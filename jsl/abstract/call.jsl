;; https://tc39.es/ecma262/#sec-call
;;
;; ECMA-262's argumentsList is a specification List, not a JavaScript Array. `(rest dyn)` retains
;; it as a compile-time SSA slice and the lowering expands that slice directly into the ordinary
;; receiver call ABI. No observable allocation or Array semantics are introduced.
(macro Call
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-call"
  :spec-name "Call"
  :status partial
  :deviation "Callable Proxy exotic objects and their [[Call]] traps are not implemented; some statically non-callable source call sites are still rejected before the DSL TypeError path."
  :transitioning true
  :params [(function dyn) (thisValue dyn) (argumentsList (rest dyn))] :ret dyn
  (if (IsCallable function)
      (call-dynamic-with-receiver-rest function thisValue argumentsList)
      (ThrowTypeError "Value is not callable")))
