;; The three non-finite doubles, as macros rather than primitives. JSL has no NaN or Infinity
;; literal and does not need one: IEEE division supplies all three exactly, they fold to constants
;; at lowering, and a macro costs no call.
(macro NaN         :params [] :ret dyn (%Div 0 0))
(macro Infinity    :params [] :ret dyn (%Div 1 0))
(macro MaxSafeInteger :params [] :ret flt 9007199254740991.0)

;; https://tc39.es/ecma262/#sec-number-constructor-number-value. Static Number properties are
;; JavaScript values, not frontend literals. Keeping every value here gives `Number.NaN`, the two
;; infinities, and the finite bounds the same DSL-owned source as the operations that consume them.
(macro NumberNaN              :params [] :ret flt (%Div 0.0 0.0))
(macro NumberPositiveInfinity :params [] :ret flt (%Div 1.0 0.0))
(macro NumberNegativeInfinity :params [] :ret flt (%Div -1.0 0.0))
(macro NumberEpsilon          :params [] :ret flt 2.220446049250313e-16)
(macro NumberMaxValue         :params [] :ret flt 1.7976931348623157e308)
(macro NumberMinValue         :params [] :ret flt 5e-324)
(macro NumberMaxSafeInteger   :params [] :ret flt 9007199254740991.0)
(macro NumberMinSafeInteger   :params [] :ret flt -9007199254740991.0)
