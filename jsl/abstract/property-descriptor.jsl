(record PropertyDescriptor
  [(hasEnumerable bool) (enumerable dyn)
   (hasConfigurable bool) (configurable dyn)
   (hasValue bool) (value dyn)
   (hasWritable bool) (writable dyn)
   (hasGetter bool) (getter dyn)
   (hasSetter bool) (setter dyn)])

(record MaybePropertyDescriptor
  [(present bool) (descriptor (record PropertyDescriptor))])

;; Property Descriptor is a specification Record, not the user-supplied descriptor Object. Field
;; presence is represented explicitly and the entire value compiles away unless a reviewed
;; record-list boundary materializes it.
(macro NewPropertyDescriptor :params [] :ret (record PropertyDescriptor)
  (record-new PropertyDescriptor
    [(hasEnumerable false) (enumerable undefined)
     (hasConfigurable false) (configurable undefined)
     (hasValue false) (value undefined)
     (hasWritable false) (writable undefined)
     (hasGetter false) (getter undefined)
     (hasSetter false) (setter undefined)]))

(macro NoPropertyDescriptor :params [] :ret (record MaybePropertyDescriptor)
  (record-new MaybePropertyDescriptor
    [(present false) (descriptor (NewPropertyDescriptor))]))
(macro SomePropertyDescriptor
  :params [(descriptor (record PropertyDescriptor))] :ret (record MaybePropertyDescriptor)
  (record-new MaybePropertyDescriptor [(present true) (descriptor descriptor)]))
(macro PropertyDescriptorPresent
  :params [(result (record MaybePropertyDescriptor))] :ret bool
  (record-get result present))
(macro PropertyDescriptorFromResult
  :params [(result (record MaybePropertyDescriptor))] :ret (record PropertyDescriptor)
  (record-get result descriptor))

(macro DescriptorHasEnumerable :params [(descriptor (record PropertyDescriptor))] :ret bool
  (record-get descriptor hasEnumerable))
(macro DescriptorHasConfigurable :params [(descriptor (record PropertyDescriptor))] :ret bool
  (record-get descriptor hasConfigurable))
(macro DescriptorHasValue :params [(descriptor (record PropertyDescriptor))] :ret bool
  (record-get descriptor hasValue))
(macro DescriptorHasWritable :params [(descriptor (record PropertyDescriptor))] :ret bool
  (record-get descriptor hasWritable))
(macro DescriptorHasGetter :params [(descriptor (record PropertyDescriptor))] :ret bool
  (record-get descriptor hasGetter))
(macro DescriptorHasSetter :params [(descriptor (record PropertyDescriptor))] :ret bool
  (record-get descriptor hasSetter))

(macro DescriptorEnumerable :params [(descriptor (record PropertyDescriptor))] :ret dyn
  (record-get descriptor enumerable))
(macro DescriptorConfigurable :params [(descriptor (record PropertyDescriptor))] :ret dyn
  (record-get descriptor configurable))
(macro DescriptorValue :params [(descriptor (record PropertyDescriptor))] :ret dyn
  (record-get descriptor value))
(macro DescriptorWritable :params [(descriptor (record PropertyDescriptor))] :ret dyn
  (record-get descriptor writable))
(macro DescriptorGetter :params [(descriptor (record PropertyDescriptor))] :ret dyn
  (record-get descriptor getter))
(macro DescriptorSetter :params [(descriptor (record PropertyDescriptor))] :ret dyn
  (record-get descriptor setter))

(macro DescriptorSetEnumerable
  :params [(descriptor (record PropertyDescriptor)) (value dyn)]
  :ret (record PropertyDescriptor)
  (record-with (record-with descriptor hasEnumerable true) enumerable value))
(macro DescriptorSetConfigurable
  :params [(descriptor (record PropertyDescriptor)) (value dyn)]
  :ret (record PropertyDescriptor)
  (record-with (record-with descriptor hasConfigurable true) configurable value))
(macro DescriptorSetValue
  :params [(descriptor (record PropertyDescriptor)) (value dyn)]
  :ret (record PropertyDescriptor)
  (record-with (record-with descriptor hasValue true) value value))
(macro DescriptorSetWritable
  :params [(descriptor (record PropertyDescriptor)) (value dyn)]
  :ret (record PropertyDescriptor)
  (record-with (record-with descriptor hasWritable true) writable value))
(macro DescriptorSetGetter
  :params [(descriptor (record PropertyDescriptor)) (value dyn)]
  :ret (record PropertyDescriptor)
  (record-with (record-with descriptor hasGetter true) getter value))
(macro DescriptorSetSetter
  :params [(descriptor (record PropertyDescriptor)) (value dyn)]
  :ret (record PropertyDescriptor)
  (record-with (record-with descriptor hasSetter true) setter value))

(builtin DescriptorHasAnyField :params [(propertyDesc (record PropertyDescriptor))] :ret bool
  (if (DescriptorHasValue propertyDesc) true
      (if (DescriptorHasWritable propertyDesc) true
          (if (DescriptorHasGetter propertyDesc) true
              (if (DescriptorHasSetter propertyDesc) true
                  (if (DescriptorHasEnumerable propertyDesc) true
                      (DescriptorHasConfigurable propertyDesc)))))))

(builtin IsAccessorDescriptor
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isaccessordescriptor"
  :spec-name "IsAccessorDescriptor"
  :status complete
  :params [(propertyDesc (record PropertyDescriptor))] :ret bool
  (if (DescriptorHasGetter propertyDesc) true (DescriptorHasSetter propertyDesc)))

(builtin IsDataDescriptor
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isdatadescriptor"
  :spec-name "IsDataDescriptor"
  :status complete
  :params [(propertyDesc (record PropertyDescriptor))] :ret bool
  (if (DescriptorHasValue propertyDesc) true (DescriptorHasWritable propertyDesc)))

(builtin IsGenericDescriptor
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isgenericdescriptor"
  :spec-name "IsGenericDescriptor"
  :status complete
  :transitioning true
  :params [(propertyDesc (record PropertyDescriptor))] :ret bool
  (if (IsAccessorDescriptor propertyDesc) false
      (if (IsDataDescriptor propertyDesc) false true)))

(macro CompletePropertyDescriptor
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-completepropertydescriptor"
  :spec-name "CompletePropertyDescriptor"
  :status complete
  :transitioning true
  :params [(propertyDesc (record PropertyDescriptor))] :ret (record PropertyDescriptor)
  (let [(kindCompleted
          (if (if (IsGenericDescriptor propertyDesc) true
                  (IsDataDescriptor propertyDesc))
              (let [(valueCompleted
                      (if (DescriptorHasValue propertyDesc) propertyDesc
                          (DescriptorSetValue propertyDesc (%Box undefined))))
                    (writableCompleted
                      (if (DescriptorHasWritable valueCompleted) valueCompleted
                          (DescriptorSetWritable valueCompleted false)))]
                writableCompleted)
              (let [(getterCompleted
                      (if (DescriptorHasGetter propertyDesc) propertyDesc
                          (DescriptorSetGetter propertyDesc (%Box undefined))))
                    (setterCompleted
                      (if (DescriptorHasSetter getterCompleted) getterCompleted
                          (DescriptorSetSetter getterCompleted (%Box undefined))))]
                setterCompleted)))
        (enumerableCompleted
          (if (DescriptorHasEnumerable kindCompleted) kindCompleted
              (DescriptorSetEnumerable kindCompleted false)))
        (configurableCompleted
          (if (DescriptorHasConfigurable enumerableCompleted) enumerableCompleted
              (DescriptorSetConfigurable enumerableCompleted false)))]
    configurableCompleted))

(macro ToPropertyDescriptor
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-topropertydescriptor"
  :spec-name "ToPropertyDescriptor"
  :status partial
  :deviation "BigInt and Proxy descriptor objects are not represented; ordinary Objects, Arrays, and Functions use canonical inherited HasProperty/Get observation and callable validation."
  :transitioning true
  :params [(object dyn)] :ret (record PropertyDescriptor)
  (let [(source (RequireObjectValue object "Property description must be an object"))
        (descriptor (NewPropertyDescriptor))
        (enumerable
          (if (HasProperty source "enumerable")
              (DescriptorSetEnumerable descriptor (ToBoolean (GetProperty source "enumerable")))
              descriptor))
        (configurable
          (if (HasProperty source "configurable")
              (DescriptorSetConfigurable enumerable
                (ToBoolean (GetProperty source "configurable")))
              enumerable))
        (value
          (if (HasProperty source "value")
              (DescriptorSetValue configurable (GetProperty source "value"))
              configurable))
        (writable
          (if (HasProperty source "writable")
              (DescriptorSetWritable value (ToBoolean (GetProperty source "writable")))
              value))
        (getter
          (if (HasProperty source "get")
              (let [(candidate (GetProperty source "get"))]
                (if (if (IsCallable candidate) true (%IsUndefined candidate))
                    (DescriptorSetGetter writable candidate)
                    (ThrowTypeError "Getter must be a function")))
              writable))
        (setter
          (if (HasProperty source "set")
              (let [(candidate (GetProperty source "set"))]
                (if (if (IsCallable candidate) true (%IsUndefined candidate))
                    (DescriptorSetSetter getter candidate)
                    (ThrowTypeError "Setter must be a function")))
              getter))]
    (if (if (DescriptorHasGetter setter) true (DescriptorHasSetter setter))
        (if (if (DescriptorHasValue setter) true (DescriptorHasWritable setter))
            (ThrowTypeError "Invalid property descriptor. Cannot both specify accessors and a value or writable attribute")
            setter)
        setter)))
