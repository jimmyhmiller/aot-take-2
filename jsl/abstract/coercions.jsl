  ;; usually prove. Put it first so ordinary numeric/string arithmetic does not retain object-only
  ;; conversion calls in its graph.
  (ToPrimitive (%Box v) "number"))

;; https://tc39.es/ecma262/#sec-tonumber
(builtin ToNumberValue :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-tonumber"
  :spec-name "ToNumber"
  :status partial
  :deviation "BigInt values and the complete object ToPrimitive protocol are not yet implemented."
  :params [(v dyn)] :ret dyn
