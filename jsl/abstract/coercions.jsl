      input
      (ToPrimitiveObject input preferredType)))

;; Object-only continuation kept out of the overwhelmingly common primitive fast path. Making the
;; canonical macro guard this called unit lets statically primitive arithmetic erase the entire
;; heap/callback closure while still keeping exactly one implementation of the observable branch.
(builtin ToPrimitiveObject
  :specializes "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-toprimitive"
  :deviation "Object-only continuation of canonical ToPrimitive; callers must establish that input is not primitive."
  :transitioning true :params [(input dyn) (preferredType dyn)] :ret dyn
