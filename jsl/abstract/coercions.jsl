      true
      (if (%IsSymbol v)
          true
      (if (%IsString v)
          true
          (if (%IsUndefined v)
              true
              (if (%IsNull v) true (%IsBool v)))))))

;; https://tc39.es/ecma262/#sec-toprimitive. `preferredType = undefined` represents the omitted
;; optional argument and therefore selects the specification's "default" hint. Well-known Symbol
;; identity is published by the targeted JSL entry rather than by retaining the complete Symbol
;; constructor closure in every coercion graph.
(builtin ToPrimitive
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-toprimitive"
  :spec-name "ToPrimitive"
  :status partial
  :deviation "Proxy exotic objects and BigInt are not represented. Until the intrinsic manifest publishes every inherited default conversion method, the no-@@toPrimitive fallback for represented Arrays, Functions, and primitive wrappers composes their unmodified intrinsic result directly; mutation of those inherited defaults is not yet supported."
