                        (ThrowTypeError "Cannot convert object to primitive value")))))
            (let [(second (GetProperty object "valueOf"))]
              (if (IsCallable second)
                  (let [(secondResult (Call second object))]
                    (if (IsPrimitiveValue secondResult)
                        secondResult
                        (ThrowTypeError "Cannot convert object to primitive value")))
                  (ThrowTypeError "Cannot convert object to primitive value")))))
      (let [(first (GetProperty object "valueOf"))]
        (if (IsCallable first)
            (let [(firstResult (Call first object))]
              (if (IsPrimitiveValue firstResult)
                  firstResult
                  (let [(second (GetProperty object "toString"))]
                    (if (IsCallable second)
                        (let [(secondResult (Call second object))]
                          (if (IsPrimitiveValue secondResult)
                              secondResult
                              (ThrowTypeError "Cannot convert object to primitive value")))
                        (ThrowTypeError "Cannot convert object to primitive value")))))
            (let [(second (GetProperty object "toString"))]
              (if (IsCallable second)
                  (let [(secondResult (Call second object))]
                    (if (IsPrimitiveValue secondResult)
                        secondResult
