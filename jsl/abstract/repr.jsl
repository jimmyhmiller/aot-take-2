;; Representation. A `dyn` is a NaN-boxed JavaScript value; arithmetic runs on UNBOXED words, and
;; the backend chooses integer or floating instructions from the static type of its operands. A
;; `dyn` has no such type, so `(%Lt v 0)` on one compiles to a raw integer compare of a boxed word
;; — which is why a definition that reads correctly under the interpreter can be wrong natively.
;;
;; WHY THE UNBOXING IS WRITTEN HERE RATHER THAN HIDDEN IN THE BACKEND. `unbox-idealize` rewrites
;; `Unbox(Box(v))` to `v` when v's type is proven, so a chain of operations on values the compiler
;; can prove are integers loses ALL of its boxing. Measured on an isolated definition: source with
;; two Box and two Unbox nodes keeps one of each after `iterate!`, flat and through a merge Phi.
;; That only works while Box and Unbox are nodes the optimiser can see. Move the unboxing into
;; instruction selection and it happens after the optimiser has run, so every intermediate is boxed
;; and immediately unboxed for ever, and the cost is invisible in the source.
;;
;; The guard is the price. Where closed-world inference proves the type it folds away entirely;
;; where it cannot, a compare-and-branch remains. That is V8's bargain without the deoptimisation.
;;
;; THE SHAPE EVERY NUMERIC BUILTIN TAKES: test the representation, unbox, do the arithmetic on a raw
;; word, box the result. The int and float cores are separate macros because the backend selects
;; integer or floating instructions from the PARAMETER TYPE alone — one core over `dyn` would
;; compile to integer instructions on boxed words.

; --- absolute value ---------------------------------------------------------
;; `(%Add x 0)` on the float arm is what makes `abs(-0)` answer `+0` under IEEE without a special
;; case, and it leaves NaN and both infinities alone. The integer arm needs no such thing.
(macro IntAbs :params [(x int)] :ret int (if (%Lt x 0) (%Sub 0 x) x))
(builtin FltAbs :params [(x flt)] :ret flt (if (%Lt x 0) (%Sub 0 x) (%Add x 0)))

; --- sign -------------------------------------------------------------------
;; The zero arm returns `x` UNCHANGED, because the spec preserves the sign of a zero.
(builtin IntSign :params [(x int)] :ret int (if (%Lt 0 x) 1 (if (%Lt x 0) -1 x)))
(builtin FltSign :params [(x flt)] :ret flt (if (%Lt 0 x) 1.0 (if (%Lt x 0) -1.0 x)))

; --- NaN ------------------------------------------------------------------
;; `NaN === NaN` is false, and the ONLY way to observe that is a floating comparison. `(%Eq v v)` on
;; a `dyn` compiles to an integer compare of the boxed word, which is true for NaN — measured: it
;; answered true for both a raw NaN and the canonical NaN box. Unboxing first makes the backend
;; select FCMP, where IEEE gives the right answer.
;;
;; An integer is never NaN, so the integer arm needs no test at all. A NaN reports `%IsFlt`, which
;; is also why `IsNumber` below is correct: NaN is a Number.
(macro FltIsNaN :params [(x flt)] :ret bool (%Not (%Eq x x)))
(macro IsNaNNumber :params [(v dyn)] :ret bool
  (if (%IsFlt v) (FltIsNaN (%UnboxFlt v)) false))

;; The non-finite doubles as BOXED values, for merging with other boxed values. An unboxed double
;; and a boxed word are different register classes, and a Phi over both is incoherent.
(builtin BoxedNaN :params [] :ret dyn (%Box (%Div 0.0 0.0)))
; --- comparison over two dynamic numbers ------------------------------------
;; Both operands unboxed, all four representation pairs enumerated. The backend promotes an integer
;; operand to floating when the OTHER operand is float-typed, so the mixed arms need no explicit
;; conversion — but they do need the unboxing, because a comparison of two boxed words is an integer
;; compare of tagged bit patterns.
(builtin NumLt :params [(a dyn) (b dyn)] :ret bool
  (if (%IsInt a)
      (if (%IsInt b) (%Lt (%UnboxInt a) (%UnboxInt b)) (%Lt (%UnboxInt a) (%UnboxFlt b)))
      (if (%IsInt b) (%Lt (%UnboxFlt a) (%UnboxInt b)) (%Lt (%UnboxFlt a) (%UnboxFlt b)))))

(builtin NumEq :params [(a dyn) (b dyn)] :ret bool
  (if (%IsInt a)
      (if (%IsInt b) (%Eq (%UnboxInt a) (%UnboxInt b)) (%Eq (%UnboxInt a) (%UnboxFlt b)))
      (if (%IsInt b) (%Eq (%UnboxFlt a) (%UnboxInt b)) (%Eq (%UnboxFlt a) (%UnboxFlt b)))))

(builtin NumLe :params [(a dyn) (b dyn)] :ret bool
  (if (%IsInt a)
      (if (%IsInt b) (%Le (%UnboxInt a) (%UnboxInt b)) (%Le (%UnboxInt a) (%UnboxFlt b)))
      (if (%IsInt b) (%Le (%UnboxFlt a) (%UnboxInt b)) (%Le (%UnboxFlt a) (%UnboxFlt b)))))

; --- comparison -------------------------------------------------------------
