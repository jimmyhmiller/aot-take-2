;; Internal slot names are specification values, not ECMAScript language values. These zero-arg
;; macros give represented slot names stable, readable identities at the JSL boundary while the
;; opaque `%InternalKind` primitive remains the single source of runtime layout information. The
;; integer encodings are private to this file; callers always name the specification slot.
(macro InternalSlotNumberData :params [] :ret int 1)
(macro InternalSlotBooleanData :params [] :ret int 2)
(macro InternalSlotStringData :params [] :ret int 3)
(macro InternalSlotSymbolData :params [] :ret int 4)
(macro InternalSlotArrayBufferData :params [] :ret int 5)
(macro InternalSlotArrayBufferByteLength :params [] :ret int 6)
(macro InternalSlotArrayBufferByteLengthData :params [] :ret int 17)
(macro InternalSlotViewedArrayBuffer :params [] :ret int 8)
(macro InternalSlotTypedArrayName :params [] :ret int 9)
(macro InternalSlotContentType :params [] :ret int 10)
(macro InternalSlotByteLength :params [] :ret int 11)
(macro InternalSlotByteOffset :params [] :ret int 12)
(macro InternalSlotArrayLength :params [] :ret int 13)
(macro InternalSlotIteratedArrayLike :params [] :ret int 14)
(macro InternalSlotArrayLikeNextIndex :params [] :ret int 15)
(macro InternalSlotArrayLikeIterationKind :params [] :ret int 16)
(macro InternalSlotDataView :params [] :ret int 18)

(builtin RequireInternalSlot
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-requireinternalslot"
  :spec-name "RequireInternalSlot"
  :status partial
  :deviation "Only internal slots belonging to the represented Number, Boolean, String, Symbol, ArrayBuffer, DataView, TypedArray, and Array Iterator object families currently have slot-name identities."
  :transitioning true
  :params [(obj dyn) (internalSlot int)] :ret dyn
  (if (HasInternalSlot obj internalSlot)
      (%Box undefined)
      (ThrowTypeError "Object does not have the required internal slot")))

;; Slot presence is a representation question. One runtime kind owns a complete represented slot
;; family, so this is the only bridge from named specification slots to the compact payload tuple.
;; Adding a new represented object family extends this table once instead of teaching each builtin
;; a private brand-number convention.
(builtin HasPrimitiveWrapperInternalSlot
  :params [(kind int) (internalSlot int)] :ret bool
  (if (%Eq internalSlot (InternalSlotNumberData))
      (%Eq kind 100)
      (if (%Eq internalSlot (InternalSlotBooleanData))
          (%Eq kind 101)
          (if (%Eq internalSlot (InternalSlotStringData))
              (%Eq kind 102)
              (if (%Eq internalSlot (InternalSlotSymbolData))
                  (%Eq kind 103)
                  false)))))

(macro IsArrayBufferInternalSlot :params [(internalSlot int)] :ret bool
  (if (%Eq internalSlot (InternalSlotArrayBufferData))
      true
      (%Eq internalSlot (InternalSlotArrayBufferByteLength))))

(builtin IsTypedArrayInternalSlot :params [(internalSlot int)] :ret bool
  (if (%Eq internalSlot (InternalSlotViewedArrayBuffer))
      true
      (if (%Eq internalSlot (InternalSlotTypedArrayName))
          true
          (if (%Eq internalSlot (InternalSlotContentType))
              true
              (if (%Eq internalSlot (InternalSlotByteLength))
                  true
                  (if (%Eq internalSlot (InternalSlotByteOffset))
                      true
                      (%Eq internalSlot (InternalSlotArrayLength))))))))

(builtin IsArrayIteratorInternalSlot :params [(internalSlot int)] :ret bool
  (if (%Eq internalSlot (InternalSlotIteratedArrayLike))
      true
      (if (%Eq internalSlot (InternalSlotArrayLikeNextIndex))
          true
          (%Eq internalSlot (InternalSlotArrayLikeIterationKind)))))

(macro HasTypedArrayKind :params [(kind int)] :ret bool
  (if (%Eq kind 200) true (%Eq kind 201)))

(builtin HasArrayIteratorKind :params [(kind int)] :ret bool
  (if (%Eq kind 0) true (if (%Eq kind 1) true (%Eq kind 2))))

;; DataView is represented by the generated object layout rather than a private numeric brand.
;; Keep the abstract operation's slot-name value boundary while asking the layout for presence.
(builtin HasDataViewInternalSlot :params [(obj dyn) (internalSlot int)] :ret bool
  (if (%Eq internalSlot (InternalSlotDataView))
      (internal-slot-has obj DataView)
      (if (%Eq internalSlot (InternalSlotViewedArrayBuffer))
      (internal-slot-has obj ViewedArrayBuffer)
      (if (%Eq internalSlot (InternalSlotByteLength))
          (internal-slot-has obj ByteLength)
          (if (%Eq internalSlot (InternalSlotByteOffset))
              (internal-slot-has obj ByteOffset)
              false)))))

(builtin HasInternalSlot :transitioning true :params [(obj dyn) (internalSlot int)] :ret bool
  (if (%IsObject obj)
      (let [(kind (%InternalKind obj))]
        (if (HasPrimitiveWrapperInternalSlot kind internalSlot)
            true
            (if (IsArrayBufferInternalSlot internalSlot)
                (%Eq kind 105)
                (if (IsTypedArrayInternalSlot internalSlot)
                    (HasTypedArrayKind kind)
                    (if (IsArrayIteratorInternalSlot internalSlot)
                        (HasArrayIteratorKind kind)
                        (HasDataViewInternalSlot obj internalSlot))))))
      false))
