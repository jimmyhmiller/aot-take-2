                        (DescriptorValue propertyDesc)
                        (if (if hasCurrent (IsDataDescriptor current) false)
                            (DescriptorValue current) (%Box undefined))))
                  (writable
                    (WritableAttribute propertyDesc
                      (if (if hasCurrent (IsDataDescriptor current) false)
                          (WritableAttribute current 0) 0)))
                  (stored (%DefinePropertyValue object propertyKey value))
                  (marked (%SetPropertyAttributes object propertyKey
                                                  (%BitOr writable
                                                    (%BitOr enumerable configurable))))
                  (lengthMaintained
                    (MaintainArrayIndexLengthAfterDefine object propertyKey value))]
              object)))))

;; This is deliberately a called builtin. The algorithm is a large decision tree reused by
;; ordinary, String-exotic, and compatibility paths; inlining it duplicates the whole tree at
;; every definition site and again at every JavaScript entry. PropertyDescriptor and
;; MaybePropertyDescriptor now cross this internal boundary as canonical flattened result/argument
;; vectors, so a macro is no longer needed to keep specification Records compile-away.
(builtin ValidateAndApplyPropertyDescriptor
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-validateandapplypropertydescriptor"
  :spec-name "ValidateAndApplyPropertyDescriptor"
  :status partial
  :deviation "Proxy and unrepresented exotic [[DefineOwnProperty]] protocols are not implemented; validation-only calls and represented ordinary Objects, Arrays, and Functions follow the canonical descriptor algorithm."
  :transitioning true
  :params [(object dyn) (propertyKey dyn) (extensible bool)
           (propertyDesc (record PropertyDescriptor))
           (currentResult (record MaybePropertyDescriptor))] :ret bool
