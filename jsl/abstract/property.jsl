        (let [(current (NewPropertyDescriptor))
              (enumerable
                (DescriptorSetEnumerable current (%Not (%Eq (%BitAnd attributes 2) 0))))
              (configurable
                (DescriptorSetConfigurable enumerable (%Not (%Eq (%BitAnd attributes 4) 0))))
              (kind
                (if (%Eq (%BitAnd attributes 8) 0)
                    (let [(value (DescriptorSetValue configurable (%PropLoadKey object propertyKey)))
                          (writable
