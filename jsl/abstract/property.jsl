      (if (%Not extensible)
          false
          (let [(applied
                  (if (%IsUndefined object) (%Box undefined)
                      (ApplyPropertyDescriptorRecord object propertyKey propertyDesc currentResult)))]
            true))
      (if (%Not (DescriptorHasAnyField propertyDesc))
          true
          (let [(current (PropertyDescriptorFromResult currentResult))
                (currentConfigurable (ToBoolean (DescriptorConfigurable current)))
                (currentAccessor (IsAccessorDescriptor current))
                (descriptorAccessor (IsAccessorDescriptor propertyDesc))
                (descriptorGeneric (IsGenericDescriptor propertyDesc))]
            (if (if (%Not currentConfigurable)
                    (if (DescriptorHasConfigurable propertyDesc)
                        (ToBoolean (DescriptorConfigurable propertyDesc)) false) false)
                false
                (if (if (%Not currentConfigurable)
                        (if (DescriptorHasEnumerable propertyDesc)
                            (%Not (%Eq (ToBoolean (DescriptorEnumerable propertyDesc))
                                      (ToBoolean (DescriptorEnumerable current)))) false) false)
                    false
                    (if (if (%Not currentConfigurable)
                            (if (%Not descriptorGeneric)
                                (%Not (%Eq descriptorAccessor currentAccessor)) false) false)
                        false
                        (if (if (%Not currentConfigurable) currentAccessor false)
                            (if (if (DescriptorHasGetter propertyDesc)
                                    (%Not (SameValue (DescriptorGetter propertyDesc)
                                                     (DescriptorGetter current))) false)
                                false
                                (if (if (DescriptorHasSetter propertyDesc)
                                        (%Not (SameValue (DescriptorSetter propertyDesc)
                                                         (DescriptorSetter current))) false)
                                    false
                                    true))
                            (if (if (%Not currentConfigurable)
                                    (if (%Not currentAccessor)
                                        (%Not (ToBoolean (DescriptorWritable current))) false)
                                    false)
                                (if (if (DescriptorHasWritable propertyDesc)
                                        (ToBoolean (DescriptorWritable propertyDesc)) false)
                                    false
                                    (if (DescriptorHasValue propertyDesc)
                                        (SameValue (DescriptorValue propertyDesc)
                                                   (DescriptorValue current))
                                        true))
                                (let [(applied
