              (EnumerableAttribute propertyDesc
                (if hasCurrent (EnumerableAttribute current 0) 0)))
            (configurable
              (ConfigurableAttribute propertyDesc
                (if hasCurrent (ConfigurableAttribute current 0) 0)))]
        (if accessor
            (let [(getter
                    (if (DescriptorHasGetter propertyDesc)
                        (DescriptorGetter propertyDesc)
                        (if (if hasCurrent (IsAccessorDescriptor current) false)
                            (DescriptorGetter current) (%Box undefined))))
                  (setter
                    (if (DescriptorHasSetter propertyDesc)
                        (DescriptorSetter propertyDesc)
                        (if (if hasCurrent (IsAccessorDescriptor current) false)
                            (DescriptorSetter current) (%Box undefined))))
