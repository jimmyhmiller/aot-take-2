;; Internal abstract operations. Not ECMAScript surface: these are the helpers the spec-shaped
;; builtins are written out of, and they exist so that a coercion or a bound appears once.
;;
;; A MACRO, NOT A BUILTIN, and the difference is visible in the output. As a builtin this was an
;; OP-CALL in every caller, which made each of them `:transitioning` and put a call on the fast path
;; of `StringIndexOfFrom`. Inlined, the bound is three nodes the optimiser can fold against a known
;; index, and the caller needs no annotation because it no longer transitions.
;; UNBOXED INTS. Every index in the string library is a machine integer — `%StringLen` and
;; `%StringIndexOf` both compute `int` — so clamping one is ordinary integer arithmetic. A version
;; over `dyn` would compare boxed words, which is an integer compare of tagged bit patterns.
(builtin Clamp :params [(x int) (lo int) (hi int)] :ret int
  (if (%Lt x lo) lo (if (%Lt hi x) hi x)))

;; ToIntegerOrInfinity, saturated to a machine index in [0, hi]. It returns a BOXED value
;; that is an integer for anything in range and a double only for the infinities and magnitudes at
;; or beyond 2^53 — both of which are outside any string or array length, so the double arm only has
;; to pick an end.
(builtin ClampedIndex :transitioning true :params [(v dyn) (hi int)] :ret int
  (let [(index (ToClampedIndex v (%Box hi)))]
    ;; Every Number inside a represented machine bound is emitted by ToIntegerOrInfinity as an
    ;; immediate integer. The only float-tagged inputs are infinities/large magnitudes, and the
    ;; canonical clamp replaces those with one of the immediate integer bounds.
    (%UnboxInt index)))
