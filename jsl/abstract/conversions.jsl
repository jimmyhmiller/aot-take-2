;; https://tc39.es/ecma262/#sec-toboolean — `%Not` is JavaScript truthiness, so negating twice IS
;; ToBoolean. No primitive required.
(builtin ToBoolean
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-toboolean"
  :spec-name "ToBoolean"
  :status partial
  :deviation "BigInt source values are not yet represented by the supported JavaScript frontend/runtime surface."
  :params [(v dyn)] :ret bool
  (%Not (%Not v)))

;; https://tc39.es/ecma262/#sec-iscallable. The runtime primitive answers whether the value carries
;; this implementation's callable representation; the language operation and its provenance stay
;; named here so every semantic consumer shares one boundary.
(builtin IsCallable
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-iscallable"
  :spec-name "IsCallable"
  :status partial
  :deviation "Callable Proxy exotic objects are not yet implemented by the supported runtime surface."
  :params [(v dyn)] :ret bool
  (%IsFunction (%Box v)))

;; https://tc39.es/ecma262/#sec-logical-not-operator — `!v` is `%Not(ToBoolean(v))`, and `%Not`
;; already IS truthiness-negate, so one application is the whole operator.
(macro LogicalNot :params [(v dyn)] :ret bool (%Not v))

;; https://tc39.es/ecma262/#sec-toint32 and #sec-touint32.
;;
;; THE TRUNCATION IS THE PRIMITIVE'S; THE COERCION IS NOT. `%BitOr` and `%Ushr` do reduce their
;; operands modulo 2^32 -- that part of `x | 0` really is the primitive -- but they refuse a value
;; that is not already a number, so `"5" | 0` and `true | 0` never reached the truncation at all.
;; These read `(%BitOr v 0)` before, which is why they were never wired up: correct for a number
;; and wrong for everything else, exactly like the four hand-written relational operators.
;;
;; `ToNumberValue` carries the spec's own "already a Number" step, so the guard costs nothing on
;; the numeric path.
;; The UNBOX is as load-bearing as the coercion. `%BitOr` and friends are IR nodes whose operands
;; must be RAW numbers -- `v-rep-of` says so and `g-verify` enforces it -- so handing them the
;; tagged result of `ToNumberValue` is a representation error however correct the value is. Which
;; tag it carries is not known statically, so it is asked, exactly as `NumLt` asks.
(builtin ToInt32 :transitioning true :params [(v dyn)] :ret int
  (let [(n (ToNumberValue v))]
    (if (%IsInt n) (%BitOr (%UnboxInt n) 0) (%BitOr (%UnboxFlt n) 0))))

(builtin ToUint32 :transitioning true :params [(v dyn)] :ret int
  (let [(n (ToNumberValue v))]
    (if (%IsInt n) (%Ushr (%UnboxInt n) 0) (%Ushr (%UnboxFlt n) 0))))

;; https://tc39.es/ecma262/#sec-binary-bitwise-operators and #sec-bitwise-shift-operators.
;;
;; Each is ToInt32 (ToUint32 for the shift count of `>>>`) on both operands and then the machine
;; operation, and the primitives already perform the modulo-2^32 reduction -- so the whole content
;; of these definitions is the coercion the frontend used to write out by hand, once per operator,
;; at eleven separate sites.
(builtin BitwiseAnd :transitioning true :params [(a dyn) (b dyn)] :ret int (%BitAnd (ToInt32 a) (ToInt32 b)))
(builtin BitwiseOr :transitioning true  :params [(a dyn) (b dyn)] :ret int (%BitOr  (ToInt32 a) (ToInt32 b)))
(builtin BitwiseXor :transitioning true :params [(a dyn) (b dyn)] :ret int (%BitXor (ToInt32 a) (ToInt32 b)))
(macro BitwiseNot :transitioning true :params [(a dyn)] :ret int (%BitNot (ToInt32 a)))
(builtin ShiftLeft :transitioning true  :params [(a dyn) (b dyn)] :ret int (%Shl (ToInt32 a) (ToInt32 b)))
(builtin ShiftRight :transitioning true :params [(a dyn) (b dyn)] :ret int (%Shr (ToInt32 a) (ToInt32 b)))
;; `>>>` is the one that reads its LEFT operand as unsigned, which is the whole difference from
;; `>>` and the reason `ToUint32` exists at all.
(builtin ShiftRightUnsigned :transitioning true :params [(a dyn) (b dyn)] :ret int (%Ushr (ToUint32 a) (ToInt32 b)))

;; https://tc39.es/ecma262/#sec-parsefloat-string. ToString is semantic and stays here; scanning
;; and correctly-rounded decimal conversion are the runtime capability behind `%ParseFloat`.
(macro ParseFloatValue :transitioning true :params [(v dyn)] :ret dyn (%ParseFloat (ToStringValue v)))

;; https://tc39.es/ecma262/#sec-void-operator. Evaluation of the argument is sequenced by the
;; frontend; this definition owns the JavaScript result and its tagged representation.
(macro VoidValue :params [(v dyn)] :ret dyn (%Box undefined))

;; https://tc39.es/ecma262/#sec-typeof-operator. Tag and capability inspection are primitives;
;; the language-level classification and its deliberately surprising null case remain in JSL.
(builtin TypeOfValue :transitioning true :params [(v dyn)] :ret str
  (if (%IsUndefined v) "undefined"
    (if (%IsBool v) "boolean"
      (if (IsNumber v) "number"
        (if (%IsString v) "string"
          (if (%IsSymbol v) "symbol"
          (if (IsCallable v) "function"
            (if (%IsNull v) "object"
              (if (%IsObject v) "object"
                (if (%IsArray v) "object" "undefined"))))))))))

;; The test used by `??`. Operand evaluation and the conditional right-hand evaluation are syntax
;; sequencing; the definition of nullish is JavaScript semantics and belongs here.
(macro IsNullishValue :params [(v dyn)] :ret bool
  (if (%IsUndefined v) true (%IsNull v)))

;; Default-parameter evaluation is syntax sequencing in the frontend. The deciding JavaScript
;; predicate remains library semantics so `null` is preserved while only `undefined` selects the
;; initializer.
(macro IsUndefinedValue :params [(v dyn)] :ret bool (%IsUndefined v))

;; Native call targets may still be represented by a raw `Fun` graph value before invocation.
;; Recognize that callable representation before applying ordinary tagged nullish classification.
(macro IsNullishCallable :params [(v dyn)] :ret bool
  (if (%IsFunction v) false (IsNullishValue v)))

;; Storage consumers need a machine index after applying the specification's Number-domain
;; ToLength. Keep that representation conversion named separately so it cannot masquerade as the
;; abstract operation or silently narrow callers that only need the ECMAScript Number result.
(builtin ToMachineLength :transitioning true
  :specializes "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-tolength"
  :deviation "Returns a machine index saturated to an explicit caller-provided storage limit instead of the canonical Number domain through 2^53-1."
  :params [(v dyn) (hi int)] :ret int
  (ClampedIndex v hi))

(builtin ToLength
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-tolength"
  :spec-name "ToLength"
  :status partial
  :deviation "BigInt values and the complete object ToPrimitive protocol inherited from ToIntegerOrInfinity are not yet implemented."
  :transitioning true
  :params [(argument dyn)] :ret dyn
  (let [(length (ToIntegerOrInfinity argument))
        (maximum (%Box (MaxSafeInteger)))]
    (if (NumLe length (%Box 0))
        (%Box 0)
        (if (NumLt maximum length) maximum length))))

(builtin ToIndex
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-toindex"
  :spec-name "ToIndex"
  :status partial
  :deviation "BigInt values and the complete object ToPrimitive protocol inherited from ToIntegerOrInfinity are not yet implemented."
  :transitioning true
  :params [(value dyn)] :ret dyn
  (if (%IsUndefined value)
      (%Box 0)
      (let [(integer (ToIntegerOrInfinity value))]
        (if (NumLt integer (%Box 0))
            (ThrowRangeError "Index must be non-negative")
            (let [(index (ToLength integer))]
              (if (SameValueZero integer index)
                  index
                  (ThrowRangeError "Index is outside the valid range")))))))

;; Both operands are already specification Numbers. Preserve the immediate-integer representation
;; when possible so machine-index adapters can erase boxing without narrowing the Number-domain
;; operation; mixed/large values use the checked numeric-to-double conversion.
(builtin AddNumericValues :params [(left dyn) (right dyn)] :ret dyn
  (if (%IsInt left)
      (if (%IsInt right)
          (%Box (%Add (%UnboxInt left) (%UnboxInt right)))
          (%Box (%Add (%UnboxInt left) (%UnboxFlt right))))
      (if (%IsInt right)
          (%Box (%Add (%UnboxFlt left) (%UnboxInt right)))
          (%Box (%Add (%UnboxFlt left) (%UnboxFlt right))))))

(builtin ToAbsoluteIndex
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-toabsoluteindex"
  :spec-name "ToAbsoluteIndex"
  :status partial
  :deviation "BigInt values and the complete object ToPrimitive protocol inherited from ToIntegerOrInfinity are not yet implemented."
  :transitioning true
  :params [(value dyn) (length dyn)] :ret dyn
  (let [(integer (ToIntegerOrInfinity value))]
    (if (if (IsFiniteNumber integer) (NumLt integer (%Box 0)) false)
        (AddNumericValues length integer)
        integer)))

(builtin ToClampedIndex
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-toclampedindex"
  :spec-name "ToClampedIndex"
  :status partial
  :deviation "BigInt values and the complete object ToPrimitive protocol inherited from ToAbsoluteIndex are not yet implemented."
  :transitioning true
  :params [(value dyn) (length dyn)] :ret dyn
  (let [(index (ToAbsoluteIndex value length))]
    (if (NumLt index (%Box 0))
        (%Box 0)
        (if (NumLt length index) length index))))

;; https://tc39.es/ecma262/#sec-samevaluezero. Strict equality differs from SameValueZero only at
;; NaN: `NaN === NaN` is false and `SameValueZero(NaN, NaN)` is true. Strings need their value
;; comparison before the raw equality used by every other tagged representation.
(builtin SameValueZero :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-samevaluezero"
  :spec-name "SameValueZero"
  :status partial
  :deviation "BigInt values are not yet represented by the supported frontend/runtime surface."
  :params [(a dyn) (b dyn)] :ret bool
  (if (SameType a b)
      (if (IsNumber a)
          (NumberSameValueZero a b)
          (SameValueNonNumber a b))
      false))

;; `Number.isNaN`. `v !== v` is exact as a SEMANTIC statement, but it is not compilable: strict
;; equality on a `dyn` becomes an integer compare of the boxed word, which is true for NaN. So this
;; delegates to `IsNaNNumber` in repr.jsl, which unboxes first and lets IEEE answer.
(macro IsNaNValue :params [(v dyn)] :ret bool (IsNaNNumber v))

;; https://tc39.es/ecma262/#sec-numeric-types-number-sameValue. Both operands are Numbers by the
;; numeric-method contract. Equal finite values and infinities compare directly; NaN pairs compare
;; equal; reciprocal comparison distinguishes the two IEEE zero signs without canonicalizing them.
(builtin NumberSameValue :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-numeric-types-number-sameValue"
  :spec-name "Number::sameValue"
  :status complete
  :params [(a dyn) (b dyn)] :ret bool
  (if (NumEq a b)
      (if (NumEq a (%Box 0))
          (%Eq (%Div 1.0 (%UnboxNumber a))
               (%Div 1.0 (%UnboxNumber b)))
          true)
      (if (IsNaNValue a) (IsNaNValue b) false)))

;; https://tc39.es/ecma262/#sec-numeric-types-number-equal. IEEE equality implements the Number
;; relation exactly: NaN is unequal, the two zero signs are equal, equal infinities are equal, and
;; all remaining finite values use ordinary numeric equality.
(builtin NumberEqual :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-numeric-types-number-equal"
  :spec-name "Number::equal"
  :status complete
  :params [(a dyn) (b dyn)] :ret bool
  (NumEq a b))

;; https://tc39.es/ecma262/#sec-numeric-types-number-sameValueZero. Number::equal already supplies
;; signed-zero equivalence and ordinary equality; SameValueZero adds exactly the NaN-pair case.
(builtin NumberSameValueZero :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-numeric-types-number-sameValueZero"
  :spec-name "Number::sameValueZero"
  :status complete
  :params [(a dyn) (b dyn)] :ret bool
  (if (NumberEqual a b) true (if (IsNaNValue a) (IsNaNValue b) false)))

;; https://tc39.es/ecma262/#sec-sametype. Object is one ECMAScript language type across ordinary
;; objects, arrays, and callable objects; the individual representation predicates are joined here
;; rather than leaking that layout distinction into semantic consumers.
(builtin SameType :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-sametype"
  :spec-name "SameType"
  :status partial
  :deviation "BigInt values are not yet represented by the supported frontend/runtime surface."
  :params [(a dyn) (b dyn)] :ret bool
  (if (IsNumber a) (IsNumber b)
      (if (%IsString a) (%IsString b)
          (if (%IsSymbol a) (%IsSymbol b)
              (if (%IsUndefined a) (%IsUndefined b)
                  (if (%IsNull a) (%IsNull b)
                      (if (%IsBool a) (%IsBool b)
                          (if (%IsFunction a)
                              (if (%IsFunction b) true
                                  (if (%IsObject b) true (%IsArray b)))
                              (if (%IsObject a)
                                  (if (%IsFunction b) true
                                      (if (%IsObject b) true (%IsArray b)))
                                  (if (%IsArray a)
                                      (if (%IsFunction b) true
                                          (if (%IsObject b) true (%IsArray b)))
                                      false))))))))))

;; https://tc39.es/ecma262/#sec-samevaluenonnumber. Callers establish SameType and exclude Number,
;; exactly as the spec requires. Strings compare their UTF-16 contents; every other represented
;; non-Number language value has a canonical tagged identity, so raw equality implements null,
;; undefined, Boolean, Symbol, and Object identity without conflating distinct objects.
(builtin SameValueNonNumber :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-samevaluenonnumber"
  :spec-name "SameValueNonNumber"
  :status partial
  :deviation "BigInt values are not yet represented by the supported frontend/runtime surface."
  :params [(a dyn) (b dyn)] :ret bool
  (if (%IsString a) (StringEquals a b) (%Eq a b)))

;; https://tc39.es/ecma262/#sec-samevalue. Equal zeros require reciprocal comparison to preserve
;; their IEEE signs; unequal Numbers are SameValue only when both are NaN. Every other represented
;; type uses String value equality or stable tagged identity after SameType has ruled out cross-type
;; coincidences.
(builtin SameValue :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-samevalue"
  :spec-name "SameValue"
  :status partial
  :deviation "BigInt values are not yet represented by the supported frontend/runtime surface."
  :params [(a dyn) (b dyn)] :ret bool
  (if (SameType a b)
      (if (IsNumber a)
          (NumberSameValue a b)
          (SameValueNonNumber a b))
      false))

(builtin ObjectIs :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-object.is"
  :spec-name "Object.is"
  :status partial
  :deviation "BigInt, complete callable publication metadata/constructor classification, and all Symbol execution paths are not yet implemented."
  :params [(value1 dyn) (value2 dyn)] :ret bool
  (SameValue value1 value2))

;; https://tc39.es/ecma262/#sec-isstrictlyequal. Boxing first gives every representation one
;; tagged comparison domain; Numbers and Strings then use their value semantics instead of boxed
;; word identity. In particular NumEq reaches an IEEE floating compare, so NaN is unequal to itself.
(builtin StrictEqual :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isstrictlyequal"
  :spec-name "IsStrictlyEqual"
  :status partial
  :deviation "BigInt values are not yet represented by the supported frontend/runtime surface."
  :params [(a dyn) (b dyn)] :ret bool
  (let [(left a) (right b)]
    (if (SameType left right)
        (if (IsNumber left)
            (NumberEqual left right)
            (SameValueNonNumber left right))
        false)))

;; https://tc39.es/ecma262/#sec-applystringornumericbinaryoperator, and the numeric operations it
;; dispatches to.
;;
;; ONE UNBOX PER OPERAND, NOT A FOUR-WAY TAG DISPATCH. Written as `if (%IsInt a) … (%IsFlt …)` the
;; arithmetic cannot fold, because a tag is not a type: a field declared `flt` holds an int-tagged
;; 0 after `{a: 0}`, so nothing static decides which arm runs. `n + 1` came out as seventy nodes.
;;
;; `%UnboxFlt` of an int-tagged value is a CONVERSION and not a reinterpretation, on both paths that
;; execute a graph: `ev-unbox` turns `RT-INT` into `RFlt` explicitly, and aarch64's `MI-JSUNBOX`
;; tests `JSV-INTEGER` and emits `sxt48`/`scvtf`. Its comment says so -- "ToNumber accepts the
;; immediate-integer arm of the tagged ABI as well as raw IEEE doubles" -- and the frontend's own
;; `fng-to-number-operand` has always relied on it. So one guarded coercion and one unbox is the
;; whole conversion, which is what the hand-written arithmetic did too.
(macro NumberRaw :transitioning true :params [(v dyn)] :ret flt (%UnboxNumber (ToNumberValue v)))

;; `+` IS THE ONLY OPERATOR WHOSE RESULT TYPE DEPENDS ON ITS OPERANDS: a String on either side makes
;; it concatenation, and everything else makes it addition. That is the whole reason it cannot be a
;; peephole and has to be a definition.
(builtin JsAdd :transitioning true :params [(a dyn) (b dyn)] :ret dyn
  (let [(left (ToPrimitive (%Box a) (%Box undefined)))
        (right (ToPrimitive (%Box b) (%Box undefined)))]
    (if (%IsString left)
        (%StringConcat left (ToStringValue right))
        (if (%IsString right)
            (%StringConcat (ToStringValue left) right)
            (%Box (%Add (NumberRaw left) (NumberRaw right)))))))

(builtin JsSub :transitioning true :params [(a dyn) (b dyn)] :ret dyn (%Box (%Sub (NumberRaw a) (NumberRaw b))))
(builtin JsMul :transitioning true :params [(a dyn) (b dyn)] :ret dyn (%Box (%Mul (NumberRaw a) (NumberRaw b))))
(builtin JsDiv :transitioning true :params [(a dyn) (b dyn)] :ret dyn (%Box (%Div (NumberRaw a) (NumberRaw b))))
(builtin JsMod :transitioning true :params [(a dyn) (b dyn)] :ret dyn (%Box (%Mod (NumberRaw a) (NumberRaw b))))
(macro JsNegate :transitioning true :params [(a dyn)] :ret dyn (%Box (%Neg (NumberRaw a))))

;; https://tc39.es/ecma262/#sec-islessthan. THE RELATIONAL OPERATORS ARE NOT `%Lt` ON TWO NUMBERS.
;; Both operands go through ToPrimitive, two Strings compare by code unit, and everything else
;; compares numerically after ToNumber -- so `"5" < 6` is true and `"10" < "9"` is false, and the
;; difference between those two is the operand types rather than the operator.
;;
;; The frontend used to decide this STATICALLY: if inference said both sides were strings it
;; emitted a string compare, and otherwise it emitted a numeric one over a coercion helper that
;; only fires on `dyn`. A string that inference had typed as a string, beside a number, matched
;; neither case, and `"5" < 6` stopped the evaluator. The test cannot be static because the answer
;; depends on the runtime tags.
;;
;; `IsLessEqual` is a separate definition rather than `(%Not (IsLessThan b a))` because that
;; identity is FALSE for NaN: `NaN <= 1` and `NaN > 1` are both false, and negating one to get the
;; other turns one of them true. Going through `NumLe`, which reaches an IEEE compare, keeps both.
;;
;; THE ORDER OF THE TESTS IS THE PERFORMANCE. Number-beside-Number is the overwhelming majority of
;; comparisons in real code, so it is decided first and costs two tag tests and `NumLt` -- no
;; `ToNumber`, no string test, no runtime call. Written the other way round, leading with the
;; String tests and coercing both operands unconditionally, `repros/ns.js` did not finish inside
;; 200,000,000 evaluator steps. Putting the specialisation in the DEFINITION is what lets the
;; frontend hold no opinion at all; a fast path in the compiler would have been the same speed and
;; a fifth hand-written copy of the semantics.
(builtin IsLessThan :transitioning true :params [(a dyn) (b dyn)] :ret bool
  (if (IsNumber a)
      (if (IsNumber b)
          (NumLt a b)
          (if (%IsString b) (NumLt a (%ToNumber b)) (NumLt a (ToNumberValue b))))
      (if (%IsString a)
          (if (%IsString b)
              (%Lt (StringCompare a b) 0)
              (NumLt (%ToNumber a) (ToNumberValue b)))
          (NumLt (ToNumberValue a) (ToNumberValue b)))))

(builtin IsLessEqual :transitioning true :params [(a dyn) (b dyn)] :ret bool
  (if (IsNumber a)
      (if (IsNumber b)
          (NumLe a b)
          (if (%IsString b) (NumLe a (%ToNumber b)) (NumLe a (ToNumberValue b))))
      (if (%IsString a)
          (if (%IsString b)
              (%Le (StringCompare a b) 0)
              (NumLe (%ToNumber a) (ToNumberValue b)))
          (NumLe (ToNumberValue a) (ToNumberValue b)))))

;; https://tc39.es/ecma262/#sec-islooselyequal. `==` IS NOT `===` WITH BOXING, and treating it as
;; such is how `7 == "7"` came out FALSE: the frontend saw one tagged operand beside a numeric one,
;; assumed the tagged word was a number, and unboxed a STRING as a float. Every comparison of a
;; number against its own string form was wrong, in both directions and through `!=` as well, with
;; a well-formed graph and no diagnostic -- see repros/open/loose-equality-number-to-string.js.
;;
;; The coercion is what makes this a library operation rather than a peephole: a Number beside a
;; String compares against ToNumber of the String, and a Boolean on either side becomes a Number
;; first. Booleans are converted up front so the remaining cases need no recursion, which a macro
;; cannot express.
;;
;; NOT COVERED: an object beside a primitive, which the spec resolves with ToPrimitive. Objects
;; here fall through to `StrictEqual` and so compare by identity. That is the pre-existing
;; behaviour and this does not change it; it is written down rather than fixed because ToPrimitive
;; is a valueOf/toString protocol this compiler has no closed-world story for yet.
(builtin LooseEqual :transitioning true :params [(a dyn) (b dyn)] :ret bool
  (let [(left (if (%IsBool a) (%ToNumber a) a))
        (right (if (%IsBool b) (%ToNumber b) b))]
    (if (IsNullishValue left)
        (IsNullishValue right)
        (if (IsNullishValue right)
            false
            (if (IsNumber left)
                (if (IsNumber right)
                    (NumEq left right)
                    (if (%IsString right) (NumEq left (%ToNumber right)) false))
                (if (%IsString left)
                    (if (IsNumber right)
                        (NumEq (%ToNumber left) right)
                        (if (%IsString right) (StringEquals left right) false))
                    (StrictEqual left right)))))))

;; https://tc39.es/ecma262/#sec-strict-inequality and #sec-inequality. Each is the negation of its
;; positive form and nothing else -- the operators exist so the FRONTEND does not have to spell the
;; negation, which is semantics like any other.
(macro StrictNotEqual :transitioning true :params [(a dyn) (b dyn)] :ret bool (%Not (StrictEqual a b)))
(macro LooseNotEqual :transitioning true :params [(a dyn) (b dyn)] :ret bool (%Not (LooseEqual a b)))

;; "Is this value a Number", as ONE test against the numeric union.
;;
;; It was two single-tag tests -- `%IsInt` then `%IsFlt` -- because an integer and a double are
;; genuinely different NaN-box tags and `be-js-tag-for-type` had no single answer for `int|flt`,
;; so a union test failed `MSEL-UNSUPPORTED` in the backend.
;;
;; THE SPLIT MADE THE GUARD UNPROVABLE, which is what forced this back. A boxed operand carries
;; the kind `int|flt` -- it has to, since a field declared `flt` holds an int-tagged 0 and the
;; static type cannot decide the runtime tag -- and against that, `ty-isa num num` decides while
;; `ty-isa num int` does not. The disjunction is provable where neither half is, so written as two
;; tests every `ToNumberValue` guard in this library survived into the final graph and `n + 1`
;; came out as forty-three nodes.
;;
;; Selection now emits the two `MI-JSTEST`s and an OR at the `TypeTest` site, which is the shape
;; the callable test already used for function-or-closure. No new instruction, and the union is
;; decidable. See docs/DSL-OWNERSHIP.md.
(macro IsNumber :params [(v dyn)] :ret bool (%IsNumber v))
