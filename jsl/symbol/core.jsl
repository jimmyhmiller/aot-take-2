;; A Symbol payload is the identity of an ordinary traced allocation. The retag primitive is
;; representation-only; all observable construction and conversion semantics remain here.
(builtin NewSymbol :transitioning true :params [(description dyn)] :ret dyn
  (let [(text (if (%IsUndefined description)
                  (%Box undefined)
                  (ToStringValue description)))
        (identity (%Box (%NewObject)))
        (initialized (%InternalInit identity (%Box text) 104))
        (prototype (InitializeObjectPrototype identity (BuiltinPrototypeValue 22)))]
    (%SymbolFromObject identity)))

;; Public Symbol() entry. Direct call syntax can reach this without first loading the constructor
;; object, so materialize its stable prototype surface before allocating the primitive.
(macro CallSymbol :transitioning true :params [(description dyn)] :ret dyn
  (let [(initialized (SymbolConstructorValue))]
    (NewSymbol description)))

;; Well-known symbols are ordinary, traced Symbol allocations whose stable roots are the own
;; properties of the stable Symbol constructor. Never retag a synthetic builtin identity: those
;; are function/object handles, not GC allocations.
(builtin WellKnownSymbol :transitioning true :params [(constructor dyn) (name dyn) (description dyn)] :ret dyn
  (if (HasOwnProperty constructor name)
      (GetProperty constructor name)
      (let [(symbol (NewSymbol description))
            (stored (%DefinePropertyValue constructor (ToPropertyKey name) symbol))]
        symbol)))

;; https://tc39.es/ecma262/#sec-thissymbolvalue. This is the single brand/unwrap operation shared
;; by every Symbol prototype entry: primitive Symbols pass through unchanged; wrapper Objects must
;; carry [[SymbolData]] and yield that exact primitive identity.
(builtin ThisSymbolValue :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-thissymbolvalue"
  :spec-name "ThisSymbolValue"
  :status complete
  :params [(value dyn)] :ret dyn
  (if (%IsSymbol value)
      value
      (let [(required (RequireInternalSlot value (InternalSlotSymbolData)))]
        (%InternalTarget value))))

;; https://tc39.es/ecma262/#sec-symboldescriptivestring. The input contract is the specification's
;; `a Symbol`; public receiver validation belongs to ThisSymbolValue at the consuming method.
;; [[Description]] itself is represented by the Symbol allocation's internal target.
(builtin SymbolDescriptiveString
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-symboldescriptivestring"
  :spec-name "SymbolDescriptiveString"
  :status complete
  :params [(symbol dyn)] :ret dyn
  (let [(description (%InternalTarget symbol))]
    (%StringConcat "Symbol("
      (%StringConcat (if (%IsUndefined description) "" description) ")"))))

(callable SymbolValueOf0 :transitioning true :params [] :ret dyn
  (ThisSymbolValue this))

(callable SymbolDescriptionGetter0 :transitioning true :params [] :ret dyn
