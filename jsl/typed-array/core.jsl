;; Fixed-length one-byte typed-array views. A view is an ordinary object with [[ViewedArrayBuffer]]
;; in InternalTarget, [[ArrayLength]] in InternalIndex, and its element kind in InternalKind.
;; Kinds 200 and 201 are Int8Array and Uint8Array. Numeric-indexed exotic behavior is routed once
;; through GetProperty/SetProperty in abstract/property.jsl; the frontend remains syntax-only.

(macro IsTypedArray :transitioning true :params [(value dyn)] :ret bool
  (HasInternalSlot value (InternalSlotTypedArrayName)))

;; TypedArray element types are specification values. The fixed one-byte representation uses its
;; existing internal kinds as the private encoding: 200 is ~int8~ and 201 is ~uint8~. Callers name
;; and compose the specification operations rather than interpreting those tags themselves.
(builtin TypedArrayElementType
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-typedarrayelementtype"
  :spec-name "TypedArrayElementType"
  :status partial
  :deviation "Only the represented Int8Array and Uint8Array element types are encoded."
  :params [(object dyn)] :ret int
  (%InternalKind object))

(builtin TypedArrayElementSize
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-typedarrayelementsize"
  :spec-name "TypedArrayElementSize"
  :status partial
  :deviation "Only the represented one-byte Int8Array and Uint8Array element types are supported."
  :params [(object dyn)] :ret int
  1)

(builtin IsUnsignedElementType
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isunsignedelementtype"
  :spec-name "IsUnsignedElementType"
  :status partial
  :deviation "The element-type value domain currently contains only represented ~int8~ and ~uint8~; ~uint8~ is correctly the sole unsigned member of that domain."
  :params [(elementType int)] :ret bool
  (%Eq elementType 201))

;; Specification witness records collapse to their [[Object]] field in the fixed-buffer profile:
;; buffers cannot detach or resize, so the cached byte length is invariant and recoverable from
;; the represented backing buffer. This is an explicit partial record encoding, not a second
;; TypedArray representation.
(builtin MakeTypedArrayWithBufferWitnessRecord
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-maketypedarraywithbufferwitnessrecord"
  :spec-name "MakeTypedArrayWithBufferWitnessRecord"
  :status partial
  :deviation "For represented fixed, non-detachable buffers the witness record is encoded by its TypedArray object; the invariant cached byte length is read from [[ViewedArrayBuffer]] when needed."
  :params [(object dyn) (order int)] :ret dyn
  object)

(builtin IsTypedArrayOutOfBounds :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-istypedarrayoutofbounds"
  :spec-name "IsTypedArrayOutOfBounds"
  :status partial
  :deviation "Represented TypedArrays have byte offset zero, fixed explicit lengths, and fixed non-detachable backing buffers; resizable, length-tracking, detached, and nonzero-offset views are not represented."
  :params [(record dyn)] :ret bool
  (let [(object record)
        (buffer (%InternalTarget object))]
    (if (IsDetachedBuffer buffer)
        true
        (let [(bufferByteLength (%InternalIndex buffer))
              (byteOffsetStart 0)
              (arrayByteLength (%Mul (%InternalIndex object)
                                     (TypedArrayElementSize object)))
              (byteOffsetEnd (%Add byteOffsetStart arrayByteLength))]
          (if (%Lt bufferByteLength byteOffsetStart)
              true
              (%Lt bufferByteLength byteOffsetEnd))))))

(builtin TypedArrayLength
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-typedarraylength"
  :spec-name "TypedArrayLength"
  :status partial
  :deviation "Represented TypedArrays always have an explicit fixed [[ArrayLength]]; length-tracking views are not represented."
  :params [(record dyn)] :ret dyn
  (%Box (%InternalIndex record)))

(builtin TypedArrayByteLength :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-typedarraybytelength"
  :spec-name "TypedArrayByteLength"
  :status partial
  :deviation "Represented TypedArrays have explicit fixed lengths and one-byte element types; length-tracking and wider element types are not represented."
  :params [(record dyn)] :ret dyn
  (%Box (%Mul (%InternalIndex record) (TypedArrayElementSize record))))

(builtin TypedArrayIndex :params [(propertyKey dyn)] :ret int
  (if (%IsString (%Box propertyKey))
      (let [(text (%UnboxString (%Box propertyKey)))]
        (if (%Lt (%StringLen text) 1)
            -1
            (let [(first (%StringCharCode text 0))]
              (if (if (%Le 48 first) (%Le first 57) false)
                  (if (if (%Lt 1 (%StringLen text)) (%Eq first 48) false)
                      -1
                      (loop [(cursor 0) (index 0)]
                        (if (%Eq cursor (%StringLen text))
                            index
                            (let [(code (%StringCharCode text cursor))]
                              (if (if (%Le 48 code) (%Le code 57) false)
                                  (let [(digit (%Sub code 48))]
                                    (if (if (%Lt 214748364 index)
                                            true
                                            (if (%Eq index 214748364) (%Lt 7 digit) false))
                                        -1
                                        (recur (%Add cursor 1)
                                               (%Add (%Mul index 10) digit))))
                                  -1)))))
                  -1))))
      -1))

(builtin TypedArrayGet :transitioning true :params [(array dyn) (index int)] :ret dyn
  (let [(length (%InternalIndex array))]
    (if (%Le length index)
        (%Box undefined)
        (let [(buffer (%InternalTarget array))
              (bytes (%InternalTarget buffer))
              (stored (%ArrayLoad bytes index))
              (byte (if (%IsUndefined stored) 0 (%UnboxInt stored)))]
          (if (IsUnsignedElementType (TypedArrayElementType array))
              (%Box byte)
              (%Box (if (%Le 128 byte) (%Sub byte 256) byte)))))))

(builtin TypedArraySet :transitioning true
  :params [(array dyn) (index int) (value dyn)] :ret dyn
  (let [(length (%InternalIndex array))]
    (if (%Le length index)
        (%Box value)
        (let [(tagged (%Box value))
              (number (ToInt32 tagged))
              (byte (%BitAnd number 255))
              (buffer (%InternalTarget array))
              (bytes (%InternalTarget buffer))
              (stored (%ArrayStore bytes index (%Box byte)))]
          tagged))))

(builtin NewTypedArray :transitioning true
  :params [(buffer dyn) (length int) (constructorKind int)] :ret dyn
  (let [(array (%Box (%NewObject)))
        (elementKind (if (%Eq constructorKind 26) 200 201))
        (initialized (%InternalInit array buffer elementKind))
        (lengthInitialized (%InternalSetIndex array length))
        (prototype (InitializeObjectPrototype array (BuiltinPrototypeValue constructorKind)))]
    array))

(builtin ConstructTypedArray :transitioning true
  :params [(constructorKind int) (source dyn)] :ret dyn
  (let [(initialized (TypedArrayConstructorValue constructorKind))]
    (if (IsArrayBuffer source)
        (NewTypedArray source (%InternalIndex source) constructorKind)
        (let [(length (if (%IsUndefined source) 0 (ToArrayBufferLength source)))
              (buffer (NewArrayBuffer length))]
          (NewTypedArray buffer length constructorKind)))))

(callable TypedArrayBufferGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotTypedArrayName)))]
    (%InternalTarget this)))

(callable TypedArrayByteLengthGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotTypedArrayName)))]
    (let [(record (MakeTypedArrayWithBufferWitnessRecord this 0))]
      (if (IsTypedArrayOutOfBounds record)
          (%Box 0)
          (TypedArrayByteLength record)))))

(callable TypedArrayByteOffsetGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotTypedArrayName)))]
    (let [(record (MakeTypedArrayWithBufferWitnessRecord this 0))]
      (if (IsTypedArrayOutOfBounds record) (%Box 0) (%Box 0)))))

(callable TypedArrayLengthGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotTypedArrayName)))]
    (let [(record (MakeTypedArrayWithBufferWitnessRecord this 0))]
      (if (IsTypedArrayOutOfBounds record)
          (%Box 0)
          (TypedArrayLength record)))))

(macro TypedArrayName :params [(constructorKind int)] :ret dyn
  (if (%Eq constructorKind 26) (%Box "Int8Array") (%Box "Uint8Array")))

;; `%TypedArray%` and `%TypedArray.prototype%` are realm intrinsics shared by every concrete
;; typed-array family. They need identities distinct from Int8Array/Uint8Array themselves: the
;; former is a constructor-capable function object and the latter is an ordinary prototype object.
(builtin TypedArrayIntrinsicConstructorValue :transitioning true :params [] :ret dyn
  (let [(constructor (%ErrorConstructor 28))
        (prototype (BuiltinPrototypeValue 29))
        (prototypeKey (ToPropertyKey "prototype"))
        (prototypeStored (%DefinePropertyValue constructor prototypeKey prototype))
        (prototypeMarked (%SetPropertyAttributes constructor prototypeKey 0))
        (linked (InitializeObjectPrototype constructor (BuiltinPrototypeValue 21)))]
    constructor))

(builtin TypedArrayConstructorValue :transitioning true
  :params [(constructorKind int)] :ret dyn
  (let [(constructor (BuiltinConstructorValue constructorKind))
        (prototype (BuiltinPrototypeValue constructorKind))
        (intrinsicConstructor (TypedArrayIntrinsicConstructorValue))
        (intrinsicPrototype (BuiltinPrototypeValue 29))
        (constructorLinked (InitializeObjectPrototype constructor intrinsicConstructor))
        (prototypeLinked (InitializeObjectPrototype prototype intrinsicPrototype))
        (lengthStored (%DefinePropertyValue constructor (ToPropertyKey "length") (%Box 3)))
        (lengthMarked (%SetPropertyAttributes constructor (ToPropertyKey "length") 4))
        (prototypeMarked (%SetPropertyAttributes constructor (ToPropertyKey "prototype") 0))
        (bytesPerElement
          (%DefinePropertyValue constructor (ToPropertyKey "BYTES_PER_ELEMENT") (%Box 1)))
        (bytesPerElementMarked
          (%SetPropertyAttributes constructor (ToPropertyKey "BYTES_PER_ELEMENT") 0))
        (prototypeBytesPerElement
          (%DefinePropertyValue prototype (ToPropertyKey "BYTES_PER_ELEMENT") (%Box 1)))
        (prototypeBytesPerElementMarked
          (%SetPropertyAttributes prototype (ToPropertyKey "BYTES_PER_ELEMENT") 0))
        (bufferGetter (%Box (closure TypedArrayBufferGetter0)))
        (bufferInstalled
          (InstallBuiltinGetter prototype (ToPropertyKey "buffer") bufferGetter
                                (%Box "get buffer")))
        (byteLengthGetter (%Box (closure TypedArrayByteLengthGetter0)))
        (byteLengthInstalled
          (InstallBuiltinGetter prototype (ToPropertyKey "byteLength") byteLengthGetter
                                (%Box "get byteLength")))
        (byteOffsetGetter (%Box (closure TypedArrayByteOffsetGetter0)))
        (byteOffsetInstalled
          (InstallBuiltinGetter prototype (ToPropertyKey "byteOffset") byteOffsetGetter
                                (%Box "get byteOffset")))
        (lengthGetter (%Box (closure TypedArrayLengthGetter0)))
        (lengthInstalled
          (InstallBuiltinGetter prototype (ToPropertyKey "length") lengthGetter
                                (%Box "get length")))
        (toStringTagKey (SymbolToStringTagValue))
        (toStringTag (%DefinePropertyValue prototype toStringTagKey
                                          (TypedArrayName constructorKind)))
        (toStringTagMarked (%SetPropertyAttributes prototype toStringTagKey 4))]
    constructor))

(macro ThrowTypedArrayCall :transitioning true :params [] :ret dyn
  (ThrowTypeError "Constructor TypedArray requires 'new'"))
