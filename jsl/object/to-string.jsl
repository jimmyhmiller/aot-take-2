;; https://tc39.es/ecma262/#sec-object.prototype.tostring
;;
;; Built-in namespace brands are properties of their stable DSL identities, not frontend syntax.
;; Symbol.toStringTag is not yet representable, but the ordinary primitive, callable, Array, Math,
;; and Object brands all live here so borrowed calls share one semantic operation.
(macro JSONObjectValue :params [] :ret dyn
  (%BuiltinObject 22))

;; Scripts have one stable global-object identity. The frontend decides when source `this` denotes
;; the script receiver; property storage, coercion, equality, and every observable operation on the
;; resulting value continue through the ordinary DSL object operations.
(macro GlobalObjectValue :params [] :ret dyn
  (%BuiltinObject 23))

;; The declarative half of a Realm's GlobalEnvironmentRecord is deliberately not reachable from
;; JavaScript. `let`, `const`, and `class` bindings live here while `var` and function declarations
;; remain properties of GlobalObjectValue. A stable runtime identity lets functions compiled from
;; an earlier Script observe bindings created by a later Script when they are eventually called.
(macro GlobalDeclarativeEnvironmentValue :params [] :ret dyn
  (%BuiltinObject 24))

(builtin ObjectPrototypeToString :transitioning true :params [(receiver dyn)] :ret dyn
  (if (%IsUndefined receiver) "[object Undefined]"
    (if (%IsNull receiver) "[object Null]"
      (if (StrictEqual receiver (MathObjectValue)) "[object Math]"
        (if (StrictEqual receiver (JSONObjectValue)) "[object JSON]"
          (if (%IsArray receiver) "[object Array]"
            (if (%IsFunction receiver) "[object Function]"
              (if (%IsString receiver) "[object String]"
                (if (%IsBool receiver) "[object Boolean]"
                  (if (%IsNumber receiver) "[object Number]" "[object Object]"))))))))))
