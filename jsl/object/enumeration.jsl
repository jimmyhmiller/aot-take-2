;; https://tc39.es/ecma262/#sec-object.keys
;; https://tc39.es/ecma262/#sec-object.values
;; https://tc39.es/ecma262/#sec-object.entries
;;
;; Like Torque's `GetOwnPropertyKeys`, the platform intrinsics expose a stable ordinal view of the
;; heap representation. Allocation, looping, value lookup, pair construction, and result layout
;; remain visible JSL semantics.
;; https://tc39.es/ecma262/#sec-ordinarycallbindthis
;; Function strictness is indexed frontend structure. Receiver substitution and primitive boxing
;; are JavaScript semantics and therefore live here, once at function entry rather than at each
;; call site or each read of `this`.
(builtin OrdinaryCallBindThisSloppy :transitioning true
  :params [(receiver dyn)] :ret dyn
  (if (%IsUndefined receiver) (GlobalObjectValue)
      (if (%IsNull receiver) (GlobalObjectValue) (ToObject receiver))))

;; https://tc39.es/ecma262/#sec-ordinaryownpropertykeys
;; `%OwnKeyCount`/`%OwnKeyAt` expose the representation's stable ordinal view.  The abstract
;; operation snapshots that view so every consumer observes one specification List even if later
;; callbacks mutate the source object.
(builtin OrdinaryOwnPropertyKeys :transitioning true :params [(object dyn)] :ret dyn
  (let [(keys (%NewArray))
        (count (%OwnKeyCount object))]
    (loop [(index 0)]
      (if (%Le count index)
          (%Box keys)
          (let [(stored (%ArrayStore keys index (%OwnKeyAt object index)))]
            (recur (%Add index 1)))))))

;; https://tc39.es/ecma262/#sec-string-exotic-objects-ownpropertykeys
;; The representation primitive contributes virtual character and length keys; ordering and the
;; selected receiver-family semantics remain explicit at this JSL boundary.
(macro StringOwnPropertyKeys :transitioning true :params [(object dyn)] :ret dyn
  (OrdinaryOwnPropertyKeys object))

;; The canonical internal-method entry point.  Generated families that declare an override may
;; never silently inherit the ordinary algorithm.
(builtin OwnPropertyKeys :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-ordinary-object-internal-methods-and-internal-slots-ownpropertykeys"
  :spec-name "[[OwnPropertyKeys]] ( )"
  :status partial
  :deviation "Proxy [[OwnPropertyKeys]] is not yet implemented."
  :params [(object dyn)] :ret dyn
  (if (UsesOrdinaryOwnPropertyKeys object)
      (OrdinaryOwnPropertyKeys object)
      (if (object-method-family-is object StringExoticMethods)
          (StringOwnPropertyKeys object)
          (if (HasInternalSlot object (InternalSlotStringData))
              (StringOwnPropertyKeys object)
              (ThrowTypeError "exotic [[OwnPropertyKeys]] method is not implemented")))))

;; One source step from Object.assign. The frontend repeats this macro for variadic source syntax;
;; all JavaScript behavior of a step remains here.
(builtin ObjectAssignSource :transitioning true :params [(target dyn) (source dyn)] :ret dyn
  (if (%Eq source (%Box null)) target
      (if (%Eq source (%Box undefined)) target
          (let [(from (ToObject source))
                (keys (OwnPropertyKeys from))
                (count (%ArrayLen keys))]
            (loop [(index 0)]
              (if (%Le count index) target
                  (let [(key (%ArrayLoad keys index))
                        (value (%PropLoadKey from key))
                        (stored (%PropStoreKey target key value))]
                    (recur (%Add index 1)))))))))

(builtin ObjectKeys :transitioning true :params [(object dyn)] :ret dyn
  (let [(target (ToObject object))
        (out (%NewArray))
        (keys (OwnPropertyKeys target))
        (count (%ArrayLen keys))]
    (loop [(index 0) (outIndex 0)]
      (if (%Le count index) out
          (let [(key (%ArrayLoad keys index))
                (attributes (%OwnPropertyAttributes target key))]
            (if (%Eq (%BitAnd attributes 2) 0)
                (recur (%Add index 1) outIndex)
                (let [(stored (%ArrayStore out outIndex key))]
                  (recur (%Add index 1) (%Add outIndex 1)))))))))

;; https://tc39.es/ecma262/#sec-copydataproperties
;; Excluded names are already canonical property keys: syntax lowering evaluates each computed key
;; once, then uses the same value for its named Get and for this list.
(builtin ObjectRestKeyExcluded :transitioning true :params [(excluded dyn) (key dyn)] :ret bool
  (loop [(index 0)]
    (if (%Le (%ArrayLen excluded) index)
        false
        (if (StringEquals (%ArrayLoad excluded index) key)
            true
            (recur (%Add index 1))))))

(builtin ObjectRest :transitioning true :params [(source dyn) (excluded dyn)] :ret dyn
  (let [(from (ToObject source))
        (out (%Box (%NewObject)))
        (initialized (InitializeOrdinaryObject out))
        (keys (OwnPropertyKeys from))
        (count (%ArrayLen keys))]
    (loop [(index 0)]
      (if (%Le count index)
          out
          (let [(key (%ArrayLoad keys index))
                (attributes (%OwnPropertyAttributes from key))]
            (if (if (ObjectRestKeyExcluded excluded key)
                    true
                    (%Eq (%BitAnd attributes 2) 0))
                (recur (%Add index 1))
                (let [(value (GetProperty from key))
                      (defined (%DefinePropertyValue out key value))
                      (marked (%SetPropertyAttributes out key 7))]
                  (recur (%Add index 1)))))))))

(builtin ObjectOwnPropertyNames :transitioning true :params [(object dyn)] :ret dyn
  (let [(target (ToObject object))
        (out (%NewArray))
        (keys (OwnPropertyKeys target))
        (count (%ArrayLen keys))]
    (loop [(index 0)]
      (if (%Le count index) out
          (let [(stored (%ArrayStore out index (%ArrayLoad keys index)))]
            (recur (%Add index 1)))))))

(callable ObjectOwnPropertyNames1
  :transitioning true :params [(object dyn)] :ret dyn
  (ObjectOwnPropertyNames object))

(builtin ObjectOwnPropertyNamesValue :transitioning true :params [] :ret dyn
  (let [(function (%Box (closure ObjectOwnPropertyNames1)))
        (lengthKey (ToPropertyKey "length"))
        (nameKey (ToPropertyKey "name"))
        (lengthStored (%DefinePropertyValue function lengthKey (%Box 1)))
        (lengthMarked (%SetPropertyAttributes function lengthKey 4))
        (nameStored (%DefinePropertyValue function nameKey (%Box "getOwnPropertyNames")))
        (nameMarked (%SetPropertyAttributes function nameKey 4))]
    function))

(builtin ObjectValues :transitioning true :params [(object dyn)] :ret dyn
  (let [(target (ToObject object))
        (out (%NewArray))
        (keys (OwnPropertyKeys target))
        (count (%ArrayLen keys))]
    (loop [(index 0) (outIndex 0)]
      (if (%Le count index) out
          (let [(key (%ArrayLoad keys index))
                (attributes (%OwnPropertyAttributes target key))]
            (if (%Eq (%BitAnd attributes 2) 0)
                (recur (%Add index 1) outIndex)
                (let [(stored (%ArrayStore out outIndex (%PropLoadKey target key)))]
                  (recur (%Add index 1) (%Add outIndex 1)))))))))

(builtin ObjectEntries :transitioning true :params [(object dyn)] :ret dyn
  (let [(target (ToObject object))
        (out (%NewArray))
        (keys (OwnPropertyKeys target))
        (count (%ArrayLen keys))]
    (loop [(index 0) (outIndex 0)]
      (if (%Le count index) out
          (let [(key (%ArrayLoad keys index))
                (attributes (%OwnPropertyAttributes target key))
                (pair (%NewArray))
                (key-store (%ArrayStore pair 0 key))
                (value-store (%ArrayStore pair 1 (%PropLoadKey target key)))
                (out-store (if (%Eq (%BitAnd attributes 2) 0)
                               (%Box undefined)
                               (%ArrayStore out outIndex (%Box pair))))]
            (if (%Eq (%BitAnd attributes 2) 0)
                (recur (%Add index 1) outIndex)
                (recur (%Add index 1) (%Add outIndex 1))))))))

;; https://tc39.es/ecma262/#sec-object.freeze
;; SetIntegrityLevel is representation-owned, like Torque's runtime intrinsic; the observable
;; operation and its primitive-value identity rule remain in JSL.
(builtin ObjectFreeze :transitioning true :params [(value dyn)] :ret dyn
  (if (%IsObject value)
      (let [(ignored (%ObjectFreeze value))] value)
      (if (%IsArray value)
          (let [(ignored (%ObjectFreeze value))] value)
          value)))
