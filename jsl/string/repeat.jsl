;; https://tc39.es/ecma262/#sec-string.prototype.repeat, over an already-coerced receiver and an
;; already-integral count.
;;
;; Steps 4-5 are the RangeError cases: a negative count, or +Infinity. Error CLASSES do not exist
;; yet (roadmap R03), so the throw carries the message and the class is the same documented
;; deviation `String.prototype.indexOf` step 1 has.
(builtin StringRepeatCount
  :transitioning true
  :params [(s dyn) (count int)]
  :ret dyn
  (if (%Lt count 0)
      (%Throw "RangeError: Invalid count value")
      (loop [(i 0) (out "")]
        (if (%Lt i count) (recur (%Add i 1) (%StringConcat out s)) out))))
