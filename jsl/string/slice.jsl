;; https://tc39.es/ecma262/#sec-string.prototype.slice, over an already-coerced receiver and
;; already-integral bounds.
;;
;; `slice` and `substring` differ in exactly two ways and both matter: slice maps a NEGATIVE index
;; to `len + index` where substring clamps it to 0, and slice returns the empty string when start
;; exceeds end where substring SWAPS them. `%Substring` implements the substring rule, so the
;; negative mapping and the ordering are done here before handing over.
;; The bounds arrive as machine indices; the negative-to-end mapping and the clamp are plain integer
;; arithmetic once they do.
(builtin StringSlice :transitioning true :params [(s dyn) (start int) (end int)] :ret dyn
  (let [(len (%StringLen s))
        (a (Clamp (if (%Lt start 0) (%Add len start) start) 0 len))
        (b (Clamp (if (%Lt end 0) (%Add len end) end) 0 len))]
    (if (%Le b a) "" (%Substring s a b))))
