;; https://tc39.es/ecma262/#sec-string.prototype.indexof
;;
;; All seven steps. The coerced core is kept separate so the other string builtins that share steps
;; 5-7 (startsWith, endsWith, includes) do not each re-derive the clamp.
;;
;; Steps 5-7, over an already-coerced receiver and search string. The surface position remains a
;; JavaScript value until this DSL boundary applies ToIntegerOrInfinity and saturation.
(builtin StringIndexOfFrom :transitioning true
  :params [(s dyn) (needle dyn) (position dyn)]
  :ret int
  (%StringIndexOf s needle (ClampedIndex position (%StringLen s))))

;; Steps 1-4, then the core.
;;
;; ToIntegerOrInfinity is not `|0`. The difference is observable: `|0` is ToInt32, so
;; it answers 0 for +Infinity, and `"abc".indexOf("c", Infinity)` would then find the `c` at index 2
;; instead of returning -1. It also wraps at 2^31 and mis-handles fractional positions the spec
;; truncates toward zero.
(builtin String.prototype.indexOf
  :transitioning true
  :params [(this dyn) (search dyn) (position dyn)]
  :ret dyn
  (let [(s      (%ToString (RequireObjectCoercible this)))
        (needle (%ToString search))]
    (%Box (StringIndexOfFrom s needle position))))

;; First-class prototype publication needs a closure, while the shared implementation above stays
;; a builtin. The callable contributes only the JavaScript receiver ABI and delegates all meaning.
(callable StringIndexOfMethod2
  :transitioning true :params [(search dyn) (position dyn)] :ret dyn
  (String.prototype.indexOf this search position))
