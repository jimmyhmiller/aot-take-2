;; https://tc39.es/ecma262/#sec-string.prototype.padend. Same shape as padStart, appending instead.
(builtin StringPadEnd :transitioning true :params [(s dyn) (target int) (filler dyn)] :ret dyn
  (let [(len (%StringLen s))]
    (if (%Le target len)
        s
        (if (%Eq (%StringLen filler) 0)
            s
            (loop [(pad "")]
              (if (%Lt (%StringLen pad) (%Sub target len))
                  (recur (%StringConcat pad filler))
                  (%StringConcat s (%Substring pad 0 (%Sub target len)))))))))
