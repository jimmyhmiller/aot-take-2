;; https://tc39.es/ecma262/#sec-string.prototype.replaceall, for a STRING pattern and a STRING
;; replacement. The function-replacement and RegExp forms need `%Call` and a regexp engine and are
;; not expressible; they are absent rather than approximated.
;;
;; THE EMPTY PATTERN IS THE WHOLE DIFFICULTY. `"abc".replaceAll("", "-")` is `"-a-b-c-"`: the match
;; is between every code unit and at both ends, so advancing by the pattern's length would not
;; advance at all. Stepping by `max(1, len(pattern))` past each hit is what terminates, and copying
;; the skipped code unit is what keeps the receiver intact.
;; https://tc39.es/ecma262/#sec-string.prototype.replace, for a STRING pattern and a STRING
;; replacement -- the FIRST occurrence only, which is the whole difference from replaceAll. The
;; empty pattern matches at position 0, so `"abc".replace("", "-")` is `"-abc"`. Like
;; StringReplaceAll below, `$`-substitution in the replacement (GetSubstitution) is not
;; implemented: the replacement is inserted literally.
(builtin StringReplaceFirst
  :transitioning true
  :params [(s dyn) (pattern dyn) (replacement dyn)]
  :ret dyn
  (let [(hit (%StringIndexOf s pattern 0))
        (slen (%StringLen s))]
    (if (%Lt hit 0)
        s
        (%StringConcat (%StringConcat (%Substring s 0 hit) replacement)
                       (%Substring s (%Add hit (%StringLen pattern)) slen)))))

;; The represented entry for String.prototype.replace. The @@replace interception is the exact
;; GetMethod/Call prefix from ECMA-262; the fallback delegates to the existing literal replacement
;; core. Functional replacement and GetSubstitution remain explicit limitations of that core.
(builtin StringReplaceValue
  :transitioning true
  :params [(thisValue dyn) (searchValue dyn) (replaceValue dyn)]
  :ret dyn
  (let [(receiver (RequireObjectCoercible thisValue))
        (search (%Box searchValue))]
    (if (%IsObject search)
        (let [(replaceKey (SymbolReplaceValue))
              (replacer (GetMethod search replaceKey))]
          (if (%IsUndefined replacer)
              (StringReplaceFirst (ToStringValue receiver)
                                  (ToStringValue search)
                                  (ToStringValue replaceValue))
              (Call replacer search receiver (%Box replaceValue))))
        (StringReplaceFirst (ToStringValue receiver)
                            (ToStringValue search)
                            (ToStringValue replaceValue)))))

(builtin StringReplaceAll
  :transitioning true
  :params [(s dyn) (pattern dyn) (replacement dyn)]
  :ret dyn
  (let [(plen (%StringLen pattern))
        (slen (%StringLen s))]
    (loop [(from 0) (out "")]
      (if (%Lt slen from)
          out
          (let [(hit (%StringIndexOf s pattern from))]
            (if (%Lt hit 0)
                (%StringConcat out (%Substring s from slen))
                (let [(head (%StringConcat out (%Substring s from hit)))
                      (with (%StringConcat head replacement))]
                  (if (%Eq plen 0)
                      (if (%Le slen hit)
                          with
                          (recur (%Add hit 1)
                                 (%StringConcat with (%Substring s hit (%Add hit 1)))))
                      (recur (%Add hit plen) with)))))))))
