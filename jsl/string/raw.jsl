;; https://tc39.es/ecma262/#sec-string.raw
;; Variadic syntax is packaged by the frontend into `substitutions`; coercion, raw-segment lookup,
;; truncation of surplus substitutions, and concatenation order are all library semantics here.
(builtin StringRaw :transitioning true :params [(template dyn) (substitutions dyn)] :ret dyn
  (let [(cooked (ToObject template))
        (raw (ToObject (GetProperty cooked "raw")))
        (literal-count (ToMachineLength (LengthOfArrayLike raw) 2147483647))
        (substitution-count (%ArrayLen substitutions))]
    (if (%Le literal-count 0) ""
        (loop [(index 0) (result "")]
          (let [(with-literal
                  (StringConcat result
                                (ToStringValue (GetProperty raw index))))]
            (if (%Le literal-count (%Add index 1))
                with-literal
                (let [(with-substitution
                        (if (%Lt index substitution-count)
                            (StringConcat with-literal
                                          (ToStringValue (%ArrayLoad substitutions index)))
                            with-literal))]
                  (recur (%Add index 1) with-substitution))))))))
