;; The single-code-unit accessors, over an already-coerced receiver and an already-integral index.

;; https://tc39.es/ecma262/#sec-string.prototype.charat — the empty string for an out-of-range
;; index, which is what distinguishes it from `at` and from `charCodeAt`.
(builtin StringCharAt :params [(s dyn) (i int)] :ret dyn
  (if (%Lt i 0) ""
    (if (%Le (%StringLen s) i) ""
      (%Substring s i (%Add i 1)))))

;; https://tc39.es/ecma262/#sec-string.prototype.charcodeat — NaN out of range.
;;
;; THE BOUNDS ARE THIS WRAPPER'S BUSINESS, and the comment here used to say the opposite: that
;; `%StringCharCode` answers NaN itself. It does, and that was the bug. The atom's contract is
;; IN-BOUNDS ONLY (docs/DEMOLITION.md strike 0), and the runtime honoured the out-of-range case by
;; returning a TAGGED NaN where the in-range case returns a raw code unit -- one primitive, two
;; machine representations, chosen at run time. Nothing downstream can be right about both:
;; `String("abcdef".charCodeAt(99))` selected an integer conversion, read the NaN box as an
;; integer, and printed nineteen digits where node prints "NaN".
;;
;; Guarded here, every path leaves as a tagged word and the atom is only ever called in bounds.
(builtin StringCharCodeAt :params [(s dyn) (i int)] :ret dyn
  (if (%Lt i 0)
      (%Box (NaN))
      (if (%Le (%StringLen s) i)
          (%Box (NaN))
          (%Box (%StringCharCode s i)))))

;; https://tc39.es/ecma262/#sec-string.prototype.codepointat. A leading surrogate combines only
;; with a following trailing surrogate; lone surrogates are returned as their own code unit.
(builtin StringCodePointAt :params [(s dyn) (i int)] :ret dyn
  (if (%Lt i 0) (%Box undefined)
    (if (%Le (%StringLen s) i) (%Box undefined)
      (let [(first (%StringCharCode s i))]
        (if (if (%Le 55296 first) (%Le first 56319) false)
            (if (%Lt (%Add i 1) (%StringLen s))
                (let [(second (%StringCharCode s (%Add i 1)))]
                  (if (if (%Le 56320 second) (%Le second 57343) false)
                      (%Box (%Add 65536
                              (%Add (%Mul (%Sub first 55296) 1024)
                                    (%Sub second 56320))))
                      (%Box first)))
                (%Box first))
            (%Box first))))))

;; https://tc39.es/ecma262/#sec-string.prototype.at — a negative index counts from the end, and
;; anything still out of range is `undefined` rather than the empty string.
;;
;; THE SUBSTRING IS BOXED AND `charAt`'s IS NOT, and the difference is the return type rather than a
;; preference. `charAt` answers a string on every path, so every path is a raw string pointer and
;; the Phi is one representation. `at` answers `undefined` out of range, which is a TAGGED word, so
;; an unboxed substring on the other arm makes the Phi a pointer on one side and a tag on the
;; other. That verifies clean and reads whichever the consumer assumes: `"abc".at(-1) === "c"` was
;; false, comparing a raw pointer against a tagged word, and `String("abc".at(1))` failed selection
;; outright. A value that can be `undefined` has to be tagged the whole way.
(builtin StringAt :transitioning true :params [(s dyn) (i dyn)] :ret dyn
  (let [(k (RelativeIndex i (%StringLen s)))]
    (if (%Lt k 0) (%Box undefined) (%Box (%Substring s k (%Add k 1))))))
