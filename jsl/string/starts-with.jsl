;; https://tc39.es/ecma262/#sec-string.prototype.startswith, over already-coerced arguments.
;; `indexOf` reports the first occurrence at or after the clamped position. It is a prefix at that
;; position exactly when the occurrence starts there. An omitted position arrives as `undefined`,
;; whose ToIntegerOrInfinity value is zero.
(builtin StringStartsWith
  :transitioning true
  :params [(s dyn) (needle dyn) (position dyn)]
  :ret dyn
  (let [(at (ClampedIndex position (%StringLen s)))]
    (%Box (%Eq (%StringIndexOf s needle at) at))))
