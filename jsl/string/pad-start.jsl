;; https://tc39.es/ecma262/#sec-string.prototype.padstart, over already-coerced arguments.
;;
;; Spec step 5: if the target length is not greater than the receiver's, return it unchanged; the
;; filler is truncated to exactly the shortfall. Building the pad one code unit at a time is what
;; keeps the truncation exact for a multi-character filler.
(builtin StringPadStart
  :transitioning true
  :params [(s dyn) (target int) (filler dyn)]
  :ret dyn
  (let [(len (%StringLen s))]
    (if (%Le target len)
        s
        (if (%Eq (%StringLen filler) 0)
            s
            (loop [(pad "")]
              (if (%Lt (%StringLen pad) (%Sub target len))
                  (recur (%StringConcat pad filler))
                  (%StringConcat (%Substring pad 0 (%Sub target len)) s)))))))
