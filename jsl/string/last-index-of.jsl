;; https://tc39.es/ecma262/#sec-string.prototype.lastindexof, over already-coerced arguments.
;;
;; Returns an UNBOXED index, like `StringIndexOfFrom`. The library's rule is that internal helpers
;; hand back machine values and only entry points box: the backend treats a `dyn`-typed Phi as
;; already boxed, so boxing the result of a loop that carries raw integers emits no box at all.
;;
;; Walks forward keeping the LAST match rather than scanning backwards, because the primitive is a
;; forward `%StringIndexOf`. Each step resumes one past the previous hit, so the loop runs once per
;; occurrence rather than once per code unit.
;;
;; NaN is deliberately detected after ToNumber and before ToIntegerOrInfinity: lastIndexOf gives
;; NaN (including an omitted or undefined position) the value +Infinity, whereas ordinary index
;; conversion would turn it into zero. The forward search stops when its next hit lies beyond the
;; clamped limit. The `from > limit` guard is also what makes an empty needle terminate.
(builtin StringLastIndexOf
  :transitioning true
  :params [(s dyn) (needle dyn) (position dyn)]
  :ret int
  (let [(len (%StringLen s))
        (number (ToNumberValue position))
        (limit (if (IsNaNValue number) len (ClampedIndex number len)))]
    (loop [(from 0) (best -1)]
      (if (%Lt limit from)
          best
          (let [(hit (%StringIndexOf s needle from))]
            (if (%Lt hit 0)
                best
                (if (%Lt limit hit) best (recur (%Add hit 1) hit))))))))
