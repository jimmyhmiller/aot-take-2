;; https://tc39.es/ecma262/#sec-string.prototype.trim and its two halves.
;;
;; WHITESPACE IS THE SPEC'S SET, NOT `<= 0x20`. TrimString removes WhiteSpace and LineTerminator,
;; which is a specific list: tab, LF, VT, FF, CR, space, NBSP, ZWNBSP and the Unicode Zs category.
;; The Zs category beyond NBSP needs a Unicode table this runtime does not have, so this covers the
;; ASCII set plus NBSP and ZWNBSP and NOTHING ELSE — a rarely-hit deviation, recorded in docs/JSL.md
;; rather than papered over by trimming everything below a threshold.
(builtin IsTrimmable :params [(c dyn)] :ret bool
  (if (%Eq c 32) true
    (if (%Eq c 9) true
      (if (%Eq c 10) true
        (if (%Eq c 11) true
          (if (%Eq c 12) true
            (if (%Eq c 13) true
              (if (%Eq c 160) true
                (%Eq c 65279)))))))))

(builtin StringTrimStart :transitioning true :params [(s dyn)] :ret dyn
  (let [(len (%StringLen s))]
    (loop [(i 0)]
      (if (%Le len i) ""
        (if (IsTrimmable (%StringCharCode s i))
            (recur (%Add i 1))
            (%Substring s i len))))))

(builtin StringTrimEnd :transitioning true :params [(s dyn)] :ret dyn
  (loop [(n (%StringLen s))]
    (if (%Le n 0) ""
      (if (IsTrimmable (%StringCharCode s (%Sub n 1)))
          (recur (%Sub n 1))
          (%Substring s 0 n)))))

(builtin StringTrim :transitioning true :params [(s dyn)] :ret dyn
  (StringTrimEnd (StringTrimStart s)))
