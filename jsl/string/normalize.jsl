;; https://tc39.es/ecma262/#sec-string.prototype.normalize
;; Form selection and the invalid-form RangeError are JavaScript policy and therefore stay here.
;; `%StringNormalize` is only the platform Unicode operation, analogous to a Torque extern macro.
(builtin StringNormalize :params [(s dyn) (form dyn)] :ret dyn
  (if (%StringEq form "NFC")
      (%StringNormalize s 0)
      (if (%StringEq form "NFD")
          (%StringNormalize s 1)
          (if (%StringEq form "NFKC")
              (%StringNormalize s 2)
              (if (%StringEq form "NFKD")
                  (%StringNormalize s 3)
                  (%Throw "RangeError: The normalization form should be one of NFC, NFD, NFKC, NFKD"))))))
