;; https://tc39.es/ecma262/#sec-string.prototype.tolowercase and toUpperCase.
;;
;; ASCII ONLY, and that is the whole reason these can be written here. Full case mapping is a
;; Unicode TABLE with no algorithm a DSL could express — but neither runtime ever had that table:
;; both open-coded the same `A`–`Z`/`a`–`z` shift, once in the evaluator and once in C. So the
;; "irreducible primitive" was a loop over `%StringNew`/`%StringSetUnit` all along, and the two
;; hand-written copies are deleted with this file. When real case mapping arrives it arrives as a
;; primitive that reaches a table, not as a second implementation of this loop.
;;
;; THE STRING IS THREADED THROUGH THE ACCUMULATOR, never discarded. `%StringSetUnit` answers the
;; same string it wrote, so `out` carries a data dependence from each write to the next, and that
;; dependence is the ONLY thing that orders them — the runtime accepts unit `i` only when units
;; `0..i-1` are already written, and refuses a read of a string with a hole in it.
(builtin StringToLowerCase :params [(s dyn)] :ret dyn
  (let [(len (%StringLen s))]
    (loop [(i 0) (out (%StringNew len))]
      (if (%Le len i)
          out
          (let [(u (%StringCharCode s i))
                (m (if (%Lt u 65) u (if (%Lt 90 u) u (%Add u 32))))]
            (recur (%Add i 1) (%StringSetUnit out i m)))))))

(builtin StringToUpperCase :params [(s dyn)] :ret dyn
  (let [(len (%StringLen s))]
    (loop [(i 0) (out (%StringNew len))]
      (if (%Le len i)
          out
          (let [(u (%StringCharCode s i))
                (m (if (%Lt u 97) u (if (%Lt 122 u) u (%Sub u 32))))]
            (recur (%Add i 1) (%StringSetUnit out i m)))))))
