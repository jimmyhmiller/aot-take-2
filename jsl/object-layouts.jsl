; Specification-pinned internal-slot Lists accepted by object creation operations. Generated from
; spec/object-layouts.json until 2026-08-29; the JSON and its generator are gone and this is now
; ordinary source, edited directly like every other unit in lib/.
; PrivateElements is deliberately absent: ordinary object creation appends it exactly once.

(internal-method-family OrdinaryObjectMethods)
(internal-method-family ArrayExoticMethods)
(internal-method-family MappedArgumentsExoticMethods)
(internal-method-family StringExoticMethods)
(internal-method-family ProxyExoticMethods)

(internal-method GetPrototypeOf)
(internal-method SetPrototypeOf)
(internal-method IsExtensible)
(internal-method PreventExtensions)
(internal-method GetOwnProperty)
(internal-method DefineOwnProperty)
(internal-method HasProperty)
(internal-method Get)
(internal-method Set)
(internal-method Delete)
(internal-method OwnPropertyKeys)

(macro UsesOrdinaryGetPrototypeOf :params [(object dyn)] :ret bool (object-method-is-ordinary object GetPrototypeOf))
(macro UsesOrdinarySetPrototypeOf :params [(object dyn)] :ret bool (object-method-is-ordinary object SetPrototypeOf))
(macro UsesOrdinaryIsExtensible :transitioning true :params [(object dyn)] :ret bool (object-method-is-ordinary object IsExtensible))
(macro UsesOrdinaryPreventExtensions :params [(object dyn)] :ret bool (object-method-is-ordinary object PreventExtensions))
(macro UsesOrdinaryGetOwnProperty :params [(object dyn)] :ret bool (object-method-is-ordinary object GetOwnProperty))
(macro UsesOrdinaryDefineOwnProperty :params [(object dyn)] :ret bool (object-method-is-ordinary object DefineOwnProperty))
(macro UsesOrdinaryHasProperty :transitioning true :params [(object dyn)] :ret bool (object-method-is-ordinary object HasProperty))
(macro UsesOrdinaryGet :params [(object dyn)] :ret bool (object-method-is-ordinary object Get))
(macro UsesOrdinarySet :params [(object dyn)] :ret bool (object-method-is-ordinary object Set))
(macro UsesOrdinaryDelete :params [(object dyn)] :ret bool (object-method-is-ordinary object Delete))
(builtin UsesOrdinaryOwnPropertyKeys :transitioning true :params [(object dyn)] :ret bool (object-method-is-ordinary object OwnPropertyKeys))

(internal-slot PrivateElements spec-list)
(internal-slot Prototype js-value)
(internal-slot Extensible boolean)
(internal-slot ParameterMap js-value)
(internal-slot StringData js-value)
(internal-slot DataView boolean)
(internal-slot ViewedArrayBuffer js-value)
(internal-slot ByteLength js-value)
(internal-slot ByteOffset js-value)
(internal-slot ProxyHandler js-value)
(internal-slot ProxyTarget js-value)

(slot-list OrdinaryObjectBase [Prototype Extensible])
(slot-list MappedArgumentsBase [Prototype Extensible ParameterMap])
(slot-list StringExoticBase [Prototype Extensible StringData])
(slot-list DataViewObjectBase [Prototype Extensible DataView ViewedArrayBuffer ByteLength ByteOffset])
(slot-list ProxyExoticBase [ProxyHandler ProxyTarget])
