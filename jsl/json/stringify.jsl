;; https://tc39.es/ecma262/#sec-json.stringify
;;
;; The serializer, recursive traversal, omission rules, cycle detection, and quoting live in JSL.
;; Runtime primitives expose only representation-owned string, array, object, and own-key access.

(builtin JsonHexChar :params [(digit int)] :ret str
  (%StringFromCode (if (%Lt digit 10) (%Add digit 48) (%Add digit 87))))

(builtin JsonEscapeCodeUnit :transitioning true :params [(code int)] :ret str
  (let [(slash (%StringFromCode 92))]
    (if (%Eq code 34) (%StringConcat slash (%StringFromCode 34))
      (if (%Eq code 92) (%StringConcat slash slash)
        (if (%Eq code 8) (%StringConcat slash "b")
          (if (%Eq code 9) (%StringConcat slash "t")
            (if (%Eq code 10) (%StringConcat slash "n")
              (if (%Eq code 12) (%StringConcat slash "f")
                (if (%Eq code 13) (%StringConcat slash "r")
                  (if (%Lt code 32)
                      (%StringConcat
                        (%StringConcat (%StringConcat slash "u") "00")
                        (%StringConcat
                          (JsonHexChar (%Shr code 4))
                          (JsonHexChar (%BitAnd code 15))))
                      (%StringFromCode code)))))))))))

(builtin JsonQuoteString :transitioning true :params [(value dyn)] :ret str
  (let [(quote (%StringFromCode 34))
        (length (%StringLen value))]
    (loop [(index 0 int) (out quote str)]
      (if (%Le length index)
          (%StringConcat out quote)
          (recur (%Add index 1)
                 (%StringConcat out
                   (JsonEscapeCodeUnit (%StringCharCode value index))))))))

(builtin JsonStackContains :params [(stack dyn) (value dyn)] :ret bool
  (let [(length (%ArrayLen stack))]
    (loop [(index 0 int)]
      (if (%Le length index) false
          (if (%Eq (%ArrayLoad stack index) value)
              true
              (recur (%Add index 1)))))))

(macro JsonCircularError :params [] :ret dyn
  (%Throw "TypeError: Converting circular structure to JSON"))

(builtin JsonGap :params [(space dyn)] :ret str
  (if (IsNumber space)
      (let [(integer (%ToInteger space))
            (count (if (%IsInt integer)
                       (let [(raw (%UnboxInt integer))]
                         (if (%Lt raw 0) 0 (if (%Lt 10 raw) 10 raw)))
                       (if (%Lt (%UnboxFlt integer) 0.0) 0 10)))]
        (loop [(index 0 int) (out "" str)]
          (if (%Le count index) out
              (recur (%Add index 1) (%StringConcat out " ")))))
      (if (%IsString space)
          (%Substring (%UnboxString space) 0
                      (if (%Lt 10 (%StringLen space)) 10 (%StringLen space)))
          "")))

(builtin JsonPropertyListContains :transitioning true :params [(list dyn) (key dyn)] :ret bool
  (let [(length (%ArrayLen list))]
    (loop [(index 0 int)]
      (if (%Le length index) false
          (if (StringEquals (%ArrayLoad list index) key)
              true
              (recur (%Add index 1)))))))

(builtin JsonBuildPropertyList :transitioning true
  :params [(replacer dyn) (index int) (length int) (out dyn)] :ret dyn
  (if (%Le length index) out
      (let [(item (%ArrayLoad replacer index))
            (key (if (%IsString item) item
                     (if (IsNumber item) (%Box (ToStringValue item)) (%Box undefined))))]
        (if (%IsUndefined key)
            (JsonBuildPropertyList replacer (%Add index 1) length out)
            (if (JsonPropertyListContains out key)
                (JsonBuildPropertyList replacer (%Add index 1) length out)
                (let [(ignored (%ArrayStore out (%ArrayLen out) key))]
                  (JsonBuildPropertyList replacer (%Add index 1) length out)))))))

(builtin JsonPropertyList :transitioning true :params [(replacer dyn)] :ret dyn
  (if (%IsArray replacer)
      (let [(out (%BoxArray (%NewArray)))]
        (JsonBuildPropertyList replacer 0 (%ArrayLen replacer) out))
      (%Box undefined)))

(builtin JsonApplyToJSON :transitioning true
  :params [(value dyn) (key dyn)] :ret dyn
  (if (if (%IsObject value) true (%IsArray value))
      (let [(receiver (if (%IsArray value)
                          (%UnboxArray value)
                          (%UnboxObj value)))
            (method (%PropLoadNamed receiver "toJSON"))]
        (if (%IsFunction method)
            (Call method receiver (%Box key))
            value))
      value))

(builtin JsonApplyReplacer :transitioning true
  :params [(value dyn) (key dyn) (holder obj) (replacer dyn)] :ret dyn
  (if (%IsFunction replacer)
      (Call replacer holder (%Box key) (%Box value))
      value))

;; The plain path is deliberately separate from the replacer path. A literal "no replacer" flag
;; would still construct the callback arm before folding, leaving an invalid call target and dead
;; merge values in the graph. Torque uses specialized builtins for this same reason: distinct
;; calling shapes should be distinct generated functions, not a runtime flag over an illegal arm.
(builtin JsonStringifyPlainArray :transitioning true
  :params [(array dyn) (stack dyn) (replacer dyn) (propertyList dyn)
           (gap str) (indent str)] :ret dyn
  (if (JsonStackContains stack array) (JsonCircularError)
      (let [(depth (%ArrayLen stack))
            (pushed (%ArrayStore stack depth array))
            (length (%ArrayLen array))
            (nextIndent (%StringConcat indent gap))
            (body
              (loop [(index 0 int) (out "" str)]
                (if (%Le length index) out
                    (let [(serialized
                            (JsonStringifyPlainValue
                              (%ArrayLoad array index)
                              (%Box (ToStringValue (%Box index))) (%UnboxArray array) stack
                              replacer propertyList gap nextIndent))
                          (piece (if (%IsUndefined serialized)
                                     "null" (%UnboxString serialized)))
                          (next (%StringConcat out
                                  (%StringConcat
                                    (if (%Eq (%StringLen gap) 0)
                                        (if (%Eq index 0) "" ",")
                                        (%StringConcat
                                          (if (%Eq index 0) "\n" ",\n") nextIndent))
                                    piece)))]
                      (recur (%Add index 1) next)))))
            (result (%StringConcat
                      (%StringConcat "[" body)
                      (if (if (%Eq (%StringLen gap) 0) true (%Eq length 0))
                          "]" (%StringConcat (%StringConcat "\n" indent) "]"))))
            (popped (%ArrayResize stack depth (%Box result)))]
        (%Box result))))

(builtin JsonStringifyPlainObjectMembers :transitioning true
  :params [(object dyn) (stack dyn) (replacer dyn) (propertyList dyn)
           (gap str) (indent str) (index int) (count int) (out dyn)] :ret dyn
  (if (%Le count index) out
      (let [(key (if (%IsArray propertyList)
                     (%ArrayLoad propertyList index)
                     (%ArrayLoad propertyList index)))
            (serialized
              (JsonStringifyPlainValue (%PropLoadKey object key) key (%UnboxObj object) stack
                                       replacer propertyList gap indent))]
        (if (%IsUndefined serialized)
            (JsonStringifyPlainObjectMembers object stack replacer propertyList gap indent
                                             (%Add index 1) count out)
            (let [(member (%StringConcat
                            (%StringConcat (JsonQuoteString key)
                              (if (%Eq (%StringLen gap) 0) ":" ": "))
                            (%UnboxString serialized)))
                  (next (%StringConcat out
                          (%StringConcat
                            (if (%Eq (%StringLen gap) 0)
                                (if (%Eq (%StringLen out) 0) "" ",")
                                (%StringConcat
                                  (if (%Eq (%StringLen out) 0) "\n" ",\n") indent))
                            member)))]
              (JsonStringifyPlainObjectMembers object stack replacer propertyList gap indent
                                               (%Add index 1) count next))))))

(builtin JsonStringifyPlainObject :transitioning true
  :params [(object dyn) (stack dyn) (replacer dyn) (propertyList dyn)
           (gap str) (indent str)] :ret dyn
  (if (JsonStackContains stack object) (JsonCircularError)
      (let [(depth (%ArrayLen stack))
            (pushed (%ArrayStore stack depth object))
            (nextIndent (%StringConcat indent gap))
            (keys (if (%IsArray propertyList) propertyList (OwnPropertyKeys object)))
            (count (%ArrayLen keys))
            (body (JsonStringifyPlainObjectMembers
                    object stack replacer keys gap nextIndent 0 count ""))
            (result (%StringConcat
                      (%StringConcat "{" body)
                      (if (if (%Eq (%StringLen gap) 0) true (%Eq (%StringLen body) 0))
                          "}" (%StringConcat (%StringConcat "\n" indent) "}"))))
            (popped (%ArrayResize stack depth (%Box result)))]
        (%Box result))))

(builtin JsonStringifyPlainValue :transitioning true
  :params [(input dyn) (key dyn) (holder obj) (stack dyn) (replacer dyn)
           (propertyList dyn) (gap str) (indent str)] :ret dyn
  (let [(jsonValue (JsonApplyToJSON input key))
        (value (JsonApplyReplacer jsonValue key holder replacer))]
    (if (%IsString value) (%Box (JsonQuoteString value))
      (if (%IsBool value) (%Box (ToStringValue value))
        (if (%IsNull value) (%Box "null")
          (if (IsNumber value)
              (if (IsFiniteNumber value)
                  (%Box (ToStringValue value))
                  (%Box "null"))
            (if (%IsArray value)
                (JsonStringifyPlainArray value stack replacer propertyList gap indent)
              (if (%IsObject value)
                  (JsonStringifyPlainObject value stack replacer propertyList gap indent)
                (%Box undefined)))))))))

;; Internal serializer results are tagged strings, or tagged undefined for a value which the
;; surrounding object must omit. Arrays translate that same sentinel to the JSON token `null`.
(builtin JSONStringifyWithOptions :transitioning true
  :params [(value dyn) (replacer dyn) (space dyn)] :ret dyn
  (let [(holder (%NewObject))
        (stored (%PropStoreKey holder (%Box "") (%Box value)))
        (normalizedReplacer (%Box replacer))
        (normalizedSpace (%Box space))
        (propertyList (JsonPropertyList normalizedReplacer))
        (gap (JsonGap normalizedSpace))]
    (JsonStringifyPlainValue (%PropLoadKey holder (%Box "")) (%Box "") holder
                             (%BoxArray (%NewArray)) normalizedReplacer propertyList gap "")))

(macro JSONStringify :transitioning true :params [(value dyn)] :ret dyn
  (JSONStringifyWithOptions value (%Box undefined) (%Box undefined)))
