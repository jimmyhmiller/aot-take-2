;; https://tc39.es/ecma262/#sec-json.parse
;;
;; The grammar, cursor movement, allocation, and property population live here. Runtime primitives
;; only expose representation operations (UTF-16 code units, managed allocation, and property
;; access), following Torque's split between generated builtin semantics and runtime capabilities.
;; A parse result is a two-element managed array: boxed value followed by boxed next index. This
;; keeps mutually recursive builtin signatures within JSL's ordinary value vocabulary.

(macro JsonSyntaxError :params [] :ret dyn
  (%Throw "SyntaxError: Unexpected token in JSON"))

(builtin JsonResult :transitioning true :params [(text dyn) (value dyn) (next int)] :ret dyn
  (let [(result (%NewArray))
        ;; StringLen reifies the cursor's raw integer representation after control-flow joins.
        (nextInt (%StringLen (%Substring text 0 next)))
        ;; Every parser arm supplies a tagged JavaScript value; ArrayStore consumes it directly.
        ;; Boxing here would double-tag numbers, booleans, null, arrays, and objects natively.
        (valueStore (%ArrayStore result 0 value))
        (nextStore (%ArrayStore result 1 (%Box nextInt)))]
    result))

(macro JsonIsDigit :params [(code int)] :ret bool
  (if (%Lt code 48) false (%Le code 57)))

(macro JsonIsNonzeroDigit :params [(code int)] :ret bool
  (if (%Lt code 49) false (%Le code 57)))

(builtin JsonIsWhitespace :params [(code int)] :ret bool
  (if (%Eq code 32) true
      (if (%Eq code 10) true
          (if (%Eq code 13) true (%Eq code 9)))))

(builtin JsonSkipWhitespace :transitioning true :params [(text dyn) (index int)] :ret int
  (let [(length (%StringLen text))]
    (loop [(cursor index int)]
      (if (%Le length cursor) cursor
          (if (JsonIsWhitespace (%StringCharCode text cursor))
              (recur (%Add cursor 1))
              cursor)))))

(builtin JsonHexDigit :params [(code int)] :ret int
  (if (if (%Le 48 code) (%Le code 57) false) (%Sub code 48)
      (if (if (%Le 65 code) (%Le code 70) false) (%Sub code 55)
          (if (if (%Le 97 code) (%Le code 102) false) (%Sub code 87) -1))))

(builtin JsonHex4 :transitioning true :params [(text dyn) (index int)] :ret int
  (let [(a (JsonHexDigit (%StringCharCode text index)))
        (b (JsonHexDigit (%StringCharCode text (%Add index 1))))
        (c (JsonHexDigit (%StringCharCode text (%Add index 2))))
        (d (JsonHexDigit (%StringCharCode text (%Add index 3))))]
    (if (%Lt a 0) -1
        (if (%Lt b 0) -1
            (if (%Lt c 0) -1
                (if (%Lt d 0) -1
                    (%Add (%Add (%Mul a 4096) (%Mul b 256))
                          (%Add (%Mul c 16) d))))))))

(builtin JsonStringEnd :transitioning true :params [(text dyn) (index int)] :ret int
  (let [(length (%StringLen text))]
    (loop [(cursor (%Add index 1) int)]
      (if (%Le length cursor) (JsonSyntaxError)
          (let [(code (%StringCharCode text cursor))]
            (if (%Eq code 34)
                (%Add cursor 1)
                (if (%Lt code 32) (JsonSyntaxError)
                    (if (%Eq code 92)
                        (let [(escapeIndex (%Add cursor 1))]
                          (if (%Le length escapeIndex) (JsonSyntaxError)
                              (let [(escape (%StringCharCode text escapeIndex))]
                                (if (%Eq escape 117)
                                    (if (%Lt length (%Add escapeIndex 5)) (JsonSyntaxError)
                                        (let [(unit (JsonHex4 text (%Add escapeIndex 1)))]
                                          (if (%Lt unit 0) (JsonSyntaxError)
                                              (recur (%Add escapeIndex 5)))))
                                    (let [(unit
                                            (if (%Eq escape 34) 34
                                              (if (%Eq escape 92) 92
                                                (if (%Eq escape 47) 47
                                                  (if (%Eq escape 98) 8
                                                    (if (%Eq escape 102) 12
                                                      (if (%Eq escape 110) 10
                                                        (if (%Eq escape 114) 13
                                                          (if (%Eq escape 116) 9 -1)))))))))]
                                      (if (%Lt unit 0) (JsonSyntaxError)
                                          (recur (%Add escapeIndex 1))))))))
                        (recur (%Add cursor 1))))))))))

(builtin JsonDecodeString :transitioning true :params [(text dyn) (index int) (end int)] :ret dyn
  (loop [(cursor (%Add index 1) int) (out "" str)]
    (if (%Le (%Sub end 1) cursor) out
        (let [(code (%StringCharCode text cursor))]
          (if (%Eq code 92)
              (let [(escapeIndex (%Add cursor 1))
                    (escape (%StringCharCode text escapeIndex))]
                (if (%Eq escape 117)
                    (recur (%Add escapeIndex 5)
                           (%StringConcat out
                                          (%StringFromCode
                                            (JsonHex4 text (%Add escapeIndex 1)))))
                    (let [(unit
                            (if (%Eq escape 34) 34
                              (if (%Eq escape 92) 92
                                (if (%Eq escape 47) 47
                                  (if (%Eq escape 98) 8
                                    (if (%Eq escape 102) 12
                                      (if (%Eq escape 110) 10
                                        (if (%Eq escape 114) 13 9))))))))]
                      (recur (%Add escapeIndex 1)
                             (%StringConcat out (%StringFromCode unit))))))
              (recur (%Add cursor 1)
                     (%StringConcat out (%StringFromCode code))))))))

(builtin JsonParseString :transitioning true :params [(text dyn) (index int)] :ret dyn
  (let [(end (JsonStringEnd text index))
        (value (JsonDecodeString text index end))]
    (JsonResult text (%Box value) end)))

(builtin JsonScanDigits :params [(text dyn) (index int)] :ret int
  (let [(length (%StringLen text))]
    (loop [(cursor index int)]
      (if (%Le length cursor) cursor
          (if (JsonIsDigit (%StringCharCode text cursor))
              (recur (%Add cursor 1))
              cursor)))))

(builtin JsonParseNumber :transitioning true :params [(text dyn) (index int)] :ret dyn
  (let [(length (%StringLen text))
        (integerStart
          (if (%Eq (%StringCharCode text index) 45) (%Add index 1) index))]
    (if (%Le length integerStart) (JsonSyntaxError)
        (let [(first (%StringCharCode text integerStart))
              (integerEnd
                (if (%Eq first 48)
                    (%Add integerStart 1)
                    (if (JsonIsNonzeroDigit first)
                        (JsonScanDigits text (%Add integerStart 1))
                        (JsonSyntaxError))))]
          (if (if (%Lt integerEnd length)
                  (JsonIsDigit (%StringCharCode text integerEnd))
                  false)
              (JsonSyntaxError)
              (let [(fractionEnd
                      (if (if (%Lt integerEnd length)
                              (%Eq (%StringCharCode text integerEnd) 46)
                              false)
                          (let [(digits (%Add integerEnd 1))]
                            (if (if (%Lt digits length)
                                    (JsonIsDigit (%StringCharCode text digits))
                                    false)
                                (JsonScanDigits text (%Add digits 1))
                                (JsonSyntaxError)))
                          integerEnd))
                    (exponentCode
                      (if (%Lt fractionEnd length)
                          (%StringCharCode text fractionEnd)
                          -1))
                    (end
                      (if (if (%Eq exponentCode 101) true (%Eq exponentCode 69))
                          (let [(afterE (%Add fractionEnd 1))
                                (signed
                                  (if (%Lt afterE length)
                                      (let [(sign (%StringCharCode text afterE))]
                                        (if (if (%Eq sign 43) true (%Eq sign 45))
                                            (%Add afterE 1)
                                            afterE))
                                      afterE))]
                            (if (if (%Lt signed length)
                                    (JsonIsDigit (%StringCharCode text signed))
                                    false)
                                (JsonScanDigits text (%Add signed 1))
                                (JsonSyntaxError)))
                          fractionEnd))]
                (JsonResult text (%ParseFloat (%Substring text index end)) end)))))))

(builtin JsonLiteralAt :transitioning true :params [(text dyn) (index int) (literal dyn) (value dyn)] :ret dyn
  (let [(end (%Add index (%StringLen literal)))]
    (if (if (%Le end (%StringLen text))
            (%StringEq (%Substring text index end) literal)
            false)
        (JsonResult text value end)
        (JsonSyntaxError))))

(builtin JsonParseArrayElements :transitioning true
  :params [(text dyn) (cursor int) (out dyn) (element int)] :ret dyn
  (let [(parsed (JsonParseValue text cursor))
        (value (%ArrayLoad parsed 0))
        (afterValue (%UnboxInt (%ArrayLoad parsed 1)))
        (stored (%ArrayStore out element value))
        (after (JsonSkipWhitespace text afterValue))]
    (if (%Le (%StringLen text) after) (JsonSyntaxError)
        (let [(punctuation (%StringCharCode text after))]
          (if (%Eq punctuation 93)
              (%Box (%Add after 1))
              (if (%Eq punctuation 44)
                  (JsonParseArrayElements text
                    (JsonSkipWhitespace text (%Add after 1)) out (%Add element 1))
                  (JsonSyntaxError)))))))

(builtin JsonParseArray :transitioning true :params [(text dyn) (index int)] :ret dyn
  (let [(out (%NewArray))
        (start (JsonSkipWhitespace text (%Add index 1)))
        (end
          (if (if (%Lt start (%StringLen text))
                  (%Eq (%StringCharCode text start) 93)
                  false)
              (%Add start 1)
              (%UnboxInt (JsonParseArrayElements text start out 0))))]
    (JsonResult text (%Box out) end)))

(builtin JsonParseObjectMembers :transitioning true
  :params [(text dyn) (cursor int) (out dyn)] :ret dyn
  (if (if (%Lt cursor (%StringLen text))
          (%Eq (%StringCharCode text cursor) 34)
          false)
      (let [(keyResult (JsonParseString text cursor))
            (key (%ArrayLoad keyResult 0))
            (afterKey (JsonSkipWhitespace text (%UnboxInt (%ArrayLoad keyResult 1))))]
        (if (if (%Lt afterKey (%StringLen text))
                (%Eq (%StringCharCode text afterKey) 58)
                false)
            (let [(parsed
                    (JsonParseValue text (JsonSkipWhitespace text (%Add afterKey 1))))
                  (value (%ArrayLoad parsed 0))
                  (stored (%PropStoreKey out key value))
                  (after
                    (JsonSkipWhitespace text (%UnboxInt (%ArrayLoad parsed 1))))]
              (if (%Le (%StringLen text) after) (JsonSyntaxError)
                  (let [(punctuation (%StringCharCode text after))]
                    (if (%Eq punctuation 125)
                        (%Box (%Add after 1))
                        (if (%Eq punctuation 44)
                            (JsonParseObjectMembers text
                              (JsonSkipWhitespace text (%Add after 1)) out)
                            (JsonSyntaxError))))))
            (JsonSyntaxError)))
      (JsonSyntaxError)))

(builtin JsonParseObject :transitioning true :params [(text dyn) (index int)] :ret dyn
  (let [(out (%Box (%NewObject)))
        (start (JsonSkipWhitespace text (%Add index 1)))
        (end
          (if (if (%Lt start (%StringLen text))
                  (%Eq (%StringCharCode text start) 125)
                  false)
              (%Add start 1)
              (%UnboxInt (JsonParseObjectMembers text start out))))]
    (JsonResult text out end)))

(builtin JsonParseValue :transitioning true :params [(text dyn) (index int)] :ret dyn
  (let [(cursor (JsonSkipWhitespace text index))]
    (if (%Le (%StringLen text) cursor) (JsonSyntaxError)
        (let [(code (%StringCharCode text cursor))]
          (if (%Eq code 34) (JsonParseString text cursor)
              (if (%Eq code 91) (JsonParseArray text cursor)
                  (if (%Eq code 123) (JsonParseObject text cursor)
                      (if (%Eq code 116) (JsonLiteralAt text cursor "true" (%Box true))
                          (if (%Eq code 102) (JsonLiteralAt text cursor "false" (%Box false))
                              (if (%Eq code 110) (JsonLiteralAt text cursor "null" (%Box null))
                                  (if (if (%Eq code 45) true (JsonIsDigit code))
                                      (JsonParseNumber text cursor)
                                      (JsonSyntaxError))))))))))))

;; InternalizeJSONProperty walks children before invoking the reviver. Object keys are copied before
;; traversal because a child callback may delete a sibling or add a new property; neither operation
;; changes the spec's snapshot. Parsed arrays begin dense, so their copied enumerable index keys are
;; also the spec's initial `[0, length)` list and retain future indices if an earlier callback deletes
;; them.

(builtin JsonReviveObjectKeys :transitioning true
  :params [(object dyn) (reviver dyn) (keys dyn) (index int) (count int)] :ret dyn
  (if (%Le count index) object
      (let [(key (%ArrayLoad keys index))
            (revived (JsonReviveProperty object key reviver))]
        (if (%IsUndefined revived)
            (let [(ignored (if (%IsArray object)
                               (%PropDeleteKey (%UnboxArray object) key)
                               (%PropDeleteKey object key)))]
              (JsonReviveObjectKeys object reviver keys (%Add index 1) count))
            (let [(ignored (%PropStoreKey object key revived))]
              (JsonReviveObjectKeys object reviver keys (%Add index 1) count))))))

(builtin JsonReviveProperty :transitioning true
  :params [(holder dyn) (key dyn) (reviver dyn)] :ret dyn
  (let [(value (%PropLoadKey holder key))
        (walked
          (if (%IsArray value)
              (let [(keys (ObjectKeys value))]
                (JsonReviveObjectKeys value reviver keys 0 (%ArrayLen keys)))
              (if (%IsObject value)
                  (let [(keys (ObjectKeys value))]
                    (JsonReviveObjectKeys value reviver keys 0 (%ArrayLen keys)))
                  value)))]
    (Call reviver holder key walked)))

(builtin JSONParseWithReviver :transitioning true
  :params [(value dyn) (reviver dyn)] :ret dyn
  (let [(callback (%Box reviver))
        (parsed (JSONParse value))]
    (if (%IsFunction callback)
        (let [(holder (%Box (%NewObject)))
              (stored (%PropStoreKey holder (%Box "") parsed))]
          (JsonReviveProperty holder (%Box "") callback))
        parsed)))

(builtin JSONParse :transitioning true :params [(value dyn)] :ret dyn
  (let [(text (ToStringValue (%Box value)))
        (parsed (JsonParseValue text 0))
        (end (JsonSkipWhitespace text (%UnboxInt (%ArrayLoad parsed 1))))]
    (if (%Eq end (%StringLen text))
        (%ArrayLoad parsed 0)
        (JsonSyntaxError))))
