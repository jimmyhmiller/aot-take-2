;; The global-object surface. Each `intrinsic` declares one published root and expands into
;; one demand-loadable `builtin` per property, so a consumer never initializes an unrelated
;; constructor. This replaces spec/intrinsics.json and tools/intrinsic-manifest.mjs, which
;; existed only because JSL had no declaration-level macro; see `jsl-read-intrinsic!`.
;;
;; ORDER IS PART OF THE FORMAT. A declaration's position here is its closed-world function
;; index, so `intrinsic-initializer` is written where its declaration belongs.

(intrinsic %Number% :runtime-kind 19
  (data "length" NumberConstructorLengthValue :value (number 1) :configurable true)
  (data "name" NumberConstructorNameValue :value (string "Number") :configurable true)
  (data "prototype" NumberConstructorPrototypeValue :value prototype)
  (data "EPSILON" NumberEpsilonValue :value (jsl NumberEpsilon))
  (data "MAX_SAFE_INTEGER" NumberMaxSafeIntegerValue :value (jsl NumberMaxSafeInteger))
  (data "MAX_VALUE" NumberMaxValueValue :value (jsl NumberMaxValue))
  (data "MIN_SAFE_INTEGER" NumberMinSafeIntegerValue :value (jsl NumberMinSafeInteger))
  (data "MIN_VALUE" NumberMinValueValue :value (jsl NumberMinValue))
  (data "NaN" NumberNaNValue :value (jsl NumberNaN))
  (data "NEGATIVE_INFINITY" NumberNegativeInfinityValue :value (jsl NumberNegativeInfinity))
  (data "POSITIVE_INFINITY" NumberPositiveInfinityValue :value (jsl NumberPositiveInfinity)))

(intrinsic %Symbol% :runtime-kind 22
  (data "length" SymbolConstructorLengthValue :value (number 0) :configurable true)
  (data "name" SymbolConstructorNameValue :value (string "Symbol") :configurable true)
  (data "prototype" SymbolConstructorPrototypeValue :value prototype)
  (method "for" SymbolForValue
    :closure SymbolFor1
    :name "for"
    :length 1
    :writable true
    :configurable true)
  (method "keyFor" SymbolKeyForValue
    :closure SymbolKeyFor1
    :name "keyFor"
    :length 1
    :writable true
    :configurable true)
  (method "valueOf" SymbolPrototypeValueOfValue
    :target prototype
    :closure SymbolValueOf0
    :name "valueOf"
    :length 0
    :writable true
    :configurable true)
  (method "toString" SymbolPrototypeToStringValue
    :target prototype
    :closure SymbolToString0
    :name "toString"
    :length 0
    :writable true
    :configurable true)
  (accessor "description" SymbolPrototypeDescriptionAccessor
    :target prototype
    :getter SymbolDescriptionGetter0
    :getter-name "get description"
    :configurable true)
  (data "constructor" SymbolPrototypeConstructorValue
    :target prototype
    :value constructor
    :writable true
    :configurable true)
  (method "@@toPrimitive" SymbolPrototypeToPrimitiveValue
    :target prototype
    :key-root SymbolToPrimitiveValue
    :closure SymbolToPrimitive1
    :name "[Symbol.toPrimitive]"
    :length 1
    :configurable true)
  (data "@@toStringTag" SymbolPrototypeToStringTagValue
    :target prototype
    :key-root SymbolToStringTagValue
    :value (string "Symbol")
    :configurable true)
  (well-known-symbol "iterator" SymbolIteratorValue :description "Symbol.iterator")
  (well-known-symbol "asyncIterator" SymbolAsyncIteratorValue :description "Symbol.asyncIterator")
  (well-known-symbol "dispose" SymbolDisposeValue :description "Symbol.dispose")
  (well-known-symbol "asyncDispose" SymbolAsyncDisposeValue :description "Symbol.asyncDispose")
  (well-known-symbol "hasInstance" SymbolHasInstanceValue :description "Symbol.hasInstance")
  (well-known-symbol "isConcatSpreadable" SymbolIsConcatSpreadableValue
    :description "Symbol.isConcatSpreadable")
  (well-known-symbol "match" SymbolMatchValue :description "Symbol.match")
  (well-known-symbol "matchAll" SymbolMatchAllValue :description "Symbol.matchAll")
  (well-known-symbol "replace" SymbolReplaceValue :description "Symbol.replace")
  (well-known-symbol "search" SymbolSearchValue :description "Symbol.search")
  (well-known-symbol "species" SymbolSpeciesValue :description "Symbol.species")
  (well-known-symbol "split" SymbolSplitValue :description "Symbol.split")
  (well-known-symbol "toPrimitive" SymbolToPrimitiveValue :description "Symbol.toPrimitive")
  (well-known-symbol "toStringTag" SymbolToStringTagValue :description "Symbol.toStringTag")
  (well-known-symbol "unscopables" SymbolUnscopablesValue :description "Symbol.unscopables"))

(intrinsic %DataView% :runtime-kind 30
  (method "getInt8" DataViewGetInt8Value
    :target prototype
    :closure DataViewGetInt8
    :name "getInt8"
    :length 1
    :writable true
    :configurable true)
  (method "getUint8" DataViewGetUint8Value
    :target prototype
    :closure DataViewGetUint8
    :name "getUint8"
    :length 1
    :writable true
    :configurable true)
  (method "getInt16" DataViewGetInt16Value
    :target prototype
    :closure DataViewGetInt16
    :name "getInt16"
    :length 1
    :writable true
    :configurable true)
  (method "getUint16" DataViewGetUint16Value
    :target prototype
    :closure DataViewGetUint16
    :name "getUint16"
    :length 1
    :writable true
    :configurable true)
  (method "getInt32" DataViewGetInt32Value
    :target prototype
    :closure DataViewGetInt32
    :name "getInt32"
    :length 1
    :writable true
    :configurable true)
  (method "getUint32" DataViewGetUint32Value
    :target prototype
    :closure DataViewGetUint32
    :name "getUint32"
    :length 1
    :writable true
    :configurable true)
  (method "setInt8" DataViewSetInt8Value
    :target prototype
    :closure DataViewSetInt8
    :name "setInt8"
    :length 2
    :writable true
    :configurable true)
  (method "setUint8" DataViewSetUint8Value
    :target prototype
    :closure DataViewSetUint8
    :name "setUint8"
    :length 2
    :writable true
    :configurable true)
  (method "setInt16" DataViewSetInt16Value
    :target prototype
    :closure DataViewSetInt16
    :name "setInt16"
    :length 2
    :writable true
    :configurable true)
  (method "setUint16" DataViewSetUint16Value
    :target prototype
    :closure DataViewSetUint16
    :name "setUint16"
    :length 2
    :writable true
    :configurable true)
  (method "setInt32" DataViewSetInt32Value
    :target prototype
    :closure DataViewSetInt32
    :name "setInt32"
    :length 2
    :writable true
    :configurable true)
  (method "setUint32" DataViewSetUint32Value
    :target prototype
    :closure DataViewSetUint32
    :name "setUint32"
    :length 2
    :writable true
    :configurable true))

(intrinsic-initializer NumberConstructorValue %Number%)
