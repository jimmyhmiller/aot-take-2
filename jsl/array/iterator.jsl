;; https://tc39.es/ecma262/#sec-createarrayiterator
;; The three internal slots are representation-owned primitives, analogous to V8's Torque-declared
;; JSArrayIterator fields. Everything observable—live length, exhaustion, values and result object
;; layout—is ordinary JSL.
(builtin CreateArrayIterator :params [(array dyn) (kind int)] :ret dyn
  (let [(iterator (%Box (%NewObject)))
        (initialized (%InternalInit iterator array kind))]
    iterator))

(macro ArrayKeys :transitioning true :params [(array dyn)] :ret dyn (CreateArrayIterator array 0))
(macro ArrayValues :transitioning true :params [(array dyn)] :ret dyn (CreateArrayIterator array 1))
(macro ArrayEntries :transitioning true :params [(array dyn)] :ret dyn (CreateArrayIterator array 2))

(builtin CreateIteratorResultObject :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-createiterresultobject"
  :spec-name "CreateIteratorResultObject"
  :status partial
  :deviation "BigInt iterator values are outside the represented frontend/runtime value surface."
  :params [(value dyn) (done bool)] :ret dyn
  (let [(result (%Box (%NewObject)))
        (initialized (InitializeOrdinaryObject result))
        (value-stored (CreateDataPropertyOrThrow result "value" value))
        (done-stored (CreateDataPropertyOrThrow result "done" done))]
    result))

;; https://tc39.es/ecma262/#sec-%arrayiteratorprototype%.next
(builtin ArrayIteratorNext :transitioning true :params [(iterator dyn)] :ret dyn
  (let [(required (RequireInternalSlot iterator (InternalSlotIteratedArrayLike)))
        (index (%InternalIndex iterator))]
    (if (%Lt index 0)
        (CreateIteratorResultObject (%Box undefined) true)
        (let [(array (%InternalTarget iterator))
              (length (%ArrayLen array))]
          (if (%Le length index)
              (let [(exhausted (%InternalSetIndex iterator -1))]
                (CreateIteratorResultObject (%Box undefined) true))
              (let [(kind (%InternalKind iterator))
                    (advanced (%InternalSetIndex iterator (%Add index 1)))
                    (value
                      (if (%Eq kind 0)
                          (%Box index)
                          (if (%Eq kind 1)
                              (%ArrayLoad array index)
                              (let [(entry (%NewArray))
                                    (key-stored (%ArrayStore entry 0 (%Box index)))
                                    (value-stored (%ArrayStore entry 1 (%ArrayLoad array index)))]
                                (%Box entry)))))]
                (CreateIteratorResultObject value false)))))))

;; https://tc39.es/ecma262/#sec-getiterator, restricted to the one iterable this closed world has
;; a representation for. There are no Symbols here, so there is no @@iterator to look up: an array
;; answers with %ArrayIteratorPrototype% and everything else is a TypeError. It THROWS rather than
;; iterating zero times, because `for (const c of "abc")` is a real program this cannot run yet and
;; an empty body would look like a correct answer.
(builtin GetIterator :transitioning true :params [(value dyn)] :ret dyn
  (if (%IsArray value)
      ;; The JavaScript value arrives tagged at this DSL seam. The iterator's internal target is
      ;; representation-owned and raw, so normalize it exactly once here.
      (ArrayValues (%UnboxArray value))
      (%Throw "TypeError: value is not iterable")))

;; https://tc39.es/ecma262/#sec-iteratorcomplete and #sec-iteratorvalue: the two questions
;; `for ... of` asks of the object `next` hands back. `done` is stored through SetProperty, so it
;; arrives boxed and the `if` is ordinary JavaScript truthiness -- which `If` owns end to end.
(builtin IteratorComplete :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-iteratorcomplete"
  :spec-name "IteratorComplete"
  :status partial
  :deviation "BigInt done values, Proxy iterator-result objects, and several exotic-object [[Get]] receiver families are not yet implemented."
  :params [(result dyn)] :ret bool
  (if (GetProperty result "done") true false))

(builtin IteratorValue :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-iteratorvalue"
  :spec-name "IteratorValue"
  :status partial
  :deviation "Proxy iterator-result objects and several exotic-object [[Get]] receiver families are not yet implemented."
  :params [(result dyn)] :ret dyn
  (GetProperty result "value"))

;; Array literal accumulation lives here rather than in syntax lowering because source positions
;; stop being array indices as soon as a spread expands to more than one value. These operations
;; own the observable append, elision, and iterator protocol while the frontend only preserves
;; source order and identifies which grammar production it saw.
(builtin ArrayLiteralAppend :params [(out dyn) (value dyn)] :ret dyn
  (let [(stored (%ArrayStore out (%ArrayLen out) value))] out))

(builtin ArrayLiteralElide :params [(out dyn)] :ret dyn
  (let [(resized (%ArrayResize out (%Add (%ArrayLen out) 1) out))] out))

(builtin ArrayLiteralSpread :transitioning true :params [(out dyn) (iterable dyn)] :ret dyn
  (let [(iterator (GetIterator iterable))]
    (loop []
      (let [(step (ArrayIteratorNext iterator))]
        (if (IteratorComplete step)
            out
            (let [(stored (%ArrayStore out (%ArrayLen out) (IteratorValue step)))]
              (recur)))))))

;; https://tc39.es/ecma262/#sec-runtime-semantics-iteratorbindinginitialization
;; A rest binding consumes every remaining iterator value into a fresh ordinary Array. The
;; frontend identifies only the structural `...` element and hands its live iterator here; all
;; iteration, completion checks, value extraction, allocation, and append semantics stay in JSL.
(builtin IteratorRestArray :transitioning true :params [(iterator dyn)] :ret dyn
  (let [(out (NewArray))]
    (loop []
      (let [(step (ArrayIteratorNext iterator))]
        (if (IteratorComplete step)
            out
            (let [(stored (%ArrayStore out (%ArrayLen out) (IteratorValue step)))]
              (recur)))))))
