; Abrupt completions raised by the language itself (docs/DECISIONS.md, TypeError objects). A
; TypeError is an object on %TypeError.prototype% — the realm always materializes `TypeError` — with
; the message; the pending word carries it and the result is the exception sentinel, which every
; caller tests (docs/DECISIONS.md, exceptions are a sentinel completion).
(builtin JsThrowTypeError :transitioning true :noinline true :throws true :params [(message dyn)] :ret dyn
  (let [(ctor (JsGetNamed (%GlobalObject) (%PropertyKey "TypeError")))]
    (if (%IsException ctor)
        ctor
        (let [(error (JsOrdinaryCreateFromConstructor ctor))]
          (if (%IsException error)
              error
              (let [(described (JsDefineOwnNamed error (%PropertyKey "message") message))]
                (if (%IsException described)
                    described
                    (%SetPendingException error))))))))

; A RangeError raised by the language (an invalid array length): the same shape over %RangeError%,
; which every realm that materializes `Array` materializes too.
(builtin JsThrowRangeError :transitioning true :noinline true :throws true :params [(message dyn)] :ret dyn
  (let [(ctor (JsGetNamed (%GlobalObject) (%PropertyKey "RangeError")))]
    (if (%IsException ctor)
        ctor
        (let [(error (JsOrdinaryCreateFromConstructor ctor))]
          (if (%IsException error)
              error
              (let [(described (JsDefineOwnNamed error (%PropertyKey "message") message))]
                (if (%IsException described)
                    described
                    (%SetPendingException error))))))))
