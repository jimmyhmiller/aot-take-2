; Abrupt completions raised by the language itself (docs/DECISIONS.md, TypeError objects). A
; TypeError is an object on %TypeError.prototype% — the realm always materializes `TypeError` — with
; the message; the pending word carries it and the enclosing source function's next pending check
; unwinds. The result stands in for the operation's value on the (dead) fall-through.
(builtin JsThrowTypeError :transitioning true :noinline true :params [(message dyn)] :ret dyn
  (let [(ctor (JsGetNamed (%GlobalObject) (%PropertyKey "TypeError")))]
    (let [(error (JsOrdinaryCreateFromConstructor ctor))]
      (let [(described (JsDefineOwnNamed error (%PropertyKey "message") message))]
        (let [(pending (%SetPendingException error))]
          (%Undefined))))))
