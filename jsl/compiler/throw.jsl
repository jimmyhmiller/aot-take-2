; Abrupt completions raised by the language itself (docs/DECISIONS.md, TypeError objects). A
; TypeError is an object on %TypeError.prototype% — the realm always materializes `TypeError` — with
; the message; the pending word carries it and the result is the exception sentinel, which every
; caller tests (docs/DECISIONS.md, exceptions are a sentinel completion).
; Language-raised errors use intrinsic prototype identities, never the mutable global
; constructor binding. The private fresh object's message is an own writable/configurable,
; non-enumerable data property (attributes 5); inherited setters cannot observe its creation.

; A missing object-environment binding raises the realm's intrinsic ReferenceError, regardless
; of writes to the global constructor or its .prototype property. The intrinsic prototype is
; an owned image identity that realm assembly must bind, as for other intrinsic references.
; No message is required by GetValue; omitting it also avoids observable property setters.
(builtin JsThrowReferenceError :transitioning true :noinline true :throws true :params [] :ret never
  (let [(error (JsFinishObjectLiteral
                (JsSetObjectLiteralPrototype (JsNewObjectRaw) (%IntrinsicPrototype "ReferenceError.prototype"))))]
    (%SetPendingException error)))

(builtin JsThrowTypeError :transitioning true :noinline true :throws true :params [(message dyn)] :ret never
  (let [(error (JsSetObjectLiteralPrototype (JsNewObjectRaw) (%IntrinsicPrototype "TypeError.prototype")))
        (described (JsCreateDataPropertyAttrs error (%PropertyKey "message") message 5))]
    (%SetPendingException (JsFinishObjectLiteral described))))

; A RangeError raised by the language (an invalid array length): the same shape over %RangeError%,
; which every realm that materializes `Array` materializes too.
(builtin JsThrowRangeError :transitioning true :noinline true :throws true :params [(message dyn)] :ret never
  (let [(error (JsSetObjectLiteralPrototype (JsNewObjectRaw) (%IntrinsicPrototype "RangeError.prototype")))
        (described (JsCreateDataPropertyAttrs error (%PropertyKey "message") message 5))]
    (%SetPendingException (JsFinishObjectLiteral described))))

; Declaration conflicts are runtime SyntaxErrors in the realm evaluating the Script.
(builtin JsThrowSyntaxError :transitioning true :noinline true :throws true :params [] :ret never
  (let [(error (JsFinishObjectLiteral
                (JsSetObjectLiteralPrototype (JsNewObjectRaw) (%IntrinsicPrototype "SyntaxError.prototype"))))]
    (%SetPendingException error)))
