; String.prototype and String (docs/DECISIONS.md, strings; ECMA-262 §22.1). A primitive string's
; properties resolve on %String.prototype% without a wrapper object, so every method receives the
; primitive as `this`; a receiver that is not a string is a TypeError until wrapper objects exist
; (docs/GAPS.md, strings). Iteration is recursion over an index (JSL has no loop form). Positions
; go through ToIntegerOrInfinity via ToNumber and the ToInt truncation, which takes NaN to 0 and
; saturates the infinities, and are then clamped into the string.
;
; The slot ABI cannot tell an omitted argument from undefined (docs/DECISIONS.md, intrinsics):
; `concat` and `fromCharCode` stop at the first undefined argument, and an explicit `undefined`
; for a position or a fill string is read as absent.

(macro JsStringReceiver :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsString this)
      this
      (JsThrowTypeError (%Box "String.prototype method called on a non-string value"))))

(macro JsToIntegerOrZero :params [(v dyn)] :ret int
  (%ToInteger (JsPrimitiveNumber v)))

(macro JsClampIndex :params [(i int) (len int)] :ret int
  (if (%Lt i 0) 0 (if (%Lt len i) len i)))

; A relative index: negative counts from the end; then clamped into [0, len].
(macro JsRelativeClamp :params [(i int) (len int)] :ret int
  (if (%Lt i 0)
      (let [(r (%Add len i))] (if (%Lt r 0) 0 r))
      (if (%Lt len i) len i)))

; StrWhiteSpaceChar (§12.2, §12.3): WhiteSpace and LineTerminator code units.
(macro JsStrWhiteSpaceUnit :params [(u int)] :ret bool
  (if (%Eq u 32) (%Eq 0 0)
      (if (%And (%Not (%Lt u 9)) (%Not (%Lt 13 u))) (%Eq 0 0)
          (if (%Eq u 160) (%Eq 0 0)
              (if (%Eq u 5760) (%Eq 0 0)
                  (if (%And (%Not (%Lt u 8192)) (%Not (%Lt 8202 u))) (%Eq 0 0)
                      (if (%Eq u 8232) (%Eq 0 0)
                          (if (%Eq u 8233) (%Eq 0 0)
                              (if (%Eq u 8239) (%Eq 0 0)
                                  (if (%Eq u 8287) (%Eq 0 0)
                                      (if (%Eq u 12288) (%Eq 0 0)
                                          (%Eq u 65279))))))))))))

; A string's integer-indexed properties are its code units (§10.4.3.5); past the end, the ordinary
; lookup (which reaches the prototype and then undefined).
(builtin JsStringIndexGet :transitioning true :throws true :params [(string dyn) (index int) (key dyn)] :ret dyn
  (let [(raw (%UnboxString string))]
    (if (%Lt index (%StringLength raw))
        (%Box (%Substring raw index (%Add index 1)))
        (JsGetNamed string (JsToPropertyKey key)))))

; Does `needle` occur in `raw` at position k? `j` counts matched units.
(builtin JsStringMatchAt :params [(raw str) (needle str) (k int) (j int) (nlen int)] :ret bool
  (if (%Lt j nlen)
      (if (%Eq (%StringCharCode raw (%Add k j)) (%StringCharCode needle j))
          (JsStringMatchAt raw needle k (%Add j 1) nlen)
          (%Eq 0 1))
      (%Eq 0 0)))

; The first occurrence of `needle` in `raw` at or after k, or -1.
(builtin JsStringIndexOfFrom :params [(raw str) (needle str) (k int) (len int) (nlen int)] :ret int
  (if (%Lt len (%Add k nlen))
      -1
      (if (JsStringMatchAt raw needle k 0 nlen)
          k
          (JsStringIndexOfFrom raw needle (%Add k 1) len nlen))))

; The last occurrence of `needle` in `raw` at or before k, or -1.
(builtin JsStringLastIndexOfFrom :params [(raw str) (needle str) (k int) (nlen int)] :ret int
  (if (%Lt k 0)
      -1
      (if (JsStringMatchAt raw needle k 0 nlen)
          k
          (JsStringLastIndexOfFrom raw needle (%Sub k 1) nlen))))

; charAt(pos) (§22.1.3.1)
(builtin JsStringCharAt :transitioning true :throws true :params [(this dyn) (pos dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s)) (i (JsToIntegerOrZero pos))]
          (if (%Lt i 0)
              (%Box "")
              (if (%Lt i (%StringLength raw))
                  (%Box (%Substring raw i (%Add i 1)))
                  (%Box "")))))))

; charCodeAt(pos) (§22.1.3.2): NaN outside the string.
(builtin JsStringCharCodeAt :transitioning true :throws true :params [(this dyn) (pos dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s)) (i (JsToIntegerOrZero pos))]
          (if (%Lt i 0)
              (%Box (%Div (%ToFloat 0) (%ToFloat 0)))
              (if (%Lt i (%StringLength raw))
                  (%BoxInt (%StringCharCode raw i))
                  (%Box (%Div (%ToFloat 0) (%ToFloat 0)))))))))

; at(index) (§22.1.3.1): a relative index; undefined outside the string.
(builtin JsStringAt :transitioning true :throws true :params [(this dyn) (index dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s)) (i (JsToIntegerOrZero index))]
          (let [(len (%StringLength raw))]
            (let [(k (if (%Lt i 0) (%Add len i) i))]
              (if (%Lt k 0)
                  (%Undefined)
                  (if (%Lt k len)
                      (%Box (%Substring raw k (%Add k 1)))
                      (%Undefined)))))))))

; indexOf(searchString [, position]) (§22.1.3.9)
(builtin JsStringIndexOf :transitioning true :throws true :params [(this dyn) (search dyn) (pos dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s)) (needle (%UnboxString (JsToString search)))]
          (let [(len (%StringLength raw))]
            (%BoxInt (JsStringIndexOfFrom raw needle (JsClampIndex (JsToIntegerOrZero pos) len) len (%StringLength needle))))))))

; lastIndexOf(searchString [, position]) (§22.1.3.11): an absent or NaN position searches from the end.
(builtin JsStringLastIndexOf :transitioning true :throws true :params [(this dyn) (search dyn) (pos dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s)) (needle (%UnboxString (JsToString search))) (n (JsPrimitiveNumber pos))]
          (let [(len (%StringLength raw)) (nlen (%StringLength needle))]
            (let [(start (if (%Eq n n) (JsClampIndex (%ToInteger n) len) len))]
              (let [(last (%Sub len nlen))]
                (%BoxInt (JsStringLastIndexOfFrom raw needle (if (%Lt last start) last start) nlen)))))))))

; includes(searchString [, position]) (§22.1.3.8)
(builtin JsStringIncludes :transitioning true :throws true :params [(this dyn) (search dyn) (pos dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s)) (needle (%UnboxString (JsToString search)))]
          (let [(len (%StringLength raw))]
            (%BoxBool (%Not (%Lt (JsStringIndexOfFrom raw needle (JsClampIndex (JsToIntegerOrZero pos) len) len (%StringLength needle)) 0))))))))

; startsWith(searchString [, position]) (§22.1.3.23)
(builtin JsStringStartsWith :transitioning true :throws true :params [(this dyn) (search dyn) (pos dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s)) (needle (%UnboxString (JsToString search)))]
          (let [(len (%StringLength raw)) (nlen (%StringLength needle))]
            (let [(start (JsClampIndex (JsToIntegerOrZero pos) len))]
              (if (%Lt len (%Add start nlen))
                  (%BoxBool (%Eq 0 1))
                  (%BoxBool (JsStringMatchAt raw needle start 0 nlen)))))))))

; endsWith(searchString [, endPosition]) (§22.1.3.7)
(builtin JsStringEndsWith :transitioning true :throws true :params [(this dyn) (search dyn) (end-pos dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s)) (needle (%UnboxString (JsToString search)))]
          (let [(len (%StringLength raw)) (nlen (%StringLength needle))]
            (let [(end (if (%IsUndefined end-pos) len (JsClampIndex (JsToIntegerOrZero end-pos) len)))]
              (let [(start (%Sub end nlen))]
                (if (%Lt start 0)
                    (%BoxBool (%Eq 0 1))
                    (%BoxBool (JsStringMatchAt raw needle start 0 nlen))))))))))

; slice(start, end) (§22.1.3.22): relative indices.
(builtin JsStringSlice :transitioning true :throws true :params [(this dyn) (start dyn) (end dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s))]
          (let [(len (%StringLength raw))]
            (let [(from (JsRelativeClamp (JsToIntegerOrZero start) len))
                  (to (if (%IsUndefined end) len (JsRelativeClamp (JsToIntegerOrZero end) len)))]
              (if (%Lt from to)
                  (%Box (%Substring raw from to))
                  (%Box ""))))))))

; substring(start, end) (§22.1.3.24): absolute indices, clamped, in either order.
(builtin JsStringSubstring :transitioning true :throws true :params [(this dyn) (start dyn) (end dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s))]
          (let [(len (%StringLength raw))]
            (let [(a (JsClampIndex (JsToIntegerOrZero start) len))
                  (b (if (%IsUndefined end) len (JsClampIndex (JsToIntegerOrZero end) len)))]
              (if (%Lt a b)
                  (%Box (%Substring raw a b))
                  (%Box (%Substring raw b a)))))))))

; concat(...args) (§22.1.3.5), up to the four ABI slots.
(builtin JsStringConcat :transitioning true :throws true
  :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (if (%IsUndefined a0)
            s
            (let [(s0 (JsAdd s (JsToString a0)))]
              (if (%IsUndefined a1)
                  s0
                  (let [(s1 (JsAdd s0 (JsToString a1)))]
                    (if (%IsUndefined a2)
                        s1
                        (let [(s2 (JsAdd s1 (JsToString a2)))]
                          (if (%IsUndefined a3) s2 (JsAdd s2 (JsToString a3))))))))))))

; The first index at or after k whose unit is not StrWhiteSpace (len when none).
(builtin JsStringSkipSpaceFrom :params [(raw str) (k int) (len int)] :ret int
  (if (%Lt k len)
      (if (JsStrWhiteSpaceUnit (%StringCharCode raw k))
          (JsStringSkipSpaceFrom raw (%Add k 1) len)
          k)
      len))

; One past the last index before k whose unit is not StrWhiteSpace (0 when none).
(builtin JsStringSkipSpaceBack :params [(raw str) (k int)] :ret int
  (if (%Lt 0 k)
      (if (JsStrWhiteSpaceUnit (%StringCharCode raw (%Sub k 1)))
          (JsStringSkipSpaceBack raw (%Sub k 1))
          k)
      0))

(builtin JsStringTrim :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s))]
          (let [(len (%StringLength raw))]
            (let [(from (JsStringSkipSpaceFrom raw 0 len))]
              (let [(to (JsStringSkipSpaceBack raw len))]
                (if (%Lt from to) (%Box (%Substring raw from to)) (%Box "")))))))))

(builtin JsStringTrimStart :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s))]
          (let [(len (%StringLength raw))]
            (%Box (%Substring raw (JsStringSkipSpaceFrom raw 0 len) len)))))))

(builtin JsStringTrimEnd :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(raw (%UnboxString s))]
          (%Box (%Substring raw 0 (JsStringSkipSpaceBack raw (%StringLength raw))))))))

; repeat(count) (§22.1.3.19): a negative or infinite count is a RangeError.
(builtin JsStringRepeat :transitioning true :throws true :params [(this dyn) (count dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(n (JsPrimitiveNumber count))]
          (if (%Lt n (%ToFloat 0))
              (JsThrowRangeError (%Box "Invalid count value"))
              (if (%Lt (%ToFloat 1073741823) n)
                  (JsThrowRangeError (%Box "Invalid count value"))
                  (JsStringRepeatFrom s (%Box "") (%ToInteger n))))))))

(builtin JsStringRepeatFrom :transitioning true :params [(s dyn) (acc dyn) (n int)] :ret dyn
  (if (%Lt 0 n)
      (JsStringRepeatFrom s (JsAdd acc s) (%Sub n 1))
      acc))

; toString / valueOf (§22.1.3.28, §22.1.3.35): the string itself.
(builtin JsStringToStringMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsStringReceiver this))

(builtin JsStringValueOf :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsStringReceiver this))

; split(separator [, limit]) (§22.1.3.23) with a string separator: an absent separator yields
; [S]; an empty separator splits into code units; otherwise the pieces between occurrences.
(builtin JsStringSplit :transitioning true :throws true :params [(this dyn) (separator dyn) (limit dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(lim (if (%IsUndefined limit) 4294967295 (JsToIntegerOrZero limit)))]
          (if (%Lt lim 1)
              (JsNewArray 0)
              (if (%IsUndefined separator)
                  (JsArrayLiteralElement (JsNewArray 0) 0 s)
                  (let [(raw (%UnboxString s)) (sep (%UnboxString (JsToString separator)))]
                    (let [(len (%StringLength raw)) (slen (%StringLength sep))]
                      (if (%Eq slen 0)
                          (JsStringSplitUnits raw 0 (if (%Lt lim len) lim len) (JsNewArray 0))
                          (JsStringSplitFrom raw sep 0 len slen lim (JsNewArray 0)))))))))))

(builtin JsStringSplitUnits :transitioning true :params [(raw str) (k int) (n int) (out dyn)] :ret dyn
  (if (%Lt k n)
      (let [(stored (%ArrayStore (%UnboxArray out) k (%Box (%Substring raw k (%Add k 1)))))]
        (JsStringSplitUnits raw (%Add k 1) n out))
      out))

; Pieces of `raw` from `from`, split at each occurrence of `sep`, at most `lim` pieces.
(builtin JsStringSplitFrom :transitioning true
  :params [(raw str) (sep str) (from int) (len int) (slen int) (lim int) (out dyn)] :ret dyn
  (let [(count (%ArrayLen (%UnboxArray out)))]
    (if (%Lt count lim)
        (let [(hit (JsStringIndexOfFrom raw sep from len slen))]
          (if (%Lt hit 0)
              (let [(stored (%ArrayStore (%UnboxArray out) count (%Box (%Substring raw from len))))]
                out)
              (let [(stored (%ArrayStore (%UnboxArray out) count (%Box (%Substring raw from hit))))]
                (JsStringSplitFrom raw sep (%Add hit slen) len slen lim out))))
        out)))

; padStart / padEnd (§22.1.3.16, §22.1.3.15): the filler repeated and truncated to fill up to
; maxLength; an empty filler pads nothing.
(builtin JsStringPadStart :transitioning true :throws true :params [(this dyn) (max-length dyn) (fill dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(padding (JsStringPadding s max-length fill))]
          (JsAdd padding s)))))

(builtin JsStringPadEnd :transitioning true :throws true :params [(this dyn) (max-length dyn) (fill dyn)] :ret dyn
  (let [(s (JsStringReceiver this))]
    (if (%IsException s)
        s
        (let [(padding (JsStringPadding s max-length fill))]
          (JsAdd s padding)))))

; The padding StringPad (§22.1.3.17.1) adds: filler repeated to the missing length, truncated.
(builtin JsStringPadding :transitioning true :params [(s dyn) (max-length dyn) (fill dyn)] :ret dyn
  (let [(raw (%UnboxString s)) (target (JsToIntegerOrZero max-length))]
    (let [(len (%StringLength raw))]
      (if (%Not (%Lt len target))
          (%Box "")
          (let [(filler (if (%IsUndefined fill) (%Box " ") (JsToString fill)))]
            (if (%IsString filler)
                (if (%Eq (%StringLength (%UnboxString filler)) 0)
                    (%Box "")
                    (JsStringFillTo filler (%Box "") (%Sub target len)))
                (%Box "")))))))

; `filler` repeated until `acc` reaches `need` units, then truncated to exactly `need`. The
; concatenation is the string primitive, not JsAdd, so every value stays a proven string.
(builtin JsStringFillTo :transitioning true :params [(filler dyn) (acc dyn) (need int)] :ret dyn
  (if (%IsString acc)
      (if (%IsString filler)
          (let [(have (%StringLength (%UnboxString acc)))]
            (if (%Lt have need)
                (JsStringFillTo filler (%Box (%StringConcat (%UnboxString acc) (%UnboxString filler))) need)
                (if (%Eq have need)
                    acc
                    (%Box (%Substring (%UnboxString acc) 0 need)))))
          acc)
      acc))

; String.fromCharCode(...codeUnits) (§22.1.2.1): each argument to a code unit (ToUint16 of
; ToNumber, done by the runtime's truncation), up to the four ABI slots.
(builtin JsStringFromCharCode :transitioning true
  :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (if (%IsUndefined a0)
      (%Box "")
      (let [(s0 (%Box (%StringFromCharCode (%ToInteger (JsPrimitiveNumber a0)))))]
        (if (%IsUndefined a1)
            s0
            (let [(s1 (JsAdd s0 (%Box (%StringFromCharCode (%ToInteger (JsPrimitiveNumber a1))))))]
              (if (%IsUndefined a2)
                  s1
                  (let [(s2 (JsAdd s1 (%Box (%StringFromCharCode (%ToInteger (JsPrimitiveNumber a2))))))]
                    (if (%IsUndefined a3)
                        s2
                        (JsAdd s2 (%Box (%StringFromCharCode (%ToInteger (JsPrimitiveNumber a3)))))))))))))
