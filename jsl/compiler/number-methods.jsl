; Number.prototype and Boolean.prototype (ECMA-262 §21.1.3, §20.3.3) on primitive receivers,
; reached through %Number.prototype% and %Boolean.prototype% without wrapper objects
; (docs/DECISIONS.md, strings). A receiver of another kind is a TypeError, as thisNumberValue
; requires (a Number object would qualify; none exist yet).

(macro JsNumberReceiver :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsInt this)
      this
      (if (%IsFlt this)
          this
          (JsThrowTypeError (%Box "Number.prototype method called on a non-number value")))))

; Number.prototype.toString([radix]) (§21.1.3.6): radix 10, or undefined, is Number::toString;
; another radix in [2, 36] converts the integer part digit by digit and a fraction to as many
; digits as it takes to reach zero, at most 52 (the specification leaves the fraction's digits
; implementation-approximated); a radix outside the range is a RangeError.
(builtin JsNumberToStringMethod :transitioning true :throws true :params [(this dyn) (radix dyn)] :ret dyn
  (let [(n (JsNumberReceiver this))]
    (if (%IsException n)
        n
        (if (%IsUndefined radix)
            (JsToString n)
            (let [(r (%ToInteger (JsPrimitiveNumber radix)))]
              (if (%Eq r 10)
                  (JsToString n)
                  (if (%Lt r 2)
                      (JsThrowRangeError (%Box "toString() radix must be between 2 and 36"))
                      (if (%Lt 36 r)
                          (JsThrowRangeError (%Box "toString() radix must be between 2 and 36"))
                          (JsNumberRadixString (%UnboxNumber n) r)))))))))

; The radix spelling of a finite number: sign, integer digits, and a fraction when there is one.
(builtin JsNumberRadixString :transitioning true :params [(x flt) (radix int)] :ret dyn
  (if (%Eq x x)
      (if (%Lt x (%ToFloat 0))
          (JsAdd (%Box "-") (JsNumberRadixString (%Sub (%ToFloat 0) x) radix))
          (let [(whole (%ToInteger x))]
            (let [(digits (JsRadixDigits whole radix (%Box "")))]
              (let [(fraction (%Sub x (%ToFloat whole)))]
                (if (%Eq fraction (%ToFloat 0))
                    digits
                    (JsAdd (JsAdd digits (%Box ".")) (JsRadixFractionDigits fraction radix 52 (%Box ""))))))))
      (%Box "NaN")))

; The digits of a non-negative integer, most significant first.
(builtin JsRadixDigits :transitioning true :params [(n int) (radix int) (acc dyn)] :ret dyn
  (let [(q (%Div n radix))]
    (let [(d (%Sub n (%Mul q radix)))]
      (let [(digit (%Box (%StringFromCharCode (JsRadixDigitCode d))))]
        (if (%Eq q 0)
            (JsAdd digit acc)
            (JsRadixDigits q radix (JsAdd digit acc)))))))

(macro JsRadixDigitCode :params [(d int)] :ret int
  (if (%Lt d 10) (%Add 48 d) (%Add 87 d)))

; The fraction's digits: multiply by the radix, emit the integer part, continue with the rest.
(builtin JsRadixFractionDigits :transitioning true :params [(f flt) (radix int) (left int) (acc dyn)] :ret dyn
  (if (%Eq left 0)
      acc
      (if (%Eq f (%ToFloat 0))
          acc
          (let [(scaled (%Mul f (%ToFloat radix)))]
            (let [(d (%ToInteger scaled))]
              (JsRadixFractionDigits (%Sub scaled (%ToFloat d)) radix (%Sub left 1)
                                     (JsAdd acc (%Box (%StringFromCharCode (JsRadixDigitCode d))))))))))

; Number.prototype.valueOf() (§21.1.3.7)
(builtin JsNumberValueOf :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsNumberReceiver this))

; Boolean.prototype.toString / valueOf (§20.3.3.2, §20.3.3.3)
(builtin JsBooleanToStringMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsBool this)
      (if (%UnboxBool this) (%Box "true") (%Box "false"))
      (JsThrowTypeError (%Box "Boolean.prototype.toString called on a non-boolean value"))))

(builtin JsBooleanValueOf :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsBool this)
      this
      (JsThrowTypeError (%Box "Boolean.prototype.valueOf called on a non-boolean value"))))
