; Abstract Relational Comparison for the remaining source operators, over the same guarded ToNumber
; boundary as JsLt. `a > b` is IsLessThan(b, a) with LeftFirst false: both operands were already
; evaluated in source order by the frontend, so swapping the converted values here changes no
; observable effect order. IEEE `<`/`<=` return false when either side is NaN, as required.
(builtin JsGt :params [(a dyn) (b dyn)] :ret dyn
  (let [(left (JsPrimitiveNumber a))
        (right (JsPrimitiveNumber b))]
    (%BoxBool (%Lt right left))))

(builtin JsLe :params [(a dyn) (b dyn)] :ret dyn
  (let [(left (JsPrimitiveNumber a))
        (right (JsPrimitiveNumber b))]
    (%BoxBool (%Le left right))))

(builtin JsGe :params [(a dyn) (b dyn)] :ret dyn
  (let [(left (JsPrimitiveNumber a))
        (right (JsPrimitiveNumber b))]
    (%BoxBool (%Le right left))))
