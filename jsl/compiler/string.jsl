; Runtime primitives operate only on proven raw UTF-16 strings. These JSL definitions own the
; JavaScript value guards, unboxing, and the content-versus-identity choice.
(macro JsStringEquals :params [(a dyn) (b dyn)] :ret bool
  (%StringEq (%UnboxString a) (%UnboxString b)))

(macro JsStringCompare :params [(a dyn) (b dyn)] :ret int
  (%StringCompare (%UnboxString a) (%UnboxString b)))
