; ECMAScript truthiness for the dynamic values currently admitted by source lowering. Undefined is
; false without entering the numeric representation; both signed zeros and NaN are false, and every
; other Number is true. The semantic result is a raw Boolean, not a source value.
(builtin JsTruthy :params [(value dyn)] :ret bool
  (if (%IsUndefined value)
      (%Eq 0 1)
      (if (%IsNull value)
          (%Eq 0 1)
          (if (%IsObject value)
              (%Eq 0 0)
              (if (%IsFunction value)
                  (%Eq 0 0)
                  (if (%IsSymbol value)
                      (%Eq 0 0)
                      (if (%IsString value)
                          (%Ne (%StringLength (%UnboxString value)) 0)
                          (if (%IsBool value)
                              (%UnboxBool value)
                              (let [(number (%UnboxNumber value))
                                    (nonzero (%Ne number (%ToFloat 0)))
                                    (ordered (%Eq number number))]
                                (%And nonzero ordered))))))))))
