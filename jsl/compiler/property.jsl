; Representation-level own-property access is guarded here, in JSL. The primitives only inspect
; an already proven ordinary object and its managed property backing store.
(macro JsGetOwnNamed :params [(object dyn) (key int)] :ret dyn
  (if (%IsObject object)
      (%PropLoadOwnNamed (%UnboxObject object) key)
      (%Undefined)))

(macro JsHasOwnNamed :params [(object dyn) (key int)] :ret bool
  (if (%IsObject object)
      (%PropHasOwnNamed (%UnboxObject object) key)
      (%Eq 0 1)))

; Ordinary [[Get]] for the represented data-property object model. The representation primitive
; exposes only the already-proven object's [[Prototype]] slot; own-property choice, chain traversal,
; and the undefined result at null are JavaScript semantics and therefore remain here in JSL.
(builtin JsGetNamedObject :params [(object dyn) (key int)] :ret dyn
  (if (JsHasOwnNamed object key)
      (JsGetOwnNamed object key)
      (let [(prototype (%GetObjectPrototype (%UnboxObject object)))]
        (if (%IsNull prototype)
            (%Undefined)
            (JsGetNamedObject prototype key)))))

(macro JsGetNamed :params [(object dyn) (key int)] :ret dyn
  (if (%IsObject object)
      (JsGetNamedObject object key)
      (if (%IsString object)
          (if (%Eq key (%PropertyKey "length"))
              (%BoxInt (%StringLength (%UnboxString object)))
              (%Undefined))
          (%Undefined))))

(macro JsDefineOwnNamed :transitioning true
  :params [(object dyn) (key int) (value dyn)] :ret dyn
  (if (%IsObject object)
      (let [(stored (%PropStoreOwnNamed (%UnboxObject object) key value))]
        object)
      object))

; Object-literal PropertyDefinition evaluates against a freshly allocated, proven raw object.
; Keeping this distinct from the JavaScript-visible guarded Set path preserves precise memory
; slices across successive definitions without weakening generic Set semantics.
(macro JsCreateDataPropertyNamed :transitioning true
  :params [(object obj) (key int) (value dyn)] :ret obj
  (let [(stored (%PropStoreOwnNamed object key value))]
    object))

; ObjectLiteral `__proto__: value` is Annex-B-looking syntax but normative object-initializer
; semantics: Object/null installs [[Prototype]], every other value is ignored. The primitive only
; writes an already proven raw object's representation slot.
(macro JsSetObjectLiteralPrototype :params [(object obj) (prototype dyn)] :ret obj
  (if (%IsNull prototype)
      (%SetObjectPrototype object prototype)
      (if (%IsObject prototype)
          (%SetObjectPrototype object prototype)
          object)))
