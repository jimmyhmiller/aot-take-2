; Representation-level own-property access is guarded here, in JSL. The primitives only inspect
; an already proven ordinary object and its managed property backing store.
(macro JsGetOwnNamed :params [(object dyn) (key int)] :ret dyn
  (if (%IsObjectLike object)
      (%PropLoadOwnNamed (%UnboxObjectLike object) key)
      (%Undefined)))

(macro JsHasOwnNamed :params [(object dyn) (key int)] :ret bool
  (if (%IsObjectLike object)
      (%PropHasOwnNamed (%UnboxObjectLike object) key)
      (%Eq 0 1)))

; Ordinary [[Get]] for the represented data-property object model. The representation primitive
; exposes only the already-proven object's [[Prototype]] slot; own-property choice, chain traversal,
; and the undefined result at null are JavaScript semantics and therefore remain here in JSL.
(builtin JsGetNamedObject :transitioning true :params [(object dyn) (key int)] :ret dyn
  (if (JsHasOwnNamed object key)
      (JsGetOwnNamed object key)
      (let [(prototype (%GetObjectPrototype (%UnboxObjectLike object)))]
        (if (%IsNull prototype)
            (%Undefined)
            (JsGetNamedObject prototype key)))))

;; The own-property step is peeled out of the chain walk so a receiver whose backing store the
;; compiler can see folds to a single Load at the site; only the prototype chain is a call.
(macro JsGetNamedPrototypeChain :transitioning true :params [(object dyn) (key int)] :ret dyn
  (let [(prototype (%GetObjectPrototype (%UnboxObjectLike object)))]
    (if (%IsNull prototype)
        (%Undefined)
        (JsGetNamedObject prototype key))))

;; [[Get]] on a primitive base: a string's `length`; undefined and null are a TypeError (the result
;; is then the exception sentinel, which the caller tests when the base may be either); other
;; primitives have no properties yet (their prototypes wait for the wrapper objects).
(macro JsGetNamed :transitioning true :throws true :params [(object dyn) (key int)] :ret dyn
  (if (%IsObjectLike object)
      (if (JsHasOwnNamed object key)
          (JsGetOwnNamed object key)
          (JsGetNamedPrototypeChain object key))
      (if (%IsString object)
          (if (%Eq key (%PropertyKey "length"))
              (%BoxInt (%StringLength (%UnboxString object)))
              (%Undefined))
          (if (%IsUndefined object)
              (JsThrowTypeError (%Box "Cannot read properties of undefined"))
              (if (%IsNull object)
                  (JsThrowTypeError (%Box "Cannot read properties of null"))
                  (%Undefined))))))

;; A store on undefined or null is a TypeError; a store on another primitive is silently dropped
;; (sloppy mode; strict mode's TypeError waits for the wrapper objects).
(macro JsDefineOwnNamed :transitioning true :throws true
  :params [(object dyn) (key int) (value dyn)] :ret dyn
  (if (%IsObjectLike object)
      (let [(stored (%PropStoreOwnNamed (%UnboxObjectLike object) key value))]
        object)
      (if (%IsUndefined object)
          (JsThrowTypeError (%Box "Cannot set properties of undefined"))
          (if (%IsNull object)
              (JsThrowTypeError (%Box "Cannot set properties of null"))
              object))))

; Object-literal PropertyDefinition evaluates against a freshly allocated, proven raw object.
; Keeping this distinct from the JavaScript-visible guarded Set path preserves precise memory
; slices across successive definitions without weakening generic Set semantics.
(macro JsCreateDataPropertyNamed :transitioning true
  :params [(object obj) (key int) (value dyn)] :ret obj
  (let [(stored (%PropStoreOwnNamed object key value))]
    object))

; ObjectLiteral `__proto__: value` is Annex-B-looking syntax but normative object-initializer
; semantics: Object/null installs [[Prototype]], every other value is ignored. The primitive only
; writes an already proven raw object's representation slot.
(macro JsSetObjectLiteralPrototype :params [(object obj) (prototype dyn)] :ret obj
  (if (%IsNull prototype)
      (%SetObjectPrototype object prototype)
      (if (%IsObject prototype)
          (%SetObjectPrototype object prototype)
          object)))
