; ToString (ECMA-262 §7.1.17) over primitives. An object needs ToPrimitive, which is unimplemented:
; that arm keeps its runtime refusal by name so every caller stays total.
(builtin JsToString :transitioning true :params [(v dyn)] :ret dyn
  (if (%IsString v)
      v
      (if (%IsUndefined v)
          (%Box "undefined")
          (if (%IsNull v)
              (%Box "null")
              (if (%IsBool v)
                  (if (%UnboxBool v) (%Box "true") (%Box "false"))
                  (if (%IsInt v)
                      (%Box (%NumberToString v))
                      (if (%IsFlt v)
                          (%Box (%NumberToString v))
                          ;; Neither arm returns; the empty string keeps the result a string, so
                          ;; a caller's %UnboxString is proven.
                          (if (%IsSymbol v)
                              (let [(thrown (%ThrowTypeError))]
                                (%Box ""))
                              ;; An array stringifies through Array.prototype.toString, which is
                              ;; join (docs/DECISIONS.md, arrays); a non-array object still needs
                              ;; ToPrimitive.
                              (if (%IsArray v)
                                  (JsArrayToStringValue v)
                                  (let [(trapped (%TrapToPrimitive))]
                                    (%Box "")))))))))))

;; ToString of an array: join with ",". The result of a `:throws` join is tested; a throw inside
;; it (a nested non-array receiver cannot happen here) keeps the caller's string proof by
;; answering the empty string, as the other non-returning arms do.
(macro JsArrayToStringValue :transitioning true :params [(v dyn)] :ret dyn
  (let [(joined (JsArrayJoin v (%Undefined)))]
    (if (%IsException joined) (%Box "") joined)))
