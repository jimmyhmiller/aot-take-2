; ToString (ECMA-262 §7.1.17) over primitives. An object — an array included — converts through
; ToPrimitive (`JsToStringValue`, jsl/compiler/toprimitive.jsl), which can call user code and throw;
; a caller that can meet one converts it there first, so this object arm is a runtime refusal by
; name that keeps every caller total.
(builtin JsToString :transitioning true :params [(v dyn)] :ret dyn
  (if (%IsString v)
      v
      (if (%IsUndefined v)
          (%Box "undefined")
          (if (%IsNull v)
              (%Box "null")
              (if (%IsBool v)
                  (if (%UnboxBool v) (%Box "true") (%Box "false"))
                  (if (%IsInt v)
                      (%Box (%NumberToString v))
                      (if (%IsFlt v)
                          (%Box (%NumberToString v))
                          ;; Neither arm returns; the empty string keeps the result a string, so
                          ;; a caller's %UnboxString is proven.
                          (if (%IsSymbol v)
                              (let [(thrown (%ThrowTypeError))]
                                (%Box ""))
                              (let [(trapped (%TrapToPrimitive))]
                                (%Box ""))))))))))

