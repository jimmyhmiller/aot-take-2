; Object literal property definitions that are not a plain data slot (ECMA-262 §13.2.5.5,
; §15.4.4; docs/DECISIONS.md, object literal methods and accessors). The literal under construction
; is a raw object only this evaluation has seen.

; `get key() {}` or `set key(v) {}`: an enumerable, configurable accessor property whose other half,
; when the key already holds an accessor, is kept (`setter` 1 for a setter).
(builtin JsDefineLiteralAccessor :transitioning true :throws true
  :params [(object obj) (key int) (function dyn) (setter int)] :ret dyn
  (let [(boxed (%Box object))]
    (JsApplyDefine boxed key (JsAccessorPair boxed key (%Sub 1 setter) function setter function) 6 28)))

; `key: value` or `key() {}` after an accessor of the same key: CreateDataPropertyOrThrow replaces
; the accessor with a writable, enumerable, configurable data property.
(builtin JsDefineLiteralData :transitioning true :throws true
  :params [(object obj) (key int) (value dyn)] :ret dyn
  (JsApplyDefine (%Box object) key value 7 15))
