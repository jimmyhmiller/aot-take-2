; Numeric subtraction consumes the generic Number representation as binary64. Known Box/Unbox
; pairs still cancel or become a direct integer-to-float conversion during specialization.
; Number conversion for the represented non-string primitives. String parsing, object ToPrimitive,
; and Symbol exceptions remain unsupported: the final numeric Unbox must retain its proof check.
; ToNumber, total over the dynamic axis: every tag either converts or reaches a named runtime
; refusal, so the final `%UnboxNumber` is proven on numbers alone and the enclosing program compiles.
; Objects and functions would take ToPrimitive (valueOf/toString), which does not exist yet; a
; Symbol is a TypeError.
(builtin JsPrimitiveNumber :params [(value dyn)] :ret flt
  (if (%IsUndefined value)
      (%Div (%ToFloat 0) (%ToFloat 0))
      (if (%IsNull value)
          (%ToFloat 0)
          (if (%IsBool value)
              (%ToFloat (%UnboxBool value))
              (if (%IsObjectLike value)
                  (let [(trapped (%TrapToPrimitive))]
                    (%ToFloat 0))
                  (if (%IsSymbol value)
                      (let [(thrown (%ThrowTypeError))]
                        (%ToFloat 0))
                      (if (%IsString value)
                          (let [(trapped (%TrapStringToNumber))]
                            (%ToFloat 0))
                          (%UnboxNumber value))))))))

(builtin JsSub :params [(a dyn) (b dyn)] :ret dyn
  (let [(left (JsPrimitiveNumber a))
        (right (JsPrimitiveNumber b))]
    (%Box (%Sub left right))))
