; ToPrimitive (ECMA-262 §7.1.1) and the operators' object arms (docs/DECISIONS.md, ToPrimitive). An
; object converts through OrdinaryToPrimitive (§7.1.1.1): `valueOf` then `toString` for the number
; and default hints, the other way round for the string hint, the first callable one whose result is
; a primitive; neither is a TypeError. @@toPrimitive waits for symbols (docs/GAPS.md). The
; operators convert object operands first and then take their primitive paths, so an operand whose
; type excludes objects folds the object arm, and with it the completion test, away.

; `hint`: 1 for string, 0 for number and default.
(builtin JsToPrimitive :transitioning true :throws true :params [(value dyn) (hint int)] :ret dyn
  (if (%IsObjectLike value)
      (JsOrdinaryToPrimitive value hint 0)
      value))

; Try the method for `step` (0 then 1): `toString` when exactly one of "string hint" and "second
; step" holds, `valueOf` otherwise.
(builtin JsOrdinaryToPrimitive :transitioning true :throws true :params [(object dyn) (hint int) (step int)] :ret dyn
  (if (%Lt step 2)
      (let [(method (JsGetNamed object (if (%Eq (%Add hint step) 1)
                                           (%PropertyKey "toString")
                                           (%PropertyKey "valueOf"))))]
        (if (%IsException method)
            method
            (if (%IsFunction method)
                (let [(result (%CallFunction method object))]
                  (if (%IsException result)
                      result
                      (if (%IsObjectLike result)
                          (JsOrdinaryToPrimitive object hint (%Add step 1))
                          result)))
                (JsOrdinaryToPrimitive object hint (%Add step 1)))))
      (JsThrowTypeError (%Box "Cannot convert object to primitive value"))))

(macro JsEitherObjectLike :params [(a dyn) (b dyn)] :ret bool
  (if (%IsObjectLike a) (%Eq 0 0) (%IsObjectLike b)))

; The source operators (ECMA-262 §13.15.3 ApplyStringOrNumericBinaryOperator, §13.10.1 relational
; comparison, §13.5 unary and update operators) over the numeric cores (add.jsl, sub.jsl, mul.jsl,
; logical.jsl, update.jsl), which take primitives: an object operand is ToPrimitive'd first, left
; then right, and the operator applies to the primitives. Two primitive strings compare by code
; units (IsLessThan step 3); every other primitive pair compares as Numbers.
(builtin JsAddOperator :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 0 0) (JsAdd a b)))

(builtin JsSubOperator :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 1 0) (JsSub a b)))

(builtin JsMulOperator :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 2 0) (JsMul a b)))

(builtin JsDivOperator :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 3 0) (JsDiv a b)))

(builtin JsLtOperator :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 4 0) (%BoxBool (JsRelationalOrder a b 0))))

(builtin JsGtOperator :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 5 0) (%BoxBool (JsRelationalOrder a b 1))))

(builtin JsLeOperator :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 6 0) (%BoxBool (JsRelationalOrder a b 2))))

(builtin JsGeOperator :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 7 0) (%BoxBool (JsRelationalOrder a b 3))))

(builtin JsNegateOperator :transitioning true :throws true :params [(value dyn)] :ret dyn
  (if (%IsObjectLike value) (JsUnaryOnPrimitive value 1) (JsNegate value)))

(builtin JsPositiveOperator :transitioning true :throws true :params [(value dyn)] :ret dyn
  (if (%IsObjectLike value) (JsUnaryOnPrimitive value 0) (JsPositive value)))

; `order` of a relation on primitives: 0 a < b, 1 a > b, 2 a <= b, 3 a >= b. For strings `<=` is
; "not b < a"; for Numbers IEEE `<=`, false when either is NaN.
(macro JsRelationalOrder :params [(a dyn) (b dyn) (order int)] :ret bool
  (if (%IsString a)
      (if (%IsString b)
          (let [(c (%StringCompare (%UnboxString a) (%UnboxString b)))]
            (if (%Eq order 0) (%Lt c 0)
                (if (%Eq order 1) (%Lt 0 c)
                    (if (%Eq order 2) (%Not (%Lt 0 c)) (%Not (%Lt c 0))))))
          (JsRelationalNumbers (JsPrimitiveNumber a) (JsPrimitiveNumber b) order))
      (JsRelationalNumbers (JsPrimitiveNumber a) (JsPrimitiveNumber b) order)))

(macro JsRelationalNumbers :params [(left flt) (right flt) (order int)] :ret bool
  (if (%Eq order 0) (%Lt left right)
      (if (%Eq order 1) (%Lt right left)
          (if (%Eq order 2) (%Le left right) (%Le right left)))))

; An object operand's arm: ToPrimitive of the left operand, then of the right, with `hint`, then the
; operator over the primitives. `op` names it.
(builtin JsBinaryOnPrimitives :transitioning true :throws true :params [(a dyn) (b dyn) (op int) (hint int)] :ret dyn
  (let [(left (JsToPrimitive a hint))]
    (if (%IsException left)
        left
        (let [(right (JsToPrimitive b hint))]
          (if (%IsException right)
              right
              (if (%Lt op 8)
                  (if (%Eq op 0) (JsAdd left right)
                      (if (%Eq op 1) (JsSub left right)
                          (if (%Eq op 2) (JsMul left right)
                              (if (%Eq op 3) (JsDiv left right)
                                  (%BoxBool (JsRelationalOrder left right (%Sub op 4)))))))
                  ;; 8 `%`, 9 `**`, 10-15 `&` `|` `^` `<<` `>>` `>>>`: the runtime's Number operations.
                  (JsNumberBinaryOp left right op)))))))

; The unary operators' object arm: ToPrimitive with the number hint, then the operator. `op`: 0 unary
; `+` (and the ToNumeric of `++`/`--`), 1 unary `-`.
(builtin JsUnaryOnPrimitive :transitioning true :throws true :params [(value dyn) (op int)] :ret dyn
  (let [(primitive (JsToPrimitive value 0))]
    (if (%IsException primitive)
        primitive
        (if (%Eq op 0) (JsPositive primitive)
            (if (%Eq op 1) (JsNegate primitive) (JsBitNot primitive))))))

; ToString (§7.1.17) of any value: an object through ToPrimitive with the string hint.
(builtin JsToStringValue :transitioning true :throws true :params [(value dyn)] :ret dyn
  (if (%IsObjectLike value)
      (let [(primitive (JsToPrimitive value 1))]
        (if (%IsException primitive)
            primitive
            (JsToString primitive)))
      (JsToString value)))

; ToNumber (§7.1.4) of any value as a Number word: an object through ToPrimitive with the number
; hint. The completion is the exception an object's conversion threw.
(builtin JsToNumberValue :transitioning true :throws true :params [(value dyn)] :ret dyn
  (if (%IsObjectLike value)
      (let [(primitive (JsToPrimitive value 0))]
        (if (%IsException primitive)
            primitive
            (%Box (JsPrimitiveNumber primitive))))
      (%Box (JsPrimitiveNumber value))))

; A one-argument Math function over ToNumber of its argument.
(macro JsMathUnaryOf :transitioning true :throws true :params [(op int) (value dyn)] :ret dyn
  (let [(n (JsToNumberValue value))]
    (if (%IsException n) n (%MathUnary op (%Box (%UnboxNumber n))))))

; String.prototype methods with an object argument: the receiver is checked first, then each
; argument is ToPrimitive'd with its hint (1 where the method ToStrings it, 0 where it ToNumbers it),
; in order, and the method runs again over the primitives — ToString and ToNumber of the primitive
; are then what they were of the object. `op` names the method.
(builtin JsStringOnPrimitives :transitioning true :throws true
  :params [(this dyn) (a dyn) (b dyn) (op int) (hint-a int) (hint-b int)] :ret dyn
  (if (%IsString this)
      (let [(pa (JsToPrimitive a hint-a))]
        (if (%IsException pa)
            pa
            (let [(pb (JsToPrimitive b hint-b))]
              (if (%IsException pb)
                  pb
                  (JsStringMethodOp this pa pb op)))))
      (JsThrowTypeError (%Box "String.prototype method called on a non-string value"))))

(builtin JsStringMethodOp :transitioning true :throws true :params [(this dyn) (a dyn) (b dyn) (op int)] :ret dyn
  (if (%Lt op 3)
      (if (%Eq op 0) (JsStringCharAt this a) (if (%Eq op 1) (JsStringCharCodeAt this a) (JsStringAt this a)))
      (if (%Lt op 8)
          (if (%Eq op 3) (JsStringIndexOf this a b)
              (if (%Eq op 4) (JsStringLastIndexOf this a b)
                  (if (%Eq op 5) (JsStringIncludes this a b)
                      (if (%Eq op 6) (JsStringStartsWith this a b) (JsStringEndsWith this a b)))))
          (if (%Eq op 8) (JsStringSlice this a b)
              (if (%Eq op 9) (JsStringSubstring this a b)
                  (if (%Eq op 10) (JsStringRepeat this a)
                      (if (%Eq op 11) (JsStringSplit this a b)
                          (if (%Eq op 12) (JsStringPadStart this a b) (JsStringPadEnd this a b)))))))))

; concat (0) and String.fromCharCode (1) with an object among their slots: every slot ToPrimitive'd
; with `hint` in order (a TypeError for a non-string receiver of concat comes first), then the
; function again over the primitives.
(builtin JsVariadicOnPrimitives :transitioning true :throws true
  :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn) (op int) (hint int)] :ret dyn
  (if (%And (%Eq op 0) (%Not (%IsString this)))
      (JsThrowTypeError (%Box "String.prototype method called on a non-string value"))
      (let [(p0 (JsToPrimitive a0 hint))]
        (if (%IsException p0)
            p0
            (let [(p1 (JsToPrimitive a1 hint))]
              (if (%IsException p1)
                  p1
                  (let [(p2 (JsToPrimitive a2 hint))]
                    (if (%IsException p2)
                        p2
                        (let [(p3 (JsToPrimitive a3 hint))]
                          (if (%IsException p3)
                              p3
                              (if (%Eq op 0)
                                  (JsStringConcat this p0 p1 p2 p3)
                                  (JsStringFromCharCode this p0 p1 p2 p3))))))))))))

; `object[key]` read (0) or written (1) with an object key: GetValue and PutValue take ToObject of the
; base first (§6.2.5.5 step 3.a), so an undefined or null base is the TypeError before the key's
; ToPropertyKey runs its ToPrimitive with the string hint (§7.1.19); then the access again over the
; primitive key.
(builtin JsKeyedOnPrimitiveKey :transitioning true :throws true
  :params [(object dyn) (key dyn) (value dyn) (op int) (strict int)] :ret dyn
  (if (%IsUndefined object)
      (JsThrowTypeError (%Box (if (%Eq op 0) "Cannot read properties of undefined" "Cannot set properties of undefined")))
      (if (%IsNull object)
          (JsThrowTypeError (%Box (if (%Eq op 0) "Cannot read properties of null" "Cannot set properties of null")))
          (let [(primitive (JsToPrimitive key 1))]
            (if (%IsException primitive)
                primitive
                (if (%Eq op 0)
                    (JsGetKeyed object primitive)
                    (JsSetKeyed object primitive value strict)))))))

; One substitution of a template literal (§13.2.8.6): the string so far, ToString of the value, and
; the cooked string after it.
(builtin JsTemplateAppend :transitioning true :throws true :params [(acc dyn) (value dyn) (quasi dyn)] :ret dyn
  (let [(text (JsToStringValue value))]
    (if (%IsException text)
        text
        (if (%IsString acc)
            (if (%IsString quasi)
                (if (%IsString text)
                    (%Box (%StringConcat (%StringConcat (%UnboxString acc) (%UnboxString text)) (%UnboxString quasi)))
                    (JsThrowTypeError (%Box "ToString produced no string")))
                (JsThrowTypeError (%Box "A template's cooked string is not a string")))
            (JsThrowTypeError (%Box "A template's cooked string is not a string"))))))

; `%` (Number::remainder), `**` (Number::exponentiate) and the bitwise operators over ToInt32 and
; ToUint32 (§6.1.6.1), as the runtime's Number operations (aot.rt.number MATH-OP-*): the operands
; are ToNumber'd primitives. `op` as in `JsBinaryOnPrimitives`.
(macro JsNumberBinaryOp :params [(a dyn) (b dyn) (op int)] :ret dyn
  (%MathBinary (if (%Eq op 8) 43 (if (%Eq op 9) 40 (%Add op 34)))
               (%Box (JsPrimitiveNumber a))
               (%Box (JsPrimitiveNumber b))))

(builtin JsMod :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 8 0) (JsNumberBinaryOp a b 8)))

(builtin JsExp :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 9 0) (JsNumberBinaryOp a b 9)))

(builtin JsBitAnd :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 10 0) (JsNumberBinaryOp a b 10)))

(builtin JsBitOr :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 11 0) (JsNumberBinaryOp a b 11)))

(builtin JsBitXor :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 12 0) (JsNumberBinaryOp a b 12)))

(builtin JsShl :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 13 0) (JsNumberBinaryOp a b 13)))

(builtin JsShr :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 14 0) (JsNumberBinaryOp a b 14)))

(builtin JsUshr :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherObjectLike a b) (JsBinaryOnPrimitives a b 15 0) (JsNumberBinaryOp a b 15)))

; `~` (§13.5.6.1): the bitwise NOT of ToInt32.
(builtin JsBitNot :transitioning true :throws true :params [(value dyn)] :ret dyn
  (if (%IsObjectLike value)
      (JsUnaryOnPrimitive value 2)
      (%MathUnary 26 (%Box (JsPrimitiveNumber value)))))

; `==` and `!=` (§13.11.1): IsLooselyEqual.
(builtin JsLooseEqual :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (JsLooselyEqual a b))

(builtin JsLooseNotEqual :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (let [(r (JsLooselyEqual a b))]
    (if (%IsException r) r (%BoxBool (%Not (JsTruthyBool r))))))

(macro JsTruthyBool :params [(r dyn)] :ret bool
  (if (%IsBool r) (%UnboxBool r) (%Eq 0 1)))

; IsLooselyEqual (§7.2.14) as a boxed Boolean: two objects by identity; undefined and null equal
; each other and nothing else; an object against a primitive through ToPrimitive with the default
; hint; two primitives of one type strictly; a Boolean as its Number; a Number against a String as
; Numbers; anything else (a Symbol against a Number or String) unequal. BigInt is not represented.
(builtin JsLooselyEqual :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsLooseNullish a)
      (%BoxBool (JsLooseNullish b))
      (if (JsLooseNullish b)
          (%BoxBool (%Eq 0 1))
          (if (%IsObjectLike a)
              (if (%IsObjectLike b)
                  (%BoxBool (%SameBits a b))
                  (let [(pa (JsToPrimitive a 0))]
                    (if (%IsException pa) pa (JsLooselyEqual pa b))))
              (if (%IsObjectLike b)
                  (let [(pb (JsToPrimitive b 0))]
                    (if (%IsException pb) pb (JsLooselyEqual a pb)))
                  (JsLoosePrimitives a b))))))

(macro JsLooseNullish :params [(v dyn)] :ret bool
  (if (%IsUndefined v) (%Eq 0 0) (%IsNull v)))

(builtin JsLoosePrimitives :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (%IsBool a)
      (if (%IsBool b)
          (%BoxBool (%SameBits a b))
          (JsLoosePrimitives (%Box (JsPrimitiveNumber a)) b))
      (if (%IsBool b)
          (JsLoosePrimitives a (%Box (JsPrimitiveNumber b)))
          (if (%IsSymbol a)
              (%BoxBool (%SameBits a b))
              (if (%IsSymbol b)
                  (%BoxBool (%Eq 0 1))
                  (if (%IsString a)
                      (if (%IsString b)
                          (%BoxBool (JsStrictEqualValue a b))
                          (%BoxBool (%Eq (JsPrimitiveNumber a) (JsPrimitiveNumber b))))
                      (%BoxBool (%Eq (JsPrimitiveNumber a) (JsPrimitiveNumber b)))))))))
