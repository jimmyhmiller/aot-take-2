; String.prototype.replace, replaceAll, toUpperCase and toLowerCase (§22.1.3).
;
; `replace` takes a STRING pattern here. A RegExp pattern is the Symbol.replace protocol and waits
; for regular-expression objects (docs/GAPS.md — regular expressions); a program that passes one
; gets a TypeError naming that, not a wrong answer from treating it as a string.
;
; Case conversion maps ASCII only. The specification's toUpperCase is Unicode Default Case
; Conversion, which needs case-mapping tables the compiler does not carry, so a code point above
; 127 is left as it is — `"é".toUpperCase()` answers "é" rather than "É". That is a divergence, it
; is narrow, and it is written down (docs/GAPS.md — strings) rather than hidden.

; replace(search, replacement) (§22.1.3.19) with a string pattern: the FIRST occurrence only.
(builtin JsStringReplace :transitioning true :throws true
  :params [(this dyn) (search dyn) (replacement dyn)] :ret dyn
  (JsStringReplaceOn this search replacement 0))

; replaceAll(search, replacement) (§22.1.3.20): every occurrence, left to right. An empty pattern
; matches at every position, which is what makes the walk step past it rather than loop.
(builtin JsStringReplaceAll :transitioning true :throws true
  :params [(this dyn) (search dyn) (replacement dyn)] :ret dyn
  (JsStringReplaceOn this search replacement 1))

(builtin JsStringReplaceOn :transitioning true :throws true
  :params [(this dyn) (search dyn) (replacement dyn) (all int)] :ret dyn
  (let [(receiver (JsStringReceiver this))]
    (if (%IsException receiver)
        receiver
        (if (%IsObjectLike search)
            ;; A RegExp is an object with Symbol.replace; nothing here can honour that yet.
            (JsThrowTypeError (%Box "String.prototype.replace with a non-string pattern is not implemented"))
            (let [(needle (JsToStringValue search))]
              (if (%IsException needle)
                  needle
                  (JsStringReplaceWith receiver needle replacement all)))))))

(builtin JsStringReplaceWith :transitioning true :throws true
  :params [(receiver dyn) (needle dyn) (replacement dyn) (all int)] :ret dyn
  (if (%IsFunction replacement)
      (JsStringReplaceStep receiver needle replacement all 0 "")
      (let [(text (JsToStringValue replacement))]
        (if (%IsException text)
            text
            (JsStringReplaceStep receiver needle text all 0 "")))))

; One pass: the text before each match, the replacement, and on to the position after it.
(builtin JsStringReplaceStep :transitioning true :throws true
  :params [(receiver dyn) (needle dyn) (replacement dyn) (all int) (from int) (out str)] :ret dyn
  (let [(raw (%UnboxString receiver))]
    (let [(found (JsStringIndexOfFrom raw
                                      (%UnboxString needle)
                                      from
                                      (%StringLength raw)
                                      (%StringLength (%UnboxString needle))))]
      (if (%Lt found 0)
          (%Box (%StringConcat out (%Substring raw from (%StringLength raw))))
          (let [(piece (JsStringReplacement replacement needle found receiver))]
            (if (%IsException piece)
                piece
                (let [(joined (%StringConcat (%StringConcat out (%Substring raw from found))
                                             (%UnboxString piece)))]
                  ;; An empty pattern would match here forever; the walk always advances at least
                  ;; one code unit past the match it took.
                  (let [(next (if (%Eq (%StringLength (%UnboxString needle)) 0)
                                  (%Add found 1)
                                  (%Add found (%StringLength (%UnboxString needle)))))]
                    (if (%Eq all 1)
                        (if (%Le next (%StringLength raw))
                            (JsStringReplaceStep receiver
                                                 needle
                                                 replacement
                                                 all
                                                 next
                                                 (if (%Eq (%StringLength (%UnboxString needle)) 0)
                                                     (%StringConcat joined (%Substring raw found next))
                                                     joined))
                            (%Box joined))
                        (%Box (%StringConcat joined (%Substring raw next (%StringLength raw)))))))))))))

; A function replacement is called with the match, its index and the whole string (§22.1.3.19); a
; string replacement is used as it is. `$&` and the other substitution patterns are a gap.
(builtin JsStringReplacement :transitioning true :throws true
  :params [(replacement dyn) (needle dyn) (at int) (receiver dyn)] :ret dyn
  (if (%IsFunction replacement)
      (let [(r (%CallFunction replacement (%Undefined) needle (%BoxInt at) receiver (%Undefined)))]
        (if (%IsException r) r (JsToStringValue r)))
      replacement))

(builtin JsStringToUpperCase :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsStringMapCase this 0))

(builtin JsStringToLowerCase :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsStringMapCase this 1))

(builtin JsStringMapCase :transitioning true :throws true :params [(this dyn) (down int)] :ret dyn
  (let [(receiver (JsStringReceiver this))]
    (if (%IsException receiver)
        receiver
        (%Box (JsStringCaseFrom (%UnboxString receiver) 0 down "")))))

(builtin JsStringCaseFrom :transitioning true :noinline true
  :params [(raw str) (i int) (down int) (out str)] :ret str
  (if (%Lt i (%StringLength raw))
      (JsStringCaseFrom raw
                        (%Add i 1)
                        down
                        (%StringConcat out (%StringFromCharCode (JsCaseOf (%StringCharCode raw i) down))))
      out))

; ASCII only: 'a'..'z' and 'A'..'Z'. Every other code point is left alone.
(builtin JsCaseOf :params [(code int) (down int)] :ret int
  (if (%Eq down 1)
      (if (%Le 65 code) (if (%Le code 90) (%Add code 32) code) code)
      (if (%Le 97 code) (if (%Le code 122) (%Sub code 32) code) code)))

; Number.prototype.toFixed(digits) (§21.1.3.3): the number rounded to `digits` places after the
; point, as a string with exactly that many. It is done in integers — scale by 10^digits, round
; half away from zero, then place the point — because going through the general number-to-string
; and cutting the text would inherit that rendering's choices about when to use an exponent.
(builtin JsNumberToFixed :transitioning true :throws true :params [(this dyn) (digits dyn)] :ret dyn
  (let [(n (JsNumberReceiver this))]
    (if (%IsException n)
        n
        (let [(d (if (%IsUndefined digits) (%BoxInt 0) (JsToNumberValue digits)))]
          (if (%IsException d)
              d
              (let [(places (%ToInteger (JsPrimitiveNumber d)))]
                (if (%Lt places 0)
                    (JsThrowRangeError (%Box "toFixed() digits argument must be between 0 and 100"))
                    (if (%Lt 100 places)
                        (JsThrowRangeError (%Box "toFixed() digits argument must be between 0 and 100"))
                        (if (JsNumberFinite (JsPrimitiveNumber n))
                            (%Box (JsFixedText (JsPrimitiveNumber n) places))
                            (JsToStringValue n))))))))))

(builtin JsFixedText :transitioning true :params [(f flt) (places int)] :ret str
  (let [(negative (%Lt f (%ToFloat 0)))]
    (let [(magnitude (if negative (%Sub (%ToFloat 0) f) f))]
      (let [(scale (JsPowerOfTen places))]
        ;; Round half away from zero, which is what toFixed does at the midpoint.
        (let [(scaled (%ToInteger (%Add (%Mul magnitude (%ToFloat scale)) (%Div (%ToFloat 1) (%ToFloat 2)))))]
          (let [(text (JsFixedPlace scaled scale places))]
            (if negative (%StringConcat "-" text) text)))))))

(builtin JsPowerOfTen :params [(places int)] :ret int
  (if (%Lt 0 places) (%Mul 10 (JsPowerOfTen (%Sub places 1))) 1))

(builtin JsFixedPlace :transitioning true :params [(scaled int) (scale int) (places int)] :ret str
  (let [(whole (%NumberToString (%BoxInt (%Div scaled scale))))]
    (if (%Eq places 0)
        whole
        (%StringConcat (%StringConcat whole ".")
                       (JsPadZeros (%Sub scaled (%Mul (%Div scaled scale) scale)) places)))))
