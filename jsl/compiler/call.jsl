;; A generic value call keeps dispatch and non-callable error construction in one shared body.
;; The caller has evaluated callee/receiver/arguments in source order and packed the callable
;; ABI's three direct actuals plus its immutable managed overflow tail. Count is the actual
;; argument count; missing direct actuals are undefined. Proven function calls bypass this
;; dispatch body and keep their ordinary Call/Fun edges in the frontend.
(builtin JsInvokeCallable :transitioning true :throws true
  :inline-when [(%IsFunction callee)]
  :params [(callee dyn) (receiver dyn) (newtarget dyn) (count argument-count)
           (overflow argument-vector) (a0 dyn) (a1 dyn) (a2 dyn) (message dyn)] :ret dyn
  (if (%IsFunction callee)
      (%CallFunctionPacked callee receiver newtarget count overflow a0 a1 a2)
      (JsThrowTypeError message)))
