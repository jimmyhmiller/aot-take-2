; Function.prototype.bind and bound function exotic objects (ECMA-262 §20.2.3.2, §10.4.1) as built-in
; closures (docs/DECISIONS.md, built-in closures). Both bodies take the whole callable ABI, so they
; see the exact argument count and the function object being called. A bound function is a
; closure over the `%BoundFunction%` entry whose environment word is an internal array — never a
; value a program can reach — holding [target, boundThis, boundArg0, ...].

; The arguments of a call as a fresh array: the three direct actuals, then the overflow vector.
(builtin JsArgumentsArray :transitioning true
  :params [(count argument-count) (overflow argument-vector) (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (let [(n (%ArgumentCountInt count))]
    (let [(out (JsNewArray 0))]
      (let [(d0 (if (%Lt 0 n) (%ArrayStore (%UnboxArray out) 0 a0) a0))]
        (let [(d1 (if (%Lt 1 n) (%ArrayStore (%UnboxArray out) 1 a1) a1))]
          (let [(d2 (if (%Lt 2 n) (%ArrayStore (%UnboxArray out) 2 a2) a2))]
            (JsArgumentsArrayTail overflow 3 n out)))))))

(builtin JsArgumentsArrayTail :transitioning true
  :params [(overflow argument-vector) (i int) (n int) (out dyn)] :ret dyn
  (if (%Lt i n)
      (let [(stored (%ArrayStore (%UnboxArray out) i (%ArgumentAt overflow i)))]
        (JsArgumentsArrayTail overflow (%Add i 1) n out))
      out))

; Function.prototype.bind(thisArg, ...args) (§20.2.3.2): BoundFunctionCreate over the target's own
; [[Prototype]], [[Construct]] when the target has it, then `length` (the target's own integral
; length less the bound arguments, at least 0) and `name` ("bound " and the target's name when it
; is a string), both configurable only, defined in that order.
(builtin JsFunctionBind :transitioning true :throws true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (if (%IsFunction this)
      (let [(given (JsArgumentsArray count overflow a0 a1 a2))]
        (let [(record (JsBoundRecord this given))]
          (let [(bound (%MakeClosure "BoundFunction"
                                     (%GetObjectPrototype (%UnboxObjectLike this))
                                     record
                                     (if (JsIsConstructor this) 1 0)))]
            (JsBoundSetLengthAndName bound this (JsBoundArgumentCount (%ArgumentCountInt count))))))
      (JsThrowTypeError (%Box "Bind must be called on a function"))))

(macro JsBoundArgumentCount :params [(n int)] :ret int
  (if (%Lt n 1) 0 (%Sub n 1)))

; [target, thisArg (undefined when bind had no argument), the rest of bind's arguments].
(builtin JsBoundRecord :transitioning true :params [(target dyn) (given dyn)] :ret dyn
  (let [(raw (%UnboxArray given))]
    (let [(record (JsNewArray 0))]
      (let [(t (%ArrayStore (%UnboxArray record) 0 target))]
        (let [(b (%ArrayStore (%UnboxArray record) 1 (JsArrayElementOrUndefined raw 0)))]
          (JsBoundRecordFrom raw 1 record))))))

(builtin JsBoundRecordFrom :transitioning true :params [(raw arr) (i int) (record dyn)] :ret dyn
  (if (%Lt i (%ArrayLen raw))
      (let [(stored (%ArrayStore (%UnboxArray record) (%Add i 1) (%ArrayLoad raw i)))]
        (JsBoundRecordFrom raw (%Add i 1) record))
      record))

(builtin JsBoundSetLengthAndName :transitioning true :throws true
  :params [(bound dyn) (target dyn) (bound-count int)] :ret dyn
  (if (%IsFunction bound)
      (let [(length (if (JsHasOwnNamed target (%PropertyKey "length"))
                        (let [(target-length (JsGetNamed target (%PropertyKey "length")))]
                          (if (%IsException target-length)
                              target-length
                              (JsBoundLength target-length bound-count)))
                        (%BoxInt 0)))]
        (if (%IsException length)
            length
            (let [(defined (%PropDefine (%UnboxObjectLike bound) (%PropertyKey "length") length 4 15))]
              (let [(target-name (JsGetNamed target (%PropertyKey "name")))]
                (if (%IsException target-name)
                    target-name
                    (let [(named (%PropDefine (%UnboxObjectLike bound) (%PropertyKey "name")
                                              (%Box (%StringConcat (%UnboxString (%Box "bound "))
                                                                   (if (%IsString target-name)
                                                                       (%UnboxString target-name)
                                                                       (%UnboxString (%Box "")))))
                                              4 15))]
                      bound))))))
      (JsThrowTypeError (%Box "Bind produced no function object"))))

; The bound `length` from the target's `length` (§20.2.3.2 steps 5-6): a Number is
; ToIntegerOrInfinity'd — NaN is 0, the infinities stay — less the bound arguments, at least 0; any
; other value gives 0.
(builtin JsBoundLength :params [(target-length dyn) (bound-count int)] :ret dyn
  (if (%IsInt target-length)
      (let [(l (%Sub (%UnboxInt target-length) bound-count))]
        (%BoxInt (if (%Lt l 0) 0 l)))
      (if (%IsFlt target-length)
          ;; Truncated (NaN and the infinities stay), less the bound count; NaN and anything not
          ;; above zero give 0.
          (let [(d (%Sub (%UnboxNumber (%MathUnary 23 target-length)) (%ToFloat bound-count)))]
            (if (%Lt (%ToFloat 0) d) (%Box d) (%BoxInt 0)))
          (%BoxInt 0))))

; A bound function's [[Call]] and [[Construct]] (§10.4.1.1-2): the target called with the bound
; `this` and the bound arguments before the call's own; constructed with them, the new.target being
; the target when it was the bound function itself.
(builtin JsBoundFunctionInvoke :transitioning true :throws true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (if (%IsFunction callee)
      (let [(record (%ClosureEnv callee))]
        (if (%IsArray record)
            (let [(raw (%UnboxArray record))]
              (let [(target (%ArrayLoad raw 0))]
                (if (%IsFunction target)
                    (let [(args (JsBoundArguments raw (JsArgumentsArray count overflow a0 a1 a2)))]
                      (if (%IsUndefined newtarget)
                          (JsCallWithArray target (%ArrayLoad raw 1) newtarget args)
                          (JsBoundConstruct target (if (JsStrictEqualValue callee newtarget) target newtarget) args)))
                    (JsThrowTypeError (%Box "A bound function's target is not callable")))))
            (JsThrowTypeError (%Box "A bound function has no bound record"))))
      (JsThrowTypeError (%Box "A bound function entry was called without its function object"))))

; The bound arguments (the record from index 2), then the call's own.
(builtin JsBoundArguments :transitioning true :params [(raw arr) (own dyn)] :ret dyn
  (let [(all (JsNewArray 0))]
    (let [(bound (JsArrayCopyRange raw 2 (%ArrayLen raw) (%UnboxArray all) 0))]
      (let [(appended (JsArrayConcatOne own (%UnboxArray all) (%ArrayLen (%UnboxArray all))))]
        all))))

; Construct(target, args, newTarget) for a bound target: the receiver as `new` makes it for that
; target, created from newTarget's `prototype`; the target's own object result wins.
(builtin JsBoundConstruct :transitioning true :throws true
  :params [(target dyn) (newtarget dyn) (args dyn)] :ret dyn
  (if (%IsFunction target)
      (if (%Eq (%And (%FunctionFlags target) 1) 0)
          (JsThrowTypeError (%Box "Bound target is not a constructor"))
          (let [(receiver (if (%Eq (%And (%FunctionFlags target) 2) 0)
                              (%Undefined)
                              (JsOrdinaryCreateFromConstructor newtarget (%IntrinsicPrototype "Object.prototype"))))]
            (if (%IsException receiver)
                receiver
                (let [(returned (JsCallWithArray target receiver newtarget args))]
                  (if (%IsException returned)
                      returned
                      (JsConstructResult returned receiver))))))
      (JsThrowTypeError (%Box "Bound target is not a constructor"))))

; Call(F, thisArg, argumentsList) over an argument list held in an array: its length is the count,
; its first three elements the direct actuals, the rest a fresh overflow vector.
(builtin JsCallWithArray :transitioning true :throws true
  :params [(target dyn) (receiver dyn) (newtarget dyn) (args dyn)] :ret dyn
  (if (%IsFunction target)
      (if (%IsArray args)
          (let [(raw (%UnboxArray args))]
            (%CallFunctionPacked target receiver newtarget
                                 (%ArrayArgumentCount raw) (%ArgumentTail raw)
                                 (JsArrayElementOrUndefined raw 0)
                                 (JsArrayElementOrUndefined raw 1)
                                 (JsArrayElementOrUndefined raw 2)))
          (JsThrowTypeError (%Box "An argument list is not an array")))
      (JsThrowTypeError (%Box "Call of a value that is not a function"))))
