; Constructors and the prototype chain (docs/DECISIONS.md, constructors).

; `new F(args)` returns the object F returned if it returned an object, else the fresh object that
; was F's receiver.
(macro JsConstructResult :params [(returned dyn) (created dyn)] :ret dyn
  (if (%IsObjectLike returned) returned created))

; OrdinaryHasInstance over the represented prototype chain: walk the value's [[Prototype]] until
; it is the constructor's `prototype` object or null.
(builtin JsInstanceofWalk :transitioning true :params [(value dyn) (target dyn)] :ret dyn
  (if (%IsObjectLike value)
      (let [(parent (%GetObjectPrototype (%UnboxObjectLike value)))]
        (if (%IsNull parent)
            (JsFalse)
            (if (JsStrictEqualValue parent target)
                (JsTrue)
                (JsInstanceofWalk parent target))))
      (JsFalse)))

(builtin JsInstanceof :transitioning true :throws true :params [(value dyn) (constructor dyn)] :ret dyn
  (if (%IsFunction constructor)
      (let [(proto (JsGetNamed constructor (%PropertyKey "prototype")))]
        (if (%IsException proto) proto (JsInstanceofWalk value proto)))
      (JsThrowTypeError (%Box "Right-hand side of 'instanceof' is not callable"))))

; ToPropertyKey (§7.1.19) without symbols: a string is interned to its key id at run time, any other
; primitive through ToString (`o[1]` is `o["1"]`); an object would need ToPrimitive and refuses
; inside JsToString by name.
(builtin JsToPropertyKey :transitioning true :params [(key dyn)] :ret int
  (if (%IsString key)
      (%InternKey (%UnboxString key))
      (%InternKey (%UnboxString (JsToString key)))))

; Computed property access (§13.3.3): on an array, a key that is an array index reaches the
; element (docs/DECISIONS.md, arrays); every other key is the named access over the interned key.
(builtin JsGetKeyed :transitioning true :throws true :params [(object dyn) (key dyn)] :ret dyn
  (if (%IsArray object)
      (let [(index (JsArrayIndexOfKey key))]
        (if (%Lt index 0)
            (JsGetNamed object (JsToPropertyKey key))
            (JsArrayGetIndex object index key)))
      ;; A string's integer-indexed exotic properties are its code units (§10.4.3.5).
      (if (%IsString object)
          (let [(index (JsArrayIndexOfKey key))]
            (if (%Lt index 0)
                (JsGetNamed object (JsToPropertyKey key))
                (JsStringIndexGet object index key)))
          (JsGetNamed object (JsToPropertyKey key)))))

(builtin JsSetKeyed :transitioning true :throws true :params [(object dyn) (key dyn) (value dyn) (strict int)] :ret dyn
  (if (%IsArray object)
      (let [(index (JsArrayIndexOfKey key))]
        (if (%Lt index 0)
            (JsSetKeyedNamed object key value strict)
            (JsArraySetIndex object index value)))
      (JsSetKeyedNamed object key value strict)))

(macro JsSetKeyedNamed :transitioning true :throws true :params [(object dyn) (key dyn) (value dyn) (strict int)] :ret dyn
  (let [(stored (JsDefineOwnNamed object (JsToPropertyKey key) value strict))]
    (if (%IsException stored) stored value)))

; A name the realm never declares: a global object lookup or a ReferenceError at run time. The
; key names the identifier in the refusal.
(macro JsUnresolvedGlobalRead :params [(key int)] :ret dyn
  (let [(trapped (%TrapUnresolvedGlobal key))]
    (%Undefined)))

(macro JsUnresolvedGlobalWrite :params [(key int) (value dyn)] :ret dyn
  (let [(trapped (%TrapUnresolvedGlobal key))]
    value))

; GetBindingValue on an existing global declarative binding throws for TDZ, including typeof.
(macro JsGlobalLexicalRead :transitioning true :throws true :params [(slot int)] :ret dyn
  (if (%Eq (%And (%GlobalLexicalState slot) 1) 0)
      (JsThrowReferenceError)
      (%GlobalLexicalValue slot)))

; A resolved global declarative binding has a positive realm-owned slot. Check TDZ before
; mutability (ECMA-262 9.1.1.1.5); const bindings are strict even in a sloppy Script.
; The caller evaluates and checks the RHS completion before entering this operation.
(macro JsGlobalLexicalWrite :transitioning true :throws true :params [(slot int) (value dyn)] :ret dyn
  (let [(state (%GlobalLexicalState slot))]
    (if (%Eq (%And state 1) 0)
        (JsThrowReferenceError)
        (if (%Eq (%And state 2) 0)
            (JsThrowTypeError (%Box "Assignment to constant variable"))
            (%GlobalLexicalStore slot value)))))

; Object-environment binding lookup for an independently compiled Script. HasBinding includes
; inherited properties and does not invoke a getter. GetBindingValue then performs [[Get]],
; including getter completions. The source assembler must handle declarative bindings before
; selecting this object-record path (ECMA-262 9.1.1.2 and 9.1.1.4).
(macro JsGlobalObjectBindingRead :transitioning true :throws true :params [(key int)] :ret dyn
  (let [(global (%GlobalObject))]
    (if (JsTruthy (JsHasNamedProperty global key))
        (JsGetNamed global key)
        (JsThrowReferenceError))))

; typeof suppresses only an absent binding, not an exception from an existing property's getter.
; For an ordinary object record, [[Get]] already returns undefined for an absent property.
(macro JsGlobalObjectTypeofOperand :transitioning true :throws true :params [(key int)] :ret dyn
  (JsGetNamed (%GlobalObject) key))

; The declarative record precedes the object record, including imported names and typeof.
; These are shared call bodies, not unconditional expansions at every identifier. The normal
; evidence/size-gated JSL inliner may specialize them; a mutable realm does not by itself
; justify cloning the entire binding lookup and its exception paths into each source site.
(builtin JsGlobalBindingRead :transitioning true :throws true :params [(key int)] :ret dyn
  (let [(slot (%GlobalLexicalFind key))]
    (if (%Eq slot 0) (JsGlobalObjectBindingRead key) (JsGlobalLexicalRead slot))))

(builtin JsGlobalTypeofOperand :transitioning true :throws true :params [(key int)] :ret dyn
  (let [(slot (%GlobalLexicalFind key))]
    (if (%Eq slot 0) (JsGlobalObjectTypeofOperand key) (JsGlobalLexicalRead slot))))

; HasBinding for the ordinary object-record branch, without invoking an accessor.
(macro JsGlobalObjectHasBinding :transitioning true :params [(global dyn) (key int)] :ret bool
  (JsTruthy (JsHasNamedProperty global key)))

; Resolve once before RHS evaluation: positive = lexical slot, -1 = object binding,
; zero = unresolvable. Global lexical slots cannot disappear during evaluation.
(macro JsGlobalResolveReference :transitioning true :params [(global dyn) (key int)] :ret int
  (let [(slot (%GlobalLexicalFind key))]
    (if (%Eq slot 0) (if (JsGlobalObjectHasBinding global key) -1 0) slot)))

(macro JsGlobalReferenceRead :transitioning true :throws true
  :params [(global dyn) (key int) (resolved int) (strict int)] :ret dyn
  (if (%Lt 0 resolved)
      (JsGlobalLexicalRead resolved)
      (if (%Eq resolved -1)
          (if (%Eq strict 1)
              (if (JsGlobalObjectHasBinding global key) (JsGetNamed global key) (JsThrowReferenceError))
              (JsGetNamed global key))
          (JsThrowReferenceError))))

; PutValue distinguishes an unresolvable Reference from an environment Reference before it
; applies SetMutableBinding. Strict unresolved writes throw even if the RHS created the key.
; SetMutableBinding also checks whether a resolved binding disappeared during the RHS.
; Sloppy unresolved writes use Set(global, key, value, false), including any current setter.
(macro JsGlobalReferenceWrite :transitioning true :throws true
  :params [(global dyn) (key int) (resolved int) (value dyn) (strict int)] :ret dyn
  (if (%Lt 0 resolved)
      (JsGlobalLexicalWrite resolved value)
      (if (%Eq strict 1)
          (if (%Eq resolved -1)
              (if (JsGlobalObjectHasBinding global key)
                  (JsDefineOwnNamed global key value strict)
                  (JsThrowReferenceError))
              (JsThrowReferenceError))
          (JsDefineOwnNamed global key value strict))))

; GlobalDeclarationInstantiation checks lexical conflicts before any binding creation.
(builtin JsCheckGlobalLexicalDeclaration :transitioning true :throws true :noinline true :params [(key int)] :ret dyn
  (if (%Ne (%GlobalLexicalFind key) 0)
      (JsThrowSyntaxError)
      (let [(attrs (%PropAttrsOwn (%UnboxObjectLike (%GlobalObject)) key))]
        (if (%Lt attrs 0) (%Undefined)
            (if (%Eq (%And attrs 4) 0) (JsThrowSyntaxError) (%Undefined))))))

(macro JsCheckGlobalVarLexicalConflict :transitioning true :throws true :params [(key int)] :ret dyn
  (if (%Eq (%GlobalLexicalFind key) 0) (%Undefined) (JsThrowSyntaxError)))

(macro JsCreateGlobalLexicalBinding :params [(key int) (writable int)] :ret dyn
  (let [(slot (%GlobalLexicalCreate key writable))] (%Undefined)))

(macro JsInitializeGlobalLexicalBinding :params [(key int) (value dyn)] :ret dyn
  (%GlobalLexicalInitialize (%GlobalLexicalFind key) value))

; A Script can retain the stable identity returned by its own declaration instantiation.
; This is not a cached value or a cached absence; later reads still check TDZ and load the cell.
(macro JsCreateGlobalLexicalSlot :params [(key int) (writable int)] :ret int
  (%GlobalLexicalCreate key writable))

(macro JsInitializeGlobalLexicalSlot :params [(slot int) (value dyn)] :ret dyn
  (%GlobalLexicalInitialize slot value))

(builtin JsReadGlobalLexicalSlot :transitioning true :throws true :noinline true
  :params [(slot int)] :ret dyn
  (JsGlobalLexicalRead slot))

; GlobalDeclarationInstantiation checks every declaration before it creates bindings. These
; operations implement the ordinary object-record checks; lexical conflicts belong to the
; declarative record. An inherited property does not count as an own declaration binding.
(macro JsCheckGlobalFunctionDeclaration :transitioning true :throws true :params [(key int)] :ret dyn
  (let [(global (%GlobalObject))
        (attrs (%PropAttrsOwn (%UnboxObjectLike global) key))
        (allowed (if (%Lt attrs 0)
                     (%Eq (%IsExtensible (%UnboxObjectLike global)) 1)
                     (if (%Ne (%And attrs 4) 0) (%Eq 0 0) (%Eq attrs 3))))]
    (if allowed (%Undefined) (JsThrowTypeError (%Box "Cannot declare global function")))))

(macro JsCheckGlobalVarDeclaration :transitioning true :throws true :params [(key int)] :ret dyn
  (let [(global (%GlobalObject))]
    (if (JsHasOwnNamed global key)
        (%Undefined)
        (if (%Eq (%IsExtensible (%UnboxObjectLike global)) 1)
            (%Undefined)
            (JsThrowTypeError (%Box "Cannot declare global variable"))))))

; CreateGlobalFunctionBinding with deletable=false. A configurable accessor becomes a data
; property without calling its setter. A non-configurable data property keeps its attributes.
; JsApplyDefine uses the shared descriptor validator; the following Set is the specification's
; InitializeBinding step. Proxies require their own internal-method dispatch before admission.
(macro JsCreateGlobalFunctionBinding :transitioning true :throws true
  :params [(key int) (value dyn)] :ret dyn
  (let [(global (%GlobalObject))
        (attrs (%PropAttrsOwn (%UnboxObjectLike global) key))
        (mask (if (%Lt attrs 0) 15 (if (%Ne (%And attrs 4) 0) 15 1)))
        (defined (JsApplyDefine global key value 3 mask))]
    (if (%IsException defined) defined (JsDefineOwnNamed global key value 0))))

; Existing own bindings keep both their value and attributes. A new var is writable and
; enumerable, non-configurable, and initialized to undefined at Script instantiation time.
(macro JsCreateGlobalVarBinding :transitioning true :throws true :params [(key int)] :ret dyn
  (let [(global (%GlobalObject))]
    (if (JsHasOwnNamed global key)
        (%Undefined)
        (if (%Eq (%IsExtensible (%UnboxObjectLike global)) 1)
            (let [(defined (JsApplyDefine global key (%Undefined) 3 15))]
              (if (%IsException defined) defined (JsDefineOwnNamed global key (%Undefined) 0)))
            (%Undefined)))))
