; Constructors and the prototype chain (docs/DECISIONS.md, constructors).

; `new F(args)` returns the object F returned if it returned an object, else the fresh object that
; was F's receiver.
(macro JsConstructResult :params [(returned dyn) (created dyn)] :ret dyn
  (if (%IsObjectLike returned) returned created))

; OrdinaryHasInstance over the represented prototype chain: walk the value's [[Prototype]] until
; it is the constructor's `prototype` object or null.
(builtin JsInstanceofWalk :params [(value dyn) (target dyn)] :ret dyn
  (if (%IsObjectLike value)
      (let [(parent (%GetObjectPrototype (%UnboxObjectLike value)))]
        (if (%IsNull parent)
            (JsFalse)
            (if (JsStrictEqualValue parent target)
                (JsTrue)
                (JsInstanceofWalk parent target))))
      (JsFalse)))

(builtin JsInstanceof :params [(value dyn) (constructor dyn)] :ret dyn
  (if (%IsFunction constructor)
      (JsInstanceofWalk value (JsGetNamed constructor (%PropertyKey "prototype")))
      (let [(thrown (%ThrowTypeError))]
        (JsFalse))))

; Computed property access: runtime keys are not interned yet and arrays do not exist, so both
; refuse at run time by name. They compile, so the code around them does too.
(builtin JsGetKeyed :params [(object dyn) (key dyn)] :ret dyn
  (let [(trapped (%TrapKeyedAccess))]
    (%Undefined)))

(builtin JsSetKeyed :params [(object dyn) (key dyn) (value dyn)] :ret dyn
  (let [(trapped (%TrapKeyedAccess))]
    value))

; A name the realm never declares: a global object lookup or a ReferenceError at run time.
(macro JsUnresolvedGlobalRead :params [] :ret dyn
  (let [(trapped (%TrapUnresolvedGlobal))]
    (%Undefined)))

(macro JsUnresolvedGlobalWrite :params [(value dyn)] :ret dyn
  (let [(trapped (%TrapUnresolvedGlobal))]
    value))
