; OrdinaryCallBindThis for non-strict code: an undefined or null receiver becomes the global
; object. Primitive receivers would become wrapper objects (ToObject); those wrappers do not
; exist yet, so a primitive receiver is passed through unchanged and its property access refuses.
(macro JsSloppyThis :params [(receiver dyn)] :ret dyn
  (if (%IsUndefined receiver)
      (%GlobalObject)
      (if (%IsNull receiver)
          (%GlobalObject)
          receiver)))

; The same binding in a function-entry program, which has no global object: an undefined or null
; receiver refuses at run time by name; an object receiver passes through.
(macro JsSloppyThisNoRealm :params [(receiver dyn)] :ret dyn
  (if (%IsUndefined receiver)
      (let [(trapped (%TrapNoRealm))] receiver)
      (if (%IsNull receiver)
          (let [(trapped (%TrapNoRealm))] receiver)
          receiver)))
