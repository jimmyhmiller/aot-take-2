; Date (§21.4). A Date is one number: milliseconds since the epoch, in an internal slot. Everything
; else — years, months, weekdays, leap years — is arithmetic over that number, exactly as §21.4.1
; defines it, so the only thing the host is asked for is the clock and the zone's offset.
;
; The offset is asked PER INSTANT (`%LocalTimeZoneOffset`), not once: a zone with daylight saving
; has two offsets a year, and which one applies depends on the instant being converted. Local time
; is therefore `t + offset(t)`, and the local accessors are the UTC ones over that shifted number.
;
; Every division here floors rather than truncating. An instant before 1970 is negative, and
; truncation toward zero would put it in the wrong day, hour and year.

(macro JsDateMsPerDay :params [] :ret int (%Mul 86400 1000))
(macro JsDateMsPerHour :params [] :ret int (%Mul 3600 1000))
(macro JsDateMsPerMinute :params [] :ret int (%Mul 60 1000))

; `:noinline` here is a WORKAROUND, not a choice. Inlined, these are called with a dozen different
; constant divisors (4, 7, 12, 24, 100, 400, 60000, 146097, 86400000), and the type analysis then
; panics: "n-set-ty!: monotonicity violated: new type int[4..146097]^2 is not at least as specific
; as old int[4..86400000]^1" — a Phi's type widened instead of narrowing. Keeping them calls keeps
; the divisor a parameter and the panic away. The compiler bug is the thing to fix
; (docs/GAPS.md — Date).
(builtin JsFloorDiv :noinline true :params [(a int) (b int)] :ret int
  (let [(q (%Div a b))]
    (if (%Ne (%Mul q b) a)
        (if (%Lt a 0) (%Sub q 1) q)
        q)))

(builtin JsFloorMod :noinline true :params [(a int) (b int)] :ret int
  (%Sub a (%Mul (JsFloorDiv a b) b)))

; Day(t) and TimeWithinDay(t) (§21.4.1.2).
(macro JsDateDay :params [(t int)] :ret int (JsFloorDiv t (JsDateMsPerDay)))
(macro JsDateTimeWithinDay :params [(t int)] :ret int (JsFloorMod t (JsDateMsPerDay)))

(macro JsDateLeapYear :params [(y int)] :ret bool
  (if (%Ne (JsFloorMod y 4) 0)
      (%Eq 0 1)
      (if (%Ne (JsFloorMod y 100) 0)
          (%Eq 0 0)
          (%Eq (JsFloorMod y 400) 0))))

(macro JsDateDaysInYear :params [(y int)] :ret int
  (if (JsDateLeapYear y) 366 365))

; DayFromYear (§21.4.1.3): the day number of January 1st of `y`, by the closed form the
; specification gives rather than a loop.
(builtin JsDayFromYear :params [(y int)] :ret int
  (%Add (%Sub (%Add (%Mul 365 (%Sub y 1970))
                    (JsFloorDiv (%Sub y 1969) 4))
              (JsFloorDiv (%Sub y 1901) 100))
        (JsFloorDiv (%Sub y 1601) 400)))

; YearFromTime (§21.4.1.3): the year containing day `d`. The estimate is within one year, and the
; correction step is the only search — two comparisons, not a loop over centuries.
(builtin JsYearFromDay :params [(d int)] :ret int
  (let [(guess (%Add 1970 (JsFloorDiv (%Mul d 400) 146097)))]
    (JsYearCorrect d guess)))

(builtin JsYearCorrect :noinline true :params [(d int) (y int)] :ret int
  (if (%Lt d (JsDayFromYear y))
      (JsYearCorrect d (%Sub y 1))
      (if (%Le (JsDayFromYear (%Add y 1)) d)
          (JsYearCorrect d (%Add y 1))
          y)))

; The day of the year, and from it the month and the day of the month (§21.4.1.4, §21.4.1.5). The
; month boundaries are walked from January because there are twelve of them and the walk is the
; clearest statement of the table the specification writes out.
(builtin JsDaysInMonth :params [(m int) (leap bool)] :ret int
  (if (%Eq m 0) 31
      (if (%Eq m 1) (if leap 29 28)
          (if (%Eq m 2) 31
              (if (%Eq m 3) 30
                  (if (%Eq m 4) 31
                      (if (%Eq m 5) 30
                          (if (%Eq m 6) 31
                              (if (%Eq m 7) 31
                                  (if (%Eq m 8) 30
                                      (if (%Eq m 9) 31
                                          (if (%Eq m 10) 30 31))))))))))))

(builtin JsMonthFromDayInYear :noinline true :params [(day int) (m int) (leap bool)] :ret int
  (let [(n (JsDaysInMonth m leap))]
    (if (%Lt day n)
        m
        (JsMonthFromDayInYear (%Sub day n) (%Add m 1) leap))))

(builtin JsDateFromDayInYear :noinline true :params [(day int) (m int) (leap bool)] :ret int
  (let [(n (JsDaysInMonth m leap))]
    (if (%Lt day n)
        (%Add day 1)
        (JsDateFromDayInYear (%Sub day n) (%Add m 1) leap))))

(macro JsDayWithinYear :params [(t int)] :ret int
  (%Sub (JsDateDay t) (JsDayFromYear (JsYearFromDay (JsDateDay t)))))

; WeekDay (§21.4.1.6): 1970-01-01 was a Thursday, so the epoch day is 4.
(macro JsWeekDay :params [(t int)] :ret int
  (JsFloorMod (%Add (JsDateDay t) 4) 7))

(macro JsHourFromTime :params [(t int)] :ret int
  (JsFloorMod (JsFloorDiv t (JsDateMsPerHour)) 24))

(macro JsMinFromTime :params [(t int)] :ret int
  (JsFloorMod (JsFloorDiv t (JsDateMsPerMinute)) 60))

(macro JsSecFromTime :params [(t int)] :ret int
  (JsFloorMod (JsFloorDiv t 1000) 60))

(macro JsMsFromTime :params [(t int)] :ret int
  (JsFloorMod t 1000))

; MakeDay, MakeTime and MakeDate (§21.4.1.11-13) — the constructor's direction, from broken-down
; parts back to an instant. The month is normalized first, so `new Date(2024, 12, 1)` is January of
; 2025, as the specification's arithmetic makes it.
(builtin JsMakeDay :params [(year int) (month int) (day int)] :ret int
  (let [(y (%Add year (JsFloorDiv month 12)))]
    (let [(m (JsFloorMod month 12))]
      (%Add (%Add (JsDayFromYear y) (JsDaysBeforeMonth m 0 0 (JsDateLeapYear y))) (%Sub day 1)))))

; The days before month `m`, accumulated on the way DOWN. Written the other way — adding the month
; on the way back out of the recursion — this was the one definition here that is not tail
; recursive, and compiling a program that could reach it took over ten minutes instead of under a
; second (docs/COMPILE-TIME.md §7).
(builtin JsDaysBeforeMonth :noinline true :params [(m int) (i int) (acc int) (leap bool)] :ret int
  (if (%Lt i m)
      (JsDaysBeforeMonth m (%Add i 1) (%Add acc (JsDaysInMonth i leap)) leap)
      acc))

(builtin JsMakeTime :params [(h int) (mi int) (s int) (ms int)] :ret int
  (%Add (%Add (%Mul h (JsDateMsPerHour)) (%Mul mi (JsDateMsPerMinute)))
        (%Add (%Mul s 1000) ms)))

; ---------------------------------------------------------------------------------------------
; The value in the slot, and the two directions across the local zone

(macro JsDateSlot :transitioning true :throws true :params [(date dyn)] :ret dyn
  (JsGetNamed date (%InternalKey "%DateValue%")))

(macro JsIsDate :params [(value dyn)] :ret bool
  (if (%IsObjectLike value)
      (%PropHasOwnNamed (%UnboxObjectLike value) (%InternalKey "%DateValue%"))
      (%Eq 0 1)))

; LocalTime(t) (§21.4.1.24) and UTC(t) (§21.4.1.25). The inverse is approximate where an offset
; changes: a local time inside a daylight-saving gap has no instant, and one inside the overlap has
; two. The offset at the estimated instant is used, which is what engines do (docs/GAPS.md — Date).
(macro JsLocalTime :transitioning true :params [(t int)] :ret int
  (%Add t (%LocalTimeZoneOffset t)))

(builtin JsUtcTime :transitioning true :params [(local int)] :ret int
  (%Sub local (%LocalTimeZoneOffset (%Sub local (%LocalTimeZoneOffset local)))))

; TimeClip (§21.4.1.31): a Date holds an integral number of milliseconds within ±8.64e15, and
; anything else is NaN — which is the invalid Date.
(builtin JsTimeClip :transitioning true :params [(value dyn)] :ret dyn
  (if (JsIsNumberValue value)
      (let [(f (JsPrimitiveNumber value))]
        (if (JsNumberFinite f)
            (if (%Lt (%ToFloat 8640000000000000) (JsAbsFloat f))
                (JsDateNaN)
                (%BoxInt (%ToInteger f)))
            (JsDateNaN)))
      (JsDateNaN)))

(macro JsAbsFloat :params [(f flt)] :ret flt
  (if (%Lt f (%ToFloat 0)) (%Sub (%ToFloat 0) f) f))

(macro JsDateNaN :transitioning true :params [] :ret dyn
  (%Box (%Div (%ToFloat 0) (%ToFloat 0))))

; The slot as an integer, for an accessor that has already established the Date is valid.
(macro JsDateMs :params [(value dyn)] :ret int
  (if (%IsInt value) (%UnboxInt value) (let [(trapped (%TrapInvariant))] 0)))

; ---------------------------------------------------------------------------------------------
; The constructor

(builtin JsDateConstructor :transitioning true :throws true
  :params [(this dyn) (newtarget dyn) (callee dyn) (a0 dyn) (a1 dyn) (a2 dyn)
           (a3 dyn) (a4 dyn) (a5 dyn)] :ret dyn
  (let [(created (JsOrdinaryCreateFromConstructor callee (%IntrinsicPrototype "Date.prototype")))]
    (if (%IsException created)
        created
        (let [(value (JsDateInitialValue a0 a1 a2 a3 a4 a5))]
          (if (%IsException value)
              value
              (if (%IsObjectLike created)
                  (let [(stored (JsCreateDataPropertyAttrs (%UnboxObjectLike created)
                                                           (%InternalKey "%DateValue%")
                                                           value
                                                           1))]
                    created)
                  created))))))

; `new Date()` is now; one argument is a time value or a string; two or more are local calendar
; parts (§21.4.2.1). A year below 100 is 1900 + year, which is the specification's own legacy rule.
(builtin JsDateInitialValue :transitioning true :throws true
  :params [(a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn) (a4 dyn) (a5 dyn)] :ret dyn
  (if (%IsUndefined a0)
      (%BoxInt (%DateNow))
      (if (%IsUndefined a1)
          (if (%IsString a0)
              (JsDateParseValue a0)
              (let [(n (JsToNumberValue a0))]
                (if (%IsException n) n (JsTimeClip n))))
          (let [(year (JsToNumberValue a0))]
            (if (%IsException year)
                year
                (let [(month (JsToNumberValue a1))]
                  (if (%IsException month)
                      month
                      (let [(day (if (%IsUndefined a2) (%BoxInt 1) (JsToNumberValue a2)))]
                        (if (%IsException day)
                            day
                            (JsDatePartsValue year month day a3 a4 a5 1))))))))))

; Date.now() (§21.4.3.1).
(builtin JsDateNow :transitioning true :params [(this dyn)] :ret dyn
  (%BoxInt (%DateNow)))

; ---------------------------------------------------------------------------------------------
; The accessors. Each is `thisTimeValue` then arithmetic; an invalid Date answers NaN.

(builtin JsThisDateValue :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsDate this)
      (JsDateSlot this)
      (JsThrowTypeError (%Box "Date.prototype method called on an incompatible receiver"))))

(builtin JsDateGetTime :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsThisDateValue this))

(builtin JsDateValueOf :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsThisDateValue this))

; `field` selects what is read: 0 year, 1 month, 2 date, 3 day, 4 hours, 5 minutes, 6 seconds,
; 7 milliseconds. `local` shifts the instant into the zone first.
(builtin JsDateField :transitioning true :throws true
  :params [(this dyn) (field int) (local int)] :ret dyn
  (let [(value (JsThisDateValue this))]
    (if (%IsException value)
        value
        (if (%IsInt value)
            (%BoxInt (JsDateFieldOf (if (%Eq local 1) (JsLocalTime (JsDateMs value)) (JsDateMs value))
                                    field))
            ;; The slot is NaN: an invalid Date answers NaN for every field.
            value))))

; The year search is the expensive part, so it runs once: the day, the year, its leap flag and the
; day within it are computed before the field is selected, not inside each arm.
(builtin JsDateFieldOf :noinline true :params [(t int) (field int)] :ret int
  (let [(d (JsDateDay t))]
    (let [(y (JsYearFromDay d))]
      (let [(leap (JsDateLeapYear y))]
        (let [(within (%Sub d (JsDayFromYear y)))]
          (if (%Eq field 0)
              y
              (if (%Eq field 1)
                  (JsMonthFromDayInYear within 0 leap)
                  (if (%Eq field 2)
                      (JsDateFromDayInYear within 0 leap)
                      (if (%Eq field 3)
                          (JsFloorMod (%Add d 4) 7)
                          (if (%Eq field 4)
                              (JsHourFromTime t)
                              (if (%Eq field 5)
                                  (JsMinFromTime t)
                                  (if (%Eq field 6)
                                      (JsSecFromTime t)
                                      (JsMsFromTime t)))))))))))))

(builtin JsDateGetFullYear :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 0 1))
(builtin JsDateGetMonth :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 1 1))
(builtin JsDateGetDate :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 2 1))
(builtin JsDateGetDay :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 3 1))
(builtin JsDateGetHours :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 4 1))
(builtin JsDateGetMinutes :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 5 1))
(builtin JsDateGetSeconds :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 6 1))
(builtin JsDateGetMilliseconds :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 7 1))

(builtin JsDateGetUTCFullYear :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 0 0))
(builtin JsDateGetUTCMonth :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 1 0))
(builtin JsDateGetUTCDate :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 2 0))
(builtin JsDateGetUTCDay :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 3 0))
(builtin JsDateGetUTCHours :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 4 0))
(builtin JsDateGetUTCMinutes :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 5 0))
(builtin JsDateGetUTCSeconds :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 6 0))
(builtin JsDateGetUTCMilliseconds :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsDateField this 7 0))

; getTimezoneOffset (§21.4.4.7) is minutes WEST of UTC, the opposite sign to the offset itself.
(builtin JsDateGetTimezoneOffset :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(value (JsThisDateValue this))]
    (if (%IsException value)
        value
        (if (%IsInt value)
            (%BoxInt (JsFloorDiv (%Sub 0 (%LocalTimeZoneOffset (JsDateMs value)))
                                 (JsDateMsPerMinute)))
            value))))

(builtin JsDateSetTime :transitioning true :throws true :params [(this dyn) (value dyn)] :ret dyn
  (if (JsIsDate this)
      (let [(n (JsToNumberValue value))]
        (if (%IsException n)
            n
            (let [(clipped (JsTimeClip n))]
              (let [(stored (JsDefineOwnNamed this (%InternalKey "%DateValue%") clipped 1))]
                (if (%IsException stored) stored clipped)))))
      (JsThrowTypeError (%Box "Date.prototype.setTime called on an incompatible receiver"))))

; ---------------------------------------------------------------------------------------------
; Rendering

(builtin JsDatePad :transitioning true :noinline true :params [(n int) (width int)] :ret str
  (let [(digits (%NumberToString (%BoxInt n)))]
    (JsDatePadTo digits width)))

(builtin JsDatePadTo :transitioning true :noinline true :params [(digits str) (width int)] :ret str
  (if (%Lt (%StringLength digits) width)
      (JsDatePadTo (%StringConcat "0" digits) width)
      digits))

; toISOString (§21.4.4.36): always UTC, always the same shape, and a RangeError for an invalid Date.
(builtin JsDateToISOString :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(value (JsThisDateValue this))]
    (if (%IsException value)
        value
        (if (%IsInt value)
            (let [(t (JsDateMs value))]
              (%Box (%StringConcat
                      (%StringConcat (%StringConcat (JsDatePad (JsDateFieldOf t 0) 4) "-")
                                     (%StringConcat (JsDatePad (%Add (JsDateFieldOf t 1) 1) 2) "-"))
                      (%StringConcat
                        (%StringConcat (JsDatePad (JsDateFieldOf t 2) 2) "T")
                        (%StringConcat
                          (%StringConcat (%StringConcat (JsDatePad (JsDateFieldOf t 4) 2) ":")
                                         (%StringConcat (JsDatePad (JsDateFieldOf t 5) 2) ":"))
                          (%StringConcat (JsDatePad (JsDateFieldOf t 6) 2)
                                         (%StringConcat (%StringConcat "." (JsDatePad (JsDateFieldOf t 7) 3))
                                                        "Z")))))))
            (JsThrowRangeError (%Box "Invalid time value"))))))

(builtin JsDateToJSON :transitioning true :throws true :params [(this dyn) (key dyn)] :ret dyn
  (JsDateToISOString this))

(builtin JsDateWeekdayName :params [(d int)] :ret str
  (if (%Eq d 0) "Sun"
      (if (%Eq d 1) "Mon"
          (if (%Eq d 2) "Tue"
              (if (%Eq d 3) "Wed"
                  (if (%Eq d 4) "Thu"
                      (if (%Eq d 5) "Fri" "Sat")))))))

(builtin JsDateMonthName :params [(m int)] :ret str
  (if (%Eq m 0) "Jan"
      (if (%Eq m 1) "Feb"
          (if (%Eq m 2) "Mar"
              (if (%Eq m 3) "Apr"
                  (if (%Eq m 4) "May"
                      (if (%Eq m 5) "Jun"
                          (if (%Eq m 6) "Jul"
                              (if (%Eq m 7) "Aug"
                                  (if (%Eq m 8) "Sep"
                                      (if (%Eq m 9) "Oct"
                                          (if (%Eq m 10) "Nov" "Dec"))))))))))))

; toString (§21.4.4.41): the local date and time in the fixed shape ToDateString gives, with the
; zone as an offset. An invalid Date is the string "Invalid Date", not an exception.
(builtin JsRenderDate :transitioning true :params [(t int)] :ret str
  (%StringConcat
    (%StringConcat
      (%StringConcat (JsDateWeekdayName (JsDateFieldOf t 3)) " ")
      (%StringConcat (%StringConcat (JsDateMonthName (JsDateFieldOf t 1)) " ")
                     (%StringConcat (JsDatePad (JsDateFieldOf t 2) 2) " ")))
    (%StringConcat
      (%StringConcat (JsDatePad (JsDateFieldOf t 0) 4) " ")
      (%StringConcat
        (%StringConcat (JsDatePad (JsDateFieldOf t 4) 2) ":")
        (%StringConcat (%StringConcat (JsDatePad (JsDateFieldOf t 5) 2) ":")
                       (JsDatePad (JsDateFieldOf t 6) 2))))))

(builtin JsDateToString :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(value (JsThisDateValue this))]
    (if (%IsException value)
        value
        (if (%IsInt value)
            (%Box (JsRenderDate (JsLocalTime (JsDateMs value))))
            (%Box "Invalid Date")))))

; @@toPrimitive with the default hint is a string for a Date, which is what makes `date + ""` the
; rendering and `+date` the number (§21.4.4.45).
(builtin JsDateToPrimitive :transitioning true :throws true :params [(this dyn) (hint dyn)] :ret dyn
  (if (%IsString hint)
      (if (%StringEq (%UnboxString hint) "number")
          (JsDateValueOf this)
          (JsDateToString this))
      (JsDateToString this)))

; Date.parse and the string form of the constructor (§21.4.3.2). Only the ISO shape the
; specification requires is read; anything else is an invalid Date rather than a guess
; (docs/GAPS.md — Date).
(builtin JsDateParseValue :transitioning true :throws true :params [(text dyn)] :ret dyn
  (let [(raw (%UnboxString text))]
    (if (%Lt (%StringLength raw) 10)
        (JsDateNaN)
        (let [(year (JsDateDigits raw 0 4))]
          (if (%Lt year 0)
              (JsDateNaN)
              (let [(month (JsDateDigits raw 5 2))]
                (if (%Lt month 0)
                    (JsDateNaN)
                    (let [(day (JsDateDigits raw 8 2))]
                      (if (%Lt day 0)
                          (JsDateNaN)
                          (%BoxInt (%Add (%Mul (JsMakeDay year (%Sub month 1) day) (JsDateMsPerDay))
                                         (JsDateParseTime raw))))))))))))

; The time part of an ISO string, or zero when there is none. A date-only string is UTC.
(builtin JsDateParseTime :params [(raw str)] :ret int
  (if (%Lt (%StringLength raw) 16)
      0
      (let [(h (JsDateDigits raw 11 2))]
        (if (%Lt h 0)
            0
            (let [(mi (JsDateDigits raw 14 2))]
              (if (%Lt mi 0)
                  0
                  (%Add (JsMakeTime h mi (JsDateParseSeconds raw) 0) 0)))))))

(builtin JsDateParseSeconds :params [(raw str)] :ret int
  (if (%Lt (%StringLength raw) 19)
      0
      (let [(s (JsDateDigits raw 17 2))]
        (if (%Lt s 0) 0 s))))

; `count` digits at `at` as a number, or -1 when any of them is not a digit.
(builtin JsDateDigits :params [(raw str) (at int) (count int)] :ret int
  (if (%Le (%Add at count) (%StringLength raw))
      (JsDateDigitsFrom raw at (%Add at count) 0)
      -1))

(builtin JsDateDigitsFrom :noinline true :params [(raw str) (i int) (end int) (acc int)] :ret int
  (if (%Lt i end)
      (let [(code (%StringCharCode raw i))]
        (if (%Le 48 code)
            (if (%Le code 57)
                (JsDateDigitsFrom raw (%Add i 1) end (%Add (%Mul acc 10) (%Sub code 48)))
                -1)
            -1))
      acc))

(builtin JsDateParse :transitioning true :throws true :params [(this dyn) (text dyn)] :ret dyn
  (let [(source (JsToStringValue text))]
    (if (%IsException source) source (JsDateParseValue source))))

; Date.UTC(year, month, day) (§21.4.3.4): the same parts, read as UTC rather than local.
(builtin JsDateUTC :transitioning true :throws true
  :params [(this dyn) (year dyn) (month dyn) (day dyn) (hours dyn) (minutes dyn) (seconds dyn)] :ret dyn
  (JsDatePartsValue year month day hours minutes seconds 0))

; The seven parts as one instant. `local` 1 reads them as local time, which is what the constructor
; does; 0 reads them as UTC, which is what `Date.UTC` does. A part that is absent is the
; specification's default — 1 for the day, 0 for everything else — and any part that is not finite
; makes the whole an invalid Date.
(builtin JsDatePartsValue :transitioning true :throws true
  :params [(year dyn) (month dyn) (day dyn) (hours dyn) (minutes dyn) (seconds dyn) (local int)] :ret dyn
  (let [(y (JsToNumberValue year))]
    (if (%IsException y)
        y
        (let [(mo (JsDatePart month 0))]
          (if (%IsException mo)
              mo
              (let [(d (JsDatePart day 1))]
                (if (%IsException d)
                    d
                    (let [(h (JsDatePart hours 0))]
                      (if (%IsException h)
                          h
                          (let [(mi (JsDatePart minutes 0))]
                            (if (%IsException mi)
                                mi
                                (let [(sec (JsDatePart seconds 0))]
                                  (if (%IsException sec)
                                      sec
                                      (JsDateAssemble y mo d h mi sec local))))))))))))))

(builtin JsDatePart :transitioning true :throws true :params [(value dyn) (fallback int)] :ret dyn
  (if (%IsUndefined value) (%BoxInt fallback) (JsToNumberValue value)))

(builtin JsDateAssemble :transitioning true :throws true
  :params [(year dyn) (month dyn) (day dyn) (hours dyn) (minutes dyn) (seconds dyn) (local int)] :ret dyn
  (if (JsDatePartsFinite year month day hours minutes seconds)
      (let [(y (%ToInteger (JsPrimitiveNumber year)))]
        ;; A year below 100 is 1900 + year, the specification's own legacy rule.
        (let [(full (if (%Le 0 y) (if (%Le y 99) (%Add 1900 y) y) y))]
          (let [(t (%Add (%Mul (JsMakeDay full
                                          (%ToInteger (JsPrimitiveNumber month))
                                          (%ToInteger (JsPrimitiveNumber day)))
                               (JsDateMsPerDay))
                         (JsMakeTime (%ToInteger (JsPrimitiveNumber hours))
                                     (%ToInteger (JsPrimitiveNumber minutes))
                                     (%ToInteger (JsPrimitiveNumber seconds))
                                     0)))]
            (%BoxInt (if (%Eq local 1) (JsUtcTime t) t)))))
      (JsDateNaN)))

(builtin JsDatePartsFinite
  :params [(year dyn) (month dyn) (day dyn) (hours dyn) (minutes dyn) (seconds dyn)] :ret bool
  (if (JsNumberFinite (JsPrimitiveNumber year))
      (if (JsNumberFinite (JsPrimitiveNumber month))
          (if (JsNumberFinite (JsPrimitiveNumber day))
              (if (JsNumberFinite (JsPrimitiveNumber hours))
                  (if (JsNumberFinite (JsPrimitiveNumber minutes))
                      (JsNumberFinite (JsPrimitiveNumber seconds))
                      (%Eq 0 1))
                  (%Eq 0 1))
              (%Eq 0 1))
          (%Eq 0 1))
      (%Eq 0 1)))
