; The Math object (ECMA-262 §21.3) and the number-valued global functions isNaN, isFinite,
; parseInt and parseFloat (§19.2). Math is a namespace object in the realm image whose methods are
; these builtins; each converts its arguments with ToNumber (JsPrimitiveNumber), boxes the Number
; (the word the primitives take) and hands it to the runtime's libm-backed table (`%MathUnary`, `%MathBinary`; aot.rt.number's
; MATH-OP-* codes are the numbers below), except where the specification is simple arithmetic.
; The constants (E, PI, ...) are data of the image object (docs/DECISIONS.md, Math and the number
; globals).
;
; The four ABI slots bound the variadic functions: max, min and hypot see at most four arguments,
; and a slot that arrived as undefined is indistinguishable from an absent one, so
; `Math.max(1, undefined)` is 1 where the specification says NaN (docs/GAPS.md).

; Math.abs (§21.3.2.1): -0 is +0, which `x < 0` alone would not give.
(builtin JsMathAbs :params [(this dyn) (a0 dyn)] :ret dyn
  (let [(x (JsPrimitiveNumber a0))]
    (%Box (if (%Lt x (%ToFloat 0))
              (%Sub (%ToFloat 0) x)
              (if (%Eq x (%ToFloat 0)) (%ToFloat 0) x)))))

; Math.sign (§21.3.2.29): NaN, +0 and -0 are themselves.
(builtin JsMathSign :params [(this dyn) (a0 dyn)] :ret dyn
  (let [(x (JsPrimitiveNumber a0))]
    (%Box (if (%Lt (%ToFloat 0) x)
              (%ToFloat 1)
              (if (%Lt x (%ToFloat 0))
                  (%Sub (%ToFloat 0) (%ToFloat 1))
                  x)))))

(builtin JsMathSqrt :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 1 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathSin :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 2 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathCos :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 3 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathTan :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 4 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathAsin :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 5 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathAcos :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 6 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathAtan :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 7 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathSinh :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 8 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathCosh :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 9 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathTanh :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 10 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathAsinh :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 11 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathAcosh :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 12 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathAtanh :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 13 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathExp :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 14 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathExpm1 :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 15 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathLog :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 16 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathLog1p :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 17 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathLog2 :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 18 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathLog10 :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 19 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathCbrt :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 20 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathFloor :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 21 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathCeil :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 22 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathTrunc :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 23 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathRound :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 24 (%Box (JsPrimitiveNumber a0))))
(builtin JsMathFround :params [(this dyn) (a0 dyn)] :ret dyn (%MathUnary 25 (%Box (JsPrimitiveNumber a0))))

; Math.pow (§21.3.2.26) and atan2 (§21.3.2.5) convert both arguments first, in order.
(builtin JsMathPow :params [(this dyn) (a0 dyn) (a1 dyn)] :ret dyn
  (let [(x (%Box (JsPrimitiveNumber a0)))]
    (let [(y (%Box (JsPrimitiveNumber a1)))]
      (%MathBinary 40 x y))))

(builtin JsMathAtan2 :params [(this dyn) (a0 dyn) (a1 dyn)] :ret dyn
  (let [(y (%Box (JsPrimitiveNumber a0)))]
    (let [(x (%Box (JsPrimitiveNumber a1)))]
      (%MathBinary 41 y x))))

(builtin JsMathRandom :params [(this dyn)] :ret dyn
  (%MathRandom))

; Math.max (§21.3.2.24) and Math.min (§21.3.2.25) over the slots that arrived, converted in
; order: a NaN wins; +0 is above -0. With no argument, -Infinity or +Infinity.
(builtin JsMathMax :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (%Box (JsMathLarger (JsMathLarger (JsMathLarger (JsMathLarger (%Sub (%ToFloat 0) (%Div (%ToFloat 1) (%ToFloat 0))) a0) a1) a2) a3)))

(builtin JsMathMin :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (%Box (JsMathSmaller (JsMathSmaller (JsMathSmaller (JsMathSmaller (%Div (%ToFloat 1) (%ToFloat 0)) a0) a1) a2) a3)))

; The larger of the running value and a slot: an absent slot (undefined) leaves the running value;
; a NaN poisons it; equal magnitudes prefer +0, which only a division tells from -0.
(macro JsMathLarger :params [(acc flt) (slot dyn)] :ret flt
  (if (%IsUndefined slot)
      acc
      (let [(x (JsPrimitiveNumber slot))]
        (if (%Ne x x)
            x
            (if (%Ne acc acc)
                acc
                (if (%Lt acc x)
                    x
                    (if (%Lt x acc)
                        acc
                        (if (%Lt (%Div (%ToFloat 1) acc) (%ToFloat 0)) x acc))))))))

(macro JsMathSmaller :params [(acc flt) (slot dyn)] :ret flt
  (if (%IsUndefined slot)
      acc
      (let [(x (JsPrimitiveNumber slot))]
        (if (%Ne x x)
            x
            (if (%Ne acc acc)
                acc
                (if (%Lt x acc)
                    x
                    (if (%Lt acc x)
                        acc
                        (if (%Lt (%Div (%ToFloat 1) x) (%ToFloat 0)) x acc))))))))

; Math.hypot (§21.3.2.18) over the slots that arrived, as nested two-argument hypot: the libm
; function is correctly rounded pairwise and free of the overflow the naive square sum has.
(builtin JsMathHypot :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (%Box (JsMathHypotStep (JsMathHypotStep (JsMathHypotStep (JsMathHypotStep (%ToFloat 0) a0) a1) a2) a3)))

(macro JsMathHypotStep :params [(acc flt) (slot dyn)] :ret flt
  (if (%IsUndefined slot)
      acc
      (%UnboxNumber (%MathBinary 42 (%Box acc) (%Box (JsPrimitiveNumber slot))))))

; --- the number-valued global functions (§19.2) ---
; A global function is a plain function: constructing it is a TypeError.

(builtin JsGlobalIsNaN :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (a0 dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (let [(x (JsPrimitiveNumber a0))]
        (%BoxBool (%Ne x x)))
      (JsThrowTypeError (%Box "isNaN is not a constructor"))))

(builtin JsGlobalIsFinite :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (a0 dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (let [(x (JsPrimitiveNumber a0))]
        (%BoxBool (%Eq (%Sub x x) (%ToFloat 0))))
      (JsThrowTypeError (%Box "isFinite is not a constructor"))))

; parseInt(string, radix) (§19.2.5): ToString of the input, ToInt32 of the radix (an integer
; here; a radix beyond 2^31 wraps in the specification and is out of range either way).
(builtin JsGlobalParseInt :transitioning true :throws true
  :params [(this dyn) (newtarget dyn) (callee dyn) (a0 dyn) (a1 dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (let [(s (JsToString a0))]
        (let [(radix (if (%IsUndefined a1) 0 (%ToInteger (JsPrimitiveNumber a1))))]
          (%ParseInt (%UnboxString s) radix)))
      (JsThrowTypeError (%Box "parseInt is not a constructor"))))

(builtin JsGlobalParseFloat :transitioning true :throws true
  :params [(this dyn) (newtarget dyn) (callee dyn) (a0 dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (let [(s (JsToString a0))]
        (%ParseFloat (%UnboxString s)))
      (JsThrowTypeError (%Box "parseFloat is not a constructor"))))
