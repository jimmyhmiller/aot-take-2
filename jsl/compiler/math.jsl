; The Math object (ECMA-262 §21.3) and the number-valued global functions isNaN, isFinite,
; parseInt and parseFloat (§19.2). Math is a namespace object in the realm image whose methods are
; these builtins; each converts its arguments with ToNumber (JsPrimitiveNumber), boxes the Number
; (the word the primitives take) and hands it to the runtime's libm-backed table (`%MathUnary`, `%MathBinary`; aot.rt.number's
; MATH-OP-* codes are the numbers below), except where the specification is simple arithmetic.
; The constants (E, PI, ...) are data of the image object (docs/DECISIONS.md, Math and the number
; globals).
;
; The four ABI slots bound the variadic functions: max, min and hypot see at most four arguments,
; and a slot that arrived as undefined is indistinguishable from an absent one, so
; `Math.max(1, undefined)` is 1 where the specification says NaN (docs/GAPS.md).

; Math.abs (§21.3.2.1): -0 is +0, which `x < 0` alone would not give.
(builtin JsMathAbs :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn
  (let [(n (JsToNumberValue a0))]
    (if (%IsException n)
        n
        (let [(x (%UnboxNumber n))]
          (%Box (if (%Lt x (%ToFloat 0))
                    (%Sub (%ToFloat 0) x)
                    (if (%Eq x (%ToFloat 0)) (%ToFloat 0) x)))))))

; Math.sign (§21.3.2.29): NaN, +0 and -0 are themselves.
(builtin JsMathSign :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn
  (let [(n (JsToNumberValue a0))]
    (if (%IsException n)
        n
        (let [(x (%UnboxNumber n))]
          (%Box (if (%Lt (%ToFloat 0) x)
                    (%ToFloat 1)
                    (if (%Lt x (%ToFloat 0))
                        (%Sub (%ToFloat 0) (%ToFloat 1))
                        x)))))))

(builtin JsMathSqrt :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 1 a0))
(builtin JsMathSin :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 2 a0))
(builtin JsMathCos :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 3 a0))
(builtin JsMathTan :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 4 a0))
(builtin JsMathAsin :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 5 a0))
(builtin JsMathAcos :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 6 a0))
(builtin JsMathAtan :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 7 a0))
(builtin JsMathSinh :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 8 a0))
(builtin JsMathCosh :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 9 a0))
(builtin JsMathTanh :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 10 a0))
(builtin JsMathAsinh :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 11 a0))
(builtin JsMathAcosh :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 12 a0))
(builtin JsMathAtanh :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 13 a0))
(builtin JsMathExp :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 14 a0))
(builtin JsMathExpm1 :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 15 a0))
(builtin JsMathLog :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 16 a0))
(builtin JsMathLog1p :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 17 a0))
(builtin JsMathLog2 :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 18 a0))
(builtin JsMathLog10 :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 19 a0))
(builtin JsMathCbrt :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 20 a0))
(builtin JsMathFloor :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 21 a0))
(builtin JsMathCeil :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 22 a0))
(builtin JsMathTrunc :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 23 a0))
(builtin JsMathRound :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 24 a0))
(builtin JsMathFround :transitioning true :throws true :params [(this dyn) (a0 dyn)] :ret dyn (JsMathUnaryOf 25 a0))

; Math.pow (§21.3.2.26) and atan2 (§21.3.2.5) convert both arguments first, in order.
(builtin JsMathPow :transitioning true :throws true :params [(this dyn) (a0 dyn) (a1 dyn)] :ret dyn
  (JsMathBinaryOf 40 a0 a1))

(builtin JsMathAtan2 :transitioning true :throws true :params [(this dyn) (a0 dyn) (a1 dyn)] :ret dyn
  (JsMathBinaryOf 41 a0 a1))

; A two-argument Math function over ToNumber of both arguments, converted in order.
(macro JsMathBinaryOf :transitioning true :throws true :params [(op int) (a dyn) (b dyn)] :ret dyn
  (let [(x (JsToNumberValue a))]
    (if (%IsException x)
        x
        (let [(y (JsToNumberValue b))]
          (if (%IsException y) y (%MathBinary op (%Box (%UnboxNumber x)) (%Box (%UnboxNumber y))))))))

(builtin JsMathRandom :params [(this dyn)] :ret dyn
  (%MathRandom))

; Math.max (§21.3.2.24) and Math.min (§21.3.2.25) over the slots that arrived, converted in
; order: a NaN wins; +0 is above -0. With no argument, -Infinity or +Infinity.
(builtin JsMathMax :transitioning true :throws true :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (JsMathVariadic 0 a0 a1 a2 a3))

(builtin JsMathMin :transitioning true :throws true :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (JsMathVariadic 1 a0 a1 a2 a3))

; max (0), min (1) and hypot (2) convert every slot that arrived, in order, before computing: a
; conversion that throws ends the call with its exception.
(builtin JsMathVariadic :transitioning true :throws true :params [(op int) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (let [(n0 (JsToNumberSlot a0))]
    (if (%IsException n0)
        n0
        (let [(n1 (JsToNumberSlot a1))]
          (if (%IsException n1)
              n1
              (let [(n2 (JsToNumberSlot a2))]
                (if (%IsException n2)
                    n2
                    (let [(n3 (JsToNumberSlot a3))]
                      (if (%IsException n3)
                          n3
                          (if (%Eq op 0)
                              (%Box (JsMathLarger (JsMathLarger (JsMathLarger (JsMathLarger (%Sub (%ToFloat 0) (%Div (%ToFloat 1) (%ToFloat 0))) n0) n1) n2) n3))
                              (if (%Eq op 1)
                                  (%Box (JsMathSmaller (JsMathSmaller (JsMathSmaller (JsMathSmaller (%Div (%ToFloat 1) (%ToFloat 0)) n0) n1) n2) n3))
                                  (%Box (JsMathHypotStep (JsMathHypotStep (JsMathHypotStep (JsMathHypotStep (%ToFloat 0) n0) n1) n2) n3)))))))))))))

; A slot that arrived as undefined stays absent; any other value is ToNumber'd.
(macro JsToNumberSlot :transitioning true :throws true :params [(slot dyn)] :ret dyn
  (if (%IsUndefined slot) slot (JsToNumberValue slot)))

; The larger of the running value and a slot: an absent slot (undefined) leaves the running value;
; a NaN poisons it; equal magnitudes prefer +0, which only a division tells from -0.
(macro JsMathLarger :params [(acc flt) (slot dyn)] :ret flt
  (if (%IsUndefined slot)
      acc
      (let [(x (JsPrimitiveNumber slot))]
        (if (%Ne x x)
            x
            (if (%Ne acc acc)
                acc
                (if (%Lt acc x)
                    x
                    (if (%Lt x acc)
                        acc
                        (if (%Lt (%Div (%ToFloat 1) acc) (%ToFloat 0)) x acc))))))))

(macro JsMathSmaller :params [(acc flt) (slot dyn)] :ret flt
  (if (%IsUndefined slot)
      acc
      (let [(x (JsPrimitiveNumber slot))]
        (if (%Ne x x)
            x
            (if (%Ne acc acc)
                acc
                (if (%Lt x acc)
                    x
                    (if (%Lt acc x)
                        acc
                        (if (%Lt (%Div (%ToFloat 1) x) (%ToFloat 0)) x acc))))))))

; Math.hypot (§21.3.2.18) over the slots that arrived, as nested two-argument hypot: the libm
; function is correctly rounded pairwise and free of the overflow the naive square sum has.
(builtin JsMathHypot :transitioning true :throws true :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (JsMathVariadic 2 a0 a1 a2 a3))

(macro JsMathHypotStep :params [(acc flt) (slot dyn)] :ret flt
  (if (%IsUndefined slot)
      acc
      (%UnboxNumber (%MathBinary 42 (%Box acc) (%Box (JsPrimitiveNumber slot))))))

; --- the number-valued global functions (§19.2) ---
; A global function is a plain function: constructing it is a TypeError.

(builtin JsGlobalIsNaN :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (a0 dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (let [(n (JsToNumberValue a0))]
        (if (%IsException n)
            n
            (let [(x (%UnboxNumber n))]
              (%BoxBool (%Ne x x)))))
      (JsThrowTypeError (%Box "isNaN is not a constructor"))))

(builtin JsGlobalIsFinite :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (a0 dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (let [(n (JsToNumberValue a0))]
        (if (%IsException n)
            n
            (let [(x (%UnboxNumber n))]
              (%BoxBool (%Eq (%Sub x x) (%ToFloat 0))))))
      (JsThrowTypeError (%Box "isFinite is not a constructor"))))

; parseInt(string, radix) (§19.2.5): ToString of the input, ToInt32 of the radix (an integer
; here; a radix beyond 2^31 wraps in the specification and is out of range either way).
(builtin JsGlobalParseInt :transitioning true :throws true
  :params [(this dyn) (newtarget dyn) (callee dyn) (a0 dyn) (a1 dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (let [(s (JsToStringValue a0))]
        (if (%IsException s)
            s
            (let [(r (if (%IsUndefined a1) (%BoxInt 0) (JsToNumberValue a1)))]
              (if (%IsException r)
                  r
                  (%ParseInt (%UnboxString s) (%ToInteger (%UnboxNumber r)))))))
      (JsThrowTypeError (%Box "parseInt is not a constructor"))))

(builtin JsGlobalParseFloat :transitioning true :throws true
  :params [(this dyn) (newtarget dyn) (callee dyn) (a0 dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (let [(s (JsToStringValue a0))]
        (if (%IsException s) s (%ParseFloat (%UnboxString s))))
      (JsThrowTypeError (%Box "parseFloat is not a constructor"))))
