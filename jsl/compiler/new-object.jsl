; Object-literal construction stays raw while its private property backing is initialized, then
; crosses the JavaScript value boundary exactly once. Both steps remain explicit JSL semantics.
(macro JsNewObjectRaw :transitioning true :params [] :ret obj
  (%NewObject))

(macro JsFinishObjectLiteral :params [(object obj)] :ret dyn
  (%Box object))

(macro JsNewObject :transitioning true :params [] :ret dyn
  (JsFinishObjectLiteral (JsNewObjectRaw)))

; The fixed layout is a compiler constant, consumed at lowering (never a runtime shape id).
; Every data slot initially contains undefined. The frontend uses this only for a private,
; unpublished literal, then evaluates and defines its properties in their original order.
(macro JsNewObjectLiteralRaw :transitioning true :params [(layout int)] :ret obj
  (%NewObjectWithShape layout))
