; The generic arms of the Array.prototype callback and search methods (ECMA-262 §23.1.3, "these
; functions are intentionally generic"), reached from array.jsl when the receiver is not an array.
;  A separate unit so the stable function indices of the earlier units stay put (tests/jsl-test).
;
; A receiver that is not an array is read as an array-like — LengthOfArrayLike over its `length`,
; HasProperty and [[Get]] per index through the ordinary keyed access, so a plain object with
; `length` and indexed keys, a string, or an `arguments`-shaped object all serve. The array
; receiver keeps the element-store fast path above; these are the other arm of each method.

; LengthOfArrayLike (§7.3.19) of any receiver: undefined and null are a TypeError (ToObject);
; ToLength clamps into [0, 2^53 - 1] with NaN as 0.
(builtin JsArrayLikeLength :transitioning true :throws true :params [(object dyn)] :ret dyn
  (if (%IsUndefined object)
      (JsThrowTypeError (%Box "Array.prototype method called on null or undefined"))
      (if (%IsNull object)
          (JsThrowTypeError (%Box "Array.prototype method called on null or undefined"))
          (let [(length (JsGetNamed object (%PropertyKey "length")))]
            (if (%IsException length)
                length
                (%BoxInt (JsToLength length)))))))

(macro JsToLength :params [(v dyn)] :ret int
  (let [(x (JsPrimitiveNumber v))]
    (if (%Ne x x)
        0
        (if (%Lt x (%ToFloat 0))
            0
            (if (%Lt (%ToFloat 9007199254740991) x)
                9007199254740991
                (%ToInteger x))))))

; HasProperty (§7.3.11) of index k: an array's element or its chain, a string's code unit, an
; object's own key or its chain, nothing on another primitive.
(builtin JsArrayLikeHas :transitioning true :throws true :params [(object dyn) (k int)] :ret dyn
  (if (%IsArray object)
      (if (%ArrayHasIndex (%UnboxArray object) k)
          (%BoxBool (%Eq 0 0))
          (JsHasNamedProperty (%GetObjectPrototype (%UnboxObjectLike object)) (JsToPropertyKey (%BoxInt k))))
      (if (%IsString object)
          (%BoxBool (%Lt k (%StringLength (%UnboxString object))))
          (if (%IsObjectLike object)
              (JsHasNamedProperty object (JsToPropertyKey (%BoxInt k)))
              (%BoxBool (%Eq 0 1))))))

; [[HasProperty]] of a named key along the chain (§10.1.7.1); null ends the chain.
(builtin JsHasNamedProperty :transitioning true :params [(object dyn) (key int)] :ret dyn
  (if (%IsObjectLike object)
      (if (JsHasOwnNamed object key)
          (%BoxBool (%Eq 0 0))
          (JsHasNamedProperty (%GetObjectPrototype (%UnboxObjectLike object)) key))
      (%BoxBool (%Eq 0 1))))

(builtin JsArrayForEachGenericFrom :transitioning true :throws true
  :params [(object dyn) (callee dyn) (thisArg dyn) (k int) (len int)] :ret dyn
  (if (%Lt k len)
      (let [(present (JsArrayLikeHas object k))]
        (if (%IsException present)
            present
            (if (JsTruthy present)
                (let [(value (JsGetKeyed object (%BoxInt k)))]
                  (if (%IsException value)
                      value
                      (if (%IsFunction callee)
                          (let [(r (%CallFunction callee thisArg value (%BoxInt k) object))]
                            (if (%IsException r)
                                r
                                (JsArrayForEachGenericFrom object callee thisArg (%Add k 1) len)))
                          (JsThrowTypeError (%Box "callback is not a function")))))
                (JsArrayForEachGenericFrom object callee thisArg (%Add k 1) len))))
      (%Undefined)))

(builtin JsArrayMapGenericFrom :transitioning true :throws true
  :params [(object dyn) (callee dyn) (thisArg dyn) (out dyn) (k int) (len int)] :ret dyn
  (if (%Lt k len)
      (let [(present (JsArrayLikeHas object k))]
        (if (%IsException present)
            present
            (if (JsTruthy present)
                (let [(value (JsGetKeyed object (%BoxInt k)))]
                  (if (%IsException value)
                      value
                      (if (%IsFunction callee)
                          (let [(r (%CallFunction callee thisArg value (%BoxInt k) object))]
                            (if (%IsException r)
                                r
                                (let [(stored (%ArrayStore (%UnboxArray out) k r))]
                                  (JsArrayMapGenericFrom object callee thisArg out (%Add k 1) len))))
                          (JsThrowTypeError (%Box "callback is not a function")))))
                (JsArrayMapGenericFrom object callee thisArg out (%Add k 1) len))))
      out))

(builtin JsArrayFilterGenericFrom :transitioning true :throws true
  :params [(object dyn) (callee dyn) (thisArg dyn) (out dyn) (k int) (len int)] :ret dyn
  (if (%Lt k len)
      (let [(present (JsArrayLikeHas object k))]
        (if (%IsException present)
            present
            (if (JsTruthy present)
                (let [(value (JsGetKeyed object (%BoxInt k)))]
                  (if (%IsException value)
                      value
                      (if (%IsFunction callee)
                          (let [(r (%CallFunction callee thisArg value (%BoxInt k) object))]
                            (if (%IsException r)
                                r
                                (if (JsTruthy r)
                                    (let [(stored (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) value))]
                                      (JsArrayFilterGenericFrom object callee thisArg out (%Add k 1) len))
                                    (JsArrayFilterGenericFrom object callee thisArg out (%Add k 1) len))))
                          (JsThrowTypeError (%Box "callback is not a function")))))
                (JsArrayFilterGenericFrom object callee thisArg out (%Add k 1) len))))
      out))

(builtin JsArraySomeGenericFrom :transitioning true :throws true
  :params [(object dyn) (callee dyn) (thisArg dyn) (k int) (len int) (stop-on int)] :ret dyn
  (if (%Lt k len)
      (let [(present (JsArrayLikeHas object k))]
        (if (%IsException present)
            present
            (if (JsTruthy present)
                (let [(value (JsGetKeyed object (%BoxInt k)))]
                  (if (%IsException value)
                      value
                      (if (%IsFunction callee)
                          (let [(r (%CallFunction callee thisArg value (%BoxInt k) object))]
                            (if (%IsException r)
                                r
                                (if (%Eq (if (JsTruthy r) 1 0) stop-on)
                                    (%BoxBool (%Eq stop-on 1))
                                    (JsArraySomeGenericFrom object callee thisArg (%Add k 1) len stop-on))))
                          (JsThrowTypeError (%Box "callback is not a function")))))
                (JsArraySomeGenericFrom object callee thisArg (%Add k 1) len stop-on))))
      (%BoxBool (%Eq stop-on 0))))

; find / findIndex visit every index (no HasProperty step).
(builtin JsArrayFindGenericFrom :transitioning true :throws true
  :params [(object dyn) (callee dyn) (thisArg dyn) (k int) (len int) (want-value int)] :ret dyn
  (if (%Lt k len)
      (let [(value (JsGetKeyed object (%BoxInt k)))]
        (if (%IsException value)
            value
            (if (%IsFunction callee)
                (let [(r (%CallFunction callee thisArg value (%BoxInt k) object))]
                  (if (%IsException r)
                      r
                      (if (JsTruthy r)
                          (if (%Eq want-value 1) value (%BoxInt k))
                          (JsArrayFindGenericFrom object callee thisArg (%Add k 1) len want-value))))
                (JsThrowTypeError (%Box "callback is not a function")))))
      (if (%Eq want-value 1) (%Undefined) (%BoxInt -1))))

; The first present index at or after k, boxed; -1 when none. A completion, since HasProperty may throw.
(builtin JsArrayLikeFirstPresent :transitioning true :throws true :params [(object dyn) (k int) (len int)] :ret dyn
  (if (%Lt k len)
      (let [(present (JsArrayLikeHas object k))]
        (if (%IsException present)
            present
            (if (JsTruthy present)
                (%BoxInt k)
                (JsArrayLikeFirstPresent object (%Add k 1) len))))
      (%BoxInt -1)))

(builtin JsArrayReduceGenericFrom :transitioning true :throws true
  :params [(object dyn) (callee dyn) (acc dyn) (k int) (len int)] :ret dyn
  (if (%Lt k len)
      (let [(present (JsArrayLikeHas object k))]
        (if (%IsException present)
            present
            (if (JsTruthy present)
                (let [(value (JsGetKeyed object (%BoxInt k)))]
                  (if (%IsException value)
                      value
                      (if (%IsFunction callee)
                          (let [(r (%CallFunction callee (%Undefined) acc value (%BoxInt k) object))]
                            (if (%IsException r)
                                r
                                (JsArrayReduceGenericFrom object callee r (%Add k 1) len)))
                          (JsThrowTypeError (%Box "callback is not a function")))))
                (JsArrayReduceGenericFrom object callee acc (%Add k 1) len))))
      acc))

; indexOf (§23.1.3.17) and includes (§23.1.3.16) over an array-like: `mode` 0 answers the index
; under strict equality (holes skipped), 1 the boolean under SameValueZero (holes read as
; undefined).
(builtin JsArrayIndexOfGenericFrom :transitioning true :throws true
  :params [(object dyn) (search dyn) (k int) (len int) (mode int)] :ret dyn
  (if (%Lt k len)
      (if (%Eq mode 1)
          (let [(value (JsGetKeyed object (%BoxInt k)))]
            (if (%IsException value)
                value
                (if (JsSameValueZero value search)
                    (%BoxBool (%Eq 0 0))
                    (JsArrayIndexOfGenericFrom object search (%Add k 1) len mode))))
          (let [(present (JsArrayLikeHas object k))]
            (if (%IsException present)
                present
                (if (JsTruthy present)
                    (let [(value (JsGetKeyed object (%BoxInt k)))]
                      (if (%IsException value)
                          value
                          (if (JsStrictEqualValue value search)
                              (%BoxInt k)
                              (JsArrayIndexOfGenericFrom object search (%Add k 1) len mode))))
                    (JsArrayIndexOfGenericFrom object search (%Add k 1) len mode)))))
      (if (%Eq mode 1) (%BoxBool (%Eq 0 1)) (%BoxInt -1))))

; The `in` operator (§13.10.1): the right operand must be an object, then HasProperty of
; ToPropertyKey(left) — an array index reaches the elements, any other key the named chain.
(builtin JsIn :transitioning true :throws true :params [(key dyn) (object dyn)] :ret dyn
  (if (%IsObjectLike object)
      (if (%IsArray object)
          (let [(index (JsArrayIndexOfKey key))]
            (if (%Lt index 0)
                (JsHasNamedProperty object (JsToPropertyKey key))
                (JsArrayLikeHas object index)))
          (JsHasNamedProperty object (JsToPropertyKey key)))
      (JsThrowTypeError (%Box "Cannot use 'in' operator to search for a key in a non-object"))))
