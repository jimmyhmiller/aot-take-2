; Map (§24.1) and Set (§24.2).
;
; A Map's entries live in two arrays under internal slots — the keys and the values at matching
; indices — and a Set's in one. That is insertion order by construction, which is what the
; specification's iteration order is, and it makes `size` the array's length. Lookup is a scan under
; SameValueZero; there is no hash table here, so a large Map costs what a scan costs
; (docs/GAPS.md — collections). A deleted entry is removed rather than tombstoned, so nothing has to
; remember holes and the order stays exactly the insertion order of what is left.

(macro JsMapKeys :transitioning true :throws true :params [(map dyn)] :ret dyn
  (JsGetNamed map (%InternalKey "%MapKeys%")))

(macro JsMapValues :transitioning true :throws true :params [(map dyn)] :ret dyn
  (JsGetNamed map (%InternalKey "%MapValues%")))

; RequireInternalSlot (§24.1.3): the presence of the keys slot is the brand.
(macro JsIsMap :params [(value dyn)] :ret bool
  (if (%IsObjectLike value)
      (%PropHasOwnNamed (%UnboxObjectLike value) (%InternalKey "%MapKeys%"))
      (%Eq 0 1)))

(macro JsIsSet :params [(value dyn)] :ret bool
  (if (%IsObjectLike value)
      (%PropHasOwnNamed (%UnboxObjectLike value) (%InternalKey "%SetValues%"))
      (%Eq 0 1)))

(macro JsSetValues :transitioning true :throws true :params [(set dyn)] :ret dyn
  (JsGetNamed set (%InternalKey "%SetValues%")))

; A slot read is any dynamic value again, so its array family has to be re-established at each use.
; The slot is the compiler's own and nothing but these definitions writes it, so a value that is not
; an array there is a failed invariant rather than a completion.
(macro JsSlotArray :transitioning true :params [(value dyn)] :ret arr
  (if (%IsArray value)
      (%UnboxArray value)
      (let [(trapped (%TrapInvariant))] (%UnboxArray (JsNewArray 0)))))

; The index of `key` under SameValueZero, or -1.
(builtin JsMapIndexOf :params [(keys arr) (key dyn) (i int)] :ret int
  (if (%Lt i (%ArrayLen keys))
      (if (JsSameValueZero (%ArrayLoad keys i) key)
          i
          (JsMapIndexOf keys key (%Add i 1)))
      -1))

; ---------------------------------------------------------------------------------------------
; Map

(builtin JsMapConstructor :transitioning true :throws true
  :params [(this dyn) (newtarget dyn) (callee dyn) (iterable dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (JsThrowTypeError (%Box "Constructor Map requires 'new'"))
      (let [(created (JsOrdinaryCreateFromConstructor callee (%IntrinsicPrototype "Map.prototype")))]
        (if (%IsException created)
            created
            (let [(with-keys (JsCreateDataPropertyAttrs (%UnboxObjectLike created)
                                                        (%InternalKey "%MapKeys%")
                                                        (JsNewArray 0)
                                                        1))]
              (let [(with-values (JsCreateDataPropertyAttrs with-keys
                                                            (%InternalKey "%MapValues%")
                                                            (JsNewArray 0)
                                                            1))]
                (JsMapFill created iterable)))))))

; new Map(iterable) (§24.1.1.1 steps 6-8): each entry of the iterable is a two element list whose
; first element is the key.
(builtin JsMapFill :transitioning true :throws true :params [(map dyn) (iterable dyn)] :ret dyn
  (if (%IsUndefined iterable)
      map
      (if (%IsNull iterable)
          map
          (let [(entries (JsArrayFrom (%Undefined) iterable (%Undefined)))]
            (if (%IsException entries)
                entries
                (JsMapFillFrom map (%UnboxArray entries) 0))))))

(builtin JsMapFillFrom :transitioning true :throws true
  :params [(map dyn) (entries arr) (i int)] :ret dyn
  (if (%Lt i (%ArrayLen entries))
      (let [(entry (%ArrayLoad entries i))]
        (if (%IsObjectLike entry)
            (let [(key (JsGetKeyed entry (%BoxInt 0)))]
              (if (%IsException key)
                  key
                  (let [(value (JsGetKeyed entry (%BoxInt 1)))]
                    (if (%IsException value)
                        value
                        (let [(stored (JsMapSet map key value))]
                          (if (%IsException stored)
                              stored
                              (JsMapFillFrom map entries (%Add i 1))))))))
            (JsThrowTypeError (%Box "Iterator value is not an entry object"))))
      map))

(builtin JsMapSet :transitioning true :throws true :params [(this dyn) (key dyn) (value dyn)] :ret dyn
  (if (JsIsMap this)
      (let [(keys (JsMapKeys this))]
        (if (%IsException keys)
            keys
            (let [(values (JsMapValues this))]
              (if (%IsException values)
                  values
                  (let [(at (JsMapIndexOf (JsSlotArray keys) key 0))]
                    (if (%Lt at 0)
                        (let [(k (%ArrayStore (JsSlotArray keys) (%ArrayLen (JsSlotArray keys)) key))]
                          (let [(v (%ArrayStore (JsSlotArray values) (%ArrayLen (JsSlotArray values)) value))]
                            this))
                        ;; An existing key keeps its position and takes the new value (§24.1.3.9).
                        (let [(v (%ArrayStore (JsSlotArray values) at value))]
                          this)))))))
      (JsThrowTypeError (%Box "Map.prototype.set called on an incompatible receiver"))))

(builtin JsMapGet :transitioning true :throws true :params [(this dyn) (key dyn)] :ret dyn
  (if (JsIsMap this)
      (let [(keys (JsMapKeys this))]
        (if (%IsException keys)
            keys
            (let [(at (JsMapIndexOf (JsSlotArray keys) key 0))]
              (if (%Lt at 0)
                  (%Undefined)
                  (let [(values (JsMapValues this))]
                    (if (%IsException values)
                        values
                        (%ArrayLoad (JsSlotArray values) at)))))))
      (JsThrowTypeError (%Box "Map.prototype.get called on an incompatible receiver"))))

(builtin JsMapHas :transitioning true :throws true :params [(this dyn) (key dyn)] :ret dyn
  (if (JsIsMap this)
      (let [(keys (JsMapKeys this))]
        (if (%IsException keys)
            keys
            (%BoxBool (%Le 0 (JsMapIndexOf (JsSlotArray keys) key 0)))))
      (JsThrowTypeError (%Box "Map.prototype.has called on an incompatible receiver"))))

(builtin JsMapDelete :transitioning true :throws true :params [(this dyn) (key dyn)] :ret dyn
  (if (JsIsMap this)
      (let [(keys (JsMapKeys this))]
        (if (%IsException keys)
            keys
            (let [(values (JsMapValues this))]
              (if (%IsException values)
                  values
                  (let [(at (JsMapIndexOf (JsSlotArray keys) key 0))]
                    (if (%Lt at 0)
                        (%BoxBool (%Eq 0 1))
                        (let [(k (JsArrayRemoveAt (JsSlotArray keys) at))]
                          (let [(v (JsArrayRemoveAt (JsSlotArray values) at))]
                            (%BoxBool (%Eq 0 0))))))))))
      (JsThrowTypeError (%Box "Map.prototype.delete called on an incompatible receiver"))))

; The element at `at` removed, every later element moved down and the length shortened: what keeps
; the two arrays aligned and the order exactly the insertion order of what remains.
(builtin JsArrayRemoveAt :transitioning true :params [(raw arr) (at int)] :ret int
  (let [(shifted (JsArrayShiftDown raw at))]
    (%ArraySetLength raw (%Sub (%ArrayLen raw) 1))))

(builtin JsArrayShiftDown :transitioning true :params [(raw arr) (i int)] :ret int
  (if (%Lt (%Add i 1) (%ArrayLen raw))
      (let [(moved (%ArrayStore raw i (%ArrayLoad raw (%Add i 1))))]
        (JsArrayShiftDown raw (%Add i 1)))
      0))

(builtin JsMapClear :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsMap this)
      (let [(keys (JsMapKeys this))]
        (if (%IsException keys)
            keys
            (let [(values (JsMapValues this))]
              (if (%IsException values)
                  values
                  (let [(k (%ArraySetLength (JsSlotArray keys) 0))]
                    (let [(v (%ArraySetLength (JsSlotArray values) 0))]
                      (%Undefined)))))))
      (JsThrowTypeError (%Box "Map.prototype.clear called on an incompatible receiver"))))

; The `size` accessor (§24.1.3.10), a getter and not a method: `m.size` reads without a call.
(builtin JsMapSize :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsMap this)
      (let [(keys (JsMapKeys this))]
        (if (%IsException keys)
            keys
            (%BoxInt (%ArrayLen (JsSlotArray keys)))))
      (JsThrowTypeError (%Box "Map.prototype.size called on an incompatible receiver"))))

; forEach(callback, thisArg) (§24.1.3.5): value, key, map — in that order, over a snapshot of the
; entries as they are when each step runs.
(builtin JsMapForEach :transitioning true :throws true
  :params [(this dyn) (callback dyn) (thisarg dyn)] :ret dyn
  (if (JsIsMap this)
      (if (%IsFunction callback)
          (JsMapForEachFrom this callback thisarg 0)
          (JsThrowTypeError (%Box "callback is not a function")))
      (JsThrowTypeError (%Box "Map.prototype.forEach called on an incompatible receiver"))))

(builtin JsMapForEachFrom :transitioning true :throws true
  :params [(this dyn) (callback dyn) (thisarg dyn) (i int)] :ret dyn
  (let [(keys (JsMapKeys this))]
    (if (%IsException keys)
        keys
        (let [(values (JsMapValues this))]
          (if (%IsException values)
              values
              (if (%Lt i (%ArrayLen (JsSlotArray keys)))
                  (if (%IsFunction callback)
                      (let [(r (%CallFunction callback
                                              thisarg
                                              (%ArrayLoad (JsSlotArray values) i)
                                              (%ArrayLoad (JsSlotArray keys) i)
                                              this
                                              (%Undefined)))]
                        (if (%IsException r)
                            r
                            (JsMapForEachFrom this callback thisarg (%Add i 1))))
                      (JsThrowTypeError (%Box "callback is not a function")))
                  (%Undefined)))))))

; The iterators are array iterators over a COPY of the entries as they are now: the specification's
; Map iterator follows later insertions, which needs a live cursor into the entry list
; (docs/GAPS.md — collections).
(builtin JsMapKeysMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsMap this)
      (let [(keys (JsMapKeys this))]
        (if (%IsException keys) keys (JsArrayValues (JsArrayCopy (JsSlotArray keys)))))
      (JsThrowTypeError (%Box "Map.prototype.keys called on an incompatible receiver"))))

(builtin JsMapValuesMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsMap this)
      (let [(values (JsMapValues this))]
        (if (%IsException values) values (JsArrayValues (JsArrayCopy (JsSlotArray values)))))
      (JsThrowTypeError (%Box "Map.prototype.values called on an incompatible receiver"))))

(builtin JsMapEntriesMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsMap this)
      (let [(keys (JsMapKeys this))]
        (if (%IsException keys)
            keys
            (let [(values (JsMapValues this))]
              (if (%IsException values)
                  values
                  (JsArrayValues (JsMapPairs (JsSlotArray keys) (JsSlotArray values) 0 (JsNewArray 0)))))))
      (JsThrowTypeError (%Box "Map.prototype.entries called on an incompatible receiver"))))

(builtin JsMapPairs :transitioning true :params [(keys arr) (values arr) (i int) (out dyn)] :ret dyn
  (if (%Lt i (%ArrayLen keys))
      (let [(pair (JsNewArray 0))]
        (let [(a (%ArrayStore (%UnboxArray pair) 0 (%ArrayLoad keys i)))]
          (let [(b (%ArrayStore (%UnboxArray pair) 1 (%ArrayLoad values i)))]
            (let [(stored (%ArrayStore (%UnboxArray out) i pair))]
              (JsMapPairs keys values (%Add i 1) out)))))
      out))

(builtin JsArrayCopy :transitioning true :params [(raw arr)] :ret dyn
  (JsArrayCopyFrom raw 0 (JsNewArray 0)))

(builtin JsArrayCopyFrom :transitioning true :params [(raw arr) (i int) (out dyn)] :ret dyn
  (if (%Lt i (%ArrayLen raw))
      (let [(stored (%ArrayStore (%UnboxArray out) i (%ArrayLoad raw i)))]
        (JsArrayCopyFrom raw (%Add i 1) out))
      out))

; ---------------------------------------------------------------------------------------------
; Set

(builtin JsSetConstructor :transitioning true :throws true
  :params [(this dyn) (newtarget dyn) (callee dyn) (iterable dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (JsThrowTypeError (%Box "Constructor Set requires 'new'"))
      (let [(created (JsOrdinaryCreateFromConstructor callee (%IntrinsicPrototype "Set.prototype")))]
        (if (%IsException created)
            created
            (let [(with-values (JsCreateDataPropertyAttrs (%UnboxObjectLike created)
                                                          (%InternalKey "%SetValues%")
                                                          (JsNewArray 0)
                                                          1))]
              (JsSetFill created iterable))))))

(builtin JsSetFill :transitioning true :throws true :params [(set dyn) (iterable dyn)] :ret dyn
  (if (%IsUndefined iterable)
      set
      (if (%IsNull iterable)
          set
          (let [(items (JsArrayFrom (%Undefined) iterable (%Undefined)))]
            (if (%IsException items)
                items
                (JsSetFillFrom set (%UnboxArray items) 0))))))

(builtin JsSetFillFrom :transitioning true :throws true :params [(set dyn) (items arr) (i int)] :ret dyn
  (if (%Lt i (%ArrayLen items))
      (let [(added (JsSetAdd set (%ArrayLoad items i)))]
        (if (%IsException added)
            added
            (JsSetFillFrom set items (%Add i 1))))
      set))

(builtin JsSetAdd :transitioning true :throws true :params [(this dyn) (value dyn)] :ret dyn
  (if (JsIsSet this)
      (let [(values (JsSetValues this))]
        (if (%IsException values)
            values
            (if (%Le 0 (JsMapIndexOf (JsSlotArray values) value 0))
                this
                (let [(stored (%ArrayStore (JsSlotArray values) (%ArrayLen (JsSlotArray values)) value))]
                  this))))
      (JsThrowTypeError (%Box "Set.prototype.add called on an incompatible receiver"))))

(builtin JsSetHas :transitioning true :throws true :params [(this dyn) (value dyn)] :ret dyn
  (if (JsIsSet this)
      (let [(values (JsSetValues this))]
        (if (%IsException values)
            values
            (%BoxBool (%Le 0 (JsMapIndexOf (JsSlotArray values) value 0)))))
      (JsThrowTypeError (%Box "Set.prototype.has called on an incompatible receiver"))))

(builtin JsSetDelete :transitioning true :throws true :params [(this dyn) (value dyn)] :ret dyn
  (if (JsIsSet this)
      (let [(values (JsSetValues this))]
        (if (%IsException values)
            values
            (let [(at (JsMapIndexOf (JsSlotArray values) value 0))]
              (if (%Lt at 0)
                  (%BoxBool (%Eq 0 1))
                  (let [(removed (JsArrayRemoveAt (JsSlotArray values) at))]
                    (%BoxBool (%Eq 0 0)))))))
      (JsThrowTypeError (%Box "Set.prototype.delete called on an incompatible receiver"))))

(builtin JsSetClear :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsSet this)
      (let [(values (JsSetValues this))]
        (if (%IsException values)
            values
            (let [(cleared (%ArraySetLength (JsSlotArray values) 0))]
              (%Undefined))))
      (JsThrowTypeError (%Box "Set.prototype.clear called on an incompatible receiver"))))

(builtin JsSetSize :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsSet this)
      (let [(values (JsSetValues this))]
        (if (%IsException values)
            values
            (%BoxInt (%ArrayLen (JsSlotArray values)))))
      (JsThrowTypeError (%Box "Set.prototype.size called on an incompatible receiver"))))

; forEach(callback, thisArg) (§24.2.3.6): a Set passes the value twice, as value and as key.
(builtin JsSetForEach :transitioning true :throws true
  :params [(this dyn) (callback dyn) (thisarg dyn)] :ret dyn
  (if (JsIsSet this)
      (if (%IsFunction callback)
          (JsSetForEachFrom this callback thisarg 0)
          (JsThrowTypeError (%Box "callback is not a function")))
      (JsThrowTypeError (%Box "Set.prototype.forEach called on an incompatible receiver"))))

(builtin JsSetForEachFrom :transitioning true :throws true
  :params [(this dyn) (callback dyn) (thisarg dyn) (i int)] :ret dyn
  (let [(values (JsSetValues this))]
    (if (%IsException values)
        values
        (if (%Lt i (%ArrayLen (JsSlotArray values)))
            (if (%IsFunction callback)
                (let [(r (%CallFunction callback
                                        thisarg
                                        (%ArrayLoad (JsSlotArray values) i)
                                        (%ArrayLoad (JsSlotArray values) i)
                                        this
                                        (%Undefined)))]
                  (if (%IsException r)
                      r
                      (JsSetForEachFrom this callback thisarg (%Add i 1))))
                (JsThrowTypeError (%Box "callback is not a function")))
            (%Undefined)))))

; `values`, `keys` and `@@iterator` are the same iterator over a Set (§24.2.3.10).
(builtin JsSetValuesMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsSet this)
      (let [(values (JsSetValues this))]
        (if (%IsException values) values (JsArrayValues (JsArrayCopy (JsSlotArray values)))))
      (JsThrowTypeError (%Box "Set.prototype.values called on an incompatible receiver"))))

(builtin JsSetEntriesMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsSet this)
      (let [(values (JsSetValues this))]
        (if (%IsException values)
            values
            (JsArrayValues (JsMapPairs (JsSlotArray values) (JsSlotArray values) 0 (JsNewArray 0)))))
      (JsThrowTypeError (%Box "Set.prototype.entries called on an incompatible receiver"))))
