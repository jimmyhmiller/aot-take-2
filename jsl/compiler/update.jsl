; UpdateExpression arithmetic on an already numeric operand. The frontend applies ToNumeric
; (JsPositive) to the Reference's value first, so both operands here are Numbers; BigInt is not
; represented. Binary64 addition owns overflow beyond the compact integer payload.
(builtin JsIncrement :params [(value dyn)] :ret dyn
  (%Box (%Add (JsPrimitiveNumber value) (%ToFloat 1))))

(builtin JsDecrement :params [(value dyn)] :ret dyn
  (%Box (%Sub (JsPrimitiveNumber value) (%ToFloat 1))))
