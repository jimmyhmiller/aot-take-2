; Array.prototype.sort (§23.1.3.30) and the SortCompare it is defined over (§23.1.3.30.2).
;
; The sort is a merge sort because the specification requires a STABLE one: elements the comparator
; calls equal keep the order they were in. Merging keeps the left element whenever the comparison is
; not positive, which is exactly that guarantee. A comparator is user code, so every comparison can
; throw, and a completion stops the sort where it happened rather than sorting a partial order.
;
; Holes and undefined both move to the end, in that order: SortIndexedProperties collects only the
; present elements, SortCompare sorts undefined after every value, and the write-back leaves the
; positions past the collected elements as holes.

(macro JsSortComparatorOk :params [(comparator dyn)] :ret bool
  (if (%IsUndefined comparator) (%Eq 0 0) (%IsFunction comparator)))

(builtin JsArraySort :transitioning true :throws true :params [(this dyn) (comparator dyn)] :ret dyn
  (if (JsSortComparatorOk comparator)
      (let [(receiver (JsArrayReceiver this))]
        (if (%IsException receiver)
            receiver
            (JsArraySortOn receiver comparator)))
      (JsThrowTypeError (%Box "The comparison function must be either a function or undefined"))))

(builtin JsArraySortOn :transitioning true :throws true :params [(receiver dyn) (comparator dyn)] :ret dyn
  (let [(items (JsSortPresent (%UnboxArray receiver) 0 (JsNewArray 0)))]
    (let [(sorted (JsSortItems items comparator))]
      (if (%IsException sorted)
          sorted
          (let [(written (JsSortWriteBack (%UnboxArray receiver) (%UnboxArray sorted) 0))]
            receiver)))))

; The present elements, in index order (SortIndexedProperties with holes skipped).
(builtin JsSortPresent :transitioning true :params [(raw arr) (i int) (out dyn)] :ret dyn
  (if (%Lt i (%ArrayLen raw))
      (if (%ArrayHasIndex raw i)
          (let [(stored (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) (%ArrayLoad raw i)))]
            (JsSortPresent raw (%Add i 1) out))
          (JsSortPresent raw (%Add i 1) out))
      out))

; The sorted elements over the array's first positions; every position after them becomes a hole,
; which is where a hole sorts to.
(builtin JsSortWriteBack :transitioning true :params [(raw arr) (sorted arr) (i int)] :ret int
  (if (%Lt i (%ArrayLen raw))
      (let [(written (if (%Lt i (%ArrayLen sorted))
                         (let [(stored (%ArrayStore raw i (%ArrayLoad sorted i)))] 0)
                         (%ArrayDeleteIndex raw i)))]
        (JsSortWriteBack raw sorted (%Add i 1)))
      0))

(builtin JsSortItems :transitioning true :throws true :params [(items dyn) (comparator dyn)] :ret dyn
  (if (%Lt (%ArrayLen (%UnboxArray items)) 2)
      items
      (let [(mid (%Div (%ArrayLen (%UnboxArray items)) 2))]
        (let [(left (JsSortItems (JsSortRange items 0 mid) comparator))]
          (if (%IsException left)
              left
              (let [(right (JsSortItems (JsSortRange items mid (%ArrayLen (%UnboxArray items)))
                                        comparator))]
                (if (%IsException right)
                    right
                    (JsSortMerge left right 0 0 (JsNewArray 0) comparator))))))))

(builtin JsSortRange :transitioning true :params [(items dyn) (i int) (end int)] :ret dyn
  (JsSortRangeInto items i end (JsNewArray 0)))

(builtin JsSortRangeInto :transitioning true :params [(items dyn) (i int) (end int) (out dyn)] :ret dyn
  (if (%Lt i end)
      (let [(stored (%ArrayStore (%UnboxArray out)
                                 (%ArrayLen (%UnboxArray out))
                                 (%ArrayLoad (%UnboxArray items) i)))]
        (JsSortRangeInto items (%Add i 1) end out))
      out))

; The left element wins a tie, which is what makes the sort stable.
(builtin JsSortMerge :transitioning true :throws true
  :params [(left dyn) (right dyn) (i int) (j int) (out dyn) (comparator dyn)] :ret dyn
  (if (%Lt i (%ArrayLen (%UnboxArray left)))
      (if (%Lt j (%ArrayLen (%UnboxArray right)))
          (let [(a (%ArrayLoad (%UnboxArray left) i))
                (b (%ArrayLoad (%UnboxArray right) j))]
            (let [(order (JsSortCompare a b comparator))]
              (if (%IsException order)
                  order
                  (if (%Lt 0 (%UnboxInt order))
                      (let [(took (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) b))]
                        (JsSortMerge left right i (%Add j 1) out comparator))
                      (let [(took (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) a))]
                        (JsSortMerge left right (%Add i 1) j out comparator))))))
          (JsSortMerge left
                       right
                       (%Add i 1)
                       j
                       (JsSortTake out (%ArrayLoad (%UnboxArray left) i))
                       comparator))
      (if (%Lt j (%ArrayLen (%UnboxArray right)))
          (JsSortMerge left
                       right
                       i
                       (%Add j 1)
                       (JsSortTake out (%ArrayLoad (%UnboxArray right) j))
                       comparator)
          out)))

(macro JsSortTake :transitioning true :params [(out dyn) (value dyn)] :ret dyn
  (let [(stored (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) value))]
    out))

; SortCompare (§23.1.3.30.2): undefined sorts after every value; a comparator decides, and its
; result is ToNumber'd with NaN treated as equal; without one the elements compare as strings.
(builtin JsSortCompare :transitioning true :throws true
  :params [(a dyn) (b dyn) (comparator dyn)] :ret dyn
  (if (%IsUndefined a)
      (if (%IsUndefined b) (%BoxInt 0) (%BoxInt 1))
      (if (%IsUndefined b)
          (%BoxInt -1)
          (if (%IsFunction comparator)
              (let [(r (%CallFunction comparator (%Undefined) a b (%Undefined) (%Undefined)))]
                (if (%IsException r)
                    r
                    (let [(n (JsToNumberValue r))]
                      (if (%IsException n)
                          n
                          (%BoxInt (JsSortSign n))))))
              (JsSortStrings a b)))))

(macro JsSortSign :params [(n dyn)] :ret int
  (let [(f (JsPrimitiveNumber n))]
    (if (%Lt f (%ToFloat 0))
        -1
        (if (%Lt (%ToFloat 0) f) 1 0))))

; Without a comparator the elements are compared as strings, in code unit order.
(builtin JsSortStrings :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (let [(x (JsToStringValue a))]
    (if (%IsException x)
        x
        (let [(y (JsToStringValue b))]
          (if (%IsException y)
              y
              (%BoxInt (%StringCompare (%UnboxString x) (%UnboxString y))))))))
