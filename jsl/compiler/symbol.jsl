; Symbols (ECMA-262 §20.4; docs/DECISIONS.md, symbols).
;
; A Symbol is a primitive whose identity is a traced allocation: two Symbols are the same value
; exactly when they are the same allocation, and nothing about one can be observed except the
; description it was created with. It has no wrapper object here yet, so `Object(sym)` and
; `sym.description` through a wrapper refuse where the wrapper would be made; the prototype methods
; below take the primitive itself.
;
; The conversions are where a Symbol is deliberately unlike every other primitive: ToString and
; ToNumber of one are TypeErrors, which is what keeps a Symbol from being concatenated or added by
; accident. ToPropertyKey is the exception — a Symbol IS a property key — and that is handled where
; keys are interned.

; Symbol([description]) (§20.4.1.1): a fresh Symbol. `new Symbol()` is a TypeError (§20.4.1).
(builtin JsSymbolConstructor :transitioning true :throws true
  :params [(this dyn) (newtarget dyn) (callee dyn) (description dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (if (%IsUndefined description)
          (%Box (%NewSymbol (%Undefined)))
          (let [(text (JsToStringValue description))]
            (if (%IsException text) text (%Box (%NewSymbol text)))))
      (JsThrowTypeError (%Box "Symbol is not a constructor"))))

; ThisSymbolValue (§20.4.3): a Symbol passes through; anything else is a TypeError, there being no
; Symbol wrapper object yet.
(builtin JsThisSymbolValue :transitioning true :throws true :params [(value dyn)] :ret dyn
  (if (%IsSymbol value)
      value
      (JsThrowTypeError (%Box "Symbol.prototype method called on a non-symbol value"))))

; get Symbol.prototype.description (§20.4.3.2).
(builtin JsSymbolDescriptionMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(symbol (JsThisSymbolValue this))]
    (if (%IsException symbol)
        symbol
        (%SymbolDescription (%UnboxSymbol symbol)))))

; SymbolDescriptiveString (§20.4.3.3.1): "Symbol(" + the description or the empty string + ")".
(builtin JsSymbolDescriptiveString :transitioning true :throws true :params [(symbol dyn)] :ret dyn
  (let [(description (%SymbolDescription (%UnboxSymbol symbol)))]
    (%Box (%StringConcat (%StringConcat (%UnboxString (%Box "Symbol("))
                                        (if (%IsString description)
                                            (%UnboxString description)
                                            (%UnboxString (%Box ""))))
                         (%UnboxString (%Box ")"))))))

; Symbol.prototype.toString (§20.4.3.3) and valueOf (§20.4.3.4).
(builtin JsSymbolToStringMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(symbol (JsThisSymbolValue this))]
    (if (%IsException symbol) symbol (JsSymbolDescriptiveString symbol))))

(builtin JsSymbolValueOfMethod :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsThisSymbolValue this))

; ToString of a Symbol is a TypeError (§7.1.17 step 2), and so is ToNumber (§7.1.4). Every
; conversion that reaches a Symbol by accident — a template substitution, `+`, a property key built
; from one by ToString rather than ToPropertyKey — arrives here.
(builtin JsSymbolToStringRefused :transitioning true :throws true :params [(value dyn)] :ret dyn
  (JsThrowTypeError (%Box "Cannot convert a Symbol value to a string")))

(builtin JsSymbolToNumberRefused :transitioning true :throws true :params [(value dyn)] :ret dyn
  (JsThrowTypeError (%Box "Cannot convert a Symbol value to a number")))
