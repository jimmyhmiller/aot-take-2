; `%UnboxNumber` accepts either numeric representation and produces binary64, converting a compact
; signed-48 integer rather than reinterpreting its bits. Undefined follows ECMA ToNumber and becomes
; NaN; the guard keeps that singleton out of the unbox path. IEEE addition therefore owns every
; result outside the immediate payload instead of truncating an overflowing raw integer.
(macro JsConcatStrings :transitioning true :params [(a dyn) (b dyn)] :ret dyn
  (%Box (%StringConcat (%UnboxString a) (%UnboxString b))))

(builtin JsAdd :transitioning true :params [(a dyn) (b dyn)] :ret dyn
  (if (%IsString a)
      (if (%IsString b)
          (JsConcatStrings a b)
          (let [(left (%UnboxNumber a))
                (right (if (%IsUndefined b)
                           (%Div (%ToFloat 0) (%ToFloat 0))
                           (%UnboxNumber b)))]
            (%Box (%Add left right))))
      (let [(left (if (%IsUndefined a)
                      (%Div (%ToFloat 0) (%ToFloat 0))
                      (%UnboxNumber a)))
            (right (if (%IsUndefined b)
                       (%Div (%ToFloat 0) (%ToFloat 0))
                       (%UnboxNumber b)))]
        (%Box (%Add left right)))))
