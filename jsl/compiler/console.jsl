; The console (docs/DECISIONS.md, the console). A program's only way to say anything to the host:
; `%HostWrite` takes the code units of a string and a stream, and everything about what a value
; looks like is decided here, where ToString is.
;
; `console.log` is variadic, so its code is the callable ABI itself (`jsl-definition-abi?`): it sees
; the call's own argument count and prints exactly the arguments it was passed — `log()` writes an
; empty line, which a fixed slot count could not distinguish from `log(undefined)`.

; How one argument is shown: a string as itself, a Symbol by its description — ToString of one is a
; TypeError, and printing is not the place to raise it — and every other value through ToString, so
; an array joins its elements and a plain object is "[object Object]". A richer rendering of objects
; is an inspector, which is its own feature (docs/GAPS.md).
(builtin JsConsoleDisplay :transitioning true :throws true :params [(value dyn)] :ret dyn
  (if (%IsString value)
      value
      (if (%IsSymbol value)
          (JsSymbolDescriptiveString value)
          (JsToStringValue value))))

; The arguments from `i` on, each preceded by a space, appended to `text`.
(builtin JsConsoleJoin :transitioning true :throws true
  :params [(text dyn) (args dyn) (i int) (n int)] :ret dyn
  (if (%Lt i n)
      (let [(shown (JsConsoleDisplay (%ArrayLoad (%UnboxArray args) i)))]
        (if (%IsException shown)
            shown
            (let [(next (%Box (%StringConcat (%StringConcat (%UnboxString text)
                                                            (%UnboxString (%Box " ")))
                                             (%UnboxString shown))))]
              (JsConsoleJoin next args (%Add i 1) n))))
      text))

; One line of output: the arguments shown, separated by a space, and a newline.
(builtin JsConsoleWrite :transitioning true :throws true
  :params [(stream int) (count argument-count) (overflow argument-vector) (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (let [(args (JsArgumentsArray count overflow a0 a1 a2))]
    (let [(n (%ArrayLen (%UnboxArray args)))]
      (let [(first (if (%Lt 0 n) (JsConsoleDisplay (%ArrayLoad (%UnboxArray args) 0)) (%Box "")))]
        (if (%IsException first)
            first
            (let [(joined (JsConsoleJoin first args 1 n))]
              (if (%IsException joined)
                  joined
                  (let [(line (%Box (%StringConcat (%UnboxString joined) (%UnboxString (%Box "\n")))))]
                    (let [(written (%HostWrite (%UnboxString line) stream))]
                      (%Undefined))))))))))

(builtin JsConsoleLog :transitioning true :throws true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (JsConsoleWrite 0 count overflow a0 a1 a2))

(builtin JsConsoleError :transitioning true :throws true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (JsConsoleWrite 1 count overflow a0 a1 a2))
