; The integer arms of `+`, `-` and the relations, and the generic definitions every other operand
; pair takes (toprimitive.jsl). A generic definition is out of line and never inlined: inlined into
; the shared operator body on the evidence of its narrowing Casts, it grew the operator past the
; inliner's size cap and `fib(30)` went from 5.3 to 22 ms. Numbers never reach it. They come last in
; the index so no existing function index moves.

; The Number an exact integer result denotes. Two compact signed-48 operands sum or subtract exactly
; in an i64; a result outside the signed-48 payload is the same Number in binary64 (every magnitude
; below 2^49 is exact there), so it boxes as a double. Neither operation forms -0 from integers
; (0 - 0 and 0 + 0 are +0), so the compact form is the whole answer inside the range.
(macro JsBoxInt48 :params [(r int)] :ret dyn
  (if (%Lt r -140737488355328)
      (%Box (%ToFloat r))
      (if (%Lt 140737488355327 r) (%Box (%ToFloat r)) (%BoxInt r))))

(macro JsAddInts :params [(a int) (b int)] :ret dyn
  (JsBoxInt48 (%Add a b)))

(macro JsSubInts :params [(a int) (b int)] :ret dyn
  (JsBoxInt48 (%Sub a b)))

; `order` of a relation on two integers: 0 a < b, 1 a > b, 2 a <= b, 3 a >= b, exactly as over their
; Number values.
(macro JsRelationalInts :params [(left int) (right int) (order int)] :ret bool
  (if (%Eq order 0) (%Lt left right)
      (if (%Eq order 1) (%Lt right left)
          (if (%Eq order 2) (%Le left right) (%Le right left)))))

(builtin JsAddOperatorGeneric :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherNeedsConversion a b) (JsBinaryConversion a b 0 0) (JsAdd a b)))

(builtin JsSubOperatorGeneric :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherNeedsConversion a b) (JsBinaryConversion a b 1 0) (JsSub a b)))

(builtin JsLtOperatorGeneric :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherNeedsConversion a b) (JsBinaryConversion a b 4 0) (%BoxBool (JsRelationalOrder a b 0))))

(builtin JsGtOperatorGeneric :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherNeedsConversion a b) (JsBinaryConversion a b 5 0) (%BoxBool (JsRelationalOrder a b 1))))

(builtin JsLeOperatorGeneric :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherNeedsConversion a b) (JsBinaryConversion a b 6 0) (%BoxBool (JsRelationalOrder a b 2))))

(builtin JsGeOperatorGeneric :transitioning true :throws true :params [(a dyn) (b dyn)] :ret dyn
  (if (JsEitherNeedsConversion a b) (JsBinaryConversion a b 7 0) (%BoxBool (JsRelationalOrder a b 3))))
