; Object and Object.prototype (ECMA-262 §20.1) over the represented object model: data properties
; without attributes (docs/GAPS.md, objects). Primitive receivers are handled as the wrapper's
; prototype chain would resolve them, without creating the wrapper (docs/DECISIONS.md, strings).

; Object.create(O [, Properties]) (§20.1.2.2): a fresh ordinary object on O. A properties object
; needs property descriptors, which do not exist yet; it is a TypeError naming the gap.
(builtin JsObjectCreate :transitioning true :throws true
  :params [(this dyn) (proto dyn) (properties dyn)] :ret dyn
  (if (%IsUndefined properties)
      (if (%IsObjectLike proto)
          (JsFinishObjectLiteral (JsSetObjectLiteralPrototype (JsNewObjectRaw) proto))
          (if (%IsNull proto)
              (JsFinishObjectLiteral (JsNewObjectRaw))
              (JsThrowTypeError (%Box "Object prototype may only be an Object or null"))))
      (let [(created (JsObjectCreate this proto (%Undefined)))]
        (if (%IsException created)
            created
            (JsObjectDefineProperties this created properties)))))

; Object.getPrototypeOf(O) (§20.1.2.12): ToObject first, so a primitive answers its wrapper's
; prototype.
(builtin JsObjectGetPrototypeOf :transitioning true :throws true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsObjectLike o)
      (%GetObjectPrototype (%UnboxObjectLike o))
      (if (%IsString o)
          (%IntrinsicPrototype "String.prototype")
          (if (%IsBool o)
              (%IntrinsicPrototype "Boolean.prototype")
              (if (%IsUndefined o)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (if (%IsNull o)
                      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                      (if (%IsSymbol o)
                          (%Null)
                          (%IntrinsicPrototype "Number.prototype"))))))))

; Object.keys(O) (§20.1.2.17): own enumerable string keys in order — for an array its present
; indices then its named properties, for a string its indices, for an ordinary object its
; properties (every property is enumerable here).
(builtin JsObjectKeys :transitioning true :throws true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsArray o)
      (let [(raw (%UnboxArray o))]
        (let [(indices (JsArrayIndexKeys raw 0 (%ArrayLen raw) (JsNewArray 0)))]
          (let [(named (%Box (%ObjectKeys (%UnboxObjectLike o) (%IntrinsicPrototype "Array.prototype"))))]
            (let [(appended (JsArrayConcatOne named (%UnboxArray indices) (%ArrayLen (%UnboxArray indices))))]
              indices))))
      (if (%IsObjectLike o)
          (%Box (%ObjectKeys (%UnboxObjectLike o) (%IntrinsicPrototype "Array.prototype")))
          (if (%IsString o)
              (JsStringIndexKeys (%UnboxString o) 0 (JsNewArray 0))
              (if (%IsUndefined o)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (if (%IsNull o)
                      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                      (JsNewArray 0)))))))

; The canonical strings of the present indices below `len`, appended to `out`.
(builtin JsArrayIndexKeys :transitioning true :params [(raw arr) (k int) (len int) (out dyn)] :ret dyn
  (if (%Lt k len)
      (if (%ArrayHasIndex raw k)
          (let [(stored (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) (%Box (%NumberToString (%BoxInt k)))))]
            (JsArrayIndexKeys raw (%Add k 1) len out))
          (JsArrayIndexKeys raw (%Add k 1) len out))
      out))

(builtin JsStringIndexKeys :transitioning true :params [(raw str) (k int) (out dyn)] :ret dyn
  (if (%Lt k (%StringLength raw))
      (let [(stored (%ArrayStore (%UnboxArray out) k (%Box (%NumberToString (%BoxInt k)))))]
        (JsStringIndexKeys raw (%Add k 1) out))
      out))

; Object.prototype.hasOwnProperty(V) (§20.1.3.2): HasOwnProperty over the represented kinds.
(builtin JsObjectHasOwnProperty :transitioning true :throws true :params [(this dyn) (key dyn)] :ret dyn
  (if (%IsArray this)
      (let [(index (JsArrayIndexOfKey key))]
        (if (%Lt index 0)
            (let [(k (JsToPropertyKey key))]
              (if (%Eq k (%PropertyKey "length"))
                  (JsTrue)
                  (%BoxBool (JsHasOwnNamed this k))))
            (%BoxBool (%ArrayHasIndex (%UnboxArray this) index))))
      (if (%IsObjectLike this)
          (%BoxBool (JsHasOwnNamed this (JsToPropertyKey key)))
          (if (%IsString this)
              (let [(index (JsArrayIndexOfKey key))]
                (if (%Lt index 0)
                    (%BoxBool (%Eq (JsToPropertyKey key) (%PropertyKey "length")))
                    (%BoxBool (%Lt index (%StringLength (%UnboxString this))))))
              (if (%IsUndefined this)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (if (%IsNull this)
                      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                      (JsFalse)))))))

; Object.prototype.toString() (§20.1.3.6): the builtin tag; Symbol.toStringTag is not represented.
(builtin JsObjectToStringMethod :params [(this dyn)] :ret dyn
  (if (%IsUndefined this)
      (%Box "[object Undefined]")
      (if (%IsNull this)
          (%Box "[object Null]")
          (if (%IsArray this)
              (%Box "[object Array]")
              (if (%IsFunction this)
                  (%Box "[object Function]")
                  (if (%IsString this)
                      (%Box "[object String]")
                      (if (%IsBool this)
                          (%Box "[object Boolean]")
                          (if (%IsSymbol this)
                              (%Box "[object Symbol]")
                              (if (%IsObject this)
                                  (%Box "[object Object]")
                                  (%Box "[object Number]"))))))))))

; Object.prototype.valueOf() (§20.1.3.7): ToObject(this); a primitive stays itself here (no wrapper
; objects: docs/GAPS.md).
(builtin JsObjectValueOf :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsUndefined this)
      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
      (if (%IsNull this)
          (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
          this)))

; Object.prototype.isPrototypeOf(V) (§20.1.3.3): walk V's chain looking for this.
(builtin JsObjectIsPrototypeOf :transitioning true :throws true :params [(this dyn) (v dyn)] :ret dyn
  (if (%IsObjectLike v)
      (if (%IsObjectLike this)
          (JsInstanceofWalk v this)
          (if (%IsUndefined this)
              (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
              (if (%IsNull this)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (JsFalse))))
      (JsFalse)))

; Object.prototype.propertyIsEnumerable(V) (§20.1.3.4): the own property's enumerable bit; an
; array's elements and a string's code units are enumerable, their `length` is not.
(builtin JsObjectPropertyIsEnumerable :transitioning true :throws true :params [(this dyn) (key dyn)] :ret dyn
  (if (%IsObjectLike this)
      (let [(k (JsToPropertyKey key))]
        (if (%IsArray this)
            (if (%Eq k (%PropertyKey "length"))
                (JsFalse)
                (JsObjectHasOwnProperty this key))
            (let [(attrs (%PropAttrsOwn (%UnboxObjectLike this) k))]
              (%BoxBool (%And (%Lt -1 attrs) (%Ne (%And attrs 2) 0))))))
      (if (%IsString this)
          (let [(k (JsToPropertyKey key))]
            (if (%Eq k (%PropertyKey "length")) (JsFalse) (JsObjectHasOwnProperty this key)))
          (JsObjectHasOwnProperty this key))))

; ---------------------------------------------------------------------------
; Property descriptors (ECMA-262 §6.2.6, §10.1.6.3, §20.1.2): attributes live in the shape tree
; (docs/DECISIONS.md, property attributes live in the shape tree); an accessor property's word is
; its pair, an ordinary object with `get` and `set`. The runtime's `%PropDefine` is
; ValidateAndApplyPropertyDescriptor; these definitions are ToPropertyDescriptor, the TypeErrors
; the specification names, and FromPropertyDescriptor.

; The object a static's first argument must be, else a TypeError naming the static.
(macro JsRequireObject :transitioning true :throws true :params [(o dyn) (message dyn)] :ret dyn
  (if (%IsObjectLike o) o (JsThrowTypeError message)))

; Object.defineProperty(O, P, Attributes) (§20.1.2.4).
(builtin JsObjectDefineProperty :transitioning true :throws true
  :params [(this dyn) (o dyn) (p dyn) (attributes dyn)] :ret dyn
  (let [(object (JsRequireObject o (%Box "Object.defineProperty called on non-object")))]
    (if (%IsException object)
        object
        (let [(key (JsToPropertyKey p))]
          (let [(defined (JsDefineFromDescriptor object key attributes))]
            (if (%IsException defined) defined object))))))

; Object.defineProperties(O, Properties) (§20.1.2.3): every own enumerable key of Properties, in
; order, defines a property of O.
(builtin JsObjectDefineProperties :transitioning true :throws true
  :params [(this dyn) (o dyn) (properties dyn)] :ret dyn
  (let [(object (JsRequireObject o (%Box "Object.defineProperties called on non-object")))]
    (if (%IsException object)
        object
        (if (%IsObjectLike properties)
            (let [(keys (%Box (%ObjectKeys (%UnboxObjectLike properties) (%IntrinsicPrototype "Array.prototype"))))]
              (let [(done (JsDefinePropertiesFrom object properties (%UnboxArray keys) 0 (%ArrayLen (%UnboxArray keys))))]
                (if (%IsException done) done object)))
            (if (%IsUndefined properties)
                (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                (if (%IsNull properties)
                    (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                    object))))))

(builtin JsDefinePropertiesFrom :transitioning true :throws true
  :params [(object dyn) (properties dyn) (keys arr) (k int) (len int)] :ret dyn
  (if (%Lt k len)
      (let [(name (%ArrayLoad keys k))]
        (let [(descriptor (JsGetKeyed properties name))]
          (if (%IsException descriptor)
              descriptor
              (let [(defined (JsDefineFromDescriptor object (JsToPropertyKey name) descriptor))]
                (if (%IsException defined)
                    defined
                    (JsDefinePropertiesFrom object properties keys (%Add k 1) len))))))
      object))

; ToPropertyDescriptor (§6.2.6.5) then the runtime's ValidateAndApply: each field present on the
; descriptor object is read in the specification's order and named in the mask; `get`/`set` must
; be callable or undefined; naming both an accessor and a data field is a TypeError. An accessor
; descriptor that leaves `get` or `set` out keeps the existing accessor's function.
(builtin JsDefineFromDescriptor :transitioning true :throws true
  :params [(object dyn) (key int) (descriptor dyn)] :ret dyn
  (if (%IsObjectLike descriptor)
      (let [(has-enumerable (JsHasNamedProperty descriptor (%PropertyKey "enumerable")))]
  (let [(enumerable (if (JsTruthy has-enumerable) (JsGetNamed descriptor (%PropertyKey "enumerable")) (%Undefined)))]
    (if (%IsException enumerable)
        enumerable
        (let [(has-configurable (JsHasNamedProperty descriptor (%PropertyKey "configurable")))]
  (let [(configurable (if (JsTruthy has-configurable) (JsGetNamed descriptor (%PropertyKey "configurable")) (%Undefined)))]
    (if (%IsException configurable)
        configurable
        (let [(has-value (JsHasNamedProperty descriptor (%PropertyKey "value")))]
  (let [(value (if (JsTruthy has-value) (JsGetNamed descriptor (%PropertyKey "value")) (%Undefined)))]
    (if (%IsException value)
        value
        (let [(has-writable (JsHasNamedProperty descriptor (%PropertyKey "writable")))]
  (let [(writable (if (JsTruthy has-writable) (JsGetNamed descriptor (%PropertyKey "writable")) (%Undefined)))]
    (if (%IsException writable)
        writable
        (let [(has-get (JsHasNamedProperty descriptor (%PropertyKey "get")))]
  (let [(getter (if (JsTruthy has-get) (JsGetNamed descriptor (%PropertyKey "get")) (%Undefined)))]
    (if (%IsException getter)
        getter
        (let [(has-set (JsHasNamedProperty descriptor (%PropertyKey "set")))]
  (let [(setter (if (JsTruthy has-set) (JsGetNamed descriptor (%PropertyKey "set")) (%Undefined)))]
    (if (%IsException setter)
        setter
        (JsDefineChecked object key
                 (JsTruthy has-enumerable) (JsTruthy enumerable)
                 (JsTruthy has-configurable) (JsTruthy configurable)
                 (JsTruthy has-value) value
                 (JsTruthy has-writable) (JsTruthy writable)
                 (JsTruthy has-get) getter
                 (JsTruthy has-set) setter)))))))))))))))))))
      (JsThrowTypeError (%Box "Property description must be an object"))))

; Boolean disjunction, which the primitive set leaves to `if`.
(macro JsOr :params [(a bool) (b bool)] :ret bool
  (if a (%Eq 0 0) b))

(macro JsNot :params [(a bool)] :ret bool
  (if a (%Eq 0 1) (%Eq 0 0)))

(macro JsDefineChecked :transitioning true :throws true
  :params [(object dyn) (key int)
           (has-enumerable bool) (enumerable bool)
           (has-configurable bool) (configurable bool)
           (has-value bool) (value dyn)
           (has-writable bool) (writable bool)
           (has-get bool) (getter dyn)
           (has-set bool) (setter dyn)] :ret dyn
  (if (%And has-get (JsNot (JsOr (%IsUndefined getter) (%IsFunction getter))))
      (JsThrowTypeError (%Box "Getter must be a function"))
      (if (%And has-set (JsNot (JsOr (%IsUndefined setter) (%IsFunction setter))))
          (JsThrowTypeError (%Box "Setter must be a function"))
          (if (%And (JsOr has-get has-set) (JsOr has-value has-writable))
              (JsThrowTypeError (%Box "Invalid property descriptor. Cannot both specify accessors and a value or writable attribute"))
              (let [(attrs (%Add (if (%And has-writable writable) 1 0)
                                 (%Add (if (%And has-enumerable enumerable) 2 0)
                                       (if (%And has-configurable configurable) 4 0))))]
                (let [(mask (%Add (if has-value 1 0)
                                  (%Add (if has-writable 2 0)
                                        (%Add (if has-enumerable 4 0)
                                              (%Add (if has-configurable 8 0)
                                                    (if (JsOr has-get has-set) 16 0))))))]
                  (if (JsOr has-get has-set)
                      (JsApplyDefine object key (JsAccessorPair object key (if has-get 1 0) getter (if has-set 1 0) setter) attrs mask)
                      (JsApplyDefine object key value attrs mask))))))))

; The accessor pair for a define: the named functions, the current pair's for the ones not named.
(builtin JsAccessorPair :transitioning true
  :params [(object dyn) (key int) (has-get int) (getter dyn) (has-set int) (setter dyn)] :ret dyn
  (let [(current (%PropAttrsOwn (%UnboxObjectLike object) key))]
    (let [(pair (if (%Lt current 0)
                    (%Undefined)
                    (if (%Eq (%And current 8) 0)
                        (%Undefined)
                        (%PropLoadOwnNamed (%UnboxObjectLike object) key))))]
      (let [(fresh (JsNewObjectRaw))]
        (let [(g (if (%Eq has-get 1) getter (if (%IsUndefined pair) (%Undefined) (JsGetOwnNamed pair (%PropertyKey "get")))))]
          (let [(s (if (%Eq has-set 1) setter (if (%IsUndefined pair) (%Undefined) (JsGetOwnNamed pair (%PropertyKey "set")))))]
            (let [(with-get (JsCreateDataPropertyNamed fresh (%PropertyKey "get") g))]
              (let [(with-set (JsCreateDataPropertyNamed with-get (%PropertyKey "set") s))]
                (JsFinishObjectLiteral with-set)))))))))

(macro JsApplyDefine :transitioning true :throws true
  :params [(object dyn) (key int) (value dyn) (attrs int) (mask int)] :ret dyn
  (let [(status (%PropDefine (%UnboxObjectLike object) key value attrs mask))]
    (if (%Eq status 0)
        object
        (if (%Eq status 2)
            (JsThrowTypeError (%Box "Cannot define property, object is not extensible"))
            (JsThrowTypeError (%Box "Cannot redefine property"))))))

; Object.getOwnPropertyDescriptor(O, P) (§20.1.2.8): FromPropertyDescriptor, or undefined.
(builtin JsObjectGetOwnPropertyDescriptor :transitioning true :throws true
  :params [(this dyn) (o dyn) (p dyn)] :ret dyn
  (if (%IsObjectLike o)
      (let [(key (JsToPropertyKey p))]
        (let [(attrs (%PropAttrsOwn (%UnboxObjectLike o) key))]
          (if (%Lt attrs 0)
              (if (%IsArray o)
                  (JsArrayOwnDescriptor o p key)
                  (%Undefined))
              (let [(word (%PropLoadOwnNamed (%UnboxObjectLike o) key))]
                (if (%Eq (%And attrs 8) 0)
                    (JsDataDescriptor word (%Ne (%And attrs 1) 0) (%Ne (%And attrs 2) 0) (%Ne (%And attrs 4) 0))
                    (JsAccessorDescriptor (JsGetOwnNamed word (%PropertyKey "get"))
                                          (JsGetOwnNamed word (%PropertyKey "set"))
                                          (%Ne (%And attrs 2) 0)
                                          (%Ne (%And attrs 4) 0)))))))
      (if (%IsUndefined o)
          (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
          (if (%IsNull o)
              (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
              (%Undefined)))))

; An array's exotic own properties (§10.4.2): `length` is writable, not enumerable, not
; configurable; a present element is a writable, enumerable, configurable data property.
(builtin JsArrayOwnDescriptor :transitioning true :throws true :params [(o dyn) (p dyn) (key int)] :ret dyn
  (if (%Eq key (%PropertyKey "length"))
      (JsDataDescriptor (%BoxInt (%ArrayLen (%UnboxArray o))) (%Eq 0 0) (%Eq 0 1) (%Eq 0 1))
      (let [(index (JsArrayIndexOfKey p))]
        (if (%Lt index 0)
            (%Undefined)
            (if (%ArrayHasIndex (%UnboxArray o) index)
                (JsDataDescriptor (%ArrayLoad (%UnboxArray o) index) (%Eq 0 0) (%Eq 0 0) (%Eq 0 0))
                (%Undefined))))))

(builtin JsDataDescriptor :transitioning true
  :params [(value dyn) (writable bool) (enumerable bool) (configurable bool)] :ret dyn
  (let [(o (JsNewObjectRaw))]
    (let [(a (JsCreateDataPropertyNamed o (%PropertyKey "value") value))]
      (let [(b (JsCreateDataPropertyNamed a (%PropertyKey "writable") (%BoxBool writable)))]
        (let [(c (JsCreateDataPropertyNamed b (%PropertyKey "enumerable") (%BoxBool enumerable)))]
          (let [(d (JsCreateDataPropertyNamed c (%PropertyKey "configurable") (%BoxBool configurable)))]
            (JsFinishObjectLiteral (JsSetObjectLiteralPrototype d (%IntrinsicPrototype "Object.prototype")))))))))

(builtin JsAccessorDescriptor :transitioning true
  :params [(getter dyn) (setter dyn) (enumerable bool) (configurable bool)] :ret dyn
  (let [(o (JsNewObjectRaw))]
    (let [(a (JsCreateDataPropertyNamed o (%PropertyKey "get") getter))]
      (let [(b (JsCreateDataPropertyNamed a (%PropertyKey "set") setter))]
        (let [(c (JsCreateDataPropertyNamed b (%PropertyKey "enumerable") (%BoxBool enumerable)))]
          (let [(d (JsCreateDataPropertyNamed c (%PropertyKey "configurable") (%BoxBool configurable)))]
            (JsFinishObjectLiteral (JsSetObjectLiteralPrototype d (%IntrinsicPrototype "Object.prototype")))))))))

; Object.preventExtensions / isExtensible / freeze / seal / isFrozen / isSealed (§20.1.2): a
; non-object argument is returned (or answers as the specification says) without a TypeError.
(builtin JsObjectPreventExtensions :transitioning true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsObjectLike o)
      (let [(done (%PreventExtensions (%UnboxObjectLike o)))] o)
      o))

(builtin JsObjectIsExtensible :transitioning true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsObjectLike o)
      (%BoxBool (%Eq (%IsExtensible (%UnboxObjectLike o)) 1))
      (JsFalse)))

(builtin JsObjectFreeze :transitioning true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsObjectLike o)
      (let [(done (%ObjectIntegrity (%UnboxObjectLike o) 2))] o)
      o))

(builtin JsObjectSeal :transitioning true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsObjectLike o)
      (let [(done (%ObjectIntegrity (%UnboxObjectLike o) 1))] o)
      o))

(builtin JsObjectIsFrozen :transitioning true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsObjectLike o)
      (%BoxBool (%Eq (%TestIntegrity (%UnboxObjectLike o) 2) 1))
      (JsTrue)))

(builtin JsObjectIsSealed :transitioning true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsObjectLike o)
      (%BoxBool (%Eq (%TestIntegrity (%UnboxObjectLike o) 1) 1))
      (JsTrue)))
