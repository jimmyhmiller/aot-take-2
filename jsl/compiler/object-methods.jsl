; Object and Object.prototype (ECMA-262 §20.1) over the represented object model: data properties
; without attributes (docs/GAPS.md, objects). Primitive receivers are handled as the wrapper's
; prototype chain would resolve them, without creating the wrapper (docs/DECISIONS.md, strings).

; Object.create(O [, Properties]) (§20.1.2.2): a fresh ordinary object on O. A properties object
; needs property descriptors, which do not exist yet; it is a TypeError naming the gap.
(builtin JsObjectCreate :transitioning true :throws true
  :params [(this dyn) (proto dyn) (properties dyn)] :ret dyn
  (if (%IsUndefined properties)
      (if (%IsObjectLike proto)
          (JsFinishObjectLiteral (JsSetObjectLiteralPrototype (JsNewObjectRaw) proto))
          (if (%IsNull proto)
              (JsFinishObjectLiteral (JsNewObjectRaw))
              (JsThrowTypeError (%Box "Object prototype may only be an Object or null"))))
      (JsThrowTypeError (%Box "Object.create with a properties object needs property descriptors, which are not implemented"))))

; Object.getPrototypeOf(O) (§20.1.2.12): ToObject first, so a primitive answers its wrapper's
; prototype.
(builtin JsObjectGetPrototypeOf :transitioning true :throws true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsObjectLike o)
      (%GetObjectPrototype (%UnboxObjectLike o))
      (if (%IsString o)
          (%IntrinsicPrototype "String.prototype")
          (if (%IsBool o)
              (%IntrinsicPrototype "Boolean.prototype")
              (if (%IsUndefined o)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (if (%IsNull o)
                      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                      (if (%IsSymbol o)
                          (%Null)
                          (%IntrinsicPrototype "Number.prototype"))))))))

; Object.keys(O) (§20.1.2.17): own enumerable string keys in order — for an array its present
; indices then its named properties, for a string its indices, for an ordinary object its
; properties (every property is enumerable here).
(builtin JsObjectKeys :transitioning true :throws true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsArray o)
      (let [(raw (%UnboxArray o))]
        (let [(indices (JsArrayIndexKeys raw 0 (%ArrayLen raw) (JsNewArray 0)))]
          (let [(named (%Box (%ObjectKeys (%UnboxObjectLike o) (%IntrinsicPrototype "Array.prototype"))))]
            (let [(appended (JsArrayConcatOne named (%UnboxArray indices) (%ArrayLen (%UnboxArray indices))))]
              indices))))
      (if (%IsObjectLike o)
          (%Box (%ObjectKeys (%UnboxObjectLike o) (%IntrinsicPrototype "Array.prototype")))
          (if (%IsString o)
              (JsStringIndexKeys (%UnboxString o) 0 (JsNewArray 0))
              (if (%IsUndefined o)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (if (%IsNull o)
                      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                      (JsNewArray 0)))))))

; The canonical strings of the present indices below `len`, appended to `out`.
(builtin JsArrayIndexKeys :transitioning true :params [(raw arr) (k int) (len int) (out dyn)] :ret dyn
  (if (%Lt k len)
      (if (%ArrayHasIndex raw k)
          (let [(stored (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) (%Box (%NumberToString (%BoxInt k)))))]
            (JsArrayIndexKeys raw (%Add k 1) len out))
          (JsArrayIndexKeys raw (%Add k 1) len out))
      out))

(builtin JsStringIndexKeys :transitioning true :params [(raw str) (k int) (out dyn)] :ret dyn
  (if (%Lt k (%StringLength raw))
      (let [(stored (%ArrayStore (%UnboxArray out) k (%Box (%NumberToString (%BoxInt k)))))]
        (JsStringIndexKeys raw (%Add k 1) out))
      out))

; Object.prototype.hasOwnProperty(V) (§20.1.3.2): HasOwnProperty over the represented kinds.
(builtin JsObjectHasOwnProperty :transitioning true :throws true :params [(this dyn) (key dyn)] :ret dyn
  (if (%IsArray this)
      (let [(index (JsArrayIndexOfKey key))]
        (if (%Lt index 0)
            (let [(k (JsToPropertyKey key))]
              (if (%Eq k (%PropertyKey "length"))
                  (JsTrue)
                  (%BoxBool (JsHasOwnNamed this k))))
            (%BoxBool (%ArrayHasIndex (%UnboxArray this) index))))
      (if (%IsObjectLike this)
          (%BoxBool (JsHasOwnNamed this (JsToPropertyKey key)))
          (if (%IsString this)
              (let [(index (JsArrayIndexOfKey key))]
                (if (%Lt index 0)
                    (%BoxBool (%Eq (JsToPropertyKey key) (%PropertyKey "length")))
                    (%BoxBool (%Lt index (%StringLength (%UnboxString this))))))
              (if (%IsUndefined this)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (if (%IsNull this)
                      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                      (JsFalse)))))))

; Object.prototype.toString() (§20.1.3.6): the builtin tag; Symbol.toStringTag is not represented.
(builtin JsObjectToStringMethod :params [(this dyn)] :ret dyn
  (if (%IsUndefined this)
      (%Box "[object Undefined]")
      (if (%IsNull this)
          (%Box "[object Null]")
          (if (%IsArray this)
              (%Box "[object Array]")
              (if (%IsFunction this)
                  (%Box "[object Function]")
                  (if (%IsString this)
                      (%Box "[object String]")
                      (if (%IsBool this)
                          (%Box "[object Boolean]")
                          (if (%IsSymbol this)
                              (%Box "[object Symbol]")
                              (if (%IsObject this)
                                  (%Box "[object Object]")
                                  (%Box "[object Number]"))))))))))

; Object.prototype.valueOf() (§20.1.3.7): ToObject(this); a primitive stays itself here (no wrapper
; objects: docs/GAPS.md).
(builtin JsObjectValueOf :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsUndefined this)
      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
      (if (%IsNull this)
          (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
          this)))

; Object.prototype.isPrototypeOf(V) (§20.1.3.3): walk V's chain looking for this.
(builtin JsObjectIsPrototypeOf :transitioning true :throws true :params [(this dyn) (v dyn)] :ret dyn
  (if (%IsObjectLike v)
      (if (%IsObjectLike this)
          (JsInstanceofWalk v this)
          (if (%IsUndefined this)
              (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
              (if (%IsNull this)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (JsFalse))))
      (JsFalse)))

; Object.prototype.propertyIsEnumerable(V) (§20.1.3.4): every represented own property is
; enumerable, so this is hasOwnProperty.
(builtin JsObjectPropertyIsEnumerable :transitioning true :throws true :params [(this dyn) (key dyn)] :ret dyn
  (JsObjectHasOwnProperty this key))
