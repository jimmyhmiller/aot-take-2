; The Array.prototype methods that change an array's shape or search it from the end: splice, fill,
; flat, reduceRight, findLast and findLastIndex (§23.1.3).
;
; Each one here works on a real array. The generic array-like path (array-generic.jsl) is what a
; method called on a non-array receiver takes, and these refuse such a receiver by name rather than
; pretending: `[].splice.call({length: 2})` is a gap, not a silent wrong answer
; (docs/GAPS.md — arrays).

; splice(start, deleteCount, ...items) (§23.1.3.31): the removed elements are answered, the rest
; move, and the items take their place. It is variadic, so its code is the callable ABI itself.
(builtin JsArraySplice :transitioning true :throws true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(args (JsArgumentsArray count overflow a0 a1 a2))]
          (JsArraySpliceOn receiver (%UnboxArray args))))))

(builtin JsArraySpliceOn :transitioning true :throws true :params [(receiver dyn) (args arr)] :ret dyn
  (let [(len (%ArrayLen (%UnboxArray receiver)))]
    (let [(boxed (JsClampedIndex (JsArgAt args 0) len 0))]
      (if (%IsException boxed)
          boxed
          (let [(start (%UnboxInt boxed))]
            (let [(deleted (if (%Lt (%ArrayLen args) 2)
                               (%BoxInt (%Sub len start))
                               (JsClampCount (JsArgAt args 1) (%Sub len start))))]
              (if (%IsException deleted)
                  deleted
                  (let [(removed (JsSortRange receiver start (%Add start (%UnboxInt deleted))))]
                    (let [(rebuilt (JsArraySpliceRebuild receiver args start (%UnboxInt deleted)))]
                      removed)))))))))

(macro JsArgAt :params [(args arr) (i int)] :ret dyn
  (if (%Lt i (%ArrayLen args)) (%ArrayLoad args i) (%Undefined)))

; A relative index (§23.1.3.31 step 4): negative counts from the end, and it is clamped to the
; array. `fallback` is the value an absent argument stands for.
; A completion travels as the value, so the conversion a relative index performs can propagate: a
; `valueOf` that throws must not be swallowed into a zero.
(builtin JsClampedIndex :transitioning true :throws true
  :params [(value dyn) (len int) (fallback int)] :ret dyn
  (if (%IsUndefined value)
      (%BoxInt fallback)
      (let [(n (JsToNumberValue value))]
        (if (%IsException n)
            n
            (let [(i (if (JsNumberFinite (JsPrimitiveNumber n)) (%ToInteger (JsPrimitiveNumber n)) 0))]
              (%BoxInt (if (%Lt i 0)
                           (if (%Lt (%Add len i) 0) 0 (%Add len i))
                           (if (%Lt len i) len i))))))))

(builtin JsClampCount :transitioning true :throws true :params [(value dyn) (most int)] :ret dyn
  (let [(n (JsToNumberValue value))]
    (if (%IsException n)
        n
        (let [(c (if (JsNumberFinite (JsPrimitiveNumber n)) (%ToInteger (JsPrimitiveNumber n)) 0))]
          (%BoxInt (if (%Lt c 0) 0 (if (%Lt most c) most c)))))))

; The array after the splice: everything before `start`, then the inserted items, then everything
; after the removed run. It is rebuilt into a list and written back, which keeps one rule for the
; overlapping cases instead of two directions of copying.
(builtin JsArraySpliceRebuild :transitioning true :throws true
  :params [(receiver dyn) (args arr) (start int) (deleted int)] :ret dyn
  (let [(out (JsSortRange receiver 0 start))]
    (let [(with-items (JsArrayAppendFrom out args 2))]
      (let [(tail (JsSortRange receiver
                               (%Add start deleted)
                               (%ArrayLen (%UnboxArray receiver))))]
        (let [(whole (JsArrayAppendFrom with-items (%UnboxArray tail) 0))]
          ;; The length is set FIRST: a splice that inserts more than it removes grows the array,
          ;; and writing back over the old length would leave the tail unwritten.
          (let [(sized (%ArraySetLength (%UnboxArray receiver) (%ArrayLen (%UnboxArray whole))))]
            (let [(written (JsSortWriteBack (%UnboxArray receiver) (%UnboxArray whole) 0))]
              receiver)))))))

(builtin JsArrayAppendFrom :transitioning true :params [(out dyn) (items arr) (i int)] :ret dyn
  (if (%Lt i (%ArrayLen items))
      (let [(stored (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) (%ArrayLoad items i)))]
        (JsArrayAppendFrom out items (%Add i 1)))
      out))

; fill(value, start, end) (§23.1.3.6).
(builtin JsArrayFill :transitioning true :throws true
  :params [(this dyn) (value dyn) (start dyn) (end dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(len (%ArrayLen (%UnboxArray receiver)))]
          (let [(from (JsClampedIndex start len 0))]
            (if (%IsException from)
                from
                (let [(to (JsClampedIndex end len len))]
                  (if (%IsException to)
                      to
                      (let [(done (JsArrayFillFrom (%UnboxArray receiver)
                                                   value
                                                   (%UnboxInt from)
                                                   (%UnboxInt to)))]
                        receiver)))))))))

(builtin JsArrayFillFrom :transitioning true :params [(raw arr) (value dyn) (i int) (end int)] :ret int
  (if (%Lt i end)
      (let [(stored (%ArrayStore raw i value))]
        (JsArrayFillFrom raw value (%Add i 1) end))
      0))

; flat(depth) (§23.1.3.13): a nested array is spread into the result, to `depth` levels.
(builtin JsArrayFlat :transitioning true :throws true :params [(this dyn) (depth dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(d (if (%IsUndefined depth) (%BoxInt 1) (JsToNumberValue depth)))]
          (if (%IsException d)
              d
              (let [(levels (if (JsNumberFinite (JsPrimitiveNumber d))
                                (%ToInteger (JsPrimitiveNumber d))
                                2147483647))]
                (JsArrayFlatInto receiver levels (JsNewArray 0) 0)))))))

(builtin JsArrayFlatInto :transitioning true :throws true
  :params [(source dyn) (depth int) (out dyn) (i int)] :ret dyn
  (if (%IsArray source)
      (JsArrayFlatStep source depth out i)
      out))

(builtin JsArrayFlatStep :transitioning true :throws true
  :params [(source dyn) (depth int) (out dyn) (i int)] :ret dyn
  (if (%Lt i (%ArrayLen (%UnboxArray source)))
      (let [(element (%ArrayLoad (%UnboxArray source) i))]
        (if (if (%IsArray element) (%Lt 0 depth) (%Eq 0 1))
            (let [(nested (JsArrayFlatInto element (%Sub depth 1) out 0))]
              (if (%IsException nested)
                  nested
                  (JsArrayFlatStep source depth out (%Add i 1))))
            (let [(stored (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) element))]
              (JsArrayFlatStep source depth out (%Add i 1)))))
      out))

; reduceRight(callback, initial) (§23.1.3.25): the same fold, from the end.
(builtin JsArrayReduceRight :transitioning true :throws true
  :params [(this dyn) (callback dyn) (initial dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (if (%IsFunction callback)
            (let [(len (%ArrayLen (%UnboxArray receiver)))]
              (if (%Eq len 0)
                  (if (%IsUndefined initial)
                      (JsThrowTypeError (%Box "Reduce of empty array with no initial value"))
                      initial)
                  (if (%IsUndefined initial)
                      (JsArrayReduceRightFrom receiver
                                              callback
                                              (%ArrayLoad (%UnboxArray receiver) (%Sub len 1))
                                              (%Sub len 2))
                      (JsArrayReduceRightFrom receiver callback initial (%Sub len 1)))))
            (JsThrowTypeError (%Box "callback is not a function"))))))

(builtin JsArrayReduceRightFrom :transitioning true :throws true
  :params [(receiver dyn) (callback dyn) (acc dyn) (i int)] :ret dyn
  (if (%Le 0 i)
      (if (%IsFunction callback)
          (let [(r (%CallFunction callback
                                  (%Undefined)
                                  acc
                                  (%ArrayLoad (%UnboxArray receiver) i)
                                  (%BoxInt i)
                                  receiver))]
            (if (%IsException r)
                r
                (JsArrayReduceRightFrom receiver callback r (%Sub i 1))))
          (JsThrowTypeError (%Box "callback is not a function")))
      acc))

; findLast and findLastIndex (§23.1.3.11, §23.1.3.12): `want` 0 answers the element, 1 the index.
(builtin JsArrayFindLast :transitioning true :throws true
  :params [(this dyn) (predicate dyn) (thisarg dyn)] :ret dyn
  (JsArrayFindLastOf this predicate thisarg 0))

(builtin JsArrayFindLastIndex :transitioning true :throws true
  :params [(this dyn) (predicate dyn) (thisarg dyn)] :ret dyn
  (JsArrayFindLastOf this predicate thisarg 1))

(builtin JsArrayFindLastOf :transitioning true :throws true
  :params [(this dyn) (predicate dyn) (thisarg dyn) (want int)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (if (%IsFunction predicate)
            (JsArrayFindLastFrom receiver
                                 predicate
                                 thisarg
                                 want
                                 (%Sub (%ArrayLen (%UnboxArray receiver)) 1))
            (JsThrowTypeError (%Box "predicate is not a function"))))))

(builtin JsArrayFindLastFrom :transitioning true :throws true
  :params [(receiver dyn) (predicate dyn) (thisarg dyn) (want int) (i int)] :ret dyn
  (if (%Le 0 i)
      (let [(element (%ArrayLoad (%UnboxArray receiver) i))]
        (if (%IsFunction predicate)
            (let [(r (%CallFunction predicate thisarg element (%BoxInt i) receiver (%Undefined)))]
              (if (%IsException r)
                  r
                  (if (JsTruthy r)
                      (if (%Eq want 1) (%BoxInt i) element)
                      (JsArrayFindLastFrom receiver predicate thisarg want (%Sub i 1)))))
            (JsThrowTypeError (%Box "predicate is not a function"))))
      (if (%Eq want 1) (%BoxInt -1) (%Undefined))))
