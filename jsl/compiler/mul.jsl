; Multiplication converts either numeric representation to binary64 before multiplying. In
; particular, it never forms a possibly 96-bit product in an i64 node before deciding how to box it.
(builtin JsMul :params [(a dyn) (b dyn)] :ret dyn
  (let [(left (JsPrimitiveNumber a))
        (right (JsPrimitiveNumber b))]
    (%Box (%Mul left right))))
