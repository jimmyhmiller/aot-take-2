; Building one collection out of another: Array.from and Array.of (§23.1.2.1, §23.1.2.3), and the
; object views Object.entries, Object.values and Object.assign (§20.1.2.5, §20.1.2.22, §20.1.2.1).
;
; The object views share the rule CopyDataProperties states: own string keys in
; OrdinaryOwnPropertyKeys order, the non-enumerable ones dropped, and each read KEYED — an array's
; elements and a string's code units are own properties a named read cannot reach.
; `Object.assign` differs from a spread in one way that is observable: it SETS, so a setter on the
; target runs and a non-writable property on it is a TypeError in strict callers.

; Array.from(items, mapfn) (§23.1.2.1): an iterable is walked by its iterator, anything else is read
; as an array-like by `length`. A mapping function sees each value and its index.
(builtin JsArrayFrom :transitioning true :throws true
  :params [(this dyn) (items dyn) (mapfn dyn)] :ret dyn
  (if (JsArrayFromMapperOk mapfn)
      (if (%IsUndefined items)
          (JsThrowTypeError (%Box "Array.from requires an array-like or iterable object"))
          (if (%IsNull items)
              (JsThrowTypeError (%Box "Array.from requires an array-like or iterable object"))
              (let [(method (JsGetMethodValue items (%WellKnownKey "iterator")))]
                (if (%IsException method)
                    method
                    (if (%IsUndefined method)
                        (JsArrayFromArrayLike items mapfn (JsNewArray 0) 0)
                        (let [(iterator (JsGetIterator items))]
                          (if (%IsException iterator)
                              iterator
                              (let [(next (JsIteratorNextMethod iterator))]
                                (if (%IsException next)
                                    next
                                    (JsArrayFromIterator iterator next mapfn (JsNewArray 0)))))))))))
      (JsThrowTypeError (%Box "Array.from mapper is not a function"))))

(macro JsArrayFromMapperOk :params [(mapfn dyn)] :ret bool
  (if (%IsUndefined mapfn) (%Eq 0 0) (%IsFunction mapfn)))

(builtin JsArrayFromIterator :transitioning true :throws true
  :params [(iterator dyn) (next dyn) (mapfn dyn) (out dyn)] :ret dyn
  (let [(step (JsIteratorStep iterator next))]
    (if (%IsException step)
        step
        (if (JsIteratorDone step)
            out
            (let [(value (JsIteratorValue step))]
              (if (%IsException value)
                  value
                  (let [(mapped (JsArrayFromMap mapfn
                                                value
                                                (%ArrayLen (%UnboxArray out))
                                                iterator))]
                    (if (%IsException mapped)
                        mapped
                        (let [(stored (%ArrayStore (%UnboxArray out)
                                                   (%ArrayLen (%UnboxArray out))
                                                   mapped))]
                          (JsArrayFromIterator iterator next mapfn out))))))))))

; A mapper that throws closes the iterator, as IteratorClose does for every abrupt completion inside
; the loop; without one the value is taken as it is.
(builtin JsArrayFromMap :transitioning true :throws true
  :params [(mapfn dyn) (value dyn) (i int) (iterator dyn)] :ret dyn
  (if (%IsFunction mapfn)
      (let [(mapped (%CallFunction mapfn (%Undefined) value (%BoxInt i) (%Undefined) (%Undefined)))]
        (if (%IsException mapped)
            (let [(closed (JsIteratorClose iterator))]
              mapped)
            mapped))
      value))

; LengthOfArrayLike is the shared one (array-generic.jsl): ToLength of the receiver's `length`.
(builtin JsArrayFromArrayLike :transitioning true :throws true
  :params [(items dyn) (mapfn dyn) (out dyn) (k int)] :ret dyn
  (let [(len (JsArrayLikeLength items))]
    (if (%IsException len)
        len
        (JsArrayFromIndex items mapfn out k (%UnboxInt len)))))

(builtin JsArrayFromIndex :transitioning true :throws true
  :params [(items dyn) (mapfn dyn) (out dyn) (k int) (len int)] :ret dyn
  (if (%Lt k len)
      (let [(value (JsGetKeyed items (%BoxInt k)))]
        (if (%IsException value)
            value
            (let [(mapped (if (%IsFunction mapfn)
                              (%CallFunction mapfn (%Undefined) value (%BoxInt k) (%Undefined) (%Undefined))
                              value))]
              (if (%IsException mapped)
                  mapped
                  (let [(stored (%ArrayStore (%UnboxArray out) k mapped))]
                    (JsArrayFromIndex items mapfn out (%Add k 1) len))))))
      out))

; Array.of(...items) (§23.1.2.3): its arguments, as an array. It is variadic, so its code is the
; callable ABI itself — the only shape that can see how many arguments a call actually passed, which
; is what distinguishes `Array.of()` from `Array.of(undefined)`.
(builtin JsArrayOf :transitioning true :throws true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (JsArgumentsArray count overflow a0 a1 a2))

; Object.values(O) and Object.entries(O) (§20.1.2.22, §20.1.2.5): `kind` 0 the values, 1 the
; `[key, value]` pairs.
(builtin JsObjectValues :transitioning true :throws true :params [(this dyn) (o dyn)] :ret dyn
  (JsObjectView o 0))

(builtin JsObjectEntries :transitioning true :throws true :params [(this dyn) (o dyn)] :ret dyn
  (JsObjectView o 1))

(builtin JsObjectView :transitioning true :throws true :params [(o dyn) (kind int)] :ret dyn
  (if (%IsUndefined o)
      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
      (if (%IsNull o)
          (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
          (let [(names (JsObjectGetOwnPropertyNames (%Undefined) o))]
            (if (%IsException names)
                names
                (JsObjectViewFrom o (%UnboxArray names) 0 kind (JsNewArray 0)))))))

(builtin JsObjectViewFrom :transitioning true :throws true
  :params [(o dyn) (names arr) (i int) (kind int) (out dyn)] :ret dyn
  (if (%Lt i (%ArrayLen names))
      (let [(name (%ArrayLoad names i))]
        (if (JsForInEnumerable o name (JsToPropertyKey name))
            (let [(value (JsGetKeyed o name))]
              (if (%IsException value)
                  value
                  (let [(entry (if (%Eq kind 1) (JsObjectPair name value) value))]
                    (let [(stored (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) entry))]
                      (JsObjectViewFrom o names (%Add i 1) kind out)))))
            (JsObjectViewFrom o names (%Add i 1) kind out)))
      out))

(builtin JsObjectPair :transitioning true :params [(name dyn) (value dyn)] :ret dyn
  (let [(pair (JsNewArray 0))]
    (let [(with-name (%ArrayStore (%UnboxArray pair) 0 name))]
      (let [(with-value (%ArrayStore (%UnboxArray pair) 1 value))]
        pair))))

; Object.assign(target, ...sources) (§20.1.2.1): each source's own enumerable properties are SET on
; the target, in source order, so a setter on the target runs and a later source wins.
(builtin JsObjectAssign :transitioning true :throws true
  :params [(this dyn) (target dyn) (s0 dyn) (s1 dyn) (s2 dyn)] :ret dyn
  (if (%IsObjectLike target)
      (let [(a (JsAssignFrom target s0))]
        (if (%IsException a)
            a
            (let [(b (JsAssignFrom target s1))]
              (if (%IsException b)
                  b
                  (let [(c (JsAssignFrom target s2))]
                    (if (%IsException c) c target))))))
      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))))

; undefined and null are skipped rather than refused (§20.1.2.1 step 4.a).
(builtin JsAssignFrom :transitioning true :throws true :params [(target dyn) (source dyn)] :ret dyn
  (if (%IsUndefined source)
      target
      (if (%IsNull source)
          target
          (let [(names (JsObjectGetOwnPropertyNames (%Undefined) source))]
            (if (%IsException names)
                names
                (JsAssignNames target source (%UnboxArray names) 0))))))

(builtin JsAssignNames :transitioning true :throws true
  :params [(target dyn) (source dyn) (names arr) (i int)] :ret dyn
  (if (%Lt i (%ArrayLen names))
      (let [(name (%ArrayLoad names i))]
        (if (JsForInEnumerable source name (JsToPropertyKey name))
            (let [(value (JsGetKeyed source name))]
              (if (%IsException value)
                  value
                  (let [(written (JsSetKeyed target name value 1))]
                    (if (%IsException written)
                        written
                        (JsAssignNames target source names (%Add i 1))))))
            (JsAssignNames target source names (%Add i 1))))
      target))

; Number.isInteger(v) (§21.1.2.3), isFinite (§21.1.2.2) and isNaN (§21.1.2.4): no conversion — a
; value that is not a Number answers false. A finite number is one that `x - x` leaves at zero; the
; infinities and NaN leave NaN there.
(builtin JsNumberIsInteger :params [(this dyn) (value dyn)] :ret dyn
  (if (JsIsNumberValue value)
      (let [(f (JsPrimitiveNumber value))]
        ;; A finite number is an integer when truncating it changes nothing. An integer value is
        ;; one already; a float goes through the machine truncation.
        (if (%IsInt value)
            (%BoxBool (%Eq 0 0))
            (if (JsNumberFinite f)
                (%BoxBool (%Eq f (%UnboxNumber (%MathUnary 23 (%Box f)))))
                (%BoxBool (%Eq 0 1)))))
      (%BoxBool (%Eq 0 1))))

(builtin JsNumberIsFinite :params [(this dyn) (value dyn)] :ret dyn
  (if (JsIsNumberValue value)
      (%BoxBool (JsNumberFinite (JsPrimitiveNumber value)))
      (%BoxBool (%Eq 0 1))))

(builtin JsNumberIsNaN :params [(this dyn) (value dyn)] :ret dyn
  (if (JsIsNumberValue value)
      (let [(f (JsPrimitiveNumber value))]
        (%BoxBool (%Not (%Eq f f))))
      (%BoxBool (%Eq 0 1))))

(macro JsNumberFinite :params [(f flt)] :ret bool
  (%Eq (%Sub f f) (%ToFloat 0)))

(macro JsIsNumberValue :params [(value dyn)] :ret bool
  (if (%IsInt value) (%Eq 0 0) (%IsFlt value)))
