; A small structured definition kept in the production compiler index. It exercises JSL lexical
; bindings and value-producing control without inventing a second IR: `if` lowers to If/CProj and
; the selected dynamic result lowers to Region/Phi.
(builtin JsChoose :params [(condition dyn) (whenTrue dyn) (whenFalse dyn)] :ret dyn
  (let [(selected (if condition whenTrue whenFalse))]
    (JsIdentity selected)))
