; Own string keys and for-in enumeration (docs/DECISIONS.md, for-in). The runtime answers an ordinary
; object's own keys in OrdinaryOwnPropertyKeys order (`%ObjectKeys`, `%ObjectOwnNames`); the exotic
; kinds' own keys — an array's elements and `length`, a string's indices and `length` — are
; answered here.

; [[OwnPropertyKeys]] restricted to strings (§10.1.11): an array's present indices ascending, then
; `length` (created with the array), then its named keys; any other object's shape keys.
(builtin JsOwnStringKeys :transitioning true :params [(object dyn-object-like)] :ret dyn
  (if (%IsArray object)
      (let [(raw (%UnboxArray object))]
        (let [(keys (JsArrayIndexKeys raw 0 (%ArrayLen raw) (JsNewArray 0)))]
          (let [(with-length (%ArrayStore (%UnboxArray keys) (%ArrayLen (%UnboxArray keys)) (%Box "length")))]
            (let [(named (%Box (%ObjectOwnNames (%UnboxObjectLike object) (%IntrinsicPrototype "Array.prototype"))))]
              (let [(appended (JsArrayConcatOne named (%UnboxArray keys) (%ArrayLen (%UnboxArray keys))))]
                keys)))))
      (%Box (%ObjectOwnNames (%UnboxObjectLike object) (%IntrinsicPrototype "Array.prototype")))))

; Object.getOwnPropertyNames(O) (§20.1.2.10): ToObject, then its own string keys. A string's wrapper
; has its indices and `length`; a Number, Boolean or Symbol wrapper has none.
(builtin JsObjectGetOwnPropertyNames :transitioning true :throws true :params [(this dyn) (o dyn)] :ret dyn
  (if (%IsObjectLike o)
      (JsOwnStringKeys o)
      (if (%IsString o)
          (let [(keys (JsStringIndexKeys (%UnboxString o) 0 (JsNewArray 0)))]
            (let [(with-length (%ArrayStore (%UnboxArray keys) (%ArrayLen (%UnboxArray keys)) (%Box "length")))]
              keys))
          (if (%IsUndefined o)
              (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
              (if (%IsNull o)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (JsNewArray 0))))))

; ForIn/OfHeadEvaluation for `in` (§14.7.5.6) and EnumerateObjectProperties (§14.7.5.9): undefined
; and null enumerate nothing; any other value is ToObject'd and its enumerable string keys are
; listed, own before inherited, each name once — a name seen on a nearer object, enumerable or not,
; shadows it further up the chain. The list is taken when the loop starts; the loop skips a key that
; is gone by the time it is reached (`JsForInNext`).
(builtin JsForInKeys :transitioning true :params [(value dyn)] :ret dyn
  (if (%IsUndefined value)
      (JsNewArray 0)
      (if (%IsNull value)
          (JsNewArray 0)
          (let [(out (JsNewArray 0))]
            (let [(seen (JsNewArray 0))]
              (if (%IsObjectLike value)
                  (JsForInObject value out seen)
                  (if (%IsString value)
                      (let [(indices (JsStringIndexKeys (%UnboxString value) 0 (JsNewArray 0)))]
                        (let [(listed (JsForInCollect (%UnboxArray indices) 0 value out seen))]
                          (let [(shadowed (JsForInSee seen (%PropertyKey "length")))]
                            (JsForInChain (%IntrinsicPrototype "String.prototype") out seen))))
                      (if (%IsBool value)
                          (JsForInChain (%IntrinsicPrototype "Boolean.prototype") out seen)
                          (if (%IsSymbol value)
                              out
                              (JsForInChain (%IntrinsicPrototype "Number.prototype") out seen))))))))))

; One object of the chain: its own string keys, then its prototype's.
(builtin JsForInObject :transitioning true :params [(object dyn-object-like) (out dyn) (seen dyn)] :ret dyn
  (let [(own (JsOwnStringKeys object))]
    (let [(listed (JsForInCollect (%UnboxArray own) 0 object out seen))]
      (JsForInChain (%GetObjectPrototype (%UnboxObjectLike object)) out seen))))

(builtin JsForInChain :transitioning true :params [(holder dyn) (out dyn) (seen dyn)] :ret dyn
  (if (%IsObjectLike holder)
      (JsForInObject holder out seen)
      out))

; Each name of `names` from `i` not already seen is seen, and listed when `holder` has it enumerable.
; `seen` holds property key ids, so a name is compared by identity.
(builtin JsForInCollect :transitioning true :params [(names arr) (i int) (holder dyn) (out dyn) (seen dyn)] :ret int
  (if (%Lt i (%ArrayLen names))
      (let [(name (%ArrayLoad names i))]
        (let [(key (JsToPropertyKey name))]
          (if (JsForInSeen (%UnboxArray seen) key 0)
              (JsForInCollect names (%Add i 1) holder out seen)
              (let [(marked (JsForInSee seen key))]
                (if (JsForInEnumerable holder name key)
                    (let [(listed (%ArrayStore (%UnboxArray out) (%ArrayLen (%UnboxArray out)) name))]
                      (JsForInCollect names (%Add i 1) holder out seen))
                    (JsForInCollect names (%Add i 1) holder out seen))))))
      0))

(macro JsForInSee :transitioning true :params [(seen dyn) (key int)] :ret dyn
  (%ArrayStore (%UnboxArray seen) (%ArrayLen (%UnboxArray seen)) (%BoxInt key)))

(builtin JsForInSeen :params [(seen arr) (key int) (i int)] :ret bool
  (if (%Lt i (%ArrayLen seen))
      (let [(entry (%ArrayLoad seen i))]
        (if (%IsInt entry)
            (if (%Eq (%UnboxInt entry) key)
                (%Eq 0 0)
                (JsForInSeen seen key (%Add i 1)))
            (JsForInSeen seen key (%Add i 1))))
      (%Eq 0 1)))

; Whether `holder` has the own string key `name` (key id `key`) enumerable: a string's indices and an
; array's elements are; an array's `length` is not; any other key answers its shape attributes.
(builtin JsForInEnumerable :transitioning true :params [(holder dyn) (name dyn) (key int)] :ret bool
  (if (%IsString holder)
      (%Eq 0 0)
      (if (%IsArray holder)
          (if (%Lt (JsArrayIndexOfKey name) 0)
              (JsForInEnumerableNamed holder key)
              (%Eq 0 0))
          (JsForInEnumerableNamed holder key))))

(macro JsForInEnumerableNamed :params [(holder dyn) (key int)] :ret bool
  (if (%IsObjectLike holder)
      (let [(attrs (%PropAttrsOwn (%UnboxObjectLike holder) key))]
        (if (%Lt attrs 0)
            (%Eq 0 1)
            (%Ne (%And attrs 2) 0)))
      (%Eq 0 1)))

; The loop's cursor into the key list, starting at the first key.
(macro JsForInFirst :params [] :ret dyn
  (%BoxInt 0))

; The cursor of the first key at or after `cursor` that the object still has ([[HasProperty]]); -1
; past the end. A primitive's keys cannot disappear. The loop site unboxes its own cursor and key
; list, whose representations it holds.
(macro JsForInNext :transitioning true :params [(object dyn) (keys dyn) (cursor dyn)] :ret dyn
  (%BoxInt (JsForInNextFrom object (%UnboxArray keys) (%UnboxInt cursor))))

(builtin JsForInNextFrom :transitioning true :params [(object dyn) (raw arr) (i int)] :ret int
  (if (%Lt i (%ArrayLen raw))
      (if (%IsObjectLike object)
          (if (JsTruthy (JsHasNamedProperty object (JsToPropertyKey (%ArrayLoad raw i))))
              i
              (JsForInNextFrom object raw (%Add i 1)))
          i)
      -1))

(macro JsForInHasKey :params [(cursor dyn)] :ret dyn
  (%BoxBool (%Le 0 (%UnboxInt cursor))))

(macro JsForInKeyAt :params [(keys dyn) (cursor dyn)] :ret dyn
  (%ArrayLoad (%UnboxArray keys) (%UnboxInt cursor)))

(macro JsForInAfter :params [(cursor dyn)] :ret dyn
  (%BoxInt (%Add (%UnboxInt cursor) 1)))
