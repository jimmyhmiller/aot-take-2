; Environment records (docs/DECISIONS.md, closures; ECMA-262 §9.1 Environment Records).
;
; A binding one activation owns and a nested function mentions is shared: both may read it and
; either may write it, so it cannot stay an SSA value of the activation. It moves into the
; activation's environment record — an array whose element 0 is the enclosing environment and whose
; other elements are that activation's captured bindings, in the order the frontend assigned. A
; function object carries the environment it was created in (its environment word, the same word a
; bound function uses for its record), and a running function reaches it through the function object
; its entry was called with.
;
; Nothing in a program can name an environment: the frontend is the only writer of the word and of
; every slot index, so a value that is not an environment record here is a compiler invariant that
; failed, not a JavaScript completion — these definitions trap rather than throw, and reading a
; captured binding is therefore an ordinary value, never a completion its caller must test.

(builtin JsNewEnvironment :transitioning true :params [(parent dyn) (count int)] :ret dyn
  (let [(env (JsNewArray (%Add count 1)))]
    (let [(linked (%ArrayStore (%UnboxArray env) 0 parent))]
      env)))

; The environment a running function was called with.
(builtin JsFunctionEnvironment :transitioning true :params [(callee dyn)] :ret dyn
  (if (%IsFunction callee)
      (JsRequireEnvironment (%ClosureEnv callee))
      (JsRequireEnvironment callee)))

(macro JsRequireEnvironment :params [(env dyn)] :ret dyn
  (if (%IsArray env) env (let [(trapped (%TrapInvariant))] env)))

; The environment `depth` links above one: element 0 of each is the environment enclosing it.
(builtin JsEnvAncestor :transitioning true :params [(env dyn) (depth int)] :ret dyn
  (if (%Lt 0 depth)
      (JsEnvAncestor (JsEnvSlot env 0) (%Sub depth 1))
      env))

(builtin JsEnvSlot :transitioning true :params [(env dyn) (slot int)] :ret dyn
  (if (%IsArray env)
      (%ArrayLoad (%UnboxArray env) slot)
      (let [(trapped (%TrapInvariant))] env)))

; A captured `let`, `const` or `class` before its initialization: its slot is still empty, which is
; its temporal dead zone (§9.1.1.1.6), and reading it is a ReferenceError.
(builtin JsEnvSlotInitialized :transitioning true :throws true :params [(env dyn) (slot int)] :ret dyn
  (if (%IsArray env)
      (if (%ArrayHasIndex (%UnboxArray env) slot)
          (%ArrayLoad (%UnboxArray env) slot)
          (JsThrowReferenceError))
      (let [(trapped (%TrapInvariant))] env)))

(builtin JsEnvStore :transitioning true :params [(env dyn) (slot int) (value dyn)] :ret dyn
  (if (%IsArray env)
      (let [(stored (%ArrayStore (%UnboxArray env) slot value))]
        value)
      (let [(trapped (%TrapInvariant))] value)))
