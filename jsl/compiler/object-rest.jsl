; CopyDataProperties (§7.3.25), which is what object spread in a literal (`{...o}`) and a rest
; property in an object pattern (`{a, ...rest}`) both perform. Every own enumerable property of the
; source that the pattern did not already take is defined on the target as a data property — a copy,
; not an alias: an accessor is read once and the target holds its value.
;
; The excluded keys are the ones the pattern took, as key ids in a JS array, so a computed key is
; excluded by the identity the pattern already converted it to rather than by its spelling.

; A fresh exclusion list, and one key added to it. The pattern builds the list as it reads, so a
; computed key is evaluated exactly once.
(macro JsExcludedKeys :transitioning true :params [] :ret dyn
  (JsNewArray 0))

(macro JsExcludeKey :transitioning true :params [(excluded dyn) (key int)] :ret dyn
  (%ArrayStore (%UnboxArray excluded) (%ArrayLen (%UnboxArray excluded)) (%BoxInt key)))

; undefined and null copy nothing (step 2). A primitive source has no own enumerable properties
; except a string's indices, which its wrapper would expose; an object source answers its own string
; keys in OrdinaryOwnPropertyKeys order. Symbol keys are not copied because nothing enumerates them
; yet (docs/GAPS.md — property enumeration).
(builtin JsCopyDataProperties :transitioning true :throws true
  :params [(target dyn) (source dyn) (excluded dyn)] :ret dyn
  (if (%IsUndefined source)
      target
      (if (%IsNull source)
          target
          (if (%IsObjectLike source)
              (let [(names (JsOwnStringKeys source))]
                (if (%IsException names)
                    names
                    (JsCopyOwnEnumerable target source (%UnboxArray names) 0 excluded)))
              (if (%IsString source)
                  (let [(names (JsStringIndexKeys (%UnboxString source) 0 (JsNewArray 0)))]
                    (JsCopyOwnEnumerable target source (%UnboxArray names) 0 excluded))
                  target)))))

(builtin JsCopyOwnEnumerable :transitioning true :throws true
  :params [(target dyn) (source dyn) (names arr) (i int) (excluded dyn)] :ret dyn
  (if (%Lt i (%ArrayLen names))
      (let [(name (%ArrayLoad names i))]
        (let [(key (JsToPropertyKey name))]
          (if (JsKeyExcluded (%UnboxArray excluded) key 0)
              (JsCopyOwnEnumerable target source names (%Add i 1) excluded)
              (if (JsForInEnumerable source name key)
                  ;; The read is keyed, not named: an array's elements and a string's code units
                  ;; are own properties that a named read does not reach.
                  (let [(value (JsGetKeyed source name))]
                    (if (%IsException value)
                        value
                        (let [(defined (JsCopyDefine target key value))]
                          (if (%IsException defined)
                              defined
                              (JsCopyOwnEnumerable target source names (%Add i 1) excluded)))))
                  (JsCopyOwnEnumerable target source names (%Add i 1) excluded)))))
      target))

; CreateDataPropertyOrThrow on the target, which the caller always created and so is an object.
(macro JsCopyDefine :transitioning true :throws true
  :params [(target dyn) (key int) (value dyn)] :ret dyn
  (if (%IsObjectLike target)
      (JsApplyDefine target key value 7 15)
      ;; The caller created the target, so a primitive here is a compiler invariant.
      (let [(trapped (%TrapInvariant))] target)))

; Whether a key id is one the pattern already took. The list is short — one entry per property the
; pattern named — so it is scanned, the way for-in scans the names it has already seen.
(builtin JsKeyExcluded :params [(excluded arr) (key int) (i int)] :ret bool
  (if (%Lt i (%ArrayLen excluded))
      (let [(entry (%ArrayLoad excluded i))]
        ;; Every entry was boxed by JsExcludeKey; the test is the proof the unbox needs.
        (if (%IsInt entry)
            (if (%Eq (%UnboxInt entry) key)
                (%Eq 0 0)
                (JsKeyExcluded excluded key (%Add i 1)))
            (JsKeyExcluded excluded key (%Add i 1))))
      (%Eq 0 1)))

; `{ ...rest }` in a pattern (§14.3.3.1 RestBindingInitialization): a fresh ordinary object holding
; every own enumerable property of the source the pattern did not take. undefined and null are a
; TypeError here, unlike a spread in a literal, because the pattern requires an object to copy from.
(builtin JsObjectRest :transitioning true :throws true :params [(source dyn) (excluded dyn)] :ret dyn
  (if (%IsUndefined source)
      (JsThrowTypeError (%Box "Cannot destructure a rest property from undefined or null"))
      (if (%IsNull source)
          (JsThrowTypeError (%Box "Cannot destructure a rest property from undefined or null"))
          (let [(target (JsFinishObjectLiteral (JsSetObjectLiteralPrototype (JsNewObjectRaw)
                                                                           (%IntrinsicPrototype "Object.prototype"))))]
            (JsCopyDataProperties target source excluded)))))

; `{ ...o }` in a literal: the object under construction is still the raw one the literal builder
; holds, so the spread boxes it and copies onto it, excluding nothing. The literal's own later
; properties are defined after it and overwrite what the copy brought in, as source order says.
(builtin JsCopyLiteralProperties :transitioning true :throws true
  :params [(object obj) (source dyn)] :ret dyn
  (JsCopyDataProperties (%Box object) source (JsExcludedKeys)))

; A computed key in a pattern is excluded by the identity it was already converted to.
(macro JsExcludeComputedKey :transitioning true :throws true :params [(excluded dyn) (key dyn)] :ret dyn
  (JsExcludeKey excluded (JsToPropertyKey key)))
