; Array exotic objects (docs/DECISIONS.md, arrays; ECMA-262 §10.4.2 and §23.1).
;
; An array is a tagged word of its own family (%IsArray) whose payload begins like an object's
; and then holds the elements store and the length word. The store is the runtime's: %NewArray
; allocates, %ArrayLoad / %ArrayHasIndex read a slot, %ArrayStore writes one and grows the store
; and the length, %ArraySetLength is ArraySetLength over a valid length, and %ArrayIndexOfString
; decides whether a string is a canonical array index. Everything JavaScript can observe — which
; keys are indices, what a hole reads as, how `length` behaves, what the constructor and the
; methods do — is written here.
;
; Two consequences of the fixed-slot calling convention are recorded in docs/DECISIONS.md
; (intrinsics): a missing argument arrives as undefined, so `Array(undefined)` builds an empty
; array and `push(undefined)` pushes nothing; and a variadic call admits at most the slots the
; intrinsic declares.

; ArrayCreate(length) (§10.4.2.2) with %Array.prototype% as [[Prototype]].
(macro JsNewArray :transitioning true :params [(length int)] :ret dyn
  (%Box (%NewArray length (%ArrayPrototype))))

; ArrayLiteral evaluation (§13.2.4.2): each element is CreateDataProperty at the next index; an
; elision advances the length without defining an element.
(macro JsArrayLiteralElement :transitioning true :params [(array dyn) (index int) (value dyn)] :ret dyn
  (let [(stored (%ArrayStore (%UnboxArray array) index value))]
    array))

(macro JsArrayLiteralHole :transitioning true :params [(array dyn)] :ret dyn
  (let [(raw (%UnboxArray array))]
    (let [(grown (%ArraySetLength raw (%Add (%ArrayLen raw) 1)))]
      array)))

; Is this integer an array index (§6.1.7): in [0, 2^32 - 2]?
(macro JsIsArrayIndexInt :params [(i int)] :ret bool
  (if (%Lt i 0) (%Eq 0 1) (%Not (%Lt 4294967294 i))))

; Is this Number an integer (no fraction, finite)? NaN and the infinities fail the round trip.
(macro JsIsIntegralNumber :params [(f flt)] :ret bool
  (%Eq (%ToFloat (%ToInteger f)) f))

; The array index a property key denotes, or -1: an integral Number in range, or a canonical
; numeric String of one. Everything else is an ordinary property key.
(builtin JsArrayIndexOfKey :params [(key dyn)] :ret int
  (if (%IsInt key)
      (let [(i (%UnboxInt key))]
        (if (JsIsArrayIndexInt i) i -1))
      (if (%IsFlt key)
          (let [(f (%UnboxFlt key))]
            (if (JsIsIntegralNumber f)
                (let [(i (%ToInteger f))]
                  (if (JsIsArrayIndexInt i) i -1))
                -1))
          (if (%IsString key)
              (%ArrayIndexOfString (%UnboxString key))
              -1))))

; [[Get]] of an array index on an array (§10.1.8 over the exotic own property): the element when
; it exists, else the ordinary walk up the prototype chain under the key's string.
(macro JsArrayGetIndex :transitioning true :throws true :params [(array dyn) (index int) (key dyn)] :ret dyn
  (let [(raw (%UnboxArray array))]
    (if (%ArrayHasIndex raw index)
        (%ArrayLoad raw index)
        (JsGetNamedPrototypeChain array (%InternKey (%UnboxString (JsToString key)))))))

; [[Set]] of an array index on an array (§10.4.2.1 step 2): define the element; the length grows
; past it.
(macro JsArraySetIndex :transitioning true :params [(array dyn) (index int) (value dyn)] :ret dyn
  (let [(stored (%ArrayStore (%UnboxArray array) index value))]
    value))

; ArraySetLength (§10.4.2.4) for a `length` write: ToUint32(value) must equal ToNumber(value) or
; the write is a RangeError.
(builtin JsArraySetLength :transitioning true :throws true :params [(array dyn) (value dyn)] :ret dyn
  (let [(number (JsPrimitiveNumber value))]
    (if (JsIsIntegralNumber number)
        (let [(n (%ToInteger number))]
          (if (%Lt n 0)
              (JsThrowRangeError (%Box "Invalid array length"))
              (if (%Lt 4294967295 n)
                  (JsThrowRangeError (%Box "Invalid array length"))
                  (let [(set (%ArraySetLength (%UnboxArray array) n))]
                    array))))
        (JsThrowRangeError (%Box "Invalid array length")))))

; --- the constructor and its statics (§23.1.1, §23.1.2) ---

; Array(...values), called with or without `new` (§23.1.1.1). One argument that is a Number is a
; length; one that is not is the single element; several are the elements.
(builtin JsIntrinsicArray :transitioning true :throws true
  :params [(this dyn) (callee dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (if (%IsUndefined a0)
      (JsNewArray 0)
      (if (%IsUndefined a1)
          (if (%IsInt a0)
              (JsArrayOfLength a0)
              (if (%IsFlt a0)
                  (JsArrayOfLength a0)
                  (JsArrayLiteralElement (JsNewArray 0) 0 a0)))
          (let [(two (JsArrayLiteralElement (JsArrayLiteralElement (JsNewArray 0) 0 a0) 1 a1))]
            (if (%IsUndefined a2)
                two
                (let [(three (JsArrayLiteralElement two 2 a2))]
                  (if (%IsUndefined a3) three (JsArrayLiteralElement three 3 a3))))))))

; Array(len): a valid array length or a RangeError.
(builtin JsArrayOfLength :transitioning true :throws true :params [(length dyn)] :ret dyn
  (let [(number (JsPrimitiveNumber length))]
    (if (JsIsIntegralNumber number)
        (let [(n (%ToInteger number))]
          (if (%Lt n 0)
              (JsThrowRangeError (%Box "Invalid array length"))
              (if (%Lt 4294967295 n)
                  (JsThrowRangeError (%Box "Invalid array length"))
                  (JsNewArray n))))
        (JsThrowRangeError (%Box "Invalid array length")))))

; Array.isArray(value) (§23.1.2.2).
(builtin JsArrayIsArray :params [(this dyn) (value dyn)] :ret dyn
  (%BoxBool (%IsArray value)))

; --- Array.prototype (§23.1.3), over an array receiver ---
;
; A method's body receives the receiver and its arguments; unlike a constructor it never needs its
; own function object (docs/DECISIONS.md, intrinsics). These methods are generic in the
; specification (any array-like receiver); here a receiver that is not an array is a TypeError
; until array-likes exist (docs/GAPS.md, arrays).

(macro JsArrayReceiver :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsArray this) this (JsThrowTypeError (%Box "Array.prototype method called on a non-array"))))

; push(...items) (§23.1.3.23): each argument that arrived is appended; the new length is returned.
(builtin JsArrayPush :transitioning true :throws true
  :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(raw (%UnboxArray receiver))]
          (if (%IsUndefined a0)
              (%BoxInt (%ArrayLen raw))
              (let [(s0 (%ArrayStore raw (%ArrayLen raw) a0))]
                (if (%IsUndefined a1)
                    (%BoxInt (%ArrayLen raw))
                    (let [(s1 (%ArrayStore raw (%ArrayLen raw) a1))]
                      (if (%IsUndefined a2)
                          (%BoxInt (%ArrayLen raw))
                          (let [(s2 (%ArrayStore raw (%ArrayLen raw) a2))]
                            (if (%IsUndefined a3)
                                (%BoxInt (%ArrayLen raw))
                                (let [(s3 (%ArrayStore raw (%ArrayLen raw) a3))]
                                  (%BoxInt (%ArrayLen raw))))))))))))))

; pop() (§23.1.3.22): the last element (undefined when empty) and one less length.
(builtin JsArrayPop :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(raw (%UnboxArray receiver))]
          (let [(len (%ArrayLen raw))]
            (if (%Lt len 1)
                (%Undefined)
                (let [(last (%ArrayLoad raw (%Sub len 1)))]
                  (let [(shrunk (%ArraySetLength raw (%Sub len 1)))]
                    last))))))))

; at(index) (§23.1.3.1): a negative index counts from the end.
(builtin JsArrayAt :transitioning true :throws true :params [(this dyn) (index dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(raw (%UnboxArray receiver))]
          (let [(len (%ArrayLen raw))
                (relative (JsRelativeIndex index))]
            (let [(k (if (%Lt relative 0) (%Add len relative) relative))]
              (if (%Lt k 0)
                  (%Undefined)
                  (if (%Lt k len) (%ArrayLoad raw k) (%Undefined)))))))))

; ToIntegerOrInfinity (§7.1.5) of an index argument, saturated into the int range; undefined is 0.
(macro JsRelativeIndex :params [(index dyn)] :ret int
  (if (%IsUndefined index) 0 (%ToInteger (JsPrimitiveNumber index))))

; indexOf(search) and includes(search) (§23.1.3.17, §23.1.3.16) from the front: indexOf skips
; holes and compares strictly; includes reads holes as undefined and uses SameValueZero (so it
; finds NaN). Both walk by recursion over the index.
(builtin JsArrayIndexOf :transitioning true :throws true :params [(this dyn) (search dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (%BoxInt (JsArrayIndexOfFrom (%UnboxArray receiver) search 0)))))

(builtin JsArrayIndexOfFrom :params [(raw arr) (search dyn) (i int)] :ret int
  (if (%Lt i (%ArrayLen raw))
      (if (%ArrayHasIndex raw i)
          (if (JsStrictEqualValue (%ArrayLoad raw i) search) i (JsArrayIndexOfFrom raw search (%Add i 1)))
          (JsArrayIndexOfFrom raw search (%Add i 1)))
      -1))

(builtin JsArrayIncludes :transitioning true :throws true :params [(this dyn) (search dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (%BoxBool (JsArrayIncludesFrom (%UnboxArray receiver) search 0)))))

(builtin JsArrayIncludesFrom :params [(raw arr) (search dyn) (i int)] :ret bool
  (if (%Lt i (%ArrayLen raw))
      (if (JsSameValueZero (%ArrayLoad raw i) search) (%Eq 0 0) (JsArrayIncludesFrom raw search (%Add i 1)))
      (%Eq 0 1)))

; SameValueZero (§7.2.11): strict equality, except that NaN equals NaN.
(macro JsSameValueZero :params [(a dyn) (b dyn)] :ret bool
  (if (JsStrictEqualValue a b)
      (%Eq 0 0)
      (if (%IsFlt a)
          (if (%IsFlt b)
              (let [(x (%UnboxFlt a)) (y (%UnboxFlt b))]
                (%And (%Ne x x) (%Ne y y)))
              (%Eq 0 1))
          (%Eq 0 1))))

; join(separator) (§23.1.3.18): undefined and null elements join as the empty string; the
; separator defaults to ",".
(builtin JsArrayJoin :transitioning true :throws true :params [(this dyn) (separator dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(sep (if (%IsUndefined separator) (%Box ",") (JsToString separator)))]
          (%Box (JsArrayJoinFrom (%UnboxArray receiver) (%UnboxString sep) 0 ""))))))

(builtin JsArrayJoinFrom :transitioning true :params [(raw arr) (sep str) (i int) (out str)] :ret str
  (if (%Lt i (%ArrayLen raw))
      (let [(element (%ArrayLoad raw i))]
        (let [(piece (if (%IsUndefined element)
                         ""
                         (if (%IsNull element) "" (%UnboxString (JsToString element)))))]
          (let [(joined (if (%Eq i 0) piece (%StringConcat (%StringConcat out sep) piece)))]
            (JsArrayJoinFrom raw sep (%Add i 1) joined))))
      out))

; Array.prototype.toString (§23.1.3.36): join with the default separator.
(builtin JsArrayToString :transitioning true :throws true :params [(this dyn)] :ret dyn
  (JsArrayJoin this (%Undefined)))

; reverse() (§23.1.3.26), in place, by swapping from both ends.
(builtin JsArrayReverse :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(raw (%UnboxArray receiver))]
          (let [(done (JsArrayReverseFrom raw 0 (%Sub (%ArrayLen raw) 1)))]
            receiver)))))

(builtin JsArrayReverseFrom :transitioning true :params [(raw arr) (lower int) (upper int)] :ret int
  (if (%Lt lower upper)
      (let [(low (%ArrayLoad raw lower))
            (high (%ArrayLoad raw upper))
            (low-defined (%ArrayHasIndex raw lower))
            (high-defined (%ArrayHasIndex raw upper))]
        (let [(s1 (JsArrayMoveSlot raw upper low low-defined))
              (s2 (JsArrayMoveSlot raw lower high high-defined))]
          (JsArrayReverseFrom raw (%Add lower 1) (%Sub upper 1))))
      0))

; Put `value` at `index`, or make the slot a hole when the source slot was one: the length is
; unchanged either way.
(macro JsArrayMoveSlot :transitioning true :params [(raw arr) (index int) (value dyn) (defined bool)] :ret int
  (if defined
      (let [(stored (%ArrayStore raw index value))] 0)
      (JsArrayDeleteSlot raw index)))

; Delete an element inside the length by truncating past it and restoring the length: the slot
; becomes a hole and the length is what it was.
(macro JsArrayDeleteSlot :transitioning true :params [(raw arr) (index int)] :ret int
  (let [(len (%ArrayLen raw))]
    (if (%Lt index len)
        (let [(cut (%ArraySetLength raw index))]
          (%ArraySetLength raw len))
        len)))

; shift() (§23.1.3.27): the first element; the rest move down one.
(builtin JsArrayShift :transitioning true :throws true :params [(this dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(raw (%UnboxArray receiver))]
          (let [(len (%ArrayLen raw))]
            (if (%Lt len 1)
                (%Undefined)
                (let [(first (%ArrayLoad raw 0))]
                  (let [(moved (JsArrayMoveDown raw 1 len))]
                    (let [(shrunk (%ArraySetLength raw (%Sub len 1)))]
                      first)))))))))

(builtin JsArrayMoveDown :transitioning true :params [(raw arr) (from int) (len int)] :ret int
  (if (%Lt from len)
      (let [(moved (JsArrayMoveSlot raw (%Sub from 1) (%ArrayLoad raw from) (%ArrayHasIndex raw from)))]
        (JsArrayMoveDown raw (%Add from 1) len))
      0))

; unshift(...items) (§23.1.3.34): the arguments that arrived go in front; the new length is returned.
(builtin JsArrayUnshift :transitioning true :throws true
  :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(raw (%UnboxArray receiver))]
          (let [(count (if (%IsUndefined a0) 0 (if (%IsUndefined a1) 1 (if (%IsUndefined a2) 2 (if (%IsUndefined a3) 3 4)))))]
            (if (%Eq count 0)
                (%BoxInt (%ArrayLen raw))
                (let [(len (%ArrayLen raw))]
                  (let [(moved (JsArrayMoveUp raw (%Sub len 1) count))]
                    (let [(p0 (%ArrayStore raw 0 a0))]
                      (let [(p1 (if (%Lt 1 count) (%ArrayStore raw 1 a1) a1))]
                        (let [(p2 (if (%Lt 2 count) (%ArrayStore raw 2 a2) a2))]
                          (let [(p3 (if (%Lt 3 count) (%ArrayStore raw 3 a3) a3))]
                            (%BoxInt (%ArrayLen raw))))))))))))))

; Move the elements [0, from] up by `count`, from the top down so nothing is overwritten first.
(builtin JsArrayMoveUp :transitioning true :params [(raw arr) (from int) (count int)] :ret int
  (if (%Lt from 0)
      0
      (let [(moved (JsArrayMoveSlot raw (%Add from count) (%ArrayLoad raw from) (%ArrayHasIndex raw from)))]
        (JsArrayMoveUp raw (%Sub from 1) count))))

; slice(start, end) (§23.1.3.28): a fresh array of the elements in [start, end), holes kept as
; holes; negative indices count from the end, undefined end is the length.
(builtin JsArraySlice :transitioning true :throws true :params [(this dyn) (start dyn) (end dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(raw (%UnboxArray receiver))]
          (let [(len (%ArrayLen raw))]
            (let [(from (JsClampRelative (JsRelativeIndex start) len))
                  (to (if (%IsUndefined end) len (JsClampRelative (JsRelativeIndex end) len)))]
              (let [(result (JsNewArray 0))]
                (let [(copied (JsArrayCopyRange raw from to (%UnboxArray result) 0))]
                  result))))))))

; A relative index resolved against the length and clamped into [0, len].
(macro JsClampRelative :params [(relative int) (len int)] :ret int
  (if (%Lt relative 0)
      (let [(k (%Add len relative))] (if (%Lt k 0) 0 k))
      (if (%Lt len relative) len relative)))

; Copy [from, to) of `source` to `target` starting at `at`; holes stay holes but count toward
; the target's length.
(builtin JsArrayCopyRange :transitioning true :params [(source arr) (from int) (to int) (target arr) (at int)] :ret int
  (if (%Lt from to)
      (let [(placed (if (%ArrayHasIndex source from)
                        (let [(s (%ArrayStore target at (%ArrayLoad source from)))] 0)
                        (%ArraySetLength target (%Add at 1))))]
        (JsArrayCopyRange source (%Add from 1) to target (%Add at 1)))
      at))

; concat(...items) (§23.1.3.2): a fresh array of the receiver's elements followed by each argument
; that arrived, spread when it is an array, appended otherwise.
(builtin JsArrayConcat :transitioning true :throws true
  :params [(this dyn) (a0 dyn) (a1 dyn) (a2 dyn) (a3 dyn)] :ret dyn
  (let [(receiver (JsArrayReceiver this))]
    (if (%IsException receiver)
        receiver
        (let [(result (JsNewArray 0))]
          (let [(raw (%UnboxArray result))]
            (let [(n0 (JsArrayConcatOne receiver raw 0))]
              (if (%IsUndefined a0)
                  result
                  (let [(n1 (JsArrayConcatOne a0 raw n0))]
                    (if (%IsUndefined a1)
                        result
                        (let [(n2 (JsArrayConcatOne a1 raw n1))]
                          (if (%IsUndefined a2)
                              result
                              (let [(n3 (JsArrayConcatOne a2 raw n2))]
                                (if (%IsUndefined a3)
                                    result
                                    (let [(n4 (JsArrayConcatOne a3 raw n3))]
                                      result))))))))))))))

(builtin JsArrayConcatOne :transitioning true :params [(item dyn) (target arr) (at int)] :ret int
  (if (%IsArray item)
      (let [(source (%UnboxArray item))]
        (JsArrayCopyRange source 0 (%ArrayLen source) target at))
      (let [(stored (%ArrayStore target at item))]
        (%Add at 1))))
