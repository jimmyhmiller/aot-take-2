(intrinsic %isNaN% :function JsGlobalIsNaN :writable true :configurable true)

(intrinsic %isFinite% :function JsGlobalIsFinite :writable true :configurable true)

(intrinsic %parseInt% :function JsGlobalParseInt :writable true :configurable true)

