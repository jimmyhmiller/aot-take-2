; The standard globals (docs/DECISIONS.md, intrinsics). Each is the body of a hoisted function
; `Name(a0 ...)`: it receives the receiver, `new.target`, its own function object (whose
; `prototype` property is the created objects' [[Prototype]]), then the arguments. A `new`
; arrives with the fresh object as receiver and the constructor as `new.target`; a call arrives
; with whatever receiver the site gave and an undefined `new.target` (docs/DECISIONS.md,
; new.target is an argument slot) — that, not the receiver, is what tells the two apart.

(builtin JsOrdinaryCreateFromConstructor :transitioning true :throws true :params [(callee dyn)] :ret dyn
  (let [(proto (JsGetNamed callee (%PropertyKey "prototype")))]
    (if (%IsException proto)
        proto
        (JsFinishObjectLiteral (JsSetObjectLiteralPrototype (JsNewObjectRaw) proto)))))

(builtin JsCalledAsFunction :params [(newtarget dyn)] :ret bool
  (%IsUndefined newtarget))

; Object(value): an object is itself; undefined and null make a fresh ordinary object; a primitive
; would need a wrapper object.
(builtin JsIntrinsicObject :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (value dyn)] :ret dyn
  (if (%IsObjectLike value)
      value
      (if (%IsUndefined value)
          (JsOrdinaryCreateFromConstructor callee)
          (if (%IsNull value)
              (JsOrdinaryCreateFromConstructor callee)
              (let [(trapped (%TrapToObject))]
                value)))))

; String(value) converts; `new String(value)` would be a wrapper object.
(builtin JsIntrinsicString :transitioning true :params [(this dyn) (newtarget dyn) (callee dyn) (value dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (JsToString value)
      (let [(trapped (%TrapToObject))]
        value)))

(builtin JsIntrinsicNumber :params [(this dyn) (newtarget dyn) (callee dyn) (value dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (%Box (JsPrimitiveNumber value))
      (let [(trapped (%TrapToObject))]
        value)))

(builtin JsIntrinsicBoolean :params [(this dyn) (newtarget dyn) (callee dyn) (value dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (%BoxBool (JsTruthy value))
      (let [(trapped (%TrapToObject))]
        value)))

; Error(message) and every NativeError: called with or without `new` the result is an object on the
; constructor's prototype, with an own `message` when one was given (ECMA-262 §20.5.1.1).
(builtin JsIntrinsicError :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (message dyn)] :ret dyn
  (let [(created (if (JsCalledAsFunction newtarget) (JsOrdinaryCreateFromConstructor callee) this))]
    (if (%IsException created)
        created
        (if (%IsUndefined message)
            created
            (let [(described (JsDefineOwnNamed created (%PropertyKey "message") (JsToString message) 0))]
              (if (%IsException described) described created))))))

; ---------------------------------------------------------------------------------------------
; The realm's global-object surface (src/jsl/decls.coil defines the form). Each declaration is one
; global binding: the function or object it names, its prototype chain, and every property
; CreateIntrinsics gives it, with the attributes ECMA-262 §18 assigns: a global binding and a
; built-in method are writable and configurable, not enumerable; a Math value property has none.
; ORDER IS PART OF THE FORMAT: it is the order the realm materializes them in.

(intrinsic %Object% :constructor JsIntrinsicObject :writable true :configurable true
  (method "create" :closure JsObjectCreate :writable true :configurable true)
  (method "getPrototypeOf" :closure JsObjectGetPrototypeOf :writable true :configurable true)
  (method "keys" :closure JsObjectKeys :writable true :configurable true)
  (method "defineProperty" :closure JsObjectDefineProperty :writable true :configurable true)
  (method "defineProperties" :closure JsObjectDefineProperties :writable true :configurable true)
  (method "getOwnPropertyDescriptor" :closure JsObjectGetOwnPropertyDescriptor :writable true :configurable true)
  (method "preventExtensions" :closure JsObjectPreventExtensions :writable true :configurable true)
  (method "isExtensible" :closure JsObjectIsExtensible :writable true :configurable true)
  (method "freeze" :closure JsObjectFreeze :writable true :configurable true)
  (method "seal" :closure JsObjectSeal :writable true :configurable true)
  (method "isFrozen" :closure JsObjectIsFrozen :writable true :configurable true)
  (method "isSealed" :closure JsObjectIsSealed :writable true :configurable true)
  (method "hasOwnProperty" :target prototype :closure JsObjectHasOwnProperty :writable true :configurable true)
  (method "toString" :target prototype :closure JsObjectToStringMethod :writable true :configurable true)
  (method "valueOf" :target prototype :closure JsObjectValueOf :writable true :configurable true)
  (method "isPrototypeOf" :target prototype :closure JsObjectIsPrototypeOf :writable true :configurable true)
  (method "propertyIsEnumerable" :target prototype :closure JsObjectPropertyIsEnumerable :writable true :configurable true))

(intrinsic %String% :constructor JsIntrinsicString :writable true :configurable true
  (method "fromCharCode" :closure JsStringFromCharCode :writable true :configurable true)
  (method "charAt" :target prototype :closure JsStringCharAt :writable true :configurable true)
  (method "charCodeAt" :target prototype :closure JsStringCharCodeAt :writable true :configurable true)
  (method "at" :target prototype :closure JsStringAt :writable true :configurable true)
  (method "indexOf" :target prototype :closure JsStringIndexOf :writable true :configurable true)
  (method "lastIndexOf" :target prototype :closure JsStringLastIndexOf :writable true :configurable true)
  (method "includes" :target prototype :closure JsStringIncludes :writable true :configurable true)
  (method "startsWith" :target prototype :closure JsStringStartsWith :writable true :configurable true)
  (method "endsWith" :target prototype :closure JsStringEndsWith :writable true :configurable true)
  (method "slice" :target prototype :closure JsStringSlice :writable true :configurable true)
  (method "substring" :target prototype :closure JsStringSubstring :writable true :configurable true)
  (method "concat" :target prototype :closure JsStringConcat :writable true :configurable true)
  (method "trim" :target prototype :closure JsStringTrim :writable true :configurable true)
  (method "trimStart" :target prototype :closure JsStringTrimStart :writable true :configurable true)
  (method "trimEnd" :target prototype :closure JsStringTrimEnd :writable true :configurable true)
  (method "repeat" :target prototype :closure JsStringRepeat :writable true :configurable true)
  (method "toString" :target prototype :closure JsStringToStringMethod :writable true :configurable true)
  (method "valueOf" :target prototype :closure JsStringValueOf :writable true :configurable true)
  (method "split" :target prototype :closure JsStringSplit :writable true :configurable true)
  (method "padStart" :target prototype :closure JsStringPadStart :writable true :configurable true)
  (method "padEnd" :target prototype :closure JsStringPadEnd :writable true :configurable true))

(intrinsic %Number% :constructor JsIntrinsicNumber :writable true :configurable true
  (method "toString" :target prototype :closure JsNumberToStringMethod :writable true :configurable true)
  (method "valueOf" :target prototype :closure JsNumberValueOf :writable true :configurable true))

(intrinsic %Boolean% :constructor JsIntrinsicBoolean :writable true :configurable true
  (method "toString" :target prototype :closure JsBooleanToStringMethod :writable true :configurable true)
  (method "valueOf" :target prototype :closure JsBooleanValueOf :writable true :configurable true))

(intrinsic %Function% :constructor JsIntrinsicFunction :writable true :configurable true
  (method "call" :target prototype :closure JsFunctionCall :writable true :configurable true)
  (method "apply" :target prototype :closure JsFunctionApply :writable true :configurable true))

(intrinsic %Error% :constructor JsIntrinsicError :writable true :configurable true
  (data "name" :target prototype :value (string "Error") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %TypeError% :constructor JsIntrinsicError :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "TypeError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %RangeError% :constructor JsIntrinsicError :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "RangeError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %SyntaxError% :constructor JsIntrinsicError :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "SyntaxError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %ReferenceError% :constructor JsIntrinsicError :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "ReferenceError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %EvalError% :constructor JsIntrinsicError :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "EvalError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %URIError% :constructor JsIntrinsicError :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "URIError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %Array% :constructor JsIntrinsicArray :writable true :configurable true
  (method "isArray" :closure JsArrayIsArray :writable true :configurable true)
  (method "push" :target prototype :closure JsArrayPush :writable true :configurable true)
  (method "pop" :target prototype :closure JsArrayPop :writable true :configurable true)
  (method "shift" :target prototype :closure JsArrayShift :writable true :configurable true)
  (method "unshift" :target prototype :closure JsArrayUnshift :writable true :configurable true)
  (method "at" :target prototype :closure JsArrayAt :writable true :configurable true)
  (method "indexOf" :target prototype :closure JsArrayIndexOf :writable true :configurable true)
  (method "includes" :target prototype :closure JsArrayIncludes :writable true :configurable true)
  (method "join" :target prototype :closure JsArrayJoin :writable true :configurable true)
  (method "toString" :target prototype :closure JsArrayToString :writable true :configurable true)
  (method "reverse" :target prototype :closure JsArrayReverse :writable true :configurable true)
  (method "slice" :target prototype :closure JsArraySlice :writable true :configurable true)
  (method "concat" :target prototype :closure JsArrayConcat :writable true :configurable true)
  (method "forEach" :target prototype :closure JsArrayForEach :writable true :configurable true)
  (method "map" :target prototype :closure JsArrayMap :writable true :configurable true)
  (method "filter" :target prototype :closure JsArrayFilter :writable true :configurable true)
  (method "some" :target prototype :closure JsArraySome :writable true :configurable true)
  (method "every" :target prototype :closure JsArrayEvery :writable true :configurable true)
  (method "find" :target prototype :closure JsArrayFind :writable true :configurable true)
  (method "findIndex" :target prototype :closure JsArrayFindIndex :writable true :configurable true)
  (method "reduce" :target prototype :closure JsArrayReduce :writable true :configurable true))

(intrinsic %Math% :namespace true :writable true :configurable true
  (data "E" :value (number "2.718281828459045"))
  (data "LN10" :value (number "2.302585092994046"))
  (data "LN2" :value (number "0.6931471805599453"))
  (data "LOG10E" :value (number "0.4342944819032518"))
  (data "LOG2E" :value (number "1.4426950408889634"))
  (data "PI" :value (number "3.141592653589793"))
  (data "SQRT1_2" :value (number "0.7071067811865476"))
  (data "SQRT2" :value (number "1.4142135623730951"))
  (method "abs" :closure JsMathAbs :writable true :configurable true)
  (method "sign" :closure JsMathSign :writable true :configurable true)
  (method "sqrt" :closure JsMathSqrt :writable true :configurable true)
  (method "sin" :closure JsMathSin :writable true :configurable true)
  (method "cos" :closure JsMathCos :writable true :configurable true)
  (method "tan" :closure JsMathTan :writable true :configurable true)
  (method "asin" :closure JsMathAsin :writable true :configurable true)
  (method "acos" :closure JsMathAcos :writable true :configurable true)
  (method "atan" :closure JsMathAtan :writable true :configurable true)
  (method "sinh" :closure JsMathSinh :writable true :configurable true)
  (method "cosh" :closure JsMathCosh :writable true :configurable true)
  (method "tanh" :closure JsMathTanh :writable true :configurable true)
  (method "asinh" :closure JsMathAsinh :writable true :configurable true)
  (method "acosh" :closure JsMathAcosh :writable true :configurable true)
  (method "atanh" :closure JsMathAtanh :writable true :configurable true)
  (method "exp" :closure JsMathExp :writable true :configurable true)
  (method "expm1" :closure JsMathExpm1 :writable true :configurable true)
  (method "log" :closure JsMathLog :writable true :configurable true)
  (method "log1p" :closure JsMathLog1p :writable true :configurable true)
  (method "log2" :closure JsMathLog2 :writable true :configurable true)
  (method "log10" :closure JsMathLog10 :writable true :configurable true)
  (method "cbrt" :closure JsMathCbrt :writable true :configurable true)
