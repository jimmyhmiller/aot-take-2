; The standard globals (docs/DECISIONS.md, intrinsics). Each is the body of a hoisted function
; `Name(a0 ...)`: it receives the receiver, its own function object (whose `prototype` property is
; the created objects' [[Prototype]]), then the arguments. A plain call in sloppy code arrives with
; the global object as receiver, a `new` with the fresh object.

(builtin JsOrdinaryCreateFromConstructor :transitioning true :params [(callee dyn)] :ret dyn
  (let [(raw (JsNewObjectRaw))]
    (JsFinishObjectLiteral (JsSetObjectLiteralPrototype raw (JsGetNamed callee (%PropertyKey "prototype"))))))

(builtin JsCalledAsFunction :params [(this dyn)] :ret bool
  (JsStrictEqualValue this (%GlobalObject)))

; Object(value): an object is itself; undefined and null make a fresh ordinary object; a primitive
; would need a wrapper object.
(builtin JsIntrinsicObject :transitioning true :params [(this dyn) (callee dyn) (value dyn)] :ret dyn
  (if (%IsObjectLike value)
      value
      (if (%IsUndefined value)
          (JsOrdinaryCreateFromConstructor callee)
          (if (%IsNull value)
              (JsOrdinaryCreateFromConstructor callee)
              (let [(trapped (%TrapToObject))]
                value)))))

; String(value) converts; `new String(value)` would be a wrapper object.
(builtin JsIntrinsicString :transitioning true :params [(this dyn) (callee dyn) (value dyn)] :ret dyn
  (if (JsCalledAsFunction this)
      (JsToString value)
      (let [(trapped (%TrapToObject))]
        value)))

(builtin JsIntrinsicNumber :params [(this dyn) (callee dyn) (value dyn)] :ret dyn
  (if (JsCalledAsFunction this)
      (%Box (JsPrimitiveNumber value))
      (let [(trapped (%TrapToObject))]
        value)))

(builtin JsIntrinsicBoolean :params [(this dyn) (callee dyn) (value dyn)] :ret dyn
  (if (JsCalledAsFunction this)
      (%BoxBool (JsTruthy value))
      (let [(trapped (%TrapToObject))]
        value)))

; Error(message) and every NativeError: called with or without `new` the result is an object on the
; constructor's prototype, with an own `message` when one was given (ECMA-262 §20.5.1.1).
(builtin JsIntrinsicError :transitioning true :params [(this dyn) (callee dyn) (message dyn)] :ret dyn
  (let [(created (if (JsCalledAsFunction this) (JsOrdinaryCreateFromConstructor callee) this))]
    (if (%IsUndefined message)
        created
        (JsDefineOwnNamed created (%PropertyKey "message") (JsToString message)))))
