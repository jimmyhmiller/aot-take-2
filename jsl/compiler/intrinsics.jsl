; The standard globals (docs/DECISIONS.md, intrinsics). Each is the body of a hoisted function
; `Name(a0 ...)`: it receives the receiver, `new.target`, its own function object (whose
; `prototype` property is the created objects' [[Prototype]]), then the arguments. A `new`
; arrives with the fresh object as receiver and the constructor as `new.target`; a call arrives
; with whatever receiver the site gave and an undefined `new.target` (docs/DECISIONS.md,
; new.target is an argument slot) — that, not the receiver, is what tells the two apart.

; OrdinaryCreateFromConstructor (§10.1.13) with GetPrototypeFromConstructor (§10.1.14): the
; constructor's `prototype` if it is an object, else `fallback`, the intrinsic default prototype.
(builtin JsOrdinaryCreateFromConstructor :transitioning true :throws true :params [(constructor dyn) (fallback dyn)] :ret dyn
  (let [(proto (JsGetNamed constructor (%PropertyKey "prototype")))]
    (if (%IsException proto)
        proto
        (JsFinishObjectLiteral
          (JsSetObjectLiteralPrototype (JsNewObjectRaw) (if (%IsObjectLike proto) proto fallback))))))

(builtin JsCalledAsFunction :params [(newtarget dyn)] :ret bool
  (%IsUndefined newtarget))

; Object(value): an object is itself; undefined and null make a fresh ordinary object; a primitive
; would need a wrapper object.
(builtin JsIntrinsicObject :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (value dyn)] :ret dyn
  (if (%IsObjectLike value)
      value
      (if (%IsUndefined value)
          (JsOrdinaryCreateFromConstructor callee (%IntrinsicPrototype "Object.prototype"))
          (if (%IsNull value)
              (JsOrdinaryCreateFromConstructor callee (%IntrinsicPrototype "Object.prototype"))
              (let [(trapped (%TrapToObject))]
                value)))))

; String(value) converts; `new String(value)` would be a wrapper object.
(builtin JsIntrinsicString :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (value dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (JsToStringValue value)
      (let [(trapped (%TrapToObject))]
        value)))

(builtin JsIntrinsicNumber :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (value dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (JsToNumberValue value)
      (let [(trapped (%TrapToObject))]
        value)))

(builtin JsIntrinsicBoolean :params [(this dyn) (newtarget dyn) (callee dyn) (value dyn)] :ret dyn
  (if (JsCalledAsFunction newtarget)
      (%BoxBool (JsTruthy value))
      (let [(trapped (%TrapToObject))]
        value)))

; Error(message) and every NativeError (ECMA-262 §20.5.1.1): OrdinaryCreateFromConstructor(NewTarget,
; or the active function when called), with an own `message` when one was given. The intrinsic
; default prototype is the constructor's own `prototype`, a non-writable, non-configurable property.
(builtin JsIntrinsicError :transitioning true :throws true :params [(this dyn) (newtarget dyn) (callee dyn) (message dyn)] :ret dyn
  (let [(fallback (JsGetNamed callee (%PropertyKey "prototype")))
        (created (if (%IsException fallback)
                     fallback
                     (JsOrdinaryCreateFromConstructor (if (JsCalledAsFunction newtarget) callee newtarget)
                                                      fallback)))]
    (if (%IsException created)
        created
        (if (%IsUndefined message)
            created
            ;; ToString(message), then a writable, configurable, non-enumerable own `message`
            ;; (CreateNonEnumerableDataPropertyOrThrow, §20.5.1.1 step 3).
            (let [(text (JsToStringValue message))]
              (if (%IsException text)
                  text
                  (if (%IsObjectLike created)
                      (let [(described (%PropDefine (%UnboxObjectLike created) (%PropertyKey "message") text 5 15))]
                        created)
                      created)))))))

; ---------------------------------------------------------------------------------------------
; The realm's global-object surface (src/jsl/decls.coil defines the form). Each declaration is one
; global binding: the function or object it names, its prototype chain, and every property
; CreateIntrinsics gives it, with the attributes ECMA-262 §18 assigns: a global binding and a
; built-in method are writable and configurable, not enumerable; a Math value property has none.
; ORDER IS PART OF THE FORMAT: it is the order the realm materializes them in.

(intrinsic %Object% :constructor JsIntrinsicObject :length 1 :writable true :configurable true
  (method "create" :closure JsObjectCreate :length 2 :writable true :configurable true)
  (method "getPrototypeOf" :closure JsObjectGetPrototypeOf :length 1 :writable true :configurable true)
  (method "keys" :closure JsObjectKeys :length 1 :writable true :configurable true)
  (method "getOwnPropertyNames" :closure JsObjectGetOwnPropertyNames :length 1 :writable true :configurable true)
  (method "defineProperty" :closure JsObjectDefineProperty :length 3 :writable true :configurable true)
  (method "defineProperties" :closure JsObjectDefineProperties :length 2 :writable true :configurable true)
  (method "getOwnPropertyDescriptor" :closure JsObjectGetOwnPropertyDescriptor :length 2 :writable true :configurable true)
  (method "preventExtensions" :closure JsObjectPreventExtensions :length 1 :writable true :configurable true)
  (method "isExtensible" :closure JsObjectIsExtensible :length 1 :writable true :configurable true)
  (method "freeze" :closure JsObjectFreeze :length 1 :writable true :configurable true)
  (method "seal" :closure JsObjectSeal :length 1 :writable true :configurable true)
  (method "isFrozen" :closure JsObjectIsFrozen :length 1 :writable true :configurable true)
  (method "isSealed" :closure JsObjectIsSealed :length 1 :writable true :configurable true)
  (method "hasOwnProperty" :target prototype :closure JsObjectHasOwnProperty :length 1 :writable true :configurable true)
  (method "toString" :target prototype :closure JsObjectToStringMethod :length 0 :writable true :configurable true)
  (method "valueOf" :target prototype :closure JsObjectValueOf :length 0 :writable true :configurable true)
  (method "isPrototypeOf" :target prototype :closure JsObjectIsPrototypeOf :length 1 :writable true :configurable true)
  (method "propertyIsEnumerable" :target prototype :closure JsObjectPropertyIsEnumerable :length 1 :writable true :configurable true))

(intrinsic %String% :constructor JsIntrinsicString :length 1 :writable true :configurable true
  (method "fromCharCode" :closure JsStringFromCharCode :length 1 :writable true :configurable true)
  (method "charAt" :target prototype :closure JsStringCharAt :length 1 :writable true :configurable true)
  (method "charCodeAt" :target prototype :closure JsStringCharCodeAt :length 1 :writable true :configurable true)
  (method "at" :target prototype :closure JsStringAt :length 1 :writable true :configurable true)
  (method "indexOf" :target prototype :closure JsStringIndexOf :length 1 :writable true :configurable true)
  (method "lastIndexOf" :target prototype :closure JsStringLastIndexOf :length 1 :writable true :configurable true)
  (method "includes" :target prototype :closure JsStringIncludes :length 1 :writable true :configurable true)
  (method "startsWith" :target prototype :closure JsStringStartsWith :length 1 :writable true :configurable true)
  (method "endsWith" :target prototype :closure JsStringEndsWith :length 1 :writable true :configurable true)
  (method "slice" :target prototype :closure JsStringSlice :length 2 :writable true :configurable true)
  (method "substring" :target prototype :closure JsStringSubstring :length 2 :writable true :configurable true)
  (method "concat" :target prototype :closure JsStringConcat :length 1 :writable true :configurable true)
  (method "trim" :target prototype :closure JsStringTrim :length 0 :writable true :configurable true)
  (method "trimStart" :target prototype :closure JsStringTrimStart :length 0 :writable true :configurable true)
  (method "trimEnd" :target prototype :closure JsStringTrimEnd :length 0 :writable true :configurable true)
  (method "repeat" :target prototype :closure JsStringRepeat :length 1 :writable true :configurable true)
  (method "toString" :target prototype :closure JsStringToStringMethod :length 0 :writable true :configurable true)
  (method "valueOf" :target prototype :closure JsStringValueOf :length 0 :writable true :configurable true)
  (method "split" :target prototype :closure JsStringSplit :length 2 :writable true :configurable true)
  (method "padStart" :target prototype :closure JsStringPadStart :length 1 :writable true :configurable true)
  (method "padEnd" :target prototype :closure JsStringPadEnd :length 1 :writable true :configurable true))

(intrinsic %Number% :constructor JsIntrinsicNumber :length 1 :writable true :configurable true
  (method "toString" :target prototype :closure JsNumberToStringMethod :length 1 :writable true :configurable true)
  (method "valueOf" :target prototype :closure JsNumberValueOf :length 0 :writable true :configurable true))

(intrinsic %Boolean% :constructor JsIntrinsicBoolean :length 1 :writable true :configurable true
  (method "toString" :target prototype :closure JsBooleanToStringMethod :length 0 :writable true :configurable true)
  (method "valueOf" :target prototype :closure JsBooleanValueOf :length 0 :writable true :configurable true))

(intrinsic %Function% :constructor JsIntrinsicFunction :length 1 :writable true :configurable true
  (method "call" :target prototype :closure JsFunctionCall :length 1 :writable true :configurable true)
  (method "apply" :target prototype :closure JsFunctionApply :length 2 :writable true :configurable true)
  (method "bind" :target prototype :closure JsFunctionBind :length 1 :writable true :configurable true))

(intrinsic %Error% :constructor JsIntrinsicError :length 1 :writable true :configurable true
  (data "name" :target prototype :value (string "Error") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %TypeError% :constructor JsIntrinsicError :length 1 :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "TypeError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %RangeError% :constructor JsIntrinsicError :length 1 :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "RangeError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %SyntaxError% :constructor JsIntrinsicError :length 1 :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "SyntaxError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %ReferenceError% :constructor JsIntrinsicError :length 1 :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "ReferenceError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %EvalError% :constructor JsIntrinsicError :length 1 :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "EvalError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %URIError% :constructor JsIntrinsicError :length 1 :parent %Error% :writable true :configurable true
  (data "name" :target prototype :value (string "URIError") :writable true :configurable true)
  (data "message" :target prototype :value (string "") :writable true :configurable true))

(intrinsic %Array% :constructor JsIntrinsicArray :length 1 :writable true :configurable true
  (method "isArray" :closure JsArrayIsArray :length 1 :writable true :configurable true)
  (method "push" :target prototype :closure JsArrayPush :length 1 :writable true :configurable true)
  (method "pop" :target prototype :closure JsArrayPop :length 0 :writable true :configurable true)
  (method "shift" :target prototype :closure JsArrayShift :length 0 :writable true :configurable true)
  (method "unshift" :target prototype :closure JsArrayUnshift :length 1 :writable true :configurable true)
  (method "at" :target prototype :closure JsArrayAt :length 1 :writable true :configurable true)
  (method "indexOf" :target prototype :closure JsArrayIndexOf :length 1 :writable true :configurable true)
  (method "includes" :target prototype :closure JsArrayIncludes :length 1 :writable true :configurable true)
  (method "join" :target prototype :closure JsArrayJoin :length 1 :writable true :configurable true)
  (method "toString" :target prototype :closure JsArrayToString :length 0 :writable true :configurable true)
  (method "reverse" :target prototype :closure JsArrayReverse :length 0 :writable true :configurable true)
  (method "slice" :target prototype :closure JsArraySlice :length 2 :writable true :configurable true)
  (method "concat" :target prototype :closure JsArrayConcat :length 1 :writable true :configurable true)
  (method "forEach" :target prototype :closure JsArrayForEach :length 1 :writable true :configurable true)
  (method "map" :target prototype :closure JsArrayMap :length 1 :writable true :configurable true)
  (method "filter" :target prototype :closure JsArrayFilter :length 1 :writable true :configurable true)
  (method "some" :target prototype :closure JsArraySome :length 1 :writable true :configurable true)
  (method "every" :target prototype :closure JsArrayEvery :length 1 :writable true :configurable true)
  (method "find" :target prototype :closure JsArrayFind :length 1 :writable true :configurable true)
  (method "findIndex" :target prototype :closure JsArrayFindIndex :length 1 :writable true :configurable true)
  (method "reduce" :target prototype :closure JsArrayReduce :length 1 :writable true :configurable true))

(intrinsic %Math% :namespace true :writable true :configurable true
  (data "E" :value (number "2.718281828459045"))
  (data "LN10" :value (number "2.302585092994046"))
  (data "LN2" :value (number "0.6931471805599453"))
  (data "LOG10E" :value (number "0.4342944819032518"))
  (data "LOG2E" :value (number "1.4426950408889634"))
  (data "PI" :value (number "3.141592653589793"))
  (data "SQRT1_2" :value (number "0.7071067811865476"))
  (data "SQRT2" :value (number "1.4142135623730951"))
  (method "abs" :closure JsMathAbs :length 1 :writable true :configurable true)
  (method "sign" :closure JsMathSign :length 1 :writable true :configurable true)
  (method "sqrt" :closure JsMathSqrt :length 1 :writable true :configurable true)
  (method "sin" :closure JsMathSin :length 1 :writable true :configurable true)
  (method "cos" :closure JsMathCos :length 1 :writable true :configurable true)
  (method "tan" :closure JsMathTan :length 1 :writable true :configurable true)
  (method "asin" :closure JsMathAsin :length 1 :writable true :configurable true)
  (method "acos" :closure JsMathAcos :length 1 :writable true :configurable true)
  (method "atan" :closure JsMathAtan :length 1 :writable true :configurable true)
  (method "sinh" :closure JsMathSinh :length 1 :writable true :configurable true)
  (method "cosh" :closure JsMathCosh :length 1 :writable true :configurable true)
  (method "tanh" :closure JsMathTanh :length 1 :writable true :configurable true)
  (method "asinh" :closure JsMathAsinh :length 1 :writable true :configurable true)
  (method "acosh" :closure JsMathAcosh :length 1 :writable true :configurable true)
  (method "atanh" :closure JsMathAtanh :length 1 :writable true :configurable true)
  (method "exp" :closure JsMathExp :length 1 :writable true :configurable true)
  (method "expm1" :closure JsMathExpm1 :length 1 :writable true :configurable true)
  (method "log" :closure JsMathLog :length 1 :writable true :configurable true)
  (method "log1p" :closure JsMathLog1p :length 1 :writable true :configurable true)
  (method "log2" :closure JsMathLog2 :length 1 :writable true :configurable true)
  (method "log10" :closure JsMathLog10 :length 1 :writable true :configurable true)
  (method "cbrt" :closure JsMathCbrt :length 1 :writable true :configurable true)
