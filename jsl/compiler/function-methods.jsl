; Function objects (docs/DECISIONS.md, function objects; ECMA-262 §20.2). Every function object's
; [[Prototype]] is %Function.prototype% once the realm materializes `Function`; the methods here
; receive the function as `this`. `bind` waits for closures (docs/GAPS.md, function objects).

; The Function constructor compiles source text at run time; this compiler is ahead-of-time and
; refuses it by name (docs/DESIGN.md, strictly AOT).
(builtin JsIntrinsicFunction :params [(this dyn) (newtarget dyn) (callee dyn) (source dyn)] :ret dyn
  (let [(trapped (%TrapDynamicCode))]
    (%Undefined)))

; Function.prototype.call(thisArg, ...args) (§20.2.3.3), up to three arguments in the ABI slots.
(builtin JsFunctionCall :transitioning true :throws true
  :params [(this dyn) (this-arg dyn) (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (if (%IsFunction this)
      (%CallFunction this this-arg a0 a1 a2)
      (JsThrowTypeError (%Box "Function.prototype.call called on a non-function"))))

; Function.prototype.apply(thisArg, argArray) (§20.2.3.1): the array's first four elements become
; the arguments (CreateListFromArrayLike over an array; other array-likes are not represented).
(builtin JsFunctionApply :transitioning true :throws true
  :params [(this dyn) (this-arg dyn) (args dyn)] :ret dyn
  (if (%IsFunction this)
      (if (%IsUndefined args)
          (%CallFunction this this-arg)
          (if (%IsNull args)
              (%CallFunction this this-arg)
              (if (%IsArray args)
                  (let [(raw (%UnboxArray args))]
                    (%CallFunction this this-arg
                                   (JsArrayElementOrUndefined raw 0)
                                   (JsArrayElementOrUndefined raw 1)
                                   (JsArrayElementOrUndefined raw 2)
                                   (JsArrayElementOrUndefined raw 3)))
                  (JsThrowTypeError (%Box "CreateListFromArrayLike called on non-object")))))
      (JsThrowTypeError (%Box "Function.prototype.apply called on a non-function"))))

; An array element, or undefined past the length or at a hole.
(macro JsArrayElementOrUndefined :params [(raw arr) (i int)] :ret dyn
  (if (%Lt i (%ArrayLen raw))
      (if (%ArrayHasIndex raw i) (%ArrayLoad raw i) (%Undefined))
      (%Undefined)))
