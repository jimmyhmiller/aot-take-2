; The Reflect namespace object (ECMA-262 §28.1). Every method takes its target as a value and
; refuses a non-Object with a TypeError: Reflect never performs ToObject, which is the whole
; difference between `Reflect.getPrototypeOf(1)` (a TypeError) and `Object.getPrototypeOf(1)`
; (%Number.prototype%). The internal methods themselves already exist for the Object statics and
; for the frontend's own property access; this unit is the specified argument handling in front of
; them, not a second object model.
;
; Two methods are absent rather than approximated, and jsl/compiler/intrinsics.jsl does not declare
; them (docs/GAPS.md, Reflect):
;
;   - `ownKeys` would have to answer own SYMBOL keys beside own string keys. `%ObjectOwnNames`
;     answers strings and `rt-shape-keys!` filters symbol keys out deliberately; recovering the
;     symbol VALUE from its interned shape key needs a key-to-symbol registry the runtime does not
;     keep. Answering the string keys alone would silently drop properties.
;   - `setPrototypeOf` would mutate an existing object's [[Prototype]]. `%SetObjectPrototype` writes
;     the representation slot of a freshly allocated literal, where the compiler still owns the
;     shape; re-pointing a chain the image analysis has already proven over is the same gap that
;     keeps `Object.setPrototypeOf` absent.

; Each method guards its target with `%IsObjectLike` at the call it protects, rather than through a
; shared helper: the JSL checker narrows `dyn` to `dyn-object-like` on that test, and the internal
; operations below take the narrowed type. A helper returning `dyn` would erase it.

; CreateListFromArrayLike(obj) (§7.3.18) with the default element types: an Array is already the
; argument-list representation `JsCallWithArray` and `JsBoundConstruct` consume; any other Object is
; read as an array-like, through its `length` and its index properties, so an `arguments` object or
; a plain `{length: 2, 0: …, 1: …}` is a list as the specification says. A non-Object is a TypeError.
(builtin JsCreateListFromArrayLike :transitioning true :throws true :params [(items dyn)] :ret dyn
  (if (%IsArray items)
      items
      (if (%IsObjectLike items)
          (let [(raw-length (JsGetNamed items (%PropertyKey "length")))]
            (if (%IsException raw-length)
                raw-length
                (JsArrayLikeElements items 0 (JsToLength raw-length) (JsNewArray 0))))
          (JsThrowTypeError (%Box "CreateListFromArrayLike called on non-object")))))

; The elements of an array-like from `k` to `len`, appended to `out` in order. Every read is a
; JavaScript [[Get]], so a getter on the array-like runs exactly once per index, in order.
(builtin JsArrayLikeElements :transitioning true :throws true
  :params [(items dyn) (k int) (len int) (out dyn)] :ret dyn
  (if (%Lt k len)
      (let [(element (JsGetKeyed items (%BoxInt k)))]
        (if (%IsException element)
            element
            (let [(stored (%ArrayStore (%UnboxArray out) k element))]
              (JsArrayLikeElements items (%Add k 1) len out))))
      out))

; Reflect.apply(target, thisArgument, argumentsList) (§28.1.1). IsCallable precedes the list, and
; the list is built before the call, so a getter on the array-like cannot observe the call.
(builtin JsReflectApply :transitioning true :throws true
  :params [(this dyn) (target dyn) (this-argument dyn) (arguments-list dyn)] :ret dyn
  (if (%IsFunction target)
      (let [(args (JsCreateListFromArrayLike arguments-list))]
        (if (%IsException args)
            args
            (JsCallWithArray target this-argument (%Undefined) args)))
      (JsThrowTypeError (%Box "Reflect.apply called on a non-function"))))

; Reflect.construct(target, argumentsList [, newTarget]) (§28.1.2). An ABSENT third argument makes
; newTarget the target (step 2); an explicitly passed `undefined` is a value that is not a
; constructor and is the TypeError of step 3, which is why this body takes the argument count
; rather than testing the parameter for undefined.
(builtin JsReflectConstruct :transitioning true :throws true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (if (JsIsConstructor a0)
      (let [(target-newtarget (if (%Lt (%ArgumentCountInt count) 3) a0 a2))]
        (if (JsIsConstructor target-newtarget)
            (let [(args (JsCreateListFromArrayLike a1))]
              (if (%IsException args)
                  args
                  (JsBoundConstruct a0 target-newtarget args)))
            (JsThrowTypeError (%Box "Reflect.construct was given a newTarget that is not a constructor"))))
      (JsThrowTypeError (%Box "Reflect.construct called on a non-constructor"))))

; Reflect.defineProperty(target, propertyKey, attributes) (§28.1.3): the boolean result of
; [[DefineOwnProperty]], where `Object.defineProperty` answers the object or throws.
;
; DIVERGENCE, recorded in docs/GAPS.md: `JsDefineFromDescriptor` reports an invalid descriptor and a
; REFUSED definition through the one exception sentinel, so a refusal (defining on a non-extensible
; object, redefining a non-configurable property) throws that TypeError here instead of answering
; false. An accepted definition answers true, and an invalid descriptor throws, both as specified.
(builtin JsReflectDefineProperty :transitioning true :throws true
  :params [(this dyn) (target dyn) (property-key dyn) (attributes dyn)] :ret dyn
  (if (%IsObjectLike target)
      (let [(defined (JsDefineFromDescriptor target (JsToPropertyKey property-key) attributes))]
        (if (%IsException defined) defined (JsTrue)))
      (JsThrowTypeError (%Box "Reflect.defineProperty called on non-object"))))

; Reflect.deleteProperty(target, propertyKey) (§28.1.4): [[Delete]] as a boolean. Non-strict
; deletion is the status-returning form, so a non-configurable property answers false rather than
; throwing, which is exactly this method's contract.
(builtin JsReflectDeleteProperty :transitioning true :throws true
  :params [(this dyn) (target dyn) (property-key dyn)] :ret dyn
  (if (%IsObjectLike target)
      (JsDeleteKeyed target property-key 0)
      (JsThrowTypeError (%Box "Reflect.deleteProperty called on non-object"))))

; Reflect.get(target, propertyKey [, receiver]) (§28.1.5): OrdinaryGet with an explicit Receiver,
; which is what `JsGetFromHolder` already threads — a getter found anywhere on the chain is called
; with the Receiver, not with the holder. An absent third argument makes the Receiver the target.
(builtin JsReflectGet :transitioning true :throws true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (if (%IsObjectLike a0)
      (JsGetFromHolder a0
                       (JsToPropertyKey a1)
                       (if (%Lt (%ArgumentCountInt count) 3) a0 a2))
      (JsThrowTypeError (%Box "Reflect.get called on non-object"))))

; Reflect.set(target, propertyKey, V [, receiver]) (§28.1.6): [[Set]] as a boolean.
;
; With the Receiver the target — every call of the three-argument form — this is the ordinary
; guarded store, and the non-strict form's refusal is the specified false. A Receiver that is a
; DIFFERENT object is §10.1.9.2's OrdinarySetWithOwnDescriptor, which creates the property on the
; Receiver rather than the target; `%PropStoreNamed` writes through the base it is given and has no
; Receiver operand, so that form is a TypeError naming the gap instead of storing to the wrong
; object (docs/GAPS.md, Reflect).
(builtin JsReflectSet :transitioning true :throws true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (if (%IsObjectLike a0)
      (if (%Lt (%ArgumentCountInt count) 4)
          (JsReflectStore a0 a1 a2)
          (let [(receiver (%ArgumentAt overflow 3))]
            (if (JsStrictEqualValue receiver a0)
                (JsReflectStore a0 a1 a2)
                (JsThrowTypeError
                 (%Box "Reflect.set with a receiver other than the target is not implemented")))))
      (JsThrowTypeError (%Box "Reflect.set called on non-object"))))

; [[Set]] whose Receiver is the target, as a boolean: the non-strict store refuses by answering,
; never by throwing, so the completion is the specified false.
(builtin JsReflectStore :transitioning true :throws true
  :params [(object dyn) (property-key dyn) (value dyn)] :ret dyn
  (let [(stored (JsSetKeyed object property-key value 0))]
    (if (%IsException stored) stored (JsTrue))))

; Reflect.getOwnPropertyDescriptor(target, propertyKey) (§28.1.7): the same descriptor object
; Object.getOwnPropertyDescriptor answers, over a target that must already be an Object.
(builtin JsReflectGetOwnPropertyDescriptor :transitioning true :throws true
  :params [(this dyn) (target dyn) (property-key dyn)] :ret dyn
  (if (%IsObjectLike target)
      (JsObjectGetOwnPropertyDescriptor (%Undefined) target property-key)
      (JsThrowTypeError (%Box "Reflect.getOwnPropertyDescriptor called on non-object"))))

; Reflect.getPrototypeOf(target) (§28.1.8): [[GetPrototypeOf]] with no ToObject.
(builtin JsReflectGetPrototypeOf :transitioning true :throws true
  :params [(this dyn) (target dyn)] :ret dyn
  (if (%IsObjectLike target)
      (%GetObjectPrototype (%UnboxObjectLike target))
      (JsThrowTypeError (%Box "Reflect.getPrototypeOf called on non-object"))))

; Reflect.has(target, propertyKey) (§28.1.9): [[HasProperty]], the chain included, without invoking
; an accessor.
(builtin JsReflectHas :transitioning true :throws true
  :params [(this dyn) (target dyn) (property-key dyn)] :ret dyn
  (if (%IsObjectLike target)
      (JsHasNamedProperty target (JsToPropertyKey property-key))
      (JsThrowTypeError (%Box "Reflect.has called on non-object"))))

; Reflect.isExtensible(target) (§28.1.10): [[IsExtensible]]. `Object.isExtensible` answers false for
; a primitive; this one refuses it.
(builtin JsReflectIsExtensible :transitioning true :throws true
  :params [(this dyn) (target dyn)] :ret dyn
  (if (%IsObjectLike target)
      (%BoxBool (%Eq (%IsExtensible (%UnboxObjectLike target)) 1))
      (JsThrowTypeError (%Box "Reflect.isExtensible called on non-object"))))

; Reflect.preventExtensions(target) (§28.1.12): [[PreventExtensions]] as a boolean. An ordinary
; object's always succeeds (§10.1.4.1).
(builtin JsReflectPreventExtensions :transitioning true :throws true
  :params [(this dyn) (target dyn)] :ret dyn
  (if (%IsObjectLike target)
      (let [(done (%PreventExtensions (%UnboxObjectLike target)))] (JsTrue))
      (JsThrowTypeError (%Box "Reflect.preventExtensions called on non-object"))))
