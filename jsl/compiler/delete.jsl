; The delete operator (ECMA-262 §13.5.1.2) and [[Delete]] over the represented kinds of object
; (docs/DECISIONS.md, delete). An ordinary property is removed from the shape tree by the runtime
; (`%PropDelete`, a hole row that keeps every other field's offset); an array element becomes a
; hole (`%ArrayDeleteIndex`). The parser lowers each form of the operand to one entry here.

; `delete base.name`, and `delete base[key]` once the key is a property key: ToObject(base) — undefined
; and null are a TypeError — then [[Delete]]; a refusal throws in strict code and is false otherwise
; (step 5.e). A primitive's wrapper object is never made: a String wrapper's own properties are its
; `length` and its in-range indices, all non-configurable (§10.4.3); a Number, Boolean or Symbol
; wrapper has no own property, so deleting from one succeeds.
(builtin JsDeleteNamed :transitioning true :throws true :params [(object dyn) (key int) (strict int)] :ret dyn
  (if (%IsObjectLike object)
      (JsDeleteStatus (JsObjectDeleteOwn object key) strict)
      (if (%IsString object)
          (if (%Eq key (%PropertyKey "length"))
              (JsDeleteStatus 1 strict)
              (let [(index (%KeyArrayIndex key))]
                (if (%Lt index 0)
                    (JsTrue)
                    (if (%Lt index (%StringLength (%UnboxString object)))
                        (JsDeleteStatus 1 strict)
                        (JsTrue)))))
          (if (%IsUndefined object)
              (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
              (if (%IsNull object)
                  (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
                  (JsTrue))))))

; `delete base[key]`: ToObject(base) precedes ToPropertyKey(key) (§13.5.1.2 steps 5.b-5.c). An array
; index on an array names an element without interning a key.
(builtin JsDeleteKeyed :transitioning true :throws true :params [(object dyn) (key dyn) (strict int)] :ret dyn
  (if (%IsUndefined object)
      (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
      (if (%IsNull object)
          (JsThrowTypeError (%Box "Cannot convert undefined or null to object"))
          (if (%IsArray object)
              (let [(index (JsArrayIndexOfKey key))]
                (if (%Lt index 0)
                    (JsDeleteNamed object (JsToPropertyKey key) strict)
                    (let [(holed (%ArrayDeleteIndex (%UnboxArray object) index))]
                      (JsTrue))))
              (JsDeleteNamed object (JsToPropertyKey key) strict)))))

; [[Delete]] of an own property, as a status: 0 the object no longer has it, 1 refused. An Array's
; `length` is non-configurable and its elements are configurable (§10.4.2); every other key, and
; every key of an ordinary object or a function, is OrdinaryDelete over the shape tree (§10.1.10.1).
(macro JsObjectDeleteOwn :transitioning true :params [(object dyn-object-like) (key int)] :ret int
  (if (%IsArray object)
      (if (%Eq key (%PropertyKey "length"))
          1
          (let [(index (%KeyArrayIndex key))]
            (if (%Lt index 0)
                (%PropDelete (%UnboxObjectLike object) key)
                (%ArrayDeleteIndex (%UnboxArray object) index))))
      (%PropDelete (%UnboxObjectLike object) key)))

; The operator's value from a [[Delete]] status: true, or a refusal — a TypeError in strict code,
; false otherwise.
(macro JsDeleteStatus :transitioning true :throws true :params [(status int) (strict int)] :ret dyn
  (if (%Eq status 0)
      (JsTrue)
      (if (%Eq strict 1)
          (JsThrowTypeError (%Box "Cannot delete property"))
          (JsFalse))))

; `delete name` in sloppy code (strict code rejects it early) against a Reference resolved before
; the operator (`JsGlobalResolveReference`): a global declarative binding cannot be deleted
; (§9.1.1.1.7); an object-record binding is [[Delete]] on the global object (§9.1.1.2.7), which
; refuses a declared var or function because those are non-configurable; an unresolvable name is
; true (§13.5.1.2 step 3).
(macro JsGlobalReferenceDelete :transitioning true :throws true
  :params [(global dyn) (key int) (resolved int)] :ret dyn
  (if (%Lt 0 resolved)
      (JsFalse)
      (if (%Eq resolved -1)
          (JsDeleteNamed global key 0)
          (JsTrue))))
