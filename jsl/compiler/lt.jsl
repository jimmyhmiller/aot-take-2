; Abstract Relational Comparison for the currently admitted numeric operands. Both inputs cross the
; same guarded ToNumber boundary as arithmetic; IEEE `<` supplies the required false result when
; either converted value is NaN, and the JavaScript result is a boxed Boolean.
(builtin JsLt :params [(a dyn) (b dyn)] :ret dyn
  (let [(left (JsPrimitiveNumber a))
        (right (JsPrimitiveNumber b))]
    (%BoxBool (%Lt left right))))
