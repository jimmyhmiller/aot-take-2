; A guarded fast-path definition: integers increment through raw arithmetic, while every other
; dynamic value is returned unchanged. Unknown callers retain both paths; proven integer callers
; erase the test, Cast, fallback, and Box/Unbox boundary.
(builtin JsIncrementIntOrIdentity :params [(value dyn)] :ret dyn
  (if (%IsInt value)
      (%Box (%Add (%UnboxInt value) 1))
      value))
