; The iteration protocol (ECMA-262 §7.4; docs/DECISIONS.md, iteration). `for-of`, spread and array
; destructuring are all this: an iterator is whatever @@iterator answers, `next` is called on it, and
; the result object's `done` and `value` are read with ordinary property access — no built-in
; iterator is privileged, and a user object with the two methods drives every one of those forms.
;
; The iterator itself travels as a value, and the frontend keeps the pair (iterator, nextMethod) in
; the loop's own bindings, so nothing here holds state.

; GetIterator(obj, sync) (§7.4.2): @@iterator must exist and be callable, its result must be an
; object, and `next` is read once, as the specification does, so a later assignment to it is not seen.
(builtin JsGetIterator :transitioning true :throws true :params [(value dyn)] :ret dyn
  (let [(method (JsGetMethodValue value (%WellKnownKey "Symbol.iterator")))]
    (if (%IsException method)
        method
        (if (%IsFunction method)
            (let [(iterator (%CallFunction method value))]
              (if (%IsException iterator)
                  iterator
                  (if (%IsObjectLike iterator)
                      iterator
                      (JsThrowTypeError (%Box "The result of the Symbol.iterator method is not an object")))))
            (JsThrowTypeError (%Box "value is not iterable"))))))

; GetMethod (§7.3.11): undefined and null answer undefined; anything else that is not callable is a
; TypeError at the call site.
(builtin JsGetMethodValue :transitioning true :throws true :params [(value dyn) (key int)] :ret dyn
  (if (%IsUndefined value)
      (JsThrowTypeError (%Box "undefined is not iterable"))
      (if (%IsNull value)
          (JsThrowTypeError (%Box "null is not iterable"))
          (JsGetNamed value key))))

; The `next` method of an iterator, read once when the iteration begins (§7.4.2 step 5).
(builtin JsIteratorNextMethod :transitioning true :throws true :params [(iterator dyn)] :ret dyn
  (JsGetNamed iterator (%PropertyKey "next")))

; IteratorNext (§7.4.4): the result must be an object, which is what makes `done` and `value`
; ordinary property reads.
(builtin JsIteratorStep :transitioning true :throws true :params [(iterator dyn) (next dyn)] :ret dyn
  (if (%IsFunction next)
      (let [(result (%CallFunction next iterator))]
        (if (%IsException result)
            result
            (if (%IsObjectLike result)
                result
                (JsThrowTypeError (%Box "Iterator result is not an object")))))
      (JsThrowTypeError (%Box "Iterator next is not a function"))))

(builtin JsIteratorDone :transitioning true :throws true :params [(result dyn)] :ret dyn
  (let [(done (JsGetNamed result (%PropertyKey "done")))]
    (if (%IsException done) done (%BoxBool (JsTruthy done)))))

(builtin JsIteratorValue :transitioning true :throws true :params [(result dyn)] :ret dyn
  (JsGetNamed result (%PropertyKey "value")))

; IteratorClose (§7.4.9) for a loop that leaves early — a `break`, a `return`, a `throw`. The
; iterator's own `return`, when it has one, is called and its result is ignored unless it throws;
; an absent one closes nothing. A completion already in flight is not replaced by a TypeError from
; a `return` that answers a non-object, which is why this answers undefined either way.
(builtin JsIteratorClose :transitioning true :throws true :params [(iterator dyn)] :ret dyn
  (let [(method (JsGetNamed iterator (%PropertyKey "return")))]
    (if (%IsException method)
        method
        (if (%IsFunction method)
            (let [(result (%CallFunction method iterator))]
              (if (%IsException result) result (%Undefined)))
            (%Undefined)))))

; %ArrayIteratorPrototype%.next (§23.1.5.1) and the iterator `Array.prototype[@@iterator]` makes.
;
; The iterator's state — the array it walks and the next index — lives in two properties under keys
; minted by the compiler for this purpose (`%InternalKey`). A key like that has no Symbol value and
; no name, so nothing a program can write reaches it, enumeration passes over it, and it is what an
; internal slot is here. The brand check is the presence of the first of them, as
; RequireInternalSlot is.
; `kind` is what the iterator yields: 0 the value, 1 the index, 2 the `[index, value]` pair —
; CreateArrayIterator's iteration kind (§23.1.5.1), kept in a third internal slot.
(builtin JsCreateArrayIterator :transitioning true :throws true :params [(array dyn) (kind int)] :ret dyn
  (let [(raw (JsSetObjectLiteralPrototype (JsNewObjectRaw)
                                          (%IntrinsicPrototype "ArrayIterator.prototype")))]
    (let [(with-target (JsCreateDataPropertyAttrs raw (%InternalKey "%ArrayIteratorTarget%") array 1))]
      (let [(with-index (JsCreateDataPropertyAttrs with-target
                                                   (%InternalKey "%ArrayIteratorIndex%")
                                                   (%BoxInt 0)
                                                   1))]
        (let [(with-kind (JsCreateDataPropertyAttrs with-index
                                                    (%InternalKey "%ArrayIteratorKind%")
                                                    (%BoxInt kind)
                                                    1))]
          (JsFinishObjectLiteral with-kind))))))

(builtin JsArrayIteratorNext :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (JsIsArrayIterator this)
      (let [(target (JsGetNamed this (%InternalKey "%ArrayIteratorTarget%")))]
        (if (%IsException target)
            target
            (if (%IsUndefined target)
                (JsIteratorResult (%Undefined) (%Eq 0 0))
                (JsArrayIteratorStep this target))))
      (JsThrowTypeError (%Box "next called on a value that is not an Array Iterator"))))

(macro JsIsArrayIterator :params [(value dyn)] :ret bool
  (if (%IsObjectLike value)
      (%PropHasOwnNamed (%UnboxObjectLike value) (%InternalKey "%ArrayIteratorTarget%"))
      (%Eq 0 1)))

; One step over an array-like: past its length the iterator is exhausted, and it drops the array so
; that a later `next` answers done without reading it again (§23.1.5.1 step 10.a).
(builtin JsArrayIteratorStep :transitioning true :throws true :params [(iterator dyn) (target dyn)] :ret dyn
  (if (%IsArray target) (JsArrayIteratorStepOn iterator target) (let [(trapped (%TrapInvariant))] target)))

;; The array is the one this iterator was created over, so its family is an invariant, not a check.
(builtin JsArrayIteratorStepOn :transitioning true :throws true :params [(iterator dyn) (target dyn)] :ret dyn
  (let [(index (JsGetNamed iterator (%InternalKey "%ArrayIteratorIndex%")))]
    (if (%IsException index)
        index
        ;; The index is this iterator's own slot and nothing else writes it, so a value that is not
        ;; an integer is a failed invariant rather than a completion.
        (let [(i (if (%IsInt index) (%UnboxInt index) (let [(trapped (%TrapInvariant))] 0)))]
          (if (%Lt i (%ArrayLen (%UnboxArray target)))
              (let [(advanced (JsDefineOwnNamed iterator
                                                (%InternalKey "%ArrayIteratorIndex%")
                                                (%BoxInt (%Add i 1))
                                                1))]
                (if (%IsException advanced)
                    advanced
                    (let [(yielded (JsArrayIteratorYield iterator target i))]
                      (if (%IsException yielded)
                          yielded
                          (JsIteratorResult yielded (%Eq 0 1))))))
              (let [(dropped (JsDefineOwnNamed iterator
                                               (%InternalKey "%ArrayIteratorTarget%")
                                               (%Undefined)
                                               1))]
                (if (%IsException dropped)
                    dropped
                    (JsIteratorResult (%Undefined) (%Eq 0 0)))))))))

; CreateIterResultObject (§7.4.1): an ordinary object with `value` and `done`, in that order.
(builtin JsIteratorResult :transitioning true :throws true :params [(value dyn) (done bool)] :ret dyn
  (let [(raw (JsSetObjectLiteralPrototype (JsNewObjectRaw) (%IntrinsicPrototype "Object.prototype")))]
    (let [(with-value (JsCreateDataPropertyAttrs raw (%PropertyKey "value") value 7))]
      (let [(with-done (JsCreateDataPropertyAttrs with-value
                                                  (%PropertyKey "done")
                                                  (%BoxBool done)
                                                  7))]
        (JsFinishObjectLiteral with-done)))))

; What one step yields, by the iterator's kind: the element, its index, or the pair of them.
(builtin JsArrayIteratorYield :transitioning true :throws true
  :params [(iterator dyn) (target dyn) (i int)] :ret dyn
  (let [(kind (JsGetNamed iterator (%InternalKey "%ArrayIteratorKind%")))]
    (if (%IsException kind)
        kind
        ;; The kind is this iterator's own slot, written when it was created and never again.
        (let [(k (if (%IsInt kind) (%UnboxInt kind) (let [(trapped (%TrapInvariant))] 0)))]
          (if (%Eq k 1)
              (%BoxInt i)
              (if (%Eq k 2)
                  (let [(pair (JsNewArray 0))]
                    (let [(with-index (%ArrayStore (%UnboxArray pair) 0 (%BoxInt i)))]
                      (let [(with-value (%ArrayStore (%UnboxArray pair)
                                                     1
                                                     (%ArrayLoad (%UnboxArray target) i)))]
                        pair)))
                  (%ArrayLoad (%UnboxArray target) i)))))))

; Array.prototype[@@iterator] and `values` (§23.1.3.34), `keys` (§23.1.3.18) and `entries`
; (§23.1.3.7): the same iterator over the same array, differing only in what a step yields.
(builtin JsArrayValues :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsArray this)
      (JsCreateArrayIterator this 0)
      (JsThrowTypeError (%Box "Array.prototype method called on a non-array"))))

; %IteratorPrototype%[@@iterator] (§27.1.2.1): an iterator is its own iterable, which is what lets
; `for (const k of a.keys())` and `[...a.entries()]` walk one.
(builtin JsIteratorSelf :params [(this dyn)] :ret dyn
  this)

(builtin JsArrayKeys :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsArray this)
      (JsCreateArrayIterator this 1)
      (JsThrowTypeError (%Box "Array.prototype method called on a non-array"))))

(builtin JsArrayEntries :transitioning true :throws true :params [(this dyn)] :ret dyn
  (if (%IsArray this)
      (JsCreateArrayIterator this 2)
      (JsThrowTypeError (%Box "Array.prototype method called on a non-array"))))

; Spread (§13.2.4.2 for an array literal, §13.3.8.1 for an argument list) is the same protocol: the
; iterable is walked to exhaustion and each value appended. The array under construction carries the
; position, so an element after a spread lands where the spread left off.
(builtin JsArraySpreadInto :transitioning true :throws true :params [(array dyn) (iterable dyn)] :ret dyn
  (let [(iterator (JsGetIterator iterable))]
    (if (%IsException iterator)
        iterator
        (let [(next (JsIteratorNextMethod iterator))]
          (if (%IsException next)
              next
              (JsArraySpreadStep array iterator next))))))

(builtin JsArraySpreadStep :transitioning true :throws true
  :params [(array dyn) (iterator dyn) (next dyn)] :ret dyn
  (let [(result (JsIteratorStep iterator next))]
    (if (%IsException result)
        result
        (let [(done (JsIteratorDone result))]
          (if (%IsException done)
              done
              (if (JsTruthy done)
                  array
                  (let [(value (JsIteratorValue result))]
                    (if (%IsException value)
                        value
                        (let [(appended (JsArrayAppend array value))]
                          (if (%IsException appended)
                              appended
                              (JsArraySpreadStep array iterator next)))))))))))

; One value at the end of an array under construction, which is where its length points.
(builtin JsArrayAppend :transitioning true :throws true :params [(array dyn) (value dyn)] :ret dyn
  (if (%IsArray array)
      (let [(raw (%UnboxArray array))]
        (let [(stored (%ArrayStore raw (%ArrayLen raw) value))]
          array))
      (let [(trapped (%TrapInvariant))] array)))

; Array destructuring (§8.6.2 IteratorBindingInitialization) walks the same iterator, but a pattern
; has a fixed number of targets and each one takes the next value — or undefined once the iterator
; is done, and a pattern may be longer than the iterable. The done flag therefore has to survive
; between steps, so it lives in a one-element array the frontend keeps for the pattern.
(builtin JsDestructureState :transitioning true :params [] :ret dyn
  (let [(state (JsNewArray 1))]
    (let [(stored (%ArrayStore (%UnboxArray state) 0 (%BoxBool (%Eq 0 1))))]
      state)))

(macro JsDestructureDone? :params [(state dyn)] :ret bool
  (JsTruthy (%ArrayLoad (%UnboxArray state) 0)))

(macro JsDestructureFinish :transitioning true :params [(state dyn)] :ret dyn
  (let [(stored (%ArrayStore (%UnboxArray state) 0 (%BoxBool (%Eq 0 0))))]
    state))

; One target's value: the iterator's next, or undefined once it is done (§8.6.2 step 4.b).
(builtin JsDestructureStep :transitioning true :throws true
  :params [(iterator dyn) (next dyn) (state dyn)] :ret dyn
  (if (JsDestructureDone? state)
      (%Undefined)
      (let [(result (JsIteratorStep iterator next))]
        (if (%IsException result)
            result
            (let [(done (JsIteratorDone result))]
              (if (%IsException done)
                  done
                  (if (JsTruthy done)
                      (let [(finished (JsDestructureFinish state))]
                        (%Undefined))
                      (JsIteratorValue result))))))))

; A rest target takes every value the iterator has left (§8.6.2 step 5.b), which exhausts it.
(builtin JsDestructureRest :transitioning true :throws true
  :params [(iterator dyn) (next dyn) (state dyn)] :ret dyn
  (let [(out (JsNewArray 0))]
    (if (JsDestructureDone? state)
        out
        (let [(filled (JsDestructureRestStep iterator next state out))]
          filled))))

(builtin JsDestructureRestStep :transitioning true :throws true
  :params [(iterator dyn) (next dyn) (state dyn) (out dyn)] :ret dyn
  (let [(result (JsIteratorStep iterator next))]
    (if (%IsException result)
        result
        (let [(done (JsIteratorDone result))]
          (if (%IsException done)
              done
              (if (JsTruthy done)
                  (let [(finished (JsDestructureFinish state))]
                    out)
                  (let [(value (JsIteratorValue result))]
                    (if (%IsException value)
                        value
                        (let [(appended (JsArrayAppend out value))]
                          (if (%IsException appended)
                              appended
                              (JsDestructureRestStep iterator next state out)))))))))))

; A pattern shorter than its iterable leaves it unfinished, and the iterator is closed (§8.6.2 step 6).
(builtin JsDestructureClose :transitioning true :throws true :params [(iterator dyn) (state dyn)] :ret dyn
  (if (JsDestructureDone? state) (%Undefined) (JsIteratorClose iterator)))
