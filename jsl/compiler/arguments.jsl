; The arguments object (ECMA-262 §10.4.4; docs/DECISIONS.md, the arguments object). A function
; whose code names `arguments` receives it from its public entry, which calls this with the call's
; own operands. The frontend admits only functions where the mapped object's aliasing of formals
; cannot be observed, so the object is built once: an ordinary object on %Object.prototype% with
; the actuals at their indices (writable, enumerable, configurable), then `length` and `callee`
; (writable and configurable, not enumerable). @@iterator waits for symbols (docs/GAPS.md).
(builtin JsCreateArgumentsObject :transitioning true
  :params [(callee dyn) (this dyn) (newtarget dyn) (count argument-count) (overflow argument-vector)
           (a0 dyn) (a1 dyn) (a2 dyn)] :ret dyn
  (let [(n (%ArgumentCountInt count))]
    (let [(object (JsSetObjectLiteralPrototype (JsNewObjectRaw) (%IntrinsicPrototype "Object.prototype")))]
      (let [(d0 (if (%Lt 0 n) (JsCreateArgumentsIndex object 0 a0) object))]
        (let [(d1 (if (%Lt 1 n) (JsCreateArgumentsIndex object 1 a1) object))]
          (let [(d2 (if (%Lt 2 n) (JsCreateArgumentsIndex object 2 a2) object))]
            (let [(rest (JsCreateArgumentsTail object overflow 3 n))]
              (let [(length (%PropStoreOwnNamedAttrs object (%PropertyKey "length") (%BoxInt n) 5))]
                (let [(named (%PropStoreOwnNamedAttrs object (%PropertyKey "callee") callee 5))]
                  (JsFinishObjectLiteral object))))))))))

(macro JsCreateArgumentsIndex :transitioning true :params [(object obj) (i int) (value dyn)] :ret obj
  (JsCreateDataPropertyAttrs object (JsToPropertyKey (%BoxInt i)) value 7))

(builtin JsCreateArgumentsTail :transitioning true
  :params [(object obj) (overflow argument-vector) (i int) (n int)] :ret obj
  (if (%Lt i n)
      (let [(stored (JsCreateArgumentsIndex object i (%ArgumentAt overflow i)))]
        (JsCreateArgumentsTail object overflow (%Add i 1) n))
      object))
