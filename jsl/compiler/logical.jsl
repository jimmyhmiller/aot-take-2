; Logical operators select source values in the frontend's Scope diamond. Only these JSL
; predicates decide which edge to take; neither operator coerces the returned operand.
(builtin JsNullish :params [(value dyn)] :ret bool
  (if (%IsUndefined value) (%Eq 0 0) (%IsNull value)))

(builtin JsLogicalNot :params [(value dyn)] :ret dyn
  (%BoxBool (%Not (JsTruthy value))))

(builtin JsVoid :params [(value dyn)] :ret dyn
  (%Undefined))

(macro JsTrue :params [] :ret dyn
  (%BoxBool (%Eq 0 0)))

(macro JsFalse :params [] :ret dyn
  (%BoxBool (%Eq 0 1)))

(macro JsNull :params [] :ret dyn
  (%Null))

; IsStrictlyEqual for the represented value domain. Both numeric representations are ECMAScript
; Number: IEEE equality rejects NaN and equates signed zeros. Strings compare UTF-16 contents.
; Remaining tags use exact tagged-word identity (including object/function/symbol identity).
; BigInt is not represented yet; parsing a BigInt literal remains an explicit unsupported error.
(macro JsNumberStrictEqual :params [(number flt) (value dyn)] :ret bool
  (if (%IsInt value)
      (%Eq number (%UnboxNumber value))
      (if (%IsFlt value) (%Eq number (%UnboxNumber value)) (%Eq 0 1))))

(macro JsStrictEqualValue :params [(a dyn) (b dyn)] :ret bool
  (if (%IsInt a)
      (JsNumberStrictEqual (%UnboxNumber a) b)
      (if (%IsFlt a)
          (JsNumberStrictEqual (%UnboxNumber a) b)
          (if (%IsString a)
              (if (%IsString b) (JsStringEquals a b) (%Eq 0 1))
              (%SameBits a b)))))

(builtin JsStrictEqual :params [(a dyn) (b dyn)] :ret dyn
  (%BoxBool (JsStrictEqualValue a b)))

(builtin JsStrictNotEqual :params [(a dyn) (b dyn)] :ret dyn
  (%BoxBool (%Not (JsStrictEqualValue a b))))
