; ClassDefinitionEvaluation (ECMA-262 §15.7.14) over the represented object model
; (docs/DECISIONS.md, classes). The constructor is an ordinary function object with [[Construct]];
; these definitions give it the prototype object and the class's members, with the attributes the
; specification assigns — a class's members are never enumerable.
;
; A method's [[HomeObject]] is the class's prototype object, or the constructor for a static member,
; and lives in its function object's environment word: `super.x` reads from the object above it.

; The prototype object of a class (§15.7.14 step 8), which exists before the constructor does: it is
; the home object of the constructor and of every prototype method, so `super` reads from the object
; above it. A base class's sits on %Object.prototype%.
(builtin JsNewClassPrototype :transitioning true :params [(parent-prototype dyn)] :ret dyn
  (JsFinishObjectLiteral (JsSetObjectLiteralPrototype (JsNewObjectRaw) parent-prototype)))

(macro JsNewBaseClassPrototype :transitioning true :params [] :ret dyn
  (JsNewClassPrototype (%IntrinsicPrototype "Object.prototype")))

; The two links between a class and its prototype object (§15.7.14 steps 14 and 16): `constructor`
; writable and configurable on the prototype, `prototype` neither writable, enumerable nor
; configurable on the constructor.
(builtin JsLinkClassPrototype :transitioning true :throws true :params [(ctor dyn) (proto dyn)] :ret dyn
  (let [(linked (JsApplyDefine proto (%PropertyKey "constructor") ctor 5 15))]
    (if (%IsException linked)
        linked
        (let [(named (JsApplyDefine ctor (%PropertyKey "prototype") proto 0 15))]
          (if (%IsException named) named proto)))))

; A class method: a writable, configurable, non-enumerable data property of the prototype object or,
; for a static method, of the constructor.
(builtin JsDefineClassMethod :transitioning true :throws true :params [(target dyn) (key int) (function dyn)] :ret dyn
  (JsApplyDefine target key function 5 15))

; The same members under a computed key, which the class evaluation has already converted to a
; primitive (`JsComputedKeyPrimitive`): the interning here cannot fail.
(macro JsDefineClassMethodComputed :transitioning true :throws true
  :params [(target dyn) (key dyn) (function dyn)] :ret dyn
  (JsDefineClassMethod target (JsToPropertyKey key) function))

(macro JsDefineFieldComputed :transitioning true :throws true
  :params [(target dyn) (key dyn) (value dyn)] :ret dyn
  (JsDefineField target (JsToPropertyKey key) value))

; A class accessor: configurable and non-enumerable, keeping the other half of one already defined.
(builtin JsDefineClassAccessor :transitioning true :throws true
  :params [(target dyn) (key int) (function dyn) (setter int)] :ret dyn
  (JsApplyDefine target key (JsAccessorPair target key (%Sub 1 setter) function setter function) 4 28))

(macro JsDefineClassAccessorComputed :transitioning true :throws true
  :params [(target dyn) (key dyn) (function dyn) (setter int)] :ret dyn
  (JsDefineClassAccessor target (JsToPropertyKey key) function setter))

; DefineField (§10.2.11): CreateDataPropertyOrThrow — writable, enumerable and configurable — of a
; field's value on the object it belongs to, the instance being constructed or the constructor.
; The receiver of a construction is always an object, so the guard is the proof that it is one.
(builtin JsDefineField :transitioning true :throws true :params [(target dyn) (key int) (value dyn)] :ret dyn
  (if (%IsObjectLike target)
      (JsApplyDefine target key value 7 15)
      (JsThrowTypeError (%Box "Cannot define a class field on a primitive value"))))

; ClassDefinitionEvaluation with a heritage (§15.7.14 steps 8-9): the parent's `prototype` heads the
; class's prototype chain and the parent heads the constructor's. `null` extends nothing: the
; prototype object has no prototype, and the constructor still sits on %Function.prototype%.
(builtin JsClassHeritagePrototype :transitioning true :throws true :params [(parent dyn)] :ret dyn
  (if (%IsNull parent)
      parent
      (if (JsIsConstructor parent)
          (let [(proto (JsGetNamed parent (%PropertyKey "prototype")))]
            (if (%IsException proto)
                proto
                (if (%IsObjectLike proto)
                    proto
                    (if (%IsNull proto)
                        proto
                        (JsThrowTypeError (%Box "Class extends value does not have valid prototype property"))))))
          (JsThrowTypeError (%Box "Class extends value is not a constructor or null")))))

; A derived class's links: the prototype object's are the base ones, and the constructor inherits
; from the parent constructor (§15.7.14 step 9.e). `extends null` leaves it on %Function.prototype%.
(builtin JsLinkDerivedClass :transitioning true :throws true
  :params [(ctor dyn) (parent dyn) (proto dyn)] :ret dyn
  (let [(linked (JsLinkClassPrototype ctor proto))]
    (if (%IsException linked)
        linked
        (if (%IsObjectLike ctor)
            (let [(inherited (%SetObjectPrototype (%UnboxObjectLike ctor)
                                                  (if (%IsNull parent)
                                                      (%IntrinsicPrototype "Function.prototype")
                                                      parent)))]
              proto)
            proto))))

; SuperCall (§13.3.7.1): the active constructor's [[Prototype]] is the parent constructor, which is
; constructed with the call's arguments and the running `new.target`; the result becomes `this`.
(builtin JsSuperConstruct :transitioning true :throws true
  :params [(callee dyn) (newtarget dyn) (args dyn)] :ret dyn
  (if (%IsObjectLike callee)
      (let [(parent (%GetObjectPrototype (%UnboxObjectLike callee)))]
        (if (JsIsConstructor parent)
            (JsBoundConstruct parent (if (%IsUndefined newtarget) parent newtarget) args)
            (JsThrowTypeError (%Box "Super constructor is not a constructor"))))
      (JsThrowTypeError (%Box "Super constructor is not a constructor"))))

; `this` in a derived constructor before `super()` is in its temporal dead zone (§9.1.1.3.4); the
; binding holds undefined until the super call initializes it, and no constructed `this` is undefined.
(macro JsRequireThisInitialized :transitioning true :throws true :params [(value dyn)] :ret dyn
  (if (%IsUndefined value) (JsThrowReferenceError) value))

; A second `super()` in one constructor is a ReferenceError (§13.3.7.1 step 3).
(macro JsRequireThisUninitialized :transitioning true :throws true :params [(value dyn) (constructed dyn)] :ret dyn
  (if (%IsUndefined value) constructed (JsThrowReferenceError)))

; A constructor's result (§10.2.2 step 13): an object it returned, else the `this` it bound, which a
; derived constructor must have initialized.
(builtin JsConstructorResult :transitioning true :throws true :params [(returned dyn) (this dyn)] :ret dyn
  (if (%IsObjectLike returned)
      returned
      (if (%IsUndefined returned)
          (JsRequireThisInitialized this)
          (JsThrowTypeError (%Box "Derived constructors may only return object or undefined")))))

; A base constructor's result: an object it returned, else the `this` it was given (§10.2.2 step 13).
(macro JsBaseConstructorResult :params [(returned dyn) (this dyn)] :ret dyn
  (if (%IsObjectLike returned) returned this))

; GetSuperBase (§13.3.7.3): the home object of the running method is its function object's
; environment word (docs/DECISIONS.md, home objects), and the reference's base is the object above
; it. A method's `this` stays the receiver of the access, so an inherited accessor runs on it.
(builtin JsSuperBase :transitioning true :throws true :params [(callee dyn)] :ret dyn
  (if (%IsFunction callee)
      (let [(home (%ClosureEnv callee))]
        (if (%IsObjectLike home)
            (%GetObjectPrototype (%UnboxObjectLike home))
            (JsThrowTypeError (%Box "super is only available in a method with a home object"))))
      (JsThrowTypeError (%Box "super is only available in a method with a home object"))))

; `super.x` — GetValue on a super reference (§6.2.5.5 step 3): ToObject of the base first, so a
; prototype-less home object is a TypeError, then [[Get]] with the method's `this` as the receiver.
(builtin JsSuperGet :transitioning true :throws true :params [(base dyn) (key int) (receiver dyn)] :ret dyn
  (if (%IsObjectLike base)
      (JsGetFromHolder base key receiver)
      (if (%IsNull base)
          (JsThrowTypeError (%Box "Cannot read properties of null"))
          (JsThrowTypeError (%Box "Cannot read properties of undefined")))))

; `super[k]`: the base is checked before the key's ToPropertyKey, whose ToPrimitive can throw.
(builtin JsSuperGetKeyed :transitioning true :throws true :params [(base dyn) (key dyn) (receiver dyn)] :ret dyn
  (if (%IsObjectLike base)
      (if (%IsObjectLike key)
          (let [(primitive (JsToPrimitive key 1))]
            (if (%IsException primitive)
                primitive
                (JsSuperGet base (JsToPropertyKey primitive) receiver)))
          (JsSuperGet base (JsToPropertyKey key) receiver))
      (if (%IsNull base)
          (JsThrowTypeError (%Box "Cannot read properties of null"))
          (JsThrowTypeError (%Box "Cannot read properties of undefined")))))

; `super.x = v` — PutValue on a super reference (§6.2.5.6 step 5): the base object's [[Set]] with
; the method's `this` as the receiver, so a data property is created on `this` and an inherited
; setter runs on it. A failed [[Set]] throws in strict code, which class code always is.
(builtin JsSuperSet :transitioning true :throws true
  :params [(base dyn) (key int) (value dyn) (receiver dyn) (strict int)] :ret dyn
  (if (%IsObjectLike base)
      (JsSuperSetViaHolder base key value receiver strict)
      (if (%IsNull base)
          (JsThrowTypeError (%Box "Cannot set properties of null"))
          (JsThrowTypeError (%Box "Cannot set properties of undefined")))))

(builtin JsSuperSetKeyed :transitioning true :throws true
  :params [(base dyn) (key dyn) (value dyn) (receiver dyn) (strict int)] :ret dyn
  (if (%IsObjectLike base)
      (if (%IsObjectLike key)
          (let [(primitive (JsToPrimitive key 1))]
            (if (%IsException primitive)
                primitive
                (JsSuperSet base (JsToPropertyKey primitive) value receiver strict)))
          (JsSuperSet base (JsToPropertyKey key) value receiver strict))
      (if (%IsNull base)
          (JsThrowTypeError (%Box "Cannot set properties of null"))
          (JsThrowTypeError (%Box "Cannot set properties of undefined")))))

; OrdinarySet (§10.1.9.2) starting at the base object of a super reference, whose receiver is the
; method's `this` and so is not the object the walk starts from — and need not be an object at all,
; when the method was called on a primitive. The shape of the walk is JsSetViaHolder's.
(builtin JsSuperSetViaHolder :transitioning true :noinline true :throws true
  :params [(holder dyn) (key int) (value dyn) (receiver dyn) (strict int)] :ret dyn
  (if (%IsObjectLike holder)
      (if (JsArrayHolderOwnsExotic holder key)
          (JsSuperSetCreateOwn receiver key value strict)
          (let [(hattrs (%PropAttrsOwn (%UnboxObjectLike holder) key))]
            (if (%Lt hattrs 0)
                (JsSuperSetViaHolder (%PropChainHolder (%UnboxObjectLike holder) key) key value receiver strict)
                (if (%Lt hattrs 8)
                    (if (%Eq (%And hattrs 1) 1)
                        (JsSuperSetCreateOwn receiver key value strict)
                        (JsSetFail value strict (%Box "Cannot assign to read only property")))
                    (JsCallSetter (%PropLoadOwnNamed (%UnboxObjectLike holder) key) receiver value strict)))))
      (JsSuperSetCreateOwn receiver key value strict)))

; CreateDataProperty(Receiver, …) at the end of that walk: a primitive receiver takes no property
; (§10.1.9.2 step 2.c.i), which is the failed assignment.
(macro JsSuperSetCreateOwn :transitioning true :throws true
  :params [(receiver dyn) (key int) (value dyn) (strict int)] :ret dyn
  (if (%IsObjectLike receiver)
      (JsSetCreateOwn receiver key value strict)
      (JsSetFail value strict (%Box "Cannot create property on a primitive value"))))
