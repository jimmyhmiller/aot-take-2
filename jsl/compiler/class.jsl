; ClassDefinitionEvaluation (ECMA-262 §15.7.14) over the represented object model
; (docs/DECISIONS.md, classes). The constructor is an ordinary function object with [[Construct]];
; these definitions give it the prototype object and the class's members, with the attributes the
; specification assigns — a class's members are never enumerable.

; The prototype object of a base class and its two links: `constructor` writable and configurable on
; the prototype, `prototype` neither writable, enumerable nor configurable on the constructor.
(builtin JsMakeClassPrototype :transitioning true :throws true :params [(ctor dyn)] :ret dyn
  (let [(proto (JsFinishObjectLiteral
                 (JsSetObjectLiteralPrototype (JsNewObjectRaw) (%IntrinsicPrototype "Object.prototype"))))]
    (let [(linked (JsApplyDefine proto (%PropertyKey "constructor") ctor 5 15))]
      (if (%IsException linked)
          linked
          (let [(named (JsApplyDefine ctor (%PropertyKey "prototype") proto 0 15))]
            (if (%IsException named) named proto))))))

; A class method: a writable, configurable, non-enumerable data property of the prototype object or,
; for a static method, of the constructor.
(builtin JsDefineClassMethod :transitioning true :throws true :params [(target dyn) (key int) (function dyn)] :ret dyn
  (JsApplyDefine target key function 5 15))

; A class accessor: configurable and non-enumerable, keeping the other half of one already defined.
(builtin JsDefineClassAccessor :transitioning true :throws true
  :params [(target dyn) (key int) (function dyn) (setter int)] :ret dyn
  (JsApplyDefine target key (JsAccessorPair target key (%Sub 1 setter) function setter function) 4 28))
