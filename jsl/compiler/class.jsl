; ClassDefinitionEvaluation (ECMA-262 §15.7.14) over the represented object model
; (docs/DECISIONS.md, classes). The constructor is an ordinary function object with [[Construct]];
; these definitions give it the prototype object and the class's members, with the attributes the
; specification assigns — a class's members are never enumerable.

; The prototype object of a base class and its two links: `constructor` writable and configurable on
; the prototype, `prototype` neither writable, enumerable nor configurable on the constructor.
(builtin JsMakeClassPrototype :transitioning true :throws true :params [(ctor dyn)] :ret dyn
  (let [(proto (JsFinishObjectLiteral
                 (JsSetObjectLiteralPrototype (JsNewObjectRaw) (%IntrinsicPrototype "Object.prototype"))))]
    (let [(linked (JsApplyDefine proto (%PropertyKey "constructor") ctor 5 15))]
      (if (%IsException linked)
          linked
          (let [(named (JsApplyDefine ctor (%PropertyKey "prototype") proto 0 15))]
            (if (%IsException named) named proto))))))

; A class method: a writable, configurable, non-enumerable data property of the prototype object or,
; for a static method, of the constructor.
(builtin JsDefineClassMethod :transitioning true :throws true :params [(target dyn) (key int) (function dyn)] :ret dyn
  (JsApplyDefine target key function 5 15))

; A class accessor: configurable and non-enumerable, keeping the other half of one already defined.
(builtin JsDefineClassAccessor :transitioning true :throws true
  :params [(target dyn) (key int) (function dyn) (setter int)] :ret dyn
  (JsApplyDefine target key (JsAccessorPair target key (%Sub 1 setter) function setter function) 4 28))

; ClassDefinitionEvaluation with a heritage (§15.7.14 steps 8-9): the parent's `prototype` heads the
; class's prototype chain and the parent heads the constructor's. `null` extends nothing: the
; prototype object has no prototype, and the constructor still sits on %Function.prototype%.
(builtin JsClassHeritagePrototype :transitioning true :throws true :params [(parent dyn)] :ret dyn
  (if (%IsNull parent)
      parent
      (if (JsIsConstructor parent)
          (let [(proto (JsGetNamed parent (%PropertyKey "prototype")))]
            (if (%IsException proto)
                proto
                (if (%IsObjectLike proto)
                    proto
                    (if (%IsNull proto)
                        proto
                        (JsThrowTypeError (%Box "Class extends value does not have valid prototype property"))))))
          (JsThrowTypeError (%Box "Class extends value is not a constructor or null")))))

; The prototype object of a derived class, on the parent's `prototype`, and the constructor on the
; parent itself.
(builtin JsMakeDerivedClassPrototype :transitioning true :throws true
  :params [(ctor dyn) (parent dyn) (parent-prototype dyn)] :ret dyn
  (let [(proto (JsFinishObjectLiteral
                 (JsSetObjectLiteralPrototype (JsNewObjectRaw) parent-prototype)))]
    (let [(linked (JsApplyDefine proto (%PropertyKey "constructor") ctor 5 15))]
      (if (%IsException linked)
          linked
          (let [(named (JsApplyDefine ctor (%PropertyKey "prototype") proto 0 15))]
            (if (%IsException named)
                named
                (if (%IsObjectLike ctor)
                    (let [(inherited (%SetObjectPrototype (%UnboxObjectLike ctor)
                                                          (if (%IsNull parent)
                                                              (%IntrinsicPrototype "Function.prototype")
                                                              parent)))]
                      proto)
                    proto)))))))

; SuperCall (§13.3.7.1): the active constructor's [[Prototype]] is the parent constructor, which is
; constructed with the call's arguments and the running `new.target`; the result becomes `this`.
(builtin JsSuperConstruct :transitioning true :throws true
  :params [(callee dyn) (newtarget dyn) (args dyn)] :ret dyn
  (if (%IsObjectLike callee)
      (let [(parent (%GetObjectPrototype (%UnboxObjectLike callee)))]
        (if (JsIsConstructor parent)
            (JsBoundConstruct parent (if (%IsUndefined newtarget) parent newtarget) args)
            (JsThrowTypeError (%Box "Super constructor is not a constructor"))))
      (JsThrowTypeError (%Box "Super constructor is not a constructor"))))

; `this` in a derived constructor before `super()` is in its temporal dead zone (§9.1.1.3.4); the
; binding holds undefined until the super call initializes it, and no constructed `this` is undefined.
(macro JsRequireThisInitialized :transitioning true :throws true :params [(value dyn)] :ret dyn
  (if (%IsUndefined value) (JsThrowReferenceError) value))

; A second `super()` in one constructor is a ReferenceError (§13.3.7.1 step 3).
(macro JsRequireThisUninitialized :transitioning true :throws true :params [(value dyn) (constructed dyn)] :ret dyn
  (if (%IsUndefined value) constructed (JsThrowReferenceError)))

; A constructor's result (§10.2.2 step 13): an object it returned, else the `this` it bound, which a
; derived constructor must have initialized.
(builtin JsConstructorResult :transitioning true :throws true :params [(returned dyn) (this dyn)] :ret dyn
  (if (%IsObjectLike returned)
      returned
      (if (%IsUndefined returned)
          (JsRequireThisInitialized this)
          (JsThrowTypeError (%Box "Derived constructors may only return object or undefined")))))

; A base constructor's result: an object it returned, else the `this` it was given (§10.2.2 step 13).
(macro JsBaseConstructorResult :params [(returned dyn) (this dyn)] :ret dyn
  (if (%IsObjectLike returned) returned this))
