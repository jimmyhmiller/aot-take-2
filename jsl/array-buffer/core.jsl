;; Fixed-length ArrayBuffer foundation. An ArrayBuffer is an ordinary object carrying opaque
;; internal slots: target is sparse byte storage, index is [[ArrayBufferByteLength]], and kind 105
;; is the brand. Unmaterialized sparse bytes are read as zero by typed-array operations. The byte
;; array is opaque and never represented by JavaScript properties.

(macro IsArrayBuffer :transitioning true :params [(value dyn)] :ret bool
  (HasInternalSlot value (InternalSlotArrayBufferData)))

(builtin IsSharedArrayBuffer
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-issharedarraybuffer"
  :spec-name "IsSharedArrayBuffer"
  :status partial
  :deviation "Shared Data Blocks and SharedArrayBuffer objects are not represented; every represented fixed ArrayBuffer correctly returns false."
  :params [(object dyn)] :ret bool
  false)

(builtin IsDetachedBuffer
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isdetachedbuffer"
  :spec-name "IsDetachedBuffer"
  :status partial
  :deviation "ArrayBuffer detachment is not yet implemented; represented allocated ArrayBuffers retain a non-null [[ArrayBufferData]] target and correctly return false."
  :params [(arrayBuffer dyn)] :ret bool
  (%IsNull (%InternalTarget arrayBuffer)))

(builtin IsGrowableSharedArrayBuffer :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isgrowablesharedarraybuffer"
  :spec-name "IsGrowableSharedArrayBuffer"
  :status partial
  :deviation "SharedArrayBuffer and [[ArrayBufferByteLengthData]] representations are not implemented; represented fixed ArrayBuffers correctly return false."
  :params [(arrayBuffer dyn)] :ret bool
  (if (IsSharedArrayBuffer arrayBuffer)
      (HasInternalSlot arrayBuffer (InternalSlotArrayBufferByteLengthData))
      false))

(builtin IsFixedLengthArrayBuffer
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isfixedlengtharraybuffer"
  :spec-name "IsFixedLengthArrayBuffer"
  :status partial
  :deviation "Resizable and growable ArrayBuffer representations with [[ArrayBufferMaxByteLength]] are not implemented; represented fixed ArrayBuffers correctly return true."
  :params [(arrayBuffer dyn)] :ret bool
  true)

(builtin ArrayBufferByteLength :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-arraybufferbytelength"
  :spec-name "ArrayBufferByteLength"
  :status partial
  :deviation "The growable SharedArrayBuffer atomic-length path and detached buffers are not represented; fixed non-shared ArrayBuffers return their canonical [[ArrayBufferByteLength]]."
  :params [(arrayBuffer dyn) (order int)] :ret dyn
  (if (IsGrowableSharedArrayBuffer arrayBuffer)
      (ThrowTypeError "Growable SharedArrayBuffer byte length is not represented")
      (if (IsDetachedBuffer arrayBuffer)
          (ThrowTypeError "ArrayBuffer is detached")
          (%Box (%InternalIndex arrayBuffer)))))

;; Private encodings of the specification's integer TypedArray element-type values. The first two
;; are the existing Int8Array/Uint8Array layout kinds; the wider values are compile-time operation
;; discriminators, not object-layout tags. Keeping interpretation behind these named operations
;; prevents DataView callers from duplicating a switch over representation numbers.
(builtin IntegerElementSize :params [(elementType int)] :ret int
  (if (if (%Eq elementType 200) true (%Eq elementType 201)) 1
      (if (if (%Eq elementType 202) true (%Eq elementType 203)) 2
          (if (if (%Eq elementType 204) true (%Eq elementType 205)) 4 0))))

(builtin IntegerElementTypeIsUnsigned :params [(elementType int)] :ret bool
  (if (%Eq elementType 201) true
      (if (%Eq elementType 203) true (%Eq elementType 205))))

;; https://tc39.es/ecma262/#sec-getvaluefrombuffer. This is the fixed, non-shared integer branch:
;; it reads the canonical byte block and performs RawBytesToNumeric's endian assembly and signed
;; two's-complement interpretation. Float, BigInt, shared-memory, and detachable-buffer branches
;; remain explicit deviations rather than being approximated through Number arithmetic.
(builtin GetValueFromBuffer :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-getvaluefrombuffer"
  :spec-name "GetValueFromBuffer"
  :status partial
  :deviation "Only fixed non-shared ArrayBuffers and the six integer element types are represented; Float16/32/64, BigInt64/BigUint64, shared-memory ordering, and detachment remain unimplemented."
  :params [(arrayBuffer dyn) (byteIndex int) (elementType int)
           (isTypedArray bool) (order int) (isLittleEndian bool)] :ret dyn
  (let [(elementSize (IntegerElementSize elementType))]
    (if (%Eq elementSize 0)
        (ThrowTypeError "Unsupported ArrayBuffer element type")
        (if (IsDetachedBuffer arrayBuffer)
            (ThrowTypeError "ArrayBuffer is detached")
            (let [(bytes (%InternalTarget arrayBuffer))
                  (unsignedValue
                    (loop [(cursor 0) (value 0)]
                      (if (%Eq cursor elementSize)
                          value
                          (let [(stored (%ArrayLoad bytes (%Add byteIndex cursor)))
                                (byte (if (%IsUndefined stored) 0 (%UnboxInt stored)))
                                (shift (%Mul (if isLittleEndian
                                                cursor
                                                (%Sub (%Sub elementSize 1) cursor))
                                             8))
                                ;; IR bitwise operations intentionally implement JavaScript's
                                ;; signed 32-bit operators. RawBytesToNumeric's Uint32 result is a
                                ;; mathematical Number up to 2^32-1, so assemble with exact integer
                                ;; multiplication instead of sign-extending a bit-31 shift.
                                (factor
                                  (if (%Eq shift 0) 1
                                      (if (%Eq shift 8) 256
                                          (if (%Eq shift 16) 65536 16777216))))]
                            (recur (%Add cursor 1)
                                   (%Add value (%Mul byte factor)))))))]
              (if (IntegerElementTypeIsUnsigned elementType)
                  (%Box unsignedValue)
                  (let [(signBoundary
                          (if (%Eq elementSize 1) 128
                              (if (%Eq elementSize 2) 32768 2147483648)))
                        (modulus
                          (if (%Eq elementSize 1) 256
                              (if (%Eq elementSize 2) 65536 4294967296)))]
                    (%Box (if (%Le signBoundary unsignedValue)
                              (%Sub unsignedValue modulus)
                              unsignedValue)))))))))

;; https://tc39.es/ecma262/#sec-setvalueinbuffer. NumericToRawBytes for integer element types is
;; modulo-2^32 conversion followed by byte extraction, which ToUint32 plus unsigned shifts provides
;; directly. Writes target the same opaque byte block consumed by TypedArray and DataView reads.
(builtin SetValueInBuffer
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-setvalueinbuffer"
  :spec-name "SetValueInBuffer"
  :status partial
  :deviation "Only fixed non-shared ArrayBuffers and the six integer element types are represented; Float16/32/64, BigInt64/BigUint64, shared-memory event ordering, and detachment remain unimplemented."
  :transitioning true
  :params [(arrayBuffer dyn) (byteIndex int) (elementType int) (value dyn)
           (isTypedArray bool) (order int) (isLittleEndian bool)] :ret dyn
  (let [(elementSize (IntegerElementSize elementType))]
    (if (%Eq elementSize 0)
        (ThrowTypeError "Unsupported ArrayBuffer element type")
        (if (IsDetachedBuffer arrayBuffer)
            (ThrowTypeError "ArrayBuffer is detached")
            (let [(bytes (%InternalTarget arrayBuffer))
                  (bits (ToUint32 value))]
              (loop [(cursor 0)]
                (if (%Eq cursor elementSize)
                    undefined
                    (let [(shift (%Mul (if isLittleEndian
                                          cursor
                                          (%Sub (%Sub elementSize 1) cursor))
                                       8))
                          (byte (%BitAnd (%Ushr bits shift) 255))
                          (stored (%ArrayStore bytes (%Add byteIndex cursor) (%Box byte)))]
                      (recur (%Add cursor 1))))))))))

;; ToIndex owns ECMAScript conversion and validation. This helper owns only the fixed-length
;; implementation's smaller addressable storage range and raw machine-index representation.
(builtin ToArrayBufferLength :transitioning true :params [(value dyn)] :ret int
  (let [(index (ToIndex value))]
    (if (%IsInt index)
        (let [(length (%UnboxInt index))]
          (if (%Lt length 0)
              (ThrowRangeError "Invalid array buffer length")
              (if (%Le length 2147483647)
                  length
                  (ThrowRangeError "Invalid array buffer length"))))
        (ThrowRangeError "Invalid array buffer length"))))

(builtin NewArrayBuffer :transitioning true :params [(length int)] :ret dyn
  ;; Every allocation path must establish the realm intrinsic whose prototype it installs.
  ;; ConstructArrayBuffer already reaches ArrayBufferConstructorValue directly, but TypedArray
  ;; construction also allocates backing buffers through this operation. Without this dependency
  ;; those buffers carried the right internal slots and an uninitialized %ArrayBuffer.prototype%,
  ;; so an inherited `byteLength` read observed an absent data property instead of the accessor.
  (let [(intrinsics (ArrayBufferConstructorValue))
        (object (%Box (%NewObject)))
        (bytes (%BoxArray (%NewArray)))
        (sized (%ArrayResize bytes length object))
        (initialized (%InternalInit object bytes 105))
        (lengthInitialized (%InternalSetIndex object length))
        (prototype (InitializeObjectPrototype object (BuiltinPrototypeValue 25)))]
    object))

(builtin ConstructArrayBuffer :transitioning true :params [(lengthValue dyn)] :ret dyn
  (let [(initialized (ArrayBufferConstructorValue))
        (length (ToArrayBufferLength lengthValue))]
    (NewArrayBuffer length)))

(callable ArrayBufferByteLengthGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotArrayBufferData)))]
    (ArrayBufferByteLength this 0)))

(callable ArrayBufferIsView1 :transitioning true :params [(value dyn)] :ret dyn
