(callable ArrayBufferDetachedGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotArrayBufferData)))]
    (%Box (IsDetachedBuffer this))))

(callable ArrayBufferSpeciesGetter0 :params [] :ret dyn this)

(builtin InstallBuiltinGetter :transitioning true :params [(target dyn) (key dyn) (getter dyn) (name dyn)] :ret dyn
  (let [(getterLength (%DefinePropertyValue getter (ToPropertyKey "length") (%Box 0)))
