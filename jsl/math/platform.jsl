;; Torque calls these `extern` operations: the host supplies the irreducible floating-point
;; instruction/libm service, while JavaScript-visible entry points remain definitions in the DSL.
;; These wrappers deliberately carry no policy beyond argument/result representation; special
;; values and correctly-rounded behavior are the platform primitive's contract.

(macro MathObjectValue :params [] :ret dyn
  (%BuiltinObject 21))

(builtin MathExp :params [(v dyn)] :ret dyn (%ExpNum v))
(builtin MathLog :params [(v dyn)] :ret dyn (%LogNum v))
(builtin MathSin :params [(v dyn)] :ret dyn (%SinNum v))
(builtin MathCos :params [(v dyn)] :ret dyn (%CosNum v))
(builtin MathTan :params [(v dyn)] :ret dyn (%TanNum v))
(builtin MathAsin :params [(v dyn)] :ret dyn (%AsinNum v))
(builtin MathAcos :params [(v dyn)] :ret dyn (%AcosNum v))
(builtin MathAtan :params [(v dyn)] :ret dyn (%AtanNum v))
(builtin MathSqrt :params [(v dyn)] :ret dyn (%SqrtNum v))
(builtin MathPow :params [(base dyn) (exponent dyn)] :ret dyn (%PowNum base exponent))
(builtin MathRandom :params [] :ret dyn (%RandomNum))
