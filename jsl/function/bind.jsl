;; Exact two-argument Function helper shape used by Test262's property helpers. General Function
;; binding still requires an argument-count channel in the native ABI; these definitions are real
;; callable values rather than syntax rewrites and compose through ordinary dynamic dispatch.

;; IteratorBindingInitialization supplies `undefined` after the argument list is exhausted. Native
;; call sites reserve enough machine slots for every possible formal while carrying the real source
;; argc separately; the frontend owns that layout and this operation owns the JavaScript value put
;; in every structurally omitted slot. Present arguments never pass through this operation.
(macro OmittedArgumentValue :params [] :ret dyn
  (%Box undefined))

;; A lexical binding read before InitializeBinding is abrupt. Parameter default initializers use
;; this for their own and later parameter bindings; the frontend supplies only the resolved-name
;; structure that identifies the TDZ read.
(builtin GetParameterBinding :transitioning true :params [(value dyn) (initialized bool) (name dyn)] :ret dyn
  (if initialized
      value
      (ThrowReferenceError (%StringConcat name " is not initialized"))))

(callable FunctionCall2 :transitioning true
  :params [(thisArg dyn) (arg0 dyn)] :ret dyn
  (Call this thisArg arg0))

(callable ArrayJoin1 :transitioning true
  :params [(separator dyn)] :ret dyn
  (ArrayJoin this separator))

(callable ArrayPushMethod1 :transitioning true
  :params [(value dyn)] :ret dyn
  (%Box (ArrayPush1 this value)))

(callable BoundFunction2 :transitioning true :captures [target boundThis]
  :params [(arg0 dyn) (arg1 dyn)] :ret dyn
  (Call target boundThis arg0 arg1))

(callable FunctionBind1 :transitioning true :captures [] :params [(boundThis dyn)] :ret dyn
  (%Box (closure BoundFunction2 (%Box this) (%Box boundThis))))

(builtin FunctionConstructorValue :transitioning true :params [] :ret dyn
  (let [(constructor (%ErrorConstructor 21))
        (prototype (BuiltinPrototypeValue 21))
        (metadata (InitializeFunctionProperties prototype 0 ""))
        (callMethod (closure FunctionCall2))
        (prototypeStored
          (%PropStoreKey constructor (ToPropertyKey "prototype") (%Box prototype)))
        (constructorStored
          (%PropStoreKey prototype (ToPropertyKey "constructor") (%Box constructor)))
        (callStored (%PropStoreKey prototype (ToPropertyKey "call") (%Box callMethod)))
        (bindMethod (closure FunctionBind1))
        (bindStored (%PropStoreKey prototype (ToPropertyKey "bind") (%Box bindMethod)))]
    constructor))
