(builtin ToDataViewIndex :transitioning true :params [(value dyn)] :ret int
  (let [(index (ToIndex value))]
    (if (%IsInt index)
        (let [(raw (%UnboxInt index))]
          (if (%Lt raw 0)
              (ThrowRangeError "Invalid DataView offset or length")
              (if (%Le raw 2147483647)
                  raw
                  (ThrowRangeError "Invalid DataView offset or length"))))
        (ThrowRangeError "Invalid DataView offset or length"))))

(builtin NewDataView :transitioning true
  :params [(buffer dyn) (byteOffset int) (byteLength int)] :ret dyn
  (let [(object (%Box (%NewObject)))
        (layout (object-layout-init object DataViewObjectBase))
        (extensible (internal-slot-store layout Extensible true))
        (branded (internal-slot-store extensible DataView true))
        (viewed (internal-slot-store branded ViewedArrayBuffer buffer))
        (length (internal-slot-store viewed ByteLength (%Box byteLength)))
        (offset (internal-slot-store length ByteOffset (%Box byteOffset)))
        (prototype (InitializeObjectPrototype offset (BuiltinPrototypeValue 30)))]
    object))

;; https://tc39.es/ecma262/#sec-dataview-buffer-byteoffset-bytelength. The represented ArrayBuffer
;; profile is fixed-length and non-shared, so the resizable-buffer branches are explicit future
;; work while offset/length conversion, bounds checks, and slot initialization follow the spec.
(builtin ConstructDataView :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-dataview-buffer-byteoffset-bytelength"
  :spec-name "DataView"
  :status partial
  :deviation "Resizable and growable shared ArrayBuffers, detached-buffer rechecks, subclass NewTarget prototype selection, and host storage beyond the represented fixed 31-bit range are not implemented."
  :params [(buffer dyn) (byteOffsetValue dyn) (byteLengthValue dyn)] :ret dyn
  (let [(initialized (DataViewConstructorValue))
        (required (RequireInternalSlot buffer (InternalSlotArrayBufferData)))
        (byteOffset (ToDataViewIndex byteOffsetValue))
        (bufferByteLength (%InternalIndex buffer))]
    (if (%Lt bufferByteLength byteOffset)
        (ThrowRangeError "DataView byteOffset is outside the buffer")
        (let [(byteLength
                (if (%IsUndefined byteLengthValue)
                    (%Sub bufferByteLength byteOffset)
                    (ToDataViewIndex byteLengthValue)))]
          (if (%Lt (%Sub bufferByteLength byteOffset) byteLength)
              (ThrowRangeError "DataView byteLength is outside the buffer")
              (NewDataView buffer byteOffset byteLength))))))

