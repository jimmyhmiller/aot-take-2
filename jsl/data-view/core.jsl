;; Fixed-length DataView foundation. Unlike the older compact view encodings, DataView is the
;; first buffer view stored entirely in the generated Torque-style object layout: its three
;; specification slots are named, independently traced, and inaccessible as JavaScript properties.

(builtin IsDataView :params [(value dyn)] :ret bool
  (if (%IsObject value)
      (internal-slot-has value DataView)
      false))

(record DataViewWithBufferWitnessRecord
  [(object dyn) (cachedBufferByteLength dyn)])

;; https://tc39.es/ecma262/#sec-makedataviewwithbufferwitnessrecord. `undefined` is the internal
;; compile-time/runtime sentinel for the specification's ~detached~ record alternative; a valid
;; cached byte length is always a represented non-negative integer.
(macro MakeDataViewWithBufferWitnessRecord :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-makedataviewwithbufferwitnessrecord"
  :spec-name "MakeDataViewWithBufferWitnessRecord"
  :status partial
  :deviation "Shared, growable, resizable, and observably detached ArrayBuffers are not yet represented; fixed buffers cache their canonical byte length in the specification Record."
  :params [(object dyn) (order int)] :ret (record DataViewWithBufferWitnessRecord)
  (let [(buffer (internal-slot-load object ViewedArrayBuffer))]
    (record-new DataViewWithBufferWitnessRecord
      [(object object)
       (cachedBufferByteLength
         (if (IsDetachedBuffer buffer)
             undefined
             (ArrayBufferByteLength buffer order)))])))

;; https://tc39.es/ecma262/#sec-isviewoutofbounds.
(builtin IsViewOutOfBounds :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isviewoutofbounds"
  :spec-name "IsViewOutOfBounds"
  :status partial
  :deviation "Represented DataViews always have explicit fixed byte lengths; the ~auto~ length-tracking branch awaits resizable ArrayBuffer representation."
  :params [(viewRecord (record DataViewWithBufferWitnessRecord))] :ret bool
  (let [(view (record-get viewRecord object))
        (buffer (internal-slot-load view ViewedArrayBuffer))
        (bufferByteLength (record-get viewRecord cachedBufferByteLength))]
    (if (IsDetachedBuffer buffer)
        true
        (let [(byteOffsetStart (%UnboxInt (internal-slot-load view ByteOffset)))
              (byteOffsetEnd
                (%Add byteOffsetStart (%UnboxInt (internal-slot-load view ByteLength))))
              (bufferLength (%UnboxInt bufferByteLength))]
          (if (%Lt bufferLength byteOffsetStart)
              true
              (%Lt bufferLength byteOffsetEnd))))))

;; https://tc39.es/ecma262/#sec-getviewbytelength.
(builtin GetViewByteLength :transitioning true
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-getviewbytelength"
  :spec-name "GetViewByteLength"
  :status partial
  :deviation "Represented DataViews always have an explicit [[ByteLength]]; the ~auto~ length-tracking calculation awaits resizable ArrayBuffer representation."
  :params [(viewRecord (record DataViewWithBufferWitnessRecord))] :ret dyn
  (let [(view (record-get viewRecord object))]
    (if (IsViewOutOfBounds viewRecord)
        (ThrowTypeError "GetViewByteLength requires an in-bounds DataView")
        (internal-slot-load view ByteLength))))

;; https://tc39.es/ecma262/#sec-getviewvalue. The public DataView getters all enter through this
;; one semantic operation; method wrappers supply only the spec element-type discriminator.
(builtin GetViewValue
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-getviewvalue"
  :spec-name "GetViewValue"
  :status partial
  :deviation "The fixed-buffer integer path is implemented for Int8/Uint8/Int16/Uint16/Int32/Uint32; floating-point, BigInt, resizable, growable-shared, and detachable-buffer behavior remains unimplemented."
  :transitioning true
  :params [(view dyn) (requestIndex dyn) (isLittleEndianValue dyn) (elementType int)] :ret dyn
  (let [(required (RequireInternalSlot view (InternalSlotDataView)))
        (getIndex (ToDataViewIndex requestIndex))
        (isLittleEndian (ToBoolean isLittleEndianValue))
        (viewOffset (%UnboxInt (internal-slot-load view ByteOffset)))
        (viewRecord (MakeDataViewWithBufferWitnessRecord view 0))]
    (if (IsViewOutOfBounds viewRecord)
        (ThrowTypeError "DataView is out of bounds")
        (let [(viewSize (%UnboxInt (GetViewByteLength viewRecord)))
              (elementSize (IntegerElementSize elementType))]
          (if (%Eq elementSize 0)
              (ThrowTypeError "Unsupported DataView element type")
              (if (%Lt viewSize (%Add getIndex elementSize))
                  (ThrowRangeError "DataView access is outside the view")
                  (GetValueFromBuffer (internal-slot-load view ViewedArrayBuffer)
                    (%Add getIndex viewOffset) elementType false 0 isLittleEndian)))))))

;; https://tc39.es/ecma262/#sec-setviewvalue. Conversion deliberately precedes the view bounds
;; checks, matching the observable ordering in ECMA-262.
(builtin SetViewValue
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-setviewvalue"
  :spec-name "SetViewValue"
  :status partial
  :deviation "The fixed-buffer integer path is implemented for Int8/Uint8/Int16/Uint16/Int32/Uint32; floating-point, BigInt, resizable, growable-shared, and detachable-buffer behavior remains unimplemented."
  :transitioning true
  :params [(view dyn) (requestIndex dyn) (isLittleEndianValue dyn)
           (elementType int) (value dyn)] :ret dyn
  (let [(required (RequireInternalSlot view (InternalSlotDataView)))
        (getIndex (ToDataViewIndex requestIndex))
        (number (ToNumberValue value))
        (isLittleEndian (ToBoolean isLittleEndianValue))
        (viewOffset (%UnboxInt (internal-slot-load view ByteOffset)))
        (viewRecord (MakeDataViewWithBufferWitnessRecord view 0))]
    (if (IsViewOutOfBounds viewRecord)
        (ThrowTypeError "DataView is out of bounds")
        (let [(viewSize (%UnboxInt (GetViewByteLength viewRecord)))
              (elementSize (IntegerElementSize elementType))]
          (if (%Eq elementSize 0)
              (ThrowTypeError "Unsupported DataView element type")
              (if (%Lt viewSize (%Add getIndex elementSize))
                  (ThrowRangeError "DataView access is outside the view")
                  (SetValueInBuffer (internal-slot-load view ViewedArrayBuffer)
                    (%Add getIndex viewOffset) elementType number false 0 isLittleEndian)))))))

