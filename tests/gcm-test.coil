;; Loop-tree facts consumed by GCM.
(module aot.tests.gcm)
(import "coil.assert" :use *)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.call" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.compare" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.codegen.looptree" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.gcm" :use *)
(import "aot.node.cpus.arm64" :use *)
(import "aot.type.type" :use *)

(defn gcm-test-add-chain [(value (dyn NodeOps))
                          (step (dyn NodeOps))
                          (remaining i64)] (-> (dyn NodeOps))
  (if (<= remaining 0)
      value
      (gcm-test-add-chain (add-make-mode value step MODE-INT) step (- remaining 1))))

(deftest instruction_selection_ownership_is_linear_and_invalidates_after_control_edits
  (boot! 1)
  (let [st (start-make (ty-int-bot))
        sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
        fun (fun-make st sig "first") other (fun-make st sig "second")
        (mut nodes) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
        (mut ctrl) (load fun) (mut first) (load fun) (mut i) 0]
    (loop (if (= (load i) 512) (break 0)
      (let [branch (if-make (load ctrl) (con-make (ty-int-range 0 1))) arms (if-arms! branch)]
        (if (= (load i) 0) (set! (mut first) branch) 0)
        (push! [(dyn NodeOps)] (mut nodes) (arms-true arms))
        (set! (mut ctrl) (arms-false arms))
        (set! (mut i) (+ (load i) 1)) (continue))))
    (set! (.steps (cfg-owner-stats)) 0)
    (al-for [n (load nodes)]
      (match (arm64--enclosing-fun n)
        (Some [owner] (assert (n-same? owner fun))) (None [] (assert false))))
    (assert (> (.steps (cfg-owner-stats)) 0))
    (assert (<= (.steps (cfg-owner-stats)) (* 512 3)))
    (n-set-def! (load first) 0 (Some other))
    (match (arm64--enclosing-fun (load ctrl))
      (Some [owner] (assert (n-same? owner other))) (None [] (assert false)))
    (al-free! (mut nodes))))


(deftest indexed_dominators_match_chain_walks_and_refuse_stale_control
  (boot! 1)
  (code-reset! 1)
  (let [st (start-make (ty-int-bot))
        fun (fun-make st (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "indexed")
        other (fun-make st (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "other")
        (mut nodes) (al-new [i64] (alloc/malloc-allocator))
        (mut control) (load fun) (mut first) 0 (mut i) 0]
    (loop (if (= (load i) 64) (break 0)
      (let [branch (if-make (load control) (con-make (ty-int-range 0 1)))
            arms (if-arms! branch)]
        (if (= (load i) 0) (set! (mut first) (n-nid branch)) 0)
        (push! [i64] (mut nodes) (n-nid (arms-true arms)))
        (push! [i64] (mut nodes) (n-nid (arms-false arms)))
        ;; Only endpoints are supplied; index construction must include their ancestors too.
        (push! [i64] (mut (.cfg (code))) (n-nid (arms-true arms)))
        (push! [i64] (mut (.cfg (code))) (n-nid (arms-false arms)))
        (set! (mut control) (arms-true arms))
        (set! (mut i) (+ (load i) 1)) (continue))))
    (gcm-dom-begin!)
    (set! (mut i) 0)
    (loop (if (>= (load i) (len (load nodes))) (break 0)
      (let [a (match (arena-node (get (load nodes) (load i)))
                (Some [n] n) (None [] (unreachable-node))) (mut j) 0]
        (loop (if (>= (load j) (len (load nodes))) (break 0)
          (let [b (match (arena-node (get (load nodes) (load j)))
                    (Some [n] n) (None [] (unreachable-node)))]
            (match (idom-lca-nodes a (Some b))
              (Some [expected]
                (match (gcm-idom-lca a (Some b))
                  (Some [actual] (assert (n-same? expected actual)))
                  (None [] (assert false))))
              (None [] (assert false)))
            (set! (mut j) (+ (load j) 7)) (continue))))
        (set! (mut i) (+ (load i) 1)) (continue))))
    (assert (<= (.steps (gcm-dom-index))
                (* 2 (* (.levels (gcm-dom-index)) (.queries (gcm-dom-index))))))
    (let [before (.queries (gcm-dom-index))
          first-branch (match (arena-node (load first))
                         (Some [n] n) (None [] (unreachable-node)))]
      (n-set-def! first-branch 0 (Some other))
      (match (gcm-idom-lca (load control) (Some fun))
        ;; Unlinked function entries are separate dominator roots.
        (Some [_] (assert false))
        (None [] (assert true)))
      (assert-eq (.queries (gcm-dom-index)) before)
      (gcm-dom-begin!)
      (match (gcm-idom-lca (load control) (Some other))
        (Some [answer] (assert (n-same? answer other)))
        (None [] (assert false)))
      (assert-eq (.queries (gcm-dom-index)) 1))
    (set! (.active (gcm-dom-index)) false)
    (al-free! (mut nodes))))

(deftest loop_tree_assigns_root_depth_to_straight_line_control
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               fun (fun-make st (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "straight")
               ret (return-make fun (None [(dyn NodeOps)]) (con-make (ty-int-con 1))
                                (None [(dyn NodeOps)]) (Some fun))
               stop (stop-make)]
           (fun-set-ret! fun ret)
           (stop-add-return! stop ret)
           (looptree-build! st stop)
           (assert-eq (n-nid (looptree-loop-of fun)) (n-nid st))
           (assert-eq (looptree-depth-of fun) 0)
           (assert-eq (looptree-depth-of ret) 0)))

(deftest loop_tree_marks_a_finite_loop_and_its_exit
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               fun (fun-make st (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "finite-loop")
               loop-node (loop-make fun)
               arms (if-arms! (if-make loop-node (con-make (ty-int-range 0 1))))
               back (arms-true arms)
               exit (arms-false arms)
               ret (return-make exit (None [(dyn NodeOps)]) (con-make (ty-int-con 0))
                                (None [(dyn NodeOps)]) (Some fun))
               stop (stop-make)]
           (loop-close! loop-node back)
           (n-set-ty! loop-node TY-CTRL)
           (fun-set-ret! fun ret)
           (stop-add-return! stop ret)
           (looptree-build! st stop)
           (assert-eq (n-nid (looptree-loop-of loop-node)) (n-nid loop-node))
           (assert-eq (looptree-depth-of loop-node) 1)
           (assert-eq (n-nid (looptree-loop-of back)) (n-nid loop-node))
           (assert-eq (looptree-depth-of back) 1)
           (assert-eq (n-nid (looptree-loop-of exit)) (n-nid st))
           (assert-eq (looptree-depth-of exit) 0)))

(deftest loop_tree_nests_inner_loop_and_keeps_outer_exit_at_the_function_root
         (boot! 1)
         (let [start (start-make (ty-int-bot))
               fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "nested-loop")
               outer (loop-make fun)
               outer-arms (if-arms! (if-make outer (con-make (ty-int-range 0 1))))
               inner (loop-make (arms-true outer-arms))
               inner-arms (if-arms! (if-make inner (con-make (ty-int-range 0 1))))
               ret
                 (return-make (arms-false outer-arms)
                              (None [(dyn NodeOps)])
                              (con-int 42)
                              (None [(dyn NodeOps)])
                              (Some fun))
               stop (stop-make)]
           (loop-close! inner (arms-true inner-arms))
           (loop-close! outer (arms-false inner-arms))
           (n-set-ty! inner TY-CTRL)
           (n-set-ty! outer TY-CTRL)
           (fun-set-ret! fun ret)
           (stop-add-return! stop ret)
           (looptree-build! start stop)
           (assert-eq (n-ltree-parent inner) (n-nid outer))
           (assert-eq (n-ltree-parent outer) (n-nid start))
           (assert-eq (n-nid (looptree-loop-of (arms-true inner-arms))) (n-nid inner))
           (assert-eq (n-nid (looptree-loop-of (arms-false inner-arms))) (n-nid outer))
           (assert-eq (n-nid (looptree-loop-of (arms-false outer-arms))) (n-nid start))))

(deftest loop_tree_forces_an_aligned_never_exit_for_a_truly_infinite_loop
         (boot! 1)
         (let [start (start-make (ty-int-bot))
               stop (stop-make)
               fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "infinite")
               loop-node (loop-make fun)
               mem (proj-make start 1 "infinite.start.mem")
               ret
                 (return-make (xctrl-make)
                              (Some mem)
                              (con-int 0)
                              (None [(dyn NodeOps)])
                              (Some fun))]
           (loop-close! loop-node loop-node)
           (fun-set-ret! fun ret)
           (stop-add-return! stop ret)
           (looptree-build! start stop)
           (let [back (n-in! loop-node 2)
                 never (n-in! back 0)]
             (assert-eq (n-op back) OP-CPROJ)
             (assert-eq (n-op never) OP-NEVER)
             (assert-eq (cproj-idx back) IF-TRUE-IDX)
             (assert-eq (n-op (n-in! ret RETURN-CTRL)) OP-CPROJ)
             (assert-eq (cproj-idx (n-in! ret RETURN-CTRL)) IF-FALSE-IDX)
             (assert-eq (n-op (n-in! ret RETURN-MEM)) OP-MEMMERGE)
             (assert-eq (n-ty (n-in! ret RETURN-VALUE)) TY-TOP)
             (assert-eq (n-ltree-parent loop-node) (n-nid start)))))

(deftest gcm_rpo_records_selected_control_and_assigns_block_heads
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "rpo")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 arg (parm-make fun 0 (ty-int-bot) "x")
                 value (add-make arg (con-make (ty-int-con 5000)))
                 ret (return-make fun
                                  (Some (con-make (ty-mem 1 TY-BOT)))
                                  value
                                  (Some rpc)
                                  (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (assert-eq (code-cfg-count) 4)
               (assert (n-same? (code-cfg-at 0) selected-start))
               (assert (n-same? (code-cfg-at 1) selected-fun))
               (assert (n-same? (code-cfg-at 2) selected-ret))
               (assert (n-same? (code-cfg-at 3) selected-stop))
               (assert-eq (n-block-nid selected-start) (n-nid selected-start))
               (assert-eq (n-block-nid selected-fun) (n-nid selected-fun))
               (assert-eq (n-block-nid selected-ret) (n-nid selected-fun))
               (assert-eq (n-block-nid selected-stop) (n-nid selected-stop))
               (let [selected-value (n-in! selected-ret RETURN-VALUE)
                     selected-arg (n-in! selected-value 1)
                     selected-one (n-in! selected-value 2)]
                 (assert-eq (n-block-nid selected-arg) (n-nid selected-fun))
                 (assert-eq (n-block-nid selected-one) (n-nid selected-fun))
                 (assert (n-same? (n-in! selected-one 0) selected-fun))
                 (assert-eq (n-block-nid selected-value) (n-nid selected-fun))
                 (assert (n-same? (n-in! selected-value 0) selected-fun)))))))

(deftest gcm_gives_each_function_a_private_copy_of_a_shared_constant
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
                 first (fun-make start sig "global-first")
                 second (fun-make start sig "global-second")
                 shared (con-make (ty-int-con 5000))
                 first-ret
                   (return-make first
                                (Some (con-make (ty-mem 1 TY-BOT)))
                                shared
                                (None [(dyn NodeOps)])
                                (Some first))
                 second-ret
                   (return-make second
                                (Some (con-make (ty-mem 1 TY-BOT)))
                                shared
                                (None [(dyn NodeOps)])
                                (Some second))
                 stop (stop-make)]
             (fun-set-ret! first first-ret)
             (fun-set-ret! second second-ret)
             (stop-add-return! stop first-ret)
             (stop-add-return! stop second-ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-first-ret (n-in! selected-stop 0)
                   selected-second-ret (n-in! selected-stop 1)
                   selected-first (n-in! selected-first-ret RETURN-CTRL)
                   selected-second (n-in! selected-second-ret RETURN-CTRL)
                   selected-start (n-in! selected-first 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (let [first-value (n-in! selected-first-ret RETURN-VALUE)
                     second-value (n-in! selected-second-ret RETURN-VALUE)]
                 (assert (not (n-same? first-value second-value)))
                 (assert (n-same? (n-in! first-value 0) selected-first))
                 (assert (n-same? (n-in! second-value 0) selected-second))
                 (assert-eq (n-block-nid first-value) (n-nid selected-first))
                 (assert-eq (n-block-nid second-value) (n-nid selected-second)))))))

(deftest gcm_phi_use_is_on_predecessor_edges_not_in_the_merge_block
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "phi-use")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 pred (parm-make fun 0 (ty-int-bot) "condition")
                 arms (if-arms! (if-make fun pred))
                 region (region-make)
                 shared (con-make (ty-int-con 5000))]
             (region-add-path! region (arms-true arms))
             (region-add-path! region (arms-false arms))
             (let [phi (phi-make region (ty-int-bot) "merged")]
               (phi-add-value! phi shared)
               (phi-add-value! phi shared)
               (let [ret (return-make region
                                      (Some (con-make (ty-mem 1 TY-BOT)))
                                      phi
                                      (Some rpc)
                                      (Some fun))
                     stop (stop-make)]
                 (fun-set-ret! fun ret)
                 (stop-add-return! stop ret)
                 (looptree-build! start stop)
                 (let [selected-stop (arm64-select-graph stop)
                       selected-ret (n-in! selected-stop 0)
                       selected-phi (n-in! selected-ret RETURN-VALUE)
                       selected-region (n-in! selected-phi 0)
                       selected-shared (n-in! selected-phi 1)
                       selected-fun
                         (n-in! (n-in! (n-in! selected-region 1) 0) 0)
                       selected-start (n-in! selected-fun 1)]
                   (code-set-roots! selected-start selected-stop)
                   (gcm-build-cfg!)
                   (let [use-block (gcm-use-block selected-shared selected-phi)]
                     (assert (n-same? use-block selected-fun))
                     (assert (not (n-same? use-block selected-region))))))))))

(deftest gcm_repeated_phi_values_do_not_rescan_all_arms_for_each_use_edge
  (boot! 1)
  (code-reset! 1)
  (let [start (start-make (ty-int-bot))
        fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "wide-phi")
        rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
        pred (parm-make fun 0 (ty-int-bot) "condition")
        region (region-make)
        shared (con-int 5000)
        phi (phi-make region (ty-int-bot) "merged")
        (mut ctrl) (load fun)
        (mut i) 0]
    (loop (if (= (load i) 256) (break 0)
      (let [arms (if-arms! (if-make (load ctrl) pred))]
        (region-add-path! region (arms-false arms))
        (phi-add-value! phi shared)
        (set! (mut ctrl) (arms-true arms))
        (set! (mut i) (+ (load i) 1)) (continue))))
    (region-add-path! region (load ctrl))
    (phi-add-value! phi (con-int 6000))
    (let [ret (return-make region (Some (con-make (ty-mem 1 TY-BOT)))
                           phi (Some rpc) (Some fun))
          stop (stop-make)]
      (fun-set-ret! fun ret)
      (stop-add-return! stop ret)
      (looptree-build! start stop)
      (let [selected-stop (arm64-select-graph stop)
            selected-ret (n-in! selected-stop 0)
            selected-phi (n-in! selected-ret RETURN-VALUE)
            selected-region (n-in! selected-phi 0)
            selected-shared (n-in! selected-phi 1)
            selected-fun (n-in! (n-in! (n-in! selected-region 1) 0) 0)
            selected-start (n-in! selected-fun 1)]
        (code-set-roots! selected-start selected-stop)
        (gcm-build-cfg!)
        (assert (n-same? (gcm-node-block selected-shared) selected-fun))
        ;; Count semantic arm inspections, not wall time: 256 copies of the same
        ;; Phi use must not each trigger another full 257-arm scan.
        (assert (< (.phi-arms (gcm-late-stats)) 2048))
        ;; Marks cannot suppress a subsequent query for the same definition.
        (assert (match (gcm-late-lca selected-shared)
                  (Some [where] (n-same? where selected-fun)) (None [] false)))
        (assert (match (gcm-late-lca selected-shared)
                  (Some [where] (n-same? where selected-fun)) (None [] false)))))))

(deftest gcm_loop_phi_region_is_published_before_both_backedge_values_are_scheduled_early
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "loop-phi-early")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 loop-node (loop-make fun)
                 value (phi-make loop-node (ty-int-bot) "value")
                 count (phi-make loop-node (ty-int-bot) "count")]
             (phi-add-value! value (con-make (ty-int-con 10)))
             (phi-open! value)
             (phi-add-value! count (con-make (ty-int-con 1)))
             (phi-open! count)
             (let [arms (if-arms! (if-make loop-node count))
                   back (arms-true arms)
                   exit (arms-false arms)
                   next-value (add-make value (con-make (ty-int-con 1)))
                   next-count (sub-make count (con-make (ty-int-con 1)))
                   ret (return-make exit
                                    (Some (con-make (ty-mem 1 TY-BOT)))
                                    value
                                    (Some rpc)
                                    (Some fun))
                   stop (stop-make)]
               (loop-close! loop-node back)
               (phi-close! value next-value)
               (phi-close! count next-count)
               (fun-set-ret! fun ret)
               (stop-add-return! stop ret)
               (looptree-build! start stop)
               (let [selected-stop (arm64-select-graph stop)
                     selected-ret (n-in! selected-stop 0)
                     selected-value (n-in! selected-ret RETURN-VALUE)
                     selected-loop (n-in! selected-value 0)
                     selected-back (n-in! selected-loop 2)
                     selected-if (n-in! selected-back 0)
                     selected-count (n-in! (n-in! selected-if 1) 1)
                     selected-next-value (n-in! selected-value 2)
                     selected-next-count (n-in! selected-count 2)
                     selected-fun (n-in! selected-loop 1)
                     selected-start (n-in! selected-fun 1)]
                 (code-set-roots! selected-start selected-stop)
                 ;; Schedule a consumer before visiting its Phi. Simple's structural cfg0 query
                 ;; already knows the Region; cached placement must expose the same fact without
                 ;; following the backedge. This order occurs with nested-loop shared consumers.
                 (gcm-rpo!)
                 (let [(mut seen) (al-new [bool] (alloc/malloc-allocator)) (mut i) 0]
                   (loop (if (> (load i) (arena-node-count))
                             (break 0)
                             (do (push! [bool] (mut seen) false)
                                 (set! (mut i) (+ (load i) 1)) (continue))))
                   (gcm-schedule-early-node! selected-next-value (mut seen))
                   (assert-eq (n-early-nid selected-next-value) (n-nid selected-loop))
                   (assert (not (get (load seen) (n-nid selected-value))))
                   (al-free! [bool] (mut seen)))
                 (gcm-build-cfg!)
                 ;; Both loop-carried definitions consume a Phi. Their earliest legal block is the
                 ;; Loop, never the function entry; their only late use is the true predecessor edge.
                 (assert-eq (n-early-nid selected-next-value) (n-nid selected-loop))
                 (assert-eq (n-early-nid selected-next-count) (n-nid selected-loop))
                 (assert-eq (n-block-nid selected-next-value) (n-nid selected-back))
                 (assert-eq (n-block-nid selected-next-count) (n-nid selected-back))
                 (assert (n-same? (gcm-use-block selected-next-value selected-value)
                                  selected-back))
                 (assert (n-same? (gcm-use-block selected-next-count selected-count)
                                  selected-back))
                 (assert (not (n-same? (gcm-node-block selected-next-value) selected-fun)))
                 (assert (not (n-same? (gcm-node-block selected-next-count) selected-fun))))))))

(deftest gcm_adds_an_antidependence_when_a_same_alias_store_shares_the_load_block
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 object-ty (ty-struct "AntiObject")
                 pointer-ty (ty-memptr false object-ty)
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) pointer-ty) "anti")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 pointer (parm-make fun 0 pointer-ty "object")
                 memory (con-make (ty-mem 7 TY-BOT))
                 offset (con-make (ty-int-con 0))
                 load_ (load-make fun memory pointer offset 7 (ty-int-bot))
                 store (store-make fun
                                   memory
                                   pointer
                                   offset
                                   (con-make (ty-int-con 9))
                                   7
                                   (ty-int-bot))
                 ret (return-make fun (Some store) load_ (Some rpc) (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-store (n-in! selected-ret RETURN-MEM)
                   selected-load (n-in! selected-ret RETURN-VALUE)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (assert-eq (n-block-nid selected-load) (n-nid selected-fun))
               (assert-eq (n-block-nid selected-store) (n-nid selected-fun))
               (assert (n-has? (.ins (hdr selected-store)) selected-load))))))

(deftest gcm_raises_loads_above_memphi_arms_without_adding_a_phi_input
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 object-ty (ty-struct "MemPhiAntiObject")
                 pointer-ty (ty-memptr false object-ty)
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) pointer-ty) "memphi-anti")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 pointer (parm-make fun 0 pointer-ty "object")
                 pred (parm-make fun 1 (ty-int-bot) "condition")
                 arms (if-arms! (if-make fun pred))
                 region (region-make)
                 memory (con-make (ty-mem 7 TY-BOT))
                 other-memory (con-make (ty-mem 7 TY-BOT))
                 offset (con-make (ty-int-con 0))
                 load_ (load-make fun memory pointer offset 7 (ty-int-bot))]
             (region-add-path! region (arms-true arms))
             (region-add-path! region (arms-false arms))
             (let [memory-phi (memphi-make region 7 TY-BOT "memory")]
               (memphi-add-state! memory-phi memory)
               (memphi-add-state! memory-phi other-memory)
               (let [ret (return-make region (Some memory-phi) load_ (Some rpc) (Some fun))
                     stop (stop-make)]
                 (fun-set-ret! fun ret)
                 (stop-add-return! stop ret)
                 (looptree-build! start stop)
                 (let [selected-stop (arm64-select-graph stop)
                       selected-ret (n-in! selected-stop 0)
                       selected-memory-phi (n-in! selected-ret RETURN-MEM)
                       selected-load (n-in! selected-ret RETURN-VALUE)
                       selected-region (n-in! selected-memory-phi 0)
                       selected-fun (n-in! (n-in! (n-in! selected-region 1) 0) 0)
                       selected-start (n-in! selected-fun 1)]
                   (code-set-roots! selected-start selected-stop)
                   (gcm-build-cfg!)
                   (assert-eq (n-nins selected-memory-phi) 3)
                   (assert (not (n-has? (.ins (hdr selected-memory-phi)) selected-load)))
                   (assert
                     (not
                       (n-same? (gcm-use-block (n-in! selected-memory-phi 1)
                                               selected-memory-phi)
                                selected-region)))))))))

(deftest gcm_does_not_reparent_a_global_with_an_unowned_non_global_user
         (do
           (boot! 2)
           (code-reset! 2)
           (let [ideal-start (start-make (ty-int-bot))
                 ideal-fun
                   (fun-make ideal-start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "owner")
                 selected-start (arm64-select ideal-start)
                 selected-fun (arm64-select ideal-fun)
                 global (arm64-select (con-int 17))
                 owned (arm64-select (add-make (con-int 1) (con-int 2)))
                 unowned (arm64-select (add-make (con-int 3) (con-int 4)))]
             (code-set-roots! selected-start selected-start)
             (n-add-def! global (Some selected-start))
             (gcm-clear-clone-inputs! owned)
             (n-add-def! owned (Some selected-fun))
             (n-add-def! owned (Some global))
             (n-add-def! owned (Some global))
             (n-set-block-nid! selected-fun (n-nid selected-fun))
             (n-set-block-nid! owned (n-nid selected-fun))
             (gcm-clear-clone-inputs! unowned)
             (n-add-def! unowned (None [(dyn NodeOps)]))
             (n-add-def! unowned (Some global))
             (n-add-def! unowned (Some global))
             (assert (gcm-start-pinned-global? global))
             (assert (not (gcm-global-users-splittable? global)))
             (gcm-break-up-global! global)
             ;; Simple returns without splitting here. Moving the definition under `owner` would
             ;; leave the unresolved user outside the definition's dominance region.
             (assert (n-same? (n-in! global 0) selected-start)))))

(deftest selected_box_preserves_its_function_control_through_gcm
         (do
           (boot! 3)
           (code-reset! 3)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-dyn TAG-INT)) "box-owner")
                 boxed (box-make-at (Some fun) (con-int 7))
                 ret
                   (return-make fun
                                (Some (con-make (ty-mem 1 TY-BOT)))
                                boxed
                                (None [(dyn NodeOps)])
                                (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-box (n-in! selected-ret RETURN-VALUE)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (assert-eq (gcm-ideal-op selected-box) OP-BOX)
               (assert (n-same? (n-in! selected-box 0) selected-fun))
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (assert-eq (n-block-nid selected-box) (n-nid selected-fun))))))

(deftest gcm_fixed_flags_do_not_hoist_above_the_loop_branch_that_constrains_them
         (do
           (boot! 5)
           (code-reset! 5)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "flag-loop")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 arg (parm-make fun 0 (ty-int-bot) "x")
                 loop-node (loop-make fun)
                 predicate (cmp--make OP-LT arg (con-int 9) MODE-INT)
                 arms (if-arms! (if-make loop-node predicate))
                 back (arms-true arms)
                 exit (arms-false arms)]
             (loop-close! loop-node back)
             (let [ret (return-make exit
                                    (Some (con-make (ty-mem 1 TY-BOT)))
                                    arg
                                    (Some rpc)
                                    (Some fun))
                   stop (stop-make)]
               (fun-set-ret! fun ret)
               (stop-add-return! stop ret)
               (looptree-build! start stop)
               (let [selected-stop (arm64-select-graph stop)
                     selected-ret (n-in! selected-stop 0)
                     selected-exit (n-in! selected-ret RETURN-CTRL)
                     selected-branch (n-in! selected-exit 0)
                     selected-flags (n-in! selected-branch 1)
                     selected-loop (n-in! selected-branch 0)
                     selected-fun (n-in! selected-loop 1)
                     selected-start (n-in! selected-fun 1)]
                 (code-set-roots! selected-start selected-stop)
                 (gcm-build-cfg!)
                 (assert-eq (gcm-ideal-op selected-flags) OP-LT)
                 ;; The operands are loop invariant, so frequency alone would hoist this compare to
                 ;; Fun. Its FLAGS result is fixed, and the loop branch consumes FLAGS; final Simple
                 ;; makes that constrained CFG use the lower bound for hoisting.
                 (assert-eq (n-block-nid selected-flags) (n-nid selected-loop)))))))

(deftest gcm_late_work_is_linear_in_a_deep_use_chain
         (do
           (boot! 7)
           (code-reset! 7)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "late-chain")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 arg (parm-make fun 0 (ty-int-bot) "x")
                 step (con-int 5000)
                 value (gcm-test-add-chain arg step 128)]
             (let [ret (return-make fun
                                    (Some (con-make (ty-mem 1 TY-BOT)))
                                    value
                                    (Some rpc)
                                    (Some fun))
                   stop (stop-make)]
               (fun-set-ret! fun ret)
               (stop-add-return! stop ret)
               (looptree-build! start stop)
               (let [selected-stop (arm64-select-graph stop)
                     selected-ret (n-in! selected-stop 0)
                     selected-fun (n-in! selected-ret RETURN-CTRL)
                     selected-start (n-in! selected-fun 1)]
                 (code-set-roots! selected-start selected-stop)
                 (gcm-build-cfg!)
                 ;; A whole-arena pass per dependency layer is quadratic here. Stop-seeded,
                 ;; last-use-triggered scheduling visits the chain only a small constant number of
                 ;; times, including its pinned control/value leaves.
                 (assert (< (gcm-last-late-pops) 512))
                 (assert (< (gcm-last-late-pushes) 512)))))))
