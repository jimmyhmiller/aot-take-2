;; Bitwise operators and shifts.

;;
;; In JavaScript `a & b` is `ToInt32(a) & ToInt32(b)` — the coercion is the semantics and lives in
;; JSL. THESE nodes are the machine operation that JSL definition bottoms out in.
(module aot.tests.bits)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.bits" :use *)
(import "aot.type.type" :use *)

(deftest highest_one_bit_uses_clz
         ;; `clz` returns the WIDTH for zero, so the zero case is the only guard needed.
         (boot! 1)
         (assert-eq (highest-one-bit 0) 0)
         (assert-eq (highest-one-bit 1) 1)
         (assert-eq (highest-one-bit 8) 8)
         (assert-eq (highest-one-bit 9) 8)
         (assert-eq (highest-one-bit 255) 128))

(deftest the_mask_of_a_range_covers_every_value_in_it
         ;; Simple's `TypeInteger.mask()`. This is what makes `x & 0xFF` produce `[0..255]` rather than the
         ;; integer bottom, and it is why `And` is the one operator with a real range rule.
         (boot! 1)
         (assert-eq (ty-int-mask (ty-int-con 12)) 12)
         ;; [0..255] can have any of the low 8 bits set.
         (assert-eq (ty-int-mask (ty-int-range 0 255)) 255)
         ;; [8..9] differ only in bit 0, and both have bit 3 — so the mask is 0b1001.
         (assert-eq (ty-int-mask (ty-int-range 8 9)) 9)
         ;; A high type can have no bits.
         (assert-eq (ty-int-mask (ty-dual (ty-int-bot))) 0))

(deftest and_sharpens_a_range_through_its_mask
         (boot! 1)
         ;; Anything AND 0xFF fits in [0..255], even from the integer bottom.
         (assert-eq (bits-compute-ty OP-AND (ty-int-bot) (ty-int-con 255)) (ty-int-range 0 255))
         (assert-eq (bits-compute-ty OP-AND (ty-int-con 12) (ty-int-con 10)) (ty-int-con 8)))

(deftest or_and_xor_say_nothing_about_ranges
         ;; Simple returns BOT for both, and copying that weakness is the point: a range rule that is almost
         ;; right is worse than one that says nothing.
         (boot! 1)
         (assert-eq (bits-compute-ty OP-OR (ty-int-range 0 15) (ty-int-range 0 15)) (ty-int-bot))
         (assert-eq (bits-compute-ty OP-XOR (ty-int-range 0 15) (ty-int-range 0 15)) (ty-int-bot))
         ;; But two constants still fold exactly.
         (assert-eq (bits-compute-ty OP-OR (ty-int-con 12) (ty-int-con 3)) (ty-int-con 15))
         (assert-eq (bits-compute-ty OP-XOR (ty-int-con 12) (ty-int-con 10)) (ty-int-con 6)))

(deftest a_logical_right_shift_does_not_sign_extend
         ;; Coil picks the machine instruction from the TYPE: `ishr` on `u64` is logical. `>>>` in
         ;; JavaScript is the unsigned one, and getting it wrong turns -1 into -1 rather than 2^64-1.
         (boot! 1)
         (assert-eq (bits-compute-ty OP-SHR (ty-int-con -8) (ty-int-con 1))
                    (ty-int-con 9223372036854775804))
         ;; Whereas the arithmetic shift keeps the sign.
         (assert-eq (bits-compute-ty OP-SAR (ty-int-con -8) (ty-int-con 1)) (ty-int-con -4)))

(deftest internal_i64_shift_counts_are_modulo_64
         (boot! 1)
         (assert-eq (bits-compute-ty OP-SHR (ty-int-con 1) (ty-int-con 64)) (ty-int-con 1))
         (assert-eq (bits-compute-ty OP-SAR (ty-int-con -8) (ty-int-con 65)) (ty-int-con -4)))

(deftest sar_by_a_constant_gives_the_exact_reachable_range
         ;; `>> log` leaves `64-log` significant bits, sign-extended.
         (boot! 1)
         (assert-eq (bits-compute-ty OP-SAR (ty-int-bot) (ty-int-con 1))
                    (ty-int-range -4611686018427387904 4611686018427387903)))

(deftest the_identities_fire_after_the_mode_settles
         (boot! 1)
         (let [x (con-make (ty-int-range 0 100))]
           ;; x & -1 -> x
           (let [n (and-make x (con-int -1))]
             (n-peephole-opt! n)  ; settles the mode
             (assert (match (n-peephole-opt! n) (Some [r] (n-same? r x)) (None [] false))))
           ;; x | 0 -> x
           (let [n2 (or-make x (con-int 0))]
             (n-peephole-opt! n2)
             (assert (match (n-peephole-opt! n2) (Some [r] (n-same? r x)) (None [] false))))
           ;; x ^ 0 -> x
           (let [n3 (xor-make x (con-int 0))]
             (n-peephole-opt! n3)
             (assert (match (n-peephole-opt! n3) (Some [r] (n-same? r x)) (None [] false))))))

(deftest only_the_commutative_operators_sink_their_constant
         ;; A shift is NOT commutative: swapping its operands changes the meaning entirely.
         (boot! 1)
         (let [x (con-make (ty-int-range 0 100))
               a (and-make (con-int 12) x)]
           (n-peephole-opt! a)
           (assert (match (n-peephole-opt! a) (Some [r] (n-same? r a)) (None [] false)))
           (assert (ty-constant? (n-ty (n-in! a 2)))))
         (let [x2 (con-make (ty-int-range 0 100))
               s (shr-make (con-int 12) x2)]
           (n-peephole-opt! s)
           ;; No swap: the constant stays on the left where it belongs.
           (assert (ty-constant? (n-ty (n-in! s 1))))))

(deftest the_operator_participates_in_gvn
         (boot! 1)
         (let [x (con-make (ty-int-range 0 100))
               y (con-make (ty-int-range 0 100))
               a (and-make x y)
               o (or-make x y)]
           (assert (not (n-gvn-eq? a o)))
           (assert-ne (n-gvn-hash a) (n-gvn-hash o))))
