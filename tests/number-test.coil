(module aot.tests.number)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "aot.rt.number" :use *)

;; StringToNumber over a trimmed ASCII spelling (ECMA-262 §7.1.4.1.1): the decimal, `Infinity`
;; and radix productions, and NaN for every spelling outside the grammar that libc's `strtod`
;; would otherwise accept.
(deftest string_to_number_follows_the_string_numeric_literal_grammar
         (do
           (assert (primitive/fcmp-eq (number-string-to-number "42") (primitive/cast f64 42)))
           (assert (primitive/fcmp-eq (number-string-to-number "") (primitive/cast f64 0)))
           (assert (primitive/fcmp-eq (number-string-to-number "12.5e1") (primitive/cast f64 125)))
           (assert (primitive/fcmp-eq (number-string-to-number ".5") (number-from-bits 4602678819172646912)))
           (assert (primitive/fcmp-eq (number-string-to-number "+.5") (number-from-bits 4602678819172646912)))
           (assert (primitive/fcmp-eq (number-string-to-number "-7") (primitive/cast f64 -7)))
           (assert (primitive/fcmp-eq (number-string-to-number "0x1F") (primitive/cast f64 31)))
           (assert (primitive/fcmp-eq (number-string-to-number "0B101") (primitive/cast f64 5)))
           (assert (primitive/fcmp-eq (number-string-to-number "0o17") (primitive/cast f64 15)))
           (assert (primitive/fcmp-eq (number-string-to-number "Infinity") (number-infinity)))
           (assert (primitive/fcmp-eq (number-string-to-number "-Infinity") (- (primitive/cast f64 0) (number-infinity))))
           ;; NaN is not equal to itself: test the bits.
           (assert-eq (number-bits (number-string-to-number "abc")) NUMBER-NAN-BITS)
           (assert-eq (number-bits (number-string-to-number "infinity")) NUMBER-NAN-BITS)
           (assert-eq (number-bits (number-string-to-number "1e")) NUMBER-NAN-BITS)
           (assert-eq (number-bits (number-string-to-number "1_000")) NUMBER-NAN-BITS)
           (assert-eq (number-bits (number-string-to-number "0x")) NUMBER-NAN-BITS)
           (assert-eq (number-bits (number-string-to-number "-0x10")) NUMBER-NAN-BITS)
           (assert-eq (number-bits (number-string-to-number "0x1p3")) NUMBER-NAN-BITS)
           (assert-eq (number-bits (number-string-to-number "1.")) (number-bits (primitive/cast f64 1)))
           (assert-eq (number-bits (number-string-to-number ".")) NUMBER-NAN-BITS)
           ;; Exact rounding of a long radix spelling: 2^53 + 1 rounds to 2^53 (ties to even).
           (assert (primitive/fcmp-eq (number-string-to-number "0x20000000000001") (primitive/cast f64 9007199254740992)))))

;; A Number's NaN-box word: compact integers for integral values in the signed 48-bit range, raw
;; binary64 bits for everything else, and -0 is never compact.
(deftest number_words_are_compact_integers_or_raw_doubles
         (do
           (assert-eq (number-word (primitive/cast f64 7)) 0x7ff9000000000007)
           (assert-eq (number-word (primitive/cast f64 -1)) 0x7ff9ffffffffffff)
           (assert-eq (number-word (number-from-bits 4602678819172646912)) 4602678819172646912)
           (assert-eq (number-word (number-from-bits -9223372036854775808)) -9223372036854775808)
           (assert-eq (number-word (number-infinity)) NUMBER-INFINITY-BITS)
           (assert-eq (number-word (primitive/cast f64 140737488355328)) (number-bits (primitive/cast f64 140737488355328)))))
