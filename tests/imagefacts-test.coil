;; The closed-world image facts (aot.node.imagefacts, aot.facts): what the program can do to each

;; image object, computed once the world is closed and read by the property folds.
(module aot.tests.imagefacts)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.assert" :use *)
(import "aot.heap" :use *)
(import "aot.shape" :use *)
(import "aot.facts" :use *)
(import "aot.codegen.pipeline" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use [proj-make])
(import "aot.node.call" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.jsops" :use *)
(import "aot.node.memory" :use [ALIAS-BULK])
(import "aot.node.imagefacts" :use *)
(import "aot.type.type" :use *)

(deftest sparse_named_writes_preserve_identity_flags_and_rescan_counts
         (boot! 1)
         (facts-begin! 65536 65536)
         (assert (facts-mark-written! 65535 65536))
         (assert (not (facts-mark-written! 65535 65536)))
         (assert-eq (.written-count (facts-table)) 1)
         (assert-eq (len (get (.written (facts-table)) 65535)) 1)
         (assert (facts-written? 65535 65536))
         (assert (not (facts-written? 65534 65536)))
         (assert (not (facts-written? 65535 65535)))
         (assert (not (facts-written? 65535 65537)))
         (facts-mark-escaped! 2)
         (facts-mark-unknown-owner-key! 42)
         (assert (facts-written? 2 42))
         (assert (not (facts-written? 3 42)))
         (facts-mark-any-key! 3)
         (assert (facts-written? 3 65537))
         (facts-finish!)
         (assert-eq (facts-signature) 4)
         (facts-reopen!)
         (facts-begin! 4 42)
         (facts-finish!)
         (assert-eq (facts-signature) 0)
         (assert (not (facts-written? 2 42))))

(deftest lexical_storage_escapes_image_values_and_reads_have_unknown_object_identity
         (boot! 1)
         (let [owner (heap-add-object! DYNAMIC-NULL-WORD)
               key (shape-key-intern "answer")
               ctrl (con-make TY-CTRL)
               initialize
                 (jsop-make ctrl
                            (con-make (ty-mem ALIAS-BULK TY-BOT))
                            JS-GLOBAL-LEXICAL-INITIALIZE)]
           (jsop-add-arg! initialize (con-int 1))
           (jsop-add-arg! initialize
                          (box-make (staticref-make owner REP-OBJECT)))
           (let [read
                   (jsop-make ctrl
                              (proj-make initialize 1 "initialized.memory")
                              JS-GLOBAL-LEXICAL-VALUE)]
             (jsop-add-arg! read (con-int 1))
             (let [value (proj-make read 2 "lexical.value")
                   write
                     (jsop-make ctrl
                                (proj-make read 1 "read.memory")
                                JS-PROP-SET-OWN)]
               (jsop-add-arg! write value)
               (jsop-add-arg! write (keyref-make key))
               (jsop-add-arg! write (box-make (con-int 42)))
               (n-keep! write)
               (imagefacts-compute!)
               (assert (facts-escaped? owner))
               (assert (scan--top? (n-nid value)))
               (assert (facts-written? owner key))))))

(deftest opaque_callbacks_apply_external_effects_without_a_symbol_declaration
         (boot! 1)
         (let [owner (heap-add-object! DYNAMIC-NULL-WORD)
               key (shape-key-intern "answer")
               (mut empty) (al-new [i64] (alloc/malloc-allocator))
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               c
                 (call-make-with-mem (con-make TY-CTRL)
                                     (con-make (ty-mem 1 TY-BOT)))]
           (call-add-arg! c (con-int 7))
           (call-set-fptr! c
                           (con-make (ty-funptr-boundary sig
                                                         (fidx-set-intern (al-slice (load empty)))
                                                         true)))
           (n-keep! (callend-make c))
           (imagefacts-compute!)
           (assert-eq (call-external-target-count c) 0)
           (assert (facts-escaped? owner))
           (assert (facts-written? owner key))
           (assert (facts-prototypes-written?))
           (assert (facts-descriptors?))
           (al-free! (mut empty))))

(deftest incoming_mutation_boundary_survives_recomputation_without_local_stores
         (boot! 1)
         (let [owner (heap-add-object! DYNAMIC-NULL-WORD)
               key (shape-key-intern "answer")]
           (heap-define-own-attrs! owner
                                   "answer"
                                   42
                                   HEAP-WORD-CONST
                                   SHAPE-ATTR-WRITABLE)
           (imagefacts-compute!)
           (assert (not (facts-written? owner key)))
           (facts-reopen!)
           (imagefacts-compute-with-boundary! true)
           (assert (facts-written? owner key))
           (assert (facts-escaped? owner))
           (assert (facts-prototypes-written?))
           (assert (facts-descriptors?))
           (facts-reopen!)
           (imagefacts-compute-with-boundary! true)
           (assert (facts-written? owner key))
           (assert (facts-prototypes-written?))
           (assert (facts-descriptors?))))

(deftest symbolic_property_keys_keep_precise_write_facts_without_integer_constant_types
         (boot! 1)
         (let [owner (heap-add-object! DYNAMIC-NULL-WORD)
               x (shape-key-intern "x")
               y (shape-key-intern "y")
               key (keyref-make x)
               operation
                 (jsop-make (con-make TY-CTRL)
                            (con-make (ty-mem ALIAS-BULK TY-BOT))
                            JS-PROP-SET-OWN)]
           (jsop-add-arg! operation
                          (box-make (staticref-make owner REP-OBJECT)))
           (jsop-add-arg! operation key)
           (jsop-add-arg! operation (box-make (con-int 42)))
           (n-keep! operation)
           (assert (not (ty-constant? (n-ty key))))
           (assert-eq (scan--key-operand key) x)
           (assert-eq (scan--key-operand (con-int x)) -1)
           (assert-eq (scan--key-operand (shaperef-make SHAPE-EMPTY)) -1)
           (imagefacts-compute!)
           (assert (facts-written? owner x))
           (assert (not (facts-written? owner y)))))

(deftest a_numeric_key_word_does_not_prove_a_unit_local_property_name
         (boot! 1)
         (let [owner (heap-add-object! DYNAMIC-NULL-WORD)
               x (shape-key-intern "x")
               y (shape-key-intern "y")
               operation
                 (jsop-make (con-make TY-CTRL)
                            (con-make (ty-mem ALIAS-BULK TY-BOT))
                            JS-PROP-SET-OWN)]
           (jsop-add-arg! operation
                          (box-make (staticref-make owner REP-OBJECT)))
           (jsop-add-arg! operation (con-int x))
           (jsop-add-arg! operation (box-make (con-int 42)))
           (n-keep! operation)
           (imagefacts-compute!)
           (assert (facts-written? owner x))
           (assert (facts-written? owner y))))

(deftest an_unsummarized_import_invalidates_realm_image_facts_without_object_arguments
         (boot! 1)
         (let [global (heap-add-object! 0)
               key (shape-key-intern "mutable")
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               target
                 (external-make (arena-declare-external! 41
                                                         "harness::mutateGlobal"
                                                         sig))
               c
                 (call-make-with-mem (con-make TY-CTRL)
                                     (con-make (ty-mem 1 TY-BOT)))]
           (heap-set-global! global)
           (call-add-arg! c (con-int 0))
           (call-set-fptr! c target)
           (n-keep! c)
           (imagefacts-compute!)
           (assert (facts-written? global key))
           (assert (facts-escaped? global))
           (assert (facts-prototypes-written?))
           (assert (facts-descriptors?))))

(defn imagefacts-test-compile! [(source (slice u8))] (-> i64)
  (let [a (alloc/malloc-allocator)
        (mut sources) (al-new [(slice u8)] a)]
    (push! [(slice u8)] (mut sources) source)
    (let [answer
            (pipeline-compile-macho-sources! (load sources)
                                             "/tmp/aot-take-2-imagefacts.o"
                                             1
                                             true)]
      (al-free! [(slice u8)] (mut sources))
      answer)))

;; The image entry a global function declaration's object occupies.
(defn imagefacts-test-global-function [(name (slice u8))] (-> i64)
  (heap-ref-entry (heap-own-word (heap-global-entry) name)))

;; A store whose owner the analysis names writes exactly that pair. An object passed to a call
;; flows into the callee's parameter, so a store through the parameter names it too; nothing here
;; escapes, and an object the program never stores through keeps every other key.
(deftest named_and_parameter_owner_stores_mark_exactly_the_pairs_they_may_write
         (do
           (assert (> (imagefacts-test-compile! "function f() {}
                        f.a = 1;
                        function h(o) { o.b = 2; }
                        h(f);
                        function g() {}
                        g.c = 3;
                        var v = 4;
                        v = 5;")
                      0))
           (assert (facts-ready?))
           (let [f (imagefacts-test-global-function "f")
                 g (imagefacts-test-global-function "g")
                 global (heap-global-entry)
                 a (shape-key-intern "a")
                 b (shape-key-intern "b")
                 c (shape-key-intern "c")]
             ;; Whether f and g escape is not this test's question: `o.b = 2` passes its owner as the
             ;; receiver of the generic setter call, which reaches every function's `this`, and the
             ;; realm's ToPrimitive materializes `Object.prototype.valueOf`, which returns its receiver.
             ;; The pairs below stay exact because every store here names its owner.
             (assert (facts-written? f a))
             (assert (facts-written? f b))
             (assert (not (facts-written? f c)))
             (assert (not (facts-written? g a)))
             (assert (not (facts-written? g b)))
             (assert (facts-written? g c))
             ;; A Script's `var` initializer is a store on the global object; a hoisted function
             ;; declaration is image data, never stored.
             (assert (facts-written? global (shape-key-intern "v")))
             (assert (not (facts-written? global (shape-key-intern "f"))))
             (assert (not (facts-written? global (shape-key-intern "g"))))
             (assert (not (facts-prototypes-written?))))))

;; A read of an image property whose value is an object names that object exactly: a store through
;; it writes that object alone. `F.prototype` is the image prototype object of F.
(deftest a_read_of_an_image_property_names_its_object_for_later_stores
         (do
           (assert (> (imagefacts-test-compile! "function F() {}
                        function G() {}
                        F.prototype.m = function () { return 1; };")
                      0))
           (let [f (imagefacts-test-global-function "F")
                 g (imagefacts-test-global-function "G")
                 f-proto (heap-ref-entry (heap-own-word f "prototype"))
                 g-proto (heap-ref-entry (heap-own-word g "prototype"))
                 m (shape-key-intern "m")]
             (assert (facts-written? f-proto m))
             (assert (not (facts-written? g-proto m)))
             (assert (not (facts-escaped? g-proto)))
             (assert (not (facts-written? f (shape-key-intern "prototype")))))))

;; A store of a runtime key on a named owner writes every key of that owner and nothing else, the
;; owner reached through a parameter included.
(deftest runtime_keys_write_every_key_of_their_owner
         (do
           (assert (> (imagefacts-test-compile! "function f() {}
                        function g() {}
                        var k = 'a';
                        f[k] = 1;
                        function h(o) { o[k] = 2; }
                        h(g);
                        function u() {}")
                      0))
           (let [f (imagefacts-test-global-function "f")
                 g (imagefacts-test-global-function "g")
                 u (imagefacts-test-global-function "u")
                 a (shape-key-intern "a")]
             (assert (facts-written? f a))
             (assert (facts-written? f (shape-key-intern "prototype")))
             (assert (facts-written? g a))
             (assert (not (facts-written? u a))))))

;; The code index an image function entry's object calls.
(defn imagefacts-test-code-fidx [(entry i64)] (-> i64)
  (heap-entry-word entry HEAP-OFFSET-FUNCTION-CODE-WORD))

;; How many published code-word Loads can name `fidx`.
(defn imagefacts-test-loads-naming [(fidx i64)] (-> i64)
  (let [(mut n) 0]
    (hm-for [nid fidxs (.code-targets (facts-table))]
            (if (= (fidx-set-difference fidxs (fidx-set-single fidx)) fidxs)
                0
                (set! (mut n) (+ (load n) 1))))
    (load n)))

;; A function only ever called by name never escapes, so no call through a function VALUE — not the
;; generic paths `console.log` reaches for `valueOf` and `toString` — can be linked to it. A function
;; whose value escapes into an allocated array is a target of the calls whose pointer the analysis
;; cannot name, the one through `fs[0]` among them.
(deftest calls_through_function_values_name_only_escaped_or_allocated_functions
         (do
           (assert (> (imagefacts-test-compile! "function fib(n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); }
                        function g(x) { return x; }
                        var fs = [g];
                        console.log('fib ' + fib(10) + ' ' + fs[0](1));")
                      0))
           (assert (facts-ready?))
           (let [fib (imagefacts-test-global-function "fib")
                 g (imagefacts-test-global-function "g")]
             (assert (not (facts-escaped? fib)))
             (assert (facts-escaped? g))
             (assert (> (len (.code-targets (facts-table))) 0))
             (assert-eq (imagefacts-test-loads-naming (imagefacts-test-code-fidx fib))
                        0)
             (assert (> (imagefacts-test-loads-naming (imagefacts-test-code-fidx g))
                        0)))))
