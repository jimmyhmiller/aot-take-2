;; Compile-time budgets as gates (docs/COMPILE-TIME.md §7).
;;
;; Deterministic quantities are hard ceilings: the shape of the allocated program for a realm that
;; is a test262-style assertion harness plus one test. Wall time has a coarse ceiling whose only
;; job is to catch the four-hour campaign, not the millisecond. When a ceiling fires, the answer
;; is to find the volume, never to raise the number.
(module aot.tests.budget)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.assert" :use *)
(import "coil.time" :as time)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.pipeline" :use *)

(defn budget-harness [] (-> (slice u8))
  "function Test262Error(message) {
     if (!(this instanceof Test262Error)) return new Test262Error(message);
     this.message = message || '';
   }
   Test262Error.prototype.toString = function () { return 'Test262Error: ' + this.message; };
   Test262Error.thrower = function (message) { throw new Test262Error(message); };
   function assert(mustBeTrue, message) {
     if (mustBeTrue === true) { return; }
     if (message === undefined) { message = 'Expected true'; }
     throw new Test262Error(message);
   }
   assert._isSameValue = function (a, b) {
     if (a === b) { return a !== 0 || 1 / a === 1 / b; }
     return a !== a && b !== b;
   };
   assert.sameValue = function (actual, expected, message) {
     if (assert._isSameValue(actual, expected)) { return; }
     throw new Test262Error(message);
   };
   assert.throws = function (expectedErrorConstructor, func, message) {
     if (typeof func !== 'function') { throw new Test262Error('not a function'); }
     try { func(); } catch (thrown) {
       if (typeof thrown !== 'object' || thrown === null) { throw new Test262Error('not an object'); }
       if (thrown.constructor !== expectedErrorConstructor) { throw new Test262Error('wrong constructor'); }
       return;
     }
     throw new Test262Error('did not throw');
   };")

(defn budget-test [] (-> (slice u8))
  "var x = 1;
   assert.sameValue(x, 1, 'x');
   assert.sameValue(-0, -0, 'negative zeros');
   assert.throws(Test262Error, function () { throw new Test262Error('boom'); });
   assert(true);")

(defn budget-now-ms [] (-> i64)
  (try (let [ms (try-or! (time/monotonic-now-ms) 0)] ms)))

(deftest harness_realm_stays_within_the_compile_time_budgets
         (let [a (alloc/malloc-allocator)
               (mut sources) (al-new [(slice u8)] a)]
           (push! [(slice u8)] (mut sources) (budget-harness))
           (push! [(slice u8)] (mut sources) (budget-test))
           (let [started (budget-now-ms)
                 answer (pipeline-compile-macho-sources! (load sources) "/tmp/aot-take-2-budget.o" 1 true)
                 elapsed (- (budget-now-ms) started)]
             (assert (> answer 0))
             (println "budget: {} ms, {} machine nodes, {} blocks, {} rounds, {} callee-saves, {} casts"
                      elapsed (code-stat-machine-nodes) (code-stat-blocks) (code-stat-rounds)
                      (code-stat-callee-saves) (code-stat-casts))
             ;; A JavaScript frame preserves no registers: CalleeSaves exist only in the C-boundary
             ;; entry wrapper (docs/DECISIONS.md, the compile-time architecture, decision 1).
             (assert-eq (code-stat-callee-saves) 18)
             ;; A Cast is erased after scheduling; none reaches allocation.
             (assert-eq (code-stat-casts) 0)
             ;; Simple's expectation: a few rounds. Eight is its hard limit.
             (assert (<= (code-stat-rounds) 6))
             ;; Shape ceilings: generous over the honest size (2026-09-08: 5,649 nodes, 1,171 blocks,
             ;; 5 rounds, 99 ms), so ordinary growth never trips them; they catch a dispatch expanding
             ;; at every site or a splitter that stops converging.
             (assert (<= (code-stat-machine-nodes) 9000))
             (assert (<= (code-stat-blocks) 2600))
             ;; Ten times the budget of docs/COMPILE-TIME.md §1: the four-hour campaign, not the ms.
             (assert (<= elapsed 1000)))))
