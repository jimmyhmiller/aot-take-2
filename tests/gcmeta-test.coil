;; Stack maps are keyed to final return PCs and retain allocator GC kinds.
(module aot.tests.gcmeta)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-data])
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.call" :use *)
(import "aot.node.gc" :use *)
(import "aot.type.type" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.encoding" :use *)
(import "aot.codegen.gcmeta" :use *)
(import "aot.codegen.objfile" :use *)
(import "aot.rt.rt" :use *)
(import "aot.codegen.regalloc" :use *)
(import "aot.node.cpus.arm64" :use *)
(import "aot.node.cpus.arm64.call" :use *)
(import "aot.node.cpus.arm64.base" :use *)

(defn gc-test-u16 [(bytes (slice u8)) (offset i64)] (-> i64)
  (| (primitive/cast i64 (get bytes offset))
     (primitive/ishl (primitive/cast i64 (get bytes (+ offset 1))) 8)))

(defn gc-test-u32 [(bytes (slice u8)) (offset i64)] (-> i64)
  (| (gc-test-u16 bytes offset) (primitive/ishl (gc-test-u16 bytes (+ offset 2)) 16)))

(defn gc-test-contains? [(haystack (slice u8)) (needle (slice u8))] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop (if (or (load found) (> (+ (load i) (len needle)) (len haystack)))
              (break 0)
              (let [(mut j) 0 (mut same) true]
                (loop (if (or (>= (load j) (len needle)) (not (load same)))
                          (break 0)
                          (do
                            (if (!= (get haystack (+ (load i) (load j))) (get needle (load j)))
                                (set! (mut same) false)
                                0)
                            (set! (mut j) (+ (load j) 1))
                            (continue))))
                (if (load same) (set! (mut found) true) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

(deftest calls_receive_stack_maps_at_their_final_return_pc
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "maps"))
                 source (call-make (con-make TY-CTRL))
                 call (arm64-call-alloc source false true 71 4)]
             (arm64-call-set-symbol! call "callee")
             (arm64-fun-finalize-frame! fun 65 true)
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun fun)
             (code-schedule-add! fun call)
             (code-schedule-end-block! fun)
             (ra-reset-state! 0)
             (assert-eq (enc-layout!) 12)
             (assert-eq (enc-emit!) 12)
             (assert-eq (gc-build-stackmaps!) 1)
             (assert-eq (gc-stackmap-safepoint-nid 0) (n-nid call))
             (assert-eq (gc-stackmap-return-pc 0) 12)
             (assert-eq (gc-stackmap-slot-count 0) 0))))

(deftest stack_maps_retain_raw_reference_locations
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "typed.maps"))
                 source (call-make (con-make TY-CTRL))
                 call (arm64-call-alloc source false true 72 4)
                 ref (con-make (ty-memptr false (ty-struct "Managed")))
                 a (alloc/malloc-allocator)
                 (mut live) (al-new [i64] a)]
             (arm64-call-set-symbol! call "callee")
             (arm64-fun-finalize-frame! fun 65 true)
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun fun)
             (code-schedule-add! fun call)
             (code-schedule-end-block! fun)
             (assert-eq (enc-layout!) 12)
             (assert-eq (enc-emit!) 12)
             (ra-reset-state! 0)
             (let [lrg (ra-new-lrg! ref)]
               (n-set-reg! ref 65)
               ;; Stack-map construction reads the canonical LRG assignment, exactly as it does
               ;; after allocation. Keep the node annotation in sync because this focused test
               ;; constructs the allocated state directly instead of running the colourer.
               (set! (mut (.regs (ra-state))) lrg 65)
               (push! [i64] (mut live) 0)
               (push! [i64] (mut live) (n-nid ref))
               (gcmeta-reset!)
               (gc-record-stackmap! call (load live))
               (assert-eq (gc-stackmap-count) 1)
               (assert-eq (gc-stackmap-return-pc 0) 12)
               (assert-eq (gc-stackmap-slot-count 0) 1)
               (assert-eq (gc-stackmap-location 0 0) 0)
               (assert-eq (gc-stackmap-kind 0 0) SLOT-RAW-REF)
               (let [maps (gc-stackmap-bytes)]
                 (assert-eq (len maps) 56)
                 (assert (gc-test-contains? maps "AOTSMAP"))
                 (assert-eq (gc-test-u32 maps 8) 3)
                 (assert-eq (gc-test-u32 maps 12) 1)
                 (assert-eq (gc-test-u32 maps 16) (n-nid call))
                 (assert-eq (gc-test-u32 maps 24) 12)
                 (assert-eq (gc-test-u32 maps 32) 1)
                 (assert-eq (gc-test-u32 maps 48) 0)
                 (assert-eq (primitive/cast i64 (get maps 52)) SLOT-RAW-REF)
                 (let [record
                         (rt-stackmap-find (slice-data maps)
                                           (len maps)
                                           (n-nid call))]
                   (assert-eq record 16)
                   (assert-eq (rt-stackmap-slot-count (slice-data maps) record)
                              1)
                   (assert-eq (rt-stackmap-slot-location
                                (slice-data maps) record 0)
                              0)
                   (assert-eq (rt-stackmap-slot-kind
                                (slice-data maps) record 0)
                              SLOT-RAW-REF)
                   ;; The runtime consumes the exact serialized record, treats its location as a
                   ;; caller-SP-relative byte offset, and rewrites the root after moving the object.
                   (rt-heap-reset! 256)
                   (let [old (rt-alloc 8 9 0 0) root (primitive/alloc-stack i64)]
                     (set! root old)
                     (rt-collect-from-maps! (slice-data maps)
                                            (len maps)
                                            (n-nid call)
                                            (primitive/cast i64 root))
                     (assert (!= (load root) old))
                     (assert-eq (rt-payload-shape (load root)) 9))))
               (let [macho (macho-bytes) elf (elf-bytes)]
                 (assert-eq (gc-test-u32 macho 96) 2)
                 (assert (gc-test-contains? macho "__aot_stackmaps"))
                 (assert (gc-test-contains? macho "AOTSMAP"))
                 (assert-eq (gc-test-u16 elf 60) 7)
                 (assert-eq (gc-test-u16 elf 62) 6)
                 (assert (gc-test-contains? elf ".aot_stackmaps"))
                 (assert (gc-test-contains? elf "AOTSMAP"))
                 (assert-eq (macho-write "/tmp/aot-take-2-stackmaps.o") (len macho))
                 (assert-eq (elf-write "/tmp/aot-take-2-stackmaps.elf.o") (len elf)))
               (assert-eq lrg 1)))))

(deftest relocation_verification_rejects_only_uses_after_the_selected_safepoint
         (do
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 ref-ty (ty-memptr false (ty-struct "Managed"))
                 ;; An opaque managed reference is a parameter; a non-constant Con has no machine form.
                 fun (fun-make ideal-start (ty-tuple-of2 (ty-int-bot) ref-ty) "reloc")
                 ideal-ref (parm-make fun 0 ref-ty "ref")
                 ref (arm64-select ideal-ref)
                 ideal-sp (safepoint-make (con-make TY-CTRL) (con-make (ty-mem 1 TY-BOT)))
                 source (con-make (ty-int-con 0))]
             (safepoint-add-live! ideal-sp ideal-ref)
             (safepoint-relocated ideal-sp 0)
             (let [sp (arm64-select ideal-sp)
                   use (arm64-scalar-make source
                                          OP-ADD
                                          ARM64-FORM-REG
                                          0
                                          ARM64-CLASS-GPR
                                          ARM64-CLASS-GPR
                                          4
                                          false
                                          false)]
               ;; Direct single-node selection intentionally leaves raw ideal inputs. Rebind the
               ;; live slot to the selected value and register both selected uses explicitly.
               (set! (mut (.ins (hdr sp))) 2 (Some ref))
               (n-add-use! ref sp)
               (n-add-def! use (Some ref))
               (n-set-block-nid! start (n-nid start))
               (n-set-block-nid! ref (n-nid start))
               (n-set-block-nid! sp (n-nid start))
               (n-set-block-nid! use (n-nid start))
               (push! [i64] (mut (.cfg (code))) (n-nid start))
               (code-schedule-reset!)
               (code-schedule-begin-block! start)
               (code-schedule-add! start start)
               (code-schedule-add! start ref)
               (code-schedule-add! start sp)
               (code-schedule-add! start use)
               (code-schedule-end-block! start)
               (assert (not (gc-verify-relocations?)))
               (code-schedule-reset!)
               (code-schedule-begin-block! start)
               (code-schedule-add! start start)
               (code-schedule-add! start ref)
               (code-schedule-add! start use)
               (code-schedule-add! start sp)
               (code-schedule-end-block! start)
               (assert (gc-verify-relocations?))))))
