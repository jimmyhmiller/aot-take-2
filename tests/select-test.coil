;; Instruction selection preserves the ideal graph and exposes exact machine constraints.
(module aot.tests.select)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.cfg" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.bits" :use *)
(import "aot.node.compare" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.call" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.gc" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.codegen.regmask" :use *)
(import "aot.node.cpus.arm64" :use *)
(import "aot.node.cpus.arm64.base" :use *)
(import "aot.node.cpus.arm64.bits" :use *)
(import "aot.node.cpus.arm64.mem" :use *)
(import "aot.node.cpus.arm64.branch" :use *)
(import "aot.node.cpus.arm64.call" :use *)
(import "aot.node.cpus.arm64.phi" :use *)
(import "aot.type.type" :use *)
(import "aot.shape" :use *)

(defn select-test--mach [(n (dyn NodeOps))] (-> (dyn MachNode))
  (primitive/make-dyn MachNode (arm64-scalar-node n)))

(defn select-test--mask [(m (Option (ptr RegMask)))] (-> (ptr RegMask))
  (match m
    (Some [mask] mask)
    (None [] (do (panic "select-test--mask: expected a register edge") (mask-empty)))))

(defn select-test--assert-runtime-prefix [(tag i64) (prefix i64)] (-> i64)
  (let [value (con-make (ty-dyn TAG-ANY))
        selected (arm64-select (typetest-make value tag))
        p (arm64-scalar-node selected)
        m (select-test--mach selected)
        kills (select-test--mask (m-killmap m))]
    (assert-eq (.form p) ARM64-FORM-TYPETEST-PREFIX)
    (assert-eq (.imm p) prefix)
    (assert-eq (m-size m) 16)
    (assert (mask-test kills ARM-X16))
    (assert (mask-test kills ARM-FLAGS))
    0))

(deftest arm64_add_immediate_moves_the_constant_into_the_instruction_payload
         (do
           (arena-reset! 101)
           (let [lhs (con-make (ty-int-con 20))
                 rhs (con-make (ty-int-con 7))
                 add (add-make-mode lhs rhs MODE-INT)
                 rhs-uses (n-nouts rhs)
                 selected (arm64-select add)
                 p (arm64-scalar-node selected)
                 m (select-test--mach selected)]
             (assert-eq (n-op selected) OP-MACH-SCALAR)
             (assert (mach? selected))
             (assert-eq (mach-ideal-op selected) OP-ADD)
             (assert-eq (.ideal-op p) OP-ADD)
             (assert-eq (.form p) ARM64-FORM-IMM12)
             (assert-eq (.imm p) 7)
             (assert-eq (n-nins selected) 2)
             (assert (n-same? (n-in! selected 1) lhs))
             ;; Selection copied inputs without touching the old def-use graph.
             (assert-eq (n-nouts rhs) rhs-uses)
             (assert (mask-test (select-test--mask (m-regmap m 1)) ARM-X0))
             (assert (mask-test (select-test--mask (m-outregmap m)) ARM-X0)))))

(deftest arm64_float_add_keeps_two_fpr_inputs
         (do
           (arena-reset! 103)
           (let [lhs (con-make (ty-flt-con 1.25))
                 rhs (con-make (ty-flt-con 2.5))
                 add (add-make-mode lhs rhs MODE-FLT)
                 selected (arm64-select add)
                 p (arm64-scalar-node selected)
                 m (select-test--mach selected)]
             (assert-eq (.form p) ARM64-FORM-REG)
             (assert-eq (n-nins selected) 3)
             (assert (m-commutes m))
             (assert (mask-test (select-test--mask (m-regmap m 1)) ARM-D0))
             (assert (mask-test (select-test--mask (m-regmap m 2)) ARM-D31))
             (assert (mask-test (select-test--mask (m-outregmap m)) ARM-D0)))))

(deftest arm64_canonicalizes_negative_add_and_sub_constants_to_the_opposite_immediate
         (do
           (arena-reset! 105)
           (let [lhs (con-make (ty-int-con 20))
                 rhs (con-make (ty-int-con -1))
                 selected-add (arm64-select (add-make-mode lhs rhs MODE-INT))
                 selected-sub (arm64-select (sub-make-mode lhs rhs MODE-INT))]
             (assert-eq (.ideal-op (arm64-scalar-node selected-add)) OP-SUB)
             (assert-eq (.form (arm64-scalar-node selected-add)) ARM64-FORM-IMM12)
             (assert-eq (.imm (arm64-scalar-node selected-add)) 1)
             (assert-eq (n-nins selected-add) 2)
             (assert-eq (.ideal-op (arm64-scalar-node selected-sub)) OP-ADD)
             (assert-eq (.form (arm64-scalar-node selected-sub)) ARM64-FORM-IMM12)
             (assert-eq (.imm (arm64-scalar-node selected-sub)) 1)
             (assert-eq (n-nins selected-sub) 2))))

(deftest arm64_constants_are_cloneable_machine_definitions
         (do
           (arena-reset! 107)
           (let [selected (arm64-select (con-make (ty-int-con 0x12345678)))
                 m (select-test--mach selected)]
             (assert (m-clone-cheap? m))
             (match (m-clone m)
               (Some [copy]
                     (do
                       (assert (not (n-same? copy selected)))
                       (assert-eq (.form (arm64-scalar-node copy)) ARM64-FORM-CONST)))
               (None [] (assert false))))))

;; A `Con dyn{null}` once selected as a zero-size placeholder with no register class: every use
;; then read an uninitialized stack slot. The two exact dynamic singletons are immediates.
(deftest arm64_undefined_and_null_constants_are_materialized_immediates
         (do
           (arena-reset! 108)
           (let [null-sel (arm64-scalar-node (arm64-select (dyn-null-make)))
                 undef-sel (arm64-scalar-node (arm64-select (dyn-undefined-make)))]
             (assert-eq (.form null-sel) ARM64-FORM-CONST)
             (assert-eq (.output-class null-sel) ARM64-CLASS-GPR)
             (assert (.clone-cheap null-sel))
             (assert (> (.size null-sel) 0))
             (assert-eq (.imm null-sel) (primitive/ishl DYNAMIC-PREFIX-NULL 48))
             (assert-eq (.output-class undef-sel) ARM64-CLASS-GPR)
             (assert-eq (.imm undef-sel) DYNAMIC-UNDEFINED-WORD))))

(deftest graph_selection_maps_inputs_before_rebuilding_machine_outputs
         (do
           (arena-reset! 109)
           (let [lhs (con-make (ty-int-con 4))
                 rhs (con-make (ty-int-con 50000))
                 add (add-make-mode lhs rhs MODE-INT)
                 lhs-uses (n-nouts lhs)
                 rhs-uses (n-nouts rhs)
                 selected (arm64-select-graph add)
                 selected-lhs (n-in! selected 1)
                 selected-rhs (n-in! selected 2)]
             (assert-eq (n-op selected) OP-MACH-SCALAR)
             (assert-eq (n-op selected-lhs) OP-MACH-SCALAR)
             (assert-eq (n-op selected-rhs) OP-MACH-SCALAR)
             (assert (not (n-same? selected-lhs lhs)))
             (assert (not (n-same? selected-rhs rhs)))
             (assert-eq (n-nouts selected-lhs) 1)
             (assert-eq (n-nouts selected-rhs) 1)
             (match (n-out selected-lhs 0)
               (Some [use] (assert (n-same? use selected)))
               (None [] (assert false)))
             ;; The ideal graph remains authoritative for serialization and was not rewired.
             (assert-eq (n-nouts lhs) lhs-uses)
             (assert-eq (n-nouts rhs) rhs-uses)
             (assert (n-same? (n-in! add 1) lhs))
             (assert (n-same? (n-in! add 2) rhs)))))

(deftest arm64_logical_immediates_store_the_exact_encoding_and_drop_the_constant_lrg
         (do
           (arena-reset! 113)
           (let [lhs (con-make (ty-int-con 0x1234))
                 rhs (con-make (ty-int-con 0xFF))
                 selected (arm64-select (and-make lhs rhs))
                 p (arm64-scalar-node selected)]
             (assert-eq (.form p) ARM64-FORM-LOGICAL-IMM)
             (assert-eq (.imm p) 0x1007)
             (assert-eq (n-nins selected) 2)
             (assert (n-same? (n-in! selected 1) lhs)))
           (match (arm64-logical-immediate 0) (Some [_] (assert false)) (None [] 0))
           (match (arm64-logical-immediate -1) (Some [_] (assert false)) (None [] 0))))

(deftest arm64_comparison_expands_to_flags_then_cset_with_a_real_dependency
         (do
           (arena-reset! 127)
           (let [lhs (con-make (ty-int-con 9))
                 rhs (con-make (ty-int-con 12))
                 ideal (cmp--make OP-LT lhs rhs MODE-INT)
                 selected (arm64-select-graph ideal)
                 setp (arm64-scalar-node selected)
                 flags (n-in! selected 1)
                 flagsp (arm64-scalar-node flags)
                 setm (select-test--mach selected)
                 flagsm (select-test--mach flags)]
             (assert-eq (.form setp) ARM64-FORM-SET)
             (assert-eq (.form flagsp) ARM64-FORM-CMP-IMM)
             (assert-eq (.imm flagsp) 12)
             (assert-eq (n-nins flags) 2)
             (assert (mask-test (select-test--mask (m-outregmap flagsm)) ARM-FLAGS))
             (assert (mask-test (select-test--mask (m-regmap setm 1)) ARM-FLAGS))
             (assert (mask-test (select-test--mask (m-outregmap setm)) ARM-X0))
             (match (n-out flags 0)
               (Some [use] (assert (n-same? use selected)))
               (None [] (assert false))))))

(deftest arm64_not_declares_its_flag_kill_and_two_instruction_size
         (do
           (arena-reset! 131)
           (let [selected (arm64-select (not-make (con-make (ty-int-con 3))))
                 m (select-test--mach selected)]
             (assert-eq (m-size m) 8)
             (assert (mask-test (select-test--mask (m-killmap m)) ARM-FLAGS)))))

(deftest arm64_dynamic_guards_select_every_runtime_tag_and_control_pinned_casts
         (do
           (arena-reset! 133)
           (let [value (con-make (ty-dyn TAG-ANY))
                 test (arm64-select (typetest-make value TAG-UNDEFINED))
                 testp (arm64-scalar-node test)
                 testm (select-test--mach test)]
             (assert-eq (.form testp) ARM64-FORM-TYPETEST-PREFIX)
             (assert-eq (.imm testp) 0x7ffa)
             (assert-eq (m-size testm) 16)
             (assert (mask-test (select-test--mask (m-regmap testm 1)) ARM-X0))
             (assert (mask-test (select-test--mask (m-outregmap testm)) ARM-X0))
             (assert (mask-test (select-test--mask (m-killmap testm)) ARM-X16))
             (assert (mask-test (select-test--mask (m-killmap testm)) ARM-FLAGS))
             (let [ctrl (cproj-make (start-make (ty-int-bot)) 0 "guard.ctrl")
                   cast (arm64-select (cast-make ctrl value (ty-dyn TAG-NUMBER)))
                   castp (arm64-scalar-node cast)]
               (assert-eq (.form castp) ARM64-FORM-CAST)
               (assert (n-same? (n-in! cast 0) ctrl))
               (assert (n-same? (n-in! cast 1) value))
               (assert-eq (m-size (select-test--mach cast)) 4)))
           (select-test--assert-runtime-prefix TAG-INT DYNAMIC-PREFIX-INT)
           (select-test--assert-runtime-prefix TAG-UNDEFINED DYNAMIC-PREFIX-UNDEFINED)
           (select-test--assert-runtime-prefix TAG-NULL DYNAMIC-PREFIX-NULL)
           (select-test--assert-runtime-prefix TAG-BOOL DYNAMIC-PREFIX-BOOL)
           (select-test--assert-runtime-prefix TAG-STRING DYNAMIC-PREFIX-STRING)
           (select-test--assert-runtime-prefix TAG-SYMBOL DYNAMIC-PREFIX-SYMBOL)
           (select-test--assert-runtime-prefix TAG-OBJECT DYNAMIC-PREFIX-OBJECT)
           (select-test--assert-runtime-prefix TAG-FUNCTION DYNAMIC-PREFIX-FUNCTION)
           (let [value (con-make (ty-dyn TAG-ANY))
                 selected (arm64-select (typetest-make value TAG-DOUBLE))
                 p (arm64-scalar-node selected)
                 m (select-test--mach selected)
                 kills (select-test--mask (m-killmap m))]
             (assert-eq (.form p) ARM64-FORM-TYPETEST-DOUBLE)
             (assert-eq (m-size m) 48)
             (assert (mask-test kills ARM-X16))
             (assert (mask-test kills ARM-X17))
             (assert (mask-test kills ARM-FLAGS)))
           (let [raw (con-make (ty-flt 64))
                 selected (arm64-select (box-make raw))
                 m (select-test--mach selected)
                 kills (select-test--mask (m-killmap m))]
             (assert-eq (.form (arm64-scalar-node selected)) ARM64-FORM-BOX-DOUBLE)
             (assert-eq (m-size m) 16)
             (assert (mask-test kills ARM-X16))
             (assert (mask-test kills ARM-FLAGS)))))

(deftest arm64_load_folds_a_scaled_offset_without_allocating_it
         (do
           (arena-reset! 137)
           (let [ctrl (con-make TY-CTRL)
                 mem (con-make (ty-mem 17 (ty-int-bot)))
                 ptr_ (con-make (ty-memptr false (ty-struct "SelectedLoad")))
                 off (con-make (ty-int-con 32760))
                 load_ (load-make ctrl mem ptr_ off 17 (ty-int-bot))
                 selected (arm64-select load_)
                 p (arm64-mem-node selected)
                 m (primitive/make-dyn MachNode p)]
             (assert-eq (.form p) ARM64-MEM-UIMM12)
             (assert-eq (.offset p) 32760)
             (match (n-in selected MEM-OFF) (Some [_] (assert false)) (None [] 0))
             (match (m-regmap m MEM-STATE) (Some [_] (assert false)) (None [] 0))
             (assert (mask-test (select-test--mask (m-regmap m MEM-PTR)) ARM-X0))
             (assert (mask-test (select-test--mask (m-outregmap m)) ARM-X0))
             (match (mem-of selected)
               (Some [access]
                     (do
                       (assert (mem-is-load? access))
                       (assert-eq (mem-alias access) 17)
                       (assert (n-same? (mem-in access) mem))
                       (assert (n-same? (mem-ptr access) ptr_))
                       (assert (n-same? (mem-offset access) off))))
               (None [] (assert false))))))

(deftest arm64_store_uses_signed_imm9_or_register_offset_and_has_no_value_result
         (do
           (arena-reset! 139)
           (let [ctrl (con-make TY-CTRL)
                 mem (con-make (ty-mem 19 (ty-int-bot)))
                 ptr_ (con-make (ty-memptr false (ty-struct "SelectedStore")))
                 val (con-make (ty-flt 32))
                 small (store-make ctrl mem ptr_ (con-make (ty-int-con -8)) val 19 (ty-flt 32))
                 indexed (store-make ctrl mem ptr_ (con-make (ty-int-con -300)) val 19 (ty-flt 32))
                 sm (arm64-select small)
                 rm (arm64-select indexed)
                 sp (arm64-mem-node sm)
                 rp (arm64-mem-node rm)
                 smach (primitive/make-dyn MachNode sp)
                 rmach (primitive/make-dyn MachNode rp)]
             (assert-eq (.form sp) ARM64-MEM-SIMM9)
             (assert-eq (.offset sp) -8)
             (assert-eq (.bytes sp) 4)
             (assert-eq (.form rp) ARM64-MEM-REG)
             (assert (mask-test (select-test--mask (m-regmap smach STORE-VAL)) ARM-D0))
             (assert (mask-test (select-test--mask (m-regmap rmach MEM-OFF)) ARM-X0))
             (match (m-outregmap smach) (Some [_] (assert false)) (None [] 0)))))

(deftest graph_selection_carries_memory_state_as_a_zero_code_non_lrg_value
         (do
           (arena-reset! 149)
           (let [ctrl (con-make TY-CTRL)
                 mem (con-make (ty-mem 23 (ty-int-bot)))
                 ptr-ty (ty-memptr false (ty-struct "SelectedMemoryGraph"))
                 ;; An opaque register value is a parameter; a non-constant Con has no machine form.
                 fun (fun-make (start-make (ty-int-bot)) (ty-tuple-of2 (ty-int-bot) ptr-ty) "mem")
                 ptr_ (parm-make fun 0 ptr-ty "p")
                 load_ (load-make ctrl mem ptr_ (con-make (ty-int-con 16)) 23 (ty-int-bot))
                 selected (arm64-select-graph load_)
                 selected-mem (n-in! selected MEM-STATE)
                 mm (select-test--mach selected-mem)]
             (assert-eq (n-op selected) OP-MACH-MEM)
             (assert-eq (n-op selected-mem) OP-MACH-SCALAR)
             (assert-eq (m-size mm) 0)
             (match (m-outregmap mm) (Some [_] (assert false)) (None [] 0))
             (assert-eq (n-nouts selected-mem) 1))))

(deftest arm64_branch_bypasses_cset_and_consumes_comparison_flags
         (do
           (arena-reset! 151)
           (let [ctrl (con-make TY-CTRL)
                 lhs (con-make (ty-int-con 7))
                 rhs (con-make (ty-int-con 9))
                 cmp (cmp--make OP-LT lhs rhs MODE-INT)
                 iff (if-make ctrl cmp)
                 arm (cproj-make iff IF-TRUE-IDX "selected.true")]
             (n-set-ltree-head! iff 77)
             (n-set-ltree-parent! iff 33)
             (n-set-ltree-depth! iff 2)
             (n-set-cfg-pre! iff 19)
             (let [selected-arm (arm64-select-graph arm)
                   branch (n-in! selected-arm 0)
                   flags (n-in! branch 1)
                   bm (primitive/make-dyn MachNode (arm64-cfg-node branch))
                   fm (select-test--mach flags)]
               (assert-eq (.ideal-op (arm64-cfg-node branch)) OP-IF)
               (assert-eq (.form (arm64-scalar-node flags)) ARM64-FORM-CMP-IMM)
               (assert (mask-test (select-test--mask (m-regmap bm 1)) ARM-FLAGS))
               (assert (mask-test (select-test--mask (m-outregmap fm)) ARM-FLAGS))
               (assert-eq (n-ltree-head branch) 77)
               (assert-eq (n-ltree-parent branch) 33)
               (assert-eq (n-ltree-depth branch) 2)
               (assert-eq (n-cfg-pre branch) 19)
               (match (cfg-of selected-arm)
                 (Some [cfg] (assert (block-head? cfg)))
                 (None [] (assert false)))
               (match (cfg-of branch)
                 (Some [cfg] (assert (not (block-head? cfg))))
                 (None [] (assert false)))))))

(deftest arm64_noncomparison_predicate_gets_an_explicit_test_against_zero
         (do
           (arena-reset! 157)
           (let [ctrl (con-make TY-CTRL)
                 pred (add-make-mode (con-make (ty-int-con 2))
                                     (con-make (ty-int-con 3))
                                     MODE-INT)
                 branch (arm64-select (if-make ctrl pred))
                 flags (n-in! branch 1)]
             (assert-eq (.form (arm64-scalar-node flags)) ARM64-FORM-CMP-IMM)
             (assert-eq (.imm (arm64-scalar-node flags)) 0)
             (assert (n-same? (n-in! flags 1) pred)))))

(deftest arm64_never_keeps_a_null_nonregister_predicate
         (do
           (arena-reset! 163)
           (let [branch (arm64-select (never-make (con-make TY-CTRL)))
                 m (primitive/make-dyn MachNode (arm64-cfg-node branch))]
             (match (n-in branch 1) (Some [_] (assert false)) (None [] 0))
             (match (m-regmap m 1) (Some [_] (assert false)) (None [] 0))
             (assert-eq (m-size m) 4))))

(deftest arm64_selected_start_and_region_preserve_cfg_semantics
         (do
           (arena-reset! 167)
           (let [start (start-make (ty-int-bot))
                 region (region-make)]
             (region-add-path! region start)
             (region-add-path! region start)
             (let [selected (arm64-select-graph region)
                   selected-start (n-in! selected 1)]
               (match (cfg-of selected-start)
                 (Some [cfg]
                       (do
                         (assert (block-head? cfg))
                         (assert-eq (cfg-idepth cfg) 0)
                         (match (cfg-idom cfg) (Some [_] (assert false)) (None [] 0))))
                 (None [] (assert false)))
               (match (cfg-of selected)
                 (Some [cfg]
                       (do
                         (assert (block-head? cfg))
                         (assert-eq (cfg-idepth cfg) 1)
                         (match (cfg-idom cfg)
                           (Some [idom] (assert (n-same? idom selected-start)))
                           (None [] (assert false)))))
                 (None [] (assert false)))))))

(deftest arm64_selected_loop_maps_its_backedge_cycle_before_recursing
         (do
           (arena-reset! 173)
           (let [start (start-make (ty-int-bot))
                 loop-node (loop-make start)]
             (loop-close! loop-node loop-node)
             (let [selected (arm64-select-graph loop-node)]
               (assert (n-same? (n-in! selected 2) selected))
               (match (cfg-of selected)
                 (Some [cfg]
                       (do
                         (assert (block-head? cfg))
                         (assert-eq (cfg-idepth cfg) 1)
                         (match (cfg-idom cfg)
                           (Some [entry] (assert (n-same? entry (n-in! selected 1))))
                           (None [] (assert false)))))
                 (None [] (assert false)))))))

(deftest arm64_call_boundary_caches_exact_abi_masks
         (do
           (arena-reset! 179)
           (let [start (start-make (ty-int-bot))
                 sig (ty-tuple-of2 (ty-flt-bot) (ty-int-bot))
                 fun (fun-make start sig "callee")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 arg (parm-make fun 0 (ty-int-bot) "x")
                 mem (con-make (ty-mem 1 TY-BOT))
                 fptr (funptr-make fun 41)
                 call (call-make-with-mem start mem)]
             (call-add-arg! call (con-make (ty-int-con 7)))
             (call-set-fptr! call fptr)
             (let [end (callend-make call)
                   ret (return-make fun (Some mem) (con-make (ty-flt-con 1.5)) (Some rpc) (Some fun))
                   selected-parm (arm64-select arg)
                   selected-call (arm64-select call)
                   selected-end (arm64-select end)
                   selected-ret (arm64-select ret)
                   pm (primitive/make-dyn MachNode (arm64-call-node selected-parm))
                   cm (primitive/make-dyn MachNode (arm64-call-node selected-call))
                   em (primitive/make-dyn MachNode (arm64-call-node selected-end))
                   rm (primitive/make-dyn MachNode (arm64-call-node selected-ret))]
               (assert-eq (mask-first (select-test--mask (m-outregmap pm))) ARM-X0)
               (assert (.direct (arm64-call-node selected-call)))
               (assert-eq (n-nins selected-call) 3)
               (assert-eq (mask-first (select-test--mask (m-regmap cm CALL-ARG0))) ARM-X0)
               (assert-eq (mask-first (select-test--mask (m-proj-outregmap em RETURN-VALUE))) ARM-D0)
               (assert (mask-test (select-test--mask (m-killmap em)) ARM-FLAGS))
               (assert-eq (mask-first (select-test--mask (m-regmap rm RETURN-VALUE))) ARM-D0)
               (assert-eq (mask-first (select-test--mask (m-regmap rm RETURN-RPC))) ARM-LR)
               (match (cfg-of selected-end)
                 (Some [cfg] (assert (block-head? cfg)))
                 (None [] (assert false)))))))

(deftest arm64_new_is_an_aot_runtime_boundary_with_size_shape_result_and_clobbers
         (do
           (arena-reset! 181)
           (let [size (con-make (ty-int-con 48))
                 allocation (new-make (con-make TY-CTRL)
                                      size
                                      (con-make (ty-mem 1 TY-BOT))
                                      SHAPE-EMPTY
                                      (ty-struct "SelectedAllocation"))
                 selected (arm64-select allocation)
                 pointer (arm64-select (proj-make allocation 0 "allocated.pointer"))
                 machine (primitive/make-dyn MachNode (arm64-call-node selected))
                 pointer-machine (primitive/make-dyn MachNode (arm64-call-node pointer))]
             (assert-eq (.ideal-op (arm64-call-node selected)) OP-NEW)
             (assert-eq (m-size machine) 108)
             (assert-eq (mask-first (select-test--mask (m-regmap machine 1))) ARM-X0)
             (assert-eq (.alloc-shape (arm64-call-node selected)) SHAPE-EMPTY)
             (assert-eq (.alloc-map-id (arm64-call-node selected)) (n-nid selected))
             (assert-eq (.symbol (arm64-call-node selected)) "aot_rt_alloc")
             (assert-eq (mask-first (select-test--mask (m-proj-outregmap machine 0))) ARM-X0)
             (assert-eq (mask-first (select-test--mask (m-outregmap pointer-machine))) ARM-X0)
             (assert (mask-test (select-test--mask (m-killmap machine)) ARM-X0))
             (match (cfg-of selected) (Some [_] (assert false)) (None [] 0)))))

(deftest arm64_selected_loop_phi_preserves_its_edge_cycle_and_register_class
         (do
           (arena-reset! 191)
           (let [start (start-make (ty-int-bot))
                 loop-node (loop-make start)
                 phi (phi-make loop-node (ty-int-bot) "induction")]
             (phi-add-value! phi (con-make (ty-int-con 0)))
             (phi-open! phi)
             (loop-close! loop-node loop-node)
             (phi-close! phi phi)
             (let [selected (arm64-select-graph phi)
                   machine (primitive/make-dyn MachNode (arm64-phi-node selected))]
               (assert-eq (n-op selected) OP-MACH-PHI)
               (assert (mach? selected))
               (assert-eq (mach-ideal-op selected) OP-PHI)
               (assert (n-same? (n-in! selected 2) selected))
               (assert (is-pinned? (arm64-phi-node selected)))
               (assert-eq (m-size machine) 0)
               (assert (mask-test (select-test--mask (m-regmap machine 1)) ARM-X0))
               (assert (mask-test (select-test--mask (m-outregmap machine)) ARM-X0))))))

(deftest arm64_selected_memphi_has_no_register_live_range
         (do
           (arena-reset! 193)
           (let [start (start-make (ty-int-bot))
                 region (region-make)
                 memory (con-make (ty-mem 7 TY-BOT))]
             (region-add-path! region start)
             (region-add-path! region start)
             (let [phi (memphi-make region 7 TY-BOT "memory.merge")]
               (memphi-add-state! phi memory)
               (memphi-add-state! phi memory)
               (let [selected (arm64-select phi)
                     machine (primitive/make-dyn MachNode (arm64-phi-node selected))]
                 (match (m-regmap machine 1) (Some [_] (assert false)) (None [] 0))
                 (match (m-outregmap machine) (Some [_] (assert false)) (None [] 0)))))))

(deftest arm64_safepoints_keep_live_inputs_and_relocations_in_writable_stack_homes
         (do
           (boot! 197)
           (let [sp (safepoint-make (con-make TY-CTRL) (con-make (ty-mem 1 TY-BOT)))
                 ref (con-make (ty-memptr false (ty-struct "Managed")))]
             (safepoint-add-live! sp ref)
             (let [relocated (safepoint-relocated sp 0)
                   selected-sp (arm64-select sp)
                   selected-relocated (arm64-select relocated)
                   sm (primitive/make-dyn MachNode (arm64-call-node selected-sp))
                   rm (primitive/make-dyn MachNode (arm64-call-node selected-relocated))]
               (assert-eq (mach-ideal-op selected-sp) OP-SAFEPOINT)
               (assert-eq (m-size sm) 0)
               (assert (mask-test (select-test--mask (m-regmap sm SAFEPOINT-LIVE)) ARM-MAX-REG))
               (assert (not (mask-test (select-test--mask (m-regmap sm SAFEPOINT-LIVE)) ARM-X0)))
               (match (m-outregmap sm) (Some [_] (assert false)) (None [] 0))
               (assert (mask-test (select-test--mask (m-outregmap rm)) ARM-MAX-REG))))))

(deftest arm64_barriers_are_inline_noncollecting_machine_boundaries
         (do
           (boot! 199)
           (let [obj (con-make (ty-memptr false (ty-struct "Owner")))
                 value (con-make (ty-memptr true (ty-struct "Value")))
                 barrier (barrier-make (con-make TY-CTRL)
                                       (con-make (ty-mem 9 (n-ty value)))
                                       obj
                                       value)
                 selected (arm64-select barrier)
                 machine (primitive/make-dyn MachNode (arm64-call-node selected))]
             (assert-eq (mach-ideal-op selected) OP-BARRIER)
             (assert-eq (m-size machine) 60)
             (assert (mask-test (select-test--mask (m-regmap machine BARRIER-OBJ)) ARM-X0))
             (assert (mask-test (select-test--mask (m-regmap machine BARRIER-VAL)) ARM-X1))
             (assert (mask-test (select-test--mask (m-killmap machine)) ARM-X16))
             (assert (not (mask-test (select-test--mask (m-killmap machine)) ARM-LR)))
             (match (m-outregmap machine) (Some [_] (assert false)) (None [] 0)))))
