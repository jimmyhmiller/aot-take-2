;; The type lattice.

;;
;; The properties here are the ones a wrong `meet` or `dual` breaks silently: the optimiser keeps
;; running, the verifier stays clean, and the answers are wrong. Each is stated as a law rather
;; than an example, because an example passes for the wrong reason.
(module aot.tests.type)
(import "coil.assert" :use *)
(import "aot.type.type" :use *)

(deftest interning_makes_identity_equality
         ;; The whole reason a Ty is an integer: two structurally identical types are the SAME id, so
         ;; every later comparison is an integer compare rather than a structural walk.
         (assert-eq (ty-int-con 5) (ty-int-con 5))
         (assert-eq (ty-int-range 0 10) (ty-int-range 0 10))
         (assert-ne (ty-int-con 5) (ty-int-con 6))
         (assert-ne (ty-int-range 0 10) (ty-int-range 0 11)))

(deftest the_well_known_ids_are_stable
         ;; These ids appear in every printed graph and golden hash, so their VALUES are part of the
         ;; format, not an implementation detail.
         (assert-eq (ty-dual TY-BOT) TY-TOP)
         (assert-eq (ty-dual TY-CTRL) TY-XCTRL)
         (assert-eq (ty-dual TY-NIL) TY-XNIL))

(deftest dual_is_an_involution
         ;; dual(dual(t)) == t, for every t we can name. A dual that is not an involution breaks the
         ;; optimistic pass in a way the pessimistic pass cannot see, because join is defined through it.
         (assert-eq (ty-dual (ty-dual TY-BOT)) TY-BOT)
         (assert-eq (ty-dual (ty-dual TY-TOP)) TY-TOP)
         (assert-eq (ty-dual (ty-dual TY-CTRL)) TY-CTRL)
         (assert-eq (ty-dual (ty-dual TY-XCTRL)) TY-XCTRL)
         (assert-eq (ty-dual (ty-dual TY-NIL)) TY-NIL)
         (assert-eq (ty-dual (ty-dual TY-XNIL)) TY-XNIL)
         (assert-eq (ty-dual (ty-dual (ty-int-con 7))) (ty-int-con 7))
         (assert-eq (ty-dual (ty-dual (ty-int-range 1 9))) (ty-int-range 1 9)))

(deftest meet_is_commutative
         (assert-eq (ty-meet TY-BOT TY-TOP) (ty-meet TY-TOP TY-BOT))
         (assert-eq (ty-meet (ty-int-con 1) (ty-int-con 2))
                    (ty-meet (ty-int-con 2) (ty-int-con 1)))
         (assert-eq (ty-meet TY-CTRL TY-XCTRL) (ty-meet TY-XCTRL TY-CTRL)))

(deftest meet_is_idempotent
         (assert-eq (ty-meet TY-BOT TY-BOT) TY-BOT)
         (assert-eq (ty-meet (ty-int-con 3) (ty-int-con 3)) (ty-int-con 3)))

(deftest top_and_bottom_are_the_lattice_bounds
         ;; TOP is the identity of meet; BOT is its absorbing element. Anything else and the optimistic
         ;; pass cannot start from TOP.
         (assert-eq (ty-meet TY-TOP (ty-int-con 4)) (ty-int-con 4))
         (assert-eq (ty-meet (ty-int-con 4) TY-TOP) (ty-int-con 4))
         (assert-eq (ty-meet TY-BOT (ty-int-con 4)) TY-BOT)
         (assert-eq (ty-meet (ty-int-con 4) TY-BOT) TY-BOT))

(deftest two_constants_meet_to_the_range_that_covers_both
         (assert-eq (ty-meet (ty-int-con 3) (ty-int-con 7)) (ty-int-range 3 7))
         (assert-eq (ty-meet (ty-int-range 0 5) (ty-int-range 3 9)) (ty-int-range 0 9)))

(deftest control_is_its_own_mini_lattice
         ;; any - ~ctrl - ctrl - all. Reachable meets unreachable to reachable: if either path arrives,
         ;; the merge is reached.
         (assert-eq (ty-meet TY-CTRL TY-XCTRL) TY-CTRL))

(deftest isa_orders_the_lattice
         ;; `a isa b` = every value a admits, b admits too.
         (assert (ty-isa? (ty-int-con 5) (ty-int-range 0 10)))
         (assert (not (ty-isa? (ty-int-range 0 10) (ty-int-con 5))))
         ;; Reflexive.
         (assert (ty-isa? (ty-int-con 5) (ty-int-con 5))))

(deftest the_lattice_bottom_is_the_universal_supertype
         ;; THE NAMING INVERTS AND IT CATCHES EVERYONE. BOT is the lattice BOTTOM — meet moves toward it —
         ;; but it means "any value at all", so in SUBTYPING terms it is the universal SUPERtype: every
         ;; type isa BOT. TOP is the lattice top and means "no information", so nothing but TOP isa TOP.
         ;;
         ;; Get this backwards and `ty-isa?` reads plausibly while making every Cast discharge itself,
         ;; because `ANY isa t` would hold for every t — which is the guard mechanism erasing itself.
         (assert (ty-isa? TY-TOP TY-BOT))
         (assert (not (ty-isa? TY-BOT TY-TOP)))
         (assert (ty-isa? (ty-int-con 5) TY-BOT))
         (assert (not (ty-isa? (ty-int-con 5) TY-TOP))))

(deftest high_is_a_question_about_the_lattice_not_about_proof
         ;; TOP is the ABSENCE of information; ~ctrl and ~nil are CLAIMS someone computed. `ty-high?`
         ;; answers only "is this at or above the centreline" — it is deliberately NOT the test a rewrite
         ;; is allowed to use, which is why `ty-proven?` exists separately.
         (assert (ty-high? TY-TOP))
         (assert (ty-high? TY-XCTRL))
         (assert (ty-high? TY-XNIL))
         (assert (not (ty-high? TY-BOT)))
         (assert (not (ty-high? TY-CTRL)))
         (assert (not (ty-high? (ty-int-con 5)))))

(deftest constants_are_recognised_and_ranges_are_not
         (assert (ty-constant? (ty-int-con 5)))
         (assert (not (ty-constant? (ty-int-range 0 5))))
         (assert (not (ty-constant? TY-BOT))))

(deftest tuple_interning_is_structural_over_the_members
         ;; The obvious implementation — hashing `(offset,len)` — is wrong in a way that is easy to miss:
         ;; every constructor call appends fresh members, so two tuples with identical members land at
         ;; different offsets and intern as DIFFERENT types. Identity then stops being equality for exactly
         ;; the types `If` reports, and every comparison against `ty-if-true` fails while every printed
         ;; graph still looks correct.
         (assert-eq (ty-tuple-of2 TY-CTRL TY-XCTRL) (ty-tuple-of2 TY-CTRL TY-XCTRL))
         (assert-eq (ty-if-true) (ty-if-true))
         (assert-ne (ty-if-true) (ty-if-false))
         (assert-ne (ty-if-both) (ty-if-neither))
         ;; And the side array does not grow on repeat: only four distinct tuples exist in the compiler,
         ;; but `If.compute` builds one on every visit.
         (let [before (ty-kids-len)]
           (ty-if-true)
           (ty-if-true)
           (ty-if-true)
           (ty-if-both)
           (ty-if-both)
           (assert-eq (ty-kids-len) before)))

(deftest a_tuple_duals_and_meets_memberwise
         ;; dual(IF_TRUE) is (~ctrl, ctrl) = IF_FALSE, and that symmetry is what makes `join` on If
         ;; outcomes mean the right thing.
         (assert-eq (ty-dual (ty-if-true)) (ty-if-false))
         (assert-eq (ty-dual (ty-dual (ty-if-true))) (ty-if-true))
         ;; Meeting a decided arm with its opposite gives both arms reachable.
         (assert-eq (ty-meet (ty-if-true) (ty-if-false)) (ty-if-both))
         ;; Different arities have no common refinement.
         (assert-eq (ty-meet (ty-if-true) (ty-tuple-of3 TY-CTRL TY-CTRL TY-CTRL)) TY-BOT))

(deftest a_reversed_integer_range_is_HIGH
         ;; Simple's `TypeInteger.isHigh()` is literally `_min > _max`. `ty-dual` produces exactly that by
         ;; swapping the bounds, and it is the only thing that may — `ty-int-range` refuses lo > hi.
         ;;
         ;; Missing this case makes `ty-high?` answer a per-axis question with a single-axis test, and
         ;; every `compute` guarding on it silently treats an unanalysed integer as a known one.
         (assert (ty-high? (ty-dual (ty-int-range 0 1))))
         (assert (ty-high? (ty-dual (ty-int-bot))))
         (assert (not (ty-high? (ty-int-range 0 1))))
         (assert (not (ty-high? (ty-int-bot))))
         ;; And a high float, which duals by negating the width tag.
         (assert (ty-high? (ty-dual (ty-flt-bot))))
         (assert (not (ty-high? (ty-flt-bot)))))

(deftest a_constant_float_is_self_dual
         ;; Simple's encoding: `_sz == 0` means CONSTANT, with the value in `_con`. A constant sits on the
         ;; lattice centreline, so it is its own dual — `_isConstant() ? this : new TypeFloat(-_sz, 0)`.
         ;;
         ;; I originally packed width, constant-ness and high-ness into one field with the sign meaning
         ;; "high", which made `dual(F64)` return F64: a bottom that is its own dual, and a lattice that is
         ;; not dual-symmetric at all.
         (assert-eq (ty-dual (ty-flt-con 1.5)) (ty-flt-con 1.5))
         (assert (ty-constant? (ty-flt-con 1.5)))
         (assert (not (ty-high? (ty-flt-con 1.5))))
         ;; The non-constant forms flip.
         (assert-ne (ty-dual (ty-flt-bot)) (ty-flt-bot))
         (assert (ty-high? (ty-dual (ty-flt-bot))))
         (assert-eq (ty-dual (ty-dual (ty-flt-bot))) (ty-flt-bot))
         (assert (not (ty-constant? (ty-flt-bot))))
         ;; And the two widths are distinct types.
         (assert-ne (ty-flt 32) (ty-flt 64)))
