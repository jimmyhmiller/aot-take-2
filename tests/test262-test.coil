;; Runner policy tests never claim JavaScript conformance results.
(module aot.tests.test262)
(import "coil.assert" :use *)
(import "coil.arraylist" :use *)
(import "aot.tools.test262-metadata" :use *)

(deftest test262_metadata_preserves_execution_fields_and_variant_rules
  (let [(mut meta) (t262-metadata "/*---\ndescription: |\n  flags: [raw]\nflags: [generated]\nincludes: [a.js, 'b.js']\nfeatures:\n  - Symbol\nnegative:\n  phase: parse\n  type: SyntaxError\n---*/\ninvalid input")
        (mut modes) (t262-variants (load meta))]
    (assert-eq (.error meta) "")
    (assert-eq (len (load modes)) 2)
    (assert-eq (get (load modes) 0) T262-SLOPPY)
    (assert-eq (get (load modes) 1) T262-STRICT)
    (assert (not (t262-has (.flags meta) "raw")))
    (assert-eq (get (.includes meta) 0) "a.js")
    (assert-eq (get (.includes meta) 1) "b.js")
    (assert (t262-has (.features meta) "Symbol"))
    (assert-eq (.negative-phase meta) "parse")
    (assert-eq (.negative-type meta) "SyntaxError")
    (al-free! (mut modes))
    (t262-metadata-free! (mut meta)))
  (let [(mut meta) (t262-metadata "/*---\nflags:\n  - module\n  - raw\n---*/")
        (mut modes) (t262-variants (load meta))]
    (assert-eq (.error meta) "")
    (assert-eq (len (load modes)) 1)
    (assert-eq (get (load modes) 0) T262-MODULE)
    (al-free! (mut modes))
    (t262-metadata-free! (mut meta))))

(deftest test262_metadata_errors_do_not_become_default_execution
  (let [(mut missing) (t262-metadata "42;")
        (mut unknown) (t262-metadata "/*---\nflags: [futureFlag]\n---*/")
        (mut duplicate) (t262-metadata "/*---\nflags: [raw]\nflags: []\n---*/")
        (mut negative) (t262-metadata "/*---\nnegative:\n  phase: parse\n---*/")]
    (assert (!= (.error missing) ""))
    (assert (!= (.error unknown) ""))
    (assert (!= (.error duplicate) ""))
    (assert (!= (.error negative) ""))
    (t262-metadata-free! (mut missing))
    (t262-metadata-free! (mut unknown))
    (t262-metadata-free! (mut duplicate))
    (t262-metadata-free! (mut negative))))
