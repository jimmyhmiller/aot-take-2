;; Runner policy tests never claim JavaScript conformance results.
(module aot.tests.test262)
(import "coil.assert" :use *)
(import "coil.arraylist" :use *)
(import "aot.tools.test262-metadata" :use *)
(import "aot.tools.test262-policy" :use *)
(import "coil.alloc" :as alloc)
(import "aot.tools.test262-worker" :use *)
(import "aot.tools.test262-memory" :use *)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "coil.str" :use [sb-new sb-push-str! sb-push-i64! sb-str sb-free!])

(extern setenv :cc c [(ptr i8) (ptr i8) i32] (-> i32))

(deftest memory_worker_reuses_compiled_harness_and_host_and_invalidates_changed_harness_bytes
  (let [(mut plain) (t262-metadata "/*---\nflags: [noStrict]\n---*/")
        (mut harness) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut path) (sb-new (alloc/malloc-allocator))]
    (sb-push-str! (mut path) "/tmp/aot-cached-harness-")
    (sb-push-i64! (mut path) (primitive/cast i64 (os/getpid)))
    (sb-push-str! (mut path) ".js")
    (t262-write! (sb-str (load path)) "var state = {answer:1}; function bump() { state.answer++; }")
    (push! [(slice u8)] (mut harness) (sb-str (load path)))
    (assert-eq (memory-execute! (load harness) "bump(); if (state.answer !== 2) throw 7;"
      "/tmp/aot-worker-cache-first" (load plain)) T262-PASS)
    (assert-eq (.cache-hits (memory-worker)) 0)
    (assert-eq (.cache-misses (memory-worker)) 2)
    (assert-eq (.host-misses (memory-worker)) 1)
    (assert (> (.reserved (memory-worker)) 0))
    (assert-eq (memory-execute! (load harness) "bump(); if (state.answer !== 2) throw 7;"
      "/tmp/aot-worker-cache-hit" (load plain)) T262-PASS)
    (assert-eq (.cache-hits (memory-worker)) 2)
    (assert-eq (.cache-misses (memory-worker)) 2)
    (assert-eq (.host-hits (memory-worker)) 1)
    (t262-write! (sb-str (load path)) "var state = {answer:2}; function bump() { state.answer++; }")
    (assert-eq (memory-execute! (load harness) "bump(); if (state.answer !== 3) throw 7;"
      "/tmp/aot-worker-cache-changed" (load plain)) T262-PASS)
    (assert-eq (.cache-misses (memory-worker)) 4)
    (assert-eq (.host-hits (memory-worker)) 2)
    (assert-eq (.host-misses (memory-worker)) 1)
    (assert-eq (.starts (memory-worker)) 1)
    (memory-close-worker! false)
    (al-free! (mut harness)) (sb-free! (mut path)) (t262-metadata-free! (mut plain))))

(deftest memory_worker_times_out_execution_and_recovers
  (let [(mut plain) (t262-metadata "/*---\nflags: [noStrict]\n---*/")
        (mut harness) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (assert-eq (setenv c"AOT_T262_RUN_SECONDS" c"1" 1) (primitive/cast i32 0))
    (assert-eq (memory-execute! (load harness) "var i = 0; while (i < 1000000000000000) { i++; }"
                              "/tmp/aot-memory-worker-timeout" (load plain)) T262-TIMEOUT)
    (assert-eq (.pid (memory-worker)) (primitive/cast i32 0))
    (assert-eq (memory-execute! (load harness) "var x = 1;" "/tmp/aot-memory-worker-timeout-recovered" (load plain)) T262-PASS)
    (assert-eq (.starts (memory-worker)) 2)
    (memory-close-worker! false)
    (al-free! (mut harness))
    (t262-metadata-free! (mut plain))))

(deftest memory_worker_recovers_if_idle_child_dies
  (let [(mut plain) (t262-metadata "/*---\nflags: [noStrict]\n---*/")
        (mut harness) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (assert-eq (memory-execute! (load harness) "var x = 1;" "/tmp/aot-memory-worker-idle" (load plain)) T262-PASS)
    (let [pid (.pid (memory-worker))]
      (assert-eq (os/kill pid 9) (primitive/cast i32 0))
      ;; Death can be observed before start, during send, or during monitoring. Each is a valid
      ;; scheduling outcome, but none may kill/hang the coordinator or poison the next request.
      (let [answer (memory-execute! (load harness) "var x = 2;" "/tmp/aot-memory-worker-idle-dead" (load plain))]
        (assert (or (= answer T262-PASS) (= answer T262-HARNESS-ERROR) (= answer T262-CRASH)))))
    (assert-eq (memory-execute! (load harness) "var x = 3;" "/tmp/aot-memory-worker-idle-recovered" (load plain)) T262-PASS)
    (memory-close-worker! false)
    (al-free! (mut harness))
    (t262-metadata-free! (mut plain))))

(deftest memory_worker_reuses_process_after_normal_and_javascript_failure
  (let [(mut plain) (t262-metadata "/*---\nflags: [noStrict]\n---*/")
        (mut harness) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (assert-eq (memory-execute! (load harness) "var x = 1;" "/tmp/aot-memory-worker-normal" (load plain)) T262-PASS)
    (let [pid (.pid (memory-worker))]
      (assert-eq (memory-execute! (load harness) "throw 1;" "/tmp/aot-memory-worker-throw" (load plain)) T262-FAIL)
      (assert-eq (.pid (memory-worker)) pid)
      (assert-eq (memory-execute! (load harness) "if (typeof x !== 'undefined') throw 2;"
                                "/tmp/aot-memory-worker-fresh" (load plain)) T262-PASS)
      (assert-eq (.pid (memory-worker)) pid)
      (assert-eq (.starts (memory-worker)) 1))
    (memory-close-worker! false)
    (al-free! (mut harness))
    (t262-metadata-free! (mut plain))))

(deftest memory_worker_recovers_from_compiler_refusal_and_preserves_parse_negative_protocol
  (let [(mut plain) (t262-metadata "/*---\nflags: [noStrict]\n---*/")
        (mut negative) (t262-metadata "/*---\nnegative:\n  phase: parse\n  type: SyntaxError\n---*/")
        (mut harness) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (assert-eq (memory-execute! (load harness) "class C {}" "/tmp/aot-memory-worker-refusal" (load plain)) T262-UNSUPPORTED)
    (assert-eq (memory-execute! (load harness) "var x = 1;" "/tmp/aot-memory-worker-recovered" (load plain)) T262-PASS)
    (assert-eq (.starts (memory-worker)) 2)
    (assert-eq (memory-execute! (load harness) "return 1;" "/tmp/aot-memory-worker-parse" (load negative)) T262-PASS)
    (assert-eq (memory-execute! (load harness) "var x = 1;" "/tmp/aot-memory-worker-parse-recovered" (load plain)) T262-PASS)
    (assert-eq (.starts (memory-worker)) 3)
    (memory-close-worker! false)
    (al-free! (mut harness))
    (t262-metadata-free! (mut negative))
    (t262-metadata-free! (mut plain))))

;; These are runner self-tests, not suite passes. Compile the real Coil compiler once, then
;; exercise the same compile/link/native-execute path used by the campaign, without a JS oracle.
(deftest test262_worker_executes_native_script_and_never_counts_a_compiler_error_as_negative_success
  (let [(mut argv) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut plain) (t262-metadata "/*---\nflags: [raw]\n---*/")
        (mut negative) (t262-metadata "/*---\nflags: [raw]\nnegative:\n  phase: parse\n  type: SyntaxError\n---*/")]
    (push! [(slice u8)] (mut argv) "build")
    (push! [(slice u8)] (mut argv) "src/main.coil")
    (push! [(slice u8)] (mut argv) "-o")
    (push! [(slice u8)] (mut argv) "/tmp/aot-take-2-test262-selftest-compiler")
    (assert-eq (t262-process! "coil" (load argv) "/tmp/aot-take-2-test262-selftest-build" 30) 0)
    (assert-eq
      (t262-execute-script! "/tmp/aot-take-2-test262-selftest-compiler" "build/release/aot-runtime.o" (al-new [(slice u8)] (alloc/malloc-allocator))
                           "42;" "/tmp/aot-take-2-test262-selftest-normal" (load plain)) T262-PASS)
    (assert-eq
      (t262-execute-script! "/tmp/aot-take-2-test262-selftest-compiler" "build/release/aot-runtime.o" (al-new [(slice u8)] (alloc/malloc-allocator))
                           "return;" "/tmp/aot-take-2-test262-selftest-refusal" (load negative)) T262-PASS)
    (assert-eq
      (t262-execute-script! "/tmp/aot-take-2-test262-selftest-compiler" "build/release/aot-runtime.o" (al-new [(slice u8)] (alloc/malloc-allocator))
                           "var π = 1;" "/tmp/aot-take-2-test262-selftest-unknown" (load negative)) T262-COMPILER-ERROR)
    (assert-eq
      (t262-execute-script! "/tmp/aot-take-2-test262-selftest-compiler" "build/release/aot-runtime.o" (al-new [(slice u8)] (alloc/malloc-allocator))
                           "42;" "/tmp/aot-take-2-test262-selftest-valid" (load negative)) T262-FAIL)
    (assert-eq
      (t262-execute-script! "/tmp/aot-take-2-test262-selftest-compiler" "build/release/aot-runtime.o" (al-new [(slice u8)] (alloc/malloc-allocator))
                           "\"use strict\"; let x; let x;" "/tmp/aot-take-2-test262-selftest-strict-error" (load negative)) T262-PASS)
    (assert-eq
      (t262-execute-script! "/tmp/aot-take-2-test262-selftest-compiler" "build/release/aot-runtime.o" (al-new [(slice u8)] (alloc/malloc-allocator))
                           "\"use strict\"; 42;" "/tmp/aot-take-2-test262-selftest-strict-open" (load negative)) T262-FAIL)
    (assert-eq
      (t262-execute-script! "/tmp/aot-take-2-test262-selftest-compiler" "build/release/aot-runtime.o" (al-new [(slice u8)] (alloc/malloc-allocator))
                           "let Infinity;" "/tmp/aot-take-2-test262-selftest-runtime-error" (load negative)) T262-FAIL)
    (assert-eq
      (t262-execute-script! "/tmp/aot-take-2-test262-selftest-compiler" "build/release/aot-runtime.o" (al-new [(slice u8)] (alloc/malloc-allocator))
                           "$DONOTEVALUATE(); var x; let x;" "/tmp/aot-take-2-test262-selftest-var-error" (load negative)) T262-PASS)
    (al-free! (mut argv))
    (t262-metadata-free! (mut plain))
    (t262-metadata-free! (mut negative))))

(deftest parse_protocol_requires_matching_status_and_complete_record
  (assert-eq (t262-parse-status 73 "AOT-PARSE/1 SyntaxError\n") T262-PARSE-SYNTAX)
  (assert-eq (t262-parse-status 0 "AOT-PARSE/1 normal\n") 0)
  (assert-eq (t262-parse-status 70 "AOT-PARSE/1 SyntaxError\n") T262-COMPILER-ERROR)
  (assert-eq (t262-parse-status 73 "SyntaxError") T262-COMPILER-ERROR)
  (assert-eq (t262-parse-status 73 "AOT-PARSE/1 SyntaxError\nextra\n") T262-COMPILER-ERROR)
  (assert-eq (t262-parse-status 0 "") T262-COMPILER-ERROR))

(deftest parse_negative_plan_has_only_the_test_grammar_unit
  (let [(mut meta) (t262-metadata "/*---\nincludes: [a.js]\nnegative:\n  phase: parse\n  type: SyntaxError\n---*/")]
    (try
        (let [(mut units) (try-or! (t262-plan (load meta) "test/invalid.js" T262-STRICT) (assert false))
              unit (get (load units) 0)]
          (assert-eq (len (load units)) 1)
          (assert-eq (.path unit) "test/invalid.js")
          (assert-eq (.mode unit) T262-STRICT)
          (assert (not (.harness unit)))
          (assert-eq (t262-unavailable (load meta) T262-STRICT (load units)) "")
          (al-free! (mut units))))
    (t262-metadata-free! (mut meta))))

(deftest test262_plans_keep_scripts_separate_and_raw_bytes_untouched
  (let [(mut meta) (t262-metadata "/*---\nflags: [async, onlyStrict]\nincludes: [a.js, b.js]\n---*/")]
    (try
        (let [(mut units) (try-or! (t262-plan (load meta) "test/example.js" T262-STRICT) (assert false))]
          (assert-eq (len (load units)) 6)
          (assert-eq (.path (al-elem [Test262Unit] (mut units) 0)) "assert.js")
          (assert-eq (.path (al-elem [Test262Unit] (mut units) 1)) "sta.js")
          (assert-eq (.path (al-elem [Test262Unit] (mut units) 2)) "doneprintHandle.js")
          (assert-eq (.path (al-elem [Test262Unit] (mut units) 3)) "a.js")
          (assert-eq (.path (al-elem [Test262Unit] (mut units) 4)) "b.js")
          (assert-eq (.mode (al-elem [Test262Unit] (mut units) 0)) T262-SLOPPY)
          (assert-eq (.mode (al-elem [Test262Unit] (mut units) 5)) T262-STRICT)
          (match (t262-unit-source (get (load units) 5) "42;")
            (None [] (assert false))
            (Some [source]
              (assert-eq source "\"use strict\";\n42;")
              (alloc/free [u8] (alloc/malloc-allocator) source)))
          (al-free! (mut units))))
    (t262-metadata-free! (mut meta)))
  (let [(mut meta) (t262-metadata "/*---\nflags: [raw]\nincludes: [unused.js]\n---*/")]
    (try
        (let [(mut units) (try-or! (t262-plan (load meta) "test/raw.js" T262-SLOPPY) (assert false))]
          (assert-eq (len (load units)) 1)
          (match (t262-unit-source (get (load units) 0) "#! source\r\n42;\0")
            (None [] (assert false))
            (Some [source]
              (assert-eq source "#! source\r\n42;\0")
              (alloc/free [u8] (alloc/malloc-allocator) source)))
          (al-free! (mut units))))
    (t262-metadata-free! (mut meta))))

(deftest test262_negative_async_and_file_verdicts_require_complete_evidence
  (let [(mut negative) (t262-metadata "/*---\nnegative:\n  phase: parse\n  type: SyntaxError\n---*/")
        (mut asynchronous) (t262-metadata "/*---\nflags: [async]\n---*/")
        (mut plain) (t262-metadata "/*---\ndescription: ordinary\n---*/")
        (mut results) (al-new [Test262VariantResult] (alloc/malloc-allocator))]
    (assert-eq (t262-verdict (load negative) (JsException "parse" "SyntaxError")) T262-PASS)
    (assert-eq (t262-verdict (load negative) (JsException "runtime" "SyntaxError")) T262-FAIL)
    (assert-eq (t262-verdict (load negative) (JsException "parse" "TypeError")) T262-FAIL)
    (assert-eq (t262-verdict (load negative) (CompilerFailure)) T262-COMPILER-ERROR)
    (assert-eq (t262-verdict (load negative) (HarnessFailure)) T262-HARNESS-ERROR)
    (assert-eq (t262-verdict (load negative) (ProcessCrash)) T262-CRASH)
    (assert-eq (t262-verdict (load negative) (DeadlineExpired)) T262-TIMEOUT)
    (assert-eq (t262-verdict (load negative) (Normal 0 false)) T262-FAIL)
    (assert-eq (t262-verdict (load asynchronous) (Normal 0 false)) T262-FAIL)
    (assert-eq (t262-verdict (load asynchronous) (Normal 1 true)) T262-FAIL)
    (assert-eq (t262-verdict (load asynchronous) (Normal 1 false)) T262-PASS)
    (push! [Test262VariantResult] (mut results) (Test262VariantResult :mode T262-SLOPPY :verdict T262-PASS))
    (assert (not (t262-file-passed? (load plain) (load results))))
    (push! [Test262VariantResult] (mut results) (Test262VariantResult :mode T262-SLOPPY :verdict T262-PASS))
    (assert (not (t262-file-passed? (load plain) (load results))))
    (set! (mut results) 1 (Test262VariantResult :mode T262-STRICT :verdict T262-PASS))
    (assert (t262-file-passed? (load plain) (load results)))
    (set! (mut results) 1 (Test262VariantResult :mode T262-STRICT :verdict T262-UNSUPPORTED))
    (assert (not (t262-file-passed? (load plain) (load results))))
    (al-free! (mut results))
    (t262-metadata-free! (mut negative))
    (t262-metadata-free! (mut asynchronous))
    (t262-metadata-free! (mut plain))))

(deftest test262_metadata_preserves_execution_fields_and_variant_rules
  (let [(mut meta) (t262-metadata "/*---\ndescription: |\n  flags: [raw]\nflags: [generated]\nincludes: [a.js, 'b.js']\nfeatures:\n  - Symbol\nnegative:\n  phase: parse\n  type: SyntaxError\n---*/\ninvalid input")
        (mut modes) (t262-variants (load meta))]
    (assert-eq (.error meta) "")
    (assert-eq (len (load modes)) 2)
    (assert-eq (get (load modes) 0) T262-SLOPPY)
    (assert-eq (get (load modes) 1) T262-STRICT)
    (assert (not (t262-has (.flags meta) "raw")))
    (assert-eq (get (.includes meta) 0) "a.js")
    (assert-eq (get (.includes meta) 1) "b.js")
    (assert (t262-has (.features meta) "Symbol"))
    (assert-eq (.negative-phase meta) "parse")
    (assert-eq (.negative-type meta) "SyntaxError")
    (al-free! (mut modes))
    (t262-metadata-free! (mut meta)))
  (let [(mut meta) (t262-metadata "/*---\nflags:\n  - module\n  - raw\n---*/")
        (mut modes) (t262-variants (load meta))]
    (assert-eq (.error meta) "")
    (assert-eq (len (load modes)) 1)
    (assert-eq (get (load modes) 0) T262-MODULE)
    (al-free! (mut modes))
    (t262-metadata-free! (mut meta))))

(deftest test262_metadata_errors_do_not_become_default_execution
  (let [(mut missing) (t262-metadata "42;")
        (mut unknown) (t262-metadata "/*---\nflags: [futureFlag]\n---*/")
        (mut duplicate) (t262-metadata "/*---\nflags: [raw]\nflags: []\n---*/")
        (mut negative) (t262-metadata "/*---\nnegative:\n  phase: parse\n---*/")]
    (assert (!= (.error missing) ""))
    (assert (!= (.error unknown) ""))
    (assert (!= (.error duplicate) ""))
    (assert (!= (.error negative) ""))
    (t262-metadata-free! (mut missing))
    (t262-metadata-free! (mut unknown))
    (t262-metadata-free! (mut duplicate))
    (t262-metadata-free! (mut negative))))
