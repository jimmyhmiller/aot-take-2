;; Control flow: Region, If, CProj, Phi, Loop — and the two construction windows.

;;
;; These are the traps the value-node unit could not demonstrate. Each test names the failure it
;; guards against, because several of them fail SILENTLY: the graph stays structurally valid and the
;; verifier stays clean while the program means something else.
(module aot.tests.control)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.compare" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.cfg" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.tests.support" :use *)
(import "aot.type.type" :use *)

;; ---------------------------------------------------------------------------
;; Reachability
(deftest start_is_reachable_control_and_has_no_dominator
         (boot! 1)
         (let [st (start-make (ty-int-bot))]
           (assert-eq (ty-tuple-at (n-ty st) 0) TY-CTRL)
           (assert (match (cfg-idom-of st) (Some [_] false) (None [] true)))
           (assert-eq (cfg-idepth-of st) 0)
           (assert (cfg-block-head-of? st))))

(deftest stop_is_a_sink_block_head_below_its_deepest_cfg_input
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               ctrl (cproj-make st 0 "exit")
               stop (stop-make)]
           (n-add-def! stop (Some ctrl))
           (assert (cfg-block-head-of? stop))
           (assert-eq (cfg-idepth-of stop) (+ (cfg-idepth-of ctrl) 1))
           (assert (match (cfg-idom-of stop) (Some [_] false) (None [] true)))))

(deftest a_region_is_reachable_when_some_path_is
         ;; Seeded with XCONTROL and met upward: reachable exactly when SOME path reaching it is.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c1 (cproj-make st 0 "c1")
               r (region-make)]
           (region-add-path! r c1)
           (region-add-path! r (xctrl-make))
           ;; One live path, one dead: the merge is reachable.
           (assert-eq (compute-ty-of r) TY-CTRL)))

(deftest a_region_with_only_dead_paths_is_unreachable
         (boot! 1)
         (let [r (region-make)]
           (region-add-path! r (xctrl-make))
           (region-add-path! r (xctrl-make))
           (assert-eq (compute-ty-of r) TY-XCTRL)))

(deftest iter_collapses_an_all_dead_region_without_reading_a_missing_path
         (boot! 1)
         (let [r (region-make)]
           (region-add-path! r (xctrl-make))
           (region-add-path! r (xctrl-make))
           (let [p (phi-make r (ty-int-bot) "dead.value")]
             (phi-add-value! p (con-int 1))
             (phi-add-value! p (con-int 2))
             (n-keep! p)
             (iter-seed-all!)
             (iter-run!)
             (assert (n-dead? r))
             (assert (or (n-dead? p) (ty-high? (n-ty p)))))))

;; ---------------------------------------------------------------------------
;; The If lattice
(deftest an_if_on_a_high_predicate_decides_NEITHER_arm
         ;; IF_NEITHER from a high predicate does NOT mean both arms are dead. It means nobody has decided
         ;; yet. Reading it as "provably unreachable" is the proven-type trap in its purest form.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               pred (con-make TY-TOP)
               iff (if-make c pred)]
           (assert-eq (n-ty iff) (ty-if-neither))))

(deftest an_if_on_a_constant_picks_one_arm
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")]
           (assert-eq (n-ty (if-make c (con-int 1))) (ty-if-true))
           (assert-eq (n-ty (if-make c (con-int 0))) (ty-if-false))
           (assert-eq (n-ty (if-make c (con-int 7))) (ty-if-true))))

(deftest an_if_routes_every_javascript_falsy_constant_to_false
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")]
           (assert-eq (n-ty (if-make c (con-make TY-NIL))) (ty-if-false))
           (assert-eq (n-ty (if-make c (con-flt (flt--from-bits 0)))) (ty-if-false))
           (assert-eq (n-ty (if-make c (con-flt (flt--from-bits -9223372036854775808))))
                      (ty-if-false))
           (assert-eq (n-ty (if-make c (con-flt (flt--from-bits 0x7ff8000000000000))))
                      (ty-if-false))))

(deftest an_if_whose_predicate_provably_excludes_zero_takes_the_true_arm
         ;; "Would admitting zero WIDEN this type?" If yes, zero was not in it, so the test cannot fail.
         ;; This is how a null check on an already-non-null value deletes itself — and it is the mechanism
         ;; a discharged TypeScript annotation rides on.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               pred (con-make (ty-int-range 1 10))]  ; a range that excludes 0
           (assert-eq (n-ty (if-make c pred)) (ty-if-true)))
         (let [st2 (start-make (ty-int-bot))
               c2 (cproj-make st2 0 "ctrl")
               pred2 (con-make (ty-int-range 0 10))]  ; a range that includes 0: undecided
           (assert-eq (n-ty (if-make c2 pred2)) (ty-if-both))))

(deftest an_if_under_unreachable_control_decides_neither
         (boot! 1)
         (let [iff (if-make (xctrl-make) (con-int 1))]
           (assert-eq (n-ty iff) (ty-if-neither))))

(deftest a_nested_if_recognizes_the_true_arm_truthiness_refinement
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               ctrl (cproj-make st 0 "ctrl")
               value (con-make (ty-int-range 0 9))
               outer (if-make ctrl value)
               arms (if-arms! outer)
               narrowed (truthiness-refine! (arms-true arms) value)
               inner (if-make (arms-true arms) narrowed)]
           ;; The inner predicate is not pointer-identical to the outer predicate, but it is the
           ;; structurally proven nonzero Cast created for that outer true arm.
           (assert (match (if-idealize inner)
                     (Some [progress]
                           (and (n-same? progress inner)
                                (= (n-ty (n-in! inner 1)) (ty-int-con 1))))
                     (None [] false)))))

;; ---------------------------------------------------------------------------
;; The MULTI window
(deftest both_if_arms_are_built_before_either_is_peepholed
         ;; Peephole them one at a time and the first folds to ~ctrl, the If loses its last use, the kill
         ;; cascade takes it, and the sibling rewrites against a corpse whose inputs were cleared but whose
         ;; type was not. `if-arms!` is the only sanctioned constructor for exactly this reason.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               iff (if-make c (con-int 1))
               arms (if-arms! iff)]
           ;; The predicate is constant-true, so the false arm folded to XCtrl and the true arm became the
           ;; If's own control — and CRUCIALLY the If survived long enough for both to be computed.
           (assert-eq (n-op (arms-false arms)) OP-XCTRL)
           (assert (not (n-dead? (arms-true arms))))))

(deftest a_cproj_on_a_dead_arm_becomes_xctrl
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               iff (if-make c (con-int 0))  ; constant FALSE
               arms (if-arms! iff)]
           (assert-eq (n-op (arms-true arms)) OP-XCTRL)))

;; ---------------------------------------------------------------------------
;; Region peepholes
(deftest a_region_with_one_live_path_and_no_phi_collapses_into_it
         ;; >>> THE RULE THAT MAKES INLINING WORK. A Fun IS a Region; inlining leaves it with one input and
         ;; >>> lets THIS rule collapse it. Weaken it and inlining silently stops happening.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               r (region-make)]
           (region-add-path! r c)
           (assert (match (n-peephole-opt! r) (Some [x] (n-same? x c)) (None [] false)))))

(deftest a_region_keeps_its_paths_while_a_phi_is_attached
         ;; Guarded on having no Phis: a one-input Phi collapses on its own, and doing both at once races.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               r (region-make)]
           (region-add-path! r c)
           (let [p (phi-make r (ty-int-bot) "x")]
             (phi-add-value! p (con-int 1))
             (assert (region-has-phi? r))
             ;; With a Phi attached the collapse must NOT fire.
             (assert (match (n-peephole-opt! r) (Some [x] (not (n-same? x c))) (None [] true))))))

(deftest dropping_a_region_path_drops_the_matching_phi_value
         ;; Region arity and Phi arity are ONE invariant. Diverging for even one peephole gives a Phi
         ;; reading the wrong arm — a miscompile that typechecks cleanly.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c1 (cproj-make st 0 "c1")
               c2 (fresh-ctrl (cproj-make st 0 "c0"))
               r (region-make)]
           (region-add-path! r c1)
           (region-add-path! r c2)
           (let [p (phi-make r (ty-int-bot) "x")]
             (phi-add-value! p (con-int 10))
             (phi-add-value! p (con-int 20))
             (n-keep! p)
             (assert-eq (n-nins r) 3)
             (assert-eq (n-nins p) 3)
             (region-del-path! r 2)
             ;; BOTH shrank, together.
             (assert-eq (n-nins r) 2)
             (assert-eq (n-nins p) 2)
             ;; And the surviving value is the one that belonged to the surviving path.
             (assert-eq (n-ty (n-in! p 1)) (ty-int-con 10)))))

;; ---------------------------------------------------------------------------
;; Phi
(deftest a_phi_over_two_paths_meets_only_the_live_ones
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c1 (cproj-make st 0 "c1")
               r (region-make)]
           (region-add-path! r c1)
           (region-add-path! r (xctrl-make))
           (let [p (phi-make r (ty-int-bot) "x")]
             (phi-add-value! p (con-int 10))
             (phi-add-value! p (con-int 999))
             ;; The second path is dead, so its value does not participate: the meet is just 10.
             (assert-eq (compute-ty-of p) (ty-int-con 10)))))

(deftest a_phi_with_one_distinct_input_becomes_it
         ;; >>> The other half of inlining: when a Fun collapses, its Parms are Phis with one distinct
         ;; >>> value — the caller's actual argument. Argument substitution IS this rule.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c1 (cproj-make st 0 "c1")
               c2 (fresh-ctrl (cproj-make st 0 "c0"))
               r (region-make)
               v (con-int 42)]
           (region-add-path! r c1)
           (region-add-path! r c2)
           (let [p (phi-make r (ty-int-bot) "x")]
             (phi-add-value! p v)
             (phi-add-value! p v)
             (n-keep! p)
             (assert (match (phi-single-unique-input p) (Some [u] (n-same? u v)) (None [] false))))))

(deftest a_phi_ignores_self_references_when_looking_for_a_unique_input
         ;; A loop Phi whose only other input is itself must collapse.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c1 (cproj-make st 0 "c1")
               c2 (fresh-ctrl (cproj-make st 0 "c0"))
               r (region-make)
               v (con-int 7)]
           (region-add-path! r c1)
           (region-add-path! r c2)
           (let [p (phi-make r (ty-int-bot) "x")]
             (phi-add-value! p v)
             (phi-add-value! p p)  ; self-reference
             (n-keep! p)
             (assert (match (phi-single-unique-input p) (Some [u] (n-same? u v)) (None [] false))))))

(deftest phi_uniqueness_ignores_values_on_dead_control_paths
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               live-ctrl (cproj-make st 0 "live")
               dead-ctrl (xctrl-make)
               r (region-make)
               live (con-int 7)
               dead (con-int 999)]
           (region-add-path! r live-ctrl)
           (region-add-path! r dead-ctrl)
           (let [p (phi-make r (ty-int-bot) "x")]
             (phi-add-value! p live)
             (phi-add-value! p dead)
             (n-keep! p)
             (assert (match (phi-single-unique-input p)
                       (Some [u] (n-same? u live))
                       (None [] false))))))

(deftest a_dead_entry_loop_phi_waits_for_control_to_collapse
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               l (loop-make (xctrl-make))
               p (phi-make l (ty-int-bot) "dead.i")]
           (phi-add-value! p (con-int 0))
           (phi-open! p)
           (phi-close! p (con-int 1))
           (loop-close! l (cproj-make st 0 "back"))
           (n-keep! p)
           (assert (match (phi-single-unique-input p) (Some [_] false) (None [] true)))))

;; ---------------------------------------------------------------------------
;; The IN-PROGRESS window — the trap that deletes loops silently
(deftest an_in_progress_region_reports_CONTROL_regardless_of_its_paths
         (boot! 1)
         (let [r (region-make)]
           (region-add-path! r (xctrl-make))
           (region-open! r)
           (assert (region-in-progress? r))
           ;; Every path is dead, yet it reports CONTROL: the window is what keeps the half-built merge
           ;; from being folded away before the real path arrives.
           (assert-eq (compute-ty-of r) TY-CTRL)))

(deftest an_in_progress_phi_reports_its_DECLARED_type_not_the_meet
         ;; THE loop-deleting trap. If the Phi reported the meet of what it has so far, a loop counter
         ;; would read its initial value, `i+1` would fold to a literal, the Phi would lose its only other
         ;; user, and the whole loop would go — every step locally justified, no error reported.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               entry (cproj-make st 0 "entry")
               l (loop-make entry)]
           (assert (loop-in-progress? l))
           (let [p (phi-make l (ty-int-bot) "i")]
             (phi-add-value! p (con-int 0))
             (phi-open! p)
             ;; The meet so far would be the constant 0. The declared type is what must be reported.
             (assert-eq (compute-ty-of p) (ty-int-bot))
             (assert-ne (compute-ty-of p) (ty-int-con 0)))))

(deftest open_phi_inputs_are_not_all_constants_or_gvn_equal
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               l (loop-make (cproj-make st 0 "entry"))
               p1 (phi-make l (ty-int-bot) "i")
               p2 (phi-make l (ty-int-bot) "j")
               probe (con-int 9)]
           (phi-add-value! p1 (con-int 0))
           (phi-open! p1)
           (phi-add-value! p2 (n-in! p1 1))
           (phi-open! p2)
           (assert (not (n-all-cons? p1 probe)))
           (assert (not (n-gvn-eq? p1 p2)))))

(deftest an_in_progress_phi_refuses_constant_folding
         ;; The engine's `no-const-fold?` hook, which was reserved for exactly this. A Phi whose declared
         ;; type happens to be constant must NOT be replaced by that constant while its Region is open.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               entry (cproj-make st 0 "entry")
               l (loop-make entry)]
           (let [p (phi-make l (ty-int-con 5) "i")]
             (phi-add-value! p (con-int 5))
             (phi-open! p)
             (n-keep! p)
             (assert (no-const-fold-of? p))
             ;; It survives a peephole rather than folding to Con 5.
             (assert-eq (n-op (n-peephole! p)) OP-PHI))))

(deftest a_phi_stays_in_progress_when_control_closes_first
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               l (loop-make (cproj-make st 0 "entry"))
               p1 (phi-make l (ty-int-con 5) "i")
               p2 (phi-make l (ty-int-con 5) "j")]
           (phi-add-value! p1 (con-int 5))
           (phi-open! p1)
           (phi-add-value! p2 (n-in! p1 1))
           (phi-open! p2)
           ;; Exercise final Simple's brief endLoop intermediate state directly. Phi openness, not
           ;; just Loop openness, must prevent compute, folding, and GVN from consuming it.
           (loop-close! l (cproj-make st 0 "back"))
           (assert (phi-in-progress? p1))
           (assert-eq (compute-ty-of p1) (ty-int-con 5))
           (assert (no-const-fold-of? p1))
           (assert (not (n-gvn-eq? p1 p2)))
           (n-keep! p1)
           (assert-eq (n-op (n-peephole! p1)) OP-PHI)))

(deftest a_closed_loop_phi_reports_the_meet_of_its_arms
         ;; Final Simple's full order: build inside the window, close CONTROL, immediately close PHIS.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               entry (cproj-make st 0 "entry")
               l (loop-make entry)]
           (let [p (phi-make l (ty-int-range 0 10) "i")]
             (phi-add-value! p (con-int 0))
             (phi-open! p)
             (n-keep! p)
             ;; 4. close control
             (loop-close! l (fresh-ctrl (cproj-make st 0 "c0")))
             ;; 5. immediately close the Phi before any peephole runs
             (phi-close! p (con-int 3))
             (assert (not (loop-in-progress? l)))
             ;; The live-arm meet is [0..3], and because this is a falling Loop Phi its first
             ;; widening stage is attached immediately.
             (let [t (compute-ty-of p)]
               (assert-eq (ty-int-lo t) 0)
               (assert-eq (ty-int-hi t) 3)
               (assert-eq (ty-int-widen t) 1)))))

(deftest closing_a_loop_twice_is_a_named_error_not_silent_corruption
         ;; `loop-close!` on an already-closed loop means the caller lost track of the protocol. It must
         ;; say so rather than overwrite the back edge.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               entry (cproj-make st 0 "entry")
               l (loop-make entry)]
           (loop-close! l (fresh-ctrl (cproj-make st 0 "c0")))
           (assert (not (loop-in-progress? l)))))

;; ---------------------------------------------------------------------------
;; Dominators
(deftest a_loops_dominator_is_its_entry_not_the_lca
         ;; A back edge dominates nothing, so a Loop bypasses Region's LCA entirely.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               entry (cproj-make st 0 "entry")
               l (loop-make entry)]
           (loop-close! l (fresh-ctrl (cproj-make st 0 "c0")))
           (assert (match (cfg-idom-of l) (Some [d] (n-same? d entry)) (None [] false)))))

(deftest idepth_increases_down_the_dominator_tree
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               iff (if-make c (con-make (ty-int-range 0 10)))
               arms (if-arms! iff)]
           (assert-eq (cfg-idepth-of st) 0)
           (assert (> (cfg-idepth-of c) (cfg-idepth-of st)))
           (assert (> (cfg-idepth-of iff) (cfg-idepth-of c)))))

(deftest the_idepth_cache_is_invalidated_by_a_control_mutation
         ;; A stale dominator does not crash — it schedules a node outside its own dominance region, which
         ;; is a miscompile. So the cache is version-checked against a counter any control edit bumps.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")]
           (cfg-idepth-of c)
           (assert (n-idepth-valid? c))
           (invalidate-cfg!)
           (assert (not (n-idepth-valid? c)))))

(deftest an_empty_diamond_collapses_at_two_paths_and_at_more
         ;; `if (pred) {} else {}` — both arms of one If reach a Region with no Phi, so the If contributes
         ;; exactly its own control, once.
         ;;
         ;; A DIVERGENCE FROM SIMPLE, tested in both shapes: Simple guards this with `nIns()>3` and then
         ;; opens with an `nIns()==3` branch that guard makes unreachable, so its live path only handles
         ;; the fat case. Both cases are correct, so both are implemented.
         (boot! 1)
         ;; Two paths: the Region becomes the If's own control.
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               iff (if-make c (con-make (ty-int-range 0 10)))
               arms (if-arms! iff)
               r (region-make)]
           (region-add-path! r (arms-true arms))
           (region-add-path! r (arms-false arms))
           (assert (match (n-peephole-opt! r) (Some [x] (n-same? x c)) (None [] false))))
         0)

(deftest a_fat_empty_diamond_loses_one_path
         ;; Three paths, two of them the same If arms: path 1 becomes the If control and path 2 goes,
         ;; leaving a two-path Region.
         (boot! 2)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               other (fresh-ctrl (cproj-make st 0 "c0"))
               iff (if-make c (con-make (ty-int-range 0 10)))
               arms (if-arms! iff)
               r (region-make)]
           (region-add-path! r (arms-true arms))
           (region-add-path! r (arms-false arms))
           (region-add-path! r other)
           (assert-eq (n-nins r) 4)
           (assert (match (n-peephole-opt! r) (Some [x] (n-same? x r)) (None [] false)))
           (assert-eq (n-nins r) 3)
           ;; And the surviving first path is the If's own incoming control.
           (assert (n-same? (n-in! r 1) c))))

(deftest stacked_regions_flatten_and_splice_their_phis
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c1 (cproj-make st 0 "c1")
               c2 (fresh-ctrl (cproj-make st 0 "c2"))
               other (fresh-ctrl (cproj-make st 0 "other"))
               inner (region-make)]
           (region-add-path! inner c1)
           (region-add-path! inner c2)
           (let [inner-phi (phi-make inner (ty-int-bot) "inner")]
             (phi-add-value! inner-phi (con-int 10))
             (phi-add-value! inner-phi (con-int 20))
             (let [outer (region-make)]
               (region-add-path! outer inner)
               (region-add-path! outer other)
               (let [outer-phi (phi-make outer (ty-int-bot) "outer")]
                 (phi-add-value! outer-phi inner-phi)
                 (phi-add-value! outer-phi (con-int 99))
                 (n-keep! outer-phi)
                 (assert (match (region--flatten-stacked! outer)
                           (Some [replacement] (n-same? replacement outer))
                           (None [] false)))
                 ;; The old inner-Region slot is dead. Its two paths and the matching two Phi
                 ;; values were appended in the same order.
                 (assert-eq (n-nins outer) 5)
                 (assert-eq (n-nins outer-phi) 5)
                 (assert-eq (n-ty (n-in! outer 1)) TY-XCTRL)
                 (assert (n-same? (n-in! outer 3) c1))
                 (assert (n-same? (n-in! outer 4) c2))
                 (assert-eq (n-ty (n-in! outer-phi 3)) (ty-int-con 10))
                 (assert-eq (n-ty (n-in! outer-phi 4)) (ty-int-con 20)))))))

(deftest stacked_regions_refuse_to_flatten_across_a_mid_user
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               inner (region-make)]
           (region-add-path! inner (cproj-make st 0 "c1"))
           (region-add-path! inner (fresh-ctrl (cproj-make st 0 "c2")))
           (let [inner-phi (phi-make inner (ty-int-bot) "inner")]
             (phi-add-value! inner-phi (con-int 10))
             (phi-add-value! inner-phi (con-int 20))
             ;; This Add consumes the value between the two merges. Flattening through it would
             ;; require distribution, which this local Region rule deliberately refuses.
             (n-keep! (add-make inner-phi (con-int 1)))
             (let [outer (region-make)]
               (region-add-path! outer inner)
               (region-add-path! outer (fresh-ctrl (cproj-make st 0 "other")))
               (let [outer-phi (phi-make outer (ty-int-bot) "outer")]
                 (phi-add-value! outer-phi inner-phi)
                 (phi-add-value! outer-phi (con-int 99))
                 (n-keep! outer-phi)
                 (assert (match (region--flatten-stacked! outer)
                           (Some [_] false)
                           (None [] true)))
                 (assert-eq (n-nins outer) 3)
                 (assert-eq (n-nins outer-phi) 3))))))

(deftest cproj_flips_an_if_of_not_and_selects_the_opposite_arm
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               ctrl (cproj-make st 0 "ctrl")
               x (con-make (ty-int-range 0 10))
               iff (if-make ctrl (not-make x))
               true-arm (cproj-make iff IF-TRUE-IDX "True")
               false-arm (cproj-make iff IF-FALSE-IDX "False")]
           ;; Both old arms exist before asking either to idealize.
           (n-keep! false-arm)
           (assert (match (cproj-idealize true-arm IF-TRUE-IDX)
                     (Some [replacement]
                           (let [new-if (n-in! replacement 0)]
                             (and (= (cproj-idx replacement) IF-FALSE-IDX)
                                  (and (= (n-op new-if) OP-IF)
                                       (n-same? (n-in! new-if 1) x)))))
                     (None [] false)))
           (n-unkeep! false-arm)))

(deftest phi_pulls_matching_scalar_operations_below_the_merge
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               region (region-make)
               common (con-int 10)]
           (region-add-path! region (cproj-make st 0 "left"))
           (region-add-path! region (fresh-ctrl (cproj-make st 0 "right")))
           (let [left (add-make-mode (con-int 1) common MODE-INT)
                 right (add-make-mode (con-int 2) common MODE-INT)
                 phi (phi-make region (ty-int-bot) "sum")]
             (phi-add-value! phi left)
             (phi-add-value! phi right)
             (n-keep! phi)
             (let [before (arena-node-count)]
               (match (phi-idealize phi)
                 (None [] (assert false))
                 (Some [pulled]
                       (do
                         ;; One merged-input Phi plus one copied Add. A capability probe must not
                         ;; allocate and wire a second throwaway Add.
                         (assert-eq (- (arena-node-count) before) 2)
                         (assert-eq (n-op pulled) OP-ADD)
                         (assert-eq (n-op (n-in! pulled ARITH-LHS)) OP-PHI)
                         (assert (n-same? (n-in! pulled ARITH-RHS) common)))))))))

(deftest phi_comparison_pull_down_derives_operand_bounds_instead_of_boolean_result_bounds
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               region (region-make)
               common (con-make (ty-flt-bot))]
           (region-add-path! region (cproj-make st 0 "left"))
           (region-add-path! region (fresh-ctrl (cproj-make st 0 "right")))
           (let [left (lt-make (con-make (ty-flt-con 1.0)) common)
                 right (lt-make (con-make (ty-flt-con 2.0)) common)
                 phi (phi-make region (ty-bool) "comparison")]
             (phi-add-value! phi left)
             (phi-add-value! phi right)
             (n-keep! phi)
             (match (phi-idealize phi)
               (None [] (assert false))
               (Some [pulled]
                 (do
                   (assert-eq (n-op pulled) OP-LT)
                   (assert (ty-flt? (phi-declared-ty (n-in! pulled CMP-LHS))))
                   (assert (ty-flt? (n-ty (n-in! pulled CMP-LHS))))
                   (assert-eq (compute pulled) (ty-bool))))))))

(deftest phi_refuses_to_duplicate_two_operations_with_other_users
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               region (region-make)
               common (con-int 10)]
           (region-add-path! region (cproj-make st 0 "left"))
           (region-add-path! region (fresh-ctrl (cproj-make st 0 "right")))
           (let [left (add-make-mode (con-int 1) common MODE-INT)
                 right (add-make-mode (con-int 2) common MODE-INT)
                 phi (phi-make region (ty-int-bot) "sum")]
             (phi-add-value! phi left)
             (phi-add-value! phi right)
             (n-keep! phi)
             ;; Both candidates now have an additional real user. Pulling down would duplicate
             ;; both operations instead of reducing the graph.
             (n-keep! (sub-make-mode left common MODE-INT))
             (n-keep! (sub-make-mode right common MODE-INT))
             (assert (match (phi-idealize phi) (Some [_] false) (None [] true))))))

(deftest phi_merging_zero_and_a_truthy_refinement_recovers_the_original_value
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               ctrl (cproj-make st 0 "ctrl")
               value (con-make (ty-int-range 0 9))
               iff (if-make ctrl value)
               arms (if-arms! iff)
               narrowed (truthiness-refine! (arms-true arms) value)
               region (region-make)]
           (region-add-path! region (arms-false arms))
           (region-add-path! region (arms-true arms))
           (let [phi (phi-make region (ty-int-bot) "truthy-merge")]
             (phi-add-value! phi (con-int 0))
             (phi-add-value! phi narrowed)
             (n-keep! phi)
             (assert (match (phi-idealize phi)
                       (Some [replacement] (n-same? replacement value))
                       (None [] false))))))

(deftest phi_pulls_matching_unary_operations_below_the_merge
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               region (region-make)]
           (region-add-path! region (cproj-make st 0 "left"))
           (region-add-path! region (fresh-ctrl (cproj-make st 0 "right")))
           (let [phi (phi-make region (ty-int-bot) "neg")]
             (phi-add-value! phi (minus-make-mode (con-int 1) MODE-INT))
             (phi-add-value! phi (minus-make-mode (con-int 2) MODE-INT))
             (n-keep! phi)
             (assert (match (phi-idealize phi)
                       (Some [replacement]
                             (and (= (n-op replacement) OP-MINUS)
                                  (= (n-op (n-in! replacement 1)) OP-PHI)))
                       (None [] false))))))

;; A Region merging both arms of an If is dominated by that If, even while one more of its paths
;; hangs under a branch whose control was just replaced by XCtrl and whose subtree has not been
;; retyped: that path's dominator chain ends at the XCtrl, and a chain that ends without meeting
;; the others is ignored (aot.node.control, region-lca-path). Restarting the LCA at the next path
;; instead put the dominator inside one arm, and the dominating-test hunt then folded the other
;; arm's repeated test to the wrong constant (found by tests/pipeline-test.coil under seed 41).
(deftest a_region_dominator_ignores_a_path_whose_chain_ended_in_a_dead_subtree
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               iff (if-make c (con-make (ty-int-range 0 10)))
               arms (if-arms! iff)
               live-true (arms-true arms)
               live-false (arms-false arms)
               inner (if-make live-true (con-make (ty-int-range 0 10)))
               inner-arms (if-arms! inner)
               stale (arms-true inner-arms)
               r (region-make)]
           (region-add-path! r live-true)
           (region-add-path! r stale)
           (region-add-path! r live-false)
           (let [r2 (region-make)]
             (region-add-path! r2 stale)
             (region-add-path! r2 live-false)
             (region-add-path! r2 live-true)
             ;; The inner branch dies without its projections being retyped yet (the Regions hold
             ;; the true arm alive through the edit).
             (n-set-def! inner 0 (Some (xctrl-make)))
             (assert-eq (n-ty stale) TY-CTRL)
             (assert (match (cfg-idom-of r) (Some [d] (n-same? d iff)) (None [] false)))
             ;; The order of the paths does not matter either.
             (assert (match (cfg-idom-of r2) (Some [d] (n-same? d iff)) (None [] false))))))
