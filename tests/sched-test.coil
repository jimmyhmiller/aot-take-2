;; Block-local dependency scheduling over selected machine graphs.
(module aot.tests.sched)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.call" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.memory" :use *)
(import "aot.codegen.looptree" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.gcm" :use *)
(import "aot.codegen.listsched" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.node.cpus.arm64" :use *)
(import "aot.node.cpus.arm64.call" :use *)
(import "aot.node.cpus.arm64.split" :use *)
(import "aot.shape" :use *)
(import "aot.type.type" :use *)

(defn scheduled-index [(block (dyn NodeOps)) (needle (dyn NodeOps))] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop (if (>= (load i) (code-schedule-count block))
              (break 0)
              (do
                (if (n-same? (code-schedule-at block (load i)) needle)
                    (set! (mut found) (load i))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

(deftest local_schedule_is_durable_and_places_definitions_before_uses_and_cfg_tail_last
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "schedule")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 arg (parm-make fun 0 (ty-int-bot) "x")
                 add (add-make arg (con-make (ty-int-con 5000)))
                 mul (mul-make add (con-make (ty-int-con 3)))
                 ret (return-make fun
                                  (Some (con-make (ty-mem 1 TY-BOT)))
                                  mul
                                  (Some rpc)
                                  (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-mul (n-in! selected-ret RETURN-VALUE)
                   selected-add (n-in! selected-mul 1)
                   selected-arg (n-in! selected-add 1)
                   selected-constant (n-in! selected-add 2)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (let [(mut state) (sched-state-new)]
                 (sched-collect! selected-fun (mut state))
                 (sched-count-inputs! selected-fun (mut state))
                 (sched-compute-flags! selected-fun (mut state))
                 (assert (get (.single state) (n-nid selected-arg)))
                 ;; Final Simple's ParmNode extends PhiNode, so it receives Phi's fixed entry score
                 ;; instead of the ordinary pressure score its Return use would otherwise distort.
                 (assert-eq (sched-score selected-arg (mut state)) 1000)
                 (assert (> (sched-score selected-arg (mut state))
                            (sched-score selected-constant (mut state)))))
               (sched-run!)
               (assert (n-same? (code-schedule-at selected-fun 0) selected-fun))
               (assert (< (scheduled-index selected-fun selected-arg)
                          (scheduled-index selected-fun selected-constant)))
               (assert (< (scheduled-index selected-fun selected-arg)
                          (scheduled-index selected-fun selected-add)))
               (assert (< (scheduled-index selected-fun selected-add)
                          (scheduled-index selected-fun selected-mul)))
               (assert (< (scheduled-index selected-fun selected-mul)
                          (scheduled-index selected-fun selected-ret)))
               (assert-eq (scheduled-index selected-fun selected-ret)
                          (- (code-schedule-count selected-fun) 1))))))

(deftest local_schedule_preserves_a_gcm_load_before_store_antidependence
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 object-ty (ty-struct "ScheduledAntiObject")
                 pointer-ty (ty-memptr false object-ty)
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) pointer-ty) "schedule-anti")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 pointer (parm-make fun 0 pointer-ty "object")
                 memory (con-make (ty-mem 7 TY-BOT))
                 offset (con-make (ty-int-con 0))
                 load_ (load-make fun memory pointer offset 7 (ty-int-bot))
                 store (store-make fun memory pointer offset (con-make (ty-int-con 9))
                                   7 (ty-int-bot))
                 ret (return-make fun (Some store) load_ (Some rpc) (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-store (n-in! selected-ret RETURN-MEM)
                   selected-load (n-in! selected-ret RETURN-VALUE)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (sched-run!)
               (assert (n-has? (.ins (hdr selected-store)) selected-load))
               (assert (< (scheduled-index selected-fun selected-load)
                          (scheduled-index selected-fun selected-store)))))))

(deftest zero_byte_projections_are_scheduled_immediately_after_their_multi_definition
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "schedule-proj")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 object-ty (ty-struct "ScheduledAllocation")
                 allocation
                   (new-make fun
                             (con-make (ty-int-con 32))
                             (con-make (ty-mem 1 TY-BOT))
                             SHAPE-EMPTY
                             object-ty)
                 pointer (proj-make allocation 0 "allocation.pointer")
                 memory (proj-make allocation 1 "allocation.memory")
                 ret (return-make fun (Some memory) pointer (Some rpc) (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-pointer (n-in! selected-ret RETURN-VALUE)
                   selected-memory (n-in! selected-ret RETURN-MEM)
                   selected-allocation (n-in! selected-pointer 0)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (sched-run!)
               (let [allocation-index (scheduled-index selected-fun selected-allocation)
                     pointer-index (scheduled-index selected-fun selected-pointer)
                     memory-index (scheduled-index selected-fun selected-memory)
                     first-proj (if (< pointer-index memory-index) pointer-index memory-index)
                     second-proj (if (> pointer-index memory-index) pointer-index memory-index)]
                 (assert-eq first-proj (+ allocation-index 1))
                 (assert-eq second-proj (+ allocation-index 2)))))))

(deftest remote_cfg_users_do_not_look_like_the_current_blocks_tail
         (do
           (boot! 7)
           (code-reset! 7)
           (let [start (start-make (ty-int-bot))
                 fun
                   (fun-make start
                             (ty-tuple-of3 (ty-int-bot) (ty-int-bot) (ty-int-bot))
                             "remote-tail")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 arg (parm-make fun 0 (ty-int-bot) "x")
                 value (parm-make fun 1 (ty-int-bot) "value")
                 iff (if-make fun arg)
                 arms (if-arms! iff)
                 merge (region-make)
                 ret
                   (return-make merge
                                (Some (con-make (ty-mem 1 TY-BOT)))
                                value
                                (Some rpc)
                                (Some fun))
                 stop (stop-make)]
             (region-add-path! merge (arms-true arms))
             (region-add-path! merge (arms-false arms))
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-value (n-in! selected-ret RETURN-VALUE)
                   selected-fun (n-in! selected-value 0)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (let [(mut state) (sched-state-new)]
                 (sched-collect! selected-fun (mut state))
                 (sched-count-inputs! selected-fun (mut state))
                 (sched-compute-flags! selected-fun (mut state))
                 (assert (get (.remote-def state) (n-nid selected-value)))
                 ;; The Return consumes `value` in the Region block. It is a remote use, not the
                 ;; Fun block's CFG tail, and therefore does not trigger the fixed-register stall.
                 (assert-eq (sched-opening-pressure selected-value (mut state)) 0))))))

(deftest allocation_projection_wrappers_do_not_turn_the_multi_into_a_cfg_tail
         (do
           (boot! 9)
           (code-reset! 9)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "multi-pressure")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 object-ty (ty-struct "MultiPressureObject")
                 allocation
                   (new-make fun
                             (con-int 32)
                             (con-make (ty-mem 1 TY-BOT))
                             SHAPE-EMPTY
                             object-ty)
                 pointer (proj-make allocation 0 "pointer")
                 memory (proj-make allocation 1 "memory")
                 store
                   (store-make fun memory pointer (con-int 0) (con-int 7) 11 (ty-int-bot))
                 ret (return-make fun (Some store) (con-int 0) (Some rpc) (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-store (n-in! selected-ret RETURN-MEM)
                   selected-memory (n-in! selected-store 1)
                   selected-allocation (n-in! selected-memory 0)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (let [(mut state) (sched-state-new)]
                 (sched-collect! selected-fun (mut state))
                 (sched-count-inputs! selected-fun (mut state))
                 (sched-compute-flags! selected-fun (mut state))
                 (assert (< (sched-opening-pressure selected-allocation (mut state)) 10000))
                 (assert (> (sched-score selected-allocation (mut state)) 1)))))))

(deftest callee_save_entry_split_precedes_the_first_ordinary_body_definition
         (do
           (boot! 10)
           (code-reset! 10)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "save-split")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 body (add-make-mode (con-int 5000) (con-int 7000) MODE-INT)
                 ret (return-make fun
                                  (Some (con-make (ty-mem 1 TY-BOT)))
                                  body
                                  (Some rpc)
                                  (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-body (n-in! selected-ret RETURN-VALUE)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (let [save (arm64-callee-save-make selected-fun selected-ret ARM-D8)
                     other-save (arm64-callee-save-make selected-fun selected-ret ARM-X19)
                     split (arm64-split-make 1 "entry-save" 0)]
                 ;; Model final Simple's `insertAfter(CalleeSave)`: allocation has created the
                 ;; entry-side Split and will rebuild the durable schedule from placement facts.
                 (n-set-block-nid! save (n-nid selected-fun))
                 (n-set-early-nid! save (n-nid selected-fun))
                 (n-set-block-nid! other-save (n-nid selected-fun))
                 (n-set-early-nid! other-save (n-nid selected-fun))
                 (arm64-split-bind! split selected-fun save)
                 (n-set-block-nid! split (n-nid selected-fun))
                 (n-set-early-nid! split (n-nid selected-fun))
                 (sched-run!)
                 (let [(mut state) (sched-state-new)]
                   (assert-eq (sched-score split (mut state)) 1000))
                 (assert (< (scheduled-index selected-fun other-save)
                            (scheduled-index selected-fun split)))
                 (assert (< (scheduled-index selected-fun save)
                            (scheduled-index selected-fun split)))
                 (assert (< (scheduled-index selected-fun split)
                            (scheduled-index selected-fun selected-body))))))))

(deftest local_schedule_collection_scales_with_block_outputs_not_the_whole_arena
         (do
           (boot! 11)
           (code-reset! 11)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "sparse-schedule")
                 rpc (parm-make-slot fun 0 (ty-int-bot) "$rpc")
                 arg (parm-make fun 0 (ty-int-bot) "x")
                 value (add-make-mode arg (con-int 5000) MODE-INT)
                 ret (return-make fun
                                  (Some (con-make (ty-mem 1 TY-BOT)))
                                  value
                                  (Some rpc)
                                  (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)
                   (mut i) 0]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               ;; Inflate the shared arena with selected nodes that belong to no scheduled block.
               ;; Final Simple's local scheduler never sees them because it walks block outputs.
               (loop (if (>= (load i) 512)
                         (break 0)
                         (do
                           (arm64-select (con-int (load i)))
                           (set! (mut i) (+ (load i) 1))
                           (continue))))
               (assert (> (arena-node-count) 1000))
               (assert (> (sched-run!) 1))
               (assert (< (sched-last-collect-visits) 128))
               (assert-eq (sched-last-state-init-visits) (+ (arena-node-count) 1))
               (assert (> (code-schedule-count selected-fun) 1))))))
