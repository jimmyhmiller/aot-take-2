;; Ordinary-object property backing storage and its precise memory slices.

(module aot.tests.property)
(import "coil.assert" :use *)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.call" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.property" :use *)
(import "aot.node.jsops" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.shape" :use *)
(import "aot.heap" :use *)
(import "aot.facts" :use *)
(import "aot.type.type" :use *)
(import "aot.verify" :use *)
(import "aot.jsl.lower" :use [jsl-lower-new-object])

(deftest shaped_property_storage_initializes_every_precise_alias_before_publication
         (do
           (boot! 1)
           (let [left-shape (shape-transition SHAPE-EMPTY "storage-left")
                 tree-shape (shape-transition left-shape "storage-right")
                 left (box-make (con-int 11))
                 right (box-make (con-int 22))
                 (mut values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
             (push! [(dyn NodeOps)] (mut values) left)
             (push! [(dyn NodeOps)] (mut values) right)
             (let [storage
                     (property-storage-new (con-make TY-CTRL)
                                           (con-make (ty-mem ALIAS-BULK TY-BOT))
                                           tree-shape
                                           (load values))
                   ptr_ (.ptr_ storage)
                   fresh (n-in! ptr_ 0)
                   left-load
                     (load-make (con-make TY-CTRL)
                                (.mem storage)
                                ptr_
                                (con-int 0)
                                (shape-alias-key tree-shape
                                                 (shape-key-intern "storage-left"))
                                (ty-dyn TAG-ANY))
                   right-load
                     (load-make (con-make TY-CTRL)
                                (.mem storage)
                                ptr_
                                (con-int SHAPE-WORD-BYTES)
                                (shape-alias-key tree-shape
                                                 (shape-key-intern "storage-right"))
                                (ty-dyn TAG-ANY))]
               (assert-eq (n-op fresh) OP-NEW)
               (assert-eq (new-shape fresh) tree-shape)
               (assert-eq (new-object-ty fresh) (ty-struct "JsPropertyStorage"))
               (assert-eq (n-ty (n-in! fresh 1)) (ty-int-con 16))
               (assert (n-same? (n-in! (memmerge-alias (.mem storage)
                                                       (shape-alias-key tree-shape
                                                                        (shape-key-intern "storage-left")))
                                       STORE-VAL)
                                left))
               (assert (n-same? (n-in! (memmerge-alias (.mem storage)
                                                       (shape-alias-key tree-shape
                                                                        (shape-key-intern "storage-right")))
                                       STORE-VAL)
                                right))
               (assert-eq (verify-all) VERR-OK)
               ;; Each load folds to its stored boxed integer, range included.
               (assert-eq (n-ty (n-peephole! left-load))
                          (ty-dyn-with-int TAG-INT (ty-int-con 11)))
               (assert-eq (n-ty (n-peephole! right-load))
                          (ty-dyn-with-int TAG-INT (ty-int-con 22)))
               (assert-eq (verify-all) VERR-OK)))))

(deftest publishing_property_storage_preserves_owner_and_field_memory_slices
         (do
           (boot! 2)
           (let [ctrl (con-make TY-CTRL)
                 public-mem (con-make (ty-mem ALIAS-BULK TY-BOT))
                 object (jsl-lower-new-object ctrl public-mem)
                 leaf-shape (shape-transition SHAPE-EMPTY "published-item")
                 item (box-make (con-int 7))
                 (mut values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
             (push! [(dyn NodeOps)] (mut values) item)
             (let [storage
                     (property-storage-new ctrl
                                           public-mem
                                           leaf-shape
                                           (load values))
                   installed
                     (property-storage-install ctrl
                                               (.mem object)
                                               (.value object)
                                               leaf-shape
                                               storage)
                   owner-store
                     (memmerge-alias installed ALIAS-OBJECT-PROPERTIES)
                   field-alias
                     (shape-alias-key leaf-shape
                                      (shape-key-intern "published-item"))]
               (assert-eq (n-op owner-store) OP-STORE)
               (assert (n-same? (n-in! owner-store MEM-PTR) (.value object)))
               (assert-eq (n-op (n-in! owner-store STORE-VAL)) OP-BOX)
               (assert (n-same? (n-in! (n-in! owner-store STORE-VAL) 1)
                                (.ptr_ storage)))
               (assert (n-same? (memmerge-alias installed field-alias)
                                (memmerge-alias (.mem storage) field-alias)))
               (assert-eq (verify-all) VERR-OK)))))

;; An owner whose backing store is not statically visible takes ONE runtime operation over the
;; shape tree (docs/DECISIONS.md, generic property access): a JsOp whose value is the result and
;; whose memory is public BOT, never an enumeration of shapes.
(deftest ordinary_own_property_access_is_one_runtime_shape_tree_operation
         (do
           (boot! 3)
           (let [ctrl (con-make TY-CTRL)
                 public-mem (con-make (ty-mem ALIAS-BULK TY-BOT))
                 object (jsl-lower-new-object ctrl public-mem)
                 key (shape-key-intern "dispatched-item")
                 item-shape (shape-transition SHAPE-EMPTY "dispatched-item")
                 item (box-make (con-int 31))
                 (mut values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
             (push! [(dyn NodeOps)] (mut values) item)
             (let [storage
                     (property-storage-new ctrl
                                           public-mem
                                           item-shape
                                           (load values))
                   installed
                     (property-storage-install ctrl
                                               (.mem object)
                                               (.value object)
                                               item-shape
                                               storage)
                   loaded
                     (property-load-own-named ctrl
                                              installed
                                              (.value object)
                                              key)
                   present
                     (property-has-own-named ctrl installed (.value object) key)]
               (assert-eq (n-op (.value loaded)) OP-PROJ)
               (assert-eq (n-ty (.value loaded)) (ty-dyn TAG-ANY))
               (assert-eq (n-op (.value present)) OP-PROJ)
               (assert-eq (n-ty (.value present)) (ty-bool))
               (assert-eq (jsop-prim (n-in! (.value loaded) 0)) JS-PROP-GET-OWN)
               (assert-eq (jsop-prim (n-in! (.value present) 0))
                          JS-PROP-HAS-OWN)
               (assert (n-same? (.ctrl loaded) ctrl))
               (assert-eq (n-op (.mem loaded)) OP-PROJ)
               (assert (n-same? (n-in! (.mem loaded) 0)
                                (n-in! (.value loaded) 0)))
               (assert-eq (n-ty (.mem loaded)) (ty-mem 1 TY-BOT))
               (assert-eq (verify-all) VERR-OK)))))

(deftest ordered_known_owner_writes_create_transition_copy_and_overwrite_paths
         (do
           (boot! 4)
           (let [ctrl (con-make TY-CTRL)
                 public-mem (con-make (ty-mem ALIAS-BULK TY-BOT))
                 object (jsl-lower-new-object ctrl public-mem)
                 left-key (shape-key-intern "write-left")
                 right-key (shape-key-intern "write-right")
                 left (box-make (con-int 10))
                 right (box-make (con-int 20))
                 replacement (box-make (con-int 30))
                 first
                   (property-store-known-owner ctrl
                                               (.mem object)
                                               (.value object)
                                               left-key
                                               left
                                               SHAPE-ATTRS-DEFAULT)
                 second
                   (property-store-known-owner ctrl
                                               (.mem first)
                                               (.value object)
                                               right-key
                                               right
                                               SHAPE-ATTRS-DEFAULT)
                 overwritten
                   (property-store-known-owner ctrl
                                               (.mem second)
                                               (.value object)
                                               left-key
                                               replacement
                                               SHAPE-ATTRS-DEFAULT)
                 second-owner
                   (memmerge-alias (.mem second) ALIAS-OBJECT-PROPERTIES)
                 second-storage (n-in! (n-in! second-owner STORE-VAL) 1)
                 second-shape (new-shape (n-in! second-storage 0))
                 left-alias (shape-alias-key second-shape left-key)
                 right-alias (shape-alias-key second-shape right-key)]
             (assert (shape-has-key? second-shape left-key))
             (assert (shape-has-key? second-shape right-key))
             (assert-eq (shape-field-count second-shape) 2)
             (assert (n-same? (n-in! (memmerge-alias (.mem second) right-alias)
                                     STORE-VAL)
                              right))
             (assert (n-same? (n-in! (memmerge-alias (.mem overwritten)
                                                     left-alias)
                                     STORE-VAL)
                              replacement))
             ;; A precise update initially retains prior memory as its default. Flattening must
             ;; preserve the owner slice while the changed property takes the outer override.
             (memmerge-idealize (.mem overwritten))
             (assert (n-same? (memmerge-alias (.mem overwritten)
                                              ALIAS-OBJECT-PROPERTIES)
                              second-owner))
             (assert-eq (verify-all) VERR-OK))))

;; A store whose owner's backing store hides behind a merge is the transitioning runtime store: the
;; value stays the value stored, control is unchanged, and memory is the operation's public result.
(deftest equal_memory_paths_retain_the_owner_shape_and_allow_a_direct_transition
         (do
           (boot! 5)
           (let [ctrl (con-make TY-CTRL)
                 public-mem (con-make (ty-mem ALIAS-BULK TY-BOT))
                 object (jsl-lower-new-object ctrl public-mem)
                 key (shape-key-intern "generic-write")
                 value (box-make (con-int 41))
                 region (region-make)
                 merged-input
                   (memphi-make region 1 TY-BOT "generic.owner.input")]
             ;; The initialization Store is behind a merge. Both paths establish the same shape,
             ;; so a direct transition remains justified without requiring a construction pattern.
             (region-add-path! region ctrl)
             (region-add-path! region ctrl)
             (memphi-add-state! merged-input (.mem object))
             (memphi-add-state! merged-input (.mem object))
             (let [stored
                     (property-store-known-owner region
                                                 merged-input
                                                 (.value object)
                                                 key
                                                 value
                                                 SHAPE-ATTRS-DEFAULT)]
               (assert (n-same? (.value stored) value))
               (assert (n-same? (.ctrl stored) region))
               (assert-eq (n-op (.mem stored)) OP-MEMMERGE)
               (assert (shape-has-key? (prop-state-shape (prop-static-storage (.mem stored)
                                                                              (.value object)))
                                       key))
               (assert-eq (verify-all) VERR-OK)))))

(deftest image_property_creation_is_a_memory_fact_not_a_change_to_the_image
         (boot! 31)
         (let [entry (heap-add-object! DYNAMIC-NULL-WORD)
               object (staticref-make entry REP-OBJECT)
               start (start-make (ty-int-bot))
               ctrl (cproj-make start 0 "entry")
               initial (proj-make start START-INITIAL-MEM "initial")
               incoming (proj-make start 1 "incoming")
               key (shape-key-intern "created")
               value (box-make (con-int 42))]
           (n-keep! initial)
           (n-keep! incoming)
           (n-keep! object)
           (assert-eq (prop-state-shape (prop-static-storage initial object))
                      SHAPE-EMPTY)
           (assert (property-specialization-absent? initial object key object))
           (assert (not (property-specialization-absent? incoming
                                                         object
                                                         key
                                                         object)))
           (assert-eq (prop-state-shape (prop-static-storage incoming object))
                      -1)
           ;; Singleton identity describes the reference alternative, not the null alternative.
           (let [nullable
                   (con-make (ty-with-identity (ty-dyn (+ TAG-OBJECT TAG-NULL))
                                               (ty-identity-single entry)))]
             (assert-eq (prop-state-shape (prop-static-storage initial nullable))
                        -1))
           (let [stored
                   (property-store-known-owner ctrl
                                               initial
                                               object
                                               key
                                               value
                                               SHAPE-ATTRS-DEFAULT)
                 state (prop-static-storage (.mem stored) object)]
             (n-keep! (.mem stored))
             (assert (shape-has-key? (prop-state-shape state) key))
             (assert (not (property-specialization-absent? (.mem stored)
                                                           object
                                                           key
                                                           object)))
             (assert (not (shape-has-key? (heap-storage-shape entry) key)))
             (assert-eq (prop-state-shape (prop-static-storage initial object))
                        SHAPE-EMPTY)
             (let [read
                     (prop-access-emit ctrl
                                       (.mem stored)
                                       object
                                       (None [(dyn NodeOps)])
                                       key
                                       PROP-LOAD)
                   ret
                     (return-make (.ctrl read)
                                  (Some (.mem read))
                                  (.value read)
                                  (None [(dyn NodeOps)])
                                  (None [(dyn NodeOps)]))]
               (n-keep! ret)
               (iter-seed-all!)
               (iter-run!)
               (assert-eq (n-ty (n-in! ret RETURN-VALUE))
                          (ty-dyn-with-int TAG-INT (ty-int-con 42)))))))

(deftest conditional_creation_does_not_prove_presence_after_the_merge
         (boot! 32)
         (let [entry (heap-add-object! DYNAMIC-NULL-WORD)
               object (staticref-make entry REP-OBJECT)
               start (start-make (ty-int-bot))
               ctrl (cproj-make start 0 "entry")
               initial (proj-make start START-INITIAL-MEM "initial")
               key (shape-key-intern "conditional")
               region (region-make)
               merged (memphi-make region ALIAS-BULK TY-BOT "conditional.mem")]
           (n-keep! initial)
           (n-keep! object)
           (let [stored
                   (property-store-known-owner ctrl
                                               initial
                                               object
                                               key
                                               (dyn-undefined-make)
                                               SHAPE-ATTRS-DEFAULT)]
             (region-add-path! region ctrl)
             (region-add-path! region ctrl)
             (memphi-add-state! merged initial)
             (memphi-add-state! merged (.mem stored))
             (assert-eq (prop-state-shape (prop-static-storage merged object))
                        -1)
             (assert (shape-has-key? (prop-state-shape (prop-static-storage (.mem stored)
                                                                            object))
                                     key)))))

(deftest unknown_effects_invalidate_a_known_property_state
         (boot! 33)
         (let [entry (heap-add-object! DYNAMIC-NULL-WORD)
               object (staticref-make entry REP-OBJECT)
               start (start-make (ty-int-bot))
               ctrl (cproj-make start 0 "entry")
               initial (proj-make start START-INITIAL-MEM "initial")
               key (shape-key-intern "effect")
               stored
                 (property-store-known-owner ctrl
                                             initial
                                             object
                                             key
                                             (box-make (con-int 7))
                                             SHAPE-ATTRS-DEFAULT)
               unknown
                 (property-store-generic-owner ctrl
                                               (.mem stored)
                                               object
                                               key
                                               (dyn-undefined-make))]
           (assert-eq (prop-state-shape (prop-static-storage (.mem unknown)
                                                             object))
                      -1)))

(deftest property_proof_reads_identity_through_phi_cast_and_unbox
         (boot! 34)
         (let [entry (heap-add-object! DYNAMIC-NULL-WORD)
               key (shape-key-intern "identity-proof")
               raw (staticref-make entry REP-OBJECT)
               ctrl (con-make TY-CTRL)
               region (region-make)
               merged (phi-make region (ty-dyn TAG-ANY) "same-object")
               mem (con-make (ty-mem ALIAS-BULK TY-BOT))]
           (heap-define-own! entry
                             "identity-proof"
                             DYNAMIC-UNDEFINED-WORD
                             HEAP-WORD-CONST)
           (region-add-path! region ctrl)
           (region-add-path! region ctrl)
           (phi-add-value! merged (box-make raw))
           (phi-add-value! merged (box-make raw))
           (n-set-ty! merged (compute merged))
           (let [cast (cast-make region merged (ty-dyn TAG-OBJECT))
                 object (unbox-make cast REP-OBJECT)]
             (assert-eq (n-op object) OP-UNBOX)
             (assert-eq (ty-image-entry (n-ty object)) entry)
             (facts-begin! (heap-count) (shape-key-count))
             (facts-finish!)
             (match (prop-own-state mem object key merged)
               (OwnPresent [shape _ value-entry]
                           (do
                             (assert (shape-has-key? shape key))
                             (assert-eq value-entry entry)))
               (_ (assert false)))
             (assert (property-specialization-proven? mem cast key false merged)))))

(deftest property_memory_propagation_reaches_a_fixpoint_across_worklist_orders
         (let [(mut seed) 1]
           (loop (if (> (load seed) 24)
                     (break 0)
                     (do
                       (boot! (load seed))
                       (let [entry (heap-add-object! DYNAMIC-NULL-WORD)
                             object (staticref-make entry REP-OBJECT)
                             start (start-make (ty-int-bot))
                             ctrl (cproj-make start 0 "entry")
                             initial
                               (proj-make start START-INITIAL-MEM "initial")
                             key (shape-key-intern "answer")
                             stored
                               (property-store-known-owner ctrl
                                                           initial
                                                           object
                                                           key
                                                           (box-make (con-int 42))
                                                           SHAPE-ATTRS-DEFAULT)
                             read
                               (prop-access-emit ctrl
                                                 (.mem stored)
                                                 object
                                                 (None [(dyn NodeOps)])
                                                 key
                                                 PROP-LOAD)
                             ret
                               (return-make (.ctrl read)
                                            (Some (.mem read))
                                            (.value read)
                                            (None [(dyn NodeOps)])
                                            (None [(dyn NodeOps)]))]
                         (n-keep! ret)
                         (iter-seed-all!)
                         (iter-run!)
                         (assert-eq (n-ty (n-in! ret RETURN-VALUE))
                                    (ty-dyn-with-int TAG-INT (ty-int-con 42)))
                         (assert-eq (iter-check-fixpoint) 0)
                         (assert-eq (verify-all) VERR-OK))
                       (set! (mut seed) (+ (load seed) 1))
                       (continue))))
           (assert-eq (load seed) 25)))
