;; Shared test construction helpers.

;;
;; Exists because of a real mistake: several tests built extra "control" paths with
;; `(cproj-make st 1 …)`, but `Start` projects `(CONTROL, arg)` — member 1 is the ARGUMENT. Those
;; projections had integer types, so any Region merging them computed BOT rather than CONTROL. The
;; tests passed only because none of them asserted on the Region's type; the first one that did
;; tripped the monotonicity check immediately.
;;
;; `Start` has exactly ONE control member, in Simple too. Extra control edges come from branching.
(module aot.tests.support)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.type.type" :use *)

;; A fresh control edge below `from`, whose type really is CONTROL.
;;
;; Built from an If on an UNDECIDABLE predicate — a range straddling zero — so both arms stay live
;; and neither folds away underneath the test.
(defn fresh-ctrl [(from (dyn NodeOps))] (-> (dyn NodeOps))
  (arms-true (if-arms! (if-make from (con-make (ty-int-range 0 10))))))

;; Both arms of one undecidable If below `from`. Use this when a test wants two control paths that
;; genuinely diverge and re-merge.
(defn fresh-arms [(from (dyn NodeOps))] (-> IfArms)
  (if-arms! (if-make from (con-make (ty-int-range 0 10)))))
