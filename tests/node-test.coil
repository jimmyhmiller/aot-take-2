;; The graph representation: identity, edges, keep/kill/subsume, GVN.

;;
;; Every claim here is one a corruption could break, and each is stated so that removing the
;; mechanism makes THIS test red rather than some distant one.
(module aot.tests.node)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.type.type" :use *)

(defn node-test--is-add [(n (dyn NodeOps))] (-> bool)
  (= (n-op n) OP-ADD))

(defn node-test--drain-worklist [] (-> i64)
  (loop (match (code-work-pop!)
          (Some [_] (continue))
          (None [] (break 0)))))

(deftest identity_is_the_header_address
         (boot! 1)
         (let [a (con-int 3)
               b (con-int 3)]
           ;; Two structurally identical constants are two DIFFERENT nodes until GVN unifies them.
           ;; If identity accidentally meant equality, `n-del-use!` would remove the wrong edge.
           (assert (n-same? a a))
           (assert (not (n-same? a b)))
           (assert-ne (n-nid a) (n-nid b))))

(deftest a_constant_computes_its_own_type
         (boot! 1)
         (let [c (con-int 42)]
           (assert-eq (n-op c) OP-CON)
           (assert-eq (n-ty c) (ty-int-con 42))
           (assert (ty-constant? (n-ty c)))))

(deftest edges_are_maintained_in_both_directions
         (boot! 1)
         (let [l (con-int 3)
               r (con-int 4)
               s (add-make l r)]
           (assert-eq (n-nins s) 3)
           (assert (match (n-in s 0) (Some [_] false) (None [] true)))
           (assert (n-same? (n-in! s 1) l))
           (assert (n-same? (n-in! s 2) r))
           (assert-eq (n-nouts l) 1)
           (assert-eq (n-nouts r) 1)
           (assert (n-same? (match (n-out l 0) (Some [v] v) (None [] l)) s))))

(deftest an_operand_used_twice_records_two_edges
         ;; `x+x` is one node used twice. If `n-del-use!` removed ALL matching edges rather than one, the
         ;; second use would vanish silently and the Add would read a dead operand.
         (boot! 1)
         (let [x (con-int 5)
               s (add-make x x)]
           (assert-eq (n-nouts x) 2)
           (n-del-use! x s)
           (assert-eq (n-nouts x) 1)))

(deftest setting_an_input_rewires_both_directions
         (boot! 1)
         (let [l (con-int 1)
               r (con-int 2)
               r2 (con-int 9)
               s (add-make l r)]
           (n-set-def! s 2 (Some r2))
           (assert (n-same? (n-in! s 2) r2))
           (assert-eq (n-nouts r2) 1)))

(deftest keep_holds_a_node_alive_with_no_users
         ;; Without `keep`, a freshly built node with no users yet is collected the moment anything
         ;; triggers a kill cascade.
         (boot! 1)
         (let [c (con-int 7)]
           (assert (n-unused? c))
           (n-keep! c)
           (assert (not (n-unused? c)))
           (assert (n-kept? c))
           (n-unkeep! c)
           (assert (n-unused? c))
           (assert (not (n-kept? c)))))

(deftest killing_recursively_kills_inputs_that_lost_their_last_use
         ;; This IS dead code elimination. There is no separate DCE pass.
         (boot! 1)
         (let [l (con-int 3)
               r (con-int 4)
               s (add-make l r)]
           (assert-eq (n-nouts l) 1)
           (n-kill! s)
           (assert (n-dead? s))
           ;; Both operands lost their only use, so the cascade took them too.
           (assert (n-dead? l))
           (assert (n-dead? r))))

(deftest an_input_still_used_elsewhere_survives_a_kill
         (boot! 1)
         (let [shared (con-int 3)
               other (con-int 4)
               s1 (add-make shared other)
               s2 (add-make shared other)]
           (assert-eq (n-nouts shared) 2)
           (n-kill! s1)
           (assert (n-dead? s1))
           ;; `shared` still feeds s2, so it must NOT have been collected.
           (assert (not (n-dead? shared)))
           (assert-eq (n-nouts shared) 1)))

(deftest subsume_moves_every_user_and_kills_the_old_node
         (boot! 1)
         (let [old (con-int 3)
               new_ (con-int 99)
               user (add-make old (con-int 4))]
           (n-keep! new_)
           (assert-eq (n-nouts old) 1)
           (n-subsume! old new_)
           (assert (n-dead? old))
           (assert (n-same? (n-in! user 1) new_))
           ;; The user moved across, so the replacement now has it plus the keep.
           (assert-eq (n-nouts new_) 2)))

(deftest subsume_rewires_duplicate_uses_one_edge_at_a_time
         (boot! 1)
         (let [old (con-int 3)
               new_ (con-int 9)
               user (add-make old old)]
           (n-keep! new_)
           (n-subsume! old new_)
           (assert (n-dead? old))
           (assert (n-same? (n-in! user 1) new_))
           (assert (n-same? (n-in! user 2) new_))))

(deftest arena_reset_clears_both_inline_queues
         (boot! 1)
         (code-inline-push! 41)
         (code-defer-inline! 42)
         (arena-reset! 2)
         (assert (match (code-inline-pop!) (Some [_] false) (None [] true)))
         (assert-eq (code-requeue-deferred!) 0))

(deftest gvn_is_structural_on_identity_not_on_value
         (boot! 1)
         (let [a (add-make (con-int 3) (con-int 4))
               b (add-make (con-int 3) (con-int 4))]
           ;; DIFFERENT operand nodes (the constants are not yet unified), so these are not GVN-equal even
           ;; though they compute the same value.
           (assert (not (n-gvn-eq? a b)))
           (assert (n-gvn-eq? a a))
           (assert-eq (n-gvn-hash a) (n-gvn-hash a))
           ;; 0 is reserved for "not in the table" and must never be produced.
           (assert-ne (n-gvn-hash a) 0)))

(deftest gvn_unifies_two_nodes_over_the_same_operands
         (boot! 1)
         (let [l (con-int 3)
               r (con-int 4)
               a (add-make l r)
               b (add-make l r)]
           (assert (not (n-same? a b)))
           (assert (n-gvn-eq? a b))
           (assert-eq (n-gvn-hash a) (n-gvn-hash b))))

(deftest the_gvn_table_finds_an_equal_node_and_unlock_removes_it
         (boot! 1)
         (let [l (con-int 3)
               r (con-int 4)
               a (add-make l r)
               b (add-make l r)]
           ;; Nothing is in the table until something is inserted.
           (assert (match (n-gvn-find b) (Some [_] false) (None [] true)))
           (n-gvn-insert! a)
           (assert (n-locked? a))
           ;; Now b finds a.
           (assert (match (n-gvn-find b) (Some [f] (n-same? f a)) (None [] false)))
           ;; Unlocking removes it again, so the edges may be mutated safely.
           (n-unlock! a)
           (assert (not (n-locked? a)))
           (assert (match (n-gvn-find b) (Some [_] false) (None [] true)))))

(deftest mutating_an_edge_unlocks_from_the_gvn_table
         ;; A node in the table has its hash cached, and the hash is computed from its edges. Mutating an
         ;; edge without leaving the table leaves an entry that later unifies two nodes that are NOT equal.
         (boot! 1)
         (let [l (con-int 1)
               r (con-int 2)
               s (add-make l r)]
           (n-gvn-insert! s)
           (assert (n-locked? s))
           (n-set-def! s 2 (Some (con-int 9)))
           (assert (not (n-locked? s)))))

(deftest sparse_set_insert_and_pop_preserve_both_edge_directions
         (boot! 1)
         (let [a (con-int 1)
               b (con-int 2)
               c (con-int 3)
               use (add-make a b)]
           (n-keep! a)
           (n-keep! b)
           (n-keep! c)
           (n-set-def-x! use 5 (Some c))
           (assert-eq (n-nins use) 6)
           (assert (n-same? (n-in! use 5) c))
           (n-insert-def! use 2 (Some c))
           (assert-eq (n-nins use) 7)
           (assert (n-same? (n-in! use 2) c))
           (assert (n-same? (n-in! use 3) b))
           (assert-eq (n-nouts c) 3)  ; keep plus two real uses
           (n-pop-until! use 3)
           (assert-eq (n-nins use) 3)
           (assert-eq (n-nouts c) 2)
           (assert (n-same? (n-in! use 2) c))))

(deftest forward_dependencies_cover_an_immediate_input_when_requested
         (boot! 1)
         (let [input (con-make (ty-int-range 0 9))
               watcher (add-make input (con-int 1))]
           (node-test--drain-worklist)
           ;; `watcher` is a forward output of `input`. Ordinary registration refuses both kinds
           ;; of immediate neighbor.
           (n-add-dep! watcher input)
           (n-move-deps-to-worklist! watcher)
           (assert (not (code-on-worklist? (n-nid input))))
           ;; The explicit forwards form records the backward dependency on that forward node.
           (n-add-dep-forwards! watcher input)
           (n-move-deps-to-worklist! watcher)
           (assert (code-on-worklist? (n-nid input)))))

(deftest graph_walk_visits_cycles_once_and_returns_the_first_match
         (boot! 1)
         (let [x (con-int 4)
               sum (add-make x x)]
           ;; Inputs and outputs form a cycle in the undirected walk. The visited bitmap makes it
           ;; finite, while the predicate still finds the Add from an input root.
           (assert (match (n-walk-find x (primitive/fnptr-of node-test--is-add))
                     (Some [found] (n-same? found sum))
                     (None [] false)))))

(deftest ordered_kill_preserves_the_remaining_control_user_order
         (boot! 1)
         (let [ctrl (con-make TY-CTRL)
               first (if-make ctrl (con-int 1))
               doomed (if-make ctrl (con-int 1))
               last (if-make ctrl (con-int 1))]
           ;; `doomed` is unused. Its input 0 is `ctrl`, and it sits between two other users.
           (n-kill-ordered! doomed)
           (assert (n-dead? doomed))
           (assert-eq (n-nouts ctrl) 2)
           (assert (match (n-out ctrl 0) (Some [n] (n-same? n first)) (None [] false)))
           (assert (match (n-out ctrl 1) (Some [n] (n-same? n last)) (None [] false)))))
