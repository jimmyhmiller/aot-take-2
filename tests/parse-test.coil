         (parser-test-syntax-result "x = /\\d\\u0041/; `\\u0041${a}`; '\\u0041';" 0)
         (parser-test-syntax-result "var \\u{1F600};" EXIT-UNIMPLEMENTED)
         (parser-test-syntax-result "'use strict'; var x = { \\u0069mplements } = { implements: 42 };" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; ({ \\u0069nterface } = {}); [pr\\u006ftected] = [];" EXIT-SYNTAX)
         (parser-test-syntax-result "var x = { \\u0069mplements } = { implements: 42 };" 0))

(deftest annex_b_for_in_var_initializers_are_sloppy_syntax
         (parser-test-syntax-result "for (var x = 1 in o) {} for (var x = f() in o) ;" 0)
         (parser-test-syntax-result "'use strict'; for (var x = 1 in o) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "function f() { 'use strict'; for (var x = 1 in o) {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "for (var [x] = 1 in o) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (var {x} = 1 in o) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (let x = 1 in o) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (const x = 1 in o) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (var x = 1 of o) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (var x = 1, y in o) {}" EXIT-SYNTAX))

(deftest non_ascii_identifier_characters_fail_closed_not_as_syntax_errors
         (parser-test-syntax-result "var π = 1;" EXIT-PANIC)
         (parser-test-syntax-result "({π: 1});" EXIT-PANIC)
         (parser-test-syntax-result "x.π;" EXIT-PANIC)
         (parser-test-syntax-result "class C { π() {} }" EXIT-PANIC)
         (parser-test-syntax-result "π: 1;" EXIT-PANIC)
         (parser-test-syntax-result "@dec class C {}" EXIT-PANIC))
