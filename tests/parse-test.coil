;; The first TypeScript frontend vertical slice: thin syntax, hoisted function headers, and direct

;; lowering into the ordinary call/arithmetic sea of nodes.
(module aot.tests.parser)
(import "coil.assert" :use *)
(import "coil.os" :as os)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [subslice])
(import "aot.util.panic" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.call" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.memory" :use *)
(import "aot.shape" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.opto" :use *)
(import "aot.verify" :use *)
(import "aot.type.type" :use *)
(import "aot.parse.parser" :use *)
(import "aot.jsl.lower" :use *)

(defn parser-test-refuses [(source (slice u8)) (script-mode bool) (expected i64)] (-> i64)
  (let [pid (os/fork)
        status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (do (boot! 1) (parse-program-mode source script-mode) (os/_exit 0) 0)
        (do
          (assert-eq (os/waitpid pid status 0) pid)
          ;; A crash is not a successful refusal. Check normal exit and the exact compiler class.
          (assert-eq (primitive/iand (primitive/cast i64 (load status)) 127) 0)
          (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) expected)
          0))))

(defn parser-test-syntax-result [(source (slice u8)) (expected i64)] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (do (boot! 1) (parse-syntax-program-mode! source true true) (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (primitive/iand (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) expected) 0))))

(deftest strict_early_errors_cover_inheritance_bindings_references_and_legacy_numbers
  (parser-test-syntax-result "'use strict'; function f(x, x) {}" EXIT-SYNTAX)
  (parser-test-syntax-result "function f(x, x) { 'use strict'; }" EXIT-SYNTAX)
  (parser-test-syntax-result "function eval() { 'use strict'; }" EXIT-SYNTAX)
  (parser-test-syntax-result "'use strict'; function f(arguments) {}" EXIT-SYNTAX)
  (parser-test-syntax-result "'use strict'; var eval;" EXIT-SYNTAX)
  (parser-test-syntax-result "'use strict'; let arguments;" EXIT-SYNTAX)
  (parser-test-syntax-result "'use strict'; if (false) { eval = 1; }" EXIT-SYNTAX)
  (parser-test-syntax-result "'use strict'; (arguments) = 1;" EXIT-SYNTAX)
  (parser-test-syntax-result "'use strict'; interface;" EXIT-SYNTAX)
  (parser-test-syntax-result "'use strict'; yield();" EXIT-SYNTAX)
  (parser-test-syntax-result "'use strict'; 077;" EXIT-SYNTAX)
  (parser-test-syntax-result "function f() { 'use strict'; return 089; }" EXIT-SYNTAX))

(deftest strict_directives_do_not_leak_between_functions_or_reclassify_property_names
  (parser-test-syntax-result "'use strict'; 42;" 0)
  (parser-test-syntax-result "function strict() { 'use strict'; } function sloppy(x, x) { return 077; }" 0)
  (parser-test-syntax-result "function f(x, x) { { 'use strict'; } return 089; }" 0)
  (parser-test-syntax-result "('use strict'); var eval;" 0)
  (parser-test-syntax-result "42; 'use strict'; var arguments;" 0)
  (parser-test-syntax-result "function f() {} 'use strict'; var eval;" 0)
  (parser-test-syntax-result "'use strict'; let o = { eval: 0, interface: 1 }; o.arguments = 2; o.interface;" 0)
  (parser-test-syntax-result "'use strict'; let await = 1; 0x77; .5; 0.89;" 0)
  ;; Syntax validation is not permission to execute strict code with sloppy runtime rules.
  (parser-test-refuses "'use strict'; Infinity = 0;" true EXIT-UNIMPLEMENTED))

(deftest script_goal_and_logical_grammar_refuse_incorrect_contexts
         (parser-test-refuses "return 42;" true EXIT-PANIC)
         (parser-test-refuses "if (false) { return; }" true EXIT-PANIC)
         (parser-test-refuses "function main() { return 0 ?? 1 || 2; }" false EXIT-PANIC)
         (parser-test-refuses "function main() { return 0 || 1 ?? 2; }" false EXIT-PANIC)
         (parser-test-refuses "function main() { return 0 ?? 1 && 2; }" false EXIT-PANIC)
         (parser-test-refuses "function main() { return 0 && 1 ?? 2; }" false EXIT-PANIC)
         (parser-test-refuses "'use strict'; 42;" true EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { 'use strict'; return 42; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "let captured = 42; function f() { return captured; } f();"
                              true EXIT-UNIMPLEMENTED)
         (parser-test-refuses "let undefined = 42;" true EXIT-PANIC)
         (parser-test-refuses "const Infinity = 42;" true EXIT-PANIC)
         (parser-test-refuses "let NaN = 42;" true EXIT-PANIC)
         (parser-test-refuses "function Infinity() {}" true EXIT-PANIC)
         (parser-test-refuses "let f = 42; function f() {}" true EXIT-PANIC)
         (parser-test-refuses "let x: number = 42;" true EXIT-PANIC)
         (parser-test-refuses "let true = 42;" true EXIT-PANIC)
         (parser-test-refuses "function while() {}" true EXIT-PANIC)
         (parser-test-refuses "'a\rb';" true EXIT-PANIC)
         (parser-test-refuses "/* unclosed" true EXIT-PANIC))

(deftest lexical_instantiation_never_reads_or_writes_an_outer_binding_through_the_tdz
         (parser-test-refuses "function main() { let x = x; return x; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { let x = 42; { let x = x; } return x; }"
                              false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { let undefined = undefined; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { x = 42; let x; return x; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { return x; let x = 42; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { if (true) let x = 42; }" false EXIT-PANIC)
         (parser-test-refuses "function main() { while (false) const x = 42; }" false EXIT-PANIC)
         (parser-test-refuses "function main() { const x; }" false EXIT-PANIC))

(deftest typeof_keeps_unresolved_global_and_tdz_boundaries_explicit
         (parser-test-refuses "function main() { return typeof missing; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { return typeof ((JSON)); }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function f() {} function main() { return typeof f; }"
                              false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { let x = typeof x; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { let x = 42; { return typeof x; let x; } }"
                              false EXIT-UNIMPLEMENTED))

(deftest declaration_early_errors_cover_unreachable_blocks_and_var_lexical_conflicts
         (parser-test-refuses "function main() { return 42; { let x; let x; } }" false EXIT-PANIC)
         (parser-test-refuses "function main() { let x; if (false) { var x; } }" false EXIT-PANIC)
         (parser-test-refuses "function main() { { let x; { var x; } } }" false EXIT-PANIC)
         (parser-test-refuses "function main(x) { let x; }" false EXIT-PANIC)
         (parser-test-refuses "function main() { let x = 1, x = 2; }" false EXIT-PANIC)
         (parser-test-refuses "function main() { let x = y, y = 1; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { const x = 1, y; }" false EXIT-PANIC)
         (parser-test-refuses "let x = 1, Infinity = 2;" true EXIT-PANIC)
         (parser-test-refuses "var x = 42;" true EXIT-UNIMPLEMENTED)
         (parser-test-refuses "if (false) { var x; }" true EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main() { var arguments; }" false EXIT-UNIMPLEMENTED))

(deftest declaration_list_spans_preserve_annotations_without_consuming_trailing_comments
         (boot! 1)
         (let [source "function main() { let x: number /*note*/, y: number = 42; return y; }"
               stop (parse-program source)
               fun (syntax-fun-at (syntax-find-fun "main"))
               group (syntax-stmt-at (get (.body fun) 0))
               first (syntax-stmt-at (get (.body group) 0))
               second (syntax-stmt-at (get (.body group) 1))]
           (assert-eq (.kind group) SS-DECL-LIST)
           (assert-eq (subslice [u8] source (.lo first) (.hi first)) "let x: number")
           (assert-eq (subslice [u8] source (.lo second) (.hi second)) "y: number = 42")
           (assert (> (n-nins stop) 0))))

(deftest break_context_and_label_boundaries_are_checked_before_lowering
         (parser-test-refuses "break;" true EXIT-PANIC)
         (parser-test-refuses "function main() { return 42; break; }" false EXIT-PANIC)
         (parser-test-refuses "function main() { while (true) { break outer; } }"
                              false EXIT-UNIMPLEMENTED))

(deftest switch_cases_share_one_lexical_scope_and_reject_duplicate_defaults
         (parser-test-refuses "function main() { switch (0) { default: ; default: ; } }"
                              false EXIT-PANIC)
         (parser-test-refuses "function main() { switch (0) { case 0: let x; case 1: let x; } }"
                              false EXIT-PANIC)
         (parser-test-refuses "function main() { switch (0) { case 0: let x; case 1: var x; } }"
                              false EXIT-PANIC)
         (parser-test-refuses "function main() { switch (0) { case x: let x = 1; } }"
                              false EXIT-UNIMPLEMENTED))

(deftest script_has_a_distinct_zero_argument_execution_root_and_original_spans
         (boot! 1)
         (let [source "let x = 40; x = x + 2; function main() { return 7; } x;"
               stop (parse-script source)
               root (syntax-fun-at (parser-source-entry-index))
               first (syntax-stmt-at (get (.body root) 0))]
           (assert-eq (.name root) "$aot$.script")
           (assert-eq (parser-entry-arity) 0)
           (assert-eq (.lo first) 0)
           (assert-eq (.hi root) (len source))
           (assert-eq (verify-all) VERR-OK)
           (assert (> (n-nins stop) 0))))

(defn parser-test-return-named [(stop (dyn NodeOps)) (name (slice u8))] (-> (dyn NodeOps))
  (let [(mut i) 0]
    (loop (if (>= (load i) (n-nins stop))
              (break (unreachable-node))
              (let [ret (n-in! stop (load i))
                    fun
                      (match (arena-node (return-fun-nid ret))
                        (Some [f] f)
                        (None [] (unreachable-node)))]
                (if (= (fun-name fun)
                       (if (= name "main") (parser-internal-main-name) name))
                    (break ret)
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn parser-test-boxed-int [(n (dyn NodeOps))] (-> i64)
  (do
    (assert-eq (n-op n) OP-BOX)
    (n-ty (n-in! n 1))))

(defn parser-test-run-opto! [(stop (dyn NodeOps))] (-> i64)
  (do
    ;; Use the production phase boundary. Pessimistic Iter must see unknown-caller hooks before
    ;; Opto closes the world; guarded JSL bodies carry Cast types that depend on that ordering.
    (jsl-prepare-opto!)
    (iter-seed-connected! stop)
    (iter-run!)
    (parser-close-world!)
    (parser-prepare-opto! stop)
    (let [progress (opto-run!)]
      (iter-seed-all!)
      (iter-run!)
      (parser-finish-opto! stop)
      (jsl-finish-opto! stop)
      progress)))

(deftest typed_functions_parse_to_a_verified_lazy_call_graph
         (boot! 73)
         (let [stop
                 (parse-program "function sub(a: number, b: number): number { return a - b; }
             function main(): number { return sub(5, 3); }")
               sub-ret (parser-test-return-named stop "sub")
               main-ret (parser-test-return-named stop "main")]
           (assert-eq (n-op stop) OP-STOP)
           ;; Both source definitions plus the compiler-owned process-entry wrapper are visible
           ;; until the compilation-unit lifetime pass detaches internal Returns.
           (assert-eq (n-nins stop) 3)
           (assert-eq (n-op (n-in! sub-ret RETURN-VALUE)) OP-PROJ)
           (assert-eq (n-op (n-in! main-ret RETURN-VALUE)) OP-PROJ)
           (let [end (n-in! (n-in! main-ret RETURN-VALUE) 0)
                 linked-call (n-in! end 0)]
             (assert-eq (n-op linked-call) OP-CALL)
             (assert-eq (call-nargs linked-call) 2)
             (assert (> (ty-funptr-the-fidx (n-ty (call-fptr linked-call))) 0))
             (assert-ne (ty-funptr-the-fidx (n-ty (call-fptr linked-call)))
                        (jsl-fidx-of "JsSub"))
             (assert (ty-mem? (n-ty (call-mem linked-call))))
             (assert-eq (n-op (n-in! main-ret RETURN-MEM)) OP-PROJ)
             (assert-eq (proj-idx (n-in! main-ret RETURN-MEM)) RETURN-MEM)
             (assert (n-same? (n-in! (n-in! main-ret RETURN-MEM) 0) end))
             (assert-eq (parser-test-boxed-int (call-arg linked-call 0)) (ty-int-con 5))
             (assert-eq (parser-test-boxed-int (call-arg linked-call 1)) (ty-int-con 3))
             (assert (not (call-linked? linked-call
                                        (match (arena-node (return-fun-nid sub-ret))
                                          (Some [f] f)
                                          (None [] (unreachable-node)))))))
           (assert-eq (verify-all) VERR-OK)))

(deftest process_entry_is_distinct_from_boxed_source_main
         (boot! 91)
         (let [stop
                 (parse-program "function caller() { return main(); }
             function main() { return 42; }")
               source-ret (parser-test-return-named stop "main")
               source-fun
                 (match (return-fun source-ret)
                   (Some [f] f)
                   (None [] (unreachable-node)))
               caller-ret (parser-test-return-named stop "caller")
               caller-end (n-in! (n-in! caller-ret RETURN-VALUE) 0)
               caller-call (n-in! caller-end 0)
               wrapper (parser-entry-fun)
               wrapper-ret
                 (match (fun-ret wrapper)
                   (Some [ret] ret)
                   (None [] (unreachable-node)))
               wrapper-end (n-in! (n-in! wrapper-ret RETURN-VALUE) 0)
               wrapper-call (n-in! wrapper-end 0)]
           (assert-eq (fun-name source-fun) (parser-internal-main-name))
           (assert-eq (fun-name wrapper) "main")
           (assert (ty-dyn? (ty-tuple-at (fun-sig source-fun) 0)))
           (assert-eq (n-op (n-in! source-ret RETURN-VALUE)) OP-BOX)
           ;; An ordinary source call and the process wrapper both target the boxed source ABI.
           (assert (n-same? (n-in! (call-fptr caller-call) 0) source-fun))
           (assert (n-same? (n-in! (call-fptr wrapper-call) 0) source-fun))
           ;; Only the process edge is forbidden from folding across the ABI boundary.
           (assert-ne (callend-inline-candidate caller-end) INLINE-NEVER)
           (assert-eq (callend-inline-candidate wrapper-end) INLINE-NEVER)
           (assert-eq (verify-all) VERR-OK)))

(deftest duplicate_function_declarations_resolve_to_the_last_binding
         (boot! 92)
         (let [stop
                 (parse-program "function answer() { return 7; }
             function answer() { return 42; }
             function main() { return answer(); }")
               main-ret (parser-test-return-named stop "main")
               call-end (n-in! (n-in! main-ret RETURN-VALUE) 0)
               linked (n-in! call-end 0)
               selected (n-in! (call-fptr linked) 0)]
           (assert-eq (fun-name selected) "answer")
           (assert-eq (parser-test-boxed-int
                        (n-in!
                          (match (fun-ret selected)
                            (Some [ret] ret)
                            (None [] (unreachable-node)))
                          RETURN-VALUE))
                      (ty-int-con 42))
           (assert-eq (verify-all) VERR-OK)))

(deftest parsed_subtraction_crosses_the_jsl_semantic_call_boundary
         (boot! 74)
         (let [stop (parse-program "function main(): number { return 9 - 4; }")
               ret (parser-test-return-named stop "main")
               value-proj (n-in! ret RETURN-VALUE)
               end (n-in! value-proj 0)
               semantic-call (n-in! end 0)]
           (assert-eq (n-op semantic-call) OP-CALL)
           (assert-eq (n-op (call-arg semantic-call 0)) OP-BOX)
           (assert-eq (n-op (call-arg semantic-call 1)) OP-BOX)
           (assert (not (call-linked? semantic-call (jsl-graph-of "JsSub"))))
           (assert-eq (verify-all) VERR-OK)))

(deftest parsed_string_literals_use_jsl_utf16_allocation_semantics
         (boot! 87)
         (let [stop (parse-program "function main() { return 'Aé😀'; }")
               ret (parser-test-return-named stop "main")
               box (n-in! ret RETURN-VALUE)
               ptr_ (n-in! box 1)
               fresh (n-in! ptr_ 0)]
           (assert-eq (n-op box) OP-BOX)
           (assert-eq (n-ty box) (ty-dyn TAG-STRING))
           (assert-eq (n-op fresh) OP-NEW)
           (assert-eq (new-shape fresh) SHAPE-STRING)
           (assert-eq (new-object-ty fresh) (ty-struct "JsStringPayload"))
           (assert-eq (n-op (n-in! ret RETURN-MEM)) OP-MEMMERGE)
           (assert-eq (verify-all) VERR-OK)))

(deftest parsed_named_member_reads_expand_the_production_jsl_property_macro
         (boot! 88)
         (let [stop
                 (parse-program "function read(object) { return object.value; }
                                 function main() { return read(undefined); }")
               ret (parser-test-return-named stop "read")
               value (n-in! ret RETURN-VALUE)]
           (assert-eq (n-op value) OP-PHI)
           (assert-eq (n-ty value) (ty-dyn TAG-ANY))
           ;; Macro expansion creates no semantic call boundary; its guards, backing-store load,
           ;; shape dispatch, and undefined fallback are ordinary nodes in the source function.
           (assert-eq (n-op (phi-region value)) OP-REGION)
           (assert-eq (verify-all) VERR-OK)))

(deftest object_literals_define_ordered_properties_through_jsl_and_fold_named_reads
         (boot! 89)
         (let [stop
                 (parse-program "function main() {
                                   let node = { left: 1, right: 2, item: 3 };
                                   return node.item;
                                 }")]
           (assert-eq (verify-all) VERR-OK)
           (assert (fun-self-recursive? (jsl-graph-of "JsGetNamedObject")))
           (assert (> (parser-test-run-opto! stop) 0))
           (let [ret (parser-test-return-named stop "main")
                 value (n-in! ret RETURN-VALUE)]
             ;; Ordinary [[Get]] is recursive because the prototype depth is dynamic. Keep that
             ;; semantic call in the ideal graph; the native pipeline test proves its result is 3.
             (assert-eq (n-op value) OP-PROJ)
             (assert-eq (n-ty value) (ty-dyn TAG-ANY))
             (assert-eq (verify-all) VERR-OK))))

(deftest addition_and_multiplication_preserve_precedence_across_nested_jsl_calls
         (boot! 75)
         (let [stop (parse-program "function main(): number { return 2 + 3 * 4; }")
               ret (parser-test-return-named stop "main")
               add-end (n-in! (n-in! ret RETURN-VALUE) 0)
               add-call (n-in! add-end 0)
               mul-end (n-in! (call-arg add-call 1) 0)
               mul-call (n-in! mul-end 0)]
           (assert (not (call-linked? add-call (jsl-graph-of "JsAdd"))))
           (assert (not (call-linked? mul-call (jsl-graph-of "JsMul"))))
           (assert-eq (parser-test-boxed-int (call-arg add-call 0)) (ty-int-con 2))
           (assert-eq (parser-test-boxed-int (call-arg mul-call 0)) (ty-int-con 3))
           (assert-eq (parser-test-boxed-int (call-arg mul-call 1)) (ty-int-con 4))
           (assert-eq (verify-all) VERR-OK)
           (assert (> (parser-test-run-opto! stop) 0))
           (assert-eq (parser-test-boxed-int (n-in! ret RETURN-VALUE)) (ty-flt-con 14.0))
           (assert-eq (verify-all) VERR-OK)))

(deftest a_single_jsl_arithmetic_call_is_monotone_through_lazy_linking
         (boot! 76)
         (let [stop (parse-program "function main(): number { return 2 + 3; }")
               ret (parser-test-return-named stop "main")]
           ;; This is the smallest graph where CallEnd is visited before its Return link. The
           ;; unresolved optimistic result must remain TOP until linking supplies evidence.
           (assert (> (parser-test-run-opto! stop) 0))
           (assert-eq (parser-test-boxed-int (n-in! ret RETURN-VALUE)) (ty-flt-con 5.0))
           (assert-eq (verify-all) VERR-OK)))

(deftest closed_world_arguments_specialize_across_user_and_jsl_calls
         (boot! 77)
         (let [stop
                 (parse-program "function scale(a: number, b: number): number { return a + b * 4; }
             function main(): number { return scale(2, 3); }")
               scale-ret (parser-test-return-named stop "scale")
               main-ret (parser-test-return-named stop "main")
               scale-fun
                 (match (arena-node (return-fun-nid scale-ret))
                   (Some [f] f)
                   (None [] (unreachable-node)))
               user-end (n-in! (n-in! main-ret RETURN-VALUE) 0)
               user-call (n-in! user-end 0)]
           ;; Before Opto the source call is lazy and the annotation has manufactured no raw-int
           ;; representation: JavaScript parameters enter as dynamic values.
           (assert-eq (n-op user-call) OP-CALL)
           (assert (ty-dyn? (n-ty (match (fun-parm scale-fun 0)
                                    (Some [p] p)
                                    (None [] (unreachable-node))))))
           (assert-eq (verify-all) VERR-OK)
           (assert (> (parser-test-run-opto! stop) 0))
           ;; Closed-world constants sharpen the Parms; JSL unboxing becomes justified and the
           ;; entire user-call/JSL-call chain specializes to the boxed JavaScript number 14.
           ;; Inlining may replace and collect main's original Return; Stop's live program exit is
           ;; authoritative after ownership-preserving Return forwarding.
           (assert-eq (parser-test-boxed-int
                        (n-in! (parser-test-return-named stop "main") RETURN-VALUE))
                      (ty-flt-con 14.0))
           (assert (live-unboxes-proven?))
           (assert-eq (verify-all) VERR-OK)))

(deftest sequential_bindings_assignment_and_block_shadowing_build_ssa_during_lowering
         (boot! 78)
         (let [stop
                 (parse-program "function main(): number {
               let x: number = 2;
               x = x + 3;
               { const x: number = 99; x; }
               return x * 2;
             }")
               ret (parser-test-return-named stop "main")]
           ;; The inner const is lexical parser state only and cannot leak into the returned graph.
           ;; The outer assignment is an SSA edge update, so specialization sees (2 + 3) * 2.
           (assert-eq (verify-all) VERR-OK)
           (assert (> (parser-test-run-opto! stop) 0))
           (assert-eq (parser-test-boxed-int (n-in! ret RETURN-VALUE)) (ty-flt-con 10.0))
           (assert (live-unboxes-proven?))
           (assert-eq (verify-all) VERR-OK)))

(deftest block_local_return_value_survives_lexical_scope_pop
         (boot! 87)
         (let [stop
                 (parse-program "function main() {
               { let answer = 42; return answer; }
             }")
               ret (parser-test-return-named stop "main")]
           ;; Scope pop removes the local's environment edge. Return lowering must retain its
           ;; value until the graph Return has taken ownership rather than triggering eager DCE.
           (assert-eq (parser-test-boxed-int (n-in! ret RETURN-VALUE)) (ty-int-con 42))
           (assert-eq (verify-all) VERR-OK)))

(deftest block_local_returns_survive_until_the_if_return_phi_owns_them
         (boot! 88)
         (let [stop
                 (parse-program "function choose(condition) {
               if (condition) { let yes = 7; return yes; }
               else { let no = 9; return no; }
             }
             function main() { return choose(1); }")
               ret (parser-test-return-named stop "choose")
               answer (n-in! ret RETURN-VALUE)]
           (assert-eq (n-op answer) OP-PHI)
           (assert-eq (parser-test-boxed-int (n-in! answer 1)) (ty-int-con 7))
           (assert-eq (parser-test-boxed-int (n-in! answer 2)) (ty-int-con 9))
           (assert-eq (verify-all) VERR-OK)))

(deftest conditional_expressions_lower_to_lazy_branch_control_and_value_phi
         (boot! 79)
         (let [stop
                 (parse-program "function pick(c: number, a: number, b: number): number {
               return c ? a : b;
             }
             function main(): number { return pick(1, 2, 3); }")
               pick-ret (parser-test-return-named stop "pick")
               selected (n-in! pick-ret RETURN-VALUE)]
           (assert-eq (n-op selected) OP-PHI)
           (assert-eq (n-op (n-in! pick-ret RETURN-CTRL)) OP-REGION)
           (assert (n-same? (phi-region selected) (n-in! pick-ret RETURN-CTRL)))
           (assert-eq (verify-all) VERR-OK)
           (assert (> (parser-test-run-opto! stop) 0))
           (assert-eq (parser-test-boxed-int
                        (n-in! (parser-test-return-named stop "main") RETURN-VALUE))
                      (ty-int-con 2))
           (assert-eq (verify-all) VERR-OK)))

(deftest conditional_calls_fork_and_merge_scope_memory_with_the_value
         (boot! 89)
         (let [stop
                 (parse-program "function left(value) { return value; }
             function right(value) { return value; }
             function choose(condition, a, b) {
               return condition ? left(a) : right(b);
             }
             function main() { return choose(1, 7, 9); }")
               ret (parser-test-return-named stop "choose")
               control (n-in! ret RETURN-CTRL)
               value (n-in! ret RETURN-VALUE)
               memory (n-in! ret RETURN-MEM)]
           (assert-eq (n-op control) OP-REGION)
           (assert-eq (n-op value) OP-PHI)
           (assert-eq (n-op memory) OP-MEMPHI)
           (assert (n-same? (phi-region value) control))
           (assert (n-same? (phi-region memory) control))
           (assert-ne (n-nid (n-in! memory 1)) (n-nid (n-in! memory 2)))
           (assert-eq (verify-all) VERR-OK)))

(deftest unknown_entry_values_keep_the_generic_conditional_graph
         (boot! 80)
         (let [stop
                 (parse-program "function main(condition: number, a: number, b: number): number {
               return condition ? a : b;
             }")
               ret (parser-test-return-named stop "main")
               selected (n-in! ret RETURN-VALUE)
               region (n-in! ret RETURN-CTRL)
               true-arm (n-in! region 1)
               iff (n-in! true-arm 0)]
           ;; The source value remains dynamic at the semantic boundary; If consumes the raw
           ;; Boolean result of the JSL truthiness call.
           (assert-eq (n-op (n-in! iff 1)) OP-PROJ)
           (assert-eq (n-op iff) OP-IF)
           (assert-eq (n-op selected) OP-PHI)
           (assert-eq (verify-all) VERR-OK)))

(deftest process_wrapper_supplies_undefined_for_every_omitted_main_argument
         (boot! 90)
         (let [stop
                 (parse-program "function main(condition, a, b) {
               return condition ? a : b;
             }")
               wrapper-ret
                 (match (fun-ret (parser-entry-fun))
                   (Some [ret] ret)
                   (None [] (unreachable-node)))
               wrapper-end (n-in! (n-in! wrapper-ret RETURN-VALUE) 0)
               wrapper-call (n-in! wrapper-end 0)]
           (assert-eq (parser-entry-arity) 3)
           (assert-eq (call-nargs wrapper-call) 3)
           (let [(mut i) 0]
             (loop (if (>= (load i) 3)
                       (break 0)
                       (do
                         (assert-eq (n-ty (call-arg wrapper-call (load i)))
                                    (ty-dyn TAG-UNDEFINED))
                         (set! (mut i) (+ (load i) 1))
                         (continue)))))
           (assert-eq (n-op (parser-entry-start)) OP-START)
           (assert-eq (n-op stop) OP-STOP)
           (assert-eq (verify-all) VERR-OK)))

(deftest extra_call_actuals_evaluate_left_to_right_before_the_fixed_arity_call
         (boot! 93)
         (let [stop
                 (parse-program "function observe_noInline(value) { return value; }
             function identity_noInline(answer) { return answer; }
             function main() { return identity_noInline(42, observe_noInline(7)); }")
               main-ret (parser-test-return-named stop "main")
               outer-end (n-in! (n-in! main-ret RETURN-VALUE) 0)
               outer-call (n-in! outer-end 0)
               effect-ctrl (call-ctrl outer-call)
               effect-mem (call-mem outer-call)
               effect-end (n-in! effect-ctrl 0)
               effect-call (n-in! effect-end 0)]
           ;; The target has one formal, so only the first actual reaches its ABI input bank.
           (assert-eq (call-nargs outer-call) 1)
           (assert-eq (parser-test-boxed-int (call-arg outer-call 0)) (ty-int-con 42))
           ;; The extra actual is still lowered. Its CallEnd advances both control and memory, and
           ;; the outer call consumes those projections; this is the observable sequencing edge
           ;; even though the admitted source subset has no externally mutable binding yet.
           (assert-eq (n-op effect-ctrl) OP-CPROJ)
           (assert-eq (n-op effect-mem) OP-PROJ)
           (assert (n-same? (n-in! effect-mem 0) effect-end))
           (assert-eq (n-op effect-call) OP-CALL)
           (assert-eq (call-nargs effect-call) 1)
           (assert-eq (parser-test-boxed-int (call-arg effect-call 0)) (ty-int-con 7))
           (assert-eq (verify-all) VERR-OK)))

(deftest assignment_to_global_undefined_preserves_rhs_control_and_memory_effects
         (boot! 95)
         (let [stop
                 (parse-program "function observe_noInline(value) { return value; }
             function main() { undefined = observe_noInline(7); return 42; }")
               main-ret (parser-test-return-named stop "main")
               ret-ctrl (n-in! main-ret RETURN-CTRL)
               ret-mem (n-in! main-ret RETURN-MEM)
               effect-end (n-in! ret-ctrl 0)
               effect-call (n-in! effect-end 0)]
           ;; PutValue to the non-writable global is a no-op in this non-strict subset, but the RHS
           ;; call is not dead syntax: its CallEnd advances both effect chains consumed by Return.
           (assert-eq (n-op ret-ctrl) OP-CPROJ)
           (assert-eq (n-op ret-mem) OP-PROJ)
           (assert (n-same? (n-in! ret-mem 0) effect-end))
           (assert-eq (n-op effect-call) OP-CALL)
           (assert-eq (call-nargs effect-call) 1)
           (assert-eq (parser-test-boxed-int (call-arg effect-call 0)) (ty-int-con 7))
           (assert-eq (verify-all) VERR-OK)))

(deftest binary_operands_advance_control_and_memory_in_source_order
         (boot! 94)
         (let [stop
                 (parse-program "function left_noInline(value) { return value; }
             function right_noInline(value) { return value; }
             function main() { return left_noInline(20) + right_noInline(22); }")
               main-ret (parser-test-return-named stop "main")
               add-end (n-in! (n-in! main-ret RETURN-VALUE) 0)
               add-call (n-in! add-end 0)
               right-end (n-in! (call-ctrl add-call) 0)
               right-call (n-in! right-end 0)
               left-end (n-in! (call-ctrl right-call) 0)
               left-call (n-in! left-end 0)]
           ;; JavaScript evaluates the left operand first, then the right, then invokes the
           ;; semantic numeric operation. Both effect chains must record that same order.
           (assert (n-same? (n-in! (call-mem right-call) 0) left-end))
           (assert (n-same? (n-in! (call-mem add-call) 0) right-end))
           (assert (n-same? (n-in! (call-arg add-call 0) 0) left-end))
           (assert (n-same? (n-in! (call-arg add-call 1) 0) right-end))
           (assert-eq (call-nargs left-call) 1)
           (assert-eq (call-nargs right-call) 1)
           (assert-eq (verify-all) VERR-OK)))

(deftest if_statements_merge_reassigned_bindings_through_scope_ssa
         (boot! 81)
         (let [stop
                 (parse-program "function main(condition: number, a: number, b: number): number {
               let selected = a;
               if (condition) { selected = b; }
               return selected;
             }")
               ret (parser-test-return-named stop "main")
               selected (n-in! ret RETURN-VALUE)
               region (n-in! ret RETURN-CTRL)
               true-arm (n-in! region 1)
               iff (n-in! true-arm 0)]
           (assert-eq (n-op iff) OP-IF)
           (assert-eq (n-op region) OP-REGION)
           (assert-eq (n-op selected) OP-PHI)
           (assert (n-same? (phi-region selected) region))
           (assert-eq (verify-all) VERR-OK)))

(deftest constant_if_else_statements_collapse_to_the_taken_assignment
         (boot! 82)
         (let [stop
                 (parse-program "function main(): number {
               let selected = 2;
               if (0) { selected = 3; } else { selected = 4; }
               return selected;
             }")]
           (assert-eq (verify-all) VERR-OK)
           (assert (> (parser-test-run-opto! stop) 0))
           (assert-eq (parser-test-boxed-int (n-in! (parser-test-return-named stop "main") RETURN-VALUE))
                      (ty-int-con 4))
           (assert-eq (verify-all) VERR-OK)))

(deftest if_else_with_two_returns_joins_values_at_the_function_return
         (boot! 83)
         (let [stop
                 (parse-program "function main(condition: number, a: number, b: number): number {
               if (condition) { return a; } else { return b; }
             }")
               ret (parser-test-return-named stop "main")
               answer (n-in! ret RETURN-VALUE)
               region (n-in! ret RETURN-CTRL)]
           (assert-eq (n-op answer) OP-PHI)
           (assert-eq (n-op region) OP-REGION)
           (assert (n-same? (phi-region answer) region))
           (assert-eq (verify-all) VERR-OK)))

(deftest while_statements_build_lazy_loop_phis_and_close_the_backedge
         (boot! 84)
         (let [stop
                 (parse-program "function main(condition: number, initial: number, next: number): number {
               let value = initial;
               while (condition) {
                 value = next;
                 condition = 0;
               }
               return value;
             }")
               ret (parser-test-return-named stop "main")
               value (n-in! ret RETURN-VALUE)
               head (phi-region value)
               exit-control (n-in! ret RETURN-CTRL)
               iff (n-in! exit-control 0)]
           (assert-eq (n-op value) OP-PHI)
           (assert-eq (n-op head) OP-LOOP)
           (assert (not (loop-in-progress? head)))
           (assert-eq (n-nins value) 3)
           ;; Arity alone is insufficient: a closing Phi may still retain a null backedge. Force
           ;; the edge here so eager Scope reclamation cannot silently produce a malformed loop.
           (assert (> (n-nid (n-in! value 2)) 0))
           (assert-eq (n-nins head) 3)
           (assert-eq (n-op exit-control) OP-CPROJ)
           (assert-eq (n-op iff) OP-IF)
           (let [truthy-end (n-in! (n-in! iff 0) 0)
                 truthy-call (n-in! truthy-end 0)]
             (assert (n-same? (call-ctrl truthy-call) head)))
           (assert-eq (verify-all) VERR-OK)))

(deftest false_constant_while_collapses_without_executing_the_body
         (boot! 85)
         (let [stop
                 (parse-program "function main(): number {
               let value = 2;
               while (0) { value = 3; }
               return value;
             }")]
           (assert-eq (verify-all) VERR-OK)
           (assert (> (parser-test-run-opto! stop) 0))
           ;; The original Return may be replaced when the dead loop collapses. Stop owns the live
           ;; compilation-unit return, so reacquire it after optimization.
           (assert-eq (n-ty (n-in! (parser-test-return-named stop "main") RETURN-VALUE))
                      (ty-dyn TAG-INT))
           (assert-eq (verify-all) VERR-OK)))

(deftest unannotated_javascript_functions_use_the_same_dynamic_calling_convention
         (boot! 86)
         (let [stop
                 (parse-program "function scale(a, b) { return a + b * 4; }
             function main() { return scale(2, 3); }")
               add-ret (parser-test-return-named stop "scale")
               add-fun
                 (match (arena-node (return-fun-nid add-ret))
                   (Some [f] f)
                   (None [] (unreachable-node)))
               main-ret (parser-test-return-named stop "main")]
           (assert-eq (n-op (n-in! add-ret RETURN-VALUE)) OP-PROJ)
           (assert-eq (ty-tuple-at (fun-sig add-fun) 0) (ty-dyn TAG-ANY))
           (assert-eq (ty-tuple-at (fun-sig add-fun) 1) (ty-dyn TAG-ANY))
           (assert-eq (ty-tuple-at (fun-sig add-fun) 2) (ty-dyn TAG-ANY))
           (assert-eq (verify-all) VERR-OK)
           (assert-eq (n-op (n-in! main-ret RETURN-VALUE)) OP-PROJ)
           (assert (> (parser-test-run-opto! stop) 0))
           ;; Opto may replace the Return itself and rewire Stop. Reacquire the live graph root
           ;; rather than dereferencing the intentionally killed pre-Opto node handle.
           (assert (ty-flt? (parser-test-boxed-int
                              (n-in! (parser-test-return-named stop "main") RETURN-VALUE))))
           (assert-eq (verify-all) VERR-OK)))
