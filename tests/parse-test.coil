         (parser-test-syntax-result "class C { x = super.y; static { super.z; } }" 0)
         (parser-test-syntax-result "class C extends B { constructor(a = super()) {} }" 0)
         (parser-test-syntax-result "class C extends (o) => o {}" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { x = arguments; }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { x = () => arguments; }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { x = function () { arguments; }; }" 0)
         (parser-test-syntax-result "class C { static { arguments; } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { static { await; } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { static { var await; } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { static { return; } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { static { await: 0; } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { static { new.target; () => arguments; } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { static { new.target; function f() { arguments; return; } } }" 0)
         (parser-test-syntax-result "class C { x y }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { x\ny }" 0)
         (parser-test-syntax-result "class C { x = 1 /**/ m() {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { get; set = 1; static; async\nm() {} static x = 1; static static() {} static async *[y]() {} }" 0)
         (parser-test-syntax-result "class A {} class A {}" EXIT-SYNTAX)
         (parser-test-syntax-result "{ class A {} class A {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "class eval {}" EXIT-SYNTAX)
         (parser-test-syntax-result "class yield {}" EXIT-SYNTAX)
         (parser-test-syntax-result "class let {}" EXIT-SYNTAX)
         (parser-test-syntax-result "let A = 1; class A {}" EXIT-SYNTAX)
         (parser-test-syntax-result "class A {} var A;" EXIT-SYNTAX)
         (parser-test-syntax-result "(class await {}); function f() { class A {} }" 0)
         (parser-test-syntax-result "class C { m() { 077; } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { m() { with (x) {} } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { m(a, a) {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { *g() { yield 3 + yield 4; } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { async m(x = await) {} }" EXIT-SYNTAX)
         (parser-test-refuses "x = class {};" true EXIT-UNIMPLEMENTED)
         (parser-test-refuses "class A {}" true EXIT-UNIMPLEMENTED))

(deftest campaign_false_accepts_are_now_proven_errors
         ;; Annex B duplicate functions in a sloppy Block are plain functions only.
         (parser-test-syntax-result "{ async function f() {} function f() {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "{ function f() {} class f {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "{ function* f() {} function* f() {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "{ function f() {} function f() {} }" 0)
         ;; Web-compat call targets: never for logical assignment or for-in/of heads.
         (parser-test-syntax-result "for (f() in [1]) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (f() of [1]) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "f() &&= 1;" EXIT-SYNTAX)
         (parser-test-syntax-result "(f()) ??= 1;" EXIT-SYNTAX)
         (parser-test-syntax-result "f() = 1; f() += 1; f()++;" 0)
         ;; `await` in nested arrow parameters of an async arrow head.
         (parser-test-syntax-result "async(a = await => {}) => {};" EXIT-SYNTAX)
         (parser-test-syntax-result "async(a = (await) => {}) => {};" EXIT-SYNTAX)
         (parser-test-syntax-result "async(a = (...await) => {}) => {};" EXIT-SYNTAX)
         (parser-test-syntax-result "(async (...a,) => {});" EXIT-SYNTAX)
         (parser-test-syntax-result "async (...a) => {}; async (a, ...b) => {}; f(...a,);" 0)
         ;; Private names: not through super, only as the left operand of `in`.
         (parser-test-syntax-result "class C extends B { #x() {} m() { super.#x(); } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { #f; constructor() { #f in #f in this; } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { #f; constructor() { #f in () => {}; } }" EXIT-SYNTAX)
         ;; Arrows are whole AssignmentExpressions.
         (parser-test-syntax-result "a in () => {};" EXIT-SYNTAX)
         (parser-test-syntax-result "() => {}.x;" EXIT-SYNTAX)
         (parser-test-syntax-result "-() => 1;" EXIT-SYNTAX)
         (parser-test-syntax-result "new () => {};" EXIT-SYNTAX)
         (parser-test-syntax-result "() => {} ? 1 : 2;" EXIT-SYNTAX)
         (parser-test-syntax-result "() => 1 + 1; (() => 1) + 1; a ? () => 1 : () => 2; x = () => 1, () => 2; (() => 1)();" 0)
         ;; `return` in a static block inside a function.
         (parser-test-syntax-result "function f() { class C { static { return; } } }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { static { () => { return; }; } }" 0)
         ;; Class heritage and computed keys are strict code.
         (parser-test-syntax-result "class C extends (function B() { with ({}); return B; }()) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "class C extends (eval = 1) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { [eval = 1]() {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { [x]() {} static [y] = 1; }" 0)
         ;; Missing required tokens are proven errors in Script code.
         (parser-test-syntax-result "...x => x;" EXIT-SYNTAX)
         (parser-test-syntax-result "switch {}" EXIT-SYNTAX)
         (parser-test-syntax-result "if true;" EXIT-SYNTAX)
         (parser-test-syntax-result "do {} while" EXIT-SYNTAX)
         (parser-test-syntax-result "function x,y(){}" EXIT-SYNTAX)
         (parser-test-syntax-result "x.1;" EXIT-SYNTAX)
         (parser-test-syntax-result "while 0 break;" EXIT-SYNTAX)
         (parser-test-syntax-result "({ async function f() {} });" EXIT-SYNTAX)
         ;; Lexically unknown tokens still fail closed, as does TypeScript entry mode.
         (parser-test-syntax-result "x.\\u0061; x.\\u0069f;" 0)
         (parser-test-refuses "function main<T>() { return 1; }" false EXIT-PANIC))

(deftest binding_patterns_in_declarations_parameters_and_catch
         ;; Valid binding patterns parse as syntax.
         (parser-test-syntax-result "let [a, , b = 1, ...c] = x; const {d, e: f, g: [h], ...i} = y; var {j = 2} = z;" 0)
         (parser-test-syntax-result "function f([a], {b}, c = 1, ...[d]) {} function g({a: {b: [c]}} = {}) {}" 0)
         (parser-test-syntax-result "try {} catch ([a, b]) {} try {} catch ({message}) {}" 0)
         (parser-test-syntax-result "for (const [k, v] of m) {} for (let {a} in o) {} for (var [x] of y) {}" 0)
         (parser-test-syntax-result "({a, b: [c]}) => 0; ([a], {b}) => 0; ({a = 1} = {}) => 0; (...[a, b]) => 0; async ({a}) => 0;" 0)
         (parser-test-syntax-result "let {[k]: v, 'q': w, 0: x, if: y} = o;" 0)
         ;; Rest elements are last and take no default.
         (parser-test-syntax-result "let [...x, y] = z;" EXIT-SYNTAX)
         (parser-test-syntax-result "let [...x = 1] = z;" EXIT-SYNTAX)
         (parser-test-syntax-result "let {...x, y} = z;" EXIT-SYNTAX)
         (parser-test-syntax-result "let {...{x}} = z;" EXIT-SYNTAX)
         (parser-test-syntax-result "function f(...[a] = []) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "(...[a], b) => 0;" EXIT-SYNTAX)
         ;; A destructuring declaration needs an initializer, even in a for head.
         (parser-test-syntax-result "let [a];" EXIT-SYNTAX)
         (parser-test-syntax-result "var {a};" EXIT-SYNTAX)
         (parser-test-syntax-result "for (let [a]; ;) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (const [x] = 1 of []) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (var [x] = 1 in {}) {}" EXIT-SYNTAX)
         ;; Bound names are still names: duplicates, conflicts and strict restrictions apply.
         (parser-test-syntax-result "let [a, a] = x;" EXIT-SYNTAX)
         (parser-test-syntax-result "let {a} = x; var a;" EXIT-SYNTAX)
         (parser-test-syntax-result "function f([a], a) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "function f([a, a]) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "({a}, a) => 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "try {} catch ([a, a]) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "try {} catch ({a}) { let a; }" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; let [eval] = x;" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; function f({arguments}) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "function f([a] = 1) { 'use strict'; }" EXIT-SYNTAX)
         (parser-test-syntax-result "let [this] = x;" EXIT-SYNTAX)
         (parser-test-syntax-result "let [a.b] = x;" EXIT-SYNTAX)
         (parser-test-syntax-result "let {a: b.c} = x;" EXIT-SYNTAX)
         (parser-test-syntax-result "let {a: (b)} = x;" EXIT-SYNTAX)
         (parser-test-syntax-result "([a.b]) => 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "({a: (b)}) => 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "async ({await}) => 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "async ({a = await 1}) => 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "function* g([a = yield]) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "let {a b} = x;" EXIT-SYNTAX)
         (parser-test-syntax-result "let {[k]} = x;" EXIT-SYNTAX)
         (parser-test-syntax-result "let {'q'} = x;" EXIT-SYNTAX))

(deftest assignment_patterns_reinterpret_object_and_array_literals
         (parser-test-syntax-result "[a, b] = [b, a]; ({a, b: c.d, e: f[0], ...g} = h); [a = 1, [b], {c}, ...d] = e;" 0)
         (parser-test-syntax-result "({a = 1} = x); [{a = 1}] = y; ({a: {b = 2}} = z);" 0)
         (parser-test-syntax-result "for ([a, b] of c) {} for ({x, y = 1} in z) {} for ([a.b] of c) {}" 0)
         (parser-test-syntax-result "[(a), (b.c)] = d; ({a: (b)} = c);" 0)
         (parser-test-syntax-result "x = [a, b] = c; ([a] = b) => 0; ({a} = b, [c] = d) => 0;" 0)
         (parser-test-syntax-result "([a.b] = c) => 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "({a: (b)} = c) => 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; ([eval] = c) => 0;" EXIT-SYNTAX)
         ;; Only `=` destructures; a literal is never a compound or logical target.
         (parser-test-syntax-result "[a] += 1;" EXIT-SYNTAX)
         (parser-test-syntax-result "({a} ??= 1);" EXIT-SYNTAX)
         (parser-test-syntax-result "([a]) = 1;" EXIT-SYNTAX)
         (parser-test-syntax-result "({a}) = 1;" EXIT-SYNTAX)
         (parser-test-syntax-result "[([a])] = 1;" EXIT-SYNTAX)
         ;; Shorthand initializers only survive inside a pattern.
         (parser-test-syntax-result "({a = 1});" EXIT-SYNTAX)
         (parser-test-syntax-result "f({a = 1});" EXIT-SYNTAX)
         (parser-test-syntax-result "({a = 1}) + 1;" EXIT-SYNTAX)
         ;; Invalid leaves and rest elements.
         (parser-test-syntax-result "[a + b] = c;" EXIT-SYNTAX)
         (parser-test-syntax-result "[f()] = c;" EXIT-SYNTAX)
         (parser-test-syntax-result "[a?.b] = c;" EXIT-SYNTAX)
         (parser-test-syntax-result "[...a, b] = c;" EXIT-SYNTAX)
         (parser-test-syntax-result "[...a = 1] = c;" EXIT-SYNTAX)
         (parser-test-syntax-result "({...a, b} = c);" EXIT-SYNTAX)
         (parser-test-syntax-result "({...[a]} = c);" EXIT-SYNTAX)
         (parser-test-syntax-result "({...{a}} = c);" EXIT-SYNTAX)
         (parser-test-syntax-result "({m() {}} = c);" EXIT-SYNTAX)
         (parser-test-syntax-result "[(a = 1)] = c;" EXIT-SYNTAX)
         (parser-test-syntax-result "[this] = c;" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; [eval] = c;" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; ({arguments} = c);" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; [(eval)] = c;" EXIT-SYNTAX)
         (parser-test-syntax-result "[(a) = 1] = c; [(a)] = c;" 0)
         (parser-test-syntax-result "[a, b] = c;" 0))

(deftest regex_literal_patterns_are_early_errors_of_the_program
         (parser-test-syntax-result "/a/; /a/u; /[a-z&&[^aeiou]]/v; /(?<n>x)\\k<n>/; /\\p{Script=Latin}/u; x = /re/g;" 0)
         (parser-test-syntax-result "/?/;" EXIT-SYNTAX)
         (parser-test-syntax-result "/{2}/;" EXIT-SYNTAX)
         (parser-test-syntax-result "/a{2,1}/;" EXIT-SYNTAX)
         (parser-test-syntax-result "/\\p{Foo}/u;" EXIT-SYNTAX)
         (parser-test-syntax-result "/\\P{RGI_Emoji}/v;" EXIT-SYNTAX)
         (parser-test-syntax-result "/(?<a>x)(?<a>y)/;" EXIT-SYNTAX)
         (parser-test-syntax-result "/[(]/v;" EXIT-SYNTAX)
         (parser-test-syntax-result "/(?i-i:a)/;" EXIT-SYNTAX)
         (parser-test-syntax-result "/\\M/u;" EXIT-SYNTAX)
         (parser-test-syntax-result "/\\M/;" 0)
         (parser-test-syntax-result "/a/x;" EXIT-SYNTAX)
         (parser-test-syntax-result "/(?<❤>a)/;" EXIT-PANIC)
         (parser-test-syntax-result "function f() { return /(/; }" EXIT-SYNTAX))

(deftest patterns_campaign_false_accepts_are_now_proven_errors
         (parser-test-syntax-result "[...x,] = y;" EXIT-SYNTAX)
         (parser-test-syntax-result "({...x,} = y);" EXIT-SYNTAX)
         (parser-test-syntax-result "for ([...x,] of y) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for ({...x,} in y) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "([...x,]) => 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "[...x,]; ({...x,}); f([...x,], {...x,});" 0)
         (parser-test-syntax-result "'use strict'; for ([arguments] in x) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; for ({eval} of x) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; for ({eval = 1} of x) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; for ({yield} in x) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for ([arguments] in x) {} for ({eval} of x) {} for ({yield} in x) {}" 0))

(deftest for_await_is_syntax_inside_async_functions_only
         (parser-test-syntax-result "async function f() { for await (x of y) {} for await (let x of y) {} for await (const [a] of y) {} }" 0)
         (parser-test-syntax-result "async () => { for await (x of y) {} }; async function* g() { for await (var x of y) ; }" 0)
         (parser-test-syntax-result "({ async m() { for await (x.y of z) {} } });" 0)
         (parser-test-syntax-result "for await (x of y) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "function f() { for await (x of y) {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "async function f() { function g() { for await (x of y) {} } }" EXIT-SYNTAX)
         (parser-test-syntax-result "async function f() { () => { for await (x of y) {} }; }" EXIT-SYNTAX)
         (parser-test-syntax-result "async function f() { for await (x in y) {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "async function f() { for await (;;) {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "async function f() { for await (x; y; z) {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "async function f() { for await (let [x] = 1 of []) {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "async function f() { for await (var x = 1 of []) {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "async function f() { for await ([...x,] of []) {} }" EXIT-SYNTAX)
         (parser-test-refuses "async function f() { for await (x of y) ; }" true EXIT-UNIMPLEMENTED))

(deftest sloppy_let_is_an_identifier_outside_strict_code
         (parser-test-syntax-result "var let = 1; let; let = 2; let.x; (let[0]); f(let); for (let in o) {} for (let;;) break; for (let.x in o) {}" 0)
         (parser-test-syntax-result "(function let() {}); function let() {} ({let}); if (x) let\ny; let\nx = 1; while (false) let\nx; let: 1;" 0)
         (parser-test-syntax-result "let[0];" EXIT-SYNTAX)
         (parser-test-syntax-result "let let = 1;" EXIT-SYNTAX)
         (parser-test-syntax-result "const let = 1;" EXIT-SYNTAX)
         (parser-test-syntax-result "let [let] = x;" EXIT-SYNTAX)
         (parser-test-syntax-result "for (let let of x) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (let of x) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (async of x) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (async.x of y) {} for (async in y) {} async function f() { for await (async of x) {} }" 0)
         (parser-test-syntax-result "if (x) let y;" EXIT-SYNTAX)
         (parser-test-syntax-result "if (x) let\n[a] = 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "if (x) let {a} = 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "while (x) let\n[a] = 0;" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; var let = 1;" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; let;" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; function let() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; (function let() {});" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; ({let});" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; for (let in o) {}" EXIT-SYNTAX)
         (parser-test-syntax-result "class let {}" EXIT-SYNTAX)
         (parser-test-syntax-result "function f() { 'use strict'; let; }" EXIT-SYNTAX))

(deftest annex_b_function_declarations_in_if_clauses_and_labels
         (parser-test-syntax-result "if (x) function f() {} else function g() {} if (x) ; else function h() {}" 0)
         (parser-test-syntax-result "label: function f() {} a: b: function g() {} { c: function h() {} }" 0)
         (parser-test-syntax-result "if (x) function* g() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "if (x) async function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "while (x) function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "do function f() {} while (x)" EXIT-SYNTAX)
         (parser-test-syntax-result "for (;;) function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (x in y) function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (x of y) function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "with (x) function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "if (x) label: function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "if (x) ; else label: function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "while (x) a: b: function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "for (x of y) a: b: function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "with (x) a: function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "label: function* g() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "label: async function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; if (x) function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "'use strict'; label: function f() {}" EXIT-SYNTAX)
         (parser-test-syntax-result "function g() { 'use strict'; if (x) function f() {} }" EXIT-SYNTAX)
         (parser-test-syntax-result "class C { m() { if (x) function f() {} } }" EXIT-SYNTAX)
         (parser-test-syntax-result "if (x) function f() {} if (x) function f() {}" 0)
         ;; B.3.3 treats the clause as a Block, so the outer `let f` does not conflict.
         (parser-test-syntax-result "{ if (x) function f() {} let f; }" 0)
         (parser-test-syntax-result "{ if (x) function f() {} else function f() {} }" 0))

(deftest identifier_escapes_are_names_not_keywords
         (parser-test-syntax-result "var \\u0061 = 1; \\u0061; var l\\u0065t = 1; l\\u0065t; ({ v\\u0061r: 1 }).v\\u0061r; ({ \\u0061wait: 1 }); x.\\u0069f;" 0)
