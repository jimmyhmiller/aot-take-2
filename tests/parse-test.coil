(deftest function_values_lower_and_the_remaining_function_forms_refuse_by_name
         ;; Function expressions, arrows, nested and block-level declarations, immediate calls and
         ;; a declaration read as a value all lower over the shared ABI (docs/DECISIONS.md,
         ;; function values).
         (parser-test-lowers "function main() { function inner() {} return 1; }" false)
         (parser-test-lowers "function main() { let f = function () {}; return 1; }" false)
         (parser-test-lowers "function main() { let f = x => x; return 1; }" false)
         (parser-test-lowers "function main() { return (() => 1)(); }" false)
         (parser-test-lowers "function main() { function g() {} g = function () {}; return 1; }" false)
         (parser-test-lowers "x => x;" true)
         (parser-test-lowers "(a, b) => a;" true)
         (parser-test-lowers "function f() {} let g = f; g();" true)
         (parser-test-lowers "function g() {} if (g) function f() {}" true)
         (parser-test-lowers "label: function f() {}" true)
         ;; Script `var` is a realm global (docs/DECISIONS.md, realm).
         (parser-test-lowers "var x = 42;" true)
         (parser-test-lowers "var x = 1; function f() { return x; } f();" true)
         (parser-test-lowers "function f() { x = 2; } var x; f();" true)
         (parser-test-lowers "if (false) { var x; }" true)
         (parser-test-lowers "function g() {} g = function () {};" true)
         ;; Methods, accessors, generators, async functions and non-simple parameter lists refuse
         ;; by name; so do Script-level global-object bindings, read or written.
         (parser-test-refuses "function main() { let o = { m() {} }; return 1; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function* main() { return 1; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "async function main() { return 1; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "function main(a = 1) { return a; }" false EXIT-UNIMPLEMENTED)
         (parser-test-refuses "async x => x;" true EXIT-UNIMPLEMENTED)
         (parser-test-refuses "x = { m() {} };" true EXIT-UNIMPLEMENTED)
         (parser-test-refuses "x = function () {};" true EXIT-UNIMPLEMENTED)
         (parser-test-refuses "if (x) function f() {}" true EXIT-UNIMPLEMENTED)
         (parser-test-refuses "x;" true EXIT-UNIMPLEMENTED))

