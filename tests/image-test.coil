(extern setenv :cc c [(ptr i8) (ptr i8) i32] (-> i32))
(extern unsetenv :cc c [(ptr i8)] (-> i32))

(deftest provider_ideal_graph_is_a_durable_byte_exact_artifact
         (compiler-session-reset!)
         (let [artifact (pipeline-shared-jsl-artifact 211)
               first (.graph artifact)
               image (primitive/alloc-stack CodeImage)]
           (set! image (.image artifact))
           (compiler-session-reset!)
           (match (ser-read-graph first)
             (None [] (assert false))
             (Some [root]
               (let [second (ser-write-graph root)]
                 (assert-eq first second)
                 (alloc/free [u8] (alloc/malloc-allocator) second))))
           (image-free! image)
           (alloc/free [u8] (alloc/malloc-allocator) first)))

(deftest provider_disk_cache_survives_process_local_source_cache_teardown
         (assert-eq (setenv c"AOT_PROVIDER_CACHE_DIR"
                            c"/tmp/aot-take-2-provider-cache-test"
                            1)
                    (primitive/cast i32 0))
         (compiler-session-reset!)
         (jsl-load-library! JSL-COMPILER-INDEX)
         (let [(mut key) (source-cache-library-key)
               first (primitive/alloc-stack SourceCache)
               second (primitive/alloc-stack SourceCache)]
           (provider-cache-remove! (load key) 223)
           (set! first (source-cache-new 1))
           (source-cache-library! first (load key) 223)
           (assert-eq (.provider-disk-misses first) 1)
           (assert-eq (.provider-disk-hits first) 0)
           (source-cache-free! first)
           (assert (match (provider-cache-load (load key) 224)
                     (Some [_] false)
                     (None [] true)))
           (let [(mut changed) (source-cache-copy-strings (load key))
                 bytes (al-elem [(slice u8)] (mut changed) 3)
                 first-byte (primitive/index (alloc/alloc-slice-data (load bytes)) 0)]
             (set! first-byte
                   (primitive/cast u8
                     (if (= (load first-byte) (primitive/cast u8 32)) 33 32)))
             (assert (match (provider-cache-load (load changed) 223)
                       (Some [_] false)
                       (None [] true)))
             (source-cache-free-strings! (mut changed)))
           (set! second (source-cache-new 1))
           (source-cache-library! second (load key) 223)
           (assert-eq (.provider-disk-misses second) 0)
           (assert-eq (.provider-disk-hits second) 1)
           (source-cache-free! second)
           (assert (provider-cache-remove! (load key) 223))
           (source-cache-free-strings! (mut key)))
         (assert-eq (unsetenv c"AOT_PROVIDER_CACHE_DIR") (primitive/cast i32 0)))

(defn image-test-jsl-verify [(body JslExprResult) (library bool)] (-> JslExprResult)
  (if library
      (let [(mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
        (push! [(dyn NodeOps)] (mut args) (.value body))
        (push! [(dyn NodeOps)]
               (mut args)
               (load-make (.ctrl body)
                          (.mem body)
                          (heapstate-make)
                          (con-int RT-HEAP-OFFSET-EXCEPTION-VALUE)
                          ALIAS-EXCEPTION-VALUE
                          (ty-dyn TAG-ANY)))
        (let [verified
                (jsl-lower-macro-values "Verify"
                                        (load args)
                                        (.ctrl body)
                                        (.mem body))]
          (al-free! (mut args))
          verified))
      body))

;; A JSL-only frontend for native capability tests. It uses the ordinary optimizer, backend,
;; image installation and realm lifecycle, without exposing test-only syntax to JavaScript.
(defn image-test-jsl! [(source (slice u8))
                       (seed i64)
                       (expected i64)
                       (library bool)] (-> i64)
  (let [im (primitive/alloc-stack CodeImage)
        loaded (primitive/alloc-stack InstalledImage)]
    (compiler-session-reset!)
    (boot! seed)
    (code-reset! seed)
    (jsl-reset!)
    (jsl-lower-reset!)
    (code-enter-phase! PHASE-PARSE)
    (if library
        (do
          ;; This capability realm needs intrinsic identities but no source constructors or
          ;; global object. Execute the production error helpers over distinct prototype objects.
          (heap-set-intrinsic! "ReferenceError.prototype"
                               (heap-add-object! DYNAMIC-NULL-WORD))
          (heap-set-intrinsic! "TypeError.prototype"
                               (heap-add-object! DYNAMIC-NULL-WORD))
          (jsl-lower-index! "jsl/compiler/index")
          0)
        0)
    (jsl-lower-unit! (jsl-read-source! source "native-primitive-test.jsl"))
    (let [start (start-make (ty-int-bot))
          stop (stop-make)
          main
            (fun-make start
                      (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot))
                      "main")
          (mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
          body
            (image-test-jsl-verify (jsl-lower-macro-values "Probe"
                                                           (load args)
                                                           main
                                                           (con-make (ty-mem ALIAS-BULK
                                                                             TY-BOT)))
                                   library)
          ret
            (return-make (.ctrl body)
                         (Some (.mem body))
                         (.value body)
                         (None [(dyn NodeOps)])
                         (Some main))]
      (fun-set-ret! main ret)
      (stop-add-return! stop ret)
      (n-keep! start)
      (jsl-define-pending!)
      (code-enter-phase! PHASE-ITER)
      (jsl-prepare-opto!)
      (iter-seed-connected! stop)
      (iter-run!)
      (code-enter-phase! PHASE-OPTO)
      (jsl-close-world!)
      (opto-run!)
      (iter-seed-all!)
      (iter-run!)
      (property-expand-all!)
      (iter-seed-all!)
      (iter-run!)
      (jsl-finish-opto! stop)
      (code-enter-phase! PHASE-TYPECHECK)
      (typecheck-run! stop)
      (code-enter-phase! PHASE-LOOPTREE)
      (looptree-build! start stop)
      (code-enter-phase! PHASE-SERIALIZE)
      (gc-lower-barriers-from! stop)
      (code-enter-phase! PHASE-UNLINK)
      (fun-prepare-codegen! main start)
      (jsl-prepare-codegen! start)
      (call-unlink-all!)
      (n-unkeep! start)
      (pipeline-encode-machine! stop)
      (set! im (image-capture))
      (al-free! (mut args)))
    (compiler-session-reset!)
    (set! loaded (image-install im))
    (assert-eq (image-run! im loaded) expected)
    (assert-eq (image-run! im loaded) expected)
    (image-uninstall! loaded)
    (image-free! im)
    0))

(defn image-test-jsl-primitive! [(source (slice u8)) (seed i64) (expected i64)] (-> i64)
  (image-test-jsl! source seed expected false))

(deftest lexical_tdz_read_raises_the_intrinsic_reference_error_in_native_code
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
         (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
         (image-test-jsl! "(macro Probe :transitioning true :throws true :params [] :ret dyn
       (let [(slot (%GlobalLexicalCreate (%PropertyKey \"tdz\") 1))]
         (JsGlobalLexicalRead slot)))
     (macro Verify :params [(result dyn) (error dyn)] :ret dyn
       (if (%IsException result)
         (if (%IsObjectLike error)
           (if (JsStrictEqualValue (%GetObjectPrototype (%UnboxObjectLike error))
                                  (%IntrinsicPrototype \"ReferenceError.prototype\"))
               (%Box 42) (%Box 1)) (%Box 2)) (%Box 3)))"
                          1
                          42
                          true))

(deftest lexical_tdz_write_checks_initialization_before_const_writability
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
         (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
         (image-test-jsl! "(macro Probe :transitioning true :throws true :params [] :ret dyn
       (let [(slot (%GlobalLexicalCreate (%PropertyKey \"tdz\") 0))]
         (JsGlobalLexicalWrite slot (%Box (%StringFromCharCode 65)))))
     (macro Verify :params [(result dyn) (error dyn)] :ret dyn
       (if (%IsException result)
         (if (%IsObjectLike error)
           (if (JsStrictEqualValue (%GetObjectPrototype (%UnboxObjectLike error))
                                  (%IntrinsicPrototype \"ReferenceError.prototype\"))
               (%Box 42) (%Box 1)) (%Box 2)) (%Box 3)))"
                          17
                          42
                          true))

(deftest lexical_const_write_raises_type_error_and_preserves_the_initialized_value
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
         (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
         (image-test-jsl! "(macro Probe :transitioning true :throws true :params [] :ret dyn
       (let [(slot (%GlobalLexicalCreate (%PropertyKey \"constant\") 0))
             (initialized (%GlobalLexicalInitialize slot (%Box (%StringFromCharCode 65))))]
         (JsGlobalLexicalWrite slot (%Box (%StringFromCharCode 66)))))
     (macro Verify :params [(result dyn) (error dyn)] :ret dyn
       (if (%IsException result)
         (if (%IsObjectLike error)
           (if (JsStrictEqualValue (%GetObjectPrototype (%UnboxObjectLike error))
                                  (%IntrinsicPrototype \"TypeError.prototype\"))
             (let [(saved (%GlobalLexicalValue (%GlobalLexicalFind (%PropertyKey \"constant\"))))]
               (if (%IsString saved)
                 (if (%Eq (%StringCharCode (%UnboxString saved) 0) 65) (%Box 42) (%Box 4))
                 (%Box 5)))
             (%Box 1)) (%Box 2)) (%Box 3)))"
                          31
                          42
                          true))

(deftest lexical_initialized_undefined_and_mutable_writes_use_normal_completions
         (image-test-jsl! "(macro Probe :transitioning true :throws true :params [] :ret dyn
       (let [(slot (%GlobalLexicalCreate (%PropertyKey \"mutable\") 1))
             (initialized (%GlobalLexicalInitialize slot (%Undefined)))
             (before (JsGlobalLexicalRead slot))]
         (if (%IsException before) before
           (if (%IsUndefined before)
             (let [(stored (JsGlobalLexicalWrite slot (%Box 42)))]
               (if (%IsException stored) stored (JsGlobalLexicalRead slot)))
             (%Box 1)))))
     (macro Verify :params [(result dyn) (error dyn)] :ret dyn
       (if (%IsException result) (%Box 2) result))"
                          43
                          42
                          true))

(deftest lexical_primitives_execute_in_memory_with_fresh_realms_and_gc_roots
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
         (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
         (let [source
                 "(macro Probe :transitioning true :params [] :ret dyn
    (let [(key (%PropertyKey \"shared\"))
          (before (%GlobalLexicalFind key))
          (slot (%GlobalLexicalCreate key 1))
          (state (%GlobalLexicalState slot))
          (initialized (%GlobalLexicalInitialize slot (%Box (%StringFromCharCode 65))))
          (allocation (%StringFromCharCode 66))
          (saved (%GlobalLexicalValue slot))
          (other (%StringCharCode allocation 0))
          (stored (%GlobalLexicalStore slot (%Box 42)))
          (found (%GlobalLexicalFind key))]
      (if (%Eq before 0)
        (if (%Eq state 2)
          (if (%Eq found slot)
            (if (%IsString saved)
              (if (%Eq (%StringCharCode (%UnboxString saved) 0) 65)
                (if (%Eq other 66)
                  (if (%Eq (%GlobalLexicalState slot) 3) (%GlobalLexicalValue slot) (%Box 6))
                  (%Box 5)) (%Box 4)) (%Box 7)) (%Box 3)) (%Box 2)) (%Box 1))))"]
           (image-test-jsl-primitive! source 1 42)
           (image-test-jsl-primitive! source 17 42))
         (image-test-jsl-primitive! "(macro Probe :params [] :ret dyn
       (let [(slot (%GlobalLexicalCreate (%PropertyKey \"constant\") 0))
             (before (%GlobalLexicalState slot))
             (initialized (%GlobalLexicalInitialize slot (%Box 42)))]
         (if (%Eq before 0)
           (if (%Eq (%GlobalLexicalState slot) 1) (%GlobalLexicalValue slot) (%Box 2))
           (%Box 1))))"
                                    31
                                    42))

(defn image-test-source! [(source (slice u8)) (script bool) (expected i64)] (-> i64)
  (let [(mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
        im (primitive/alloc-stack CodeImage)
        loaded (primitive/alloc-stack InstalledImage)]
    (push! [(slice u8)] (mut sources) source)
    (compiler-session-reset!)
    (pipeline-encode-sources! (load sources) 1 script)
    (set! im (image-capture))
    (compiler-session-reset!)
    (assert-eq (.reserved (compiler-region)) 0)
    ;; Reinstall the same immutable artifact twice: the data image must be fresh both times.
    (set! loaded (image-install im))
    (assert-eq (image-run! im loaded) expected)
    ;; Retain exactly the same text and installation identity across fresh realm instances.
    (assert-eq (image-run! im loaded) expected)
    (image-uninstall! loaded)
    (set! loaded (image-install im))
    (assert-eq (image-run! im loaded) expected)
    (image-uninstall! loaded)
    (image-free! im)
    (al-free! (mut sources))
    0))

(deftest memory-function-entry
         (image-test-source! "function main() { return 42; }" false 42))

(deftest fixed_literal_backing_preserves_order_duplicates_prototype_and_gc
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
         (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
         (image-test-source! "var effects = 0;
     function value(n) { effects = effects * 10 + n; return {n: n}; }
     var proto = {inherited: 42};
     var o = {a: value(1), __proto__: proto, b: value(2), a: value(3), c: value(4)};
     if (effects !== 1234 || o.a.n !== 3 || o.b.n !== 2 || o.c.n !== 4) throw 1;
     if (Object.getPrototypeOf(o) !== proto || o.inherited !== 42) throw 2;
     var keys = Object.keys(o);
     if (keys.length !== 3 || keys[0] !== 'a' || keys[1] !== 'b' || keys[2] !== 'c') throw 3;
     var again = {a: value(5), b: value(6)};
     if (again === o || again.a === o.a || o.a.n !== 3 || again.b.n !== 6) throw 4;
     var ignored = {a: 1, __proto__: 7, b: 2};
     if (Object.getPrototypeOf(ignored) !== Object.prototype || ignored.b !== 2) throw 5;"
                             true
                             0))

(deftest fixed_literal_backing_stops_on_abrupt_completion
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
         (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
         (image-test-source! "var effects = 0; var result = 17;
     function value(n) { effects = effects * 10 + n; return {n: n}; }
     function fail() { effects = effects * 10 + 2; throw 91; }
     var caught = 0;
     try { result = {a: value(1), b: fail(), c: value(3)}; }
     catch (e) { if (e !== 91) throw 1; caught = 1; }
     if (effects !== 12 || result !== 17 || caught !== 1) throw 2;"
                             true
                             0))

(deftest source_program_owns_provider_leases_and_runs_ordered_repeated_selections_in_fresh_realms
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
         (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
         (let [cache (primitive/alloc-stack SourceCache)
               (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
               (mut selections)
                 (al-new [SourceScriptSelection] (alloc/malloc-allocator))
               before (rt-code-count)]
           (set! cache (source-cache-new 2))
           (push! [(slice u8)] (mut sources) "var state = {answer:0};")
           (push! [(slice u8)] (mut sources) "state.answer++;")
           (let [harness (source-cache-acquire! cache (load sources) 1)]
             (al-clear! (mut sources))
             (push! [(slice u8)]
                    (mut sources)
                    "if (state.answer !== 2) throw 7;")
             (let [test (source-cache-acquire! cache (load sources) 1)]
               (push! [SourceScriptSelection]
                      (mut selections)
                      (SourceScriptSelection :handle harness :script 0))
               (push! [SourceScriptSelection]
                      (mut selections)
                      (SourceScriptSelection :handle harness :script 1))
               (push! [SourceScriptSelection]
                      (mut selections)
                      (SourceScriptSelection :handle harness :script 1))
               (push! [SourceScriptSelection]
                      (mut selections)
                      (SourceScriptSelection :handle test :script 0))
               (let [first (source-program-new cache (load selections) 1)
                     second (source-program-new cache (load selections) 1)]
                 (assert-eq (.host first) (.host second))
                 (assert-eq (.host-hits cache) 1)
                 (assert-eq (.host-misses cache) 1)
                 (assert-eq (.installations (.host first)) 2)
                 (assert-eq (len (.providers first)) 2)
                 (assert-eq (.leases (source-cache-entry! cache harness)) 3)
                 (source-cache-release! cache harness)
                 (source-cache-release! cache test)
                 (al-free! (mut sources))
                 (al-free! (mut selections))
                 (compiler-session-reset!)
                 (jsl-library-clear!)
                 (assert-eq (source-program-run! first) 0)
                 (assert-eq (source-program-run! first) 0)
                 (source-program-free! first)
                 (assert-eq (.leases (source-cache-entry! cache harness)) 1)
                 (assert-eq (source-program-run! second) 0)
                 (source-program-free! second)
                 (assert-eq (.leases (source-cache-entry! cache harness)) 0)
                 (assert-eq (.installations (.image (source-cache-entry! cache
                                                                         harness)))
                            0))))
           (source-cache-free! cache)
           (assert-eq (rt-code-count) before)))

(deftest source_program_accepts_empty_execution_and_preserves_uncaught_status
         (let [cache (primitive/alloc-stack SourceCache)
               (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
               (mut selections)
                 (al-new [SourceScriptSelection] (alloc/malloc-allocator))]
           (set! cache (source-cache-new 1))
           (let [empty (source-program-new cache (load selections) 1)]
             (assert-eq (source-program-run! empty) 0)
             (source-program-free! empty))
           (push! [(slice u8)] (mut sources) "throw {answer:42};")
           (let [handle (source-cache-acquire! cache (load sources) 1)]
             (push! [SourceScriptSelection]
                    (mut selections)
                    (SourceScriptSelection :handle handle :script 0))
             (let [program (source-program-new cache (load selections) 1)]
               (source-cache-release! cache handle)
               (assert-eq (source-program-run! program) 3)
               (assert-eq (source-program-run! program) 3)
               (source-program-free! program)))
           (source-cache-free! cache)
           (al-free! (mut sources))
           (al-free! (mut selections))))

(defn image-test-program-refuses! [(cache (ptr SourceCache))
                                   (selections (ArrayList SourceScriptSelection))] (-> i64)
  (let [pid (os/fork)
        status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (do (source-program-new cache selections 1) (os/_exit 0) 0)
        (do
          (assert-eq (os/waitpid pid status 0) pid)
          (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
          (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8)
                     EXIT-PANIC)
          0))))

(deftest source_program_rejects_invalid_selections_and_mixed_dependency_snapshots
         (let [cache (primitive/alloc-stack SourceCache)
               (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
               (mut selections)
                 (al-new [SourceScriptSelection] (alloc/malloc-allocator))]
           (set! cache (source-cache-new 2))
           (push! [(slice u8)] (mut sources) "var answer = 42;")
           (let [first (source-cache-acquire! cache (load sources) 1)
                 second (source-cache-acquire! cache (load sources) 2)]
             (push! [SourceScriptSelection]
                    (mut selections)
                    (SourceScriptSelection :handle first :script -1))
             (image-test-program-refuses! cache (load selections))
             (al-clear! (mut selections))
             (push! [SourceScriptSelection]
                    (mut selections)
                    (SourceScriptSelection :handle first :script 1))
             (image-test-program-refuses! cache (load selections))
             (al-clear! (mut selections))
             (push! [SourceScriptSelection]
                    (mut selections)
                    (SourceScriptSelection :handle first :script 0))
             (push! [SourceScriptSelection]
                    (mut selections)
                    (SourceScriptSelection :handle second :script 0))
             (let [entry (source-cache-entry! cache second)
                   bytes (get (.library entry) 3)
                   first-byte (primitive/index (alloc/alloc-slice-data bytes) 0)]
               (set! first-byte
                     (primitive/cast u8
                                     (if (= (load first-byte)
                                            (primitive/cast u8 32))
                                         33
                                         32))))
             (image-test-program-refuses! cache (load selections))
             (assert-eq (.leases (source-cache-entry! cache first)) 1)
             (source-cache-release! cache first)
             (source-cache-release! cache second))
           (source-cache-free! cache)
           (al-free! (mut sources))
           (al-free! (mut selections))))

(defn image-test-cached-script-run! [(im (ptr CodeImage))] (-> i64)
  (let [provider (primitive/alloc-stack InstalledImage)
        host (primitive/alloc-stack CodeImage)
        loaded (primitive/alloc-stack InstalledImage)
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
    (set! provider (image-install-bound im (test-library-bindings im)))
    (push! [ImageBinding]
           (mut bindings)
           (image-script-initializer-binding im provider 0 "cache::initialize"))
    (set! host (pipeline-script-sequence-image (load bindings) 1))
    (compiler-session-reset!)
    (set! loaded (image-install-bound host (load bindings)))
    (test-push-host! (mut units) loaded)
    (push! [(ptr InstalledImage)] (mut units) provider)
    (assert-eq (image-run-shared-program! loaded (load units)) 0)
    (assert-eq (image-run-shared-program! loaded (load units)) 0)
    (image-uninstall! loaded)
    (image-free! host)
    (image-uninstall! provider)
    (al-free! (mut bindings))
    (al-free! (mut units))
    0))

(defn image-test-independent-script-list! [(scripts (ArrayList (slice u8)))] (-> i64)
  (let [cache (primitive/alloc-stack SourceCache)
        (mut source) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut selections)
          (al-new [SourceScriptSelection] (alloc/malloc-allocator))
        (mut seed) 1]
    (set! cache (source-cache-new (len scripts)))
    (al-for [script scripts]
            (al-clear! (mut source))
            (push! [(slice u8)] (mut source) script)
            (let [handle (source-cache-acquire! cache (load source) (load seed))]
              (push! [SourceScriptSelection]
                     (mut selections)
                     (SourceScriptSelection :handle handle :script 0)))
            (set! (mut seed) (+ (load seed) 16)))
    (let [program (source-program-new cache (load selections) 1)]
      (al-for [selection (load selections)]
              (let [s selection] (source-cache-release! cache (.handle s))))
      (assert-eq (source-program-run! program) 0)
      (assert-eq (source-program-run! program) 0)
      (source-program-free! program))
    (source-cache-free! cache)
    (al-free! (mut source))
    (al-free! (mut selections))
    0))

(defn image-test-independent-scripts! [(first (slice u8)) (second (slice u8))] (-> i64)
  (let [(mut scripts) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut scripts) first)
    (push! [(slice u8)] (mut scripts) second)
    (image-test-independent-script-list! (load scripts))
    (al-free! (mut scripts))
    0))

