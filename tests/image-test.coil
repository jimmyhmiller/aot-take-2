(deftest shared_jsl_snapshots_are_exact_and_unused_providers_are_bounded
         (let [a (alloc/malloc-allocator)
               cache (primitive/alloc-stack SourceCache)
               (mut source) (al-new [(slice u8)] a)]
           (set! cache (source-cache-new 1))
           (push! [(slice u8)] (mut source) "var x = 1;")
           (let [first (source-cache-acquire! cache (load source) 1)]
             (source-cache-release! cache first))
           (al-clear! (mut source))
           (push! [(slice u8)] (mut source) "var x = 2;")
           (let [second (source-cache-acquire! cache (load source) 1)]
             (source-cache-release! cache second))
           (assert-eq (.library-misses cache) 1)
           (assert-eq (.library-hits cache) 1)
           ;; Simulate an old dependency snapshot without editing production JSL on disk.
           (let [library (get (.libraries cache) 0)
                 bytes (get (.library library) 3)
                 first-byte (primitive/index (alloc/alloc-slice-data bytes) 0)]
             (set! first-byte
                   (primitive/cast u8
                                   (if (= (load first-byte)
                                          (primitive/cast u8 32))
                                       33
                                       32))))
           (al-clear! (mut source))
           (push! [(slice u8)] (mut source) "var x = 3;")
           (let [third (source-cache-acquire! cache (load source) 1)]
             (source-cache-release! cache third))
           (assert-eq (.library-misses cache) 2)
           (let [fourth (source-cache-acquire! cache (load source) 2)]
             (source-cache-release! cache fourth))
           (assert-eq (.library-misses cache) 3)
           (assert-eq (len (.libraries cache)) 2)
           (source-cache-free! cache)
           (al-free! (mut source))))

(deftest shared_jsl_provider_is_compiled_once_and_rebound_to_fresh_realms
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
         (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
         (let [a (alloc/malloc-allocator)
               cache (primitive/alloc-stack SourceCache)
               (mut source) (al-new [(slice u8)] a)
               (mut selections) (al-new [SourceScriptSelection] a)]
           (set! cache (source-cache-new 2))
           (push! [(slice u8)]
                  (mut source)
                  "function read(o) { return o.x; } function write(o,v) { o.x = v; }
       var effects = 0; var o = {};
       Object.defineProperty(o, 'x', {get: function() { return this.y; },
         set: function(v) { effects += 1; this.y = v; }});")
           (let [first (source-cache-acquire! cache (load source) 1)]
             (al-clear! (mut source))
             (push! [(slice u8)]
                    (mut source)
                    "write(o, 42); if (read(o) !== 42 || effects !== 1) throw 1;
         var caught = 0; try { read(null); } catch (e) {
           if (Object.getPrototypeOf(e) !== TypeError.prototype) throw 2; caught = 1;
         } if (caught !== 1) throw 3;
         function primitiveValue(x) { return x.valueOf(); }
         if (primitiveValue('str') !== 'str') throw 4;
         if (primitiveValue(101) !== 101) throw 5;
         if (primitiveValue(true) !== true) throw 6;
         var method = 'pu' + 'sh'; var list = []; list[method](5);
         if (list.length !== 1 || list[0] !== 5) throw 7;")
             (let [second (source-cache-acquire! cache (load source) 1)]
               (assert-eq (.library-misses cache) 1)
               (assert-eq (.library-hits cache) 1)
               ;; The provider carries the declared surface, methods no client spells included; clients
               ;; carry no method of their own and reach the canonical ones through the runtime.
               (al-for [library (.libraries cache)]
                       (let [(mut push) false
                             (mut hypot) false]
                         (al-for [object (.realm-objects (.image library))]
                                 (let [o object]
                                   (if (= (.name o) "Array.prototype.push")
                                       (set! (mut push) true)
                                       0)
                                   (if (= (.name o) "Math.hypot")
                                       (set! (mut hypot) true)
                                       0)))
                         (assert (load push))
                         (assert (load hypot))))
               (al-for [entry (.entries cache)]
                       (al-for [object (.realm-objects (.image entry))]
                               ;; A method identity is `Owner.key` or `Owner.prototype.key`: a callable one with a dot
                               ;; would be a client-compiled method.
                               (let [o object
                                     (mut dotted) false]
                                 (al-for [b (.name o)]
                                         (if (= b (primitive/cast u8 46))
                                             (set! (mut dotted) true)
                                             0))
                                 (assert (not (and (= (.kind o)
                                                      IMAGE-REALM-INTRINSIC)
                                                   (.callable o)
                                                   (load dotted)))))))
               (al-for [library (.libraries cache)]
                       (let [(mut exports) 0]
                         (al-for [symbol (.symbols (.image library))]
                                 (let [s symbol]
                                   (if (and (= (.segment s) IMAGE-SYM-TEXT)
                                            (or (= (.name s) "JsGetNamed")
                                                (= (.name s) "JsDefineOwnNamed")))
                                       (do
                                         (assert (> (len (.abi s)) 0))
                                         (set! (mut exports)
                                               (+ (load exports) 1)))
                                       0)))
                         (assert-eq (load exports) 2)))
               (al-for [entry (.entries cache)]
                       (al-for [symbol (.symbols (.image entry))]
                               (let [s symbol]
                                 (if (or (= (.name s) "JsGetNamed")
                                         (= (.name s) "JsDefineOwnNamed"))
                                     (do
                                       (assert-eq (.segment s) IMAGE-SYM-IMPORT)
                                       (assert (> (len (.abi s)) 0)))
                                     0))))
               (push! [SourceScriptSelection]
                      (mut selections)
                      (SourceScriptSelection :handle first :script 0))
               (push! [SourceScriptSelection]
                      (mut selections)
                      (SourceScriptSelection :handle second :script 0))
               (let [program (source-program-new cache (load selections) 1)]
                 (source-cache-release! cache first)
                 (source-cache-release! cache second)
                 (assert-eq (source-program-run! program) 0)
                 (assert-eq (source-program-run! program) 0)
                 (source-program-free! program))))
           (source-cache-free! cache)
           (al-free! (mut source))
           (al-free! (mut selections))))

