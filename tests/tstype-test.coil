;;
;; Empty on purpose, and it must STAY named here so the gap is visible in `coil test --list`
;; rather than being absent. A suite that does not exist cannot be noticed as missing.
;;
;; See docs/LAYOUT.md for what this area owns and which build step fills it in.
(module aot.tests.tstype)
(import "coil.assert" :use *)

(deftest tstype_suite_is_a_placeholder
         ;; Deliberately trivial. When the first real test lands here, DELETE this one — a placeholder
         ;; left beside real tests inflates the count and makes coverage look better than it is.
         (assert true))
