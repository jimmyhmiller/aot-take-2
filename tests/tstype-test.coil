;; Primitive and union annotations are evidence, not executable representation assertions.
(module aot.tests.tstype)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.parse.lexer" :use *)
(import "aot.parse.tstype" :use *)
(import "aot.parse.parser" :use *)
(import "aot.type.type" :use *)
(import "aot.node.node" :use *)
(import "aot.node.call" :use *)

(deftest primitive_unions_use_the_existing_dynamic_tag_lattice
         (boot! 1)
         (lex-init! "number | (string | null) | undefined")
         (assert-eq (tstype-parse) (ty-dyn (+ (+ TAG-NUMBER TAG-STRING) (+ TAG-NULL TAG-UNDEFINED))))
         (let [end (lex-next! false)] (assert-eq (.kind end) TOK-EOF))
         (lex-init! "boolean | never")
         (assert-eq (tstype-parse) (ty-dyn TAG-BOOL))
         (lex-init! "unknown | number")
         (assert (not (tstype-informative? (tstype-parse))))
         (lex-init! "void")
         (assert (not (tstype-informative? (tstype-parse)))))

(deftest frontend_retains_annotations_without_narrowing_runtime_evidence
         (boot! 1)
         (parse-program
           "function choose(x: number | undefined): string { let y: boolean = x; return y; }
            function main() { return choose(42); }")
         (let [f (syntax-fun-at 0)
               binding (syntax-stmt-at (get (.body f) 0))]
           (assert-eq (get (.param-annotations f) 0) (ty-dyn (+ TAG-NUMBER TAG-UNDEFINED)))
           (assert-eq (.return-annotation f) (ty-dyn TAG-STRING))
           (match (.node binding)
             (SsLet [name init final annotation] (assert-eq annotation (ty-dyn TAG-BOOL)))
             (_ (assert false)))
           (match (fun-parm (parser-node (.fun-nid f)) 0)
             (Some [parm] (assert-eq (n-ty parm) (ty-dyn TAG-ANY)))
             (None [] (assert false)))))
