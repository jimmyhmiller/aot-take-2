;; Callable specialization stays a call, shares compatible entries, and preserves fallback.

(module aot.tests.versions)
(import "coil.assert" :use *)
(import "coil.arraylist" :use *)
(import "aot.util.arena" :use [compiler-allocator])
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.call" :use *)
(import "aot.node.control" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.versions" :use *)
(import "aot.type.type" :use *)
(import "aot.verify" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.perfunction" :use *)

(defn versions-test-fun [(st (dyn NodeOps))] (-> (dyn NodeOps))
  (let [t (ty-dyn TAG-ANY)
        f (fun-make st (ty-tuple-of2 t t) "identity_noInline")
        p (parm-make f 0 t "x")
        ret (return-make f (None [(dyn NodeOps)]) p (None [(dyn NodeOps)]) (Some f))]
    (fun-set-ret! f ret)
    (n-keep! ret)
    f))

(defn versions-test-declared-fun [(st (dyn NodeOps))] (-> (dyn NodeOps))
  (let [t (ty-dyn TAG-ANY)
        f (fun-make st (ty-tuple-of2 t t) "declared-contract")
        p (parm-make f 0 t "x")
        ret (return-make f (None [(dyn NodeOps)]) p (None [(dyn NodeOps)]) (Some f))]
    (fun-set-ret! f ret)
    (n-keep! ret)
    f))

(defn versions-test-declare-integer! [(f (dyn NodeOps))] (-> (dyn NodeOps))
  (let [(mut contract) (al-new [i64] (compiler-allocator))]
    (push! [i64] (mut contract) (ty-dyn TAG-INT))
    (assert-eq (versions-create-primary-unrouted! f (load contract)) 1)
    (let [version (get (.items (function-versions)) 0)]
      (match (arena-node (.entry version))
        (Some [entry] entry)
        (None [] (unreachable-node))))))

(defn versions-test-call [(st (dyn NodeOps)) (f (dyn NodeOps)) (t i64)] (-> (dyn NodeOps))
  (let [c (call-make (cproj-make st 0 "ctrl"))]
    (call-add-arg! c (con-make t))
    (call-set-fptr! c (funptr-make f 41))
    (let [end (callend-make c)]
      (call-link! c f)
      (n-keep! end)
      end)))

(defn versions-test-admit! [(end (dyn NodeOps))] (-> i64)
  (let [requested (versions-try! end)]
    (if (> (.pending (function-versions)) 0)
        (do (iter-peeps!) (versions-finish-trial!) (iter-peeps!) 0)
        0)
    requested))

(defn versions-test-reuse [(seed i64)] (-> i64)
  (boot! seed)
  (let [st (start-make (ty-int-bot))
        f (versions-test-fun st)
        a (versions-test-call st f (ty-dyn-with-int TAG-INT (ty-int-con 3)))
        b (versions-test-call st f (ty-dyn-with-int TAG-INT (ty-int-con 9)))
        text (versions-test-call st f (ty-dyn TAG-STRING))
        other (versions-test-call st f (ty-dyn TAG-OBJECT))]
    (assert-eq (versions-test-admit! a) 1)
    (let [entry (n-in! (call-fptr (cend-call a)) 0)]
      (assert (not (n-same? entry f)))
      (assert (fun-version-entry? entry))
      (assert-eq (versions-test-admit! b) 1)
      (assert (n-same? entry (n-in! (call-fptr (cend-call b)) 0)))
      (assert-eq (versions-count (n-nid f)) 1)
      (match (fun-parm entry 0)
        (Some [p] (assert-eq (compute p) (ty-dyn TAG-INT)))
        (None [] (assert false)))
      (assert-eq (callend-inline-candidate a) INLINE-NEVER))
    (assert-eq (versions-test-admit! text) 1)
    (assert-eq (versions-count (n-nid f)) 2)
    (assert-eq (versions-test-admit! other) 0)
    (assert (call-linked? (cend-call other) f))
    (fun-drop-unknown-callers! f)
    (assert (not (fun-unknown-callers? f)))
    (assert-eq (verify-all) VERR-OK))
  0)

(deftest callable_versions_reuse_contract_and_preserve_generic_fallback
         (versions-test-reuse 1)
         (versions-test-reuse 7)
         (versions-test-reuse 97))

(deftest primary_contract_selection_groups_proven_sites_before_local_optimization
         (boot! 101)
         (let [st (start-make (ty-int-bot))
               f (versions-test-fun st)
               a (versions-test-call st f (ty-dyn-with-int TAG-INT (ty-int-con 3)))
               b (versions-test-call st f (ty-dyn-with-int TAG-INT (ty-int-con 9)))
               text (versions-test-call st f (ty-dyn TAG-STRING))
               fallback (versions-test-call st f (ty-dyn TAG-OBJECT))]
           (assert-eq (versions-select-primary!) 3)
           (assert-eq (versions-count (n-nid f)) 2)
           (let [integer-entry (n-in! (call-fptr (cend-call a)) 0)]
             (assert (n-same? integer-entry
                              (n-in! (call-fptr (cend-call b)) 0)))
             (assert (not (n-same? integer-entry f)))
             ;; A primary body is copied after global SCCP, so its node types still carry the
             ;; source body's broad meet. The local plan must preserve the admitted interface,
             ;; not reconstruct it from that stale copy.
             (let [plan (per-function-plan)
                   (mut i) 0
                   (mut found) false]
               (loop (if (>= (load i) (per-function-entry-count plan))
                         (break 0)
                         (let [entry (per-function-entry-at plan (load i))]
                           (if (= (per-function-entry-fun entry)
                                  (n-nid integer-entry))
                               (do
                                 (assert-eq (per-function-contract-at entry 1)
                                            (ty-dyn TAG-INT))
                                 (set! (mut found) true))
                               0)
                           (set! (mut i) (+ (load i) 1))
                           (continue))))
               (assert (load found))
               (per-function-plan-free! plan)))
           (assert (not (n-same? (n-in! (call-fptr (cend-call text)) 0) f)))
           (assert (call-linked? (cend-call fallback) f))
           ;; Selection closes before any local body runs; later sites cannot widen or append an
           ;; entry behind the fixed interface.
           (assert-eq (versions-test-admit! fallback) 0)
           ;; Local simplification may strengthen a surviving generic site's evidence. Admission
           ;; stays closed, but that site can reuse the exact interface selected above.
           (n-set-def! (cend-call fallback)
                       CALL-ARG0
                       (Some (con-make (ty-dyn TAG-INT))))
           (code-work-scope-begin!)
           (code-work-scope-allow! (n-nid fallback))
           (assert-eq (versions-reroute-closed-round!) 1)
           (code-work-scope-end!)
           (assert (n-same? (n-in! (call-fptr (cend-call fallback)) 0)
                            (n-in! (call-fptr (cend-call a)) 0)))
           (assert-eq (versions-count (n-nid f)) 2)
           (assert-eq (verify-all) VERR-OK)))

(deftest jsl_uses_the_same_callable_version_contracts
         (boot! 13)
         (let [st (start-make (ty-int-bot))
               f (versions-test-fun st)
               number (versions-test-call st f (ty-dyn TAG-INT))
               text (versions-test-call st f (ty-dyn TAG-STRING))]
           (fun-set-jsl! f)
           (assert-eq (versions-test-admit! number) 1)
           (assert (fun-jsl? (n-in! (call-fptr (cend-call number)) 0)))
           (assert-eq (n-op number) OP-CALLEND)
           (assert (call-linked? (cend-call text) f))))

(deftest a_failed_declared_contract_hypothesis_rolls_back_once
         (boot! 137)
         (let [st (start-make (ty-int-bot))
               f (versions-test-declared-fun st)
               end (versions-test-call st f (ty-dyn TAG-NUMBER))
               c (cend-call end)
               entry (versions-test-declare-integer! f)]
           (assert (> (versions-close-admission!) 0))
           (code-work-scope-begin!)
           (code-work-scope-allow! (n-nid end))
           (assert-eq (versions-reroute-closed-round!) 1)
           (assert (call-linked? c entry))
           ;; No new evidence appeared during the complete solve, so settlement restores the
           ;; exact generic edge and remembers this pair instead of oscillating.
           (assert-eq (versions-reroute-closed-round!) 1)
           (assert (call-linked? c f))
           (assert (not (callend-never-inline? end)))
           (assert-eq (len (.rejected-calls (function-versions))) 1)
           (assert-eq (versions-reroute-closed-round!) 0)
           (assert (call-linked? c f))
           (assert-eq (len (.rejected-calls (function-versions))) 1)
           (code-work-scope-end!)
           (assert-eq (verify-all) VERR-OK)))

(deftest a_shared_body_already_precise_for_its_callers_needs_no_version
         (boot! 2)
         (let [st (start-make (ty-int-bot))
               f (versions-test-fun st)
               a (versions-test-call st f (ty-dyn TAG-INT))]
           (fun-drop-unknown-callers! f)
           (assert-eq (versions-test-admit! a) 0)
           (assert (call-linked? (cend-call a) f))))

(deftest unknown_external_callers_keep_the_generic_domain_broad
         (boot! 2)
         (let [st (start-make (ty-int-bot))
               f (versions-test-fun st)
               a (versions-test-call st f (ty-dyn TAG-INT))]
           ;; The known callers all pass integers, but the retained unknown-caller hook means
           ;; the generic entry cannot narrow to them. A private entry can still use that proof.
           (assert-eq (versions-test-admit! a) 1)
           (assert (fun-unknown-callers? f))
           (assert (not (call-linked? (cend-call a) f)))
           (assert-eq (versions-count (n-nid f)) 1)
           (assert-eq (verify-all) VERR-OK)))

(deftest a_closed_body_copy_keeps_its_proven_integer_bound
         (boot! 9)
         (let [st (start-make (ty-int-bot))
               f (versions-test-fun st)
               integer (ty-dyn-with-int TAG-INT (ty-int-con 3))
               a (versions-test-call st f integer)
               text (versions-test-call st f (ty-dyn TAG-STRING))]
           (fun-drop-unknown-callers! f)
           (match (fun-parm f 0)
             (Some [p] (n-set-ty! p (compute p)))
             (None [] (assert false)))
           (assert-eq (versions-test-admit! a) 1)
           (let [entry (n-in! (call-fptr (cend-call a)) 0)]
             (match (fun-parm entry 0)
               (Some [p] (assert-eq (compute p) integer))
               (None [] (assert false))))
           (assert (call-linked? (cend-call text) f))
           (assert (> (versions-close-admission!) 0))
           (assert-eq (versions-test-admit! text) 0)))

(deftest recursive_versions_preserve_generic_identity_until_contract_is_proved
         (boot! 7)
         (let [st (start-make (ty-int-bot))
               t (ty-dyn TAG-ANY)
               f (fun-make st (ty-tuple-of2 t t) "recursive_noInline")
               p (parm-make f 0 t "x")
               self (call-make f)]
           (call-add-arg! self p)
           (call-set-fptr! self (funptr-make f 41))
           (let [self-end (callend-make self)
                 ret
                   (return-make (cproj-make self-end RETURN-CTRL "ctrl")
                                (None [(dyn NodeOps)])
                                p
                                (None [(dyn NodeOps)])
                                (Some f))]
             (fun-set-ret! f ret)
             (n-keep! ret)
             (call-link! self f)
             (let [outer (versions-test-call st f (ty-dyn TAG-INT))]
               (assert-eq (versions-test-admit! outer) 1)
               (let [entry (n-in! (call-fptr (cend-call outer)) 0)
                     fresh-ret (match (fun-ret entry) (Some [r] r) (None [] (unreachable-node)))
                     fresh-end (n-in! (n-in! fresh-ret RETURN-CTRL) 0)
                     fresh-call (cend-call fresh-end)]
                 (assert (call-linked? fresh-call f))
                 (assert (not (call-linked? fresh-call entry)))
                 (assert (n-same? (n-in! (call-fptr fresh-call) 0) f))
                 (match (fun-parm entry 0)
                   (Some [arg] (n-set-ty! arg (compute arg)))
                   (None [] (assert false)))
                 (assert-eq (versions-test-admit! fresh-end) 1)
                 (assert (call-linked? fresh-call entry))
                 (assert-eq (versions-count (n-nid f)) 1)
                 (assert (call-linked? self f))
                 (assert-eq (verify-all) VERR-OK))))))

(deftest per_function_limits_and_compilation_reset_are_independent_of_inlining
         (boot! 3)
         (versions-set-limit! "*" 0)
         (versions-set-limit! "identity_noInline" 1)
         (let [st (start-make (ty-int-bot))
               f (versions-test-fun st)
               a (versions-test-call st f (ty-dyn TAG-INT))
               b (versions-test-call st f (ty-dyn TAG-STRING))]
           (assert-eq (versions-test-admit! a) 1)
           (assert-eq (versions-test-admit! b) 0))
         (boot! 4)
         (let [st (start-make (ty-int-bot))
               f (versions-test-fun st)]
           (assert-eq (versions-limit f) VERSION-DEFAULT-LIMIT)
           (assert-eq (versions-count (n-nid f)) 0)))

(deftest rejected_trials_leave_callers_unchanged_and_are_not_rebuilt
         (boot! 17)
         (let [st (start-make (ty-int-bot))
               t (ty-dyn TAG-ANY)
               sig (ty-tuple-of2 (ty-int-con 42) t)
               f (fun-make st sig "effect_noInline")
               p (parm-make f 0 t "value")
               target (arena-declare-external! 99 "test.effect" sig)
               effect (call-make-with-mem f (con-make (ty-mem 1 TY-BOT)))]
           (call-add-arg! effect p)
           (call-set-fptr! effect (external-make target))
           (let [end (callend-make effect)
                 ret
                   (return-make (cproj-make end RETURN-CTRL "ctrl")
                                (Some (proj-make end RETURN-MEM "memory"))
                                (con-int 42)
                                (None [(dyn NodeOps)])
                                (Some f))]
             (fun-set-ret! f ret)
             (n-keep! ret)
             (let [number (versions-test-call st f (ty-dyn TAG-INT))
                   text (versions-test-call st f (ty-dyn TAG-STRING))]
               (assert-eq (versions-test-admit! number) 1)
               (assert-eq (versions-count (n-nid f)) 0)
               (assert (call-linked? (cend-call number) f))
               (assert (call-linked? (cend-call text) f))
               (let [before (arena-node-count)]
                 (assert-eq (versions-test-admit! number) 0)
                 (assert-eq (arena-node-count) before))
               (assert-eq (verify-all) VERR-OK)))))
