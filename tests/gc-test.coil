;; Safepoints redefine every live managed value through ordinary tuple projections.

(module aot.tests.gc)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.str" :use [sb-new sb-push-str! sb-push-i64! sb-str sb-free!])
(import "coil.os" :as os)
(import "aot.util.panic" :use [EXIT-PANIC])
(import "aot.codegen.image" :use [image-copy])
(import "aot.rt.abi"
        :use
        [RtObjectBinding RT-LEXICAL-INITIALIZED RT-LEXICAL-WRITABLE])
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.gc" :use *)
(import "aot.node.memory" :use *)
(import "aot.codegen.gcmeta" :use *)
(import "aot.type.type" :use *)
(import "aot.shape" :use *)
(import "aot.heap" :use *)
(import "aot.node.dynamic"
        :use
        [DYNAMIC-PREFIX-OBJECT DYNAMIC-NULL-WORD DYNAMIC-UNDEFINED-WORD])
(import "coil.slice" :use [slice-data])
(import "aot.verify" :use *)
(import "aot.rt.rt" :use *)
(import "aot.rt.shapes"
        :use
        [shapes-boot!
         shapes-lookup-attrs
         shapes-lookup-offset
         shapes-intern-key])

(defn gc-test-string2 [(a i64) (b i64)] (-> i64)
  (let [string (rt-alloc 12 SHAPE-STRING 0 0)]
    (set! (primitive/cast (ptr i64) string) 2)
    (rt-string-set-code-unit! string 0 a)
    (rt-string-set-code-unit! string 1 b)
    string))

(deftest realm_lexical_slots_preserve_initialization_and_identity_through_table_growth
         (rt-heap-reset! 1024)
         (shapes-boot! (primitive/cast (ptr u8) 0) 0)
         (let [key (shapes-intern-key "kept")
               slot (rt-global-lexical-create! key true)
               (mut name) (sb-new (alloc/malloc-allocator))
               (mut i) 0]
           (assert-eq slot 1)
           (assert-eq (rt-global-lexical-state slot) RT-LEXICAL-WRITABLE)
           (rt-global-lexical-initialize! slot RT-DYNAMIC-UNDEFINED-WORD)
           (assert-eq (rt-global-lexical-state slot)
                      (| RT-LEXICAL-INITIALIZED RT-LEXICAL-WRITABLE))
           (loop (if (= (load i) 1024)
                     (break 0)
                     (do
                       (al-clear! (mut (.bytes (mut name))))
                       (sb-push-str! (mut name) "binding")
                       (sb-push-i64! (mut name) (load i))
                       (let [next-key (shapes-intern-key (sb-str (load name)))
                             next-slot
                               (rt-global-lexical-create! next-key false)]
                         (assert-eq next-slot (+ (load i) 2))
                         (assert-eq (rt-global-lexical-state next-slot) 0)
                         (rt-global-lexical-initialize! next-slot
                                                        RT-DYNAMIC-NULL-WORD))
                       (set! (mut i) (+ (load i) 1))
                       (continue))))
           (set! (mut i) 0)
           (loop (if (= (load i) 1024)
                     (break 0)
                     (do
                       (al-clear! (mut (.bytes (mut name))))
                       (sb-push-str! (mut name) "binding")
                       (sb-push-i64! (mut name) (load i))
                       (let [found
                               (rt-global-lexical-find (shapes-intern-key (sb-str (load name))))]
                         (assert-eq found (+ (load i) 2))
                         (assert-eq (rt-global-lexical-state found)
                                    RT-LEXICAL-INITIALIZED)
                         (assert-eq (rt-global-lexical-value found)
                                    RT-DYNAMIC-NULL-WORD))
                       (set! (mut i) (+ (load i) 1))
                       (continue))))
           (assert-eq (rt-global-lexical-find key) slot)
           (assert-eq (rt-global-lexical-value slot) RT-DYNAMIC-UNDEFINED-WORD)
           (rt-global-lexical-store! slot RT-DYNAMIC-NULL-WORD)
           (assert-eq (rt-global-lexical-value slot) RT-DYNAMIC-NULL-WORD)
           (assert-eq (rt-global-lexical-find (shapes-intern-key "absent")) 0)
           (sb-free! (mut name))
           (rt-heap-reset! 1024)
           (assert-eq (rt-global-lexical-find key) 0)
           (let [fresh (rt-global-lexical-create! key false)]
             (assert-eq fresh 1)
             (assert-eq (rt-global-lexical-state fresh) 0))
           (rt-realm-destroy!)))

(deftest realm_lexical_values_are_roots_across_minor_promotion_major_and_replacement
         (rt-heap-reset-generational! 256 2048)
         (shapes-boot! (primitive/cast (ptr u8) 0) 0)
         (let [slot (rt-global-lexical-create! (shapes-intern-key "text") true)
               root (primitive/alloc-stack i64)
               original (gc-test-string2 65 66)]
           (set! root 0)
           (rt-global-lexical-initialize! slot (rt-box-string original))
           ;; The lexical cell is the only root for this string.
           (rt-verify-heap! "lexical before minor")
           (rt-collect-one-root! root)
           (assert (!= (& (rt-global-lexical-value slot)
                          RT-DYNAMIC-PAYLOAD-MASK)
                       original))
           (rt-collect-one-root! root)
           (set! (.force-major (rt-heap)) true)
           (rt-collect-one-root! root)
           (rt-verify-heap! "lexical after major")
           (let [payload
                   (& (rt-global-lexical-value slot) RT-DYNAMIC-PAYLOAD-MASK)]
             (assert-eq (rt-string-code-unit payload 0) 65)
             (assert-eq (rt-string-code-unit payload 1) 66))
           ;; A post-promotion write is still an explicit realm root, without a remembered card.
           (rt-global-lexical-store! slot
                                     (rt-box-string (gc-test-string2 67 68)))
           (rt-collect-one-root! root)
           (set! (.force-major (rt-heap)) true)
           (rt-collect-one-root! root)
           (rt-verify-heap! "lexical replacement after major")
           (assert-eq (rt-string-code-unit (& (rt-global-lexical-value slot)
                                              RT-DYNAMIC-PAYLOAD-MASK)
                                           0)
                      67)
           (rt-global-lexical-store! slot RT-DYNAMIC-UNDEFINED-WORD)
           (set! (.force-major (rt-heap)) true)
           (rt-collect-one-root! root)
           (assert-eq (+ (.used (rt-heap)) (.to-used (rt-heap))) 0)
           (rt-realm-destroy!)))

;; First survivors can occupy the entire nursery after a perfectly successful minor collection.
;; Exhaustion must promote them before reporting OOM; the old generation has ample room here.
(deftest nursery_allocation_promotes_a_full_first_survivor_set_before_failing
         (rt-heap-reset-generational! 64 256)
         (shapes-boot! (primitive/cast (ptr u8) 0) 0)
         ;; This test has realm roots but no generated frame, just like property assembly at boot.
         (set! (.assembling-properties (rt-heap)) true)
         (let [a (rt-global-lexical-create! (shapes-intern-key "a") true)
               b (rt-global-lexical-create! (shapes-intern-key "b") true)
               first (rt-alloc 8 RT-SHAPE-ELEMENTS 0 0)]
           (set! (primitive/cast (ptr i64) first) RT-DYNAMIC-UNDEFINED-WORD)
           (rt-global-lexical-initialize! a (rt-box-object first))
           (let [second (rt-alloc 8 RT-SHAPE-ELEMENTS 0 0)]
             (set! (primitive/cast (ptr i64) second) RT-DYNAMIC-NULL-WORD)
             (rt-global-lexical-initialize! b (rt-box-object second)))
           (assert-eq (.used (rt-heap)) 64)
           (let [third (rt-alloc 8 RT-SHAPE-ELEMENTS 0 0)]
             (set! (primitive/cast (ptr i64) third) RT-DYNAMIC-UNDEFINED-WORD)
             (assert-eq (.used (rt-heap)) 32)
             (assert-eq (.to-used (rt-heap)) 64)
             (assert-eq (load (primitive/cast (ptr i64)
                                              (& (rt-global-lexical-value a)
                                                 RT-DYNAMIC-PAYLOAD-MASK)))
                        RT-DYNAMIC-UNDEFINED-WORD)
             (assert-eq (load (primitive/cast (ptr i64)
                                              (& (rt-global-lexical-value b)
                                                 RT-DYNAMIC-PAYLOAD-MASK)))
                        RT-DYNAMIC-NULL-WORD))
           (rt-verify-heap! "full survivor nursery promoted")
           (rt-realm-destroy!)))

(deftest immutable_realm_lexical_roots_trace_cycles_and_transitive_children
         (rt-heap-reset-generational! 256 2048)
         (shapes-boot! (primitive/cast (ptr u8) 0) 0)
         (let [slot
                 (rt-global-lexical-create! (shapes-intern-key "cycle") false)
               root (primitive/alloc-stack i64)
               child (gc-test-string2 69 70)
               parent (rt-alloc 16 RT-SHAPE-ELEMENTS 0 0)]
           (set! root 0)
           (set! (primitive/cast (ptr i64) parent) (rt-box-string child))
           (set! (primitive/index (primitive/cast (ptr i64) parent) 1)
                 (rt-box-object parent))
           (rt-global-lexical-initialize! slot (rt-box-object parent))
           (rt-collect-one-root! root)
           (rt-collect-one-root! root)
           (set! (.force-major (rt-heap)) true)
           (rt-collect-one-root! root)
           (rt-verify-heap! "lexical cycle after major")
           (let [moved
                   (& (rt-global-lexical-value slot) RT-DYNAMIC-PAYLOAD-MASK)
                 child-word (load (primitive/cast (ptr i64) moved))]
             (assert-eq (load (primitive/index (primitive/cast (ptr i64) moved)
                                               1))
                        (rt-box-object moved))
             (assert-eq (rt-string-code-unit (& child-word
                                                RT-DYNAMIC-PAYLOAD-MASK)
                                             1)
                        70))
           (rt-realm-destroy!)))

(const GC-LEXICAL-MISSING 0)

(const GC-LEXICAL-READ-TDZ 1)

(const GC-LEXICAL-WRITE-TDZ 2)

(const GC-LEXICAL-IMMUTABLE 3)

(const GC-LEXICAL-DUPLICATE 4)

(const GC-LEXICAL-REINITIALIZE 5)

(const GC-LEXICAL-KEY 6)

(const GC-LEXICAL-DESTROYED 7)

(defn gc-test-lexical-refuses [(key i64) (slot i64) (mode i64)] (-> i64)
  (let [pid (os/fork)
        status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (do
          (case mode GC-LEXICAL-MISSING
                (rt-global-lexical-value 0) GC-LEXICAL-READ-TDZ
                (rt-global-lexical-value slot) GC-LEXICAL-WRITE-TDZ
                (rt-global-lexical-store! slot RT-DYNAMIC-NULL-WORD)
                  GC-LEXICAL-IMMUTABLE
                (do
                  (rt-global-lexical-initialize! slot RT-DYNAMIC-UNDEFINED-WORD)
                  (rt-global-lexical-store! slot RT-DYNAMIC-NULL-WORD))
                  GC-LEXICAL-DUPLICATE
                (rt-global-lexical-create! key true) GC-LEXICAL-REINITIALIZE
                (do
                  (rt-global-lexical-initialize! slot RT-DYNAMIC-UNDEFINED-WORD)
                  (rt-global-lexical-initialize! slot RT-DYNAMIC-NULL-WORD))
                  GC-LEXICAL-KEY
                (rt-global-lexical-create! 0 true) GC-LEXICAL-DESTROYED
                (do (rt-realm-destroy!) (rt-global-lexical-state slot))
                  (rt-global-lexical-value 0))
          (os/_exit 0)
          0)
        (do
          (assert-eq (os/waitpid pid status 0) pid)
          (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
          (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8)
                     EXIT-PANIC)
          0))))

(deftest realm_lexical_storage_rejects_invalid_lifecycles_before_access
         (rt-heap-reset! 1024)
         (shapes-boot! (primitive/cast (ptr u8) 0) 0)
         (let [key (shapes-intern-key "constant")
               slot (rt-global-lexical-create! key false)
               (mut mode) GC-LEXICAL-MISSING]
           (loop (if (> (load mode) GC-LEXICAL-DESTROYED)
                     (break 0)
                     (do
                       (gc-test-lexical-refuses key slot (load mode))
                       (set! (mut mode) (+ (load mode) 1))
                       (continue))))
           (assert-eq (rt-global-lexical-state slot) 0)
           (rt-global-lexical-initialize! slot RT-DYNAMIC-UNDEFINED-WORD)
           (assert-eq (rt-global-lexical-value slot) RT-DYNAMIC-UNDEFINED-WORD)
           (rt-realm-destroy!)))

(deftest runtime_allocator_owns_headers_shapes_and_zeroed_payloads
         (do
           (rt-heap-reset! 1024)
           (let [payload (rt-alloc 24 37 0 0)
                 bytes (primitive/cast (ptr u8) payload)]
             (assert (!= payload 0))
             (assert-eq (rt-payload-bytes payload) 24)
             (assert-eq (rt-payload-shape payload) 37)
             (assert-eq (primitive/cast i64 (load (primitive/index bytes 0))) 0)
             (assert-eq (primitive/cast i64 (load (primitive/index bytes 12)))
                        0)
             (assert-eq (primitive/cast i64 (load (primitive/index bytes 23)))
                        0)
             (set! (primitive/index bytes 12) (primitive/cast u8 91))
             (assert-eq (primitive/cast i64 (load (primitive/index bytes 12)))
                        91))))

(deftest objects_larger_than_the_nursery_allocate_directly_in_old_space
         (do
           (rt-heap-reset-generational! 64 256)
           (let [payload (rt-alloc 80 37 0 0)]
             (assert (rt-in-old-space? payload))
             (assert-eq (rt-payload-bytes payload) 80)
             (assert-eq (rt-payload-shape payload) 37))))

(deftest moving_runtime_collection_rewrites_roots_and_boxed_object_edges
         (do
           (rt-heap-reset! 256)
           (let [child (rt-alloc 8 2 0 0)
                 parent (rt-alloc 16 3 0 0)
                 parent-words (primitive/cast (ptr i64) parent)
                 root (primitive/alloc-stack i64)]
             (set! (primitive/index parent-words 0)
                   (| (primitive/ishl 0x7fff 48) child))
             (set! root parent)
             (let [before parent
                   live-bytes (rt-collect-one-root! root)
                   moved (load root)]
               (assert (!= moved before))
               (assert-eq live-bytes 72)
               (assert-eq (rt-payload-shape moved) 3)
               (let [boxed-child (load (primitive/cast (ptr i64) moved))
                     moved-child (& boxed-child 0x0000ffffffffffff)]
                 (assert (!= moved-child child))
                 (assert-eq (primitive/ishr boxed-child 48) 0x7fff)
                 (assert-eq (rt-payload-shape moved-child) 2))))))

(deftest moving_runtime_collection_does_not_scan_utf16_string_payload_words
         (do
           (rt-heap-reset! 256)
           (let [coincidental-target (rt-alloc 8 2 0 0)
                 string (rt-alloc 8 SHAPE-STRING 0 0)
                 string-word (primitive/cast (ptr i64) string)
                 root (primitive/alloc-stack i64)
                 boxed-looking-word
                   (| (primitive/ishl 0x7fff 48) coincidental-target)]
             ;; UTF-16 data is arbitrary bits. Even if a packed word looks exactly like a boxed
             ;; object reference, the string layout's no-scan shape must leave it untouched.
             (set! string-word boxed-looking-word)
             (set! root string)
             (assert-eq (rt-collect-one-root! root) 32)
             (assert-eq (rt-payload-shape (load root)) SHAPE-STRING)
             (assert-eq (load (primitive/cast (ptr i64) (load root)))
                        boxed-looking-word))))

(deftest minor_collection_uses_the_old_to_young_remembered_set
         (do
           (rt-heap-reset! 256)
           (let [initial-child (rt-alloc 8 2 0 0)
                 parent (rt-alloc 8 3 0 0)
                 root (primitive/alloc-stack i64)]
             (set! (primitive/cast (ptr i64) parent)
                   (| (primitive/ishl 0x7fff 48) initial-child))
             (set! root parent)
             (rt-collect-one-root! root)
             (rt-collect-one-root! root)
             (let [old-parent (load root)
                   young-child (rt-alloc 8 4 0 0)
                   parent-word (primitive/cast (ptr i64) old-parent)]
               (set! parent-word (| (primitive/ishl 0x7fff 48) young-child))
               (aot-rt-write-barrier old-parent
                                     (load parent-word)
                                     RT-BARRIER-BOXED)
               (rt-collect-one-root! root)
               (let [moved-child (& (load parent-word) 0x0000ffffffffffff)]
                 (assert (!= moved-child young-child))
                 (assert-eq (rt-payload-shape moved-child) 4))))))

(deftest minor_collection_relocates_a_raw_old_to_young_edge
         (do
           (rt-heap-reset! 256)
           (let [parent (rt-alloc 8 3 0 0)
                 root (primitive/alloc-stack i64)]
             (set! root parent)
             (rt-collect-one-root! root)
             (rt-collect-one-root! root)
             (let [old-parent (load root)
                   child (rt-alloc 8 4 0 0)
                   parent-word (primitive/cast (ptr i64) old-parent)]
               (set! parent-word child)
               (aot-rt-write-barrier old-parent child RT-BARRIER-RAW)
               (rt-collect-one-root! root)
               (assert (!= (load parent-word) child))
               (assert-eq (rt-payload-shape (load parent-word)) 4)))))

(deftest promotion_uses_barrier_recorded_raw_layout_information
         (do
           (rt-heap-reset! 256)
           (let [child (rt-alloc 8 4 0 0)
                 parent (rt-alloc 8 3 0 0)
                 root (primitive/alloc-stack i64)]
             (set! (primitive/cast (ptr i64) parent) child)
             (aot-rt-write-barrier parent child RT-BARRIER-RAW)
             (set! root parent)
             (rt-collect-one-root! root)
             (let [moved-parent (load root)
                   moved-child (load (primitive/cast (ptr i64) moved-parent))]
               (assert (!= moved-child child))
               (assert-eq (rt-payload-shape moved-parent) 3)
               (assert-eq (rt-payload-shape moved-child) 4)))))

(deftest repeated_writes_dirty_the_owner_card_across_an_object_boundary
         (do
           (rt-heap-reset-generational! 64 2048)
           (let [padding (rt-heap-allocate-old 480 3)
                 owner (rt-heap-allocate-old 8 4)
                 child (rt-alloc 8 5 0 0)
                 owner-word (primitive/cast (ptr i64) owner)
                 root (primitive/alloc-stack i64)
                 card
                   (/ (- owner (primitive/cast i64 (.to (rt-heap))))
                      RT-CARD-BYTES)]
             padding
             (assert-eq card 1)
             (set! owner-word (| (primitive/ishl 0x7fff 48) child))
             (aot-rt-write-barrier owner (load owner-word) RT-BARRIER-BOXED)
             (aot-rt-write-barrier owner (load owner-word) RT-BARRIER-BOXED)
             (assert-eq (primitive/cast i64
                                        (load (primitive/index (.cards (rt-heap))
                                                               card)))
                        RT-CARD-DIRTY-BOXED)
             (set! root owner)
             (rt-collect-one-root! root)
             ;; The first collection retains the card because the rewritten child is still in the
             ;; survivor nursery. The second promotes that child and can clear the card.
             (assert-eq (primitive/cast i64
                                        (load (primitive/index (.cards (rt-heap))
                                                               card)))
                        RT-CARD-DIRTY-BOXED)
             (rt-collect-one-root! root)
             (assert-eq (primitive/cast i64
                                        (load (primitive/index (.cards (rt-heap))
                                                               card)))
                        0)
             (let [moved-child (& (load owner-word) 0x0000ffffffffffff)]
               (assert (!= moved-child child))
               (assert-eq (rt-payload-shape moved-child) 5)))))

(deftest major_collection_compacts_old_and_young_reachable_objects_together
         (do
           (rt-heap-reset! 128)
           (let [child (rt-alloc 8 2 0 0)
                 parent (rt-alloc 8 3 0 0)
                 root (primitive/alloc-stack i64)]
             (set! (primitive/cast (ptr i64) parent)
                   (| (primitive/ishl 0x7fff 48) child))
             (set! root parent)
             (rt-collect-one-root! root)
             (rt-collect-one-root! root)
             (let [old-parent (load root)]
               (rt-alloc 48 4 0 0)
               (rt-collect-one-root! root)
               (assert (!= (load root) old-parent))
               (let [moved-child
                       (& (load (primitive/cast (ptr i64) (load root)))
                          0x0000ffffffffffff)]
                 (assert-eq (rt-payload-shape (load root)) 3)
                 (assert-eq (rt-payload-shape moved-child) 2))))))

(deftest runtime_string_capabilities_use_utf16_code_unit_semantics
         (do
           (rt-heap-reset! 1024)
           (let [ab (gc-test-string2 65 66)
                 ab-again (gc-test-string2 65 66)
                 ac (gc-test-string2 65 67)
                 astral (gc-test-string2 0xd83d 0xde00)]
             (assert-eq (rt-string-length astral) 2)
             (assert-eq (rt-string-eq ab ab-again) 1)
             (assert-eq (rt-string-eq ab ac) 0)
             (assert-eq (rt-string-compare ab ac) -1)
             (assert-eq (rt-string-compare ac ab) 1)
             (assert-eq (rt-string-compare ab ab-again) 0)
             (let [joined (rt-string-concat ab ac SHAPE-STRING 0 0)]
               (assert-eq (rt-string-length joined) 4)
               (assert-eq (rt-string-code-unit joined 0) 65)
               (assert-eq (rt-string-code-unit joined 1) 66)
               (assert-eq (rt-string-code-unit joined 2) 65)
               (assert-eq (rt-string-code-unit joined 3) 67)))))

(deftest safepoints_preserve_control_memory_and_relocate_each_live_reference
         (do
           (boot! 1)
           (let [ctrl (con-make TY-CTRL)
                 mem (con-make (ty-mem 1 TY-BOT))
                 first (con-make (ty-memptr false (ty-struct "First")))
                 second (con-make (ty-memptr false (ty-struct "Second")))
                 sp (safepoint-make ctrl mem)]
             (assert-eq (safepoint-add-live! sp first) 0)
             (assert-eq (safepoint-add-live! sp second) 1)
             (assert (ty-tuple? (n-ty sp)))
             (assert-eq (ty-tuple-len (n-ty sp)) 4)
             (assert-eq (ty-tuple-at (n-ty sp) SAFEPOINT-CTRL) (n-ty ctrl))
             (assert-eq (ty-tuple-at (n-ty sp) SAFEPOINT-MEM) (n-ty mem))
             (assert-eq (ty-tuple-at (n-ty sp) SAFEPOINT-LIVE) (n-ty first))
             (assert-eq (ty-tuple-at (n-ty sp) (+ SAFEPOINT-LIVE 1))
                        (n-ty second))
             (let [relocated-first (safepoint-relocated sp 0)
                   same-first (safepoint-relocated sp 0)
                   relocated-second (safepoint-relocated sp 1)]
               (assert (n-same? relocated-first same-first))
               (assert-eq (n-ty relocated-first) (n-ty first))
               (assert-eq (n-ty relocated-second) (n-ty second))
               (assert-eq (n-nouts sp) 2)))))

(deftest verifier_requires_every_safepoint_relocation_projection
         (do
           (boot! 1)
           (let [sp
                   (safepoint-make (con-make TY-CTRL)
                                   (con-make (ty-mem 1 TY-BOT)))
                 ref (con-make (ty-memptr false (ty-struct "Managed")))]
             (safepoint-add-live! sp ref)
             (assert-eq (verify-node sp) VERR-SAFEPOINT-R2)
             (safepoint-relocated sp 0)
             (assert-eq (verify-node sp) VERR-OK))))

(deftest verifier_rejects_a_scalar_in_the_safepoint_live_set
         (do
           (boot! 1)
           (let [sp
                   (safepoint-make (con-make TY-CTRL)
                                   (con-make (ty-mem 1 TY-BOT)))
                 scalar (con-make (ty-int-con 7))]
             (safepoint-add-live! sp scalar)
             (safepoint-relocated sp 0)
             (assert-eq (verify-node sp) VERR-SAFEPOINT-R1))))

(deftest reference_stores_gain_one_post_write_barrier_in_the_memory_chain
         (do
           (boot! 1)
           (let [ctrl (con-make TY-CTRL)
                 obj (con-make (ty-memptr false (ty-struct "Owner")))
                 value (con-make (ty-memptr true (ty-struct "Value")))
                 off (con-make (ty-int-con 16))
                 initial
                   (con-make (ty-mem 9 (ty-memptr true (ty-struct "Value"))))
                 store (store-make ctrl initial obj off value 9 (n-ty value))
                 load_ (load-make ctrl store obj off 9 (n-ty value))]
             (assert-eq (gc-lower-barriers!) 1)
             (let [barrier (n-in! load_ MEM-STATE)]
               (assert-eq (n-op barrier) OP-BARRIER)
               (assert (n-same? (n-in! barrier BARRIER-MEM) store))
               (assert (n-same? (n-in! barrier BARRIER-OBJ) obj))
               (assert (n-same? (n-in! barrier BARRIER-VAL) value))
               (assert-eq (n-ty barrier) (n-ty store))
               (assert-eq (gc-lower-barriers!) 0)))))

(deftest scalar_stores_do_not_gain_a_write_barrier
         (do
           (boot! 1)
           (let [ctrl (con-make TY-CTRL)
                 obj (con-make (ty-memptr false (ty-struct "ScalarOwner")))
                 value (con-make (ty-int-range 1 2))
                 off (con-make (ty-int-con 8))
                 initial (con-make (ty-mem 10 (ty-int-bot)))]
             (store-make ctrl initial obj off value 10 (ty-int-bot))
             (assert-eq (gc-lower-barriers!) 0))))

(deftest non_reference_dynamic_singletons_do_not_gain_a_write_barrier
         (do
           (boot! 1)
           (let [ctrl (con-make TY-CTRL)
                 obj (con-make (ty-memptr false (ty-struct "DynamicOwner")))
                 initial (con-make (ty-mem 11 (ty-dyn TAG-ANY)))]
             (store-make ctrl
                         initial
                         obj
                         (con-make (ty-int-con 0))
                         (con-make (ty-dyn TAG-NULL))
                         11
                         (ty-dyn TAG-ANY))
             (assert-eq (gc-lower-barriers!) 0))))

;; Image objects are roots: a young object stored into an image object's word survives a minor
;; collection and the word is rewritten to its new address, while the image object itself stays
;; where it is. A raw-kind store is honoured through the barrier's metadata bit as for heap objects.
(deftest image_objects_are_roots_whose_words_are_forwarded_and_never_moved
         (shape-reset!)
         (heap-reset! DYNAMIC-PREFIX-OBJECT)
         (rt-heap-reset! 4096)
         (let [holder (heap-add-object! DYNAMIC-NULL-WORD)]
           (heap-define-own! holder
                             "slot"
                             DYNAMIC-UNDEFINED-WORD
                             HEAP-WORD-CONST)
           (heap-image-build!)
           (let [blob (heap-image-bytes)
                 base (primitive/cast i64 (slice-data [u8] blob))]
             (rt-statics-adopt! (slice-data [u8] blob) (len blob))
             (let [h (+ base (heap-entry-offset holder))
                   storage (rt-storage-of h)
                   young (rt-alloc 16 SHAPE-EMPTY 0 0)
                   slot
                     (primitive/cast (ptr i64)
                                     (+ storage
                                        (shape-offset (heap-storage-shape holder)
                                                      "slot")))]
               (assert (rt-static-payload? storage))
               (assert (not (rt-static-payload? young)))
               ;; The image storage now references a nursery object, through the barrier.
               (set! slot (rt-box-object young))
               (aot-rt-write-barrier storage
                                     (rt-box-object young)
                                     RT-BARRIER-BOXED)
               (let [root (primitive/alloc-stack i64)]
                 (set! root 0)
                 (rt-collect-one-root! root)
                 (let [moved (& (load slot) RT-DYNAMIC-PAYLOAD-MASK)]
                   (assert (!= moved young))
                   (assert (rt-live-payload? moved))
                   (assert-eq (rt-payload-shape moved) SHAPE-EMPTY)
                   ;; Nothing in the image moved, and its storage still hangs off the object.
                   (assert-eq (rt-storage-of h) storage)
                   (assert (rt-verify-reference? (load slot) false))))))))

(defn gc-test-static-pair [(template (slice u8))
                           (holder-offset i64)
                           (slot-offset i64)] (-> i64)
  (let [first (image-copy template)
        second (image-copy template)
        first-base (primitive/cast i64 (slice-data [u8] first))
        second-base (primitive/cast i64 (slice-data [u8] second))
        root (primitive/alloc-stack i64)]
    (rt-heap-reset! 4096)
    (rt-statics-adopt! (slice-data [u8] first) (len first))
    (rt-statics-adopt! (slice-data [u8] second) (len second))
    (let [a (rt-storage-of (+ first-base holder-offset))
          b (rt-storage-of (+ second-base holder-offset))
          slot-a (primitive/cast (ptr i64) (+ a slot-offset))
          slot-b (primitive/cast (ptr i64) (+ b slot-offset))
          young-a (rt-alloc 16 SHAPE-EMPTY 0 0)
          young-b (rt-alloc 16 SHAPE-EMPTY 0 0)]
      (assert-eq (load slot-a) DYNAMIC-UNDEFINED-WORD)
      (assert-eq (load slot-b) DYNAMIC-UNDEFINED-WORD)
      (assert (rt-static-payload? a))
      (assert (rt-static-payload? b))
      (set! (primitive/cast (ptr i64) young-a) 101)
      (set! (primitive/cast (ptr i64) young-b) 202)
      (set! slot-a (rt-box-object young-a))
      ;; Exercise the raw-root metadata path independently of the boxed path.
      (set! slot-b young-b)
      (aot-rt-write-barrier b young-b RT-BARRIER-RAW)
      (set! root 0)
      (rt-collect-one-root! root)
      (assert (!= (& (load slot-a) RT-DYNAMIC-PAYLOAD-MASK) young-a))
      (assert (!= (load slot-b) young-b))
      (rt-verify-statics! "two images after minor")
      (rt-collect-one-root! root)
      (set! (.force-major (rt-heap)) true)
      (rt-collect-one-root! root)
      (rt-verify-statics! "two images after major")
      (assert-eq (load (primitive/cast (ptr i64)
                                       (& (load slot-a) RT-DYNAMIC-PAYLOAD-MASK)))
                 101)
      (assert-eq (load (primitive/cast (ptr i64) (load slot-b))) 202)
      ;; References between the two nonmoving images are valid too.
      (set! slot-a (rt-box-object b))
      (rt-verify-statics! "cross-image reference")
      (rt-heap-reset! 4096)
      (assert (not (rt-static-payload? a)))
      (assert (not (rt-static-payload? b)))
      (assert-eq (.global-object (rt-heap)) 0)
      (assert-eq (.exception-value (rt-heap)) 0))
    (rt-realm-destroy!)
    (alloc/free [u8] (alloc/malloc-allocator) first)
    (alloc/free [u8] (alloc/malloc-allocator) second)
    0))

(deftest all_static_images_remain_roots_and_fresh_realms_start_from_unchanged_templates
         (shape-reset!)
         (heap-reset! DYNAMIC-PREFIX-OBJECT)
         (let [holder (heap-add-object! DYNAMIC-NULL-WORD)]
           (heap-define-own! holder
                             "slot"
                             DYNAMIC-UNDEFINED-WORD
                             HEAP-WORD-CONST)
           (heap-image-build!)
           (let [template (heap-image-bytes)
                 offset (heap-entry-offset holder)
                 slot (shape-offset (heap-storage-shape holder) "slot")]
             (gc-test-static-pair template offset slot)
             (gc-test-static-pair template offset slot))))

(defn gc-test-canonical-object-binding [(template (slice u8))
                                        (prototype i64)
                                        (prototype-offset i64)
                                        (owner-offset i64)
                                        (slot-offset i64)
                                        (reference-offset i64)] (-> i64)
  (let [first (image-copy template)
        second (image-copy template)
        source (+ (primitive/cast i64 (slice-data first)) prototype-offset)
        target (+ (primitive/cast i64 (slice-data second)) prototype-offset)
        owner (+ (primitive/cast i64 (slice-data first)) owner-offset)
        root (primitive/alloc-stack i64)
        (mut bindings) (al-new [RtObjectBinding] (alloc/malloc-allocator))]
    (rt-heap-reset! 4096)
    (rt-unit-adopt! 0 (slice-data first) (len first))
    (rt-statics-adopt! (slice-data second) (len second))
    (set! (.global-object (rt-heap)) (rt-box-object source))
    (push! [RtObjectBinding]
           (mut bindings)
           (RtObjectBinding :source source :target target))
    (rt-unit-bind-objects! (al-slice (load bindings)))
    (al-free! (mut bindings))
    (let [objects (get (.object-maps (rt-heap)) 0)
          prototype-slot (primitive/cast (ptr i64) owner)
          reference-slot
            (primitive/cast (ptr i64)
                            (+ (rt-storage-of owner) reference-offset))
          target-slot
            (primitive/cast (ptr i64) (+ (rt-storage-of target) slot-offset))]
      (assert-eq (get objects prototype) target)
      (assert-eq (load prototype-slot) (rt-box-object target))
      (assert-eq (load reference-slot) (rt-box-object target))
      (assert-eq (.global-object (rt-heap)) (rt-box-object target))
      (assert (.object-bindings-finalized (rt-heap)))
      (let [young (rt-alloc 16 SHAPE-EMPTY 0 0)]
        (set! (primitive/cast (ptr i64) young) 123)
        (set! target-slot (rt-box-object young))
        (aot-rt-write-barrier (rt-storage-of target)
                              (rt-box-object young)
                              RT-BARRIER-BOXED)
        (set! root 0)
        (rt-collect-one-root! root)
        (assert (!= (& (load target-slot) RT-DYNAMIC-PAYLOAD-MASK) young))
        (rt-collect-one-root! root)
        (set! (.force-major (rt-heap)) true)
        (rt-collect-one-root! root)
        (rt-verify-statics! "canonical object bindings")
        (assert-eq (load (primitive/cast (ptr i64)
                                         (& (load target-slot)
                                            RT-DYNAMIC-PAYLOAD-MASK)))
                   123)
        (assert-eq (get objects prototype) target)
        (assert-eq (load prototype-slot) (rt-box-object target))
        (assert-eq (load reference-slot) (rt-box-object target))))
    (rt-realm-destroy!)
    (assert (not (.object-bindings-finalized (rt-heap))))
    (alloc/free [u8] (alloc/malloc-allocator) first)
    (alloc/free [u8] (alloc/malloc-allocator) second)
    0))

(deftest canonical_bindings_update_code_maps_template_edges_and_global_roots_through_collection
         (shape-reset!)
         (heap-reset! DYNAMIC-PREFIX-OBJECT)
         (let [prototype (heap-add-object! DYNAMIC-NULL-WORD)
               owner (heap-add-object! DYNAMIC-NULL-WORD)]
           (heap-define-own! prototype
                             "slot"
                             DYNAMIC-UNDEFINED-WORD
                             HEAP-WORD-CONST)
           (heap-set-prototype! owner
                                (heap-ref-word DYNAMIC-PREFIX-OBJECT prototype)
                                HEAP-WORD-REF)
           (heap-define-own! owner
                             "reference"
                             (heap-ref-word DYNAMIC-PREFIX-OBJECT prototype)
                             HEAP-WORD-REF)
           (heap-image-build!)
           (let [template (heap-image-bytes)
                 p (heap-entry-offset prototype)
                 o (heap-entry-offset owner)
                 slot (shape-offset (heap-storage-shape prototype) "slot")
                 reference (shape-offset (heap-storage-shape owner) "reference")]
             (gc-test-canonical-object-binding template
                                               prototype
                                               p
                                               o
                                               slot
                                               reference)
             (gc-test-canonical-object-binding template
                                               prototype
                                               p
                                               o
                                               slot
                                               reference))))

(defn gc-test-initial-merge-refuses [(source i64) (target i64)] (-> i64)
  (let [(mut merges) (al-new [RtObjectBinding] (alloc/malloc-allocator))]
    (push! [RtObjectBinding]
           (mut merges)
           (RtObjectBinding :source source :target target))
    (gc-test-initial-merge-batch-refuses (load merges))
    (al-free! (mut merges))
    0))

(defn gc-test-initial-merge-batch-refuses [(merges (ArrayList RtObjectBinding))] (-> i64)
  (let [pid (os/fork)
        status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (do
          (rt-unit-merge-object-properties! (al-slice merges))
          (os/_exit 0)
          0)
        (do
          (assert-eq (os/waitpid pid status 0) pid)
          (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
          (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8)
                     EXIT-PANIC)
          0))))

(deftest initial_property_union_preserves_descriptors_references_and_equal_string_values_under_gc
         (shape-reset!)
         (heap-reset! DYNAMIC-PREFIX-OBJECT)
         (let [left (heap-add-object! DYNAMIC-NULL-WORD)
               right (heap-add-object! DYNAMIC-NULL-WORD)
               target (heap-add-object! DYNAMIC-NULL-WORD)
               child (heap-add-object! DYNAMIC-NULL-WORD)
               (mut units) (al-new [i64] (alloc/malloc-allocator))]
           (push! [i64] (mut units) 120)
           (let [first-string (heap-add-string! (load units))
                 second-string (heap-add-string! (load units))]
             (heap-define-own-attrs! left
                                     "a"
                                     (heap-ref-word DYNAMIC-PREFIX-OBJECT child)
                                     HEAP-WORD-REF
                                     1)
             (heap-define-own-attrs! left
                                     "same"
                                     (heap-ref-word RT-DYNAMIC-PREFIX-STRING
                                                    first-string)
                                     HEAP-WORD-REF
                                     5)
             (heap-define-own-attrs! right "b" 42 HEAP-WORD-CONST 3)
             (heap-define-own-attrs! right
                                     "same"
                                     (heap-ref-word RT-DYNAMIC-PREFIX-STRING
                                                    second-string)
                                     HEAP-WORD-REF
                                     5)
             (heap-define-own-attrs! target "kept" 7 HEAP-WORD-CONST 0))
           (heap-image-build!)
           (let [copy (image-copy (heap-image-bytes))
                 shapes (shape-table-bytes)
                 base (primitive/cast i64 (slice-data copy))
                 receiver (+ base (heap-entry-offset target))
                 (mut empty) (al-new [RtObjectBinding] (alloc/malloc-allocator))
                 (mut merges)
                   (al-new [RtObjectBinding] (alloc/malloc-allocator))
                 root (primitive/alloc-stack i64)]
             (rt-heap-reset-generational! 64 4096)
             (shapes-boot! (slice-data shapes) (len shapes))
             (rt-unit-adopt! 0 (slice-data copy) (len copy))
             (rt-unit-bind-objects! (al-slice (load empty)))
             (set! (.stress (rt-heap)) true)
             (set! (.verify (rt-heap)) true)
             (push! [RtObjectBinding]
                    (mut merges)
                    (RtObjectBinding :source (+ base (heap-entry-offset left))
                      :target receiver))
             (push! [RtObjectBinding]
                    (mut merges)
                    (RtObjectBinding :source (+ base (heap-entry-offset right))
                      :target receiver))
             (rt-unit-merge-object-properties! (al-slice (load merges)))
             (assert (.object-properties-finalized (rt-heap)))
             (assert-eq (rt-prop-get-own receiver (shape-key-intern "a"))
                        (rt-box-object (+ base (heap-entry-offset child))))
             (assert-eq (rt-prop-get-own receiver (shape-key-intern "b")) 42)
             (assert-eq (rt-prop-get-own receiver (shape-key-intern "kept")) 7)
             (let [shape (rt-payload-shape (rt-storage-of receiver))]
               (assert-eq (shapes-lookup-attrs shape (shape-key-intern "a")) 1)
               (assert-eq (shapes-lookup-attrs shape (shape-key-intern "same"))
                          5)
               (assert-eq (shapes-lookup-offset shape (shape-key-intern "a")) 8)
               (assert-eq (shapes-lookup-offset shape (shape-key-intern "b"))
                          24))
             (set! root 0)
             (rt-collect-one-root! root)
             (set! (.force-major (rt-heap)) true)
             (rt-collect-one-root! root)
             (rt-verify-statics! "initial property union")
             (assert-eq (rt-prop-get-own receiver (shape-key-intern "b")) 42)
             (gc-test-initial-merge-refuses (+ base (heap-entry-offset left))
                                            receiver)
             (rt-realm-destroy!)
             (alloc/free [u8] (alloc/malloc-allocator) copy)
             (al-free! (mut merges))
             (al-free! (mut empty)))
           (al-free! (mut units))))

(deftest initial_property_union_rejects_conflicting_values_descriptors_prototypes_and_interior_addresses
         (shape-reset!)
         (heap-reset! DYNAMIC-PREFIX-OBJECT)
         (let [source (heap-add-object! DYNAMIC-NULL-WORD)
               value (heap-add-object! DYNAMIC-NULL-WORD)
               attrs (heap-add-object! DYNAMIC-NULL-WORD)
               proto (heap-add-object! DYNAMIC-NULL-WORD)
               target (heap-add-object! DYNAMIC-NULL-WORD)]
           (heap-define-own-attrs! source "x" 42 HEAP-WORD-CONST 5)
           (heap-define-own-attrs! value "x" 7 HEAP-WORD-CONST 5)
           (heap-define-own-attrs! attrs "x" 42 HEAP-WORD-CONST 1)
           (heap-set-prototype! proto
                                (heap-ref-word DYNAMIC-PREFIX-OBJECT source)
                                HEAP-WORD-REF)
           (heap-image-build!)
           (let [copy (image-copy (heap-image-bytes))
                 shapes (shape-table-bytes)
                 base (primitive/cast i64 (slice-data copy))
                 origin (+ base (heap-entry-offset source))
                 (mut empty) (al-new [RtObjectBinding] (alloc/malloc-allocator))]
             (rt-heap-reset! 4096)
             (shapes-boot! (slice-data shapes) (len shapes))
             (rt-unit-adopt! 0 (slice-data copy) (len copy))
             (gc-test-initial-merge-refuses origin
                                            (+ base (heap-entry-offset value)))
             (rt-unit-bind-objects! (al-slice (load empty)))
             (gc-test-initial-merge-refuses origin
                                            (+ base (heap-entry-offset value)))
             (gc-test-initial-merge-refuses origin
                                            (+ base (heap-entry-offset attrs)))
             (gc-test-initial-merge-refuses origin
                                            (+ base (heap-entry-offset proto)))
             (gc-test-initial-merge-refuses (+ origin 8)
                                            (+ base (heap-entry-offset value)))
             (let [(mut merges)
                     (al-new [RtObjectBinding] (alloc/malloc-allocator))
                   receiver (+ base (heap-entry-offset target))]
               (push! [RtObjectBinding]
                      (mut merges)
                      (RtObjectBinding :source origin :target receiver))
               (push! [RtObjectBinding]
                      (mut merges)
                      (RtObjectBinding :source
                                         (+ base (heap-entry-offset value))
                        :target receiver))
               (gc-test-initial-merge-batch-refuses (load merges))
               (al-free! (mut merges)))
             (rt-realm-destroy!)
             (alloc/free [u8] (alloc/malloc-allocator) copy)
             (al-free! (mut empty)))))

(const GC-BIND-INTERIOR 1)

(const GC-BIND-MISSING 2)

(const GC-BIND-LAYOUT 3)

(const GC-BIND-DUPLICATE 4)

(const GC-BIND-CHAIN 5)

(const GC-BIND-LOCAL-ALIAS 6)

(const GC-BIND-SELF 7)

(const GC-BIND-FINALIZED 8)

(const GC-BIND-STARTED 9)

(const GC-BIND-ADOPT 10)

(const GC-BIND-CYCLE 11)

(defn gc-test-object-binding-refuses [(source i64)
                                      (target i64)
                                      (local i64)
                                      (storage i64)
                                      (template (slice u8))
                                      (mode i64)] (-> i64)
  (let [pid (os/fork)
        status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (let [(mut bindings) (al-new [RtObjectBinding] (alloc/malloc-allocator))]
          (push! [RtObjectBinding]
                 (mut bindings)
                 (RtObjectBinding :source source
                   :target
                     (case mode GC-BIND-INTERIOR
                           (+ target 8) GC-BIND-MISSING
                           1 GC-BIND-LAYOUT
                           storage GC-BIND-LOCAL-ALIAS
                           local GC-BIND-SELF
                           source target)))
          (if (= mode GC-BIND-DUPLICATE)
              (push! [RtObjectBinding]
                     (mut bindings)
                     (RtObjectBinding :source source :target target))
              0)
          (if (= mode GC-BIND-CHAIN)
              (push! [RtObjectBinding]
                     (mut bindings)
                     (RtObjectBinding :source target :target local))
              0)
          (if (= mode GC-BIND-CYCLE)
              (push! [RtObjectBinding]
                     (mut bindings)
                     (RtObjectBinding :source target :target source))
              0)
          (if (= mode GC-BIND-FINALIZED)
              (do (rt-unit-bind-objects! (al-slice (load bindings))) 0)
              0)
          (if (= mode GC-BIND-STARTED) (do (rt-alloc 16 SHAPE-EMPTY 0 0) 0) 0)
          (rt-unit-bind-objects! (al-slice (load bindings)))
          (if (= mode GC-BIND-ADOPT)
              (let [copy (image-copy template)]
                (rt-statics-adopt! (slice-data copy) (len copy)))
              0)
          (os/_exit 0)
          0)
        (do
          (assert-eq (os/waitpid pid status 0) pid)
          (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
          (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8)
                     EXIT-PANIC)
          0))))

(deftest canonical_bindings_reject_invalid_payloads_alias_chains_and_late_changes
         (shape-reset!)
         (heap-reset! DYNAMIC-PREFIX-OBJECT)
         (let [prototype (heap-add-object! DYNAMIC-NULL-WORD)
               other (heap-add-object! DYNAMIC-NULL-WORD)]
           (heap-define-own! prototype
                             "slot"
                             DYNAMIC-UNDEFINED-WORD
                             HEAP-WORD-CONST)
           (heap-image-build!)
           (let [first (image-copy (heap-image-bytes))
                 second (image-copy (heap-image-bytes))
                 source
                   (+ (primitive/cast i64 (slice-data first))
                      (heap-entry-offset prototype))
                 target
                   (+ (primitive/cast i64 (slice-data second))
                      (heap-entry-offset prototype))
                 local
                   (+ (primitive/cast i64 (slice-data first))
                      (heap-entry-offset other))]
             (rt-heap-reset! 4096)
             (rt-unit-adopt! 0 (slice-data first) (len first))
             (rt-statics-adopt! (slice-data second) (len second))
             (let [storage (rt-storage-of target)
                   (mut mode) GC-BIND-INTERIOR]
               (loop (if (> (load mode) GC-BIND-CYCLE)
                         (break 0)
                         (do
                           (gc-test-object-binding-refuses source
                                                           target
                                                           local
                                                           storage
                                                           (heap-image-bytes)
                                                           (load mode))
                           (set! (mut mode) (+ (load mode) 1))
                           (continue)))))
             (rt-realm-destroy!)
             (alloc/free [u8] (alloc/malloc-allocator) first)
             (alloc/free [u8] (alloc/malloc-allocator) second))))

(defn gc-test-adoption-refuses [(blob (ptr u8)) (bytes i64)] (-> i64)
  (let [pid (os/fork)
        status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (do (rt-statics-adopt! blob bytes) (os/_exit 0) 0)
        (do
          (assert-eq (os/waitpid pid status 0) pid)
          (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
          (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8)
                     EXIT-PANIC)
          0))))

(deftest static_image_adoption_rejects_duplicate_overlapping_and_competing_global_images
         (shape-reset!)
         (heap-reset! DYNAMIC-PREFIX-OBJECT)
         (let [global (heap-add-object! DYNAMIC-NULL-WORD)]
           (heap-set-global! global)
           (heap-image-build!)
           (let [first (image-copy (heap-image-bytes))
                 second (image-copy (heap-image-bytes))
                 base (slice-data [u8] first)]
             (rt-heap-reset! 4096)
             (rt-statics-adopt! base (len first))
             (gc-test-adoption-refuses base (len first))
             (gc-test-adoption-refuses (primitive/index base 8)
                                       (- (len first) 8))
             (gc-test-adoption-refuses (slice-data [u8] second) (len second))
             (assert-eq (.global-object (rt-heap))
                        (rt-box-object (+ (primitive/cast i64 base)
                                          (heap-entry-offset global))))
             (rt-realm-destroy!)
             (assert (not (rt-static-payload? (+ (primitive/cast i64 base)
                                                 (heap-entry-offset global)))))
             (gc-test-adoption-refuses (slice-data [u8] second) (len second))
             ;; A competing image is legitimate in a different realm, with its own relocated global.
             (rt-heap-reset! 4096)
             (rt-statics-adopt! (slice-data [u8] second) (len second))
             (assert-eq (.global-object (rt-heap))
                        (rt-box-object (+ (primitive/cast i64
                                                          (slice-data [u8]
                                                                      second))
                                          (heap-entry-offset global))))
             (rt-realm-destroy!)
             (alloc/free [u8] (alloc/malloc-allocator) first)
             (alloc/free [u8] (alloc/malloc-allocator) second))))

;; Array elements live in a store the collector moves: a young element stored through the runtime
;; is forwarded with the store, holes are left alone, the length word is not a reference, and a
;; growth past the capacity keeps the array's identity while the store is replaced.
(deftest array_element_stores_are_scanned_grown_and_kept_behind_the_array
         (do
           (rt-heap-reset! 8192)
           (let [arr (rt-array-new 2 RT-DYNAMIC-UNDEFINED-WORD 0 0)]
             (assert-eq (rt-array-length arr) 2)
             (assert-eq (rt-array-has arr 0) 0)
             (assert-eq (rt-array-load arr 0) RT-DYNAMIC-UNDEFINED-WORD)
             (let [young (rt-alloc 16 SHAPE-EMPTY 0 0)]
               (rt-array-store arr 1 (rt-box-object young) 0 0)
               (assert-eq (rt-array-has arr 1) 1)
               ;; Growth: index 9 is past the capacity of 4; the array stays where it is.
               (rt-array-store arr 9 (rt-box-object young) 0 0)
               (assert-eq (rt-array-length arr) 10)
               (assert-eq (rt-array-has arr 5) 0)
               (let [root (primitive/alloc-stack i64)]
                 (set! root arr)
                 (rt-collect-one-root! root)
                 (let [moved-arr (load root)
                       e1 (rt-array-load moved-arr 1)
                       e9 (rt-array-load moved-arr 9)]
                   (assert (rt-word-object? e1))
                   (assert-eq e1 e9)
                   (assert (!= (& e1 RT-DYNAMIC-PAYLOAD-MASK) young))
                   (assert (rt-live-payload? (& e1 RT-DYNAMIC-PAYLOAD-MASK)))
                   (assert-eq (rt-array-length moved-arr) 10)
                   ;; Truncation makes the dropped slots holes; extension makes new holes.
                   (rt-array-set-length moved-arr 1 0 0)
                   (assert-eq (rt-array-has moved-arr 1) 0)
                   (rt-array-set-length moved-arr 3 0 0)
                   (assert-eq (rt-array-length moved-arr) 3)
                   (assert-eq (rt-array-has moved-arr 2) 0)
                   ;; Canonical numeric strings are indices; anything else is not.
                   (assert-eq (rt-array-index-of-string (gc-test-string2 49 50))
                              12)
                   (assert-eq (rt-array-index-of-string (gc-test-string2 48 49))
                              -1)))))))
