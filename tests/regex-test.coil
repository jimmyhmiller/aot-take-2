;; Regular-expression pattern early errors: the strict (`u`), web-compat (no flag) and class-set
;; (`v`) grammars each admit and reject exactly what ECMA-262 §22.2.1 and Annex B.1.2 say.

(module aot.tests.regex)
(import "coil.assert" :use *)
(import "aot.parse.regex" :use *)

(defn regex-ok [(body (slice u8)) (flags (slice u8))] (-> i64)
  (match (regex-validate body flags)
    (RegexOk [] 0)
    (RegexError [m] (do (println "unexpected error for /{s}/{s}: {s}" body flags m) (assert false) 0))
    (RegexUnknown [m] (do (println "unexpected unknown for /{s}/{s}: {s}" body flags m) (assert false) 0))))

(defn regex-bad [(body (slice u8)) (flags (slice u8))] (-> i64)
  (match (regex-validate body flags)
    (RegexError [m] 0)
    (RegexOk [] (do (println "unexpected accept for /{s}/{s}" body flags) (assert false) 0))
    (RegexUnknown [m] (do (println "unexpected unknown for /{s}/{s}: {s}" body flags m) (assert false) 0))))

(defn regex-unknown [(body (slice u8)) (flags (slice u8))] (-> i64)
  (match (regex-validate body flags)
    (RegexUnknown [m] 0)
    (RegexOk [] (do (println "unexpected accept for /{s}/{s}" body flags) (assert false) 0))
    (RegexError [m] (do (println "unexpected error for /{s}/{s}: {s}" body flags m) (assert false) 0))))

(deftest regex_common_grammar_accepts_ordinary_patterns_in_every_mode
         (regex-ok "a" "")
         (regex-ok "a" "u")
         (regex-ok "a" "v")
         (regex-ok "^ab*c+d?e{2}f{2,}g{2,3}h*?$" "")
         (regex-ok "^ab*c+d?e{2}f{2,}g{2,3}h*?$" "u")
         (regex-ok "a|b|" "u")
         (regex-ok "(a)(?:b)(?=c)(?!d)(?<=e)(?<!f)" "u")
         (regex-ok "(a)\\1" "")
         (regex-ok "(a)\\1" "u")
         (regex-ok "\\d\\D\\s\\S\\w\\W\\b\\B\\f\\n\\r\\t\\v\\0\\cA\\x41\\u0041" "u")
         (regex-ok "[abc][^abc][a-z][\\d\\w][-a][a-]" "u")
         (regex-ok "[\\b]" "u")
         (regex-ok "(?<name>a)\\k<name>" "")
         (regex-ok "(?<name>a)\\k<name>" "u")
         (regex-ok "(?<$_a1>a)" "u")
         (regex-ok "(?<\\u0061>a)\\k<a>" "")
         (regex-ok "(?<a>x)|(?<a>y)" "u")
         (regex-ok "(?:(?<a>x)|(?<a>y))\\k<a>" "u")
         (regex-ok "(?i:a)(?-i:b)(?ims:c)(?i-m:d)" "u")
         (regex-ok "\\u{1F600}\\uD83D\\uDE00[\\uD83D\\uDE00-\\uD83D\\uDE01]" "u")
         (regex-ok "\\p{L}\\P{Lu}\\p{Script=Latin}\\p{sc=Latn}\\p{scx=Grek}\\p{gc=Nd}\\p{ASCII}\\p{Any}" "u")
         (regex-ok "\\p{General_Category=Letter}\\p{Script_Extensions=Garay}\\p{Script=Tai_Yo}" "u")
         (regex-ok "\\/\\.\\*\\[\\]\\{\\}\\(\\)\\|\\^\\$\\?\\+\\\\" "u")
         (regex-ok ".{1000000000000000000000}" "u"))

(deftest regex_web_compat_grammar_admits_annex_b_extensions
         (regex-ok "]" "")
         (regex-ok "}" "")
         (regex-ok "{" "")
         (regex-ok "a{" "")
         (regex-ok "a{1" "")
         (regex-ok "a{,1}" "")
         (regex-ok "{a}" "")
         (regex-ok "\\8\\9\\1\\377\\400" "")
         (regex-ok "\\c" "")
         (regex-ok "\\c1" "")
         (regex-ok "[\\c1\\c_]" "")
         (regex-ok "\\M\\-\\k\\p\\u\\x\\u{1}" "")
         (regex-ok "\\u{" "")
         (regex-ok "[\\d-a][a-\\d][\\s-\\d]" "")
         (regex-ok ".(?=.)?.(?!.){2,3}" "")
         (regex-ok "[[]" "")
         (regex-ok "\\00\\01" ""))

(deftest regex_common_early_errors_are_rejected_in_every_mode
         (regex-bad "?" "")
         (regex-bad "*" "")
         (regex-bad "+a" "")
         (regex-bad "a**" "")
         (regex-bad "a*?*" "")
         (regex-bad "^*" "")
         (regex-bad "\\b+" "")
         (regex-bad "{2}" "")
         (regex-bad "{2,}" "")
         (regex-bad "{2,3}" "")
         (regex-bad "a{2}{3}" "")
         (regex-bad "a{2,1}" "")
         (regex-bad "a{2,1}" "u")
         (regex-bad "(" "")
         (regex-bad ")" "")
         (regex-bad "(a" "u")
         (regex-bad "a)" "u")
         (regex-bad "[a" "")
         (regex-bad "[z-a]" "")
         (regex-bad "[z-a]" "u")
         (regex-bad "a\\" "")
         (regex-bad "(?a)" "")
         (regex-bad "(?<a)" "")
         (regex-bad ".(?<=.)?" "")
         (regex-bad ".(?<!.){2,3}" "")
         (regex-bad ".(?<=.)?" "u"))

(deftest regex_strict_grammar_rejects_what_web_compat_tolerates
         (regex-bad "{" "u")
         (regex-bad "}" "u")
         (regex-bad "]" "u")
         (regex-bad "a{" "u")
         (regex-bad "\\M" "u")
         (regex-bad "\\-" "u")
         (regex-bad "\\1" "u")
         (regex-bad "\\8" "u")
         (regex-bad "\\00" "u")
         (regex-bad "\\c0" "u")
         (regex-bad "\\c" "u")
         (regex-bad "\\x4" "u")
         (regex-bad "\\u004" "u")
         (regex-bad "\\u{110000}" "u")
         (regex-bad "\\u{1,}" "u")
         (regex-bad "\\u{1F_639}" "u")
         (regex-bad "\\u{}" "u")
         (regex-bad "[\\d-a]" "u")
         (regex-bad "[\\s-\\d]" "u")
         (regex-bad "[%-\\d]" "u")
         (regex-bad "[--\\d]" "u")
         (regex-bad "[\\c0]" "u")
         (regex-bad "[\\1]" "u")
         (regex-bad ".(?=.)?" "u")
         (regex-bad ".(?!.){2,3}" "u")
         (regex-bad "\\k" "u")
         (regex-bad "\\k<a" "u")
         (regex-bad "\\k<a>" "u"))

(deftest regex_named_groups_and_modifiers_have_their_own_early_errors
         (regex-bad "(?<a>a)(?<a>a)" "")
         (regex-bad "(?<a>a)(?<b>b)(?<a>a)" "")
         (regex-bad "(?<a>a)|(?<b>b)(?<a>a)(?<a>c)" "u")
         (regex-bad "(?<a>.)\\k<b>" "")
         (regex-bad "(?<a>.)\\k<>" "u")
         (regex-bad "(?<a>.)\\k" "")
         (regex-bad "(?<a:>a)" "")
         (regex-bad "(?<>a)" "")
         (regex-bad "(?<1a>a)" "")
         (regex-bad "(?<a\\uD801>.)" "u")
         (regex-bad "(?<\\uD801>.)" "")
         (regex-bad "(?<a\\u{110000}>.)" "")
         (regex-bad "(?<a\\x41>.)" "")
         (regex-unknown "(?<❤>a)" "")
         (regex-unknown "(?<$❞>a)" "")
         (regex-unknown "(?<𝒜>a)" "")
         (regex-bad "(?i-i:a)" "")
         (regex-bad "(?ims-m:a)" "")
         (regex-bad "(?-:a)" "")
         (regex-bad "(?ii:a)" "")
         (regex-ok "(?i-:a)" "")
         (regex-ok "(?-i:a)" "")
         (regex-bad "(?\\u{0073}-s:a)" "")
         (regex-bad "(?i a)" "")
         (regex-bad "(?ix:a)" "")
         (regex-bad "(?i" ""))

(deftest regex_property_escapes_match_exact_unicode_spellings
         (regex-bad "\\p{ASCII=F}" "u")
         (regex-bad "\\P{ASCII=Yes}" "u")
         (regex-bad "\\p{General_Category}" "u")
         (regex-bad "\\p{General_Category=}" "u")
         (regex-bad "\\p{Script}" "u")
         (regex-bad "\\p{Script_Extensions=}" "u")
         (regex-bad "\\p{UnknownBinaryProperty}" "u")
         (regex-bad "\\p{Line_Breakz=WAT}" "u")
         (regex-bad "\\p{Line_Breakz=Alphabetic}" "u")
         (regex-bad "\\p{General_Category=WAT}" "u")
         (regex-bad "\\p{Script=FooBarBazInvalid}" "u")
         (regex-bad "\\p{Composition_Exclusion}" "u")
         (regex-bad "\\p{InAdlam}" "u")
         (regex-bad "\\p{IsScript=Adlam}" "u")
         (regex-bad "\\p{^General_Category=Letter}" "u")
         (regex-bad "[\\p{}]" "u")
         (regex-bad "\\P" "u")
         (regex-bad "\\PL" "u")
         (regex-bad "\\p{=Letter}" "u")
         (regex-bad "\\p{=}" "u")
         (regex-bad "\\p{" "u")
         (regex-bad "\\p}" "u")
         (regex-bad "\\p{ Lowercase }" "u")
         (regex-bad "\\p{ANY}" "u")
         (regex-bad "\\p{Ascii}" "u")
         (regex-bad "\\p{General_Category = Uppercase_Letter}" "u")
         (regex-bad "[--\\p{Hex}]" "u")
         (regex-bad "[\\uFFFF-\\p{Hex}]" "u")
         (regex-bad "[\\p{Hex}-\\uFFFF]" "u")
         (regex-bad "\\p{RGI_Emoji}" "u")
         (regex-ok "\\p{RGI_Emoji}[\\p{Basic_Emoji}]" "v")
         (regex-bad "\\P{RGI_Emoji}" "v")
         (regex-bad "[^\\p{RGI_Emoji}]" "v")
         (regex-bad "[\\P{Emoji_Keycap_Sequence}]" "v"))

(deftest regex_class_set_grammar_admits_operators_and_rejects_reserved_syntax
         (regex-ok "[a-z&&[^aeiou]]" "v")
         (regex-ok "[\\p{L}--[a-z]]" "v")
         (regex-ok "[[a-z]--b--c]" "v")
         (regex-ok "[a&&b&&c]" "v")
         (regex-ok "[\\q{abc|d|}]" "v")
         (regex-ok "[^\\q{a|b}]" "v")
         (regex-ok "[\\q{ab}&&\\q{ab|c}]" "v")
         (regex-ok "[\\q{ab}--\\q{c}]" "v")
         (regex-ok "[\\&\\-\\!\\#\\%\\,\\:\\;\\<\\=\\>\\@\\`\\~]" "v")
         (regex-ok "[a-z0-9_.]" "v")
         (regex-ok "[]" "v")
         (regex-ok "[^]" "v")
         (regex-ok "[[]]" "v")
         (regex-ok "[\\d\\w[\\s]]" "v")
         (regex-bad "[(]" "v")
         (regex-bad "[)]" "v")
         (regex-bad "[[]" "v")
         (regex-bad "[{]" "v")
         (regex-bad "[}]" "v")
         (regex-bad "[/]" "v")
         (regex-bad "[-]" "v")
         (regex-bad "[|]" "v")
         (regex-bad "[&&]" "v")
         (regex-bad "[!!]" "v")
         (regex-bad "[##]" "v")
         (regex-bad "[$$]" "v")
         (regex-bad "[%%]" "v")
         (regex-bad "[**]" "v")
         (regex-bad "[++]" "v")
         (regex-bad "[,,]" "v")
         (regex-bad "[..]" "v")
         (regex-bad "[::]" "v")
         (regex-bad "[;;]" "v")
         (regex-bad "[<<]" "v")
         (regex-bad "[==]" "v")
         (regex-bad "[>>]" "v")
         (regex-bad "[??]" "v")
         (regex-bad "[@@]" "v")
         (regex-bad "[``]" "v")
         (regex-bad "[~~]" "v")
         (regex-bad "[^^^]" "v")
         (regex-bad "[_^^]" "v")
         (regex-bad "[a&&b--c]" "v")
         (regex-bad "[a--b&&c]" "v")
         (regex-bad "[a&&b c]" "v")
         (regex-bad "[ab&&c]" "v")
         (regex-bad "[a&&&b]" "v")
         (regex-bad "[a--]" "v")
         (regex-bad "[a&&b-c]" "v")
         (regex-bad "[z-a]" "v")
         (regex-bad "[a-\\d]" "v")
         (regex-bad "[^\\q{ab}]" "v")
         (regex-bad "[^[\\q{ab}]]" "v")
         (regex-ok "[^[\\q{ab}&&\\q{c}]]" "v")
         (regex-bad "\\q{a}" "v")
         (regex-bad "[\\q{a}-b]" "v")
         (regex-bad "[\\q{a]" "v")
         (regex-bad "[\\q]" "v")
         (regex-bad "[a" "v"))
