         (regex-bad "[a" "v"))

;; ---------------------------------------------------------------------------
;; The compiled program (aot.parse.regex.compile)
;;
;; A validated pattern becomes a program for the backtracking matcher. These assertions pin the
;; ENCODING — what opcode sits where — because the matcher in `jsl/` reads exactly these words, and
;; the two have to agree before either can be trusted.

(defn regex-program [(body (slice u8)) (flags (slice u8)) (program-flags i64)] (-> i64)
  (do
    (regex-ok body flags)
    (if (regex-compile! body program-flags (regex-group-count))
        0
        (do
          (println "unexpected refusal compiling /{s}/: {s}" body (rxc-refusal))
          (assert false)
          0))
    0))

(defn regex-refuses [(body (slice u8)) (flags (slice u8)) (program-flags i64)] (-> i64)
  (do
    (regex-ok body flags)
    (if (regex-compile! body program-flags (regex-group-count))
        (do
          (println "unexpected compile of /{s}/{s}" body flags)
          (assert false)
          0)
        0)
    0))

(deftest regex_compiles_literals_into_char_instructions
         (regex-program "abc" "" 0)
         ;; SAVE 0 | CHAR a | CHAR b | CHAR c | SAVE 1 | MATCH
         (assert-eq (rxp-length) 11)
         (assert-eq (rxp-word-at 0) RXOP-SAVE)
         (assert-eq (rxp-word-at 1) 0)
         (assert-eq (rxp-word-at 2) RXOP-CHAR)
         (assert-eq (rxp-word-at 3) 97)
         (assert-eq (rxp-word-at 4) RXOP-CHAR)
         (assert-eq (rxp-word-at 5) 98)
         (assert-eq (rxp-word-at 8) RXOP-SAVE)
         (assert-eq (rxp-word-at 9) 1)
         (assert-eq (rxp-word-at 10) RXOP-MATCH))

;; `.` takes the `s` flag's form only when the program carries RXFLAG-DOT-ALL, and `^`/`$` are
;; their own instructions rather than a class.
(deftest regex_compiles_dot_and_the_anchors
         (regex-program "^.$" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-BOL)
         (assert-eq (rxp-word-at 3) RXOP-ANY)
         (assert-eq (rxp-word-at 4) RXOP-EOL)
         (regex-program "." "" RXFLAG-DOT-ALL)
         (assert-eq (rxp-word-at 2) RXOP-ANY-NL))

;; A class is one CLASS instruction over a range table; `\d` and `\w` expand into ranges there
;; rather than giving the matcher a second vocabulary.
(deftest regex_compiles_classes_into_ranges
         (regex-program "[a-z0-9_]" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-CLASS)
         (let [at (rxp-word-at 3)]
           (assert (not (rxp-class-negated? at)))
           (assert-eq (rxp-class-count at) 3)
           (assert-eq (rxp-class-lo at 0) 97)
           (assert-eq (rxp-class-hi at 0) 122)
           (assert-eq (rxp-class-lo at 1) 48)
           (assert-eq (rxp-class-hi at 1) 57)
           (assert-eq (rxp-class-lo at 2) 95)
           (assert-eq (rxp-class-hi at 2) 95))
         (regex-program "[^a]" "" 0)
         (assert (rxp-class-negated? (rxp-word-at 3)))
         (regex-program "\\d" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-CLASS)
         (let [digits (rxp-word-at 3)]
           (assert-eq (rxp-class-count digits) 1)
           (assert-eq (rxp-class-lo digits 0) 48)
           (assert-eq (rxp-class-hi digits 0) 57))
         (regex-program "\\W" "" 0)
         (assert (rxp-class-negated? (rxp-word-at 3)))
         (assert-eq (rxp-class-count (rxp-word-at 3)) 4))

;; Greedy and lazy differ in ONE thing: which operand of the SPLIT is the body. That is the whole
;; of greediness, and the matcher relies on it.
(deftest regex_compiles_greedy_and_lazy_quantifiers_as_split_order
         (regex-program "a*" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-SPLIT)
         ;; greedy: first operand is the body, which follows the SPLIT
         (assert-eq (rxp-word-at 3) 5)
         (regex-program "a*?" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-SPLIT)
         ;; lazy: the operands are the other way round
         (assert-eq (rxp-word-at 4) 5)
         ;; `a+` is the body once, then the same loop.
         (regex-program "a+" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-CHAR)
         (assert-eq (rxp-word-at 4) RXOP-SPLIT))

;; `a{2,3}` is the body twice, then one optional body behind a SPLIT — the bounded form is
;; re-emitted from source, never copied and relocated.
(deftest regex_compiles_bounded_quantifiers_by_re_emitting_the_body
         (regex-program "a{2,3}" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-CHAR)
         (assert-eq (rxp-word-at 3) 97)
         (assert-eq (rxp-word-at 4) RXOP-CHAR)
         (assert-eq (rxp-word-at 5) 97)
         (assert-eq (rxp-word-at 6) RXOP-SPLIT)
         (assert-eq (rxp-word-at 9) RXOP-CHAR)
         (regex-program "a{2}" "" 0)
         ;; SAVE 0 | CHAR a | CHAR a | SAVE 1 | MATCH
         (assert-eq (rxp-length) 9))

;; Alternation is ordered choice: SPLIT tries its first operand to exhaustion first, which is why
;; `/a|ab/` answers "a" and not the longest match.
(deftest regex_compiles_alternation_as_ordered_choice
         (regex-program "a|b" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-SPLIT)
         (assert-eq (rxp-word-at 3) 5)
         (assert-eq (rxp-word-at 5) RXOP-CHAR)
         (assert-eq (rxp-word-at 7) RXOP-JMP))

;; A capturing group brackets its body with the SAVE pair for its slots; `(?:` has no slots.
(deftest regex_compiles_capturing_groups_into_save_pairs
         (regex-program "(a)(b)" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-SAVE)
         (assert-eq (rxp-word-at 3) 2)
         (assert-eq (rxp-word-at 6) RXOP-SAVE)
         (assert-eq (rxp-word-at 7) 3)
         (assert-eq (rxp-word-at 8) RXOP-SAVE)
         (assert-eq (rxp-word-at 9) 4)
         (regex-program "(?:ab)" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-CHAR)
         (assert-eq (rxp-length) 9)
         ;; SAVE 0 | SAVE 2 | CHAR a | SAVE 3 | BACKREF 1 | SAVE 1 | MATCH
         (regex-program "(a)\\1" "" 0)
         (assert-eq (rxp-word-at 6) RXOP-SAVE)
         (assert-eq (rxp-word-at 7) 3)
         (assert-eq (rxp-word-at 8) RXOP-BACKREF)
         (assert-eq (rxp-word-at 9) 1))

;; `\b` and `\B` are the same instruction with the flag that distinguishes them.
(deftest regex_compiles_word_boundaries
         (regex-program "\\bx\\B" "" 0)
         (assert-eq (rxp-word-at 2) RXOP-WORDB)
         (assert-eq (rxp-word-at 3) 0)
         (assert-eq (rxp-word-at 6) RXOP-WORDB)
         (assert-eq (rxp-word-at 7) 1))

;; What this stage does not compile it REFUSES, so the caller keeps refusing the pattern by name.
;; Compiling one of these to an approximation would answer a wrong match instead of stopping.
(deftest regex_refuses_what_it_cannot_yet_compile
         (regex-refuses "(?=a)" "" 0)
         (regex-refuses "(?!a)" "" 0)
         (regex-refuses "(?<=a)" "" 0)
         (regex-refuses "(?<n>a)" "" 0)
         (regex-refuses "a" "" RXFLAG-IGNORE-CASE)
         (regex-refuses "a" "" RXFLAG-UNICODE)
         (regex-refuses "[\\D]" "" 0))
