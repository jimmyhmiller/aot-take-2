         (regex-bad "[^^^]" "v")
         (regex-bad "[_^^]" "v")
         (regex-bad "[a&&b--c]" "v")
         (regex-bad "[a--b&&c]" "v")
         (regex-bad "[a&&b c]" "v")
         (regex-bad "[ab&&c]" "v")
         (regex-bad "[a&&&b]" "v")
