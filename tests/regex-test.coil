(deftest regex_class_set_grammar_admits_operators_and_rejects_reserved_syntax
         (regex-ok "[a-z&&[^aeiou]]" "v")
         (regex-ok "[\\p{L}--[a-z]]" "v")
         (regex-ok "[[a-z]--b--c]" "v")
