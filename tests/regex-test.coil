;; Regular-expression pattern early errors: the strict (`u`), web-compat (no flag) and class-set

;; (`v`) grammars each admit and reject exactly what ECMA-262 §22.2.1 and Annex B.1.2 say.
(module aot.tests.regex)
(import "coil.assert" :use *)
(import "aot.parse.regex" :use *)
(import "aot.parse.regex.program" :use *)
(import "aot.parse.regex.compile" :use *)

(defn regex-ok [(body (slice u8)) (flags (slice u8))] (-> i64)
  (match (regex-validate body flags)
    (RegexOk [] 0)
    (RegexError [m]
                (do
                  (println "unexpected error for /{s}/{s}: {s}" body flags m)
                  (assert false)
                  0))
    (RegexUnknown [m]
                  (do
                    (println "unexpected unknown for /{s}/{s}: {s}"
                             body
                             flags
                             m)
                    (assert false)
                    0))))

(defn regex-bad [(body (slice u8)) (flags (slice u8))] (-> i64)
  (match (regex-validate body flags)
    (RegexError [m] 0)
    (RegexOk []
             (do
               (println "unexpected accept for /{s}/{s}" body flags)
               (assert false)
               0))
    (RegexUnknown [m]
                  (do
                    (println "unexpected unknown for /{s}/{s}: {s}"
                             body
                             flags
                             m)
                    (assert false)
                    0))))

(defn regex-unknown [(body (slice u8)) (flags (slice u8))] (-> i64)
  (match (regex-validate body flags)
    (RegexUnknown [m] 0)
    (RegexOk []
             (do
               (println "unexpected accept for /{s}/{s}" body flags)
               (assert false)
               0))
    (RegexError [m]
                (do
                  (println "unexpected error for /{s}/{s}: {s}" body flags m)
                  (assert false)
                  0))))

(deftest regex_common_grammar_accepts_ordinary_patterns_in_every_mode
         (regex-ok "a" "")
         (regex-ok "a" "u")
         (regex-ok "a" "v")
         (regex-ok "^ab*c+d?e{2}f{2,}g{2,3}h*?$" "")
         (regex-ok "^ab*c+d?e{2}f{2,}g{2,3}h*?$" "u")
         (regex-ok "a|b|" "u")
         (regex-ok "(a)(?:b)(?=c)(?!d)(?<=e)(?<!f)" "u")
         (regex-ok "(a)\\1" "")
         (regex-ok "(a)\\1" "u")
         (regex-ok "\\d\\D\\s\\S\\w\\W\\b\\B\\f\\n\\r\\t\\v\\0\\cA\\x41\\u0041"
                   "u")
         (regex-ok "[abc][^abc][a-z][\\d\\w][-a][a-]" "u")
         (regex-ok "[\\b]" "u")
         (regex-ok "(?<name>a)\\k<name>" "")
         (regex-ok "(?<name>a)\\k<name>" "u")
         (regex-ok "(?<$_a1>a)" "u")
         (regex-ok "(?<\\u0061>a)\\k<a>" "")
         (regex-ok "(?<a>x)|(?<a>y)" "u")
         (regex-ok "(?:(?<a>x)|(?<a>y))\\k<a>" "u")
         (regex-ok "(?i:a)(?-i:b)(?ims:c)(?i-m:d)" "u")
         (regex-ok "\\u{1F600}\\uD83D\\uDE00[\\uD83D\\uDE00-\\uD83D\\uDE01]"
                   "u")
         (regex-ok "\\p{L}\\P{Lu}\\p{Script=Latin}\\p{sc=Latn}\\p{scx=Grek}\\p{gc=Nd}\\p{ASCII}\\p{Any}"
                   "u")
         (regex-ok "\\p{General_Category=Letter}\\p{Script_Extensions=Garay}\\p{Script=Tai_Yo}"
                   "u")
         (regex-ok "\\/\\.\\*\\[\\]\\{\\}\\(\\)\\|\\^\\$\\?\\+\\\\" "u")
         (regex-ok ".{1000000000000000000000}" "u"))

(deftest regex_web_compat_grammar_admits_annex_b_extensions
         (regex-ok "]" "")
         (regex-ok "}" "")
         (regex-ok "{" "")
         (regex-ok "a{" "")
         (regex-ok "a{1" "")
         (regex-ok "a{,1}" "")
         (regex-ok "{a}" "")
         (regex-ok "\\8\\9\\1\\377\\400" "")
         (regex-ok "\\c" "")
         (regex-ok "\\c1" "")
         (regex-ok "[\\c1\\c_]" "")
         (regex-ok "\\M\\-\\k\\p\\u\\x\\u{1}" "")
         (regex-ok "\\u{" "")
         (regex-ok "[\\d-a][a-\\d][\\s-\\d]" "")
         (regex-ok ".(?=.)?.(?!.){2,3}" "")
         (regex-ok "[[]" "")
         (regex-ok "\\00\\01" ""))

(deftest regex_common_early_errors_are_rejected_in_every_mode
         (regex-bad "?" "")
         (regex-bad "*" "")
         (regex-bad "+a" "")
         (regex-bad "a**" "")
         (regex-bad "a*?*" "")
         (regex-bad "^*" "")
         (regex-bad "\\b+" "")
         (regex-bad "{2}" "")
         (regex-bad "{2,}" "")
         (regex-bad "{2,3}" "")
         (regex-bad "a{2}{3}" "")
         (regex-bad "a{2,1}" "")
         (regex-bad "a{2,1}" "u")
         (regex-bad "(" "")
         (regex-bad ")" "")
         (regex-bad "(a" "u")
         (regex-bad "a)" "u")
         (regex-bad "[a" "")
         (regex-bad "[z-a]" "")
         (regex-bad "[z-a]" "u")
         (regex-bad "a\\" "")
         (regex-bad "(?a)" "")
         (regex-bad "(?<a)" "")
         (regex-bad ".(?<=.)?" "")
         (regex-bad ".(?<!.){2,3}" "")
         (regex-bad ".(?<=.)?" "u"))

(deftest regex_strict_grammar_rejects_what_web_compat_tolerates
         (regex-bad "{" "u")
         (regex-bad "}" "u")
         (regex-bad "]" "u")
         (regex-bad "a{" "u")
         (regex-bad "\\M" "u")
         (regex-bad "\\-" "u")
         (regex-bad "\\1" "u")
         (regex-bad "\\8" "u")
         (regex-bad "\\00" "u")
         (regex-bad "\\c0" "u")
         (regex-bad "\\c" "u")
         (regex-bad "\\x4" "u")
         (regex-bad "\\u004" "u")
         (regex-bad "\\u{110000}" "u")
         (regex-bad "\\u{1,}" "u")
         (regex-bad "\\u{1F_639}" "u")
         (regex-bad "\\u{}" "u")
         (regex-bad "[\\d-a]" "u")
         (regex-bad "[\\s-\\d]" "u")
         (regex-bad "[%-\\d]" "u")
         (regex-bad "[--\\d]" "u")
