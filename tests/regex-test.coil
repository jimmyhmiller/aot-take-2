         (regex-ok "[\\q{abc|d|}]" "v")
         (regex-ok "[^\\q{a|b}]" "v")
         (regex-ok "[\\q{ab}&&\\q{ab|c}]" "v")
         (regex-ok "[\\q{ab}--\\q{c}]" "v")
         (regex-ok "[\\&\\-\\!\\#\\%\\,\\:\\;\\<\\=\\>\\@\\`\\~]" "v")
         (regex-ok "[a-z0-9_.]" "v")
         (regex-ok "[]" "v")
         (regex-ok "[^]" "v")
         (regex-ok "[[]]" "v")
         (regex-ok "[\\d\\w[\\s]]" "v")
         (regex-bad "[(]" "v")
         (regex-bad "[)]" "v")
         (regex-bad "[[]" "v")
         (regex-bad "[{]" "v")
         (regex-bad "[}]" "v")
         (regex-bad "[/]" "v")
         (regex-bad "[-]" "v")
         (regex-bad "[|]" "v")
         (regex-bad "[&&]" "v")
         (regex-bad "[!!]" "v")
