(deftest regex_named_groups_and_modifiers_have_their_own_early_errors
         (regex-bad "(?<a>a)(?<a>a)" "")
         (regex-bad "(?<a>a)(?<b>b)(?<a>a)" "")
         (regex-bad "(?<a>a)|(?<b>b)(?<a>a)(?<a>c)" "u")
         (regex-bad "(?<a>.)\\k<b>" "")
         (regex-bad "(?<a>.)\\k<>" "u")
         (regex-bad "(?<a>.)\\k" "")
         (regex-bad "(?<a:>a)" "")
         (regex-bad "(?<>a)" "")
         (regex-bad "(?<1a>a)" "")
         (regex-bad "(?<a\\uD801>.)" "u")
         (regex-bad "(?<\\uD801>.)" "")
         (regex-bad "(?<a\\u{110000}>.)" "")
         (regex-bad "(?<a\\x41>.)" "")
         (regex-unknown "(?<❤>a)" "")
         (regex-unknown "(?<$❞>a)" "")
         (regex-unknown "(?<𝒜>a)" "")
         (regex-bad "(?i-i:a)" "")
         (regex-bad "(?ims-m:a)" "")
         (regex-bad "(?-:a)" "")
         (regex-bad "(?ii:a)" "")
         (regex-ok "(?i-:a)" "")
         (regex-ok "(?-i:a)" "")
         (regex-bad "(?\\u{0073}-s:a)" "")
         (regex-bad "(?i a)" "")
         (regex-bad "(?ix:a)" "")
         (regex-bad "(?i" ""))

