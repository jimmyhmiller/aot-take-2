(defn grouped-layout-scaling-check [(nested bool)] (-> i64)
  (boot! 1)
  (let [root (start-make (ty-int-bot))
        (mut heads) (al-new [i64] (compiler-allocator))
        (mut blocks) (al-new [i64] (compiler-allocator))
        (mut parent) (n-nid root)
        (mut i) 0]
    (n-set-ltree-head! root (n-nid root))
    (loop (if (= (load i) 512)
              (break 0)
              (let [head (cproj-make root 0 "layout.scaling")]
                (n-set-ltree-head! head (n-nid head))
                (n-set-ltree-parent! head
                                     (if nested (load parent) (n-nid root)))
                (push! [i64] (mut heads) (n-nid head))
                (set! (mut parent) (n-nid head))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; Discover the deepest parent chain before any ancestor block appears.
    (set! (mut i) 511)
    (loop (if (< (load i) 0)
              (break 0)
              (do
                (push! [i64] (mut blocks) (get (load heads) (load i)))
                (set! (mut i) (- (load i) 1))
                (continue))))
    (push! [i64] (mut blocks) (n-nid root))
    (let [(mut ordered) (enc-layout-grouped-order (n-nid root) (load blocks))]
      (assert-eq (len (load ordered)) 513)
      (set! (mut i) 0)
      (loop (if (= (load i) 513)
                (break 0)
                (do
                  (assert-eq (get (load ordered) (load i))
                             (get (load blocks) (load i)))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (assert-eq (.blocks (enc-layout-stats)) 513)
      (assert-eq (.containers (enc-layout-stats)) 512)
      (assert-eq (.tokens (enc-layout-stats)) 1026)
      (al-free! (mut ordered)))
    (al-free! (mut heads))
    (al-free! (mut blocks))
    0))

(deftest grouped_layout_visits_nested_containers_once
         (grouped-layout-scaling-check true))

(deftest grouped_layout_visits_sibling_containers_once
         (grouped-layout-scaling-check false))

(deftest symbolic_identities_load_realm_maps_with_typed_slot_relocations
         (boot! 1)
         (let [key (shape-key-intern "x")
               shape (shape-transition SHAPE-EMPTY "x")
               k (arm64-select (keyref-make key))
               s (arm64-select (shaperef-make shape))]
           (n-set-reg! k ARM-X0)
           (n-set-reg! s ARM-X1)
           (enc-reset!)
           (m-encoding (encode-test-mach k) ENCODER-HANDLE)
           (m-encoding (encode-test-mach s) ENCODER-HANDLE)
           (assert-eq (enc-byte-count) 56)
           (assert-eq (m-size (encode-test-mach k)) 28)
           (assert-eq (enc-read4 0)
                      (| 0xf9400380
                         (primitive/ishl (/ RT-HEAP-OFFSET-UNIT-KEYS 8) 10)))
           (assert-eq (enc-read4 4) 0xd2800010)
           (assert-eq (enc-read4 8) 0xf2a00010)
           (assert-eq (enc-read4 12) 0xf8707800)
           (assert-eq (enc-read4 16) (| 0xd2800010 (primitive/ishl key 5)))
           (assert-eq (enc-read4 20) 0xf2a00010)
           (assert-eq (enc-read4 24) 0xf8707800)
           (assert-eq (enc-read4 28)
                      (| 0xf9400381
                         (primitive/ishl (/ RT-HEAP-OFFSET-UNIT-SHAPES 8) 10)))
           (assert-eq (enc-read4 40) 0xf8707821)
           (assert-eq (enc-read4 44) (| 0xd2800010 (primitive/ishl shape 5)))
           (assert-eq (enc-read4 52) 0xf8707821)
           (assert-eq (len (.unit-sites (enc-state))) 2)
           (let [ks (get (.unit-sites (enc-state)) 0)
                 ss (get (.unit-sites (enc-state)) 1)]
             (assert-eq (.kind ks) ENC-UNIT-KEY)
             (assert-eq (.local-id ks) key)
             (assert-eq (.kind ss) ENC-UNIT-SHAPE)
             (assert-eq (.local-id ss) shape)
             (assert-eq (.offset ks) 4)
             (assert-eq (.offset ss) 32))))

(deftest a_graph_leaf_process_entry_saves_lr_for_its_implicit_runtime_bootstrap_call
         (boot! 1)
         (let [start (start-make (ty-int-bot))
               ideal
                 (fun-make start
                           (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot))
                           "main")
               selected (arm64-select ideal)]
           (assert-eq (arm64-fun-finalize-frame! selected ARM-MAX-REG false) 32)
           (assert (arm64-fun-has-calls? selected))
           (enc-reset!)
           (m-encoding (encode-test-call-mach selected) ENCODER-HANDLE)
           (assert-eq (enc-read4 0) 0xd10083ff)
           (assert-eq (enc-read4 4) 0xf9000bfe)
           (assert-eq (enc-read4 8) 0xf9000ffc)
           (assert-eq (enc-read4 12) 0x94000000)))

(deftest static_addresses_load_the_realm_object_map_and_record_only_the_slot_relocation
         (boot! 1)
         (heap-add-object! DYNAMIC-NULL-WORD)
         (let [entry (heap-add-object! DYNAMIC-NULL-WORD)
               selected (arm64-select (staticref-make entry REP-OBJECT))]
           (n-set-reg! selected ARM-X0)
           (heap-image-build!)
           (enc-reset!)
           (m-encoding (encode-test-mach selected) ENCODER-HANDLE)
           (assert-eq (enc-byte-count) 36)
           (assert-eq (enc-read4 0)
                      (| 0xf9400380
                         (primitive/ishl (/ RT-HEAP-OFFSET-UNIT-OBJECTS 8) 10)))
           (assert-eq (enc-read4 4) 0xd2800010)
           (assert-eq (enc-read4 8) 0xf2a00010)
           (assert-eq (enc-read4 12) 0xf8707800)
           (assert-eq (enc-read4 16) (| 0xd2800010 (primitive/ishl entry 5)))
           (assert-eq (enc-read4 32) 0xf8707800)
           (assert-eq (enc-symbol-fixup-count) 0)
           (assert-eq (len (.unit-sites (enc-state))) 1)
           (let [site (get (.unit-sites (enc-state)) 0)]
             (assert-eq (.offset site) 4)
             (assert-eq (.local-id site) entry))))

(defn encode-test-mach [(n (dyn NodeOps))] (-> (dyn MachNode))
  (match (mach-of n)
    (Some [mach] mach)
    (None []
          (do
            (assert false)
            (primitive/make-dyn MachNode (arm64-scalar-node n))))))

(defn encode-test-call-mach [(n (dyn NodeOps))] (-> (dyn MachNode))
  (primitive/make-dyn MachNode (arm64-call-node n)))

(defn encode-test--assert-dynamic-prefix [(tag i64)
                                          (prefix i64)
                                          (movz-word i64)] (-> i64)
  (let [value (con-make (ty-dyn TAG-ANY))
        test (arm64-select (typetest-make value tag))]
    (n-set-reg! value ARM-X1)
    (n-set-reg! test ARM-X0)
    (assert-eq (.imm (arm64-scalar-node test)) prefix)
    (assert-eq (m-size (encode-test-mach test)) 16)
    (enc-reset!)
    (m-encoding (encode-test-mach test) ENCODER-HANDLE)
    (assert-eq (enc-byte-count) 16)
    (assert-eq (enc-read4 0) 0xd370fc20)
    (assert-eq (enc-read4 4) movz-word)
    (assert-eq (enc-read4 8) 0xeb10001f)
    (assert-eq (enc-read4 12) 0x9a9f17e0)
    0))

(deftest arm64_add_immediate_emits_the_exact_little_endian_word
         (do
           (boot! 1)
           (let [lhs (con-make (ty-int-con 5000))
                 add (add-make-mode lhs (con-make (ty-int-con 7)) MODE-INT)
                 selected (arm64-select add)]
             (n-set-reg! lhs ARM-X1)
             (n-set-reg! selected ARM-X0)
             (enc-reset!)
             (m-encoding (encode-test-mach selected) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 4)
             (assert-eq (enc-read4 0) 0x91001c20))))

(deftest arm64_integer_constants_use_minimal_mov_wide_sequences
         (do
           (boot! 1)
           (let [selected (arm64-select (con-make (ty-int-con 0x12345678)))]
             (n-set-reg! selected 3)
             (assert-eq (m-size (encode-test-mach selected)) 8)
             (enc-reset!)
             (m-encoding (encode-test-mach selected) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 8)
             (assert-eq (enc-read4 0) 0xd28acf03)
             (assert-eq (enc-read4 4) 0xf2a24683))))

(deftest arm64_integer_nan_boxing_and_unboxing_emit_the_exact_payload_operations
         (do
           (boot! 1)
           (let [raw (con-make (ty-int-range -17 29))
                 boxed (arm64-select (box-make raw))]
             (n-set-reg! raw ARM-X1)
             (n-set-reg! boxed ARM-X0)
             (assert-eq (m-size (encode-test-mach boxed)) 8)
             (enc-reset!)
             (m-encoding (encode-test-mach boxed) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0xb340bc20)
             (assert-eq (enc-read4 4) 0xf2efff20))
           (let [boxed-input (box-make (con-make (ty-int-con 9)))
                 raw (arm64-select (unbox-make boxed-input REP-INT))]
             (n-set-reg! boxed-input ARM-X1)
             (n-set-reg! raw ARM-X0)
             (assert-eq (m-size (encode-test-mach raw)) 4)
             (enc-reset!)
             (m-encoding (encode-test-mach raw) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0x9340bc20))))

(deftest arm64_object_nan_boxing_and_unboxing_emit_unsigned_payload_operations
