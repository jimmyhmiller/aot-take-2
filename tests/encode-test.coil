(deftest encoder_owner_queries_share_prefixes_and_invalidate_on_control_edits
         (boot! 1)
         (code-reset! 1)
         (let [start (start-make (ty-int-bot))
               first
                 (fun-make start
                           (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
                           "first")
               second
                 (fun-make start
                           (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
                           "second")
               pred (con-make (ty-int-bot))
               (mut blocks) (al-new [(dyn NodeOps)] (compiler-allocator))
               (mut ctrl) (load first)
               (mut i) 0]
           (loop (if (= (load i) 256)
                     (break 0)
                     (let [arms (if-arms! (if-make (load ctrl) pred))]
                       (set! (mut ctrl) (arms-true arms))
                       (push! [(dyn NodeOps)] (mut blocks) (load ctrl))
                       (set! (mut i) (+ (load i) 1))
                       (continue))))
           (enc-reset!)
           (al-for [block (load blocks)]
                   (assert (match (enc-find-enclosing-fun block)
                             (Some [owner] (n-same? owner first))
                             (None [] false))))
           (assert (< (enc-owner-walk-visits) 1024))
           (assert (n-same? (enc-enclosing-fun (load ctrl)) first))
           (n-set-def! (n-in! (get (load blocks) 0) 0) 0 (Some second))
           (assert (n-same? (enc-enclosing-fun (load ctrl)) second))
           (al-free! (mut blocks))))

(deftest finalized_frames_resize_and_encode_function_entry_and_return
         (do
           (boot! 1)
           (let [start (start-make (ty-int-bot))
                 fun
                   (fun-make start
                             (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
                             "framed")
                 ret
                   (return-make fun
                                (Some (con-make (ty-mem 1 TY-BOT)))
                                (con-make (ty-int-con 7))
                                (None [(dyn NodeOps)])
                                (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-fun (n-in! selected-ret RETURN-CTRL)]
               ;; A single eight-byte leaf spill still reserves sixteen bytes: AAPCS64 requires
               ;; every SP-relative memory access to observe a 16-byte-aligned stack pointer.
               (assert-eq (arm64-fun-finalize-frame! selected-fun 66 false) 16)
               (assert-eq (arm64-fun-finalize-frame! selected-fun 67 false) 16)
               (assert-eq (m-size (encode-test-call-mach selected-fun)) 4)
               (assert-eq (m-size (encode-test-call-mach selected-ret)) 8)
               (enc-reset!)
               (m-encoding (encode-test-call-mach selected-fun) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xd10043ff)
               (n-set-block-nid! selected-ret (n-nid selected-ret))
               (enc-reset!)
               (let [owner (enc-enclosing-fun selected-ret)
                     visits (enc-owner-walk-visits)]
                 (assert (n-same? owner selected-fun))
                 (assert (> visits 0))
                 (assert (n-same? (enc-enclosing-fun selected-ret) selected-fun))
                 (assert-eq (enc-owner-walk-visits) visits))
               (m-encoding (encode-test-call-mach selected-ret) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0x910043ff)
               (assert-eq (enc-read4 4) 0xd65f03c0)))))

(deftest selected_branch_data_edits_preserve_dominance_but_control_edits_invalidate_it
         (boot! 1)
         (let [start (start-make (ty-int-bot))
               other (start-make (ty-int-bot))
               branch (arm64-select (if-make start (con-make (ty-int-bot))))
               ideal-region (region-make)
               region
                 (do
                   (n-add-def! ideal-region (Some start))
                   (n-add-def! ideal-region (Some other))
                   (arm64-select ideal-region))
               version (cfg-edit-version)]
           ;; Single-node selection has input-only edges until the graph selector rebuilds outputs.
           (let [(mut i) 0]
             (loop (if (>= (load i) (n-nins branch))
                       (break 0)
                       (do
                         (match (n-in branch (load i))
                           (Some [input]
                                 (do (n-keep! input) (n-add-use! input branch)))
                           (None [] 0))
                         (set! (mut i) (+ (load i) 1))
                         (continue))))
             (set! (mut i) 0)
             (loop (if (>= (load i) (n-nins region))
                       (break 0)
                       (do
                         (match (n-in region (load i))
                           (Some [input]
                                 (do (n-keep! input) (n-add-use! input region)))
                           (None [] 0))
                         (set! (mut i) (+ (load i) 1))
                         (continue)))))
           (n-set-def! branch 1 (Some (con-make (ty-int-con 1))))
           (assert-eq (cfg-edit-version) version)
           (n-set-def! branch 0 (Some other))
           (assert (> (cfg-edit-version) version))
           (let [control-version (cfg-edit-version)]
             (n-set-def! region 1 (Some other))
             (assert (> (cfg-edit-version) control-version)))))

(deftest finalized_frames_materialize_adjustments_beyond_two_immediate_instructions
         (do
           (boot! 1)
           (let [start (start-make (ty-int-bot))
                 fun
                   (fun-make start
                             (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
                             "large-frame")
                 ret
                   (return-make fun
                                (Some (con-make (ty-mem 1 TY-BOT)))
                                (con-make (ty-int-con 7))
                                (None [(dyn NodeOps)])
                                (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-fun (n-in! selected-ret RETURN-CTRL)]
               ;; 2,097,152 slots is a 16MiB frame, one byte beyond the old two-immediate cap.
               (assert-eq (arm64-fun-finalize-frame! selected-fun 2097217 false)
                          16777216)
               (assert-eq (m-size (encode-test-call-mach selected-fun)) 8)
               (assert-eq (m-size (encode-test-call-mach selected-ret)) 12)
               (enc-reset!)
               (m-encoding (encode-test-call-mach selected-fun) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xd2a02010)
               (assert-eq (enc-read4 4) 0xcb3063ff)
               (n-set-block-nid! selected-ret (n-nid selected-ret))
               (enc-reset!)
               (m-encoding (encode-test-call-mach selected-ret) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xd2a02010)
               (assert-eq (enc-read4 4) 0x8b3063ff)
               (assert-eq (enc-read4 8) 0xd65f03c0)))))

(deftest macho_object_contains_arm64_text_symbols_and_branch_relocation
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun
                   (arm64-select (fun-make start
                                           (ty-tuple-of2 (ty-int-bot)
                                                         (ty-int-bot))
                                           "entry"))
                 source (call-make (con-make TY-CTRL))
                 call (arm64-call-alloc source false true 91 4)]
             (arm64-call-set-symbol! call "puts")
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun fun)
             (code-schedule-add! fun call)
             (code-schedule-end-block! fun)
             (assert-eq (enc-layout!) 4)
             (assert-eq (enc-emit!) 4)
             (enc-relocate!)
             (let [bytes (macho-bytes)]
               (assert-eq (len bytes) 290)
               (assert-eq (get bytes 0) (primitive/cast u8 0xcf))
               (assert-eq (get bytes 1) (primitive/cast u8 0xfa))
               (assert-eq (get bytes 2) (primitive/cast u8 0xed))
               (assert-eq (get bytes 3) (primitive/cast u8 0xfe))
               (assert-eq (get bytes 232) (primitive/cast u8 0x00))
               (assert-eq (get bytes 235) (primitive/cast u8 0x94))
               ;; relocation_info: address zero; external PC-relative 32-bit BRANCH26 to symbol 1.
               (assert-eq (get bytes 240) (primitive/cast u8 0x01))
               (assert-eq (get bytes 243) (primitive/cast u8 0x2d))
               ;; Defined `_entry` is N_SECT|N_EXT in section one; `_puts` is undefined external.
               (assert-eq (get bytes 248) (primitive/cast u8 0x0f))
               (assert-eq (get bytes 249) (primitive/cast u8 0x01))
               (assert-eq (get bytes 264) (primitive/cast u8 0x01))
               (assert-eq (macho-write "/tmp/aot-take-2-macho-test.o")
                          (len bytes)))
             (let [bytes (elf-bytes)]
               (assert-eq (len bytes) 632)
               (assert-eq (get bytes 0) (primitive/cast u8 0x7f))
               (assert-eq (get bytes 1) (primitive/cast u8 0x45))
               (assert-eq (get bytes 2) (primitive/cast u8 0x4c))
               (assert-eq (get bytes 3) (primitive/cast u8 0x46))
               (assert-eq (get bytes 64) (primitive/cast u8 0x00))
               (assert-eq (get bytes 67) (primitive/cast u8 0x94))
               ;; RELA r_info names symbol three and R_AARCH64_CALL26 (283).
               (assert-eq (get bytes 80) (primitive/cast u8 0x1b))
               (assert-eq (get bytes 81) (primitive/cast u8 0x01))
               (assert-eq (get bytes 84) (primitive/cast u8 0x03))
               (assert-eq (get bytes 148) (primitive/cast u8 0x12))
               (assert-eq (get bytes 172) (primitive/cast u8 0x10))
               (assert-eq (elf-write "/tmp/aot-take-2-elf-test.o") (len bytes))))))

(defn encode-test-read-le [(bytes (slice u8)) (offset i64) (width i64)] (-> i64)
  (let [(mut i) 0 (mut value) 0]
    (loop (if (= (load i) width) (break (load value))
              (do (set! (mut value)
                        (| (load value)
                           (primitive/ishl (primitive/cast i64 (get bytes (+ offset (load i))))
                                           (* 8 (load i)))))
                  (set! (mut i) (+ (load i) 1)) (continue))))))

(deftest private_function_entries_have_local_symbols_and_matching_relocations
         (boot! 1)
         (code-reset! 1)
         (let [start (start-make (ty-int-bot))
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               public (arm64-select (fun-make start sig "public"))
               original (fun-make start sig ".aot.version.test")]
           (set! (.version-entry (primitive/cast (ptr FunNode) (hdr original))) true)
           (let [private (arm64-select original)
                 source (call-make (con-make TY-CTRL))
                 invoke (arm64-call-alloc source false true 42 4)]
             (arm64-call-set-fidx! public 41)
             (arm64-call-set-fidx! private 42)
             (arm64-call-set-symbol! invoke ".aot.version.test")
             (push! [i64] (mut (.cfg (code))) (n-nid public))
             (push! [i64] (mut (.cfg (code))) (n-nid private))
             (code-schedule-reset!)
             (code-schedule-begin-block! public)
             (code-schedule-add! public public)
             (code-schedule-add! public invoke)
             (code-schedule-end-block! public)
             (code-schedule-begin-block! private)
             (code-schedule-add! private private)
             (code-schedule-end-block! private)
             (let [size (enc-layout!)] (assert-eq (enc-emit!) size))
             (enc-relocate!)
             (let [bytes (macho-bytes)
                   symoff (encode-test-read-le bytes 192 4)
                   reloff (encode-test-read-le bytes 160 4)]
               ;; Encoder order is public then private. The relocation names the private
               ;; N_SECT definition, which must not export a colliding version name.
               (assert-eq (get bytes (+ reloff 4)) (primitive/cast u8 1))
               (assert-eq (get bytes (+ symoff 4)) (primitive/cast u8 0x0f))
               (assert-eq (get bytes (+ symoff 20)) (primitive/cast u8 0x0e)))
             (let [bytes (elf-bytes) shoff (encode-test-read-le bytes 40 8)
                   symoff (encode-test-read-le bytes (+ shoff (+ (* 3 64) 24)) 8)
                   reloff (encode-test-read-le bytes (+ shoff (+ (* 2 64) 24)) 8)]
               ;; ELF permutes locals before globals. Both the relocation and sh_info must
               ;; follow that order, not the encoder's original definition indices.
               (assert-eq (get bytes (+ reloff 12)) (primitive/cast u8 2))
               (assert-eq (get bytes (+ symoff (+ (* 2 24) 4))) (primitive/cast u8 0x02))
               (assert-eq (get bytes (+ symoff (+ (* 3 24) 4))) (primitive/cast u8 0x12))
               (assert-eq (get bytes (+ shoff (+ (* 3 64) 44))) (primitive/cast u8 3))))))

(defn encode-test--cset-word [(op i64) (mode i64) (lhs-ty i64) (rhs-ty i64)] (-> i64)
  (let [lhs (con-make lhs-ty)
        rhs (con-make rhs-ty)
        _ (assert (and (ty-constant? lhs-ty) (ty-constant? rhs-ty)))
        selected (arm64-select-graph (cmp--make op lhs rhs mode))
        flags (n-in! selected 1)]
    (n-set-reg! lhs (if (= mode MODE-FLT) (+ ARM-D0 1) (+ ARM-X0 1)))
    (n-set-reg! rhs (if (= mode MODE-FLT) (+ ARM-D0 2) (+ ARM-X0 2)))
    (n-set-reg! selected ARM-X0)
    (enc-reset!)
    (m-encoding (encode-test-mach selected) ENCODER-HANDLE)
    (assert-eq (enc-byte-count) 4)
    (enc-read4 0)))

(deftest arm64_float_comparisons_use_unordered_false_condition_codes
         (do
           (boot! 1)
           ;; CSET Xd,cond is CSINC with the INVERTED code in bits 12..15. Integer `<` inverts LT to
           ;; GE (10); floating `<` must invert MI to PL (5) so a NaN operand yields false. Integer
           ;; `<=` inverts LE to GT (12); floating `<=` inverts LS to HI (8).
           (assert-eq (encode-test--cset-word OP-LT
                                              MODE-INT
                                              (ty-int-con 7)
                                              (ty-int-con 9))
                      0x9a9fa7e0)
           (assert-eq (encode-test--cset-word OP-LE
                                              MODE-INT
                                              (ty-int-con 7)
                                              (ty-int-con 9))
                      0x9a9fc7e0)
           (assert-eq (encode-test--cset-word OP-LT
                                              MODE-FLT
                                              (ty-flt-con 1.5)
                                              (ty-flt-con 2.5))
                      0x9a9f57e0)
           (assert-eq (encode-test--cset-word OP-LE
                                              MODE-FLT
                                              (ty-flt-con 1.5)
                                              (ty-flt-con 2.5))
                      0x9a9f87e0)
           ;; Equality is unordered-safe in both modes: EQ inverts to NE (1).
           (assert-eq (encode-test--cset-word OP-EQ
                                              MODE-FLT
                                              (ty-flt-con 1.5)
                                              (ty-flt-con 2.5))
                      0x9a9f17e0)))

(deftest arm64_float_branches_use_mi_and_ls_instead_of_lt_and_le
         (do
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 lhs (con-make (ty-flt-con 1.5))
                 rhs (con-make (ty-flt-con 2.5))
                 cmp (cmp--make OP-LT lhs rhs MODE-FLT)
                 ideal-if (if-make ideal-start cmp)
                 taken (cproj-make ideal-if 0 "taken")
                 selected-taken (arm64-select-graph taken)
                 branch (n-in! selected-taken 0)
                 flags (n-in! branch 1)
                 fallthrough
                   (arm64-select (cproj-make ideal-if 1 "fallthrough"))]
             (n-set-reg! (n-in! flags 1) (+ ARM-D0 1))
             (n-set-reg! (n-in! flags 2) (+ ARM-D0 2))
             (set! (mut (.ins (hdr fallthrough))) 0 (Some branch))
             (n-add-use! branch fallthrough)
             (push! [i64] (mut (.cfg (code))) (n-nid start))
             (push! [i64] (mut (.cfg (code))) (n-nid fallthrough))
             (push! [i64] (mut (.cfg (code))) (n-nid selected-taken))
             (code-schedule-reset!)
             (code-schedule-begin-block! start)
             (code-schedule-add! start start)
             (code-schedule-add! start flags)
             (code-schedule-add! start branch)
             (code-schedule-end-block! start)
             (code-schedule-begin-block! fallthrough)
             (code-schedule-add! fallthrough fallthrough)
             (code-schedule-end-block! fallthrough)
             (code-schedule-begin-block! selected-taken)
             (code-schedule-add! selected-taken selected-taken)
             (code-schedule-end-block! selected-taken)
             (assert-eq (enc-layout!) 8)
             (assert-eq (enc-emit!) 8)
             (enc-relocate!)
             ;; FCMP D1,D2 then B.MI +4: condition MI (4), never the integer LT (11).
             (assert-eq (enc-read4 0) 0x1e622020)
             (assert-eq (enc-read4 4) 0x54000024))))
