             (assert-eq (enc-read4 0) 0x94000000)
             (assert-eq (enc-symbol-fixup-count) 1)
             (assert-eq (enc-symbol-fixup-kind 0) ENC-FIXUP-A64-BL26)
             (assert-eq (enc-symbol-fixup-fidx 0) 17)
             (assert-eq (enc-symbol-fixup-name 0) "callee"))
           (let [ctrl (con-make TY-CTRL)
                 target (con-make (ty-memptr false (ty-struct "IndirectCode")))
                 source (call-make ctrl)]
             (call-set-fptr! source target)
             (let [indirect (arm64-call-alloc source false false 0 4)]
               (n-set-reg! target 9)
               (enc-reset!)
