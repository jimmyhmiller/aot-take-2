                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "literals"))
                 first (arm64-select (con-make (ty-flt-con 1.5)))
                 second (arm64-select (con-make (ty-flt-con 1.5)))]
             (n-set-reg! first (+ ARM-D0 2))
             (n-set-reg! second (+ ARM-D0 3))
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
