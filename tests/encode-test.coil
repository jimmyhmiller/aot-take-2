;; Exact AArch64 instruction encoding and generic layout contracts.
(module aot.tests.encode)
(import "coil.assert" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.call" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.gc" :use *)
(import "aot.type.type" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.encoding" :use *)
(import "aot.codegen.objfile" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.codegen.regmask" :use *)
(import "aot.node.cpus.arm64" :use *)
(import "aot.node.cpus.arm64.base" :use *)
(import "aot.node.cpus.arm64.call" :use *)
(import "aot.node.cpus.arm64.branch" :use *)
(import "aot.node.cpus.arm64.split" :use *)

(defn encode-test-mach [(n (dyn NodeOps))] (-> (dyn MachNode))
  (match (mach-of n)
    (Some [mach] mach)
    (None [] (do (assert false) (primitive/make-dyn MachNode (arm64-scalar-node n))))))

(defn encode-test-call-mach [(n (dyn NodeOps))] (-> (dyn MachNode))
  (primitive/make-dyn MachNode (arm64-call-node n)))

(deftest arm64_add_immediate_emits_the_exact_little_endian_word
         (do
           (boot! 1)
           (let [lhs (con-make (ty-int-con 5000))
                 add (add-make-mode lhs (con-make (ty-int-con 7)) MODE-INT)
                 selected (arm64-select add)]
             (n-set-reg! lhs ARM-X1)
             (n-set-reg! selected ARM-X0)
             (enc-reset!)
             (m-encoding (encode-test-mach selected) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 4)
             (assert-eq (enc-read4 0) 0x91001c20))))

(deftest arm64_integer_constants_use_minimal_mov_wide_sequences
         (do
           (boot! 1)
           (let [selected (arm64-select (con-make (ty-int-con 0x12345678)))]
             (n-set-reg! selected 3)
             (assert-eq (m-size (encode-test-mach selected)) 8)
             (enc-reset!)
             (m-encoding (encode-test-mach selected) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 8)
             (assert-eq (enc-read4 0) 0xd28acf03)
             (assert-eq (enc-read4 4) 0xf2a24683))))

(deftest arm64_unary_minus_uses_the_dedicated_integer_and_float_encodings
         (do
           (boot! 1)
           (let [integer-input (con-make (ty-int-range 1 9))
                 integer-minus (arm64-select (minus-make-mode integer-input MODE-INT))]
             (n-set-reg! integer-input ARM-X1)
             (n-set-reg! integer-minus ARM-X0)
             (enc-reset!)
             (m-encoding (encode-test-mach integer-minus) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0xcb0103e0))
           (let [float-input (con-make (ty-flt 64))
                 float-minus (arm64-select (minus-make-mode float-input MODE-FLT))]
             (n-set-reg! float-input (+ ARM-D0 1))
             (n-set-reg! float-minus ARM-D0)
             (enc-reset!)
             (m-encoding (encode-test-mach float-minus) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0x1e614020))))

(deftest arm64_memory_encodes_scaled_and_signed_offsets_exactly
         (do
           (boot! 1)
           (let [ctrl (con-make TY-CTRL)
                 mem (con-make (ty-mem 7 (ty-int-bot)))
                 ptr (con-make (ty-memptr false (ty-struct "EncodedMemory")))
                 load_ (arm64-select
                         (load-make ctrl
                                    mem
                                    ptr
                                    (con-make (ty-int-con 24))
                                    7
                                    (ty-int-bot)))]
             (n-set-reg! ptr ARM-X1)
             (n-set-reg! load_ ARM-X0)
             (enc-reset!)
             (m-encoding (encode-test-mach load_) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0xf9400c20)
             (let [value (con-make (ty-int-range 1 9))
                   store (arm64-select
                           (store-make ctrl
                                       mem
                                       ptr
                                       (con-make (ty-int-con -8))
                                       value
                                       7
                                       (ty-int-bot)))]
               (n-set-reg! value 2)
               (enc-reset!)
               (m-encoding (encode-test-mach store) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xf81f8022)))))

(deftest arm64_splits_encode_register_moves_spills_and_reloads
         (do
           (boot! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "split-encode"))
                 value (arm64-select (con-make (ty-int-con 9)))
                 spill (arm64-split-make 1 "spill" 0)]
             (arm64-fun-finalize-frame! fun 66 false)
             (n-set-block-nid! fun (n-nid fun))
             (n-set-reg! value ARM-X0)
             (arm64-split-bind! spill fun value)
             (n-set-block-nid! spill (n-nid fun))
             (n-set-reg! spill 65)
             (enc-reset!)
             (m-encoding (encode-test-mach spill) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0xf90003e0)
             (let [stack-value (arm64-select (con-make (ty-int-con 11)))
                   reload (arm64-split-make 2 "reload" 0)]
               (n-set-reg! stack-value 65)
               (arm64-split-bind! reload fun stack-value)
               (n-set-block-nid! reload (n-nid fun))
               (n-set-reg! reload ARM-X1)
               (enc-reset!)
               (m-encoding (encode-test-mach reload) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xf94003e1))
             (let [move (arm64-split-make 3 "move" 0)]
               (arm64-split-bind! move fun value)
               (n-set-block-nid! move (n-nid fun))
               (n-set-reg! move ARM-X1)
               (enc-reset!)
               (m-encoding (encode-test-mach move) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xaa0003e1))
             (let [stack-value (arm64-select (con-make (ty-int-con 12)))
                   stack-copy (arm64-split-make 4 "stack-copy" 0)]
               (arm64-fun-finalize-frame! fun 67 false)
               (n-set-reg! stack-value 65)
               (arm64-split-bind! stack-copy fun stack-value)
               (n-set-block-nid! stack-copy (n-nid fun))
               (n-set-reg! stack-copy 66)
               (assert-eq (m-size (encode-test-mach stack-copy)) 8)
               (match (m-killmap (encode-test-mach stack-copy))
                 (Some [kills] (assert (mask-test kills ARM64-SPLIT-SCRATCH)))
                 (None [] (assert false)))
               (enc-reset!)
               (m-encoding (encode-test-mach stack-copy) ENCODER-HANDLE)
               (assert-eq (enc-byte-count) 8)
               (assert-eq (enc-read4 0) 0xf94003f0)
               (assert-eq (enc-read4 4) 0xf90007f0)))))

(deftest generic_layout_records_schedule_offsets_and_verifies_emitted_size
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "layout"))
                 lhs (con-make (ty-int-con 5000))
                 add (arm64-select
                       (add-make-mode lhs (con-make (ty-int-con 7)) MODE-INT))]
             (n-set-reg! lhs ARM-X1)
             (n-set-reg! add ARM-X0)
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun add)
             (code-schedule-end-block! fun)
             (assert-eq (enc-layout!) 4)
             (assert-eq (enc-op-start add) 0)
             (assert-eq (enc-op-length add) 4)
             (assert-eq (enc-emit!) 4)
             (assert-eq (enc-read4 0) 0x91001c20))))

(deftest local_fixups_patch_forward_conditional_and_backward_unconditional_branches
         (do
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 pred (con-make (ty-int-range 0 1))
                 ideal-if (if-make ideal-start pred)
                 branch (arm64-select ideal-if)
                 target (arm64-select (cproj-make ideal-if 0 "taken"))
                 fallthrough (arm64-select (cproj-make ideal-if 1 "fallthrough"))]
             (set! (mut (.ins (hdr target))) 0 (Some branch))
             (n-add-use! branch target)
             (set! (mut (.ins (hdr fallthrough))) 0 (Some branch))
             (n-add-use! branch fallthrough)
             (push! [i64] (mut (.cfg (code))) (n-nid start))
             (push! [i64] (mut (.cfg (code))) (n-nid fallthrough))
             (push! [i64] (mut (.cfg (code))) (n-nid target))
             (code-schedule-reset!)
             (code-schedule-begin-block! start)
             (code-schedule-add! start start)
             (code-schedule-add! start branch)
             (code-schedule-end-block! start)
             (code-schedule-begin-block! fallthrough)
             (code-schedule-add! fallthrough fallthrough)
             (code-schedule-end-block! fallthrough)
             (code-schedule-begin-block! target)
             (code-schedule-add! target target)
             (code-schedule-end-block! target)
             (assert-eq (enc-layout!) 4)
             (assert-eq (enc-emit!) 4)
             (assert-eq (enc-fixup-count) 1)
             (enc-relocate!)
             (assert-eq (enc-read4 0) 0x54000021))
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 target (arm64-select (cproj-make ideal-start 0 "target"))
                 jump (arm64-jump-make)
                 padding (arm64-select (con-make (ty-int-con 0)))
                 jump-block (arm64-select (cproj-make (start-make (ty-int-bot)) 0 "jump"))]
             (n-set-reg! padding ARM-X0)
             (set! (mut (.ins (hdr target))) 0 (Some jump))
             (n-add-use! jump target)
             (push! [i64] (mut (.cfg (code))) (n-nid target))
             (push! [i64] (mut (.cfg (code))) (n-nid jump-block))
             (code-schedule-reset!)
             (code-schedule-begin-block! target)
             (code-schedule-add! target target)
             (code-schedule-end-block! target)
             (code-schedule-begin-block! jump-block)
             (code-schedule-add! jump-block jump-block)
             (code-schedule-add! jump-block padding)
             (code-schedule-add! jump-block jump)
             (code-schedule-end-block! jump-block)
             (assert-eq (enc-layout!) 8)
             (assert-eq (enc-emit!) 8)
             (enc-relocate!)
             (assert-eq (enc-read4 4) 0x17ffffff))))

(deftest arm64_conditional_branch_relaxation_uses_an_inverted_skip_and_b26_veneer
         (do
           (assert (arm64-b19-fits? -1048576))
           (assert (arm64-b19-fits? 1048572))
           (assert (not (arm64-b19-fits? -1048580)))
           (assert (not (arm64-b19-fits? 1048576)))
           (assert (not (arm64-b19-fits? 2)))
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 pred (con-make (ty-int-range 0 1))
                 ideal-if (if-make ideal-start pred)
                 branch (arm64-select ideal-if)
                 target (arm64-select (cproj-make ideal-if 0 "taken"))
                 fallthrough (arm64-select (cproj-make ideal-if 1 "fallthrough"))]
             (set! (mut (.ins (hdr target))) 0 (Some branch))
             (n-add-use! branch target)
             (set! (mut (.ins (hdr fallthrough))) 0 (Some branch))
             (n-add-use! branch fallthrough)
             (push! [i64] (mut (.cfg (code))) (n-nid start))
             (push! [i64] (mut (.cfg (code))) (n-nid fallthrough))
             (push! [i64] (mut (.cfg (code))) (n-nid target))
             (code-schedule-reset!)
             (code-schedule-begin-block! start)
             (code-schedule-add! start start)
             (code-schedule-add! start branch)
             (code-schedule-end-block! start)
             (code-schedule-begin-block! fallthrough)
             (code-schedule-add! fallthrough fallthrough)
             (code-schedule-end-block! fallthrough)
             (code-schedule-begin-block! target)
             (code-schedule-add! target target)
             (code-schedule-end-block! target)
             (assert (arm64-layout-relax-branch! branch 1048576 0))
             (assert-eq (enc-layout!) 8)
             (assert-eq (enc-emit!) 8)
             (assert-eq (enc-fixup-count) 1)
             (enc-relocate!)
             (assert-eq (enc-read4 0) 0x54000040)
             (assert-eq (enc-read4 4) 0x14000001))))

(deftest block_layout_inverts_a_branch_when_its_taken_arm_is_the_fallthrough
         (do
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 pred (con-make (ty-int-range 0 1))
                 ideal-if (if-make ideal-start pred)
                 branch (arm64-select ideal-if)
                 taken (arm64-select (cproj-make ideal-if 0 "taken"))
                 fall (arm64-select (cproj-make ideal-if 1 "fall"))]
             (set! (mut (.ins (hdr taken))) 0 (Some branch))
             (n-add-use! branch taken)
             (set! (mut (.ins (hdr fall))) 0 (Some branch))
             (n-add-use! branch fall)
             (push! [i64] (mut (.cfg (code))) (n-nid start))
             (push! [i64] (mut (.cfg (code))) (n-nid taken))
             (push! [i64] (mut (.cfg (code))) (n-nid fall))
             (code-schedule-reset!)
             (code-schedule-begin-block! start)
             (code-schedule-add! start start)
             (code-schedule-add! start branch)
             (code-schedule-end-block! start)
             (code-schedule-begin-block! taken)
             (code-schedule-add! taken taken)
             (code-schedule-end-block! taken)
             (code-schedule-begin-block! fall)
             (code-schedule-add! fall fall)
             (code-schedule-end-block! fall)
             (assert-eq (enc-layout!) 4)
             (assert (arm64-branch-inverted? branch))
             (assert-eq (enc-emit!) 4)
             (enc-relocate!)
             (assert-eq (enc-read4 0) 0x54000020))))

(deftest block_layout_adds_a_jump_when_neither_branch_arm_is_adjacent
         (do
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 pred (con-make (ty-int-range 0 1))
                 ideal-if (if-make ideal-start pred)
                 branch (arm64-select ideal-if)
                 taken (arm64-select (cproj-make ideal-if 0 "taken"))
                 fall (arm64-select (cproj-make ideal-if 1 "fall"))
                 other-start (start-make (ty-int-bot))
                 other (arm64-select (cproj-make other-start 0 "other"))]
             (set! (mut (.ins (hdr taken))) 0 (Some branch))
             (n-add-use! branch taken)
             (set! (mut (.ins (hdr fall))) 0 (Some branch))
             (n-add-use! branch fall)
             (push! [i64] (mut (.cfg (code))) (n-nid start))
             (push! [i64] (mut (.cfg (code))) (n-nid other))
             (push! [i64] (mut (.cfg (code))) (n-nid fall))
             (push! [i64] (mut (.cfg (code))) (n-nid taken))
             (code-schedule-reset!)
             (code-schedule-begin-block! start)
             (code-schedule-add! start start)
             (code-schedule-add! start branch)
             (code-schedule-end-block! start)
             (code-schedule-begin-block! other)
             (code-schedule-add! other other)
             (code-schedule-end-block! other)
             (code-schedule-begin-block! fall)
             (code-schedule-add! fall fall)
             (code-schedule-end-block! fall)
             (code-schedule-begin-block! taken)
             (code-schedule-add! taken taken)
             (code-schedule-end-block! taken)
             (assert-eq (enc-layout!) 8)
             (assert (not (arm64-branch-inverted? branch)))
             (match (enc-layout-jump-at 0)
               (Some [_] 0)
               (None [] (assert false)))
             (assert-eq (enc-emit!) 8)
             (enc-relocate!)
             (assert-eq (enc-read4 0) 0x54000041)
             (assert-eq (enc-read4 4) 0x14000001))))

(deftest block_layout_splices_nested_loop_bodies_contiguously
         (do
           (boot! 1)
           (code-reset! 1)
           (let [root (arm64-select (start-make (ty-int-bot)))
                 loop-head (arm64-select (cproj-make (start-make (ty-int-bot)) 0 "loop"))
                 nested-head (arm64-select (cproj-make (start-make (ty-int-bot)) 0 "nested"))
                 exit (arm64-select (cproj-make (start-make (ty-int-bot)) 0 "exit"))
                 body (arm64-select (cproj-make (start-make (ty-int-bot)) 0 "body"))
                 nested-body
                   (arm64-select (cproj-make (start-make (ty-int-bot)) 0 "nested.body"))]
             (n-set-ltree-head! root (n-nid root))
             (n-set-ltree-head! loop-head (n-nid loop-head))
             (n-set-ltree-parent! loop-head (n-nid root))
             (n-set-ltree-head! nested-head (n-nid nested-head))
             (n-set-ltree-parent! nested-head (n-nid loop-head))
             (n-set-ltree-head! exit (n-nid root))
             (n-set-ltree-head! body (n-nid loop-head))
             (n-set-ltree-head! nested-body (n-nid nested-head))
             ;; Deliberately interleave the loop bodies with their outer exit. The layout projection
             ;; retains RPO within each tree level while splicing each child tree exactly once.
             (push! [i64] (mut (.cfg (code))) (n-nid root))
             (push! [i64] (mut (.cfg (code))) (n-nid loop-head))
             (push! [i64] (mut (.cfg (code))) (n-nid nested-head))
             (push! [i64] (mut (.cfg (code))) (n-nid exit))
             (push! [i64] (mut (.cfg (code))) (n-nid body))
             (push! [i64] (mut (.cfg (code))) (n-nid nested-body))
             (code-schedule-reset!)
             (let [(mut i) 0]
               (loop (if (>= (load i) (code-cfg-count))
                         (break 0)
                         (let [block (code-cfg-at (load i))]
                           (code-schedule-begin-block! block)
                           (code-schedule-add! block block)
                           (code-schedule-end-block! block)
                           (set! (mut i) (+ (load i) 1))
                           (continue)))))
             (assert-eq (enc-layout!) 0)
             (assert-eq (enc-layout-block-count) 6)
             (assert (n-same? (enc-layout-block-at 0) root))
             (assert (n-same? (enc-layout-block-at 1) loop-head))
             (assert (n-same? (enc-layout-block-at 2) nested-head))
             (assert (n-same? (enc-layout-block-at 3) nested-body))
             (assert (n-same? (enc-layout-block-at 4) body))
             (assert (n-same? (enc-layout-block-at 5) exit)))))

(deftest block_layout_uses_simples_preorder_tiebreak_before_choosing_fallthrough
         (do
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 pred (con-make (ty-int-range 0 1))
                 ideal-if (if-make ideal-start pred)
                 branch (arm64-select ideal-if)
                 taken (arm64-select (cproj-make ideal-if 0 "taken"))
                 fall (arm64-select (cproj-make ideal-if 1 "fall"))
                 root (n-nid start)]
             (set! (mut (.ins (hdr taken))) 0 (Some branch))
             (n-add-use! branch taken)
             (set! (mut (.ins (hdr fall))) 0 (Some branch))
             (n-add-use! branch fall)
             (n-set-ltree-head! start root)
             (n-set-ltree-head! branch root)
             (n-set-ltree-head! taken root)
             (n-set-ltree-head! fall root)
             (n-set-cfg-pre! taken 20)
             (n-set-cfg-pre! fall 10)
             ;; Raw order prefers false. Simple's final preorder tie-break says invert, so the
             ;; preference-aware RPO must place original true immediately after the If instead.
             (push! [i64] (mut (.cfg (code))) (n-nid start))
             (push! [i64] (mut (.cfg (code))) (n-nid fall))
             (push! [i64] (mut (.cfg (code))) (n-nid taken))
             (code-schedule-reset!)
             (code-schedule-begin-block! start)
             (code-schedule-add! start start)
             (code-schedule-add! start branch)
             (code-schedule-end-block! start)
             (code-schedule-begin-block! fall)
             (code-schedule-add! fall fall)
             (code-schedule-end-block! fall)
             (code-schedule-begin-block! taken)
             (code-schedule-add! taken taken)
             (code-schedule-end-block! taken)
             (assert-eq (enc-layout!) 4)
             (assert (n-same? (enc-layout-block-at 1) taken))
             (assert (arm64-branch-inverted? branch))
             (assert-eq (enc-emit!) 4)
             (enc-relocate!)
             (assert-eq (enc-read4 0) 0x54000020))))

(deftest float_constants_use_deduplicated_exact_bit_literal_pool_entries
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "literals"))
                 first (arm64-select (con-make (ty-flt-con 1.5)))
                 second (arm64-select (con-make (ty-flt-con 1.5)))]
             (n-set-reg! first (+ ARM-D0 2))
             (n-set-reg! second (+ ARM-D0 3))
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun fun)
             (code-schedule-add! fun first)
             (code-schedule-add! fun second)
             (code-schedule-end-block! fun)
             (assert-eq (enc-layout!) 8)
             (assert-eq (enc-emit!) 8)
             (assert-eq (enc-literal-count) 2)
             (enc-relocate!)
             (assert-eq (enc-byte-count) 16)
             (assert-eq (enc-read4 0) 0x5c000042)
             (assert-eq (enc-read4 4) 0x5c000023)
             (assert-eq (enc-read4 8) 0)
             (assert-eq (enc-read4 12) 0x3ff80000))))

(deftest calls_encode_direct_symbol_fixups_and_indirect_blr_exactly
         (do
           (boot! 1)
           (let [ctrl (con-make TY-CTRL)
                 source (call-make ctrl)
                 direct (arm64-call-alloc source false true 17 4)]
             (arm64-call-set-symbol! direct "callee")
             (enc-reset!)
             (m-encoding (encode-test-call-mach direct) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0x94000000)
             (assert-eq (enc-symbol-fixup-count) 1)
             (assert-eq (enc-symbol-fixup-kind 0) ENC-FIXUP-A64-BL26)
             (assert-eq (enc-symbol-fixup-fidx 0) 17)
             (assert-eq (enc-symbol-fixup-name 0) "callee"))
           (let [ctrl (con-make TY-CTRL)
                 target (con-make (ty-memptr false (ty-struct "IndirectCode")))
                 source (call-make ctrl)]
             (call-set-fptr! source target)
             (let [indirect (arm64-call-alloc source false false 0 4)]
               (n-set-reg! target 9)
               (enc-reset!)
               (m-encoding (encode-test-call-mach indirect) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xd63f0120)
               (assert-eq (enc-symbol-fixup-count) 0)))))

(deftest barriers_encode_a_typed_runtime_call_relocation
         (do
           (boot! 1)
           (let [obj (con-make (ty-memptr false (ty-struct "Owner")))
                 value (con-make (ty-memptr true (ty-struct "Value")))
                 barrier (barrier-make (con-make TY-CTRL)
                                       (con-make (ty-mem 9 (n-ty value)))
                                       obj
                                       value)
                 selected (arm64-select barrier)]
             (n-set-reg! obj ARM-X0)
             (n-set-reg! value ARM-X1)
             (enc-reset!)
             (m-encoding (encode-test-call-mach selected) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0x94000000)
             (assert-eq (enc-symbol-fixup-count) 1)
             (assert-eq (enc-symbol-fixup-kind 0) ENC-FIXUP-A64-BL26)
             (assert-eq (enc-symbol-fixup-fidx 0) -1)
             (assert-eq (enc-symbol-fixup-name 0) "aot_rt_write_barrier"))))

(deftest finalized_frames_resize_and_encode_function_entry_and_return
         (do
           (boot! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "framed")
                 ret (return-make fun
                                  (Some (con-make (ty-mem 1 TY-BOT)))
                                  (con-make (ty-int-con 7))
                                  (None [(dyn NodeOps)])
                                  (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-fun (n-in! selected-ret RETURN-CTRL)]
               (assert-eq (arm64-fun-finalize-frame! selected-fun 67 false) 16)
               (assert-eq (m-size (encode-test-call-mach selected-fun)) 4)
               (assert-eq (m-size (encode-test-call-mach selected-ret)) 8)
               (enc-reset!)
               (m-encoding (encode-test-call-mach selected-fun) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xd10043ff)
               (n-set-block-nid! selected-ret (n-nid selected-ret))
               (enc-reset!)
               (m-encoding (encode-test-call-mach selected-ret) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0x910043ff)
               (assert-eq (enc-read4 4) 0xd65f03c0)))))

(deftest macho_object_contains_arm64_text_symbols_and_branch_relocation
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "entry"))
                 source (call-make (con-make TY-CTRL))
                 call (arm64-call-alloc source false true 91 4)]
             (arm64-call-set-symbol! call "puts")
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun fun)
             (code-schedule-add! fun call)
             (code-schedule-end-block! fun)
             (assert-eq (enc-layout!) 4)
             (assert-eq (enc-emit!) 4)
             (enc-relocate!)
             (let [bytes (macho-bytes)]
               (assert-eq (len bytes) 290)
               (assert-eq (get bytes 0) (primitive/cast u8 0xcf))
               (assert-eq (get bytes 1) (primitive/cast u8 0xfa))
               (assert-eq (get bytes 2) (primitive/cast u8 0xed))
               (assert-eq (get bytes 3) (primitive/cast u8 0xfe))
               (assert-eq (get bytes 232) (primitive/cast u8 0x00))
               (assert-eq (get bytes 235) (primitive/cast u8 0x94))
               ;; relocation_info: address zero; external PC-relative 32-bit BRANCH26 to symbol 1.
               (assert-eq (get bytes 240) (primitive/cast u8 0x01))
               (assert-eq (get bytes 243) (primitive/cast u8 0x2d))
               ;; Defined `_entry` is N_SECT|N_EXT in section one; `_puts` is undefined external.
               (assert-eq (get bytes 248) (primitive/cast u8 0x0f))
               (assert-eq (get bytes 249) (primitive/cast u8 0x01))
               (assert-eq (get bytes 264) (primitive/cast u8 0x01))
               (assert-eq (macho-write "/tmp/aot-take-2-macho-test.o") (len bytes)))
             (let [bytes (elf-bytes)]
               (assert-eq (len bytes) 632)
               (assert-eq (get bytes 0) (primitive/cast u8 0x7f))
               (assert-eq (get bytes 1) (primitive/cast u8 0x45))
               (assert-eq (get bytes 2) (primitive/cast u8 0x4c))
               (assert-eq (get bytes 3) (primitive/cast u8 0x46))
               (assert-eq (get bytes 64) (primitive/cast u8 0x00))
               (assert-eq (get bytes 67) (primitive/cast u8 0x94))
               ;; RELA r_info names symbol three and R_AARCH64_CALL26 (283).
               (assert-eq (get bytes 80) (primitive/cast u8 0x1b))
               (assert-eq (get bytes 81) (primitive/cast u8 0x01))
               (assert-eq (get bytes 84) (primitive/cast u8 0x03))
               (assert-eq (get bytes 148) (primitive/cast u8 0x12))
               (assert-eq (get bytes 172) (primitive/cast u8 0x10))
               (assert-eq (elf-write "/tmp/aot-take-2-elf-test.o") (len bytes))))))
