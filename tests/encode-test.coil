(deftest local_fixups_patch_forward_conditional_and_backward_unconditional_branches
         (do
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 pred (con-make (ty-int-range 0 1))
                 ideal-if (if-make ideal-start pred)
                 branch (arm64-select ideal-if)
                 target (arm64-select (cproj-make ideal-if 0 "taken"))
                 fallthrough
                   (arm64-select (cproj-make ideal-if 1 "fallthrough"))]
             (set! (mut (.ins (hdr target))) 0 (Some branch))
             (n-add-use! branch target)
             (set! (mut (.ins (hdr fallthrough))) 0 (Some branch))
             (n-add-use! branch fallthrough)
             (push! [i64] (mut (.cfg (code))) (n-nid start))
             (push! [i64] (mut (.cfg (code))) (n-nid fallthrough))
             (push! [i64] (mut (.cfg (code))) (n-nid target))
             (code-schedule-reset!)
             (code-schedule-begin-block! start)
             (code-schedule-add! start start)
             (code-schedule-add! start branch)
             (code-schedule-end-block! start)
             (code-schedule-begin-block! fallthrough)
             (code-schedule-add! fallthrough fallthrough)
             (code-schedule-end-block! fallthrough)
             (code-schedule-begin-block! target)
             (code-schedule-add! target target)
             (code-schedule-end-block! target)
             (assert-eq (enc-layout!) 4)
             (assert-eq (enc-emit!) 4)
             (assert-eq (enc-fixup-count) 1)
             (enc-relocate!)
             (assert-eq (enc-read4 0) 0x54000021))
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 target (arm64-select (cproj-make ideal-start 0 "target"))
                 jump (arm64-jump-make)
                 padding (arm64-select (con-make (ty-int-con 0)))
                 jump-block
                   (arm64-select (cproj-make (start-make (ty-int-bot)) 0 "jump"))]
             (n-set-reg! padding ARM-X0)
             (set! (mut (.ins (hdr target))) 0 (Some jump))
             (n-add-use! jump target)
             (push! [i64] (mut (.cfg (code))) (n-nid target))
             (push! [i64] (mut (.cfg (code))) (n-nid jump-block))
             (code-schedule-reset!)
             (code-schedule-begin-block! target)
             (code-schedule-add! target target)
             (code-schedule-end-block! target)
             (code-schedule-begin-block! jump-block)
             (code-schedule-add! jump-block jump-block)
             (code-schedule-add! jump-block padding)
             (code-schedule-add! jump-block jump)
             (code-schedule-end-block! jump-block)
             (let [version (cfg-edit-version)]
               (assert-eq (enc-layout!) 8)
               (assert-eq (cfg-edit-version) version))
             (assert-eq (enc-emit!) 8)
             (enc-relocate!)
             (assert-eq (enc-read4 4) 0x17ffffff))))

