             (assert-eq (enc-read4 0) 0x5c000082)
             (assert-eq (enc-read4 4) 0x5c000063)
             (assert-eq (enc-read4 8) 0x14000004)
             (assert-eq (enc-read4 12) 0)
             (assert-eq (enc-read4 16) 0)
             (assert-eq (enc-read4 20) 0x3ff80000))))

(deftest literal_islands_keep_each_request_in_range_across_more_than_one_mib_of_text
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "large-literals"))
                 first (arm64-select (con-make (ty-flt-con 1.0)))
                 fill1 (arm64-select (con-make (ty-int-con 1)))
                 second (arm64-select (con-make (ty-flt-con 2.0)))
                 fill2 (arm64-select (con-make (ty-int-con 2)))
                 third (arm64-select (con-make (ty-flt-con 3.0)))
                 fill3 (arm64-select (con-make (ty-int-con 3)))
                 fourth (arm64-select (con-make (ty-flt-con 4.0)))
                 fill4 (arm64-select (con-make (ty-int-con 4)))]
             ;; Large exact sizes stand in for ordinary instruction runs. This exercises production
             ;; layout without constructing hundreds of thousands of redundant arena nodes; emission
             ;; is covered separately by the exact island-byte test above.
             (arm64-scalar-set-size! fill1 300000)
             (arm64-scalar-set-size! fill2 300000)
             (arm64-scalar-set-size! fill3 300000)
             (arm64-scalar-set-size! fill4 300000)
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun fun)
             (code-schedule-add! fun first)
             (code-schedule-add! fun fill1)
             (code-schedule-add! fun second)
             (code-schedule-add! fun fill2)
             (code-schedule-add! fun third)
             (code-schedule-add! fun fill3)
             (code-schedule-add! fun fourth)
             (code-schedule-add! fun fill4)
             (code-schedule-end-block! fun)
             (assert (> (enc-layout!) 1048576))
             (assert-eq (enc-literal-count) 4)
             (assert-eq (enc-literal-island-count) 4)
             (assert (< (- (enc-literal-offset 0) (enc-op-start first)) 1048576))
             (assert (< (- (enc-literal-offset 1) (enc-op-start second)) 1048576))
             (assert (< (- (enc-literal-offset 2) (enc-op-start third)) 1048576))
             (assert (< (- (enc-literal-offset 3) (enc-op-start fourth)) 1048576)))))

(deftest calls_encode_direct_symbol_fixups_and_indirect_blr_exactly
         (do
           (boot! 1)
           (let [ctrl (con-make TY-CTRL)
                 source (call-make ctrl)
                 direct (arm64-call-alloc source false true 17 4)]
             (arm64-call-set-symbol! direct "callee")
             (enc-reset!)
             (m-encoding (encode-test-call-mach direct) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0x94000000)
             (assert-eq (enc-symbol-fixup-count) 1)
             (assert-eq (enc-symbol-fixup-kind 0) ENC-FIXUP-A64-BL26)
             (assert-eq (enc-symbol-fixup-fidx 0) 17)
             (assert-eq (enc-symbol-fixup-name 0) "callee"))
           (let [ctrl (con-make TY-CTRL)
                 target (con-make (ty-memptr false (ty-struct "IndirectCode")))
                 source (call-make ctrl)]
             (call-set-fptr! source target)
             (let [indirect (arm64-call-alloc source false false 0 4)]
               (n-set-reg! target 9)
               (enc-reset!)
               (m-encoding (encode-test-call-mach indirect) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xd63f0120)
               (assert-eq (enc-symbol-fixup-count) 0)))))

(deftest far_closed_world_bl26_routes_locally_and_preserves_link_register_across_b_hops
         (do
           (boot! 1)
           (code-reset! 1)
           (let [caller (arm64-select
                          (fun-make (start-make (ty-int-bot))
                                    (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
                                    "caller"))
                 callee (arm64-select
                          (fun-make (start-make (ty-int-bot))
                                    (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
                                    "callee"))
                 source (call-make (con-make TY-CTRL))
                 direct (arm64-call-alloc source false true 2 4)
                 fill1 (arm64-select (con-make (ty-int-con 1)))
                 fill2 (arm64-select (con-make (ty-int-con 2)))
                 fill3 (arm64-select (con-make (ty-int-con 3)))
                 fill4 (arm64-select (con-make (ty-int-con 4)))
                 fill5 (arm64-select (con-make (ty-int-con 5)))]
             (arm64-call-set-fidx! caller 1)
             (arm64-call-set-fidx! callee 2)
             (arm64-call-set-symbol! direct "callee")
             (arm64-scalar-set-size! fill1 33554432)
             (arm64-scalar-set-size! fill2 33554432)
             (arm64-scalar-set-size! fill3 33554432)
             (arm64-scalar-set-size! fill4 33554432)
             (arm64-scalar-set-size! fill5 33554432)
             (push! [i64] (mut (.cfg (code))) (n-nid caller))
             (push! [i64] (mut (.cfg (code))) (n-nid callee))
             (code-schedule-reset!)
             (code-schedule-begin-block! caller)
             (code-schedule-add! caller caller)
             (code-schedule-add! caller direct)
             (code-schedule-add! caller fill1)
             (code-schedule-add! caller fill2)
             (code-schedule-add! caller fill3)
             (code-schedule-add! caller fill4)
             (code-schedule-add! caller fill5)
             (code-schedule-end-block! caller)
             (code-schedule-begin-block! callee)
             (code-schedule-add! callee callee)
             (code-schedule-end-block! callee)
             (assert (> (enc-layout!) 134217728))
             (assert-eq (enc-veneer-route-count) 1)
             ;; A far closed-world BL becomes one local B26 fixup to the first hub. Hub entries are
             ;; B, not BL, so the original return address in LR survives the complete chain.
             (m-encoding (encode-test-call-mach direct) ENCODER-HANDLE)
             (assert-eq (enc-fixup-count) 1)
             (assert-eq (enc-symbol-fixup-count) 0))))

(deftest closed_world_fixups_never_bind_a_same_named_different_fidx_definition
         (do
           (boot! 1)
           (let [definition (con-int 1)
                 caller (con-int 2)]
             (enc-reset!)
             (enc-add-definition! ENCODER-HANDLE definition 41 "same")
             (enc-add-symbol-fixup! ENCODER-HANDLE ENC-FIXUP-A64-BL26 caller 42 "same")
             ;; Closed-world identity is authoritative. Treating this as definition zero would
             ;; silently redirect a corrupted call merely because its debug spelling still agrees.
             (assert-eq (macho-definition-for-fixup 0) -1)))
         (do
           (boot! 1)
           (let [definition (con-int 1)
                 caller (con-int 2)]
             (enc-reset!)
             (enc-add-definition! ENCODER-HANDLE definition 41 "platform")
             (enc-add-symbol-fixup! ENCODER-HANDLE ENC-FIXUP-A64-BL26 caller -1 "platform")
             ;; Explicit externs have no closed-world identity and intentionally use the symbol.
             (assert-eq (macho-definition-for-fixup 0) 0))))

