(deftest literal_islands_keep_each_request_in_range_across_more_than_one_mib_of_text
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun
                   (arm64-select (fun-make start
                                           (ty-tuple-of2 (ty-int-bot)
                                                         (ty-int-bot))
                                           "large-literals"))
