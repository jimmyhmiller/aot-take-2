(deftest arm64_dynamic_tags_nan_canonicalization_and_casts_emit_exact_words
         (do
           (boot! 1)
           (let [undefined (arm64-select (dyn-undefined-make))]
             (n-set-reg! undefined ARM-X0)
             (assert-eq (m-size (encode-test-mach undefined)) 4)
             (enc-reset!)
             (m-encoding (encode-test-mach undefined) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0xd2efff40))
           (encode-test--assert-dynamic-prefix TAG-INT DYNAMIC-PREFIX-INT 0xd28fff30)
           (encode-test--assert-dynamic-prefix
             TAG-UNDEFINED
             DYNAMIC-PREFIX-UNDEFINED
             0xd28fff50)
           (encode-test--assert-dynamic-prefix TAG-NULL DYNAMIC-PREFIX-NULL 0xd28fff70)
           (encode-test--assert-dynamic-prefix TAG-BOOL DYNAMIC-PREFIX-BOOL 0xd28fff90)
           (encode-test--assert-dynamic-prefix TAG-STRING DYNAMIC-PREFIX-STRING 0xd28fffb0)
           (encode-test--assert-dynamic-prefix TAG-SYMBOL DYNAMIC-PREFIX-SYMBOL 0xd28fffd0)
           (encode-test--assert-dynamic-prefix TAG-OBJECT DYNAMIC-PREFIX-OBJECT 0xd28ffff0)
           (encode-test--assert-dynamic-prefix
             TAG-FUNCTION
             DYNAMIC-PREFIX-FUNCTION
             0xd29fff30)
           (let [value (con-make (ty-dyn TAG-ANY))
                 test (arm64-select (typetest-make value TAG-DOUBLE))]
             (n-set-reg! value ARM-X1)
             (n-set-reg! test ARM-X0)
             (assert-eq (m-size (encode-test-mach test)) 48)
             (enc-reset!)
             (m-encoding (encode-test-mach test) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 48)
             (assert-eq (enc-read4 0) 0xd370fc30)
             (assert-eq (enc-read4 4) 0xd28fff31)
             (assert-eq (enc-read4 8) 0xcb110210)
             (assert-eq (enc-read4 12) 0xf1001a1f)
             (assert-eq (enc-read4 16) 0x9a9f87e0)
             (assert-eq (enc-read4 20) 0xd370fc30)
             (assert-eq (enc-read4 24) 0xd29fff31)
             (assert-eq (enc-read4 28) 0xeb11021f)
             (assert-eq (enc-read4 32) 0x9a9f17f0)
             (assert-eq (enc-read4 36) 0xaa100000)
             (assert-eq (enc-read4 40) 0xf100001f)
             (assert-eq (enc-read4 44) 0x9a9f17e0))
           (let [raw (con-make (ty-flt 64))
                 boxed (arm64-select (box-make raw))]
             (n-set-reg! raw (+ ARM-D0 1))
             (n-set-reg! boxed ARM-X0)
             (assert-eq (m-size (encode-test-mach boxed)) 16)
             (enc-reset!)
             (m-encoding (encode-test-mach boxed) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 16)
             (assert-eq (enc-read4 0) 0x1e612020)
             (assert-eq (enc-read4 4) 0x9e660020)
             (assert-eq (enc-read4 8) 0xd2efff10)
             (assert-eq (enc-read4 12) 0x9a806200))
           (let [value (con-make (ty-dyn TAG-ANY))]
             (let [ctrl (cproj-make (start-make (ty-int-bot)) 0 "guard.ctrl")
                   cast (arm64-select (cast-make ctrl value (ty-dyn TAG-NUMBER)))]
               (n-set-reg! value ARM-X1)
               (n-set-reg! cast ARM-X0)
               (enc-reset!)
               (m-encoding (encode-test-mach cast) ENCODER-HANDLE)
               (assert-eq (enc-byte-count) 4)
               (assert-eq (enc-read4 0) 0xaa0103e0)))))

(deftest arm64_unary_minus_uses_the_dedicated_integer_and_float_encodings
         (do
           (boot! 1)
           (let [integer-input (con-make (ty-int-range 1 9))
                 integer-minus (arm64-select (minus-make-mode integer-input MODE-INT))]
             (n-set-reg! integer-input ARM-X1)
             (n-set-reg! integer-minus ARM-X0)
             (enc-reset!)
             (m-encoding (encode-test-mach integer-minus) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0xcb0103e0))
           (let [float-input (con-make (ty-flt 64))
                 float-minus (arm64-select (minus-make-mode float-input MODE-FLT))]
             (n-set-reg! float-input (+ ARM-D0 1))
             (n-set-reg! float-minus ARM-D0)
             (enc-reset!)
             (m-encoding (encode-test-mach float-minus) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0x1e614020))))

(deftest arm64_memory_encodes_scaled_and_signed_offsets_exactly
         (do
           (boot! 1)
           (let [ctrl (con-make TY-CTRL)
                 mem (con-make (ty-mem 7 (ty-int-bot)))
                 ptr (con-make (ty-memptr false (ty-struct "EncodedMemory")))
                 load_ (arm64-select
                         (load-make ctrl
                                    mem
                                    ptr
                                    (con-make (ty-int-con 24))
                                    7
                                    (ty-int-bot)))]
             (n-set-reg! ptr ARM-X1)
             (n-set-reg! load_ ARM-X0)
             (enc-reset!)
             (m-encoding (encode-test-mach load_) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0xf9400c20)
             (let [value (con-make (ty-int-range 1 9))
                   store (arm64-select
                           (store-make ctrl
                                       mem
                                       ptr
                                       (con-make (ty-int-con -8))
                                       value
                                       7
                                       (ty-int-bot)))]
               (n-set-reg! value 2)
               (enc-reset!)
               (m-encoding (encode-test-mach store) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xf81f8022)))))

(deftest arm64_splits_encode_register_moves_spills_and_reloads
         (do
           (boot! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "split-encode"))
                 value (arm64-select (con-make (ty-int-con 9)))
                 spill (arm64-split-make 1 "spill" 0)]
             (arm64-fun-finalize-frame! fun 66 false)
             (n-set-block-nid! fun (n-nid fun))
             (n-set-reg! value ARM-X0)
             (arm64-split-bind! spill fun value)
             (n-set-block-nid! spill (n-nid fun))
             (n-set-reg! spill 65)
             (enc-reset!)
             (m-encoding (encode-test-mach spill) ENCODER-HANDLE)
             (assert-eq (enc-read4 0) 0xf90003e0)
             (let [stack-value (arm64-select (con-make (ty-int-con 11)))
                   reload (arm64-split-make 2 "reload" 0)]
               (n-set-reg! stack-value 65)
               (arm64-split-bind! reload fun stack-value)
               (n-set-block-nid! reload (n-nid fun))
               (n-set-reg! reload ARM-X1)
               (enc-reset!)
               (m-encoding (encode-test-mach reload) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xf94003e1))
             (let [move (arm64-split-make 3 "move" 0)]
               (arm64-split-bind! move fun value)
               (n-set-block-nid! move (n-nid fun))
               (n-set-reg! move ARM-X1)
               (enc-reset!)
               (m-encoding (encode-test-mach move) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xaa0003e1))
             ;; CalleeSave is deliberately untyped: its fixed physical register is the bank
             ;; evidence. Preserve D8 with floating stack opcodes even though the pseudo is TY-BOT.
             (let [untyped (arm64-select (con-make TY-BOT))
                   spill-d8 (arm64-split-make 4 "spill-d8" 0)]
               (n-set-reg! untyped ARM-D8)
               (arm64-split-bind! spill-d8 fun untyped)
               (n-set-block-nid! spill-d8 (n-nid fun))
               (n-set-reg! spill-d8 65)
               (enc-reset!)
               (m-encoding (encode-test-mach spill-d8) ENCODER-HANDLE)
               (assert-eq (enc-read4 0) 0xfd0003e8)
               (let [stack-bits (arm64-select (con-make TY-BOT))
                     reload-d8 (arm64-split-make 5 "reload-d8" 0)]
                 (n-set-reg! stack-bits 65)
                 (arm64-split-bind! reload-d8 fun stack-bits)
                 (n-set-block-nid! reload-d8 (n-nid fun))
                 (n-set-reg! reload-d8 ARM-D8)
                 (enc-reset!)
                 (m-encoding (encode-test-mach reload-d8) ENCODER-HANDLE)
                 (assert-eq (enc-read4 0) 0xfd4003e8)))
             (let [stack-value (arm64-select (con-make (ty-int-con 12)))
                   stack-copy (arm64-split-make 6 "stack-copy" 0)]
               (arm64-fun-finalize-frame! fun 67 false)
               (n-set-reg! stack-value 65)
               (arm64-split-bind! stack-copy fun stack-value)
               (n-set-block-nid! stack-copy (n-nid fun))
               (n-set-reg! stack-copy 66)
               (assert-eq (m-size (encode-test-mach stack-copy)) 8)
               (match (m-killmap (encode-test-mach stack-copy))
                 (Some [kills] (assert (mask-test kills ARM64-SPLIT-SCRATCH)))
                 (None [] (assert false)))
               (enc-reset!)
               (m-encoding (encode-test-mach stack-copy) ENCODER-HANDLE)
               (assert-eq (enc-byte-count) 8)
               (assert-eq (enc-read4 0) 0xf94003f0)
               (assert-eq (enc-read4 4) 0xf90007f0)))))

(deftest arm64_splits_materialize_frame_addresses_beyond_scaled_ldr_str_range
         (do
           (boot! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "large-split"))
                 value (arm64-select (con-make (ty-int-con 9)))
                 spill (arm64-split-make 1 "large-spill" 0)]
             ;; Location 4161 is SP+32768, exactly one eight-byte slot beyond unsigned imm12.
             (arm64-fun-finalize-frame! fun 4163 false)
             (n-set-block-nid! fun (n-nid fun))
             (n-set-reg! value ARM-X0)
             (arm64-split-bind! spill fun value)
             (n-set-block-nid! spill (n-nid fun))
             (n-set-reg! spill 4161)
             (assert-eq (m-size (encode-test-mach spill)) 12)
             (enc-reset!)
             (m-encoding (encode-test-mach spill) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 12)
             (assert-eq (enc-read4 0) 0xd2900010)
             (assert-eq (enc-read4 4) 0x8b3063f0)
             (assert-eq (enc-read4 8) 0xf9000200)
             (let [stack-value (arm64-select (con-make (ty-int-con 11)))
                   stack-copy (arm64-split-make 2 "large-stack-copy" 0)]
               (n-set-reg! stack-value 4161)
               (arm64-split-bind! stack-copy fun stack-value)
               (n-set-block-nid! stack-copy (n-nid fun))
               (n-set-reg! stack-copy 4162)
               (assert-eq (m-size (encode-test-mach stack-copy)) 24)
               (match (m-killmap (encode-test-mach stack-copy))
                 (Some [kills]
                       (do
                         (assert (mask-test kills ARM64-SPLIT-SCRATCH))
                         (assert (mask-test kills ARM64-SPLIT-ADDRESS-SCRATCH))))
                 (None [] (assert false)))
               (enc-reset!)
               (m-encoding (encode-test-mach stack-copy) ENCODER-HANDLE)
               (assert-eq (enc-byte-count) 24)
               (assert-eq (enc-read4 0) 0xd2900011)
               (assert-eq (enc-read4 4) 0x8b3163f1)
               (assert-eq (enc-read4 8) 0xf9400230)
               (assert-eq (enc-read4 12) 0xd2900111)
               (assert-eq (enc-read4 16) 0x8b3163f1)
               (assert-eq (enc-read4 20) 0xf9000230)))))

(deftest generic_layout_records_schedule_offsets_and_verifies_emitted_size
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "layout"))
                 lhs (con-make (ty-int-con 5000))
                 add (arm64-select
                       (add-make-mode lhs (con-make (ty-int-con 7)) MODE-INT))]
             (n-set-reg! lhs ARM-X1)
             (n-set-reg! add ARM-X0)
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun fun)
             (code-schedule-add! fun add)
             (code-schedule-end-block! fun)
             (assert-eq (enc-layout!) 4)
             (assert-eq (enc-op-start add) 0)
             (assert-eq (enc-op-length add) 4)
             (assert-eq (enc-emit!) 4)
             (assert-eq (enc-read4 0) 0x91001c20))))

(deftest function_entries_are_aligned_to_sixteen_bytes_like_final_simple
         (do
           (boot! 1)
           (code-reset! 1)
           (let [first (arm64-select
                         (fun-make (start-make (ty-int-bot))
                                   (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
                                   "aligned-first"))
                 body (arm64-select (con-make (ty-int-con 7)))
                 second (arm64-select
                          (fun-make (start-make (ty-int-bot))
                                    (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
                                    "aligned-second"))]
             (n-set-reg! body ARM-X0)
             (push! [i64] (mut (.cfg (code))) (n-nid first))
             (push! [i64] (mut (.cfg (code))) (n-nid second))
             (code-schedule-reset!)
             (code-schedule-begin-block! first)
             (code-schedule-add! first first)
             (code-schedule-add! first body)
             (code-schedule-end-block! first)
             (code-schedule-begin-block! second)
             (code-schedule-add! second second)
             (code-schedule-end-block! second)
             (assert-eq (enc-layout!) 16)
             (assert-eq (enc-op-start first) 0)
             (assert-eq (enc-op-start body) 0)
             (assert-eq (enc-op-start second) 16)
             (assert-eq (enc-emit!) 16)
             (assert-eq (enc-read4 0) 0xd28000e0)
             (assert-eq (enc-read4 4) 0xd503201f)
             (assert-eq (enc-read4 8) 0xd503201f)
             (assert-eq (enc-read4 12) 0xd503201f))))

(deftest local_fixups_patch_forward_conditional_and_backward_unconditional_branches
         (do
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 pred (con-make (ty-int-range 0 1))
                 ideal-if (if-make ideal-start pred)
                 branch (arm64-select ideal-if)
                 target (arm64-select (cproj-make ideal-if 0 "taken"))
                 fallthrough (arm64-select (cproj-make ideal-if 1 "fallthrough"))]
             (set! (mut (.ins (hdr target))) 0 (Some branch))
             (n-add-use! branch target)
             (set! (mut (.ins (hdr fallthrough))) 0 (Some branch))
             (n-add-use! branch fallthrough)
             (push! [i64] (mut (.cfg (code))) (n-nid start))
             (push! [i64] (mut (.cfg (code))) (n-nid fallthrough))
             (push! [i64] (mut (.cfg (code))) (n-nid target))
             (code-schedule-reset!)
             (code-schedule-begin-block! start)
             (code-schedule-add! start start)
             (code-schedule-add! start branch)
             (code-schedule-end-block! start)
             (code-schedule-begin-block! fallthrough)
             (code-schedule-add! fallthrough fallthrough)
             (code-schedule-end-block! fallthrough)
             (code-schedule-begin-block! target)
             (code-schedule-add! target target)
             (code-schedule-end-block! target)
             (assert-eq (enc-layout!) 4)
             (assert-eq (enc-emit!) 4)
             (assert-eq (enc-fixup-count) 1)
             (enc-relocate!)
             (assert-eq (enc-read4 0) 0x54000021))
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 target (arm64-select (cproj-make ideal-start 0 "target"))
                 jump (arm64-jump-make)
                 padding (arm64-select (con-make (ty-int-con 0)))
                 jump-block (arm64-select (cproj-make (start-make (ty-int-bot)) 0 "jump"))]
             (n-set-reg! padding ARM-X0)
             (set! (mut (.ins (hdr target))) 0 (Some jump))
             (n-add-use! jump target)
             (push! [i64] (mut (.cfg (code))) (n-nid target))
             (push! [i64] (mut (.cfg (code))) (n-nid jump-block))
             (code-schedule-reset!)
             (code-schedule-begin-block! target)
             (code-schedule-add! target target)
             (code-schedule-end-block! target)
             (code-schedule-begin-block! jump-block)
             (code-schedule-add! jump-block jump-block)
             (code-schedule-add! jump-block padding)
             (code-schedule-add! jump-block jump)
             (code-schedule-end-block! jump-block)
             (assert-eq (enc-layout!) 8)
             (assert-eq (enc-emit!) 8)
             (enc-relocate!)
             (assert-eq (enc-read4 4) 0x17ffffff))))

