             (assert-eq (enc-byte-count) 8)
             (assert-eq (enc-read4 0) 0xb340bc20)
             (assert-eq (enc-read4 4) 0xf2efffe0))
           (let [boxed (con-make (ty-dyn TAG-OBJECT))
                 raw (arm64-select (unbox-make boxed REP-OBJECT))]
             (n-set-reg! boxed ARM-X1)
             (n-set-reg! raw ARM-X0)
             (enc-reset!)
             (m-encoding (encode-test-mach raw) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 4)
             (assert-eq (enc-read4 0) 0xd340bc20))))

(deftest arm64_string_nan_boxing_and_unboxing_emit_the_string_prefix
