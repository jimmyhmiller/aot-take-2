                 second (arm64-select (con-make (ty-flt-con 2.0)))
                 fill2 (arm64-select (con-make (ty-int-con 2)))
                 third (arm64-select (con-make (ty-flt-con 3.0)))
                 fill3 (arm64-select (con-make (ty-int-con 3)))
                 fourth (arm64-select (con-make (ty-flt-con 4.0)))
                 fill4 (arm64-select (con-make (ty-int-con 4)))]
             ;; Large exact sizes stand in for ordinary instruction runs. This exercises production
             ;; layout without constructing hundreds of thousands of redundant arena nodes; emission
             ;; is covered separately by the exact island-byte test above.
             (arm64-scalar-set-size! fill1 300000)
             (arm64-scalar-set-size! fill2 300000)
             (arm64-scalar-set-size! fill3 300000)
             (arm64-scalar-set-size! fill4 300000)
             (push! [i64] (mut (.cfg (code))) (n-nid fun))
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun fun)
             (code-schedule-add! fun first)
             (code-schedule-add! fun fill1)
             (code-schedule-add! fun second)
             (code-schedule-add! fun fill2)
             (code-schedule-add! fun third)
             (code-schedule-add! fun fill3)
             (code-schedule-add! fun fourth)
             (code-schedule-add! fun fill4)
             (code-schedule-end-block! fun)
             (assert (> (enc-layout!) 1048576))
             (assert-eq (enc-literal-count) 4)
             (assert-eq (enc-literal-island-count) 4)
             (assert (< (- (enc-literal-offset 0) (enc-op-start first)) 1048576))
             (assert (< (- (enc-literal-offset 1) (enc-op-start second))
                        1048576))
             (assert (< (- (enc-literal-offset 2) (enc-op-start third)) 1048576))
             (assert (< (- (enc-literal-offset 3) (enc-op-start fourth))
                        1048576)))))

(deftest declared_imports_encode_calls_and_addresses_without_local_function_owners
         (boot! 1)
         (let [start (start-make (ty-int-bot))
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               caller (fun-make start sig "caller")
               fidx (arena-declare-external! 41 "harness::identity" sig)
               target (external-make fidx)
               c (call-make-with-mem caller (con-make (ty-mem 1 TY-BOT)))]
           (call-add-arg! c (con-int 7))
           (call-set-fptr! c target)
           (callend-make c)
           (let [selected (arm64-select c)]
             (enc-reset!)
             (m-encoding (encode-test-call-mach selected) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 4)
             (assert-eq (enc-read4 0) 0x94000000)
             (assert-eq (enc-symbol-fixup-count) 1)
             (assert-eq (enc-symbol-fixup-fidx 0) fidx)
             (assert-eq (enc-symbol-fixup-name 0) "harness::identity"))
           (let [address (arm64-select target)]
             (n-set-reg! address ARM-X0)
             (enc-reset!)
             (m-encoding (encode-test-mach address) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 8)
             (assert-eq (enc-symbol-fixup-count) 2)
             (assert-eq (enc-symbol-fixup-kind 0) ENC-FIXUP-A64-PAGE21)
             (assert-eq (enc-symbol-fixup-kind 1) ENC-FIXUP-A64-PAGEOFF12)
             (assert-eq (enc-symbol-fixup-fidx 1) fidx)
             (assert-eq (enc-symbol-fixup-name 1) "harness::identity")
             ;; The address in an imported function object resolves to that same undefined symbol.
             (heap-add-function! fidx 0 0)
             (obj-symbols-build!)
             (assert-eq (macho-undefined-count) 1)
             (assert-eq (macho-undefined-name 0) "harness::identity")
             (assert-eq (macho-code-fixup-symbol 0)
                        (macho-symbol-index-for-fixup 0)))))

(deftest calls_encode_direct_symbol_fixups_and_indirect_blr_exactly
         (do
