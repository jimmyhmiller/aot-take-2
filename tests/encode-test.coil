             (assert-eq (enc-layout!) 8)
             (assert-eq (enc-emit!) 8)
             (assert-eq (enc-fixup-count) 1)
             (enc-relocate!)
             (assert-eq (enc-read4 0) 0x54000040)
             (assert-eq (enc-read4 4) 0x14000001))))

(deftest far_local_b26_uses_a_no_scratch_chain_of_layout_veneer_hubs
         (do
           (boot! 1)
           (code-reset! 1)
           (let [ideal-start (start-make (ty-int-bot))
                 start (arm64-select ideal-start)
                 pred (con-make (ty-int-range 0 1))
                 ideal-if (if-make ideal-start pred)
                 branch (arm64-select ideal-if)
                 target (arm64-select (cproj-make ideal-if 0 "far-taken"))
                 fallthrough (arm64-select (cproj-make ideal-if 1 "fallthrough"))
                 fill1 (arm64-select (con-make (ty-int-con 1)))
                 fill2 (arm64-select (con-make (ty-int-con 2)))
                 fill3 (arm64-select (con-make (ty-int-con 3)))
                 fill4 (arm64-select (con-make (ty-int-con 4)))
                 fill5 (arm64-select (con-make (ty-int-con 5)))]
             (set! (mut (.ins (hdr target))) 0 (Some branch))
             (n-add-use! branch target)
             (set! (mut (.ins (hdr fallthrough))) 0 (Some branch))
             (n-add-use! branch fallthrough)
             ;; Prefer false as fallthrough, leaving the selected true arm beyond five 32MiB runs.
             (n-set-cfg-pre! fallthrough 20)
             (n-set-cfg-pre! target 10)
             (arm64-scalar-set-size! fill1 33554432)
             (arm64-scalar-set-size! fill2 33554432)
             (arm64-scalar-set-size! fill3 33554432)
             (arm64-scalar-set-size! fill4 33554432)
             (arm64-scalar-set-size! fill5 33554432)
             (push! [i64] (mut (.cfg (code))) (n-nid start))
             (push! [i64] (mut (.cfg (code))) (n-nid fallthrough))
             (push! [i64] (mut (.cfg (code))) (n-nid target))
             (code-schedule-reset!)
             (code-schedule-begin-block! start)
             (code-schedule-add! start start)
             (code-schedule-add! start branch)
             (code-schedule-end-block! start)
             (code-schedule-begin-block! fallthrough)
             (code-schedule-add! fallthrough fallthrough)
             (code-schedule-add! fallthrough fill1)
             (code-schedule-add! fallthrough fill2)
             (code-schedule-add! fallthrough fill3)
             (code-schedule-add! fallthrough fill4)
             (code-schedule-add! fallthrough fill5)
             (code-schedule-end-block! fallthrough)
             (code-schedule-begin-block! target)
             (code-schedule-add! target target)
             (code-schedule-end-block! target)
             ;; The synthetic large sizes exercise production layout without allocating 160MiB of
             ;; test bytes. enc-layout! itself verifies every source, hub and final B26 hop.
             (assert (> (enc-layout!) 134217728))
             (assert-eq (enc-op-length branch) 8)
             (assert-eq (enc-veneer-route-count) 1)
             (assert (>= (enc-veneer-hub-count) 4))
             (assert (>= (enc-veneer-entry-count) 3)))))

