(deftest allocations_encode_shape_and_the_typed_runtime_call_relocation
         (do
           (boot! 1)
           (let [allocation
                   (new-make (con-make TY-CTRL)
                             (con-make (ty-int-con 24))
                             (con-make (ty-mem 1 TY-BOT))
                             SHAPE-EMPTY
                             (ty-struct "RuntimeAllocation"))
                 selected (arm64-select allocation)]
             (n-set-reg! (n-in! selected 1) ARM-X0)
             (enc-reset!)
             (m-encoding (encode-test-call-mach selected) ENCODER-HANDLE)
             (assert-eq (enc-byte-count) 156)
             (assert-eq (enc-read4 0) 0xf9404b8f)
             (assert-eq (enc-read4 152) 0x94000000)
             (assert-eq (enc-read4 136) 0xf2a00002)
             (assert-eq (enc-read4 140) 0xf2c00002)
             (assert-eq (enc-read4 144) 0xf2e00002)
             (assert-eq (len (.unit-sites (enc-state))) 2)
             (let [fast (get (.unit-sites (enc-state)) 0)
                   slow (get (.unit-sites (enc-state)) 1)]
               (assert-eq (.kind fast) ENC-UNIT-SHAPE)
               (assert-eq (.local-id fast) SHAPE-EMPTY)
               (assert-eq (.kind slow) ENC-UNIT-SHAPE)
               (assert-eq (.local-id slow) SHAPE-EMPTY)
               (assert-eq (.reg fast) 17)
               (assert-eq (.reg slow) 16)
               (assert-eq (enc-read4 (.offset fast)) 0xd2800011)
               (assert-eq (enc-read4 (+ (.offset fast) 8)) 0xf87179ef)
               (assert-eq (enc-read4 (.offset slow)) 0xd2800010)
               (assert-eq (enc-read4 (+ (.offset slow) 8)) 0xf8707821))
             (assert-eq (len (.map-sites (enc-state))) 1)
             (let [site (get (.map-sites (enc-state)) 0)]
               (assert-eq (.offset site) 132)
               (assert-eq (.local-id site) (n-nid selected))
               (assert-eq (.reg site) 2))
             (assert-eq (enc-symbol-fixup-count) 1)
             (assert-eq (enc-symbol-fixup-kind 0) ENC-FIXUP-A64-BL26)
             (assert-eq (enc-symbol-fixup-fidx 0) -1)
             (assert-eq (enc-symbol-fixup-name 0) "aot_rt_alloc"))))

