;; Comparisons and Not — the range logic that makes a bounds check disappear.

(module aot.tests.compare)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.compare" :use *)
(import "aot.node.control" :use *)
(import "aot.type.type" :use *)

(deftest a_boolean_is_an_integer_range
         ;; No boolean type: BOOL is [0..1], TRUE is 1, FALSE is 0. That is what lets `If` take any integer
         ;; as a predicate.
         (boot! 1)
         (assert-eq (ty-bool) (ty-int-range 0 1))
         (assert-eq (ty-true) (ty-int-con 1))
         (assert-eq (ty-false) (ty-int-con 0)))

(deftest disjoint_ranges_decide_equality
         (boot! 1)
         (let [a (con-make (ty-int-range 0 5))
               b (con-make (ty-int-range 10 20))]
           ;; The ranges cannot overlap, so equality is decided FALSE and inequality TRUE — without either
           ;; operand being constant.
           (assert-eq (n-ty (eq-make a b)) (ty-false))
           (assert-eq (n-ty (ne-make a b)) (ty-true))))

(deftest overlapping_ranges_leave_equality_undecided
         (boot! 1)
         (let [a (con-make (ty-int-range 0 10))
               b (con-make (ty-int-range 5 20))]
           (assert-eq (n-ty (eq-make a b)) (ty-bool))
           (assert-eq (n-ty (ne-make a b)) (ty-bool))))

(deftest ordered_ranges_decide_less_than
         (boot! 1)
         (let [lo (con-make (ty-int-range 0 5))
               hi (con-make (ty-int-range 10 20))]
           (assert-eq (n-ty (lt-make lo hi)) (ty-true))
           (assert-eq (n-ty (lt-make hi lo)) (ty-false))
           (assert-eq (n-ty (le-make lo hi)) (ty-true))))

(deftest le_and_lt_differ_exactly_at_the_touching_bound
         ;; [0..5] vs [5..9]: `<` cannot decide (5 < 5 is false, 4 < 5 is true) but `<=` can.
         (boot! 1)
         (let [a (con-make (ty-int-range 0 5))
               b (con-make (ty-int-range 5 9))]
           (assert-eq (n-ty (lt-make a b)) (ty-bool))
           (assert-eq (n-ty (le-make a b)) (ty-true))))

(deftest unsigned_less_than_is_the_bounds_check_idiom
         ;; `(unsigned)i < len` catches a NEGATIVE index and an over-large one in a SINGLE branch, because
         ;; a negative signed value is a huge unsigned one. This is the whole reason ULT exists.
         (boot! 1)
         (let [idx (con-make (ty-int-range 0 9))
               len (con-int 10)]
           ;; A proven-in-range index: the check folds to TRUE and the branch disappears.
           (assert-eq (n-ty (ult-make idx len)) (ty-true)))
         (let [neg (con-int -1)
               len2 (con-int 10)]
           ;; -1 as unsigned is the largest 64-bit value, so the same single test rejects it.
           (assert-eq (n-ty (ult-make neg len2)) (ty-false))))

(deftest comparing_a_node_with_itself_is_decided_without_any_range_test
         ;; No range comparison discovers this — the ranges overlap perfectly.
         (boot! 1)
         (let [x (con-make (ty-int-range 0 100))
               lt (lt-make x x)
               le (le-make x x)
               eq (eq-make x x)
               ne (ne-make x x)]
           ;; The mode must settle first; these are built UNKNOWN.
           (cmp-set-mode! lt MODE-INT)
           (cmp-set-mode! le MODE-INT)
           (cmp-set-mode! eq MODE-INT)
           (cmp-set-mode! ne MODE-INT)
           (assert-eq (compute-ty-of lt) (ty-false))
           (assert-eq (compute-ty-of le) (ty-true))
           (assert-eq (compute-ty-of eq) (ty-true))
           (assert-eq (compute-ty-of ne) (ty-false))))

(deftest a_high_operand_leaves_the_answer_high
         ;; "A boolean, but nobody has computed which." Returning a low answer here would break the
         ;; optimistic pass, which must be free to rise.
         (boot! 1)
         (let [a (con-make TY-TOP)
               b (con-int 5)]
           (assert-eq (n-ty (lt-make a b)) (ty-bool-high))
           (assert (ty-high? (n-ty (eq-make a b))))))

(deftest not_decides_on_a_provably_nonzero_range
         ;; `!x` is FALSE whenever the range sits strictly above or strictly below zero — which a
         ;; disjointness test on `x == 0` could not conclude for a range straddling zero.
         (boot! 1)
         (assert-eq (not-compute-ty (ty-int-con 0)) (ty-true))
         (assert-eq (not-compute-ty (ty-int-range 1 10)) (ty-false))
         (assert-eq (not-compute-ty (ty-int-range -10 -1)) (ty-false))
         (assert-eq (not-compute-ty (ty-int-range -5 5)) (ty-bool))
         (assert-eq (not-compute-ty TY-TOP) (ty-bool-high)))

(deftest equality_against_zero_becomes_a_not
         ;; `x == 0` and `!x` are the same value, and Not has the sharper compute.
         (boot! 1)
         (let [x (con-make (ty-int-range -5 5))
               e (eq-make x (con-int 0))]
           (cmp-set-mode! e MODE-INT)
           (assert (match (n-peephole-opt! e) (Some [r] (= (n-op r) OP-NOT)) (None [] false)))))

(deftest equality_sinks_its_constant_to_the_right
         ;; So that `5 == x` and `x == 5` GVN together.
         (boot! 1)
         (let [x (con-make (ty-int-range 0 10))
               e (eq-make (con-int 5) x)]
           (cmp-set-mode! e MODE-INT)
           (assert (match (n-peephole-opt! e) (Some [r] (n-same? r e)) (None [] false)))
           ;; After the swap the constant is on the right.
           (assert (ty-constant? (n-ty (n-in! e 2))))))

(deftest the_operator_participates_in_gvn
         ;; `a < b` and `a <= b` over the same operands are DIFFERENT nodes.
         (boot! 1)
         (let [a (con-make (ty-int-range 0 10))
               b (con-make (ty-int-range 5 20))
               lt (lt-make a b)
               le (le-make a b)]
           (assert (not (n-gvn-eq? lt le)))
           (assert-ne (n-gvn-hash lt) (n-gvn-hash le))))

(deftest a_comparison_drives_a_real_branch
         ;; The whole point of this slice: an If can now test a comparison rather than a bare constant.
         ;; A proven-in-range index makes the bounds check fold and the branch disappear.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               idx (con-make (ty-int-range 0 9))
               len (con-int 10)
               check (ult-make idx len)
               iff (if-make c check)
               arms (if-arms! iff)]
           ;; The check is provably TRUE, so the false arm is dead and the true arm became the incoming
           ;; control — the branch is gone.
           (assert-eq (n-ty check) (ty-true))
           (assert-eq (n-ty iff) (ty-if-true))
           (assert-eq (n-op (arms-false arms)) OP-XCTRL)))

(deftest an_unprovable_index_keeps_its_branch
         ;; The other half, and the one that matters for soundness: where the range is NOT proven, the
         ;; check survives and both arms stay live.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               idx (con-make (ty-int-range 0 20))  ; may exceed the length
               len (con-int 10)
               check (ult-make idx len)
               iff (if-make c check)]
           (assert-eq (n-ty check) (ty-bool))
           (assert-eq (n-ty iff) (ty-if-both))))
