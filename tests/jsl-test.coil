         (assert-eq (jsl-fidx-of "JsNumberRadixString") 145)
         (assert-eq (jsl-fidx-of "JsRadixDigits") 146)
         (assert-eq (jsl-fidx-of "JsRadixFractionDigits") 147)
         (assert-eq (jsl-fidx-of "JsNumberValueOf") 148)
         (assert-eq (jsl-fidx-of "JsBooleanToStringMethod") 149)
         (assert-eq (jsl-fidx-of "JsBooleanValueOf") 150)
         ;; jsl/compiler/math.jsl adds 37 definitions after JsBooleanValueOf.
         (assert-eq (jsl-fidx-of "JsMathAbs") 151)
         (assert-eq (jsl-fidx-of "JsGlobalParseFloat") 187)
         ;; jsl/compiler/array-generic.jsl adds 12 builtins (its macro has no index).
         (assert-eq (jsl-fidx-of "JsArrayLikeLength") 188)
         (assert-eq (jsl-fidx-of "JsIn") 199)
         (assert-eq (next-inline-fidx!) 200)
         ;; A graph exists only for a demanded definition; the frontend demands, then closes.
         (jsl-graph-of "JsSub")
         (jsl-graph-of "JsAdd")
         (jsl-graph-of "JsMul")
         (jsl-graph-of "JsChoose")
         (jsl-graph-of "JsIdentity")
         (jsl-graph-of "JsIncrementIntOrIdentity")
         (assert (not (jsl-graph-built? "JsArrayPush")))
         (jsl-close-world!)
         (assert (not (fun-unknown-callers? (jsl-graph-of "JsSub"))))
         (assert (not (fun-unknown-callers? (jsl-graph-of "JsAdd"))))
         (assert (not (fun-unknown-callers? (jsl-graph-of "JsMul"))))
         (assert (not (fun-unknown-callers? (jsl-graph-of "JsChoose"))))
         (assert (not (fun-unknown-callers? (jsl-graph-of "JsIdentity"))))
         (assert (not (fun-unknown-callers? (jsl-graph-of "JsIncrementIntOrIdentity"))))
         (assert-eq (verify-all) VERR-OK))

(deftest structured_jsl_let_and_if_lower_to_ordinary_control_and_phi
         (boot! 45)
           (assert-eq (jsl-lower-index! "jsl/compiler/index") 26)
         (let [fun (jsl-graph-defined "JsChoose")
               ret (match (fun-ret fun) (Some [r] r) (None [] (unreachable-node)))
               value (n-in! ret RETURN-VALUE)
               end (n-in! value 0)
               call (n-in! end 0)
               selected (call-arg call 0)
               region (phi-region selected)]
           (assert-eq (n-op value) OP-PROJ)
           (assert-eq (n-op selected) OP-PHI)
           (assert-eq (n-op region) OP-REGION)
           (assert-eq (n-nins region) 3)
           (assert-eq (n-nins selected) 3)
           (assert (n-same? (n-in! selected 1)
                            (match (fun-parm fun 1)
                              (Some [p] p)
                              (None [] (unreachable-node)))))
           (assert (n-same? (n-in! selected 2)
                            (match (fun-parm fun 2)
                              (Some [p] p)
                              (None [] (unreachable-node)))))
           ;; JsIdentity is declared later in the index. The call nevertheless has its stable
           ;; forward-resolved target and remains lazy until Opto discovers it.
           (assert-eq (n-op call) OP-CALL)
           (assert (n-same? (n-in! (call-fptr call) 0) (jsl-graph-of "JsIdentity")))
           (assert (not (call-linked? call (jsl-graph-of "JsIdentity"))))
           (assert-eq (verify-all) VERR-OK)))

(deftest jsl_macros_expand_at_the_call_site_without_a_function_boundary
         (do
           (boot! 52)
           (jsl-reset!)
           (jsl-lower-reset!)
           (let [unit
                   (jsl-read-source!
                     "(macro AddOne :params [(value int)] :ret int (%Add value 1))
                      (builtin UsesAddOne :params [(value int)] :ret int (AddOne value))"
                     "macro-expansion.jsl")]
             (assert (jsl-form-macro? (jsl-form unit 0)))
             (assert-eq (jsl-check-unit unit) 2)
             (assert-eq (jsl-lower-unit! unit) 2)
             (let [fun (jsl-graph-of "UsesAddOne")
                   ret (match (fun-ret fun) (Some [r] r) (None [] (unreachable-node)))
                   value (n-in! ret RETURN-VALUE)]
               (assert-eq (n-op value) OP-ADD)
               (assert-eq (n-op (n-in! value 1)) OP-PARM)
               (assert-eq (n-op (n-in! value 2)) OP-CON)
               (assert-eq (verify-all) VERR-OK)))))

(deftest jsl_owns_guarded_named_own_property_semantics
         (do
           (boot! 53)
           (jsl-reset!)
           (jsl-lower-reset!)
           (let [key (shape-key-intern "jsl-own-property")
                 shaped (shape-transition SHAPE-EMPTY "jsl-own-property")]
             (assert-eq key (shape-field-key shaped))
             (assert-eq key 1)
             (let [unit
                     (jsl-read-source!
                       "(macro GetOwnNamed :params [(object dyn) (key int)] :ret dyn
                          (if (%IsObject object)
                              (%PropLoadOwnNamed (%UnboxObject object) key)
                              (%Undefined)))
                        (builtin UsesGetOwnNamed :params [(object dyn)] :ret dyn
                          (GetOwnNamed object 1))"
                       "own-property-macro.jsl")]
               (assert-eq (jsl-check-unit unit) 2)
               (assert-eq (jsl-lower-unit! unit) 2)
               (let [fun (jsl-graph-of "UsesGetOwnNamed")
                     ret (match (fun-ret fun) (Some [r] r) (None [] (unreachable-node)))
                     value (n-in! ret RETURN-VALUE)]
                 (assert-eq (n-op value) OP-PHI)
                 (assert-eq (n-ty value) (ty-dyn TAG-ANY))
                 (assert-eq (verify-all) VERR-OK))))))

(deftest jsl_tag_test_installs_a_branch_local_cast_before_unboxing
         (boot! 46)
           (assert-eq (jsl-lower-index! "jsl/compiler/index") 26)
         (let [fun (jsl-graph-defined "JsIncrementIntOrIdentity")
               ret (match (fun-ret fun) (Some [r] r) (None [] (unreachable-node)))
               result (n-in! ret RETURN-VALUE)
               fast-box (n-in! result 1)
               add (n-in! fast-box 1)
               left (n-in! add 1)
               right (n-in! add 2)]
           (assert-eq (n-op result) OP-PHI)
           (assert-eq (n-op fast-box) OP-BOX)
           (assert-eq (n-op add) OP-ADD)
           (assert-eq (n-op left) OP-UNBOX)
           (assert-eq (n-op right) OP-CON)
           (assert-eq (n-ty right) (ty-int-con 1))
           (assert-eq (n-op (n-in! left 1)) OP-CAST)
           (assert (unbox-proven? left))
           ;; The complementary edge excludes the tested integer tag while preserving the same
           ;; runtime word. Generic fallback code can therefore consume the precise false proof.
           (assert-eq (n-op (n-in! result 2)) OP-CAST)
           (assert (n-same? (n-in! (n-in! result 2) 1)
                            (match (fun-parm fun 0)
                              (Some [p] p)
                              (None [] (unreachable-node)))))
           (assert-eq (verify-all) VERR-OK)))

(deftest checker_admitted_tag_predicates_all_lower_to_exact_typetests
         (boot! 461)
         (jsl-reset!)
         (jsl-lower-reset!)
         (let [unit
                 (jsl-read-source!
                   "(builtin AllTagTests :params [(v dyn)] :ret bool
                      (%And (%IsInt v)
                        (%And (%IsFlt v)
                          (%And (%IsString v)
                            (%And (%IsBool v)
                              (%And (%IsNull v)
                                (%And (%IsUndefined v)
                                  (%And (%IsSymbol v)
                                    (%And (%IsObject v)
                                      (%And (%IsFunction v) (%IsArray v)))))))))))"
                   "all-tag-tests.jsl")]
           (assert-eq (jsl-check-unit unit) 1)
           (assert-eq (jsl-lower-unit! unit) 1)
           (let [(mut nid) 1
                 (mut count) 0
                 (mut tags) 0]
             (loop (if (> (load nid) (arena-node-count))
                       (break 0)
                       (do
                         (match (arena-node (load nid))
                           (Some [n]
                                 (if (= (n-op n) OP-TYPETEST)
                                     (do
                                       (set! (mut count) (+ (load count) 1))
                                       (set! (mut tags) (| (load tags) (typetest-tags n))))
                                     0))
                           (None [] 0))
                         (set! (mut nid) (+ (load nid) 1))
                         (continue))))
             (assert-eq (load count) 10)
             (assert-eq (load tags) TAG-ANY)
             (assert-eq (verify-all) VERR-OK))))

(deftest unknown_dynamic_input_retains_the_guarded_jsl_fallback_after_opto
         (boot! 47)
           (assert-eq (jsl-lower-index! "jsl/compiler/index") 26)
         (let [fun (jsl-graph-of "JsIncrementIntOrIdentity")
               caller-start (start-make (ty-int-bot))
               caller-fun
                 (fun-make caller-start
                           (ty-tuple-of2 (ty-dyn TAG-ANY) (ty-dyn TAG-ANY))
                           "main")
               arg (parm-make caller-fun 0 (ty-dyn TAG-ANY) "value")
               c (call-make caller-fun)]
           (call-add-arg! c arg)
           (call-set-fptr! c (funptr-make fun 5))
           (let [end (callend-make c)
                 result (proj-make end RETURN-VALUE "increment.result")
                 ret
                   (return-make (cproj-make end RETURN-CTRL "increment.ctrl")
                                (None [(dyn NodeOps)])
                                result
                                (None [(dyn NodeOps)])
                                (Some caller-fun))
                 stop (stop-make)]
             (fun-set-ret! caller-fun ret)
             (stop-add-return! stop ret)
             (jsl-close-world!)
             (assert-eq (verify-all) VERR-OK)
             (opto-run!)
             ;; Unknown callers can supply any JavaScript tag, so the argument carries no evidence
             ;; and the JSL definition is not inlined (docs/DECISIONS.md, the compile-time
             ;; architecture, decision 3): the site stays a call to the one shared body, whose
             ;; integer fast path and identity fallback both remain, guarded, in that body.
             (let [answer (n-in! ret RETURN-VALUE)
                   body-ret (match (fun-ret fun) (Some [r] r) (None [] (unreachable-node)))
                   body-answer (n-in! body-ret RETURN-VALUE)
                   region (phi-region body-answer)
                   true-arm (n-in! region 1)
                   iff (n-in! true-arm 0)]
               (assert-eq (n-op answer) OP-PROJ)
               (assert-eq (n-op (n-in! answer 0)) OP-CALLEND)
               (assert-eq (n-op body-answer) OP-PHI)
               (assert-eq (n-op iff) OP-IF)
               (assert-eq (n-op (n-in! iff 1)) OP-TYPETEST)
               (assert (live-unboxes-proven?))
               (assert-eq (verify-all) VERR-OK)))))

(deftest boxed_integer_call_specializes_the_guarded_jsl_definition
         (boot! 48)
           (assert-eq (jsl-lower-index! "jsl/compiler/index") 26)
         (let [fun (jsl-graph-of "JsIncrementIntOrIdentity")
               caller-start (start-make (ty-int-bot))
               caller-fun
                 (fun-make caller-start
                           (ty-tuple-of2 (ty-dyn TAG-ANY) (ty-dyn TAG-ANY))
                           "main")
               unused (parm-make caller-fun 0 (ty-dyn TAG-ANY) "unused")
               c (call-make caller-fun)]
           (n-keep! unused)
           (call-add-arg! c (box-make (con-int 9)))
           (call-set-fptr! c (funptr-make fun (jsl-fidx-of "JsIncrementIntOrIdentity")))
           (let [end (callend-make c)
                 result (proj-make end RETURN-VALUE "increment.result")
                 ret
                   (return-make (cproj-make end RETURN-CTRL "increment.ctrl")
                                (None [(dyn NodeOps)])
                                result
                                (None [(dyn NodeOps)])
                                (Some caller-fun))
                 stop (stop-make)]
             (fun-set-ret! caller-fun ret)
             (stop-add-return! stop ret)
             (n-unkeep! unused)
             (jsl-close-world!)
             (assert (> (opto-run!) 0))
             (let [answer (n-in! ret RETURN-VALUE)]
               (assert-eq (n-op answer) OP-BOX)
               (assert-eq (n-ty (n-in! answer 1)) (ty-int-con 10))
               (assert-eq (verify-all) VERR-OK)))))

;; `:throws` is inferred and enforced like `:transitioning`: a body that may complete with the
;; exception sentinel must declare it, a throwing definition's result is a completion that only
;; `%IsException` may inspect before use, and the narrowing on that test makes the value usable.
(deftest jsl_checker_infers_and_enforces_the_throws_property
         (do
           (jsl-reset!)
           (let [unit (jsl-read-source!
                        "(builtin Boom :throws true :params [(v dyn)] :ret dyn (%SetPendingException v))
                         (builtin Unchecked :params [(v dyn)] :ret dyn (%Box (%UnboxInt (Boom v))))
                         (builtin Checked :throws true :params [(v dyn)] :ret dyn
                           (let [(r (Boom v))] (if (%IsException r) r (%Box (%UnboxInt r)))))
                         (builtin Leaks :params [(v dyn)] :ret dyn (Boom v))"
                        "throws.jsl")]
             (assert (jsl-form-throws? (jsl-form unit 0)))
             ;; The sentinel itself is a completion of the exception tag alone.
             (assert-eq (jsl-check-expr-type (jsl-form-body (jsl-form unit 0)) (jsl-form-params (jsl-form unit 0)))
                        (jsl-check-dyn-type TAG-EXCEPTION))
             ;; A completion fed to a primitive is refused.
             (assert-eq (jsl-check-expr-type (jsl-form-body (jsl-form unit 1)) (jsl-form-params (jsl-form unit 1)))
                        JSL-CHECK-TY-INVALID)
             ;; Tested first, the value is usable and the result is a completion.
             (assert-eq (jsl-check-expr-type (jsl-form-body (jsl-form unit 2)) (jsl-form-params (jsl-form unit 2)))
                        (jsl-check-dyn-type (+ TAG-EXCEPTION TAG-INT)))
             ;; A body that may throw without declaring so types as a completion; the form check
             ;; refuses it (`throwing body requires :throws true`), which terminates the process, so
             ;; the typed answer is what a test can inspect.
             (assert (jsl-check-may-throw? (jsl-check-expr-type (jsl-form-body (jsl-form unit 3)) (jsl-form-params (jsl-form unit 3))))))))

;; The array primitives type as the representation says: `%NewArray` yields a raw array, only a
;; raw array reaches the store and length primitives, `%UnboxArray` needs the array tag, and the
;; ToInteger truncation takes a float to an int.
(deftest jsl_checker_types_the_array_primitives
         (do
           (assert-eq (jsl-test-body-type
                        "(builtin Fresh :transitioning true :params [] :ret arr (%NewArray 3 (%IntrinsicPrototype \"Array.prototype\")))"
                        0)
                      JSL-CHECK-TY-RAW-ARRAY)
           (assert-eq (jsl-test-body-type
                        "(builtin Len :params [(a arr)] :ret int (%ArrayLen a))"
                        0)
                      JSL-CHECK-TY-INT)
           (assert-eq (jsl-test-body-type
                        "(builtin Get :params [(a arr) (i int)] :ret dyn (%ArrayLoad a i))"
                        0)
                      (jsl-check-dyn-type TAG-ANY))
           (assert-eq (jsl-test-body-type
                        "(builtin Put :transitioning true :params [(a arr) (v dyn)] :ret dyn (%ArrayStore a 0 v))"
                        0)
                      (jsl-check-dyn-type TAG-ANY))
           ;; A raw object is not an array.
           (assert-eq (jsl-test-body-type
                        "(builtin BadLen :params [(o obj)] :ret int (%ArrayLen o))"
                        0)
                      JSL-CHECK-TY-INVALID)
           ;; Unboxing needs the tag, and a tag test narrows to it.
           (assert-eq (jsl-test-body-type
                        "(builtin Narrow :params [(v dyn)] :ret int (if (%IsArray v) (%ArrayLen (%UnboxArray v)) 0))"
                        0)
                      JSL-CHECK-TY-INT)
           (assert-eq (jsl-test-body-type
                        "(builtin BadUnbox :params [(v dyn)] :ret arr (%UnboxArray (%Box 1)))"
                        0)
                      JSL-CHECK-TY-INVALID)
           (assert-eq (jsl-test-body-type
                        "(builtin Trunc :params [(f flt)] :ret int (%ToInteger f))"
                        0)
                      JSL-CHECK-TY-INT)))

;; `%CallFunction` calls a JavaScript function value from a body (docs/DECISIONS.md, JSL calls
;; JavaScript): the callee must be proven a function, the operands are values, the result is a
;; completion the body must test, and the form is transitioning.
(deftest jsl_checker_types_a_call_into_javascript_as_a_completion
         (do
           (assert-eq (jsl-test-body-type
                        "(builtin Call1 :transitioning true :throws true :params [(f dyn) (v dyn)] :ret dyn (if (%IsFunction f) (%CallFunction f (%Undefined) v) (%Undefined)))"
                        0)
                      (jsl-check-dyn-type TAG-COMPLETION))
           ;; An unproven callee is refused.
           (assert-eq (jsl-test-body-type
                        "(builtin CallAny :transitioning true :throws true :params [(f dyn) (v dyn)] :ret dyn (%CallFunction f (%Undefined) v))"
                        0)
                      JSL-CHECK-TY-INVALID)
           ;; A completion is not an argument.
           (assert-eq (jsl-test-body-type
                        "(builtin CallTwice :transitioning true :throws true :params [(f dyn) (v dyn)] :ret dyn (if (%IsFunction f) (%CallFunction f (%Undefined) (%CallFunction f (%Undefined) v)) (%Undefined)))"
                        0)
                      JSL-CHECK-TY-INVALID)))

;; The call lowers as the frontend's value call: the code word loaded from the function object is
;; the Call's function pointer, `this` and the ABI's slots are its arguments, and the body sees the
;; CallEnd's value projection.
;; The shared boxed signature over `slots` formals: a completion, `this`, `new.target`, the slots.
(defn jsl-test-abi-sig [(slots i64)] (-> i64)
  (let [(mut members) (al-new [i64] (alloc/malloc-allocator))]
    (push! [i64] (mut members) (ty-dyn TAG-COMPLETION))
    (let [(mut i) 0]
      (loop (if (> (load i) (+ slots 1))
                (break 0)
                (do (push! [i64] (mut members) (ty-dyn TAG-ANY)) (set! (mut i) (+ (load i) 1)) (continue)))))
    (ty-tuple (al-slice (load members)))))

(deftest jsl_call_into_javascript_lowers_to_a_call_through_the_code_word
         (boot! 462)
         (jsl-reset!)
         (jsl-lower-reset!)
         ;; [ret this new.target slot slot]
         (jsl-set-value-call-abi! 2 (ty-funptr (jsl-test-abi-sig 2) (fidx-set-intern (al-slice (al-new [i64] (alloc/malloc-allocator))))))
         (let [unit (jsl-read-source!
                      "(builtin CallIt :transitioning true :throws true :params [(f dyn) (v dyn)] :ret dyn
                         (if (%IsFunction f) (%CallFunction f (%Undefined) v) (%Undefined)))"
                      "call-function.jsl")]
           (assert-eq (jsl-lower-unit! unit) 1)
           (let [fun (jsl-graph-of "CallIt")
                 ret (match (fun-ret fun) (Some [r] r) (None [] (unreachable-node)))
                 result (n-in! ret RETURN-VALUE)
                 value (n-in! result 1)
                 end (n-in! value 0)
                 c (n-in! end 0)]
             (assert-eq (n-op result) OP-PHI)
             (assert-eq (n-op end) OP-CALLEND)
             (assert-eq (n-op c) OP-CALL)
             ;; this + new.target + two slots
             (assert-eq (call-nargs c) 4)
             (assert-eq (n-op (call-fptr c)) OP-LOAD)
             (assert-eq (n-op (n-in! (call-fptr c) 2)) OP-UNBOX)
             (assert-eq (verify-all) VERR-OK))))
