;; Production numeric/JSL proof of the semantic-call boundary.

(module aot.tests.jsl)
(import "coil.assert" :use *)
(import "coil.reader" :as rd)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.call" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.jsops" :use *)
(import "aot.shape" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.opto" :use *)
(import "aot.verify" :use *)
(import "aot.type.type" :use *)
(import "aot.jsl.reader" :use *)
(import "aot.jsl.check" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.jsl.prims" :use *)

(deftest production_primitive_table_admits_only_implemented_capabilities
         (do
           (assert-eq (prim-lookup "%StringConcat") JS-STRING-CONCAT)
           (assert-eq (prim-lookup "%StringEq") JS-STRING-EQ)
           (assert-eq (prim-lookup "%GetPrototype") JS-GET-PROTOTYPE)
           (assert-eq (prim-lookup "%UnimplementedCapability") 0)
           (assert-eq (prim-arity JS-STRING-CONCAT) 2)
           (assert (prim-transitioning? JS-STRING-CONCAT))
           (assert (not (prim-transitioning? JS-STRING-EQ)))))

(deftest jsop_is_one_typed_pinned_multi_for_the_runtime_capability_family
         (do
           (boot! 49)
           (let [ctrl (con-make TY-CTRL)
                 mem (con-make (ty-mem 1 TY-BOT))
                 left (con-make (raw-string-ty))
                 right (con-make (raw-string-ty))
                 op (jsop-make ctrl mem JS-STRING-CONCAT)]
             (jsop-add-arg! op left)
             (jsop-add-arg! op right)
             (assert-eq (jsop-prim op) JS-STRING-CONCAT)
             (assert-eq (n-nins op) 4)
             (assert (is-pinned? op))
             (assert (ty-tuple? (n-ty op)))
             (assert-eq (ty-tuple-at (n-ty op) 2) (raw-string-ty)))))

(defn load-production-sub [] (-> i64)
  (do
    (jsl-reset!)
    (jsl-lower-reset!)
    (jsl-read-file "jsl/compiler/sub.jsl")))

(defn jsl-test-boxed-body-op [(name (slice u8))] (-> i64)
  (let [fun (jsl-graph-defined name)
        ret (match (fun-ret fun) (Some [r] r) (None [] (unreachable-node)))
        box (n-in! ret RETURN-VALUE)]
    (n-op (n-in! box 1))))

(defn jsl-test-body-type [(source (slice u8)) (form-index i64)] (-> i64)
  (do
    (jsl-reset!)
    (let [unit (jsl-read-source! source "semantic-check.jsl")
          form (jsl-form unit form-index)
          params (jsl-form-params form)
          body (jsl-form-body form)]
      ;; Structural admission and semantic typing are deliberately separate so negative tests can
      ;; inspect the typed refusal without terminating the test process through `jsl-refuse`.
      (jsl-check-expr body params)
      (jsl-check-expr-type body params))))

(deftest jsl_reader_preserves_the_production_declaration_shape_and_spans
         (let [unit (load-production-sub)]
           (assert-eq (jsl-form-count unit) 2)
           (let [form (jsl-form unit 1)]
             (assert (rd/sexp-list? form))
             (assert-eq (rd/sexp-count form) 7)
             (assert (rd/sexp-sym-is (rd/sexp-nth form 0) "builtin"))
             (assert (rd/sexp-sym-is (rd/sexp-nth form 1) "JsSub"))
             ;; The production unit begins with its explanatory comment; the form span begins at
             ;; the declaration itself rather than incorrectly swallowing leading trivia.
             (assert (> (.lo form) 0))
             (assert (> (.hi form) (.lo form))))))

(deftest jsl_checker_accepts_the_current_production_numeric_subset
         (let [unit (load-production-sub)]
           (let [form (jsl-form unit 1)]
             (assert-eq (jsl-check-expr-type (jsl-form-body form) (jsl-form-params form))
                        (jsl-check-dyn-type TAG-DOUBLE)))
           (assert-eq (jsl-check-unit unit) 2)))

(deftest jsl_checker_admits_explicit_transition_metadata_without_positional_drift
         (do
           (jsl-reset!)
           (let [unit
                   (jsl-read-source!
                     "(builtin TransitionIdentity :transitioning true :params [(x int)] :ret dyn (%Box x))"
                     "transition.jsl")
                 form (jsl-form unit 0)]
             (assert (jsl-form-transitioning? form))
             (assert-eq (rd/sexp-count (jsl-form-params form)) 1)
             (assert (rd/sexp-sym-is (jsl-form-ret form) "dyn"))
             (assert-eq (jsl-check-unit unit) 1))))

(deftest jsl_semantic_checker_covers_every_admitted_primitive_signature
         (do
           (assert-eq (jsl-check-unary-type "%Neg" JSL-CHECK-TY-FLT) JSL-CHECK-TY-FLT)
           (assert-eq (jsl-check-unary-type "%Neg" JSL-CHECK-TY-INT) JSL-CHECK-TY-INT)
           (assert-eq (jsl-check-unary-type "%Neg" (jsl-check-dyn-type TAG-ANY)) JSL-CHECK-TY-INVALID)
           (assert-eq (jsl-check-binary-type "%Add" JSL-CHECK-TY-INT JSL-CHECK-TY-INT)
                      JSL-CHECK-TY-INT)
           (assert-eq (jsl-check-binary-type "%Sub" JSL-CHECK-TY-FLT JSL-CHECK-TY-INT)
                      JSL-CHECK-TY-FLT)
           (assert-eq (jsl-check-binary-type "%Mul" JSL-CHECK-TY-INT JSL-CHECK-TY-FLT)
                      JSL-CHECK-TY-FLT)
           (assert-eq (jsl-check-binary-type "%Div" JSL-CHECK-TY-FLT JSL-CHECK-TY-FLT)
                      JSL-CHECK-TY-FLT)
           (assert-eq (jsl-check-binary-type "%Eq" JSL-CHECK-TY-INT JSL-CHECK-TY-FLT)
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-binary-type "%Ne"
                                             (jsl-check-dyn-type TAG-INT)
                                             (jsl-check-dyn-type TAG-UNDEFINED))
                      JSL-CHECK-TY-INVALID)
           (assert-eq (jsl-check-binary-type "%SameBits"
                                             (jsl-check-dyn-type TAG-ANY)
                                             (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-binary-type "%SameBits" JSL-CHECK-TY-INT JSL-CHECK-TY-INT)
                      JSL-CHECK-TY-INVALID)
           (assert-eq (jsl-check-binary-type "%Lt" JSL-CHECK-TY-INT JSL-CHECK-TY-INT)
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-binary-type "%Le" JSL-CHECK-TY-FLT JSL-CHECK-TY-INT)
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-binary-type "%And" JSL-CHECK-TY-BOOL JSL-CHECK-TY-BOOL)
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%Box" JSL-CHECK-TY-INT)
                      (jsl-check-dyn-type TAG-INT))
           (assert-eq (jsl-check-unary-type "%Box" JSL-CHECK-TY-FLT)
                      (jsl-check-dyn-type TAG-DOUBLE))
           (assert-eq (jsl-check-unary-type "%Not" JSL-CHECK-TY-BOOL) JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%UnboxInt" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-INT)
           (assert-eq (jsl-check-unary-type "%UnboxFlt" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-FLT)
           (assert-eq (jsl-check-unary-type "%UnboxNumber" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-FLT)
           (assert-eq (jsl-check-unary-type "%ToFloat" JSL-CHECK-TY-INT)
                      JSL-CHECK-TY-FLT)
           (assert-eq (jsl-check-unary-type "%IsInt" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%IsFlt" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%IsString" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%IsBool" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%IsNull" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%IsUndefined" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%IsSymbol" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%IsObject" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)
           (assert-eq (jsl-check-unary-type "%IsFunction" (jsl-check-dyn-type TAG-ANY))
                      JSL-CHECK-TY-BOOL)))

(deftest jsl_semantic_checker_refuses_invalid_box_predicate_call_and_return_types
         (do
           (assert-eq (jsl-test-body-type
                        "(builtin BadBox :params [(v dyn)] :ret dyn (%Box v))"
                        0)
                      JSL-CHECK-TY-INVALID)
           (assert-eq (jsl-test-body-type
                        "(builtin BadBoolBox :params [] :ret dyn (%Box (%Eq 1 1)))"
                        0)
                      JSL-CHECK-TY-INVALID)
           (assert-eq (jsl-test-body-type
                        "(builtin BadPredicate :params [] :ret int (if (%ToFloat 1) 1 2))"
                        0)
                      JSL-CHECK-TY-INVALID)
           (assert-eq (jsl-test-body-type
                        "(builtin NeedInt :params [(v int)] :ret int v)
                         (builtin BadCall :params [(v dyn)] :ret int (NeedInt v))"
                        1)
                      JSL-CHECK-TY-INVALID)
           (let [actual
                   (jsl-test-body-type
                     "(builtin BadReturn :params [] :ret dyn (%Add 1 2))"
                     0)]
             (assert-eq actual JSL-CHECK-TY-INT)
             (assert (not (jsl-check-type-assignable?
                            actual
                            (jsl-check-dyn-type TAG-ANY)))))))

(deftest jsl_semantic_checker_refines_both_tag_test_arms_before_joining
         (assert-eq
           (jsl-test-body-type
             "(builtin IntEitherWay :params [(v dyn)] :ret dyn
                (if (%IsInt v) v (%Box 1)))"
             0)
           (jsl-check-dyn-type TAG-INT)))

(deftest jsl_checker_refuses_ambiguous_parameter_and_definition_names
         (do
           (jsl-reset!)
           (let [params-unit
                   (jsl-read-source!
                     "(builtin DuplicateParams :params [(v int) (v flt)] :ret int 0)"
                     "duplicate-params.jsl")
                 params (rd/sexp-nth (jsl-form params-unit 0) 3)]
             (assert (not (jsl-check-params-unique? params))))
           (jsl-reset!)
           (jsl-read-source! "(builtin Same :params [] :ret int 1)" "same-a.jsl")
           (jsl-read-source! "(builtin Same :params [] :ret flt (%ToFloat 2))" "same-b.jsl")
           (assert-eq (jsl-definition-count "Same") 2)))

(deftest production_sub_lowers_to_an_ordinary_fun_parm_return_graph
         (boot! 41)
         (let [unit (load-production-sub)]
           (assert-eq (jsl-lower-unit! unit) 2)
           (let [fun (jsl-graph-of "JsSub")]
             (assert-eq (n-op fun) OP-FUN)
             (assert-eq (fun-name fun) "JsSub")
             (assert (match (fun-parm fun 0) (Some [p] (= (n-op p) OP-PARM)) (None [] false)))
             (assert (match (fun-parm fun 1) (Some [p] (= (n-op p) OP-PARM)) (None [] false)))
             (match (fun-ret fun)
               (None [] (assert false))
               (Some [ret]
                     (do
                       (assert-eq (n-op ret) OP-RETURN)
                       (assert-eq (n-op (n-in! ret RETURN-VALUE)) OP-BOX)
                       (assert-eq (n-nins (n-in! ret RETURN-VALUE)) 2)))))))

(deftest production_sub_call_specializes_through_the_normal_inline_fixpoint
         (boot! 42)
         (let [unit (load-production-sub)]
           (jsl-lower-unit! unit)
           (let [fun-shape (jsl-graph-of "JsSub")
                 ret-shape (match (fun-ret fun-shape) (Some [r] r) (None [] (unreachable-node)))
                 box-shape (n-in! ret-shape RETURN-VALUE)
                 sub-shape (n-in! box-shape 1)]
             (assert-eq (n-nins box-shape) 2)
             (assert-eq (n-nins sub-shape) 3)
             ;; Both operands enter through the shared JSL conversion function; ordinary inlining
             ;; specializes its tag guards after call-graph discovery.
             (assert-eq (n-op (n-in! sub-shape 1)) OP-PROJ)
             (assert-eq (n-op (n-in! sub-shape 2)) OP-PROJ)
             (assert-eq (n-ty (n-in! sub-shape 1)) (ty-flt-bot))
             (assert-eq (n-ty (n-in! sub-shape 2)) (ty-flt-bot)))
           (assert-eq (verify-all) VERR-OK)
           (let [fun (jsl-graph-of "JsSub")
                 caller-start (start-make (ty-int-bot))
                 ctrl (cproj-make caller-start 0 "caller.ctrl")
                 c (call-make ctrl)]
             (call-add-arg! c (box-make (con-int 5)))
             (call-add-arg! c (box-make (con-int 3)))
             (call-set-fptr! c (funptr-make fun (jsl-fidx-of "JsSub")))
             (let [end (callend-make c)
                   result (proj-make end RETURN-VALUE "JsSub.result")
                   raw (unbox-make result REP-NUMBER)
                   probe (add-make raw (con-make (ty-flt 32)))]
               ;; Observe the answer through a surviving non-constant user. The fixpoint subsumes and
               ;; kills `raw`; one Probe edge is the stable place where that replacement becomes visible.
               (n-keep! probe)
               (assert-eq (verify-all) VERR-OK)
               (call-link! c fun)
               (assert-eq (verify-all) VERR-OK)
               ;; The conversion helper is another lazy semantic call. Preserve JSL bodies and
               ;; discover that call graph through the same SCCP boundary as the production driver.
               (jsl-prepare-opto!)
               (jsl-close-world!)
               (assert-eq (verify-all) VERR-OK)
               (opto-run!)
               (iter-seed-all!)
               (iter-run!)
               (let [left (n-in! probe 1)
                     right (n-in! probe 2)]
                 (assert (or (= (n-ty left) (ty-flt-con 2.0))
                             (= (n-ty right) (ty-flt-con 2.0)))))))))

(deftest production_numeric_jsl_units_lower_to_their_exact_ideal_operators
         (boot! 43)
         (jsl-reset!)
         (jsl-lower-reset!)
         ;; `+` concatenates through ToString, and ToString of an array joins it: the numeric units
         ;; are checked with the whole library present.
         (assert-eq (jsl-lower-index! "jsl/compiler/index") 26)
         ;; The library's accessor paths call back into JavaScript, so its bodies build only against
         ;; a settled value-call ABI, as under the frontend (loading the index resets it).
         (jsl-set-value-call-abi! 2 (ty-funptr (jsl-test-abi-sig 2) (fidx-set-intern (al-slice (al-new [i64] (alloc/malloc-allocator))))))
         (assert-eq (jsl-test-boxed-body-op "JsSub") OP-SUB)
         ;; Add now first selects the ECMA-262 String/String branch. Its numeric operation remains
         ;; in the guarded fallback instead of being the Return's immediate boxed producer.
         (assert-eq (n-op (n-in! (match (fun-ret (jsl-graph-defined "JsAdd"))
                                  (Some [ret] ret)
                                  (None [] (unreachable-node)))
                                RETURN-VALUE))
                    OP-PHI)
         (assert-eq (jsl-test-boxed-body-op "JsMul") OP-MUL)
         (assert-eq (verify-all) VERR-OK))

(deftest production_object_creation_lowers_through_jsl_to_new_and_object_boxing
         (boot! 49)
         (jsl-reset!)
         (jsl-lower-reset!)
         (let [unit (jsl-read-file "jsl/compiler/new-object.jsl")]
           (assert (jsl-form-transitioning? (jsl-form unit 0)))
           (assert (jsl-form-transitioning? (jsl-form unit 2)))
           (assert-eq
             (jsl-check-expr-type
               (rd/sexp-nth (jsl-form-body (jsl-form unit 2)) 1)
               (jsl-form-params (jsl-form unit 2)))
             JSL-CHECK-TY-RAW-OBJECT)
           (assert-eq (jsl-check-expr-type (jsl-form-body (jsl-form unit 2))
                                           (jsl-form-params (jsl-form unit 2)))
                      (jsl-check-dyn-type TAG-ANY))
           (assert-eq (jsl-check-unit unit) 3)
           (assert-eq (jsl-lower-unit! unit) 3))
         (let [(mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
               lowered
                 (jsl-lower-macro-values "JsNewObject"
                                         (load args)
                                         (con-make TY-CTRL)
                                         (con-make (ty-mem ALIAS-BULK TY-BOT)))
               box (.value lowered)
               ptr_ (n-in! box 1)
               fresh (n-in! ptr_ 0)]
           (assert-eq (n-op box) OP-BOX)
           (assert-eq (n-op ptr_) OP-PROJ)
           (assert-eq (proj-idx ptr_) 0)
           (assert-eq (n-op fresh) OP-NEW)
           (assert-eq (new-shape fresh) SHAPE-EMPTY)
           (assert-eq (new-object-ty fresh) (ty-struct "JsObjectPayload"))
           (assert-eq (n-ty (n-in! fresh 1)) (ty-int-con OBJECT-PAYLOAD-BYTES))
           (let [merged (.mem lowered)
                 prototype-store (memmerge-alias merged ALIAS-OBJECT-PROTOTYPE)
                 properties-store (memmerge-alias merged ALIAS-OBJECT-PROPERTIES)]
             (assert-eq (n-op merged) OP-MEMMERGE)
             (assert-eq (n-op prototype-store) OP-STORE)
             (assert-eq (n-op properties-store) OP-STORE)
             (assert-eq (mem-alias-of-node prototype-store) ALIAS-OBJECT-PROTOTYPE)
             (assert-eq (mem-alias-of-node properties-store) ALIAS-OBJECT-PROPERTIES)
             (assert-eq (n-ty (n-in! prototype-store STORE-VAL)) (ty-dyn TAG-NULL))
             (assert-eq (n-ty (n-in! properties-store STORE-VAL)) (ty-dyn TAG-NULL)))
           (assert-eq (verify-all) VERR-OK)))

(deftest jsl_string_literals_lower_to_static_utf16_strconst_data
         (do
           (boot! 50)
           (jsl-reset!)
           (jsl-lower-reset!)
           (let [units (jsl-string-utf16-units "Aé😀")]
             (assert-eq (len units) 4)
             (assert-eq (get units 0) 0x41)
             (assert-eq (get units 1) 0xe9)
             (assert-eq (get units 2) 0xd83d)
             (assert-eq (get units 3) 0xde00))
           (let [unit
                   (jsl-read-source!
                     "(builtin JsStringWitness :transitioning true :params [] :ret dyn (%Box \"A\\x1f600;\"))"
                     "string-witness.jsl")
                 form (jsl-form unit 0)]
             (assert-eq (jsl-check-expr-type (jsl-form-body form) (jsl-form-params form))
                        (jsl-check-dyn-type TAG-STRING))
             (assert-eq (jsl-check-unit unit) 1)
             (assert-eq (jsl-lower-unit! unit) 1)
             (let [fun (jsl-graph-of "JsStringWitness")
                   ret (match (fun-ret fun) (Some [r] r) (None [] (unreachable-node)))
                   box (n-in! ret RETURN-VALUE)
                   literal (n-in! box 1)]
               ;; The literal is static data, not an allocation: no New, no stores, no memory
               ;; effect. Its code units are the decoded UTF-16 of the source.
               (assert-eq (n-op box) OP-BOX)
               (assert-eq (n-op literal) OP-STATICREF)
               (assert-eq (n-ty literal) (raw-string-ty))
               (assert-eq (len (strconst-units literal)) 3)
               (assert-eq (get (strconst-units literal) 0) 0x41)
               (assert-eq (get (strconst-units literal) 1) 0xd83d)
               (assert-eq (get (strconst-units literal) 2) 0xde00)
               (assert-eq (n-op (n-in! ret RETURN-MEM)) OP-PARM)
               (assert-eq (verify-all) VERR-OK)))))

(deftest jsl_string_length_of_a_literal_folds_to_its_unit_count
         (do
           (boot! 51)
           (jsl-reset!)
           (jsl-lower-reset!)
           (let [unit
                   (jsl-read-source!
                     "(builtin JsStringLengthWitness :transitioning true :params [] :ret int (%StringLength \"A\\x1f600;\"))"
                     "string-length-witness.jsl")]
             (assert-eq (jsl-check-unit unit) 1)
             (assert-eq (jsl-lower-unit! unit) 1)
             (let [fun (jsl-graph-of "JsStringLengthWitness")
                   ret (match (fun-ret fun) (Some [r] r) (None [] (unreachable-node)))
                   length (n-in! ret RETURN-VALUE)]
               ;; Lowering builds the length-slice Load; the first peephole pass folds it to the
               ;; literal's unit count (aot.node.memory, load-idealize on a StrConst base).
               (assert-eq (n-op length) OP-LOAD)
               (assert-eq (mem-alias-of-node length) ALIAS-STRING-LENGTH)
               (assert-eq (verify-all) VERR-OK)
               ;; A Return with no Stop is dead to the peephole pass; keep it for the check.
               (n-keep! ret)
               (iter-seed-connected! ret)
               (iter-run!)
               (assert-eq (n-ty (n-in! ret RETURN-VALUE)) (ty-int-con 3))
               (assert-eq (verify-all) VERR-OK)
               (n-unkeep! ret)))))

(deftest compiler_index_assigns_stable_function_indices_and_closes_the_world
         (boot! 44)
         (assert-eq (jsl-lower-index! "jsl/compiler/index") 26)
         (jsl-set-value-call-abi! 2 (ty-funptr (jsl-test-abi-sig 2) (fidx-set-intern (al-slice (al-new [i64] (alloc/malloc-allocator))))))
         (assert-eq (jsl-fidx-of "JsPrimitiveNumber") 0)
         (assert-eq (jsl-fidx-of "JsSub") 1)
         (assert-eq (jsl-fidx-of "JsAdd") 2)
         (assert-eq (jsl-fidx-of "JsMul") 3)
         (assert-eq (jsl-fidx-of "JsLt") 4)
         (assert-eq (jsl-fidx-of "JsChoose") 5)
         (assert-eq (jsl-fidx-of "JsIdentity") 6)
         (assert-eq (jsl-fidx-of "JsIncrementIntOrIdentity") 7)
         ;; Loading declarations reserves identities even when no FunPtr happened to name the
         ;; highest JSL function. Source and inline identities therefore begin after the library.
         (assert-eq (jsl-fidx-of "JsTruthy") 8)
         (assert-eq (jsl-fidx-of "JsGetFromHolder") 9)
         (assert-eq (jsl-fidx-of "JsGetViaAccessor") 10)
         (assert-eq (jsl-fidx-of "JsCallGetter") 11)
         (assert-eq (jsl-fidx-of "JsCallSetter") 12)
         (assert-eq (jsl-fidx-of "JsSetSlow") 13)
         (assert-eq (jsl-fidx-of "JsSetFail") 14)
         (assert-eq (jsl-fidx-of "JsNullish") 15)
         (assert-eq (jsl-fidx-of "JsLogicalNot") 16)
         (assert-eq (jsl-fidx-of "JsVoid") 17)
         (assert-eq (jsl-fidx-of "JsStrictEqual") 18)
         (assert-eq (jsl-fidx-of "JsStrictNotEqual") 19)
         (assert-eq (jsl-fidx-of "JsNegate") 20)
         (assert-eq (jsl-fidx-of "JsPositive") 21)
         (assert-eq (jsl-fidx-of "JsDiv") 22)
         (assert-eq (jsl-fidx-of "JsTypeof") 23)
         (assert-eq (jsl-fidx-of "JsIncrement") 24)
         (assert-eq (jsl-fidx-of "JsDecrement") 25)
         (assert-eq (jsl-fidx-of "JsGt") 26)
         (assert-eq (jsl-fidx-of "JsLe") 27)
         (assert-eq (jsl-fidx-of "JsGe") 28)
         (assert-eq (jsl-fidx-of "JsInstanceofWalk") 29)
         (assert-eq (jsl-fidx-of "JsInstanceof") 30)
