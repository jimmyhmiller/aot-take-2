;; Whole-program graph structure, compared against equivalent Simple post-parse graphs.

;;
;; These tests close the hole that node-family tests cannot: they start at Stop and prove that the
;; complete connected component contains a Fun-as-Region, Parm-as-Phi, Return, and floating data.
;; The control test additionally proves the positional Region/Phi invariant across a real diamond.
(module aot.tests.program-graph)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.call" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.type.type" :use *)

(deftest expression_program_has_simples_fun_parm_return_stop_spine
         (boot! 31)
         (let [st (start-make (ty-int-bot))
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               fun (fun-make st sig "expression")
               arg (parm-make fun 0 (ty-int-bot) "arg")
               shared (add-make arg (con-int 3))
               delta (sub-make arg (con-int 4))
               value (mul-make shared (add-make shared delta))
               ret (return-make fun (None [(dyn NodeOps)]) value (None [(dyn NodeOps)]) (Some fun))
               stop (stop-make)]
           (fun-set-ret! fun ret)
           (stop-add-return! stop ret)
           (assert-eq (n-op stop) OP-STOP)
           (assert (n-same? (n-in! stop 0) ret))
           (assert-eq (n-op ret) OP-RETURN)
           (assert (n-same? (n-in! ret 0) fun))
           (assert-eq (n-nins ret) 4)
           (match (n-in-safe ret RETURN-MEM) (Some [_] (assert false)) (None [] (assert true)))
           (assert (n-same? (n-in! ret RETURN-VALUE) value))
           (match (n-in-safe ret RETURN-RPC) (Some [_] (assert false)) (None [] (assert true)))
           (assert-eq (return-fun-nid ret) (n-nid fun))
           (let [rt (compute-ty-of ret)]
             (assert-eq (ty-tuple-at rt RETURN-CTRL) (n-ty fun))
             (assert-eq (ty-tuple-at rt RETURN-MEM) TY-TOP)
             (assert-eq (ty-tuple-at rt RETURN-VALUE) (n-ty value)))
           (assert-eq (n-op fun) OP-FUN)
           (assert (fun-unknown-callers? fun))
           (assert-eq (n-op arg) OP-PARM)
           (assert (n-same? (parm-fun arg) fun))
           ;; Pure data floats: slot zero is control and is deliberately absent.
           (match (n-in-safe shared 0) (Some [_] (assert false)) (None [] (assert true)))
           ;; The shared Add really has two distinct use edges into the expression.
           (assert-eq (n-nouts shared) 2)))

(deftest control_program_has_simples_if_region_phi_and_program_spine
         (boot! 32)
         (let [st (start-make (ty-int-bot))
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               fun (fun-make st sig "control")
               arg (parm-make fun 0 (ty-int-bot) "arg")
               iff (if-make fun arg)
               arms (if-arms! iff)
               region (region-make)
               phi (phi-make region (ty-int-bot) "answer")
               stop (stop-make)]
           (region-add-path! region (arms-true arms))
           (region-add-path! region (arms-false arms))
           (phi-add-value! phi (add-make arg (con-int 2)))
           (phi-add-value! phi (sub-make arg (con-int 2)))
           (let [ret
                   (return-make region
                                (None [(dyn NodeOps)])
                                phi
                                (None [(dyn NodeOps)])
                                (Some fun))]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (assert (n-same? (n-in! stop 0) ret))
             (assert (n-same? (n-in! ret 0) region))
             (assert-eq (n-nins ret) 4)
             (assert (n-same? (n-in! ret RETURN-VALUE) phi))
             (assert-eq (return-fun-nid ret) (n-nid fun))
             (assert (n-same? (n-in! iff 0) fun))
             (assert (n-same? (n-in! iff 1) arg))
             (assert (n-same? (n-in! region 1) (arms-true arms)))
             (assert (n-same? (n-in! region 2) (arms-false arms)))
             (assert (n-same? (n-in! phi 0) region))
             (assert-eq (n-nins phi) (n-nins region)))))

(deftest complete_program_graphs_reach_the_iterative_fixpoint
         (boot! 33)
         (let [st (start-make (ty-int-bot))
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               fun (fun-make st sig "fixed")
               arg (parm-make fun 0 (ty-int-bot) "arg")
               ret
                 (return-make fun
                              (None [(dyn NodeOps)])
                              (add-make arg (con-int 0))
                              (None [(dyn NodeOps)])
                              (Some fun))
               stop (stop-make)]
           (fun-set-ret! fun ret)
           (stop-add-return! stop ret)
           (iter-seed-all!)
           (iter-run!)
           (assert-eq (iter-check-fixpoint) 0)
           (assert-eq (n-op stop) OP-STOP)
           (assert-eq (n-op (n-in! (n-in! stop 0) RETURN-VALUE)) OP-PARM)))

(deftest equivalent_expression_reassociates_to_simples_left_spine
         ;; Simple post-Iter turns the inner `(arg+3)+(arg-4)` into a left spine whose final RHS is
         ;; 3. The two nonconstant terms may commute under nid ordering; the load-bearing shape is
         ;; `Add(Add(arg, Sub), 3)`, which exposes constants for folding.
         (boot! 34)
         (let [st (start-make (ty-int-bot))
               fun (fun-make st (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "expression")
               arg (parm-make fun 0 (ty-int-bot) "arg")
               shared (add-make arg (con-int 3))
               delta (sub-make arg (con-int 4))
               value (mul-make shared (add-make shared delta))
               ret (return-make fun (None [(dyn NodeOps)]) value (None [(dyn NodeOps)]) (Some fun))
               stop (stop-make)]
           (fun-set-ret! fun ret)
           (stop-add-return! stop ret)
           (iter-seed-all!)
           (iter-run!)
           (let [mul (n-in! ret RETURN-VALUE)
                 outer (n-in! mul 2)
                 inner (n-in! outer 1)]
             (assert-eq (n-op outer) OP-ADD)
             (assert-eq (n-op inner) OP-ADD)
             (assert-eq (n-ty (n-in! outer 2)) (ty-int-con 3))
             (assert (or (= (n-op (n-in! inner 1)) OP-SUB)
                         (= (n-op (n-in! inner 2)) OP-SUB)))
             (assert (or (n-same? (n-in! inner 1) arg) (n-same? (n-in! inner 2) arg))))))

(deftest pessimistic_iteration_seeds_referenced_callee_outputs_but_not_disconnected_declarations
         (boot! 35)
         (let [start (start-make (ty-int-bot))
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               helper (fun-make start sig "helper")
               helper-arg (parm-make helper 0 (ty-int-bot) "value")
               helper-body (add-make helper-arg (con-int 1))
               helper-ret
                 (return-make helper
                              (None [(dyn NodeOps)])
                              helper-body
                              (None [(dyn NodeOps)])
                              (Some helper))
               main (fun-make start sig "main")
               call (call-make main)]
           (fun-set-ret! helper helper-ret)
           (n-keep! helper-ret)
           (call-add-arg! call (con-int 41))
           (call-set-fptr! call (funptr-make helper 35))
           (let [end (callend-make call)
                 result (proj-make end RETURN-VALUE "result")
                 main-ret
                   (return-make main
                                (None [(dyn NodeOps)])
                                result
                                (None [(dyn NodeOps)])
                                (Some main))
                 stop (stop-make)
                 other-start (start-make (ty-int-bot))
                 other (fun-make other-start sig "disconnected")
                 other-ret
                   (return-make other
                                (None [(dyn NodeOps)])
                                (con-int 99)
                                (None [(dyn NodeOps)])
                                (Some other))]
             (fun-set-ret! main main-ret)
             (stop-add-return! stop main-ret)
             (fun-set-ret! other other-ret)
             (n-keep! other-ret)
             (iter-seed-connected! stop)
             ;; FunPtr reaches `helper` through an input; the body is reachable only by following
             ;; Fun outputs, exactly why final Simple's Node.walk traverses both directions.
             (assert (code-on-worklist? (n-nid helper-ret)))
             (assert (code-on-worklist? (n-nid helper-body)))
             (assert (not (code-on-worklist? (n-nid other))))
             (assert (not (code-on-worklist? (n-nid other-ret)))))))
