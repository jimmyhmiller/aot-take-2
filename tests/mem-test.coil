;; Memory lattice and memory SSA.
(module aot.tests.mem)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.memory" :use *)
(import "aot.type.type" :use *)
(import "aot.shape" :use *)

(deftest named_structs_are_structurally_interned
         (let [a (ty-struct "Point")
               b (ty-struct "Point")
               c (ty-struct "Other")]
           (assert-eq a b)
           (assert-ne a c)))

(deftest memory_pointer_duality_preserves_the_referent_axis
         (let [point (ty-struct "Point")
               ptr (ty-memptr true point)
               high (ty-dual ptr)]
           (assert (ty-memptr? ptr))
           (assert-eq (ty-memptr-struct ptr) point)
           (assert-eq (ty-dual high) ptr)))

(deftest memory_slices_meet_contents_on_the_same_alias
         (let [left (ty-mem 7 (ty-int-con 1))
               right (ty-mem 7 (ty-int-con 3))
               answer (ty-meet left right)]
           (assert (ty-mem? answer))
           (assert-eq (ty-mem-alias answer) 7)
           (assert-eq (ty-mem-elem answer) (ty-int-range 1 3))))

(deftest unequal_precise_aliases_meet_to_bulk_memory
         (let [answer (ty-meet (ty-mem 7 (ty-int-con 1))
                               (ty-mem 9 (ty-int-con 1)))]
           (assert-eq (ty-mem-alias answer) 1)
           (assert-eq (ty-mem-elem answer) (ty-int-con 1))))

(deftest a_high_bulk_slice_is_neutral_for_a_precise_alias
         (let [precise (ty-mem 7 (ty-int-con 1))
               bulk-high (ty-mem 1 (ty-dual (ty-int-bot)))
               answer (ty-meet precise bulk-high)]
           (assert-eq (ty-mem-alias answer) 7)
           (assert-eq answer (ty-meet bulk-high precise))))

(deftest memory_dual_is_an_involution
         (let [mem (ty-mem 11 (ty-int-range 1 9))]
           (assert-eq (ty-dual (ty-dual mem)) mem)))

(deftest load_after_store_on_the_same_alias_address_forwards_the_value
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               ctrl (cproj-make st 0 "mem.ctrl")
               obj (ty-struct "Forward")
               ptr (con-make (ty-memptr false obj))
               off (con-make (ty-int-con 16))
               initial (con-make (ty-mem 7 (ty-int-bot)))
               ;; A non-singleton value prevents the generic constant-replacement step from
               ;; winning first, so this test specifically witnesses Load-after-Store forwarding.
               value (con-make (ty-int-range 40 42))
               store (store-make ctrl initial ptr off value 7 (ty-int-bot))
               load_ (load-make ctrl store ptr off 7 (ty-int-bot))
               after-control (n-peephole! load_)
               answer (n-peephole! after-control)]
           (assert (n-same? answer value))))

(deftest memmerge_selects_a_precise_alias_and_falls_back_to_default
         (boot! 1)
         (let [default (con-make (ty-mem 1 (ty-int-bot)))
               precise (con-make (ty-mem 7 (ty-int-con 9)))
               merge (memmerge-make)]
           (memmerge-set-alias! merge 1 default)
           (memmerge-set-alias! merge 7 precise)
           (assert (n-same? (memmerge-alias merge 7) precise))
           (assert (n-same? (memmerge-alias merge 8) default))))

(deftest memops_exposes_alias_kind_memory_pointer_and_offset_to_gcm
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               ctrl (cproj-make st 0 "memops.ctrl")
               ptr (con-make (ty-memptr false (ty-struct "MemOps")))
               off (con-make (ty-int-con 24))
               mem (con-make (ty-mem 13 (ty-int-bot)))
               load_ (load-make ctrl mem ptr off 13 (ty-int-bot))]
           (match (mem-of load_)
             (Some [m]
                   (do
                     (assert (mem-is-load? m))
                     (assert-eq (mem-alias m) 13)
                     (assert (n-same? (mem-in m) mem))
                     (assert (n-same? (mem-ptr m) ptr))
                     (assert (n-same? (mem-offset m) off))))
             (None [] (assert false)))))

(deftest new_produces_a_fresh_pointer_and_private_initial_memory
         (do
           (arena-reset! 89)
           (let [ctrl (con-make TY-CTRL)
                 size (con-make (ty-int-con 32))
                 mem (con-make (ty-mem 1 TY-BOT))
                 object-ty (ty-struct "AllocatedObject")
                 first (new-make ctrl size mem SHAPE-EMPTY object-ty)
                 second (new-make ctrl size mem SHAPE-EMPTY object-ty)]
             (assert-eq (n-op first) OP-NEW)
             (assert (not (n-gvn-eq? first second)))
             (assert-eq (new-shape first) SHAPE-EMPTY)
             (assert (n-same? (new-size first) size))
             (assert (n-same? (new-memory first) mem))
             (assert-eq (ty-tuple-len (n-ty first)) 2)
             (assert-eq (ty-tuple-at (n-ty first) 0) (ty-memptr false object-ty))
             ;; The allocation's memory is PRIVATE: stores continuing it for this object track just
             ;; the stored value, and no other object may read it as the alias's state.
             (assert-eq (ty-tuple-at (n-ty first) 1) (ty-mem-private ALIAS-BULK object-ty))
             (assert (ty-mem-one? (ty-tuple-at (n-ty first) 1)))
             (assert (not (ty-mem-one? (ty-mem ALIAS-BULK object-ty))))
             ;; Private is the high side of the memory lattice (`isa` reads "at least as specific
             ;; as"): TOP memory is more specific than a private slice, which is more specific than
             ;; the public slice of the same element.
             (assert (ty-isa? (ty-mem-private ALIAS-BULK object-ty) (ty-mem ALIAS-BULK object-ty)))
             (assert (ty-isa? (ty-mem-top 4) (ty-mem-private 4 (ty-dyn TAG-NULL))))
             (assert (not (ty-isa? (ty-mem 4 (ty-dyn TAG-NULL)) (ty-mem-private 4 (ty-dyn TAG-NULL))))))))

(deftest memphi_meets_same_alias_states_positionally
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               left (cproj-make st 0 "memphi.left")
               right (cproj-make st 0 "memphi.right")
               region (region-make)
               m1 (con-make (ty-mem 7 (ty-int-con 1)))
               m3 (con-make (ty-mem 7 (ty-int-con 3)))
               phi (memphi-make region 7 (ty-int-bot) "memphi")]
           (region-add-path! region left)
           (region-add-path! region right)
           (memphi-add-state! phi m1)
           (memphi-add-state! phi m3)
           (n-set-ty! phi (compute phi))
           (assert-eq (n-op phi) OP-MEMPHI)
           (assert-eq (memphi-alias phi) 7)
           (assert-eq (n-ty phi) (ty-mem 7 (ty-int-range 1 3)))))

(deftest memphi_collapses_like_an_ordinary_phi
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               left (cproj-make st 0 "memphi.same.left")
               right (cproj-make st 0 "memphi.same.right")
               region (region-make)
               mem (con-make (ty-mem 9 (ty-int-bot)))
               phi (memphi-make region 9 (ty-int-bot) "memphi.same")]
           (region-add-path! region left)
           (region-add-path! region right)
           (memphi-add-state! phi mem)
           (memphi-add-state! phi mem)
           (n-keep! phi)
           (match (idealize phi)
             (Some [answer] (assert (n-same? answer mem)))
             (None [] (assert false)))))
