;; Optimistic SCCP and lazy call-graph construction.

(module aot.tests.opto)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.call" :use *)
(import "aot.codegen.opto" :use *)
(import "aot.type.type" :use *)

(deftest optimistic_sccp_resets_then_reaches_the_constant_fixpoint
         (boot! 17)
         (let [lhs (con-int 20)
               rhs (con-int 22)
               sum (add-make-mode lhs rhs MODE-INT)]
           (n-keep! sum)
           (assert-eq (n-ty sum) (ty-int-con 42))
           (opto-reset-to-top!)
           (assert-eq (n-pesi-ty sum) (ty-int-con 42))
           (assert-eq (n-ty sum) TY-TOP)
           (assert (> (opto-sccp!) 0))
           (assert-eq (n-ty lhs) (ty-int-con 20))
           (assert-eq (n-ty rhs) (ty-int-con 22))
           (assert-eq (n-ty sum) (ty-int-con 42))
           (assert (code-work-empty?))))

(deftest optimistic_sccp_builds_a_direct_call_graph_edge_lazily
         (boot! 23)
         (let [st (start-make (ty-int-bot))
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               fun (fun-make st sig "callee")
               parm (parm-make fun 0 (ty-int-bot) "x")
               ret
                 (return-make fun
                              (None [(dyn NodeOps)])
                              parm
                              (None [(dyn NodeOps)])
                              (Some fun))
               call (call-make st)]
           (n-keep! ret)
           (fun-set-ret! fun ret)
           (call-add-arg! call (con-int 9))
           (call-set-fptr! call (funptr-make fun 77))
           (callend-make call)
           (assert (not (call-linked? call fun)))
           (opto-reset-to-top!)
           (opto-sccp!)
           (assert (call-linked? call fun))
           ;; Region/Parm lockstep is preserved by the lazy linkage.
           (assert-eq (n-nins parm) (n-nins fun))))

(deftest proof_is_about_a_stable_input_cone_not_just_a_type
         (boot! 31)
         (let [lhs (con-int 2)
               rhs (con-int 3)
               sum (add-make-mode lhs rhs MODE-INT)]
           (n-keep! sum)
           (opto-reset-to-top!)
           (opto-sccp!)
           (assert (n-proven? sum))
           ;; The result still carries the plausible old type, but one producer has changed and
           ;; queued its users. A type-only predicate cannot distinguish this state from proof.
           (n-force-ty! lhs (ty-int-con 7))
           (code-add-outputs! lhs)
           (assert (not (n-proven? sum)))))

(deftest recursive_numeric_mode_resolution_follows_phi_evidence_and_float_wins
         (boot! 41)
         (let [st (start-make (ty-int-bot))
               region (region-make)]
           (region-add-path! region (cproj-make st 0 "left"))
           (region-add-path! region (cproj-make st 0 "right"))
           (let [value (phi-make region TY-BOT "number")]
             (phi-add-value! value (con-int 1))
             (phi-add-value! value (con-flt 2.5))
             (let [sum (add-make value value)]
               (n-keep! sum)
               (assert-eq (add-mode sum) MODE-UNKNOWN)
               (assert-eq (opto-resolve-numeric-modes!) 1)
               (assert-eq (add-mode sum) MODE-FLT)
               (assert (code-on-worklist? (n-nid sum)))))))

(deftest numeric_mode_evidence_crosses_a_call_result_projection
         (boot! 43)
         (let [st (start-make (ty-int-bot))
               sig (ty-tuple-of2 TY-BOT TY-BOT)
               fun (fun-make st sig "returns.float")
               ret
                 (return-make fun
                              (None [(dyn NodeOps)])
                              (con-flt 1.5)
                              (None [(dyn NodeOps)])
                              (Some fun))
               call (call-make st)]
           (fun-set-ret! fun ret)
           (call-set-fptr! call (funptr-make fun 91))
           (let [end (callend-make call)]
             (call-link! call fun)
             (let [result (proj-make end RETURN-VALUE "result")]
               ;; Model the recursive unresolved component: the projection itself is only BOTTOM,
               ;; while the linked Return supplies the concrete float evidence.
               (n-force-ty! result TY-BOT)
               (let [sum (add-make result result)]
                 (n-keep! sum)
                 (assert-eq (opto-resolve-numeric-modes!) 1)
                 (assert-eq (add-mode sum) MODE-FLT))))))

(deftest post_sccp_handoff_queues_even_unchanged_live_nodes
         (boot! 47)
         (let [n (con-make (ty-int-range 1 9))]
           (n-keep! n)
           (assert (not (code-on-worklist? (n-nid n))))
           (assert (>= (opto-move-changes-to-worklist!) 1))
           (assert (code-on-worklist? (n-nid n)))))
