;; The runtime shape tree against the compiler's: the blob round-trips, offsets agree, runtime
;; transitions extend the tree past the static ids, and the shared ABI constants agree.
(module aot.tests.rt-shapes)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "aot.shape" :use *)
(import "aot.type.type" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.rt.shapes" :use *)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.heap" :use *)
(import "aot.rt.rt" :use *)

(deftest runtime_and_compiler_agree_on_the_shared_representation_constants
         (assert-eq RT-DYNAMIC-UNDEFINED-WORD DYNAMIC-UNDEFINED-WORD)
         (assert-eq RT-OFFSET-OBJECT-PROPERTIES OFFSET-OBJECT-PROPERTIES)
         (assert-eq RT-DYNAMIC-PREFIX-OBJECT DYNAMIC-PREFIX-OBJECT)
         (assert-eq RT-DYNAMIC-PREFIX-EXCEPTION DYNAMIC-PREFIX-EXCEPTION)
         (assert-eq RT-DYNAMIC-PREFIX-ARRAY DYNAMIC-PREFIX-ARRAY)
         (assert-eq RT-DYNAMIC-HOLE-WORD (primitive/ishl DYNAMIC-PREFIX-HOLE 48))
         (assert-eq RT-SHAPE-ELEMENTS SHAPE-ELEMENTS)
         (assert-eq RT-OFFSET-ARRAY-ELEMENTS OFFSET-ARRAY-ELEMENTS)
         (assert-eq RT-OFFSET-ARRAY-LENGTH OFFSET-ARRAY-LENGTH)
         (assert-eq RT-ARRAY-PAYLOAD-BYTES ARRAY-PAYLOAD-BYTES)
         (assert-eq SHAPES-ROOT SHAPE-EMPTY)
         (assert-eq SHAPES-WORD-BYTES SHAPE-WORD-BYTES))

(deftest the_static_blob_boots_a_tree_that_agrees_with_the_compiler
         (shape-reset!)
         (let [xy (shape-transition (shape-transition SHAPE-EMPTY "x") "y")
               yx (shape-transition (shape-transition SHAPE-EMPTY "y") "x")
               kx (shape-key-intern "x")
               ky (shape-key-intern "y")
               blob (shape-table-bytes)]
           (shapes-boot! (slice-data [u8] blob) (len blob))
           (assert (shapes-booted?))
           (assert-eq (shapes-count) (shape-count))
           (assert-eq (shapes-key-count) (shape-key-count))
           ;; Every static shape reads back field for field.
           (let [(mut s) 2]
             (loop (if (>= (load s) (shape-count))
                       (break 0)
                       (do
                         (assert-eq (shapes-field-count (load s)) (shape-field-count (load s)))
                         (assert-eq (shapes-key (load s)) (shape-field-key (load s)))
                         (set! (mut s) (+ (load s) 1))
                         (continue)))))
           ;; Offsets follow the introducing edge in both trees, so `{x,y}` and `{y,x}` disagree.
           (assert-eq (shapes-lookup-offset xy kx) (shape-offset-key xy kx))
           (assert-eq (shapes-lookup-offset xy ky) (shape-offset-key xy ky))
           (assert-eq (shapes-lookup-offset yx kx) (shape-offset-key yx kx))
           (assert-eq (shapes-lookup-offset yx ky) 0)
           (assert-eq (shapes-lookup-offset xy kx) 0)
           (assert-eq (shapes-lookup-offset SHAPES-ROOT kx) -1)
           (assert (not (shapes-has-key? (shape-transition SHAPE-EMPTY "x") ky)))
           ;; A runtime transition to an existing static edge finds it; a new key makes a new id
           ;; past every static one, memoised on (parent, key); an existing key changes nothing.
           (assert-eq (shapes-transition (shape-transition SHAPE-EMPTY "x") ky) xy)
           (let [kz (shape-key-intern "z")
                 static-count (shape-count)
                 xyz (shapes-transition xy kz)]
             (assert (>= xyz static-count))
             (assert-eq (shapes-transition xy kz) xyz)
             (assert-eq (shapes-transition xyz kz) xyz)
             (assert-eq (shapes-parent xyz) xy)
             (assert-eq (shapes-key xyz) kz)
             (assert-eq (shapes-offset xyz) (* 2 SHAPES-WORD-BYTES))
             (assert-eq (shapes-field-count xyz) 3)
             (assert-eq (shapes-lookup-offset xyz kx) 0)
             (assert-eq (shapes-lookup-offset xyz kz) 16)
             (assert-eq (shapes-count) (+ static-count 1)))))

;; The static heap image round-trips: the runtime adopts the compiler's blob, relocates every
;; reference word to the blob's address, publishes the global object, and reads back the same
;; objects, shapes and property words the compiler laid out.
(deftest the_static_heap_image_adopts_relocates_and_agrees_with_the_compiler
         (shape-reset!)
         (heap-reset! DYNAMIC-PREFIX-OBJECT)
         (rt-heap-reset! 4096)
         (let [global (heap-add-object! DYNAMIC-NULL-WORD)
               fobj (heap-add-function! 0 DYNAMIC-NULL-WORD)
               proto (heap-add-object! DYNAMIC-NULL-WORD)
               (mut units) (al-new [i64] (alloc/malloc-allocator))]
           (push! [i64] (mut units) 0x45)
           (push! [i64] (mut units) 0x72)
           (let [name (heap-add-string! (load units))]
             (assert-eq (heap-add-string! (load units)) name)
             (heap-define-own! proto "constructor" (heap-ref-word DYNAMIC-PREFIX-FUNCTION fobj) HEAP-WORD-REF)
             (heap-define-own! proto "name" (heap-ref-word DYNAMIC-PREFIX-STRING name) HEAP-WORD-REF)
             (heap-define-own! fobj "prototype" (heap-ref-word DYNAMIC-PREFIX-OBJECT proto) HEAP-WORD-REF)
             (heap-define-own! global "f" (heap-ref-word DYNAMIC-PREFIX-FUNCTION fobj) HEAP-WORD-REF)
             (heap-define-own! global "x" DYNAMIC-UNDEFINED-WORD HEAP-WORD-CONST)
             ;; Redefining a present key changes its word, not the layout.
             (heap-define-own! global "x" (heap-ref-word DYNAMIC-PREFIX-OBJECT proto) HEAP-WORD-REF)
             (heap-set-global! global)
             (heap-image-build!)
             ;; The runtime's generic property path reads offsets from the shape blob.
             (let [shapes (shape-table-bytes)] (shapes-boot! (slice-data [u8] shapes) (len shapes)))
             (let [blob (heap-image-bytes)
                   bytes (len blob)
                   base (primitive/cast i64 (slice-data [u8] blob))]
               (assert-eq HEAP-HEADER-BYTES RT-HEADER-BYTES)
               (assert-eq HEAP-META-HAS-BOXED RT-META-HAS-BOXED)
               ;; One code word (the function's); five property REF words and three storage pointers.
               (assert-eq (heap-code-fixup-count) 1)
               (assert-eq (heap-code-fixup-fidx 0) 0)
               (assert-eq (heap-reloc-count) 8)
               (rt-statics-adopt! (slice-data [u8] blob) bytes)
               (let [g (+ base (heap-entry-offset global))
                     f (+ base (heap-entry-offset fobj))
                     p (+ base (heap-entry-offset proto))
                     n (+ base (heap-entry-offset name))]
                 (assert (rt-static-payload? g))
                 (assert (rt-static-payload? n))
                 (assert (not (rt-static-payload? (- base 8))))
                 (assert-eq (.global-object (rt-heap)) (rt-box-object g))
                 (assert-eq (rt-payload-shape g) SHAPE-EMPTY)
                 (assert-eq (rt-payload-bytes f) FUNCTION-PAYLOAD-BYTES)
                 (assert-eq (rt-payload-shape n) RT-SHAPE-STRING)
                 (assert-eq (rt-string-length n) 2)
                 (assert-eq (rt-string-code-unit n 1) 0x72)
                 ;; The generic runtime property path reads the relocated words.
                 (assert-eq (rt-prop-get-own g (shape-key-intern "f"))
                            (| (primitive/ishl DYNAMIC-PREFIX-FUNCTION 48) f))
                 (assert-eq (rt-prop-get-own g (shape-key-intern "x")) (rt-box-object p))
                 (assert-eq (rt-prop-get-own f (shape-key-intern "prototype")) (rt-box-object p))
                 (assert-eq (rt-prop-get-own p (shape-key-intern "name"))
                            (| (primitive/ishl DYNAMIC-PREFIX-STRING 48) n))
                 (assert-eq (rt-prop-has-own p (shape-key-intern "constructor")) 1)
                 ;; The code word is the linker's: zero in the image.
                 (assert-eq (load (primitive/cast (ptr i64) (+ f OFFSET-FUNCTION-CODE))) 0)
                 ;; A forwarded image word is itself: nothing in the image moves.
                 (assert-eq (rt-forward g) g)
                 (assert (rt-verify-reference? (rt-box-object g) false)))))))
