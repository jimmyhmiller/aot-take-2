;; The runtime shape tree against the compiler's: the blob round-trips, offsets agree, runtime
;; transitions extend the tree past the static ids, and the shared ABI constants agree.
(module aot.tests.rt-shapes)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "aot.shape" :use *)
(import "aot.type.type" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.rt.shapes" :use *)
(import "aot.rt.rt" :use [RT-DYNAMIC-UNDEFINED-WORD RT-OFFSET-OBJECT-PROPERTIES RT-DYNAMIC-PREFIX-OBJECT])

(deftest runtime_and_compiler_agree_on_the_shared_representation_constants
         (assert-eq RT-DYNAMIC-UNDEFINED-WORD DYNAMIC-UNDEFINED-WORD)
         (assert-eq RT-OFFSET-OBJECT-PROPERTIES OFFSET-OBJECT-PROPERTIES)
         (assert-eq RT-DYNAMIC-PREFIX-OBJECT DYNAMIC-PREFIX-OBJECT)
         (assert-eq SHAPES-ROOT SHAPE-EMPTY)
         (assert-eq SHAPES-WORD-BYTES SHAPE-WORD-BYTES))

(deftest the_static_blob_boots_a_tree_that_agrees_with_the_compiler
         (shape-reset!)
         (let [xy (shape-transition (shape-transition SHAPE-EMPTY "x") "y")
               yx (shape-transition (shape-transition SHAPE-EMPTY "y") "x")
               kx (shape-key-intern "x")
               ky (shape-key-intern "y")
               blob (shape-table-bytes)]
           (shapes-boot! (slice-data [u8] blob) (len blob))
           (assert (shapes-booted?))
           (assert-eq (shapes-count) (shape-count))
           (assert-eq (shapes-key-count) (shape-key-count))
           ;; Every static shape reads back field for field.
           (let [(mut s) 2]
             (loop (if (>= (load s) (shape-count))
                       (break 0)
                       (do
                         (assert-eq (shapes-field-count (load s)) (shape-field-count (load s)))
                         (assert-eq (shapes-key (load s)) (shape-field-key (load s)))
                         (set! (mut s) (+ (load s) 1))
                         (continue)))))
           ;; Offsets follow the introducing edge in both trees, so `{x,y}` and `{y,x}` disagree.
           (assert-eq (shapes-lookup-offset xy kx) (shape-offset-key xy kx))
           (assert-eq (shapes-lookup-offset xy ky) (shape-offset-key xy ky))
           (assert-eq (shapes-lookup-offset yx kx) (shape-offset-key yx kx))
           (assert-eq (shapes-lookup-offset yx ky) 0)
           (assert-eq (shapes-lookup-offset xy kx) 0)
           (assert-eq (shapes-lookup-offset SHAPES-ROOT kx) -1)
           (assert (not (shapes-has-key? (shape-transition SHAPE-EMPTY "x") ky)))
           ;; A runtime transition to an existing static edge finds it; a new key makes a new id
           ;; past every static one, memoised on (parent, key); an existing key changes nothing.
           (assert-eq (shapes-transition (shape-transition SHAPE-EMPTY "x") ky) xy)
           (let [kz (shape-key-intern "z")
                 static-count (shape-count)
                 xyz (shapes-transition xy kz)]
             (assert (>= xyz static-count))
             (assert-eq (shapes-transition xy kz) xyz)
             (assert-eq (shapes-transition xyz kz) xyz)
             (assert-eq (shapes-parent xyz) xy)
             (assert-eq (shapes-key xyz) kz)
             (assert-eq (shapes-offset xyz) (* 2 SHAPES-WORD-BYTES))
             (assert-eq (shapes-field-count xyz) 3)
             (assert-eq (shapes-lookup-offset xyz kx) 0)
             (assert-eq (shapes-lookup-offset xyz kz) 16)
             (assert-eq (shapes-count) (+ static-count 1)))))
