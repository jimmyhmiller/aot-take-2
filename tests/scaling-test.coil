;; Compile time must be LINEAR in the program (docs/SCALING.md). These tests compile the same

;; program shape at N and at 2N and gate on the RATIO of deterministic counts.

;;
;; Counts, never wall time: the suite runs in parallel, so elapsed time measures the machine's load
;; (CLAUDE.md). The counts are the optimizer's own — peephole visits, worklist pushes, inline
;; candidates asked, rounds — and a ratio near 2 for a doubled program is what linear means. A ratio
;; near 4 is quadratic, and that is what main measured on 2026-09-20.
;;
;; Two shapes, because they meet different hubs:
;;   WIDE  N functions, each called once: many Funs, many Returns on Stop, shared constants.
;;   HUB   one function called N times: one Fun whose inputs are all N call sites, and Parms
;;         likewise — the shape every shared runtime function has, and the one lodash died on.
;;
;; THE CEILINGS ARE A RATCHET, not the goal. Each is set just above what was measured when it was
;; written, with the measurement beside it; a fix that improves a ratio lowers its ceiling in the same
;; commit. The goal for every ratio is 2.2.
(module aot.tests.scaling)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.assert" :use *)
(import "coil.str" :use [sb-new sb-push-str! sb-push-i64! sb-str])
(import "aot.node.node"
        :use
        [code-stat-work-pushes
         code-stat-work-pushes-reset!
         code-stat-use-scan-steps
         code-stat-use-scan-steps-reset!])
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.pipeline" :use *)

(defstruct ScalingCounts
  [(visits i64) (pushes i64) (asks i64) (rounds i64) (scans i64)])

;; N functions and N calls, one call each.
(defn scaling-wide-source [(n i64)] (-> (slice u8))
  (let [(mut b) (sb-new (alloc/malloc-allocator))
        (mut i) 0]
    (sb-push-str! (mut b) "var total = 0;\n")
    (loop (if (>= (load i) n)
              (break 0)
              (do
                (sb-push-str! (mut b) "function f")
                (sb-push-i64! (mut b) (load i))
                (sb-push-str! (mut b)
                              "(a, b, c) { if (b === undefined) return a + ")
                (sb-push-i64! (mut b) (load i))
                (sb-push-str! (mut b) "; return a; }\n")
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) n)
              (break 0)
              (do
                (sb-push-str! (mut b) "total = total + f")
                (sb-push-i64! (mut b) (load i))
                (sb-push-str! (mut b) "(")
                (sb-push-i64! (mut b) (load i))
                (sb-push-str! (mut b) ");\n")
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (sb-str (load b))))

;; One function, N calls. `_noInline` keeps it a callee, so it stays a hub with N callers instead of
;; dissolving into its callers.
(defn scaling-hub-source [(n i64)] (-> (slice u8))
  (let [(mut b) (sb-new (alloc/malloc-allocator))
        (mut i) 0]
    (sb-push-str! (mut b)
                  "var total = 0;\nfunction hub_noInline(a, b, c) { if (b === undefined) return a + 1; return a; }\n")
    (loop (if (>= (load i) n)
              (break 0)
              (do
                (sb-push-str! (mut b) "total = total + hub_noInline(")
                (sb-push-i64! (mut b) (load i))
                (sb-push-str! (mut b) ");\n")
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (sb-str (load b))))

(defn scaling-compile [(source (slice u8))] (-> ScalingCounts)
  (let [(mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut sources) source)
    (iter-stats-reset!)
    (code-stat-work-pushes-reset!)
    (code-stat-use-scan-steps-reset!)
    (let [answer
            (pipeline-compile-macho-sources! (load sources)
                                             "/tmp/aot-take-2-scaling.o"
                                             1
                                             true)]
      (assert (> answer 0))
      (al-free! (mut sources))
      (ScalingCounts
        :visits (iter-stat-visits)
        :pushes (code-stat-work-pushes)
        :asks (iter-stat-inline-asks)
        :rounds (iter-stat-rounds)
        :scans (code-stat-use-scan-steps)))))

;; ratio × 100, so the ceilings are integers: 220 is "2.2 times".
(defn scaling-ratio [(small i64) (large i64)] (-> i64)
  (if (<= small 0) 0 (/ (* large 100) small)))

(defn scaling-report [(shape (slice u8))
                      (n i64)
                      (small ScalingCounts)
                      (large ScalingCounts)] (-> i64)
  (do
    (println "scaling {s}: N={} -> {}: visits {} -> {} (x{}), pushes {} -> {} (x{}), asks {} -> {} (x{}), rounds {} -> {} (x{}), use-scan steps {} -> {} (x{})  [ratios are x100]"
             shape
             n
             (* n 2)
             (.visits small)
             (.visits large)
             (scaling-ratio (.visits small) (.visits large))
             (.pushes small)
             (.pushes large)
             (scaling-ratio (.pushes small) (.pushes large))
             (.asks small)
             (.asks large)
             (scaling-ratio (.asks small) (.asks large))
             (.rounds small)
             (.rounds large)
             (scaling-ratio (.rounds small) (.rounds large))
             (.scans small)
             (.scans large)
             (scaling-ratio (.scans small) (.scans large)))
    0))

;; A ratio ceiling, x100: `large` may be at most `ceiling`/100 times `small`.
(defn scaling-within? [(small i64) (large i64) (ceiling i64)] (-> bool)
  (<= (scaling-ratio small large) ceiling))

;; Measured 2026-09-20, N=60 -> 120 (ratios x100; linear is 200):
;;
;;                       main (265c1ea)              with hub position hints
;;   visits              132,094 ->   360,621 x273   122,564 ->   352,812 x287
;;   pushes            1,752,967 -> 5,311,490 x303 1,790,108 -> 5,417,992 x302
;;   asks                  3,181 ->     5,312 x167     3,520 ->     5,998 x170
;;   rounds                  364 ->       855 x235       295 ->       863 x292
;;   use-scan steps    1,226,911 -> 4,233,274 x345   128,804 ->   411,089 x319
;;
;; The scan is a tenth of what it was and now tracks visits (about 1.2 steps a visit) instead of
;; hub size. Visits, pushes and rounds are still superlinear: that is the open work in
;; docs/SCALING.md, and these ceilings come down as it lands. The visit and round counts move by
;; +-15% with any change to worklist order, so the ratio ceilings carry that much headroom; the
;; absolute scan ceiling is the tight one.
(deftest scaling_wide_program_counts_grow_linearly
         (let [small (scaling-compile (scaling-wide-source 60))
               large (scaling-compile (scaling-wide-source 120))]
           (scaling-report "wide" 60 small large)
           (assert (> (.visits small) 0))
           (assert (scaling-within? (.visits small) (.visits large) 330))
           (assert (scaling-within? (.pushes small) (.pushes large) 340))
           (assert (scaling-within? (.asks small) (.asks large) 210))
           (assert (scaling-within? (.rounds small) (.rounds large) 340))
           (assert (< (.scans large) 600000))))

;; Measured 2026-09-20, N=60 -> 120:
;;
;;                       main (265c1ea)              with hub position hints
;;   visits               46,496 ->    67,641 x145    50,632 ->    69,725 x137
;;   pushes              604,997 -> 1,455,543 x240   644,963 -> 1,395,508 x216
;;   rounds                   86 ->        87 x101        90 ->        92 x102
;;   use-scan steps      497,559 -> 1,343,619 x270    82,667 ->   134,890 x163
(deftest scaling_hub_program_counts_grow_linearly
         (let [small (scaling-compile (scaling-hub-source 60))
               large (scaling-compile (scaling-hub-source 120))]
           (scaling-report "hub" 60 small large)
           (assert (> (.visits small) 0))
           (assert (scaling-within? (.visits small) (.visits large) 170))
           (assert (scaling-within? (.pushes small) (.pushes large) 250))
           (assert (scaling-within? (.rounds small) (.rounds large) 125))
           (assert (< (.scans large) 200000))))
