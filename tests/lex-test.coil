;; Token spans remain views into retained source; newline presence is parser-visible for ASI.

(module aot.tests.lex)
(import "coil.assert" :use *)
(import "aot.parse.lexer" :use *)
(import "coil.os" :as os)
(import "coil.primitive" :as primitive)
(import "aot.util.panic" :use *)

(defn lex-test-number [(source (slice u8)) (expected i64)] (-> i64)
  (lex-init! source)
  (let [t (lex-next! false)]
    (assert-eq (.kind t) expected)
    (assert-eq (token-text t) source)
    (let [end (lex-next! false)] (assert-eq (.kind end) TOK-EOF))
    0))

(defn lex-test-invalid-number [(source (slice u8))] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (do (lex-init! source) (set! (.typed-diagnostics (lexer-state)) true)
            (lex-next! false) (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (primitive/iand (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-SYNTAX) 0))))

(deftest numeric_tokens_cover_decimal_radix_separators_and_bigint_boundaries
  (lex-test-number "1.25e+2" TOK-NUMBER)
  (lex-test-number ".5e-1" TOK-NUMBER)
  (lex-test-number "1." TOK-NUMBER)
  (lex-test-number "1_234.5_6e7_8" TOK-NUMBER)
  (lex-test-number "0xAB_cd" TOK-NUMBER)
  (lex-test-number "0o7_7" TOK-NUMBER)
  (lex-test-number "0b1_0" TOK-NUMBER)
  (lex-test-number "077" TOK-LEGACY-NUMBER)
  (lex-test-number "089.5" TOK-NUMBER)
  (lex-test-number "123_456n" TOK-BIGINT)
  (lex-test-number "0Xf_fn" TOK-BIGINT)
  (lex-init! "1..x 1 .x")
  (assert (token-is (lex-next! false) "1."))
  (assert (token-is (lex-next! false) "."))
  (assert (token-is (lex-next! false) "x"))
  (assert (token-is (lex-next! false) "1"))
  (assert (token-is (lex-next! false) ".")))

(deftest string_continuations_and_raw_unicode_separators_preserve_token_lines
  (lex-init! "'a\\\r\nb\\\nc\\\rd\\ e\\ f g h' next")
  (let [literal (lex-next! false)]
    (assert-eq (.kind literal) TOK-STRING)
    (assert-eq (.line literal) 1))
  (let [next (lex-next! false)]
    (assert (token-is next "next"))
    (assert-eq (.line next) 8)))

(deftest malformed_numeric_literals_never_become_valid_prefixes
  (lex-test-invalid-number "10._1")
  (lex-test-invalid-number "10._e1")
  (lex-test-invalid-number "10._")
  (lex-test-invalid-number "1__2")
  (lex-test-invalid-number "0_1")
  (lex-test-invalid-number "01_2")
  (lex-test-invalid-number "1e+")
  (lex-test-invalid-number "1e_2")
  (lex-test-invalid-number "0x")
  (lex-test-invalid-number "0x_1")
  (lex-test-invalid-number "0b102")
  (lex-test-invalid-number "0o8")
  (lex-test-invalid-number "1.0n")
  (lex-test-invalid-number "01n")
  (lex-test-invalid-number "1n0")
  (lex-test-invalid-number "123abc"))

(deftest lexer_preserves_string_spans_and_the_newline_needed_for_asi
         (lex-init! "return 'hello';\n42")
         (lex-peek false)
         (assert-eq (lex-consumed-end) 0)
         (let [ret (lex-next! false)
               string-token (lex-next! false)
               semi (lex-next! false)
               number (lex-next! false)]
           (assert-eq (.kind ret) TOK-KEYWORD)
           (assert-eq (.kind string-token) TOK-STRING)
           (assert-eq (token-text string-token) "'hello'")
           (assert (token-is semi ";"))
           (assert-eq (.kind number) TOK-NUMBER)
           (assert (.nl-before number))
           (assert-eq (lex-consumed-end) (.end number))))

(deftest comments_and_all_line_terminators_preserve_asi
         (lex-init! "a/*metadata*/b/*\r\n*/c//line\rd//line\x2028;e/*\x2029;*/f")
         (assert (token-is (lex-next! false) "a"))
         (let [b (lex-next! false)]
           (assert (token-is b "b"))
           (assert (not (.nl-before b))))
         (let [c (lex-next! false) d (lex-next! false) e (lex-next! false) f (lex-next! false)]
           (assert (token-is c "c"))
           (assert (.nl-before c))
           (assert-eq (.line c) 2)
           (assert (token-is d "d"))
           (assert (.nl-before d))
           (assert-eq (.line d) 3)
           (assert (token-is e "e"))
           (assert (.nl-before e))
           (assert-eq (.line e) 4)
           (assert (token-is f "f"))
           (assert (.nl-before f))
           (assert-eq (.line f) 5)))

(deftest whitespace_does_not_become_a_line_terminator
         (lex-init! "﻿a      　b")
         (assert (token-is (lex-next! false) "a"))
         (let [b (lex-next! false)]
           (assert (token-is b "b"))
           (assert (not (.nl-before b)))))

(deftest punctuators_use_maximal_munch_including_unadmitted_operators
         (lex-init! "&& || ?? ??= === !== >>>= ++ ?. ?")
         (assert (token-is (lex-next! false) "&&"))
         (assert (token-is (lex-next! false) "||"))
         (assert (token-is (lex-next! false) "??"))
         (assert (token-is (lex-next! false) "??="))
         (assert (token-is (lex-next! false) "==="))
         (assert (token-is (lex-next! false) "!=="))
         (assert (token-is (lex-next! false) ">>>="))
         (assert (token-is (lex-next! false) "++"))
         (assert (token-is (lex-next! false) "?."))
         (assert (token-is (lex-next! false) "?")))
