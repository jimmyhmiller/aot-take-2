;; Property tests over generated ideal graphs.

;;
;; These use Coil's property runner directly because the graph recipe itself is generated from the
;; runner's Source. DRAW modes build the tape without checking, and RUN modes check the resulting
;; graph. Counterexamples still replay, shrink, persist, and carry reproduction seeds normally.
(module aot.tests.graph-property)
(import "coil.assert" :use *)
(import "coil.prop.source" :use *)
(import "coil.prop.runner" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.tests.graph-gen" :use *)
(import "aot.type.type" :use *)

(defn prop-generated-expression-edges [(s (ptr Source)) (mode i64)] (-> bool)
  (let [depth (draw-int! s 1 6)]
    (boot! (draw-int! s 1 9223372036854775807))
    (let [g (graph-gen-expr! s depth)]
      (n-keep! (.root g))
      (prop-collect! "nodes" (.nodes g))
      (prop-classify! "shared operand" (> (.shared g) 0))
      (if (>= mode PROP-MODE-DRAW) true (graph-edges-symmetric?)))))

(defn prop-generated-expression-model [(s (ptr Source)) (mode i64)] (-> bool)
  (let [depth (draw-int! s 1 6)
        seed (draw-int! s 1 9223372036854775807)]
    (boot! seed)
    (let [g (graph-gen-expr! s depth)
          st (start-make (ty-int-bot))
          ;; Return is pinned and remains a stable observer while Add reassociation replaces roots.
          probe
            (return-make (cproj-make st 0 "prop.ctrl")
                         (None [(dyn NodeOps)])
                         (.root g)
                         (None [(dyn NodeOps)])
                         (None [(dyn NodeOps)]))]
      (n-keep! probe)
      (if (>= mode PROP-MODE-DRAW)
          true
          (do
            (iter-seed-all!)
            (iter-run!)
            (and (= (n-op (n-in! probe RETURN-VALUE)) OP-CON)
                 (and (= (n-ty (n-in! probe RETURN-VALUE)) (ty-int-con (.value g)))
                      (and (= (iter-check-fixpoint) 0) (graph-edges-symmetric?)))))))))

(defn prop-generated-control-lockstep [(s (ptr Source)) (mode i64)] (-> bool)
  (let [diamonds (draw-int! s 1 8)]
    (boot! (draw-int! s 1 9223372036854775807))
    (let [g (graph-gen-control! s diamonds)]
      (n-keep! (.ctrl g))
      (n-keep! (.value g))
      (prop-collect! "diamonds" (.diamonds g))
      (if (>= mode PROP-MODE-DRAW)
          true
          (and (graph-phi-arities-match?) (graph-edges-symmetric?))))))

(deftest generated_expression_graphs_have_symmetric_edges
         (prop-run "generated_expression_graphs_have_symmetric_edges"
                   "tests/graph-property-test.coil"
                   57
                   (fnptr-of prop-generated-expression-edges)))

(deftest generated_expression_graphs_fold_to_the_independent_model
         (prop-run "generated_expression_graphs_fold_to_the_independent_model"
                   "tests/graph-property-test.coil"
                   63
                   (fnptr-of prop-generated-expression-model)))

(deftest generated_control_graphs_keep_region_phi_lockstep
         (prop-run "generated_control_graphs_keep_region_phi_lockstep"
                   "tests/graph-property-test.coil"
                   69
                   (fnptr-of prop-generated-control-lockstep)))
