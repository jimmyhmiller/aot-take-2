;; The dynamic value: Box, Unbox, TypeTest, Cast, and guards as control flow.

;;
;; This is the unit that makes the compiler a JavaScript compiler rather than a Simple compiler, and
;; the one where a TypeScript annotation stops costing anything.
(module aot.tests.dynamic)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.type.type" :use *)

;; ---------------------------------------------------------------------------
;; The axis
(deftest a_singleton_low_tag_set_is_a_proven_representation
         ;; The test that decides whether a value unboxes and lives in a register rather than as a
         ;; NaN-boxed word.
         (boot! 1)
         (assert (ty-monomorphic? (ty-dyn TAG-INT)))
         (assert (not (ty-monomorphic? (ty-dyn TAG-NUMBER))))  ; int-or-double: two tags
         (assert (not (ty-monomorphic? (ty-dyn TAG-ANY))))
         ;; A HIGH singleton is not proven — it is the optimistic mirror, not a claim.
         (assert (not (ty-monomorphic? (ty-dyn-high TAG-INT)))))

(deftest the_dynamic_axis_meets_by_union_and_duals_by_flipping_the_flag
         (boot! 1)
         ;; More possibilities is more general.
         (assert-eq (ty-meet (ty-dyn TAG-INT) (ty-dyn TAG-STRING))
                    (ty-dyn (+ TAG-INT TAG-STRING)))
         (assert-eq (ty-meet (ty-dyn TAG-INT) (ty-dyn TAG-INT)) (ty-dyn TAG-INT))
         ;; The high mirror meets by intersection.
         (assert-eq (ty-meet (ty-dyn-high TAG-NUMBER) (ty-dyn-high TAG-INT)) (ty-dyn-high TAG-INT))
         ;; An empty stored high intersection denotes the full universe, canonical low(ALL).
         (assert-eq (ty-meet (ty-dyn-high TAG-INT) (ty-dyn-high TAG-STRING))
                    (ty-dyn TAG-ANY))
         ;; Dual flips the flag and KEEPS the set — that is why the flag exists.
         (assert-eq (ty-dual (ty-dyn TAG-INT)) (ty-dyn-high TAG-INT))
         (assert-eq (ty-dual (ty-dual (ty-dyn TAG-NUMBER))) (ty-dyn TAG-NUMBER))
         (assert (ty-high? (ty-dyn-high TAG-INT)))
         (assert (not (ty-high? (ty-dyn TAG-INT)))))

(deftest empty_complemented_tag_sets_canonicalize_to_the_opposite_endpoint
         ;; The two spellings of each complemented-set endpoint share one canonical type.
         (boot! 1)
         (assert-eq (ty-dyn 0) (ty-dyn-high TAG-ANY))
         (assert-eq (ty-dyn-high 0) (ty-dyn TAG-ANY)))

;; ---------------------------------------------------------------------------
;; Box / Unbox
(deftest boxing_produces_a_singleton_tag_set
         ;; And that singleton is what makes `Unbox(Box(x))` provable — the tag is not merely known, it has
         ;; exactly one member.
         (boot! 1)
         (assert-eq (box-compute-ty (ty-int-con 5)) (ty-dyn TAG-INT))
         (assert-eq (box-compute-ty (ty-int-bot)) (ty-dyn TAG-INT))
         (assert-eq (box-compute-ty (ty-flt-bot)) (ty-dyn TAG-DOUBLE))
         (assert-eq (box-compute-ty (raw-object-ty)) (ty-dyn TAG-OBJECT))
         ;; A high input stays high.
         (assert-eq (box-compute-ty TY-TOP) TY-TOP))

(deftest boxing_refuses_a_type_that_is_not_a_raw_representation
         ;; Guessing a tag here produces a value that reads back as the wrong type, and nothing downstream
         ;; would catch it.
         (boot! 1)
         (assert-eq (box-compute-ty TY-CTRL) TY-BOT))

(deftest unboxing_refuses_a_value_that_is_not_dynamic
         ;; Inventing a raw type would let an unproven value flow into arithmetic as if it were a number.
         (boot! 1)
         (assert-eq (unbox-compute-ty (ty-int-bot) REP-INT) TY-BOT))

(deftest object_unboxing_produces_the_canonical_managed_payload_type
         (boot! 1)
         (assert-eq (unbox-compute-ty (ty-dyn TAG-OBJECT) REP-OBJECT) (raw-object-ty)))

(deftest string_boxing_and_unboxing_use_the_string_tag_and_payload_type
         (do
           (boot! 1)
           (assert-eq (box-tag-of (raw-string-ty)) TAG-STRING)
           (assert-eq (unbox-compute-ty (ty-dyn TAG-STRING) REP-STRING) (raw-string-ty))))

(deftest an_unbox_requires_representation_proof_not_a_raw_result_type
         (boot! 1)
         (let [unknown (con-make (ty-dyn TAG-ANY))
               proven (con-make (ty-dyn TAG-INT))]
           ;; Both nodes can compute an integer representation while the graph is converging. Only
           ;; the singleton tag is evidence that code generation may actually perform the unbox.
           (assert (not (unbox-proven? (unbox-make unknown REP-INT))))
           (assert (unbox-proven? (unbox-make proven REP-INT)))))

(deftest the_backend_handoff_rejects_a_live_unproven_unbox
         (boot! 1)
         ;; A TypeScript annotation can at most leave this dynamic value at TAG-ANY. Producing an
         ;; integer-shaped result does not make the machine operation safe.
         (let [unknown (con-make (ty-dyn TAG-ANY))]
           (n-keep! (unbox-make unknown REP-INT))
           (assert (not (live-unboxes-proven?)))))

(deftest unboxing_a_tag_the_value_cannot_carry_is_unreachable
         ;; TOP says "this path cannot be taken", which is what lets the dead branch of a guard fold away.
         (boot! 1)
         (assert-eq (unbox-compute-ty (ty-dyn TAG-STRING) REP-INT) TY-TOP))

(deftest box_then_unbox_cancels
         ;; >>> THE PEEPHOLE THAT PRODUCES UNBOXED CODE. <<<
         ;; JSL wraps every result in `%Box` and every operand in `%UnboxInt`. Once inlining has put a Box
         ;; next to an Unbox they annihilate, leaving raw arithmetic.
         (boot! 1)
         (let [x (con-int 7)
               b (box-make x)
               u (unbox-make b REP-INT)]
           (assert (match (n-peephole-opt! u) (Some [r] (n-same? r x)) (None [] false)))))

(deftest box_then_unbox_as_a_DIFFERENT_representation_does_not_cancel
         ;; `Unbox_double(Box_int(x))` is NOT `x` — it is a reinterpretation, and folding it would read an
         ;; integer's bits as a double.
         (boot! 1)
         (let [x (con-int 7)
               b (box-make x)
               u (unbox-make b REP-DOUBLE)]
           ;; It must NOT become `x`. Folding to a constant is correct and expected: an unbox of a tag the
           ;; value cannot carry is unreachable, so its type is TOP and the engine replaces it.
           (assert (match (n-peephole-opt! u) (Some [r] (not (n-same? r x))) (None [] true)))))

;; ---------------------------------------------------------------------------
;; TypeTest
(deftest a_typetest_on_a_proven_subset_folds_TRUE
         ;; >>> WHERE A DISCHARGED TYPESCRIPT ANNOTATION CASHES OUT. <<<
         ;; Once the fixpoint has proven a parameter is int-only, the check must pass, and the branch goes.
         (boot! 1)
         (assert-eq (typetest-compute-ty (ty-dyn TAG-INT) TAG-NUMBER) (ty-true))
         (assert-eq (typetest-compute-ty (ty-dyn TAG-NUMBER) TAG-NUMBER) (ty-true)))

(deftest a_typetest_on_a_disjoint_set_folds_FALSE
         (boot! 1)
         (assert-eq (typetest-compute-ty (ty-dyn TAG-STRING) TAG-NUMBER) (ty-false)))

(deftest a_typetest_on_an_overlapping_set_stays_UNDECIDED
         ;; And the branch survives — which is the sound half, and the one that matters.
         (boot! 1)
         (assert-eq (typetest-compute-ty (ty-dyn (+ TAG-INT TAG-STRING)) TAG-NUMBER) (ty-bool)))

(deftest a_typetest_on_a_high_input_stays_high
         (boot! 1)
         (assert (ty-high? (typetest-compute-ty TY-TOP TAG-NUMBER))))

;; ---------------------------------------------------------------------------
;; Cast — the value half
(deftest a_cast_narrows_by_joining
         ;; A Cast can only NARROW. Joining with something incompatible gives the high end, which says
         ;; "unreachable" rather than "some value".
         (boot! 1)
         (assert-eq (cast-compute-ty (ty-dyn TAG-ANY) (ty-dyn TAG-INT)) (ty-dyn TAG-INT))
         (assert-eq (cast-compute-ty (ty-dyn TAG-NUMBER) (ty-dyn TAG-INT)) (ty-dyn TAG-INT)))

(deftest a_cast_on_an_already_narrow_value_discharges_itself
         ;; >>> THE SINGLE MOST IMPORTANT PEEPHOLE IN THE TYPESCRIPT STORY. <<<
         ;; The input already `isa` the cast type, so the assertion adds nothing and the guard's value side
         ;; costs zero.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               v (con-make (ty-dyn TAG-INT))
               cast (cast-make c v (ty-dyn TAG-NUMBER))]
           (assert (match (n-peephole-opt! cast) (Some [r] (n-same? r v)) (None [] false)))))

(deftest a_cast_on_an_unanalysed_input_REFUSES_to_discharge
         ;; If this fired on a high input, `ty-isa? ANY t` is true for every `t` and EVERY cast would
         ;; discharge itself — the guard mechanism erasing itself.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               v (con-make TY-TOP)
               cast (cast-make c v (ty-dyn TAG-INT))]
           ;; It must NOT become `v`. A high input makes the Cast's own type high, so the engine replaces
           ;; it with a constant — what matters is that the DISCHARGE rule did not fire.
           (assert (match (n-peephole-opt! cast) (Some [r] (not (n-same? r v))) (None [] true)))))

(deftest a_cast_that_actually_narrows_survives
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               v (con-make (ty-dyn TAG-ANY))
               cast (cast-make c v (ty-dyn TAG-INT))]
           (assert-eq (n-ty cast) (ty-dyn TAG-INT))
           ;; It must NOT become `v`. A high input makes the Cast's own type high, so the engine replaces
           ;; it with a constant — what matters is that the DISCHARGE rule did not fire.
           (assert (match (n-peephole-opt! cast) (Some [r] (not (n-same? r v))) (None [] true)))))

(deftest a_cast_is_pinned
         ;; It asserts something true only ON ITS EDGE. Unpin it and the narrowed value escapes to a path
         ;; where the narrowing was never established.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               v (con-make (ty-dyn TAG-ANY))]
           (assert (is-pinned-of? (cast-make c v (ty-dyn TAG-INT))))))

;; ---------------------------------------------------------------------------
;; The whole guard — D4 in one test
(deftest a_guard_is_ordinary_control_flow
         ;; `If(TypeTest(v, T))` then `Cast(T)` on the taken edge. No Guard opcode: every CFG peephole,
         ;; dominator pass and code-motion pass already understands If/Region/Phi/Cast.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               v (con-make (ty-dyn TAG-ANY))
               g (guard! c v TAG-INT)]
           ;; The value is narrowed on the true edge.
           (assert-eq (n-ty (guard-narrowed g)) (ty-dyn TAG-INT))
           ;; Both arms exist and are live: nothing was proven, so the branch stays.
           (assert-ne (n-op (guard-true g)) OP-XCTRL)
           (assert-ne (n-op (guard-false g)) OP-XCTRL)))

(deftest a_guard_on_a_PROVEN_value_folds_away_entirely
         ;; >>> THE WHOLE POINT. A discharged annotation costs NOTHING: the test folds TRUE, the If folds
         ;; >>> to one arm, the false arm becomes XCtrl, and the Cast discharges into its input.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               v (con-make (ty-dyn TAG-INT))  ; already proven int
               g (guard! c v TAG-NUMBER)]
           ;; The dead arm is gone.
           (assert-eq (n-op (guard-false g)) OP-XCTRL)
           ;; And the narrowing itself discharges.
           (assert (match (n-peephole-opt! (guard-narrowed g))
                     (Some [r] (n-same? r v))
                     (None [] false)))))

;; ---------------------------------------------------------------------------
;; The two guards that `compute` makes unreachable through `peephole`
;;
;; `n-peephole-opt!` computes a type FIRST, and for both of these the type comes back high — so the
;; engine replaces the node with a constant and `idealize` never runs. Simple has exactly the same
;; shape (`GuardNode.compute` returns TOP for a TOP input, and its `idealize` still tests for it).
;;
;; The guards are real, and a direct call is the only thing that reaches them. Testing them through
;; `peephole` would produce a test that passes with the guard REMOVED — which is no test at all.
(deftest unbox_idealize_refuses_to_cancel_a_mismatched_representation
         ;; `Unbox_double(Box_int(x))` is a REINTERPRETATION, not an identity: folding it would read an
         ;; integer's bits as a double.
         (boot! 1)
         (let [x (con-int 7)
               b (box-make x)
               u (unbox-make b REP-DOUBLE)]
           (assert (match (unbox-idealize u) (Some [_] false) (None [] true))))
         ;; And the matching case still cancels, so the refusal is not simply "never fires".
         (let [y (con-int 9)
               b2 (box-make y)
               u2 (unbox-make b2 REP-INT)]
           (assert (match (unbox-idealize u2) (Some [r] (n-same? r y)) (None [] false)))))

(deftest cast_idealize_refuses_to_discharge_on_an_unanalysed_input
         ;; If it fired here, `ty-isa? ANY t` is true for every `t` and EVERY cast would discharge itself —
         ;; the guard mechanism erasing itself. This is the single most dangerous loosening in the file.
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               c (cproj-make st 0 "ctrl")
               v (con-make TY-TOP)
               cast (cast-make c v (ty-dyn TAG-INT))]
           (assert (match (cast-idealize cast) (Some [_] false) (None [] true))))
         ;; And an analysed input that already satisfies the cast DOES discharge, so the refusal is
         ;; specific rather than a blanket "never".
         (let [st2 (start-make (ty-int-bot))
               c2 (cproj-make st2 0 "ctrl")
               v2 (con-make (ty-dyn TAG-INT))
               cast2 (cast-make c2 v2 (ty-dyn TAG-NUMBER))]
           (assert (match (cast-idealize cast2) (Some [r] (n-same? r v2)) (None [] false)))))

(deftest truthiness_refines_integer_values_on_each_control_projection
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               ctrl (cproj-make st 0 "ctrl")
               value (con-make (ty-int-range 0 9))
               iff (if-make ctrl value)
               arms (if-arms! iff)
               on-true (truthiness-refine! (arms-true arms) value)
               on-false (truthiness-refine! (arms-false arms) value)]
           (assert-eq (n-ty on-true) (ty-int-range 1 9))
           (assert-eq (n-ty on-false) (ty-int-con 0))
           (assert (is-pinned-of? on-true))
           (assert (is-pinned-of? on-false))))

(deftest truthiness_refines_dynamic_tag_sets_without_claiming_value_precision
         (boot! 1)
         (let [all (ty-dyn TAG-ANY)
               true-tags (ty-dyn-tags (truthiness-refine-ty all true))
               false-tags (ty-dyn-tags (truthiness-refine-ty all false))]
           (assert (not (= (primitive/iand true-tags TAG-UNDEFINED) TAG-UNDEFINED)))
           (assert (not (= (primitive/iand true-tags TAG-NULL) TAG-NULL)))
           (assert (= (primitive/iand true-tags TAG-OBJECT) TAG-OBJECT))
           (assert (not (= (primitive/iand false-tags TAG-OBJECT) TAG-OBJECT)))
           (assert (not (= (primitive/iand false-tags TAG-FUNCTION) TAG-FUNCTION)))
           ;; Bool, number, and string remain on the false arm because false, zero/NaN, and the
           ;; empty string are values inside those tags.
           (assert (= (primitive/iand false-tags TAG-BOOL) TAG-BOOL))
           (assert (= (primitive/iand false-tags TAG-NUMBER) TAG-NUMBER))
           (assert (= (primitive/iand false-tags TAG-STRING) TAG-STRING))))
