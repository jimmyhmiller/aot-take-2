(deftest a_generic_use_boundary_keeps_the_spillable_middle_split
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "split-boundary")
                 arg (parm-make fun 0 (ty-int-bot) "arg")
                 value (add-make arg (con-make (ty-int-con 5000)))
                 ret (return-make fun
                                  (Some (con-make (ty-mem 1 TY-BOT)))
                                  value
                                  (None [(dyn NodeOps)])
                                  (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-value (n-in! selected-ret RETURN-VALUE)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (sched-run!)
               (let [before-padding (arena-node-count) (mut padding) 0]
                 (loop (if (>= (load padding) 256)
                           (break 0)
                           (do
                             (con-make (ty-int-con (+ 20000 (load padding))))
                             (set! (mut padding) (+ (load padding) 1))
                             (continue))))
                 (assert (>= (- (arena-node-count) before-padding) 256)))
               (assert (ra-build-lrg! 0))
               (let [leader (ra-lrg-of! selected-value)]
                 ;; Final Simple's findAllLRG follows this value's local def-use component. The
                 ;; disconnected arena padding above must not appear in the failed-range workset.
                 (assert (< (len (ra-find-all-lrg leader)) 16))
                 (assert (ra-split-by-loop-boundary! 0 leader))
                 (let [use-split (n-in! selected-ret RETURN-VALUE)
                       middle-split (n-in! use-split 1)]
                   (assert-eq (n-op use-split) OP-MACH-SPLIT)
                   (assert-eq (n-op middle-split) OP-MACH-SPLIT)
                   ;; Simple's generic ordinary-use path passes skip=false. The use-side split
                   ;; must retain the middle spillable range instead of bypassing it back to the
                   ;; original finite-register definition.
                   (assert (n-same? (n-in! middle-split 1) selected-value))
                   (assert (not (n-dead? middle-split)))
                   ;; Biased coloring can give the outer and original ranges the same register
                   ;; while the middle spill range differs. Final Simple bypasses that chain when
                   ;; the block has no intervening clobber, then removes the outer no-op Split.
                   (sched-run!)
                   (assert-eq (len (ra-snapshot-scheduled-splits)) 2)
                   (n-set-reg! selected-value 7)
                   (n-set-reg! middle-split 8)
                   (n-set-reg! use-split 7)
                   (ra-post-colour!)
                   (assert (n-same? (n-in! selected-ret RETURN-VALUE) selected-value))))))))

(deftest postcolor_split_bypass_respects_intervening_machine_kills
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (arm64-select
                       (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "kill-bypass"))
                 source (arm64-select (con-make (ty-int-con 17)))
                 high (arm64-split-make 1 "high" 0)
                 call (arm64-call-alloc (call-make fun) false true 2 4)
                 low (arm64-split-make 2 "low" 0)
                 block-id (n-nid fun)]
             (arm64-split-bind! high fun source)
             (arm64-split-bind! low fun high)
             (n-set-reg! source ARM-X0)
             (n-set-reg! high 65)
             (n-set-reg! low ARM-X0)
             (n-set-block-nid! fun block-id)
             (n-set-block-nid! source block-id)
             (n-set-block-nid! high block-id)
             (n-set-block-nid! call block-id)
             (n-set-block-nid! low block-id)
             (push! [i64] (mut (.cfg (code))) block-id)
             (code-schedule-reset!)
             (code-schedule-begin-block! fun)
             (code-schedule-add! fun fun)
             (code-schedule-add! fun source)
             (code-schedule-add! fun high)
             (code-schedule-add! fun call)
             (code-schedule-add! fun low)
             (code-schedule-end-block! fun)
             ;; The call itself has no allocated output, but its kill mask invalidates X0. Looking
             ;; only at scheduled result registers would incorrectly bypass the spill/reload pair.
             (arm64-call-set-kill-mask! call (mask-of ARM-X0))
             (assert (not (ra-post-colour-bypass! low ARM-X0)))
             (assert (n-same? (n-in! low 1) high))
             (arm64-call-set-kill-mask! call (mask-of ARM-X1))
             (assert (ra-post-colour-bypass! low ARM-X0))
             (assert (n-same? (n-in! low 1) source)))))

(deftest full_allocator_spills_a_callee_save_range_for_a_value_live_across_a_call
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "callee-spill")
                 arg (parm-make fun 0 (ty-int-bot) "x")
                 value (add-make arg (con-make (ty-int-con 5000)))
                 object-ty (ty-struct "CalleeSpillObject")
                 allocation
                   (new-make fun
                             (con-make (ty-int-con 32))
                             (con-make (ty-mem 1 TY-BOT))
                             SHAPE-EMPTY
                             object-ty)]
             ;; Keep `value` above the call, then consume it below the call without giving that
             ;; dependency a machine register. The resulting LRG must survive the caller-save kill.
             (n-add-def! allocation (Some value))
             (let [memory (proj-make allocation 1 "allocation.memory")
                   post (add-make value (con-make (ty-int-con 9)))
                   stop (stop-make)]
               (n-add-def! post (Some allocation))
               (let [ret (return-make fun
                                      (Some memory)
                                      post
                                      (None [(dyn NodeOps)])
                                      (Some fun))]
                 (fun-set-ret! fun ret)
                 (stop-add-return! stop ret)
                 (looptree-build! start stop)
                 (let [selected-stop (arm64-select-graph stop)
                       selected-ret (n-in! selected-stop 0)
                       selected-post (n-in! selected-ret RETURN-VALUE)
                       selected-value (n-in! selected-post 1)
                       selected-fun (n-in! selected-ret RETURN-CTRL)
                       selected-start (n-in! selected-fun 1)]
                   (code-set-roots! selected-start selected-stop)
                   (gcm-build-cfg!)
                   (sched-run!)
                   (let [rounds (ra-run!)]
                     (assert (> rounds 0))
                     (assert (< rounds RA-MAX-ROUNDS)))
                   (assert (>= (n-reg selected-value) ARM-X19))
                   (assert (not (mask-test (arm64-caller-save) (n-reg selected-value))))))))))

(deftest incompatible_fixed_parameter_definitions_are_split_before_a_phi_retry
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 sig (ty-tuple-of3 (ty-int-bot) (ty-int-bot) (ty-int-bot))
                 fun (fun-make start sig "fixed-def-phi")
                 left (parm-make fun 0 (ty-int-bot) "left")
                 right (parm-make fun 1 (ty-int-bot) "right")
                 arms (if-arms! (if-make fun (con-make (ty-int-range 0 1))))
                 region (region-make)]
             (region-add-path! region (arms-true arms))
             (region-add-path! region (arms-false arms))
             (let [phi (phi-make region (ty-int-bot) "merged")]
               (phi-add-value! phi left)
               (phi-add-value! phi right)
               (let [ret (return-make region
                                      (Some (con-make (ty-mem 1 TY-BOT)))
                                      phi
                                      (None [(dyn NodeOps)])
                                      (Some fun))
                     stop (stop-make)]
                 (fun-set-ret! fun ret)
                 (stop-add-return! stop ret)
                 (looptree-build! start stop)
                 (let [selected-stop (arm64-select-graph stop)
                       selected-ret (n-in! selected-stop 0)
                       selected-phi (n-in! selected-ret RETURN-VALUE)
                       selected-region (n-in! selected-phi 0)
                       selected-fun (n-in! (n-in! (n-in! selected-region 1) 0) 0)
                       selected-start (n-in! selected-fun 1)]
                   (code-set-roots! selected-start selected-stop)
                   (gcm-build-cfg!)
                   (sched-run!)
                   (assert (not (ra-build-lrg! 0)))
                   (assert-eq (ra-split-all! 0) 1)
                   (assert-eq (n-op (n-in! selected-phi 1)) OP-MACH-SPLIT)
                   (assert-eq (n-op (n-in! selected-phi 2)) OP-MACH-SPLIT)
                   (assert (ra-build-lrg! 1))))))))

(deftest a_loop_invariant_backedge_phi_arm_is_split_on_its_own_edge
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of3 (ty-int-bot) (ty-int-bot) (ty-int-bot))
                               "invariant-backedge")
                 initial (parm-make fun 0 (ty-int-bot) "initial")
                 next (parm-make fun 1 (ty-int-bot) "next")
                 boxed-initial (box-make-at (Some fun) initial)
                 boxed-next (box-make-at (Some fun) next)
                 loop-node (loop-make fun)
                 phi (phi-make loop-node (ty-dyn TAG-ANY) "value")]
             (phi-add-value! phi boxed-initial)
             (phi-open! phi)
             (let [arms (if-arms! (if-make loop-node (con-make (ty-int-range 0 1))))
                   back (arms-true arms)
                   exit (arms-false arms)
                   ret (return-make exit
                                    (Some (con-make (ty-mem 1 TY-BOT)))
                                    phi
                                    (None [(dyn NodeOps)])
                                    (Some fun))
                   stop (stop-make)]
               (loop-close! loop-node back)
               ;; Unlike an induction update, this backedge value is defined before loop entry.
               ;; It overlaps the cold arm until both Phi uses are isolated on their CFG edges.
               (phi-close! phi boxed-next)
               (fun-set-ret! fun ret)
               (stop-add-return! stop ret)
               (looptree-build! start stop)
               (let [selected-stop (arm64-select-graph stop)
                     selected-ret (n-in! selected-stop 0)
                     selected-phi (n-in! selected-ret RETURN-VALUE)
                     selected-loop (n-in! selected-phi 0)
                     cold-before (n-in! selected-phi 1)
                     hot-before (n-in! selected-phi 2)
                     cold-pred (n-in! selected-loop 1)
                     hot-pred (n-in! selected-loop 2)
                     selected-fun (n-in! selected-loop 1)
                     selected-start (n-in! selected-fun 1)]
                 (code-set-roots! selected-start selected-stop)
                 (gcm-build-cfg!)
                 (sched-run!)
                 (let [cold-block (ra-ifg-block-of cold-pred)
                       hot-block (ra-ifg-block-of hot-pred)]
                   (assert (ra-build-lrg! 0))
                   ;; Explicit Phi edge uses carry the hot arm around the loop and expose the
                   ;; overlapping definitions as a self-conflict.
                   (assert (not (ra-build-ifg! 0)))
                   (assert-eq (ra-split-all! 0) 1)
                   (let [cold-after (n-in! selected-phi 1)]
                     (assert (not (n-same? cold-after cold-before)))
                     (assert (n-same? (n-in! selected-phi 2) hot-before))
                     (assert-eq (n-block-nid cold-after) (n-nid cold-block)))
                   (assert (ra-build-lrg! 1))
                   (assert (not (ra-build-ifg! 1)))
                   (assert-eq (ra-split-all! 1) 1)
                   (let [hot-after (n-in! selected-phi 2)]
                     (assert (not (n-same? hot-after hot-before)))
                     (assert-eq (n-block-nid hot-after) (n-nid hot-block)))
                   (assert (ra-build-lrg! 2))
                   (assert (ra-build-ifg! 2))
                   (assert (ra-coalesce! 2))
                   (assert (ra-colour! 2))))))))

(deftest loop_phi_self_conflicts_split_the_cold_edge_before_the_hot_definition
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "loop-self")
                 loop-node (loop-make fun)
                 phi (phi-make loop-node (ty-int-bot) "induction")]
             (phi-add-value! phi (con-make (ty-int-con 0)))
             (phi-open! phi)
             (let [arms (if-arms! (if-make loop-node (con-make (ty-int-range 0 1))))
                   back (arms-true arms)
                   exit (arms-false arms)
                   next (add-make phi (con-make (ty-int-con 1)))
                   ret (return-make exit
                                    (Some (con-make (ty-mem 1 TY-BOT)))
                                    phi
                                    (None [(dyn NodeOps)])
                                    (Some fun))
                   stop (stop-make)]
               (loop-close! loop-node back)
               (phi-close! phi next)
               (fun-set-ret! fun ret)
               (stop-add-return! stop ret)
               (looptree-build! start stop)
               (let [selected-stop (arm64-select-graph stop)
                     selected-ret (n-in! selected-stop 0)
                     selected-phi (n-in! selected-ret RETURN-VALUE)
                     selected-loop (n-in! selected-phi 0)
                     selected-cold (n-in! selected-phi 1)
                     selected-hot (n-in! selected-phi 2)
                     cold-pred (n-in! selected-loop 1)
                     hot-pred (n-in! selected-loop 2)]
                 (match (mach-of selected-loop)
                   (Some [mach] (assert (= (m-ideal-op mach) OP-LOOP)))
                   (None [] (assert false)))
                 ;; This test isolates splitting from GCM: install the exact block facts that GCM
                 ;; supplies for a loop Phi and its predecessor-edge uses.
                 (n-set-block-nid! cold-pred (n-nid cold-pred))
                 (n-set-block-nid! hot-pred (n-nid hot-pred))
                 (n-set-block-nid! selected-loop (n-nid selected-loop))
                 (n-set-block-nid! selected-phi (n-nid selected-loop))
                 (n-set-block-nid! selected-hot (n-nid hot-pred))
                 ;; Disconnected arena population must not multiply self-conflict use discovery.
                 ;; Final Simple walks the sparse def-output lists of the sorted conflict set.
                 (let [before-padding (arena-node-count) (mut padding) 0]
                   (loop (if (>= (load padding) 256)
                             (break 0)
                             (do
                               (con-make (ty-int-con (+ 10000 (load padding))))
                               (set! (mut padding) (+ (load padding) 1))
                               (continue))))
                   (assert (>= (- (arena-node-count) before-padding) 256)))
                 (ra-reset-state! 0)
                 (let [leader (ra-new-lrg! selected-phi)]
                   (ra-assign-to-lrg! selected-cold leader)
                   (ra-assign-to-lrg! selected-hot leader)
                   (ra-self-conflict! leader selected-phi)
                   (assert (ra-split-self-conflict! 0 leader))
                   (assert (< (ra-self-conflict-use-visits) 32))
                   ;; Final Simple rematerializes a cloneable cold constant at the Phi edge instead
                   ;; of manufacturing a copy pseudo-instruction around it.
                   (let [cold-copy (n-in! selected-phi 1)]
                     (assert (not (n-same? cold-copy selected-cold)))
                     (assert-eq (ra-ideal-op cold-copy) OP-CON)
                     (match (mach-of cold-copy)
                       (Some [mach] (assert (m-clone-cheap? mach)))
                       (None [] (assert false))))
                   (assert (n-same? (n-in! selected-phi 2) selected-hot))
                   ;; The remembered Phi receives its hot definition split only if the conflict
                   ;; survives into the following allocation round.
                   (ra-reset-state! 1)
                   (let [next-leader (ra-new-lrg! selected-phi)]
                     (ra-assign-to-lrg! selected-hot next-leader)
                     (ra-self-conflict! next-leader selected-phi)
                     (assert (ra-split-self-conflict! 1 next-leader))
                     (assert-eq (n-op (n-in! selected-hot 1)) OP-MACH-SPLIT))))))))

(deftest colouring_reports_an_at_risk_clique_that_has_fewer_colours_than_vertices
         (do
           (boot! 1)
           (ra-reset-state! 0)
           (let [a (con-make (ty-int-bot))
                 b (con-make (ty-int-bot))
                 c (con-make (ty-int-bot))
                 aid (ra-new-lrg! a)
                 bid (ra-new-lrg! b)
                 cid (ra-new-lrg! c)
                 two (mask-or (mask-of 0) (mask-of 1))]
             (assert (ra-lrg-and-mask! aid two))
             (assert (ra-lrg-and-mask! bid two))
             (assert (ra-lrg-and-mask! cid two))
             (ra-ifg-add! aid bid)
             (ra-ifg-add! aid cid)
             (ra-ifg-add! bid cid)
             (assert (not (ra-colour! 0)))
             (assert (> (ra-first-failed) 0))
             (assert-eq (n-reg a) -1))))
