;; Hidden-class transition tree and inherited aliases.
(module aot.tests.shape)
(import "coil.assert" :use *)
(import "aot.shape" :use *)

(deftest a_transition_is_memoized_on_parent_and_field_name
         (let [a (shape-transition SHAPE-EMPTY "x")
               b (shape-transition SHAPE-EMPTY "x")]
           (assert-eq a b)
           (assert-eq (shape-field-count a) 1)))

(deftest descendant_shapes_inherit_the_introducing_alias_and_offset
         (let [x (shape-transition SHAPE-EMPTY "inherited-x")
               xy (shape-transition x "inherited-y")]
           (assert (shape-has? xy "inherited-x"))
           (assert (shape-has? xy "inherited-y"))
           (assert-eq (shape-alias xy "inherited-x") (shape-alias x "inherited-x"))
           (assert-eq (shape-offset xy "inherited-x") (shape-offset x "inherited-x"))
           (assert-eq (shape-offset x "inherited-x") 0)
           (assert-eq (shape-offset xy "inherited-y") SHAPE-WORD-BYTES)
           (assert-eq (shape-field-count xy) 2)))

(deftest adding_an_existing_field_changes_no_layout
         (let [x (shape-transition SHAPE-EMPTY "stable-x")]
           (assert-eq (shape-transition x "stable-x") x)))

(deftest property_order_produces_distinct_hidden_classes
         (let [x (shape-transition SHAPE-EMPTY "order-x")
               xy (shape-transition x "order-y")
               y (shape-transition SHAPE-EMPTY "order-y")
               yx (shape-transition y "order-x")]
           (assert-ne xy yx)
           (assert-ne (shape-alias xy "order-x") (shape-alias yx "order-x"))))
