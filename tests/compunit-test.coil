(extern setenv :cc c [(ptr i8) (ptr i8) i32] (-> i32))
(extern unsetenv :cc c [(ptr i8)] (-> i32))


(defn compunit-test-int [(value i64)] (-> i64)
  (| (primitive/ishl DYNAMIC-PREFIX-INT 48) value))

(defn compunit-test-declaration-refuses [(kind i64) (ordinal i64) (name (slice u8))] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (let [(mut entries) (al-new [CuScriptDecl] (alloc/malloc-allocator))
              plan (primitive/alloc-stack CuScriptDeclarations)]
          (push! [CuScriptDecl] (mut entries) (CuScriptDecl :name name :kind kind :function-ordinal ordinal))
          (set! plan (cu-script-declarations-copy false (load entries)))
          (cu-script-declarations-free! plan) (al-free! (mut entries))
          (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-PANIC) 0))))

(deftest owned_script_declarations_reject_invalid_kinds_and_nonlocal_function_identities
  (compunit-test-declaration-refuses 0 -1 "x")
  (compunit-test-declaration-refuses CU-SCRIPT-FUNCTION 1 "f")
  (compunit-test-declaration-refuses CU-SCRIPT-VAR 0 "x")
  (compunit-test-declaration-refuses CU-SCRIPT-FUNCTION 0 ""))

(deftest symbolic_unit_identities_gvn_by_kind_and_identity_without_exposing_local_integer_values
  (compiler-session-reset!)
  (boot! 1)
  (let [kx (shape-key-intern "x") ky (shape-key-intern "y")
        sx (shape-transition SHAPE-EMPTY "x")
        x (n-peephole! (keyref-make kx)) y (n-peephole! (keyref-make ky))
        shape (n-peephole! (shaperef-make sx))
        root (n-peephole! (shaperef-make SHAPE-EMPTY))]
    (n-keep! x) (n-keep! y) (n-keep! shape) (n-keep! root)
    (assert (n-same? x (n-peephole! (keyref-make kx))))
    (assert (n-same? shape (n-peephole! (shaperef-make sx))))
    (assert (not (n-same? x y)))
    ;; Key 1 and root shape 1 inhabit different namespaces even within one unit.
    (assert-eq kx SHAPE-EMPTY)
    (assert (not (n-same? x root)))
    (assert (not (n-same? x (n-peephole! (con-int kx)))))
    (assert-eq (keyref-local x) kx)
    (assert-eq (keyref-local root) -1)
    (assert-eq (keyref-local (con-int kx)) -1)
    (assert-eq (label x) "KeyRef(1)")
    (assert-eq (label root) "ShapeRef(1)")
    (assert-eq (n-ty x) (ty-int-bot))
    (assert (not (ty-constant? (n-ty shape))))
    (assert-eq (n-op (shaperef-make SHAPE-STRING)) OP-CON)
    (assert-eq (n-ty (shaperef-make SHAPE-ELEMENTS)) (ty-int-con SHAPE-ELEMENTS))))

(deftest symbolic_unit_identity_consumers_do_not_fold_unit_local_numbers_during_sccp
  (compiler-session-reset!)
  (boot! 1)
  (let [key (shape-key-intern "x") x (keyref-make key)
        sum (add-make-mode x (con-int 10) MODE-INT)
        equal (cmp--make OP-EQ x (con-int key) MODE-INT)]
    (n-keep! sum) (n-keep! equal)
    (opto-reset-to-top!)
    (opto-sccp!)
    (assert-eq (n-ty x) (ty-int-bot))
    (assert (not (ty-constant? (n-ty sum))))
    (assert (not (ty-constant? (n-ty equal))))
    (assert-eq (n-op (n-peephole! sum)) OP-ADD)
    (assert-eq (n-op (n-peephole! equal)) OP-EQ)
    (assert-eq (unitref-local x) key)))

(deftest graph_copies_preserve_symbolic_key_and_shape_payloads
  (compiler-session-reset!)
  (boot! 1)
  (let [shape (shape-transition SHAPE-EMPTY "x")
        key (keyref-make (shape-key-intern "x")) ref (shaperef-make shape)
        (mut selected) (al-new [bool] (alloc/malloc-allocator)) (mut i) 0]
    (n-keep! key) (n-keep! ref)
    (loop (if (> (load i) (arena-node-count)) (break 0)
              (do (push! [bool] (mut selected)
                         (or (= (load i) (n-nid key)) (= (load i) (n-nid ref))))
                  (set! (mut i) (+ (load i) 1)) (continue))))
    (let [copy (graph-copy-selected (al-slice (load selected)))]
      (match (graph-copy-get copy key)
        (Some [fresh]
          (do (assert-eq (n-op fresh) OP-KEYREF)
              (assert-eq (keyref-local fresh) (keyref-local key))
              (assert (not (n-same? fresh key)))
              (assert-eq (n-ty fresh) (ty-int-bot))))
        (None [] (assert false)))
      (match (graph-copy-get copy ref)
        (Some [fresh]
          (do (assert-eq (n-op fresh) OP-SHAPEREF)
              (assert-eq (unitref-local fresh) shape)
              (assert (not (n-same? fresh ref)))
              (assert-eq (n-ty fresh) (ty-int-bot))))
        (None [] (assert false)))
      (graph-copy-free! copy))
    (al-free! (mut selected))))

(deftest merging_a_symbolic_identity_with_its_local_integer_does_not_prove_a_constant
  (compiler-session-reset!)
  (boot! 1)
  (let [key (shape-key-intern "x") x (keyref-make key)
        region (region-make) ctrl (con-make TY-CTRL)]
    (region-add-path! region ctrl)
    (region-add-path! region ctrl)
    (let [merged (phi-make region (ty-int-bot) "identity-or-integer")]
      (phi-add-value! merged x)
      (phi-add-value! merged (con-int key))
      (n-keep! merged)
      (opto-reset-to-top!)
      (opto-sccp!)
      (assert-eq (n-ty merged) (ty-int-bot))
      (assert-eq (n-op (n-peephole! merged)) OP-PHI))))

(defn compunit-test-identity-refuses [(op i64) (id i64)] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (do (unitref-make op id) (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-PANIC) 0))))

(deftest symbolic_identity_construction_rejects_unknown_keys_shapes_and_kinds
  (compiler-session-reset!)
  (boot! 1)
  (shape-key-intern "x")
  (compunit-test-identity-refuses OP-KEYREF 0)
  (compunit-test-identity-refuses OP-KEYREF (+ (shape-key-count) 1))
  (compunit-test-identity-refuses OP-SHAPEREF 0)
  (compunit-test-identity-refuses OP-SHAPEREF (shape-count))
  (compunit-test-identity-refuses OP-SHAPEREF SHAPE-STRING)
  (compunit-test-identity-refuses OP-CON 1))

(defstruct CompunitShapeFixture
  [(table (slice u8)) (image (slice u8)) (holder i64) (kx i64) (ky i64)
   (xy i64) (yx i64) (readonly i64) (accessor i64) (sealed i64)])

(deftest realm_object_maps_follow_payload_boundaries_and_reset_between_executions
  (compiler-session-reset!)
  (boot! 1)
  (let [holder (heap-add-object! DYNAMIC-NULL-WORD)
        (mut offsets) (al-new [i64] (alloc/malloc-allocator))
        (mut entry) 0 (mut round) 0]
    (heap-define-own! holder "x" (compunit-test-int 42) HEAP-WORD-CONST)
    (heap-define-own! holder "y" (compunit-test-int 99) HEAP-WORD-CONST)
    (heap-define-own! holder "z" DYNAMIC-UNDEFINED-WORD HEAP-WORD-CONST)
    (heap-add-object! DYNAMIC-NULL-WORD)
    (heap-image-build!)
    (loop (if (>= (load entry) (heap-count)) (break 0)
              (do (push! [i64] (mut offsets) (heap-entry-offset (load entry)))
                  (set! (mut entry) (+ (load entry) 1)) (continue))))
    (let [first (image-copy (heap-image-bytes)) second (image-copy (heap-image-bytes))]
      (compiler-session-reset!)
      (loop (if (>= (load round) 2) (break 0)
                (let [bytes (if (= (load round) 0) first second) h (rt-heap)]
                  (rt-heap-reset! 4096)
                  (assert-eq (load (.unit-objects h)) 0)
                  (assert-eq (len (.object-maps h)) 0)
                  (rt-unit-adopt! 0 (slice-data bytes) (len bytes))
                  (assert-eq (len (.object-maps h)) 1)
                  (let [objects (get (.object-maps h) 0)]
                    (assert-eq (len objects) (len (load offsets)))
                    (assert-eq (load (.unit-objects h)) (primitive/cast i64 (slice-data objects)))
                    (set! (mut entry) 0)
                    (al-for [offset (load offsets)]
                      (assert-eq (get objects (load entry)) (+ (primitive/cast i64 (slice-data bytes)) offset))
                      (set! (mut entry) (+ (load entry) 1))))
                  (rt-realm-destroy!)
                  (assert-eq (primitive/cast i64 (.unit-objects h)) 0)
                  (assert-eq (len (.object-maps h)) 0)
                  (set! (mut round) (+ (load round) 1)) (continue))))
      (alloc/free [u8] (alloc/malloc-allocator) first)
      (alloc/free [u8] (alloc/malloc-allocator) second))
    (al-free! (mut offsets))))

(defn compunit-test-shape-fixture [(perturb bool)] (-> CompunitShapeFixture)
  (compiler-session-reset!)
  (boot! 1)
  (if perturb
      (do (shape-key-intern "y") (shape-key-intern "x")
          (shape-transition SHAPE-EMPTY "unrelated") 0) 0)
  (let [xy (shape-transition (shape-transition SHAPE-EMPTY "x") "y")
        yx (shape-transition (shape-transition SHAPE-EMPTY "y") "x")
        readonly (shape-transition-attrs SHAPE-EMPTY "x" 6)
        accessor (shape-transition-attrs SHAPE-EMPTY "x" 14)
        sealed (shape-prevent-extensions xy)
        holder (heap-add-object! DYNAMIC-NULL-WORD)]
    (heap-define-own! holder "x" (compunit-test-int 42) HEAP-WORD-CONST)
    (heap-define-own! holder "y" (compunit-test-int 99) HEAP-WORD-CONST)
    (heap-image-build!)
    (CompunitShapeFixture :table (image-copy (shape-table-bytes)) :image (image-copy (heap-image-bytes))
                         :holder (heap-entry-offset holder) :kx (shape-key-intern "x") :ky (shape-key-intern "y")
                         :xy xy :yx yx :readonly readonly :accessor accessor :sealed sealed)))

(deftest shape_assembly_unifies_unit_identities_preserves_layout_and_owns_its_metadata
  (let [first (compunit-test-shape-fixture false) second (compunit-test-shape-fixture true)
        assembly (primitive/alloc-stack CuShapeAssembly)
        (mut blobs) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (assert-ne (.kx first) (.kx second))
    (assert-ne (.xy first) (.xy second))
    (push! [(slice u8)] (mut blobs) (.table first))
    (push! [(slice u8)] (mut blobs) (.table second))
    (push! [(slice u8)] (mut blobs) (.table first))
    (set! assembly (cu-shapes-compose (load blobs)))
    (assert-eq (len (.units assembly)) 3)
    (let [a (get (.units assembly) 0) b (get (.units assembly) 1) again (get (.units assembly) 2)
          data-a (image-copy (.image first)) data-b (image-copy (.image second))]
      (assert-eq (cu-remap-key a (.kx first)) (cu-remap-key b (.kx second)))
      (assert-eq (cu-remap-key a (.ky first)) (cu-remap-key b (.ky second)))
      (assert-eq (cu-remap-shape a (.xy first)) (cu-remap-shape b (.xy second)))
      (assert-eq (cu-remap-shape a (.yx first)) (cu-remap-shape b (.yx second)))
      (assert-eq (cu-remap-shape a (.xy first)) (cu-remap-shape again (.xy first)))
      (assert-ne (cu-remap-shape a (.xy first)) (cu-remap-shape a (.yx first)))
      (assert-eq (cu-remap-shape a SHAPE-STRING) SHAPE-STRING)
      (assert-eq (cu-remap-shape b SHAPE-ELEMENTS) SHAPE-ELEMENTS)
      (cu-remap-static-shapes! data-a a)
      (cu-remap-static-shapes! data-b b)
      ;; Assembly owns names, rows and maps after both source artifacts and compiler scratch die.
      (alloc/free [u8] (alloc/malloc-allocator) (.table first))
      (alloc/free [u8] (alloc/malloc-allocator) (.table second))
      (alloc/free [u8] (alloc/malloc-allocator) (.image first))
      (alloc/free [u8] (alloc/malloc-allocator) (.image second))
      (compiler-session-reset!)
      (rt-realm-destroy!)
      (rt-heap-reset! 4096)
      (shapes-boot! (slice-data (.blob assembly)) (len (.blob assembly)))
      (let [kx (cu-remap-key a (.kx first)) ky (cu-remap-key a (.ky first))
            xy (cu-remap-shape a (.xy first)) yx (cu-remap-shape b (.yx second))]
        (assert-eq (shapes-key-name kx) "x")
        (assert-eq (shapes-key-name ky) "y")
        (assert-eq (shapes-lookup-offset xy kx) 0)
        (assert-eq (shapes-lookup-offset xy ky) 8)
        (assert-eq (shapes-lookup-offset yx kx) 8)
        (assert-eq (shapes-lookup-offset yx ky) 0)
        (assert-eq (shapes-lookup-attrs (cu-remap-shape a (.readonly first)) kx) 6)
        (assert-eq (shapes-lookup-attrs (cu-remap-shape b (.accessor second)) kx) 14)
        (assert (not (shapes-extensible? (cu-remap-shape b (.sealed second)))))
        (assert-eq (shapes-transition (shapes-transition SHAPES-ROOT kx) ky) xy)
        (rt-statics-adopt! (slice-data data-a) (len data-a))
        (rt-statics-adopt! (slice-data data-b) (len data-b))
        ;; One canonical key addresses objects whose original shape/key numbers disagreed.
        (assert-eq (rt-prop-get-own (+ (primitive/cast i64 (slice-data data-a)) (.holder first)) kx) (compunit-test-int 42))
        (assert-eq (rt-prop-get-own (+ (primitive/cast i64 (slice-data data-b)) (.holder second)) ky) (compunit-test-int 99)))
      (rt-realm-destroy!)
      (alloc/free [u8] (alloc/malloc-allocator) data-a)
      (alloc/free [u8] (alloc/malloc-allocator) data-b))
    (cu-shapes-free! assembly)
    (al-free! (mut blobs))))

(deftest empty_shape_assembly_has_the_shared_root_and_no_property_keys
  (let [(mut blobs) (al-new [(slice u8)] (alloc/malloc-allocator))
        assembly (primitive/alloc-stack CuShapeAssembly)]
    (push! [(slice u8)] (mut blobs) "")
    (set! assembly (cu-shapes-compose (load blobs)))
    (compiler-session-reset!)
    (shapes-destroy!)
    (shapes-boot! (slice-data (.blob assembly)) (len (.blob assembly)))
    (assert-eq (shapes-count) 2)
    (assert-eq (shapes-key-count) 0)
    (let [map (get (.units assembly) 0)] (assert-eq (cu-remap-shape map 1) 1))
    (shapes-destroy!)
    (cu-shapes-free! assembly)
    (al-free! (mut blobs))))

(defn compunit-test-patch-u32! [(bytes (slice u8)) (offset i64) (value i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (= (load i) 4) (break 0)
              (do (set! (primitive/index (slice-data bytes) (+ offset (load i)))
                        (primitive/cast u8 (& (primitive/ishr value (* 8 (load i))) 255)))
                  (set! (mut i) (+ (load i) 1)) (continue))))))

(defn compunit-test-shape-refuses [(blob (slice u8)) (offset i64) (value i64) (extent i64)] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (let [copy (image-copy blob) (mut blobs) (al-new [(slice u8)] (alloc/malloc-allocator))]
          (compunit-test-patch-u32! copy offset value)
          (push! [(slice u8)] (mut blobs) (slice-new (slice-data copy) extent))
          (cu-shapes-compose (load blobs))
          (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-PANIC) 0))))

(deftest shape_assembly_rejects_invalid_extents_identities_and_field_layouts
  (let [fixture (compunit-test-shape-fixture false) blob (.table fixture) p (slice-data blob)
        extent (len blob) row (+ SHAPES-HEADER-BYTES (* 2 SHAPES-RECORD-BYTES))
        keys (+ SHAPES-HEADER-BYTES (* (shapes-read-u32 p 12) SHAPES-RECORD-BYTES))]
    (compunit-test-shape-refuses blob 0 0 extent)
    (compunit-test-shape-refuses blob 8 (+ SHAPES-VERSION 1) extent)
    (compunit-test-shape-refuses blob 12 0xffffffff extent)
    (compunit-test-shape-refuses blob 8 SHAPES-VERSION 8)
    (compunit-test-shape-refuses blob 8 SHAPES-VERSION (- extent 1))
    (compunit-test-shape-refuses blob SHAPES-HEADER-BYTES 1 extent)
    (compunit-test-shape-refuses blob keys 1 extent)
    (compunit-test-shape-refuses blob (+ keys SHAPES-KEY-RECORD-BYTES) 0xffffffff extent)
    (compunit-test-shape-refuses blob row 2 extent)
    (compunit-test-shape-refuses blob (+ row 4) (shapes-read-u32 p 16) extent)
    (compunit-test-shape-refuses blob (+ row 8) 8 extent)
    (compunit-test-shape-refuses blob (+ row 12) 2 extent)
    (compunit-test-shape-refuses blob (+ row 16) 16 extent)
    (compunit-test-shape-refuses blob (+ row 20) 2 extent)
    (compunit-test-shape-refuses blob
      (+ (+ SHAPES-HEADER-BYTES (* (.sealed fixture) SHAPES-RECORD-BYTES)) 8) 0 extent)
    (alloc/free [u8] (alloc/malloc-allocator) blob)
    (alloc/free [u8] (alloc/malloc-allocator) (.image fixture))))

(defn compunit-test-static-shape-refuses [(blob (slice u8)) (map CuIdentityMap)
                                        (offset i64) (value i64)] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (let [copy (image-copy blob)]
          (compunit-test-patch-u32! copy offset value)
          (cu-remap-static-shapes! copy map)
          (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-PANIC) 0))))

(deftest static_shape_remapping_rejects_bad_headers_and_unknown_unit_shapes
  (let [fixture (compunit-test-shape-fixture false)
        assembly (primitive/alloc-stack CuShapeAssembly)
        (mut blobs) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut blobs) (.table fixture))
    (set! assembly (cu-shapes-compose (load blobs)))
    (let [map (get (.units assembly) 0) blob (.image fixture)
          entries (shapes-read-u32 (slice-data blob) 28)]
      (compunit-test-static-shape-refuses blob map 0 0)
      (compunit-test-static-shape-refuses blob map 8 0)
      (compunit-test-static-shape-refuses blob map 12 0xffffffff)
      (compunit-test-static-shape-refuses blob map 24 0xffffffff)
      (compunit-test-static-shape-refuses blob map 28 0)
      (compunit-test-static-shape-refuses blob map entries 0xffffffff)
      (compunit-test-static-shape-refuses blob map (+ entries 16) 0)
      (compunit-test-static-shape-refuses blob map (+ entries 16) (len (.shapes map))))
    (cu-shapes-free! assembly)
    (al-free! (mut blobs))
    (alloc/free [u8] (alloc/malloc-allocator) (.table fixture))
    (alloc/free [u8] (alloc/malloc-allocator) (.image fixture))))

(deftest shape_assembly_is_deterministic_and_does_not_mutate_its_inputs
  (let [a (compunit-test-shape-fixture false) b (compunit-test-shape-fixture true)
        source-a (image-copy (.table a)) source-b (image-copy (.table b))
        first (primitive/alloc-stack CuShapeAssembly) second (primitive/alloc-stack CuShapeAssembly)
        (mut blobs) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut blobs) (.table a))
    (push! [(slice u8)] (mut blobs) (.table b))
    (set! first (cu-shapes-compose (load blobs)))
    (compiler-session-reset!)
    (set! second (cu-shapes-compose (load blobs)))
    (assert-eq (.blob first) (.blob second))
    (assert-eq (.table a) source-a)
    (assert-eq (.table b) source-b)
    (cu-shapes-free! first) (cu-shapes-free! second)
    (al-free! (mut blobs))
    (alloc/free [u8] (alloc/malloc-allocator) source-a)
    (alloc/free [u8] (alloc/malloc-allocator) source-b)
    (alloc/free [u8] (alloc/malloc-allocator) (.table a))
    (alloc/free [u8] (alloc/malloc-allocator) (.table b))
    (alloc/free [u8] (alloc/malloc-allocator) (.image a))
    (alloc/free [u8] (alloc/malloc-allocator) (.image b))))

(deftest native_abi_descriptors_survive_reset_and_distinguish_representations_and_entries
  (compiler-session-reset!)
  (boot! 1)
  (let [first (image-abi-describe (callabi-signature) false)]
    (compiler-session-reset!)
    (boot! 2)
    ;; Perturb type identities before rebuilding the same signature.
    (ty-struct "UnrelatedBeforeTheImportedSignature")
    (let [second (image-abi-describe (callabi-signature) false)
          host (image-abi-describe (callabi-signature) true)
          raw (image-abi-describe (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) false)
          flt (image-abi-describe (ty-tuple-of2 (ty-int-bot) (ty-flt-bot)) false)
          boxed (image-abi-describe (ty-tuple-of2 (ty-int-bot) (ty-dyn TAG-ANY)) false)
          scalar-box (image-abi-describe (ty-tuple-of2 (ty-int-bot) (ty-dyn TAG-INT)) false)
          scalar-ret (image-abi-describe (ty-tuple-of2 (ty-dyn TAG-INT) (ty-int-bot)) false)
          boxed-ret (image-abi-describe (ty-tuple-of2 (ty-dyn TAG-ANY) (ty-int-bot)) false)
          managed (image-abi-describe (ty-tuple-of2 (ty-int-bot) (callabi-vector-type)) false)
          pointer (image-abi-describe (ty-tuple-of2 (ty-int-bot) (ty-ptr false (ty-struct "Host"))) false)
          unknown (image-abi-describe (ty-tuple-of2 TY-BOT TY-BOT) false)]
      (assert (image-abi-compatible? first second))
      (assert (not (image-abi-compatible? first host)))
      (assert (not (image-abi-compatible? host host)))
      (assert (not (image-abi-compatible? first raw)))
      (assert (not (image-abi-compatible? raw flt)))
      (assert (not (image-abi-compatible? raw boxed)))
      (assert (image-abi-compatible? scalar-box boxed))
      (assert (not (image-abi-compatible? boxed scalar-box)))
      (assert (image-abi-compatible? boxed-ret scalar-ret))
      (assert (not (image-abi-compatible? scalar-ret boxed-ret)))
      (assert (not (image-abi-compatible? pointer managed)))
      (assert (not (image-abi-compatible? unknown unknown)))
      (assert (not (image-abi-compatible? (slice-new (slice-data first) 4) first)))
      ;; Even two identically corrupted descriptors cannot authorize a binding.
      (set! (primitive/index (slice-data second) 8) (primitive/cast u8 (+ IMAGE-ABI-VERSION 1)))
      (assert (not (image-abi-compatible? second second)))
      (let [a (alloc/malloc-allocator)]
        (alloc/free [u8] a second) (alloc/free [u8] a host)
        (alloc/free [u8] a raw) (alloc/free [u8] a flt) (alloc/free [u8] a boxed) (alloc/free [u8] a scalar-box)
        (alloc/free [u8] a scalar-ret) (alloc/free [u8] a boxed-ret)
        (alloc/free [u8] a managed) (alloc/free [u8] a pointer) (alloc/free [u8] a unknown)))
    (alloc/free [u8] (alloc/malloc-allocator) first)))

(defn compunit-test-encode-image [(start (dyn NodeOps)) (stop (dyn NodeOps)) (entry bool)] (-> CodeImage)
  (looptree-build! start stop)
  (gc-lower-barriers-from! stop)
  (call-unlink-all!)
  (let [selected (arm64-select-graph stop)]
    (code-set-roots! (pipeline-find-selected-start selected) selected)
    (gcm-build-cfg!)
    (sched-run!)
    (pipeline-record-stats! (ra-run!))
    (enc-layout!)
    (gc-build-stackmaps!)
    (enc-emit!)
    (enc-relocate!)
    (image-capture-mode entry)))

(defn compunit-test-compile-identity-expression [(root-only bool)] (-> CodeImage)
  (compiler-session-reset!)
  (boot! 1)
  (code-reset! 1)
  (let [key (if root-only 0 (shape-key-intern "x"))
        shape (if root-only SHAPE-EMPTY (shape-transition SHAPE-EMPTY "x"))
        start (start-make (ty-int-bot)) stop (stop-make)
        main (fun-make start (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot)) "main")
        value (if root-only (shaperef-make shape)
                  (add-make-mode (mul-make-mode (keyref-make key) (con-int 100) MODE-INT)
                                 (shaperef-make shape) MODE-INT))
        ret (return-make main (None [(dyn NodeOps)]) (box-make value)
                          (None [(dyn NodeOps)]) (Some main))]
    (fun-set-ret! main ret)
    (stop-add-return! stop ret)
    (fun-prepare-codegen! main start)
    (compunit-test-encode-image start stop true)))

(defn compunit-test-compile-identities [] (-> CodeImage)
  (compunit-test-compile-identity-expression false))

;; Read the actual allocated header through bulk memory, deliberately withholding the dedicated
;; shape alias which lets the optimizer substitute ShapeRef. This checks the allocator's write.
(defn compunit-test-compile-allocation-header [] (-> CodeImage)
  (compiler-session-reset!) (boot! 1) (code-reset! 1)
  (let [shape (shape-transition SHAPE-EMPTY "x")
        start (start-make (ty-int-bot)) stop (stop-make)
        main (fun-make start (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot)) "main")
        mem (con-make (ty-mem ALIAS-BULK TY-BOT))
        allocation (new-make main (con-int 32) mem shape (ty-struct "MappedAllocation"))
        ptr_ (proj-make allocation 0 "allocated")
        header (load-make main mem ptr_ (con-int -8) ALIAS-BULK (ty-int-bot))
        ret (return-make main (Some (proj-make allocation 1 "memory")) (box-make header)
                         (None [(dyn NodeOps)]) (Some main))]
    (fun-set-ret! main ret) (stop-add-return! stop ret)
    (fun-prepare-codegen! main start)
    (compunit-test-encode-image start stop true)))

(deftest native_root_identity_needs_neither_a_shape_blob_nor_a_static_data_image
  (let [im (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)]
    (set! im (compunit-test-compile-identity-expression true))
    (assert-eq (len (.shapes im)) 0)
    (assert-eq (len (.data im)) 0)
    (set! loaded (image-install im))
    (compiler-session-reset!)
    (assert-eq (image-run! im loaded) 1)
    (assert-eq (image-run! im loaded) 1)
    (image-uninstall! loaded) (image-free! im)))

;; Exercise the runtime descriptor with a preassembled namespace. This deliberately supplies no
;; source/data units: the entry only reads two symbolic metadata words from its own binding slot.
(defn compunit-test-run-identities [(loaded (ptr InstalledImage)) (assembly (ptr CuShapeAssembly))
                                   (map CuIdentityMap)] (-> i64)
  (let [im (.owner loaded) program (rt-program)]
    (set! program (primitive/zeroed RtProgram))
    (set! (.text program) (.text loaded))
    (set! (.text-bytes program) (primitive/cast u64 (len (.text im))))
    (set! (.maps program) (slice-data (.maps im)))
    (set! (.map-bytes program) (primitive/cast u64 (len (.maps im))))
    (set! (.shapes program) (slice-data (.blob assembly)))
    (set! (.shape-bytes program) (primitive/cast u64 (len (.blob assembly))))
    (set! (.code-id program) (.code-id loaded))
    (set! (.keys program) (.keys map))
    (set! (.shape-ids program) (.shapes map))
    (let [entry (primitive/cast (fnptr c [] i64) (primitive/cast (ptr u8) (.entry loaded)))
          result (primitive/call-ptr entry)]
      (rt-realm-destroy!)
      result)))

(defn compunit-test-retained-metadata [(allocation bool)] (-> i64)
  (let [im (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)
        first (primitive/alloc-stack CuShapeAssembly) second (primitive/alloc-stack CuShapeAssembly)
        (mut blobs) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (set! im (if allocation (compunit-test-compile-allocation-header) (compunit-test-compile-identities)))
    (set! loaded (image-install im))
    (let [text-before (image-copy (slice-new (.text loaded) (len (.text im))))
          extra (compunit-test-shape-fixture true)]
      (push! [(slice u8)] (mut blobs) (.table extra))
      (push! [(slice u8)] (mut blobs) (.shapes im))
      (set! first (cu-shapes-compose (load blobs)))
      (al-clear! (mut blobs))
      (push! [(slice u8)] (mut blobs) (.shapes im))
      (push! [(slice u8)] (mut blobs) (.table extra))
      (set! second (cu-shapes-compose (load blobs)))
      (alloc/free [u8] (alloc/malloc-allocator) (.table extra))
      (alloc/free [u8] (alloc/malloc-allocator) (.image extra))
      (compiler-session-reset!)
      (let [a (get (.units first) 1) b (get (.units second) 0)
            expected-a (if allocation (cu-remap-shape a 2) (+ (* (cu-remap-key a 1) 100) (cu-remap-shape a 2)))
            expected-b (if allocation (cu-remap-shape b 2) (+ (* (cu-remap-key b 1) 100) (cu-remap-shape b 2)))]
        (assert-ne expected-a expected-b)
        (assert-eq (compunit-test-run-identities loaded first a) expected-a)
        (assert-eq (compunit-test-run-identities loaded second b) expected-b)
        (assert-eq (compunit-test-run-identities loaded first a) expected-a)
        (assert-eq (slice-new (.text loaded) (len (.text im))) text-before)
        ;; Same-namespace execution still supplies identity maps, including metadata-only units.
        (assert-eq (image-run! im loaded) (if allocation 2 102)))
      (alloc/free [u8] (alloc/malloc-allocator) text-before))
    (cu-shapes-free! first) (cu-shapes-free! second)
    (al-free! (mut blobs))
    (image-uninstall! loaded) (image-free! im)))

(deftest retained_native_identity_references_follow_each_realms_assembly_without_text_rewriting
  (compunit-test-retained-metadata false))

(deftest retained_native_fast_allocations_write_the_realms_mapped_shape_header
  (assert-eq (unsetenv c"AOT_RT_GC_STRESS") (primitive/cast i32 0))
  (assert-eq (unsetenv c"AOT_RT_GC_STATS") (primitive/cast i32 0))
  (compunit-test-retained-metadata true))

(deftest retained_native_collecting_allocations_write_the_realms_mapped_shape_header
  (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (compunit-test-retained-metadata true))

(const UNIT-MAP-KEY-BOUNDS 1)
(const UNIT-MAP-SHAPE-BOUNDS 2)
(const UNIT-MAP-ROOT 3)
(const UNIT-MAP-SHORT 4)
(const UNIT-MAP-DUPLICATE 5)
(const UNIT-MAP-INACTIVE 6)
(const UNIT-MAP-KEY-ALIAS 7)

(defn compunit-test-map-refuses [(loaded (ptr InstalledImage)) (assembly (ptr CuShapeAssembly))
                                (map CuIdentityMap) (mode i64)] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (do
          (rt-heap-reset! 4096)
          (shapes-boot! (slice-data (.blob assembly)) (len (.blob assembly)))
          (case mode
            UNIT-MAP-KEY-BOUNDS (do (set! (primitive/index (slice-data (.keys map)) 1) (+ (shapes-key-count) 1)) 0)
            UNIT-MAP-SHAPE-BOUNDS (do (set! (primitive/index (slice-data (.shapes map)) 2) (shapes-count)) 0)
            UNIT-MAP-ROOT (do (set! (primitive/index (slice-data (.shapes map)) 1) 2) 0)
            UNIT-MAP-SHORT (rt-unit-identities-bind! (.code-id loaded) (slice-new (slice-data (.keys map)) 1) (.shapes map))
            UNIT-MAP-DUPLICATE (rt-unit-identities-bind! (.code-id loaded) (.keys map) (.shapes map))
            UNIT-MAP-INACTIVE (rt-realm-destroy!)
            UNIT-MAP-KEY-ALIAS
              (let [(mut keys) (al-new [i64] (alloc/malloc-allocator))]
                (push! [i64] (mut keys) 0)
                (push! [i64] (mut keys) (get (.keys map) 1))
                (push! [i64] (mut keys) (get (.keys map) 1))
                (rt-unit-identities-bind! (.code-id loaded) (al-slice (load keys)) (.shapes map))
                (al-free! (mut keys)))
            (do (assert false) 0))
          (rt-unit-identities-bind! (.code-id loaded) (.keys map) (.shapes map))
          (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-PANIC) 0))))

(deftest realm_identity_bindings_validate_coverage_and_borrow_maps_until_teardown
  (let [im (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)
        assembly (primitive/alloc-stack CuShapeAssembly)
        (mut blobs) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (set! im (compunit-test-compile-identities))
    (set! loaded (image-install im))
    (push! [(slice u8)] (mut blobs) (.shapes im))
    (set! assembly (cu-shapes-compose (load blobs)))
    (let [map (get (.units assembly) 0)]
      (compunit-test-map-refuses loaded assembly map UNIT-MAP-KEY-BOUNDS)
      (compunit-test-map-refuses loaded assembly map UNIT-MAP-SHAPE-BOUNDS)
      (compunit-test-map-refuses loaded assembly map UNIT-MAP-ROOT)
      (compunit-test-map-refuses loaded assembly map UNIT-MAP-SHORT)
      (compunit-test-map-refuses loaded assembly map UNIT-MAP-DUPLICATE)
      (compunit-test-map-refuses loaded assembly map UNIT-MAP-INACTIVE)
      (compunit-test-map-refuses loaded assembly map UNIT-MAP-KEY-ALIAS)
      (rt-heap-reset! 4096)
      (shapes-boot! (slice-data (.blob assembly)) (len (.blob assembly)))
      (rt-unit-identities-bind! (.code-id loaded) (.keys map) (.shapes map))
      (let [slot (rt-code-unit-slot (.code-id loaded)) h (rt-heap)]
        (assert-eq (load (primitive/index (.unit-keys h) slot)) (primitive/cast i64 (slice-data (.keys map))))
        (assert-eq (load (primitive/index (.unit-shapes h) slot)) (primitive/cast i64 (slice-data (.shapes map)))))
      (rt-realm-destroy!)
      (assert-eq (primitive/cast i64 (.unit-keys (rt-heap))) 0)
      (assert-eq (primitive/cast i64 (.unit-shapes (rt-heap))) 0)
      (assert-eq (cu-remap-key map 1) 1)
      (assert-eq (cu-remap-shape map 2) 2))
    (cu-shapes-free! assembly)
    (al-free! (mut blobs))
    (image-uninstall! loaded) (image-free! im)))

(defn compunit-test-install-site-refuses [(im (ptr CodeImage)) (kind i64) (id i64) (reg i64)] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (let [site (get (.unit-sites im) 0)]
          (set! (mut (.unit-sites im)) 0 (EncUnitSite :offset (.offset site) :kind kind :local-id id :reg reg))
          (image-install im)
          (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-PANIC) 0))))

(deftest loader_rejects_invalid_symbolic_identity_relocations
  (let [im (primitive/alloc-stack CodeImage)]
    (set! im (compunit-test-compile-identities))
    (compunit-test-install-site-refuses im 0 1 16)
    (compunit-test-install-site-refuses im ENC-UNIT-KEY 0 16)
    (compunit-test-install-site-refuses im ENC-UNIT-KEY 0xffffffff 16)
    (compunit-test-install-site-refuses im ENC-UNIT-SHAPE 0xffffffff 16)
    (compunit-test-install-site-refuses im ENC-UNIT-DATA 0 16)
    (compunit-test-install-site-refuses im ENC-UNIT-KEY 1 17)
    (compunit-test-install-site-refuses im ENC-UNIT-KEY 1 28)
    (compunit-test-install-site-refuses im ENC-UNIT-KEY 1 31)
    (compunit-test-install-site-refuses im ENC-UNIT-KEY 1 -1)
    (assert-eq (.installations im) 0)
    (image-free! im)))

(defn compunit-test-force-argument-allocation [(control (dyn NodeOps)) (memory (dyn NodeOps))] (-> CallArguments)
  (let [(mut values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator)) (mut i) 0]
    (loop (if (> (load i) CALL-ABI-DIRECT-COUNT) (break 0)
              (do (push! [(dyn NodeOps)] (mut values) (dyn-undefined-make))
                  (set! (mut i) (+ (load i) 1)) (continue))))
    (set! (mut values) CALL-ABI-DIRECT-COUNT
      (parm-make control CALL-ABI-DIRECT0 (ty-dyn TAG-ANY) "argument.direct"))
    (let [packed (callabi-pack! control memory (load values))]
      (al-free! (mut values)) packed)))

(defn compunit-test-compile-provider [] (-> CodeImage)
  (boot! 1)
  (code-reset! 1)
  (let [start (start-make (ty-int-bot)) stop (stop-make)
        sig (callabi-signature) fun (fun-make start sig "readArgument")
        mem (parm-make-slot fun CALL-MEM (ty-mem ALIAS-BULK TY-BOT) "$mem")
        arguments (callabi-formals! fun mem)
        allocation (compunit-test-force-argument-allocation fun mem)
        value (callabi-argument! fun (.memory allocation) arguments 12)
        ret (return-make (.control value) (Some (.memory allocation)) (.value value)
                          (None [(dyn NodeOps)]) (Some fun))]
    (parm-set-unknown-input! mem (con-make (ty-mem ALIAS-BULK TY-BOT)))
    (arena-register-function! 1 fun)
    (fun-set-ret! fun ret)
    (stop-add-return! stop ret)
    (fun-prepare-codegen! fun start)
    (compunit-test-encode-image start stop false)))

(defn compunit-test-compile-importer-namespace [(count i64) (twice bool) (perturb bool)] (-> CodeImage)
  (boot! 2)
  (code-reset! 2)
  (if perturb
      (do (shape-transition SHAPE-EMPTY "caller-only") (shape-transition SHAPE-EMPTY "y") 0) 0)
  (let [start (start-make (ty-int-bot)) stop (stop-make)
        main (fun-make start (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot)) "main")
        target (external-make (arena-declare-external! 1 "provider::reader" (callabi-signature)))
        (mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator)) (mut i) 0]
    (loop (if (>= (load i) count) (break 0)
              (do (push! [(dyn NodeOps)] (mut args) (box-make (con-int (+ 30 (load i)))))
                  (set! (mut i) (+ (load i) 1)) (continue))))
    (let [packed (callabi-pack! main (con-make (ty-mem ALIAS-BULK TY-BOT)) (load args))
          first-end (callabi-invoke! main (.memory packed) target
                               (dyn-undefined-make) (dyn-undefined-make) (dyn-undefined-make)
                               packed)
          end (if twice
                  (callabi-invoke! (cproj-make first-end 0 "first-returned") (proj-make first-end 1 "first-memory") target
                                  (dyn-undefined-make) (dyn-undefined-make) (dyn-undefined-make)
                                  packed) (load first-end))
          result (proj-make end 2 "result")
          ret (return-make (cproj-make end 0 "returned") (Some (proj-make end 1 "memory"))
                           (if (< count 13) (box-make (typetest-make result TAG-UNDEFINED)) result)
                           (None [(dyn NodeOps)]) (Some main))]
      (fun-set-ret! main ret)
      (stop-add-return! stop ret)
      (fun-prepare-codegen! main start)
      (al-free! (mut args))
      (compunit-test-encode-image start stop true))))

(defn compunit-test-compile-importer-mode [(count i64) (twice bool)] (-> CodeImage)
  (compunit-test-compile-importer-namespace count twice false))

(defn compunit-test-compile-importer [(count i64)] (-> CodeImage)
  (compunit-test-compile-importer-mode count false))

(defn compunit-test-compile-initializer-caller [(throws bool)] (-> CodeImage)
  (boot! 2) (code-reset! 2)
  (let [start (start-make (ty-int-bot)) stop (stop-make)
        main (fun-make start (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot)) "main")
        memory (con-make (ty-mem ALIAS-BULK TY-BOT))
        initial (jsop-make main memory JS-PROP-GET-OWN)
        init0 (external-make (arena-declare-external! 1 "unit::init0" (callabi-signature)))
        init1 (external-make (arena-declare-external! 2 "unit::init1" (callabi-signature)))
        reader (external-make (arena-declare-external! 3 "unit::read" (callabi-signature)))
        init2 (external-make (arena-declare-external! 4 "unit::init2" (callabi-signature)))
        (mut initializers) (al-new [(dyn NodeOps)] (compiler-allocator))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (jsop-add-arg! initial (unbox-make (realm-global-object-load main memory) REP-OBJECT))
    (jsop-add-arg! initial (keyref-make (shape-key-intern "read")))
    (push! [(dyn NodeOps)] (mut initializers) init0)
    (push! [(dyn NodeOps)] (mut initializers) init1)
    (push! [(dyn NodeOps)] (mut initializers) init2)
    (let [before (typetest-make (proj-make initial 2 "before-init") TAG-UNDEFINED)
          sequence (callabi-script-sequence! main (proj-make initial 1 "initial-memory") (load initializers))
          control (.control sequence) second-memory (.memory sequence)
          exceptional (typetest-make (.completion sequence) TAG-EXCEPTION)
          valid (eq-make exceptional (con-int (if throws 1 0)))]
      ;; The host observes the completion before deliberately calling the inspector. A normal
      ;; Script runner must stop on failure; this inspector verifies the failed Script's effects.
      (if throws
          (push! [(dyn NodeOps)] (mut args)
            (load-make control second-memory (heapstate-make) (con-int RT-HEAP-OFFSET-EXCEPTION-VALUE)
                       ALIAS-EXCEPTION-VALUE (ty-dyn TAG-ANY))) 0)
      (let [inspect-args (callabi-pack! control second-memory (load args))
          end (callabi-invoke! control (.memory inspect-args) reader
                              (dyn-undefined-make) (dyn-undefined-make) (dyn-undefined-make)
                              inspect-args)
          ret (return-make (cproj-make end 0 "read") (Some (proj-make end 1 "read-memory"))
                           (box-make (mul-make (unbox-make (proj-make end 2 "answer") REP-INT) (mul-make before valid)))
                           (None [(dyn NodeOps)]) (Some main))]
      (fun-set-ret! main ret) (stop-add-return! stop ret) (fun-prepare-codegen! main start)
      (al-free! (mut initializers))
      (al-free! (mut args))
      (compunit-test-encode-image start stop true)))))

(deftest retained_script_initializers_execute_in_order_inside_one_fresh_realm
  (compunit-test-script-initializer-stores! "state = state + 41;"))

(defn compunit-test-has-intrinsic? [(im (ptr CodeImage)) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (al-for [object (.realm-objects im)]
      (let [o object]
        (if (and (= (.kind o) IMAGE-REALM-INTRINSIC) (= (.name o) name)) (set! (mut found) true) 0)))
    (load found)))

(deftest independent_script_units_share_intrinsic_identity_and_union_methods_in_fresh_realms
  (compunit-test-independent-scripts!
    "var state = 1; var savedCtor = Object; var savedProto = Object.prototype; var made = Object.create(null); function read() { return state === 42 ? 42 : 0; }"
    "if (state === 1 && Object === savedCtor && Object.prototype === savedProto && Object.keys({answer:42})[0] === 'answer') state = 42;"
    true))

(deftest independent_script_units_preserve_foundational_prototypes_without_local_intrinsic_uses
  (compunit-test-independent-scripts!
    "var state = 1; function read() { return state === 42 ? 42 : 0; }"
    "if (Object.getPrototypeOf(read) === Function.prototype && Object.getPrototypeOf(TypeError.prototype) === Error.prototype && Object.getPrototypeOf(Error.prototype) === Object.prototype) state = 42; if (read.call(null) !== 42) state = 0;"
    false))

(defn compunit-test-independent-scripts! [(provider-source (slice u8)) (consumer-source (slice u8))
                                        (check-methods bool)] (-> i64)
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (let [provider (primitive/alloc-stack CodeImage) consumer (primitive/alloc-stack CodeImage)
        first (primitive/alloc-stack InstalledImage) second (primitive/alloc-stack InstalledImage)
        caller (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)
        (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut sources) provider-source)
    (push! [(slice u8)] (mut sources) "")
    (compiler-session-reset!) (pipeline-encode-script-unit! (load sources) 1)
    (set! provider (pipeline-capture-script-image))
    (al-clear! (mut sources))
    (push! [(slice u8)] (mut sources) consumer-source)
    (compiler-session-reset!) (pipeline-encode-script-unit! (load sources) 1)
    (set! consumer (pipeline-capture-script-image))
    (compiler-session-reset!)
    (if check-methods (do
    (assert (compunit-test-has-intrinsic? provider "Object.create"))
    (assert (not (compunit-test-has-intrinsic? provider "Object.keys")))
    (assert (compunit-test-has-intrinsic? consumer "Object.keys"))
    (assert (not (compunit-test-has-intrinsic? consumer "Object.create")))) 0)
    (set! first (image-install provider)) (set! second (image-install consumer))
    (let [provider-data (image-copy (.data provider)) consumer-data (image-copy (.data consumer))
          provider-text (image-copy (slice-new [u8] (.text first) (primitive/cast i64 (.text-bytes first))))
          consumer-text (image-copy (slice-new [u8] (.text second) (primitive/cast i64 (.text-bytes second))))]
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider first 0 "unit::init0"))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider first 1 "unit::init1"))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding consumer second 0 "unit::init2"))
    (let [script (get (.scripts provider) 0) offset (get (.functions script) 0)]
      (al-for [fixup (.code-fixups provider)]
        (let [f fixup]
          (if (= (.offset f) (+ offset 16))
              (let [symbol (get (.symbols provider) (.symbol f))]
                (push! [ImageBinding] (mut bindings)
                       (image-export-binding provider first (.name symbol) "unit::read"))) 0))))
    (set! caller (compunit-test-compile-initializer-caller false)) (compiler-session-reset!)
    (set! loaded (image-install-bound caller (load bindings)))
    (push! [(ptr InstalledImage)] (mut units) loaded)
    (push! [(ptr InstalledImage)] (mut units) first)
    (push! [(ptr InstalledImage)] (mut units) second)
    (assert-eq (image-run-shared-program! loaded (load units)) 42)
    (assert-eq (image-run-shared-program! loaded (load units)) 42)
    ;; Canonical selection changes with unit order, but Script execution order stays fixed by
    ;; the installed host. Both intrinsic property subsets must survive either selection.
    (al-clear! (mut units))
    (push! [(ptr InstalledImage)] (mut units) loaded)
    (push! [(ptr InstalledImage)] (mut units) second)
    (push! [(ptr InstalledImage)] (mut units) first)
    (assert-eq (image-run-shared-program! loaded (load units)) 42)
    (assert-eq (.data provider) provider-data) (assert-eq (.data consumer) consumer-data)
    (assert-eq (slice-new [u8] (.text first) (primitive/cast i64 (.text-bytes first))) provider-text)
    (assert-eq (slice-new [u8] (.text second) (primitive/cast i64 (.text-bytes second))) consumer-text)
    (alloc/free [u8] (alloc/malloc-allocator) provider-data) (alloc/free [u8] (alloc/malloc-allocator) consumer-data)
    (alloc/free [u8] (alloc/malloc-allocator) provider-text) (alloc/free [u8] (alloc/malloc-allocator) consumer-text)
    (image-uninstall! loaded) (image-free! caller)
    ;; The public host builder needs only ordered initializer bindings. Provider code survives
    ;; both compiler resets and repeated host installation; no test-specific graph is involved.
    (al-clear! (mut bindings))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider first 0 "unit::init0"))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider first 1 "unit::init1"))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding consumer second 0 "unit::init2"))
    (compiler-session-reset!)
    (set! caller (pipeline-script-sequence-image (load bindings) 2))
    (compiler-session-reset!)
    (set! loaded (image-install-bound caller (load bindings)))
    (al-clear! (mut units))
    (push! [(ptr InstalledImage)] (mut units) loaded)
    (push! [(ptr InstalledImage)] (mut units) first)
    (push! [(ptr InstalledImage)] (mut units) second)
    (assert-eq (image-run-shared-program! loaded (load units)) 0)
    (assert-eq (image-run-shared-program! loaded (load units)) 0)
    (image-uninstall! loaded) (image-free! caller)
    (image-uninstall! second) (image-free! consumer)
    (image-uninstall! first) (image-free! provider)
    (al-free! (mut units)) (al-free! (mut bindings)) (al-free! (mut sources)))))

(defn compunit-test-shared-refuses! [(source (slice u8)) (retained bool) (expected i64)] (-> i64)
  (let [im (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)
        (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut sources) source)
    (compiler-session-reset!)
    (if retained (pipeline-encode-script-unit! (load sources) 1) (pipeline-encode-sources! (load sources) 1 true))
    (set! im (pipeline-capture-script-image)) (compiler-session-reset!)
    (set! loaded (image-install im))
    (push! [(ptr InstalledImage)] (mut units) loaded)
    (let [pid (os/fork) status (primitive/alloc-stack i32)]
      (assert (>= pid 0))
      (if (= pid 0)
          (do (image-run-shared-program! loaded (load units)) (os/_exit 0) 0)
          (do (assert-eq (os/waitpid pid status 0) pid)
              (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
              (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) expected) 0)))
    (image-uninstall! loaded) (image-free! im) (al-free! (mut units)) (al-free! (mut sources)) 0))

(deftest shared_script_assembly_rejects_closed_world_artifacts
  (compunit-test-shared-refuses! "var state = 42;" false EXIT-PANIC)
  (compunit-test-shared-refuses! "let state = 42;" false EXIT-PANIC))

(defn compunit-test-public-sequence! [(first-source (slice u8)) (second-source (slice u8))
                                    (third-source (slice u8)) (expected i64)] (-> i64)
  (let [provider (primitive/alloc-stack CodeImage) host (primitive/alloc-stack CodeImage)
        installed (primitive/alloc-stack InstalledImage) loaded (primitive/alloc-stack InstalledImage)
        (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut sources) first-source)
    (push! [(slice u8)] (mut sources) second-source)
    (push! [(slice u8)] (mut sources) third-source)
    (compiler-session-reset!) (pipeline-encode-script-unit! (load sources) 1)
    (set! provider (pipeline-capture-script-image)) (compiler-session-reset!)
    (set! installed (image-install provider))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider installed 0 "setup::first"))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider installed 1 "setup::second"))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider installed 2 "setup::third"))
    (set! host (pipeline-script-sequence-image (load bindings) 2)) (compiler-session-reset!)
    (set! loaded (image-install-bound host (load bindings)))
    (push! [(ptr InstalledImage)] (mut units) loaded)
    (push! [(ptr InstalledImage)] (mut units) installed)
    (assert-eq (image-run-shared-program! loaded (load units)) expected)
    (assert-eq (image-run-shared-program! loaded (load units)) expected)
    (image-uninstall! loaded) (image-free! host)
    (image-uninstall! installed) (image-free! provider)
    (al-free! (mut sources)) (al-free! (mut bindings)) (al-free! (mut units)) 0))

(deftest public_script_sequence_host_preserves_order
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (compunit-test-public-sequence! "var state = {answer:1};" "state.answer += 41;"
    "if (state.answer !== 42) throw 7;" 0))

(deftest public_script_sequence_host_preserves_first_uncaught_completion
  (compunit-test-public-sequence! "throw {answer:42};" "" "" 3))

(deftest public_script_sequence_host_preserves_middle_uncaught_completion
  (compunit-test-public-sequence! "var state = {answer:42};" "throw state;" "" 3))

(deftest public_script_sequence_host_accepts_an_empty_sequence
  (let [(mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        host (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)]
    (compiler-session-reset!) (set! host (pipeline-script-sequence-image (load bindings) 1))
    (compiler-session-reset!) (set! loaded (image-install host))
    (assert-eq (image-run! host loaded) 0)
    (assert-eq (image-run! host loaded) 0)
    (image-uninstall! loaded) (image-free! host) (al-free! (mut bindings))))

(deftest public_script_sequence_host_rejects_non_script_bindings_before_graph_construction
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (let [(mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))]
          (push! [ImageBinding] (mut bindings)
            (ImageBinding :name "native::not-a-script" :address 0 :provider 0 :abi ""))
          (pipeline-script-sequence-image (load bindings) 1)
          (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-PANIC) 0))))

(deftest retained_var_initializer_invokes_the_existing_global_setter_after_allocating_rhs
  (compunit-test-script-initializer-stores!
    "Object.defineProperty(this, 'ReferenceError', { set: function(v) { state = v; } }); var ReferenceError = state === 1 ? ({answer:42}).answer : [0][0];"))

(deftest retained_var_initializer_honors_readonly_globals_in_sloppy_and_strict_scripts
  (compunit-test-script-initializer-stores!
    "var original = ReferenceError; Object.defineProperty(this, 'ReferenceError', { writable:false }); var ReferenceError = 42; state = ReferenceError === original ? 42 : 0;")
  (compunit-test-script-initializer-stores!
    "'use strict'; Object.defineProperty(this, 'ReferenceError', { writable:false }); try { var ReferenceError = 42; } catch (e) { state = e.name === 'TypeError' ? 42 : 0; }"))

(deftest retained_var_initializer_does_not_store_after_an_abrupt_rhs
  (compunit-test-script-initializer-stores!
    "Object.defineProperty(this, 'ReferenceError', { set: function(v) { state = 0; } }); try { var ReferenceError = fail(); } catch (e) { state = e; } function fail() { throw 42; }"))

(defn compunit-test-script-initializer-stores! [(source (slice u8))] (-> i64)
  (compunit-test-script-declarations!
    "var state = 1; function read() { return state === 42 ? 42 : 0; }" source false))

(deftest retained_function_declaration_replaces_a_configurable_accessor_without_calling_it
  (compunit-test-script-declarations!
    "var state = 0; function read() { return state === 42 ? 42 : 0; } Object.defineProperty(this, 'f', {set:function(v) {state = -100;}, configurable:true});"
    "function f() { return 42; } var d = Object.getOwnPropertyDescriptor(this, 'f'); if (state === 0 && d.writable && d.enumerable && !d.configurable && d.value === f) state = f();"
    false))

(deftest retained_var_declaration_preserves_existing_values_and_creates_only_at_instantiation
  (compunit-test-script-declarations!
    "var state = 0; function read() { return state === 42 ? 42 : 0; } if (!Object.prototype.hasOwnProperty.call(this, 'fresh')) state = 1; Object.defineProperty(this, 'kept', {value:41, configurable:true});"
    "var kept; var fresh; var d = Object.getOwnPropertyDescriptor(this, 'fresh'); if (state === 1 && fresh === undefined && d.writable && d.enumerable && !d.configurable) state = kept + state;"
    false))

(deftest retained_function_declaration_rejects_readonly_before_installing_other_functions_or_running_body
  (compunit-test-script-declarations!
    "var state = 42; function read(e) { return e.name === 'TypeError' && state === 42 && typeof good === 'undefined' && blocked === 7 ? 42 : 0; } Object.defineProperty(this, 'blocked', {value:7, enumerable:true});"
    "function blocked() {} function good() {} state = 0;"
    true))

(deftest retained_var_declaration_rejects_nonextensible_global_before_function_replacement
  (compunit-test-script-declarations!
    "var state = 42; function read(e) { return e.name === 'TypeError' && state === 42 && kept === 7 && typeof fresh === 'undefined' ? 42 : 0; } Object.defineProperty(this, 'kept', {value:7, writable:true, enumerable:true}); Object.preventExtensions(this);"
    "function kept() {} var fresh; state = 0;"
    true))

(deftest retained_function_declaration_rejects_nonconfigurable_accessor_and_nonenumerable_data
  (compunit-test-script-declarations!
    "var state = 42; function read(e) { return e.name === 'TypeError' && state === 42 ? 42 : 0; } Object.defineProperty(this, 'blocked', {get:function() {state = 0;}, set:function(v) {state = 0;}, enumerable:true});"
    "function blocked() {} state = 0;"
    true)
  (compunit-test-script-declarations!
    "var state = 42; function read(e) { return e.name === 'TypeError' && state === 42 && blocked === 7 ? 42 : 0; } Object.defineProperty(this, 'blocked', {value:7, writable:true});"
    "function blocked() {} state = 0;"
    true))

(deftest retained_function_declarations_select_last_duplicates_in_source_order
  (compunit-test-script-declarations!
    "var state = 0; function read() { return state === 42 ? 42 : 0; }"
    "function f() { return 0; } function g() { return 1; } function f() { return 41; } var keys = Object.keys(this); if (keys[2] === 'g' && keys[3] === 'f') state = f() + g();"
    false))

(deftest retained_function_declaration_replaces_writable_enumerable_nonconfigurable_data
  (compunit-test-script-declarations!
    "var state = 0; function read() { return state === 42 ? 42 : 0; } Object.defineProperty(this, 'f', {value:7, writable:true, enumerable:true}); Object.preventExtensions(this);"
    "function f() { return 42; } state = f();"
    false))

(defn compunit-test-script-declarations! [(first-source (slice u8)) (source (slice u8)) (throws bool)] (-> i64)
  (compunit-test-script-sequence! first-source source "" throws))

(deftest retained_lexical_declaration_conflicts_precede_all_binding_creation
  (compunit-test-script-declarations!
    "let taken = 42; var state = 42; function read(e) { return e.name === 'SyntaxError' && taken === 42 && state === 42 && typeof fresh === 'undefined' && typeof fn === 'undefined' ? 42 : 0; }"
    "let fresh = 9; function fn() {} var taken; state = 0;" true)
  (compunit-test-script-declarations!
    "const taken = 42; var state = 42; function read(e) { return e.name === 'SyntaxError' && taken === 42 && state === 42 && typeof fresh === 'undefined' ? 42 : 0; }"
    "let fresh = 9; let taken = 0; state = 0;" true)
  (compunit-test-script-declarations!
    "var taken = 42; function read(e) { return e.name === 'SyntaxError' && taken === 42 && typeof fresh === 'undefined' ? 42 : 0; }"
    "let fresh = 9; const taken = 0;" true))

(deftest retained_lexical_restricted_global_conflicts_are_runtime_syntax_errors
  (compunit-test-script-declarations!
    "function read(e) { return e.name === 'SyntaxError' && typeof fresh === 'undefined' ? 42 : 0; }"
    "let fresh = 9; let undefined = 0;" true)
  (compunit-test-script-declarations!
    "function read(e) { return e.name === 'SyntaxError' && typeof fresh === 'undefined' ? 42 : 0; } Object.defineProperty(this, 'blocked', {value:1});"
    "let fresh = 9; let blocked = 0;" true))

(deftest retained_script_sequence_stops_after_the_first_initializers_exception
  (compunit-test-script-sequence!
    "var state = 42; function read(e) { return state === 42 && e.answer === 42 ? 42 : 0; } throw {answer:42};"
    "state = 0; throw 7;"
    "state = 0; throw 99;" true))

(deftest retained_script_sequence_stops_after_a_middle_exception_and_keeps_its_value
  (compunit-test-script-sequence!
    "var state = 1; function read(e) { return state === 42 && e.answer === 42 ? 42 : 0; }"
    "state = state + 41; throw {answer:42};"
    "state = 0; throw 99;" true))

(deftest retained_script_sequence_runs_all_normal_initializers_in_order
  (compunit-test-script-sequence!
    "var state = 1; function read() { return state === 42 ? 42 : 0; }"
    "state = state + 20;"
    "state = state * 2;" false))

(deftest retained_script_sequence_skips_later_declarations_after_instantiation_failure
  (compunit-test-script-sequence!
    "var state = 42; function read(e) { return e.name === 'TypeError' && state === 42 && typeof late === 'undefined' ? 42 : 0; } Object.defineProperty(this, 'blocked', {value:7});"
    "function blocked() {} state = 0;"
    "function late() {} state = 0; throw 99;" true))

(deftest empty_script_sequence_preserves_control_and_memory_without_allocating
  (compiler-session-reset!) (boot! 1)
  (let [control (start-make (ty-int-bot)) memory (con-make (ty-mem ALIAS-BULK TY-BOT))
        (mut targets) (al-new [(dyn NodeOps)] (compiler-allocator))
        before (arena-node-count)
        sequence (callabi-script-sequence! control memory (load targets))]
    (assert (n-same? (.control sequence) control))
    (assert (n-same? (.memory sequence) memory))
    (assert-eq (n-ty (.completion sequence)) (ty-dyn TAG-UNDEFINED))
    ;; Only the undefined constant may be added, never an argument-vector allocation or call.
    (assert (<= (- (arena-node-count) before) 1))
    (al-free! (mut targets))))

(defn compunit-test-script-sequence! [(first-source (slice u8)) (source (slice u8))
                                     (last-source (slice u8)) (throws bool)] (-> i64)
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (let [provider (primitive/alloc-stack CodeImage) code (primitive/alloc-stack InstalledImage)
        caller (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)
        (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut sources) first-source)
    (push! [(slice u8)] (mut sources) source)
    (push! [(slice u8)] (mut sources) last-source)
    (compiler-session-reset!)
    (pipeline-encode-script-unit! (load sources) 1)
    (set! provider (pipeline-capture-script-image))
    (compiler-session-reset!)
    (set! code (image-install provider))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider code 0 "unit::init0"))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider code 1 "unit::init1"))
    (push! [ImageBinding] (mut bindings) (image-script-initializer-binding provider code 2 "unit::init2"))
    (let [script (get (.scripts provider) 0) offset (get (.functions script) 0)]
      (al-for [fixup (.code-fixups provider)]
        (let [f fixup]
          (if (= (.offset f) (+ offset 16))
              (let [symbol (get (.symbols provider) (.symbol f))]
                (push! [ImageBinding] (mut bindings)
                       (image-export-binding provider code (.name symbol) "unit::read"))) 0))))
    (assert-eq (len (load bindings)) 4)
    (set! caller (compunit-test-compile-initializer-caller throws))
    (compiler-session-reset!)
    (set! loaded (image-install-bound caller (load bindings)))
    (push! [(ptr InstalledImage)] (mut units) loaded)
    (push! [(ptr InstalledImage)] (mut units) code)
    (assert-eq (image-run-program! loaded (load units)) 42)
    (assert-eq (image-run-program! loaded (load units)) 42)
    (image-uninstall! loaded) (image-free! caller)
    (image-uninstall! code) (image-free! provider)
    (al-free! (mut sources)) (al-free! (mut bindings)) (al-free! (mut units))
    0))

(defn compunit-test-compile-returned-function-caller [(value i64) (property bool)] (-> CodeImage)
  (boot! 2) (code-reset! 2)
  (let [start (start-make (ty-int-bot)) stop (stop-make)
        main (fun-make start (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot)) "main")
        target (external-make (arena-declare-external! 1 "provider::make" (callabi-signature)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))
        (mut empty) (al-new [i64] (compiler-allocator))
        packed (callabi-pack! main (con-make (ty-mem ALIAS-BULK TY-BOT)) (load args))
        made (callabi-invoke! main (.memory packed) target
                             (dyn-undefined-make) (dyn-undefined-make) (dyn-undefined-make)
                             packed)
        control (cproj-make made 0 "made") (mut memory) (proj-make made 1 "made-memory")
        (mut callee) (proj-make made 2 "published")]
    (if property
        (let [read (jsop-make control (load memory) JS-PROP-GET-OWN)]
          (jsop-add-arg! read (unbox-make (load callee) REP-OBJECT))
          (jsop-add-arg! read (keyref-make (shape-key-intern "run")))
          (set! (mut callee) (proj-make read 2 "function"))
          (set! (mut memory) (proj-make read 1 "property-memory"))) 0)
    (push! [(dyn NodeOps)] (mut args) (box-make (con-int value)))
    (let [arguments (callabi-pack! control (load memory) (load args))
          code (load-make control (.memory arguments) (unbox-make (load callee) REP-FUNCTION)
                          (con-int OFFSET-FUNCTION-CODE) ALIAS-FUNCTION-CODE
                          (ty-funptr-boundary (callabi-signature) (fidx-set-intern (al-slice (load empty))) true))
          end (callabi-invoke! control (.memory arguments) code (load callee)
                              (dyn-undefined-make) (dyn-undefined-make) arguments)
          ret (return-make (cproj-make end 0 "returned") (Some (proj-make end 1 "memory"))
                           (proj-make end 2 "value") (None [(dyn NodeOps)]) (Some main))]
      (fun-set-ret! main ret) (stop-add-return! stop ret) (fun-prepare-codegen! main start)
      (al-free! (mut args)) (al-free! (mut empty))
      (compunit-test-encode-image start stop true))))

(defn compunit-test-published-function! [(property bool)] (-> i64)
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (let [provider (primitive/alloc-stack CodeImage) code (primitive/alloc-stack InstalledImage)
        caller (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)
        (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut roots) (al-new [CuScriptCallableRoot] (alloc/malloc-allocator))
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator)) (mut round) 0]
    (push! [(slice u8)] (mut sources)
           (if property "'use strict'; function make() { return {run: function(x) { return x; }}; }"
                        "'use strict'; function make() { return function(x) { return x; }; }"))
    (push! [CuScriptCallableRoot] (mut roots) (CuScriptCallableRoot :script 0 :ordinal 0))
    (compiler-session-reset!)
    (pipeline-encode-sources-with-roots! (load sources) 1 true (load roots))
    (set! provider (pipeline-capture-script-image))
    (compiler-session-reset!)
    (set! code (image-install provider))
    (let [script (get (.scripts provider) 0) offset (get (.functions script) 0)]
      (al-for [fixup (.code-fixups provider)]
        (let [f fixup]
          (if (= (.offset f) (+ offset 16))
              (let [symbol (get (.symbols provider) (.symbol f))]
                (push! [ImageBinding] (mut bindings)
                       (image-export-binding provider code (.name symbol) "provider::make"))) 0))))
    (assert-eq (len (load bindings)) 1)
    (loop (if (>= (load round) 2) (break 0)
              (let [value (if (= (load round) 0) 42 99)]
                (set! caller (compunit-test-compile-returned-function-caller value property))
                (compiler-session-reset!)
                (set! loaded (image-install-bound caller (load bindings)))
                (al-clear! (mut units))
                (push! [(ptr InstalledImage)] (mut units) loaded)
                (push! [(ptr InstalledImage)] (mut units) code)
                (assert-eq (image-run-program! loaded (load units)) value)
                (assert-eq (image-run-program! loaded (load units)) value)
                (image-uninstall! loaded) (image-free! caller)
                (set! (mut round) (+ (load round) 1)) (continue))))
    (image-uninstall! code) (image-free! provider)
    (al-free! (mut sources)) (al-free! (mut roots))
    (al-free! (mut bindings)) (al-free! (mut units))
    0))

(deftest retained_source_returns_callable_function_values_to_future_callers
  (compunit-test-published-function! false))

(deftest retained_source_publishes_callable_object_properties_to_future_callers
  (compunit-test-published-function! true))

(defn compunit-test-compile-callback-caller [(value i64)] (-> CodeImage)
  (boot! 2) (code-reset! 2)
  (let [start (start-make (ty-int-bot)) stop (stop-make)
        callback (fun-make start (callabi-signature) "callback")
        memory (con-make (ty-mem ALIAS-BULK TY-BOT))
        cbret (return-make callback (Some memory) (box-make (con-int value))
                           (None [(dyn NodeOps)]) (Some callback))
        object (heap-add-function! 1 DYNAMIC-NULL-WORD)
        main (fun-make start (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot)) "main")
        target (external-make (arena-declare-external! 2 "provider::invoke" (callabi-signature)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (arena-register-function! 1 callback)
    (fun-set-ret! callback cbret) (stop-add-return! stop cbret)
    (fun-set-escapes! callback) (fun-prepare-codegen! callback start)
    (push! [(dyn NodeOps)] (mut args) (box-make (staticref-make object REP-FUNCTION)))
    (let [packed (callabi-pack! main memory (load args))
          end (callabi-invoke! main (.memory packed) target
                              (dyn-undefined-make) (dyn-undefined-make) (dyn-undefined-make)
                              packed)
          ret (return-make (cproj-make end 0 "returned") (Some (proj-make end 1 "memory"))
                           (proj-make end 2 "value") (None [(dyn NodeOps)]) (Some main))]
      (fun-set-ret! main ret) (stop-add-return! stop ret) (fun-prepare-codegen! main start)
      (al-free! (mut args))
      (compunit-test-encode-image start stop true))))

(deftest retained_source_calls_callbacks_from_independent_compilations
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (let [provider (primitive/alloc-stack CodeImage) code (primitive/alloc-stack InstalledImage)
        caller (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)
        (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut roots) (al-new [CuScriptCallableRoot] (alloc/malloc-allocator))
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator)) (mut round) 0]
    (push! [(slice u8)] (mut sources) "'use strict'; function invoke(cb) { return cb(); }")
    (push! [CuScriptCallableRoot] (mut roots) (CuScriptCallableRoot :script 0 :ordinal 0))
    (compiler-session-reset!)
    (pipeline-encode-sources-with-roots! (load sources) 1 true (load roots))
    (set! provider (pipeline-capture-script-image))
    (compiler-session-reset!)
    (set! code (image-install provider))
    (let [script (get (.scripts provider) 0) offset (get (.functions script) 0)]
      (al-for [fixup (.code-fixups provider)]
        (let [f fixup]
          (if (= (.offset f) (+ offset 16))
              (let [symbol (get (.symbols provider) (.symbol f))]
                (push! [ImageBinding] (mut bindings)
                       (image-export-binding provider code (.name symbol) "provider::invoke"))) 0))))
    (assert-eq (len (load bindings)) 1)
    (loop (if (>= (load round) 2) (break 0)
              (let [value (if (= (load round) 0) 42 99)]
                (set! caller (compunit-test-compile-callback-caller value))
                (compiler-session-reset!)
                (set! loaded (image-install-bound caller (load bindings)))
                (al-clear! (mut units))
                (push! [(ptr InstalledImage)] (mut units) loaded)
                (push! [(ptr InstalledImage)] (mut units) code)
                (assert-eq (image-run-program! loaded (load units)) value)
                (assert-eq (image-run-program! loaded (load units)) value)
                (image-uninstall! loaded) (image-free! caller)
                (set! (mut round) (+ (load round) 1)) (continue))))
    (image-uninstall! code) (image-free! provider)
    (al-free! (mut sources)) (al-free! (mut roots))
    (al-free! (mut bindings)) (al-free! (mut units))))

(defn compunit-test-compile-global-writer [(value i64)] (-> CodeImage)
  (compunit-test-compile-global-writer-mode value false))

(defn compunit-test-compile-global-writer-mode [(value i64) (bind-root bool)] (-> CodeImage)
  (boot! 2) (code-reset! 2)
  (let [start (start-make (ty-int-bot)) stop (stop-make)
        main (fun-make start (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot)) "main")
        memory (con-make (ty-mem ALIAS-BULK TY-BOT))
        global (if bind-root (staticref-make (heap-add-object! DYNAMIC-NULL-WORD) REP-OBJECT)
                             (unbox-make (realm-global-object-load main memory) REP-OBJECT))
        write (jsop-make main memory JS-PROP-SET-OWN)
        target (external-make (arena-declare-external! 1 "provider::reader" (callabi-signature)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (jsop-add-arg! write global)
    (jsop-add-arg! write (keyref-make (shape-key-intern "value")))
    (jsop-add-arg! write (box-make (con-int value)))
    (let [bound-memory (if bind-root
                          (store-make main (proj-make write 1 "write-memory") (heapstate-make)
                                      (con-int RT-HEAP-OFFSET-GLOBAL-OBJECT) (box-make global)
                                      ALIAS-REALM-ROOT (ty-dyn TAG-OBJECT))
                          (proj-make write 1 "write-memory"))
          packed (callabi-pack! main bound-memory (load args))
          initialized (if bind-root
                          (Some (callabi-invoke! main (.memory packed)
                                                (external-make (arena-declare-external! 2 "provider::initialize" (callabi-signature)))
                                                (dyn-undefined-make) (dyn-undefined-make) (dyn-undefined-make)
                                                packed))
                          (None [(dyn NodeOps)]))
          end (callabi-invoke! (match initialized (Some [done] (cproj-make done 0 "initialized")) (None [] main))
                              (match initialized (Some [done] (proj-make done 1 "initialized-memory")) (None [] (.memory packed))) target
                              (dyn-undefined-make) (dyn-undefined-make) (dyn-undefined-make)
                              packed)
          ret (return-make (cproj-make end 0 "returned") (Some (proj-make end 1 "memory"))
                           (proj-make end 2 "value") (None [(dyn NodeOps)]) (Some main))]
      (fun-set-ret! main ret) (stop-add-return! stop ret)
      (fun-prepare-codegen! main start)
      (al-free! (mut args))
      (compunit-test-encode-image start stop true))))

(deftest source_callable_root_observes_global_writes_absent_from_its_compilation
