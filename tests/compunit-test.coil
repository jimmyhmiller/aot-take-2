(deftest retained_global_writes_invoke_declared_and_imported_setters
  (compunit-test-global-write!
    "var value; function read() { Object.defineProperty(this, 'ReferenceError', { set: function(v) { throw v; } }); try { ReferenceError = value; } catch (e) { return e; } return 0; }" false)
  (compunit-test-global-write!
    "var value; function read() { Object.defineProperty(this, 'provided', { set: function(v) { throw v; } }); try { provided = value; } catch (e) { return e; } return 0; }" false))

(deftest retained_sloppy_global_write_creates_a_property_after_a_collecting_branch_rhs
  (compunit-test-global-write!
    "var value; function read() { provided = value === 42 ? ({x:value}).x : [value][0]; var d = Object.getOwnPropertyDescriptor(this, 'provided'); return d.writable && d.enumerable && d.configurable ? provided : 0; }" false))

(deftest retained_strict_unresolved_write_stays_unresolved_when_rhs_creates_the_property
  (compunit-test-global-write!
    "var value; function read() { try { write(this); } catch (e) { return e.name === 'ReferenceError' && this.provided === value ? value : 0; } return 0; } function write(g) { 'use strict'; provided = (g.provided = value, value); }" false))

(deftest retained_strict_write_resolves_a_declared_name_in_the_executing_realm_before_rhs
  (compunit-test-global-write!
    "var value; function read() { try { write(this); } catch (e) { return e.name === 'ReferenceError' && this.ReferenceError === value ? value : 0; } return 0; } function write(g) { 'use strict'; ReferenceError = (g.ReferenceError = value, value); }" true))

(deftest retained_global_writes_honor_readonly_properties_and_site_strictness
  (compunit-test-global-write!
    "var value; function read() { Object.defineProperty(this, 'value', { writable:false }); var result = (value = 0); return result === 0 ? this.value : 0; }" false)
  (compunit-test-global-write!
    "var value; function read() { Object.defineProperty(this, 'value', { writable:false }); try { write(); } catch (e) { return e.name === 'TypeError' ? value : 0; } return 0; } function write() { 'use strict'; value = 0; }" false))

(deftest retained_global_compound_logical_and_postfix_updates_share_the_reference_lifetime
  (compunit-test-global-write!
    "var value; function read() { this.provided = 0; provided ||= value; var old = provided++; provided += 1; return old === value && provided === value + 2 ? value : 0; }" false))

(deftest source_callable_root_survives_without_local_calls_and_serves_distinct_native_callers
  (let [provider (primitive/alloc-stack CodeImage) code (primitive/alloc-stack InstalledImage)
        caller (primitive/alloc-stack CodeImage) loaded (primitive/alloc-stack InstalledImage)
        (mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut roots) (al-new [CuScriptCallableRoot] (alloc/malloc-allocator))
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))
        (mut symbol) -1 (mut round) 0]
    (push! [(slice u8)] (mut sources)
           "'use strict'; function read(a,b,c,d,e,f,g,h,i,j,k,l,m) { return m; }")
    (push! [CuScriptCallableRoot] (mut roots) (CuScriptCallableRoot :script 0 :ordinal 0))
    (compiler-session-reset!)
    (pipeline-encode-sources-with-roots! (load sources) 1 true (load roots))
    (set! provider (pipeline-capture-script-image))
    (al-free! (mut sources)) (al-free! (mut roots))
    (compiler-session-reset!)
    (let [script (get (.scripts provider) 0) offset (get (.functions script) 0)]
      (al-for [fixup (.code-fixups provider)]
        (let [f fixup] (if (= (.offset f) (+ offset 16)) (set! (mut symbol) (.symbol f)) 0))))
    (assert (>= (load symbol) 0))
    (set! code (image-install provider))
    (let [entry (get (.symbols provider) (load symbol))]
      (assert-eq (.segment entry) IMAGE-SYM-TEXT)
      (push! [ImageBinding] (mut bindings)
             (image-export-binding provider code (.name entry) "provider::reader")))
    (loop (if (>= (load round) 2) (break 0)
              (do
                (set! caller (compunit-test-compile-importer (if (= (load round) 0) 13 1)))
                (compiler-session-reset!)
                (set! loaded (image-install-bound caller (load bindings)))
                (al-clear! (mut units))
                (push! [(ptr InstalledImage)] (mut units) loaded)
                (push! [(ptr InstalledImage)] (mut units) code)
                (assert-eq (image-run-program! loaded (load units)) (if (= (load round) 0) 42 1))
                (assert-eq (image-run-program! loaded (load units)) (if (= (load round) 0) 42 1))
                (image-uninstall! loaded) (image-free! caller)
                (set! (mut round) (+ (load round) 1)) (continue))))
    (image-uninstall! code) (image-free! provider)
    (al-free! (mut bindings)) (al-free! (mut units))))

(defn compunit-test-compile-static-provider [] (-> CodeImage)
  (boot! 1)
  (code-reset! 1)
  (let [(mut words) (al-new [i64] (compiler-allocator))
        (mut kinds) (al-new [i64] (compiler-allocator))]
    (push! [i64] (mut words) (| (primitive/ishl DYNAMIC-PREFIX-INT 48) 42))
    (push! [i64] (mut kinds) HEAP-WORD-CONST)
    ;; An elements backing store uses a fixed runtime shape, without a unit-local property key.
    (let [entry (heap--add-words! SHAPE-ELEMENTS (load words) (load kinds))
          start (start-make (ty-int-bot)) stop (stop-make)
          sig (callabi-signature) fun (fun-make start sig "readArgument")
          mem (parm-make-slot fun CALL-MEM (ty-mem ALIAS-BULK TY-BOT) "$mem")
          pointer (staticref-make entry REP-OBJECT)
          value (load-make fun mem pointer (con-int 0) ALIAS-BULK (ty-dyn TAG-ANY))
          changed (store-make fun mem pointer (con-int 0) (box-make (con-int 99)) ALIAS-BULK (ty-dyn TAG-ANY))
          ret (return-make fun (Some changed) value (None [(dyn NodeOps)]) (Some fun))]
      (parm-set-unknown-input! mem (con-make (ty-mem ALIAS-BULK TY-BOT)))
      (arena-register-function! 1 fun)
      (fun-set-ret! fun ret)
      (stop-add-return! stop ret)
      (fun-prepare-codegen! fun start)
      (compunit-test-encode-image start stop false))))

(defn compunit-test-compile-named-provider [] (-> CodeImage)
  (boot! 1) (code-reset! 1)
  (let [holder (heap-add-object! DYNAMIC-NULL-WORD)]
    (heap-define-own! holder "x" (compunit-test-int 42) HEAP-WORD-CONST)
    (heap-define-own! holder "y" (compunit-test-int 17) HEAP-WORD-CONST)
    (let [start (start-make (ty-int-bot)) stop (stop-make)
          fun (fun-make start (callabi-signature) "readArgument")
          mem (parm-make-slot fun CALL-MEM (ty-mem ALIAS-BULK TY-BOT) "$mem")
          pointer (staticref-make holder REP-OBJECT) key (keyref-make (shape-key-intern "x"))
          read (jsop-make fun mem JS-PROP-GET-OWN)]
      (jsop-add-arg! read pointer) (jsop-add-arg! read key)
      ;; JsOps keep the enclosing control; their memory projections order the effects, as in
      ;; property-generic-access. They are not CallEnd control-flow boundaries.
      (let [write (jsop-make fun (proj-make read 1 "read-memory") JS-PROP-SET-OWN)]
        (jsop-add-arg! write pointer) (jsop-add-arg! write key)
        (jsop-add-arg! write (box-make (con-int 99)))
        (let [ret (return-make fun (Some (proj-make write 1 "write-memory"))
                               (proj-make read 2 "old-value") (None [(dyn NodeOps)]) (Some fun))]
          (parm-set-unknown-input! mem (con-make (ty-mem ALIAS-BULK TY-BOT)))
          (arena-register-function! 1 fun)
          (fun-set-ret! fun ret) (stop-add-return! stop ret)
          (fun-prepare-codegen! fun start)
          (compunit-test-encode-image start stop false))))))

(deftest native_program_assembles_independent_namespaces_and_resets_named_provider_data
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (let [provider (primitive/alloc-stack CodeImage) caller (primitive/alloc-stack CodeImage)
        code (primitive/alloc-stack InstalledImage) invocation (primitive/alloc-stack InstalledImage)
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator)) (mut round) 0]
    (compiler-session-reset!)
    (set! provider (compunit-test-compile-named-provider))
    (set! code (image-install provider))
    (push! [ImageBinding] (mut bindings) (image-export-binding provider code "readArgument" "provider::reader"))
    (let [template (image-copy (.data provider)) text (image-copy (slice-new (.text code) (len (.text provider))))]
      (loop (if (>= (load round) 2) (break 0)
                (do
                  (compiler-session-reset!)
                  (set! caller (compunit-test-compile-importer-namespace 13 (= (load round) 1) true))
                  (assert-ne (.shapes caller) (.shapes provider))
                  (compiler-session-reset!)
                  (set! invocation (image-install-bound caller (load bindings)))
                  (al-clear! (mut units))
                  (push! [(ptr InstalledImage)] (mut units) invocation)
                  (push! [(ptr InstalledImage)] (mut units) code)
                  (assert-eq (image-run-program! invocation (load units)) (if (= (load round) 0) 42 99))
                  ;; Put the entry second: canonical IDs change, but the installation does not.
                  (set! (mut units) 0 code) (set! (mut units) 1 invocation)
                  (assert-eq (image-run-program! invocation (load units)) (if (= (load round) 0) 42 99))
                  (assert-eq (.data provider) template)
                  (assert-eq (slice-new (.text code) (len (.text provider))) text)
                  (image-uninstall! invocation) (image-free! caller)
                  (set! (mut round) (+ (load round) 1)) (continue))))
      (alloc/free [u8] (alloc/malloc-allocator) template)
      (alloc/free [u8] (alloc/malloc-allocator) text))
    (image-uninstall! code) (image-free! provider)
    (al-free! (mut bindings)) (al-free! (mut units))))

(defn compunit-test-program-refuses [(entry (ptr InstalledImage)) (provider (ptr InstalledImage)) (duplicate bool)] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (let [(mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
          (push! [(ptr InstalledImage)] (mut units) entry)
          (if duplicate
              (do (push! [(ptr InstalledImage)] (mut units) provider)
                  (push! [(ptr InstalledImage)] (mut units) provider) 0) 0)
          (image-run-program! entry (load units))
          (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-PANIC) 0))))

(deftest retained_native_provider_reads_and_mutates_its_own_fresh_realm_data
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (let [provider (primitive/alloc-stack CodeImage) caller (primitive/alloc-stack CodeImage)
        code (primitive/alloc-stack InstalledImage) invocation (primitive/alloc-stack InstalledImage)
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        (mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
    (compiler-session-reset!)
    (set! provider (compunit-test-compile-static-provider))
    (assert (> (len (.unit-sites provider)) 0))
    (compiler-session-reset!)
    (set! code (image-install provider))
    (push! [ImageBinding] (mut bindings) (image-export-binding provider code "readArgument" "provider::reader"))
    (set! caller (compunit-test-compile-importer 13))
    (compiler-session-reset!)
    (set! invocation (image-install-bound caller (load bindings)))
    (push! [(ptr InstalledImage)] (mut units) invocation)
    (push! [(ptr InstalledImage)] (mut units) code)
    (compunit-test-program-refuses invocation code false)
    (compunit-test-program-refuses invocation code true)
    (assert-eq (image-run-program! invocation (load units)) 42)
    (assert-eq (image-run-program! invocation (load units)) 42)
    (image-uninstall! invocation)
    (image-free! caller)
    ;; A second caller sees the mutation within a realm, then starts fresh on its next run.
    (set! caller (compunit-test-compile-importer-mode 13 true))
    (compiler-session-reset!)
    (set! invocation (image-install-bound caller (load bindings)))
    (assert-eq (image-run-program! invocation (load units)) 99)
    (assert-eq (image-run-program! invocation (load units)) 99)
    (assert-eq (.installations provider) 1)
    (image-uninstall! invocation) (image-free! caller)
    (image-uninstall! code) (image-free! provider)
    (al-free! (mut bindings)) (al-free! (mut units))))

(deftest compiled_provider_survives_compiler_reset_and_serves_two_fresh_native_callers
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (let [provider (primitive/alloc-stack CodeImage) caller (primitive/alloc-stack CodeImage)
        code (primitive/alloc-stack InstalledImage) invocation (primitive/alloc-stack InstalledImage)
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator)) (mut round) 0]
    (compiler-session-reset!)
    (set! provider (compunit-test-compile-provider))
    (compiler-session-reset!)
    (set! code (image-install provider))
    (push! [ImageBinding] (mut bindings) (image-export-binding provider code "readArgument" "provider::reader"))
    (loop (if (>= (load round) 2) (break 0)
              (do
                (set! caller (compunit-test-compile-importer (if (= (load round) 0) 13 1)))
                (compiler-session-reset!)
                (set! invocation (image-install-bound caller (load bindings)))
                (assert-eq (rt-code-count) 2)
                (match (rt-code-find (.code-id code))
                  (Some [range] (let [r range] (assert-eq (.dependents r) 1)))
                  (None [] (assert false)))
                (let [(mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
                  (push! [(ptr InstalledImage)] (mut units) invocation)
                  (push! [(ptr InstalledImage)] (mut units) code)
                  (assert-eq (image-run-program! invocation (load units)) (if (= (load round) 0) 42 1))
                  (al-free! (mut units)))
                (image-uninstall! invocation)
                (image-free! caller)
                (assert-eq (rt-code-count) 1)
                (assert-eq (.installations provider) 1)
                (set! (mut round) (+ (load round) 1)) (continue))))
    (al-free! (mut bindings))
    (image-uninstall! code)
    (image-free! provider)
    (assert-eq (rt-code-count) 0)))

(const BIND-TEST-FREE 1)
(const BIND-TEST-UNINSTALL 2)
(const BIND-TEST-DUPLICATE 3)
(const BIND-TEST-MISSING 4)
(const BIND-TEST-STALE 5)
(const BIND-TEST-RUNTIME 6)
(const BIND-TEST-ABI 7)

(defn compunit-test-binding-refuses [(provider (ptr CodeImage)) (code (ptr InstalledImage))
                                    (caller (ptr CodeImage)) (binding ImageBinding) (mode i64)] (-> i64)
  (let [pid (os/fork) status (primitive/alloc-stack i32)]
    (assert (>= pid 0))
    (if (= pid 0)
        (let [(mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator)) b binding]
          (case mode
            BIND-TEST-FREE (image-free! provider)
            BIND-TEST-UNINSTALL (image-uninstall! code)
            BIND-TEST-DUPLICATE
              (do (push! [ImageBinding] (mut bindings) binding)
                  (push! [ImageBinding] (mut bindings) binding)
                  (image-resolve-imports caller (load bindings)) 0)
            BIND-TEST-MISSING (do (image-resolve-imports caller (load bindings)) 0)
            BIND-TEST-STALE
              (do (push! [ImageBinding] (mut bindings) binding)
                  (image-resolve-imports caller (load bindings)) 0)
            BIND-TEST-RUNTIME
              (do (push! [ImageBinding] (mut bindings)
                        (ImageBinding :name "aot_rt_alloc" :address (.address b) :provider (.provider b) :abi (.abi b)))
                  (image-resolve-imports caller (load bindings)) 0)
            BIND-TEST-ABI
              (do (push! [ImageBinding] (mut bindings) binding)
                  (image-install-bound caller (load bindings)) 0)
            (do (assert false) 0))
          (os/_exit 0) 0)
        (do (assert-eq (os/waitpid pid status 0) pid)
            (assert-eq (& (primitive/cast i64 (load status)) 127) 0)
            (assert-eq (primitive/ishr (primitive/cast i64 (load status)) 8) EXIT-PANIC)
            0))))

(deftest image_bindings_reject_missing_conflicting_and_stale_providers_and_pin_lifetimes
  (let [provider (primitive/alloc-stack CodeImage) caller (primitive/alloc-stack CodeImage)
        code (primitive/alloc-stack InstalledImage) invocation (primitive/alloc-stack InstalledImage)
        (mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))]
    (compiler-session-reset!)
    (set! provider (compunit-test-compile-provider))
    (compiler-session-reset!)
    (set! code (image-install provider))
    (set! caller (compunit-test-compile-importer 13))
    (compiler-session-reset!)
    (let [binding (image-export-binding provider code "readArgument" "provider::reader")]
      (compunit-test-binding-refuses provider code caller binding BIND-TEST-FREE)
      (compunit-test-binding-refuses provider code caller binding BIND-TEST-DUPLICATE)
      (compunit-test-binding-refuses provider code caller binding BIND-TEST-MISSING)
      (compunit-test-binding-refuses provider code caller binding BIND-TEST-RUNTIME)
      (push! [ImageBinding] (mut bindings) binding)
      (set! invocation (image-install-bound caller (load bindings)))
      (compunit-test-binding-refuses provider code caller binding BIND-TEST-UNINSTALL)
      (image-uninstall! invocation)
      (image-uninstall! code)
      (compunit-test-binding-refuses provider code caller binding BIND-TEST-STALE))
    (al-free! (mut bindings))
    (image-free! provider)
    (image-free! caller)
    (assert-eq (rt-code-count) 0)))

(deftest loader_rejects_a_real_same_named_provider_with_an_incompatible_signature
  (let [provider (primitive/alloc-stack CodeImage) caller (primitive/alloc-stack CodeImage)
        code (primitive/alloc-stack InstalledImage)]
    (compiler-session-reset!)
    (boot! 1)
    (code-reset! 1)
    (let [start (start-make (ty-int-bot)) stop (stop-make)
          fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "readArgument")
          value (parm-make fun 0 (ty-int-bot) "value")
          ret (return-make fun (Some (con-make (ty-mem ALIAS-BULK TY-BOT))) value
                            (None [(dyn NodeOps)]) (Some fun))]
      (arena-register-function! 1 fun)
      (fun-set-ret! fun ret)
      (stop-add-return! stop ret)
      (fun-prepare-codegen! fun start)
      (set! provider (compunit-test-encode-image start stop false)))
    (compiler-session-reset!)
    (set! code (image-install provider))
    (set! caller (compunit-test-compile-importer 13))
    (compiler-session-reset!)
    (compunit-test-binding-refuses provider code caller
      (image-export-binding provider code "readArgument" "provider::reader") BIND-TEST-ABI)
    (assert-eq (.installations caller) 0)
    (match (rt-code-find (.code-id code))
      (Some [range] (let [r range] (assert-eq (.dependents r) 0)))
      (None [] (assert false)))
    (image-uninstall! code)
    (image-free! provider)
    (image-free! caller)))

(deftest graph_copies_preserve_declared_import_identity_without_a_function_body
  (boot! 1)
  (let [fidx (arena-declare-external! 41 "harness::assert" (callabi-signature))
        target (external-make fidx)
        (mut selected) (al-new [bool] (alloc/malloc-allocator)) (mut i) 0]
    (n-keep! target)
    (loop (if (> (load i) (arena-node-count)) (break 0)
              (do (push! [bool] (mut selected) (= (load i) (n-nid target)))
                  (set! (mut i) (+ (load i) 1)) (continue))))
    (let [copy (graph-copy-selected (al-slice (load selected)))]
      (match (graph-copy-get copy target)
        (Some [fresh]
          (do (assert-eq (n-op fresh) OP-EXTERN)
              (assert-eq (n-ty fresh) (n-ty target))
              (assert (not (n-same? fresh target)))
              (assert (match (arena-function fidx) (None [] true) (Some [_] false)))))
        (None [] (assert false)))
      (graph-copy-free! copy))
    (al-free! (mut selected))))

(deftest callable_signature_has_a_fixed_count_and_managed_vector_boundary
  (boot! 1)
  (let [signature (callabi-signature)]
    (assert-eq (ty-tuple-len signature) (+ CALL-ABI-ARITY 1))
    (assert-eq (ty-tuple-at signature 0) (ty-dyn TAG-COMPLETION))
    (assert-eq (ty-tuple-at signature (+ CALL-ABI-CALLEE 1)) (ty-dyn TAG-ANY))
    (assert-eq (ty-tuple-at signature (+ CALL-ABI-THIS 1)) (ty-dyn TAG-ANY))
    (assert-eq (ty-tuple-at signature (+ CALL-ABI-NEW-TARGET 1)) (ty-dyn TAG-ANY))
    (assert-eq (ty-tuple-at signature (+ CALL-ABI-COUNT 1))
               (ty-int-range 0 CALL-ABI-MAX-ARGUMENTS))
    (assert-eq (ty-tuple-at signature (+ CALL-ABI-VECTOR 1)) (callabi-vector-type))))

(deftest argument_vectors_distinguish_omitted_from_supplied_undefined
  (boot! 1)
  (let [control (con-make TY-CTRL) memory (con-make (ty-mem ALIAS-BULK TY-BOT))
        (mut values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
        empty (callabi-pack! control memory (load values))]
    (push! [(dyn NodeOps)] (mut values) (dyn-undefined-make))
    (let [supplied (callabi-pack! control memory (load values))]
      (assert-eq (n-ty (.count empty)) (ty-int-con 0))
      (assert-eq (n-ty (.count supplied)) (ty-int-con 1))
      (assert-eq (n-ty (get (.direct empty) 0)) (ty-dyn TAG-UNDEFINED))
      (assert-eq (n-ty (get (.direct supplied) 0)) (ty-dyn TAG-UNDEFINED))
      (assert (n-same? (.memory empty) memory))
      (assert (n-same? (.memory supplied) memory))
      (assert-eq (n-ty (.vector empty)) (ty-memptr-state 1 (ty-struct "$aot.ArgumentVector")))
      (assert-eq (n-ty (.vector supplied)) (n-ty (.vector empty))))
    (al-free! (mut values))))

(deftest bounded_argument_load_keeps_its_guard_when_the_pointer_is_nonnull
  (boot! 1)
  (let [control (con-make TY-CTRL)
        memory (con-make (ty-mem ALIAS-CALL-ARGUMENTS (ty-dyn TAG-ANY)))
        vector (con-make (ty-memptr false (ty-struct "$aot.ArgumentVector")))
        guarded (load-make-mode control memory vector (con-int 104)
                                 ALIAS-CALL-ARGUMENTS (ty-dyn TAG-ANY) true)
        ordinary (load-make control memory vector (con-int 104)
                              ALIAS-CALL-ARGUMENTS (ty-dyn TAG-ANY))]
    (n-keep! guarded)
    (n-keep! ordinary)
    (assert (not (n-gvn-eq? guarded ordinary)))
    (match (idealize guarded) (Some [_] 0) (None [] 0))
    (assert (n-same? (n-in! guarded MEM-CTRL) control))
    (match (idealize ordinary) (Some [_] 0) (None [] 0))
    (assert (match (n-in ordinary MEM-CTRL) (None [] true) (Some [_] false)))
    (let [(mut selected) (al-new [bool] (alloc/malloc-allocator)) (mut i) 0]
      (loop (if (> (load i) (arena-node-count)) (break 0)
                (do (push! [bool] (mut selected) (= (load i) (n-nid guarded)))
                    (set! (mut i) (+ (load i) 1)) (continue))))
      (let [copy (graph-copy-selected (al-slice (load selected)))]
        (match (graph-copy-get copy guarded)
          (Some [fresh]
            (do (assert (load-bounded? fresh))
                (assert (n-same? (n-in! fresh MEM-CTRL) control))))
          (None [] (assert false)))
        (graph-copy-free! copy))
      (al-free! (mut selected)))))

(deftest direct_arguments_allocate_only_the_overflow_tail
  (boot! 1)
  (let [control (con-make TY-CTRL) memory (con-make (ty-mem ALIAS-BULK TY-BOT))
        (mut values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator)) (mut i) 0]
    (loop (if (>= (load i) CALL-ABI-DIRECT-COUNT) (break 0)
              (do (push! [(dyn NodeOps)] (mut values) (box-make (con-int (load i))))
                  (set! (mut i) (+ (load i) 1)) (continue))))
    (let [direct (callabi-pack! control memory (load values))]
      (assert (n-same? (.memory direct) memory))
      (assert (ty-constant? (n-ty (.vector direct))))
      (assert-eq (len (.direct direct)) CALL-ABI-DIRECT-COUNT))
    (push! [(dyn NodeOps)] (mut values) (box-make (con-int 99)))
    (let [constant-tail (callabi-pack! control memory (load values))]
      (assert (n-same? (.memory constant-tail) memory))
      (assert-eq (n-op (.vector constant-tail)) OP-STATICREF)
      (assert-eq (staticref-rep (.vector constant-tail)) STATICREF-ARGUMENT-VECTOR)
      (assert-eq (heap-entry-word (staticref-entry (.vector constant-tail)) 0)
                 (primitive/ior (primitive/ishl DYNAMIC-PREFIX-INT 48) 99)))
    (set! (mut values) CALL-ABI-DIRECT-COUNT (con-make (ty-dyn TAG-ANY)))
    (let [overflow (callabi-pack! control memory (load values))
          allocated (n-in! (.vector overflow) 0)
          stored (memmerge-alias (.memory overflow) ALIAS-CALL-ARGUMENTS)]
      (assert-eq (new-shape allocated) SHAPE-ELEMENTS)
      (assert-eq (n-ty (new-size allocated)) (ty-int-con 8))
      (assert (n-same? (n-in! stored STORE-VAL) (get (load values) CALL-ABI-DIRECT-COUNT)))
      (assert-eq (n-ty (.count overflow)) (ty-int-con (+ CALL-ABI-DIRECT-COUNT 1))))
    (al-free! (mut values))))

;; Build both sides using ordinary Fun/Call nodes. The callee retains its unknown-caller entry:
;; its formal read cannot specialize to the caller's constant count or padded argument slots.
(defn compunit-test-native-arguments [(count i64) (index i64) (missing bool)] (-> i64)
  (boot! 1)
  (code-reset! 1)
  (let [start (start-make (ty-int-bot)) stop (stop-make)
        signature (callabi-signature)
        callee (fun-make start signature "readArgument_noInline")
        memory (parm-make-slot callee CALL-MEM (ty-mem ALIAS-BULK TY-BOT) "$mem")
        arguments (callabi-formals! callee memory)
        ;; Force overflow allocation even though zero-argument calls no longer allocate.
        ;; Direct boxed arguments and the overflow reference remain live across its safepoint.
        allocation (compunit-test-force-argument-allocation callee memory)
        read (callabi-argument! callee (.memory allocation) arguments index)
        callee-ret (return-make (.control read) (Some (.memory allocation)) (.value read)
                                (None [(dyn NodeOps)]) (Some callee))
        ;; image-run! enters through C. A boxed-completion main selects the real host wrapper,
        ;; including heap-context installation and preservation of AAPCS64 callee-saved registers.
        main (fun-make start (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot)) "main")
        (mut values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator)) (mut i) 0]
    (fun-set-ret! callee callee-ret)
    (parm-set-unknown-input! memory (con-make (ty-mem ALIAS-BULK TY-BOT)))
    (loop (if (>= (load i) count) (break 0)
              (do (push! [(dyn NodeOps)] (mut values) (box-make (con-int (+ 30 (load i)))))
                  (set! (mut i) (+ (load i) 1)) (continue))))
    (let [packed (callabi-pack! main (con-make (ty-mem ALIAS-BULK TY-BOT)) (load values))
          end (callabi-invoke! main (.memory packed) (funptr-make callee 1)
                               (dyn-undefined-make) (dyn-undefined-make) (dyn-undefined-make)
                               packed)
          result (proj-make end 2 "result")
          ret (return-make (cproj-make end 0 "returned") (Some (proj-make end 1 "memory"))
                           (if missing (box-make (typetest-make result TAG-UNDEFINED)) result)
                           (None [(dyn NodeOps)]) (Some main))]
      (callend-set-never-inline! end)
      (fun-set-ret! main ret)
      (stop-add-return! stop ret)
      (stop-add-return! stop callee-ret)
      (looptree-build! start stop)
      (gc-lower-barriers-from! stop)
      (fun-prepare-codegen! main start)
      (fun-prepare-codegen! callee start)
      (call-unlink-all!)
      (let [selected (arm64-select-graph stop)
            im (primitive/alloc-stack CodeImage) installed (primitive/alloc-stack InstalledImage)]
        (code-set-roots! (pipeline-find-selected-start selected) selected)
        (gcm-build-cfg!)
        (sched-run!)
        (pipeline-record-stats! (ra-run!))
        (assert-eq (code-stat-callee-saves) 18)
        (enc-layout!)
        (gc-build-stackmaps!)
        (enc-emit!)
        (enc-relocate!)
        (set! im (image-capture))
        (set! installed (image-install im))
        (assert-eq (image-run! im installed) (if missing 1 (+ 30 index)))
        (image-uninstall! installed)
        (image-free! im)))
    (al-free! (mut values))
    0))

(deftest native_callable_boundary_reads_extra_arguments_without_changing_its_signature
  (compunit-test-native-arguments 13 12 false))

(deftest native_callable_boundary_preserves_direct_arguments_across_a_safepoint
  (compunit-test-native-arguments 3 2 false)
  (compunit-test-native-arguments 1 2 true))

(deftest native_callable_boundary_returns_undefined_for_a_missing_argument
  ;; The formal offset is well outside the allocation. A speculative unguarded load is invalid.
  (compunit-test-native-arguments 0 131072 true))
