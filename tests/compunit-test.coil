(deftest retained_script_unit_uses_another_images_realm_global_for_names_and_sloppy_this
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (compunit-test-source-global-binding! true))

(defn compunit-test-source-global-binding! [(bind-root bool)] (-> i64)
  (compunit-test-source-global-reader! bind-root
    (if bind-root "var value; function read() { return this.read === read && value === this.value ? value : 0; }"
                  "'use strict'; var value; function read() { return value; }")))

(deftest retained_script_reads_and_typeof_resolve_object_bindings_absent_from_its_source
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (compunit-test-source-global-reader! true
    "function read() { if (typeof ((value)) !== 'number' || typeof absent !== 'undefined') return 0; try { absent; } catch (e) { return e.name === 'ReferenceError' ? value : 0; } return 0; }"))

(deftest retained_script_typeof_propagates_external_global_getter_exceptions
  (assert-eq (os/setenv c"AOT_RT_GC_STRESS" c"1" 1) (primitive/cast i32 0))
  (assert-eq (os/setenv c"AOT_RT_GC_VERIFY" c"1" 1) (primitive/cast i32 0))
  (compunit-test-source-global-reader! false
    "var value; function read() { Object.defineProperty(this, 'provided', { get: function() { throw 42; } }); try { typeof provided; } catch (e) { return e === 42 ? value : 0; } return 0; }"))

