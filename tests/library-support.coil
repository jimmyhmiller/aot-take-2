;; Retained Script units in tests: the runtime-library provider they import from.

(module aot.tests.librarysupport)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "aot.util.arena" :use [compiler-session-reset!])
(import "aot.codegen.image" :use *)
(import "aot.codegen.pipeline" :use [pipeline-shared-jsl-image])

;; The runtime-library provider every retained Script unit imports from (pipeline-shared-jsl-image):
;; compiled and installed once per test process, bound into each unit that imports it, and assembled
;; into each program that runs such a unit (docs/DECISIONS.md, the provider carries the declared surface).
(defstruct TestLibrary
  [(image CodeImage) (installed InstalledImage) (ready bool)])

(defn test-library-cell [] (-> (ptr TestLibrary))
  (primitive/alloc-static TestLibrary))

(defn test-library! [] (-> (ptr InstalledImage))
  (let [cell (test-library-cell)]
    (if (.ready cell)
        0
        (do
          (compiler-session-reset!)
          (set! (.image cell) (pipeline-shared-jsl-image 1))
          (compiler-session-reset!)
          (set! (.installed cell) (image-install (field cell image)))
          (set! (.ready cell) true)
          0))
    (field cell installed)))

(defn test-imports-library? [(im (ptr CodeImage))] (-> bool)
  (let [(mut found) false]
    (al-for [symbol (.symbols im)]
            (let [s symbol]
              (if (and (= (.segment s) IMAGE-SYM-IMPORT) (> (len (.abi s)) 0))
                  (set! (mut found) true)
                  0)))
    (load found)))

;; The bindings that install a compiled image: a retained unit's imports bound to the library, and
;; nothing for an image that imports none. Install with `image-install-bound` at the destination.
(defn test-library-bindings [(im (ptr CodeImage))] (-> (ArrayList ImageBinding))
  (let [(mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))]
    (if (test-imports-library? im)
        (let [library (test-library!)]
          (al-for [symbol (.symbols im)]
                  (let [s symbol]
                    (if (and (= (.segment s) IMAGE-SYM-IMPORT)
                             (> (len (.abi s)) 0))
                        (push! [ImageBinding]
                               (mut bindings)
                               (image-export-binding (field (test-library-cell)
                                                            image)
                                                     library
                                                     (.name s)
                                                     (.name s)))
                        0)))
          0)
        0)
    (load bindings)))

;; Run an assembled program: a realm shared with the library when one is assembled into it.
(defn test-run! [(loaded (ptr InstalledImage))
                 (units (ArrayList (ptr InstalledImage)))] (-> i64)
  (if (.ready (test-library-cell))
      (image-run-shared-program! loaded units)
      (image-run-program! loaded units)))

;; A program's host unit, followed by the library when this process installed one.
(defn test-push-host! [(units (mut (ArrayList (ptr InstalledImage))))
                       (host (ptr InstalledImage))] (-> i64)
  (do
    (push! [(ptr InstalledImage)] (mut units) host)
    (if (.ready (test-library-cell))
        (push! [(ptr InstalledImage)]
               (mut units)
               (field (test-library-cell) installed))
        0)
    0))
