;; The realm's initial objects are image data (docs/DECISIONS.md, the static heap image): the
;; intrinsic prototypes carry CreateIntrinsics' properties, a Script's hoisted functions and their
;; prototypes are the objects the global slots hold, and a property added to an image object at run
;; time goes through the ordinary runtime transition whose storage the collector must keep alive.
(deftest the_realm_image_holds_intrinsic_prototypes_and_hoisted_functions
         (execution-assert-script
          "function f() { return 1; }
           var proto = f.prototype;
           if (proto.constructor !== f) throw 1;
           if (TypeError.prototype.name !== 'TypeError') throw 2;
           if (TypeError.prototype.message !== '') throw 3;
           if (Error.prototype.name !== 'Error') throw 4;
           var e = new TypeError('boom');
           if (e.message !== 'boom') throw 5;
           if (!(e instanceof Error)) throw 6;
           if (f !== f) throw 7;
           if (typeof f !== 'function') throw 8;
           if (f() !== 1) throw 9;"
          0))

(deftest image_objects_accept_runtime_properties_that_survive_collection
         (let [a (alloc/malloc-allocator)
               (mut sources) (al-new [(slice u8)] a)]
           (push! [(slice u8)] (mut sources)
                  "function keep() { return 1; }
                   Error.prototype.tag = {a: 1};
                   keep.extra = {b: 2};
                   function churn(n) { return {a: n, b: keep}; }
                   let i = 0;
                   while (i < 3000) { churn(i); i = i + 1; }")
           (push! [(slice u8)] (mut sources)
                  "function later() { return 2; }
                   if (Error.prototype.tag.a !== 1) throw 1;
                   if (keep.extra.b !== 2) throw 2;
                   if (later() !== 2) throw 3;
                   if (later.prototype.constructor !== later) throw 4;
                   if (new TypeError('x').tag.a !== 1) throw 5;")
           (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) 0)
           (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) 0)
           (assert-eq (setenv c"AOT_RT_HEAP_BYTES" c"32768" 1) 0)
           (let [status (pipeline-compile-link-run-sources! (load sources)
                                                            "/tmp/aot-take-2-image-gc.o"
                                                            "/tmp/aot-take-2-image-gc"
                                                            1 true)]
             (unsetenv c"AOT_RT_GC_VERIFY")
             (unsetenv c"AOT_RT_GC_STRESS")
             (unsetenv c"AOT_RT_HEAP_BYTES")
             (al-free! [(slice u8)] (mut sources))
             (assert-eq status 0))))

;; A later Script's function declarations are instantiated when that Script starts, not before:
;; the first Script still reads `undefined` for a name only the second declares as a function.
(deftest later_script_function_declarations_are_stored_at_their_scripts_start
         (execution-assert-scripts
          "function probe() { return typeof g; }
           var seen = probe();"
          "function g() { return 3; }
           if (seen !== 'undefined') throw 1;
           if (typeof g !== 'function') throw 2;
           if (g() !== 3) throw 3;"
          0))

;; Exceptions are a sentinel completion (docs/DECISIONS.md): a function that throws returns the
;; exception sentinel and its caller tests the result. Propagation across calls, a finally in the
;; path, the language's own TypeErrors and an uncaught exception at the root all follow from that.
