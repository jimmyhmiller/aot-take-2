;; End-to-end execution tests: ideal graph through the complete implemented backend and native link.
(module aot.tests.execution)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.call" :use *)
(import "aot.node.memory" :use *)
(import "aot.type.type" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.looptree" :use *)
(import "aot.codegen.gcm" :use *)
(import "aot.codegen.listsched" :use *)
(import "aot.codegen.regalloc" :use *)
(import "aot.codegen.encoding" :use *)
(import "aot.codegen.objfile" :use *)
(import "aot.codegen.pipeline" :use *)
(import "aot.node.cpus.arm64" :use *)

(defn execution-assert-source [(source (slice u8)) (expected i64)] (-> i64)
  (do
    (assert-eq (pipeline-compile-link-run! source
                                           "/tmp/aot-take-2-source-matrix.o"
                                           "/tmp/aot-take-2-source-matrix"
                                           1)
               expected)
    0))

(deftest ideal_main_runs_through_selection_scheduling_allocation_encoding_and_native_link
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "main")
                 ret (return-make fun
                                  (Some (con-make (ty-mem 1 TY-BOT)))
                                  (con-make (ty-int-con 42))
                                  (None [(dyn NodeOps)])
                                  (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (sched-run!)
               (assert-eq (ra-run!) 0)
               (enc-layout!)
               (enc-emit!)
               (enc-relocate!)
               (assert-eq (macho-write "/tmp/aot-take-2-exec-test.o")
                          (len (macho-bytes)))
               (assert-eq (macho-link! "/tmp/aot-take-2-exec-test.o"
                                       "/tmp/aot-take-2-exec-test")
                          0)
               (assert-eq (run-executable! "/tmp/aot-take-2-exec-test") 42)))))

(deftest source_arithmetic_runs_from_parser_through_native_execution
         (execution-assert-source "function main() { return 20 + 22; }" 42))

(deftest source_precedence_and_number_annotations_reach_native_execution
         (execution-assert-source "function main(): number { return 2 + 3 * 4 - 1; }" 13))

(deftest source_user_calls_reach_native_execution
         (execution-assert-source
           "function scale(a: number, b: number): number { return a + b * 4; }
            function main(): number { return scale(2, 3); }"
           14))

(deftest source_forward_function_declarations_reach_native_execution
         (execution-assert-source
           "function main() { return later(40); }
            function later(value) { return value + 2; }"
           42))

(deftest source_bindings_assignment_and_shadowing_reach_native_execution
         (execution-assert-source
           "function main() {
              let x = 2;
              x = x + 3;
              { const x: number = 99; x; }
              return x * 2;
            }"
           10))

(deftest source_parentheses_expression_statements_and_unreached_functions_reach_native_execution
         (execution-assert-source
           "function unused(value) { return value + 100; }
            function observe(value) { return value * 2; }
            function main() {
              observe((20 + 1));
              return (6 * (8 - 1));
            }"
           42))

(deftest source_conditional_expressions_reach_native_execution
         (execution-assert-source "function main() { return 1 ? 7 : 9; }" 7))

(deftest source_if_else_assignment_merges_reach_native_execution
         (execution-assert-source
           "function main() {
              let selected = 2;
              if (0) { selected = 3; } else { selected = 4; }
              return selected;
            }"
           4))

(deftest source_if_without_else_and_single_statement_while_reach_native_execution
         (execution-assert-source
           "function main() {
              let value = 2;
              if (1) value = value + 1;
              while (value) value = value - 1;
              return value;
            }"
           0))

(deftest source_early_return_merges_reach_native_execution
         (execution-assert-source
           "function choose(condition, a, b) {
              if (condition) { return a; } else { return b; }
            }
            function main() { return choose(1, 6, 8); }"
           6))

(deftest source_zero_iteration_loops_reach_native_execution
         (execution-assert-source
           "function main() {
              let value = 2;
              while (0) { value = 3; }
              return value;
            }"
           2))

(deftest source_loop_phis_reach_native_execution
         (execution-assert-source
           "function iterate(condition, initial, next) {
              let value = initial;
              while (condition) {
                value = next;
                condition = 0;
              }
              return value;
            }
            function main() { return iterate(1, 2, 5); }"
           5))

(deftest source_multi_iteration_loops_reach_native_execution
         (execution-assert-source
           "function main() {
              let value = 5;
              while (value) { value = value - 1; }
              return value;
            }"
           0))

(deftest source_recursive_calls_and_runtime_branches_reach_native_execution
         (execution-assert-source
           "function descend(value) {
              if (value) { return descend(value - 1); }
              else { return 7; }
            }
            function main() { return descend(3); }"
           7))
