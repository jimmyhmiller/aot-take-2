;; The elements store is a heap object the collector moves and the array keeps its identity
;; across every growth; under stress every push may collect.
(deftest array_elements_survive_collections_and_growth
         (let [a (alloc/malloc-allocator)
               (mut sources) (al-new [(slice u8)] a)]
           (push! [(slice u8)] (mut sources)
                  "var keep = [];
                   var i = 0;
                   while (i < 500) { keep.push({n: i, tag: [i, 'x' + i]}); i = i + 1; }
                   var j = 0;
                   while (j < 500) {
                     if (keep[j].n !== j) throw 1;
                     if (keep[j].tag[0] !== j) throw 2;
                     j = j + 1;
                   }
                   var s = keep.slice(497);
                   if (s.length !== 3 || s[2].tag[0] !== 499) throw 3;
                   if ([1, 2, 3].concat(keep).length !== 503) throw 4;")
           (assert-eq (setenv c"AOT_RT_GC_VERIFY" c"1" 1) 0)
           (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) 0)
           ;; 500 records with their inner arrays and strings are about 90 KB live: the heap must
           ;; hold them, and stress then collects at every allocation with the survivors moving.
           (assert-eq (setenv c"AOT_RT_HEAP_BYTES" c"262144" 1) 0)
           (let [status (pipeline-compile-link-run-sources! (load sources)
                                                            "/tmp/aot-take-2-array-gc.o"
                                                            "/tmp/aot-take-2-array-gc"
                                                            1 true)]
             (unsetenv c"AOT_RT_GC_VERIFY")
             (unsetenv c"AOT_RT_GC_STRESS")
             (unsetenv c"AOT_RT_HEAP_BYTES")
             (al-free! [(slice u8)] (mut sources))
             (assert-eq status 0))))

