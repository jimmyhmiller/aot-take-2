;; End-to-end execution tests: ideal graph through the complete implemented backend and native link.
(module aot.tests.execution)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.call" :use *)
(import "aot.node.memory" :use *)
(import "aot.type.type" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.looptree" :use *)
(import "aot.codegen.gcm" :use *)
(import "aot.codegen.listsched" :use *)
(import "aot.codegen.regalloc" :use *)
(import "aot.codegen.encoding" :use *)
(import "aot.codegen.objfile" :use *)
(import "aot.codegen.pipeline" :use *)
(import "aot.node.cpus.arm64" :use *)

(extern setenv :cc c [(ptr i8) (ptr i8) i32] (-> i32))
(extern unsetenv :cc c [(ptr i8)] (-> i32))

(defn execution-assert-source [(source (slice u8)) (expected i64)] (-> i64)
  (do
    (assert-eq (pipeline-compile-link-run! source
                                           "/tmp/aot-take-2-source-matrix.o"
                                           "/tmp/aot-take-2-source-matrix"
                                           1)
               expected)
    0))

(defn execution-assert-varying-argv [(executable (slice u8)) (expected i64)] (-> i64)
  (let [(mut argv) (al-new [(slice u8)] (alloc/malloc-allocator))]
    ;; Process entry receives argc in X0. Running the same binary with several argc values proves
    ;; that loop-Phi entry and backedge arms came from their graph definitions, not ambient ABI
    ;; registers that happened to make a zero-result loop test pass.
    (assert-eq (obj-run-process executable (al-slice (load argv))) expected)
    (push! [(slice u8)] (mut argv) "first")
    (assert-eq (obj-run-process executable (al-slice (load argv))) expected)
    (push! [(slice u8)] (mut argv) "second")
    (push! [(slice u8)] (mut argv) "third")
    (assert-eq (obj-run-process executable (al-slice (load argv))) expected)))

(deftest numeric_literal_families_lower_through_jsl_without_truncation_or_double_rounding
  (execution-assert-source
    "function identity_noInline(x) { return x; }
     function main() {
       if (identity_noInline(.5) !== 1 / 2) { return 1; }
       if (identity_noInline(1.25e+2) !== 125) { return 2; }
       if (identity_noInline(1_2.5_0e-1) !== 5 / 4) { return 3; }
       if (identity_noInline(0b1_01010) !== 42) { return 4; }
       if (identity_noInline(0o52) !== 42 || identity_noInline(0x2a) !== 42) { return 5; }
       if (identity_noInline(077) !== 63 || identity_noInline(089) !== 89) { return 6; }
       if (identity_noInline(0x20000000000001) !== 9007199254740992) { return 7; }
       if (identity_noInline(0x20000000000003) !== 9007199254740996) { return 8; }
       if (identity_noInline(1e400) !== Infinity || identity_noInline(1e-400) !== 0) { return 9; }
       if (identity_noInline(5e-324) === 0) { return 10; }
       if (1 / identity_noInline(-0.0) !== -Infinity) { return 11; }
       if (identity_noInline(0x40000000000005) !== 18014398509481988) { return 12; }
       if (identity_noInline(0x40000000000003) !== 18014398509481988) { return 13; }
       if (identity_noInline(0x3fffffffffffff) !== 18014398509481984) { return 14; }
       return 42;
     }" 42))

(deftest source_division_unary_numbers_and_readonly_globals_preserve_ieee_semantics
         (execution-assert-source
           "function divide_noInline(a, b) { return a / b; }
            function negate_noInline(a) { return -a; }
            function positive_noInline(a) { return +a; }
            function shadow_noInline(Infinity, NaN) { Infinity = Infinity + 1; return Infinity + NaN; }
            function touch_noInline(box) { box.value = true; return 7; }
            function main() {
              if (divide_noInline(1, 0) !== Infinity) { return 1; }
              if (divide_noInline(1, -0) !== -Infinity) { return 2; }
              if (divide_noInline(-1, 0) !== -Infinity) { return 3; }
              if (divide_noInline(-1, -0) !== Infinity) { return 4; }
              let nan = divide_noInline(0, 0);
              if (nan === nan || NaN === NaN) { return 5; }
              let infiniteQuotient = divide_noInline(Infinity, Infinity);
              if (infiniteQuotient === infiniteQuotient) { return 6; }
              if (1 / negate_noInline(0) !== -Infinity) { return 7; }
              if (1 / negate_noInline(-0) !== Infinity) { return 8; }
              if (1 / positive_noInline(-0) !== -Infinity) { return 9; }
              if (divide_noInline(true, false) !== Infinity) { return 10; }
              if (divide_noInline(null, true) !== 0) { return 11; }
              let missing = divide_noInline(undefined, 1);
              if (missing === missing) { return 12; }
              if (negate_noInline(true) !== -1 || positive_noInline(false) !== 0) { return 13; }
              if (1 / negate_noInline(null) !== -Infinity) { return 14; }
              if (positive_noInline(null) !== 0) { return 15; }
              if (8 / 2 * 3 !== 12 || 12 / 2 / 3 !== 2) { return 16; }
              if (shadow_noInline(20, 21) !== 42) { return 17; }
              let box = { value: false };
              Infinity = touch_noInline(box);
              NaN = 7;
              if (!box.value || Infinity !== 1 / 0 || NaN === 7) { return 18; }
              if (null - true !== -1 || true - false !== 1) { return 19; }
              if (true + true !== 2 || true * null !== 0 || !(false < true)) { return 20; }
              return 42;
            }"
           42))

(deftest source_strict_equality_uses_number_string_and_identity_semantics
         (execution-assert-source
           "function equal_noInline(a, b) { return a === b; }
            function different_noInline(a, b) { return a !== b; }
            function left_noInline(box) { box.value = 1; return 'same'; }
            function right_noInline(box) { let value = box.value; box.value = 2; return value ? 'same' : 'wrong'; }
            function main() {
              let object = {};
              let nan = undefined - 0;
              let negativeZero = 0 * (0 - 1);
              let doubleOne = 9007199254740992 - 9007199254740991;
              if (!equal_noInline(1, doubleOne)) { return 1; }
              if (!equal_noInline(0, negativeZero)) { return 2; }
              if (equal_noInline(nan, nan)) { return 3; }
              if (!different_noInline(nan, nan)) { return 4; }
              if (!equal_noInline('a' + 'b', 'ab')) { return 5; }
              if (equal_noInline('a', 'b')) { return 6; }
              if (equal_noInline('1', 1)) { return 7; }
              if (equal_noInline(1, '1')) { return 8; }
              if (!equal_noInline(object, object)) { return 9; }
              if (equal_noInline(object, {})) { return 10; }
              if (equal_noInline(null, undefined)) { return 11; }
              if (!equal_noInline(undefined, undefined)) { return 12; }
              if (!equal_noInline(null, null)) { return 13; }
              if (equal_noInline(true, 1)) { return 14; }
              if (equal_noInline(false, 0)) { return 15; }
              if (!equal_noInline(true, true)) { return 16; }
              if (!different_noInline(true, false)) { return 17; }
              if (!(1 < 2 === true && 1 === 1 === true)) { return 18; }
              let box = { value: 0 };
              if (!(left_noInline(box) === right_noInline(box))) { return 19; }
              if (box.value !== 2) { return 20; }
              return 42;
            }"
           42))

(deftest decoded_string_escapes_execute_through_jsl_utf16_operations
  (execution-assert-source
    "function equal_noInline(a, b) { return a === b; }
     function main() {
       if (!equal_noInline('\\x41\\u00e9\\u{1f600}', 'Aé😀')) { return 1; }
       if (!equal_noInline('\\ud83d\\ude00', '😀')) { return 2; }
       if (!equal_noInline('\\uD800', '\\u{d800}')) { return 3; }
       if (equal_noInline('\\uD800', '\\uD801')) { return 4; }
       if (!equal_noInline('a\\\r\nb\\\nc\\\rd\\ e\\ f', 'abcdef')) { return 5; }
       if (!equal_noInline('\\b\\f\\n\\r\\t\\v', '\\x08\\x0c\\x0a\\x0d\\x09\\x0b')) { return 6; }
       if (!equal_noInline('\\377\\400\\777', '\\xff 0?7')) { return 7; }
       if (!equal_noInline('\\08\\09\\8\\9', '\\x008\\x00989')) { return 8; }
       if (!equal_noInline('\\z\\é\\😀', 'zé😀')) { return 9; }
       if (!equal_noInline('a\\0b', 'a\\u0000b')) { return 10; }
       if (equal_noInline('a\\0b', 'a')) { return 11; }
       if (!equal_noInline('\\u{00000000000000000000000041}', 'A')) { return 12; }
       if (!equal_noInline('\\u{10ffff}', '\\udbff\\udfff')) { return 13; }
       if (!equal_noInline('\\\"\\'\\\\', '\\x22\\x27\\x5c')) { return 14; }
       return 42;
     }" 42))

(deftest assignment_expressions_preserve_references_values_and_rhs_scope_effects
  (execution-assert-source
    "function base_noInline(object, state) {
       state.value = !state.value; return object;
     }
     function identity_noInline(value) { return value; }
     function check_noInline(flag, x) {
       let y = x + (x = 4);
       if (y !== 9 || x !== 4) { return 1; }
       x += (x = 3);
       if (x !== 7) { return 2; }
       let a = 0; let b = 0;
       if ((a = b = flag ? 11 : 12) !== (flag ? 11 : 12)) { return 3; }
       if (a !== b) { return 4; }
       let original = { value: 2 }; let other = { value: 10 }; let owner = original;
       let state = { value: false };
       let result = (owner.value = (owner = other).value);
       if (result !== 10 || original.value !== 10 || owner !== other) { return 5; }
       base_noInline(original, state).value = 12;
       if (!state.value) { return 15; }
       result = (owner.value = flag ? (a = 21) : (a = 22));
       if (result !== a || owner.value !== a) { return 6; }
       if (identity_noInline(b = flag ? 31 : 32) !== b) { return 7; }
       let fresh = {};
       if ((fresh.value = 13) !== 13 || fresh.value !== 13) { return 8; }
       x = 8; if ((x *= 3) !== 24 || (x /= 2) !== 12 || (x -= 5) !== 7) { return 9; }
       let text = 'a'; if ((text += 'b') !== 'ab' || text !== 'ab') { return 10; }
       if ((Infinity = 17) !== 17 || Infinity !== 1 / 0) { return 11; }
       let count = 0; let sum = 0;
       while (count = count < 3 ? count + 1 : 0) { sum += count; }
       if (sum !== 6 || count !== 0) { return 12; }
       let object = { value: (x = 19) };
       if (object.value !== x) { return 13; }
       if (!(false || (x = 20)) || x !== 20) { return 14; }
       return 42;
     }
     function main() {
       let first = check_noInline(true, 5);
       if (first !== 42) { return first; }
       return check_noInline(false, 5);
     }" 42))

(defn execution-assert-source-with-varying-argv [(source (slice u8)) (expected i64)] (-> i64)
  (do
    (pipeline-compile-macho! source "/tmp/aot-take-2-source-argv.o" 1)
    (assert-eq (macho-link-runtime! "/tmp/aot-take-2-source-argv.o"
                                    "build/release/aot-runtime.o"
                                    "/tmp/aot-take-2-source-argv")
               0)
    (execution-assert-varying-argv "/tmp/aot-take-2-source-argv" expected)
    0))

(deftest ideal_main_runs_through_selection_scheduling_allocation_encoding_and_native_link
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "main")
                 ret (return-make fun
                                  (Some (con-make (ty-mem 1 TY-BOT)))
                                  (con-make (ty-int-con 42))
                                  (None [(dyn NodeOps)])
                                  (Some fun))
                 stop (stop-make)]
             (fun-set-ret! fun ret)
             (stop-add-return! stop ret)
             (looptree-build! start stop)
             (let [selected-stop (arm64-select-graph stop)
                   selected-ret (n-in! selected-stop 0)
                   selected-fun (n-in! selected-ret RETURN-CTRL)
                   selected-start (n-in! selected-fun 1)]
               (code-set-roots! selected-start selected-stop)
               (gcm-build-cfg!)
               (sched-run!)
               (assert-eq (ra-run!) 0)
               (enc-layout!)
               (enc-emit!)
               (enc-relocate!)
               (assert-eq (macho-write "/tmp/aot-take-2-exec-test.o")
                          (len (macho-bytes)))
               (assert-eq (macho-link! "/tmp/aot-take-2-exec-test.o"
                                       "/tmp/aot-take-2-exec-test")
                          0)
               (assert-eq (run-executable! "/tmp/aot-take-2-exec-test") 42)))))

(deftest ideal_two_loop_carried_values_execute_independently_of_process_argc
         (do
           (boot! 1)
           (code-reset! 1)
           (let [start (start-make (ty-int-bot))
                 fun (fun-make start (ty-tuple-of2 (ty-int-bot) (ty-int-bot)) "main")
                 loop-node (loop-make fun)
                 value (phi-make loop-node (ty-int-bot) "value")
                 count (phi-make loop-node (ty-int-bot) "count")]
             (phi-add-value! value (con-make (ty-int-con 10)))
             (phi-open! value)
             (phi-add-value! count (con-make (ty-int-con 1)))
             (phi-open! count)
             (let [arms (if-arms! (if-make loop-node count))
                   back (arms-true arms)
                   exit (arms-false arms)
                   next-value (add-make value (con-make (ty-int-con 1)))
                   next-count (sub-make count (con-make (ty-int-con 1)))
                   ret (return-make exit
                                    (Some (con-make (ty-mem 1 TY-BOT)))
                                    value
                                    (None [(dyn NodeOps)])
                                    (Some fun))
                   stop (stop-make)]
               (loop-close! loop-node back)
               (phi-close! value next-value)
               (phi-close! count next-count)
               (fun-set-ret! fun ret)
               (stop-add-return! stop ret)
               (looptree-build! start stop)
               (let [selected-stop (arm64-select-graph stop)
                     selected-ret (n-in! selected-stop 0)
                     selected-loop (n-in! (n-in! selected-ret RETURN-VALUE) 0)
                     selected-fun (n-in! selected-loop 1)
                     selected-start (n-in! selected-fun 1)]
                 (code-set-roots! selected-start selected-stop)
                 (gcm-build-cfg!)
                 (sched-run!)
                 (ra-run!)
                 (enc-layout!)
                 (enc-emit!)
                 (enc-relocate!)
                 (assert-eq (macho-write "/tmp/aot-take-2-loop-phi.o")
                            (len (macho-bytes)))
                 (assert-eq (macho-link! "/tmp/aot-take-2-loop-phi.o"
                                         "/tmp/aot-take-2-loop-phi")
                            0)
                 (execution-assert-varying-argv "/tmp/aot-take-2-loop-phi" 11))))))

(deftest source_arithmetic_runs_from_parser_through_native_execution
         (execution-assert-source "function main() { return 20 + 22; }" 42))

(deftest script_executes_top_level_code_without_invoking_main_or_using_expression_exit_status
         (assert-eq
           (pipeline-compile-script-link-run!
             "/*---\nflags: [raw]\n---*/
              ; let answer = later(40); answer = answer + 2;
              function main() { return 7; }
              function later(value) { return value; }
              answer;"
             "/tmp/aot-take-2-script.o" "/tmp/aot-take-2-script" 1)
           0))

(deftest logical_phi_with_register_formals_preserves_the_selected_number
         (execution-assert-source
           "function choose_noInline(value, other) { return value || other; }
            function main() { return choose_noInline(0, 42); }"
           42))

(deftest incorrect_typescript_annotations_do_not_change_javascript_values
         (execution-assert-source
           "function identity_noInline(value: number | undefined): string {
              let result: boolean = value;
              return result;
            }
            function main(): number { return identity_noInline(42); }"
           42))

(deftest lexical_initialization_and_block_exit_preserve_the_live_loop_environment
         (execution-assert-source
           "function work_noInline(n) {
              let x = 42;
              let result;
              if (result !== undefined) return 1;
              if (n) { let x; x = 7; if (x !== 7) return 2; }
              { let x = 9; while (n < 3) { n = n + 1; } }
              if (x !== 42) return 3;
              let i = 0;
              while (i < 2) {
                let x;
                if (x !== undefined) return 4;
                x = i;
                let j = 0;
                while (j < 2) { j = j + 1; }
                i = i + 1;
              }
              result = x;
              const done = result;
              return done;
            }
            function main() { return work_noInline(1); }"
           42))

(deftest function_var_hoisting_and_declaration_lists_preserve_initialization_order
         (execution-assert-source
           "function dead_noInline() { return typeof after === 'undefined'; var after = 99; }
            function parameter_noInline(arguments) { var arguments; return arguments; }
            function work_noInline(x) {
              var x;
              if (x !== 40) return 1;
              if (typeof later !== 'undefined') return 2;
              if (false) { var skipped = 99; }
              if (skipped !== undefined) return 3;
              { var later = 2; }
              var x = x + later, copy = x;
              var x;
              { let x = 7; if (x !== 7) return 4; }
              let a = 1, b = a + 1;
              const c = b + 1, d = c + 1;
              if (d !== 4) return 5;
              var i = 0;
              while (i < 2) { var saved = i; i = i + 1; }
              if (saved !== 1) return 6;
              if (true) var branch = copy; else var branch = 0;
              if (!dead_noInline()) return 7;
              if (parameter_noInline(42) !== 42) return 8;
              return branch;
            }
            function main() { return work_noInline(40); }"
           42))

(deftest loop_breaks_merge_surviving_bindings_and_use_live_nested_branch_scopes
         (execution-assert-source
           "function work_noInline(limit) {
              let result = 0, outer = 0;
              while (outer < 4) {
                let inner = 0;
                while (true) {
                  { let temporary = 1; inner = inner + temporary; }
                  if (inner === limit) break;
                }
                result = result + inner;
                outer = outer + 1;
                if (outer === 2) { let ignored = 9; break; }
              }
              if (limit) {
                while (result < 40) { result = result + 1; }
              } else {
                while (result < 10) { result = result + 1; }
              }
              while (true) { result = result + 2; break; result = 0; }
              return result;
            }
            function main() { return work_noInline(3); }"
           42))

(deftest switch_selection_fallthrough_default_and_nested_breaks_follow_javascript_order
         (execution-assert-source
           "function pick_noInline(value) {
              var result = 0;
              switch (value) {
                case 1: result = 10;
                default: result = result + 2;
                case 2: result = result + 30; break;
                case 3: return 3;
              }
              return result;
            }
            function first_noInline(box, value) { box.first = !box.first; return value; }
            function last_noInline(box, value) { box.last = true; return value; }
            function complete_noInline(value) {
              switch (value) { case 1: return 40; default: return 42; }
              return unreachableName;
            }
            function lexical_noInline() {
              let value = 1;
              switch (value) { case 1: let value = 42; return value; default: return 0; }
            }
            function main() {
              if (pick_noInline(1) !== 42) return 1;
              if (pick_noInline(2) !== 30) return 2;
              if (pick_noInline(9) !== 32) return 3;
              if (pick_noInline(3) !== 3) return 4;
              let box = {first: false, last: false};
              let result = 0;
              switch (1) {
                case first_noInline(box, 1): result = 1;
                case last_noInline(box, 2): result = result + 1; break;
              }
              if (!box.first || box.last || result !== 2) return 5;
              box.first = false;
              switch (2) {
                case first_noInline(box, 1): return 6;
                default: return 7;
                case last_noInline(box, 2): break;
              }
              if (!box.first || !box.last) return 8;
              box.first = false;
              switch (first_noInline(box, 7)) { case 0: return 16; case 7: break; default: return 17; }
              if (!box.first) return 18;
              switch (first_noInline(box, 0)) {}
              if (box.first) return 19;
              if (complete_noInline(9) !== 42 || lexical_noInline() !== 42) return 20;
              switch (NaN) { case NaN: return 9; }
              switch (-0) { case 0: break; default: return 10; }
              switch ('a' + 'b') { case 'ab': break; default: return 11; }
              switch (box) { case {}: return 12; case box: break; default: return 13; }
              switch (true) { case 1: return 14; default: break; }
              let i = 0;
              while (i < 2) {
                switch (i) { case 0: { let local = 9; break; } default: break; }
                i = i + 1;
              }
              switch (i) {
                case 2: while (true) { result = 42; break; } break;
                default: return 15;
              }
              return result;
            }"
           42)
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) 0)
         (let [status (run-executable! "/tmp/aot-take-2-source-matrix")]
           (unsetenv c"AOT_RT_GC_STRESS")
           (assert-eq status 42)))

(deftest typeof_uses_dynamic_values_and_preserves_operand_effects
         (execution-assert-source
           "function kind_noInline(value: number): boolean { return typeof value; }
            function touch_noInline(box) { box.count = !box.count; return box; }
            function main() {
              if (kind_noInline(undefined) !== 'undefined') return 1;
              if (kind_noInline(null) !== 'object') return 2;
              if (kind_noInline(true) !== 'boolean') return 3;
              if (kind_noInline(false) !== 'boolean') return 4;
              if (kind_noInline(42) !== 'number') return 5;
              if (kind_noInline(-0) !== 'number') return 6;
              if (kind_noInline(NaN) !== 'number') return 7;
              if (kind_noInline(Infinity) !== 'number') return 8;
              if (kind_noInline('') !== 'string') return 9;
              if (kind_noInline('hello') !== 'string') return 10;
              let box = {count: false};
              if (kind_noInline(box) !== 'object') return 11;
              if (typeof touch_noInline(box) !== 'object') return 12;
              if (box.count !== true) return 13;
              if (typeof (void touch_noInline(box)) !== 'undefined') return 14;
              if (box.count !== false) return 15;
              if (typeof typeof 42 !== 'string') return 16;
              if (typeof (1 < 2) !== 'boolean') return 17;
              let JSON;
              if (typeof ((JSON)) !== 'undefined') return 18;
              JSON = 42;
              if (typeof JSON !== 'number') return 19;
              { let undefined = 7; if (typeof undefined !== 'number') return 20; }
              return 42;
            }"
           42)
         ;; Reuse the compiled binary. Type-result strings allocate, so collect before each
         ;; allocation as well as testing the default path; no second compiler/linker invocation.
         (assert-eq (setenv c"AOT_RT_GC_STRESS" c"1" 1) 0)
         (let [status (run-executable! "/tmp/aot-take-2-source-matrix")]
           (unsetenv c"AOT_RT_GC_STRESS")
           (assert-eq status 42)))

(deftest logical_operators_preserve_dynamic_values_and_short_circuit_effects
         (execution-assert-source
           "function choose_noInline(value, other) { return value || other; }
            function and_noInline(value, other) { return value && other; }
            function nullish_noInline(value, other) { return value ?? other; }
            function touch_noInline(box) { box.count = !box.count; return 42; }
            function main() {
              let box = {count: false};
              false && touch_noInline(box);
              if (box.count) return 13;
              true || touch_noInline(box);
              if (box.count) return 14;
              0 ?? touch_noInline(box);
              if (box.count) return 15;
              false ?? touch_noInline(box);
              if (box.count) return 16;
              '' ?? touch_noInline(box);
              if (box.count) return 17;
              let a = null ?? touch_noInline(box);
              if (!box.count) return 18;
              let b = undefined ?? touch_noInline(box);
              if (box.count) return 1;
              if (!a) return 2;
              if (!b) return 3;
              if (!choose_noInline('', 42)) return 4;
              if (!and_noInline(1, 42)) return 5;
              if (nullish_noInline(0, 7)) return 6;
              if (!nullish_noInline(null, 42)) return 7;
              if (nullish_noInline(box, 7).count) return 8;
              if (!true || false || !!null || !!undefined) return 9;
              if (false || true && false) return 10;
              if ((null ?? false) || (true && false)) return 11;
              void touch_noInline(box);
              if (!box.count) return 12;
              return 42;
            }"
           42))

