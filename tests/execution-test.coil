;; The shape of test262's assertion harness: a constructor guarding `this instanceof`, methods
;; added to a function object one dynamic store at a time (runtime shape transitions), a
;; try/catch that inspects the thrown object's `constructor`, and a second Script that calls it.
(defn execution-harness-shape [] (-> (slice u8))
  "function Test262Error(message) {
     if (!(this instanceof Test262Error)) return new Test262Error(message);
     this.message = message || '';
   }
   Test262Error.prototype.toString = function () { return 'Test262Error: ' + this.message; };
   Test262Error.thrower = function (message) { throw new Test262Error(message); };
   function assert(mustBeTrue, message) {
     if (mustBeTrue === true) { return; }
     if (message === undefined) { message = 'Expected true'; }
     throw new Test262Error(message);
   }
   assert._isSameValue = function (a, b) {
     if (a === b) { return a !== 0 || 1 / a === 1 / b; }
     return a !== a && b !== b;
   };
   assert.sameValue = function (actual, expected, message) {
     if (assert._isSameValue(actual, expected)) { return; }
     throw new Test262Error(message);
   };
   assert.throws = function (expectedErrorConstructor, func, message) {
     if (typeof func !== 'function') { throw new Test262Error('not a function'); }
     try { func(); } catch (thrown) {
       if (typeof thrown !== 'object' || thrown === null) { throw new Test262Error('not an object'); }
       if (thrown.constructor !== expectedErrorConstructor) { throw new Test262Error('wrong constructor'); }
       return;
     }
     throw new Test262Error('did not throw');
   };")

(deftest assertion_harness_shape_runs_across_scripts
         (execution-assert-scripts
           (execution-harness-shape)
           "var x = 1;
            assert.sameValue(x, 1, 'x');
            assert.sameValue(-0, -0, 'negative zeros');
            assert.throws(Test262Error, function () { throw new Test262Error('boom'); });
            assert(true);"
           0)
         ;; SameValue tells the zeros apart: the failing assertion's Test262Error goes uncaught.
         (execution-assert-scripts (execution-harness-shape) "assert.sameValue(0, -0, 'zeros');" 3)
         (execution-assert-scripts (execution-harness-shape) "assert(false, 'plain failure');" 3)
         (execution-assert-scripts
           (execution-harness-shape)
           "assert.throws(Test262Error, function () { return 1; });"
           3))

;; ToString on primitives, and Number::toString's shortest round-trip digits and layout rules.
(deftest string_concatenation_converts_primitives_with_tostring
         (execution-assert-script
           "if ('a' + 1 !== 'a1') throw 1;
            if (1 + 'a' !== '1a') throw 2;
            if ('' + true !== 'true') throw 3;
            if ('' + false !== 'false') throw 4;
            if ('' + undefined !== 'undefined') throw 5;
            if ('' + null !== 'null') throw 6;
            if ('' + 0 !== '0') throw 7;
            if ('' + (0 - 0) !== '0') throw 8;
            if ('' + (0 * (0 - 1)) !== '0') throw 9;
            if ('' + 42 !== '42') throw 10;
            if ('' + (0 - 42) !== '-42') throw 11;
            if ('' + 1.5 !== '1.5') throw 12;
            if ('' + 0.1 !== '0.1') throw 13;
            if ('' + (0.1 + 0.2) !== '0.30000000000000004') throw 14;
            if ('' + 123.456 !== '123.456') throw 15;
            if ('' + 1e21 !== '1e+21') throw 16;
            if ('' + 100000000000000000000 !== '100000000000000000000') throw 17;
            if ('' + 0.000001 !== '0.000001') throw 18;
            if ('' + 0.0000001 !== '1e-7') throw 19;
            if ('' + 1.5e-7 !== '1.5e-7') throw 20;
            if ('' + (1 / 0) !== 'Infinity') throw 21;
            if ('' + (0 - 1 / 0) !== '-Infinity') throw 22;
            if ('' + (undefined - 0) !== 'NaN') throw 23;
            if ('' + 9007199254740993 !== '9007199254740992') throw 24;
            if ('' + 123456789012345680000 !== '123456789012345680000') throw 25;
            if ('' + 1.7976931348623157e308 !== '1.7976931348623157e+308') throw 26;
            if ('' + 5e-324 !== '5e-324') throw 27;
            if (('a' + 1).length !== 2) throw 28;"
           0))

;; The standard globals a program names are materialized as hoisted functions over JSL bodies
