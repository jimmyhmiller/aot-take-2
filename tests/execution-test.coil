(deftest supported_source_pipeline_is_stable_across_diverse_worklist_seeds
         (let [source
                 "function count_noInline(value, missing) {
                    let answer = 40;
                    while (value) {
                      if (missing) { return 7; }
                      answer = answer + 1;
                      value = value - 1;
                    }
                    return answer;
                  }
                  function main(missing) { return count_noInline(2, missing); }"]
           (assert-eq
             (pipeline-compile-link-run! source
                                         "/tmp/aot-take-2-seed-3.o"
                                         "/tmp/aot-take-2-seed-3"
                                         3)
             42)
           (assert-eq
             (pipeline-compile-link-run! source
                                         "/tmp/aot-take-2-seed-37.o"
                                         "/tmp/aot-take-2-seed-37"
                                         37)
             42)
           (assert-eq
             (pipeline-compile-link-run! source
                                         "/tmp/aot-take-2-seed-101.o"
                                         "/tmp/aot-take-2-seed-101"
                                         101)
             42)))

