;; The selected-subgraph copier: cycles, exact edge shape, payloads, and non-edge cross-links.

(module aot.tests.copy)
(import "coil.assert" :use *)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.bits" :use *)
(import "aot.node.compare" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.call" :use *)
(import "aot.node.copy" :use *)
(import "aot.type.type" :use *)
(import "aot.verify" :use *)

(defn copy-test--selection [] (-> (ArrayList bool))
  (let [a (alloc/malloc-allocator)
        (mut selected) (al-new [bool] a)
        cnt (+ (arena-node-count) 1)]
    (let [(mut i) 0]
      (loop (if (>= (load i) cnt)
                (break 0)
                (do
                  (push! [bool] (mut selected) false)
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (load selected)))

(defn copy-test--get [(copy (ptr GraphCopy)) (old (dyn NodeOps))] (-> (dyn NodeOps))
  (match (graph-copy-get copy old)
    (Some [fresh] fresh)
    (None [] (do (assert false) old))))

(deftest selected_copy_preserves_cycles_external_edges_nulls_and_duplicates
         (boot! 1)
         (let [start (start-make TY-BOT)
               entry (cproj-make start 0 "ctrl")
               loop-node (loop-make entry)
               zero (con-int 0)
               phi (phi-make loop-node (ty-int-bot) "i")
               one (con-int 1)
               step (add-make-mode phi one MODE-INT)]
           (n-add-def! phi (Some zero))
           (n-add-def! phi (Some step))
           (loop-close! loop-node loop-node)
           (assert-eq (verify-node loop-node) VERR-OK)
           (assert-eq (verify-node phi) VERR-OK)
           (assert-eq (verify-node step) VERR-OK)
           (assert-eq (verify-all) VERR-OK)
           (let [(mut selected) (copy-test--selection)]
             (set! (mut selected) (n-nid loop-node) true)
             (set! (mut selected) (n-nid phi) true)
             (set! (mut selected) (n-nid step) true)
             (let [copy (graph-copy-selected (al-slice (load selected)))
                   new-loop (copy-test--get copy loop-node)
                   new-phi (copy-test--get copy phi)
                   new-step (copy-test--get copy step)]
               (assert-ne (n-nid new-loop) (n-nid loop-node))
               (assert (match (n-in new-loop 0) (None [] true) (Some [_] false)))
               (assert (n-same? (n-in! new-loop 1) entry))
               (assert (n-same? (n-in! new-loop 2) new-loop))
               (assert (n-same? (n-in! new-phi 0) new-loop))
               (assert (n-same? (n-in! new-phi 1) zero))
               (assert (n-same? (n-in! new-phi 2) new-step))
               (assert (n-same? (n-in! new-step 1) new-phi))
               (assert (n-same? (n-in! new-step 2) one))
               (assert-eq (add-mode new-step) MODE-INT)
               (assert-eq (verify-all) VERR-OK)))))

(deftest call_and_callend_crosslink_is_repaired_without_mutating_the_source
         (boot! 1)
         (let [start (start-make TY-BOT)
               call-node (call-make start)
               end (callend-make call-node)
               old-end-id (n-nid end)]
           (let [(mut selected) (copy-test--selection)]
             (set! (mut selected) (n-nid call-node) true)
             (set! (mut selected) (n-nid end) true)
             (let [copy (graph-copy-selected (al-slice (load selected)))
                   new-call (copy-test--get copy call-node)
                   new-end (copy-test--get copy end)]
               (assert-eq (n-nid (match (call-cend call-node) (Some [e] e) (None [] start))) old-end-id)
               (assert (n-same? (match (call-cend new-call) (Some [e] e) (None [] start)) new-end))
               (assert (n-same? (n-in! new-end 0) new-call))
               (assert-eq (cend-decision new-end) (cend-decision end))
               (assert-eq (verify-all) VERR-OK)))))

(deftest selected_copy_rejects_every_one_sided_metadata_pair_before_allocating
         (boot! 1)
         (let [start (start-make TY-BOT)
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               fun (fun-make start sig "pair")
               ret
                 (return-make fun
                              (None [(dyn NodeOps)])
                              (con-int 1)
                              (None [(dyn NodeOps)])
                              (Some fun))
               call-node (call-make start)
               end (callend-make call-node)]
           (fun-set-ret! fun ret)
           (let [(mut selected) (copy-test--selection)]
             (set! (mut selected) (n-nid fun) true)
             (assert (not (graph-copy-selection-valid? (al-slice (load selected)))))
             (set! (mut selected) (n-nid ret) true)
             (assert (graph-copy-selection-valid? (al-slice (load selected)))))
           (let [(mut selected) (copy-test--selection)]
             (set! (mut selected) (n-nid ret) true)
             (assert (not (graph-copy-selection-valid? (al-slice (load selected))))))
           (let [(mut selected) (copy-test--selection)]
             (set! (mut selected) (n-nid end) true)
             (assert (not (graph-copy-selection-valid? (al-slice (load selected)))))
             (set! (mut selected) (n-nid call-node) true)
             (assert (graph-copy-selection-valid? (al-slice (load selected)))))
           (let [(mut selected) (copy-test--selection)]
             (set! (mut selected) (n-nid call-node) true)
             (assert (not (graph-copy-selection-valid? (al-slice (load selected))))))))

(deftest sparse_function_copy_preserves_the_source_construction_span
         (boot! 1)
         (let [start (start-make TY-BOT)
               sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
               fun (fun-make start sig "sparse")]
           ;; These nodes contribute to the construction span but are deliberately outside the
           ;; selected sparse pair.
           (add-make (con-int 1) (con-int 2))
           (mul-make (con-int 3) (con-int 4))
           (let [ret
                   (return-make fun
                                (None [(dyn NodeOps)])
                                (con-int 5)
                                (None [(dyn NodeOps)])
                                (Some fun))]
             (fun-set-ret! fun ret)
             (let [size (fun-approx-size fun)
                   (mut selected) (copy-test--selection)]
               (set! (mut selected) (n-nid fun) true)
               (set! (mut selected) (n-nid ret) true)
               (let [copy (graph-copy-selected (al-slice (load selected)))
                     fresh (copy-test--get copy fun)]
                 (assert (> size 2))
                 (assert-eq (fun-approx-size fresh) size))))))

(deftest every_implemented_noncall_opcode_has_a_shape_preserving_shell
         (boot! 1)
         (let [start (start-make TY-BOT)
               ctrl (cproj-make start 0 "ctrl")
               x (con-int 7)
               y (con-int 2)
               dyn-value (box-make x)
               branch (if-make ctrl x)
               region (region-make)]
           (stop-make)
           (xctrl-make)
           (n-add-def! region (Some ctrl))
           (n-add-def! region (Some ctrl))
           (never-make ctrl)
           (cproj-make branch 0 "false")
           (proj-make start 1 "arg")
           (return-make ctrl (None [(dyn NodeOps)]) x (None [(dyn NodeOps)]) (None [(dyn NodeOps)]))
           (let [phi (phi-make region (ty-int-bot) "p")]
             (n-add-def! phi (Some x))
             (n-add-def! phi (Some y)))
           (add-make-mode x y MODE-INT)
           (sub-make-mode x y MODE-INT)
           (mul-make-mode x y MODE-INT)
           (div-make-mode x y MODE-INT)
           (shl-make x y)
           (minus-make x)
           (to-float-make x)
           (round-f32-make (to-float-make x))
           (and-make x y)
           (or-make x y)
           (xor-make x y)
           (shr-make x y)
           (sar-make x y)
           (not-make x)
           (eq-make x y)
           (ne-make x y)
           (lt-make x y)
           (le-make x y)
           (ult-make x y)
           (unbox-make dyn-value REP-INT)
           (typetest-make dyn-value TAG-INT)
           (cast-make ctrl dyn-value (ty-dyn TAG-INT))
           (let [(mut selected) (copy-test--selection)
                 limit (arena-node-count)
                 (mut id) 1]
             (loop (if (> (load id) limit)
                       (break 0)
                       (do
                         (match (arena-node (load id))
                           (Some [_] (set! (mut selected) (load id) true))
                           (None [] 0))
                         (set! (mut id) (+ (load id) 1))
                         (continue))))
             (let [copy (graph-copy-selected (al-slice (load selected)))]
               (set! (mut id) 1)
               (loop (if (> (load id) limit)
                         (break 0)
                         (do
                           (match (arena-node (load id))
                             (Some [old]
                                   (let [fresh (copy-test--get copy old)]
                                     (assert-eq (n-op fresh) (n-op old))
                                     (assert-eq (n-nins fresh) (n-nins old))
                                     (assert-eq (n-ty fresh) (n-ty old))))
                             (None [] 0))
                           (set! (mut id) (+ (load id) 1))
                           (continue))))))))
