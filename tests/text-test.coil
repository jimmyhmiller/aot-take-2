;; Printer tests. Round-trippable text remains scaffolded; Graphviz output is live.

(module aot.tests.text)
(import "coil.assert" :use *)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-get slice-len])
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.print.dot" :use *)
(import "aot.type.type" :use *)

(defn bytes-contain? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (let [hn (len hay)
        nn (len needle)
        (mut at) 0
        (mut found) false]
    (loop (if (or (load found) (> (+ (load at) nn) hn))
              (break 0)
              (let [(mut i) 0
                    (mut same) true]
                (loop (if (or (not (load same)) (>= (load i) nn))
                          (break 0)
                          (do
                            (if (!= (get hay (+ (load at) (load i)))
                                    (get needle (load i)))
                                (set! (mut same) false)
                                0)
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (if (load same) (set! (mut found) true) 0)
                (set! (mut at) (+ (load at) 1))
                (continue))))
    (load found)))

(deftest dot_prints_expression_nodes_and_indexed_edges
         (boot! 1)
         (let [root (add-make (con-int 2) (con-int 3))
               bytes (dot-graph root)]
           (assert (bytes-contain? bytes "digraph ideal_graph"))
           (assert (bytes-contain? bytes "label=\"Add #"))
           (assert (bytes-contain? bytes "taillabel=\"1\""))
           (assert (bytes-contain? bytes "taillabel=\"2\""))
           (alloc/free [u8] (alloc/malloc-allocator) bytes)))

(deftest dot_marks_control_phi_and_region_relationships
         (boot! 2)
         (let [st (start-make (ty-int-bot))
               entry (cproj-make st 0 "entry")
               iff (if-make entry (con-make (ty-int-range 0 1)))
               arms (if-arms! iff)
               region (region-make)
               phi (phi-make region (ty-int-bot) "answer")]
           (region-add-path! region (arms-true arms))
           (region-add-path! region (arms-false arms))
           (phi-add-value! phi (con-int 10))
           (phi-add-value! phi (con-int 20))
           (let [bytes (dot-graph phi)]
             (assert (bytes-contain? bytes "fillcolor=gold"))
             (assert (bytes-contain? bytes "fillcolor=lightyellow"))
             (assert (bytes-contain? bytes "style=dotted"))
             (assert (bytes-contain? bytes "color=red"))
             (alloc/free [u8] (alloc/malloc-allocator) bytes))))
