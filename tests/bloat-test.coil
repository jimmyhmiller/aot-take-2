;; Graph-size budgets: the sea of nodes must stay small.
;;
;; Every test here compiles a tiny program through the pessimistic peepholes and optimistic SCCP
;; and asserts a ceiling on the live node count. The ceilings are generous multiples of the honest
;; size, so ordinary growth never trips them; what they catch is the class of regression where an
;; access expands into a dispatch at every site, a shape universe multiplies, or a fixpoint stops
;; folding what it proved. Each ceiling names the shape it protects. When one fires, the answer is
;; to find the bloat, never to raise the number.
(module aot.tests.bloat)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.opto" :use *)
(import "aot.node.property" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.parse.parser" :use *)
(import "aot.print.dot" :use *)

;; Nodes reachable from Stop after the production optimization sequence, for one or more Scripts
;; or one function-entry program. Reachability, not arena liveness: JSL definitions the program
;; never used stay in the arena until the finishing passes and are not the program's size.
(defn bloat-live-after-opto [(sources (ArrayList (slice u8))) (script-mode bool)] (-> i64)
  (do
    (boot! 1)
    (code-reset! 1)
    (let [stop (parse-program-sources sources script-mode)
          start (parser-entry-start)]
      (n-keep! start)
      (jsl-prepare-opto!)
      (iter-seed-connected! stop)
      (iter-run!)
      (parser-close-world!)
      (parser-prepare-opto! stop)
      (opto-run!)
      (iter-seed-all!)
      (iter-run!)
      (property-expand-all!)
      (iter-seed-all!)
      (iter-run!)
      (parser-finish-opto! stop)
      (jsl-finish-opto! stop)
      (n-unkeep! start)
      (let [(mut all) (dot-find-all stop)
            reachable (len (load all))]
        (al-free! [(dyn NodeOps)] (mut all))
        reachable))))

(defn bloat-one [(source (slice u8)) (script-mode bool)] (-> i64)
  (let [(mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut sources) source)
    (let [live (bloat-live-after-opto (load sources) script-mode)]
      (al-free! [(slice u8)] (mut sources))
      live)))

(defn bloat-assert-under [(what (slice u8)) (live i64) (ceiling i64)] (-> i64)
  (do
    (if (> live ceiling)
        (do (println "graph-size budget exceeded for {s}: {} live nodes, ceiling {}" what live ceiling) 0)
        0)
    (assert (<= live ceiling))
    0))

;; A property read on a literal whose backing store the compiler can see is a Load that folds; two
;; reads and their sum must not leave a shape dispatch behind. Honest size is about 37.
(deftest known_shape_property_reads_fold_and_stay_small
  (bloat-assert-under "two folded reads"
                      (bloat-one "function main() { let o = {a: 1}; return o.a + o.a; }" false)
                      80))

;; Repeated stores to an unknown receiver are one PropStore each; nothing multiplies with the
;; number of sites. Honest size is about 18 because the closed world folds the receiver.
(deftest repeated_property_stores_cost_a_constant_per_site
  (bloat-assert-under "four stores"
                      (bloat-one "function main(o) { o.a = 1; o.a = 2; o.a = 3; o.a = 4; return 0; }" false)
                      60))

;; A realm with a handful of globals, function objects and calls through them. Every global
;; access is one shaped field access; the global names must not enter the shape universe's
;; write-key closure (that once multiplied it by every permutation of the globals). Honest size is
;; about 560.
(deftest realm_global_accesses_do_not_multiply_the_shape_universe
  (let [(mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut sources)
           "var counter = 1;
            function bump() { return counter; }
            function twice(x) { return bump(); }")
    (push! [(slice u8)] (mut sources)
           "bump();
            var f = bump;
            f();
            var later = counter;
            function bump() { return 100; }")
    (let [live (bloat-live-after-opto (load sources) true)]
      (al-free! [(slice u8)] (mut sources))
      (bloat-assert-under "two-Script realm" live 1200))))

;; The peephole fixpoint itself must converge quickly on a realm this size; the budget in
;; `iter-peeps!` panics rather than spin, so reaching here is the assertion.
(deftest realm_peephole_fixpoint_converges
  (bloat-assert-under "one-Script realm"
                      (bloat-one "var x = 1; function f() { return x; } f(); f();" true)
                      600))
