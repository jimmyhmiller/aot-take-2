;; Browser graph snapshots exercise the production frontend and optimizer, not a fixture graph.

(module aot.tests.web)
(import "coil.alloc" :as alloc)
(import "coil.assert" :use *)
(import "coil.str" :use [str-find])
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.opto" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.parse.parser" :use *)
(import "aot.print.web" :use *)

(defn web-test-contains? [(bytes (slice u8)) (part (slice u8))] (-> bool)
  (match (str-find bytes part) (Some [_] true) (None [] false)))

(defn web-test-optimize! [(stop (dyn NodeOps))] (-> i64)
  (do
    (jsl-prepare-opto!)
    (iter-seed-connected! stop)
    (iter-run!)
    (parser-close-world!)
    (parser-prepare-opto! stop)
    (opto-run!)
    (iter-seed-all!)
    (iter-run!)
    (parser-finish-opto! stop)
    (jsl-finish-opto! stop)))

(deftest browser_default_example_reaches_an_optimized_snapshot
         (boot! 20260904)
         (let [stop
                 (parse-program
                   "function main() {
                      let node = { left: 1, right: 2, item: 3 };
                      return node.item;
                    }")]
           (web-test-optimize! stop)
           (let [bytes (web-graph-json stop "optimized")]
             (assert (> (len bytes) 0))
             (assert (web-test-contains? bytes "\"shape\":"))
             (assert (web-test-contains? bytes "\"color\":"))
             (assert (web-test-contains? bytes "\"idealOp\":"))
             (assert (web-test-contains? bytes "\"anchor\":"))
             (assert (web-test-contains? bytes "\"status\":\"complete\""))
             (assert (web-test-contains? bytes "\"rank\":"))
             (assert (web-test-contains? bytes "\"style\":"))
             (alloc/free [u8] (alloc/malloc-allocator) bytes))))

(deftest browser_default_example_can_be_compiled_again_for_another_phase
         (boot! 20260904)
         (let [source
                 "function main() {
                    let node = { left: 1, right: 2, item: 3 };
                    return node.item;
                  }"
               first (parse-program source)]
           (web-test-optimize! first)
           (let [bytes (web-graph-json first "optimized")]
             (alloc/free [u8] (alloc/malloc-allocator) bytes))
           (boot! 20260904)
           (let [second (parse-program source)
                 bytes (web-graph-json second "parsed")]
             (assert (> (len bytes) 0))
             (alloc/free [u8] (alloc/malloc-allocator) bytes))))
