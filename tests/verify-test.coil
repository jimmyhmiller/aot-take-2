;; Graph verifier checks and named failure codes.

(module aot.tests.verify)
(import "coil.assert" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.verify" :use *)
(import "aot.type.type" :use *)

(deftest verifier_accepts_a_well_formed_graph
         (boot! 1)
         (let [sum (add-make-mode (con-int 2) (con-int 3) MODE-INT)]
           (n-keep! sum)
           (assert-eq (verify-all) VERR-OK)
           (assert-eq (verr-name VERR-OK) "ok")))

(deftest verifier_names_a_phi_region_arity_violation
         (boot! 1)
         (let [st (start-make (ty-int-bot))
               region (region-make)]
           (region-add-path! region (cproj-make st 0 "path"))
           (let [phi (phi-make region (ty-int-bot) "x")]
             (phi-add-value! phi (con-int 1))
             ;; Deliberately corrupt only the lockstep invariant. The added edge remains symmetric,
             ;; so the verifier must identify Phi arity rather than a generic edge failure.
             (phi-add-value! phi (con-int 2))
             (n-keep! phi)
             (assert-eq (verify-node phi) VERR-PHI-ARITY)
             (assert-eq (verr-name VERR-PHI-ARITY) "phi-arity"))))

(deftest verifier_recomputes_rather_than_echoing_a_cached_gvn_hash
         (boot! 1)
         (let [sum (add-make-mode (con-int 2) (con-make (ty-int-range 3 4)) MODE-INT)]
           (n-keep! sum)
           (n-gvn-insert! sum)
           (assert-eq (verify-node sum) VERR-OK)
           ;; Deliberately corrupt only the cache. The graph and its bidirectional edges remain
           ;; valid, so the named freshness check must be the one that fires.
           (set! (.hash (hdr sum)) (+ (n-hash-of sum) 1))
           (assert-eq (verify-node sum) VERR-GVN-STALE)
           (assert-eq (verr-name VERR-GVN-STALE) "gvn-stale")))
