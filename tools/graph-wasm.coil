;; Browser entry point for source-to-ideal-graph compilation.

(module aot.tools.graph-wasm)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-new slice-data slice-len])
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.opto" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.parse.parser" :use *)
(import "aot.print.web" :use *)

(extern graph_result :cc c [(ptr u8) i32] (-> i32))

(defn graph-compile [(source-data (ptr u8)) (source-len i32) (phase i32)] (-> i32)
  (do
    (boot! 20260903)
    (let [source (slice-new [u8] source-data (cast i64 source-len))
          root (parse-program source)]
      (if (= phase (cast i32 0))
          0
          (do
            (jsl-prepare-opto!)
            (iter-seed-connected! root)
            (iter-run!)
            (parser-close-world!)
            (parser-prepare-opto! root)
            (opto-run!)
            (iter-seed-all!)
            (iter-run!)
            (parser-finish-opto! root)
            (jsl-finish-opto! root)
            0))
      (let [bytes (web-graph-json root (if (= phase (cast i32 0)) "parsed" "optimized"))
            result (graph_result (slice-data [u8] bytes) (cast i32 (len bytes)))]
        (alloc/free [u8] (alloc/malloc-allocator) bytes)
        result))))

(defn main [] (-> i64)
  0)

(export-c [graph-compile :as "graph_compile"])
