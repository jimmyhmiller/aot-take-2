;; Browser entry point for source-to-ideal-graph compilation.

(module aot.tools.graph-wasm)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-new slice-data slice-len])
(import "aot.util.panic" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.call" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.opto" :use *)
(import "aot.codegen.typecheck" :use *)
(import "aot.codegen.looptree" :use *)
(import "aot.codegen.gcmeta" :use *)
(import "aot.codegen.gcm" :use *)
(import "aot.codegen.listsched" :use *)
(import "aot.codegen.regalloc" :use *)
(import "aot.codegen.encoding" :use *)
(import "aot.node.cpus.arm64" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.parse.parser" :use *)
(import "aot.print.web" :use *)

(extern graph_result :cc c [(ptr u8) i32] (-> i32))

(defn graph-selected-start? [(n (dyn NodeOps))] (-> bool)
  (match (mach-of n) (Some [mach] (= (m-ideal-op mach) OP-START)) (None [] false)))

(defn graph-selected-start [(stop (dyn NodeOps))] (-> (dyn NodeOps))
  (match (n-walk-find stop (primitive/fnptr-of graph-selected-start?))
    (Some [start] start)
    (None [] (do (panic "graph-selected-start: selected Start is unreachable")
                 (unreachable-node)))))

(defn graph-phase-name [(phase i32)] (-> (slice u8))
  (case phase
    PHASE-PARSE "Parse"
    PHASE-ITER "Iter"
    PHASE-OPTO "Opto"
    PHASE-TYPECHECK "Typecheck"
    PHASE-LOOPTREE "Looptree"
    PHASE-SERIALIZE "Serialize"
    PHASE-UNLINK "Unlink"
    PHASE-SELECT "Select"
    PHASE-SCHEDULE "Schedule"
    PHASE-LOCALSCHED "LocalSched"
    PHASE-REGALLOC "Regalloc"
    PHASE-ENCODING "Encoding"
    PHASE-EXPORT "Export"
    (do (panic-i "graph-phase-name: invalid phase" (cast i64 phase)) "invalid")))

(defn graph-compile [(source-data (ptr u8)) (source-len i32) (phase i32)] (-> i32)
  (do
    (boot! 20260903)
    (code-reset! 20260903)
    (if (or (< phase (cast i32 PHASE-PARSE)) (> phase (cast i32 PHASE-EXPORT)))
        (panic-i "graph-compile: phase outside production pipeline" (cast i64 phase))
        0)
    (code-enter-phase! PHASE-PARSE)
    (let [source (slice-new [u8] source-data (cast i64 source-len))
          stop (parse-program source)
          start (parser-entry-start)
          (mut root-nid) (n-nid stop)]
      (n-keep! start)
      (if (>= phase (cast i32 PHASE-ITER))
          (do
            (code-enter-phase! PHASE-ITER)
            (jsl-prepare-opto!)
            (iter-seed-connected! stop)
            (iter-run!)
            0)
          0)
      (if (>= phase (cast i32 PHASE-OPTO))
          (do
            (code-enter-phase! PHASE-OPTO)
            (parser-close-world!)
            (parser-prepare-opto! stop)
            (opto-run!)
            (iter-seed-all!)
            (iter-run!)
            (parser-finish-opto! stop)
            (jsl-finish-opto! stop)
            0)
          0)
      (if (>= phase (cast i32 PHASE-TYPECHECK))
          (do (code-enter-phase! PHASE-TYPECHECK) (typecheck-run! stop) 0)
          0)
      (if (>= phase (cast i32 PHASE-LOOPTREE))
          (do (code-enter-phase! PHASE-LOOPTREE) (looptree-build! start stop) 0)
          0)
      (if (>= phase (cast i32 PHASE-SERIALIZE))
          (do (code-enter-phase! PHASE-SERIALIZE) (gc-lower-barriers-from! stop) 0)
          0)
      (if (>= phase (cast i32 PHASE-UNLINK))
          (do
            (code-enter-phase! PHASE-UNLINK)
            (parser-prepare-codegen! start)
            (jsl-prepare-codegen! start)
            (call-unlink-all!)
            0)
          0)
      (if (>= phase (cast i32 PHASE-SELECT))
          (do
            (n-unkeep! start)
            (code-enter-phase! PHASE-SELECT)
            (let [selected-stop (arm64-select-graph stop)
                  selected-start (graph-selected-start selected-stop)]
              (code-set-roots! selected-start selected-stop)
              (set! (mut root-nid) (n-nid selected-stop)))
            0)
          0)
      (if (>= phase (cast i32 PHASE-SCHEDULE))
          (do (code-enter-phase! PHASE-SCHEDULE) (gcm-build-cfg!) 0)
          0)
      (if (>= phase (cast i32 PHASE-LOCALSCHED))
          (do (code-enter-phase! PHASE-LOCALSCHED) (sched-run!) 0)
          0)
      (if (>= phase (cast i32 PHASE-REGALLOC))
          (do (code-enter-phase! PHASE-REGALLOC) (ra-run!) 0)
          0)
      (if (>= phase (cast i32 PHASE-ENCODING))
          (do
            (code-enter-phase! PHASE-ENCODING)
            (enc-layout!)
            (gc-build-stackmaps!)
            (enc-emit!)
            (enc-relocate!)
            0)
          0)
      ;; Export packages the already encoded graph. The interactive browser has no object-file
      ;; consumer, so this snapshot marks the real phase boundary without manufacturing a file.
      (if (>= phase (cast i32 PHASE-EXPORT)) (code-enter-phase! PHASE-EXPORT) 0)
      (match (arena-node (load root-nid))
        (Some [root]
              (let [bytes (web-graph-json-status root (graph-phase-name phase) "complete")
                    result (graph_result (slice-data [u8] bytes) (cast i32 (len bytes)))]
                (alloc/free [u8] (alloc/malloc-allocator) bytes)
                result))
        (None [] (do
                   (panic-i "graph-compile: snapshot root disappeared" (load root-nid))
                   (cast i32 0)))))))

(defn main [] (-> i64)
  0)

(export-c [graph-compile :as "graph_compile"])
