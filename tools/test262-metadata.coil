;; Test262 execution metadata, not JavaScript semantics. Simple has no conformance runner.
;; Contract: tc39/test262 INTERPRETING.md. Preserve ordered includes and both default variants.
;; This reads the frontmatter's execution fields, not arbitrary YAML documents. Unsupported
;; syntax in an execution field is an explicit metadata error, never a default or a skipped test.
;; Descriptive fields (including block scalars) do not control execution and remain uninterpreted.
;; Returned strings borrow the source; release the lists before releasing that source.
(module aot.tools.test262-metadata)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.str" :use *)
(import "coil.slice" :use *)

(const T262-SLOPPY 1)
(const T262-STRICT 2)
(const T262-MODULE 3)

(defstruct Test262Metadata
  [(flags (ArrayList (slice u8)))
   (includes (ArrayList (slice u8)))
   (features (ArrayList (slice u8)))
   (locales (ArrayList (slice u8)))
   (negative-phase (slice u8))
   (negative-type (slice u8))
   (negative bool)
   (error (slice u8))])

(defn t262-has [(items (ArrayList (slice u8))) (value (slice u8))] (-> bool)
  (let [(mut found) false]
    (for item (iter items) (if (= item value) (set! (mut found) true) 0))
    (load found)))

(defn t262-scalar [(text (slice u8))] (-> (slice u8))
  (let [s (str-trim text) n (len s)]
    (if (and (>= n 2)
             (or (and (= (get s 0) (cast u8 39)) (= (get s (- n 1)) (cast u8 39)))
                 (and (= (get s 0) (cast u8 34)) (= (get s (- n 1)) (cast u8 34)))))
        (subslice [u8] s 1 (- n 1)) s)))

;; Execution-field scalars in the pinned corpus are identifier/path tokens. Reject YAML aliases,
;; escape sequences and structured values rather than pretending to decode them.
(defn t262-scalar-valid? [(s (slice u8))] (-> bool)
  (let [(mut good) (> (len s) 0)]
    (for c (iter s)
      (if (or (and (>= c (cast u8 65)) (<= c (cast u8 90)))
              (and (>= c (cast u8 97)) (<= c (cast u8 122)))
              (and (>= c (cast u8 48)) (<= c (cast u8 57)))
              (= c (cast u8 95)) (= c (cast u8 45)) (= c (cast u8 46))
              (= c (cast u8 47)))
          0 (set! (mut good) false)))
    (load good)))

(defn t262-list-item! [(items (mut (ArrayList (slice u8))))
                       (text (slice u8)) (meta (mut Test262Metadata))] (-> i64)
  (let [s (t262-scalar text)]
    (if (t262-scalar-valid? s)
        (do (push! [(slice u8)] (mut items) s) 0)
        (do (set! (.error meta) "unsupported execution-field scalar") 0))))

(defn t262-list! [(items (mut (ArrayList (slice u8))))
                  (text (slice u8)) (meta (mut Test262Metadata))] (-> i64)
  (let [s (str-trim text) n (len s)]
    (if (= n 0) 0
        (if (and (>= n 2) (= (get s 0) (cast u8 91)) (= (get s (- n 1)) (cast u8 93)))
            (let [body (str-trim (subslice [u8] s 1 (- n 1)))
                  (mut parts) (str-split (alloc/malloc-allocator) body ",")]
              (if (> (len body) 0)
                  (for part (iter (load parts)) (t262-list-item! (mut items) part (mut meta))) 0)
              (al-free! (mut parts)))
            (do (set! (.error meta) "expected flow or block sequence") 0)))))

(defn t262-sequence! [(items (mut (ArrayList (slice u8)))) (value (slice u8))
                      (block-item bool) (meta (mut Test262Metadata))] (-> i64)
  (if block-item (t262-list-item! (mut items) value (mut meta))
      (t262-list! (mut items) value (mut meta))))

(defn t262-sequence-field! [(key (slice u8)) (value (slice u8))
                            (block-item bool) (meta (mut Test262Metadata))] (-> i64)
  (if (= key "flags") (t262-sequence! (mut (.flags meta)) value block-item (mut meta))
      (if (= key "includes") (t262-sequence! (mut (.includes meta)) value block-item (mut meta))
          (if (= key "features") (t262-sequence! (mut (.features meta)) value block-item (mut meta))
              (t262-sequence! (mut (.locales meta)) value block-item (mut meta))))))

(defn t262-sequence-key? [(key (slice u8))] (-> bool)
  (or (= key "flags") (= key "includes") (= key "features") (= key "locale")))

(defn t262-metadata [(source (slice u8))] (-> Test262Metadata)
  (let [a (alloc/malloc-allocator)
        (mut meta) (primitive/zeroed Test262Metadata)
        (mut seen) (al-new [(slice u8)] a)
        (mut active) ""]
    (set! (.flags (mut meta)) (al-new [(slice u8)] a))
    (set! (.includes (mut meta)) (al-new [(slice u8)] a))
    (set! (.features (mut meta)) (al-new [(slice u8)] a))
    (set! (.locales (mut meta)) (al-new [(slice u8)] a))
    (set! (.error (mut meta)) "")
    (set! (.negative-phase (mut meta)) "")
    (set! (.negative-type (mut meta)) "")
    (match (str-find source "/*---")
      (None [] (set! (.error (mut meta)) "missing frontmatter"))
      (Some [open]
        (match (str-find-from source "---*/" (+ open 5))
          (None [] (set! (.error (mut meta)) "unterminated frontmatter"))
          (Some [close]
            (let [(mut lines) (str-split a (subslice [u8] source (+ open 5) close) "\n")]
              (for line (iter (load lines))
                (let [s (str-trim line)]
                  (if (or (= (len s) 0) (starts-with s "#")) 0
                      (if (not (str-ws? (get line 0)))
                          (match (str-find s ":")
                            (None [] (set! (.error (mut meta)) "expected metadata mapping"))
                            (Some [colon]
                              (let [key (subslice [u8] s 0 colon)
                                    value (str-trim (subslice [u8] s (+ colon 1) (len s)))]
                                (if (t262-has (load seen) key)
                                    (set! (.error (mut meta)) "duplicate metadata key") 0)
                                (push! [(slice u8)] (mut seen) key)
                                (set! (mut active) key)
                                (if (t262-sequence-key? key)
                                    (t262-sequence-field! key value false (mut meta))
                                    (if (= key "negative")
                                        (do (set! (.negative (mut meta)) true)
                                            (if (!= value "")
                                                (set! (.error (mut meta)) "expected negative block mapping") 0))
                                        0)))))
                          (if (t262-sequence-key? (load active))
                              (if (starts-with s "- ")
                                  (t262-sequence-field! (load active) (subslice [u8] s 2 (len s)) true (mut meta))
                                  (set! (.error (mut meta)) "expected block sequence item"))
                              (if (= (load active) "negative")
                                  (match (str-find s ":")
                                    (None [] (set! (.error (mut meta)) "expected negative field"))
                                    (Some [colon]
                                      (let [key (subslice [u8] s 0 colon)
                                            value (t262-scalar (subslice [u8] s (+ colon 1) (len s)))]
                                        (if (not (t262-scalar-valid? value))
                                            (set! (.error (mut meta)) "invalid negative scalar") 0)
                                        (if (= key "phase")
                                            (if (!= (.negative-phase meta) "")
                                                (set! (.error (mut meta)) "duplicate negative phase")
                                                (set! (.negative-phase (mut meta)) value))
                                            (if (= key "type")
                                                (if (!= (.negative-type meta) "")
                                                    (set! (.error (mut meta)) "duplicate negative type")
                                                    (set! (.negative-type (mut meta)) value))
                                                (set! (.error (mut meta)) "unknown negative field"))))))
                                  0))))))
              (al-free! (mut lines)))))))
    (al-free! (mut seen))
    (if (and (.negative meta)
             (or (= (.negative-type meta) "")
                 (not (or (= (.negative-phase meta) "parse") (= (.negative-phase meta) "resolution")
                          (= (.negative-phase meta) "runtime")))))
        (set! (.error (mut meta)) "invalid negative expectation") 0)
    (for flag (iter (.flags meta))
      (if (or (= flag "onlyStrict") (= flag "noStrict") (= flag "module") (= flag "raw")
              (= flag "async") (= flag "generated") (= flag "CanBlockIsFalse")
              (= flag "CanBlockIsTrue") (= flag "non-deterministic"))
          0 (set! (.error (mut meta)) "unknown execution flag")))
    (if (and (t262-has (.flags meta) "onlyStrict") (t262-has (.flags meta) "noStrict"))
        (set! (.error (mut meta)) "conflicting strict flags") 0)
    (load meta)))

(defn t262-metadata-free! [(meta (mut Test262Metadata))] (-> i64)
  (al-free! (mut (.flags meta)))
  (al-free! (mut (.includes meta)))
  (al-free! (mut (.features meta)))
  (al-free! (mut (.locales meta))))

(defn t262-variants [(meta Test262Metadata)] (-> (ArrayList i64))
  (let [(mut result) (al-new [i64] (alloc/malloc-allocator))]
    (if (t262-has (.flags meta) "module")
        (push! [i64] (mut result) T262-MODULE)
        (if (t262-has (.flags meta) "raw")
            (push! [i64] (mut result) T262-SLOPPY)
            (do
              (if (not (t262-has (.flags meta) "onlyStrict")) (push! [i64] (mut result) T262-SLOPPY) 0)
              (if (not (t262-has (.flags meta) "noStrict")) (push! [i64] (mut result) T262-STRICT) 0))))
    (load result)))
