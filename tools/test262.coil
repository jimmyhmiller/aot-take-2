;; Coil-owned test262 orchestration. JavaScript files are compiler inputs, never runner code.

;; Git supplies a pinned, tracked file inventory, not semantic preprocessing. A dirty suite is
;; refused so the revision printed with the denominator identifies the bytes we inspected.
;; Simple has no test262 runner. Execution policy comes from test262/INTERPRETING.md.
(module aot.tools.test262)
(import "coil.alloc" :as alloc)
(import "coil.args" :as args)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.print" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.subprocess" :as subprocess)
(import "coil.time" :as time)
(import "aot.tools.test262-metadata" :use *)
(import "aot.tools.test262-policy" :use *)
(import "aot.util.panic" :use *)

(const TEST262-REVISION "419d3e0a2273ba01a3bfcbec423f2801425b8e93")

(defn t262-git [(root (slice u8)) (command (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        (mut argv) (str-split a command " ")
        (mut options) (primitive/zeroed subprocess/RunOptions)
        result (primitive/alloc-stack subprocess/RunResult)]
    (set! (.program (mut options)) "git")
    (set! (.args (mut options)) (al-slice (load argv)))
    (set! (.cwd (mut options)) root)
    (set! (.stdout-limit (mut options)) 16777216)
    (set! (.stderr-limit (mut options)) 65536)
    (set! (.deadline (mut options))
          (Some (try (let [deadline
                             (try-or! (time/deadline-after (time/Duration :sec 30 :nsec 0))
                                      (do (panic "test262: clock failed") (primitive/zeroed time/Instant)))]
                       deadline))))
    (try (let [_ (try-or! (subprocess/run a result (load options)) (panic "test262: git process failed"))] 0))
    (if (or (.timed-out result)
            (.stdout-truncated result)
            (.stderr-truncated result)
            (match (.status result) (subprocess/Exited [code] (!= code 0)) (subprocess/Signaled [_] true)))
        (panic "test262: git did not produce a complete successful inventory")
        0)
    (let [copy
            (match (str-concat a (.stdout result) "")
              (Some [bytes] bytes)
              (None [] (do (panic "test262: inventory allocation failed") "")))]
      (subprocess/run-result-free a result)
      (al-free! (mut argv))
      copy)))

(defn t262-read [(root (slice u8)) (relative (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        (mut path) (sb-new a)]
    (sb-push-str! (mut path) root)
    (sb-push-str! (mut path) "/")
    (sb-push-str! (mut path) relative)
    (let [source
            (try (let [bytes
                         (try-or! (fs/read-file a (sb-str (load path)))
                                  (do
                                    (println "cannot read {}" (sb-str (load path)))
                                    (panic "test262: missing tracked input")
                                    ""))]
                   bytes))]
      (sb-free! (mut path))
      source)))

(defn t262-test-path? [(path (slice u8))] (-> bool)
  (and (starts-with path "test/")
       (>= (len path) 3)
       (= (subslice [u8] path (- (len path) 3) (len path)) ".js")
       (match (str-find path "_FIXTURE") (Some [_] false) (None [] true))))

(defn t262-inventory [(root (slice u8))] (-> i64)
  (let [a (alloc/malloc-allocator)
        revision (t262-git root "rev-parse HEAD")
        dirty (t262-git root "status --porcelain --untracked-files=normal -- test harness")
        (mut files) 0
        (mut variants) 0
        (mut errors) 0
        (mut plan-errors) 0
        (mut raw) 0
        (mut modules) 0
        (mut asynchronous) 0
        (mut negative) 0]
    (if (!= (str-trim revision) TEST262-REVISION) (panic "test262: unexpected suite revision") 0)
    (if (!= (len dirty) 0) (panic "test262: suite test/harness tree is dirty") 0)
    (println "test262 revision {}" (str-trim revision))
    (let [listing (t262-git root "ls-files -z -- test")
          (mut paths) (str-split a listing "\0")]
      (for path
        (iter (load paths))
        (if (t262-test-path? path)
            (let [source (t262-read root path)
                  (mut meta) (t262-metadata source)
                  (mut modes) (t262-variants (load meta))]
              (set! (mut files) (+ (load files) 1))
              (if (!= (.error meta) "")
                  (do
                    (set! (mut errors) (+ (load errors) 1))
                    (println "metadata-error\t{}\t{}" path (.error meta))
                    0)
                  (set! (mut variants) (+ (load variants) (len (load modes)))))
              (if (= (.error meta) "")
                  (for mode (iter (load modes))
                    (match (t262-plan (load meta) path mode)
                      (Err [reason]
                        (set! (mut plan-errors) (+ (load plan-errors) 1))
                        (println "plan-error\t{}\t{}" path reason)
                        0)
                      (Ok [planned]
                        (let [(mut units) planned] (al-free! (mut units)))))) 0)
              (if (t262-has (.flags meta) "raw") (set! (mut raw) (+ (load raw) 1)) 0)
              (if (t262-has (.flags meta) "module") (set! (mut modules) (+ (load modules) 1)) 0)
              (if (t262-has (.flags meta) "async") (set! (mut asynchronous) (+ (load asynchronous) 1)) 0)
              (if (.negative meta) (set! (mut negative) (+ (load negative) 1)) 0)
              (al-free! (mut modes))
              (t262-metadata-free! (mut meta))
              (alloc/free [u8] a source))
            0))
      (al-free! (mut paths))
      (alloc/free [u8] a listing))
    (println "files={} required-variants={} metadata-errors={}" (load files) (load variants) (load errors))
    (println "raw={} module={} async={} negative={}" (load raw) (load modules) (load asynchronous) (load negative))
    (println "plan-errors={}" (load plan-errors))
    (println "No execution results: inventory is not a conformance pass.")
    (alloc/free [u8] a revision)
    (alloc/free [u8] a dirty)
    (if (or (> (load errors) 0) (> (load plan-errors) 0)) 1 0)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/args-set! argc argv)
  (if (and (= (args/args-count) 3) (= (args/args-nth 1) "inventory"))
      (t262-inventory (args/args-nth 2))
      (do (println "usage: test262 inventory TEST262_ROOT") 64)))
