;; Test262 runner policy. Simple has no conformance-harness equivalent.
;; INTERPRETING.md defines harness Scripts followed by the test Script/Module in one realm.
;; Strict transformation belongs ONLY to the test source; raw forbids any transformation or
;; harness evaluation. A plan preserves those boundaries instead of concatenating source text.
;; This module does not execute JavaScript. The worker must produce observations from actual
;; execution, with harness failures and compiler failures kept outside the JS exception channel.
(module aot.tools.test262-policy)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "aot.tools.test262-metadata" :use *)

(defstruct Test262Unit
  [(path (slice u8)) (mode i64) (harness bool)])

;; Paths borrow the metadata/source path or static defaults. The caller owns only the list.
(defn t262-relative-path? [(path (slice u8))] (-> bool)
  (let [(mut pieces) (str-split (alloc/malloc-allocator) path "/")
        (mut valid) (> (len path) 0)]
    (for piece (iter (load pieces))
      (if (or (= piece "") (= piece ".") (= piece "..")) (set! (mut valid) false) 0))
    (for byte (iter path)
      (if (or (= byte (cast u8 0)) (= byte (cast u8 92))) (set! (mut valid) false) 0))
    (al-free! (mut pieces))
    (load valid)))

(defn t262-plan [(meta Test262Metadata) (path (slice u8)) (mode i64)]
  (-> (Result (ArrayList Test262Unit) (slice u8)))
  (let [(mut modes) (t262-variants meta)
        (mut admitted) false
        (mut units) (al-new [Test262Unit] (alloc/malloc-allocator))
        (mut error) (.error meta)]
    (for expected (iter (load modes))
      (if (= mode expected) (set! (mut admitted) true) 0))
    (al-free! (mut modes))
    (if (not (load admitted)) (set! (mut error) "variant not required by metadata") 0)
    (if (not (t262-relative-path? path)) (set! (mut error) "invalid relative test path") 0)
    (if (not (t262-has (.flags meta) "raw"))
        (do
          (push! [Test262Unit] (mut units) (Test262Unit :path "assert.js" :mode T262-SLOPPY :harness true))
          (push! [Test262Unit] (mut units) (Test262Unit :path "sta.js" :mode T262-SLOPPY :harness true))
          (if (t262-has (.flags meta) "async")
              (push! [Test262Unit] (mut units)
                     (Test262Unit :path "doneprintHandle.js" :mode T262-SLOPPY :harness true)) 0)
          (for include (iter (.includes meta))
            (if (t262-relative-path? include)
                (push! [Test262Unit] (mut units)
                       (Test262Unit :path include :mode T262-SLOPPY :harness true))
                (do (set! (mut error) "invalid relative harness include") 0)))) 0)
    (push! [Test262Unit] (mut units) (Test262Unit :path path :mode mode :harness false))
    (if (= (load error) "") (Ok (load units))
        (do (al-free! (mut units)) (Err (load error))))))

;; Only the mandated strict-mode prefix may change the test source. Independent units are
;; essential: prepending harness text here would change directive and declaration semantics.
;; The returned slice is owned, even in raw/non-strict mode, and has exactly the source's bytes.
(defn t262-unit-source [(unit Test262Unit) (source (slice u8))] (-> (Option (slice u8)))
  (str-concat (alloc/malloc-allocator)
              (if (= (.mode unit) T262-STRICT) "\"use strict\";\n" "") source))

(const T262-PASS 1)
(const T262-FAIL 2)
(const T262-UNSUPPORTED 3)
(const T262-COMPILER-ERROR 4)
(const T262-CRASH 5)
(const T262-TIMEOUT 6)
(const T262-HARNESS-ERROR 7)
(const T262-NOT-RUN 8)

;; Normal and JsException may only come from a complete worker protocol, not stdout heuristics
;; or the compiler's exit status. In particular exit 70 is not a JavaScript SyntaxError.
(defsum Test262Observation
  (Normal [(async-completions i64) (async-failed bool)])
  (JsException [(phase (slice u8)) (constructor (slice u8))])
  (HarnessFailure)
  (CompilerFailure)
  (UnsupportedCapability)
  (ProcessCrash)
  (DeadlineExpired)
  (NotExecuted))

(defn t262-verdict [(meta Test262Metadata) (observation Test262Observation)] (-> i64)
  (if (!= (.error meta) "") T262-HARNESS-ERROR
      (match observation
        (Normal [completions failed]
          (if (.negative meta) T262-FAIL
              (if (t262-has (.flags meta) "async")
                  (if (and (= completions 1) (not failed)) T262-PASS T262-FAIL)
                  (if failed T262-FAIL T262-PASS))))
        (JsException [phase constructor]
          (if (and (.negative meta) (= phase (.negative-phase meta))
                   (= constructor (.negative-type meta))) T262-PASS T262-FAIL))
        (HarnessFailure [] T262-HARNESS-ERROR)
        (CompilerFailure [] T262-COMPILER-ERROR)
        (UnsupportedCapability [] T262-UNSUPPORTED)
        (ProcessCrash [] T262-CRASH)
        (DeadlineExpired [] T262-TIMEOUT)
        (NotExecuted [] T262-NOT-RUN))))

(defstruct Test262VariantResult [(mode i64) (verdict i64)])

;; File success requires exactly one passing observation for each REQUIRED mode. Do not divide
;; by the set of completed modes: omitted strict/module variants remain failures to establish a pass.
(defn t262-file-passed? [(meta Test262Metadata) (results (ArrayList Test262VariantResult))] (-> bool)
  (let [(mut modes) (t262-variants meta)
        (mut passed) (and (= (.error meta) "") (= (len results) (len (load modes))))]
    (for mode (iter (load modes))
      (let [(mut count) 0]
        (for item (iter results)
          (let [result item]
          (if (= (.mode result) mode)
              (do (set! (mut count) (+ (load count) 1))
                  (if (!= (.verdict result) T262-PASS) (set! (mut passed) false) 0)) 0)))
        (if (!= (load count) 1) (set! (mut passed) false) 0)))
    (al-free! (mut modes))
    (load passed)))
