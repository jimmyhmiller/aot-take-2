;; Emit deterministic sample ideal graphs for visual inspection.

(module aot.tools.dot-dump)
(import "coil.alloc" :as alloc)
(import "coil.fs" :use [write-file])
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.call" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.print.dot" :use *)
(import "aot.type.type" :use *)

(defn dump-one! [(path (slice u8)) (root (dyn NodeOps))] (-> i64)
  (let [a (alloc/malloc-allocator)
        bytes (dot-graph root)]
    (try (let [count (try-or! (write-file a path bytes) (do (alloc/free [u8] a bytes) -1))]
           (do (alloc/free [u8] a bytes) count)))))

(defn expression-sample [] (-> (dyn NodeOps))
  ;; Equivalent Simple source: return (arg+3)*((arg+3)+(arg-4));
  (let [st (start-make (ty-int-bot))
        sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
        fun (fun-make st sig "expression")
        arg (parm-make fun 0 (ty-int-bot) "arg")
        shared (add-make arg (con-int 3))
        delta (sub-make arg (con-int 4))
        value (mul-make shared (add-make shared delta))
        ret (return-make fun (None [(dyn NodeOps)]) value (None [(dyn NodeOps)]) (Some fun))
        stop (stop-make)]
    (fun-set-ret! fun ret)
    (stop-add-return! stop ret)
    stop))

(defn control-sample [] (-> (dyn NodeOps))
  ;; Equivalent Simple source:
  ;;   int answer; if (arg) answer=arg+2; else answer=arg-2; return answer;
  (let [st (start-make (ty-int-bot))
        sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
        fun (fun-make st sig "control")
        arg (parm-make fun 0 (ty-int-bot) "arg")
        iff (if-make fun arg)
        arms (if-arms! iff)
        region (region-make)
        phi (phi-make region (ty-int-bot) "answer")
        stop (stop-make)]
    (region-add-path! region (arms-true arms))
    (region-add-path! region (arms-false arms))
    (phi-add-value! phi (add-make arg (con-int 2)))
    (phi-add-value! phi (sub-make arg (con-int 2)))
    (let [ret (return-make region (None [(dyn NodeOps)]) phi (None [(dyn NodeOps)]) (Some fun))]
      (fun-set-ret! fun ret)
      (stop-add-return! stop ret)
      stop)))

(defn dump-pair! [(before (slice u8)) (after (slice u8)) (root (dyn NodeOps))] (-> i64)
  (let [n1 (dump-one! before root)]
    (iter-seed-all!)
    (iter-run!)
    (let [n2 (dump-one! after root)]
      (if (or (< n1 0) (< n2 0)) -1 (+ n1 n2)))))

(defn main [] (-> i64)
  (do
    (boot! 20260830)
    (let [expression
            (dump-pair! "build/graphs/expression-before.dot"
                        "build/graphs/expression-after.dot"
                        (expression-sample))]
      (boot! 20260831)
      (let [control
              (dump-pair! "build/graphs/control-before.dot"
                          "build/graphs/control-after.dot"
                          (control-sample))]
        (if (or (< expression 0) (< control 0)) 1 0)))))
