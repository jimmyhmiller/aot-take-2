;; Emit deterministic sample ideal graphs for visual inspection.

(module aot.tools.dot-dump)
(import "coil.alloc" :as alloc)
(import "coil.fs" :use [write-file])
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.call" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.opto" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.parse.parser" :use *)
(import "aot.print.dot" :use *)
(import "aot.type.type" :use *)

(defn dump-one! [(path (slice u8)) (root (dyn NodeOps))] (-> i64)
  (let [a (alloc/malloc-allocator)
        bytes (dot-graph root)]
    (try (let [count (try-or! (write-file a path bytes) (do (alloc/free [u8] a bytes) -1))]
           (do (alloc/free [u8] a bytes) count)))))

(defn expression-sample [] (-> (dyn NodeOps))
  ;; Equivalent Simple source: return (arg+3)*((arg+3)+(arg-4));
  (let [st (start-make (ty-int-bot))
        sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
        fun (fun-make st sig "expression")
        arg (parm-make fun 0 (ty-int-bot) "arg")
        shared (add-make arg (con-int 3))
        delta (sub-make arg (con-int 4))
        value (mul-make shared (add-make shared delta))
        ret (return-make fun (None [(dyn NodeOps)]) value (None [(dyn NodeOps)]) (Some fun))
        stop (stop-make)]
    (fun-set-ret! fun ret)
    (stop-add-return! stop ret)
    stop))

(defn control-sample [] (-> (dyn NodeOps))
  ;; Equivalent Simple source:
  ;;   int answer; if (arg) answer=arg+2; else answer=arg-2; return answer;
  (let [st (start-make (ty-int-bot))
        sig (ty-tuple-of2 (ty-int-bot) (ty-int-bot))
        fun (fun-make st sig "control")
        arg (parm-make fun 0 (ty-int-bot) "arg")
        iff (if-make fun arg)
        arms (if-arms! iff)
        region (region-make)
        phi (phi-make region (ty-int-bot) "answer")
        stop (stop-make)]
    (region-add-path! region (arms-true arms))
    (region-add-path! region (arms-false arms))
    (phi-add-value! phi (add-make arg (con-int 2)))
    (phi-add-value! phi (sub-make arg (con-int 2)))
    (let [ret (return-make region (None [(dyn NodeOps)]) phi (None [(dyn NodeOps)]) (Some fun))]
      (fun-set-ret! fun ret)
      (stop-add-return! stop ret)
      stop)))

(defn dump-pair! [(before (slice u8)) (after (slice u8)) (root (dyn NodeOps))] (-> i64)
  (let [n1 (dump-one! before root)]
    (iter-seed-all!)
    (iter-run!)
    (let [n2 (dump-one! after root)]
      (if (or (< n1 0) (< n2 0)) -1 (+ n1 n2)))))

;; Parse through the production frontend and JSL registry. The first graph exposes the lazy
;; semantic Call/CallEnd boundaries; the second exposes what optimistic call-graph discovery and
;; ordinary sea-of-nodes inlining specialize those definitions into.
(defn dump-ts-pair! [(before (slice u8))
                     (after (slice u8))
                     (source (slice u8))] (-> i64)
  (let [root (parse-program source)
        n1 (dump-one! before root)]
    ;; Follow the production phase boundary: pessimistic types require unknown-caller hooks;
    ;; optimistic call discovery requires the closed source/JSL world.
    (jsl-prepare-opto!)
    (iter-seed-connected! root)
    (iter-run!)
    (parser-close-world!)
    (parser-prepare-opto! root)
    (opto-run!)
    (let [n2 (dump-one! after root)]
    (iter-seed-all!)
    (iter-run!)
    (parser-finish-opto! root)
    (jsl-finish-opto! root)
      (if (or (< n1 0) (< n2 0)) -1 (+ n1 n2)))))

(defn main [] (-> i64)
  (do
    (boot! 20260909)
    (let [object
            (dump-ts-pair! "build/graphs/object-property-before.dot"
                           "build/graphs/object-property-after.dot"
                           "function main() {
  let node = { left: 1, right: 2, item: 3 };
  return node.item;
}")]
      (boot! 20260910)
      (let [binary-trees
              (dump-ts-pair! "build/graphs/binary-trees-before.dot"
                             "build/graphs/binary-trees-after.dot"
                             "function makeTree(depth) {
  if (depth < 1) { return { left: undefined, right: undefined, item: 1 }; }
  let next = depth - 1;
  return { left: makeTree(next), right: makeTree(next), item: 1 };
}
function check(node) {
  if (node.left) { return check(node.left) + check(node.right) + 1; }
  return 1;
}
function main() { return check(makeTree(15)); }")]
      (boot! 20260830)
      (let [expression
            (dump-pair! "build/graphs/expression-before.dot"
                        "build/graphs/expression-after.dot"
                        (expression-sample))]
      (boot! 20260831)
      (let [control
              (dump-pair! "build/graphs/control-before.dot"
                          "build/graphs/control-after.dot"
                          (control-sample))]
        (boot! 20260901)
        (let [add
                (dump-ts-pair! "build/graphs/ts-add-before.dot"
                               "build/graphs/ts-add-after.dot"
                               "function main(): number { return 2 + 3; }")]
          (boot! 20260902)
          (let [precedence
                  (dump-ts-pair! "build/graphs/ts-precedence-before.dot"
                                 "build/graphs/ts-precedence-after.dot"
                                 "function main(): number { return 2 + 3 * 4; }")]
            (boot! 20260903)
            (let [grouped
                    (dump-ts-pair! "build/graphs/ts-grouped-before.dot"
                                   "build/graphs/ts-grouped-after.dot"
                                   "function main(): number { return (10 - 2) * 3; }")]
              (boot! 20260904)
              (let [scale
                      (dump-ts-pair! "build/graphs/ts-scale-before.dot"
                                     "build/graphs/ts-scale-after.dot"
                                     "function scale(a: number, b: number): number { return a + b * 4; }
function main(): number { return scale(2, 3); }")]
                (boot! 20260905)
                (let [conditional
                        (dump-ts-pair! "build/graphs/ts-conditional-before.dot"
                                       "build/graphs/ts-conditional-after.dot"
                                       "function pick(c: number, a: number, b: number): number { return c ? a : b; }
function main(): number { return pick(1, 2, 3); }")]
                  (boot! 20260906)
                  (let [unknown
                          (dump-ts-pair! "build/graphs/ts-unknown-conditional-before.dot"
                                         "build/graphs/ts-unknown-conditional-after.dot"
                                         "function main(condition: number, a: number, b: number): number {
  return condition ? a : b;
}")]
                    (boot! 20260907)
                    (let [statement-if
                            (dump-ts-pair! "build/graphs/ts-if-statement-before.dot"
                                           "build/graphs/ts-if-statement-after.dot"
                                           "function main(condition: number, a: number, b: number): number {
  let selected = a;
  if (condition) { selected = b; }
  return selected;
}")]
                      (boot! 20260908)
                      (let [while-loop
                              (dump-ts-pair! "build/graphs/ts-while-before.dot"
                                             "build/graphs/ts-while-after.dot"
                                           "function main() {
  let value = 5;
  while (value) { value = value - 1; }
  return value;
}")]
                        (if (or (< object 0)
                                (< binary-trees 0)
                                (< expression 0)
                                (< control 0)
                                (< add 0)
                                (< precedence 0)
                                (< grouped 0)
                                (< scale 0)
                                (< conditional 0)
                                (< unknown 0)
                                (< statement-if 0)
                                (< while-loop 0))
                            1
                            0)))))))))))))))
