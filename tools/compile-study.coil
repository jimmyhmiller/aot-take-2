;; Diagnostic mirror of pipeline-encode-sources-config! for a retained Script unit.
;; Calls the production passes unchanged; snapshots and printing are outside timed intervals.
;; No image installation or execution. Graphs use the project Graphviz printer.
(module aot.tools.compile-study)
(import "coil.args" :use *)
(import "coil.primitive" :use [alloc-static] :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :use *)
(import "coil.time" :use *)
(import "coil.print" :use *)
(import "aot.util.arena" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.node.call" :use *)
(import "aot.node.property" :use *)
(import "aot.codegen.pipeline" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.typecheck" :use *)
(import "aot.codegen.looptree" :use *)
(import "aot.codegen.gcmeta" :use *)
(import "aot.codegen.gcm" :use *)
(import "aot.codegen.listsched" :use *)
(import "aot.codegen.regalloc" :use *)
(import "aot.codegen.encoding" :use *)
(import "aot.node.cpus.arm64" :use *)
(import "aot.node.cpus.arm64.call" :use [arm64-call-node])
(import "aot.jsl.lower" :use *)
(import "aot.parse.parser" :use *)
(import "aot.print.dot" :use *)
(defn study-now [] (-> i64)
  (try (try-or! (monotonic-now-ms) (do (panic "compile-study: clock unavailable") 0))))
(defn study-clock [] (-> (ptr i64))
  (compiler-state [i64] (primitive/alloc-static CompilerStateSlot)))
(defn study-time [(name (slice u8))] (-> i64)
  (let [now (study-now)]
    (println "STEP {s} {} ms" name (- now (load (study-clock))))
    (set! (study-clock) (study-now)) 0))
(defn study-count [(name (slice u8)) (root (dyn NodeOps))] (-> i64)
  (let [(mut all) (dot-find-all root) (mut ins) 0 (mut funs) 0 (mut calls) 0
        (mut phis) 0 (mut loads) 0 (mut stores) 0 (mut news) 0 (mut branches) 0]
    (al-for [n (load all)]
      (set! (mut ins) (+ (load ins) (n-nins n)))
      (let [op (match (mach-of n) (Some [m] (m-ideal-op m)) (None [] (n-op n)))]
        (if (= op OP-FUN) (do (set! (mut funs) (+ (load funs) 1)) (println "FUN {s} {s}" name (n-text n)) 0) 0)
        (if (= op OP-CALL) (set! (mut calls) (+ (load calls) 1)) 0)
        (if (or (= op OP-PHI) (= op OP-MEMPHI)) (set! (mut phis) (+ (load phis) 1)) 0)
        (if (= op OP-LOAD) (set! (mut loads) (+ (load loads) 1)) 0)
        (if (= op OP-STORE) (set! (mut stores) (+ (load stores) 1)) 0)
        (if (= op OP-NEW) (set! (mut news) (+ (load news) 1)) 0)
        (if (= op OP-IF) (set! (mut branches) (+ (load branches) 1)) 0)))
    (println "GRAPH {s} arena={} connected={} inputs={} functions={} calls={} phis={} loads={} stores={} allocations={} branches={}"
      name (arena-node-count) (len (load all)) (load ins) (load funs) (load calls) (load phis) (load loads) (load stores) (load news) (load branches))
    (study-origins name (load all))
    (al-free! (mut all))
    (set! (study-clock) (study-now)) 0))

;; One arena pass plus one connected-graph pass: exclusive counts, including dead construction
;; work, grouped by expansion instance. Parent ids allow consumers to compute inclusive totals.
;; Origin zero names compiler work not owned by a JSL expansion, rather than silently losing it.
(defn study-origins [(phase (slice u8)) (connected (ArrayList (dyn NodeOps)))] (-> i64)
  (let [(mut made) (al-new [i64] (compiler-allocator))
        (mut live) (al-new [i64] (compiler-allocator))
        (mut branches) (al-new [i64] (compiler-allocator)) (mut i) 0
        count (len (.items (node-origins)))]
    (loop (if (> (load i) count) (break 0)
      (do (push! [i64] (mut made) 0) (push! [i64] (mut live) 0)
          (push! [i64] (mut branches) 0) (set! (mut i) (+ (load i) 1)) (continue))))
    (set! (mut i) 1)
    (loop (if (> (load i) (arena-node-count)) (break 0)
      (do (match (arena-node (load i))
              (Some [n] (let [id (.origin (hdr n))]
                (set! (mut made) id (+ (get (load made) id) 1)))) (None [] 0))
          (set! (mut i) (+ (load i) 1)) (continue))))
    (al-for [n connected]
      (let [id (.origin (hdr n)) op (match (mach-of n) (Some [m] (m-ideal-op m)) (None [] (n-op n)))]
        (set! (mut live) id (+ (get (load live) id) 1))
        (if (= op OP-IF) (set! (mut branches) id (+ (get (load branches) id) 1)) 0)))
    (println "ORIGIN {s} 0 parent=0 compiler unowned source=-1:-1 made={} connected={} branches={}"
      phase (get (load made) 0) (get (load live) 0) (get (load branches) 0))
    (set! (mut i) 1)
    (al-for [origin (.items (node-origins))]
      (let [o origin id (load i)]
        (if (> (get (load made) id) 0)
          (do (println "ORIGIN {s} {} parent={} {s} {s} source={}:{} made={} connected={} branches={}"
             phase id (.parent o) (.kind o) (.name o) (.lo o) (.hi o)
             (get (load made) id) (get (load live) id) (get (load branches) id)) 0) 0)
        (set! (mut i) (+ id 1))))
    (al-free! (mut made)) (al-free! (mut live)) (al-free! (mut branches)) 0))
(defn study-dot [(path (slice u8)) (root (dyn NodeOps))] (-> i64)
  (if (= path "-") 0
    (try (try-or! (write-file (compiler-allocator) path (dot-graph root))
                  (do (panic "compile-study: cannot write graph") 0)))))
(defn study-ra [] (-> i64)
  (let [(mut round) 0]
    (ra-insert-callee-saves!) (study-time "ra.entry-saves")
    (loop
      (let [lrgs (ra-build-lrg! (load round))]
        (study-time "ra.live-ranges")
        (let [ifg (if lrgs (ra-build-ifg! (load round)) false)]
          (study-time "ra.interference")
          (let [coal (if ifg (ra-coalesce! (load round)) false)]
            (study-time "ra.coalesce")
            (let [coloured (if coal (ra-colour! (load round)) false)]
              (study-time "ra.colour")
              (println "ROUND {} lrgs={} build={} interference={} coalesced={} coloured={}"
                (load round) (ra-lrg-count) lrgs ifg coal coloured)
              (set! (study-clock) (study-now))
              (if coloured (break 0)
                (do
                  (if (>= (load round) (- RA-MAX-ROUNDS 1)) (panic "compile-study: allocator exceeded split budget") 0)
                  (let [count (ra-split-all! (load round))]
                    (if (= count 0) (panic "compile-study: failed round made no splits") 0)
                    (study-time "ra.split")
                    (println "SPLITS {} {}" (load round) count))
                  (set! (study-clock) (study-now))
                  (set! (mut round) (+ (load round) 1)) (continue))))))))
    (ra-post-colour!) (study-time "ra.post-colour")
    (load round)))
;; Scheduled ownership is authoritative here; do not infer ownership by following data inputs
;; across calls. Count connected nodes only and expose the unowned floor for reconciliation.
(defn study-function-counts [(root (dyn NodeOps))] (-> i64)
  (let [(mut all) (dot-find-all root) (mut owned) 0]
    (al-for [fun (load all)]
      (if (= (match (mach-of fun) (Some [m] (m-ideal-op m)) (None [] (n-op fun))) OP-FUN)
          (let [(mut count) 0]
            (al-for [n (load all)]
              (match (gcm-use-fun n)
                (Some [owner] (if (n-same? owner fun) (set! (mut count) (+ (load count) 1)) 0))
                (None [] 0)))
            (set! (mut owned) (+ (load owned) (load count)))
            (println "FUNCTION-NODES {} {s}" (load count) (.symbol (arm64-call-node fun))) 0) 0))
    (println "FUNCTION-NODES-TOTAL owned={} unowned={} connected={}"
             (load owned) (- (len (load all)) (load owned)) (len (load all)))
    (al-free! (mut all)) 0))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args-set! argc argv)
  (if (not (or (= (args-count) 4)
               (and (= (args-count) 5) (= (args-nth 1) "--shared-jsl"))))
      (panic "usage: compile-study [--shared-jsl] SOURCE IDEAL.dot MACHINE.dot (use - to skip graph)") 0)
  (let [a (malloc-allocator) base (if (= (args-count) 5) 2 1)
        source (try (try-or! (read-file a (args-nth base)) (do (panic "compile-study: source read failed") "")))
        (mut sources) (al-new [(slice u8)] a)]
    (push! [(slice u8)] (mut sources) source)
    (boot! 1) (code-reset! 1) (set! (study-clock) (study-now))
    (jsl-set-link-mode! (if (= base 2) JSL-LINK-IMPORT JSL-LINK-LOCAL))
    (code-enter-phase! PHASE-PARSE)
    (let [stop (parse-program-sources-config (load sources) true true true)
          start (parser-entry-start)]
      (n-keep! start) (study-time "parse") (study-count "parse" stop)
      (code-enter-phase! PHASE-ITER)
      (jsl-prepare-opto!) (iter-seed-connected! stop) (iter-run!)
      (study-time "iter") (study-count "iter" stop)
      (code-enter-phase! PHASE-OPTO)
      (parser-close-world!) (pipeline-opto-under-facts! stop) (study-time "opto.facts-and-sccp")
      (iter-seed-all!) (iter-run!) (study-time "opto.sweep")
      (property-expand-all!) (study-time "opto.property-expand")
      (iter-seed-all!) (iter-run!) (study-time "opto.expansion-cleanup")
      (parser-finish-opto! stop) (jsl-finish-opto! stop) (study-time "opto.finish")
      (study-count "opto" stop) (study-dot (args-nth (+ base 1)) stop) (set! (study-clock) (study-now))
      (code-enter-phase! PHASE-TYPECHECK) (typecheck-run! stop) (study-time "typecheck")
      (code-enter-phase! PHASE-LOOPTREE) (looptree-build! start stop) (study-time "loop-tree")
      (code-enter-phase! PHASE-SERIALIZE) (gc-lower-barriers-from! stop) (study-time "barriers")
      (code-enter-phase! PHASE-UNLINK)
      (parser-prepare-codegen! start) (jsl-prepare-codegen! start) (call-unlink-all!) (n-unkeep! start)
      (study-time "unlink")
      (code-enter-phase! PHASE-SELECT)
      (let [selected (arm64-select-graph stop) selected-start (pipeline-find-selected-start selected)]
        (code-set-roots! selected-start selected) (study-time "select") (study-count "select" selected)
        (code-enter-phase! PHASE-SCHEDULE) (gcm-build-cfg!) (study-time "gcm")
        (code-enter-phase! PHASE-LOCALSCHED) (sched-run!) (study-time "local-schedule")
        (code-enter-phase! PHASE-REGALLOC) (pipeline-record-stats! (study-ra))
        (study-count "regalloc" selected)
        (study-function-counts selected)
        (study-dot (args-nth (+ base 2)) selected) (set! (study-clock) (study-now))
        (code-enter-phase! PHASE-ENCODING)
        (enc-reset!) (study-time "encode.reset")
        (enc-cache-block-owners!) (study-time "encode.owners-before-layout")
        (enc-build-block-layout!) (study-time "encode.block-order")
        (enc-cache-block-owners!) (study-time "encode.block-owners")
        (enc-set-layout-observer! (primitive/fnptr-of study-time))
        (enc-layout-from-blocks!) (study-time "encode.offsets-and-relaxation")
        (gc-build-stackmaps!) (study-time "encode.stackmaps")
        (enc-emit!) (study-time "encode.emit")
        (enc-relocate!) (study-time "encode.relocate")
        (println "CODE bytes={} blocks={} functions={}" (len (enc-bytes)) (enc-layout-block-count) (enc-definition-count))
        (let [(mut i) 0]
          (loop (if (>= (load i) (enc-definition-count)) (break 0)
            (do (println "FUNCTION-CODE {s} {} bytes" (enc-definition-name (load i)) (enc-definition-size (load i)))
                (set! (mut i) (+ (load i) 1)) (continue)))))
        (code-enter-phase! PHASE-EXPORT)))
    (free [u8] a source) (al-free! (mut sources)) 0))
