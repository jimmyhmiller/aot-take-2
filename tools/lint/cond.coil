;; A staircase of nested `if`s is a `cond`.

;;
;;   (if (= name "let") A                     (cond (= name "let") A
;;       (if (= name "if") B          =>             (= name "if") B
;;           (if (= name "do") C                      (= name "do") C
;;               D)))                                 :else D)
;;
;; Registered in Coil.toml, so `coil lint` reports a chain of three or more tests and `--fix`
;; rewrites it. `cond` is a core macro that expands to exactly the nested `if`s it replaces, so the
;; rewrite cannot change behaviour; what it changes is that a dispatcher with thirty arms stops
;; marching to column 120. `jsl-lower-expr` was the case that prompted it: 583 lines whose last arms
;; were indented past the right margin.
;;
;; The replacement is built from the author's own test and body nodes, which `--fix` prints back as
;; their original bytes: comments and layout inside an arm survive, only the spine changes.
;;
;; This is Coil's own worked example of a lint with a fix (`src/examples/metaprogramming/
;; condlint.coil` in the Coil repository), adopted as a project rule with its commentary.
(module aot.lint.cond)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [subslice])

;;; The chain length is counted at THREE, not two: `(if a b (if c d e))` is still
;;; readable, and rewriting it would be churn rather than a fix.
(defn cl-min-tests [] (-> i64)
  3)

; `(if TEST THEN ELSE)` — Coil's `if` always has both arms, so a real one has 4
; elements. `code-macro?` is the load-bearing half of this test: checkers run on the
; EXPANDED program, where every `when`/`unless`/`case`/`cond` in the file has already
; become nested ifs. Those are the compiler's ifs, not the author's, and flagging them
; would report a `cond` for being a `cond`.
(defn cl-hand-if? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (= (len f) (cast i64 4))
          (if (= (get f 0) `if) (not (primitive/code-macro? f)) false)
          false)
      false))

; How many tests the chain rooted at `f` has: 0 if `f` is not a hand-written `if`,
; else 1 + the length of the chain in its else-branch.
(defn cl-chain-len [(f Code)] (-> i64)
  (if (cl-hand-if? f) (primitive/iadd 1 (cl-chain-len (get f 3))) 0))

;; ── an arm must come back as the author wrote it ────────────────────────────────────────────────
;; The syntax phase still hands a checker some macro calls already expanded: a `let` arrives as
;; `let*`, a `for` as the `let*`/`loop`/`match` it lowers to. `--fix` prints a node that is not the
;; author's as it IS, so a replacement built from such an arm writes the expansion into the source.
;; The first cut of this rule did exactly that — 164 `let*` and two unrolled `for` loops in one
;; run, found by diffing token counts per file before and after.
;;
;; `code-src` is still the author's text, so the head it starts with says what was written:
;;   * the same head as the node's — the node is the author's; use it as it is;
;;   * `let` where the node says `let*` — rebuild `(let …)` around the node's own children, which
;;     ARE the author's and print as their original bytes;
;;   * anything else — some other macro was expanded here; leave the whole chain alone.

;;; The head symbol of the text `f` was read from: `(let [a 1] …)` -> `let`. "" when `f` is not a
;;; parenthesised form.
(defn cl-written-head [(f Code)] (-> (slice u8))
  (let [src (primitive/code-src f)
        n (len src)
        (mut i) 1]
    (if (or (< n 2) (!= (primitive/cast i64 (get src 0)) 40))
        ""
        (do
          (while (and (< (load i) n)
                      (> (primitive/cast i64 (get src (load i))) 32)
                      (!= (primitive/cast i64 (get src (load i))) 40)
                      (!= (primitive/cast i64 (get src (load i))) 41)
                      (!= (primitive/cast i64 (get src (load i))) 91))
            (set! i (+ (load i) 1)))
          (subslice src 1 (load i))))))

(defn cl-head [(f Code)] (-> (slice u8))
  (if (and (primitive/code-list? f)
           (not (primitive/code-vector? f))
           (> (len f) 0)
           (primitive/code-sym? (get f 0)))
      (primitive/code-sym (get f 0))
      ""))

;;; Is this `let*` node a `let` the author wrote?
(defn cl-written-let? [(f Code)] (-> bool)
  (and (= (cl-head f) "let*") (= (cl-written-head f) "let")))

;;; Every element of `f` from `from` on is the author's own node.
(defn cl-children-written? [(f Code) (from i64)] (-> bool)
  (let [(mut ok) true]
    (for child
      (iter (primitive/code-slice f from (len f)))
      (when (not (= (cl-head child) (cl-written-head child)))
        (when (not (= (cl-head child) "")) (set! ok false) 0)
        0))
    (load ok)))

;;; Can `f` be placed in a replacement and come back as the author's text? A rebuilt `let` is a new
;;; node, so ITS children print one by one: each must be the author's own, or the expansion of a
;;; nested `let` or `for` would be written out in its place. Such a chain is left alone.
(defn cl-faithful? [(f Code)] (-> bool)
  (or (= (cl-head f) "")
      (= (cl-head f) (cl-written-head f))
      (and (cl-written-let? f) (cl-children-written? f 2))))

;;; `f` as it should appear in a replacement.
(defn cl-restore [(f Code)] (-> Code)
  (if (cl-written-let? f) `(let ~@(primitive/code-slice f 1 (len f))) f))

;;; Every test and arm of the chain rooted at `f` can be restored faithfully.
(defn cl-chain-faithful? [(f Code)] (-> bool)
  (if (cl-hand-if? f)
      (and (cl-faithful? (get f 1))
           (cl-faithful? (get f 2))
           (cl-chain-faithful? (get f 3)))
      (cl-faithful? f)))

; The clause list `(t1 e1 t2 e2 … :else E)` for the chain rooted at `f`. The tests and
; bodies are the author's own nodes, pushed through untouched — which is what lets the
; renderer put their original source text back. Built with a growable Code list rather
; than `(… ~@(cl-clauses …)) — splicing the recursion's result rebuilds the suffix at
; every level (docs/design/META_MEMORY.md).
(defn cl-clauses-into [(f Code) (out CodeBuilder)] (-> CodeBuilder)
  (if (cl-hand-if? f)
      (do
        (primitive/code-list-push! out (cl-restore (get f 1)))
        (primitive/code-list-push! out (cl-restore (get f 2)))
        (cl-clauses-into (get f 3) out))
      (do
        (primitive/code-list-push! out `:else)
        (primitive/code-list-push! out (cl-restore f))
        out)))

(defn cl-clauses [(f Code)] (-> Code)
  (primitive/code-list-done (cl-clauses-into f (primitive/code-list-new))))

(defn cl-as-cond [(f Code)] (-> Code)
  `(cond ~@(cl-clauses f)))

; ---- the walk ---------------------------------------------------------------
; A chain is reported ONCE, at its outermost `if`. Its inner ifs are the same chain,
; so walking into them would report the same staircase again at every step; instead
; `cl-walk-chain` descends into each test and body, where a *different* chain may hide.
(defn cl-walk [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (and (>= (cl-chain-len f) (cl-min-tests)) (cl-chain-faithful? f))
          (do
            (primitive/suggest f
                               "3 or more nested ifs — write this as a cond"
                               (cl-as-cond f))
            (cl-walk-chain f))
          (do (for child (iter f) (cl-walk child)) `0))
      `0))

(defn cl-walk-chain [(f Code)] (-> Code)
  (if (cl-hand-if? f)
      (do
        (cl-walk (get f 1))
        (cl-walk (get f 2))
        (cl-walk-chain (get f 3)))
      (cl-walk f)))

;; ---- module scoping ---------------------------------------------------------
;; A module record is `(name form1 form2 …)`. Ask `code-from-user?` of EVERY form, not the first:
;; a module record also carries its `(import …)` forms, which originate in the import machinery
;; and answer false, so sampling one form would skip a user module whose first form is an import —
;; silently, since a checker that inspects nothing reports nothing.
(defn lint-nested-if [(modules Code)] (-> Code)
  (for m
    (iter modules)
    (for f
      (iter (primitive/code-slice m 1 (len m)))
      (when (primitive/code-from-user? f) (cl-walk f) 0)))
  `0)

;; The SYNTAX phase, not the default one: before expansion every `if` is hand-written, which is
;; why `cl-hand-if?`'s `code-macro?` test has nothing left to filter here. Even so, this phase hands
;; over some macro calls already expanded — see "an arm must come back as the author wrote it".
(checker lint-nested-if :phase before-expand)
