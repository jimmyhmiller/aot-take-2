;; Where the code has grown too large to read: functions and files over a line budget.

;;
;;   coil lint --use aot.lint.size
;;   coil lint --use aot.lint.size --lint-param aot.size.function=100 --lint-param aot.size.file=800
;;
;; This is a REPORT, not a gate, and it is deliberately not registered in Coil.toml: the project
;; carries zero lint warnings, and a dispatcher with one arm per syntax node is long for a reason a
;; line count cannot see. Run it to choose what to split next — `aot.refactor.split` for a file,
;; ordinary extraction for a function — not to make a number go down.
;;
;; A function's length is the lines of its form, signature and inner comments included. A method
;; inside an `impl` counts as a function. A file's length is the line its last form ends on. Test
;; files are skipped: a test file is a list of independent cases and its length says nothing.
;;
;; Defaults: 150 lines for a function, 1200 for a file.
(module aot.lint.size)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [subslice])
(import "coil.str" :use [str-parse-int])

(defn size-head? [(f Code) (head (slice u8))] (-> bool)
  (and (primitive/code-list? f)
       (not (primitive/code-vector? f))
       (> (len f) 0)
       (primitive/code-sym? (get f 0))
       (= (primitive/code-sym (get f 0)) head)))

(defn size-lines [(f Code)] (-> i64)
  (let [(mut n) 1]
    (for b
      (iter (primitive/code-src f))
      (when (= (primitive/cast i64 b) 10) (set! n (+ (load n) 1)) 0))
    (load n)))

(defn size-param [(key (slice u8)) (default i64)] (-> i64)
  (match (str-parse-int (primitive/lint-param key ""))
    (Some [v] v)
    (None [] default)))

(defn size-test-file? [(file (slice u8))] (-> bool)
  (let [suffix "-test.coil"]
    (and (>= (len file) (len suffix))
         (= (subslice file (- (len file) (len suffix)) (len file)) suffix))))

(defn size-check-function! [(f Code) (budget i64)] (-> i64)
  (let [lines (size-lines f)]
    (when (> lines budget)
      (println "  {} lines: {}"
               lines
               (if (and (> (len f) 1) (primitive/code-sym? (get f 1)))
                   (primitive/code-sym (get f 1))
                   (primitive/code-sym (get f 0))))
      (primitive/warn f
                      "function is over the line budget (length printed above)")
      0)
    0))

(defn lint-size [(modules Code)] (-> Code)
  (let [function-budget (size-param "aot.size.function" 150)
        file-budget (size-param "aot.size.file" 1200)]
    (for m
      (iter modules)
      (when (and (> (len m) 1)
                 (primitive/code-from-user? (get m 1))
                 (not (size-test-file? (primitive/code-file (get m 1)))))
        (let [(mut last-line) 0]
          (for f
            (iter (primitive/code-slice m 1 (len m)))
            (let [end (+ (primitive/code-line f) (- (size-lines f) 1))]
              (when (> end (load last-line)) (set! last-line end) 0))
            (cond (size-head? f "defn") (size-check-function! f function-budget)
                  (size-head? f "impl")
                    (do
                      (for method
                        (iter (primitive/code-slice f 1 (len f)))
                        (when (and (primitive/code-list? method)
                                   (not (primitive/code-vector? method)))
                          (size-check-function! method function-budget)
                          0))
                      0)
                  :else 0))
          (when (> (load last-line) file-budget)
            (println "  {} lines: {}"
                     (load last-line)
                     (primitive/code-file (get m 1)))
            (primitive/warn (get m 1)
                            "file is over the line budget (length printed above)")
            0))
        0))
    `0))

(checker lint-size :phase before-expand)
