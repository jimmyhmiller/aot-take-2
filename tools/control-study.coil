;; Measure the control-query scaling defect independently of JSL, allocation, and output I/O.

;; Final Simple RegionNode.idom folds CFGNode._idom over live predecessors; the unchanged
;; region-lca-path is that pairwise reference, including this project's dead-root semantics.
;; Both algorithms see the identical graph and warmed depth cache. No source program executes.
(module aot.tools.control-study)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.time" :use *)
(import "coil.print" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.node.constant" :use *)
(import "aot.type.type" :use *)
(import "aot.util.panic" :use *)

(defn control-study-now [] (-> i64)
  (try (try-or! (monotonic-now-ms)
                (do (panic "control-study: clock unavailable") 0))))

(defn control-study-size [(count i64)] (-> i64)
  (boot! 1)
  (let [(mut paths) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
        (mut ctrl) (cproj-make (start-make (ty-int-bot)) 0 "entry")
        merge (region-make)
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break 0)
              (let [arms
                      (if-arms! (if-make (load ctrl)
                                         (con-make (ty-int-range 0 1))))]
                (push! [(dyn NodeOps)] (mut paths) (arms-true arms))
                (region-add-path! merge (arms-true arms))
                (set! (mut ctrl) (arms-false arms))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (push! [(dyn NodeOps)] (mut paths) (load ctrl))
    (region-add-path! merge (load ctrl))
    (al-for [path (load paths)] (cfg-idepth-of path))
    (let [start (control-study-now)
          (mut reference) (None [(dyn NodeOps)])]
      (al-for [path (load paths)]
              (set! (mut reference) (region-lca-path path (load reference))))
      (let [old-ms (- (control-study-now) start)]
        (set! (.steps (region-lca-stats)) 0)
        (set! (.paths (region-lca-stats)) 0)
        (let [begin (control-study-now)
              answer (region-idom merge)
              new-ms (- (control-study-now) begin)]
          (match answer
            (Some [actual]
                  (match (load reference)
                    (Some [expected]
                          (if (n-same? actual expected)
                              0
                              (panic "control-study: dominators differ")))
                    (None []
                          (panic "control-study: missing reference dominator"))))
            (None [] (panic "control-study: missing dominator")))
          (println "CONTROL paths={} pairwise-ms={} covered-ms={} covered-steps={}"
                   (len (load paths))
                   old-ms
                   new-ms
                   (.steps (region-lca-stats)))
          0)))
    (al-free! (mut paths))
    0))

(defn main [] (-> i64)
  (control-study-size 500)
  (control-study-size 1000)
  (control-study-size 2000)
  (control-study-size 4000)
  0)
