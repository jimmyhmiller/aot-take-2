;; CLI client of the source-to-memory pipeline. No compiler, linker, or executable subprocess.

(module aot.tools.memory-run)
(import "coil.args" :as args)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.primitive" :as primitive)
(import "coil.print" :use *)
(import "aot.util.panic" :use *)
(import "aot.util.arena" :use [compiler-session-reset!])
(import "aot.codegen.pipeline" :use *)
(import "aot.codegen.image" :use *)
(import "aot.codegen.sourcecache" :use *)

;; Public retained-unit path, also usable with AOT_TIME for per-phase compilation diagnostics.
;; The ordinary closed-program mode remains available for semantic/performance comparisons.
(defn memory-run-retained! [(sources (ArrayList (slice u8)))] (-> i64)
  (let [a (alloc/malloc-allocator)
        cache (primitive/alloc-stack SourceCache)
        (mut unit) (al-new [(slice u8)] a)
        (mut selections) (al-new [SourceScriptSelection] a)]
    (set! cache (source-cache-new (len sources)))
    (al-for [source sources]
            (al-clear! (mut unit))
            (push! [(slice u8)] (mut unit) source)
            (let [handle (source-cache-acquire! cache (load unit) 1)]
              (push! [SourceScriptSelection]
                     (mut selections)
                     (SourceScriptSelection :handle handle :script 0))))
    (let [program (source-program-new cache (load selections) 1)]
      (al-for [selection (load selections)]
              (let [s selection] (source-cache-release! cache (.handle s))))
      (let [answer (source-program-run! program)]
        (source-program-free! program)
        (source-cache-free! cache)
        (al-free! (mut unit))
        (al-free! (mut selections))
        answer))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/args-set! argc argv)
  (if (< (args/args-count) 2)
      (panic "usage: memory-run [--retained] SCRIPT.js...")
      0)
  (let [a (alloc/malloc-allocator)
        retained (= (args/args-nth 1) "--retained")
        (mut sources) (al-new [(slice u8)] a)
        (mut i) (if retained 2 1)
        im (primitive/alloc-stack CodeImage)
        loaded (primitive/alloc-stack InstalledImage)]
    (if (>= (load i) (args/args-count))
        (panic "memory-run: missing Script input")
        0)
    (loop (if (>= (load i) (args/args-count))
              (break 0)
              (do
                (push! [(slice u8)]
                       (mut sources)
                       (try (try-or! (fs/read-file a (args/args-nth (load i)))
                                     (do
                                       (panic "memory-run: cannot read source")
                                       ""))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [answer
            (if retained
                (memory-run-retained! (load sources))
                (do
                  (compiler-session-reset!)
                  (pipeline-encode-sources! (load sources) 1 true)
                  (set! im (pipeline-capture-script-image))
                  (compiler-session-reset!)
                  (set! loaded (image-install im))
                  (let [answer (image-run! im loaded)]
                    (image-uninstall! loaded)
                    (image-free! im)
                    answer)))]
      (al-for [source (load sources)] (alloc/free [u8] a source))
      (al-free! (mut sources))
      answer)))
