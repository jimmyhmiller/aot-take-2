;; The graph verifier: one NAMED code per check.

;;
;; A tool is only a tool if it can FAIL. "The verifier returned non-zero" is satisfied by a
;; verifier that always fails; "corrupting the phi/region lockstep reports VERR-PHI-ARITY" is a
;; claim about a specific check noticing a specific corruption. So every check has a name, and the
;; test for each check corrupts a graph in exactly that way and demands exactly that code.
;;
;; What the verifier CANNOT see is as important as what it can, and is written down here so that
;; nobody mistakes a green verifier for a correct graph:
;;
;;   - A graph missing an arm is still a structurally valid graph.
;;   - A dropped Return leaves Stop with fewer inputs and no rule broken.
;;   - A discharged-but-wrong type check leaves nothing behind to inspect.
;;
;; Those are the interpreter's job (`aot.eval`), which is why the differential oracle exists and
;; why "the verifier is clean" is never accepted as evidence that a pass is correct.
;;
;; STATUS: edge multiplicity, dead inputs, Phi arity, type direction and GVN freshness are live.
;; Pointer, control-placement, safepoint and unreachable-use checks land with the node families whose
;; invariants they inspect; a verifier must not pretend to validate structures that do not exist.
(module aot.verify)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.node.gc" :use *)
(import "aot.type.type" :use *)

(const VERR-OK 0)

(const VERR-EDGE-ASYMMETRIC 1)  ; a use-def edge with no matching def-use edge, or the reverse

(const VERR-PHI-ARITY 2)  ; a Phi's value count disagrees with its Region's path count

(const VERR-DEAD-INPUT 3)  ; a killed node is wired as somebody's input

(const VERR-PTR-SLOT 4)  ; a memory access whose pointer is not provably an object

(const VERR-TYPE-NOT-MONOTONE 5)  ; a type moved the wrong way up the lattice

(const VERR-CTRL-SHAPE 6)  ; a control node in a position control may not occupy

(const VERR-GVN-STALE 7)  ; a node in the GVN table whose edges were mutated

(const VERR-SAFEPOINT-R1 8)  ; an interior pointer live across a safepoint

(const VERR-SAFEPOINT-R2 9)  ; a use after a safepoint reading the un-relocated reference

(const VERR-UNREACHABLE-USE 10)  ; a live use in a block proven unreachable

;; Verify the whole graph. Returns VERR-OK or the first failing code.
(defn verify-all [] (-> i64)
  (let [cnt (arena-node-count)
        (mut i) 1
        (mut answer) VERR-OK]
    ;; Computing types during verification must not register dependencies or perturb worklists.
    (set-mid-assert! true)
    (loop (if (or (> (load i) cnt) (!= (load answer) VERR-OK))
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (n-dead? n)
                            0
                            (set! (mut answer) (verify-node n))))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set-mid-assert! false)
    (load answer)))

;; Verify one node in isolation, for use inside a peephole assert.
(defn verify-node [(n (dyn NodeOps))] (-> i64)
  (let [ins (n-nins n)
        outs (n-nouts n)
        (mut i) 0
        (mut answer) VERR-OK]
    ;; Every use-def edge has the same multiplicity in the producer's def-use list. Duplicate
    ;; operands are distinct edges and must therefore be counted, not merely found.
    (loop (if (or (>= (load i) ins) (!= (load answer) VERR-OK))
              (break 0)
              (do
                (match (n-in n (load i))
                  (Some [input]
                        (if (n-dead? input)
                            (set! (mut answer) VERR-DEAD-INPUT)
                            (if (!= (verify--input-count n input) (verify--output-count input n))
                                (set! (mut answer) VERR-EDGE-ASYMMETRIC)
                                0)))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (or (>= (load i) outs) (!= (load answer) VERR-OK))
              (break 0)
              (do
                (match (n-out n (load i))
                  (Some [use]
                        (if (!= (verify--input-count use n) (verify--output-count n use))
                            (set! (mut answer) VERR-EDGE-ASYMMETRIC)
                            0))
                  ;; None in outputs is a keep, not an edge.
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (!= (load answer) VERR-OK)
        (load answer)
        (if (= (n-op n) OP-SAFEPOINT)
            (verify--safepoint n)
            (if (or (= (n-op n) OP-PHI) (= (n-op n) OP-MEMPHI) (= (n-op n) OP-PARM))
            (match (n-in n 0)
              (Some [region]
                    (if (= (n-nins n) (n-nins region))
                        (verify--type-and-gvn n)
                        VERR-PHI-ARITY))
              (None [] VERR-PHI-ARITY))
              (verify--type-and-gvn n))))))

(defn verify--safepoint-projection? [(sp (dyn NodeOps)) (slot i64)] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) (n-nouts sp)) (load found))
              (break 0)
              (do
                (match (n-out sp (load i))
                  (Some [use]
                        (if (and (= (n-op use) OP-PROJ) (= (proj-idx use) slot))
                            (set! (mut found) true)
                            0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

(defn verify--safepoint [(sp (dyn NodeOps))] (-> i64)
  (if (or (< (n-nins sp) SAFEPOINT-LIVE)
          (not (ty-tuple? (n-ty sp)))
          (!= (ty-tuple-len (n-ty sp)) (n-nins sp)))
      VERR-SAFEPOINT-R2
      (let [(mut slot) SAFEPOINT-LIVE (mut answer) VERR-OK]
        (loop (if (or (>= (load slot) (n-nins sp)) (!= (load answer) VERR-OK))
                  (break 0)
                  (match (n-in sp (load slot))
                    (Some [live]
                          (let [t (n-ty live)]
                            (if (not (or (ty-memptr? t) (ty-dyn? t)))
                                (set! (mut answer) VERR-SAFEPOINT-R1)
                                (if (not (verify--safepoint-projection? sp (load slot)))
                                    (set! (mut answer) VERR-SAFEPOINT-R2)
                                    (do
                                      (set! (mut slot) (+ (load slot) 1))
                                      (continue))))))
                    (None [] (set! (mut answer) VERR-SAFEPOINT-R2)))))
        (if (!= (load answer) VERR-OK) (load answer) (verify--type-and-gvn sp)))))

(defn verify--type-and-gvn [(n (dyn NodeOps))] (-> i64)
  (if (and (!= (n-ty n) TY-INVALID) (not (ty-isa? (compute n) (n-ty n))))
      VERR-TYPE-NOT-MONOTONE
      (if (and (!= (n-hash-of n) 0) (!= (n-hash-of n) (n-gvn-hash-current n)))
          VERR-GVN-STALE
          VERR-OK)))

(defn verify--input-count [(use (dyn NodeOps)) (def (dyn NodeOps))] (-> i64)
  (let [cnt (n-nins use)
        (mut i) 0
        (mut found) 0]
    (loop (if (>= (load i) cnt)
              (break 0)
              (do
                (match (n-in use (load i))
                  (Some [x]
                        (if (n-same? x def) (set! (mut found) (+ (load found) 1)) 0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

(defn verify--output-count [(def (dyn NodeOps)) (use (dyn NodeOps))] (-> i64)
  (let [cnt (n-nouts def)
        (mut i) 0
        (mut found) 0]
    (loop (if (>= (load i) cnt)
              (break 0)
              (do
                (match (n-out def (load i))
                  (Some [x]
                        (if (n-same? x use) (set! (mut found) (+ (load found) 1)) 0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; The human-readable name of a code, so a failure reads as a sentence rather than a number.
(defn verr-name [(code i64)] (-> (slice u8))
  (if (= code VERR-OK)
      "ok"
      (if (= code VERR-EDGE-ASYMMETRIC)
          "edge-asymmetric"
          (if (= code VERR-PHI-ARITY)
              "phi-arity"
              (if (= code VERR-DEAD-INPUT)
                  "dead-input"
                  (if (= code VERR-PTR-SLOT)
                      "pointer-slot"
                      (if (= code VERR-TYPE-NOT-MONOTONE)
                          "type-not-monotone"
                          (if (= code VERR-CTRL-SHAPE)
                              "control-shape"
                              (if (= code VERR-GVN-STALE)
                                  "gvn-stale"
                                  (if (= code VERR-SAFEPOINT-R1)
                                      "safepoint-r1"
                                      (if (= code VERR-SAFEPOINT-R2)
                                          "safepoint-r2"
                                          (if (= code VERR-UNREACHABLE-USE)
                                              "unreachable-use"
                                              "unknown-verifier-code"))))))))))))
