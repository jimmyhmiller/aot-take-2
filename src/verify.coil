;; The graph verifier: one NAMED code per check.

;;
;; A tool is only a tool if it can FAIL. "The verifier returned non-zero" is satisfied by a
;; verifier that always fails; "corrupting the phi/region lockstep reports VERR-PHI-ARITY" is a
;; claim about a specific check noticing a specific corruption. So every check has a name, and the
;; test for each check corrupts a graph in exactly that way and demands exactly that code.
;;
;; What the verifier CANNOT see is as important as what it can, and is written down here so that
;; nobody mistakes a green verifier for a correct graph:
;;
;;   - A graph missing an arm is still a structurally valid graph.
;;   - A dropped Return leaves Stop with fewer inputs and no rule broken.
;;   - A discharged-but-wrong type check leaves nothing behind to inspect.
;;
;; Those are the interpreter's job (`aot.eval`), which is why the differential oracle exists and
;; why "the verifier is clean" is never accepted as evidence that a pass is correct.
;;
;; SCAFFOLD: the codes are final; bodies hard-error. Filled in alongside each pass.
(module aot.verify)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(const VERR-OK 0)

(const VERR-EDGE-ASYMMETRIC 1)  ; a use-def edge with no matching def-use edge, or the reverse

(const VERR-PHI-ARITY 2)  ; a Phi's value count disagrees with its Region's path count

(const VERR-DEAD-INPUT 3)  ; a killed node is wired as somebody's input

(const VERR-PTR-SLOT 4)  ; a memory access whose pointer is not provably an object

(const VERR-TYPE-NOT-MONOTONE 5)  ; a type moved the wrong way up the lattice

(const VERR-CTRL-SHAPE 6)  ; a control node in a position control may not occupy

(const VERR-GVN-STALE 7)  ; a node in the GVN table whose edges were mutated

(const VERR-SAFEPOINT-R1 8)  ; an interior pointer live across a safepoint

(const VERR-SAFEPOINT-R2 9)  ; a use after a safepoint reading the un-relocated reference

(const VERR-UNREACHABLE-USE 10)  ; a live use in a block proven unreachable

;; Verify the whole graph. Returns VERR-OK or the first failing code.
(defn verify-all [] (-> i64)
  (do (unimplemented "verify-all" "src/verify.coil — grows with each pass") VERR-OK))

;; Verify one node in isolation, for use inside a peephole assert.
(defn verify-node [(n (dyn NodeOps))] (-> i64)
  (do (unimplemented "verify-node" "src/verify.coil — grows with each pass") VERR-OK))

;; The human-readable name of a code, so a failure reads as a sentence rather than a number.
(defn verr-name [(code i64)] (-> (slice u8))
  (do (unimplemented "verr-name" "src/verify.coil") ""))
