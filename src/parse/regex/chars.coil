;; Whether units[lo, hi) spells one whole entry of `table`.
(defn rx-table-has? [(table (slice u8)) (lo i64) (hi i64)] (-> bool)
  (let [n (- hi lo)
        size (len table)
        (mut i) 0
        (mut found) false]
    (if (<= n 0)
        false
        (do
          (loop (if (or (load found) (>= (+ (load i) (+ n 1)) size))
                    (break 0)
                    (do
                      (if (and (rx-separator? (cast i64 (get table (load i))))
                               (rx-separator? (cast i64
                                                    (get table
                                                         (+ (load i) (+ n 1))))))
                          (let [(mut k) 0
                                (mut same) true]
                            (loop (if (or (not (load same)) (>= (load k) n))
                                      (break 0)
                                      (do
                                        (if (!= (cast i64
                                                      (get table
                                                           (+ (load i)
                                                              (+ (load k) 1))))
                                                (rx-unit-at (+ lo (load k))))
                                            (set! (mut same) false)
                                            0)
                                        (set! (mut k) (+ (load k) 1))
                                        (continue))))
                            (if (load same) (set! (mut found) true) 0))
                          0)
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (load found)))))

(defn rx-separator? [(c i64)] (-> bool)
  (or (= c RX-SPACE) (= c RX-LF)))

(defn rx-span-is? [(lo i64) (hi i64) (text (slice u8))] (-> bool)
  (if (!= (- hi lo) (len text))
      false
      (let [(mut k) 0
            (mut same) true]
        (loop (if (or (not (load same)) (>= (load k) (len text)))
                  (break 0)
                  (do
                    (if (!= (rx-unit-at (+ lo (load k)))
                            (cast i64 (get text (load k))))
                        (set! (mut same) false)
                        0)
                    (set! (mut k) (+ (load k) 1))
                    (continue))))
        (load same))))
