;; Character classes: legacy classes, and v-mode class sets with their operands and string disjunctions.

(module aot.parse.regex.class)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.parse.regex"
        :use
        [rx-state
         rx-error!
         rx-failed?
         rx-peek
         rx-peek-at
         rx-advance!
         rx-advance-by!
         rx-take-is?
         rx-legacy-octal!
         rx-character-escape!
         rx-identity-escape!
         rx-property!])
(import "aot.parse.regex.chars" :use *)

;; ---------------------------------------------------------------------------
;; Character classes (`u` and web-compat grammars)

;; ClassAtom: a character value, RX-CLASS-ESCAPE for `\d`-style escapes.
(defn rx-class-atom! [] (-> i64)
  (let [st (rx-state)
        c (rx-peek)]
    (if (!= c RX-BACKSLASH)
        (do (rx-advance!) c)
        (let [e (rx-peek-at 1)]
          (rx-advance!)
          (cond (= e RX-EOF) (do (rx-error! "regex: \\ at end of pattern") 0)
                (= e RX-LOWER-B) (do (rx-advance!) RX-BACKSPACE)
                (= e RX-MINUS) (do (rx-advance!) RX-MINUS)
                (or (= e RX-LOWER-D)
                    (= e RX-UPPER-D)
                    (= e RX-LOWER-S)
                    (= e RX-UPPER-S)
                    (= e RX-LOWER-W)
                    (= e RX-UPPER-W))
                  (do (rx-advance!) RX-CLASS-ESCAPE)
                (and (or (= e RX-LOWER-P) (= e RX-UPPER-P))
                     (.unicode st))
                  (do
                    (rx-advance!)
                    (rx-property! (= e RX-UPPER-P))
                    RX-CLASS-ESCAPE)
                (and (rx-digit? e) (!= e RX-ZERO))
                  (if (.unicode st)
                      (do
                        (rx-error! "regex: invalid class escape")
                        0)
                      (if (rx-octal? e)
                          (rx-legacy-octal!)
                          (do (rx-advance!) e)))
                (= e RX-LOWER-K)
                  (if (or (.unicode st) (.named st))
                      (do
                        (rx-error! "regex: invalid class escape")
                        0)
                      (do (rx-advance!) e))
                :else
                  (let [v (rx-character-escape! e true)]
                    (if (= v RX-INVALID)
                        (rx-identity-escape! e)
                        v)))))))

;; NonemptyClassRanges: atoms and `a-b` ranges until `]`. Class escapes may not bound a range in the
;; strict grammar; web-compat reads such a `-` literally.
(defn rx-class! [] (-> i64)
  (let [st (rx-state)]
    (rx-advance!)
    (rx-take-is? RX-CARET)
    (loop (if (rx-failed?)
              (break 0)
              (let [c (rx-peek)]
                (if (= c RX-RBRACKET)
                    (break (do (rx-advance!) 0))
                    (if (= c RX-EOF)
                        (break (rx-error! "regex: unterminated character class"))
                        (let [a (rx-class-atom!)]
                          (if (and (not (rx-failed?))
                                   (= (rx-peek) RX-MINUS)
                                   (!= (rx-peek-at 1) RX-RBRACKET)
                                   (!= (rx-peek-at 1) RX-EOF))
                              (do
                                (rx-advance!)
                                (let [b (rx-class-atom!)]
                                  (if (or (= a RX-CLASS-ESCAPE)
                                          (= b RX-CLASS-ESCAPE))
                                      (if (.unicode st)
                                          (rx-error! "regex: class escape in character range")
                                          0)
                                      (if (> a b)
                                          (rx-error! "regex: character range out of order")
                                          0))))
                              0)
                          (continue)))))))
    0))

;; ---------------------------------------------------------------------------
;; ClassSetExpressions (`v` grammar)

;; ClassSetCharacter at the current position, or RX-INVALID (nothing consumed) when the next thing
;; is a nested class, `\q{…}`, a class escape or a property escape.
(defn rx-class-set-character! [] (-> i64)
  (let [c (rx-peek)]
    (cond (= c RX-BACKSLASH)
            (let [e (rx-peek-at 1)]
              (if (or (= e RX-LOWER-D)
                      (= e RX-UPPER-D)
                      (= e RX-LOWER-S)
                      (= e RX-UPPER-S)
                      (= e RX-LOWER-W)
                      (= e RX-UPPER-W)
                      (= e RX-LOWER-P)
                      (= e RX-UPPER-P)
                      (= e RX-LOWER-Q))
                  RX-INVALID
                  (do
                    (rx-advance!)
                    (cond (= e RX-EOF)
                            (do (rx-error! "regex: \\ at end of pattern") 0)
                          (= e RX-LOWER-B) (do (rx-advance!) RX-BACKSPACE)
                          (rx-class-set-reserved-punct? e) (do (rx-advance!) e)
                          :else
                            (let [v (rx-character-escape! e true)]
                              (if (= v RX-INVALID)
                                  (rx-identity-escape! e)
                                  v))))))
          (or (= c RX-LBRACKET) (= c RX-EOF)) RX-INVALID
          (rx-class-set-syntax-char? c)
            (do (rx-error! "regex: unescaped class set syntax character") 0)
          (rx-at-double-punct?)
            (do
              (rx-error! "regex: reserved double punctuator in class set")
              0)
          :else (do (rx-advance!) c))))

;; ClassStringDisjunction `\q{a|bc|}`; strings unless every alternative is exactly one character.
(defn rx-class-string-disjunction! [] (-> bool)
  (do
    (rx-advance-by! 2)
    (if (not (rx-take-is? RX-LBRACE))
        (do (rx-error! "regex: \\q requires braces") false)
        (let [(mut strings) false
              (mut count) 0]
          (loop (if (rx-failed?)
                    (break 0)
                    (let [c (rx-peek)]
                      (if (or (= c RX-RBRACE) (= c RX-BAR))
                          (do
                            (rx-advance!)
                            (if (!= (load count) 1) (set! (mut strings) true) 0)
                            (set! (mut count) 0)
                            (if (= c RX-RBRACE) (break 0) (continue)))
                          (if (= c RX-EOF)
                              (break (rx-error! "regex: unterminated \\q string"))
                              (let [v (rx-class-set-character!)]
                                (if (= v RX-INVALID)
                                    (break (rx-error! "regex: invalid character in \\q string"))
                                    (do
                                      (set! (mut count) (+ (load count) 1))
                                      (continue)))))))))
          (load strings)))))

;; ClassSetOperand, plus a ClassSetRange when the union grammar allows one. Returns MayContainStrings.
(defn rx-class-set-operand! [(allow-range bool)] (-> bool)
  (let [st (rx-state)
        c (rx-peek)]
    (cond (= c RX-LBRACKET) (rx-class-set!)
          (and (= c RX-BACKSLASH) (= (rx-peek-at 1) RX-LOWER-Q))
            (rx-class-string-disjunction!)
          (and (= c RX-BACKSLASH)
               (or (= (rx-peek-at 1) RX-LOWER-D)
                   (= (rx-peek-at 1) RX-UPPER-D)
                   (= (rx-peek-at 1) RX-LOWER-S)
                   (= (rx-peek-at 1) RX-UPPER-S)
                   (= (rx-peek-at 1) RX-LOWER-W)
                   (= (rx-peek-at 1) RX-UPPER-W)))
            (do (rx-advance-by! 2) false)
          (and (= c RX-BACKSLASH)
               (or (= (rx-peek-at 1) RX-LOWER-P)
                   (= (rx-peek-at 1) RX-UPPER-P)))
            (let [negated (= (rx-peek-at 1) RX-UPPER-P)]
              (rx-advance-by! 2)
              (rx-property! negated))
          :else
            (let [a (rx-class-set-character!)]
              (if (rx-failed?)
                  false
                  (if (= a RX-INVALID)
                      (do
                        (rx-error! "regex: expected a class set operand")
                        false)
                      (do
                        (if (and allow-range
                                 (= (rx-peek) RX-MINUS)
                                 (!= (rx-peek-at 1) RX-MINUS))
                            (do
                              (rx-advance!)
                              (let [b (rx-class-set-character!)]
                                (cond (rx-failed?) 0
                                      (= b RX-INVALID)
                                        (rx-error! "regex: invalid class set range end")
                                      (> a b)
                                        (rx-error! "regex: character range out of order")
                                      :else 0)))
                            0)
                        false)))))))

;; `[` `^`? ClassContents `]` under the `v` grammar. Returns MayContainStrings of the class.
(defn rx-class-set! [] (-> bool)
  (let [st (rx-state)]
    (rx-advance!)
    (let [negated (rx-take-is? RX-CARET)]
      (if (rx-take-is? RX-RBRACKET)
          false
          (let [(mut strings) (rx-class-set-operand! true)
                mode
                  (cond (rx-failed?) SET-UNION
                        (and (= (rx-peek) RX-AMP) (= (rx-peek-at 1) RX-AMP))
                          SET-INTERSECTION
                        (and (= (rx-peek) RX-MINUS)
                             (= (rx-peek-at 1) RX-MINUS))
                          SET-SUBTRACTION
                        :else SET-UNION)]
            (loop (if (rx-failed?)
                      (break 0)
                      (let [c (rx-peek)]
                        (cond (= c RX-RBRACKET) (break (do (rx-advance!) 0))
                              (= c RX-EOF)
                                (break (rx-error! "regex: unterminated character class"))
                              (= mode SET-UNION)
                                (if (or (and (= c RX-AMP)
                                             (= (rx-peek-at 1) RX-AMP))
                                        (and (= c RX-MINUS)
                                             (= (rx-peek-at 1) RX-MINUS)))
                                    (break (rx-error! "regex: class set operator inside a union"))
                                    (do
                                      (if (rx-class-set-operand! true)
                                          (set! (mut strings) true)
                                          0)
                                      (continue)))
                              :else
                                (let [op
                                        (if (= mode SET-INTERSECTION)
                                            RX-AMP
                                            RX-MINUS)]
                                  (if (not (and (= c op)
                                                (= (rx-peek-at 1) op)))
                                      (break (rx-error! "regex: mixed class set operators"))
                                      (do
                                        (rx-advance-by! 2)
                                        (if (= (rx-peek) op)
                                            (break (rx-error! "regex: reserved double punctuator in class set"))
                                            (let [s
                                                    (rx-class-set-operand! false)]
                                              (if (= mode SET-INTERSECTION)
                                                  (set! (mut strings)
                                                        (and (load strings)
                                                             s))
                                                  0)
                                              (continue))))))))))
            (if (and (not (rx-failed?)) negated (load strings))
                (rx-error! "regex: negated class may contain strings")
                0)
            (if negated false (load strings)))))))
