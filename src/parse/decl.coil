;; Declarations: hoisting, binding resolution, and module records.

;;
;; JavaScript's scoping is three overlapping systems and they must be resolved before the graph is
;; built, because the graph has no notion of a name:
;;
;;   `var`                function-scoped, hoisted, initialised to undefined
;;   `let`/`const`        block-scoped, hoisted into a TEMPORAL DEAD ZONE — a read before the
;;                        declaration is a runtime error, not undefined, so the TDZ is real control
;;                        flow and not merely a static check
;;   function declarations hoisted whole, including their bodies
;;
;; MODULES ARE PART OF THE CLOSED WORLD. Every import must resolve to a module in the compilation
;; unit set; an unresolvable one is a hard error rather than a fallback to a dynamic lookup,
;; because a silent fallback would leave every guard folded on evidence that no longer holds.
;; `import()` of a value known only at runtime is refused BY NAME — see CLAUDE.md.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S2.
(module aot.parse.decl)
(import "aot.util.panic" :use *)

(defn decl-hoist! [] (-> i64)
  (do (unimplemented "decl-hoist!" "S2 — src/parse/decl.coil") 0))

(defn decl-resolve! [] (-> i64)
  (do (unimplemented "decl-resolve!" "S2 — src/parse/decl.coil") 0))

(defn decl-module-record [(specifier (slice u8))] (-> i64)
  (do (unimplemented "decl-module-record" "S2 — src/parse/decl.coil") 0))
