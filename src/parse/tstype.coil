;; TypeScript annotation syntax, parsed into OUR lattice.

;;
;; There is ONE type system in this compiler. A TypeScript annotation is not a second one; it is
;; surface syntax for a point in the lattice `aot.type.type` already defines:
;;
;;   number     the int-or-double tags on the dynamic axis
;;   string     the string tag
;;   boolean    the bool tag
;;   null/undef their own tags — kept apart, because JavaScript keeps them apart
;;   T | U      a meet on the tag axis: literally the union of two tag sets
;;   interface  a shape set
;;   T[]        an array with an element type
;;   any        the full tag set: no information, and therefore no guard folded
;;   unknown    the full tag set that additionally refuses to be used without a narrowing
;;
;; TYPESCRIPT IS UNSOUND AND THIS FILE DOES NOT PRETEND OTHERWISE. Bivariant parameters, `any`,
;; unchecked casts and covariant mutable arrays all mean an annotation can be false at runtime on
;; legal TypeScript. So an annotation becomes a DECLARED type and nothing more; whether the guard
;; folds is decided by the interprocedural fixpoint, not here.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S2.
(module aot.parse.tstype)
(import "aot.util.panic" :use *)

;; Parse an annotation and return the interned lattice point it denotes.
(defn tstype-parse [] (-> i64)
  (do (unimplemented "tstype-parse" "S2 — src/parse/tstype.coil") 0))

;; Does this annotation carry any information at all? `any` does not, and a guard on it can never
;; fold, so it is worth asking directly rather than discovering it later.
(defn tstype-informative? [(t i64)] (-> bool)
  (do (unimplemented "tstype-informative?" "S2 — src/parse/tstype.coil") false))
