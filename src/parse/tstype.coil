;; TypeScript annotation syntax, parsed into OUR lattice.

;;
;; There is ONE type system in this compiler. A TypeScript annotation is not a second one; it is
;; surface syntax for a point in the lattice `aot.type.type` already defines:
;;
;;   number     the int-or-double tags on the dynamic axis
;;   string     the string tag
;;   boolean    the bool tag
;;   null/undef their own tags — kept apart, because JavaScript keeps them apart
;;   T | U      a meet on the tag axis: literally the union of two tag sets
;;   never      global TOP, the empty union (not an optimistic dynamic tag set)
;;   any        the full tag set: no information, and therefore no guard folded
;;   unknown    the full tag set; use-site diagnostics are not implemented yet
;;
;; TYPESCRIPT IS UNSOUND AND THIS FILE DOES NOT PRETEND OTHERWISE. Bivariant parameters, `any`,
;; unchecked casts and covariant mutable arrays all mean an annotation can be false at runtime on
;; legal TypeScript. So an annotation becomes a DECLARED type and nothing more; whether the guard
;; folds is decided by the interprocedural fixpoint, not here.
;;
;; Final Simple Parser.type first resolves the base spelling, then accumulates array/nullability
;; suffixes and rejects illegal combinations. Its declared types constrain a sound language.
;; Here primitive names and parenthesized unions map to the existing dynamic-tag lattice; array,
;; structural, generic, literal and function types are not yet admitted. These annotations are
;; retained as evidence in syntax records, never installed as the type of a runtime Parm or Phi.
;; In particular `void` describes a discarded result and does not prove an undefined payload.
(module aot.parse.tstype)
(import "aot.util.panic" :use *)
(import "aot.parse.lexer" :use *)
(import "aot.type.type" :use *)

(defn tstype-primary [] (-> i64)
  (let [t (lex-next! false)]
    (if (token-is t "(")
        (let [inner (tstype-parse)
              close (lex-next! false)]
          (if (not (token-is close ")"))
              (panic-i "tstype: expected closing parenthesis at byte" (.start close)) 0)
          inner)
        (let [name (token-text t)]
          (if (= name "number") (ty-dyn TAG-NUMBER)
              (if (= name "string") (ty-dyn TAG-STRING)
                  (if (= name "boolean") (ty-dyn TAG-BOOL)
                      (if (= name "null") (ty-dyn TAG-NULL)
                          (if (= name "undefined") (ty-dyn TAG-UNDEFINED)
                              (if (= name "object") (ty-dyn (+ TAG-OBJECT TAG-FUNCTION))
                                  (if (= name "never") TY-TOP
                                      (if (or (= name "any") (= name "unknown") (= name "void"))
                                          (ty-dyn TAG-ANY)
                                          (do
                                            (unimplemented "tstype: annotation outside primitive/union grammar"
                                                           "docs/GAPS.md — TypeScript evidence")
                                            TY-INVALID)))))))))))))

;; Parse an annotation and return the interned lattice point it denotes.
(defn tstype-parse [] (-> i64)
  (let [(mut answer) (tstype-primary)]
    (loop (if (token-is (lex-peek false) "|")
              (do
                (lex-next! false)
                (set! (mut answer) (ty-meet (load answer) (tstype-primary)))
                (continue))
              (break 0)))
    (load answer)))

;; Does this annotation carry any information at all? `any` does not, and a guard on it can never
;; fold, so it is worth asking directly rather than discovering it later.
(defn tstype-informative? [(t i64)] (-> bool)
  (!= t (ty-dyn TAG-ANY)))
