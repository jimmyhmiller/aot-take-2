;; Regular-expression pattern early errors (ECMA-262 §22.2.1 Patterns, B.1.2 web-compat grammar).

;;
;; A regular-expression literal's body is checked here at parse time, not at RegExp construction:
;; every violation of the Pattern grammar is an early SyntaxError of the enclosing Script or
;; Module. The validator reads the pattern as code points (`u` or `v` flag) or as UTF-16 code units
;; (neither flag), because the grammar counts surrogate halves as separate characters only in the
;; second case.
;;
;; Three grammars share one recursive descent, selected by the flags:
;;
;; - Neither `u` nor `v`: Annex B's extended grammar. `]`, `{` and `}` are literal where they cannot
;;   be a quantifier; a braced quantifier with nothing to repeat is still an error; `\` before an
;;   unrecognised character is an identity escape; `\N` beyond the group count is a legacy octal
;;   escape; `\c` not followed by a letter is a literal backslash; lookaheads may be quantified;
;;   class ranges may use `\d`-style escapes as endpoints.
;; - `u`: the strict grammar. Identity escapes are SyntaxCharacters and `/` only, `\u{…}` and
;;   surrogate-pair escapes are single code points, lone brackets are errors, lookaheads are not
;;   quantifiable, and `\p{…}` property escapes are validated against the Unicode tables below.
;; - `v`: the strict grammar with ClassSetExpressions: nested classes, `&&` and `--` operators,
;;   `\q{…}` string alternatives, reserved double punctuators, and the rule that a negated class or
;;   a `\P` escape may not match strings.
;;
;; Named groups (`(?<name>…)`, `\k<name>`) switch on the N grammar in every mode: `\k` must name a
;; group, `\N` must be a real backreference, and two groups may share a name only when they can
;; never both participate in a match (they sit in different alternatives of one disjunction).
;;
;; Verdicts are returned, never raised: the parser owns error reporting. `RegexUnknown` names a
;; classification this validator cannot make yet (a non-ASCII code point whose ID_Start or
;; ID_Continue status decides a group name) so the caller fails closed instead of guessing.
;;
;; The property tables list the exact spellings ECMA-262 admits (Table 68 binary properties,
;; General_Category, Script and Script_Extensions values with their aliases, and the `v`-mode
;; properties of strings) for Unicode 17.0.0, the version test262 revision 419d3e0a generates its
;; property-escape tests from. Matching is exact: no case folding, no whitespace, no `Is`/`In`
;; prefixes.
(module aot.parse.regex)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.parse.regex.chars" :use * :reexport)
(import "aot.parse.regex.class" :use * :reexport)

;; ---------------------------------------------------------------------------
;; Verdicts
(defsum RegexVerdict
  (RegexOk)
  (RegexError [(message (slice u8))])
  (RegexUnknown [(message (slice u8))]))

;; ---------------------------------------------------------------------------
;; State
(defstruct RegexDecl [(lo i64) (hi i64) (path-lo i64) (path-hi i64)])

(defstruct RegexRef [(lo i64) (hi i64)])

(defstruct RegexState
  [(units (ArrayList i64))
   (pos i64)
   (unicode bool)  ; `u` or `v`
   (sets bool)  ; `v`
   (named bool)  ; the pattern contains a GroupSpecifier
   (group-count i64)  ; CountLeftCapturingParensWithin(Pattern)
   (disj-counter i64)
   (path (ArrayList i64))  ; (disjunction id, alternative index) pairs of the open disjunctions
   (path-pool (ArrayList i64))
   (name-pool (ArrayList i64))
   (decls (ArrayList RegexDecl))
   (refs (ArrayList RegexRef))
   (error (Option (slice u8)))
   (unknown (Option (slice u8)))
   (initialized bool)])

(defn rx-state [] (-> (ptr RegexState))
  (compiler-state [RegexState] (primitive/alloc-static CompilerStateSlot)))

(defn rx-reset! [(unicode bool) (sets bool)] (-> i64)
  (let [st (rx-state)]
    (if (.initialized st)
        (do
          (al-clear! [i64] (mut (.units st)))
          (al-clear! [i64] (mut (.path st)))
          (al-clear! [i64] (mut (.path-pool st)))
          (al-clear! [i64] (mut (.name-pool st)))
          (al-clear! [RegexDecl] (mut (.decls st)))
          (al-clear! [RegexRef] (mut (.refs st)))
          0)
        (do
          (set! (.units st) (al-new [i64] (compiler-allocator)))
          (set! (.path st) (al-new [i64] (compiler-allocator)))
          (set! (.path-pool st) (al-new [i64] (compiler-allocator)))
          (set! (.name-pool st) (al-new [i64] (compiler-allocator)))
          (set! (.decls st) (al-new [RegexDecl] (compiler-allocator)))
          (set! (.refs st) (al-new [RegexRef] (compiler-allocator)))
          (set! (.initialized st) true)
          0))
    (set! (.pos st) 0)
    (set! (.unicode st) unicode)
    (set! (.sets st) sets)
    (set! (.named st) false)
    (set! (.group-count st) 0)
    (set! (.disj-counter st) 0)
    (set! (.error st) (None [(slice u8)]))
    (set! (.unknown st) (None [(slice u8)]))
    0))

;; The first error wins; later ones are consequences of the same fault.
(defn rx-error! [(message (slice u8))] (-> i64)
  (let [st (rx-state)]
    (match (.error st)
      (None [] (set! (.error st) (Some message)))
      (Some [m] 0))
    0))

(defn rx-unknown! [(message (slice u8))] (-> i64)
  (let [st (rx-state)]
    (match (.unknown st)
      (None [] (set! (.unknown st) (Some message)))
      (Some [m] 0))
    0))

(defn rx-failed? [] (-> bool)
  (let [st (rx-state)]
    (or (match (.error st) (Some [m] true) (None [] false))
        (match (.unknown st) (Some [m] true) (None [] false)))))

(defn rx-len [] (-> i64)
  (len (.units (rx-state))))

(defn rx-unit-at [(i i64)] (-> i64)
  (if (or (< i 0) (>= i (rx-len))) RX-EOF (get (.units (rx-state)) i)))

(defn rx-peek [] (-> i64)
  (rx-unit-at (.pos (rx-state))))

(defn rx-peek-at [(k i64)] (-> i64)
  (rx-unit-at (+ (.pos (rx-state)) k)))

(defn rx-advance! [] (-> i64)
  (let [st (rx-state)]
    (set! (.pos st) (+ (.pos st) 1))
    0))

(defn rx-advance-by! [(k i64)] (-> i64)
  (let [st (rx-state)]
    (set! (.pos st) (+ (.pos st) k))
    0))

(defn rx-at-end? [] (-> bool)
  (>= (.pos (rx-state)) (rx-len)))

(defn rx-take-is? [(c i64)] (-> bool)
  (if (= (rx-peek) c) (do (rx-advance!) true) false))

;; ---------------------------------------------------------------------------
;; Decoding the pattern text

;; Decode UTF-8 to code points; without `u`/`v` a supplementary code point becomes its two UTF-16
;; code units, because that grammar sees surrogate halves as separate characters.
(defn rx-decode! [(body (slice u8))] (-> i64)
  (let [st (rx-state)
        (mut i) 0
        n (len body)]
    (loop (if (>= (load i) n)
              (break 0)
              (let [b0 (cast i64 (get body (load i)))]
                (if (< b0 128)
                    (do
                      (push! [i64] (mut (.units st)) b0)
                      (set! (mut i) (+ (load i) 1))
                      (continue))
                    (let [width
                            (cond (>= b0 240) 4
                                  (>= b0 224) 3
                                  (>= b0 192) 2
                                  :else 0)]
                      (if (or (= width 0) (> (+ (load i) width) n))
                          (break (rx-unknown! "regex: malformed UTF-8 in pattern"))
                          (let [(mut cp)
                                  (if (= width 2)
                                      (- b0 192)
                                      (if (= width 3) (- b0 224) (- b0 240)))
                                (mut k) 1]
                            (loop (if (>= (load k) width)
                                      (break 0)
                                      (let [b
                                              (cast i64
                                                    (get body
                                                         (+ (load i) (load k))))]
                                        (set! (mut cp)
                                              (+ (* (load cp) 64) (- b 128)))
                                        (set! (mut k) (+ (load k) 1))
                                        (continue))))
                            (if (or (.unicode st) (< (load cp) 65536))
                                (push! [i64] (mut (.units st)) (load cp))
                                (let [v (- (load cp) 65536)]
                                  (push! [i64]
                                         (mut (.units st))
                                         (+ RX-LEAD-LO (primitive/ishr v 10)))
                                  (push! [i64]
                                         (mut (.units st))
                                         (+ RX-TRAIL-LO (primitive/iand v 1023)))))
                            (set! (mut i) (+ (load i) width))
                            (continue))))))))
    0))

;; CountLeftCapturingParensWithin(Pattern) and whether any GroupSpecifier appears: both decide how
;; later escapes read, so they are measured before the descent.
(defn rx-prescan! [] (-> i64)
  (let [st (rx-state)
        (mut i) 0
        n (rx-len)
        (mut depth) 0]
    (loop (if (>= (load i) n)
              (break 0)
              (let [u (rx-unit-at (load i))]
                (if (= u RX-BACKSLASH)
                    (do (set! (mut i) (+ (load i) 2)) (continue))
                    (do
                      (cond (> (load depth) 0)
                              (if (= u RX-RBRACKET)
                                  (set! (mut depth) (- (load depth) 1))
                                  (if (and (= u RX-LBRACKET) (.sets st))
                                      (set! (mut depth) (+ (load depth) 1))
                                      0))
                            (= u RX-LBRACKET) (set! (mut depth) 1)
                            (= u RX-LPAREN)
                              (if (= (rx-unit-at (+ (load i) 1))
                                     RX-QUESTION)
                                  (if (and (= (rx-unit-at (+ (load i) 2))
                                              RX-LT)
                                           (!= (rx-unit-at (+ (load i) 3))
                                               RX-EQ)
                                           (!= (rx-unit-at (+ (load i) 3))
                                               RX-BANG))
                                      (do
                                        (set! (.named st) true)
                                        (set! (.group-count st)
                                              (+ (.group-count st) 1)))
                                      0)
                                  (set! (.group-count st)
                                        (+ (.group-count st) 1)))
                            :else 0)
                      (set! (mut i) (+ (load i) 1))
                      (continue))))))
    0))

;; ---------------------------------------------------------------------------
;; Escapes

;; RegExpUnicodeEscapeSequence after `\u`. Returns the code point, RX-INVALID when the text is not
;; an escape (nothing consumed), or RX-BRACED-INVALID when `{…}` opened but is malformed or out of
;; range. `braces` admits `\u{…}`; `pairs` joins `\uLEAD\uTRAIL` into one code point.
(defn rx-unicode-escape! [(braces bool) (pairs bool)] (-> i64)
  (if (= (rx-peek) RX-LBRACE)
      (if (not braces)
          RX-INVALID
          (let [(mut k) 1
                (mut value) 0
                (mut digits) 0]
            (loop (let [h (rx-hex-value (rx-peek-at (load k)))]
                    (if (< h 0)
                        (break 0)
                        (do
                          (if (<= (load value) RX-MAX-CODE-POINT)
                              (set! (mut value) (+ (* (load value) 16) h))
                              0)
                          (set! (mut digits) (+ (load digits) 1))
                          (set! (mut k) (+ (load k) 1))
                          (continue)))))
            (if (or (= (load digits) 0)
                    (!= (rx-peek-at (load k)) RX-RBRACE)
                    (> (load value) RX-MAX-CODE-POINT))
                RX-BRACED-INVALID
                (do (rx-advance-by! (+ (load k) 1)) (load value)))))
      (let [h0 (rx-hex-value (rx-peek-at 0))
            h1 (rx-hex-value (rx-peek-at 1))
            h2 (rx-hex-value (rx-peek-at 2))
            h3 (rx-hex-value (rx-peek-at 3))]
        (if (or (< h0 0) (< h1 0) (< h2 0) (< h3 0))
            RX-INVALID
            (let [value (+ (* h0 4096) (+ (* h1 256) (+ (* h2 16) h3)))]
              (rx-advance-by! 4)
              (if (and pairs
                       (>= value RX-LEAD-LO)
                       (<= value RX-LEAD-HI)
                       (= (rx-peek) RX-BACKSLASH)
                       (= (rx-peek-at 1) RX-LOWER-U))
                  (let [t0 (rx-hex-value (rx-peek-at 2))
                        t1 (rx-hex-value (rx-peek-at 3))
                        t2 (rx-hex-value (rx-peek-at 4))
                        t3 (rx-hex-value (rx-peek-at 5))]
                    (if (or (< t0 0) (< t1 0) (< t2 0) (< t3 0))
                        value
                        (let [trail
                                (+ (* t0 4096) (+ (* t1 256) (+ (* t2 16) t3)))]
                          (if (and (>= trail RX-TRAIL-LO)
                                   (<= trail RX-TRAIL-HI))
                              (do
                                (rx-advance-by! 6)
                                (+ 65536
                                   (+ (* (- value RX-LEAD-LO) 1024)
                                      (- trail RX-TRAIL-LO))))
                              value))))
                  value))))))

;; LegacyOctalEscapeSequence at a digit: up to three octal digits with value ≤ 0o377.
(defn rx-legacy-octal! [] (-> i64)
  (let [d1 (- (rx-peek) RX-ZERO)]
    (rx-advance!)
    (if (rx-octal? (rx-peek))
        (let [d2 (- (rx-peek) RX-ZERO)]
          (rx-advance!)
          (if (and (<= d1 3) (rx-octal? (rx-peek)))
              (let [d3 (- (rx-peek) RX-ZERO)]
                (rx-advance!)
                (+ (* d1 64) (+ (* d2 8) d3)))
              (+ (* d1 8) d2)))
        d1)))

;; CharacterEscape after `\` for the letters every context shares: ControlEscape, `c`, `0`, `x`,
;; `u`. Returns the character, RX-INVALID when `e` is not one of these letters (nothing consumed),
;; and reports the strict-mode errors itself. In the web-compat grammar an unusable `\c` leaves the
;; `c` unconsumed and yields a literal backslash.
(defn rx-character-escape! [(e i64) (in-class bool)] (-> i64)
  (let [st (rx-state)]
    (cond (= e RX-LOWER-F) (do (rx-advance!) RX-FF)
          (= e RX-LOWER-N) (do (rx-advance!) RX-LF)
          (= e RX-LOWER-R) (do (rx-advance!) RX-CR)
          (= e RX-LOWER-T) (do (rx-advance!) RX-TAB)
          (= e RX-LOWER-V) (do (rx-advance!) RX-VT)
          (= e RX-LOWER-C)
            (let [l (rx-peek-at 1)]
              (cond (rx-ascii-letter? l)
                      (do (rx-advance-by! 2) (primitive/iand l 31))
                    (and (not (.unicode st))
                         in-class
                         (or (rx-digit? l)
                             (= l RX-UNDERSCORE)))
                      (do
                        (rx-advance-by! 2)
                        (primitive/iand l 31))
                    (.unicode st)
                      (do
                        (rx-error! "regex: invalid control escape")
                        0)
                    :else RX-BACKSLASH))
          (= e RX-ZERO)
            (do
              (rx-advance!)
              (if (rx-digit? (rx-peek))
                  (if (.unicode st)
                      (do
                        (rx-error! "regex: invalid decimal escape")
                        0)
                      (do
                        (if (rx-octal? (rx-peek))
                            (rx-legacy-octal!)
                            0)))
                  0))
          (= e RX-LOWER-X)
            (let [h0 (rx-hex-value (rx-peek-at 1))
                  h1 (rx-hex-value (rx-peek-at 2))]
              (if (and (>= h0 0) (>= h1 0))
                  (do
                    (rx-advance-by! 3)
                    (+ (* h0 16) h1))
                  (if (.unicode st)
                      (do
                        (rx-error! "regex: invalid hexadecimal escape")
                        0)
                      (do (rx-advance!) RX-LOWER-X))))
          (= e RX-LOWER-U)
            (do
              (rx-advance!)
              (let [value
                      (rx-unicode-escape! (.unicode st)
                                          (.unicode st))]
                (if (>= value 0)
                    value
                    (if (.unicode st)
                        (do
                          (rx-error! "regex: invalid unicode escape")
                          0)
                        RX-LOWER-U))))
          :else RX-INVALID)))

;; IdentityEscape after `\`: in the strict grammar only a SyntaxCharacter or `/`; in web-compat
;; any character except `c` (handled before) and, once named groups exist, `k`.
(defn rx-identity-escape! [(e i64)] (-> i64)
  (let [st (rx-state)]
    (if (.unicode st)
        (if (or (rx-syntax-char? e) (= e RX-SLASH))
            (do (rx-advance!) e)
            (do (rx-error! "regex: invalid identity escape") 0))
        (if (and (= e RX-LOWER-K) (.named st))
            (do (rx-error! "regex: invalid named reference") 0)
            (do (rx-advance!) e)))))

;; UnicodePropertyValueExpression after `\p` or `\P`, in the strict grammars only. Returns whether
;; the property may match strings (the `v`-mode properties of strings).
(defn rx-property! [(negated bool)] (-> bool)
  (let [st (rx-state)]
    (if (not (rx-take-is? RX-LBRACE))
        (do (rx-error! "regex: property escape requires braces") false)
        (let [name-lo (.pos st)]
          (loop (if (rx-property-name-char? (rx-peek))
                    (do (rx-advance!) (continue))
                    (break 0)))
          (let [name-hi (.pos st)]
            (cond (rx-take-is? RX-EQ)
                    (let [value-lo (.pos st)]
                      (loop (if (rx-property-name-char? (rx-peek))
                                (do (rx-advance!) (continue))
                                (break 0)))
                      (let [value-hi (.pos st)]
                        (if (not (rx-take-is? RX-RBRACE))
                            (do
                              (rx-error! "regex: unterminated property escape")
                              false)
                            (do
                              (if (or (rx-span-is? name-lo
                                                   name-hi
                                                   "General_Category")
                                      (rx-span-is? name-lo name-hi "gc"))
                                  (if (rx-table-has? RX-GENERAL-CATEGORIES
                                                     value-lo
                                                     value-hi)
                                      0
                                      (rx-error! "regex: unknown General_Category value"))
                                  (if (or (rx-span-is? name-lo name-hi "Script")
                                          (rx-span-is? name-lo name-hi "sc")
                                          (rx-span-is? name-lo
                                                       name-hi
                                                       "Script_Extensions")
                                          (rx-span-is? name-lo name-hi "scx"))
                                      (if (rx-table-has? RX-SCRIPTS
                                                         value-lo
                                                         value-hi)
                                          0
                                          (rx-error! "regex: unknown Script value"))
                                      (rx-error! "regex: unknown property name")))
                              false))))
                  (not (rx-take-is? RX-RBRACE))
                    (do (rx-error! "regex: unterminated property escape") false)
                  (or (rx-table-has? RX-GENERAL-CATEGORIES
                                     name-lo
                                     name-hi)
                      (rx-table-has? RX-BINARY-PROPERTIES name-lo name-hi))
                    false
                  (rx-table-has? RX-STRING-PROPERTIES name-lo name-hi)
                    (if (not (.sets st))
                        (do
                          (rx-error! "regex: property of strings requires the v flag")
                          false)
                        (if negated
                            (do
                              (rx-error! "regex: negated property of strings")
                              false)
                            true))
                  :else
                    (do
                      (rx-error! "regex: unknown property name")
                      false)))))))

;; ---------------------------------------------------------------------------
;; Group names

;; Whether a code point may start or continue a RegExpIdentifierName. ASCII is decided here; the
;; ID_Start/ID_Continue tables for the rest are not in this compiler yet, so a non-ASCII code point
;; other than ZWNJ/ZWJ is an unknown, never a guess. Surrogate code points are never identifiers.
(defn rx-identifier-char! [(cp i64) (start bool)] (-> bool)
  (cond (or (= cp RX-DOLLAR) (= cp RX-UNDERSCORE) (rx-ascii-letter? cp)) true
        (rx-digit? cp) (not start)
        (or (= cp RX-ZWNJ) (= cp RX-ZWJ)) (not start)
        (or (< cp 128) (and (>= cp RX-LEAD-LO) (<= cp RX-TRAIL-HI))) false
        :else
          (do
            (rx-unknown! "regex: non-ASCII group name needs ID_Start/ID_Continue tables")
            false)))

;; GroupName :: < RegExpIdentifierName >, decoded into the name pool. Returns the pool span start;
;; the end is the pool length. Escapes here always take the strict `\u` forms.
(defn rx-group-name! [] (-> i64)
  (let [st (rx-state)
        pool-lo (len (.name-pool st))]
    (if (not (rx-take-is? RX-LT))
        (do (rx-error! "regex: expected group name") pool-lo)
        (do
          (loop (if (rx-failed?)
                    (break 0)
                    (let [c (rx-peek)]
                      (if (= c RX-GT)
                          (break (do (rx-advance!) 0))
                          (if (= c RX-EOF)
                              (break (rx-error! "regex: unterminated group name"))
                              (let [start (= (len (.name-pool st)) pool-lo)
                                    cp
                                      (if (= c RX-BACKSLASH)
                                          (if (= (rx-peek-at 1) RX-LOWER-U)
                                              (do
                                                (rx-advance-by! 2)
                                                (let [v
                                                        (rx-unicode-escape! true
                                                                            true)]
                                                  (if (>= v 0)
                                                      v
                                                      (do
                                                        (rx-error! "regex: invalid group name escape")
                                                        0))))
                                              (do
                                                (rx-error! "regex: invalid group name escape")
                                                0))
                                          (if (and (>= c RX-LEAD-LO)
                                                   (<= c RX-LEAD-HI)
                                                   (>= (rx-peek-at 1)
                                                       RX-TRAIL-LO)
                                                   (<= (rx-peek-at 1)
                                                       RX-TRAIL-HI))
                                              (let [v
                                                      (+ 65536
                                                         (+ (* (- c RX-LEAD-LO)
                                                               1024)
                                                            (- (rx-peek-at 1)
                                                               RX-TRAIL-LO)))]
                                                (rx-advance-by! 2)
                                                v)
                                              (do (rx-advance!) c)))]
                                (if (rx-failed?)
                                    (break 0)
                                    (if (rx-identifier-char! cp start)
                                        (do
                                          (push! [i64] (mut (.name-pool st)) cp)
                                          (continue))
                                        (break (if (rx-failed?)
                                                   0
                                                   (rx-error! "regex: invalid group name")))))))))))
          (if (and (not (rx-failed?)) (= (len (.name-pool st)) pool-lo))
              (rx-error! "regex: empty group name")
              0)
          pool-lo))))

(defn rx-names-equal? [(a-lo i64) (a-hi i64) (b-lo i64) (b-hi i64)] (-> bool)
  (if (!= (- a-hi a-lo) (- b-hi b-lo))
      false
      (let [pool (.name-pool (rx-state))
            (mut k) 0
            (mut same) true]
        (loop (if (or (not (load same)) (>= (load k) (- a-hi a-lo)))
                  (break 0)
                  (do
                    (if (!= (get pool (+ a-lo (load k)))
                            (get pool (+ b-lo (load k))))
                        (set! (mut same) false)
                        0)
                    (set! (mut k) (+ (load k) 1))
                    (continue))))
        (load same))))

;; MightBothParticipate: two groups are exclusive only if some disjunction they both sit in places
;; them in different alternatives.
(defn rx-might-both-participate? [(a RegexDecl) (b RegexDecl)] (-> bool)
  (let [pool (.path-pool (rx-state))
        a-len (- (.path-hi a) (.path-lo a))
        b-len (- (.path-hi b) (.path-lo b))
        common (if (< a-len b-len) a-len b-len)
        (mut k) 0
        (mut verdict) true
        (mut decided) false]
    (loop (if (or (load decided) (>= (load k) common))
              (break 0)
              (let [a-disj (get pool (+ (.path-lo a) (load k)))
                    b-disj (get pool (+ (.path-lo b) (load k)))
                    a-alt (get pool (+ (.path-lo a) (+ (load k) 1)))
                    b-alt (get pool (+ (.path-lo b) (+ (load k) 1)))]
                (if (!= a-disj b-disj)
                    (set! (mut decided) true)
                    (if (!= a-alt b-alt)
                        (do
                          (set! (mut verdict) false)
                          (set! (mut decided) true))
                        0))
                (set! (mut k) (+ (load k) 2))
                (continue))))
    (load verdict)))

(defn rx-declare-group! [(name-lo i64)] (-> i64)
  (let [st (rx-state)
        name-hi (len (.name-pool st))
        path-lo (len (.path-pool st))
        (mut d) (primitive/zeroed RegexDecl)]
    (al-for [p (.path st)] (push! [i64] (mut (.path-pool st)) p))
    (set! (.lo (mut d)) name-lo)
    (set! (.hi (mut d)) name-hi)
    (set! (.path-lo (mut d)) path-lo)
    (set! (.path-hi (mut d)) (len (.path-pool st)))
    (al-for [earlier (.decls st)]
            (let [e earlier]
              (if (and (rx-names-equal? (.lo e) (.hi e) name-lo name-hi)
                       (rx-might-both-participate? e (load d)))
                  (rx-error! "regex: duplicate capture group name")
                  0)))
    (push! [RegexDecl] (mut (.decls st)) (load d))
    0))

(defn rx-reference-group! [(name-lo i64)] (-> i64)
  (let [st (rx-state)
        (mut r) (primitive/zeroed RegexRef)]
    (set! (.lo (mut r)) name-lo)
    (set! (.hi (mut r)) (len (.name-pool st)))
    (push! [RegexRef] (mut (.refs st)) (load r))
    0))

(defn rx-check-references! [] (-> i64)
  (let [st (rx-state)]
    (al-for [r (.refs st)]
            (let [ref r
                  (mut found) false]
              (al-for [d (.decls st)]
                      (let [decl d]
                        (if (rx-names-equal? (.lo decl)
                                             (.hi decl)
                                             (.lo ref)
                                             (.hi ref))
                            (set! (mut found) true)
                            0)))
              (if (load found)
                  0
                  (rx-error! "regex: reference to an undefined group name"))))
    0))

;; ---------------------------------------------------------------------------
;; Quantifiers

;; `{` DecimalDigits `}` | `{` DecimalDigits `,}` | `{` DecimalDigits `,` DecimalDigits `}` at the
;; current position, without consuming. Returns the length of the braced text, or 0 when it is not a
;; quantifier; `out-of-order` is set when both bounds exist and min > max.
(defn rx-braced-quantifier-length [(out-of-order (mut bool))] (-> i64)
  (let [(mut k) 1
        (mut min) 0
        (mut min-digits) 0]
    (loop (if (rx-digit? (rx-peek-at (load k)))
              (do
                (if (< (load min) RX-QUANTIFIER-CAP)
                    (set! (mut min)
                          (+ (* (load min) 10)
                             (- (rx-peek-at (load k)) RX-ZERO)))
                    0)
                (set! (mut min-digits) (+ (load min-digits) 1))
                (set! (mut k) (+ (load k) 1))
                (continue))
              (break 0)))
    (cond (= (load min-digits) 0) 0
          (= (rx-peek-at (load k)) RX-RBRACE) (+ (load k) 1)
          (!= (rx-peek-at (load k)) RX-COMMA) 0
          :else
            (let [(mut max) 0
                  (mut max-digits) 0]
              (set! (mut k) (+ (load k) 1))
              (loop (if (rx-digit? (rx-peek-at (load k)))
                        (do
                          (if (< (load max) RX-QUANTIFIER-CAP)
                              (set! (mut max)
                                    (+ (* (load max) 10)
                                       (- (rx-peek-at (load k)) RX-ZERO)))
                              0)
                          (set! (mut max-digits) (+ (load max-digits) 1))
                          (set! (mut k) (+ (load k) 1))
                          (continue))
                        (break 0)))
              (if (!= (rx-peek-at (load k)) RX-RBRACE)
                  0
                  (do
                    (if (and (> (load max-digits) 0)
                             (> (load min) (load max)))
                        (set! out-of-order true)
                        0)
                    (+ (load k) 1)))))))

;; Quantifier after an atom; returns whether one was consumed. A `{` that is not a quantifier is an
;; error in the strict grammar and a literal (left for the next term) in web-compat.
(defn rx-quantifier-opt! [] (-> bool)
  (let [st (rx-state)
        c (rx-peek)]
    (if (or (= c RX-STAR) (= c RX-PLUS) (= c RX-QUESTION))
        (do
          (rx-advance!)
          (rx-take-is? RX-QUESTION)
          true)
        (if (= c RX-LBRACE)
            (let [(mut bad-order) false
                  length (rx-braced-quantifier-length (mut bad-order))]
              (if (= length 0)
                  (if (.unicode st)
                      (do (rx-error! "regex: incomplete quantifier") false)
                      false)
                  (do
                    (if (load bad-order)
                        (rx-error! "regex: quantifier range out of order")
                        0)
                    (rx-advance-by! length)
                    (rx-take-is? RX-QUESTION)
                    true)))
            false))))

;; ---------------------------------------------------------------------------
;; Atoms and terms

;; AtomEscape after `\`, outside a class and after `\b`/`\B` are excluded.
(defn rx-atom-escape! [] (-> i64)
  (let [st (rx-state)
        e (rx-peek)]
    (cond (= e RX-EOF) (rx-error! "regex: \\ at end of pattern")
          (and (rx-digit? e) (!= e RX-ZERO))
            (let  ;; DecimalEscape: a backreference, or in web-compat with too few groups a legacy escape.
              [(mut n)
               0
               (mut k)
               0]
              (loop (if (rx-digit? (rx-peek-at (load k)))
                        (do
                          (if (< (load n) RX-QUANTIFIER-CAP)
                              (set! (mut n)
                                    (+ (* (load n) 10)
                                       (- (rx-peek-at (load k)) RX-ZERO)))
                              0)
                          (set! (mut k) (+ (load k) 1))
                          (continue))
                        (break 0)))
              (cond (<= (load n) (.group-count st)) (rx-advance-by! (load k))
                    (or (.unicode st) (.named st))
                      (rx-error! "regex: backreference to a nonexistent group")
                    (rx-octal? e) (do (rx-legacy-octal!) 0)
                    :else (rx-advance!)))
          (or (= e RX-LOWER-D)
              (= e RX-UPPER-D)
              (= e RX-LOWER-S)
              (= e RX-UPPER-S)
              (= e RX-LOWER-W)
              (= e RX-UPPER-W))
            (rx-advance!)
          (and (or (= e RX-LOWER-P) (= e RX-UPPER-P)) (.unicode st))
            (do (rx-advance!) (rx-property! (= e RX-UPPER-P)) 0)
          (= e RX-LOWER-K)
            (if (or (.unicode st) (.named st))
                (do
                  (rx-advance!)
                  (rx-reference-group! (rx-group-name!)))
                (rx-advance!))
          (= e RX-MINUS)
            (if (.unicode st)
                (rx-error! "regex: invalid identity escape")
                (rx-advance!))
          :else
            (let [v (rx-character-escape! e false)]
              (if (= v RX-INVALID)
                  (do (rx-identity-escape! e) 0)
                  0)))))

;; RegularExpressionModifiers after `(?`: `ims` add set, optional `-` remove set, then `:`.
(defn rx-modifiers! [] (-> i64)
  (let [(mut seen-i) false
        (mut seen-m) false
        (mut seen-s) false
        (mut count) 0
        (mut dash) false
        (mut before-dash) 0]
    (loop (let [c (rx-peek)]
            (if (or (= c RX-LOWER-I) (= c RX-LOWER-M) (= c RX-LOWER-S))
                (do
                  (if (or (and (= c RX-LOWER-I) (load seen-i))
                          (and (= c RX-LOWER-M) (load seen-m))
                          (and (= c RX-LOWER-S) (load seen-s)))
                      (rx-error! "regex: repeated modifier")
                      0)
                  (if (= c RX-LOWER-I)
                      (set! (mut seen-i) true)
                      (if (= c RX-LOWER-M)
                          (set! (mut seen-m) true)
                          (set! (mut seen-s) true)))
                  (set! (mut count) (+ (load count) 1))
                  (rx-advance!)
                  (continue))
                (if (and (= c RX-MINUS) (not (load dash)))
                    (do
                      (set! (mut dash) true)
                      (set! (mut before-dash) (load count))
                      (rx-advance!)
                      (continue))
                    (break 0)))))
    (if (and (load dash) (= (load before-dash) 0) (= (load count) 0))
        (rx-error! "regex: modifiers group with nothing to add or remove")
        0)
    (if (not (rx-take-is? RX-COLON)) (rx-error! "regex: invalid group") 0)
    0))

;; `(` … `)` in every form. Returns the GROUP-* kind that decides whether a quantifier may follow.
(defn rx-group! [] (-> i64)
  (let [st (rx-state)]
    (rx-advance!)
    (let [kind
            (if (not (rx-take-is? RX-QUESTION))
                (do (rx-disjunction!) GROUP-CAPTURING)
                (let [c (rx-peek)]
                  (cond (or (= c RX-EQ) (= c RX-BANG))
                          (do (rx-advance!) (rx-disjunction!) GROUP-LOOKAHEAD)
                        (= c RX-LT)
                          (if (or (= (rx-peek-at 1) RX-EQ)
                                  (= (rx-peek-at 1) RX-BANG))
                              (do
                                (rx-advance-by! 2)
                                (rx-disjunction!)
                                GROUP-LOOKBEHIND)
                              (do
                                (rx-declare-group! (rx-group-name!))
                                (rx-disjunction!)
                                GROUP-CAPTURING))
                        (= c RX-COLON)
                          (do
                            (rx-advance!)
                            (rx-disjunction!)
                            GROUP-CAPTURING)
                        (or (= c RX-LOWER-I)
                            (= c RX-LOWER-M)
                            (= c RX-LOWER-S)
                            (= c RX-MINUS))
                          (do
                            (rx-modifiers!)
                            (rx-disjunction!)
                            GROUP-CAPTURING)
                        :else
                          (do
                            (rx-error! "regex: invalid group")
                            GROUP-CAPTURING))))]
      (if (rx-failed?)
          0
          (if (not (rx-take-is? RX-RPAREN))
              (rx-error! "regex: unterminated group")
              0))
      kind)))

;; One Term: an Assertion, or an Atom with an optional Quantifier.
(defn rx-term! [] (-> i64)
  (let [st (rx-state)
        c (rx-peek)]
    (cond (or (= c RX-CARET) (= c RX-DOLLAR))
            (do
              (rx-advance!)
              (if (rx-quantifier-opt!) (rx-error! "regex: nothing to repeat") 0))
          (and (= c RX-BACKSLASH)
               (or (= (rx-peek-at 1) RX-LOWER-B)
                   (= (rx-peek-at 1) RX-UPPER-B)))
            (do
              (rx-advance-by! 2)
              (if (rx-quantifier-opt!) (rx-error! "regex: nothing to repeat") 0))
          (= c RX-BACKSLASH)
            (do
              (rx-advance!)
              (rx-atom-escape!)
              (if (rx-failed?) 0 (do (rx-quantifier-opt!) 0)))
          (= c RX-LPAREN)
            (let [kind (rx-group!)]
              (if (rx-failed?)
                  0
                  (let [quantified (rx-quantifier-opt!)]
                    (if (and quantified
                             (or (= kind GROUP-LOOKBEHIND)
                                 (and (= kind GROUP-LOOKAHEAD)
                                      (.unicode st))))
                        (rx-error! "regex: quantified assertion")
                        0))))
          (= c RX-LBRACKET)
            (do
              (if (.sets st) (do (rx-class-set!) 0) (rx-class!))
              (if (rx-failed?) 0 (do (rx-quantifier-opt!) 0)))
          (or (= c RX-STAR) (= c RX-PLUS) (= c RX-QUESTION))
            (rx-error! "regex: nothing to repeat")
          (= c RX-LBRACE)
            (if (.unicode st)
                (rx-error! "regex: lone quantifier brackets")
                (let [(mut bad-order) false]
                  (if (> (rx-braced-quantifier-length (mut bad-order))
                         0)
                      (rx-error! "regex: nothing to repeat")
                      (do
                        (rx-advance!)
                        (rx-quantifier-opt!)
                        0))))
          (or (= c RX-RBRACE) (= c RX-RBRACKET))
            (if (.unicode st)
                (rx-error! "regex: lone quantifier brackets")
                (do
                  (rx-advance!)
                  (rx-quantifier-opt!)
                  0))
          :else  ;; PatternCharacter, `.` included.
            (do (rx-advance!) (rx-quantifier-opt!) 0))))

;; Alternative :: Term*, ending at `|`, `)` or the end of the pattern.
(defn rx-alternative! [] (-> i64)
  (do
    (loop (if (rx-failed?)
              (break 0)
              (let [c (rx-peek)]
                (if (or (= c RX-EOF) (= c RX-BAR) (= c RX-RPAREN))
                    (break 0)
                    (do (rx-term!) (continue))))))
    0))

;; Disjunction :: Alternative ( `|` Alternative )*, tracked for MightBothParticipate.
(defn rx-disjunction! [] (-> i64)
  (let [st (rx-state)]
    (set! (.disj-counter st) (+ (.disj-counter st) 1))
    (push! [i64] (mut (.path st)) (.disj-counter st))
    (push! [i64] (mut (.path st)) 0)
    (let [alt-index (- (len (.path st)) 1)]
      (loop (do
              (rx-alternative!)
              (if (and (not (rx-failed?)) (rx-take-is? RX-BAR))
                  (do
                    (set! (mut (.path st))
                          alt-index
                          (+ (get (.path st) alt-index) 1))
                    (continue))
                  (break 0)))))
    (pop! [i64] (mut (.path st)))
    (pop! [i64] (mut (.path st)))
    0))

;; ---------------------------------------------------------------------------
;; Entry

;; Validate a RegularExpressionLiteral's body under its flags. The flags themselves are checked by
;; the parser; only `u` and `v` matter here.
(defn regex-validate [(body (slice u8)) (flags (slice u8))] (-> RegexVerdict)
  (let [(mut unicode) false
        (mut sets) false]
    (for c
      (iter flags)
      (do
        (if (= c (cast u8 RX-LOWER-U)) (set! (mut unicode) true) 0)
        (if (= c (cast u8 RX-LOWER-V))
            (do (set! (mut unicode) true) (set! (mut sets) true))
            0)))
    (rx-reset! (load unicode) (load sets))
    (rx-decode! body)
    (if (rx-failed?)
        0
        (do
          (rx-prescan!)
          (rx-disjunction!)
          (if (rx-failed?)
              0
              (if (not (rx-at-end?))
                  (rx-error! "regex: unmatched )")
                  (rx-check-references!)))))
    (let [st (rx-state)]
      (match (.error st)
        (Some [m] (RegexError m))
        (None []
              (match (.unknown st)
                (Some [m] (RegexUnknown m))
                (None [] (RegexOk))))))))
