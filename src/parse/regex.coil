;; Regular-expression pattern early errors (ECMA-262 §22.2.1 Patterns, B.1.2 web-compat grammar).

;;
;; A regular-expression literal's body is checked here at parse time, not at RegExp construction:
;; every violation of the Pattern grammar is an early SyntaxError of the enclosing Script or
;; Module. The validator reads the pattern as code points (`u` or `v` flag) or as UTF-16 code units
;; (neither flag), because the grammar counts surrogate halves as separate characters only in the
;; second case.
;;
;; Three grammars share one recursive descent, selected by the flags:
;;
;; - Neither `u` nor `v`: Annex B's extended grammar. `]`, `{` and `}` are literal where they cannot
;;   be a quantifier; a braced quantifier with nothing to repeat is still an error; `\` before an
;;   unrecognised character is an identity escape; `\N` beyond the group count is a legacy octal
;;   escape; `\c` not followed by a letter is a literal backslash; lookaheads may be quantified;
;;   class ranges may use `\d`-style escapes as endpoints.
;; - `u`: the strict grammar. Identity escapes are SyntaxCharacters and `/` only, `\u{…}` and
;;   surrogate-pair escapes are single code points, lone brackets are errors, lookaheads are not
;;   quantifiable, and `\p{…}` property escapes are validated against the Unicode tables below.
;; - `v`: the strict grammar with ClassSetExpressions: nested classes, `&&` and `--` operators,
;;   `\q{…}` string alternatives, reserved double punctuators, and the rule that a negated class or
;;   a `\P` escape may not match strings.
;;
;; Named groups (`(?<name>…)`, `\k<name>`) switch on the N grammar in every mode: `\k` must name a
;; group, `\N` must be a real backreference, and two groups may share a name only when they can
;; never both participate in a match (they sit in different alternatives of one disjunction).
;;
;; Verdicts are returned, never raised: the parser owns error reporting. `RegexUnknown` names a
;; classification this validator cannot make yet (a non-ASCII code point whose ID_Start or
;; ID_Continue status decides a group name) so the caller fails closed instead of guessing.
;;
;; The property tables list the exact spellings ECMA-262 admits (Table 68 binary properties,
;; General_Category, Script and Script_Extensions values with their aliases, and the `v`-mode
;; properties of strings) for Unicode 17.0.0, the version test262 revision 419d3e0a generates its
;; property-escape tests from. Matching is exact: no case folding, no whitespace, no `Is`/`In`
;; prefixes.
(module aot.parse.regex)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)

;; ---------------------------------------------------------------------------
;; Verdicts
(defsum RegexVerdict
  (RegexOk)
  (RegexError [(message (slice u8))])
  (RegexUnknown [(message (slice u8))]))

;; ---------------------------------------------------------------------------
;; Character codes named for the grammar
(const RX-EOF -1)

(const RX-CLASS-ESCAPE -2)  ; a `\d`-style class escape where a character was possible

(const RX-INVALID -1)

(const RX-BRACED-INVALID -2)

(const RX-TAB 9)

(const RX-LF 10)

(const RX-VT 11)

(const RX-FF 12)

(const RX-CR 13)

(const RX-SPACE 32)

(const RX-BANG 33)

(const RX-HASH 35)

(const RX-DOLLAR 36)

(const RX-PERCENT 37)

(const RX-AMP 38)

(const RX-LPAREN 40)

(const RX-RPAREN 41)

(const RX-STAR 42)

(const RX-PLUS 43)

(const RX-COMMA 44)

(const RX-MINUS 45)

(const RX-DOT 46)

(const RX-SLASH 47)

(const RX-ZERO 48)

(const RX-THREE 51)

(const RX-SEVEN 55)

(const RX-NINE 57)

(const RX-COLON 58)

(const RX-SEMI 59)

(const RX-LT 60)

(const RX-EQ 61)

(const RX-GT 62)

(const RX-QUESTION 63)

(const RX-AT 64)

(const RX-UPPER-A 65)

(const RX-UPPER-B 66)

(const RX-UPPER-D 68)

(const RX-UPPER-F 70)

(const RX-UPPER-P 80)

(const RX-UPPER-S 83)

(const RX-UPPER-W 87)

(const RX-UPPER-Z 90)

(const RX-LBRACKET 91)

(const RX-BACKSLASH 92)

(const RX-RBRACKET 93)

(const RX-CARET 94)

(const RX-UNDERSCORE 95)

(const RX-BACKTICK 96)

(const RX-LOWER-A 97)

(const RX-LOWER-B 98)

(const RX-LOWER-C 99)

(const RX-LOWER-D 100)

(const RX-LOWER-F 102)

(const RX-LOWER-I 105)

(const RX-LOWER-K 107)

(const RX-LOWER-M 109)

(const RX-LOWER-N 110)

(const RX-LOWER-P 112)

(const RX-LOWER-Q 113)

(const RX-LOWER-R 114)

(const RX-LOWER-S 115)

(const RX-LOWER-T 116)

(const RX-LOWER-U 117)

(const RX-LOWER-V 118)

(const RX-LOWER-W 119)

(const RX-LOWER-X 120)

(const RX-LOWER-Z 122)

(const RX-LBRACE 123)

(const RX-BAR 124)

(const RX-RBRACE 125)

(const RX-TILDE 126)

(const RX-BACKSPACE 8)

(const RX-ZWNJ 8204)

(const RX-ZWJ 8205)

(const RX-LEAD-LO 55296)

(const RX-LEAD-HI 56319)

(const RX-TRAIL-LO 56320)

(const RX-TRAIL-HI 57343)

(const RX-MAX-CODE-POINT 1114111)

(const RX-QUANTIFIER-CAP 1000000000000)

;; How a group closed: what may follow it.
(const GROUP-CAPTURING 0)

(const GROUP-LOOKAHEAD 1)

(const GROUP-LOOKBEHIND 2)

;; ClassSetExpression operator modes.
(const SET-UNION 0)

(const SET-INTERSECTION 1)

(const SET-SUBTRACTION 2)

;; ---------------------------------------------------------------------------
;; State
(defstruct RegexDecl [(lo i64) (hi i64) (path-lo i64) (path-hi i64)])

(defstruct RegexRef [(lo i64) (hi i64)])

(defstruct RegexState
  [(units (ArrayList i64))
   (pos i64)
   (unicode bool)  ; `u` or `v`
   (sets bool)  ; `v`
   (named bool)  ; the pattern contains a GroupSpecifier
   (group-count i64)  ; CountLeftCapturingParensWithin(Pattern)
   (disj-counter i64)
   (path (ArrayList i64))  ; (disjunction id, alternative index) pairs of the open disjunctions
   (path-pool (ArrayList i64))
   (name-pool (ArrayList i64))
   (decls (ArrayList RegexDecl))
   (refs (ArrayList RegexRef))
   (error (Option (slice u8)))
   (unknown (Option (slice u8)))
   (initialized bool)])

(defn rx-state [] (-> (ptr RegexState))
  (primitive/alloc-static RegexState))

(defn rx-reset! [(unicode bool) (sets bool)] (-> i64)
  (let [st (rx-state)]
    (if (.initialized st)
        (do
          (al-clear! [i64] (mut (.units st)))
          (al-clear! [i64] (mut (.path st)))
          (al-clear! [i64] (mut (.path-pool st)))
          (al-clear! [i64] (mut (.name-pool st)))
          (al-clear! [RegexDecl] (mut (.decls st)))
          (al-clear! [RegexRef] (mut (.refs st)))
          0)
        (do
          (set! (.units st) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.path st) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.path-pool st) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.name-pool st) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.decls st) (al-new [RegexDecl] (alloc/malloc-allocator)))
          (set! (.refs st) (al-new [RegexRef] (alloc/malloc-allocator)))
          (set! (.initialized st) true)
          0))
    (set! (.pos st) 0)
    (set! (.unicode st) unicode)
    (set! (.sets st) sets)
    (set! (.named st) false)
    (set! (.group-count st) 0)
    (set! (.disj-counter st) 0)
    (set! (.error st) (None [(slice u8)]))
    (set! (.unknown st) (None [(slice u8)]))
    0))

;; The first error wins; later ones are consequences of the same fault.
(defn rx-error! [(message (slice u8))] (-> i64)
  (let [st (rx-state)]
    (match (.error st)
      (None [] (set! (.error st) (Some message)))
      (Some [m] 0))
    0))

(defn rx-unknown! [(message (slice u8))] (-> i64)
  (let [st (rx-state)]
    (match (.unknown st)
      (None [] (set! (.unknown st) (Some message)))
      (Some [m] 0))
    0))

(defn rx-failed? [] (-> bool)
  (let [st (rx-state)]
    (or (match (.error st) (Some [m] true) (None [] false))
        (match (.unknown st) (Some [m] true) (None [] false)))))

(defn rx-len [] (-> i64)
  (len (.units (rx-state))))

(defn rx-unit-at [(i i64)] (-> i64)
  (if (or (< i 0) (>= i (rx-len))) RX-EOF (get (.units (rx-state)) i)))

(defn rx-peek [] (-> i64)
  (rx-unit-at (.pos (rx-state))))

(defn rx-peek-at [(k i64)] (-> i64)
  (rx-unit-at (+ (.pos (rx-state)) k)))

(defn rx-advance! [] (-> i64)
  (let [st (rx-state)]
    (set! (.pos st) (+ (.pos st) 1))
    0))

(defn rx-advance-by! [(k i64)] (-> i64)
  (let [st (rx-state)]
    (set! (.pos st) (+ (.pos st) k))
    0))

(defn rx-at-end? [] (-> bool)
  (>= (.pos (rx-state)) (rx-len)))

(defn rx-take-is? [(c i64)] (-> bool)
  (if (= (rx-peek) c) (do (rx-advance!) true) false))

;; ---------------------------------------------------------------------------
;; Character classes of the grammar
(defn rx-digit? [(c i64)] (-> bool)
  (and (>= c RX-ZERO) (<= c RX-NINE)))

(defn rx-octal? [(c i64)] (-> bool)
  (and (>= c RX-ZERO) (<= c RX-SEVEN)))

(defn rx-ascii-letter? [(c i64)] (-> bool)
  (or (and (>= c RX-UPPER-A) (<= c RX-UPPER-Z)) (and (>= c RX-LOWER-A) (<= c RX-LOWER-Z))))

(defn rx-hex-value [(c i64)] (-> i64)
  (if (rx-digit? c)
      (- c RX-ZERO)
      (if (and (>= c RX-LOWER-A) (<= c RX-LOWER-F))
          (+ 10 (- c RX-LOWER-A))
          (if (and (>= c RX-UPPER-A) (<= c RX-UPPER-F)) (+ 10 (- c RX-UPPER-A)) RX-INVALID))))

;; SyntaxCharacter :: one of ^ $ \ . * + ? ( ) [ ] { } |
(defn rx-syntax-char? [(c i64)] (-> bool)
  (or (= c RX-CARET)
      (= c RX-DOLLAR)
      (= c RX-BACKSLASH)
      (= c RX-DOT)
      (= c RX-STAR)
      (= c RX-PLUS)
      (= c RX-QUESTION)
      (= c RX-LPAREN)
      (= c RX-RPAREN)
      (= c RX-LBRACKET)
      (= c RX-RBRACKET)
      (= c RX-LBRACE)
      (= c RX-RBRACE)
      (= c RX-BAR)))

;; ClassSetSyntaxCharacter :: one of ( ) [ ] { } / - \ |
(defn rx-class-set-syntax-char? [(c i64)] (-> bool)
  (or (= c RX-LPAREN)
      (= c RX-RPAREN)
      (= c RX-LBRACKET)
      (= c RX-RBRACKET)
      (= c RX-LBRACE)
      (= c RX-RBRACE)
      (= c RX-SLASH)
      (= c RX-MINUS)
      (= c RX-BACKSLASH)
      (= c RX-BAR)))

;; ClassSetReservedPunctuator :: one of & - ! # % , : ; < = > @ ` ~
(defn rx-class-set-reserved-punct? [(c i64)] (-> bool)
  (or (= c RX-AMP)
      (= c RX-MINUS)
      (= c RX-BANG)
      (= c RX-HASH)
      (= c RX-PERCENT)
      (= c RX-COMMA)
      (= c RX-COLON)
      (= c RX-SEMI)
      (= c RX-LT)
      (= c RX-EQ)
      (= c RX-GT)
      (= c RX-AT)
      (= c RX-BACKTICK)
      (= c RX-TILDE)))

;; ClassSetReservedDoublePunctuator :: one of && !! ## $$ %% ** ++ ,, .. :: ;; << == >> ?? @@ ^^ `` ~~
(defn rx-double-punct-char? [(c i64)] (-> bool)
  (or (= c RX-AMP)
      (= c RX-BANG)
      (= c RX-HASH)
      (= c RX-DOLLAR)
      (= c RX-PERCENT)
      (= c RX-STAR)
      (= c RX-PLUS)
      (= c RX-COMMA)
      (= c RX-DOT)
      (= c RX-COLON)
      (= c RX-SEMI)
      (= c RX-LT)
      (= c RX-EQ)
      (= c RX-GT)
      (= c RX-QUESTION)
      (= c RX-AT)
      (= c RX-CARET)
      (= c RX-BACKTICK)
      (= c RX-TILDE)))

(defn rx-at-double-punct? [] (-> bool)
  (let [c (rx-peek)]
    (and (rx-double-punct-char? c) (= (rx-peek-at 1) c))))

(defn rx-property-name-char? [(c i64)] (-> bool)
  (or (rx-ascii-letter? c) (rx-digit? c) (= c RX-UNDERSCORE)))

;; ---------------------------------------------------------------------------
;; Decoding the pattern text

;; Decode UTF-8 to code points; without `u`/`v` a supplementary code point becomes its two UTF-16
;; code units, because that grammar sees surrogate halves as separate characters.
(defn rx-decode! [(body (slice u8))] (-> i64)
  (let [st (rx-state)
        (mut i) 0
        n (len body)]
    (loop (if (>= (load i) n)
              (break 0)
              (let [b0 (cast i64 (get body (load i)))]
                (if (< b0 128)
                    (do (push! [i64] (mut (.units st)) b0) (set! (mut i) (+ (load i) 1)) (continue))
                    (let [width (if (>= b0 240) 4 (if (>= b0 224) 3 (if (>= b0 192) 2 0)))]
                      (if (or (= width 0) (> (+ (load i) width) n))
                          (break (rx-unknown! "regex: malformed UTF-8 in pattern"))
                          (let [(mut cp) (if (= width 2) (- b0 192) (if (= width 3) (- b0 224) (- b0 240)))
                                (mut k) 1]
                            (loop (if (>= (load k) width)
                                      (break 0)
                                      (let [b (cast i64 (get body (+ (load i) (load k))))]
                                        (set! (mut cp) (+ (* (load cp) 64) (- b 128)))
                                        (set! (mut k) (+ (load k) 1))
                                        (continue))))
                            (if (or (.unicode st) (< (load cp) 65536))
                                (push! [i64] (mut (.units st)) (load cp))
                                (let [v (- (load cp) 65536)]
                                  (push! [i64] (mut (.units st)) (+ RX-LEAD-LO (primitive/ishr v 10)))
                                  (push! [i64] (mut (.units st)) (+ RX-TRAIL-LO (primitive/iand v 1023)))))
                            (set! (mut i) (+ (load i) width))
                            (continue))))))))
    0))

;; CountLeftCapturingParensWithin(Pattern) and whether any GroupSpecifier appears: both decide how
;; later escapes read, so they are measured before the descent.
(defn rx-prescan! [] (-> i64)
  (let [st (rx-state)
        (mut i) 0
        n (rx-len)
        (mut depth) 0]
    (loop (if (>= (load i) n)
              (break 0)
              (let [u (rx-unit-at (load i))]
                (if (= u RX-BACKSLASH)
                    (do (set! (mut i) (+ (load i) 2)) (continue))
                    (do
                      (if (> (load depth) 0)
                          (if (= u RX-RBRACKET)
                              (set! (mut depth) (- (load depth) 1))
                              (if (and (= u RX-LBRACKET) (.sets st)) (set! (mut depth) (+ (load depth) 1)) 0))
                          (if (= u RX-LBRACKET)
                              (set! (mut depth) 1)
                              (if (= u RX-LPAREN)
                                  (if (= (rx-unit-at (+ (load i) 1)) RX-QUESTION)
                                      (if (and (= (rx-unit-at (+ (load i) 2)) RX-LT)
                                               (!= (rx-unit-at (+ (load i) 3)) RX-EQ)
                                               (!= (rx-unit-at (+ (load i) 3)) RX-BANG))
                                          (do
                                            (set! (.named st) true)
                                            (set! (.group-count st) (+ (.group-count st) 1)))
                                          0)
                                      (set! (.group-count st) (+ (.group-count st) 1)))
                                  0)))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))))
    0))

;; ---------------------------------------------------------------------------
;; Property tables (Unicode 17.0.0). Each entry is bracketed by spaces so a lookup is an exact
;; whole-word match.
(const RX-BINARY-PROPERTIES
       "
 ASCII AHex ASCII_Hex_Digit Alpha Alphabetic Any Assigned Bidi_C Bidi_Control Bidi_M Bidi_Mirrored
 CI Case_Ignorable Cased CWCF Changes_When_Casefolded CWCM Changes_When_Casemapped
 CWL Changes_When_Lowercased CWKCF Changes_When_NFKC_Casefolded CWT Changes_When_Titlecased
 CWU Changes_When_Uppercased Dash DI Default_Ignorable_Code_Point Dep Deprecated Dia Diacritic
 Emoji EComp Emoji_Component EMod Emoji_Modifier EBase Emoji_Modifier_Base EPres Emoji_Presentation
 ExtPict Extended_Pictographic Ext Extender Gr_Base Grapheme_Base Gr_Ext Grapheme_Extend
 Hex Hex_Digit IDSB IDS_Binary_Operator IDST IDS_Trinary_Operator IDC ID_Continue IDS ID_Start
 Ideo Ideographic Join_C Join_Control LOE Logical_Order_Exception Lower Lowercase Math
 NChar Noncharacter_Code_Point Pat_Syn Pattern_Syntax Pat_WS Pattern_White_Space QMark Quotation_Mark
 Radical RI Regional_Indicator STerm Sentence_Terminal SD Soft_Dotted Term Terminal_Punctuation
 UIdeo Unified_Ideograph Upper Uppercase VS Variation_Selector White_Space space
 XIDC XID_Continue XIDS XID_Start
")

(const RX-STRING-PROPERTIES
       "
 Basic_Emoji Emoji_Keycap_Sequence RGI_Emoji_Modifier_Sequence RGI_Emoji_Flag_Sequence
 RGI_Emoji_Tag_Sequence RGI_Emoji_ZWJ_Sequence RGI_Emoji
")

(const RX-GENERAL-CATEGORIES
       "
 C Cased_Letter Cc Cf Close_Punctuation Cn Co Combining_Mark Connector_Punctuation Control Cs
 Currency_Symbol Dash_Punctuation Decimal_Number Enclosing_Mark Final_Punctuation Format
 Initial_Punctuation L LC Letter Letter_Number Line_Separator Ll Lm Lo Lowercase_Letter Lt Lu M Mark
 Math_Symbol Mc Me Mn Modifier_Letter Modifier_Symbol N Nd Nl No Nonspacing_Mark Number
 Open_Punctuation Other Other_Letter Other_Number Other_Punctuation Other_Symbol P
 Paragraph_Separator Pc Pd Pe Pf Pi Po Private_Use Ps Punctuation S Sc Separator Sk Sm So
 Space_Separator Spacing_Mark Surrogate Symbol Titlecase_Letter Unassigned Uppercase_Letter Z Zl Zp Zs
 cntrl digit punct
")

(const RX-SCRIPTS
       "
 Adlam Adlm Aghb Ahom Anatolian_Hieroglyphs Arab Arabic Armenian Armi Armn Avestan Avst Bali
 Balinese Bamu Bamum Bass Bassa_Vah Batak Batk Beng Bengali Berf Beria_Erfe Bhaiksuki Bhks Bopo
 Bopomofo Brah Brahmi Brai Braille Bugi Buginese Buhd Buhid Cakm Canadian_Aboriginal Cans Cari
 Carian Caucasian_Albanian Chakma Cham Cher Cherokee Chorasmian Chrs Common Copt Coptic Cpmn Cprt
 Cuneiform Cypriot Cypro_Minoan Cyrillic Cyrl Deseret Deva Devanagari Diak Dives_Akuru Dogr Dogra
 Dsrt Dupl Duployan Egyp Egyptian_Hieroglyphs Elba Elbasan Elym Elymaic Ethi Ethiopic Gara Garay
 Geor Georgian Glag Glagolitic Gong Gonm Goth Gothic Gran Grantha Greek Grek Gujarati Gujr Gukh
 Gunjala_Gondi Gurmukhi Guru Gurung_Khema Han Hang Hangul Hani Hanifi_Rohingya Hano Hanunoo Hatr
 Hatran Hebr Hebrew Hira Hiragana Hluw Hmng Hmnp Hung Imperial_Aramaic Inherited
 Inscriptional_Pahlavi Inscriptional_Parthian Ital Java Javanese Kaithi Kali Kana Kannada
 Katakana Kawi Kayah_Li Khar Kharoshthi Khitan_Small_Script Khmer Khmr Khoj Khojki Khudawadi
 Kirat_Rai Kits Knda Krai Kthi Lana Lao Laoo Latin Latn Lepc Lepcha Limb Limbu Lina Linb Linear_A
 Linear_B Lisu Lyci Lycian Lydi Lydian Mahajani Mahj Maka Makasar Malayalam Mand Mandaic Mani
 Manichaean Marc Marchen Masaram_Gondi Medefaidrin Medf Meetei_Mayek Mend Mende_Kikakui Merc Mero
 Meroitic_Cursive Meroitic_Hieroglyphs Miao Mlym Modi Mong Mongolian Mro Mroo Mtei Mult Multani
 Myanmar Mymr Nabataean Nag_Mundari Nagm Nand Nandinagari Narb Nbat New_Tai_Lue Newa Nko Nkoo
 Nshu Nushu Nyiakeng_Puachue_Hmong Ogam Ogham Ol_Chiki Ol_Onal Olck Old_Hungarian Old_Italic
 Old_North_Arabian Old_Permic Old_Persian Old_Sogdian Old_South_Arabian Old_Turkic Old_Uyghur
 Onao Oriya Orkh Orya Osage Osge Osma Osmanya Ougr Pahawh_Hmong Palm Palmyrene Pau_Cin_Hau Pauc
 Perm Phag Phags_Pa Phli Phlp Phnx Phoenician Plrd Prti Psalter_Pahlavi Qaac Qaai Rejang Rjng
 Rohg Runic Runr Samaritan Samr Sarb Saur Saurashtra Sgnw Sharada Shavian Shaw Shrd Sidd Siddham
 Sidetic Sidt SignWriting Sind Sinh Sinhala Sogd Sogdian Sogo Sora Sora_Sompeng Soyo Soyombo Sund
 Sundanese Sunu Sunuwar Sylo Syloti_Nagri Syrc Syriac Tagalog Tagb Tagbanwa Tai_Le Tai_Tham
 Tai_Viet Tai_Yo Takr Takri Tale Talu Tamil Taml Tang Tangsa Tangut Tavt Tayo Telu Telugu Tfng
 Tglg Thaa Thaana Thai Tibetan Tibt Tifinagh Tirh Tirhuta Tnsa Todhri Todr Tolong_Siki Tols Toto
 Tulu_Tigalari Tutg Ugar Ugaritic Unknown Vai Vaii Vith Vithkuqi Wancho Wara Warang_Citi Wcho
 Xpeo Xsux Yezi Yezidi Yi Yiii Zanabazar_Square Zanb Zinh Zyyy Zzzz
")

;; Whether units[lo, hi) spells one whole entry of `table`.
(defn rx-table-has? [(table (slice u8)) (lo i64) (hi i64)] (-> bool)
  (let [n (- hi lo)
        size (len table)
        (mut i) 0
        (mut found) false]
    (if (<= n 0)
        false
        (do
          (loop (if (or (load found) (>= (+ (load i) (+ n 1)) size))
                    (break 0)
                    (do
                      (if (and (rx-separator? (cast i64 (get table (load i))))
                               (rx-separator? (cast i64 (get table (+ (load i) (+ n 1))))))
                          (let [(mut k) 0
                                (mut same) true]
                            (loop (if (or (not (load same)) (>= (load k) n))
                                      (break 0)
                                      (do
                                        (if (!= (cast i64 (get table (+ (load i) (+ (load k) 1))))
                                                (rx-unit-at (+ lo (load k))))
                                            (set! (mut same) false)
                                            0)
                                        (set! (mut k) (+ (load k) 1))
                                        (continue))))
                            (if (load same) (set! (mut found) true) 0))
                          0)
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (load found)))))

(defn rx-separator? [(c i64)] (-> bool)
  (or (= c RX-SPACE) (= c RX-LF)))

(defn rx-span-is? [(lo i64) (hi i64) (text (slice u8))] (-> bool)
  (if (!= (- hi lo) (len text))
      false
      (let [(mut k) 0
            (mut same) true]
        (loop (if (or (not (load same)) (>= (load k) (len text)))
                  (break 0)
                  (do
                    (if (!= (rx-unit-at (+ lo (load k))) (cast i64 (get text (load k))))
                        (set! (mut same) false)
                        0)
                    (set! (mut k) (+ (load k) 1))
                    (continue))))
        (load same))))

;; ---------------------------------------------------------------------------
;; Escapes

;; RegExpUnicodeEscapeSequence after `\u`. Returns the code point, RX-INVALID when the text is not
;; an escape (nothing consumed), or RX-BRACED-INVALID when `{…}` opened but is malformed or out of
;; range. `braces` admits `\u{…}`; `pairs` joins `\uLEAD\uTRAIL` into one code point.
(defn rx-unicode-escape! [(braces bool) (pairs bool)] (-> i64)
  (if (= (rx-peek) RX-LBRACE)
      (if (not braces)
          RX-INVALID
          (let [(mut k) 1
                (mut value) 0
                (mut digits) 0]
            (loop (let [h (rx-hex-value (rx-peek-at (load k)))]
                    (if (< h 0)
                        (break 0)
                        (do
                          (if (<= (load value) RX-MAX-CODE-POINT)
                              (set! (mut value) (+ (* (load value) 16) h))
                              0)
                          (set! (mut digits) (+ (load digits) 1))
                          (set! (mut k) (+ (load k) 1))
                          (continue)))))
            (if (or (= (load digits) 0) (!= (rx-peek-at (load k)) RX-RBRACE) (> (load value) RX-MAX-CODE-POINT))
                RX-BRACED-INVALID
                (do (rx-advance-by! (+ (load k) 1)) (load value)))))
      (let [h0 (rx-hex-value (rx-peek-at 0))
            h1 (rx-hex-value (rx-peek-at 1))
            h2 (rx-hex-value (rx-peek-at 2))
            h3 (rx-hex-value (rx-peek-at 3))]
        (if (or (< h0 0) (< h1 0) (< h2 0) (< h3 0))
            RX-INVALID
            (let [value (+ (* h0 4096) (+ (* h1 256) (+ (* h2 16) h3)))]
              (rx-advance-by! 4)
              (if (and pairs
                       (>= value RX-LEAD-LO)
                       (<= value RX-LEAD-HI)
                       (= (rx-peek) RX-BACKSLASH)
                       (= (rx-peek-at 1) RX-LOWER-U))
                  (let [t0 (rx-hex-value (rx-peek-at 2))
                        t1 (rx-hex-value (rx-peek-at 3))
                        t2 (rx-hex-value (rx-peek-at 4))
                        t3 (rx-hex-value (rx-peek-at 5))]
                    (if (or (< t0 0) (< t1 0) (< t2 0) (< t3 0))
                        value
                        (let [trail (+ (* t0 4096) (+ (* t1 256) (+ (* t2 16) t3)))]
                          (if (and (>= trail RX-TRAIL-LO) (<= trail RX-TRAIL-HI))
                              (do
                                (rx-advance-by! 6)
                                (+ 65536 (+ (* (- value RX-LEAD-LO) 1024) (- trail RX-TRAIL-LO))))
                              value))))
                  value))))))

;; LegacyOctalEscapeSequence at a digit: up to three octal digits with value ≤ 0o377.
(defn rx-legacy-octal! [] (-> i64)
  (let [d1 (- (rx-peek) RX-ZERO)]
    (rx-advance!)
    (if (rx-octal? (rx-peek))
        (let [d2 (- (rx-peek) RX-ZERO)]
          (rx-advance!)
          (if (and (<= d1 3) (rx-octal? (rx-peek)))
              (let [d3 (- (rx-peek) RX-ZERO)]
                (rx-advance!)
                (+ (* d1 64) (+ (* d2 8) d3)))
              (+ (* d1 8) d2)))
        d1)))

;; CharacterEscape after `\` for the letters every context shares: ControlEscape, `c`, `0`, `x`,
;; `u`. Returns the character, RX-INVALID when `e` is not one of these letters (nothing consumed),
;; and reports the strict-mode errors itself. In the web-compat grammar an unusable `\c` leaves the
;; `c` unconsumed and yields a literal backslash.
(defn rx-character-escape! [(e i64) (in-class bool)] (-> i64)
  (let [st (rx-state)]
    (if (= e RX-LOWER-F)
        (do (rx-advance!) RX-FF)
        (if (= e RX-LOWER-N)
            (do (rx-advance!) RX-LF)
            (if (= e RX-LOWER-R)
                (do (rx-advance!) RX-CR)
                (if (= e RX-LOWER-T)
                    (do (rx-advance!) RX-TAB)
                    (if (= e RX-LOWER-V)
                        (do (rx-advance!) RX-VT)
                        (if (= e RX-LOWER-C)
                            (let [l (rx-peek-at 1)]
                              (if (rx-ascii-letter? l)
                                  (do (rx-advance-by! 2) (primitive/iand l 31))
                                  (if (and (not (.unicode st)) in-class (or (rx-digit? l) (= l RX-UNDERSCORE)))
                                      (do (rx-advance-by! 2) (primitive/iand l 31))
                                      (if (.unicode st)
                                          (do (rx-error! "regex: invalid control escape") 0)
                                          RX-BACKSLASH))))
                            (if (= e RX-ZERO)
                                (do
                                  (rx-advance!)
                                  (if (rx-digit? (rx-peek))
                                      (if (.unicode st)
                                          (do (rx-error! "regex: invalid decimal escape") 0)
                                          (do
                                            (if (rx-octal? (rx-peek)) (rx-legacy-octal!) 0)))
                                      0))
                                (if (= e RX-LOWER-X)
                                    (let [h0 (rx-hex-value (rx-peek-at 1))
                                          h1 (rx-hex-value (rx-peek-at 2))]
                                      (if (and (>= h0 0) (>= h1 0))
                                          (do (rx-advance-by! 3) (+ (* h0 16) h1))
                                          (if (.unicode st)
                                              (do (rx-error! "regex: invalid hexadecimal escape") 0)
                                              (do (rx-advance!) RX-LOWER-X))))
                                    (if (= e RX-LOWER-U)
                                        (do
                                          (rx-advance!)
                                          (let [value (rx-unicode-escape! (.unicode st) (.unicode st))]
                                            (if (>= value 0)
                                                value
                                                (if (.unicode st)
                                                    (do (rx-error! "regex: invalid unicode escape") 0)
                                                    RX-LOWER-U))))
                                        RX-INVALID)))))))))))

;; IdentityEscape after `\`: in the strict grammar only a SyntaxCharacter or `/`; in web-compat
;; any character except `c` (handled before) and, once named groups exist, `k`.
(defn rx-identity-escape! [(e i64)] (-> i64)
  (let [st (rx-state)]
    (if (.unicode st)
        (if (or (rx-syntax-char? e) (= e RX-SLASH))
            (do (rx-advance!) e)
            (do (rx-error! "regex: invalid identity escape") 0))
        (if (and (= e RX-LOWER-K) (.named st))
            (do (rx-error! "regex: invalid named reference") 0)
            (do (rx-advance!) e)))))

;; UnicodePropertyValueExpression after `\p` or `\P`, in the strict grammars only. Returns whether
;; the property may match strings (the `v`-mode properties of strings).
(defn rx-property! [(negated bool)] (-> bool)
  (let [st (rx-state)]
    (if (not (rx-take-is? RX-LBRACE))
        (do (rx-error! "regex: property escape requires braces") false)
        (let [name-lo (.pos st)]
          (loop (if (rx-property-name-char? (rx-peek)) (do (rx-advance!) (continue)) (break 0)))
          (let [name-hi (.pos st)]
            (if (rx-take-is? RX-EQ)
                (let [value-lo (.pos st)]
                  (loop (if (rx-property-name-char? (rx-peek)) (do (rx-advance!) (continue)) (break 0)))
                  (let [value-hi (.pos st)]
                    (if (not (rx-take-is? RX-RBRACE))
                        (do (rx-error! "regex: unterminated property escape") false)
                        (do
                          (if (or (rx-span-is? name-lo name-hi "General_Category") (rx-span-is? name-lo name-hi "gc"))
                              (if (rx-table-has? RX-GENERAL-CATEGORIES value-lo value-hi)
                                  0
                                  (rx-error! "regex: unknown General_Category value"))
                              (if (or (rx-span-is? name-lo name-hi "Script")
                                      (rx-span-is? name-lo name-hi "sc")
                                      (rx-span-is? name-lo name-hi "Script_Extensions")
                                      (rx-span-is? name-lo name-hi "scx"))
                                  (if (rx-table-has? RX-SCRIPTS value-lo value-hi)
                                      0
                                      (rx-error! "regex: unknown Script value"))
                                  (rx-error! "regex: unknown property name")))
                          false))))
                (if (not (rx-take-is? RX-RBRACE))
                    (do (rx-error! "regex: unterminated property escape") false)
                    (if (or (rx-table-has? RX-GENERAL-CATEGORIES name-lo name-hi)
                            (rx-table-has? RX-BINARY-PROPERTIES name-lo name-hi))
                        false
                        (if (rx-table-has? RX-STRING-PROPERTIES name-lo name-hi)
                            (if (not (.sets st))
                                (do (rx-error! "regex: property of strings requires the v flag") false)
                                (if negated
                                    (do (rx-error! "regex: negated property of strings") false)
                                    true))
                            (do (rx-error! "regex: unknown property name") false))))))))))

;; ---------------------------------------------------------------------------
;; Group names

;; Whether a code point may start or continue a RegExpIdentifierName. ASCII is decided here; the
;; ID_Start/ID_Continue tables for the rest are not in this compiler yet, so a non-ASCII code point
;; other than ZWNJ/ZWJ is an unknown, never a guess. Surrogate code points are never identifiers.
(defn rx-identifier-char! [(cp i64) (start bool)] (-> bool)
  (if (or (= cp RX-DOLLAR) (= cp RX-UNDERSCORE) (rx-ascii-letter? cp))
      true
      (if (rx-digit? cp)
          (not start)
          (if (or (= cp RX-ZWNJ) (= cp RX-ZWJ))
              (not start)
              (if (or (< cp 128) (and (>= cp RX-LEAD-LO) (<= cp RX-TRAIL-HI)))
                  false
                  (do (rx-unknown! "regex: non-ASCII group name needs ID_Start/ID_Continue tables") false))))))

;; GroupName :: < RegExpIdentifierName >, decoded into the name pool. Returns the pool span start;
;; the end is the pool length. Escapes here always take the strict `\u` forms.
(defn rx-group-name! [] (-> i64)
  (let [st (rx-state)
        pool-lo (len (.name-pool st))]
    (if (not (rx-take-is? RX-LT))
        (do (rx-error! "regex: expected group name") pool-lo)
        (do
          (loop (if (rx-failed?)
                    (break 0)
                    (let [c (rx-peek)]
                      (if (= c RX-GT)
                          (break (do (rx-advance!) 0))
                          (if (= c RX-EOF)
                              (break (rx-error! "regex: unterminated group name"))
                              (let [start (= (len (.name-pool st)) pool-lo)
                                    cp
                                      (if (= c RX-BACKSLASH)
                                          (if (= (rx-peek-at 1) RX-LOWER-U)
                                              (do
                                                (rx-advance-by! 2)
                                                (let [v (rx-unicode-escape! true true)]
                                                  (if (>= v 0) v (do (rx-error! "regex: invalid group name escape") 0))))
                                              (do (rx-error! "regex: invalid group name escape") 0))
                                          (if (and (>= c RX-LEAD-LO)
                                                   (<= c RX-LEAD-HI)
                                                   (>= (rx-peek-at 1) RX-TRAIL-LO)
                                                   (<= (rx-peek-at 1) RX-TRAIL-HI))
                                              (let [v
                                                      (+ 65536
                                                         (+ (* (- c RX-LEAD-LO) 1024) (- (rx-peek-at 1) RX-TRAIL-LO)))]
                                                (rx-advance-by! 2)
                                                v)
                                              (do (rx-advance!) c)))]
                                (if (rx-failed?)
                                    (break 0)
                                    (if (rx-identifier-char! cp start)
                                        (do (push! [i64] (mut (.name-pool st)) cp) (continue))
                                        (break (if (rx-failed?) 0 (rx-error! "regex: invalid group name")))))))))))
          (if (and (not (rx-failed?)) (= (len (.name-pool st)) pool-lo))
              (rx-error! "regex: empty group name")
              0)
          pool-lo))))

(defn rx-names-equal? [(a-lo i64) (a-hi i64) (b-lo i64) (b-hi i64)] (-> bool)
  (if (!= (- a-hi a-lo) (- b-hi b-lo))
      false
      (let [pool (.name-pool (rx-state))
            (mut k) 0
            (mut same) true]
        (loop (if (or (not (load same)) (>= (load k) (- a-hi a-lo)))
                  (break 0)
                  (do
                    (if (!= (get pool (+ a-lo (load k))) (get pool (+ b-lo (load k)))) (set! (mut same) false) 0)
                    (set! (mut k) (+ (load k) 1))
                    (continue))))
        (load same))))

;; MightBothParticipate: two groups are exclusive only if some disjunction they both sit in places
;; them in different alternatives.
(defn rx-might-both-participate? [(a RegexDecl) (b RegexDecl)] (-> bool)
  (let [pool (.path-pool (rx-state))
        a-len (- (.path-hi a) (.path-lo a))
        b-len (- (.path-hi b) (.path-lo b))
        common (if (< a-len b-len) a-len b-len)
        (mut k) 0
        (mut verdict) true
        (mut decided) false]
    (loop (if (or (load decided) (>= (load k) common))
              (break 0)
              (let [a-disj (get pool (+ (.path-lo a) (load k)))
                    b-disj (get pool (+ (.path-lo b) (load k)))
                    a-alt (get pool (+ (.path-lo a) (+ (load k) 1)))
                    b-alt (get pool (+ (.path-lo b) (+ (load k) 1)))]
                (if (!= a-disj b-disj)
                    (set! (mut decided) true)
                    (if (!= a-alt b-alt)
                        (do (set! (mut verdict) false) (set! (mut decided) true))
                        0))
                (set! (mut k) (+ (load k) 2))
                (continue))))
    (load verdict)))

(defn rx-declare-group! [(name-lo i64)] (-> i64)
  (let [st (rx-state)
        name-hi (len (.name-pool st))
        path-lo (len (.path-pool st))
        (mut d) (primitive/zeroed RegexDecl)]
    (al-for [p (.path st)] (push! [i64] (mut (.path-pool st)) p))
    (set! (.lo (mut d)) name-lo)
    (set! (.hi (mut d)) name-hi)
    (set! (.path-lo (mut d)) path-lo)
    (set! (.path-hi (mut d)) (len (.path-pool st)))
    (al-for [earlier (.decls st)]
            (let [e earlier]
              (if (and (rx-names-equal? (.lo e) (.hi e) name-lo name-hi)
                       (rx-might-both-participate? e (load d)))
                  (rx-error! "regex: duplicate capture group name")
                  0)))
    (push! [RegexDecl] (mut (.decls st)) (load d))
    0))

(defn rx-reference-group! [(name-lo i64)] (-> i64)
  (let [st (rx-state)
        (mut r) (primitive/zeroed RegexRef)]
    (set! (.lo (mut r)) name-lo)
    (set! (.hi (mut r)) (len (.name-pool st)))
    (push! [RegexRef] (mut (.refs st)) (load r))
    0))

(defn rx-check-references! [] (-> i64)
  (let [st (rx-state)]
    (al-for [r (.refs st)]
            (let [ref r
                  (mut found) false]
              (al-for [d (.decls st)]
                      (let [decl d]
                        (if (rx-names-equal? (.lo decl) (.hi decl) (.lo ref) (.hi ref)) (set! (mut found) true) 0)))
              (if (load found) 0 (rx-error! "regex: reference to an undefined group name"))))
    0))

;; ---------------------------------------------------------------------------
;; Quantifiers

;; `{` DecimalDigits `}` | `{` DecimalDigits `,}` | `{` DecimalDigits `,` DecimalDigits `}` at the
;; current position, without consuming. Returns the length of the braced text, or 0 when it is not a
;; quantifier; `out-of-order` is set when both bounds exist and min > max.
(defn rx-braced-quantifier-length [(out-of-order (mut bool))] (-> i64)
  (let [(mut k) 1
        (mut min) 0
        (mut min-digits) 0]
    (loop (if (rx-digit? (rx-peek-at (load k)))
              (do
                (if (< (load min) RX-QUANTIFIER-CAP)
                    (set! (mut min) (+ (* (load min) 10) (- (rx-peek-at (load k)) RX-ZERO)))
                    0)
                (set! (mut min-digits) (+ (load min-digits) 1))
                (set! (mut k) (+ (load k) 1))
                (continue))
              (break 0)))
    (if (= (load min-digits) 0)
        0
        (if (= (rx-peek-at (load k)) RX-RBRACE)
            (+ (load k) 1)
            (if (!= (rx-peek-at (load k)) RX-COMMA)
                0
                (let [(mut max) 0
                      (mut max-digits) 0]
                  (set! (mut k) (+ (load k) 1))
                  (loop (if (rx-digit? (rx-peek-at (load k)))
                            (do
                              (if (< (load max) RX-QUANTIFIER-CAP)
                                  (set! (mut max) (+ (* (load max) 10) (- (rx-peek-at (load k)) RX-ZERO)))
                                  0)
                              (set! (mut max-digits) (+ (load max-digits) 1))
                              (set! (mut k) (+ (load k) 1))
                              (continue))
                            (break 0)))
                  (if (!= (rx-peek-at (load k)) RX-RBRACE)
                      0
                      (do
                        (if (and (> (load max-digits) 0) (> (load min) (load max))) (set! out-of-order true) 0)
                        (+ (load k) 1)))))))))

;; Quantifier after an atom; returns whether one was consumed. A `{` that is not a quantifier is an
;; error in the strict grammar and a literal (left for the next term) in web-compat.
(defn rx-quantifier-opt! [] (-> bool)
  (let [st (rx-state)
        c (rx-peek)]
    (if (or (= c RX-STAR) (= c RX-PLUS) (= c RX-QUESTION))
        (do
          (rx-advance!)
          (rx-take-is? RX-QUESTION)
          true)
        (if (= c RX-LBRACE)
            (let [(mut bad-order) false
                  length (rx-braced-quantifier-length (mut bad-order))]
              (if (= length 0)
                  (if (.unicode st)
                      (do (rx-error! "regex: incomplete quantifier") false)
                      false)
                  (do
                    (if (load bad-order) (rx-error! "regex: quantifier range out of order") 0)
                    (rx-advance-by! length)
                    (rx-take-is? RX-QUESTION)
                    true)))
            false))))

;; ---------------------------------------------------------------------------
;; Character classes (`u` and web-compat grammars)

;; ClassAtom: a character value, RX-CLASS-ESCAPE for `\d`-style escapes.
(defn rx-class-atom! [] (-> i64)
  (let [st (rx-state)
        c (rx-peek)]
    (if (!= c RX-BACKSLASH)
        (do (rx-advance!) c)
        (let [e (rx-peek-at 1)]
          (rx-advance!)
          (if (= e RX-EOF)
              (do (rx-error! "regex: \\ at end of pattern") 0)
              (if (= e RX-LOWER-B)
                  (do (rx-advance!) RX-BACKSPACE)
                  (if (= e RX-MINUS)
                      (do (rx-advance!) RX-MINUS)
                      (if (or (= e RX-LOWER-D)
                              (= e RX-UPPER-D)
                              (= e RX-LOWER-S)
                              (= e RX-UPPER-S)
                              (= e RX-LOWER-W)
                              (= e RX-UPPER-W))
                          (do (rx-advance!) RX-CLASS-ESCAPE)
                          (if (and (or (= e RX-LOWER-P) (= e RX-UPPER-P)) (.unicode st))
                              (do (rx-advance!) (rx-property! (= e RX-UPPER-P)) RX-CLASS-ESCAPE)
                              (if (and (rx-digit? e) (!= e RX-ZERO))
                                  (if (.unicode st)
                                      (do (rx-error! "regex: invalid class escape") 0)
                                      (if (rx-octal? e)
                                          (rx-legacy-octal!)
                                          (do (rx-advance!) e)))
                                  (if (= e RX-LOWER-K)
                                      (if (or (.unicode st) (.named st))
                                          (do (rx-error! "regex: invalid class escape") 0)
                                          (do (rx-advance!) e))
                                      (let [v (rx-character-escape! e true)]
                                        (if (= v RX-INVALID) (rx-identity-escape! e) v)))))))))))))

;; NonemptyClassRanges: atoms and `a-b` ranges until `]`. Class escapes may not bound a range in the
;; strict grammar; web-compat reads such a `-` literally.
(defn rx-class! [] (-> i64)
  (let [st (rx-state)]
    (rx-advance!)
    (rx-take-is? RX-CARET)
    (loop (if (rx-failed?)
              (break 0)
              (let [c (rx-peek)]
                (if (= c RX-RBRACKET)
                    (break (do (rx-advance!) 0))
                    (if (= c RX-EOF)
                        (break (rx-error! "regex: unterminated character class"))
                        (let [a (rx-class-atom!)]
                          (if (and (not (rx-failed?))
                                   (= (rx-peek) RX-MINUS)
                                   (!= (rx-peek-at 1) RX-RBRACKET)
                                   (!= (rx-peek-at 1) RX-EOF))
                              (do
                                (rx-advance!)
                                (let [b (rx-class-atom!)]
                                  (if (or (= a RX-CLASS-ESCAPE) (= b RX-CLASS-ESCAPE))
                                      (if (.unicode st) (rx-error! "regex: class escape in character range") 0)
                                      (if (> a b) (rx-error! "regex: character range out of order") 0))))
                              0)
                          (continue)))))))
    0))

;; ---------------------------------------------------------------------------
;; ClassSetExpressions (`v` grammar)

;; ClassSetCharacter at the current position, or RX-INVALID (nothing consumed) when the next thing
;; is a nested class, `\q{…}`, a class escape or a property escape.
(defn rx-class-set-character! [] (-> i64)
  (let [c (rx-peek)]
    (if (= c RX-BACKSLASH)
        (let [e (rx-peek-at 1)]
          (if (or (= e RX-LOWER-D)
                  (= e RX-UPPER-D)
                  (= e RX-LOWER-S)
                  (= e RX-UPPER-S)
                  (= e RX-LOWER-W)
                  (= e RX-UPPER-W)
                  (= e RX-LOWER-P)
                  (= e RX-UPPER-P)
                  (= e RX-LOWER-Q))
              RX-INVALID
              (do
                (rx-advance!)
                (if (= e RX-EOF)
                    (do (rx-error! "regex: \\ at end of pattern") 0)
                    (if (= e RX-LOWER-B)
                        (do (rx-advance!) RX-BACKSPACE)
                        (if (rx-class-set-reserved-punct? e)
                            (do (rx-advance!) e)
                            (let [v (rx-character-escape! e true)]
                              (if (= v RX-INVALID) (rx-identity-escape! e) v))))))))
        (if (or (= c RX-LBRACKET) (= c RX-EOF))
            RX-INVALID
            (if (rx-class-set-syntax-char? c)
                (do (rx-error! "regex: unescaped class set syntax character") 0)
                (if (rx-at-double-punct?)
                    (do (rx-error! "regex: reserved double punctuator in class set") 0)
                    (do (rx-advance!) c)))))))

;; ClassStringDisjunction `\q{a|bc|}`; strings unless every alternative is exactly one character.
(defn rx-class-string-disjunction! [] (-> bool)
  (do
    (rx-advance-by! 2)
    (if (not (rx-take-is? RX-LBRACE))
        (do (rx-error! "regex: \\q requires braces") false)
        (let [(mut strings) false
              (mut count) 0]
          (loop (if (rx-failed?)
                    (break 0)
                    (let [c (rx-peek)]
                      (if (or (= c RX-RBRACE) (= c RX-BAR))
                          (do
                            (rx-advance!)
                            (if (!= (load count) 1) (set! (mut strings) true) 0)
                            (set! (mut count) 0)
                            (if (= c RX-RBRACE) (break 0) (continue)))
                          (if (= c RX-EOF)
                              (break (rx-error! "regex: unterminated \\q string"))
                              (let [v (rx-class-set-character!)]
                                (if (= v RX-INVALID)
                                    (break (rx-error! "regex: invalid character in \\q string"))
                                    (do (set! (mut count) (+ (load count) 1)) (continue)))))))))
          (load strings)))))

;; ClassSetOperand, plus a ClassSetRange when the union grammar allows one. Returns MayContainStrings.
(defn rx-class-set-operand! [(allow-range bool)] (-> bool)
  (let [st (rx-state)
        c (rx-peek)]
    (if (= c RX-LBRACKET)
        (rx-class-set!)
        (if (and (= c RX-BACKSLASH) (= (rx-peek-at 1) RX-LOWER-Q))
            (rx-class-string-disjunction!)
            (if (and (= c RX-BACKSLASH)
                     (or (= (rx-peek-at 1) RX-LOWER-D)
                         (= (rx-peek-at 1) RX-UPPER-D)
                         (= (rx-peek-at 1) RX-LOWER-S)
                         (= (rx-peek-at 1) RX-UPPER-S)
                         (= (rx-peek-at 1) RX-LOWER-W)
                         (= (rx-peek-at 1) RX-UPPER-W)))
                (do (rx-advance-by! 2) false)
                (if (and (= c RX-BACKSLASH) (or (= (rx-peek-at 1) RX-LOWER-P) (= (rx-peek-at 1) RX-UPPER-P)))
                    (let [negated (= (rx-peek-at 1) RX-UPPER-P)]
                      (rx-advance-by! 2)
                      (rx-property! negated))
                    (let [a (rx-class-set-character!)]
                      (if (rx-failed?)
                          false
                          (if (= a RX-INVALID)
                              (do (rx-error! "regex: expected a class set operand") false)
                              (do
                                (if (and allow-range (= (rx-peek) RX-MINUS) (!= (rx-peek-at 1) RX-MINUS))
                                    (do
                                      (rx-advance!)
                                      (let [b (rx-class-set-character!)]
                                        (if (rx-failed?)
                                            0
                                            (if (= b RX-INVALID)
                                                (rx-error! "regex: invalid class set range end")
                                                (if (> a b) (rx-error! "regex: character range out of order") 0)))))
                                    0)
                                false))))))))))

;; `[` `^`? ClassContents `]` under the `v` grammar. Returns MayContainStrings of the class.
(defn rx-class-set! [] (-> bool)
  (let [st (rx-state)]
    (rx-advance!)
    (let [negated (rx-take-is? RX-CARET)]
      (if (rx-take-is? RX-RBRACKET)
          false
          (let [(mut strings) (rx-class-set-operand! true)
                mode
                  (if (rx-failed?)
                      SET-UNION
                      (if (and (= (rx-peek) RX-AMP) (= (rx-peek-at 1) RX-AMP))
                          SET-INTERSECTION
                          (if (and (= (rx-peek) RX-MINUS) (= (rx-peek-at 1) RX-MINUS))
                              SET-SUBTRACTION
                              SET-UNION)))]
            (loop (if (rx-failed?)
                      (break 0)
                      (let [c (rx-peek)]
                        (if (= c RX-RBRACKET)
                            (break (do (rx-advance!) 0))
                            (if (= c RX-EOF)
                                (break (rx-error! "regex: unterminated character class"))
                                (if (= mode SET-UNION)
                                    (if (or (and (= c RX-AMP) (= (rx-peek-at 1) RX-AMP))
                                            (and (= c RX-MINUS) (= (rx-peek-at 1) RX-MINUS)))
                                        (break (rx-error! "regex: class set operator inside a union"))
                                        (do
                                          (if (rx-class-set-operand! true) (set! (mut strings) true) 0)
                                          (continue)))
                                    (let [op (if (= mode SET-INTERSECTION) RX-AMP RX-MINUS)]
                                      (if (not (and (= c op) (= (rx-peek-at 1) op)))
                                          (break (rx-error! "regex: mixed class set operators"))
                                          (do
                                            (rx-advance-by! 2)
                                            (if (= (rx-peek) op)
                                                (break (rx-error! "regex: reserved double punctuator in class set"))
                                                (let [s (rx-class-set-operand! false)]
                                                  (if (= mode SET-INTERSECTION)
                                                      (set! (mut strings) (and (load strings) s))
                                                      0)
                                                  (continue))))))))))))
            (if (and (not (rx-failed?)) negated (load strings))
                (rx-error! "regex: negated class may contain strings")
                0)
            (if negated false (load strings)))))))

;; ---------------------------------------------------------------------------
;; Atoms and terms

;; AtomEscape after `\`, outside a class and after `\b`/`\B` are excluded.
(defn rx-atom-escape! [] (-> i64)
  (let [st (rx-state)
        e (rx-peek)]
    (if (= e RX-EOF)
        (rx-error! "regex: \\ at end of pattern")
        (if (and (rx-digit? e) (!= e RX-ZERO))
            ;; DecimalEscape: a backreference, or in web-compat with too few groups a legacy escape.
            (let [(mut n) 0
                  (mut k) 0]
              (loop (if (rx-digit? (rx-peek-at (load k)))
                        (do
                          (if (< (load n) RX-QUANTIFIER-CAP)
                              (set! (mut n) (+ (* (load n) 10) (- (rx-peek-at (load k)) RX-ZERO)))
                              0)
                          (set! (mut k) (+ (load k) 1))
                          (continue))
                        (break 0)))
              (if (<= (load n) (.group-count st))
                  (rx-advance-by! (load k))
                  (if (or (.unicode st) (.named st))
                      (rx-error! "regex: backreference to a nonexistent group")
                      (if (rx-octal? e) (do (rx-legacy-octal!) 0) (rx-advance!)))))
            (if (or (= e RX-LOWER-D)
                    (= e RX-UPPER-D)
                    (= e RX-LOWER-S)
                    (= e RX-UPPER-S)
                    (= e RX-LOWER-W)
                    (= e RX-UPPER-W))
                (rx-advance!)
                (if (and (or (= e RX-LOWER-P) (= e RX-UPPER-P)) (.unicode st))
                    (do (rx-advance!) (rx-property! (= e RX-UPPER-P)) 0)
                    (if (= e RX-LOWER-K)
                        (if (or (.unicode st) (.named st))
                            (do (rx-advance!) (rx-reference-group! (rx-group-name!)))
                            (rx-advance!))
                        (if (= e RX-MINUS)
                            (if (.unicode st) (rx-error! "regex: invalid identity escape") (rx-advance!))
                            (let [v (rx-character-escape! e false)]
                              (if (= v RX-INVALID) (do (rx-identity-escape! e) 0) 0))))))))))

;; RegularExpressionModifiers after `(?`: `ims` add set, optional `-` remove set, then `:`.
(defn rx-modifiers! [] (-> i64)
  (let [(mut seen-i) false
        (mut seen-m) false
        (mut seen-s) false
        (mut count) 0
        (mut dash) false
        (mut before-dash) 0]
    (loop (let [c (rx-peek)]
            (if (or (= c RX-LOWER-I) (= c RX-LOWER-M) (= c RX-LOWER-S))
                (do
                  (if (or (and (= c RX-LOWER-I) (load seen-i))
                          (and (= c RX-LOWER-M) (load seen-m))
                          (and (= c RX-LOWER-S) (load seen-s)))
                      (rx-error! "regex: repeated modifier")
                      0)
                  (if (= c RX-LOWER-I)
                      (set! (mut seen-i) true)
                      (if (= c RX-LOWER-M) (set! (mut seen-m) true) (set! (mut seen-s) true)))
                  (set! (mut count) (+ (load count) 1))
                  (rx-advance!)
                  (continue))
                (if (and (= c RX-MINUS) (not (load dash)))
                    (do
                      (set! (mut dash) true)
                      (set! (mut before-dash) (load count))
                      (rx-advance!)
                      (continue))
                    (break 0)))))
    (if (and (load dash) (= (load before-dash) 0) (= (load count) 0))
        (rx-error! "regex: modifiers group with nothing to add or remove")
        0)
    (if (not (rx-take-is? RX-COLON)) (rx-error! "regex: invalid group") 0)
    0))

;; `(` … `)` in every form. Returns the GROUP-* kind that decides whether a quantifier may follow.
(defn rx-group! [] (-> i64)
  (let [st (rx-state)]
    (rx-advance!)
    (let [kind
            (if (not (rx-take-is? RX-QUESTION))
                (do (rx-disjunction!) GROUP-CAPTURING)
                (let [c (rx-peek)]
                  (if (or (= c RX-EQ) (= c RX-BANG))
                      (do (rx-advance!) (rx-disjunction!) GROUP-LOOKAHEAD)
                      (if (= c RX-LT)
                          (if (or (= (rx-peek-at 1) RX-EQ) (= (rx-peek-at 1) RX-BANG))
                              (do (rx-advance-by! 2) (rx-disjunction!) GROUP-LOOKBEHIND)
                              (do
                                (rx-declare-group! (rx-group-name!))
                                (rx-disjunction!)
                                GROUP-CAPTURING))
                          (if (= c RX-COLON)
                              (do (rx-advance!) (rx-disjunction!) GROUP-CAPTURING)
                              (if (or (= c RX-LOWER-I) (= c RX-LOWER-M) (= c RX-LOWER-S) (= c RX-MINUS))
                                  (do (rx-modifiers!) (rx-disjunction!) GROUP-CAPTURING)
                                  (do (rx-error! "regex: invalid group") GROUP-CAPTURING)))))))]
      (if (rx-failed?)
          0
          (if (not (rx-take-is? RX-RPAREN)) (rx-error! "regex: unterminated group") 0))
      kind)))

;; One Term: an Assertion, or an Atom with an optional Quantifier.
(defn rx-term! [] (-> i64)
  (let [st (rx-state)
        c (rx-peek)]
    (if (or (= c RX-CARET) (= c RX-DOLLAR))
        (do
          (rx-advance!)
          (if (rx-quantifier-opt!) (rx-error! "regex: nothing to repeat") 0))
        (if (and (= c RX-BACKSLASH) (or (= (rx-peek-at 1) RX-LOWER-B) (= (rx-peek-at 1) RX-UPPER-B)))
            (do
              (rx-advance-by! 2)
              (if (rx-quantifier-opt!) (rx-error! "regex: nothing to repeat") 0))
            (if (= c RX-BACKSLASH)
                (do
                  (rx-advance!)
                  (rx-atom-escape!)
                  (if (rx-failed?) 0 (do (rx-quantifier-opt!) 0)))
                (if (= c RX-LPAREN)
                    (let [kind (rx-group!)]
                      (if (rx-failed?)
                          0
                          (let [quantified (rx-quantifier-opt!)]
                            (if (and quantified
                                     (or (= kind GROUP-LOOKBEHIND) (and (= kind GROUP-LOOKAHEAD) (.unicode st))))
                                (rx-error! "regex: quantified assertion")
                                0))))
                    (if (= c RX-LBRACKET)
                        (do
                          (if (.sets st) (do (rx-class-set!) 0) (rx-class!))
                          (if (rx-failed?) 0 (do (rx-quantifier-opt!) 0)))
                        (if (or (= c RX-STAR) (= c RX-PLUS) (= c RX-QUESTION))
                            (rx-error! "regex: nothing to repeat")
                            (if (= c RX-LBRACE)
                                (if (.unicode st)
                                    (rx-error! "regex: lone quantifier brackets")
                                    (let [(mut bad-order) false]
                                      (if (> (rx-braced-quantifier-length (mut bad-order)) 0)
                                          (rx-error! "regex: nothing to repeat")
                                          (do (rx-advance!) (rx-quantifier-opt!) 0))))
                                (if (or (= c RX-RBRACE) (= c RX-RBRACKET))
                                    (if (.unicode st)
                                        (rx-error! "regex: lone quantifier brackets")
                                        (do (rx-advance!) (rx-quantifier-opt!) 0))
                                    ;; PatternCharacter, `.` included.
                                    (do (rx-advance!) (rx-quantifier-opt!) 0)))))))))))

;; Alternative :: Term*, ending at `|`, `)` or the end of the pattern.
(defn rx-alternative! [] (-> i64)
  (do
    (loop (if (rx-failed?)
              (break 0)
              (let [c (rx-peek)]
                (if (or (= c RX-EOF) (= c RX-BAR) (= c RX-RPAREN))
                    (break 0)
                    (do (rx-term!) (continue))))))
    0))

;; Disjunction :: Alternative ( `|` Alternative )*, tracked for MightBothParticipate.
(defn rx-disjunction! [] (-> i64)
  (let [st (rx-state)]
    (set! (.disj-counter st) (+ (.disj-counter st) 1))
    (push! [i64] (mut (.path st)) (.disj-counter st))
    (push! [i64] (mut (.path st)) 0)
    (let [alt-index (- (len (.path st)) 1)]
      (loop (do
              (rx-alternative!)
              (if (and (not (rx-failed?)) (rx-take-is? RX-BAR))
                  (do
                    (set! (mut (.path st)) alt-index (+ (get (.path st) alt-index) 1))
                    (continue))
                  (break 0)))))
    (pop! [i64] (mut (.path st)))
    (pop! [i64] (mut (.path st)))
    0))

;; ---------------------------------------------------------------------------
;; Entry

;; Validate a RegularExpressionLiteral's body under its flags. The flags themselves are checked by
;; the parser; only `u` and `v` matter here.
(defn regex-validate [(body (slice u8)) (flags (slice u8))] (-> RegexVerdict)
  (let [(mut unicode) false
        (mut sets) false]
    (for c
      (iter flags)
      (do
        (if (= c (cast u8 RX-LOWER-U)) (set! (mut unicode) true) 0)
        (if (= c (cast u8 RX-LOWER-V)) (do (set! (mut unicode) true) (set! (mut sets) true)) 0)))
    (rx-reset! (load unicode) (load sets))
    (rx-decode! body)
    (if (rx-failed?)
        0
        (do
          (rx-prescan!)
          (rx-disjunction!)
          (if (rx-failed?)
              0
              (if (not (rx-at-end?))
                  (rx-error! "regex: unmatched )")
                  (rx-check-references!)))))
    (let [st (rx-state)]
      (match (.error st)
        (Some [m] (RegexError m))
        (None []
              (match (.unknown st)
                (Some [m] (RegexUnknown m))
                (None [] (RegexOk))))))))
