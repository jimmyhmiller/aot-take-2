;; The recursive-descent JS/TS parser. Source text in, sea-of-nodes IR out.

;;
;; THERE IS NO AST. The parser drives `aot.node.scope` directly, so a variable read is a slot
;; lookup that yields the node currently defining it and an assignment is a slot update — SSA is
;; constructed as a side effect of parsing rather than by a later pass. This is Simple's central
;; trick and the reason its parser is worth following closely.
;;
;; Every construct here is a shape of graph, not a shape of tree:
;;
;;   if/else          dup the scope, parse both arms, merge; Phis appear only where the arms differ
;;   while/for        the loop protocol in `aot.node.scope` — dup, build, close Phis, THEN wire the
;;                    control back edge. In that order or the loop is deleted with no error.
;;   && || ?:         short-circuit is a diamond, so these are `if` with a value
;;   try/catch        an exceptional edge (`aot.node.exception`); `finally` is duplicated onto
;;                    every path that leaves the block
;;   typeof x === "n" a guard, which is why `aot.node.scope`'s `scope-add-guards!` exists: the
;;                    narrowed value is installed in the slot on the taken edge
;;
;; TypeScript annotations are parsed by `aot.parse.tstype` and attached as DECLARED types. Declared
;; is not proven — see `aot.codegen.opto`.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S2.
(module aot.parse.parser)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(defn parse-program [(src (slice u8))] (-> (dyn NodeOps))
  (do (unimplemented "parse-program" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-statement [] (-> (dyn NodeOps))
  (do (unimplemented "parse-statement" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-expression [] (-> (dyn NodeOps))
  (do (unimplemented "parse-expression" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-if [] (-> (dyn NodeOps))
  (do (unimplemented "parse-if" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-loop [] (-> (dyn NodeOps))
  (do (unimplemented "parse-loop" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-function [] (-> (dyn NodeOps))
  (do (unimplemented "parse-function" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-class [] (-> (dyn NodeOps))
  (do (unimplemented "parse-class" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-try [] (-> (dyn NodeOps))
  (do (unimplemented "parse-try" "S2 — src/parse/parser.coil") (unreachable-node)))
