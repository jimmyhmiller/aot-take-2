;; The recursive-descent JS/TS parser. Source text in, sea-of-nodes IR out.

;;
;; JavaScript first needs the thin syntax-only tree specified in docs/FRONTEND.md for cover
;; grammars, hoisting, forward type names and capture discovery. There is still NO typed AST or
;; second semantic IR. One lowering walk drives `aot.node.scope` directly, so a variable read is a
;; slot lookup that yields the node currently defining it and an assignment is a slot update — SSA
;; is constructed as a side effect of lowering rather than by a later pass. This preserves Simple's
;; central trick while accommodating syntax that cannot be committed on first token sight.
;;
;; Every construct here is a shape of graph, not a shape of tree:
;;
;;   if/else          dup the scope, lower both arms, merge; Phis appear only where the arms differ
;;   while            the loop protocol in `aot.node.scope` — dup, build, then finalize through
;;                    `scope-end-loop!`, which wires control and immediately fills Phi backedges
;;   ?:               a full Scope diamond with a value Phi pinned to the merged Region
;;
;; Logical expressions use the same Scope diamond and keep their original operand value.
;; break/continue exit through pruned Scope merges into one labelled jump-target stack.
;; Exception unwinding and source-level narrowing remain unimplemented.
;;
;; Final Simple's `parseTrinary` builds the If and both CProjs, duplicates the current Scope for the
;; false arm before parsing the true arm, keeps each arm result across the opposing construction
;; window, restores the false Scope, then balances and merges the complete Scopes. The value Phi is
;; pinned to the Region produced by that merge. We preserve that order; in particular, memory is a
;; Scope slot and therefore joins with arm control rather than following the arm lowered last.
;;
;; Simple's `addReturn` keeps control, memory, and expression in a pruned return Scope until every
;; exit merges. We preserve that lifetime and merge shape in a function-local return accumulator.
;; Bare returns and live fallthrough contribute the canonical boxed `undefined`; recording any
;; return kills only that path's current control, so later syntax is unreachable without becoming a
;; parser error and a sibling branch or loop exit remains live.
;;
;; TypeScript primitive/union annotations are retained in syntax records as unproven evidence.
;; Runtime Parm/Phi types remain dynamic: annotation-driven proof discharge and diagnostics are
;; not implemented yet. Never narrow the executable graph merely because an annotation says so.
;;
;; The admitted subset includes named function declarations, number-annotated parameters/returns,
;; numeric, string, template, regex, array and object literals (with methods and accessors),
;; `this`, `new`, `super`, member chains, calls, bindings, function expressions, arrows,
;; generators, async functions and classes as syntax, the complete operator precedence (forms
;; without production JSL refuse at lowering by name),
;; blocks, `if`/`else`, `switch`, `while`, `do-while`, classic `for`, `break`/`continue` with
;; labels and labelled statements; `for-in/of`, `throw`, `try` and `with` parse and refuse
;; lowering by name. Grammar outside that set
;; fails closed as a compiler refusal, never as a proven SyntaxError; see
;; `token-cannot-start-expression?`. Parsing first produces a THIN syntax tree, then lowering
;; constructs SSA directly. This is the required JavaScript divergence from final Simple's one-pass
;; parser: declarations are hoisted, so every Fun header exists before any body is lowered. The
;; semantic graph remains the only typed IR; syntax nodes carry spans and grammar shape, never
;; inferred types.
;;
;; Lexical declarations differ from Simple's declaration-at-use rule: instantiate the direct
;; let/const declarations of each actual lexical scope before lowering any initializer. ScopeNode
;; owns both the binding and its initialization state. Statement-only if/while bodies cannot
;; introduce lexical declarations without braces. TDZ reads/writes explicitly refuse compilation
;; until ReferenceError completions exist; they never resolve to an outer name or undefined.
(module aot.parse.parser)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use [subslice slice-data])
(import "coil.str" :use [sb-new sb-push-byte! sb-push-str! sb-push-i64! sb-str sb-free!])
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.call" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.property" :use *)
(import "aot.node.compare" :use *)
(import "aot.rt.abi" :use *)
(import "aot.rt.number" :use [number-radix-value number-strtod!])
(import "aot.node.gc" :use *)
(import "aot.node.jsops" :use *)
(import "aot.node.scope" :use *)
(import "aot.type.type" :use *)
(import "aot.shape" :use *)
(import "aot.heap" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.jsl.reader" :use [jsl-noinline?])
(import "aot.parse.lexer" :use *)
(import "aot.parse.tstype" :use *)
(import "aot.parse.regex" :use *)

;; The thin syntax tree is a pair of sum types. Every walk over it — strict early errors,
;; declaration collection, break validation, the hidden-class prepass and graph lowering — is an
;; exhaustive `match`, so adding a grammar production is a compile error at every site that has
;; not yet decided what to do with it. Records carry source spans and grammar shape only. Child
;; references are 1-based ids into the parser-owned side arrays; an absent optional child is
;; `None`, never a sentinel id. Operator variants name their JSL entry point directly.
;; One PropertyDefinition. Shorthand `{a}` is desugared to a named property valued by an
;; IdentifierReference at parse time; CoverInitializedName survives only to be reinterpreted as a
;; destructuring pattern and is otherwise a SyntaxError. Methods, accessors and generators are
;; not admitted yet and fail closed.
(defsum PropKey
  (KeyNamed [(key i64)])  ; interned shape key
  (KeyComputed [(expr i64)]))

(defsum ObjectEntry
  (PropValue [(key PropKey) (value i64)])
  (PropMethod [(key PropKey) (fun i64)])  ; method, getter or setter: see the SyntaxFun kind
  (PropSpread [(expr i64)])
  (PropCoverInit [(name (slice u8)) (init i64)]))

;; ClassElementName. Private names keep their spelling without `#`; class keys are not shape keys
;; until classes lower.
(defsum ClassKey
  (CkNamed [(name (slice u8))])
  (CkComputed [(expr i64)])
  (CkPrivate [(name (slice u8))]))

;; A field initializer and a static block each get a method-like SyntaxFun (they evaluate with a
;; home object and their own `arguments`/`await` rules); the field's initializer is that
;; function's expression body.
(defsum ClassElement
  (CeMethod [(key ClassKey) (static bool) (fun i64)])
  (CeField [(key ClassKey) (static bool) (init-fun (Option i64))])
  (CeStaticBlock [(fun i64)]))

(defstruct SyntaxClass
  [(name (slice u8))
   (heritage (Option i64))
   (elements (ArrayList ClassElement))
   (lo i64)
   (hi i64)])

;; A `.#name` or `#name in` reference awaiting the class that declares the name, and a declared
;; private name (a getter/setter pair may share one name).
(defstruct PrivateRef [(name (slice u8)) (depth i64)])

(defstruct PrivateDecl [(name (slice u8)) (static bool) (getter bool) (setter bool)])

;; Destructuring patterns. A binding pattern's leaves are names; an assignment pattern's leaves
;; may also be Reference expressions. Every element may carry a default initializer.
(defsum PatElem
  (PatHole)
  (PatItem [(pattern i64)]))

(defstruct PatProp [(key PropKey) (pattern i64)])

(defsum PatternNode
  (PatName [(name (slice u8))])
  (PatTarget [(expr i64)])  ; assignment pattern leaf: member, index or private member
  (PatObject [(props (ArrayList PatProp)) (rest (Option i64))])
  (PatArray [(elements (ArrayList PatElem)) (rest (Option i64))]))

(defstruct SyntaxPattern [(node PatternNode) (default (Option i64)) (lo i64) (hi i64)])

;; What a SyntaxFun is syntactically. Declarations hoist and name a Fun; the others are values.
(defsum FunKind
  (FunDeclaration)
  (FunExpression)
  (FunArrow)
  (FunMethod)
  (FunGetter)
  (FunSetter))

(defsum ArrayElement
  (ElemHole)
  (ElemExpr [(expr i64)])
  (ElemSpread [(expr i64)]))

(defsum SyntaxNode
  (SxNumber [(value i64) (value-float f64) (rep i64)])
  (SxString [(raw (slice u8)) (units (ArrayList i64)) (legacy-escape bool)])
  (SxName [(name (slice u8))])
  (SxSingleton [(name (slice u8))])  ; JsTrue, JsFalse, JsNull
  (SxGroup [(inner i64)])
  (SxObject [(entries (ArrayList ObjectEntry))])
  (SxArray [(elements (ArrayList ArrayElement))])
  (SxMember [(owner i64) (name (slice u8)) (optional bool)])  ; optional: this link is `?.`
  (SxIndex [(owner i64) (key i64) (optional bool)])
  (SxCall [(callee i64) (args (ArrayList i64)) (optional bool)])
  ;; The body of a standard global: a call to a JSL builtin (docs/DECISIONS.md, intrinsics).
  (SxIntrinsic [(builtin (slice u8)) (args (ArrayList i64))])
  (SxNew [(callee i64) (args (ArrayList i64))])
  (SxNewTarget)
  (SxThis)
  (SxSpread [(expr i64)])  ; only as an argument or array element
  (SxImportCall [(specifier i64) (options (Option i64))])
  (SxTemplate [(quasis (ArrayList i64)) (substitutions (ArrayList i64))])  ; quasis: SxString ids
  (SxTaggedTemplate [(tag i64) (template i64)])
  (SxRegex [(body (slice u8)) (flags (slice u8))])
  (SxFunction [(fun i64)])  ; function expression or arrow: index into the SyntaxFun table
  (SxYield [(argument (Option i64)) (delegate bool)])
  (SxAwait [(operand i64)])
  (SxSuper)  ; only as the owner of a member/index or the callee of a call
  (SxClass [(cls i64)])  ; class expression: index into the SyntaxClass table
  (SxDestructuringAssign [(pattern i64) (value i64)])
  (SxPrivateMember [(owner i64) (name (slice u8)) (optional bool)])
  (SxPrivateName [(name (slice u8))])  ; only as the left operand of `in`
  (SxUnary [(op (slice u8)) (operand i64)])
  (SxDelete [(operand i64)])
  (SxUpdate [(op (slice u8)) (prefix bool) (target i64)])
  (SxBinary [(op (slice u8)) (left i64) (right i64)])
  (SxAnd [(left i64) (right i64)])
  (SxOr [(left i64) (right i64)])
  (SxCoalesce [(left i64) (right i64)])
  (SxConditional [(condition i64) (when-true i64) (when-false i64)])
  (SxAssign [(target i64) (value i64)])
  (SxCompoundAssign [(op (slice u8)) (target i64) (value i64)])
  (SxLogicalAssign [(predicate (slice u8))
                    (rhs-on-true bool)
                    (target i64)
                    (value i64)])
  (SxComma [(left i64) (right i64)]))

(defstruct SyntaxExpr [(lo i64) (hi i64) (node SyntaxNode)])

;; The head of a `for` statement: nothing, a declaration statement (var/let/const, possibly a
;; list) or an expression. For-in/of heads reuse it with exactly one binding or one Reference.
(defsum ForInit
  (ForNoInit)
  (ForInitDecl [(stmt i64)])
  (ForInitExpr [(expr i64)])
  (ForInitPattern [(pattern i64)]))  ; an assignment pattern as a for-in/of head

(defsum SyntaxStmtNode
  (SsLet [(name (slice u8)) (init (Option i64)) (final bool) (annotation i64)])
  (SsVar [(name (slice u8)) (init (Option i64)) (annotation i64)])
  (SsLetPattern [(pattern i64) (init (Option i64)) (final bool)])
  (SsVarPattern [(pattern i64) (init (Option i64))])
  (SsDeclList [(decls (ArrayList i64))])
  (SsReturn [(value (Option i64))])
  (SsExpr [(expr i64)])
  (SsBlock [(body (ArrayList i64))])
  (SsIf [(condition i64) (then-stmt i64) (else-stmt (Option i64))])
  (SsWhile [(condition i64) (body i64)])
  (SsEmpty)
  (SsBreak [(label (Option (slice u8)))])
  (SsContinue [(label (Option (slice u8)))])
  (SsSwitch [(discriminant i64) (cases (ArrayList i64))])
  (SsCase [(selector (Option i64)) (body (ArrayList i64))])  ; None selects `default`
  (SsDoWhile [(body i64) (condition i64)])
  (SsFor [(init ForInit) (test (Option i64)) (update (Option i64)) (body i64)])
  (SsForIn [(head ForInit) (of bool) (right i64) (body i64) (awaited bool)])  ; awaited: `for await`
  (SsLabeled [(label (slice u8)) (body i64)])
  (SsThrow [(value i64)])
  (SsTry [(body i64)
          (catch-param (Option i64))
          (catch-body (Option i64))
          (finally-body (Option i64))])  ; catch-param: a pattern
  (SsWith [(object i64) (body i64)])
  (SsDebugger)
  (SsFunctionDecl [(fun i64)])
  (SsClassDecl [(cls i64)]))

(defstruct SyntaxStmt [(lo i64) (hi i64) (node SyntaxStmtNode)])

;; One breakable statement during lowering. `labels` are the labels naming it, `kind` decides
;; which unlabelled jumps it accepts, and a loop also owns the Scope its `continue`s merge into.
(const JUMP-LOOP 1)

(const JUMP-SWITCH 2)

(const JUMP-BLOCK 3)

;; A try statement's catch clause: the target of every throw and unwinding call inside its body.
(const JUMP-CATCH 4)

;; The synthetic Scope variable that carries a thrown value to its catch clause.
(const EXCEPTION-VAR "$aot$.exception")

;; A try statement's finally block: the target of every abrupt completion — a return, or a throw
;; the statement does not catch — that must run the block before leaving (docs/DECISIONS.md,
;; finally). The completion travels in two synthetic Scope variables: its kind and its value.
(const JUMP-FINALLY 5)

(const FINALLY-KIND-VAR "$aot$.finally.kind")

(const FINALLY-VALUE-VAR "$aot$.finally.value")

(const COMPLETION-NORMAL 0)

(const COMPLETION-RETURN 1)

(const COMPLETION-THROW 2)

(defstruct JumpTarget
  [(scope i64)
   (count i64)
   (continue-scope (Option i64))
   (continue-count i64)
   (kind i64)
   (completions i64)  ; a finally target: the completion kinds recorded into it, as bits
   (labels (ArrayList (slice u8)))])

;; A function header. The record is reserved when its keyword is seen so nested functions can
;; name their parent by index (parents therefore precede children), and filled when the body
;; closes. `strict` is settled after parsing from the directive and the enclosing function.
(defstruct SyntaxFun
  [(name (slice u8))
   (kind FunKind)
   (generator bool)
   (async bool)
   (params (ArrayList (slice u8)))
   (param-annotations (ArrayList i64))
   (param-defaults (ArrayList (Option i64)))
   (param-patterns (ArrayList (Option i64)))  ; a destructured parameter; its `params` name is ""
   (rest-param (Option (slice u8)))
   (rest-pattern (Option i64))
   (simple-params bool)
   (return-annotation i64)
   (body (ArrayList i64))
   (expression-body (Option i64))  ; an arrow's concise body
   (parent i64)  ; enclosing SyntaxFun index, or -1 at the top level
   (strict bool)
   (in-class bool)  ; class bodies are strict code
   (hoisted bool)  ; a top-level declaration (or the Script root): lowered as a closed-world Fun
   (value-taken bool)  ; materialized as a function object: its pointer escapes into values
   (lo i64)
   (hi i64)
   (fidx i64)
   (fun-nid i64)
   (script i64)  ; the realm Script this function belongs to (its position in `scripts`)
   (may-throw bool)  ; can a call to this function complete with the exception sentinel? (syntactic fixpoint)
   (static-entry i64)])  ; a hoisted declaration's function object in the static heap image, or -1

;; A var-like global: a top-level `var` or function declaration of some Script of the realm. The
;; realm's global object carries one property per binding from the start.
(defstruct GlobalBinding
  [(name (slice u8))
   (script i64)  ; the first Script declaring the name
   (fun i64)  ; the last function declaration for the name, or -1 for a plain var
   (assigned bool)])  ; something in the realm may store to the name after instantiation

;; The function being parsed. Arrows inherit `this`, `new.target` and `super` from the nearest
;; enclosing non-arrow function, so those questions walk the stack through arrow contexts.
(defstruct FunContext
  [(fun i64)
   (generator bool)
   (async bool)
   (arrow bool)
   (method bool)
   (in-params bool)
   (script-root bool)  ; the Script's own statement list: not a function for `return`/`new.target`
   (field-init bool)  ; a class field initializer: `arguments` is an error
   (static-block bool)  ; a class static block: `return` and `await` are errors, `arguments` too
   (derived-constructor bool)])  ; `super()` is allowed here and in nested arrows

(defn syntax-fun-strict [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (.strict f)))

(defstruct ParserState
  [(exprs (ArrayList SyntaxExpr))
   (stmts (ArrayList SyntaxStmt))
   (funs (ArrayList SyntaxFun))
   (current-fun i64)
   (current-ctrl i64)
   (current-scope i64)
   (return-ctrls (ArrayList i64))
   (return-mems (ArrayList i64))
   (return-values (ArrayList i64))
   (jump-targets (ArrayList JumpTarget))
   (pending-labels (ArrayList (slice u8)))
   (entry-fun-nid i64)
   (script-mode bool)
   (syntax-only bool)
   (strict-pending bool)
   (script-index i64)
   (fun-contexts (ArrayList FunContext))
   (classes (ArrayList SyntaxClass))
   (patterns (ArrayList SyntaxPattern))
   (cover-consumed (ArrayList i64))  ; literals reinterpreted as patterns
   (rest-comma (ArrayList i64))  ; literals whose final `...` element was followed by a comma
   (annexb-blocks (ArrayList i64))  ; synthetic Blocks around `if (x) function f() {}`
   (abi-slots i64)  ; program-wide maximum formal count: every function's argument slots
   (abi-sig i64)  ; the shared boxed signature [ret this new.target slot…]
   (class-depth i64)  ; open class bodies: private-name scope
   (class-strict i64)  ; open class definitions, including name and heritage: strict code
   (private-refs (ArrayList PrivateRef))
   (new-callee bool)
   (spread-trailing-comma bool)  ; the last argument list ended `...x ,)`
   (no-in bool)
   (current-script i64)  ; the Script whose source is being parsed, or -1
   (scripts (ArrayList i64))  ; each Script's root function record, in evaluation order
   (globals (ArrayList GlobalBinding))
   (global-shape i64)
   (propagates bool)  ; the function being lowered emitted a path that returns the exception sentinel  ; the global object's one hidden class: every global added in table order
   (booted bool)])

(defn parser-state [] (-> (ptr ParserState))
  (primitive/alloc-static ParserState))

(defn parser-reset! [] (-> i64)
  (let [p (parser-state)]
    (if (not (.booted p))
        (do
          (set! (.exprs p) (al-new [SyntaxExpr] (alloc/malloc-allocator)))
          (set! (.stmts p) (al-new [SyntaxStmt] (alloc/malloc-allocator)))
          (set! (.funs p) (al-new [SyntaxFun] (alloc/malloc-allocator)))
          (set! (.return-ctrls p) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.return-mems p) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.return-values p) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.jump-targets p)
                (al-new [JumpTarget] (alloc/malloc-allocator)))
          (set! (.pending-labels p)
                (al-new [(slice u8)] (alloc/malloc-allocator)))
          (set! (.entry-fun-nid p) 0)
          (set! (.fun-contexts p) (al-new [FunContext] (alloc/malloc-allocator)))
          (set! (.classes p) (al-new [SyntaxClass] (alloc/malloc-allocator)))
          (set! (.patterns p) (al-new [SyntaxPattern] (alloc/malloc-allocator)))
          (set! (.cover-consumed p) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.rest-comma p) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.annexb-blocks p) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.class-depth p) 0)
          (set! (.class-strict p) 0)
          (set! (.private-refs p) (al-new [PrivateRef] (alloc/malloc-allocator)))
          (set! (.new-callee p) false)
          (set! (.spread-trailing-comma p) false)
          (set! (.no-in p) false)
          (set! (.current-script p) -1)
          (set! (.scripts p) (al-new [i64] (alloc/malloc-allocator)))
          (set! (.globals p) (al-new [GlobalBinding] (alloc/malloc-allocator)))
          (set! (.global-shape p) 0)
          (set! (.booted p) true)
          0)
        (do
          (al-for [entry (.exprs p)]
                  (let [expr entry]
                    (match (.node expr)
                      (SxString [raw units legacy]
                                (let [(mut owned) units]
                                  (al-free! [i64] (mut owned))))
                      (_ 0))))
          (al-clear! [SyntaxExpr] (mut (.exprs p)))
          (al-clear! [SyntaxStmt] (mut (.stmts p)))
          (al-clear! [SyntaxFun] (mut (.funs p)))
          (al-clear! [i64] (mut (.return-ctrls p)))
          (al-clear! [i64] (mut (.return-mems p)))
          (al-clear! [i64] (mut (.return-values p)))
          (al-clear! [JumpTarget] (mut (.jump-targets p)))
          (al-clear! [(slice u8)] (mut (.pending-labels p)))
          (set! (.entry-fun-nid p) 0)
          (al-clear! [FunContext] (mut (.fun-contexts p)))
          (al-clear! [SyntaxClass] (mut (.classes p)))
          (al-clear! [SyntaxPattern] (mut (.patterns p)))
          (al-clear! [i64] (mut (.cover-consumed p)))
          (al-clear! [i64] (mut (.rest-comma p)))
          (al-clear! [i64] (mut (.annexb-blocks p)))
          (set! (.class-depth p) 0)
          (set! (.class-strict p) 0)
          (al-clear! [PrivateRef] (mut (.private-refs p)))
          (set! (.new-callee p) false)
          (set! (.no-in p) false)
          (set! (.current-script p) -1)
          (al-clear! [i64] (mut (.scripts p)))
          (al-clear! [GlobalBinding] (mut (.globals p)))
          (set! (.global-shape p) 0)
          0))))

(defn parse-fail [(what (slice u8)) (t Token)] (-> i64)
  (do (panic-i what (.start t)) 0))

;; Only proven grammar/early errors use this channel. A failure to recognize syntax in our
;; incomplete grammar must NOT become a SyntaxError. The syntax-only API never evaluates code.
;; When the token in front of the parser is one the lexer cannot classify (a non-ASCII identifier
;; character, a decorator), the error is about our lexer, not the program, and fails closed.
(defn syntax-error! [(message (slice u8))] (-> i64)
  (let [next (peek-token)]
    (if (token-lexically-unknown? next)
        (parse-fail "parser: lexically unclassified token is outside the admitted subset at byte" next)
        (if (.syntax-only (parser-state))
            (parse-syntax-diagnostic! message)
            (panic message)))))

(defn take-token [] (-> Token)
  (lex-next! false))

(defn peek-token [] (-> Token)
  (lex-peek false))

(defn lex-second-is? [(text (slice u8))] (-> bool)
  (token-is (lex-peek-second false) text))

(defn lex-second-kind? [(kind i64)] (-> bool)
  (let [second (lex-peek-second false)] (= (.kind second) kind)))

(defn take-is [(text (slice u8))] (-> bool)
  (if (token-is (peek-token) text) (do (take-token) true) false))

(defn parser-in-function? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))
        (mut found) false]
    (al-for [entry contexts]
            (let [c entry] (if (or (.script-root c) (.static-block c)) 0 (set! (mut found) true))))
    (load found)))

;; The nearest non-arrow context: arrows inherit these questions from their home.
(defn parser-ctx-home [] (-> FunContext)
  (let [contexts (.fun-contexts (parser-state))
        (mut i) (- (len contexts) 1)
        (mut answer) (primitive/zeroed FunContext)]
    (loop (if (< (load i) 0)
              (break 0)
              (let [c (get contexts (load i))]
                (if (.arrow c)
                    (do (set! (mut i) (- (load i) 1)) (continue))
                    (break (do (set! (mut answer) c) 0))))))
    (load answer)))

(defn parser-ctx-forbids-arguments? [] (-> bool)
  (let [home (parser-ctx-home)] (or (.field-init home) (.static-block home))))

(defn parser-ctx-static-block? [] (-> bool)
  (let [home (parser-ctx-home)] (.static-block home)))

(defn parser-ctx-allows-super-call? [] (-> bool)
  (let [home (parser-ctx-home)] (.derived-constructor home)))

;; `return` is legal directly inside a function or arrow body, never in a static block or Script.
(defn parser-return-allowed? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        false
        (let [top (get contexts (- (len contexts) 1))]
          (or (.arrow top) (not (or (.script-root top) (.static-block top))))))))

(defn parser-current-fun [] (-> i64)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        -1
        (let [top (get contexts (- (len contexts) 1))] (.fun top)))))

(defn parser-ctx-generator? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        false
        (let [top (get contexts (- (len contexts) 1))] (.generator top)))))

(defn parser-ctx-async? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        false
        (let [top (get contexts (- (len contexts) 1))] (.async top)))))

(defn parser-ctx-in-params? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        false
        (let [top (get contexts (- (len contexts) 1))] (.in-params top)))))

;; The nearest non-arrow context decides `this`, `new.target` and `super` questions.
(defn parser-ctx-home-method? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))
        (mut i) (- (len contexts) 1)
        (mut answer) false]
    (loop (if (< (load i) 0)
              (break 0)
              (let [c (get contexts (load i))]
                (if (.arrow c)
                    (do (set! (mut i) (- (load i) 1)) (continue))
                    (break (do (set! (mut answer) (.method c)) 0))))))
    (load answer)))

(defn parser-ctx-allows-new-target? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))
        (mut found) false]
    (al-for [entry contexts]
            (let [c entry] (if (or (.arrow c) (.script-root c)) 0 (set! (mut found) true))))
    (load found)))

(defn parser-push-context! [(fun i64)
                            (generator bool)
                            (async bool)
                            (arrow bool)
                            (method bool)] (-> i64)
  (let [(mut c) (primitive/zeroed FunContext)]
    (set! (.fun (mut c)) fun)
    (set! (.generator (mut c)) generator)
    (set! (.async (mut c)) async)
    (set! (.arrow (mut c)) arrow)
    (set! (.method (mut c)) method)
    (set! (.script-root (mut c)) false)
    (set! (.field-init (mut c)) false)
    (set! (.static-block (mut c)) false)
    (set! (.derived-constructor (mut c)) false)
    (set! (.in-params (mut c)) true)
    (push! [FunContext] (mut (.fun-contexts (parser-state))) (load c))))

;; The Script's statement list gets a context so nested functions have a parent, without being
;; a function: `return`, `new.target` and `var` hoisting still see the Script.
(defn parser-push-root-context! [(fun i64)] (-> i64)
  (do
    (parser-push-context! fun false false false false)
    (let [count (len (.fun-contexts (parser-state)))
          top (al-elem [FunContext] (mut (.fun-contexts (parser-state))) (- count 1))]
      (set! (.script-root top) true)
      (set! (.in-params top) false)
      0)))

(defn parser-mark-top-context! [(field-init bool) (static-block bool) (derived bool)] (-> i64)
  (let [count (len (.fun-contexts (parser-state)))
        top (al-elem [FunContext] (mut (.fun-contexts (parser-state))) (- count 1))]
    (set! (.field-init top) field-init)
    (set! (.static-block top) static-block)
    (set! (.derived-constructor top) derived)
    0))

(defn parser-set-in-params! [(value bool)] (-> i64)
  (let [count (len (.fun-contexts (parser-state)))
        top
          (al-elem [FunContext]
                   (mut (.fun-contexts (parser-state)))
                   (- count 1))]
    (set! (.in-params top) value)
    0))

(defn parser-pop-context! [] (-> i64)
  (match (pop! (mut (.fun-contexts (parser-state))))
    (None [] (broken "parser-pop-context!: no function context"))
    (Some [c] 0)))

;; BindingIdentifier: a reserved word is a proven error; `yield` and `await` are reserved inside
;; generator and async bodies respectively. A sloppy `let` binding fails closed.
(defn syntax-check-binding-name! [(name (slice u8))] (-> i64)
  (if (and (= name "yield") (parser-ctx-generator?))
      (syntax-error! "parser: yield is not a valid binding identifier in a generator")
      (if (and (= name "await") (or (parser-ctx-async?) (parser-ctx-static-block?)))
          (syntax-error! "parser: await is not a valid binding identifier here")
          0)))

(defn require-binding-identifier [] (-> Token)
  (let [t (take-token)]
    (if (= (.kind t) TOK-IDENT)
        (do
          (if (token-escaped-reserved? t)
              (syntax-error! "parser: escaped reserved word cannot be a binding identifier")
              0)
          (syntax-check-binding-name! (token-text t))
          t)
        ;; `let` is a valid sloppy binding name; strict code rejects it in the strict pass and
            ;; lexical declarations reject it where they parse.
            (if (token-is t "let")
                t
                (if (= (.kind t) TOK-KEYWORD)
                (do
                  (syntax-error! "parser: reserved word cannot be a binding identifier")
                  t)
                ;; Every position that admits a BindingPattern parses it before asking for an
                ;; identifier, so a pattern here (an object rest element, a function name) is a
                ;; proven error. A token the lexer could not classify is not.
                (do
                  (if (token-lexically-unknown? t)
                      (parse-fail "parser: non-ASCII identifier is outside the admitted subset at byte" t)
                      (syntax-error! "parser: expected a binding identifier"))
                  t))))))

;; Tokens this lexer cannot classify: non-ASCII identifiers, decorators. A
;; grammar failure on one of these is not evidence about the program.
(defn token-lexically-unknown? [(t Token)] (-> bool)
  (and (= (.kind t) TOK-PUNCT)
       (let [x (token-text t)]
         (or (= x "@") (>= (get x 0) (cast u8 128))))))

;; A required token that is absent proves a SyntaxError in JavaScript Script code once the grammar
;; up to this point is complete; TypeScript entry mode keeps failing closed because annotations
;; and generics are only partially admitted there.
(defn required-token-missing! [(what (slice u8)) (t Token)] (-> i64)
  (if (and (.script-mode (parser-state)) (not (token-lexically-unknown? t)))
      (syntax-error! what)
      (parse-fail what t)))

(defn require-token [(text (slice u8))] (-> Token)
  (let [t (take-token)]
    (if (token-is t text)
        t
        (do (required-token-missing! "parser: unexpected token" t) t))))

(defn require-ident [] (-> Token)
  (let [t (take-token)]
    (if (= (.kind t) TOK-IDENT)
        t
        (do (required-token-missing! "parser: expected an identifier" t) t))))

;; Property IdentifierName permits reserved words, unlike a binding Identifier.
(defn require-property-name [] (-> Token)
  (let [t (take-token)]
    (if (or (= (.kind t) TOK-IDENT) (= (.kind t) TOK-KEYWORD))
        t
        (do (required-token-missing! "parser: expected a property name" t) t))))

(defn syntax-expr-new [(node SyntaxNode) (lo i64) (hi i64)] (-> SyntaxExpr)
  (let [(mut x) (primitive/zeroed SyntaxExpr)]
    (set! (.lo (mut x)) lo)
    (set! (.hi (mut x)) hi)
    (set! (.node (mut x)) node)
    (load x)))

(defn syntax-add! [(x SyntaxExpr)] (-> i64)
  (do
    (push! [SyntaxExpr] (mut (.exprs (parser-state))) x)
    (len (.exprs (parser-state)))))

(defn syntax-add-node! [(node SyntaxNode) (lo i64) (hi i64)] (-> i64)
  (syntax-add! (syntax-expr-new node lo hi)))

(defn syntax-at [(id i64)] (-> SyntaxExpr)
  (get (.exprs (parser-state)) (- id 1)))

(defn syntax-node [(id i64)] (-> SyntaxNode)
  (let [x (syntax-at id)] (.node x)))

(defn syntax-lo [(id i64)] (-> i64)
  (let [x (syntax-at id)] (.lo x)))

(defn syntax-hi [(id i64)] (-> i64)
  (let [x (syntax-at id)] (.hi x)))

(defn syntax-ungroup-id [(id i64)] (-> i64)
  (match (syntax-node id)
    (SxGroup [inner] (syntax-ungroup-id inner))
    (_ id)))

(defn syntax-name? [(id i64)] (-> bool)
  (match (syntax-node id) (SxName [name] true) (_ false)))

(defn syntax-member? [(id i64)] (-> bool)
  (match (syntax-node id) (SxMember [owner name optional] true) (_ false)))

;; Whether an OptionalExpression owns this member/call spine. Parentheses end the chain, so
;; `(a?.b).c` is an ordinary Reference while `a?.b.c` is not.
;; The innermost expression a member/call spine hangs from: `a.b(c)[d]` roots at `a`.
(defn syntax-spine-root [(id i64)] (-> i64)
  (match (syntax-node id)
    (SxMember [owner name optional] (syntax-spine-root owner))
    (SxPrivateMember [owner name optional] (syntax-spine-root owner))
    (SxIndex [owner key optional] (syntax-spine-root owner))
    (SxCall [callee args optional] (syntax-spine-root callee))
    (SxTaggedTemplate [tag template] (syntax-spine-root tag))
    (_ id)))

(defn syntax-optional-chain? [(id i64)] (-> bool)
  (match (syntax-node id)
    (SxMember [owner name optional] (or optional (syntax-optional-chain? owner)))
    (SxPrivateMember [owner name optional] (or optional (syntax-optional-chain? owner)))
    (SxIndex [owner key optional] (or optional (syntax-optional-chain? owner)))
    (SxCall [callee args optional]
            (or optional (syntax-optional-chain? callee)))
    (SxTaggedTemplate [tag template] (syntax-optional-chain? tag))
    (_ false)))

;; ---------------------------------------------------------------------------
;; Destructuring patterns
(defn syntax-pattern-add! [(node PatternNode) (default (Option i64)) (lo i64) (hi i64)] (-> i64)
  (let [(mut x) (primitive/zeroed SyntaxPattern)]
    (set! (.node (mut x)) node)
    (set! (.default (mut x)) default)
    (set! (.lo (mut x)) lo)
    (set! (.hi (mut x)) hi)
    (push! [SyntaxPattern] (mut (.patterns (parser-state))) (load x))
    (len (.patterns (parser-state)))))

(defn syntax-pattern-at [(id i64)] (-> SyntaxPattern)
  (get (.patterns (parser-state)) (- id 1)))

(defn syntax-pattern-node [(id i64)] (-> PatternNode)
  (let [x (syntax-pattern-at id)] (.node x)))

(defn syntax-pattern-default [(id i64)] (-> (Option i64))
  (let [x (syntax-pattern-at id)] (.default x)))

;; The names a pattern binds, in source order.
(defn syntax-pattern-names! [(id i64) (out (mut (ArrayList (slice u8))))] (-> i64)
  (do
    (match (syntax-pattern-node id)
      (PatName [name] (push! [(slice u8)] (mut out) name))
      (PatTarget [expr] 0)
      (PatObject [props rest]
                 (do
                   (al-for [prop props] (let [pp prop] (syntax-pattern-names! (.pattern pp) (mut out))))
                   (match rest (Some [r] (syntax-pattern-names! r (mut out))) (None [] 0))))
      (PatArray [elements rest]
                (do
                  (al-for [element elements]
                          (match element (PatItem [pat] (syntax-pattern-names! pat (mut out))) (PatHole [] 0)))
                  (match rest (Some [r] (syntax-pattern-names! r (mut out))) (None [] 0)))))
    0))

;; The expressions a pattern owns: defaults, computed keys and Reference leaves.
(defn syntax-pattern-exprs! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-pattern-default id) (Some [d] (push! [i64] (mut out) d)) (None [] 0))
    (match (syntax-pattern-node id)
      (PatName [name] 0)
      (PatTarget [expr] (push! [i64] (mut out) expr))
      (PatObject [props rest]
                 (do
                   (al-for [prop props]
                           (let [pp prop]
                             (match (.key pp) (KeyComputed [e] (push! [i64] (mut out) e)) (_ 0))
                             (syntax-pattern-exprs! (.pattern pp) (mut out))))
                   (match rest (Some [r] (syntax-pattern-exprs! r (mut out))) (None [] 0))))
      (PatArray [elements rest]
                (do
                  (al-for [element elements]
                          (match element (PatItem [pat] (syntax-pattern-exprs! pat (mut out))) (PatHole [] 0)))
                  (match rest (Some [r] (syntax-pattern-exprs! r (mut out))) (None [] 0)))))
    0))

;; Every name a function binds through its parameters: plain names, destructured names and the
;; rest element.
(defn syntax-fun-bound-names [(f SyntaxFun)] (-> (ArrayList (slice u8)))
  (let [(mut names) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut i) 0]
    (loop (if (>= (load i) (len (.params f)))
              (break 0)
              (do
                (match (get (.param-patterns f) (load i))
                  (Some [pat] (syntax-pattern-names! pat (mut names)))
                  (None [] (push! [(slice u8)] (mut names) (get (.params f) (load i)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (match (.rest-param f) (Some [r] (push! [(slice u8)] (mut names) r)) (None [] 0))
    (match (.rest-pattern f) (Some [r] (syntax-pattern-names! r (mut names))) (None [] 0))
    (load names)))

;; An assignment pattern reused as a binding pattern: every leaf must be a binding name.
(defn syntax-pattern-require-binding! [(id i64)] (-> i64)
  (do
    (match (syntax-pattern-node id)
      (PatName [name] (syntax-check-binding-name! name))
      (PatTarget [expr] (syntax-error! "parser: invalid binding pattern"))
      (PatObject [props rest]
                 (do
                   (al-for [prop props] (let [pp prop] (syntax-pattern-require-binding! (.pattern pp))))
                   (match rest (Some [r] (syntax-pattern-require-binding! r)) (None [] 0))))
      (PatArray [elements rest]
                (do
                  (al-for [element elements]
                          (match element (PatItem [pat] (syntax-pattern-require-binding! pat)) (PatHole [] 0)))
                  (match rest (Some [r] (syntax-pattern-require-binding! r)) (None [] 0)))))
    0))

;; Whether any parameter of `f` is a destructuring pattern.
(defn syntax-fun-has-patterns? [(f SyntaxFun)] (-> bool)
  (let [(mut found) (match (.rest-pattern f) (Some [r] true) (None [] false))]
    (al-for [p (.param-patterns f)] (match p (Some [pat] (set! (mut found) true)) (None [] 0)))
    (load found)))

;; The one place that knows every variant's children. Generic walks (strict checks, and later any
;; syntax query that does not care about shape) iterate this list instead of repeating the match.
(defn syntax-expr-children! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-node id)
      (SxNumber [value value-float rep] 0)
      (SxString [raw units legacy] 0)
      (SxName [name] 0)
      (SxSingleton [name] 0)
      (SxGroup [inner] (push! [i64] (mut out) inner))
      (SxObject [entries]
                (do
                  (al-for [entry entries]
                          (match entry
                            (PropValue [key value]
                                       (do
                                         (match key
                                           (KeyComputed [e]
                                                        (push! [i64]
                                                               (mut out)
                                                               e))
                                           (_ 0))
                                         (push! [i64] (mut out) value)))
                            (PropMethod [key fun]
                                        (match key
                                          (KeyComputed [e]
                                                       (push! [i64] (mut out) e))
                                          (_ 0)))
                            (PropSpread [expr] (push! [i64] (mut out) expr))
                            (PropCoverInit [name init]
                                           (push! [i64] (mut out) init))))
                  0))
      (SxArray [elements]
               (do
                 (al-for [element elements]
                         (match element
                           (ElemHole [] 0)
                           (ElemExpr [expr] (push! [i64] (mut out) expr))
                           (ElemSpread [expr] (push! [i64] (mut out) expr))))
                 0))
      (SxMember [owner name optional] (push! [i64] (mut out) owner))
      (SxIndex [owner key optional]
               (do (push! [i64] (mut out) owner) (push! [i64] (mut out) key)))
      (SxCall [callee args optional]
              (do
                (push! [i64] (mut out) callee)
                (al-for [arg args] (push! [i64] (mut out) arg))
                0))
      (SxNew [callee args]
             (do
               (push! [i64] (mut out) callee)
               (al-for [arg args] (push! [i64] (mut out) arg))
               0))
      (SxNewTarget [] 0)
      (SxThis [] 0)
      (SxIntrinsic [builtin args] (al-for [a args] (push! [i64] (mut out) a)))
      (SxSpread [expr] (push! [i64] (mut out) expr))
      (SxImportCall [specifier options]
                    (do
                      (push! [i64] (mut out) specifier)
                      (match options
                        (Some [o] (push! [i64] (mut out) o))
                        (None [] 0))))
      (SxTemplate [quasis substitutions]
                  (do
                    (al-for [q quasis] (push! [i64] (mut out) q))
                    (al-for [e substitutions] (push! [i64] (mut out) e))
                    0))
      (SxTaggedTemplate [tag template]
                        (do
                          (push! [i64] (mut out) tag)
                          (push! [i64] (mut out) template)))
      (SxRegex [body flags] 0)
      (SxFunction [fun] 0)
      (SxYield [argument delegate]
               (match argument (Some [a] (push! [i64] (mut out) a)) (None [] 0)))
      (SxAwait [operand] (push! [i64] (mut out) operand))
      (SxSuper [] 0)
      (SxClass [cls] (syntax-class-exprs! cls (mut out)))
      (SxDestructuringAssign [pattern value]
                             (do (syntax-pattern-exprs! pattern (mut out)) (push! [i64] (mut out) value)))
      (SxPrivateMember [owner name optional] (push! [i64] (mut out) owner))
      (SxPrivateName [name] 0)
      (SxUnary [op operand] (push! [i64] (mut out) operand))
      (SxDelete [operand] (push! [i64] (mut out) operand))
      (SxUpdate [op prefix target] (push! [i64] (mut out) target))
      (SxBinary [op left right]
                (do (push! [i64] (mut out) left) (push! [i64] (mut out) right)))
      (SxAnd [left right]
             (do (push! [i64] (mut out) left) (push! [i64] (mut out) right)))
      (SxOr [left right]
            (do (push! [i64] (mut out) left) (push! [i64] (mut out) right)))
      (SxCoalesce [left right]
                  (do
                    (push! [i64] (mut out) left)
                    (push! [i64] (mut out) right)))
      (SxConditional [condition when-true when-false]
                     (do
                       (push! [i64] (mut out) condition)
                       (push! [i64] (mut out) when-true)
                       (push! [i64] (mut out) when-false)))
      (SxAssign [target value]
                (do
                  (push! [i64] (mut out) target)
                  (push! [i64] (mut out) value)))
      (SxCompoundAssign [op target value]
                        (do
                          (push! [i64] (mut out) target)
                          (push! [i64] (mut out) value)))
      (SxLogicalAssign [predicate rhs-on-true target value]
                       (do
                         (push! [i64] (mut out) target)
                         (push! [i64] (mut out) value)))
      (SxComma [left right]
               (do (push! [i64] (mut out) left) (push! [i64] (mut out) right))))
    0))

;; Final Simple Parser.parseString consumes the quote, copies ordinary characters, and delegates
;; backslashes to escapedChar; EOF and unknown escapes fail at the literal. ECMAScript extends
;; that scanner with hex/Unicode, identity and legacy decimal/octal escapes and line continuations
;; (ECMA-262 12.9.4). Decode into code units, not UTF-8, to preserve lone surrogates. Raw spelling
;; is retained for Directive Prologues. Legacy escapes are checked after scope strictness is
;; known, including when a later directive makes an earlier literal strict. One growable buffer
;; receives raw UTF-8 runs and decoded escapes; no per-character allocation or runtime decoder.
(defn syntax-string-escape! [(units (mut (ArrayList i64)))
                             (legacy (mut bool))
                             (text (slice u8))
                             (index (mut i64))] (-> i64)
  (let [c (get text (load index))
        (mut value) (cast i64 c)]
    (set! index (+ (load index) 1))
    (if (or (= c (cast u8 120)) (= c (cast u8 117)))
        (let [braced
                (and (= c (cast u8 117))
                     (< (load index) (len text))
                     (= (get text (load index)) (cast u8 123)))
              limit (if (= c (cast u8 120)) 2 4)
              (mut digits) 0]
          (set! (mut value) 0)
          (if braced (set! index (+ (load index) 1)) 0)
          (loop (if (if braced
                        (and (< (load index) (len text))
                             (!= (get text (load index)) (cast u8 125)))
                        (< (load digits) limit))
                    (do
                      (if (>= (load index) (len text))
                          (syntax-error! "parser: truncated string escape")
                          0)
                      (let [digit (lex-digit-value (get text (load index)))]
                        (if (< digit 0)
                            (syntax-error! "parser: invalid hexadecimal string escape")
                            0)
                        (set! (mut value) (+ (* (load value) 16) digit))
                        ;; Bound on every digit prevents overflow even with arbitrarily many digits.
                        (if (> (load value) 0x10ffff)
                            (syntax-error! "parser: Unicode escape exceeds code point range")
                            0))
                      (set! index (+ (load index) 1))
                      (set! (mut digits) (+ (load digits) 1))
                      (continue))
                    (break 0)))
          (if braced
              (do
                (if (or (= (load digits) 0) (>= (load index) (len text)))
                    (syntax-error! "parser: incomplete braced Unicode escape")
                    0)
                (set! index (+ (load index) 1)))
              0))
        (if (lex-digit? c)
            (do
              (set! legacy
                    (or (load legacy)
                        (!= c (cast u8 48))
                        (and (< (load index) (len text))
                             (lex-digit? (get text (load index))))))
              (if (<= c (cast u8 55))
                  (let [limit (if (<= c (cast u8 51)) 3 2)
                        (mut digits) 1]
                    (set! (mut value) (- (cast i64 c) 48))
                    (loop (if (and (< (load digits) limit)
                                   (< (load index) (len text))
                                   (lex-radix-digit? (get text (load index)) 8))
                              (do
                                (set! (mut value)
                                      (+ (* (load value) 8)
                                         (- (cast i64 (get text (load index)))
                                            48)))
                                (set! index (+ (load index) 1))
                                (set! (mut digits) (+ (load digits) 1))
                                (continue))
                              (break 0))))
                  0))
            (set! (mut value)
                  (if (= c (cast u8 98))
                      8
                      (if (= c (cast u8 102))
                          12
                          (if (= c (cast u8 110))
                              10
                              (if (= c (cast u8 114))
                                  13
                                  (if (= c (cast u8 116))
                                      9
                                      (if (= c (cast u8 118)) 11 (cast i64 c))))))))))
    (if (<= (load value) 0xffff)
        (push! [i64] (mut units) (load value))
        (let [supplement (- (load value) 0x10000)]
          (push! [i64] (mut units) (+ 0xd800 (primitive/ishr supplement 10)))
          (push! [i64] (mut units) (+ 0xdc00 (& supplement 0x3ff)))))
    0))

;; Decode a string or template body into UTF-16 code units. `abs-start` is the source offset of
;; `text` so line continuations can be measured in place. Template bodies (TV) additionally
;; normalize CR and CRLF to LF and treat every legacy escape as a NotEscapeSequence error.
(defn syntax-decode-string-body! [(text (slice u8))
                                  (abs-start i64)
                                  (template bool)
                                  (units (mut (ArrayList i64)))
                                  (legacy (mut bool))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len text))
              (break 0)
              (do
                (if (= (get text (load i)) (cast u8 92))
                    (do
                      (set! (mut i) (+ (load i) 1))
                      (if (>= (load i) (len text))
                          (syntax-error! "parser: truncated string escape")
                          0)
                      (let [width (lex-line-width (+ abs-start (load i)))]
                        (if (> width 0)
                            (set! (mut i) (+ (load i) width))
                            (if (< (get text (load i)) (cast u8 128))
                                (do
                                  (syntax-string-escape! (mut units)
                                                         (mut legacy)
                                                         text
                                                         (mut i))
                                  (if (and template (load legacy))
                                      (syntax-error! "parser: octal escape sequence is not allowed in a template")
                                      0))
                                ;; Non-ASCII NonEscapeCharacter: the raw-run decoder below consumes
                                ;; its entire scalar, not merely the first UTF-8 byte.
                                0))))
                    0)
                (let [start (load i)]
                  (loop (if (and (< (load i) (len text))
                                 (!= (get text (load i)) (cast u8 92))
                                 (not (and template
                                           (= (get text (load i)) (cast u8 13)))))
                            (do (set! (mut i) (+ (load i) 1)) (continue))
                            (break 0)))
                  (jsl-string-append-utf8! (subslice [u8] text start (load i))
                                           (mut units))
                  (if (and template
                           (< (load i) (len text))
                           (= (get text (load i)) (cast u8 13)))
                      (do
                        (push! [i64] (mut units) 10)
                        (set! (mut i) (+ (load i) 1))
                        (if (and (< (load i) (len text))
                                 (= (get text (load i)) (cast u8 10)))
                            (set! (mut i) (+ (load i) 1))
                            0))
                      0))
                (continue))))
    0))

(defn syntax-string [(t Token)] (-> SyntaxExpr)
  (let [text (subslice [u8] (token-text t) 1 (- (- (.end t) (.start t)) 1))
        (mut units) (al-new [i64] (alloc/malloc-allocator))
        (mut legacy) false]
    (syntax-decode-string-body! text
                                (+ (.start t) 1)
                                false
                                (mut units)
                                (mut legacy))
    (syntax-expr-new (SxString
                       :raw text
                       :units (load units)
                       :legacy-escape (load legacy))
                     (.start t)
                     (.end t))))

;; One template quasi. A tagged template keeps only raw text: its cooked value may be undefined
;; and this compiler does not evaluate tagged templates yet.
(defn syntax-template-quasi [(part Token) (tagged bool)] (-> i64)
  (let [inner-end (- (.end part) (if (lex-template-continues? part) 2 1))
        text (subslice [u8] (lex-source) (+ (.start part) 1) inner-end)
        (mut units) (al-new [i64] (alloc/malloc-allocator))
        (mut legacy) false]
    (if tagged
        0
        (syntax-decode-string-body! text
                                    (+ (.start part) 1)
                                    true
                                    (mut units)
                                    (mut legacy)))
    (syntax-add-node! (SxString
                        :raw text
                        :units (load units)
                        :legacy-escape false)
                      (.start part)
                      (.end part))))

;; Declare the shapes the source spells out — object literals and the realm's global object —
;; before lowering, so a literal's layout is one canonical transition path however many places
;; build it. Nothing else is declared: a named write to an owner the compiler cannot see is a
;; runtime transition (`aot.rt.shapes`), never a compile-time one. The closure this pass once
;; took over every written key multiplied the shape universe by every permutation of those keys
;; (docs/DECISIONS.md, generic property access) and could not even close it.
(defn syntax-declare-object-shapes! [] (-> i64)
  (let [(mut i) 0
        (mut declared) 0]
    (loop (if (>= (load i) (len (.exprs (parser-state))))
              (break 0)
              (let [x (get (.exprs (parser-state)) (load i))]
                (match (.node x)
                  (SxObject [entries]
                            (let [(mut shape) SHAPE-EMPTY]
                              ;; The object-initializer `__proto__` setter mutates the stable
                              ;; prototype slot; it does not define a data property or create a
                              ;; hidden-class transition. Computed and spread entries refuse
                              ;; lowering, so they declare no layout here.
                              (al-for [entry entries]
                                      (match entry
                                        (PropValue [prop-key value]
                                                   (match prop-key
                                                     (KeyNamed [key]
                                                               (if (= (shape-key-name key)
                                                                      "__proto__")
                                                                   0
                                                                   (set! (mut shape)
                                                                         (shape-transition (load shape)
                                                                                           (shape-key-name key)))))
                                                     (_ 0)))
                                        (_ 0)))
                              (set! (mut declared) (+ (load declared) 1))))
                  (_ 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; The realm's global object is built by adding every var-like global in table order; a
    ;; lexically resolved global is a field access over that one hidden class.
    (if (> (len (.globals (parser-state))) 0)
        (let [(mut shape) SHAPE-EMPTY]
          (al-for [g (.globals (parser-state))]
                  (let [binding g]
                    (set! (mut shape) (shape-transition (load shape) (.name binding)))))
          (set! (mut declared) (+ (load declared) 1))
          0)
        0)
    (load declared)))

(defn syntax-stmt-new [(node SyntaxStmtNode) (lo i64) (hi i64)] (-> SyntaxStmt)
  (let [(mut s) (primitive/zeroed SyntaxStmt)]
    (set! (.lo (mut s)) lo)
    (set! (.hi (mut s)) hi)
    (set! (.node (mut s)) node)
    (load s)))

(defn syntax-stmt-add! [(s SyntaxStmt)] (-> i64)
  (do
    (push! [SyntaxStmt] (mut (.stmts (parser-state))) s)
    (len (.stmts (parser-state)))))

(defn syntax-stmt-add-node! [(node SyntaxStmtNode) (lo i64) (hi i64)] (-> i64)
  (syntax-stmt-add! (syntax-stmt-new node lo hi)))

(defn syntax-stmt-at [(id i64)] (-> SyntaxStmt)
  (get (.stmts (parser-state)) (- id 1)))

(defn syntax-stmt-node [(id i64)] (-> SyntaxStmtNode)
  (let [s (syntax-stmt-at id)] (.node s)))

(defn syntax-stmt-lo [(id i64)] (-> i64)
  (let [x (get (.stmts (parser-state)) (- id 1))] (.lo x)))

(defn syntax-stmt-hi [(id i64)] (-> i64)
  (let [s (syntax-stmt-at id)] (.hi s)))

;; Nested statement ids of one statement, exhaustively. Declaration lists and case clauses are
;; grouping only; blocks, branches and loops introduce nesting the walks below care about.
(defn syntax-stmt-children! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-stmt-node id)
      (SsLet [name init final annotation] 0)
      (SsVar [name init annotation] 0)
      (SsLetPattern [pattern init final] 0)
      (SsVarPattern [pattern init] 0)
      (SsDeclList [decls] (do (al-for [d decls] (push! [i64] (mut out) d)) 0))
      (SsReturn [value] 0)
      (SsExpr [expr] 0)
      (SsBlock [body] (do (al-for [s body] (push! [i64] (mut out) s)) 0))
      (SsIf [condition then-stmt else-stmt]
            (do
              (push! [i64] (mut out) then-stmt)
              (match else-stmt (Some [e] (push! [i64] (mut out) e)) (None [] 0))))
      (SsWhile [condition body] (push! [i64] (mut out) body))
      (SsEmpty [] 0)
      (SsBreak [label] 0)
      (SsContinue [label] 0)
      (SsSwitch [discriminant cases]
                (do (al-for [c cases] (push! [i64] (mut out) c)) 0))
      (SsCase [selector body]
              (do (al-for [s body] (push! [i64] (mut out) s)) 0))
      (SsDoWhile [body condition] (push! [i64] (mut out) body))
      (SsFor [init test update body]
             (do
               (match init
                 (ForInitDecl [stmt] (push! [i64] (mut out) stmt))
                 (_ 0))
               (push! [i64] (mut out) body)))
      (SsForIn [head of right body awaited]
               (do
                 (match head
                   (ForInitDecl [stmt] (push! [i64] (mut out) stmt))
                   (_ 0))
                 (push! [i64] (mut out) body)))
      (SsLabeled [label body] (push! [i64] (mut out) body))
      (SsThrow [value] 0)
      (SsTry [body catch-param catch-body finally-body]
             (do
               (push! [i64] (mut out) body)
               (match catch-body
                 (Some [c] (push! [i64] (mut out) c))
                 (None [] 0))
               (match finally-body
                 (Some [f] (push! [i64] (mut out) f))
                 (None [] 0))))
      (SsWith [object body] (push! [i64] (mut out) body))
      (SsDebugger [] 0)
      (SsFunctionDecl [fun] 0)
      (SsClassDecl [cls] 0))
    0))

;; The expressions a class body owns outside its methods: the heritage and computed keys.
;; Method bodies and field initializers are SyntaxFun records walked by the function passes.
(defn syntax-class-exprs! [(cls i64) (out (mut (ArrayList i64)))] (-> i64)
  (let [c (get (.classes (parser-state)) cls)]
    (match (.heritage c) (Some [h] (push! [i64] (mut out) h)) (None [] 0))
    (al-for [element (.elements c)]
            (let [key
                    (match element
                      (CeMethod [key is-static fun] key)
                      (CeField [key is-static init-fun] key)
                      (CeStaticBlock [fun] (CkNamed "")))]
              (match key (CkComputed [e] (push! [i64] (mut out) e)) (_ 0))))
    0))

;; Expression ids directly owned by one statement, exhaustively.
(defn syntax-stmt-exprs! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-stmt-node id)
      (SsLet [name init final annotation]
             (match init (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsVar [name init annotation]
             (match init (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsLetPattern [pattern init final]
                    (do
                      (syntax-pattern-exprs! pattern (mut out))
                      (match init (Some [e] (push! [i64] (mut out) e)) (None [] 0))))
      (SsVarPattern [pattern init]
                    (do
                      (syntax-pattern-exprs! pattern (mut out))
                      (match init (Some [e] (push! [i64] (mut out) e)) (None [] 0))))
      (SsDeclList [decls] 0)
      (SsReturn [value]
                (match value (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsExpr [expr] (push! [i64] (mut out) expr))
      (SsBlock [body] 0)
      (SsIf [condition then-stmt else-stmt] (push! [i64] (mut out) condition))
      (SsWhile [condition body] (push! [i64] (mut out) condition))
      (SsEmpty [] 0)
      (SsBreak [label] 0)
      (SsContinue [label] 0)
      (SsSwitch [discriminant cases] (push! [i64] (mut out) discriminant))
      (SsCase [selector body]
              (match selector (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsDoWhile [body condition] (push! [i64] (mut out) condition))
      (SsFor [init test update body]
             (do
               (match init
                 (ForInitExpr [e] (push! [i64] (mut out) e))
                 (ForInitPattern [pat] (syntax-pattern-exprs! pat (mut out)))
                 (_ 0))
               (match test (Some [e] (push! [i64] (mut out) e)) (None [] 0))
               (match update (Some [e] (push! [i64] (mut out) e)) (None [] 0))))
      (SsForIn [head of right body awaited]
               (do
                 (match head
                   (ForInitExpr [e] (push! [i64] (mut out) e))
                   (ForInitPattern [pat] (syntax-pattern-exprs! pat (mut out)))
                   (_ 0))
                 (push! [i64] (mut out) right)))
      (SsLabeled [label body] 0)
      (SsThrow [value] (push! [i64] (mut out) value))
      (SsTry [body catch-param catch-body finally-body]
             (match catch-param (Some [pat] (syntax-pattern-exprs! pat (mut out))) (None [] 0)))
      (SsWith [object body] (push! [i64] (mut out) object))
      (SsDebugger [] 0)
      (SsFunctionDecl [fun] 0)
      (SsClassDecl [cls] (syntax-class-exprs! cls (mut out))))
    0))

;; Power-of-two radix integers: the exact conversion is shared with the runtime's StringToNumber
;; (aot.rt.number, `number-radix-value`).
(defn parse-radix-number [(text (slice u8)) (start i64) (width i64)] (-> f64)
  (number-radix-value text start width))

;; ECMAScript decimal integer literals denote binary64 Numbers, even when their spelling no longer
;; fits the signed-48 immediate payload. Parse through `strtod` first, then choose the compact int
;; representation only where binary64 is exact and the NaN-box payload can preserve every bit.
;; Accumulating in i64 first silently wrapped long spellings before this decision could be made.
(defn parse-number-value [(t Token)] (-> f64)
  (let [text (token-text t)]
    (if (= (.kind t) TOK-LEGACY-NUMBER)
        (parse-radix-number text 0 3)
        (if (and (> (len text) 2)
                 (= (get text 0) (cast u8 48))
                 (or (= (get text 1) (cast u8 120))
                     (= (get text 1) (cast u8 88))
                     (= (get text 1) (cast u8 98))
                     (= (get text 1) (cast u8 66))
                     (= (get text 1) (cast u8 111))
                     (= (get text 1) (cast u8 79))))
            (let [prefix (get text 1)]
              (parse-radix-number text
                                  2
                                  (if (or (= prefix (cast u8 120))
                                          (= prefix (cast u8 88)))
                                      4
                                      (if (or (= prefix (cast u8 98))
                                              (= prefix (cast u8 66)))
                                          1
                                          3))))
            (let [(mut normalized) (sb-new (alloc/malloc-allocator))]
              (for c
                (iter text)
                (if (!= c (cast u8 95)) (sb-push-byte! (mut normalized) c) 0))
              (let [size (len (sb-str (load normalized)))
                    consumed (primitive/alloc-stack i64)
                    value (number-strtod! (sb-str (load normalized)) consumed)]
                (if (!= (load consumed) size)
                    (parse-fail "parser: invalid numeric literal at byte" t)
                    0)
                (sb-free! (mut normalized))
                value))))))

(defn syntax-number [(t Token)] (-> SyntaxExpr)
  (let [value (parse-number-value t)]
    (syntax-expr-new (if (and (primitive/fcmp-le value 140737488355327.0)
                              (primitive/fcmp-eq value
                                                 (primitive/cast f64
                                                                 (primitive/cast i64
                                                                                 value))))
                         (SxNumber
                           :value (primitive/cast i64 value)
                           :value-float 0.0
                           :rep REP-INT)
                         (SxNumber
                           :value 0
                           :value-float value
                           :rep REP-DOUBLE))
                     (.start t)
                     (.end t))))

;; A token that can never begin an ECMAScript expression proves a SyntaxError. Tokens that begin
;; grammar this parser has not admitted yet (regex, template, array literal, function, class,
;; `this`, `new`, `super`, `import`, escaped or non-ASCII identifiers) must fail closed instead.
(defn token-cannot-start-expression? [(t Token)] (-> bool)
  (if (= (.kind t) TOK-EOF)
      true
      (if (= (.kind t) TOK-PUNCT)
          (let [x (token-text t)]
            (not (or (= x "(")
                     (= x "{")
                     (= x "#")
                     (= x "\\")
                     (= x "@")
                     (>= (get x 0) (cast u8 128)))))
          (if (= (.kind t) TOK-KEYWORD)
              (let [x (token-text t)]
                (not (or (= x "function") (= x "class") (= x "super") (= x "let"))))
              false))))

(defn parse-primary-fallback [(t Token)] (-> i64)
  (if (token-cannot-start-expression? t)
      (syntax-error! "parser: expected an expression")
      (do
        (parse-fail "parser: primary is outside the admitted subset at byte" t)
        0)))

;; PropertyName as an interned shape key. IdentifierNames, plain ASCII string literals and
;; integral numeric literals canonicalize to the same key as the identifier spelling; escaped,
;; non-ASCII and non-integral spellings fail closed.
(defn syntax-property-key-name [(t Token)] (-> (slice u8))
  (if (or (= (.kind t) TOK-IDENT) (= (.kind t) TOK-KEYWORD))
      (token-text t)
      (if (= (.kind t) TOK-STRING)
          (let [inner (subslice [u8] (token-text t) 1 (- (- (.end t) (.start t)) 1))]
            (for c
              (iter inner)
              (if (or (= c (cast u8 92)) (>= c (cast u8 128)))
                  (parse-fail "parser: escaped or non-ASCII string property keys are outside the admitted subset at byte"
                              t)
                  0))
            inner)
          (if (or (= (.kind t) TOK-NUMBER) (= (.kind t) TOK-LEGACY-NUMBER))
              (let [x (syntax-number t)]
                (match (.node x)
                  (SxNumber [value value-float rep]
                            (if (= rep REP-INT)
                                (let [(mut text) (sb-new (alloc/malloc-allocator))]
                                  ;; The key outlives the parse; the builder is deliberately retained.
                                  (sb-push-i64! (mut text) value)
                                  (sb-str (load text)))
                                (do
                                  (parse-fail "parser: non-integral numeric property keys are outside the admitted subset at byte"
                                              t)
                                  "")))
                  (_ "")))
              (do
                (parse-fail "parser: property key is outside the admitted subset at byte"
                            t)
                "")))))

(defn token-property-name? [(t Token)] (-> bool)
  (or (= (.kind t) TOK-IDENT)
      (= (.kind t) TOK-KEYWORD)
      (= (.kind t) TOK-STRING)
      (= (.kind t) TOK-NUMBER)
      (= (.kind t) TOK-LEGACY-NUMBER)
      (= (.kind t) TOK-BIGINT)
      (token-is t "[")
      (token-is t "#")))

;; After a complete list element only a separator or the closer may follow.
(defn parse-list-separator! [(close (slice u8)) (message (slice u8))] (-> bool)
  (let [t (peek-token)]
    (if (token-is t ",")
        (do (take-token) (take-is close))
        (if (token-is t close)
            (do (take-token) true)
            (do
              (syntax-error! message)
              true)))))

;; PropertyName: IdentifierName, string, number or `[expr]`, with what the definition needs to
;; know about its spelling afterwards.
(defstruct ParsedKey
  [(key PropKey)
   (name (slice u8))
   (ident bool)  ; spelled as an Identifier, so shorthand is possible
   (computed bool)
   (named-proto bool)
   (lo i64)
   (hi i64)])

(defn parse-syntax-property-key! [] (-> ParsedKey)
  (let [(mut k) (primitive/zeroed ParsedKey)
        t (peek-token)]
    (set! (.lo (mut k)) (.start t))
    (if (token-is t "[")
        (let [saved-no-in (.no-in (parser-state))]
          (take-token)
          (set! (.no-in (parser-state)) false)
          (let [expr (parse-syntax-assignment)]
            (set! (.no-in (parser-state)) saved-no-in)
            (require-closing! "]"
                              "parser: expected `]` after computed property name")
            (set! (.key (mut k)) (KeyComputed expr))
            (set! (.name (mut k)) "")
            (set! (.computed (mut k)) true)))
        (if (token-is t "#")
            (do
              (syntax-error! "parser: private names are not allowed in object literals")
              0)
            (if (not (token-property-name? t))
                (do
                  (syntax-error! "parser: expected a property name in object literal")
                  0)
                (let [key-token (take-token)
                      name (syntax-property-key-name key-token)]
                  (set! (.key (mut k)) (KeyNamed (shape-key-intern name)))
                  (set! (.name (mut k)) name)
                  ;; Shorthand needs an Identifier; an escaped reserved word is only an IdentifierName.
                  (set! (.ident (mut k))
                        (and (= (.kind key-token) TOK-IDENT) (not (token-escaped-reserved? key-token))))
                  (set! (.named-proto (mut k))
                        (and (= name "__proto__")
                             (!= (.kind key-token) TOK-NUMBER)))))))
    (set! (.hi (mut k)) (lex-consumed-end))
    (load k)))

;; PropertyDefinition: `...spread`, `*gen(){}`, `get k(){}` / `set k(v){}` / `async k(){}` /
;; `async *k(){}`, `k(){}`, `k: value`, shorthand `k`, or the cover form `k = init`.
(defn parse-syntax-property-definition! [(saw-proto (mut bool))] (-> ObjectEntry)
  (let [first (peek-token)]
    (if (token-is first "...")
        (do (take-token) (PropSpread (parse-syntax-assignment)))
        (if (token-is first "*")
            (do
              (take-token)
              (let [k (parse-syntax-property-key!)]
                (parse-syntax-method! (.key k)
                                      (.name k)
                                      (FunMethod)
                                      true
                                      false
                                      (.start first))))
            (let [second (lex-peek-second false)
                  prefix
                    (and (= (.kind first) TOK-IDENT)
                         (or (token-is first "get")
                             (token-is first "set")
                             (token-is first "async"))
                         (or (token-property-name? second)
                             (token-is second "*"))
                         (not (and (token-is first "async") (.nl-before second))))]
              (if prefix
                  (do
                    (take-token)
                    (let [async (token-is first "async")
                          generator (and async (take-is "*"))
                          k (parse-syntax-property-key!)
                          kind
                            (if (token-is first "get")
                                (FunGetter)
                                (if (token-is first "set")
                                    (FunSetter)
                                    (FunMethod)))]
                      (parse-syntax-method! (.key k)
                                            (.name k)
                                            kind
                                            generator
                                            async
                                            (.start first))))
                  (let [k (parse-syntax-property-key!)
                        next (peek-token)]
                    (if (token-is next "(")
                        (parse-syntax-method! (.key k)
                                              (.name k)
                                              (FunMethod)
                                              false
                                              false
                                              (.lo k))
                        (if (token-is next ":")
                            (do
                              (take-token)
                              (if (.named-proto k)
                                  (if (load saw-proto)
                                      (syntax-error! "parser: duplicate __proto__ object-literal setter")
                                      (set! saw-proto true))
                                  0)
                              (PropValue (.key k) (parse-syntax-assignment)))
                            (if (.computed k)
                                (do
                                  (syntax-error! "parser: computed property name requires a value")
                                  (PropSpread 0))
                                (if (= (.name k) "let")
                                    ;; Sloppy shorthand `{let}`; strict code rejects the name.
                                    (PropValue (.key k) (syntax-add-node! (SxName "let") (.lo k) (.hi k)))
                                    (if (not (.ident k))
                                        (do
                                          (syntax-error! "parser: shorthand property requires an identifier")
                                          (PropSpread 0))
                                        (if (token-is next "=")
                                            (do
                                              (take-token)
                                              (PropCoverInit (.name k)
                                                             (parse-syntax-assignment)))
                                            (do
                                              (syntax-check-binding-name! (.name k))
                                              (PropValue (.key k)
                                                         (syntax-add-node! (SxName (.name k))
                                                                           (.lo k)
                                                                           (.hi k)))))))))))))))))

(defn parse-syntax-object-literal [(open Token)] (-> i64)
  (let [(mut entries) (al-new [ObjectEntry] (alloc/malloc-allocator))
        (mut saw-prototype-setter) false
        (mut rest-comma) false]
    (if (not (take-is "}"))
        (loop (let [entry (parse-syntax-property-definition! (mut saw-prototype-setter))]
                (push! [ObjectEntry] (mut entries) entry)
                ;; `{...a,}` is a valid literal but never a pattern.
                (set! (mut rest-comma)
                      (match entry (PropSpread [e] (token-is (peek-token) ",")) (_ false)))
                (if (parse-list-separator! "}"
                                           "parser: expected `,` or `}` in object literal")
                    (break 0)
                    (continue))))
        0)
    (let [id (syntax-add-node! (SxObject (load entries)) (.start open) (lex-consumed-end))]
      (if (load rest-comma) (push! [i64] (mut (.rest-comma (parser-state))) id) 0)
      id)))

(defn parse-syntax-array-literal [(open Token)] (-> i64)
  (let [(mut elements) (al-new [ArrayElement] (alloc/malloc-allocator))
        (mut rest-comma) false]
    (if (not (take-is "]"))
        (loop (let [first (peek-token)]
                (if (token-is first ",")
                    (do
                      (take-token)
                      (push! [ArrayElement] (mut elements) (ElemHole))
                      (if (take-is "]") (break 0) (continue)))
                    (do
                      (if (token-is first "...")
                          (do
                            (take-token)
                            (push! [ArrayElement]
                                   (mut elements)
                                   (ElemSpread (parse-syntax-assignment)))
                            ;; `[...a,]` is a valid literal but never a pattern.
                            (set! (mut rest-comma) (token-is (peek-token) ",")))
                          (do
                            (push! [ArrayElement]
                                   (mut elements)
                                   (ElemExpr (parse-syntax-assignment)))
                            (set! (mut rest-comma) false)))
                      (if (parse-list-separator! "]"
                                                 "parser: expected `,` or `]` in array literal")
                          (break 0)
                          (continue))))))
        0)
    (let [id (syntax-add-node! (SxArray (load elements)) (.start open) (lex-consumed-end))]
      (if (load rest-comma) (push! [i64] (mut (.rest-comma (parser-state))) id) 0)
      id)))

;; Arguments: AssignmentExpressions and `...spread`, with an optional trailing comma.
(defn parse-syntax-arguments [] (-> (ArrayList i64))
  (let [(mut args) (al-new [i64] (alloc/malloc-allocator))]
    (set! (.spread-trailing-comma (parser-state)) false)
    (if (not (take-is ")"))
        (loop (let [spread (token-is (peek-token) "...")]
                (if spread
                    (let [dots (take-token)
                          value (parse-syntax-assignment)]
                      (push! [i64]
                             (mut args)
                             (syntax-add-node! (SxSpread value)
                                               (.start dots)
                                               (syntax-hi value))))
                    (push! [i64] (mut args) (parse-syntax-assignment)))
                (let [comma (token-is (peek-token) ",")]
                  (if (parse-list-separator! ")"
                                             "parser: expected `,` or `)` in argument list")
                      (do
                        (if (and spread comma) (set! (.spread-trailing-comma (parser-state)) true) 0)
                        (break 0))
                      (continue)))))
        0)
    (load args)))

;; `import(specifier)` / `import(specifier, options)` and the module-only `import.meta`, which is a
;; proven error in a Script. Phase imports (`import.source`, `import.defer`) are proposals this
;; parser fails closed on; any other `import.x` matches no production.
(defn parse-syntax-import-expression [(keyword Token)] (-> i64)
  (if (take-is ".")
      (let [name (take-token)]
        (if (token-is name "meta")
            (syntax-error! "parser: import.meta is only valid in a module")
            (if (or (token-is name "source") (token-is name "defer"))
                (parse-fail "parser: phase imports are outside the admitted subset at byte"
                            name)
                (syntax-error! "parser: unexpected token after import"))))
      (if (take-is "(")
          (do
            (if (token-is (peek-token) ")")
                (syntax-error! "parser: import() requires a specifier")
                0)
            (if (token-is (peek-token) "...")
                (syntax-error! "parser: import() does not accept spread arguments")
                0)
            (let [specifier (parse-syntax-assignment)
                  options
                    (if (and (take-is ",") (not (token-is (peek-token) ")")))
                        (do
                          (if (token-is (peek-token) "...")
                              (syntax-error! "parser: import() does not accept spread arguments")
                              0)
                          (let [o (parse-syntax-assignment)]
                            (take-is ",")
                            (Some o)))
                        (None [i64]))]
              (require-closing! ")"
                                "parser: import() accepts at most two arguments")
              (syntax-add-node! (SxImportCall specifier options)
                                (.start keyword)
                                (lex-consumed-end))))
          (syntax-error! "parser: import declarations are only valid in a module"))))

(defn parse-syntax-template [(open Token) (tagged bool)] (-> i64)
  (let [(mut quasis) (al-new [i64] (alloc/malloc-allocator))
        (mut substitutions) (al-new [i64] (alloc/malloc-allocator))
        (mut part) (lex-template-part! open)]
    (loop (do
            (push! [i64]
                   (mut quasis)
                   (syntax-template-quasi (load part) tagged))
            (if (lex-template-continues? (load part))
                (let [saved-no-in (.no-in (parser-state))]
                  (set! (.no-in (parser-state)) false)
                  (push! [i64] (mut substitutions) (parse-syntax-expression))
                  (set! (.no-in (parser-state)) saved-no-in)
                  (let [brace (peek-token)]
                    (if (token-is brace "}")
                        (do
                          (set! (mut part) (lex-template-part! brace))
                          (continue))
                        (break (syntax-error! "parser: expected `}` after template substitution")))))
                (break 0))))
    (syntax-add-node! (SxTemplate (load quasis) (load substitutions))
                      (.start open)
                      (lex-consumed-end))))

;; RegularExpressionFlags: each of d g i m s u v y at most once, and not both u and v.
(defn syntax-check-regex-flags! [(flags (slice u8))] (-> i64)
  (let [(mut seen) (al-new [u8] (alloc/malloc-allocator))]
    (for c
      (iter flags)
      (do
        (if (not (or (= c (cast u8 100))
                     (= c (cast u8 103))
                     (= c (cast u8 105))
                     (= c (cast u8 109))
                     (= c (cast u8 115))
                     (= c (cast u8 117))
                     (= c (cast u8 118))
                     (= c (cast u8 121))))
            (syntax-error! "parser: invalid regular expression flag")
            0)
        (al-for [earlier (load seen)]
                (if (or (= earlier c)
                        (and (= earlier (cast u8 117)) (= c (cast u8 118)))
                        (and (= earlier (cast u8 118)) (= c (cast u8 117))))
                    (syntax-error! "parser: duplicate or conflicting regular expression flag")
                    0))
        (push! [u8] (mut seen) c)))
    (al-free! [u8] (mut seen))
    0))

(defn parse-syntax-regex [(slash Token)] (-> i64)
  (let [t (lex-regex! slash)
        text (token-text t)
        (mut close) (- (len text) 1)]
    (loop (if (= (get text (load close)) (cast u8 47))
              (break 0)
              (do (set! (mut close) (- (load close) 1)) (continue))))
    (let [body (subslice [u8] text 1 (load close))
          flags (subslice [u8] text (+ (load close) 1) (len text))]
      (syntax-check-regex-flags! flags)
      ;; The pattern grammar is an early error of the enclosing program; a classification the
      ;; validator cannot make fails closed.
      (match (regex-validate body flags)
        (RegexOk [] 0)
        (RegexError [message] (syntax-error! message))
        (RegexUnknown [message] (parse-fail message t)))
      (syntax-add-node! (SxRegex body flags) (.start t) (.end t)))))

;; IdentifierReference, or the start of an arrow function / async function that shares its first
;; token with one. `yield`/`await` reaching this point inside their reserving contexts are errors:
;; the expression forms are parsed at the assignment and unary levels.
(defn parse-syntax-identifier-primary [(t Token)] (-> i64)
  (let [next (peek-token)
        same-line (not (.nl-before next))]
    ;; These are StringValue rules: an escaped spelling of the name is still the name.
    (if (token-escaped-reserved? t)
        (syntax-error! "parser: escaped reserved word cannot be an identifier")
    (if (and (= (token-text t) "yield") (parser-ctx-generator?))
        (syntax-error! "parser: yield expression is not allowed here")
        (if (and (= (token-text t) "await") (or (parser-ctx-async?) (parser-ctx-static-block?)))
            (syntax-error! "parser: await expression is not allowed here")
            (if (and (= (token-text t) "arguments") (parser-ctx-forbids-arguments?))
                (syntax-error! "parser: arguments is not allowed in a class field initializer or static block")
                (if (and (token-is t "async")
                         same-line
                         (not (.new-callee (parser-state)))
                         (or (token-is next "function")
                             (= (.kind next) TOK-IDENT)
                             (token-is next "(")))
                    (parse-syntax-async-head t)
                    (if (and same-line (token-is next "=>"))
                        (let [(mut params) (al-new [(slice u8)] (alloc/malloc-allocator))
                              (mut defaults) (al-new [(Option i64)] (alloc/malloc-allocator))
                              (mut patterns) (al-new [(Option i64)] (alloc/malloc-allocator))]
                          (syntax-check-binding-name! (token-text t))
                          (push! [(slice u8)] (mut params) (token-text t))
                          (push! [(Option i64)] (mut defaults) (None [i64]))
                          (push! [(Option i64)] (mut patterns) (None [i64]))
                          (parse-syntax-arrow-body! (.start t)
                                                    (load params)
                                                    (load defaults)
                                                    (load patterns)
                                                    (None [(slice u8)])
                                                    (None [i64])
                                                    true
                                                    false))
                        (syntax-add-node! (SxName (token-text t)) (.start t) (.end t))))))))))

;; `async function …`, `async x => …`, `async (…) => …`, or an ordinary call `async(…)`
;; (CoverCallExpressionAndAsyncArrowHead).
(defn parse-syntax-async-head [(t Token)] (-> i64)
  (let [next (peek-token)]
    (if (token-is next "function")
        (parse-syntax-function-expression (take-token) true (.start t))
        (if (= (.kind next) TOK-IDENT)
            (let [param (take-token)
                  (mut params) (al-new [(slice u8)] (alloc/malloc-allocator))
                  (mut defaults) (al-new [(Option i64)] (alloc/malloc-allocator))
                  (mut patterns) (al-new [(Option i64)] (alloc/malloc-allocator))]
              (if (= (token-text param) "await")
                  (syntax-error! "parser: await is not a valid async arrow parameter")
                  0)
              (syntax-check-binding-name! (token-text param))
              (push! [(slice u8)] (mut params) (token-text param))
              (push! [(Option i64)] (mut defaults) (None [i64]))
              (push! [(Option i64)] (mut patterns) (None [i64]))
              (if (not (token-is (peek-token) "=>"))
                  (syntax-error! "parser: expected => after async arrow parameter")
                  0)
              (parse-syntax-arrow-body! (.start t)
                                        (load params)
                                        (load defaults)
                                        (load patterns)
                                        (None [(slice u8)])
                                        (None [i64])
                                        true
                                        true))
            (do
              (take-token)
              (let [args (parse-syntax-arguments)
                    trailing (.spread-trailing-comma (parser-state))
                    after (peek-token)]
                (if (and (token-is after "=>") (not (.nl-before after)))
                    (do
                      (if trailing (syntax-error! "parser: rest parameter must be last") 0)
                      (parse-syntax-arrow-from-cover! (.start t) args true))
                    (let [callee
                            (syntax-add-node! (SxName "async")
                                              (.start t)
                                              (.end t))]
                      (syntax-add-node! (SxCall
                                          :callee callee
                                          :args args
                                          :optional false)
                                        (.start t)
                                        (lex-consumed-end))))))))))

;; `super.x`, `super[x]` inside a method (through arrows); `super(...)` only inside a derived
;; class constructor, which does not exist yet. Anything else is a proven error.
(defn parse-syntax-super [(t Token)] (-> i64)
  (let [next (peek-token)]
    (if (or (token-is next ".") (token-is next "["))
        (if (parser-ctx-home-method?)
            (syntax-add-node! (SxSuper) (.start t) (.end t))
            (syntax-error! "parser: super property access is only allowed in a method"))
        (if (token-is next "(")
            (if (parser-ctx-allows-super-call?)
                (syntax-add-node! (SxSuper) (.start t) (.end t))
                (syntax-error! "parser: super call is only allowed in a derived class constructor"))
            (syntax-error! "parser: unexpected super")))))

;; CoverParenthesizedExpressionAndArrowParameterList. Parentheses restore the `[+In]` grammar.
;; The list is parsed as expressions; a following `=>` reinterprets it as ArrowFormalParameters,
;; otherwise an empty list, a rest element or a trailing comma is a proven error and the items
;; fold into a comma expression inside a group.
(defn parse-syntax-parenthesized [(open Token)] (-> i64)
  (let [saved-no-in (.no-in (parser-state))
        (mut items) (al-new [i64] (alloc/malloc-allocator))
        (mut arrow-only) false]
    (set! (.no-in (parser-state)) false)
    (if (take-is ")")
        (set! (mut arrow-only) true)
        (loop (if (token-is (peek-token) "...")
                  (let [dots (take-token)
                        target
                          (if (or (token-is (peek-token) "[") (token-is (peek-token) "{"))
                              (parse-syntax-primary)
                              (let [name (require-binding-identifier)]
                                (syntax-add-node! (SxName (token-text name)) (.start name) (.end name))))]
                    (set! (mut arrow-only) true)
                    (if (token-is (peek-token) "=")
                        (syntax-error! "parser: rest parameter may not have a default")
                        0)
                    (push! [i64]
                           (mut items)
                           (syntax-add-node! (SxSpread target) (.start dots) (syntax-hi target)))
                    (if (take-is ")")
                        0
                        (syntax-error! "parser: rest parameter must be last"))
                    (break 0))
                  (do
                    (push! [i64] (mut items) (parse-syntax-assignment))
                    (if (take-is ",")
                        (if (take-is ")")
                            (break (do (set! (mut arrow-only) true) 0))
                            (continue))
                        (break (do
                                 (require-closing! ")"
                                                   "parser: expected `)` after expression")
                                 0)))))))
    (set! (.no-in (parser-state)) saved-no-in)
    (let [after (peek-token)]
      (if (and (token-is after "=>") (not (.nl-before after)))
          (parse-syntax-arrow-from-cover! (.start open) (load items) false)
          (if (load arrow-only)
              (syntax-error! "parser: expected an expression")
              (let [(mut expr) (get (load items) 0)
                    (mut i) 1]
                (loop (if (>= (load i) (len (load items)))
                          (break 0)
                          (let [rhs (get (load items) (load i))]
                            (set! (mut expr)
                                  (syntax-binary! (SxComma (load expr) rhs)
                                                  (load expr)
                                                  rhs))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (syntax-add-node! (SxGroup (load expr))
                                  (.start open)
                                  (lex-consumed-end))))))))

;; Refine cover-grammar items into ArrowFormalParameters: names, `name = default` and a trailing
;; `...rest`. Patterns fail closed; anything else, or a `yield`/`await` expression inside a
;; default, is a proven error. An async head reserves `await` as well.
;; A nested arrow's parameter names, defaults and concise body are part of the enclosing head.
(defn syntax-fun-params-mention? [(fun i64) (yield? bool) (await? bool)] (-> bool)
  (let [f (syntax-fun-at fun)
        (mut found) false]
    (al-for [name (.params f)]
            (if (or (and yield? (= name "yield")) (and await? (= name "await"))) (set! (mut found) true) 0))
    (match (.rest-param f)
      (Some [r] (if (or (and yield? (= r "yield")) (and await? (= r "await"))) (set! (mut found) true) 0))
      (None [] 0))
    (al-for [d (.param-defaults f)]
            (match d (Some [e] (if (syntax-expr-contains? e yield? await?) (set! (mut found) true) 0)) (None [] 0)))
    ;; Destructured parameters: their bound names and the expressions they own.
    (let [(mut names) (al-new [(slice u8)] (alloc/malloc-allocator))
          (mut exprs) (al-new [i64] (alloc/malloc-allocator))]
      (al-for [p (.param-patterns f)]
              (match p
                (Some [pat] (do (syntax-pattern-names! pat (mut names)) (syntax-pattern-exprs! pat (mut exprs))))
                (None [] 0)))
      (match (.rest-pattern f)
        (Some [pat] (do (syntax-pattern-names! pat (mut names)) (syntax-pattern-exprs! pat (mut exprs))))
        (None [] 0))
      (al-for [name (load names)]
              (if (or (and yield? (= name "yield")) (and await? (= name "await"))) (set! (mut found) true) 0))
      (al-for [e (load exprs)]
              (if (syntax-expr-contains? e yield? await?) (set! (mut found) true) 0))
      (al-free! [(slice u8)] (mut names))
      (al-free! [i64] (mut exprs)))
    (match (.expression-body f)
      (Some [e] (if (syntax-expr-contains? e yield? await?) (set! (mut found) true) 0))
      (None [] 0))
    (load found)))

(defn syntax-expr-contains? [(id i64) (yield? bool) (await? bool)] (-> bool)
  (let [(mut children) (al-new [i64] (alloc/malloc-allocator))
        (mut found)
          (match (syntax-node id)
            (SxYield [argument delegate] yield?)
            (SxAwait [operand] await?)
            (SxName [name] (and await? (= name "await")))
            (SxFunction [fun] (syntax-fun-params-mention? fun yield? await?))
            (_ false))]
    (syntax-expr-children! id (mut children))
    (al-for [child (load children)]
            (if (syntax-expr-contains? child yield? await?)
                (set! (mut found) true)
                0))
    (al-free! [i64] (mut children))
    (load found)))

(defn parse-syntax-arrow-from-cover! [(lo i64)
                                      (items (ArrayList i64))
                                      (async bool)] (-> i64)
  (let [(mut params) (al-new [(slice u8)] (alloc/malloc-allocator))
        (mut defaults) (al-new [(Option i64)] (alloc/malloc-allocator))
        (mut patterns) (al-new [(Option i64)] (alloc/malloc-allocator))
        (mut rest) (None [(slice u8)])
        (mut rest-pattern) (None [i64])
        (mut simple) true
        (mut i) 0]
    (loop (if (>= (load i) (len items))
              (break 0)
              (let [item (get items (load i))]
                (if (syntax-expr-contains? item
                                           (parser-ctx-generator?)
                                           (or async (parser-ctx-async?)))
                    (syntax-error! "parser: yield or await is not allowed in arrow parameters")
                    0)
                (match (syntax-node item)
                  (SxName [name]
                          (do
                            (if async
                                (if (= name "await")
                                    (syntax-error! "parser: await is not a valid async arrow parameter")
                                    0)
                                0)
                            (push! [(slice u8)] (mut params) name)
                            (push! [(Option i64)] (mut defaults) (None [i64]))
                            (push! [(Option i64)] (mut patterns) (None [i64]))))
                  (SxAssign [target value]
                            (match (syntax-node target)
                              (SxName [name]
                                      (do
                                        (set! (mut simple) false)
                                        (push! [(slice u8)] (mut params) name)
                                        (push! [(Option i64)] (mut defaults) (Some value))
                                        (push! [(Option i64)] (mut patterns) (None [i64]))))
                              (SxObject [entries]
                                        (do
                                          (set! (mut simple) false)
                                          (push! [(slice u8)] (mut params) "")
                                          (push! [(Option i64)] (mut defaults) (Some value))
                                          (push! [(Option i64)]
                                                 (mut patterns)
                                                 (Some (syntax-cover-to-pattern! target true)))))
                              (SxArray [elements]
                                       (do
                                         (set! (mut simple) false)
                                         (push! [(slice u8)] (mut params) "")
                                         (push! [(Option i64)] (mut defaults) (Some value))
                                         (push! [(Option i64)]
                                                (mut patterns)
                                                (Some (syntax-cover-to-pattern! target true)))))
                              (_ (syntax-error! "parser: invalid arrow function parameter"))))
                  (SxSpread [expr]
                            (do
                              (if (!= (load i) (- (len items) 1))
                                  (syntax-error! "parser: rest parameter must be last")
                                  0)
                              (set! (mut simple) false)
                              (match (syntax-node expr)
                                (SxName [name] (do (set! (mut rest) (Some name)) 0))
                                (SxObject [entries]
                                          (do (set! (mut rest-pattern) (Some (syntax-cover-to-pattern! expr true))) 0))
                                (SxArray [elements]
                                         (do (set! (mut rest-pattern) (Some (syntax-cover-to-pattern! expr true))) 0))
                                (SxAssign [target value]
                                          (syntax-error! "parser: rest parameter may not have a default"))
                                (_ (syntax-error! "parser: invalid arrow function parameter")))))
                  ;; `([a] = b) => …` parsed as a destructuring assignment; its pattern must be
                  ;; a binding pattern.
                  (SxDestructuringAssign [pattern value]
                                         (do
                                           (set! (mut simple) false)
                                           (syntax-pattern-require-binding! pattern)
                                           (push! [(slice u8)] (mut params) "")
                                           (push! [(Option i64)] (mut defaults) (Some value))
                                           (push! [(Option i64)] (mut patterns) (Some pattern))))
                  (SxObject [entries]
                            (do
                              (set! (mut simple) false)
                              (push! [(slice u8)] (mut params) "")
                              (push! [(Option i64)] (mut defaults) (None [i64]))
                              (push! [(Option i64)] (mut patterns) (Some (syntax-cover-to-pattern! item true)))))
                  (SxArray [elements]
                           (do
                             (set! (mut simple) false)
                             (push! [(slice u8)] (mut params) "")
                             (push! [(Option i64)] (mut defaults) (None [i64]))
                             (push! [(Option i64)] (mut patterns) (Some (syntax-cover-to-pattern! item true)))))
                  (_ (syntax-error! "parser: invalid arrow function parameter")))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (parse-syntax-arrow-body! lo
                              (load params)
                              (load defaults)
                              (load patterns)
                              (load rest)
                              (load rest-pattern)
                              (load simple)
                              async)))

;; BindingPattern: `[ elements ]` or `{ properties }` in a declaration, parameter or catch clause.
;; Elements are names or nested patterns with an optional `= default`; a rest element takes no
;; default and must be last; an object rest element is a plain name.
(defn parse-syntax-binding-element! [] (-> i64)
  (let [t (peek-token)
        target
          (if (or (token-is t "[") (token-is t "{"))
              (parse-syntax-binding-pattern!)
              (let [name (require-binding-identifier)]
                (syntax-pattern-add! (PatName (token-text name)) (None [i64]) (.start name) (.end name))))]
    (if (take-is "=")
        (let [value (parse-syntax-assignment)
              x (syntax-pattern-at target)]
          (syntax-pattern-add! (.node x) (Some value) (.lo x) (syntax-hi value)))
        target)))

(defn parse-syntax-binding-pattern! [] (-> i64)
  (let [open (take-token)]
    (if (token-is open "[")
        (let [(mut elements) (al-new [PatElem] (alloc/malloc-allocator))
              (mut rest) (None [i64])]
          (loop (let [t (peek-token)]
                  (if (token-is t "]")
                      (break (do (take-token) 0))
                      (if (token-is t ",")
                          (do (take-token) (push! [PatElem] (mut elements) (PatHole)) (continue))
                          (if (token-is t "...")
                              (do
                                (take-token)
                                (let [target
                                        (if (or (token-is (peek-token) "[") (token-is (peek-token) "{"))
                                            (parse-syntax-binding-pattern!)
                                            (let [name (require-binding-identifier)]
                                              (syntax-pattern-add! (PatName (token-text name))
                                                                   (None [i64])
                                                                   (.start name)
                                                                   (.end name))))]
                                  (if (token-is (peek-token) "=")
                                      (syntax-error! "parser: rest element may not have a default")
                                      0)
                                  (set! (mut rest) (Some target))
                                  (if (take-is "]") 0 (syntax-error! "parser: rest element must be last"))
                                  (break 0)))
                              (do
                                (push! [PatElem] (mut elements) (PatItem (parse-syntax-binding-element!)))
                                (if (parse-list-separator! "]" "parser: expected `,` or `]` in array pattern")
                                    (break 0)
                                    (continue))))))))
          (syntax-pattern-add! (PatArray (load elements) (load rest)) (None [i64]) (.start open) (lex-consumed-end)))
        (let [(mut props) (al-new [PatProp] (alloc/malloc-allocator))
              (mut rest) (None [i64])]
          (loop (let [t (peek-token)]
                  (if (token-is t "}")
                      (break (do (take-token) 0))
                      (if (token-is t "...")
                          (do
                            (take-token)
                            (let [name (require-binding-identifier)]
                              (set! (mut rest)
                                    (Some (syntax-pattern-add! (PatName (token-text name))
                                                               (None [i64])
                                                               (.start name)
                                                               (.end name)))))
                            (if (take-is "}") 0 (syntax-error! "parser: rest element must be last"))
                            (break 0))
                          (let [k (parse-syntax-property-key!)
                                (mut prop) (primitive/zeroed PatProp)]
                            (set! (.key (mut prop)) (.key k))
                            (if (take-is ":")
                                (set! (.pattern (mut prop)) (parse-syntax-binding-element!))
                                (do
                                  (if (not (.ident k))
                                      (syntax-error! "parser: shorthand binding property requires an identifier")
                                      0)
                                  (syntax-check-binding-name! (.name k))
                                  (set! (.pattern (mut prop))
                                        (let [target
                                                (syntax-pattern-add! (PatName (.name k)) (None [i64]) (.lo k) (.hi k))]
                                          (if (take-is "=")
                                              (let [value (parse-syntax-assignment)]
                                                (syntax-pattern-add! (PatName (.name k))
                                                                     (Some value)
                                                                     (.lo k)
                                                                     (syntax-hi value)))
                                              target)))))
                            (push! [PatProp] (mut props) (load prop))
                            (if (parse-list-separator! "}" "parser: expected `,` or `}` in object pattern")
                                (break 0)
                                (continue)))))))
          (syntax-pattern-add! (PatObject (load props) (load rest)) (None [i64]) (.start open) (lex-consumed-end))))))

;; Reinterpret an object or array literal parsed by the cover grammar as a pattern. `binding`
;; patterns accept only names at the leaves; assignment patterns also accept Reference
;; expressions. Parentheses around a pattern, methods, call expressions, defaults on rest elements
;; and non-final rest elements are proven errors.
(defn syntax-mark-cover-consumed! [(expr i64)] (-> i64)
  (push! [i64] (mut (.cover-consumed (parser-state))) expr))

(defn syntax-cover-consumed? [(expr i64)] (-> bool)
  (let [(mut found) false]
    (al-for [id (.cover-consumed (parser-state))] (if (= id expr) (set! (mut found) true) 0))
    (load found)))

(defn syntax-cover-leaf! [(expr i64) (binding bool)] (-> i64)
  (let [x (syntax-at expr)]
    (match (.node x)
      (SxName [name]
              (do
                (if binding (syntax-check-binding-name! name) 0)
                (syntax-pattern-add! (PatName name) (None [i64]) (.lo x) (.hi x))))
      (SxMember [owner name optional]
                (if (or binding (syntax-optional-chain? expr))
                    (syntax-error! "parser: invalid destructuring target")
                    (syntax-pattern-add! (PatTarget expr) (None [i64]) (.lo x) (.hi x))))
      (SxPrivateMember [owner name optional]
                       (if (or binding (syntax-optional-chain? expr))
                           (syntax-error! "parser: invalid destructuring target")
                           (syntax-pattern-add! (PatTarget expr) (None [i64]) (.lo x) (.hi x))))
      (SxIndex [owner key optional]
               (if (or binding (syntax-optional-chain? expr))
                   (syntax-error! "parser: invalid destructuring target")
                   (syntax-pattern-add! (PatTarget expr) (None [i64]) (.lo x) (.hi x))))
      (_ (syntax-error! "parser: invalid destructuring target")))))

(defn syntax-cover-to-element! [(expr i64) (binding bool)] (-> i64)
  (let [x (syntax-at expr)]
    (match (.node x)
      (SxAssign [target value]
                (let [element (syntax-cover-to-element! target binding)
                      e (syntax-pattern-at element)]
                  (match (.default e)
                    (Some [d] (syntax-error! "parser: invalid destructuring target"))
                    (None [] 0))
                  (syntax-pattern-add! (.node e) (Some value) (.lo e) (.hi x))))
      (SxObject [entries] (syntax-cover-to-pattern! expr binding))
      (SxArray [elements] (syntax-cover-to-pattern! expr binding))
      (SxGroup [inner]
               (if binding
                   (syntax-error! "parser: invalid binding pattern")
                   (let [target (syntax-ungroup-id expr)]
                     (match (syntax-node target)
                       (SxObject [entries] (syntax-error! "parser: a parenthesized pattern is not a valid target"))
                       (SxArray [elements] (syntax-error! "parser: a parenthesized pattern is not a valid target"))
                       ;; `(a)` is a Reference, not a binding: keep the parentheses so a later
                       ;; reinterpretation as a binding pattern rejects it.
                       (SxName [name] (syntax-pattern-add! (PatTarget expr) (None [i64]) (.lo x) (.hi x)))
                       (_ (syntax-cover-leaf! target binding))))))
      (_ (syntax-cover-leaf! expr binding)))))

(defn syntax-rest-comma? [(expr i64)] (-> bool)
  (let [(mut found) false]
    (al-for [id (.rest-comma (parser-state))] (if (= id expr) (set! (mut found) true) 0))
    (load found)))

(defn syntax-cover-to-pattern! [(expr i64) (binding bool)] (-> i64)
  (let [x (syntax-at expr)]
    (syntax-mark-cover-consumed! expr)
    (if (syntax-rest-comma? expr) (syntax-error! "parser: rest element must be last") 0)
    (match (.node x)
      (SxObject [entries]
                (let [(mut props) (al-new [PatProp] (alloc/malloc-allocator))
                      (mut rest) (None [i64])
                      (mut i) 0]
                  (al-for [entry entries]
                          (do
                            (match (load rest)
                              (Some [r] (syntax-error! "parser: rest element must be last"))
                              (None [] 0))
                            (match entry
                              (PropValue [key value]
                                         (let [(mut prop) (primitive/zeroed PatProp)]
                                           (set! (.key (mut prop)) key)
                                           (set! (.pattern (mut prop)) (syntax-cover-to-element! value binding))
                                           (push! [PatProp] (mut props) (load prop))))
                              (PropCoverInit [name init]
                                             (let [(mut prop) (primitive/zeroed PatProp)]
                                               (if binding (syntax-check-binding-name! name) 0)
                                               (set! (.key (mut prop)) (KeyNamed (shape-key-intern name)))
                                               (set! (.pattern (mut prop))
                                                     (syntax-pattern-add! (PatName name)
                                                                          (Some init)
                                                                          (.lo x)
                                                                          (syntax-hi init)))
                                               (push! [PatProp] (mut props) (load prop))))
                              (PropSpread [e]
                                          (do
                                            (match (syntax-node e)
                                              (SxObject [inner]
                                                        (syntax-error! "parser: object rest element must be a simple target"))
                                              (SxArray [inner]
                                                       (syntax-error! "parser: object rest element must be a simple target"))
                                              (SxAssign [target value]
                                                        (syntax-error! "parser: rest element may not have a default"))
                                              (_ 0))
                                            (set! (mut rest) (Some (syntax-cover-to-element! e binding)))))
                              (PropMethod [key fun] (syntax-error! "parser: invalid destructuring target")))
                            (set! (mut i) (+ (load i) 1))))
                  (syntax-pattern-add! (PatObject (load props) (load rest)) (None [i64]) (.lo x) (.hi x))))
      (SxArray [elements]
               (let [(mut items) (al-new [PatElem] (alloc/malloc-allocator))
                     (mut rest) (None [i64])]
                 (al-for [element elements]
                         (do
                           (match (load rest)
                             (Some [r] (syntax-error! "parser: rest element must be last"))
                             (None [] 0))
                           (match element
                             (ElemHole [] (push! [PatElem] (mut items) (PatHole)))
                             (ElemExpr [e] (push! [PatElem] (mut items) (PatItem (syntax-cover-to-element! e binding))))
                             (ElemSpread [e]
                                         (do
                                           (match (syntax-node e)
                                             (SxAssign [target value]
                                                       (syntax-error! "parser: rest element may not have a default"))
                                             (_ 0))
                                           (set! (mut rest) (Some (syntax-cover-to-element! e binding))))))))
                 (syntax-pattern-add! (PatArray (load items) (load rest)) (None [i64]) (.lo x) (.hi x))))
      (_ (do (broken "syntax-cover-to-pattern!: not an object or array literal") 0)))))

(defn parse-syntax-primary [] (-> i64)
  (let [t (take-token)]
    (if (= (.kind t) TOK-BIGINT)
        (unimplemented "BigInt literal value lowering"
                       "jsl/compiler — BigInt runtime")
        0)
    (if (or (= (.kind t) TOK-NUMBER) (= (.kind t) TOK-LEGACY-NUMBER))
        (syntax-add! (syntax-number t))
        (if (or (token-is t "true") (token-is t "false") (token-is t "null"))
            (syntax-add-node! (SxSingleton (if (token-is t "true")
                                               "JsTrue"
                                               (if (token-is t "false")
                                                   "JsFalse"
                                                   "JsNull")))
                              (.start t)
                              (.end t))
            (if (or (= (.kind t) TOK-IDENT) (token-is t "let"))
                (parse-syntax-identifier-primary t)
                (if (= (.kind t) TOK-STRING)
                    (syntax-add! (syntax-string t))
                    (if (token-is t "(")
                        (parse-syntax-parenthesized t)
                        (if (token-is t "{")
                            (parse-syntax-object-literal t)
                            (if (token-is t "[")
                                (parse-syntax-array-literal t)
                                (if (token-is t "this")
                                    (syntax-add-node! (SxThis)
                                                      (.start t)
                                                      (.end t))
                                    (if (token-is t "super")
                                        (parse-syntax-super t)
                                        (if (token-is t "function")
                                            (parse-syntax-function-expression t false (.start t))
                                            (if (token-is t "class")
                                                (let [cls (parse-syntax-class t false)]
                                                  (syntax-add-node! (SxClass cls) (.start t) (syntax-class-hi cls)))
                                                (if (token-is t "#")
                                                    (parse-syntax-private-in t)
                                                    (if (token-is t "import")
                                                        (parse-syntax-import-expression t)
                                                        (if (token-is t "`")
                                                            (parse-syntax-template t
                                                                                   false)
                                                            (if (and (= (.kind t)
                                                                        TOK-PUNCT)
                                                                     (or (token-is t
                                                                                   "/")
                                                                         (token-is t
                                                                                   "/=")))
                                                                (parse-syntax-regex t)
                                                                (parse-primary-fallback t))))))))))))))))))

;; The member/call suffix loop shared by MemberExpression (`allow-call` false, for a `new` callee),
;; CallExpression and OptionalExpression. A tagged template cannot follow an optional chain.
(defn parse-syntax-member-tail [(start i64) (allow-call bool)] (-> i64)
  (let [(mut base) start]
    (loop (let [t (peek-token)]
            (if (and (syntax-arrow? (load base))
                     (or (token-is t ".")
                         (token-is t "?.")
                         (token-is t "[")
                         (token-is t "`")
                         (and allow-call (token-is t "("))))
                (syntax-error! "parser: an arrow function cannot be accessed or called without parentheses")
                0)
            (if (token-is t ".")
                (do
                  (take-token)
                  (if (token-is (peek-token) "#")
                      (let [is-super (match (syntax-node (load base)) (SxSuper [] true) (_ false))
                            name (parse-syntax-private-name! (take-token))]
                        (if is-super (syntax-error! "parser: super cannot access a private name") 0)
                        (set! (mut base)
                              (syntax-add-node! (SxPrivateMember
                                                  :owner (load base)
                                                  :name (token-text name)
                                                  :optional false)
                                                (syntax-lo (load base))
                                                (.end name))))
                      (let [member (require-property-name)]
                        (set! (mut base)
                              (syntax-add-node! (SxMember
                                                  :owner (load base)
                                                  :name (token-text member)
                                                  :optional false)
                                                (syntax-lo (load base))
                                                (.end member)))))
                  (continue))
                (if (token-is t "?.")
                    (do
                      (take-token)
                      (let [next (peek-token)]
                        (if (token-is next "(")
                            (do
                              (take-token)
                              (let [args (parse-syntax-arguments)]
                                (set! (mut base)
                                      (syntax-add-node! (SxCall
                                                          :callee (load base)
                                                          :args args
                                                          :optional true)
                                                        (syntax-lo (load base))
                                                        (lex-consumed-end)))))
                            (if (token-is next "[")
                                (let [saved-no-in (.no-in (parser-state))]
                                  (take-token)
                                  (set! (.no-in (parser-state)) false)
                                  (let [key (parse-syntax-expression)]
                                    (set! (.no-in (parser-state)) saved-no-in)
                                    (require-closing! "]"
                                                      "parser: expected `]` after computed member")
                                    (set! (mut base)
                                          (syntax-add-node! (SxIndex
                                                              :owner (load base)
                                                              :key key
                                                              :optional true)
                                                            (syntax-lo (load base))
                                                            (lex-consumed-end)))))
                                (if (token-is next "`")
                                    (syntax-error! "parser: tagged template is not allowed in an optional chain")
                                    (if (token-is next "#")
                                        (let [name (parse-syntax-private-name! (take-token))]
                                          (set! (mut base)
                                                (syntax-add-node! (SxPrivateMember
                                                                    :owner (load base)
                                                                    :name (token-text name)
                                                                    :optional true)
                                                                  (syntax-lo (load base))
                                                                  (.end name))))
                                        (if (or (= (.kind next) TOK-IDENT)
                                                (= (.kind next) TOK-KEYWORD))
                                            (let [member (take-token)]
                                              (set! (mut base)
                                                    (syntax-add-node! (SxMember
                                                                        :owner (load base)
                                                                        :name (token-text member)
                                                                        :optional true)
                                                                      (syntax-lo (load base))
                                                                      (.end member))))
                                            (syntax-error! "parser: expected a property, index or call after ?.")))))))
                      (continue))
                    (if (token-is t "[")
                        (let [saved-no-in (.no-in (parser-state))]
                          (take-token)
                          (set! (.no-in (parser-state)) false)
                          (let [key (parse-syntax-expression)]
                            (set! (.no-in (parser-state)) saved-no-in)
                            (require-closing! "]"
                                              "parser: expected `]` after computed member")
                            (set! (mut base)
                                  (syntax-add-node! (SxIndex
                                                      :owner (load base)
                                                      :key key
                                                      :optional false)
                                                    (syntax-lo (load base))
                                                    (lex-consumed-end)))
                            (continue)))
                        (if (and allow-call (token-is t "("))
                            (do
                              (take-token)
                              (let [args (parse-syntax-arguments)]
                                (set! (mut base)
                                      (syntax-add-node! (SxCall
                                                          :callee (load base)
                                                          :args args
                                                          :optional false)
                                                        (syntax-lo (load base))
                                                        (lex-consumed-end)))
                                (continue)))
                            (if (token-is t "`")
                                (do
                                  (if (syntax-optional-chain? (load base))
                                      (syntax-error! "parser: tagged template is not allowed in an optional chain")
                                      0)
                                  (take-token)
                                  (let [template (parse-syntax-template t true)]
                                    (set! (mut base)
                                          (syntax-add-node! (SxTaggedTemplate (load base)
                                                                              template)
                                                            (syntax-lo (load base))
                                                            (lex-consumed-end)))
                                    (continue)))
                                (break 0))))))))
    (load base)))

;; `new MemberExpression Arguments?`, `new new X()()`, and the meta property `new.target`, which
;; is a proven error outside a function body. An `import()` or optional chain cannot be a `new`
;; callee.
(defn parse-syntax-new [(keyword Token)] (-> i64)
  (if (take-is ".")
      (let [name (take-token)]
        (if (not (token-is name "target"))
            (syntax-error! "parser: expected new.target")
            (if (not (parser-ctx-allows-new-target?))
                (syntax-error! "parser: new.target is not allowed outside a function")
                (syntax-add-node! (SxNewTarget) (.start keyword) (.end name)))))
      (let [callee
              (if (token-is (peek-token) "new")
                  (parse-syntax-new (take-token))
                  (parse-syntax-member-tail (parse-syntax-primary) false))]
        (match (syntax-node (syntax-spine-root callee))
          (SxImportCall [specifier options]
                        (syntax-error! "parser: import() cannot be used with new"))
          (_ 0))
        (if (syntax-optional-chain? callee)
            (syntax-error! "parser: optional chain cannot be used with new")
            0)
        (syntax-reject-arrow-operand! callee)
        (let [args
                (if (take-is "(")
                    (parse-syntax-arguments)
                    (al-new [i64] (alloc/malloc-allocator)))]
          (syntax-add-node! (SxNew callee args)
                            (.start keyword)
                            (lex-consumed-end))))))

;; LeftHandSideExpression: NewExpression or CallExpression, with the shared suffix loop.
(defn parse-syntax-lhs [] (-> i64)
  (let [first (peek-token)
        base
          (if (token-is first "new")
              (parse-syntax-new (take-token))
              (parse-syntax-primary))]
    (parse-syntax-member-tail base true)))

;; AssignmentTargetType. A name or property Reference is simple. A CallExpression is invalid, but
;; only strict code proves it early: sloppy web-compatible code defers to a runtime ReferenceError,
;; so the strict pass reports it and lowering refuses it by name. Every other admitted expression
;; kind is proven invalid here. Parentheses are transparent for Reference targets, while a
;; parenthesized object literal can no longer be reinterpreted as a destructuring pattern.
(defn syntax-check-simple-target! [(id i64) (pattern-allowed bool) (web-compat bool)] (-> i64)
  (let [target-id (syntax-ungroup-id id)
        pattern (and pattern-allowed (= target-id id))]
    (if (syntax-optional-chain? target-id)
        (syntax-error! "parser: optional chain is not a valid assignment target")
        (match (syntax-node target-id)
          (SxName [name] 0)
          (SxMember [owner name optional] 0)
          (SxPrivateMember [owner name optional] 0)
          (SxIndex [owner key optional] 0)
          ;; Sloppy `f() = 1`, `f() += 1` and `f()++` defer to a runtime ReferenceError; logical
          ;; assignment and for-in/of heads never do.
          (SxCall [callee args optional]
                  (if web-compat 0 (syntax-error! "parser: call expression is not a valid assignment target")))
          (SxObject [entries] (syntax-error! "parser: invalid assignment target"))
          (SxArray [elements] (syntax-error! "parser: invalid assignment target"))
          (_ (syntax-error! "parser: invalid assignment target"))))))

(defn token-update-op-name [(t Token)] (-> (slice u8))
  (if (token-is t "++") "JsIncrement" "JsDecrement"))

;; UpdateExpression: postfix `++`/`--` must follow on the same line. A line terminator ends the
;; LeftHandSideExpression and the operator then begins a prefix update of the next statement.
(defn parse-syntax-update [] (-> i64)
  (let [lhs (parse-syntax-lhs)
        t (peek-token)]
    (if (and (or (token-is t "++") (token-is t "--")) (not (.nl-before t)))
        (do
          (take-token)
          (syntax-check-simple-target! lhs false true)
          (syntax-add-node! (SxUpdate
                              :op (token-update-op-name t)
                              :prefix false
                              :target (syntax-ungroup-id lhs))
                            (syntax-lo lhs)
                            (.end t)))
        lhs)))

(defn token-unary-operator? [(t Token)] (-> bool)
  (or (token-is t "!")
      (token-is t "void")
      (token-is t "-")
      (token-is t "+")
      (token-is t "typeof")
      (token-is t "~")
      (token-is t "delete")))

(defn token-unary-op-name [(t Token)] (-> (slice u8))
  (if (token-is t "!")
      "JsLogicalNot"
      (if (token-is t "void")
          "JsVoid"
          (if (token-is t "-")
              "JsNegate"
              (if (token-is t "typeof")
                  "JsTypeof"
                  (if (token-is t "~") "JsBitNot" "JsPositive"))))))

(defn parse-syntax-unary [] (-> i64)
  ;; Final Simple recursively parses unary minus before its multiplication loop. JavaScript
  ;; numeric conversion belongs to JSL; the parser never subtracts from zero (which loses -0).
  (let [t (peek-token)]
    (if (and (token-is t "await") (parser-ctx-async?))
        (do
          (take-token)
          (if (parser-ctx-in-params?)
              (syntax-error! "parser: await expression is not allowed in formal parameters")
              0)
          (let [operand (parse-syntax-unary)]
            (syntax-reject-arrow-operand! operand)
            (syntax-add-node! (SxAwait operand) (.start t) (syntax-hi operand))))
        (if (token-unary-operator? t)
            (do
              (take-token)
              (let [operand (parse-syntax-unary)
                    hi (syntax-hi operand)]
                (syntax-reject-arrow-operand! operand)
                (if (token-is t "delete")
                    (do
                      ;; Private names cannot be deleted, parenthesized or not.
                      (match (syntax-node (syntax-ungroup-id operand))
                        (SxPrivateMember [owner name optional]
                                         (syntax-error! "parser: private names cannot be deleted"))
                        (_ 0))
                      (syntax-add-node! (SxDelete operand) (.start t) hi))
                    (syntax-add-node! (SxUnary (token-unary-op-name t) operand)
                                      (.start t)
                                      hi))))
            (if (or (token-is t "++") (token-is t "--"))
                (do
                  (take-token)
                  (let [operand (parse-syntax-unary)]
                    (syntax-reject-arrow-operand! operand)
                    (syntax-check-simple-target! operand false true)
                    (syntax-add-node! (SxUpdate
                                        :op (token-update-op-name t)
                                        :prefix true
                                        :target (syntax-ungroup-id operand))
                                      (.start t)
                                      (syntax-hi operand))))
                (parse-syntax-update))))))

;; An ArrowFunction is a whole AssignmentExpression: it cannot be an operand, an object of a
;; member access, a callee, or a `new` target without parentheses.
(defn syntax-arrow? [(id i64)] (-> bool)
  (match (syntax-node id)
    (SxFunction [fun]
                (let [f (syntax-fun-at fun)] (match (.kind f) (FunArrow [] true) (_ false))))
    (_ false)))

(defn syntax-reject-arrow-operand! [(id i64)] (-> i64)
  (if (syntax-arrow? id)
      (syntax-error! "parser: an arrow function cannot be an operand without parentheses")
      0))

(defn syntax-binary! [(node SyntaxNode) (lhs i64) (rhs i64)] (-> i64)
  (do
    ;; Assignment right-hand sides, comma operands and conditional arms are AssignmentExpressions.
    (match node
      (SxComma [l r] 0)
      (SxAssign [target value] 0)
      (SxCompoundAssign [op target value] 0)
      (SxLogicalAssign [predicate rhs-on-true target value] 0)
      (SxConditional [condition when-true when-false] (syntax-reject-arrow-operand! condition))
      (_ (do (syntax-reject-arrow-operand! lhs) (syntax-reject-arrow-operand! rhs))))
    (syntax-add-node! node (syntax-lo lhs) (syntax-hi rhs))))

;; ExponentiationExpression is right-associative and its base is an UpdateExpression: a unary
;; operator directly before `**` is a proven SyntaxError, while a parenthesized unary is fine.
(defn parse-syntax-exponent [] (-> i64)
  (let [first (peek-token)
        base (parse-syntax-unary)]
    (if (token-is (peek-token) "**")
        (do
          (if (token-unary-operator? first)
              (syntax-error! "parser: unary operator before ** requires parentheses")
              0)
          (take-token)
          (let [rhs (parse-syntax-exponent)]
            (syntax-binary! (SxBinary
                              :op "JsExp"
                              :left base
                              :right rhs)
                            base
                            rhs)))
        base)))

(defn parse-syntax-mul [] (-> i64)
  (let [(mut lhs) (parse-syntax-exponent)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "*") (token-is t "/") (token-is t "%")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-exponent)
                        op
                          (if (token-is t "*")
                              "JsMul"
                              (if (token-is t "/") "JsDiv" "JsMod"))]
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-add [] (-> i64)
  (let [(mut lhs) (parse-syntax-mul)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "+") (token-is t "-")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-mul)
                        op (if (token-is t "+") "JsAdd" "JsSub")]
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-shift [] (-> i64)
  (let [(mut lhs) (parse-syntax-add)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "<<") (token-is t ">>") (token-is t ">>>")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-add)
                        op
                          (if (token-is t "<<")
                              "JsShl"
                              (if (token-is t ">>") "JsShr" "JsUshr"))]
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

;; RelationalExpression. `in` is a keyword operator here; the `[~In]` grammar parameter used by
;; for-statement heads is not needed until that statement is admitted.
(defn parse-syntax-relational [] (-> i64)
  (let [(mut lhs) (parse-syntax-shift)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "<")
                         (token-is t ">")
                         (token-is t "<=")
                         (token-is t ">=")
                         (token-is t "instanceof")
                         (and (token-is t "in") (not (.no-in (parser-state))))))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-shift)
                        op
                          (if (token-is t "<")
                              "JsLt"
                              (if (token-is t ">")
                                  "JsGt"
                                  (if (token-is t "<=")
                                      "JsLe"
                                      (if (token-is t ">=")
                                          "JsGe"
                                          (if (token-is t "instanceof")
                                              "JsInstanceof"
                                              "JsIn")))))]
                    (match (syntax-node rhs)
                      (SxPrivateName [name]
                                     (syntax-error! "parser: a private name can only be the left operand of in"))
                      (_ 0))
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-equality [] (-> i64)
  ;; Final Simple Parser.parseEquality loops over comparison operands, left-associatively.
  ;; JavaScript preserves that precedence but ===/!== mean JSL strict equality, not raw EQ.
  (let [(mut lhs) (parse-syntax-relational)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "===")
                         (token-is t "!==")
                         (token-is t "==")
                         (token-is t "!=")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-relational)
                        op
                          (if (token-is t "===")
                              "JsStrictEqual"
                              (if (token-is t "!==")
                                  "JsStrictNotEqual"
                                  (if (token-is t "==")
                                      "JsLooseEqual"
                                      "JsLooseNotEqual")))]
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-bitand [] (-> i64)
  (let [(mut lhs) (parse-syntax-equality)]
    (loop (if (not (take-is "&"))
              (break 0)
              (let [rhs (parse-syntax-equality)]
                (set! (mut lhs)
                      (syntax-binary! (SxBinary
                                        :op "JsBitAnd"
                                        :left (load lhs)
                                        :right rhs)
                                      (load lhs)
                                      rhs))
                (continue))))
    (load lhs)))

(defn parse-syntax-bitxor [] (-> i64)
  (let [(mut lhs) (parse-syntax-bitand)]
    (loop (if (not (take-is "^"))
              (break 0)
              (let [rhs (parse-syntax-bitand)]
                (set! (mut lhs)
                      (syntax-binary! (SxBinary
                                        :op "JsBitXor"
                                        :left (load lhs)
                                        :right rhs)
                                      (load lhs)
                                      rhs))
                (continue))))
    (load lhs)))

(defn parse-syntax-bitor [] (-> i64)
  (let [(mut lhs) (parse-syntax-bitxor)]
    (loop (if (not (take-is "|"))
              (break 0)
              (let [rhs (parse-syntax-bitxor)]
                (set! (mut lhs)
                      (syntax-binary! (SxBinary
                                        :op "JsBitOr"
                                        :left (load lhs)
                                        :right rhs)
                                      (load lhs)
                                      rhs))
                (continue))))
    (load lhs)))

(defn parse-syntax-and [] (-> i64)
  (let [(mut lhs) (parse-syntax-bitor)]
    (loop (if (not (take-is "&&"))
              (break 0)
              (let [rhs (parse-syntax-bitor)]
                (set! (mut lhs)
                      (syntax-binary! (SxAnd (load lhs) rhs) (load lhs) rhs))
                (continue))))
    (load lhs)))

(defn syntax-logical-and-or? [(id i64)] (-> bool)
  (match (syntax-node id) (SxAnd [l r] true) (SxOr [l r] true) (_ false)))

(defn syntax-coalesce? [(id i64)] (-> bool)
  (match (syntax-node id) (SxCoalesce [l r] true) (_ false)))

(defn parse-syntax-short-circuit [] (-> i64)
  (let [(mut lhs) (parse-syntax-and)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "||") (token-is t "??")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-and)
                        coalesce (token-is t "??")]
                    ;; CoalesceExpression may not contain an unparenthesized LogicalOR/AND.
                    ;; Group nodes preserve this grammar distinction without semantic AST facts.
                    (if (if coalesce
                            (or (syntax-logical-and-or? (load lhs))
                                (match (syntax-node rhs)
                                  (SxAnd [l r] true)
                                  (_ false)))
                            (syntax-coalesce? (load lhs)))
                        (syntax-error! "parser: nullish and logical operators require parentheses")
                        0)
                    (set! (mut lhs)
                          (syntax-binary! (if coalesce
                                              (SxCoalesce (load lhs) rhs)
                                              (SxOr (load lhs) rhs))
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-conditional [] (-> i64)
  (let [condition (parse-syntax-short-circuit)]
    (if (not (take-is "?"))
        condition
        (let [when-true (parse-syntax-assignment)]
          (require-token ":")
          (let [when-false (parse-syntax-assignment)]
            (syntax-binary! (SxConditional
                              :condition condition
                              :when-true when-true
                              :when-false when-false)
                            condition
                            when-false))))))

(defn token-compound-operator-name [(op Token)] (-> (slice u8))
  (if (token-is op "+=")
      "JsAdd"
      (if (token-is op "-=")
          "JsSub"
          (if (token-is op "*=")
              "JsMul"
              (if (token-is op "/=")
                  "JsDiv"
                  (if (token-is op "%=")
                      "JsMod"
                      (if (token-is op "**=")
                          "JsExp"
                          (if (token-is op "<<=")
                              "JsShl"
                              (if (token-is op ">>=")
                                  "JsShr"
                                  (if (token-is op ">>>=")
                                      "JsUshr"
                                      (if (token-is op "&=")
                                          "JsBitAnd"
                                          (if (token-is op "|=")
                                              "JsBitOr"
                                              (if (token-is op "^=")
                                                  "JsBitXor"
                                                  "")))))))))))))

(defn token-logical-assignment? [(op Token)] (-> bool)
  (or (token-is op "&&=") (token-is op "||=") (token-is op "??=")))

;; Assignment is right-associative and below the conditional expression. Parentheses preserve a
;; Reference, but arithmetic/calls cannot be turned into one by discarding their expression.
;; Logical assignment short-circuits: the RHS and the PutValue both live on one edge, and `||=`
;; evaluates its RHS on the FALSE edge of the truthiness predicate.
;; YieldExpression: `yield`, `yield expr`, `yield* expr`. Its argument is optional and ends at a
;; line terminator or any token that cannot begin an expression.
(defn parse-syntax-yield [] (-> i64)
  (let [t (take-token)]
    (if (parser-ctx-in-params?)
        (syntax-error! "parser: yield expression is not allowed in formal parameters")
        0)
    (let [next (peek-token)]
      (if (.nl-before next)
          (syntax-add-node! (SxYield (None [i64]) false) (.start t) (.end t))
          (if (token-is next "*")
              (do
                (take-token)
                (let [argument (parse-syntax-assignment)]
                  (syntax-add-node! (SxYield (Some argument) true)
                                    (.start t)
                                    (syntax-hi argument))))
              (if (or (token-cannot-start-expression? next)
                      (token-is next "in")
                      (token-is next "of"))
                  (syntax-add-node! (SxYield (None [i64]) false)
                                    (.start t)
                                    (.end t))
                  (let [argument (parse-syntax-assignment)]
                    (syntax-add-node! (SxYield (Some argument) false)
                                      (.start t)
                                      (syntax-hi argument)))))))))

(defn parse-syntax-assignment [] (-> i64)
  (if (and (token-is (peek-token) "yield") (parser-ctx-generator?))
      (parse-syntax-yield)
      (parse-syntax-assignment-proper)))

;; An unparenthesized object or array literal on the left of `=` is a destructuring pattern.
(defn syntax-pattern-literal? [(id i64)] (-> bool)
  (match (syntax-node id)
    (SxObject [entries] true)
    (SxArray [elements] true)
    (_ false)))

(defn parse-syntax-assignment-proper [] (-> i64)
  (let [lhs (parse-syntax-conditional)
        op (peek-token)
        compound (token-compound-operator-name op)
        logical (token-logical-assignment? op)]
    (if (not (or (token-is op "=") (!= compound "") logical))
        lhs
        (do
          (take-token)
          (if (and (token-is op "=") (syntax-pattern-literal? lhs))
              ;; Destructuring assignment: the literal becomes an assignment pattern.
              (let [pattern (syntax-cover-to-pattern! lhs false)
                    rhs (parse-syntax-assignment)]
                (syntax-add-node! (SxDestructuringAssign pattern rhs) (syntax-lo lhs) (syntax-hi rhs)))
              (do
                (syntax-check-simple-target! lhs (token-is op "=") (not logical))
                (let [target (syntax-ungroup-id lhs)
                      rhs (parse-syntax-assignment)]
                  (syntax-binary! (if logical
                                      (SxLogicalAssign
                                        :predicate
                                          (if (token-is op "??=")
                                              "JsNullish"
                                              "JsTruthy")
                                        :rhs-on-true (not (token-is op "||="))
                                        :target target
                                        :value rhs)
                                      (if (token-is op "=")
                                          (SxAssign target rhs)
                                          (SxCompoundAssign
                                            :op compound
                                            :target target
                                            :value rhs)))
                                  lhs
                                  rhs))))))))

;; Expression: comma-separated AssignmentExpressions, left to right, valued by the last.
(defn parse-syntax-expression [] (-> i64)
  (let [(mut lhs) (parse-syntax-assignment)]
    (loop (if (not (take-is ","))
              (break 0)
              (let [rhs (parse-syntax-assignment)]
                (set! (mut lhs)
                      (syntax-binary! (SxComma (load lhs) rhs) (load lhs) rhs))
                (continue))))
    (load lhs)))

(defn parse-optional-annotation [] (-> i64)
  (if (not (take-is ":"))
      (ty-dyn TAG-ANY)
      (if (.script-mode (parser-state))
          (do
            (panic "parser: TypeScript annotations are not valid in JavaScript Script code")
            TY-INVALID)
          (tstype-parse))))

;; JavaScript's ASI is a parser decision. An omitted semicolon is legal only at a line terminator,
;; before `}`, or at EOF; accepting one between two same-line statements changes invalid source
;; into a different valid program.
(defn parse-statement-end! [] (-> i64)
  (if (take-is ";")
      0
      (let [next (peek-token)]
        (if (or (.nl-before next) (token-is next "}") (= (.kind next) TOK-EOF))
            0
            (syntax-error! "parser: expected semicolon or line terminator")))))

;; Statement keywords whose grammar is not admitted yet must fail before the expression path can
;; mistake them for a proven "expected an expression" error.
;; `break`/`continue` take an optional same-line LabelIdentifier; a line terminator ends them.
(defn parse-jump-label [] (-> (Option (slice u8)))
  (let [next (peek-token)]
    (if (and (not (.nl-before next)) (= (.kind next) TOK-IDENT))
        (do (take-token) (Some (token-text next)))
        (None [(slice u8)]))))

(defn parse-syntax-statement [] (-> i64)
  (let [t (peek-token)]
    (if (token-is t "switch")
        (parse-syntax-switch)
        (if (or (token-is t "break") (token-is t "continue"))
            (do
              (take-token)
              (let [label (parse-jump-label)]
                (parse-statement-end!)
                (syntax-stmt-add-node! (if (token-is t "break")
                                           (SsBreak label)
                                           (SsContinue label))
                                       (.start t)
                                       (lex-consumed-end))))
            (if (take-is ";")
                (syntax-stmt-add-node! (SsEmpty) (.start t) (.end t))
                (do
                  (if (and (token-is t "return")
                           (not (parser-return-allowed?)))
                      (syntax-error! "parser: return is not allowed here")
                      0)
                  (parse-syntax-statement-inner)))))))

(defn parse-syntax-switch [] (-> i64)
  (let [keyword (require-token "switch")
        (mut cases) (al-new [i64] (alloc/malloc-allocator))
        (mut has-default) false]
    (require-token "(")
    (let [value (parse-syntax-expression)]
      (require-token ")")
      (require-token "{")
      (loop (if (token-is (peek-token) "}")
                (break 0)
                (let [label (take-token)
                      selector
                        (if (token-is label "case")
                            (Some (parse-syntax-expression))
                            (if (token-is label "default")
                                (do
                                  (if (load has-default)
                                      (syntax-error! "parser: duplicate switch default")
                                      0)
                                  (set! (mut has-default) true)
                                  (None [i64]))
                                (do
                                  (parse-fail "parser: expected switch case/default at byte"
                                              label)
                                  (None [i64]))))
                      (mut body) (al-new [i64] (alloc/malloc-allocator))]
                  (require-token ":")
                  (loop (let [next (peek-token)]
                          (if (or (token-is next "case")
                                  (token-is next "default")
                                  (token-is next "}"))
                              (break 0)
                              (do
                                (push! [i64]
                                       (mut body)
                                       (parse-syntax-statement))
                                (continue)))))
                  (push! [i64]
                         (mut cases)
                         (syntax-stmt-add-node! (SsCase selector (load body))
                                                (.start label)
                                                (lex-consumed-end)))
                  (continue))))
      (let [close (require-token "}")]
        (syntax-stmt-add-node! (SsSwitch value (load cases))
                               (.start keyword)
                               (.end close))))))

;; A Statement position (the body of if/while/do/for/with/label) admits no declaration. `class`,
;; `const`, `let [`, a same-line `let x` and `async function` are proven SyntaxErrors there, as is a
;; FunctionDeclaration in a loop or `with` body; Annex B.3.3 admits `if (x) function f() {}` in
;; sloppy code as a Block holding the declaration (the strict pass rejects it in strict code). A
;; labelled function declaration is never a Statement body. A bare `let` is a sloppy identifier.
(defn let-starts-declaration? [] (-> bool)
  (or (lex-second-kind? TOK-IDENT) (lex-second-is? "let") (lex-second-is? "[") (lex-second-is? "{")))

(defn syntax-labelled-function? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsLabeled [label body]
               (match (syntax-stmt-node body)
                 (SsFunctionDecl [fun] true)
                 (_ (syntax-labelled-function? body))))
    (_ false)))

(defn syntax-annexb-block? [(id i64)] (-> bool)
  (let [(mut found) false]
    (al-for [b (.annexb-blocks (parser-state))] (if (= b id) (set! (mut found) true) 0))
    (load found)))

(defn parse-syntax-controlled-statement [(loop-body bool) (annexb-if bool)] (-> i64)
  (let [stmt (parse-syntax-controlled-statement-inner loop-body annexb-if)]
    (if (syntax-labelled-function? stmt)
        (syntax-error! "parser: labelled function declaration is not allowed in a statement position")
        0)
    stmt))

(defn parse-syntax-controlled-statement-inner [(loop-body bool) (annexb-if bool)] (-> i64)
  (let [t (peek-token)]
    (if (or (token-is t "class") (token-is t "const"))
        (syntax-error! "parser: declaration is not allowed in a statement position")
        (if (token-is t "let")
            ;; `let [` can never start a Statement; a same-line `let x` / `let {` is a lexical
            ;; declaration in a statement position. Otherwise `let` is a sloppy identifier and the
            ;; statement is an expression statement.
            (if (or (lex-second-is? "[")
                    (and (let [second (lex-peek-second false)] (not (.nl-before second)))
                         (or (lex-second-kind? TOK-IDENT) (lex-second-is? "let") (lex-second-is? "{"))))
                (syntax-error! "parser: lexical declaration is not allowed in a statement position")
                (parse-syntax-expression-statement))
            (if (token-is t "function")
                (if loop-body
                    (syntax-error! "parser: function declaration is not allowed in a loop body")
                    (if (and annexb-if (not (lex-second-is? "*")))
                        (let [decl (parse-syntax-statement)
                              (mut body) (al-new [i64] (alloc/malloc-allocator))]
                          (push! [i64] (mut body) decl)
                          (let [id (syntax-stmt-add-node! (SsBlock (load body))
                                                          (syntax-stmt-lo decl)
                                                          (syntax-stmt-hi decl))]
                            (push! [i64] (mut (.annexb-blocks (parser-state))) id)
                            id))
                        (syntax-error! "parser: function declaration is not allowed in a statement position")))
                (if (and (token-is t "async") (lex-second-is? "function"))
                    (syntax-error! "parser: async function declaration is not allowed in a statement position")
                    (parse-syntax-statement)))))))

;; A declared name; `let` may not be lexically bound.
(defn parse-syntax-declared-name! [(is-var bool)] (-> Token)
  (let [t (require-binding-identifier)]
    (if (and (not is-var) (token-is t "let"))
        (syntax-error! "parser: let is not a valid lexical binding name")
        0)
    t))

(defn parse-syntax-lexical-pattern! [(is-var bool)] (-> i64)
  (let [pattern (parse-syntax-binding-pattern!)]
    (if is-var
        0
        (let [(mut names) (al-new [(slice u8)] (alloc/malloc-allocator))]
          (syntax-pattern-names! pattern (mut names))
          (al-for [name (load names)]
                  (if (= name "let") (syntax-error! "parser: let is not a valid lexical binding name") 0))
          (al-free! [(slice u8)] (mut names))
          0))
    pattern))

;; ExpressionStatement, or a LabelledStatement that shares its first token with one. A labelled
;; item may be a plain FunctionDeclaration in sloppy code (the strict pass rejects it in strict
;; code); generator and async declarations are never labelled items.
(defn parse-syntax-expression-statement [] (-> i64)
  (let [expr (parse-syntax-expression)
        parsed (syntax-at expr)]
    (if (and (token-is (peek-token) ":") (syntax-name? expr))
        (let [label (match (syntax-node expr) (SxName [name] name) (_ ""))]
          (syntax-check-binding-name! label)
          (take-token)
          (let [body (if (token-is (peek-token) "function")
                         (if (lex-second-is? "*")
                             (syntax-error! "parser: generator declaration is not allowed as a labelled item")
                             (parse-syntax-statement))
                         ;; Nested labels are checked by whichever Statement body holds the chain.
                         (parse-syntax-controlled-statement-inner false false))]
            (syntax-stmt-add-node! (SsLabeled label body) (.lo parsed) (syntax-stmt-hi body))))
        (do
          (parse-statement-end!)
          (syntax-stmt-add-node! (SsExpr expr) (.lo parsed) (.hi parsed))))))

;; VariableDeclarationList / LexicalDeclaration without the terminating semicolon. In a for-head
;; the missing `const` initializer is deferred: `for (const x of y)` is legal.
(defn parse-syntax-declaration-list [(for-head bool)] (-> i64)
  (let [keyword (take-token)
        is-var (token-is keyword "var")
        (mut declarations) (al-new [i64] (alloc/malloc-allocator))
        (mut hi) (.end keyword)]
    (loop (let [name-token (peek-token)]
            ;; BoundNames of a LexicalDeclaration may not contain `let`.
            (if (and (not is-var) (token-is name-token "let"))
                (syntax-error! "parser: `let` is not a valid lexically bound name")
                0)
            (if (or (token-is name-token "[") (token-is name-token "{"))
                (let [pattern (parse-syntax-lexical-pattern! is-var)
                      init
                        (if (take-is "=")
                            (Some (parse-syntax-assignment))
                            (do
                              (if (not for-head)
                                  (syntax-error! "parser: a destructuring declaration requires an initializer")
                                  0)
                              (None [i64])))
                      end (lex-consumed-end)
                      start (if (= (len (load declarations)) 0) (.start keyword) (.start name-token))
                      node
                        (if is-var
                            (SsVarPattern pattern init)
                            (SsLetPattern
                              :pattern pattern
                              :init init
                              :final (token-is keyword "const")))]
                  (push! [i64] (mut declarations) (syntax-stmt-add-node! node start end))
                  (set! (mut hi) end)
                  (if (take-is ",") (continue) (break 0)))
                (let [name (parse-syntax-declared-name! is-var)
                      annotation (parse-optional-annotation)
                      init
                        (if (take-is "=")
                            (Some (parse-syntax-assignment))
                            (do
                              (if (and (token-is keyword "const") (not for-head))
                                  (syntax-error! "parser: const declaration requires an initializer")
                                  0)
                              (None [i64])))
                      end (lex-consumed-end)
                      start
                        (if (= (len (load declarations)) 0)
                            (.start keyword)
                            (.start name))
                      node
                        (if is-var
                            (SsVar
                              :name (token-text name)
                              :init init
                              :annotation annotation)
                            (SsLet
                              :name (token-text name)
                              :init init
                              :final (token-is keyword "const")
                              :annotation annotation))]
                  (push! [i64]
                         (mut declarations)
                         (syntax-stmt-add-node! node start end))
                  (set! (mut hi) end)
                  (if (take-is ",") (continue) (break 0))))))
    (if (= (len (load declarations)) 1)
        (get (load declarations) 0)
        (syntax-stmt-add-node! (SsDeclList (load declarations))
                               (.start keyword)
                               (load hi)))))

;; After a complete for-head expression only the separator can follow; anything else is a
;; proven error.
(defn require-closing! [(text (slice u8)) (message (slice u8))] (-> i64)
  (let [t (peek-token)]
    (if (token-is t text)
        (do (take-token) 0)
        (syntax-error! message))))

(defn parse-syntax-declarations [] (-> i64)
  (let [stmt (parse-syntax-declaration-list false)]
    (parse-statement-end!)
    stmt))

(defn syntax-stmt-lexical? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsLet [name init final annotation] true)
    (SsLetPattern [pattern init final] true)
    (SsDeclList [decls]
                (if (= (len decls) 0)
                    false
                    (syntax-stmt-lexical? (get decls 0))))
    (_ false)))

;; A for-in/of head declaration binds exactly one name without an initializer. Annex B admits
;; `for (var x = 1 in o)` in sloppy code; that is unsupported and fails closed.
;; `of` heads never take an initializer; Annex B.3.5 admits `for (var x = 1 in o)` for a plain
;; var binding in sloppy code (the strict pass rejects it in strict code).
(defn syntax-check-for-in-head! [(stmt i64) (of bool)] (-> i64)
  (match (syntax-stmt-node stmt)
    (SsVar [name init annotation]
           (match init
             (Some [e]
                   (if of
                       (syntax-error! "parser: for-of var binding cannot have an initializer")
                       0))
             (None [] 0)))
    (SsLet [name init final annotation]
           (match init
             (Some [e]
                   (syntax-error! "parser: for-in/of lexical binding cannot have an initializer"))
             (None [] 0)))
    (SsLetPattern [pattern init final]
                  (match init
                    (Some [e] (syntax-error! "parser: for-in/of binding pattern cannot have an initializer"))
                    (None [] 0)))
    (SsVarPattern [pattern init]
                  (match init
                    (Some [e] (syntax-error! "parser: for-in/of binding pattern cannot have an initializer"))
                    (None [] 0)))
    (SsDeclList [decls]
                (syntax-error! "parser: for-in/of head declares exactly one binding"))
    (_ (broken "syntax-check-for-in-head!: head is not a declaration"))))

(defn syntax-check-const-initializers! [(stmt i64)] (-> i64)
  (match (syntax-stmt-node stmt)
    (SsLet [name init final annotation]
           (if (and final (match init (Some [e] false) (None [] true)))
               (syntax-error! "parser: const declaration requires an initializer")
               0))
    (SsLetPattern [pattern init final]
                  (match init
                    (Some [e] 0)
                    (None [] (syntax-error! "parser: a destructuring declaration requires an initializer"))))
    (SsVarPattern [pattern init]
                  (match init
                    (Some [e] 0)
                    (None [] (syntax-error! "parser: a destructuring declaration requires an initializer"))))
    (SsDeclList [decls]
                (do (al-for [d decls] (syntax-check-const-initializers! d)) 0))
    (_ 0)))

;; for ( init ; test ; update ) body, for ( head in object ) body, for ( head of iterable ) body.
;; The head is parsed under the `[~In]` grammar so `in` can only mean for-in there.
(defn parse-syntax-for [] (-> i64)
  (let [keyword (require-token "for")
        awaited (token-is (peek-token) "await")]
    ;; `for await` exists only inside async functions; elsewhere `await` is an identifier that
    ;; cannot follow `for`.
    (if awaited
        (do
          (if (not (parser-ctx-async?))
              (syntax-error! "parser: for await is only allowed in an async function")
              0)
          (take-token)
          0)
        0)
    (require-token "(")
    (let [first (peek-token)
          saved-no-in (.no-in (parser-state))
          head
            (if (token-is first ";")
                (ForNoInit)
                (do
                  (set! (.no-in (parser-state)) true)
                  (if (or (token-is first "var")
                          (token-is first "const")
                          (and (token-is first "let") (let-starts-declaration?)))
                      (ForInitDecl (parse-syntax-declaration-list true))
                      ;; `for await (async of …)`: `async of` is not an arrow head here.
                      (if (and awaited (token-is first "async") (lex-second-is? "of"))
                          (let [t (take-token)]
                            (ForInitExpr (syntax-add-node! (SxName "async") (.start t) (.end t))))
                          (ForInitExpr (parse-syntax-expression))))))]
      (set! (.no-in (parser-state)) saved-no-in)
      (let [after (peek-token)
            of (and (= (.kind after) TOK-IDENT) (token-is after "of"))]
        (if (and awaited (not of))
            (syntax-error! "parser: for await requires an of clause")
            0)
        ;; `for (let of …)` and `for (async of …)` are excluded by lookahead; `for await` admits
        ;; `async`.
        (if (and of (token-is first "let") (match head (ForInitExpr [e] true) (_ false)))
            (syntax-error! "parser: for-of head cannot begin with let")
            0)
        (if (and of (not awaited) (token-is first "async")
                 (match head
                   (ForInitExpr [e] (match (syntax-node e) (SxName [name] (= name "async")) (_ false)))
                   (_ false)))
            (syntax-error! "parser: for-of head cannot be the identifier async")
            0)
        (if (and (or (token-is after "in") of)
                 (match head (ForNoInit [] false) (_ true)))
            (do
              (take-token)
              (let [head-pattern
                      (match head
                        (ForInitExpr [expr]
                                     (match (syntax-node expr)
                                       (SxObject [entries] (Some (syntax-cover-to-pattern! expr false)))
                                       (SxArray [elements] (Some (syntax-cover-to-pattern! expr false)))
                                       (_ (do (syntax-check-simple-target! expr true false) (None [i64])))))
                        (ForInitDecl [stmt] (do (syntax-check-for-in-head! stmt of) (None [i64])))
                        (_ (None [i64])))
                    head (match head-pattern (Some [pat] (ForInitPattern pat)) (None [] head))
                    right (if of (parse-syntax-assignment) (parse-syntax-expression))]
                (require-closing! ")" "parser: expected `)` after for-in/of head")
                (let [body (parse-syntax-controlled-statement true false)]
                  (syntax-stmt-add-node! (SsForIn
                                           :head head
                                           :of of
                                           :right right
                                           :body body
                                           :awaited awaited)
                                         (.start keyword)
                                         (syntax-stmt-hi body)))))
            (do
              ;; A const without initializer was deferred for the for-in/of case above.
              (match head
                (ForInitDecl [stmt] (syntax-check-const-initializers! stmt))
                (_ 0))
              (require-closing! ";"
                                "parser: expected `;` in for statement head")
              (let [test
                      (if (token-is (peek-token) ";")
                          (None [i64])
                          (Some (parse-syntax-expression)))]
                (require-closing! ";"
                                  "parser: expected `;` in for statement head")
                (let [update
                        (if (token-is (peek-token) ")")
                            (None [i64])
                            (Some (parse-syntax-expression)))]
                  (require-closing! ")"
                                    "parser: expected `)` after for statement head")
                  (let [body (parse-syntax-controlled-statement true false)]
                    (syntax-stmt-add-node! (SsFor
                                             :init head
                                             :test test
                                             :update update
                                             :body body)
                                           (.start keyword)
                                           (syntax-stmt-hi body)))))))))))

;; try Block Catch? Finally?; at least one of Catch/Finally. CatchParameter is a BindingIdentifier
;; or a BindingPattern, recorded as a pattern either way.
(defn parse-syntax-block-required [(what (slice u8))] (-> i64)
  (if (token-is (peek-token) "{")
      (parse-syntax-statement)
      (syntax-error! what)))

(defn parse-syntax-try [] (-> i64)
  (let [keyword (require-token "try")
        body (parse-syntax-block-required "parser: expected a block after try")
        (mut catch-param) (None [i64])
        (mut catch-body) (None [i64])
        (mut finally-body) (None [i64])]
    (if (take-is "catch")
        (do
          (if (take-is "(")
              (let [param (peek-token)]
                (set! (mut catch-param)
                      (Some (if (or (token-is param "[") (token-is param "{"))
                                (parse-syntax-binding-pattern!)
                                (let [name (require-binding-identifier)]
                                  (syntax-pattern-add! (PatName (token-text name))
                                                       (None [i64])
                                                       (.start name)
                                                       (.end name))))))
                (require-token ")")
                0)
              0)
          (set! (mut catch-body)
                (Some (parse-syntax-block-required "parser: expected a block after catch"))))
        0)
    (if (take-is "finally")
        (set! (mut finally-body)
              (Some (parse-syntax-block-required "parser: expected a block after finally")))
        0)
    (if (and (match (load catch-body) (None [] true) (_ false))
             (match (load finally-body) (None [] true) (_ false)))
        (syntax-error! "parser: try requires a catch or finally clause")
        0)
    (syntax-stmt-add-node! (SsTry
                             :body body
                             :catch-param (load catch-param)
                             :catch-body (load catch-body)
                             :finally-body (load finally-body))
                           (.start keyword)
                           (lex-consumed-end))))

(defn parse-syntax-statement-inner [] (-> i64)
  (let [first (peek-token)]
    ;; Import and export declarations exist only in the Module goal. `import(` and `import.` begin
    ;; expressions and take the ordinary expression-statement path below.
    (if (token-is first "export")
        (syntax-error! "parser: export declarations are only valid in a module")
        0)
    (if (and (token-is first "import")
             (not (or (lex-second-is? "(") (lex-second-is? "."))))
        (syntax-error! "parser: import declarations are only valid in a module")
        0)
    (if (token-is first "class")
        (let [cls (parse-syntax-class (take-token) true)]
          (syntax-stmt-add-node! (SsClassDecl cls) (.start first) (syntax-class-hi cls)))
        (if (or (token-is first "function")
                (and (token-is first "async")
                     (lex-second-is? "function")
                     (let [second (lex-peek-second false)] (not (.nl-before second)))))
            (parse-syntax-function-declaration!)
            (if (token-is first "for")
                (parse-syntax-for)
                (if (token-is first "try")
                    (parse-syntax-try)
                    (if (token-is first "do")
                        (let [keyword (take-token)
                              body (parse-syntax-controlled-statement true false)]
                          (require-token "while")
                          (require-token "(")
                          (let [condition (parse-syntax-expression)
                                close (require-token ")")]
                            ;; ASI: the `;` after a do-while's `)` may be omitted even without a line terminator.
                            (take-is ";")
                            (syntax-stmt-add-node! (SsDoWhile body condition)
                                                   (.start keyword)
                                                   (.end close))))
                        (if (token-is first "throw")
                            (let [keyword (take-token)
                                  next (peek-token)]
                              (if (.nl-before next)
                                  (syntax-error! "parser: line terminator is not allowed after throw")
                                  0)
                              (let [value (parse-syntax-expression)]
                                (parse-statement-end!)
                                (syntax-stmt-add-node! (SsThrow value)
                                                       (.start keyword)
                                                       (syntax-hi value))))
                            (if (token-is first "with")
                                (let [keyword (take-token)]
                                  (require-token "(")
                                  (let [object (parse-syntax-expression)]
                                    (require-token ")")
                                            (let [body (parse-syntax-controlled-statement false false)]
                                              (syntax-stmt-add-node! (SsWith object body)
                                                             (.start keyword)
                                                             (syntax-stmt-hi body)))))
                                (if (token-is first "debugger")
                                    (let [keyword (take-token)]
                                      (parse-statement-end!)
                                      (syntax-stmt-add-node! (SsDebugger)
                                                             (.start keyword)
                                                             (.end keyword)))
                                    (if (token-is first "while")
                                        (let [keyword (take-token)]
                                          (require-token "(")
                                          (let [condition (parse-syntax-expression)]
                                            (require-token ")")
                                            (let [body (parse-syntax-controlled-statement true false)]
                                              (syntax-stmt-add-node! (SsWhile condition
                                                                              body)
                                                                     (.start keyword)
                                                                     (syntax-stmt-hi body)))))
                                        (if (token-is first "if")
                                            (let [keyword (take-token)]
                                              (require-token "(")
                                              (let [condition (parse-syntax-expression)]
                                                (require-token ")")
                                                (let [yes (parse-syntax-controlled-statement false true)
                                                      no
                                                        (if (take-is "else")
                                                            (Some (parse-syntax-controlled-statement false true))
                                                            (None [i64]))
                                                      last
                                                        (match no
                                                          (Some [n] n)
                                                          (None [] yes))]
                                                  (syntax-stmt-add-node! (SsIf
                                                                           :condition condition
                                                                           :then-stmt yes
                                                                           :else-stmt no)
                                                                         (.start keyword)
                                                                         (syntax-stmt-hi last)))))
                                            (if (or (and (token-is first "let") (let-starts-declaration?))
                                                    (token-is first "const")
                                                    (token-is first "var"))
                                                (parse-syntax-declarations)
                                                (if (token-is first "return")
                                                    (let [keyword (take-token)
                                                          next (peek-token)]
                                                      ;; Return is a restricted production: a line terminator ends it before the
                                                      ;; following expression. A missing expression is the JavaScript value
                                                      ;; `undefined`; the next line remains a separate, unreachable statement.
                                                      (if (or (.nl-before next)
                                                              (token-is next ";")
                                                              (token-is next "}")
                                                              (= (.kind next)
                                                                 TOK-EOF))
                                                          (do
                                                            (parse-statement-end!)
                                                            (syntax-stmt-add-node! (SsReturn (None [i64]))
                                                                                   (.start keyword)
                                                                                   (.end keyword)))
                                                          (let [expr (parse-syntax-expression)]
                                                            (parse-statement-end!)
                                                            (syntax-stmt-add-node! (SsReturn (Some expr))
                                                                                   (.start keyword)
                                                                                   (syntax-hi expr)))))
                                                    (if (token-is first "{")
                                                        (do
                                                          (take-token)
                                                          (let [(mut body)
                                                                  (al-new [i64]
                                                                          (alloc/malloc-allocator))]
                                                            (loop (if (token-is (peek-token)
                                                                                "}")
                                                                      (break 0)
                                                                      (do
                                                                        (push! [i64]
                                                                               (mut body)
                                                                               (parse-syntax-statement))
                                                                        (continue))))
                                                            (let [close (require-token "}")]
                                                              (syntax-stmt-add-node! (SsBlock (load body))
                                                                                     (.start first)
                                                                                     (.end close)))))
                                                        (parse-syntax-expression-statement))))))))))))))))

(defn parse-syntax-statement-list [] (-> (ArrayList i64))
  (let [(mut body) (al-new [i64] (alloc/malloc-allocator))]
    (loop (if (token-is (peek-token) "}")
              (break 0)
              (do (push! [i64] (mut body) (parse-syntax-statement)) (continue))))
    (load body)))

;; Reserve a SyntaxFun before its parameters are parsed so the record index is stable for nested
;; functions and for the `SxFunction`/`SsFunctionDecl` that will reference it.
(defn syntax-fun-reserve! [(name (slice u8))
                           (kind FunKind)
                           (generator bool)
                           (async bool)
                           (lo i64)] (-> i64)
  (let [(mut f) (primitive/zeroed SyntaxFun)
        index (len (.funs (parser-state)))]
    (set! (.name (mut f)) name)
    (set! (.kind (mut f)) kind)
    (set! (.generator (mut f)) generator)
    (set! (.async (mut f)) async)
    (set! (.params (mut f)) (al-new [(slice u8)] (alloc/malloc-allocator)))
    (set! (.param-annotations (mut f)) (al-new [i64] (alloc/malloc-allocator)))
    (set! (.param-defaults (mut f))
          (al-new [(Option i64)] (alloc/malloc-allocator)))
    (set! (.param-patterns (mut f)) (al-new [(Option i64)] (alloc/malloc-allocator)))
    (set! (.rest-param (mut f)) (None [(slice u8)]))
    (set! (.rest-pattern (mut f)) (None [i64]))
    (set! (.simple-params (mut f)) true)
    (set! (.return-annotation (mut f)) (ty-dyn TAG-ANY))
    (set! (.body (mut f)) (al-new [i64] (alloc/malloc-allocator)))
    (set! (.expression-body (mut f)) (None [i64]))
    (set! (.parent (mut f)) (parser-current-fun))
    (set! (.in-class (mut f)) (> (.class-strict (parser-state)) 0))
    (set! (.hoisted (mut f)) false)
    (set! (.value-taken (mut f)) false)
    (set! (.strict (mut f)) false)
    (set! (.lo (mut f)) lo)
    (set! (.script (mut f)) (.current-script (parser-state)))
    (set! (.static-entry (mut f)) -1)
    (push! [SyntaxFun] (mut (.funs (parser-state))) (load f))
    index))

(defn syntax-fun-ptr [(i i64)] (-> (ptr SyntaxFun))
  (al-elem [SyntaxFun] (mut (.funs (parser-state))) i))

;; FormalParameters after `(`, consuming `)`. Defaults, a rest element and destructuring
;; patterns make the list non-simple; a destructured parameter keeps "" in `params`.
(defn parse-syntax-formal-parameters! [(fp (ptr SyntaxFun))] (-> i64)
  (do
    (if (take-is ")")
        0
        (loop (if (token-is (peek-token) "...")
                  (let [dots (take-token)]
                    (set! (.simple-params fp) false)
                    (if (or (token-is (peek-token) "[") (token-is (peek-token) "{"))
                        (set! (.rest-pattern fp) (Some (parse-syntax-binding-pattern!)))
                        (let [name (require-binding-identifier)]
                          (set! (.rest-param fp) (Some (token-text name)))))
                    (if (token-is (peek-token) "=")
                        (syntax-error! "parser: rest parameter may not have a default")
                        0)
                    (if (take-is ")")
                        0
                        (syntax-error! "parser: rest parameter must be last"))
                    (break 0))
                  (let [pattern-param (or (token-is (peek-token) "[") (token-is (peek-token) "{"))
                        pattern (if pattern-param (Some (parse-syntax-binding-pattern!)) (None [i64]))
                        name-text (if pattern-param "" (token-text (require-binding-identifier)))
                        annotation (parse-optional-annotation)]
                    (if pattern-param (set! (.simple-params fp) false) 0)
                    (push! [(slice u8)] (mut (.params fp)) name-text)
                    (push! [(Option i64)] (mut (.param-patterns fp)) pattern)
                    (push! [i64] (mut (.param-annotations fp)) annotation)
                    (if (take-is "=")
                        (do
                          (set! (.simple-params fp) false)
                          (push! [(Option i64)]
                                 (mut (.param-defaults fp))
                                 (Some (parse-syntax-assignment))))
                        (push! [(Option i64)]
                               (mut (.param-defaults fp))
                               (None [i64])))
                    (if (take-is ",")
                        (if (take-is ")") (break 0) (continue))
                        (break (do
                                 (require-closing! ")"
                                                   "parser: expected `,` or `)` in parameter list")
                                 0)))))))
    0))

;; Early errors every function shares once its parameters and body are known: duplicate
;; parameters where UniqueFormalParameters or non-simple lists forbid them (strict duplicates are
;; the strict pass's job), a `use strict` directive over a non-simple list, accessor arity, and
;; parameter/lexical conflicts (checked with the other declarations later).
(defn syntax-check-function-shape! [(index i64) (own-directive bool)] (-> i64)
  (let [f (syntax-fun-at index)
        unique
          (or (not (.simple-params f))
              (match (.kind f)
                (FunArrow [] true)
                (FunMethod [] true)
                (FunGetter [] true)
                (FunSetter [] true)
                (_ false)))]
    (if (and own-directive (not (.simple-params f)))
        (syntax-error! "parser: use strict directive is not allowed with a non-simple parameter list")
        0)
    (if unique
        (let [(mut bound) (syntax-fun-bound-names f)
              (mut i) 0]
          (loop (if (>= (load i) (len (load bound)))
                    (break 0)
                    (let [name (get (load bound) (load i))
                          (mut j) (+ (load i) 1)]
                      (loop (if (>= (load j) (len (load bound)))
                                (break 0)
                                (do
                                  (if (= name (get (load bound) (load j)))
                                      (syntax-error! "parser: duplicate parameter name")
                                      0)
                                  (set! (mut j) (+ (load j) 1))
                                  (continue))))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (al-free! [(slice u8)] (mut bound)))
        0)
    (match (.kind f)
      (FunGetter []
                 (if (or (> (len (.params f)) 0)
                         (match (.rest-param f) (Some [r] true) (None [] false)))
                     (syntax-error! "parser: getter must not have parameters")
                     0))
      (FunSetter []
                 (if (or (!= (len (.params f)) 1)
                         (match (.rest-param f) (Some [r] true) (None [] false)))
                     (syntax-error! "parser: setter must have exactly one parameter")
                     0))
      (_ 0))))

;; Parameters, optional return annotation and a braced body for every non-arrow function kind.
;; `name` was validated in the enclosing context; parameters and body use the function's own.
(defn parse-syntax-function-rest! [(index i64)
                                   (kind FunKind)
                                   (generator bool)
                                   (async bool)
                                   (derived-constructor bool)] (-> i64)
  (let [method
          (match kind
            (FunMethod [] true)
            (FunGetter [] true)
            (FunSetter [] true)
            (_ false))]
    (parser-push-context! index generator async false method)
    (parser-mark-top-context! false false derived-constructor)
    (require-token "(")
    (parse-syntax-formal-parameters! (syntax-fun-ptr index))
    (let [return-annotation (parse-optional-annotation)]
      (parser-set-in-params! false)
      (require-token "{")
      (let [body (parse-syntax-statement-list)
            close (require-token "}")
            own-directive (syntax-body-strict? body)
            fp (syntax-fun-ptr index)]
        (parser-pop-context!)
        (if own-directive (do (set! (.strict-pending (parser-state)) true) 0) 0)
        (set! (.return-annotation fp) return-annotation)
        (set! (.body fp) body)
        (set! (.hi fp) (.end close))
        (syntax-check-function-shape! index own-directive)
        index))))

;; `function` [*] name (…) {…} as a declaration statement. The name binds in the enclosing scope.
(defn parse-syntax-function-declaration! [] (-> i64)
  (let [first (take-token)
        async (token-is first "async")]
    (if async (do (require-token "function") 0) 0)
    (let [generator (take-is "*")
          name (require-binding-identifier)
          index
            (syntax-fun-reserve! (token-text name)
                                 (FunDeclaration)
                                 generator
                                 async
                                 (.start first))]
      (parse-syntax-function-rest! index (FunDeclaration) generator async false)
      (let [f (syntax-fun-at index)]
        (syntax-stmt-add-node! (SsFunctionDecl index) (.start first) (.hi f))))))

;; A function expression's own name is bound inside the function, so `function yield(){}` inside a
;; generator body is legal while a generator expression named `yield` is not.
(defn parse-syntax-function-expression-name [(generator bool) (async bool)] (-> (slice u8))
  (let [t (take-token)
        name (token-text t)]
    (if (and (!= (.kind t) TOK-IDENT) (not (token-is t "let")))
            (syntax-error! "parser: reserved word cannot be a function name")
            ;; The name binds inside the expression, so only its own kind reserves yield/await.
            (if (or (and (= name "yield") generator)
                    (and (= name "await") async))
                (syntax-error! "parser: invalid function expression name")
                0))
    name))

(defn parse-syntax-function-expression [(keyword Token) (async bool) (lo i64)] (-> i64)
  (let [generator (take-is "*")
        name
          (if (token-is (peek-token) "(")
              ""
              (parse-syntax-function-expression-name generator async))]
    (let [index (syntax-fun-reserve! name (FunExpression) generator async lo)]
      (parse-syntax-function-rest! index (FunExpression) generator async false)
      (let [f (syntax-fun-at index)]
        (syntax-add-node! (SxFunction index) lo (.hi f))))))

;; ArrowFunction body after its parameters are settled: `=>` then a braced FunctionBody or a
;; ConciseBody AssignmentExpression. Arrows are never generators; `await` follows `async`.
(defn parse-syntax-arrow-body! [(lo i64)
                                (params (ArrayList (slice u8)))
                                (defaults (ArrayList (Option i64)))
                                (patterns (ArrayList (Option i64)))
                                (rest (Option (slice u8)))
                                (rest-pattern (Option i64))
                                (simple bool)
                                (async bool)] (-> i64)
  (let [arrow (take-token)]
    (if (not (token-is arrow "=>")) (syntax-error! "parser: expected =>") 0)
    (if (.nl-before arrow)
        (syntax-error! "parser: line terminator is not allowed before =>")
        0)
    (let [index (syntax-fun-reserve! "" (FunArrow) false async lo)
          fp (syntax-fun-ptr index)]
      (set! (.params fp) params)
      (set! (.param-defaults fp) defaults)
      (set! (.param-patterns fp) patterns)
      (set! (.rest-param fp) rest)
      (set! (.rest-pattern fp) rest-pattern)
      (set! (.simple-params fp) simple)
      (let [(mut i) 0]
        (loop (if (>= (load i) (len params))
                  (break 0)
                  (do
                    (push! [i64] (mut (.param-annotations fp)) (ty-dyn TAG-ANY))
                    (set! (mut i) (+ (load i) 1))
                    (continue)))))
      (parser-push-context! index false async true false)
      (parser-set-in-params! false)
      (if (token-is (peek-token) "{")
          (do
            (take-token)
            (let [body (parse-syntax-statement-list)
                  close (require-token "}")
                  own-directive (syntax-body-strict? body)
                  fp2 (syntax-fun-ptr index)]
              (parser-pop-context!)
              (if own-directive
                  (do (set! (.strict-pending (parser-state)) true) 0)
                  0)
              (set! (.body fp2) body)
              (set! (.hi fp2) (.end close))
              (syntax-check-function-shape! index own-directive)))
          (let [value (parse-syntax-assignment)
                fp2 (syntax-fun-ptr index)]
            (parser-pop-context!)
            (set! (.expression-body fp2) (Some value))
            (set! (.hi fp2) (syntax-hi value))
            (syntax-check-function-shape! index false)))
      (let [f (syntax-fun-at index)]
        (syntax-add-node! (SxFunction index) lo (.hi f))))))

;; MethodDefinition inside an object literal: `key(…) {…}`, `get key() {…}`, `set key(v) {…}`,
;; `*key(…)`, `async key(…)`, `async *key(…)`.
(defn parse-syntax-method! [(key PropKey)
                            (name (slice u8))
                            (kind FunKind)
                            (generator bool)
                            (async bool)
                            (lo i64)] (-> ObjectEntry)
  (let [index (syntax-fun-reserve! name kind generator async lo)]
    (parse-syntax-function-rest! index kind generator async false)
    (PropMethod key index)))

;; Strictness is settled after parsing: a function is strict when its own prologue says so, when
;; its enclosing function is, or when the Script is. Parents precede children in the table.
(defn syntax-settle-strictness! [] (-> i64)
  (let [p (parser-state)
        script-strict
          (if (.script-mode p)
              (let [root (syntax-fun-at (.script-index p))]
                (syntax-body-strict? (.body root)))
              false)
        (mut i) 0]
    (loop (if (>= (load i) (len (.funs p)))
              (break 0)
              (let [fp (syntax-fun-ptr (load i))
                    own (syntax-body-strict? (.body fp))
                    inherited
                      (if (< (.parent fp) 0)
                          false
                          (syntax-fun-strict (.parent fp)))]
                ;; A built-in (an intrinsic wrapper) is strict whatever the Script is: it receives
                ;; `this` as passed (ECMA-262 §10.3).
                (set! (.strict fp) (or script-strict own inherited (.in-class fp) (syntax-intrinsic-fun? (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

;; Whether a statement list declares a nested function anywhere, which lowering cannot yet
;; instantiate as a binding.
(defn syntax-contains-function-decl? [(stmts (ArrayList i64))] (-> bool)
  (let [(mut found) false]
    (al-for [id stmts]
            (let [(mut children) (al-new [i64] (alloc/malloc-allocator))]
              (match (syntax-stmt-node id)
                (SsFunctionDecl [fun]
                                (let [f (syntax-fun-at fun)]
                                  (if (not (.hoisted f))
                                      (set! (mut found) true)
                                      0)))
                (_ 0))
              (syntax-stmt-children! id (mut children))
              (if (syntax-contains-function-decl? (load children))
                  (set! (mut found) true)
                  0)
              (al-free! [i64] (mut children))))
    (load found)))

(defn syntax-class-hi [(cls i64)] (-> i64)
  (let [c (get (.classes (parser-state)) cls)] (.hi c)))

;; `#name` must be one token pair with no space, never `#constructor`, and only inside a class.
;; Every reference is recorded for resolution when the declaring class closes.
(defn parse-syntax-private-name! [(hash Token)] (-> Token)
  (let [name (take-token)]
    (if (or (!= (.kind name) TOK-IDENT) (!= (.start name) (.end hash)))
        (syntax-error! "parser: expected a private name immediately after #")
        0)
    (if (= (token-text name) "constructor")
        (syntax-error! "parser: #constructor is not a valid private name")
        0)
    (if (= (.class-depth (parser-state)) 0)
        (syntax-error! "parser: private name used outside a class body")
        0)
    (let [(mut ref) (primitive/zeroed PrivateRef)]
      (set! (.name (mut ref)) (token-text name))
      (set! (.depth (mut ref)) (.class-depth (parser-state)))
      (push! [PrivateRef] (mut (.private-refs (parser-state))) (load ref)))
    name))

;; `#name in expr`: the private name is only ever the left operand of `in`.
(defn parse-syntax-private-in [(hash Token)] (-> i64)
  (let [name (parse-syntax-private-name! hash)]
    (if (or (not (token-is (peek-token) "in")) (.no-in (parser-state)))
        (syntax-error! "parser: a private name can only be tested with `in`")
        0)
    (syntax-add-node! (SxPrivateName (token-text name)) (.start hash) (.end name))))

(defn syntax-declare-private! [(decls (mut (ArrayList PrivateDecl)))
                               (name (slice u8))
                               (is-static bool)
                               (getter bool)
                               (setter bool)] (-> i64)
  (let [(mut index) -1
        (mut i) 0]
    (loop (if (>= (load i) (len (load decls)))
              (break 0)
              (let [d (get (load decls) (load i))]
                (if (= (.name d) name) (set! (mut index) (load i)) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (< (load index) 0)
        (let [(mut d) (primitive/zeroed PrivateDecl)]
          (set! (.name (mut d)) name)
          (set! (.static (mut d)) is-static)
          (set! (.getter (mut d)) getter)
          (set! (.setter (mut d)) setter)
          (push! [PrivateDecl] (mut decls) (load d)))
        (let [d (al-elem [PrivateDecl] (mut decls) (load index))]
          ;; The only permitted duplicate is one getter plus one setter of the same staticness.
          (if (and (= (.static d) is-static)
                   (or (and getter (.setter d) (not (.getter d)))
                       (and setter (.getter d) (not (.setter d)))))
              (do (set! (.getter d) true) (set! (.setter d) true) 0)
              (syntax-error! "parser: duplicate private name"))))))

;; ClassElementName plus what the element rules need to know about its spelling.
(defstruct ParsedClassKey
  [(key ClassKey)
   (name (slice u8))
   (private bool)
   (computed bool)
   (lo i64)])

(defn parse-syntax-class-key! [] (-> ParsedClassKey)
  (let [(mut k) (primitive/zeroed ParsedClassKey)
        t (peek-token)]
    (set! (.lo (mut k)) (.start t))
    (if (token-is t "#")
        (let [name (parse-syntax-private-name! (take-token))]
          (set! (.key (mut k)) (CkPrivate (token-text name)))
          (set! (.name (mut k)) (token-text name))
          (set! (.private (mut k)) true))
        (if (token-is t "[")
            (let [saved-no-in (.no-in (parser-state))]
              (take-token)
              (set! (.no-in (parser-state)) false)
              (let [expr (parse-syntax-assignment)]
                (set! (.no-in (parser-state)) saved-no-in)
                (require-closing! "]" "parser: expected `]` after computed class element name")
                (set! (.key (mut k)) (CkComputed expr))
                (set! (.name (mut k)) "")
                (set! (.computed (mut k)) true)))
            (if (not (token-property-name? t))
                (do (syntax-error! "parser: expected a class element name") 0)
                (let [key-token (take-token)
                      name (syntax-property-key-name key-token)]
                  (set! (.key (mut k)) (CkNamed name))
                  (set! (.name (mut k)) name)))))
    (load k)))

(defn token-class-element-start? [(t Token)] (-> bool)
  (or (token-property-name? t) (token-is t "*")))

;; One ClassElement. `static` is a modifier unless it is itself the element name (`static(){}`,
;; `static = 1`, `static;`); `static {` opens a static block. `get`/`set`/`async`/`*` prefix a
;; method when a ClassElementName follows (no line terminator after `async`).
(defn parse-syntax-class-element! [(elements (mut (ArrayList ClassElement)))
                                   (privates (mut (ArrayList PrivateDecl)))
                                   (derived bool)
                                   (constructors (mut i64))] (-> i64)
  (let [first (peek-token)
        second (lex-peek-second false)
        is-static
          (and (token-is first "static")
               (= (.kind first) TOK-IDENT)
               (not (or (token-is second "(")
                        (token-is second "=")
                        (token-is second ";")
                        (token-is second "}"))))]
    (if is-static (do (take-token) 0) 0)
    (if (and is-static (token-is (peek-token) "{"))
        ;; ClassStaticBlock: a method-like body that may not `return`, use `await` or `arguments`.
        (let [open (take-token)
              index (syntax-fun-reserve! "static" (FunMethod) false false (.start first))]
          (parser-push-context! index false false false true)
          (parser-mark-top-context! false true false)
          (parser-set-in-params! false)
          (let [body (parse-syntax-statement-list)
                close (require-token "}")
                fp (syntax-fun-ptr index)]
            (parser-pop-context!)
            (set! (.body fp) body)
            (set! (.hi fp) (.end close))
            (push! [ClassElement] (mut elements) (CeStaticBlock index))
            0))
        (let [t (peek-token)
              next (lex-peek-second false)
              generator (token-is t "*")
              prefix
                (and (not generator)
                     (= (.kind t) TOK-IDENT)
                     (or (token-is t "get") (token-is t "set") (token-is t "async"))
                     (token-class-element-start? next)
                     (not (and (token-is t "async") (.nl-before next))))
              async (and prefix (token-is t "async"))
              getter (and prefix (token-is t "get"))
              setter (and prefix (token-is t "set"))]
          (if (or generator prefix) (do (take-token) 0) 0)
          (let [async-generator (and async (take-is "*"))
                k (parse-syntax-class-key!)
                after (peek-token)
                special (or generator prefix async-generator)]
            (if (token-is after "(")
                (let [constructor
                        (and (not is-static)
                             (not (.private k))
                             (not (.computed k))
                             (= (.name k) "constructor"))
                      kind (if getter (FunGetter) (if setter (FunSetter) (FunMethod)))]
                  (if constructor
                      (do
                        (if special
                            (syntax-error! "parser: constructor cannot be a getter, setter, generator or async method")
                            0)
                        (if (> (load constructors) 0) (syntax-error! "parser: duplicate constructor") 0)
                        (set! constructors (+ (load constructors) 1)))
                      0)
                  (if (and is-static (not (.computed k)) (not (.private k)) (= (.name k) "prototype"))
                      (syntax-error! "parser: static method cannot be named prototype")
                      0)
                  (if (.private k)
                      (syntax-declare-private! (mut privates) (.name k) is-static getter setter)
                      0)
                  (let [index (syntax-fun-reserve! (.name k) kind (or generator async-generator) async (.lo k))]
                    (parse-syntax-function-rest! index
                                                 kind
                                                 (or generator async-generator)
                                                 async
                                                 (and constructor derived))
                    (push! [ClassElement]
                           (mut elements)
                           (CeMethod
                             :key (.key k)
                             :static is-static
                             :fun index))
                    0))
                (do
                  (if special (syntax-error! "parser: expected a method after get, set, async or *") 0)
                  (if (and (not (.computed k)) (not (.private k)) (= (.name k) "constructor"))
                      (syntax-error! "parser: a class field cannot be named constructor")
                      0)
                  (if (and is-static (not (.computed k)) (not (.private k)) (= (.name k) "prototype"))
                      (syntax-error! "parser: a static class field cannot be named prototype")
                      0)
                  (if (.private k)
                      (syntax-declare-private! (mut privates) (.name k) is-static false false)
                      0)
                  (let [init
                          (if (take-is "=")
                              (let [index (syntax-fun-reserve! (.name k) (FunMethod) false false (.lo k))]
                                (parser-push-context! index false false false true)
                                (parser-mark-top-context! true false false)
                                (parser-set-in-params! false)
                                (let [value (parse-syntax-assignment)
                                      fp (syntax-fun-ptr index)]
                                  (parser-pop-context!)
                                  (set! (.expression-body fp) (Some value))
                                  (set! (.hi fp) (syntax-hi value))
                                  (Some index)))
                              (None [i64]))
                        end (peek-token)]
                    ;; A field ends at `;`, `}` or a line terminator.
                    (if (take-is ";")
                        0
                        (if (or (token-is end "}") (.nl-before end))
                            0
                            (syntax-error! "parser: expected `;` after class field")))
                    (push! [ClassElement]
                           (mut elements)
                           (CeField
                             :key (.key k)
                             :static is-static
                             :init-fun init))
                    0))))))))

;; ClassDeclaration / ClassExpression. Class code is strict; the name follows strict binding
;; rules. The heritage is a LeftHandSideExpression. Private references recorded inside resolve
;; against this class's declarations; unresolved ones belong to an enclosing class or are errors.
;; ClassHeritage is a LeftHandSideExpression. The parenthesized cover grammar can still yield an
;; arrow function here, which is an AssignmentExpression and therefore a proven error.
(defn parse-syntax-class-heritage [] (-> i64)
  (let [heritage (parse-syntax-lhs)]
    (match (syntax-node heritage)
      (SxFunction [fun]
                  (let [f (syntax-fun-at fun)]
                    (match (.kind f)
                      (FunArrow [] (syntax-error! "parser: class heritage must be a LeftHandSideExpression"))
                      (_ 0))))
      (_ 0))
    heritage))

(defn parse-syntax-class [(keyword Token) (declaration bool)] (-> i64)
  (set! (.class-strict (parser-state)) (+ (.class-strict (parser-state)) 1))
  (let [p (parser-state)
        lead (peek-token)
        name
          (if (or declaration (= (.kind lead) TOK-IDENT) (token-is lead "let"))
              (let [t (take-token)]
                (if (!= (.kind t) TOK-IDENT)
                    (do (syntax-error! "parser: reserved word cannot be a class name") 0)
                    (do
                      (syntax-strict-binding! (token-text t))
                      (syntax-check-binding-name! (token-text t))))
                (token-text t))
              "")
        heritage (if (take-is "extends") (Some (parse-syntax-class-heritage)) (None [i64]))
        derived (match heritage (Some [h] true) (None [] false))
        (mut elements) (al-new [ClassElement] (alloc/malloc-allocator))
        (mut privates) (al-new [PrivateDecl] (alloc/malloc-allocator))
        (mut constructors) 0]
    (set! (.class-depth p) (+ (.class-depth p) 1))
    (require-closing! "{" "parser: expected a class body")
    (loop (if (token-is (peek-token) "}")
              (break 0)
              (if (take-is ";")
                  (continue)
                  (do
                    (parse-syntax-class-element! (mut elements) (mut privates) derived (mut constructors))
                    (continue)))))
    (let [close (require-token "}")
          depth (.class-depth p)
          (mut remaining) (al-new [PrivateRef] (alloc/malloc-allocator))]
      ;; Resolve this class's private references; pass unresolved ones to the enclosing class.
      (al-for [ref (.private-refs p)]
              (let [r ref]
                (if (< (.depth r) depth)
                    (push! [PrivateRef] (mut remaining) r)
                    (let [(mut declared) false]
                      (al-for [entry (load privates)]
                              (let [d entry] (if (= (.name d) (.name r)) (set! (mut declared) true) 0)))
                      (if (load declared)
                          0
                          (if (= depth 1)
                              (syntax-error! "parser: reference to an undeclared private name")
                              (let [(mut outer) (primitive/zeroed PrivateRef)]
                                (set! (.name (mut outer)) (.name r))
                                (set! (.depth (mut outer)) (- depth 1))
                                (push! [PrivateRef] (mut remaining) (load outer)))))))))
      (al-clear! [PrivateRef] (mut (.private-refs p)))
      (al-for [r (load remaining)] (push! [PrivateRef] (mut (.private-refs p)) r))
      (al-free! [PrivateRef] (mut remaining))
      (al-free! [PrivateDecl] (mut privates))
      (set! (.class-depth p) (- depth 1))
      (set! (.class-strict p) (- (.class-strict p) 1))
      ;; The heritage and computed keys are strict code outside any method body.
      (match heritage (Some [h] (syntax-check-strict-expr! h)) (None [] 0))
      (al-for [element (load elements)]
              (let [key
                      (match element
                        (CeMethod [key is-static fun] key)
                        (CeField [key is-static init-fun] key)
                        (CeStaticBlock [fun] (CkNamed "")))]
                (match key (CkComputed [e] (syntax-check-strict-expr! e)) (_ 0))))
      (let [(mut c) (primitive/zeroed SyntaxClass)
            index (len (.classes p))]
        (set! (.name (mut c)) name)
        (set! (.heritage (mut c)) heritage)
        (set! (.elements (mut c)) (load elements))
        (set! (.lo (mut c)) (.start keyword))
        (set! (.hi (mut c)) (.end close))
        (push! [SyntaxClass] (mut (.classes p)) (load c))
        index))))

(defn syntax-fun-at [(i i64)] (-> SyntaxFun)
  (get (.funs (parser-state)) i))

;; The raw spelling of a string-literal expression statement, or None for any other statement.
(defn syntax-directive-text [(stmt-id i64)] (-> (Option (slice u8)))
  (match (syntax-stmt-node stmt-id)
    (SsExpr [expr]
            (match (syntax-node expr)
              (SxString [raw units legacy] (Some raw))
              (_ (None [(slice u8)]))))
    (_ (None [(slice u8)]))))

;; Simple has no strict-mode counterpart. ECMAScript directive prologues are local to Script or
;; FunctionBody: grouped strings, blocks and strings after a non-directive do not opt in. Script
;; strictness is inherited by its source functions, never from a sibling function's directive.
(defn syntax-body-strict? [(body (ArrayList i64))] (-> bool)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len body))
              (break false)
              (match (syntax-directive-text (get body (load i)))
                (Some [raw]
                      (if (= raw "use strict")
                          (break true)
                          (do (set! (mut i) (+ (load i) 1)) (continue))))
                (None [] (break false)))))))

(defn syntax-check-directives! [(body (ArrayList i64))] (-> i64)
  (if (syntax-body-strict? body)
      (do (set! (.strict-pending (parser-state)) true) 0)
      0))

(defn syntax-strict-reserved? [(name (slice u8))] (-> bool)
  (or (= name "implements")
      (= name "interface")
      (= name "let")
      (= name "package")
      (= name "private")
      (= name "protected")
      (= name "public")
      (= name "static")
      (= name "yield")))

(defn syntax-strict-binding! [(name (slice u8))] (-> i64)
  (if (or (= name "eval") (= name "arguments") (syntax-strict-reserved? name))
      (syntax-error! "parser: invalid strict-mode binding name")
      0))

;; Strict AssignmentTargetType: `eval`/`arguments` cannot be assigned, and a CallExpression
;; target is an early error rather than the sloppy runtime ReferenceError.
(defn syntax-check-strict-target! [(target i64)] (-> i64)
  (match (syntax-node target)
    (SxName [name] (syntax-strict-binding! name))
    (SxCall [callee args optional]
            (syntax-error! "parser: call expression is not a valid assignment target in strict code"))
    (_ 0)))

;; Inspect syntax rather than lowered values: unreachable code still has early errors and
;; property IdentifierNames are not IdentifierReferences.
(defn syntax-check-strict-expr! [(id i64)] (-> i64)
  (let [x (syntax-at id)
        (mut children) (al-new [i64] (alloc/malloc-allocator))]
    (match (.node x)
      (SxAssign [target value] (syntax-check-strict-target! target))
      (SxDestructuringAssign [pattern value] (syntax-strict-pattern-names! pattern))
      (SxCompoundAssign [op target value] (syntax-check-strict-target! target))
      (SxLogicalAssign [predicate rhs-on-true target value]
                       (syntax-check-strict-target! target))
      (SxUpdate [op prefix target] (syntax-check-strict-target! target))
      (SxString [raw units legacy]
                (if legacy
                    (syntax-error! "parser: legacy string escape in strict code")
                    0))
      (SxName [name]
              (if (syntax-strict-reserved? name)
                  (syntax-error! "parser: reserved identifier in strict code")
                  0))
      (SxDelete [operand]
                (if (syntax-name? (syntax-ungroup-id operand))
                    (syntax-error! "parser: delete of an unqualified identifier in strict code")
                    0))
      (SxNumber [value value-float rep]
                (let [text (subslice [u8] (lex-source) (.lo x) (.hi x))]
                  (if (and (> (len text) 1)
                           (= (get text 0) (cast u8 48))
                           (lex-digit? (get text 1)))
                      (syntax-error! "parser: legacy numeric literal in strict code")
                      0)))
      (_ 0))
    (syntax-expr-children! id (mut children))
    (al-for [child (load children)] (syntax-check-strict-expr! child))
    (al-free! [i64] (mut children))
    0))

(defn syntax-strict-pattern-names! [(pattern i64)] (-> i64)
  (do
    (match (syntax-pattern-node pattern)
      (PatName [name] (syntax-strict-binding! name))
      (PatTarget [expr] (syntax-check-strict-target! (syntax-ungroup-id expr)))
      (PatObject [props rest]
                 (do
                   (al-for [prop props] (let [pp prop] (syntax-strict-pattern-names! (.pattern pp))))
                   (match rest (Some [r] (syntax-strict-pattern-names! r)) (None [] 0))))
      (PatArray [elements rest]
                (do
                  (al-for [element elements]
                          (match element (PatItem [pat] (syntax-strict-pattern-names! pat)) (PatHole [] 0)))
                  (match rest (Some [r] (syntax-strict-pattern-names! r)) (None [] 0)))))
    0))

(defn syntax-check-strict-statements! [(stmts (ArrayList i64))] (-> i64)
  (do
    (al-for [id stmts]
            (let [(mut exprs) (al-new [i64] (alloc/malloc-allocator))
                  (mut children) (al-new [i64] (alloc/malloc-allocator))]
              (match (syntax-stmt-node id)
                (SsLet [name init final annotation]
                       (syntax-strict-binding! name))
                (SsVar [name init annotation] (syntax-strict-binding! name))
                (SsLetPattern [pattern init final] (syntax-strict-pattern-names! pattern))
                (SsVarPattern [pattern init] (syntax-strict-pattern-names! pattern))
                (SsWith [object body]
                        (syntax-error! "parser: with statement is not allowed in strict code"))
                (SsLabeled [label body]
                           (do
                             (if (syntax-strict-reserved? label)
                                 (syntax-error! "parser: reserved identifier in strict code")
                                 0)
                             (if (syntax-labelled-function? id)
                                 (syntax-error! "parser: labelled function declaration in strict code")
                                 0)))
                (SsBlock [body]
                         (if (syntax-annexb-block? id)
                             (syntax-error! "parser: function declaration in an if clause in strict code")
                             0))
                (SsTry [body catch-param catch-body finally-body]
                       (match catch-param (Some [pat] (syntax-strict-pattern-names! pat)) (None [] 0)))
                (SsForIn [head of right body awaited]
                         (match head
                           (ForInitPattern [pat] (syntax-strict-pattern-names! pat))
                           (ForInitDecl [stmt]
                                        (match (syntax-stmt-node stmt)
                                          (SsVar [name init annotation]
                                                 (match init
                                                   (Some [e]
                                                         (syntax-error! "parser: for-in var initializer in strict code"))
                                                   (None [] 0)))
                                          (_ 0)))
                           (_ 0)))
                (_ 0))
              (syntax-stmt-exprs! id (mut exprs))
              (al-for [e (load exprs)] (syntax-check-strict-expr! e))
              (syntax-stmt-children! id (mut children))
              (syntax-check-strict-statements! (load children))
              (al-free! [i64] (mut exprs))
              (al-free! [i64] (mut children))))
    0))

(defn syntax-check-strict-functions! [] (-> i64)
  (let [p (parser-state)]
    (al-for [entry (.funs p)]
            (let [fun entry]
              (if (.strict fun)
                  (do
                    ;; Only declarations and named expressions bind their name; a method, accessor,
                    ;; field initializer or static block name is a property key.
                    (match (.kind fun)
                      (FunDeclaration [] (syntax-strict-binding! (.name fun)))
                      (FunExpression [] (syntax-strict-binding! (.name fun)))
                      (_ 0))
                    (let [(mut bound) (syntax-fun-bound-names fun)]
                      (al-for [name (load bound)] (syntax-strict-binding! name))
                      (al-free! [(slice u8)] (mut bound)))
                    (match (.expression-body fun)
                      (Some [e] (syntax-check-strict-expr! e))
                      (None [] 0))
                    (al-for [d (.param-defaults fun)]
                            (match d
                              (Some [e] (syntax-check-strict-expr! e))
                              (None [] 0)))
                    (let [(mut bound) (syntax-fun-bound-names fun)
                          (mut i) 0]
                      (loop (if (>= (load i) (len (load bound)))
                                (break 0)
                                (let [name (get (load bound) (load i))
                                      (mut j) (+ (load i) 1)]
                                  (loop (if (>= (load j) (len (load bound)))
                                            (break 0)
                                            (do
                                              (if (= name (get (load bound) (load j)))
                                                  (syntax-error! "parser: duplicate strict-mode parameter")
                                                  0)
                                              (set! (mut j) (+ (load j) 1))
                                              (continue))))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))
                      (al-free! [(slice u8)] (mut bound)))
                    (syntax-check-strict-statements! (.body fun)))
                  0)))
    0))

;; `{a = 1}` is only valid when the object literal is reinterpreted as an assignment pattern.
;; Reinterpreted literals are marked consumed, so any surviving CoverInitializedName is a proven
;; SyntaxError.
(defn syntax-check-cover-initializers! [] (-> i64)
  (do
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.exprs (parser-state))))
                (break 0)
                (let [expr (get (.exprs (parser-state)) (load i))]
                  (match (.node expr)
                    (SxObject [entries]
                              (if (syntax-cover-consumed? (+ (load i) 1))
                                  0
                                  (do
                                    (al-for [entry entries]
                                            (match entry
                                              (PropCoverInit [name init]
                                                             (syntax-error! "parser: invalid shorthand property initializer"))
                                              (_ 0)))
                                    0)))
                    (_ 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    0))

(defn parser-source-entry-index [] (-> i64)
  (if (.script-mode (parser-state))
      (.script-index (parser-state))
      (syntax-find-fun "main")))

(defn syntax-direct-lexical? [(stmts (ArrayList i64)) (name (slice u8))] (-> bool)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len stmts))
              (break false)
              (let [found
                      (match (syntax-stmt-node (get stmts (load i)))
                        (SsLet [declared init final annotation] (= declared name))
                        (SsLetPattern [pattern init final]
                                      (let [(mut names) (al-new [(slice u8)] (alloc/malloc-allocator))]
                                        (syntax-pattern-names! pattern (mut names))
                                        (let [hit (syntax-labels-contain? (load names) name)]
                                          (al-free! [(slice u8)] (mut names))
                                          hit)))
                        (SsDeclList [decls] (syntax-direct-lexical? decls name))
                        (SsClassDecl [cls]
                                     (let [c (get (.classes (parser-state)) cls)] (= (.name c) name)))
                        (_ false))]
                (if found
                    (break true)
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn syntax-script-binding? [(name (slice u8))] (-> bool)
  (if (not (.script-mode (parser-state)))
      false
      (let [root (syntax-fun-at (.script-index (parser-state)))]
        (syntax-direct-lexical? (.body root) name))))

;; Syntax-only BoundNames collection. VarDeclaredNames crosses blocks/branches; lexical names
;; cross only declaration-list grouping and the shared switch CaseBlock. Function bodies live in
;; separate SyntaxFun records and must not be traversed as part of an enclosing declaration set.
;; A FunctionDeclaration is var-like at the top level of a function body (TopLevelVarDeclaredNames)
;; and lexical inside a Block or CaseBlock. Top-level Script functions are hoisted Funs, not
;; bindings this collector reports. `top` is true only for the function body's own list.
(defn syntax-collect-declarations! [(stmts (ArrayList i64))
                                    (lexical bool)
                                    (names (mut (ArrayList (slice u8))))] (-> i64)
  (syntax-collect-declarations-at! stmts lexical false (mut names)))

(defn syntax-function-decl-names! [(stmts (ArrayList i64))
                                   (names (mut (ArrayList (slice u8))))] (-> i64)
  (do
    (al-for [id stmts]
            (match (syntax-stmt-node id)
              (SsFunctionDecl [fun]
                              (let [f (syntax-fun-at fun)]
                                (push! [(slice u8)] (mut names) (.name f))))
              (_ 0)))
    0))

(defn syntax-collect-declarations-at! [(stmts (ArrayList i64))
                                       (lexical bool)
                                       (top bool)
                                       (names (mut (ArrayList (slice u8))))] (-> i64)
  (do
    (al-for [id stmts]
            (let [(mut children) (al-new [i64] (alloc/malloc-allocator))
                  grouping
                    (match (syntax-stmt-node id)
                      (SsClassDecl [cls]
                                   (do
                                     (if lexical
                                         (let [c (get (.classes (parser-state)) cls)]
                                           (push! [(slice u8)] (mut names) (.name c)))
                                         0)
                                     false))
                      (SsFunctionDecl [fun]
                                      (let [f (syntax-fun-at fun)]
                                        (if (not (.hoisted f))
                                            (if (= lexical (not top))
                                                (push! [(slice u8)]
                                                       (mut names)
                                                       (.name f))
                                                0)
                                            0)
                                        false))
                      (SsLet [name init final annotation]
                             (do
                               (if lexical
                                   (push! [(slice u8)] (mut names) name)
                                   0)
                               false))
                      (SsVar [name init annotation]
                             (do
                               (if lexical
                                   0
                                   (push! [(slice u8)] (mut names) name))
                               false))
                      (SsLetPattern [pattern init final]
                                    (do (if lexical (syntax-pattern-names! pattern (mut names)) 0) false))
                      (SsVarPattern [pattern init]
                                    (do (if lexical 0 (syntax-pattern-names! pattern (mut names))) false))
                      (SsDeclList [decls] true)
                      (SsCase [selector body] true)
                      (_ false))]
              (if (or (not lexical) grouping)
                  (do
                    (syntax-stmt-children! id (mut children))
                    (syntax-collect-declarations-at! (load children)
                                                     lexical
                                                     (and top grouping)
                                                     (mut names)))
                  0)
              (al-free! [i64] (mut children))))
    0))

;; Early errors are checked before graph construction, including unreachable nested blocks.
;; This is declaration-name validation, not a second semantic environment or SSA pass.
;; `top` marks a function body's own statement list, where function declarations are var-like.
;; Sloppy code tolerates duplicate FunctionDeclarations in a Block (Annex B.3.2.4); everything
;; else duplicated is an error.
(defn syntax-check-declarations! [(stmts (ArrayList i64))
                                  (parameters (ArrayList (slice u8)))
                                  (lexical-scope bool)
                                  (top bool)
                                  (strict bool)] (-> i64)
  (do
    (if lexical-scope
        (let [(mut names) (al-new [(slice u8)] (alloc/malloc-allocator))
              (mut vars) (al-new [(slice u8)] (alloc/malloc-allocator))
              (mut functions) (al-new [(slice u8)] (alloc/malloc-allocator))
              (mut i) 0]
          (syntax-collect-declarations-at! stmts true top (mut names))
          (syntax-collect-declarations-at! stmts false top (mut vars))
          (if top 0 (syntax-function-decl-names! stmts (mut functions)))
          (loop (if (>= (load i) (len (load names)))
                    (break 0)
                    (let [name (get (load names) (load i))
                          (mut j) (+ (load i) 1)]
                      (loop (if (>= (load j) (len (load names)))
                                (break 0)
                                (do
                                  (if (and (= name (get (load names) (load j)))
                                           (not (and (not strict)
                                                     (syntax-labels-contain? (load functions)
                                                                             name)
                                                     (syntax-all-plain-functions? stmts name))))
                                      (syntax-error! "parser: duplicate lexical declaration")
                                      0)
                                  (set! (mut j) (+ (load j) 1))
                                  (continue))))
                      (al-for [var-name (load vars)]
                              (if (= name var-name)
                                  (syntax-error! "parser: lexical declaration conflicts with var declaration")
                                  0))
                      (al-for [parameter parameters]
                              (if (= name parameter)
                                  (syntax-error! "parser: lexical declaration conflicts with parameter")
                                  0))
                      (set! (mut i) (+ (load i) 1))
                      (continue)))))
        0)
    (let [empty (al-new [(slice u8)] (alloc/malloc-allocator))]
      (al-for [id stmts]
              (let [(mut children) (al-new [i64] (alloc/malloc-allocator))
                    ;; A for head is its own lexical scope containing the body, so a head `let`
                    ;; conflicts with the body's VarDeclaredNames and with itself.
                    scope
                      (match (syntax-stmt-node id)
                        (SsBlock [body] true)
                        (SsSwitch [discriminant cases] true)
                        (SsFor [init test update body] true)
                        (SsForIn [head of right body awaited] true)
                        (_ false))]
                (match (syntax-stmt-node id)
                  (SsTry [body catch-param catch-body finally-body]
                         (syntax-check-catch-parameter! catch-param catch-body))
                  (_ 0))
                (syntax-stmt-children! id (mut children))
                (syntax-check-declarations! (load children)
                                            empty
                                            scope
                                            false
                                            strict)
                (al-free! [i64] (mut children)))))
    0))

;; Annex B.3.2.4 tolerates duplicate FunctionDeclarations in a sloppy Block only when every
;; declaration of the name there is a plain (non-generator, non-async) function declaration.
(defn syntax-all-plain-functions? [(stmts (ArrayList i64)) (name (slice u8))] (-> bool)
  (let [(mut ok) true]
    (al-for [id stmts]
            (match (syntax-stmt-node id)
              (SsFunctionDecl [fun]
                              (let [f (syntax-fun-at fun)]
                                (if (and (= (.name f) name) (or (.generator f) (.async f)))
                                    (set! (mut ok) false)
                                    0)))
              (SsClassDecl [cls]
                           (let [c (get (.classes (parser-state)) cls)]
                             (if (= (.name c) name) (set! (mut ok) false) 0)))
              (SsLet [declared init final annotation]
                     (if (= declared name) (set! (mut ok) false) 0))
              (SsLetPattern [pattern init final] (set! (mut ok) false))
              (SsDeclList [decls]
                          (do
                            (al-for [d decls]
                                    (match (syntax-stmt-node d)
                                      (SsLet [declared init final annotation]
                                             (if (= declared name) (set! (mut ok) false) 0))
                                      (SsLetPattern [pattern init final] (set! (mut ok) false))
                                      (_ 0)))
                            0))
              (_ 0)))
    (load ok)))

;; The CatchParameter shares a scope with the catch Block's lexical declarations; a `var` of the
;; same name is permitted by Annex B.
(defn syntax-check-catch-parameter! [(param (Option i64))
                                     (catch-body (Option i64))] (-> i64)
  (match param
    (None [] 0)
    (Some [pattern]
          (let [(mut bound) (al-new [(slice u8)] (alloc/malloc-allocator))]
            (syntax-pattern-names! pattern (mut bound))
            ;; A destructuring catch parameter cannot repeat a name.
            (let [(mut i) 0]
              (loop (if (>= (load i) (len (load bound)))
                        (break 0)
                        (let [name (get (load bound) (load i))
                              (mut j) (+ (load i) 1)]
                          (loop (if (>= (load j) (len (load bound)))
                                    (break 0)
                                    (do
                                      (if (= name (get (load bound) (load j)))
                                          (syntax-error! "parser: duplicate catch parameter name")
                                          0)
                                      (set! (mut j) (+ (load j) 1))
                                      (continue))))
                          (set! (mut i) (+ (load i) 1))
                          (continue)))))
            (match catch-body
              (None [] 0)
              (Some [block]
                    (match (syntax-stmt-node block)
                      (SsBlock [body]
                               (let [(mut names) (al-new [(slice u8)] (alloc/malloc-allocator))]
                                 (syntax-collect-declarations! body true (mut names))
                                 (al-for [declared (load names)]
                                         (al-for [name (load bound)]
                                                 (if (= declared name)
                                                     (syntax-error! "parser: catch parameter conflicts with a lexical declaration")
                                                     0)))
                                 (al-free! [(slice u8)] (mut names))
                                 0))
                      (_ 0))))))))

(defn syntax-iteration-stmt? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsWhile [condition body] true)
    (SsDoWhile [body condition] true)
    (SsFor [init test update body] true)
    (SsForIn [head of right body awaited] true)
    (_ false)))

;; `a: b: while (…)` names the loop by both labels; only such labels are `continue` targets.
(defn syntax-labeled-iteration? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsLabeled [label body] (syntax-labeled-iteration? body))
    (_ (syntax-iteration-stmt? id))))

(defn syntax-labels-contain? [(labels (ArrayList (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (al-for [label labels] (if (= label name) (set! (mut found) true) 0))
    (load found)))

(defn syntax-check-jump-label! [(label (Option (slice u8)))
                                (labels (ArrayList (slice u8)))
                                (depth i64)
                                (unlabelled (slice u8))
                                (unknown (slice u8))] (-> i64)
  (match label
    (None [] (if (= depth 0) (syntax-error! unlabelled) 0))
    (Some [name]
          (if (syntax-labels-contain? labels name) 0 (syntax-error! unknown)))))

;; Early errors for break/continue/labels. `labels` is the enclosing label set, `loop-labels`
;; the subset naming an iteration statement; `breakable` and `loops` count enclosing targets for
;; the unlabelled forms. Labels are function-local; each SyntaxFun body starts empty.
(defn syntax-check-jumps! [(stmts (ArrayList i64))
                           (labels (mut (ArrayList (slice u8))))
                           (loop-labels (mut (ArrayList (slice u8))))
                           (breakable i64)
                           (loops i64)] (-> i64)
  (do
    (al-for [id stmts]
            (let [(mut children) (al-new [i64] (alloc/malloc-allocator))
                  handled
                    (match (syntax-stmt-node id)
                      (SsLabeled [label body]
                                 (let [iteration (syntax-labeled-iteration? body)]
                                   (if (syntax-labels-contain? (load labels)
                                                               label)
                                       (syntax-error! "parser: duplicate label")
                                       0)
                                   (push! [(slice u8)] (mut labels) label)
                                   (if iteration
                                       (push! [(slice u8)]
                                              (mut loop-labels)
                                              label)
                                       0)
                                   (push! [i64] (mut children) body)
                                   (syntax-check-jumps! (load children)
                                                        (mut labels)
                                                        (mut loop-labels)
                                                        breakable
                                                        loops)
                                   (pop! (mut labels))
                                   (if iteration
                                       (do (pop! (mut loop-labels)) 0)
                                       0)
                                   true))
                      (SsBreak [label]
                               (do
                                 (syntax-check-jump-label! label
                                                           (load labels)
                                                           breakable
                                                           "parser: break has no enclosing breakable statement"
                                                           "parser: break names an undefined label")
                                 true))
                      (SsContinue [label]
                                  (do
                                    (syntax-check-jump-label! label
                                                              (load loop-labels)
                                                              loops
                                                              "parser: continue has no enclosing iteration statement"
                                                              "parser: continue names a label that is not an enclosing iteration statement")
                                    true))
                      (_ false))
                  loop (syntax-iteration-stmt? id)
                  switch
                    (match (syntax-stmt-node id)
                      (SsSwitch [discriminant cases] true)
                      (_ false))]
              (if handled
                  0
                  (do
                    (syntax-stmt-children! id (mut children))
                    (syntax-check-jumps! (load children)
                                         (mut labels)
                                         (mut loop-labels)
                                         (if (or loop switch)
                                             (+ breakable 1)
                                             breakable)
                                         (if loop (+ loops 1) loops))))
              (al-free! [i64] (mut children))))
    0))

(defn syntax-restricted-global? [(name (slice u8))] (-> bool)
  (or (= name "undefined") (= name "Infinity") (= name "NaN")))

;; The value and function properties of the global object ECMA-262 §19 requires, and the
;; well-known constructors and namespaces. None is provided yet; a program naming one must not be
;; told the name is unresolvable (`typeof JSON` is "object" in every realm), so a read of one is
;; a runtime refusal, never `undefined`.
(defn syntax-standard-global? [(name (slice u8))] (-> bool)
  (or (= name "globalThis") (= name "eval") (= name "isFinite") (= name "isNaN")
      (= name "parseFloat") (= name "parseInt") (= name "decodeURI")
      (= name "decodeURIComponent") (= name "encodeURI") (= name "encodeURIComponent")
      (= name "Array") (= name "ArrayBuffer") (= name "BigInt") (= name "Boolean")
      (= name "DataView") (= name "Date") (= name "Error") (= name "EvalError")
      (= name "Function") (= name "Map") (= name "Number") (= name "Object")
      (= name "Promise") (= name "Proxy") (= name "RangeError") (= name "ReferenceError")
      (= name "RegExp") (= name "Set") (= name "String") (= name "Symbol")
      (= name "SyntaxError") (= name "TypeError") (= name "URIError") (= name "WeakMap")
      (= name "WeakRef") (= name "WeakSet") (= name "FinalizationRegistry")
      (= name "Atomics") (= name "JSON") (= name "Math") (= name "Reflect")
      (= name "AggregateError") (= name "SharedArrayBuffer") (= name "Iterator")
      (= name "Int8Array") (= name "Uint8Array") (= name "Uint8ClampedArray")
      (= name "Int16Array") (= name "Uint16Array") (= name "Int32Array") (= name "Uint32Array")
      (= name "Float32Array") (= name "Float64Array") (= name "BigInt64Array")
      (= name "BigUint64Array")))

;; A hoisted top-level declaration: what the closed-world Fun table and call resolution see.
;; Nested functions, expressions, arrows and methods are values and are not lowered yet.
(defn syntax-top-level-declaration? [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (.hoisted f)))

;; Whether the header pass gave this function record a Fun: hoisted declarations and admitted
;; function values.
(defn syntax-fun-lowered? [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (!= (.fun-nid f) 0)))

;; Function values the closed world lowers today: plain declarations, expressions and arrows with
;; simple parameter lists. Methods, accessors, generators and async functions refuse at their use.
(defn syntax-fun-value-admitted? [(f SyntaxFun)] (-> bool)
  (and (match (.kind f)
         (FunDeclaration [] true)
         (FunExpression [] true)
         (FunArrow [] true)
         (_ false))
       (.simple-params f)
       (not (.generator f))
       (not (.async f))
       (not (syntax-fun-has-patterns? f))))

;; Every source function shares one boxed signature: `this`, then the program-wide maximum formal
;; count of slots (docs/DECISIONS.md, function values).
(defn parser-abi-slots [] (-> i64)
  (.abi-slots (parser-state)))

(defn parser-abi-sig [] (-> i64)
  (.abi-sig (parser-state)))

(defn parser-settle-abi! [] (-> i64)
  (let [(mut slots) 0 (mut members) (al-new [i64] (alloc/malloc-allocator))]
    (al-for [f (.funs (parser-state))]
            (let [fun f]
              (if (> (len (.params fun)) (load slots)) (set! (mut slots) (len (.params fun))) 0)))
    ;; A function returns a completion: its value, or the exception sentinel when it throws. Its
    ;; arguments are `this`, `new.target` (undefined for a call, the constructor for `new`:
    ;; docs/DECISIONS.md, new.target is an argument slot) and the program-wide formal slots.
    (push! [i64] (mut members) (ty-dyn TAG-COMPLETION))
    (let [(mut i) 0]
      (loop (if (> (load i) (+ (load slots) 1))
                (break 0)
                (do (push! [i64] (mut members) (ty-dyn TAG-ANY)) (set! (mut i) (+ (load i) 1)) (continue)))))
    (set! (.abi-slots (parser-state)) (load slots))
    (set! (.abi-sig (parser-state)) (ty-tuple (al-slice (load members))))
    0))

;; The object-file symbol of a hoisted declaration: its source name for the LAST declaration of
;; that name in the realm (the binding JavaScript observes), a compiler-owned dotted name for every
;; earlier one, so duplicate declarations within or across Scripts stay distinct for the linker.
(defn parser-hoisted-fun-symbol [(index i64)] (-> (slice u8))
  (let [f (syntax-fun-at index)
        (mut taken) false
        (mut j) (+ index 1)]
    (loop (if (>= (load j) (len (.funs (parser-state))))
              (break 0)
              (let [g (syntax-fun-at (load j))]
                (if (and (.hoisted g) (= (.name g) (.name f))) (set! (mut taken) true) 0)
                (set! (mut j) (+ (load j) 1))
                (continue))))
    (if (load taken)
        (let [(mut sb) (sb-new (alloc/malloc-allocator))]
          (sb-push-str! (mut sb) "$aot$.")
          (sb-push-str! (mut sb) (.name f))
          (sb-push-str! (mut sb) ".")
          (sb-push-i64! (mut sb) index)
          (sb-str (mut sb)))
        (.name f))))

;; Compiler-owned symbol for a function value; a dot keeps it outside the source namespace.
(defn parser-value-fun-name [(index i64)] (-> (slice u8))
  (let [(mut sb) (sb-new (alloc/malloc-allocator))]
    (sb-push-str! (mut sb) "$aot$.fn.")
    (sb-push-i64! (mut sb) index)
    (sb-str (mut sb))))

;; The function-pointer set a code word loaded from any function object may hold: every function
;; the program lowered. Finite, so Opto links a value call to exactly these targets.
(defn parser-value-funptr-ty [] (-> i64)
  (let [(mut fidxs) (al-new [i64] (alloc/malloc-allocator)) (mut i) 0]
    (loop (if (>= (load i) (len (.funs (parser-state))))
              (break 0)
              (do
                (if (syntax-fun-lowered? (load i))
                    (let [f (syntax-fun-at (load i))] (push! [i64] (mut fidxs) (.fidx f)))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [t (ty-funptr (parser-abi-sig) (fidx-set-intern (al-slice (load fidxs))))]
      (al-free! [i64] (mut fidxs))
      t)))

;; Whether `name` is bound by an enclosing function of `fun`: a parameter, a var, a lexical
;; declaration or a nested function declaration. Such a reference is a capture.
(defn syntax-enclosing-binding? [(fun i64) (name (slice u8))] (-> bool)
  (let [(mut current) (let [f (syntax-fun-at fun)] (.parent f))
        (mut found) false]
    (loop (if (or (load found) (< (load current) 0))
              (break 0)
              (let [f (syntax-fun-at (load current))
                    (mut names) (al-new [(slice u8)] (alloc/malloc-allocator))]
                (if (.hoisted f)
                    0  ; the Script root and top-level declarations own globals and hoisted Funs, not captures
                    (do
                      (al-for [p (.params f)] (push! [(slice u8)] (mut names) p))
                      (match (.rest-param f) (Some [r] (push! [(slice u8)] (mut names) r)) (None [] 0))
                      (syntax-collect-declarations! (.body f) false (mut names))
                      (syntax-collect-declarations! (.body f) true (mut names))
                      (syntax-function-decl-names! (.body f) (mut names))
                      (match (.kind f)
                        (FunExpression [] (push! [(slice u8)] (mut names) (.name f)))
                        (_ 0))
                      (al-for [n (load names)] (if (= n name) (set! (mut found) true) 0))
                      0))
                (al-free! [(slice u8)] (mut names))
                (set! (mut current) (.parent f))
                (continue))))
    (load found)))

;; The program loop marks the declarations it parsed at the top level as hoisted Funs.
(defn syntax-mark-hoisted! [(stmt i64)] (-> i64)
  (match (syntax-stmt-node stmt)
    (SsFunctionDecl [fun] (let [fp (syntax-fun-ptr fun)] (set! (.hoisted fp) true) 0))
    (_ 0)))

(defn syntax-find-fun [(name (slice u8))] (-> i64)
  ;; Function declarations are hoisted and later declarations replace earlier declarations of the
  ;; same binding. Resolve from the end so calls and the public entry observe that JavaScript rule;
  ;; obsolete bodies then disappear through the ordinary closed-world lifetime protocol.
  (let [(mut i) (- (len (.funs (parser-state))) 1)]
    (loop (if (< (load i) 0)
              (break -1)
              (let [f (syntax-fun-at (load i))]
                (if (and (= (.name f) name)
                         (syntax-top-level-declaration? (load i)))
                    (break (load i))
                    (do (set! (mut i) (- (load i) 1)) (continue))))))))

(defn parser-node [(nid i64)] (-> (dyn NodeOps))
  (match (arena-node nid) (Some [n] n) (None [] (unreachable-node))))

(defn parser-internal-main-name [] (-> (slice u8))
  ;; A dot cannot occur in an admitted JavaScript identifier. Compiler-owned native symbols must
  ;; live outside the source namespace or a user declaration can collide with the renamed source
  ;; entry even though their graph identities and function indices are distinct.
  "$aot$.source_main")

(defn parser-entry-fun [] (-> (dyn NodeOps))
  (if (= (.entry-fun-nid (parser-state)) 0)
      (do
        (panic "parser-entry-fun: process-entry wrapper is not installed")
        (unreachable-node))
      (parser-node (.entry-fun-nid (parser-state)))))

;; Return the compilation unit's source Start through the compiler-owned process wrapper, rather
;; than by graph search: linked source/JSL callees also expose their own Starts in the Stop cone.
(defn parser-entry-arity [] (-> i64)
  (let [idx (parser-source-entry-index)]
    (if (< idx 0)
        (do (panic "parser-entry-arity: program has no main function") 0)
        (let [syntax (syntax-fun-at idx)]
          (len (.params syntax))))))

(defn parser-entry-start [] (-> (dyn NodeOps))
  (do
    ;; argc/argv belong to the host wrapper and never enter source `main`. The wrapper supplies the
    ;; ECMAScript value `undefined` for every declared-but-omitted source parameter.
    (match (n-in (parser-entry-fun) 1)
      (Some [start]
            (if (= (n-op start) OP-START)
                start
                (do
                  (panic "parser-entry-start: wrapper is not rooted at Start")
                  (unreachable-node))))
      (None []
            (do
              (panic "parser-entry-start: wrapper has no entry hook")
              (unreachable-node))))))

(defn lower-typeof-operand [(id i64)] (-> (dyn NodeOps))
  ;; Parentheses preserve a Reference. typeof skips GetValue only for an unresolvable name;
  ;; a declared TDZ binding must still take the normal read path. Our global environment is
  ;; incomplete, so lack of a Scope slot does NOT prove that e.g. JSON is absent. Refuse that
  ;; path by name until global resolution exists, including first-class function declarations.
  (let [unresolved
          (match (syntax-node (syntax-ungroup-id id))
            (SxName [name]
                    (and (< (scope-find (parser-node (.current-scope (parser-state))) name) 0)
                         (not (syntax-restricted-global? name))
                         (not (syntax-standard-global? name))
                         (not (syntax-script-binding? name))
                         (< (syntax-global-index name) 0)
                         (< (syntax-find-fun name) 0)
                         (not (syntax-enclosing-binding? (.current-fun (parser-state)) name))))
            (_ false))]
    ;; The realm declares every global statically, so a name nothing declares is unresolvable and
    ;; `typeof` yields "undefined" without a ReferenceError: the operand is simply undefined.
    (if unresolved
        (dyn-undefined-make)
        (lower-syntax-expr id))))

(defn lower-name [(name (slice u8))] (-> (dyn NodeOps))
  (match (scope-lookup (parser-node (.current-scope (parser-state))) name)
    (Some [value] value)
    (None []
          (if (syntax-script-binding? name)
              (do
                (unimplemented "Script global lexical access outside its initialized execution scope"
                               "docs/GAPS.md — global environments and TDZ")
                (unreachable-node))
              ;; Resolve the non-writable global numeric/singleton values after lexical
              ;; bindings first because JavaScript permits a parameter or local to shadow that global;
              ;; only an unresolved identifier receives the canonical singleton.
              (if (= name "undefined")
                  (dyn-undefined-make)
                  (if (or (= name "Infinity") (= name "NaN"))
                      (lower-singleton (if (= name "Infinity")
                                           "JsInfinity"
                                           "JsNaN"))
                      (if (>= (syntax-global-index name) 0)
                          (lower-global-load name)
                          (if (>= (syntax-find-fun name) 0)
                          (lower-function-object (syntax-find-fun name))
                          (if (syntax-enclosing-binding? (.current-fun (parser-state)) name)
                              (do
                                (unimplemented "captured variables (closures)"
                                               "docs/GAPS.md — function values and closures")
                                (unreachable-node))
                              ;; Nothing in the Script or any enclosing function declares the
                              ;; name: it is a Reference into the global object, resolved at
                              ;; runtime as a property read or a ReferenceError.
                              (lower-jsl-unary-value "JsUnresolvedGlobalRead"
                                                     (con-int (shape-key-intern name))))))))))))

(defn parser-set-current-ctrl! [(ctrl (dyn NodeOps))] (-> i64)
  (do
    (set! (.current-ctrl (parser-state)) (n-nid ctrl))
    (scope-set-ctrl! (parser-node (.current-scope (parser-state))) ctrl)))

;; A source operator is admitted by the grammar before its semantics exist in the production JSL
;; index. Refuse by the operator's JSL entry-point name so the missing definition is the message.
(defn lower-require-jsl! [(name (slice u8))] (-> i64)
  (if (jsl-defined? name)
      0
      (unimplemented name
                     "jsl/compiler/index — this operator's JSL definition is not in the production registry")))

;; JavaScript numeric operators are semantic calls for every admitted Number representation.
;; Values cross the dynamic boundary into JSL; specialization may expose raw integer or binary64
;; arithmetic, while mixed number/undefined flow retains the guarded generic path.
(defn lower-js-binary [(lhs (dyn NodeOps))
                       (rhs (dyn NodeOps))
                       (name (slice u8))] (-> (dyn NodeOps))
  (let [target (jsl-graph-of name)
        scope (parser-node (.current-scope (parser-state)))
        c
          (call-make-with-mem (parser-node (.current-ctrl (parser-state)))
                              (scope-mem scope))]
    ;; JavaScript values are already dynamic at every source-level boundary. JSL owns any unboxing;
    ;; boxing again here would make the frontend silently choose an integer representation.
    (call-add-arg! c lhs)
    (call-add-arg! c rhs)
    ;; Nested argument lowering may advance both effects. The call consumes the state after all
    ;; arguments, not the snapshot from before their evaluation.
    (n-set-def! c CALL-CTRL (Some (parser-node (.current-ctrl (parser-state)))))
    (n-set-def! c CALL-MEM (Some (scope-mem scope)))
    (call-set-fptr! c (funptr-make target (jsl-fidx-of name)))
    (let [end (callend-make c)]
      (let [ctrl (cproj-make end RETURN-CTRL "js-binary.ctrl")]
        (parser-set-current-ctrl! ctrl))
      (scope-set-mem! scope (proj-make end RETURN-MEM "js-binary.mem"))
      (proj-make end RETURN-VALUE "js-binary.value"))))

;; Source predicates cross the same semantic boundary as arithmetic. JSL handles both numeric
;; representations, signed zero, and NaN; its raw Boolean result is the compiler-internal predicate
;; expected by If and never escapes as a source-language value.
(defn lower-js-unary [(value (dyn NodeOps)) (name (slice u8))] (-> (dyn NodeOps))
  (let [target (jsl-graph-of name)
        scope (parser-node (.current-scope (parser-state)))
        c
          (call-make-with-mem (parser-node (.current-ctrl (parser-state)))
                              (scope-mem scope))]
    (call-add-arg! c value)
    (n-set-def! c CALL-CTRL (Some (parser-node (.current-ctrl (parser-state)))))
    (n-set-def! c CALL-MEM (Some (scope-mem scope)))
    (call-set-fptr! c (funptr-make target (jsl-fidx-of name)))
    (let [end (callend-make c)]
      (let [ctrl (cproj-make end RETURN-CTRL "js-truthy.ctrl")]
        (parser-set-current-ctrl! ctrl))
      (scope-set-mem! scope (proj-make end RETURN-MEM "js-truthy.mem"))
      (proj-make end RETURN-VALUE "js-truthy.value"))))

(defn lower-js-truthy [(value (dyn NodeOps))] (-> (dyn NodeOps))
  (lower-js-unary value "JsTruthy"))

;; A Reference evaluated once and held across a right-hand side. Final Simple parseAsgn keeps the
;; old value across RHS parsing and its field path keeps base/offset; here the base and interned
;; key are kept as nodes until the final PutValue. `bound` is decided before the RHS: an
;; expression cannot introduce a declaration, so the resolution cannot change underneath it.
(defstruct SyntaxRef
  [(member bool) (name (slice u8)) (owner-nid i64) (key-nid i64) (bound bool)
   (keyed bool)])  ; `owner[key]`: key-nid is the evaluated key value, not an interned key

(defn lower-ref-prepare! [(target i64)] (-> SyntaxRef)
  (let [(mut ref) (primitive/zeroed SyntaxRef)]
    (match (syntax-node target)
      (SxIndex [owner key optional]
               (let [base (lower-syntax-expr owner)]
                 (n-keep! base)
                 (let [k (lower-syntax-expr key)]
                   (n-keep! k)
                   (set! (.member (mut ref)) true)
                   (set! (.keyed (mut ref)) true)
                   (set! (.owner-nid (mut ref)) (n-nid base))
                   (set! (.key-nid (mut ref)) (n-nid k)))))
      (SxPrivateMember [owner name optional]
                       (unimplemented "private class members" "docs/GAPS.md — classes"))
      (SxMember [owner name optional]
                (let [base (lower-syntax-expr owner)
                      key (con-int (shape-key-intern name))]
                  (n-keep! base)
                  (n-keep! key)
                  (set! (.member (mut ref)) true)
                  (set! (.owner-nid (mut ref)) (n-nid base))
                  (set! (.key-nid (mut ref)) (n-nid key))))
      (SxName [name]
              (do
                (set! (.name (mut ref)) name)
                (set! (.bound (mut ref))
                      (>= (scope-find (parser-node (.current-scope (parser-state)))
                                      name)
                          0))))
      (SxCall [callee args optional]
              (unimplemented "call expression assignment target (sloppy runtime ReferenceError)"
                             "docs/GAPS.md — exceptions"))
      (_ (broken "lower-ref-prepare!: target survived syntax validation")))
    (load ref)))

(defn lower-ref-get! [(ref SyntaxRef)] (-> (dyn NodeOps))
  (if (.member ref)
      (let [scope (parser-node (.current-scope (parser-state)))
            (mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
        (push! [(dyn NodeOps)] (mut args) (parser-node (.owner-nid ref)))
        (push! [(dyn NodeOps)] (mut args) (parser-node (.key-nid ref)))
        (let [loaded
                (if (.keyed ref)
                    (lower-jsl-call-values "JsGetKeyed" (load args))
                    (jsl-lower-macro-values "JsGetNamed"
                                            (load args)
                                            (scope-ctrl scope)
                                            (scope-mem scope)))]
          (al-free! [(dyn NodeOps)] (mut args))
          (parser-set-current-ctrl! (.ctrl loaded))
          (scope-set-mem! scope (.mem loaded))
          (lower-completion! (.value loaded))))
      (lower-name (.name ref))))

;; PutValue against the live post-RHS Scope. Non-strict PutValue to the three non-writable
;; globals has no effect; lexical shadows take Scope's ordinary update and const/TDZ checks. JSL
;; owns property semantics; descriptors, accessors and nullish-base exceptions remain its gaps.
(defn lower-ref-put! [(ref SyntaxRef) (value (dyn NodeOps))] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))]
    (if (.member ref)
        (let [(mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
          (push! [(dyn NodeOps)] (mut args) (parser-node (.owner-nid ref)))
          (push! [(dyn NodeOps)] (mut args) (parser-node (.key-nid ref)))
          (push! [(dyn NodeOps)] (mut args) value)
          (let [stored
                  (if (.keyed ref)
                      (lower-jsl-call-values "JsSetKeyed" (load args))
                      (jsl-lower-macro-values "JsDefineOwnNamed"
                                              (load args)
                                              (scope-ctrl scope)
                                              (scope-mem scope)))]
            (al-free! [(dyn NodeOps)] (mut args))
            (parser-set-current-ctrl! (.ctrl stored))
            (scope-set-mem! scope (.mem stored))
            (lower-completion! (.value stored))
            0))
        (if (.bound ref)
            (scope-update! scope (.name ref) value)
            (if (syntax-restricted-global? (.name ref))
                ;; `undefined = 1`: silently ignored in sloppy code; a TypeError in strict code
                ;; (the runtime's TypeError trap until exception objects exist).
                (if (syntax-fun-strict (.current-fun (parser-state)))
                    (lower-throw-type-error! "Cannot assign to read only property")
                    0)
                ;; Var-like globals are properties of the realm's global object; an undeclared
                ;; name would create one at run time and refuses until that is implemented.
                (if (>= (syntax-global-index (.name ref)) 0)
                    (lower-global-store! (.name ref) value)
                    (let [scope (parser-node (.current-scope (parser-state)))
                          (mut wargs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
                      (push! [(dyn NodeOps)] (mut wargs) (con-int (shape-key-intern (.name ref))))
                      (push! [(dyn NodeOps)] (mut wargs) value)
                      (let [w (jsl-lower-macro-values "JsUnresolvedGlobalWrite"
                                                      (load wargs)
                                                      (parser-node (.current-ctrl (parser-state)))
                                                      (scope-mem scope))]
                        (al-free! [(dyn NodeOps)] (mut wargs))
                        (parser-set-current-ctrl! (.ctrl w))
                        (scope-set-mem! scope (.mem w))
                        0))))))))

(defn lower-ref-release! [(ref SyntaxRef)] (-> i64)
  (if (.member ref)
      (do
        (n-unkeep! (parser-node (.key-nid ref)))
        (n-unkeep! (parser-node (.owner-nid ref))))
      0))

;; Final Simple parseTrinary keeps the predicate, constructs both control projections, duplicates
;; Scope before either arm, retains arm values, then merges full Scopes and makes a Region Phi.
;; JavaScript differs in its result: && returns the original falsy operand, not Simple's zero.
;; || also retains its original truthy operand; ?? tests nullishness, not truthiness. Keep the
;; original value across both arm constructions, and merge memory so skipped RHS effects stay
;; skipped even after inlining, scheduling and GC lowering. There is no eager semantic call for
;; the operator itself: the predicate alone calls JSL, and the RHS lives on exactly one edge.
;; Logical assignment is the same diamond with PutValue on that same RHS edge.
(defn lower-short-circuit-core [(left (dyn NodeOps))
                                (predicate-name (slice u8))
                                (rhs-on-true bool)
                                (right-id i64)
                                (assign bool)
                                (ref SyntaxRef)] (-> (dyn NodeOps))
  (do
    (n-keep! left)
    (let [predicate (lower-js-unary left predicate-name)
          arms
            (if-arms! (if-make (parser-node (.current-ctrl (parser-state)))
                               predicate))
          rhs-scope (parser-node (.current-scope (parser-state)))
          skipped-scope (scope-dup rhs-scope false)]
      (parser-set-current-ctrl! (if rhs-on-true
                                    (arms-true arms)
                                    (arms-false arms)))
      (scope-set-ctrl! skipped-scope
                       (if rhs-on-true (arms-false arms) (arms-true arms)))
      (let [right (lower-syntax-expr right-id)]
        (n-keep! right)
        (if assign (lower-ref-put! ref right) 0)
        (let [merged
                (scope-merge! (parser-node (.current-scope (parser-state)))
                              skipped-scope)
              region (scope-ctrl merged)
              phi (phi-make region (ty-dyn TAG-ANY) "short-circuit")]
          (phi-add-value! phi right)
          (phi-add-value! phi left)
          (set! (.current-scope (parser-state)) (n-nid merged))
          (set! (.current-ctrl (parser-state)) (n-nid region))
          (n-unkeep! right)
          (n-unkeep! left)
          phi)))))

(defn lower-short-circuit [(left-id i64)
                           (right-id i64)
                           (predicate-name (slice u8))
                           (rhs-on-true bool)] (-> (dyn NodeOps))
  (lower-short-circuit-core (lower-syntax-expr left-id)
                            predicate-name
                            rhs-on-true
                            right-id
                            false
                            (primitive/zeroed SyntaxRef)))

(defn lower-logical-assignment [(predicate-name (slice u8))
                                (rhs-on-true bool)
                                (target i64)
                                (value i64)] (-> (dyn NodeOps))
  (let [ref (lower-ref-prepare! target)
        result
          (lower-short-circuit-core (lower-ref-get! ref)
                                    predicate-name
                                    rhs-on-true
                                    value
                                    true
                                    ref)]
    (lower-ref-release! ref)
    result))

(defn lower-singleton [(name (slice u8))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        args (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
        result
          (jsl-lower-macro-values name
                                  args
                                  (scope-ctrl scope)
                                  (scope-mem scope))]
    (parser-set-current-ctrl! (.ctrl result))
    (scope-set-mem! scope (.mem result))
    (.value result)))

;; OrdinaryObjectCreate(%Object.prototype%) for a literal or a function's `prototype` object: the
;; raw object with %Object.prototype% as its [[Prototype]] when the realm materialized `Object`
;; (docs/DECISIONS.md, function objects), else the raw object whose prototype stays null.
(defn lower-fresh-ordinary-object [] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        raw (lower-jsl-nullary "JsNewObjectRaw")]
    (if (>= (heap-intrinsic-entry "Object.prototype") 0)
        (let [(mut sargs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
          (n-keep! raw)
          (push! [(dyn NodeOps)] (mut sargs) raw)
          (push! [(dyn NodeOps)] (mut sargs) (box-make (staticref-make (heap-intrinsic-entry "Object.prototype") REP-OBJECT)))
          (let [linked (jsl-lower-macro-values "JsSetObjectLiteralPrototype" (load sargs) (parser-node (.current-ctrl (parser-state))) (scope-mem scope))]
            (al-free! [(dyn NodeOps)] (mut sargs))
            (parser-set-current-ctrl! (.ctrl linked))
            (scope-set-mem! scope (.mem linked))
            (n-unkeep! raw)
            (.value linked)))
        raw)))

(defn lower-object-literal [(entries (ArrayList ObjectEntry))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        created (lower-fresh-ordinary-object)
        (mut object-nid) (n-nid created)]
    (al-for [entry entries]
            (match entry
              (PropValue [prop-key value-id]
                         (let [key
                                 (match prop-key
                                   (KeyNamed [k] k)
                                   (KeyComputed [e]
                                                (do
                                                  (unimplemented "computed property keys"
                                                                 "docs/GAPS.md — property keys")
                                                  0)))
                               value (lower-syntax-expr value-id)
                               (mut args)
                                 (al-new [(dyn NodeOps)]
                                         (alloc/malloc-allocator))]
                           (push! [(dyn NodeOps)]
                                  (mut args)
                                  (match (arena-node (load object-nid))
                                    (Some [n] n)
                                    (None [] (unreachable-node))))
                           (if (= (shape-key-name key) "__proto__")
                               0
                               (push! [(dyn NodeOps)] (mut args) (con-int key)))
                           (push! [(dyn NodeOps)] (mut args) value)
                           (let [defined
                                   (jsl-lower-macro-values (if (= (shape-key-name key)
                                                                  "__proto__")
                                                               "JsSetObjectLiteralPrototype"
                                                               "JsCreateDataPropertyNamed")
                                                           (load args)
                                                           (parser-node (.current-ctrl (parser-state)))
                                                           (scope-mem scope))]
                             (set! (mut object-nid) (n-nid (.value defined)))
                             (parser-set-current-ctrl! (.ctrl defined))
                             (scope-set-mem! scope (.mem defined)))
                           (al-free! [(dyn NodeOps)] (mut args))
                           0))
              (PropMethod [key fun]
                          (unimplemented "object methods and accessors"
                                         "docs/GAPS.md — function objects"))
              (PropSpread [expr]
                          (unimplemented "object spread"
                                         "docs/GAPS.md — property enumeration"))
              (PropCoverInit [name init]
                             (broken "lower-object-literal: CoverInitializedName survived validation"))))
    (let [(mut finish-args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
      (push! [(dyn NodeOps)]
             (mut finish-args)
             (match (arena-node (load object-nid))
               (Some [n] n)
               (None [] (unreachable-node))))
      (let [finished
              (jsl-lower-macro-values "JsFinishObjectLiteral"
                                      (load finish-args)
                                      (parser-node (.current-ctrl (parser-state)))
                                      (scope-mem scope))]
        (.value finished)))))

;; ArrayLiteral (ECMA-262 §13.2.4.2): ArrayCreate(0), then each element is CreateDataProperty at the
;; next index and each elision advances the length; the JSL (`jsl/compiler/array.jsl`) owns every
;; step. Spread refuses by name until iteration exists.
(defn lower-array-literal [(elements (ArrayList ArrayElement))] (-> (dyn NodeOps))
  (let [(mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
    (push! [(dyn NodeOps)] (mut args) (con-int 0))
    (let [scope (parser-node (.current-scope (parser-state)))
          created (jsl-lower-macro-values "JsNewArray" (load args) (parser-node (.current-ctrl (parser-state))) (scope-mem scope))
          (mut array-nid) (n-nid (.value created))
          (mut index) 0]
      (al-free! [(dyn NodeOps)] (mut args))
      (parser-set-current-ctrl! (.ctrl created))
      (scope-set-mem! scope (.mem created))
      (al-for [element elements]
              (do
                (match element
                  (ElemHole []
                            (let [(mut hargs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
                                  scope2 (parser-node (.current-scope (parser-state)))]
                              (push! [(dyn NodeOps)] (mut hargs) (parser-node (load array-nid)))
                              (let [r (jsl-lower-macro-values "JsArrayLiteralHole" (load hargs) (parser-node (.current-ctrl (parser-state))) (scope-mem scope2))]
                                (al-free! [(dyn NodeOps)] (mut hargs))
                                (parser-set-current-ctrl! (.ctrl r))
                                (scope-set-mem! scope2 (.mem r))
                                (set! (mut array-nid) (n-nid (.value r))))))
                  (ElemExpr [expr]
                            (let [array (parser-node (load array-nid))]
                              (n-keep! array)
                              (let [value (lower-syntax-expr expr)
                                    (mut eargs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
                                    scope2 (parser-node (.current-scope (parser-state)))]
                                (n-keep! value)
                                (push! [(dyn NodeOps)] (mut eargs) array)
                                (push! [(dyn NodeOps)] (mut eargs) (con-int (load index)))
                                (push! [(dyn NodeOps)] (mut eargs) value)
                                (let [r (jsl-lower-macro-values "JsArrayLiteralElement" (load eargs) (parser-node (.current-ctrl (parser-state))) (scope-mem scope2))]
                                  (al-free! [(dyn NodeOps)] (mut eargs))
                                  (parser-set-current-ctrl! (.ctrl r))
                                  (scope-set-mem! scope2 (.mem r))
                                  (n-unkeep! value)
                                  (n-unkeep! array)
                                  (set! (mut array-nid) (n-nid (.value r)))))))
                  (ElemSpread [expr]
                              (do
                                (unimplemented "spread in an array literal (iteration)" "docs/GAPS.md — arrays")
                                0)))
                (set! (mut index) (+ (load index) 1))
                0))
      (parser-node (load array-nid)))))

;; Simple parseAddition/parseMultiplication attach the left operand to a new node before parsing
;; the right operand. Here JSL builds the operation after both values exist, so keep the left across
;; RHS Scope updates that could remove its last environment use; a local handle is insufficient.
(defn lower-syntax-binary [(left-id i64) (right-id i64) (name (slice u8))] (-> (dyn NodeOps))
  (do
    (lower-require-jsl! name)
    (let [left (lower-syntax-expr left-id)]
      (n-keep! left)
      (let [right (lower-syntax-expr right-id)
            result (lower-js-binary left right name)]
        (n-unkeep! left)
        ;; `instanceof` throws a TypeError for a non-callable right operand: its result is a
        ;; completion (nothing to test when the operand's type proved a function).
        (if (= name "JsInstanceof")
            (lower-completion! result)
            result)))))

(defn lower-conditional [(condition-id i64) (yes-id i64) (no-id i64)] (-> (dyn NodeOps))
  (let [condition (lower-js-truthy (lower-syntax-expr condition-id))
        iff (if-make (parser-node (.current-ctrl (parser-state))) condition)
        arms (if-arms! iff)
        true-scope (parser-node (.current-scope (parser-state)))
        false-scope (scope-dup true-scope false)]
    ;; A conditional expression is the same full Scope diamond as a statement `if`: calls in
    ;; either arm advance memory independently, so joining only control and the selected value
    ;; would let the following expression observe whichever arm happened to lower last.
    (scope-set-ctrl! true-scope (arms-true arms))
    (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
    (let [yes (lower-syntax-expr yes-id)
          yes-scope (parser-node (.current-scope (parser-state)))]
      ;; The true value is not an environment slot, so hold it while the false arm is lowered.
      ;; The true Scope owns its control and memory.
      (n-keep! yes)
      (set! (.current-scope (parser-state)) (n-nid false-scope))
      (scope-set-ctrl! false-scope (arms-false arms))
      (set! (.current-ctrl (parser-state)) (n-nid (arms-false arms)))
      (let [no (lower-syntax-expr no-id)]
        (n-keep! no)
        (let [merged (scope-merge! yes-scope false-scope)
              region (scope-ctrl merged)
              phi (phi-make region (ty-meet (n-ty yes) (n-ty no)) "conditional")]
          (phi-add-value! phi yes)
          (phi-add-value! phi no)
          (set! (.current-scope (parser-state)) (n-nid merged))
          (set! (.current-ctrl (parser-state)) (n-nid region))
          (n-unkeep! yes)
          (n-unkeep! no)
          phi)))))

;; A function object: an ordinary object's two words, the raw code word and a boxed environment
;; (null until closures exist), boxed under the FUNCTION prefix, with its fresh `prototype`
;; object (MakeConstructor). A hoisted declaration's object exists once per program run and lives
;; in the static heap image (`realm-image-build!`); every other function form allocates one per
;; evaluation, as the specification's InstantiateOrdinaryFunctionExpression does.
(defn lower-function-object [(fun-index i64)] (-> (dyn NodeOps))
  (let [f (syntax-fun-at fun-index)]
    (if (>= (.static-entry f) 0)
        (box-make (staticref-make (.static-entry f) REP-FUNCTION))
    (if (not (syntax-fun-lowered? fun-index))
        (do (unimplemented "methods, accessors, generators and async functions as values"
                           "docs/GAPS.md — function values and closures")
            (unreachable-node))
        (let [scope (parser-node (.current-scope (parser-state)))
              ctrl (parser-node (.current-ctrl (parser-state)))
              mem (scope-mem scope)
              target (parser-node (.fun-nid f))
              fp (syntax-fun-ptr fun-index)
              fresh (new-make ctrl (con-int FUNCTION-PAYLOAD-BYTES) mem SHAPE-EMPTY
                              (ty-struct "JsFunctionPayload"))
              ptr_ (proj-make fresh 0 "function.ptr")
              private (proj-make fresh 1 "function.private-memory")
              null-value (dyn-null-make)
              ;; [[Prototype]] is %Function.prototype% when the realm materialized `Function`.
              function-proto (if (>= (heap-intrinsic-entry "Function.prototype") 0)
                                 (box-make (staticref-make (heap-intrinsic-entry "Function.prototype") REP-OBJECT))
                                 (dyn-null-make))
              prototype-state (store-make ctrl private ptr_ (con-int OFFSET-OBJECT-PROTOTYPE) function-proto
                                          ALIAS-OBJECT-PROTOTYPE (ty-dyn TAG-ANY))
              properties-state (store-make ctrl prototype-state ptr_ (con-int OFFSET-OBJECT-PROPERTIES)
                                           null-value ALIAS-OBJECT-PROPERTIES (ty-dyn TAG-ANY))
              code-state (store-make ctrl properties-state ptr_ (con-int OFFSET-FUNCTION-CODE)
                                     (funptr-make target (.fidx f))
                                     ALIAS-FUNCTION-CODE (parser-value-funptr-ty))
              env-state (store-make ctrl code-state ptr_ (con-int OFFSET-FUNCTION-ENV) null-value
                                    ALIAS-FUNCTION-ENV (ty-dyn TAG-ANY))
              merged (memmerge-make)]
          (memmerge-set-alias! merged ALIAS-BULK mem)
          (memmerge-set-alias! merged ALIAS-OBJECT-PROTOTYPE prototype-state)
          (memmerge-set-alias! merged ALIAS-OBJECT-PROPERTIES properties-state)
          (memmerge-set-alias! merged ALIAS-FUNCTION-CODE code-state)
          (memmerge-set-alias! merged ALIAS-FUNCTION-ENV env-state)
          ;; The pointer now escapes into a value: the Fun is never inlined away from under its
          ;; address. Callers stay closed-world: every value call site links the finite set, so
          ;; parameter evidence still comes from actual arguments.
          (set! (.value-taken fp) true)
          (fun-set-escapes! target)
          (scope-set-mem! scope merged)
          ;; MakeConstructor: every ordinary function object owns a fresh `prototype` object whose
          ;; `constructor` is the function.
          (let [fnobj (box-make-rep-at (Some ctrl) ptr_ REP-FUNCTION)]
            (n-keep! fnobj)
            (let [proto-raw (lower-fresh-ordinary-object)
                  (mut cargs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
              (n-keep! proto-raw)
              (push! [(dyn NodeOps)] (mut cargs) proto-raw)
              (push! [(dyn NodeOps)] (mut cargs) (con-int (shape-key-intern "constructor")))
              (push! [(dyn NodeOps)] (mut cargs) fnobj)
              (let [scope2 (parser-node (.current-scope (parser-state)))
                    defined (jsl-lower-macro-values "JsCreateDataPropertyNamed" (load cargs) (parser-node (.current-ctrl (parser-state))) (scope-mem scope2))]
                (al-free! [(dyn NodeOps)] (mut cargs))
                (parser-set-current-ctrl! (.ctrl defined))
                (scope-set-mem! scope2 (.mem defined))
                (let [proto (lower-jsl-unary-value "JsFinishObjectLiteral" (.value defined))
                      (mut pargs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
                  (n-keep! proto)
                  (push! [(dyn NodeOps)] (mut pargs) fnobj)
                  (push! [(dyn NodeOps)] (mut pargs) (con-int (shape-key-intern "prototype")))
                  (push! [(dyn NodeOps)] (mut pargs) proto)
                  (let [scope3 (parser-node (.current-scope (parser-state)))
                        stored (jsl-lower-macro-values "JsDefineOwnNamed" (load pargs) (parser-node (.current-ctrl (parser-state))) (scope-mem scope3))]
                    (al-free! [(dyn NodeOps)] (mut pargs))
                    (parser-set-current-ctrl! (.ctrl stored))
                    (scope-set-mem! scope3 (.mem stored))
                    (n-unkeep! proto)
                    (n-unkeep! proto-raw)
                    (n-unkeep! fnobj)
                    fnobj))))))))))

;; Call through a value. The callee and every actual are evaluated first, as the specification
;; orders them; then a FUNCTION guard either loads the code word and calls through the shared
;; ABI or hands the value to the runtime's abrupt-completion entry (a TypeError once exceptions
;; exist). Both arms merge as an ordinary Scope diamond.
;; ---------------------------------------------------------------------------
;; Exceptions: a sentinel completion and ordinary control flow (docs/DECISIONS.md, exceptions are
;; a sentinel completion)

;; The innermost catch target, or -1 when a throw leaves the function.
(defn parser-find-catch [] (-> i64)
  (let [p (parser-state)
        (mut i) (- (len (.jump-targets p)) 1)
        (mut found) -1]
    (loop (if (or (< (load i) 0) (>= (load found) 0))
              (break 0)
              (let [target (get (.jump-targets p) (load i))]
                (if (= (.kind target) JUMP-CATCH) (set! (mut found) (load i)) (set! (mut i) (- (load i) 1)))
                (continue))))
    (load found)))

;; Carry `value` to the catch target `index`: bind the synthetic exception variable, then take the
;; same Scope-merging jump a `break` takes to a labeled block.
(defn lower-jump-to-catch! [(index i64) (value (dyn NodeOps))] (-> i64)
  (lower-jump-to-target! index (Some value)))

;; The nearest enclosing finally target, or -1.
(defn parser-find-finally [] (-> i64)
  (let [p (parser-state)
        (mut i) (- (len (.jump-targets p)) 1)
        (mut found) -1]
    (loop (if (or (< (load i) 0) (>= (load found) 0))
              (break 0)
              (let [target (get (.jump-targets p) (load i))]
                (if (= (.kind target) JUMP-FINALLY) (set! (mut found) (load i)) (set! (mut i) (- (load i) 1)))
                (continue))))
    (load found)))

;; `return v`, or the propagation of an uncaught exception: inside a try with a finally block the
;; completion is recorded in the finally's variables and control jumps to the block; otherwise it
;; is the function's Return.
(defn lower-return-completion! [(value (dyn NodeOps))] (-> i64)
  (let [index (parser-find-finally)]
    (if (>= index 0)
        (let [scope (parser-node (.current-scope (parser-state)))]
          (n-keep! value)
          (parser-note-completion! index COMPLETION-RETURN)
          (scope-update! scope FINALLY-KIND-VAR (con-int COMPLETION-RETURN))
          (scope-update! scope FINALLY-VALUE-VAR value)
          (lower-jump-to-target! index (None [(dyn NodeOps)]))
          (n-unkeep! value)
          0)
        (parser-record-return! value))))

;; A thrown value leaving the current point (docs/DECISIONS.md, exceptions are a sentinel
;; completion): to the nearest try as a Scope jump (its catch, or its finally as a throw
;; completion); with no try around it, into the pending word, and the function completes with the
;; exception sentinel, which every caller tests.
(defn lower-throw-value! [(value (dyn NodeOps))] (-> i64)
  (let [catch-index (parser-find-catch)
        finally-index (parser-find-finally)]
    (n-keep! value)
    (if (>= catch-index 0)
        (lower-jump-to-catch! catch-index value)
        (if (>= finally-index 0)
            (let [scope (parser-node (.current-scope (parser-state)))]
              (parser-note-completion! finally-index COMPLETION-THROW)
              (scope-update! scope FINALLY-KIND-VAR (con-int COMPLETION-THROW))
              (scope-update! scope FINALLY-VALUE-VAR value)
              (lower-jump-to-target! finally-index (None [(dyn NodeOps)])))
            (do
              (lower-pending-store! value)
              (parser-note-propagation!)
              (parser-record-return! (dyn-exception-make)))))
    (n-unkeep! value)
    0))

;; The function being lowered can complete with the sentinel. The syntactic filter must have said
;; so, or a direct caller was built without its test (`syntax-fun-may-throw?`).
(defn parser-note-propagation! [] (-> i64)
  (do (set! (.propagates (parser-state)) true) 0))

;; Take the Scope-merging jump a `break` takes to target `index`, binding the synthetic exception
;; variable first when a value is carried.
(defn lower-jump-to-target! [(index i64) (value (Option (dyn NodeOps)))] (-> i64)
  (let [p (parser-state)
        scope (parser-node (.current-scope p))
        target (get (.jump-targets p) index)
        exit (parser-node (.scope target))
        outgoing (scope-dup scope false)
        depth (len (.levels (scope-node exit)))]
    (parser-set-current-ctrl! (xctrl-make))
    (loop (if (<= (len (.levels (scope-node outgoing))) depth)
              (break 0)
              (do (scope-pop! outgoing) (continue))))
    ;; Bind the carried value AFTER unwinding to the target's depth: a nested try's own level holds
    ;; another binding of the same synthetic name, and updating before the pops filled that one.
    (match value (Some [v] (scope-update! outgoing EXCEPTION-VAR v)) (None [] 0))
    (scope-merge! exit outgoing)
    (let [meta (al-elem [JumpTarget] (mut (.jump-targets p)) index)]
      (set! (.count meta) (+ (.count meta) 1)))
    0))

;; The pending word of the runtime heap record: the thrown value while a throw unwinds.
(defn lower-pending-store! [(value (dyn NodeOps))] (-> i64)
  (let [p (parser-state)
        scope (parser-node (.current-scope p))
        mem (scope-mem scope)
        stored (store-make (parser-node (.current-ctrl p)) mem (heapstate-make) (con-int RT-HEAP-OFFSET-EXCEPTION-VALUE) value ALIAS-EXCEPTION-VALUE (ty-dyn TAG-ANY))
        merged (memmerge-make)]
    (memmerge-set-alias! merged ALIAS-BULK (mem-effective mem ALIAS-BULK))
    (if (= (n-op mem) OP-MEMMERGE)
        (let [(mut a) 2]
          (loop (if (>= (load a) (n-nins mem))
                    (break 0)
                    (do
                      (match (n-in mem (load a))
                        (Some [slice] (if (= (load a) ALIAS-EXCEPTION-VALUE) 0 (memmerge-set-alias! merged (load a) slice)))
                        (None [] 0))
                      (set! (mut a) (+ (load a) 1))
                      (continue)))))
        0)
    (memmerge-set-alias! merged ALIAS-EXCEPTION-VALUE stored)
    (scope-set-mem! scope merged)
    0))

(defn lower-pending-load [] (-> (dyn NodeOps))
  (let [p (parser-state)
        scope (parser-node (.current-scope p))]
    (load-make (parser-node (.current-ctrl p)) (scope-mem scope) (heapstate-make) (con-int RT-HEAP-OFFSET-EXCEPTION-VALUE) ALIAS-EXCEPTION-VALUE (ty-dyn TAG-ANY))))

;; `throw v`: inside a try, a jump to its catch; otherwise set the pending word and leave the
;; function with undefined.
(defn lower-throw [(value-id i64)] (-> i64)
  (do
    (lower-throw-value! (lower-syntax-expr value-id))
    1))

;; After a call or operation whose result may be the exception sentinel: one TypeTest on the
;; result. On the exceptional arm the thrown value leaves the pending word (cleared) for the
;; enclosing try, or the function completes with the sentinel itself; the normal arm continues
;; with the result narrowed to a JavaScript value. The arm ends dead, so the merge keeps only the
;; normal continuation. Where the result's type already excludes the sentinel there is nothing to
;; test, and every call and throwing operation is asked: SCCP is the may-throw analysis. (A
;; syntactic may-throw fixpoint used to decide which calls were asked; it missed operators that
;; throw, and a missed site let the sentinel escape as a value. Nothing decides but the type.)
(defn lower-exception-check! [(value (dyn NodeOps))] (-> (dyn NodeOps))
  (let [p (parser-state)
        t (n-ty value)
        tags (match (ty-kind t) (TDyn [bits high] (if high TAG-COMPLETION bits)) (_ TAG-COMPLETION))]
    (if (= (primitive/iand tags TAG-EXCEPTION) 0)
        value
        (let [iff (if-make (parser-node (.current-ctrl p)) (typetest-make value TAG-EXCEPTION))
              arms (if-arms! iff)
              normal (parser-node (.current-scope p))
              unwinding (scope-dup normal false)]
          (n-keep! value)
          (set! (.current-scope p) (n-nid unwinding))
          (scope-set-ctrl! unwinding (arms-true arms))
          (set! (.current-ctrl p) (n-nid (arms-true arms)))
          (if (or (>= (parser-find-catch) 0) (>= (parser-find-finally) 0))
              (let [thrown (lower-pending-load)]
                (n-keep! thrown)
                (lower-pending-store! (con-int 0))
                (lower-throw-value! thrown)
                (n-unkeep! thrown))
              (do
                (parser-note-propagation!)
                (parser-record-return! (dyn-exception-make))))
          (let [taken (parser-node (.current-scope p))
                narrowed (cast-make (arms-false arms) value (ty-dyn (primitive/iand tags (primitive/ixor TAG-COMPLETION TAG-EXCEPTION))))]
            (n-keep! narrowed)
            (scope-set-ctrl! normal (arms-false arms))
            (let [merged (scope-merge! normal taken)]
              (set! (.current-scope p) (n-nid merged))
              (set! (.current-ctrl p) (n-nid (scope-ctrl merged)))
              (n-unkeep! narrowed)
              (n-unkeep! value)
              narrowed))))))

;; `try { body } catch (e) { handler } finally { tail }`. The catch target is a Scope with the
;; synthetic exception variable; every throw and unwinding call in the body merges into it. The
;; handler binds `e` from that variable in its own level. `finally` runs after the normal merge;
;; an abrupt completion crossing it refuses by name.
(defn lower-try [(body i64) (catch-param (Option i64)) (catch-body (Option i64)) (finally-body (Option i64))] (-> i64)
  (let [p (parser-state)
        scope (parser-node (.current-scope p))
        has-finally (match finally-body (Some [_] true) (None [] false))]
    (scope-push! scope)
    (scope-define! scope EXCEPTION-VAR (ty-dyn TAG-ANY) false (dyn-undefined-make))
    ;; With a finally block, every abrupt completion of the body or handler records its kind and
    ;; value here and jumps to the block; the normal path arrives with kind 0.
    (if has-finally
        (do
          (scope-define! scope FINALLY-KIND-VAR (ty-int-bot) false (con-int COMPLETION-NORMAL))
          (scope-define! scope FINALLY-VALUE-VAR (ty-dyn TAG-ANY) false (dyn-undefined-make))
          (let [fin-exit (scope-dup scope false)]
            (scope-set-ctrl! fin-exit (xctrl-make))
            (parser-push-jump! fin-exit JUMP-FINALLY)))
        0)
    (let [exit (scope-dup (parser-node (.current-scope p)) false)]
      (scope-set-ctrl! exit (xctrl-make))
      (parser-push-jump! exit JUMP-CATCH)
      (let [terminated (lower-syntax-statement body)
            target (parser-pop-jump!)
            after-body (parser-node (.current-scope p))]
        (match catch-body
          (None []
                ;; No catch: a throw out of the body runs the finally block with a throw completion.
                (if (> (.count target) 0)
                    (if has-finally
                        (do (lower-throw-completion-into-finally! exit) (parser-use-scope! after-body))
                        (unimplemented "try/finally without catch (rethrow through finally)" "docs/GAPS.md — exceptions"))
                    0))
          (Some [handler]
                (do
                  ;; The handler runs in the merged throw Scope with `e` bound in a fresh level. With a
                  ;; finally block its own throws land in a second catch target that feeds the block.
                  (parser-use-scope! exit)
                  (scope-push! exit)
                  (match catch-param
                    (Some [pattern]
                          (match (syntax-pattern-node pattern)
                            (PatName [name]
                                     (scope-define! (parser-node (.current-scope p))
                                                    name
                                                    (ty-dyn TAG-ANY)
                                                    false
                                                    (match (scope-lookup (parser-node (.current-scope p)) EXCEPTION-VAR)
                                                      (Some [thrown] thrown)
                                                      (None [] (unreachable-node)))))
                            (_ (unimplemented "destructuring catch parameter" "docs/GAPS.md — destructuring"))))
                    (None [] 0))
                  (let [rethrow (scope-dup (parser-node (.current-scope p)) false)]
                    (scope-set-ctrl! rethrow (xctrl-make))
                    (if has-finally (parser-push-jump! rethrow JUMP-CATCH) 0)
                    (lower-syntax-statement handler)
                    (if has-finally
                        (let [rethrow-target (parser-pop-jump!)
                              handler-scope (parser-node (.current-scope p))]
                          (if (> (.count rethrow-target) 0)
                              (do
                                (scope-pop! rethrow)
                                (lower-throw-completion-into-finally! rethrow))
                              0)
                          (parser-use-scope! handler-scope))
                        0))
                  (scope-pop! (parser-node (.current-scope p)))
                  (let [merged (scope-merge! after-body (parser-node (.current-scope p)))]
                    (parser-use-scope! merged)))))
        (match finally-body
          (Some [tail]
                (let [fin-target (parser-pop-jump!)
                      normal (parser-node (.current-scope p))]
                  (if (!= (.kind fin-target) JUMP-FINALLY)
                      (broken "lower-try: the finally target is not on top of the jump stack")
                      0)
                  ;; Every completion meets here: the normal path (kind 0), returns (kind 1) and
                  ;; throws (kind 2). The block runs once over the merge, then the completion resumes.
                  (parser-use-scope! (scope-merge! normal (parser-node (.scope fin-target))))
                  (lower-syntax-statement tail)
                  (lower-finally-dispatch! fin-target)
                  0))
          (None [] 0))
        (scope-pop! (parser-node (.current-scope p)))
        (if (and (!= terminated 0) (= (.count target) 0) (not has-finally)) 1 0)))))

;; Arrivals at a catch-like target that has no handler of its own (a try/finally without catch,
;; or a throw inside the handler) continue as a throw completion into the finally block.
(defn lower-throw-completion-into-finally! [(arrivals (dyn NodeOps))] (-> i64)
  (let [p (parser-state)
        index (parser-find-finally)]
    (parser-use-scope! arrivals)
    (let [thrown (match (scope-lookup arrivals EXCEPTION-VAR) (Some [v] v) (None [] (unreachable-node)))]
      (n-keep! thrown)
      (parser-note-completion! index COMPLETION-THROW)
      (scope-update! arrivals FINALLY-KIND-VAR (con-int COMPLETION-THROW))
      (scope-update! arrivals FINALLY-VALUE-VAR thrown)
      (lower-jump-to-target! index (None [(dyn NodeOps)]))
      (n-unkeep! thrown)
      0)))

;; After the finally block: resume the recorded completion. Each arm is a Scope diamond whose taken
;; side ends dead (a return or a throw severs control), so the merge keeps only the normal path.
;; Only the kinds some path recorded into this target get an arm: a block nothing throws into has
;; no throw arm, so it emits no propagation path (and the may-throw filter's guard stays honest).
(defn lower-finally-dispatch! [(target JumpTarget)] (-> i64)
  (do
    (if (!= (primitive/iand (.completions target) (primitive/ishl 1 COMPLETION-RETURN)) 0)
        (lower-completion-arm! COMPLETION-RETURN)
        0)
    (if (!= (primitive/iand (.completions target) (primitive/ishl 1 COMPLETION-THROW)) 0)
        (lower-completion-arm! COMPLETION-THROW)
        0)
    0))

;; A completion of `kind` is recorded into the finally target `index`.
(defn parser-note-completion! [(index i64) (kind i64)] (-> i64)
  (let [meta (al-elem [JumpTarget] (mut (.jump-targets (parser-state))) index)]
    (set! (.completions meta) (primitive/ior (.completions meta) (primitive/ishl 1 kind)))
    0))

(defn lower-completion-arm! [(kind i64)] (-> i64)
  (let [p (parser-state)
        normal (parser-node (.current-scope p))
        kind-value (match (scope-lookup normal FINALLY-KIND-VAR) (Some [v] v) (None [] (unreachable-node)))
        iff (if-make (parser-node (.current-ctrl p)) (eq-make kind-value (con-int kind)))
        arms (if-arms! iff)
        taken (scope-dup normal false)]
    (set! (.current-scope p) (n-nid taken))
    (scope-set-ctrl! taken (arms-true arms))
    (set! (.current-ctrl p) (n-nid (arms-true arms)))
    (let [value (match (scope-lookup taken FINALLY-VALUE-VAR) (Some [v] v) (None [] (unreachable-node)))]
      (if (= kind COMPLETION-RETURN)
          (lower-return-completion! value)
          (lower-throw-value! value)))
    (let [ended (parser-node (.current-scope p))]
      (scope-set-ctrl! normal (arms-false arms))
      (let [merged (scope-merge! normal ended)]
        (set! (.current-scope p) (n-nid merged))
        (set! (.current-ctrl p) (n-nid (scope-ctrl merged)))
        0))))

;; A call through a value with `this` = undefined: a plain `f(...)`.
(defn lower-value-call [(callee (dyn NodeOps)) (args (ArrayList i64)) (label (slice u8))] (-> (dyn NodeOps))
  (lower-value-call-with-receiver callee (dyn-undefined-make) (dyn-undefined-make) args
                                  (lower-callee-message label " is not a function")))

;; The TypeError message for a call through a non-callable: the callee as the source spelled it
;; (`f`, `o.m`, `this.x`, `a[…]`), as engines report it, so a failing program names its callee.
(defn lower-callee-message [(label (slice u8)) (suffix (slice u8))] (-> (slice u8))
  (let [(mut sb) (sb-new (alloc/malloc-allocator))]
    (sb-push-str! (mut sb) label)
    (sb-push-str! (mut sb) suffix)
    (sb-str (mut sb))))

;; A callee expression's spelling for that message. Only the shapes a message can name usefully
;; are spelled; anything else is `value`.
(defn syntax-callee-label [(id i64)] (-> (slice u8))
  (match (syntax-node (syntax-ungroup-id id))
    (SxName [name] name)
    (SxThis [] "this")
    (SxMember [owner name optional] (lower-callee-message (lower-callee-message (syntax-callee-label owner) ".") name))
    (SxIndex [owner key optional] (lower-callee-message (syntax-callee-label owner) "[...]"))
    (SxCall [callee args optional] (lower-callee-message (syntax-callee-label callee) "(...)"))
    (_ "value")))

;; A call through a value. `receiver` becomes the callee's `this` slot; sloppy functions map an
;; undefined receiver to the global object at their entry (JsSloppyThis). `new-target` is the
;; callee's `new.target` slot: undefined for a call, the constructor for `new` (lower-new).
;; `message` is the TypeError's text when the callee is not callable.
(defn lower-value-call-with-receiver [(callee (dyn NodeOps)) (receiver (dyn NodeOps)) (new-target (dyn NodeOps)) (args (ArrayList i64)) (message (slice u8))] (-> (dyn NodeOps))
  (let [slots (parser-abi-slots)
        (mut actuals) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
    (n-keep! callee)
    (n-keep! receiver)
    (n-keep! new-target)
    (al-for [a args]
            (let [v (lower-syntax-expr a)]
              (n-keep! v)
              (push! [(dyn NodeOps)] (mut actuals) v)))
    (let [scope (parser-node (.current-scope (parser-state)))
          g (guard! (parser-node (.current-ctrl (parser-state))) callee TAG-FUNCTION)
          false-scope (scope-dup scope false)]
      (parser-set-current-ctrl! (guard-true g))
      ;; `if-arms!` peepholes both arms: a provably callable callee folds the true arm into the
      ;; incoming control, so re-read the current control instead of holding the projection.
      (let [true-ctrl (parser-node (.current-ctrl (parser-state)))
            mem (scope-mem scope)
            raw (unbox-make (guard-narrowed g) REP-FUNCTION)
            code (load-make true-ctrl mem raw (con-int OFFSET-FUNCTION-CODE)
                            ALIAS-FUNCTION-CODE (parser-value-funptr-ty))
            c (call-make-with-mem true-ctrl mem)
            (mut i) 0]
        (call-add-arg! c receiver)
        (call-add-arg! c new-target)
        (loop (if (>= (load i) slots)
                  (break 0)
                  (do
                    (call-add-arg! c (if (< (load i) (len (load actuals)))
                                         (get (load actuals) (load i))
                                         (dyn-undefined-make)))
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (call-set-fptr! c code)
        (let [end (callend-make c)
              value (proj-make end RETURN-VALUE "value-call.value")]
          (n-keep! value)
          (parser-set-current-ctrl! (cproj-make end RETURN-CTRL "value-call.ctrl"))
          (scope-set-mem! scope (proj-make end RETURN-MEM "value-call.mem"))
          ;; The callee's completion: an exception it did not catch unwinds here.
          (let [checked (lower-exception-check! value)
                called-scope (parser-node (.current-scope (parser-state)))]
            (n-keep! checked)
            (set! (.current-scope (parser-state)) (n-nid false-scope))
            (parser-set-current-ctrl! (guard-false g))
            ;; Not callable: a TypeError, which unwinds this arm.
            (lower-throw-type-error! message)
            (let [merged (scope-merge! called-scope (parser-node (.current-scope (parser-state))))
                  region (scope-ctrl merged)
                  phi (phi-make region (ty-dyn TAG-ANY) "value-call")]
              (phi-add-value! phi checked)
              (phi-add-value! phi (dyn-undefined-make))
              (set! (.current-scope (parser-state)) (n-nid merged))
              (set! (.current-ctrl (parser-state)) (n-nid region))
              (n-unkeep! checked)
              (n-unkeep! value)
              (al-for [v (load actuals)] (n-unkeep! v))
              (n-unkeep! new-target)
              (n-unkeep! receiver)
              (n-unkeep! callee)
              (al-free! [(dyn NodeOps)] (mut actuals))
              phi)))))))

;; The completion of a JSL operation that may throw (a property access on undefined or null is a
;; TypeError raised inside JsGetNamed): tested for the sentinel, which is nothing when the operand
;; types already folded the throwing arm away.
(defn lower-completion! [(result (dyn NodeOps))] (-> (dyn NodeOps))
  (lower-exception-check! result))

;; The language raising a TypeError at a source site: JsThrowTypeError with the message returns
;; the sentinel, and the check unwinds it at once.
(defn lower-throw-type-error! [(message (slice u8))] (-> i64)
  (let [(mut values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
        text (lower-ascii-string message)]
    (n-keep! text)
    (push! [(dyn NodeOps)] (mut values) text)
    (let [scope (parser-node (.current-scope (parser-state)))
          r (lower-jsl-call-values "JsThrowTypeError" (load values))]
      (n-unkeep! text)
      (al-free! [(dyn NodeOps)] (mut values))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (lower-exception-check! (.value r))
      0)))

(defn lower-ascii-string [(text (slice u8))] (-> (dyn NodeOps))
  (let [(mut units) (al-new [i64] (alloc/malloc-allocator)) (mut i) 0]
    (loop (if (>= (load i) (len text))
              (break 0)
              (do (push! [i64] (mut units) (primitive/cast i64 (get text (load i))))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
    (let [scope (parser-node (.current-scope (parser-state)))
          lowered (jsl-lower-string-units (load units) (parser-node (.current-ctrl (parser-state))) (scope-mem scope))]
      (al-free! [i64] (mut units))
      (parser-set-current-ctrl! (.ctrl lowered))
      (scope-set-mem! scope (.mem lowered))
      (box-make-at (Some (.ctrl lowered)) (.value lowered)))))

;; A JSL macro with no arguments at the current point.
(defn lower-jsl-nullary [(name (slice u8))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
        r (jsl-lower-macro-values name (load args) (parser-node (.current-ctrl (parser-state))) (scope-mem scope))]
    (al-free! [(dyn NodeOps)] (mut args))
    (parser-set-current-ctrl! (.ctrl r))
    (scope-set-mem! scope (.mem r))
    (.value r)))

;; A JSL macro over one value at the current point.
(defn lower-jsl-unary-value [(name (slice u8)) (value (dyn NodeOps))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
    (push! [(dyn NodeOps)] (mut args) value)
    (let [r (jsl-lower-macro-values name (load args) (parser-node (.current-ctrl (parser-state))) (scope-mem scope))]
      (al-free! [(dyn NodeOps)] (mut args))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (.value r))))

;; A call to a JSL builtin over already-lowered values, threaded through the current Scope.
(defn lower-jsl-call-values [(name (slice u8)) (values (ArrayList (dyn NodeOps)))] (-> JslExprResult)
  (let [scope (parser-node (.current-scope (parser-state)))
        target (jsl-graph-of name)
        c (call-make-with-mem (parser-node (.current-ctrl (parser-state))) (scope-mem scope))]
    (al-for [v values] (call-add-arg! c v))
    (call-set-fptr! c (funptr-make target (jsl-fidx-of name)))
    (let [end (callend-make c)]
      (if (jsl-noinline? name) (callend-set-never-inline! end) 0)
      (jsl-expr-result (proj-make end RETURN-VALUE "jsl.call.value")
                       (cproj-make end RETURN-CTRL "jsl.call.ctrl")
                       (proj-make end RETURN-MEM "jsl.call.mem")))))

;; `o[k]`: a runtime key; refuses at run time until keys intern and arrays exist.
(defn lower-keyed-read [(owner-id i64) (key-id i64)] (-> (dyn NodeOps))
  (let [owner (lower-syntax-expr owner-id)]
    (n-keep! owner)
    (let [k (lower-syntax-expr key-id)
          scope (parser-node (.current-scope (parser-state)))
          (mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
      (n-keep! k)
      (push! [(dyn NodeOps)] (mut args) owner)
      (push! [(dyn NodeOps)] (mut args) k)
      (let [r (lower-jsl-call-values "JsGetKeyed" (load args))]
        (al-free! [(dyn NodeOps)] (mut args))
        (n-unkeep! k)
        (parser-set-current-ctrl! (.ctrl r))
        (scope-set-mem! scope (.mem r))
        (let [checked (lower-completion! (.value r))]
          (n-unkeep! owner)
          checked)))))

(defn lower-keyed-call [(owner-id i64) (key-id i64) (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [owner (lower-syntax-expr owner-id)]
    (n-keep! owner)
    (let [k (lower-syntax-expr key-id)
          scope (parser-node (.current-scope (parser-state)))
          (mut margs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
      (n-keep! k)
      (push! [(dyn NodeOps)] (mut margs) owner)
      (push! [(dyn NodeOps)] (mut margs) k)
      (let [r (lower-jsl-call-values "JsGetKeyed" (load margs))]
        (al-free! [(dyn NodeOps)] (mut margs))
        (n-unkeep! k)
        (parser-set-current-ctrl! (.ctrl r))
        (scope-set-mem! scope (.mem r))
        (let [checked (lower-completion! (.value r))
              answer (lower-value-call-with-receiver checked owner (dyn-undefined-make) args
                                                     (lower-callee-message (lower-callee-message (syntax-callee-label owner-id) "[...]") " is not a function"))]
          (n-unkeep! owner)
          answer)))))

;; `new F(args)`: a fresh ordinary object whose [[Prototype]] is F's `prototype` property is F's
;; receiver; the result is what F returned if that is an object, else the fresh object. A
;; non-callable F takes the value call's TypeError trap.
(defn lower-new [(callee-id i64) (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [callee (lower-syntax-expr callee-id)]
    (n-keep! callee)
    (let [scope (parser-node (.current-scope (parser-state)))
          (mut pargs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
      (push! [(dyn NodeOps)] (mut pargs) callee)
      (push! [(dyn NodeOps)] (mut pargs) (con-int (shape-key-intern "prototype")))
      (let [proto (jsl-lower-macro-values "JsGetNamed" (load pargs) (parser-node (.current-ctrl (parser-state))) (scope-mem scope))]
        (al-free! [(dyn NodeOps)] (mut pargs))
        (parser-set-current-ctrl! (.ctrl proto))
        (scope-set-mem! scope (.mem proto))
        ;; `F.prototype` on a non-object F is the TypeError; its completion unwinds here.
        (let [proto-value (lower-completion! (.value proto))]
        (n-keep! proto-value)
        (let [raw (lower-jsl-nullary "JsNewObjectRaw")]
          (n-keep! raw)
          (let [(mut sargs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
            (push! [(dyn NodeOps)] (mut sargs) raw)
            (push! [(dyn NodeOps)] (mut sargs) proto-value)
            (let [linked (jsl-lower-macro-values "JsSetObjectLiteralPrototype" (load sargs) (parser-node (.current-ctrl (parser-state))) (scope-mem scope))]
              (al-free! [(dyn NodeOps)] (mut sargs))
              (parser-set-current-ctrl! (.ctrl linked))
              (scope-set-mem! scope (.mem linked))
              (let [created (lower-jsl-unary-value "JsFinishObjectLiteral" (.value linked))]
                (n-keep! created)
                (let [returned (lower-value-call-with-receiver callee created callee args
                                                               (lower-callee-message (syntax-callee-label callee-id) " is not a constructor"))
                      (mut rargs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
                  (n-keep! returned)
                  (push! [(dyn NodeOps)] (mut rargs) returned)
                  (push! [(dyn NodeOps)] (mut rargs) created)
                  (let [result (jsl-lower-macro-values "JsConstructResult" (load rargs) (parser-node (.current-ctrl (parser-state))) (scope-mem (parser-node (.current-scope (parser-state)))))]
                    (al-free! [(dyn NodeOps)] (mut rargs))
                    (parser-set-current-ctrl! (.ctrl result))
                    (scope-set-mem! (parser-node (.current-scope (parser-state))) (.mem result))
                    (n-unkeep! returned)
                    (n-unkeep! created)
                    (n-unkeep! raw)
                    (n-unkeep! proto-value)
                    (n-unkeep! callee)
                    (.value result))))))))))))

;; `o.m(args)`: the owner is evaluated once and is both the property base and the receiver.
(defn lower-member-call [(owner-id i64) (name (slice u8)) (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [owner (lower-syntax-expr owner-id)]
    (n-keep! owner)
    (let [scope (parser-node (.current-scope (parser-state)))
          (mut margs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
      (push! [(dyn NodeOps)] (mut margs) owner)
      (push! [(dyn NodeOps)] (mut margs) (con-int (shape-key-intern name)))
      (let [loaded (jsl-lower-macro-values "JsGetNamed"
                                           (load margs)
                                           (parser-node (.current-ctrl (parser-state)))
                                           (scope-mem scope))]
        (al-free! [(dyn NodeOps)] (mut margs))
        (parser-set-current-ctrl! (.ctrl loaded))
        (scope-set-mem! scope (.mem loaded))
        (let [checked (lower-completion! (.value loaded))
              answer (lower-value-call-with-receiver checked owner (dyn-undefined-make) args
                                                     (lower-callee-message (lower-callee-message (lower-callee-message (syntax-callee-label owner-id) ".") name) " is not a function"))]
          (n-unkeep! owner)
          answer)))))

;; `this`: the receiver slot of the enclosing non-arrow function, mapped for sloppy code; the
;; global object at a Script's top level. An arrow's `this` is a capture of its enclosing
;; function's and waits for closures.
;; `new.target`: the second argument slot of the enclosing non-arrow function — undefined when it
;; was called, the constructor when it was constructed (docs/DECISIONS.md, new.target is an argument
;; slot). The parser refused it outside a function; an arrow's is a capture and waits for closures.
(defn lower-new-target [] (-> (dyn NodeOps))
  (let [p (parser-state)
        f (syntax-fun-at (.current-fun p))]
    (if (syntax-script-root? (.current-fun p))
        (do (panic "lower-new-target: new.target at a Script root (the parser admits it only in a function)")
            (unreachable-node))
        (match (.kind f)
          (FunArrow []
                    (do
                      (unimplemented "arrow function `new.target` (a capture of the enclosing function's)"
                                     "docs/GAPS.md — function values and closures")
                      (unreachable-node)))
          (_
           (let [fun (parser-node (.fun-nid f))]
             (match (fun-parm fun 1) (Some [t] t) (None [] (unreachable-node)))))))))

(defn lower-this [] (-> (dyn NodeOps))
  (let [p (parser-state)
        f (syntax-fun-at (.current-fun p))]
    (if (syntax-script-root? (.current-fun p))
        (lower-global-object)
        (match (.kind f)
          (FunArrow []
                    (do
                      (unimplemented "arrow function `this` (a capture of the enclosing receiver)"
                                     "docs/GAPS.md — function values and closures")
                      (unreachable-node)))
          (_
           (let [fun (parser-node (.fun-nid f))
                 receiver (match (fun-parm fun 0) (Some [r] r) (None [] (unreachable-node)))]
             (if (.strict f)
                 receiver
                 (let [scope (parser-node (.current-scope p))
                       (mut margs) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
                   (push! [(dyn NodeOps)] (mut margs) receiver)
                   (let [mapped (jsl-lower-macro-values (if (.script-mode p) "JsSloppyThis" "JsSloppyThisNoRealm")
                                                        (load margs)
                                                        (parser-node (.current-ctrl p))
                                                        (scope-mem scope))]
                     (al-free! [(dyn NodeOps)] (mut margs))
                     (parser-set-current-ctrl! (.ctrl mapped))
                     (scope-set-mem! scope (.mem mapped))
                     (.value mapped))))))))))

;; FunctionDeclarations at the top level of a function body are var-like bindings initialized
;; with their function objects on entry (FunctionDeclarationInstantiation).
(defn lower-bind-body-functions! [(stmts (ArrayList i64))] (-> i64)
  (do
    (al-for [id stmts]
            (match (syntax-stmt-node id)
              (SsFunctionDecl [fun]
                              (let [f (syntax-fun-at fun)]
                                (if (.hoisted f)
                                    0
                                    (scope-update! (parser-node (.current-scope (parser-state)))
                                                   (.name f)
                                                   (lower-function-object fun)))))
              (_ 0)))
    0))

(defn lower-member-read [(owner-id i64) (name (slice u8))] (-> (dyn NodeOps))
  (let [owner (lower-syntax-expr owner-id)
        scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
    (push! [(dyn NodeOps)] (mut args) owner)
    (push! [(dyn NodeOps)] (mut args) (con-int (shape-key-intern name)))
    (let [lowered
            (jsl-lower-macro-values "JsGetNamed"
                                    (load args)
                                    (parser-node (.current-ctrl (parser-state)))
                                    (scope-mem scope))]
      (al-free! [(dyn NodeOps)] (mut args))
      (parser-set-current-ctrl! (.ctrl lowered))
      (scope-set-mem! scope (.mem lowered))
      (lower-completion! (.value lowered)))))

(defn lower-named-call [(name (slice u8)) (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [bound (or (>= (scope-find (parser-node (.current-scope (parser-state))) name) 0)
                  (syntax-script-binding? name))
        global (syntax-global-index name)
        ;; A realm global is a direct call only when nothing ever assigns the name; a plain
        ;; function-entry program keeps its hoisted declarations.
        target-idx (if bound
                       -1
                       (if (>= global 0)
                           (syntax-global-direct-fun global)
                           (syntax-find-fun name)))]
    (if (or bound (< target-idx 0))
        ;; A binding, not a hoisted declaration: call through whatever value it holds.
        (lower-value-call (lower-name name) args name)
        (let [target-syntax (syntax-fun-at target-idx)
              target (parser-node (.fun-nid target-syntax))
              scope (parser-node (.current-scope (parser-state)))
              c
                (call-make-with-mem (parser-node (.current-ctrl (parser-state)))
                                    (scope-mem scope))
              formal-count (parser-abi-slots)
              (mut i) 0]
          ;; An intrinsic's body sees exactly the arguments it declares; a longer argument list
          ;; would be dropped silently, so it refuses by name instead.
          (if (syntax-intrinsic-fun? target-idx)
              (let [table (intrinsic-table)
                    entry (get table (intrinsic-index table (.name target-syntax)))]
                (if (> (len args) (.arity entry))
                    (unimplemented "more arguments than the intrinsic admits (the slot ABI carries no argument count)"
                                   "docs/GAPS.md — intrinsics")
                    0))
              0)
          ;; JavaScript evaluates every actual left-to-right. The shared ABI carries `this`,
          ;; `new.target` (undefined: this is a call) and the program-wide slot count: extra
          ;; actuals still run for effects, while omitted slots receive the canonical boxed undefined.
          (call-add-arg! c (dyn-undefined-make))
          (call-add-arg! c (dyn-undefined-make))
          (loop (if (>= (load i) (len args))
                    (break 0)
                    (do
                      (let [actual (lower-syntax-expr (get args (load i)))]
                        (if (< (load i) formal-count)
                            (call-add-arg! c actual)
                            0))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (loop (if (>= (load i) formal-count)
                    (break 0)
                    (do
                      (call-add-arg! c (dyn-undefined-make))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (n-set-def! c
                      CALL-CTRL
                      (Some (parser-node (.current-ctrl (parser-state)))))
          (n-set-def! c
                      CALL-MEM
                      (Some (scope-mem (parser-node (.current-scope (parser-state))))))
          (call-set-fptr! c (funptr-make target (.fidx target-syntax)))
          (let [end (callend-make c)]
            (let [ctrl (cproj-make end RETURN-CTRL "call.ctrl")]
              (parser-set-current-ctrl! ctrl))
            (scope-set-mem! (parser-node (.current-scope (parser-state)))
                            (proj-make end RETURN-MEM "call.mem"))
            (let [value (proj-make end RETURN-VALUE "call.value")]
              ;; The callee's completion: tested when the filter says the callee may throw; else
              ;; the filter's proof narrows the result to a value (the Cast folds once SCCP
              ;; sharpens the callee's return type).
              (if (syntax-fun-may-throw? target-idx)
                  (lower-exception-check! value)
                  (cast-make (parser-node (.current-ctrl (parser-state))) value (ty-dyn TAG-ANY)))))))))

;; Final Simple parseAsgn recursively parses the RHS, updates the lexical Scope and returns the
;; assigned value. opAssign keeps the old value across RHS parsing, then computes and updates.
;; Here syntax preserves the Reference until this walk. Evaluate its base once, GetValue before
;; a compound RHS, and PutValue after the JSL arithmetic call. Reacquire the current Scope after
;; each expression: a conditional/short-circuit RHS can replace it. Keeps protect reference/value
;; nodes across that replacement.
(defn lower-assignment [(op (slice u8)) (target i64) (value-id i64)] (-> (dyn NodeOps))
  (let [compound (!= op "")
        ref (lower-ref-prepare! target)
        (mut old-nid) 0]
    (if compound
        (do
          (lower-require-jsl! op)
          (let [old (lower-ref-get! ref)]
            (n-keep! old)
            (set! (mut old-nid) (n-nid old))))
        0)
    (let [rhs (lower-syntax-expr value-id)
          value
            (if compound
                (lower-js-binary (parser-node (load old-nid)) rhs op)
                rhs)]
      (n-keep! value)
      (if compound (n-unkeep! (parser-node (load old-nid))) 0)
      (lower-ref-put! ref value)
      (lower-ref-release! ref)
      (n-unkeep! value)
      value)))

;; UpdateExpression: oldValue = ToNumeric(GetValue(ref)); newValue = oldValue ± 1; PutValue;
;; the result is newValue for a prefix operator and oldValue (already numeric) for a postfix one.
(defn lower-update [(op (slice u8)) (prefix bool) (target i64)] (-> (dyn NodeOps))
  (let [ref (lower-ref-prepare! target)
        old (lower-js-unary (lower-ref-get! ref) "JsPositive")]
    (n-keep! old)
    (let [new (lower-js-unary old op)]
      (n-keep! new)
      (lower-ref-put! ref new)
      (lower-ref-release! ref)
      (n-unkeep! new)
      (n-unkeep! old)
      (if prefix new old))))

;; Source provenance is a scoped construction context. Nested expressions temporarily narrow it;
;; after they return, the enclosing operator regains its complete expression range. Node inputs and
;; later graph rewrites merge these ranges, so optimization does not erase attribution.
(defn lower-syntax-expr [(id i64)] (-> (dyn NodeOps))
  (let [x (syntax-at id)
        old-lo (n-source-context-lo)
        old-hi (n-source-context-hi)]
    (n-source-context-set! (.lo x) (.hi x))
    (let [answer
            (match (.node x)
              ;; A source literal is a JavaScript value. The raw integer exists only inside its
              ;; Box and may reappear after a proven JSL Unbox cancels that Box during
              ;; specialization.
              (SxNumber [value value-float rep]
                        (box-make-at (Some (parser-node (.current-ctrl (parser-state))))
                                     (if (= rep REP-INT)
                                         (con-int value)
                                         (con-flt value-float))))
              (SxString [raw units legacy]
                        (let [scope (parser-node (.current-scope (parser-state)))
                              lowered
                                (jsl-lower-string-units units
                                                        (parser-node (.current-ctrl (parser-state)))
                                                        (scope-mem scope))]
                          (parser-set-current-ctrl! (.ctrl lowered))
                          (scope-set-mem! scope (.mem lowered))
                          (box-make-at (Some (.ctrl lowered)) (.value lowered))))
              (SxName [name] (lower-name name))
              (SxSingleton [name] (lower-singleton name))
              (SxGroup [inner] (lower-syntax-expr inner))
              (SxObject [entries] (lower-object-literal entries))
              (SxArray [elements] (lower-array-literal elements))
              (SxMember [owner name optional]
                        (if optional
                            (do
                              (unimplemented "optional chaining"
                                             "docs/GAPS.md — nullish short-circuit chains")
                              (unreachable-node))
                            (lower-member-read owner name)))
              (SxIndex [owner key optional]
                       (if optional
                           (do
                             (unimplemented "optional chaining"
                                            "docs/GAPS.md — nullish short-circuit chains")
                             (unreachable-node))
                           (lower-keyed-read owner key)))
              (SxCall [callee args optional]
                      (if optional
                          (do
                            (unimplemented "optional chaining"
                                           "docs/GAPS.md — nullish short-circuit chains")
                            (unreachable-node))
                          (match (syntax-node (syntax-ungroup-id callee))
                            (SxName [name] (lower-named-call name args))
                            (SxMember [owner member optional]
                                      (if optional
                                          (do
                                            (unimplemented "optional chaining"
                                                           "docs/GAPS.md — nullish short-circuit chains")
                                            (unreachable-node))
                                          (lower-member-call owner member args)))
                            (SxPrivateMember [owner member optional]
                                             (do
                                               (unimplemented "private method calls"
                                                              "docs/GAPS.md — classes")
                                               (unreachable-node)))
                            (SxIndex [owner key optional]
                                     (if optional
                                         (do
                                           (unimplemented "optional chaining"
                                                          "docs/GAPS.md — nullish short-circuit chains")
                                           (unreachable-node))
                                         (lower-keyed-call owner key args)))
                            (_ (lower-value-call (lower-syntax-expr callee) args (syntax-callee-label callee))))))
              (SxNew [callee args] (lower-new callee args))
              (SxNewTarget [] (lower-new-target))
              (SxThis [] (lower-this))
              (SxIntrinsic [builtin args] (lower-intrinsic-call builtin args))
              (SxSpread [expr]
                        (do
                          (unimplemented "spread arguments"
                                         "docs/GAPS.md — iteration protocol")
                          (unreachable-node)))
              (SxImportCall [specifier options]
                            (do
                              (unimplemented "dynamic import()"
                                             "docs/GAPS.md — modules")
                              (unreachable-node)))
              ;; A substitution-free template is exactly its cooked string.
              (SxTemplate [quasis substitutions]
                          (if (= (len substitutions) 0)
                              (lower-syntax-expr (get quasis 0))
                              (do
                                (unimplemented "template substitutions (ToString)"
                                               "docs/GAPS.md — string conversion")
                                (unreachable-node))))
              (SxTaggedTemplate [tag template]
                                (do
                                  (unimplemented "tagged templates"
                                                 "docs/GAPS.md — function values")
                                  (unreachable-node)))
              (SxRegex [body flags]
                       (do
                         (unimplemented "regular expression objects"
                                        "docs/GAPS.md — RegExp")
                         (unreachable-node)))
              (SxFunction [fun] (lower-function-object fun))
              (SxYield [argument delegate]
                       (do
                         (unimplemented "generator yield"
                                        "docs/GAPS.md — generators")
                         (unreachable-node)))
              (SxAwait [operand]
                       (do
                         (unimplemented "await"
                                        "docs/GAPS.md — promises and async functions")
                         (unreachable-node)))
              (SxSuper []
                       (do
                         (unimplemented "super property access" "docs/GAPS.md — methods and home objects")
                         (unreachable-node)))
              (SxClass [cls]
                       (do
                         (unimplemented "class definitions" "docs/GAPS.md — classes")
                         (unreachable-node)))
              (SxDestructuringAssign [pattern value]
                                     (do
                                       (unimplemented "destructuring assignment" "docs/GAPS.md — destructuring")
                                       (unreachable-node)))
              (SxPrivateMember [owner name optional]
                               (do
                                 (unimplemented "private class members" "docs/GAPS.md — classes")
                                 (unreachable-node)))
              (SxPrivateName [name]
                             (do
                               (unimplemented "private brand checks" "docs/GAPS.md — classes")
                               (unreachable-node)))
              (SxUnary [op operand]
                       (do
                         (lower-require-jsl! op)
                         (lower-js-unary (if (= op "JsTypeof")
                                             (lower-typeof-operand operand)
                                             (lower-syntax-expr operand))
                                         op)))
              (SxDelete [operand]
                        (do
                          (unimplemented "delete operator"
                                         "docs/GAPS.md — property deletion")
                          (unreachable-node)))
              (SxUpdate [op prefix target] (lower-update op prefix target))
              (SxBinary [op left right] (lower-syntax-binary left right op))
              (SxAnd [left right]
                     (lower-short-circuit left right "JsTruthy" true))
              (SxOr [left right]
                    (lower-short-circuit left right "JsTruthy" false))
              (SxCoalesce [left right]
                          (lower-short-circuit left right "JsNullish" true))
              (SxConditional [condition when-true when-false]
                             (lower-conditional condition when-true when-false))
              (SxAssign [target value] (lower-assignment "" target value))
              (SxCompoundAssign [op target value]
                                (lower-assignment op target value))
              (SxLogicalAssign [predicate rhs-on-true target value]
                               (lower-logical-assignment predicate
                                                         rhs-on-true
                                                         target
                                                         value))
              (SxComma [left right]
                       (do (lower-syntax-expr left) (lower-syntax-expr right))))]
      (n-source-context-set! old-lo old-hi)
      answer)))

;; Final Simple's `Parser.addReturn` accumulates a pruned return Scope holding control, memory, and
;; `$expr`, then kills the current control. Later exits merge into that accumulator and function
;; fallthrough contributes its default value only while control remains live. These three nid lists
;; are the same pruned accumulator: source locals are irrelevant after exit, while control, memory,
;; and value are all kept until one final Return owns them.
(defn parser-reset-returns! [] (-> i64)
  (let [p (parser-state)]
    (al-clear! [i64] (mut (.return-ctrls p)))
    (al-clear! [i64] (mut (.return-mems p)))
    (al-clear! [i64] (mut (.return-values p)))
    0))

(defn parser-record-return! [(value (dyn NodeOps))] (-> i64)
  (let [p (parser-state)
        scope (parser-node (.current-scope p))
        ctrl (scope-ctrl scope)
        ;; Force lazy loop memory before severing the current control, exactly as Simple does.
        mem (scope-mem scope)
        dead (xctrl-make)]
    (n-keep! ctrl)
    (n-keep! mem)
    (n-keep! value)
    (push! [i64] (mut (.return-ctrls p)) (n-nid ctrl))
    (push! [i64] (mut (.return-mems p)) (n-nid mem))
    (push! [i64] (mut (.return-values p)) (n-nid value))
    (scope-set-ctrl! scope dead)
    (set! (.current-ctrl p) (n-nid dead))
    1))

;; Final Simple jumpTo duplicates the current Scope, kills current control, pops lexical levels
;; to the target depth and merges the pruned copy into the exit Scope. We retain that order and
;; keep the target while nested loops replace the active Scope. Unlike a return, a break carries
;; surviving variable bindings as well as control/memory. Simple's `_continueScope` starts null
;; and the first continue's pruned copy BECOMES it; later continues merge into it, and the loop
;; bottom merges last (`jumpTo(_continueScope)`) before the `for` update and the backedge. Labels
;; name a target explicitly; unlabelled `break` takes the nearest loop or switch and unlabelled
;; `continue` the nearest loop. `finally` unwinding remains UNIMPLEMENTED with exceptions.
(defn parser-push-jump! [(exit (dyn NodeOps)) (kind i64)] (-> i64)
  (let [p (parser-state)
        (mut target) (primitive/zeroed JumpTarget)
        (mut labels) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (al-for [label (.pending-labels p)] (push! [(slice u8)] (mut labels) label))
    (al-clear! [(slice u8)] (mut (.pending-labels p)))
    (set! (.scope (mut target)) (n-nid exit))
    (set! (.kind (mut target)) kind)
    (set! (.completions (mut target)) 0)
    (set! (.continue-scope (mut target)) (None [i64]))
    (set! (.labels (mut target)) (load labels))
    (n-keep! exit)
    (push! [JumpTarget] (mut (.jump-targets p)) (load target))))

(defn parser-pop-jump! [] (-> JumpTarget)
  (match (pop! (mut (.jump-targets (parser-state))))
    (None []
          (do
            (broken "parser-pop-jump!: no target")
            (primitive/zeroed JumpTarget)))
    (Some [target]
          (let [saved target
                (mut labels) (.labels saved)]
            (n-unkeep! (parser-node (.scope saved)))
            (al-free! [(slice u8)] (mut labels))
            saved))))

(defn parser-find-jump [(label (Option (slice u8))) (continue? bool)] (-> i64)
  (let [p (parser-state)
        (mut i) (- (len (.jump-targets p)) 1)]
    (loop (if (< (load i) 0)
              (break (do
                       (broken "parser-find-jump: no target after syntax validation")
                       -1))
              (let [target (get (.jump-targets p) (load i))
                    matches
                      (match label
                        (Some [name]
                              (syntax-labels-contain? (.labels target) name))
                        (None []
                              (if continue?
                                  (= (.kind target) JUMP-LOOP)
                                  (or (= (.kind target) JUMP-LOOP) (= (.kind target) JUMP-SWITCH)))))]
                (if matches
                    (break (load i))
                    (do (set! (mut i) (- (load i) 1)) (continue))))))))

(defn parser-record-jump! [(label (Option (slice u8))) (continue? bool)] (-> i64)
  (let [p (parser-state)
        index (parser-find-jump label continue?)
        finally-index (parser-find-finally)
        target (get (.jump-targets p) index)
        exit (parser-node (.scope target))
        outgoing (scope-dup (parser-node (.current-scope p)) false)
        depth (len (.levels (scope-node exit)))]
    ;; A break or continue that would leave a try with a finally block must run the block first.
    (if (> finally-index index)
        (unimplemented "break or continue crossing a finally block" "docs/GAPS.md — exceptions")
        0)
    (parser-set-current-ctrl! (xctrl-make))
    (loop (if (<= (len (.levels (scope-node outgoing))) depth)
              (break 0)
              (do (scope-pop! outgoing) (continue))))
    (let [meta (al-elem [JumpTarget] (mut (.jump-targets p)) index)]
      (if continue?
          (do
            (match (.continue-scope meta)
              (None []
                    (do
                      (n-keep! outgoing)
                      (set! (.continue-scope meta) (Some (n-nid outgoing)))
                      0))
              (Some [cs] (do (scope-merge! (parser-node cs) outgoing) 0)))
            (set! (.continue-count meta) (+ (.continue-count meta) 1)))
          (do
            (scope-merge! exit outgoing)
            (set! (.count meta) (+ (.count meta) 1)))))
    1))

;; The loop bottom: merge the live fallthrough into the continue Scope, which then becomes the
;; current Scope. Returns whether any path reaches the loop's update/condition/backedge.
(defn parser-close-continues! [(terminated i64)] (-> bool)
  (let [p (parser-state)
        index (- (len (.jump-targets p)) 1)
        target (get (.jump-targets p) index)]
    (match (.continue-scope target)
      (None [] (= terminated 0))
      (Some [cs]
            (let [cont (parser-node cs)]
              (scope-merge! cont (parser-node (.current-scope p)))
              (n-unkeep! cont)
              (parser-use-scope! cont)
              true)))))

(defn parser-release-return-keeps! [] (-> i64)
  (let [p (parser-state)
        (mut i) 0]
    (loop (if (>= (load i) (len (.return-values p)))
              (break 0)
              (do
                (n-unkeep! (parser-node (get (.return-ctrls p) (load i))))
                (n-unkeep! (parser-node (get (.return-mems p) (load i))))
                (n-unkeep! (parser-node (get (.return-values p) (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))))

(defn parser-build-return! [(fun (dyn NodeOps))] (-> (dyn NodeOps))
  (let [p (parser-state)
        count (len (.return-values p))]
    (if (= count 0)
        (do
          (panic "parser-build-return!: function has no exit")
          (unreachable-node))
        (let [ret
                (if (= count 1)
                    (return-make (parser-node (get (.return-ctrls p) 0))
                                 (Some (parser-node (get (.return-mems p) 0)))
                                 (parser-node (get (.return-values p) 0))
                                 (None [(dyn NodeOps)])
                                 (Some fun))
                    (let [region (region-make)
                          memphi (memphi-make region ALIAS-BULK TY-BOT "$return.mem")
                          ;; A function returns a completion: a value, or the exception sentinel.
                          valuephi (phi-make region (ty-dyn TAG-COMPLETION) "$return.value")
                          (mut i) 0]
                      (loop (if (>= (load i) count)
                                (break 0)
                                (do
                                  (region-add-path! region
                                                    (parser-node (get (.return-ctrls p)
                                                                      (load i))))
                                  (memphi-add-state! memphi
                                                     (parser-node (get (.return-mems p)
                                                                       (load i))))
                                  (phi-add-value! valuephi
                                                  (parser-node (get (.return-values p)
                                                                    (load i))))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))
                      (return-make region
                                   (Some memphi)
                                   valuephi
                                   (None [(dyn NodeOps)])
                                   (Some fun))))]
          (parser-release-return-keeps!)
          ret))))

;; Instantiate direct lexical bindings, including comma-separated declarations without a new scope.
(defn lower-instantiate-lexicals! [(stmts (ArrayList i64))] (-> i64)
  (do
    (al-for [id stmts]
            (match (syntax-stmt-node id)
              (SsLet [name init final annotation]
                     (scope-declare! (parser-node (.current-scope (parser-state)))
                                     name
                                     (ty-dyn TAG-ANY)
                                     final))
              (SsLetPattern [pattern init final]
                            (unimplemented "destructuring declarations" "docs/GAPS.md — destructuring"))
              (SsDeclList [decls] (lower-instantiate-lexicals! decls))
              (SsCase [selector body] (lower-instantiate-lexicals! body))
              ;; A block-level FunctionDeclaration is a lexical binding initialized on block entry.
              ;; The function body's own list is instantiated var-like by `lower-bind-body-functions!`
              ;; instead, which finds the var already defined.
              (SsFunctionDecl [fun]
                              (let [f (syntax-fun-at fun)
                                    scope (parser-node (.current-scope (parser-state)))]
                                (if (or (.hoisted f) (>= (scope-find scope (.name f)) 0))
                                    0
                                    (scope-define! scope (.name f) (ty-dyn TAG-ANY) false
                                                   (lower-function-object fun)))))
              (_ 0)))
    0))

;; Final Simple installs parameters in its function Scope before parsing the body. JavaScript's
;; FunctionDeclarationInstantiation additionally hoists var names out of nested statements.
;; Preserve existing parameters and repeated var bindings; initialize only new slots to JSL
;; undefined. Initializers remain at their original execution positions. Script object-environment
;; bindings and the implicit arguments object are explicitly outside this implementation boundary.
(defn lower-instantiate-vars! [(stmts (ArrayList i64))] (-> i64)
  (let [(mut names) (al-new [(slice u8)] (alloc/malloc-allocator))
        scope (parser-node (.current-scope (parser-state)))]
    (syntax-collect-declarations! stmts false (mut names))
    (al-for [name (load names)]
            (if (< (scope-find scope name) 0)
                (do
                  (if (= name "arguments")
                      (unimplemented "implicit arguments object binding"
                                     "docs/GAPS.md — function environments")
                      0)
                  (scope-define! scope
                                 name
                                 (ty-dyn TAG-ANY)
                                 false
                                 (lower-singleton "JsUndefined")))
                0))
    0))

(defn parser-use-scope! [(scope (dyn NodeOps))] (-> i64)
  (do
    (set! (.current-scope (parser-state)) (n-nid scope))
    (set! (.current-ctrl (parser-state)) (n-nid (scope-ctrl scope)))
    0))

;; Simple has no JavaScript CaseBlock. Its ordinary If/CProj/Scope diamonds and jumpTo exits
;; provide the graph machinery; JSL IsStrictlyEqual supplies case matching. First evaluate the
;; discriminant outside the switch lexical scope. Instantiate that scope once, then evaluate case
;; selectors in source order on only the unmatched path. Default receives the final unmatched
;; path even when it appears in the middle. Finally lower bodies in source order, merging each
;; selected entry with the preceding fallthrough. Thus fallthrough never re-evaluates a selector.
;; All clauses share one lexical scope. Runtime TDZ state across differently initialized case
;; paths is still unsupported by Scope and must refuse, not join TOP as a JavaScript value.
(defn syntax-case-body [(id i64)] (-> (ArrayList i64))
  (match (syntax-stmt-node id)
    (SsCase [selector body] body)
    (_ (do
         (broken "syntax-case-body: switch clause is not a case")
         (al-new [i64] (alloc/malloc-allocator))))))

(defn lower-switch [(discriminant i64) (cases (ArrayList i64))] (-> i64)
  (let [value (lower-syntax-expr discriminant)
        outer (parser-node (.current-scope (parser-state)))
        exit (scope-dup outer false)
        (mut entries) (al-new [i64] (alloc/malloc-allocator))
        (mut default-index) -1
        (mut i) 0
        (mut fallthrough) 0]
    (n-keep! value)
    (scope-set-ctrl! exit (xctrl-make))
    (parser-push-jump! exit JUMP-SWITCH)
    (scope-push! outer)
    (lower-instantiate-lexicals! cases)
    (loop (if (>= (load i) (len cases))
              (break 0)
              (let [selector-id
                      (match (syntax-stmt-node (get cases (load i)))
                        (SsCase [selector body] selector)
                        (_ (do
                             (broken "lower-switch: clause is not a case")
                             (None [i64]))))]
                (match selector-id
                  (None []
                        (do
                          (set! (mut default-index) (load i))
                          ;; A parser-only pending entry, patched after all selectors, never a value.
                          (push! [i64] (mut entries) 0)))
                  (Some [selector-expr]
                        (let [selector (lower-syntax-expr selector-expr)
                              predicate
                                (lower-js-truthy (lower-js-binary value
                                                                  selector
                                                                  "JsStrictEqual"))
                              selected (parser-node (.current-scope (parser-state)))
                              iff (if-make (scope-ctrl selected) predicate)
                              arms (if-arms! iff)
                              unmatched (scope-dup selected false)]
                          (scope-set-ctrl! selected (arms-true arms))
                          (scope-set-ctrl! unmatched (arms-false arms))
                          (n-keep! selected)
                          (push! [i64] (mut entries) (n-nid selected))
                          (parser-use-scope! unmatched))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (n-unkeep! value)
    (let [unmatched (parser-node (.current-scope (parser-state)))]
      (if (>= (load default-index) 0)
          (do
            (n-keep! unmatched)
            (set! (mut entries) (load default-index) (n-nid unmatched)))
          (do (scope-pop! unmatched) (scope-merge! exit unmatched) 0)))
    (set! (mut i) 0)
    (loop (if (>= (load i) (len cases))
              (break 0)
              (let [entry (parser-node (get (load entries) (load i)))]
                (n-unkeep! entry)
                (parser-use-scope! (if (= (load fallthrough) 0)
                                       entry
                                       (scope-merge! entry
                                                     (parser-node (load fallthrough)))))
                (let [terminated
                        (lower-syntax-statements (syntax-case-body (get cases
                                                                        (load i))))
                      current (parser-node (.current-scope (parser-state)))]
                  (if (= terminated 0)
                      (set! (mut fallthrough) (n-nid current))
                      (do (set! (mut fallthrough) 0) (n-kill! current))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (!= (load fallthrough) 0)
        (let [last (parser-node (load fallthrough))]
          (scope-pop! last)
          (scope-merge! exit last)
          0)
        0)
    (let [target (parser-pop-jump!)]
      (parser-use-scope! exit)
      (if (or (< (load default-index) 0)
              (!= (load fallthrough) 0)
              (> (.count target) 0))
          0
          1))))

(defn lower-block [(body (ArrayList i64))] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))]
    (scope-push! scope)
    (lower-instantiate-lexicals! body)
    (let [nested-return (lower-syntax-statements body)]
      ;; A loop replaces the active Scope with its exit Scope. Pop the live environment, never
      ;; the stale entry handle.
      (scope-pop! (parser-node (.current-scope (parser-state))))
      nested-return)))

(defn lower-if [(condition-id i64) (then-stmt i64) (else-stmt (Option i64))] (-> i64)
  (let [condition (lower-js-truthy (lower-syntax-expr condition-id))
        iff (if-make (parser-node (.current-ctrl (parser-state))) condition)
        arms (if-arms! iff)
        true-scope (parser-node (.current-scope (parser-state)))
        false-scope (scope-dup true-scope false)]
    (scope-set-ctrl! true-scope (arms-true arms))
    (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
    (let [true-return (lower-syntax-statement then-stmt)
          true-exit (parser-node (.current-scope (parser-state)))]
      (set! (.current-scope (parser-state)) (n-nid false-scope))
      (scope-set-ctrl! false-scope (arms-false arms))
      (set! (.current-ctrl (parser-state)) (n-nid (arms-false arms)))
      (let [false-return
              (match else-stmt
                (Some [e] (lower-syntax-statement e))
                (None [] 0))
            merged
              (scope-merge! true-exit
                            (parser-node (.current-scope (parser-state))))]
        (set! (.current-scope (parser-state)) (n-nid merged))
        (set! (.current-ctrl (parser-state)) (n-nid (scope-ctrl merged)))
        (if (and (!= true-return 0) (!= false-return 0)) 1 0)))))

;; Every loop follows final Simple's atomic protocol: an open Loop and lazy binding Phis are built
;; first, then `scope-end-loop!` installs the control backedge and every materialized Phi backedge
;; without exposing an intermediate graph. The condition and body can resolve every lazy sentinel
;; (notably memory plus all assigned variables). The resulting edge replacements may leave the
;; parser's raw `entry` pointer as its only owner, so it is held from before construction until
;; `scope-end-loop!` has consumed every entry slot.
(defn lower-loop-head! [] (-> (dyn NodeOps))
  (let [entry (parser-node (.current-scope (parser-state)))
        head (loop-make (scope-ctrl entry))]
    (n-keep! entry)
    (scope-set-ctrl! entry head)
    (parser-use-scope! (scope-dup entry true))
    entry))

;; `while (test) body` and `for (…; test; update) body`. An absent `for` test is Simple's `con(1)`.
;; The exit Scope sees the predicate's effects and the false edge; the body continues on true.
(defn lower-test-loop [(test (Option i64)) (update (Option i64)) (body i64)] (-> i64)
  (let [entry (lower-loop-head!)
        condition
          (match test
            (Some [e] (lower-js-truthy (lower-syntax-expr e)))
            (None [] (con-int 1)))
        condition-scope (parser-node (.current-scope (parser-state)))
        iff (if-make (scope-ctrl condition-scope) condition)
        arms (if-arms! iff)]
    (scope-set-ctrl! condition-scope (arms-false arms))
    (let [exit-scope (scope-dup condition-scope false)]
      (parser-push-jump! exit-scope JUMP-LOOP)
      (scope-set-ctrl! condition-scope (arms-true arms))
      (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
      (let [terminated (lower-syntax-statement body)
            live (parser-close-continues! terminated)]
        ;; The update runs after the body and every continue, only on a live path.
        (if live
            (match update (Some [e] (do (lower-syntax-expr e) 0)) (None [] 0))
            0)
        ;; This is one atomic protocol: backedge control first, then all materialized Phi
        ;; backedges, before any peephole can run.
        (scope-end-loop! entry
                         (parser-node (.current-scope (parser-state)))
                         exit-scope)
        (parser-pop-jump!)
        (n-unkeep! entry)
        (parser-use-scope! exit-scope)
        0))))

(defn lower-while [(condition-id i64) (body i64)] (-> i64)
  (lower-test-loop (Some condition-id) (None [i64]) body))

;; `do body while (test)`. The exit Scope cannot be the predicate's false edge before the body
;; exists, so it starts dead (XCtrl) and receives breaks and the false edge by merge, exactly as
;; the switch exit does. When nothing reaches the condition, the backedge is dead and the code
;; after the loop is unreachable unless a break reached the exit.
(defn lower-do-while [(body i64) (condition-id i64)] (-> i64)
  (let [entry (lower-loop-head!)
        exit-scope (scope-dup (parser-node (.current-scope (parser-state))) false)]
    (scope-set-ctrl! exit-scope (xctrl-make))
    (parser-push-jump! exit-scope JUMP-LOOP)
    (let [terminated (lower-syntax-statement body)
          live (parser-close-continues! terminated)]
      (if live
          (let [condition (lower-js-truthy (lower-syntax-expr condition-id))
                condition-scope (parser-node (.current-scope (parser-state)))
                iff (if-make (scope-ctrl condition-scope) condition)
                arms (if-arms! iff)
                false-scope (scope-dup condition-scope false)]
            (scope-set-ctrl! false-scope (arms-false arms))
            (scope-merge! exit-scope false-scope)
            (scope-set-ctrl! condition-scope (arms-true arms))
            (scope-end-loop! entry condition-scope exit-scope))
          (scope-end-loop! entry
                           (parser-node (.current-scope (parser-state)))
                           exit-scope))
      (let [target (parser-pop-jump!)]
        (n-unkeep! entry)
        (parser-use-scope! exit-scope)
        (if (and (not live) (= (.count target) 0)) 1 0)))))

(defn lower-instantiate-lexical-stmt! [(stmt i64)] (-> i64)
  (let [(mut one) (al-new [i64] (alloc/malloc-allocator))]
    (push! [i64] (mut one) stmt)
    (lower-instantiate-lexicals! (load one))
    (al-free! [i64] (mut one))
    0))

;; Final Simple parseFor pushes a block scope for the index variables, parses the declaration,
;; runs the shared looping protocol and pops that scope. A head `let` is one binding here, not a
;; per-iteration copy: without closures the per-iteration environment is unobservable, and this
;; must change when captured environments arrive.
(defn lower-for [(init ForInit)
                 (test (Option i64))
                 (update (Option i64))
                 (body i64)] (-> i64)
  (do
    (scope-push! (parser-node (.current-scope (parser-state))))
    (match init
      (ForNoInit [] 0)
      (ForInitDecl [stmt]
                   (do
                     (lower-instantiate-lexical-stmt! stmt)
                     (lower-syntax-statement stmt)))
      (ForInitExpr [e] (do (lower-syntax-expr e) 0))
      (ForInitPattern [pattern]
                      (unimplemented "destructuring for-in/of heads" "docs/GAPS.md — destructuring")))
    (let [terminated (lower-test-loop test update body)]
      (scope-pop! (parser-node (.current-scope (parser-state))))
      terminated)))

;; A label on a loop or switch names that statement's jump target; the labels accumulate until
;; the target is pushed. Any other labelled statement is a break-only block target.
(defn syntax-stmt-takes-labels? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsLabeled [label body] true)
    (SsSwitch [discriminant cases] true)
    (_ (syntax-iteration-stmt? id))))

(defn lower-labeled [(label (slice u8)) (body i64)] (-> i64)
  (do
    (push! [(slice u8)] (mut (.pending-labels (parser-state))) label)
    (if (syntax-stmt-takes-labels? body)
        (lower-syntax-statement body)
        (let [current (parser-node (.current-scope (parser-state)))
              exit (scope-dup current false)]
          (scope-set-ctrl! exit (xctrl-make))
          (parser-push-jump! exit JUMP-BLOCK)
          (let [terminated (lower-syntax-statement body)
                target (parser-pop-jump!)
                merged
                  (scope-merge! (parser-node (.current-scope (parser-state)))
                                exit)]
            (parser-use-scope! merged)
            (if (and (!= terminated 0) (= (.count target) 0)) 1 0))))))

;; Return 1 when every path exits; each exit has transferred ownership to its return/break target.
(defn lower-syntax-statement [(id i64)] (-> i64)
  (match (syntax-stmt-node id)
    (SsLet [name init final annotation]
           (let [value
                   (match init
                     (Some [e] (lower-syntax-expr e))
                     (None [] (lower-singleton "JsUndefined")))]
             (scope-initialize! (parser-node (.current-scope (parser-state)))
                                name
                                value)
             0))
    (SsVar [name init annotation]
           (match init
             (Some [e]
                   (let [value (lower-syntax-expr e)]
                     (lower-store-name! name value)
                     0))
             (None [] 0)))
    (SsLetPattern [pattern init final]
                  (unimplemented "destructuring declarations" "docs/GAPS.md — destructuring"))
    (SsVarPattern [pattern init]
                  (unimplemented "destructuring declarations" "docs/GAPS.md — destructuring"))
    (SsDeclList [decls] (lower-syntax-statements decls))
    (SsReturn [value]
              (lower-return-completion! (match value
                                          (Some [e] (lower-syntax-expr e))
                                          (None [] (dyn-undefined-make)))))
    (SsExpr [expr] (do (lower-syntax-expr expr) 0))
    (SsBlock [body] (lower-block body))
    (SsIf [condition then-stmt else-stmt]
          (lower-if condition then-stmt else-stmt))
    (SsWhile [condition body] (lower-while condition body))
    (SsEmpty [] 0)
    (SsBreak [label] (parser-record-jump! label false))
    (SsContinue [label] (parser-record-jump! label true))
    (SsSwitch [discriminant cases] (lower-switch discriminant cases))
    (SsCase [selector body]
            (do
              (broken "lower-syntax-statement: case clause outside its switch")
              0))
    (SsDoWhile [body condition] (lower-do-while body condition))
    (SsFor [init test update body] (lower-for init test update body))
    (SsForIn [head of right body awaited]
             (unimplemented (if awaited
                                "for-await-of asynchronous iteration"
                                (if of
                                    "for-of iteration protocol"
                                    "for-in property enumeration"))
                            "docs/GAPS.md — iteration statements"))
    (SsLabeled [label body] (lower-labeled label body))
    (SsThrow [value] (lower-throw value))
    (SsTry [body catch-param catch-body finally-body]
           (lower-try body catch-param catch-body finally-body))
    (SsWith [object body]
            (unimplemented "with object environment" "docs/GAPS.md — with"))
    ;; `debugger` has no observable semantics outside a debugger and lowers to nothing.
    (SsDebugger [] 0)
    ;; A hoisted top-level declaration is already a Fun; nothing executes at its statement.
    ;; A nested declaration was bound on entry; nothing executes at the statement itself.
    (SsFunctionDecl [fun]
                    (if (syntax-fun-lowered? fun)
                        0
                        (unimplemented "generator and async function declarations"
                                       "docs/GAPS.md — function environments")))
    (SsClassDecl [cls] (unimplemented "class definitions" "docs/GAPS.md — classes"))))

(defn lower-syntax-statements [(stmts (ArrayList i64))] (-> i64)
  (let [(mut i) 0
        (mut terminated) 0]
    (loop (if (or (>= (load i) (len stmts)) (!= (load terminated) 0))
              (break 0)
              (do
                (set! (mut terminated)
                      (lower-syntax-statement (get stmts (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load terminated)))

;; The source-level `main` is an ordinary boxed JavaScript function. A distinct compiler-owned
;; function owns the platform symbol `main`, calls that source function without raw argc/argv, and
;; is the only Return on which ARM64 applies the process-exit conversion. Keeping this call out of
;; the inliner makes both ABIs explicit in the final graph and lets ordinary source calls to `main`
;; continue to observe its boxed result.
(defn parser-install-entry-wrapper! [(start (dyn NodeOps)) (stop (dyn NodeOps))] (-> i64)
  (let [main-idx (parser-source-entry-index)
        p (parser-state)]
    (if (< main-idx 0)
        (panic "parser-install-entry-wrapper!: program has no main function")
        (let [wrapper
              ;; Darwin enters `main(int argc, char **argv)`. Only argc needs a signature slot to
              ;; describe the incoming register bank; the wrapper intentionally ignores both host
              ;; values and supplies boxed undefined for every omitted JavaScript argument.
              (fun-make start
                        (ty-tuple-of2 (ty-dyn TAG-ANY) (ty-int-bot))
                        "main")
              mem-parm
              (parm-make-slot wrapper CALL-MEM (ty-mem 1 TY-BOT) "$mem")
              (mut targets) (al-new [i64] (alloc/malloc-allocator))
              (mut ctrl-nid) (n-nid wrapper)
              (mut mem-nid) (n-nid mem-parm)
              (mut value-nid) (n-nid (dyn-undefined-make))]
          (parm-set-unknown-input! mem-parm
                                   (proj-make start 1 "entry.start.mem"))
          (n-keep! mem-parm)
          ;; A realm evaluates its Scripts in order, threading control and memory through each
          ;; root call; a function-entry program calls its source `main` once.
          (if (.script-mode p)
              (al-for [root (.scripts p)] (push! [i64] (mut targets) root))
              (push! [i64] (mut targets) main-idx))
          (al-for [target-idx (load targets)]
                  (let [syntax (syntax-fun-at target-idx)
                        target (parser-node (.fun-nid syntax))
                        c (call-make-with-mem (parser-node (load ctrl-nid)) (parser-node (load mem-nid)))]
                    (let [(mut i) 0]
                      (loop (if (> (load i) (+ (parser-abi-slots) 1))
                                (break 0)
                                (do
                                  (call-add-arg! c (dyn-undefined-make))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue)))))
                    (call-set-fptr! c (funptr-make target (.fidx syntax)))
                    (let [end (callend-make c)]
                      (callend-set-never-inline! end)
                      ;; An exception the root did not catch comes back as the sentinel: report
                      ;; it through the runtime, which exits, before any later Script runs. The
                      ;; arms merge so the wrapper keeps one Return.
                      (let [ctrl (cproj-make end RETURN-CTRL "entry.ctrl")
                            mem (proj-make end RETURN-MEM "entry.mem")
                            value (proj-make end RETURN-VALUE "entry.value")
                            iff (if-make ctrl (typetest-make value TAG-EXCEPTION))
                            arms (if-arms! iff)
                            thrown (load-make (arms-true arms) mem (heapstate-make) (con-int RT-HEAP-OFFSET-EXCEPTION-VALUE) ALIAS-EXCEPTION-VALUE (ty-dyn TAG-ANY))
                            report (jsop-make (arms-true arms) mem JS-UNCAUGHT)
                            region (region-make)
                            memphi (memphi-make region 1 TY-BOT "entry.uncaught.mem")]
                        (jsop-add-arg! report thrown)
                        (region-add-path! region (arms-true arms))
                        (memphi-add-state! memphi (proj-make report 1 "entry.uncaught.mem"))
                        (region-add-path! region (arms-false arms))
                        (memphi-add-state! memphi mem)
                        (set! (mut ctrl-nid) (n-nid region))
                        (set! (mut mem-nid) (n-nid memphi))
                        (set! (mut value-nid) (n-nid value))))))
          (let [ret (return-make (parser-node (load ctrl-nid))
                                 (Some (parser-node (load mem-nid)))
                                 (parser-node (load value-nid))
                                 (None [(dyn NodeOps)])
                                 (Some wrapper))]
            (fun-set-ret! wrapper ret)
            (stop-add-return! stop ret))
          (al-free! [i64] (mut targets))
          (n-unkeep! mem-parm)
          (set! (.entry-fun-nid p) (n-nid wrapper))
          0))))

;; Script is a grammar goal, not source text wrapped in a function. Its statement spans remain
;; original, Return is forbidden even in nested blocks, and declarations named main are ordinary
;; declarations. A private zero-argument Fun is only its AOT execution container. A realm is an
;; ordered list of Scripts sharing one global object (docs/DECISIONS.md, realm); each Script keeps
;; its own directive prologue and strictness. Global lexical cells shared with source functions
;; remain unimplemented; those accesses fail explicitly instead of borrowing a function-local snapshot.
(defn parse-syntax-program-mode! [(src (slice u8))
                                  (script-mode bool)
                                  (syntax-only bool)] (-> i64)
  (let [(mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut sources) src)
    (let [answer (parse-syntax-scripts! (load sources) script-mode syntax-only)]
      (al-free! [(slice u8)] (mut sources))
      answer)))

;; One source's syntax pass: collect every declaration before graph construction. This is the
;; hoisting boundary; no semantic node is built while the cover grammar is still ambiguous.
(defn parse-syntax-one-source! [(src (slice u8)) (script i64) (script-mode bool) (syntax-only bool)] (-> i64)
  (do
    (lex-init! src)
    (set! (.typed-diagnostics (lexer-state)) syntax-only)
    (set! (.current-script (parser-state)) script)
    (let [(mut script-body) (al-new [i64] (alloc/malloc-allocator))
          root-index
            (if script-mode
                (let [(mut symbol) (sb-new (alloc/malloc-allocator))]
                  (sb-push-str! (mut symbol) "$aot$.script.")
                  (sb-push-i64! (mut symbol) script)
                  (syntax-fun-reserve! (sb-str (mut symbol)) (FunDeclaration) false false 0))
                -1)]
      (if script-mode
          (do
            (set! (.script-index (parser-state)) root-index)
            (push! [i64] (mut (.scripts (parser-state))) root-index)
            (parser-push-root-context! root-index))
          0)
      (loop (let [t (peek-token)]
              (if (= (.kind t) TOK-EOF)
                  (break 0)
                  (do
                    ;; Function-entry mode admits only top-level function declarations; a Script
                    ;; is a statement list whose function declarations are hoisted Funs.
                    (if (not script-mode)
                        (if (or (token-is t "function") (token-is t "async"))
                            (syntax-mark-hoisted! (parse-syntax-function-declaration!))
                            (parse-fail "parser: expected a function declaration at byte"
                                        t))
                        (let [stmt (parse-syntax-statement)]
                          (syntax-mark-hoisted! stmt)
                          (push! [i64] (mut script-body) stmt)))
                    (continue)))))
      (if script-mode
          (let [root (syntax-fun-ptr root-index)]
            (parser-pop-context!)
            (syntax-check-directives! (load script-body))
            (set! (.return-annotation root) (ty-dyn TAG-UNDEFINED))
            (set! (.body root) (load script-body))
            (set! (.hi root) (len src))
            (set! (.hoisted root) true)
            ;; These standard global properties are non-configurable. GlobalDeclarationInstantiation
            ;; rejects a top-level lexical binding over them; block/function locals may shadow them.
            ;; Typed SyntaxError/TypeError delivery is still part of the missing exception host.
            (if (and (not syntax-only)
                     (or (syntax-script-binding? "undefined")
                         (syntax-script-binding? "Infinity")
                         (syntax-script-binding? "NaN")))
                (panic "parser: Script lexical declaration conflicts with a restricted global property")
                0)
            (let [(mut i) 0]
              (loop (if (>= (load i) (len (.funs (parser-state))))
                        (break 0)
                        (let [f (syntax-fun-at (load i))]
                          (if (and (not (syntax-script-root? (load i)))
                                   (syntax-top-level-declaration? (load i)))
                              (do
                                (if (and (not syntax-only)
                                         (syntax-restricted-global? (.name f)))
                                    (panic "parser: Script function cannot replace a non-writable global property")
                                    0)
                                (if (syntax-script-binding? (.name f))
                                    (syntax-error! "parser: Script lexical declaration conflicts with a function declaration")
                                    0))
                              0)
                          (set! (mut i) (+ (load i) 1))
                          (continue))))))
          0))
    0))

(defn parse-syntax-scripts! [(sources (ArrayList (slice u8)))
                             (script-mode bool)
                             (syntax-only bool)] (-> i64)
  (do
    (parser-reset!)
    (set! (.script-mode (parser-state)) script-mode)
    (set! (.syntax-only (parser-state)) syntax-only)
    (set! (.strict-pending (parser-state)) false)
    (set! (.script-index (parser-state)) -1)
    (if (and (not script-mode) (!= (len sources) 1))
        (panic "parser: function-entry mode compiles exactly one source")
        0)
    (let [(mut si) 0]
      (loop (if (>= (load si) (len sources))
                (break 0)
                (do
                  (parse-syntax-one-source! (get sources (load si)) (load si) script-mode syntax-only)
                  (set! (mut si) (+ (load si) 1))
                  (continue)))))
    (if script-mode (do (syntax-declare-intrinsics!) (syntax-collect-globals!)) 0)
    (syntax-settle-strictness!)
    (syntax-check-cover-initializers!)
    (al-for [f (.funs (parser-state))]
            (let [fun f]
              (syntax-check-declarations! (.body fun)
                                          (syntax-fun-bound-names fun)
                                          true
                                          true
                                          (.strict fun))
              (let [(mut labels) (al-new [(slice u8)] (alloc/malloc-allocator))
                    (mut loop-labels) (al-new [(slice u8)] (alloc/malloc-allocator))]
                (syntax-check-jumps! (.body fun)
                                     (mut labels)
                                     (mut loop-labels)
                                     0
                                     0))))
    ;; Strict code runs (docs/DECISIONS.md, strict code runs): its early errors are checked above,
    ;; a strict function's receiver is taken as it is (`lower-this`), and a strict write to a
    ;; non-writable global is a TypeError (`lower-ref-put!`).
    (syntax-check-strict-functions!)
    (syntax-compute-may-throw!)))

;; ---------------------------------------------------------------------------
;; Which functions can complete with the exception sentinel
;;
;; The truth is the type: a callee's return type carries TAG-EXCEPTION exactly when a throw path
;; reaches its Return, and `lower-exception-check!` folds to nothing where the type excludes it.
;; This syntactic fixpoint is an optimization over that truth: a direct call to a function it
;; proves cannot throw gets no test built at all (the result is narrowed by a Cast instead), which
;; keeps the parse volume and the optimizer's work proportional to the calls that can throw. A
;; function throws directly when a `throw`, a call whose target the syntax cannot name (a value, a
;; member, a constructor, a reassigned global), a property access (a TypeError on undefined or
;; null), an `instanceof` (a TypeError on a non-callable right operand) or a strict write to a
;; restricted global sits outside every try-with-catch in its body; it throws indirectly when a
;; directly named callee may throw. Shadowing a hoisted name with a local binding still counts as a
;; call to the hoisted function.
;;
;; The filter can only under-approximate by missing a throwing construct, and that is caught: a
;; body whose lowering emits a propagation path (`parser-note-propagation!`) while the filter said
;; it cannot throw is a hard error naming the function, never a silent miscompile.

(defn syntax-fun-may-throw? [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (.may-throw f)))

;; Walk one function's statements once, recording direct throws and named call edges.
;; `protected` is true inside a try body that has a catch clause.
(defn syntax-throw-walk-expr! [(id i64) (protected bool) (direct (mut bool)) (edges (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-node id)
      (SxCall [callee args optional]
              (if protected
                  0
                  (match (syntax-node (syntax-ungroup-id callee))
                    (SxName [name]
                            (let [idx (syntax-find-fun name)
                                  g (syntax-global-index name)]
                              (if (or (< idx 0) (and (>= g 0) (.assigned (syntax-global-ptr g))))
                                  (set! direct true)
                                  (push! [i64] (mut edges) idx))))
                    (_ (set! direct true)))))
      (SxNew [callee args] (if protected 0 (set! direct true)))
      ;; A property access on undefined or null is a TypeError.
      (SxMember [owner name optional] (if protected 0 (set! direct true)))
      (SxIndex [owner key optional] (if protected 0 (set! direct true)))
      ;; `instanceof` with a non-callable right operand is a TypeError. The operator is recorded
      ;; by its JSL entry point (a campaign found the source spelling compared here: the filter
      ;; then cleared every function whose only throw was an `instanceof`).
      (SxBinary [op left right] (if (and (not protected) (= op "JsInstanceof")) (set! direct true) 0))
      ;; A strict write to `undefined`, `NaN` or `Infinity` is a TypeError; sloppy code ignores it,
      ;; but the filter does not know the function's strictness here and stays conservative.
      (SxAssign [target value]
                (if protected
                    0
                    (match (syntax-node (syntax-ungroup-id target))
                      (SxName [name] (if (syntax-restricted-global? name) (set! direct true) 0))
                      (_ 0))))
      (_ 0))
    (let [(mut kids) (al-new [i64] (alloc/malloc-allocator))]
      (syntax-expr-children! id (mut kids))
      (al-for [k (load kids)] (syntax-throw-walk-expr! k protected (mut direct) (mut edges)))
      (al-free! [i64] (mut kids))
      0)))

(defn syntax-throw-walk-stmt! [(id i64) (protected bool) (direct (mut bool)) (edges (mut (ArrayList i64)))] (-> i64)
  (match (syntax-stmt-node id)
    (SsThrow [value]
             (do
               (if protected 0 (set! direct true))
               (syntax-throw-walk-expr! value protected (mut direct) (mut edges))))
    (SsTry [body catch-param catch-body finally-body]
           (do
             (syntax-throw-walk-stmt! body (or protected (match catch-body (Some [_] true) (None [] false))) (mut direct) (mut edges))
             (match catch-body (Some [h] (syntax-throw-walk-stmt! h protected (mut direct) (mut edges))) (None [] 0))
             (match finally-body (Some [t] (syntax-throw-walk-stmt! t protected (mut direct) (mut edges))) (None [] 0))))
    (_
     (let [(mut kids) (al-new [i64] (alloc/malloc-allocator))
           (mut exprs) (al-new [i64] (alloc/malloc-allocator))]
       (syntax-stmt-exprs! id (mut exprs))
       (al-for [e (load exprs)] (syntax-throw-walk-expr! e protected (mut direct) (mut edges)))
       (syntax-stmt-children! id (mut kids))
       (al-for [k (load kids)] (syntax-throw-walk-stmt! k protected (mut direct) (mut edges)))
       (al-free! [i64] (mut exprs))
       (al-free! [i64] (mut kids))
       0))))

(defn syntax-compute-may-throw! [] (-> i64)
  (let [p (parser-state)
        count (len (.funs p))
        (mut edge-from) (al-new [i64] (alloc/malloc-allocator))
        (mut edge-to) (al-new [i64] (alloc/malloc-allocator))
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break 0)
              (let [f (syntax-fun-ptr (load i))
                    (mut direct) false
                    (mut edges) (al-new [i64] (alloc/malloc-allocator))]
                (al-for [id (.body f)] (syntax-throw-walk-stmt! id false (mut direct) (mut edges)))
                (match (.expression-body f)
                  (Some [e] (syntax-throw-walk-expr! e false (mut direct) (mut edges)))
                  (None [] 0))
                (set! (.may-throw f) (load direct))
                (al-for [t (load edges)]
                        (do (push! [i64] (mut edge-from) (load i)) (push! [i64] (mut edge-to) t)))
                (al-free! [i64] (mut edges))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; Propagate along call edges to a fixpoint.
    (let [(mut changed) true]
      (loop (if (not (load changed))
                (break 0)
                (do
                  (set! (mut changed) false)
                  (let [(mut e) 0]
                    (loop (if (>= (load e) (len (load edge-from)))
                              (break 0)
                              (let [from (syntax-fun-ptr (get (load edge-from) (load e)))
                                    to (get (load edge-to) (load e))]
                                (if (and (not (.may-throw from)) (syntax-fun-may-throw? to))
                                    (do (set! (.may-throw from) true) (set! (mut changed) true))
                                    0)
                                (set! (mut e) (+ (load e) 1))
                                (continue)))))
                  (continue)))))
    (al-free! [i64] (mut edge-from))
    (al-free! [i64] (mut edge-to))
    0))

;; ---------------------------------------------------------------------------
;; The realm's var-like globals
;;
;; Every top-level `var` and function declaration of every Script is a property of the one global
;; object from the start. Functions are recorded first so a same-Script `var` of the same name
;; keeps the function's instantiation; a second function declaration anywhere means the name is
;; reassigned at some Script's instantiation, so calls to it go through the loaded value.

(defn syntax-script-root? [(i i64)] (-> bool)
  (let [(mut found) false]
    (al-for [root (.scripts (parser-state))] (if (= root i) (set! (mut found) true) 0))
    (load found)))

(defn syntax-global-index [(name (slice u8))] (-> i64)
  (let [globals (.globals (parser-state))
        (mut i) 0]
    (loop (if (>= (load i) (len globals))
              (break -1)
              (let [b (get globals (load i))]
                (if (= (.name b) name)
                    (break (load i))
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn syntax-global-ptr [(g i64)] (-> (ptr GlobalBinding))
  (al-elem [GlobalBinding] (mut (.globals (parser-state))) g))

(defn syntax-global-declare! [(name (slice u8)) (script i64) (fun i64)] (-> i64)
  (let [existing (syntax-global-index name)]
    (if (< existing 0)
        (do
          (push! [GlobalBinding]
                 (mut (.globals (parser-state)))
                 (GlobalBinding :name name :script script :fun fun :assigned false))
          0)
        (let [g (syntax-global-ptr existing)]
          (if (>= fun 0)
              (do
                (if (>= (.fun g) 0) (set! (.assigned g) true) 0)
                (set! (.fun g) fun))
              0)
          0))))

(defn syntax-mark-assigned-global! [(name (slice u8))] (-> i64)
  (let [g (syntax-global-index name)]
    (if (>= g 0) (do (set! (.assigned (syntax-global-ptr g)) true) 0) 0)))

;; Every name an assignment target can store to. Patterns are walked conservatively: any name
;; appearing inside one counts, whether or not it is a binding position.
(defn syntax-mark-assigned-target! [(target i64)] (-> i64)
  (match (syntax-node target)
    (SxName [name] (syntax-mark-assigned-global! name))
    (SxGroup [inner] (syntax-mark-assigned-target! inner))
    (SxArray [elements]
             (do
               (al-for [element elements]
                       (match element
                         (ElemHole [] 0)
                         (ElemExpr [expr] (syntax-mark-assigned-target! expr))
                         (ElemSpread [expr] (syntax-mark-assigned-target! expr))))
               0))
    (SxObject [entries]
              (do
                (al-for [entry entries]
                        (match entry
                          (PropValue [key value] (syntax-mark-assigned-target! value))
                          (PropCoverInit [name init] (syntax-mark-assigned-global! name))
                          (PropSpread [expr] (syntax-mark-assigned-target! expr))
                          (_ 0)))
                0))
    (SxAssign [inner value] (syntax-mark-assigned-target! inner))
    (_ 0)))

(defn syntax-mark-assigned-pattern! [(pattern i64)] (-> i64)
  (let [(mut names) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (syntax-pattern-names! pattern (mut names))
    (al-for [name (load names)] (syntax-mark-assigned-global! name))
    (al-free! [(slice u8)] (mut names))
    0))

(defn syntax-mark-assigned-globals! [] (-> i64)
  (do
    (al-for [x (.exprs (parser-state))]
            (let [expr x]
              (match (.node expr)
                (SxAssign [target value] (syntax-mark-assigned-target! target))
                (SxCompoundAssign [op target value] (syntax-mark-assigned-target! target))
                (SxLogicalAssign [predicate rhs-on-true target value] (syntax-mark-assigned-target! target))
                (SxUpdate [op prefix target] (syntax-mark-assigned-target! target))
                (_ 0))))
    (al-for [st (.stmts (parser-state))]
            (let [stmt st]
              (match (.node stmt)
                (SsVar [name init annotation]
                       (match init (Some [e] (syntax-mark-assigned-global! name)) (None [] 0)))
                (SsVarPattern [pattern init] (syntax-mark-assigned-pattern! pattern))
                (SsForIn [head of right body awaited]
                         (match head
                           (ForInitDecl [decl]
                                        (match (syntax-stmt-node decl)
                                          (SsVar [name init annotation] (syntax-mark-assigned-global! name))
                                          (SsVarPattern [pattern init] (syntax-mark-assigned-pattern! pattern))
                                          (_ 0)))
                           (ForInitExpr [expr] (syntax-mark-assigned-target! expr))
                           (ForInitPattern [pattern] (syntax-mark-assigned-pattern! pattern))
                           (ForNoInit [] 0)))
                (_ 0))))
    0))

;; ---------------------------------------------------------------------------
;; Standard globals — the builtin library (docs/DECISIONS.md, intrinsics)
;;
;; A standard global is a hoisted function whose body is one JSL builtin: `Error(m)` is the
;; function record `Error(a0)` with the expression body `(SxIntrinsic "JsIntrinsicError" [this,
;; Error, a0])`. Everything else — its Fun, its function object with a `prototype` object, direct
;; and value calls, inlining, `new`, `instanceof` — is what every source function already gets.
;; Only the intrinsics a program names (and the ones those depend on, an Error subclass's parent)
;; are materialized: the realm is closed, so the rest simply do not exist in it.

(defstruct Intrinsic
  [(name (slice u8))
   (builtin (slice u8))
   (arity i64)
   (parent (slice u8))   ; a constructor whose prototype heads this one's prototype chain, or ""
   (setup i64)  ; what CreateIntrinsics gives its prototype (`realm-image-build!`)
   (owner (slice u8))  ; a method: the constructor whose object carries it, or "" for a constructor
   (prop (slice u8))  ; a method: its property name
   (target i64)])  ; a method: which of the owner's objects carries it

;; The prototype needs nothing beyond `constructor`.
(const INTRINSIC-SETUP-NONE 0)

;; An Error constructor: `prototype.name`, `prototype.message` "" and, for a NativeError, the
;; chain to the parent's prototype (ECMA-262 §20.5.3, §20.5.6.3).
(const INTRINSIC-SETUP-ERROR-PROTOTYPE 1)

;; A constructor: a global binding. Its body receives (this, its own function object, args...).
(const INTRINSIC-TARGET-GLOBAL 0)

;; A method of the owner's `prototype` object. Its body receives (this, args...).
(const INTRINSIC-TARGET-PROTOTYPE 1)

;; A static method of the owner's own function object. Its body receives (this, args...).
(const INTRINSIC-TARGET-CONSTRUCTOR 2)

(defn intrinsic-method? [(entry Intrinsic)] (-> bool)
  (!= (.owner entry) ""))

(defn intrinsic-ctor [(name (slice u8)) (builtin (slice u8)) (arity i64) (parent (slice u8)) (setup i64)] (-> Intrinsic)
  (Intrinsic :name name :builtin builtin :arity arity :parent parent :setup setup
             :owner "" :prop "" :target INTRINSIC-TARGET-GLOBAL))

(defn intrinsic-method [(owner (slice u8)) (target i64) (prop (slice u8)) (builtin (slice u8)) (arity i64)] (-> Intrinsic)
  (let [(mut b) (sb-new (alloc/malloc-allocator))]
    (sb-push-str! (mut b) owner)
    (sb-push-str! (mut b) (if (= target INTRINSIC-TARGET-PROTOTYPE) ".prototype." "."))
    (sb-push-str! (mut b) prop)
    (Intrinsic :name (sb-str (mut b)) :builtin builtin :arity arity :parent "" :setup INTRINSIC-SETUP-NONE
               :owner owner :prop prop :target target)))

(defn intrinsic-table [] (-> (ArrayList Intrinsic))
  (let [(mut t) (al-new [Intrinsic] (alloc/malloc-allocator))]
    (push! [Intrinsic] (mut t) (intrinsic-ctor "Object" "JsIntrinsicObject" 1 "" INTRINSIC-SETUP-NONE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "String" "JsIntrinsicString" 1 "" INTRINSIC-SETUP-NONE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "Number" "JsIntrinsicNumber" 1 "" INTRINSIC-SETUP-NONE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "Boolean" "JsIntrinsicBoolean" 1 "" INTRINSIC-SETUP-NONE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "Function" "JsIntrinsicFunction" 1 "" INTRINSIC-SETUP-NONE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "Error" "JsIntrinsicError" 1 "" INTRINSIC-SETUP-ERROR-PROTOTYPE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "TypeError" "JsIntrinsicError" 1 "Error" INTRINSIC-SETUP-ERROR-PROTOTYPE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "RangeError" "JsIntrinsicError" 1 "Error" INTRINSIC-SETUP-ERROR-PROTOTYPE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "SyntaxError" "JsIntrinsicError" 1 "Error" INTRINSIC-SETUP-ERROR-PROTOTYPE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "ReferenceError" "JsIntrinsicError" 1 "Error" INTRINSIC-SETUP-ERROR-PROTOTYPE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "EvalError" "JsIntrinsicError" 1 "Error" INTRINSIC-SETUP-ERROR-PROTOTYPE))
    (push! [Intrinsic] (mut t) (intrinsic-ctor "URIError" "JsIntrinsicError" 1 "Error" INTRINSIC-SETUP-ERROR-PROTOTYPE))
    ;; Arrays (docs/DECISIONS.md, arrays; ECMA-262 §23.1). The constructor admits four arguments;
    ;; a call with more refuses by name (the slot ABI carries no count).
    (push! [Intrinsic] (mut t) (intrinsic-ctor "Array" "JsIntrinsicArray" 4 "" INTRINSIC-SETUP-NONE))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-CONSTRUCTOR "isArray" "JsArrayIsArray" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "push" "JsArrayPush" 4))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "pop" "JsArrayPop" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "shift" "JsArrayShift" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "unshift" "JsArrayUnshift" 4))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "at" "JsArrayAt" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "indexOf" "JsArrayIndexOf" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "includes" "JsArrayIncludes" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "join" "JsArrayJoin" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "toString" "JsArrayToString" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "reverse" "JsArrayReverse" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "slice" "JsArraySlice" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "concat" "JsArrayConcat" 4))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "forEach" "JsArrayForEach" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "map" "JsArrayMap" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "filter" "JsArrayFilter" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "some" "JsArraySome" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "every" "JsArrayEvery" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "find" "JsArrayFind" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "findIndex" "JsArrayFindIndex" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Array" INTRINSIC-TARGET-PROTOTYPE "reduce" "JsArrayReduce" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-CONSTRUCTOR "fromCharCode" "JsStringFromCharCode" 4))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "charAt" "JsStringCharAt" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "charCodeAt" "JsStringCharCodeAt" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "at" "JsStringAt" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "indexOf" "JsStringIndexOf" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "lastIndexOf" "JsStringLastIndexOf" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "includes" "JsStringIncludes" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "startsWith" "JsStringStartsWith" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "endsWith" "JsStringEndsWith" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "slice" "JsStringSlice" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "substring" "JsStringSubstring" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "concat" "JsStringConcat" 4))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "trim" "JsStringTrim" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "trimStart" "JsStringTrimStart" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "trimEnd" "JsStringTrimEnd" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "repeat" "JsStringRepeat" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "toString" "JsStringToStringMethod" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "valueOf" "JsStringValueOf" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "split" "JsStringSplit" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "padStart" "JsStringPadStart" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "String" INTRINSIC-TARGET-PROTOTYPE "padEnd" "JsStringPadEnd" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Function" INTRINSIC-TARGET-PROTOTYPE "call" "JsFunctionCall" 4))
    (push! [Intrinsic] (mut t) (intrinsic-method "Function" INTRINSIC-TARGET-PROTOTYPE "apply" "JsFunctionApply" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Object" INTRINSIC-TARGET-CONSTRUCTOR "create" "JsObjectCreate" 2))
    (push! [Intrinsic] (mut t) (intrinsic-method "Object" INTRINSIC-TARGET-CONSTRUCTOR "getPrototypeOf" "JsObjectGetPrototypeOf" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Object" INTRINSIC-TARGET-CONSTRUCTOR "keys" "JsObjectKeys" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Object" INTRINSIC-TARGET-PROTOTYPE "hasOwnProperty" "JsObjectHasOwnProperty" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Object" INTRINSIC-TARGET-PROTOTYPE "toString" "JsObjectToStringMethod" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "Object" INTRINSIC-TARGET-PROTOTYPE "valueOf" "JsObjectValueOf" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "Object" INTRINSIC-TARGET-PROTOTYPE "isPrototypeOf" "JsObjectIsPrototypeOf" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Object" INTRINSIC-TARGET-PROTOTYPE "propertyIsEnumerable" "JsObjectPropertyIsEnumerable" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Number" INTRINSIC-TARGET-PROTOTYPE "toString" "JsNumberToStringMethod" 1))
    (push! [Intrinsic] (mut t) (intrinsic-method "Number" INTRINSIC-TARGET-PROTOTYPE "valueOf" "JsNumberValueOf" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "Boolean" INTRINSIC-TARGET-PROTOTYPE "toString" "JsBooleanToStringMethod" 0))
    (push! [Intrinsic] (mut t) (intrinsic-method "Boolean" INTRINSIC-TARGET-PROTOTYPE "valueOf" "JsBooleanValueOf" 0))
    (load t)))

(defn intrinsic-index [(table (ArrayList Intrinsic)) (name (slice u8))] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop (if (or (>= (load i) (len table)) (>= (load found) 0))
              (break 0)
              (do
                (let [entry (get table (load i))]
                  (if (= (.name entry) name) (set! (mut found) (load i)) 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; Does any expression in the realm name `name` as an identifier?
(defn syntax-names-identifier? [(name (slice u8))] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) (len (.exprs (parser-state)))) (load found))
              (break 0)
              (do
                (let [x (get (.exprs (parser-state)) (load i))]
                  (match (.node x)
                    (SxName [n] (if (= n name) (set! (mut found) true) 0))
                    (_ 0)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

(defn syntax-intrinsic-fun? [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (and (.hoisted f) (< (.script f) 0))))

;; Reserve the function record and the global binding of one intrinsic (once).
(defn syntax-declare-intrinsic! [(entry Intrinsic)] (-> i64)
  (if (>= (syntax-find-fun (.name entry)) 0)
      0
      (let [index (syntax-fun-reserve! (.name entry) (FunDeclaration) false false 0)
            fp (syntax-fun-ptr index)
            (mut args) (al-new [i64] (alloc/malloc-allocator))
            (mut i) 0]
        (set! (.hoisted fp) true)
        (set! (.script fp) -1)
        (set! (.parent fp) -1)
        ;; A built-in function receives `this` as the caller passed it (ECMA-262 §10.3: built-ins
        ;; are not sloppy functions); no receiver mapping at its entry.
        (set! (.strict fp) true)
        ;; A constructor's body is (this new.target callee a0 a1 ...): the receiver, `new.target`
        ;; (undefined when called, the constructor when constructed: how the body tells the two
        ;; apart), the constructor's own function object (its `prototype` is what a plain call
        ;; still needs), then the arguments. A method's is (this a0 a1 ...): it has no global
        ;; binding to name itself by and no use for its own object.
        (push! [i64] (mut args) (syntax-add-node! (SxThis) 0 0))
        (if (intrinsic-method? entry)
            0
            (do
              (push! [i64] (mut args) (syntax-add-node! (SxNewTarget) 0 0))
              (push! [i64] (mut args) (syntax-add-node! (SxName :name (.name entry)) 0 0))))
        (loop (if (>= (load i) (.arity entry))
                  (break 0)
                  (let [(mut sb) (sb-new (alloc/malloc-allocator))]
                    (sb-push-str! (mut sb) "$aot$arg")
                    (sb-push-i64! (mut sb) (load i))
                    (let [pname (sb-str (mut sb))]
                      (push! [(slice u8)] (mut (.params fp)) pname)
                      (push! [i64] (mut (.param-annotations fp)) (ty-dyn TAG-ANY))
                      (push! [(Option i64)] (mut (.param-defaults fp)) (None [i64]))
                      (push! [(Option i64)] (mut (.param-patterns fp)) (None [i64]))
                      (push! [i64] (mut args) (syntax-add-node! (SxName :name pname) 0 0)))
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (set! (.expression-body fp)
              (Some (syntax-add-node! (SxIntrinsic :builtin (.builtin entry) :args (load args)) 0 0)))
        (if (intrinsic-method? entry) 0 (syntax-global-declare! (.name entry) -1 index))
        0)))

;; Materialize the intrinsics the program names, with their parents. Runs before the Scripts'
;; own declarations so a Script redefining `Object` shadows it as JavaScript says it does.
(defn syntax-declare-intrinsics! [] (-> i64)
  (let [table (intrinsic-table) (mut i) 0]
    ;; The language itself throws TypeErrors (a call on a non-callable, a property of null), so
    ;; %TypeError.prototype% exists in every realm.
    (syntax-declare-intrinsic! (get table (intrinsic-index table "Error")))
    (syntax-declare-intrinsic! (get table (intrinsic-index table "TypeError")))
    ;; Arrays: an array literal or the name materializes `Array`, with `Object` (whose prototype
    ;; heads %Array.prototype%'s chain) and `RangeError` (which an invalid length throws).
    (if (or (syntax-names-identifier? "Array") (syntax-uses-array-literal?))
        (do
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Object")))
          (syntax-declare-intrinsic! (get table (intrinsic-index table "RangeError")))
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Array"))))
        0)
    ;; Strings: a primitive string's properties resolve on %String.prototype% (docs/DECISIONS.md,
    ;; strings). The prototype exists when the program names `String` or names one of its methods
    ;; as a member; closed-world property names decide, as for the other intrinsics (a computed
    ;; key spelling a method name at run time is the same approximation `this['Error']` makes).
    ;; Functions: `Function.prototype` is every function object's [[Prototype]] (docs/DECISIONS.md,
    ;; function objects); it exists when the program names `Function` or one of its methods.
    (if (or (syntax-names-identifier? "Function") (syntax-names-member? "call") (syntax-names-member? "apply"))
        (do
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Object")))
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Function"))))
        0)
    ;; Numbers and booleans: their prototypes carry `toString` and `valueOf`, which a primitive
    ;; receiver reaches through %Number.prototype% and %Boolean.prototype%; `Object.prototype` is
    ;; every chain's end. Named `toString`/`valueOf` materialize all three.
    (if (or (syntax-names-identifier? "Object") (syntax-names-member? "toString") (syntax-names-member? "valueOf")
            (syntax-names-member? "hasOwnProperty") (syntax-names-member? "isPrototypeOf") (syntax-names-member? "propertyIsEnumerable"))
        (syntax-declare-intrinsic! (get table (intrinsic-index table "Object")))
        0)
    (if (or (syntax-names-identifier? "Number") (syntax-names-member? "toString") (syntax-names-member? "valueOf"))
        (do
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Object")))
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Number"))))
        0)
    (if (or (syntax-names-identifier? "Boolean") (syntax-names-member? "toString") (syntax-names-member? "valueOf"))
        (do
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Object")))
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Boolean"))))
        0)
    (if (or (syntax-names-identifier? "String") (syntax-uses-string-members? table))
        (do
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Object")))
          ;; `repeat` is the one String method that throws a RangeError.
          (if (syntax-names-member? "repeat")
              (syntax-declare-intrinsic! (get table (intrinsic-index table "RangeError")))
              0)
          (syntax-declare-intrinsic! (get table (intrinsic-index table "String"))))
        0)
    (loop (if (>= (load i) (len table))
              (break 0)
              (let [entry (get table (load i))]
                (if (and (not (intrinsic-method? entry)) (syntax-names-identifier? (.name entry)))
                    (do
                      (if (!= (.parent entry) "")
                          (let [pi (intrinsic-index table (.parent entry))]
                            (if (< pi 0)
                                (panic "syntax-declare-intrinsics!: an intrinsic names an unknown parent")
                                (syntax-declare-intrinsic! (get table pi))))
                          0)
                      (syntax-declare-intrinsic! entry))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; The methods of a materialized owner that the program names as a member (docs/DECISIONS.md,
    ;; strings): each method is a hoisted function compiled into the program, so the closed-world
    ;; property names decide which exist, as they decide which intrinsics exist.
    (set! (mut i) 0)
    (loop (if (>= (load i) (len table))
              (break 0)
              (let [entry (get table (load i))]
                (if (and (intrinsic-method? entry)
                         (>= (syntax-find-fun (.owner entry)) 0)
                         (syntax-names-member? (.prop entry)))
                    (syntax-declare-intrinsic! entry)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

;; Does any expression in the realm read or call a member of this name?
(defn syntax-names-member? [(name (slice u8))] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) (len (.exprs (parser-state)))) (load found))
              (break 0)
              (do
                (let [x (get (.exprs (parser-state)) (load i))]
                  (match (.node x)
                    (SxMember [owner member optional] (if (= member name) (set! (mut found) true) 0))
                    (_ 0)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; Does any expression in the realm name a String.prototype method as a member?
(defn syntax-uses-string-members? [(table (ArrayList Intrinsic))] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) (len (.exprs (parser-state)))) (load found))
              (break 0)
              (do
                (let [x (get (.exprs (parser-state)) (load i))]
                  (match (.node x)
                    (SxMember [owner name optional]
                              (let [(mut k) 0]
                                (loop (if (or (>= (load k) (len table)) (load found))
                                          (break 0)
                                          (let [entry (get table (load k))]
                                            (if (and (intrinsic-method? entry)
                                                     (= (.owner entry) "String")
                                                     (= (.target entry) INTRINSIC-TARGET-PROTOTYPE)
                                                     (= (.prop entry) name))
                                                (set! (mut found) true)
                                                0)
                                            (set! (mut k) (+ (load k) 1))
                                            (continue))))))
                    (_ 0)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; Does any expression in the realm build an array literal?
(defn syntax-uses-array-literal? [] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) (len (.exprs (parser-state)))) (load found))
              (break 0)
              (do
                (let [x (get (.exprs (parser-state)) (load i))]
                  (match (.node x)
                    (SxArray [elements] (set! (mut found) true))
                    (_ 0)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; The body of an intrinsic: its JSL builtin over the lowered operands.
(defn lower-intrinsic-call [(builtin (slice u8)) (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [(mut values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
    (al-for [a args]
            (let [v (lower-syntax-expr a)]
              (n-keep! v)
              (push! [(dyn NodeOps)] (mut values) v)))
    (let [scope (parser-node (.current-scope (parser-state)))
          r (lower-jsl-call-values builtin (load values))]
      (al-for [v (load values)] (n-unkeep! v))
      (al-free! [(dyn NodeOps)] (mut values))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (.value r))))

;; Every `this.name = …` target in a statement's own code (functions have their own `this`; their
;; bodies are separate records and are not entered).
(defn syntax-collect-this-properties! [(stmt i64) (names (mut (ArrayList (slice u8))))] (-> i64)
  (let [(mut exprs) (al-new [i64] (alloc/malloc-allocator))
        (mut stmts) (al-new [i64] (alloc/malloc-allocator))]
    (syntax-stmt-exprs! stmt (mut exprs))
    (al-for [e (load exprs)] (syntax-collect-this-properties-expr! e (mut names)))
    (syntax-stmt-children! stmt (mut stmts))
    (al-for [child (load stmts)] (syntax-collect-this-properties! child (mut names)))
    (al-free! [i64] (mut exprs))
    (al-free! [i64] (mut stmts))
    0))

(defn syntax-collect-this-properties-expr! [(id i64) (names (mut (ArrayList (slice u8))))] (-> i64)
  (do
    (match (syntax-node id)
      (SxAssign [target value]
                (match (syntax-node (syntax-ungroup-id target))
                  (SxMember [owner name optional]
                            (match (syntax-node (syntax-ungroup-id owner))
                              (SxThis [] (do (push! [(slice u8)] (mut names) name) 0))
                              (_ 0)))
                  (_ 0)))
      (_ 0))
    (let [(mut kids) (al-new [i64] (alloc/malloc-allocator))]
      (syntax-expr-children! id (mut kids))
      (al-for [k (load kids)] (syntax-collect-this-properties-expr! k (mut names)))
      (al-free! [i64] (mut kids))
      0)))

(defn syntax-collect-globals! [] (-> i64)
  (let [p (parser-state)
        (mut si) 0]
    (loop (if (>= (load si) (len (.scripts p)))
              (break 0)
              (let [root (syntax-fun-at (get (.scripts p) (load si)))
                    (mut var-names) (al-new [(slice u8)] (alloc/malloc-allocator))]
                (al-for [id (.body root)]
                        (match (syntax-stmt-node id)
                          (SsFunctionDecl [fun]
                                          (let [declared (syntax-fun-at fun)]
                                            (syntax-global-declare! (.name declared) (load si) fun)))
                          (_ 0)))
                (syntax-collect-declarations! (.body root) false (mut var-names))
                ;; `this.name = v` in a Script's own code creates a property of the global object,
                ;; which is the binding `name`: declare it with the vars, so the global object's
                ;; fixed shape holds it and both spellings read the same word.
                (al-for [id (.body root)] (syntax-collect-this-properties! id (mut var-names)))
                (al-for [name (load var-names)] (syntax-global-declare! name (load si) -1))
                (al-free! [(slice u8)] (mut var-names))
                (set! (mut si) (+ (load si) 1))
                (continue))))
    (syntax-mark-assigned-globals!)
    ;; The one hidden class the global object has once every global exists. The creation site
    ;; adds the same names in the same order, and checks that it arrived at this shape.
    (let [(mut shape) SHAPE-EMPTY]
      (al-for [g (.globals p)]
              (let [binding g]
                (set! (mut shape) (shape-transition (load shape) (.name binding)))))
      (set! (.global-shape p) (load shape)))
    0))

;; The realm's global object as a proven raw object at the current point.
(defn lower-global-object-raw [] (-> (dyn NodeOps))
  (unbox-make (lower-global-object) REP-OBJECT))

;; The Script whose code is being lowered.
(defn parser-current-script [] (-> i64)
  (let [f (syntax-fun-at (.current-fun (parser-state)))] (.script f)))

;; The Fun a call to global `g` may name directly, or -1: a never-reassigned function declaration
;; the calling Script can already see.
(defn syntax-global-direct-fun [(g i64)] (-> i64)
  (let [b (get (.globals (parser-state)) g)]
    (if (and (>= (.fun b) 0) (not (.assigned b)) (<= (.script b) (parser-current-script)))
        (.fun b)
        -1)))

;; The global object as a value: a realm's lives in the static heap image, so it is a constant
;; address everywhere. A function-entry program has no realm and reads the runtime root, which
;; holds zero.
(defn lower-global-object [] (-> (dyn NodeOps))
  (let [p (parser-state)
        scope (parser-node (.current-scope p))]
    (if (>= (heap-global-entry) 0)
        (box-make (staticref-make (heap-global-entry) REP-OBJECT))
        (realm-global-object-load (parser-node (.current-ctrl p)) (scope-mem scope)))))

(defn lower-global-load [(name (slice u8))] (-> (dyn NodeOps))
  (let [g (syntax-global-index name)
        p (parser-state)]
    (if (< g 0) (panic "lower-global-load: name is not a realm global") 0)
    ;; Top-level code of an earlier Script reading a global a later Script declares runs before
    ;; that declaration is instantiated: a ReferenceError, unimplemented. A function body resolves
    ;; the name when it is called, which is after every Script's instantiation in the common case
    ;; (the harness's functions naming the test's globals); a call made too early reads the slot's
    ;; initial undefined instead of the ReferenceError (docs/GAPS.md).
    (let [b (get (.globals p) g)]
      (if (and (> (.script b) (parser-current-script))
               (syntax-script-root? (.current-fun p)))
        (unimplemented "reference to a global declared only by a later Script (ReferenceError before its instantiation)"
                       "docs/GAPS.md — shared global-object bindings")
        0))
    (let [object (lower-global-object-raw)
          scope (parser-node (.current-scope p))
          ;; An access on the global object, an image object: it folds to the image word or to a
          ;; fixed-offset load once the closed-world facts are in (aot.node.property,
          ;; prop-image-resolve!).
          loaded (prop-access-emit (parser-node (.current-ctrl p))
                                   (scope-mem scope)
                                   object
                                   (None [(dyn NodeOps)])
                                   (shape-key-intern name)
                                   PROP-LOAD)]
      (parser-set-current-ctrl! (.ctrl loaded))
      (scope-set-mem! scope (.mem loaded))
      (.value loaded))))

(defn lower-global-store! [(name (slice u8)) (value (dyn NodeOps))] (-> i64)
  (let [g (syntax-global-index name)
        p (parser-state)]
    (if (< g 0) (panic "lower-global-store!: name is not a realm global") 0)
    (n-keep! value)
    (let [object (lower-global-object-raw)
          scope (parser-node (.current-scope p))
          stored (prop-access-emit (parser-node (.current-ctrl p))
                                   (scope-mem scope)
                                   object
                                   (Some value)
                                   (shape-key-intern name)
                                   PROP-STORE)]
      (n-unkeep! value)
      (parser-set-current-ctrl! (.ctrl stored))
      (scope-set-mem! scope (.mem stored))
      0)))

;; A `var` initializer or other named store: a Scope binding when one is visible, else the realm
;; global the syntax pass recorded. Anything else is a lowering invariant failure.
(defn lower-store-name! [(name (slice u8)) (value (dyn NodeOps))] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))]
    (if (>= (scope-find scope name) 0)
        (scope-update! scope name value)
        (if (>= (syntax-global-index name) 0)
            (lower-global-store! name value)
            (do
              (n-panic! "lower-store-name!: the name is neither a binding nor a realm global" value)
              0)))))

;; Realm creation as data: the static heap image (aot.heap, docs/DECISIONS.md, the realm image).
;;
;; Everything a realm holds before its first statement runs is laid out here, once, after the
;; header pass has given every hoisted function its Fun and index: the global object with an
;; `undefined` property per var-like global in table order (so its hidden class is the table's),
;; one function object with its `prototype` object per hoisted declaration of every Script and per
;; materialized intrinsic, the properties CreateIntrinsics gives an Error prototype, and the
;; global object's initial words — the intrinsics, then the first Script's own function
;; declarations in order, later declarations winning, exactly the stores GlobalDeclarationInstantiation
;; would have made before that Script's first statement. A later Script's function step stays a
;; store at its start (`lower-global-instantiation!`): the first Script runs before it and must
;; still see `undefined`.
(defn realm-image-build! [] (-> i64)
  (let [p (parser-state)
        table (intrinsic-table)
        global (heap-add-object! DYNAMIC-NULL-WORD)
        (mut fi) 0]
    (al-for [g (.globals p)]
            (let [binding g]
              (heap-define-own! global (.name binding) DYNAMIC-UNDEFINED-WORD HEAP-WORD-CONST)))
    ;; The table's shape and the built object's shape must be one and the same hidden class;
    ;; every later global access is a field access over that layout.
    (if (!= (heap-storage-shape global) (.global-shape p))
        (panic-i "realm-image-build!: the global object does not have the table's shape" (heap-storage-shape global))
        0)
    ;; Function objects: every hoisted declaration and intrinsic, MakeConstructor included.
    (loop (if (>= (load fi) (len (.funs p)))
              (break 0)
              (let [f (syntax-fun-at (load fi))]
                (if (and (.hoisted f) (not (syntax-script-root? (load fi))))
                    (do
                      (if (not (syntax-fun-lowered? (load fi)))
                          (unimplemented "methods, accessors, generators and async functions as values"
                                         "docs/GAPS.md — function values and closures")
                          0)
                      (let [fobj (heap-add-function! (.fidx f) DYNAMIC-NULL-WORD)
                            proto (heap-add-object! DYNAMIC-NULL-WORD)
                            fp (syntax-fun-ptr (load fi))]
                        (heap-define-own! proto "constructor" (heap-ref-word DYNAMIC-PREFIX-FUNCTION fobj) HEAP-WORD-REF)
                        (heap-define-own! fobj "prototype" (heap-ref-word DYNAMIC-PREFIX-OBJECT proto) HEAP-WORD-REF)
                        (set! (.static-entry fp) fobj)
                        ;; The pointer escapes into a value: the Fun is never inlined away from
                        ;; under its address. Callers stay closed-world: every value call site links
                        ;; the finite set, so parameter evidence still comes from actual arguments.
                        (set! (.value-taken fp) true)
                        (fun-set-escapes! (parser-node (.fun-nid f)))
                        ;; The code word is typed as the finite set of every value-taken function;
                        ;; the linker (`opto-link-cg!`) resolves each index through the registry a
                        ;; FunPtr would have filled.
                        (arena-register-function! (.fidx f) (parser-node (.fun-nid f)))))
                    0)
                (set! (mut fi) (+ (load fi) 1))
                (continue))))
    ;; Intrinsics: constructors into their global slots, methods onto their owner's objects, then
    ;; each constructor's prototype setup.
    (set! (mut fi) 0)
    (loop (if (>= (load fi) (len (.funs p)))
              (break 0)
              (do
                (if (syntax-intrinsic-fun? (load fi))
                    (let [f (syntax-fun-at (load fi))
                          entry (get table (intrinsic-index table (.name f)))]
                      (if (intrinsic-method? entry)
                          0
                          (heap-define-own! global (.name f) (heap-ref-word DYNAMIC-PREFIX-FUNCTION (.static-entry f)) HEAP-WORD-REF)))
                    0)
                (set! (mut fi) (+ (load fi) 1))
                (continue))))
    (set! (mut fi) 0)
    (loop (if (>= (load fi) (len (.funs p)))
              (break 0)
              (do
                (if (syntax-intrinsic-fun? (load fi))
                    (let [f (syntax-fun-at (load fi))
                          entry (get table (intrinsic-index table (.name f)))]
                      (if (intrinsic-method? entry)
                          (let [owner (syntax-fun-at (syntax-find-fun (.owner entry)))
                                carrier (if (= (.target entry) INTRINSIC-TARGET-PROTOTYPE)
                                            (realm-image-prototype-of (.static-entry owner))
                                            (.static-entry owner))]
                            (heap-define-own! carrier (.prop entry) (heap-ref-word DYNAMIC-PREFIX-FUNCTION (.static-entry f)) HEAP-WORD-REF))
                          0))
                    0)
                (set! (mut fi) (+ (load fi) 1))
                (continue))))
    ;; %Array.prototype% for `%ArrayPrototype`; and with `Object` materialized, every intrinsic
    ;; prototype that heads its own chain continues to %Object.prototype% (ECMA-262 §20.5.3.1,
    ;; §23.1.3.1: the prototypes of Error and Array are ordinary objects on Object.prototype).
    (let [object-fun (syntax-find-fun "Object")
          function-fun (syntax-find-fun "Function")]
      ;; Every materialized constructor's prototype is a well-known intrinsic the lowering may name
      ;; (`%IntrinsicPrototype "Array.prototype"`).
      (set! (mut fi) 0)
      (loop (if (>= (load fi) (len (.funs p)))
                (break 0)
                (do
                  (if (syntax-intrinsic-fun? (load fi))
                      (let [f (syntax-fun-at (load fi))
                            entry (get table (intrinsic-index table (.name f)))]
                        (if (intrinsic-method? entry)
                            0
                            (let [(mut sb) (sb-new (alloc/malloc-allocator))]
                              (sb-push-str! (mut sb) (.name f))
                              (sb-push-str! (mut sb) ".prototype")
                              (heap-set-intrinsic! (sb-str (mut sb)) (realm-image-prototype-of (.static-entry f))))))
                      0)
                  (set! (mut fi) (+ (load fi) 1))
                  (continue))))
      ;; With `Function` materialized, every function object in the image has %Function.prototype%
      ;; as its [[Prototype]] (§10.2.3 MakeConstructor / OrdinaryFunctionCreate), including the
      ;; intrinsics themselves.
      (if (>= function-fun 0)
          (let [function-syntax (syntax-fun-at function-fun)
                function-proto (realm-image-prototype-of (.static-entry function-syntax))]
            (set! (mut fi) 0)
            (loop (if (>= (load fi) (len (.funs p)))
                      (break 0)
                      (do
                        (let [f (syntax-fun-at (load fi))]
                          (if (>= (.static-entry f) 0)
                              (heap-set-prototype! (.static-entry f) (heap-ref-word DYNAMIC-PREFIX-OBJECT function-proto) HEAP-WORD-REF)
                              0))
                        (set! (mut fi) (+ (load fi) 1))
                        (continue)))))
          0)
      (if (>= object-fun 0)
          (let [object-syntax (syntax-fun-at object-fun)
                object-proto (realm-image-prototype-of (.static-entry object-syntax))]
            (set! (mut fi) 0)
            (loop (if (>= (load fi) (len (.funs p)))
                      (break 0)
                      (do
                        (if (and (syntax-intrinsic-fun? (load fi)) (!= (load fi) object-fun))
                            (let [f (syntax-fun-at (load fi))
                                  entry (get table (intrinsic-index table (.name f)))]
                              (if (and (not (intrinsic-method? entry)) (= (.parent entry) ""))
                                  (heap-set-prototype! (realm-image-prototype-of (.static-entry f))
                                                       (heap-ref-word DYNAMIC-PREFIX-OBJECT object-proto)
                                                       HEAP-WORD-REF)
                                  0))
                            ;; A hoisted source function's `prototype` object is an ordinary object
                            ;; on %Object.prototype% (MakeConstructor).
                            (let [f (syntax-fun-at (load fi))]
                              (if (and (.hoisted f)
                                       (not (syntax-intrinsic-fun? (load fi)))
                                       (not (syntax-script-root? (load fi)))
                                       (>= (.static-entry f) 0))
                                  (heap-set-prototype! (realm-image-prototype-of (.static-entry f))
                                                       (heap-ref-word DYNAMIC-PREFIX-OBJECT object-proto)
                                                       HEAP-WORD-REF)
                                  0)))
                        (set! (mut fi) (+ (load fi) 1))
                        (continue)))))
          0))
    (set! (mut fi) 0)
    (loop (if (>= (load fi) (len (.funs p)))
              (break 0)
              (do
                (if (syntax-intrinsic-fun? (load fi))
                    (let [f (syntax-fun-at (load fi))
                          entry (get table (intrinsic-index table (.name f)))]
                      (if (= (.setup entry) INTRINSIC-SETUP-ERROR-PROTOTYPE)
                          (realm-image-error-prototype! (.static-entry f) (.parent entry) (.name f))
                          (if (= (.setup entry) INTRINSIC-SETUP-NONE)
                              0
                              (panic-i "realm-image-build!: unknown intrinsic setup" (.setup entry)))))
                    0)
                (set! (mut fi) (+ (load fi) 1))
                (continue))))
    ;; The first Script's function step.
    (if (> (len (.scripts p)) 0)
        (let [root (syntax-fun-at (get (.scripts p) 0))]
          (al-for [id (.body root)]
                  (match (syntax-stmt-node id)
                    (SsFunctionDecl [fun]
                                    (let [declared (syntax-fun-at fun)]
                                      (heap-define-own! global
                                                        (.name declared)
                                                        (heap-ref-word DYNAMIC-PREFIX-FUNCTION (.static-entry declared))
                                                        HEAP-WORD-REF)))
                    (_ 0)))
          0)
        0)
    (heap-set-global! global)
    0))

;; The `prototype` object of an image function object.
(defn realm-image-prototype-of [(fobj i64)] (-> i64)
  (heap-ref-entry (heap-own-word fobj "prototype")))

;; An Error constructor's prototype: own data properties `name` (the constructor's name) and
;; `message` (the empty string), and for a NativeError the [[Prototype]] link to `Error.prototype`.
(defn realm-image-error-prototype! [(fobj i64) (parent (slice u8)) (name (slice u8))] (-> i64)
  (let [proto (realm-image-prototype-of fobj)
        (mut units) (al-new [i64] (alloc/malloc-allocator))
        (mut empty) (al-new [i64] (alloc/malloc-allocator))]
    (al-for [b name] (push! [i64] (mut units) (primitive/cast i64 b)))
    (heap-define-own! proto "name" (heap-ref-word DYNAMIC-PREFIX-STRING (heap-add-string! (load units))) HEAP-WORD-REF)
    (heap-define-own! proto "message" (heap-ref-word DYNAMIC-PREFIX-STRING (heap-add-string! (load empty))) HEAP-WORD-REF)
    (al-free! [i64] (mut units))
    (al-free! [i64] (mut empty))
    (if (= parent "")
        0
        (let [pi (syntax-find-fun parent)]
          (if (< pi 0) (panic "realm-image-error-prototype!: the parent intrinsic was not declared") 0)
          (let [pf (syntax-fun-at pi)]
            (if (< (.static-entry pf) 0) (panic "realm-image-error-prototype!: the parent has no image object") 0)
            (heap-set-prototype! proto
                                 (heap-ref-word DYNAMIC-PREFIX-OBJECT (realm-image-prototype-of (.static-entry pf)))
                                 HEAP-WORD-REF))))))

;; GlobalDeclarationInstantiation for one Script: the var step is static (every property already
;; holds `undefined`); the function step stores each declared function object in order. The
;; first Script's function step is part of the image, so it has nothing left to do.
(defn lower-global-instantiation! [(root-index i64)] (-> i64)
  (let [f (syntax-fun-at root-index)]
    (if (= (.script f) 0)
        0
        (do
          (al-for [id (.body f)]
                  (match (syntax-stmt-node id)
                    (SsFunctionDecl [fun]
                                    (let [declared (syntax-fun-at fun)]
                                      (lower-global-store! (.name declared) (lower-function-object fun))))
                    (_ 0)))
          0))))

(defn parse-program-mode [(src (slice u8)) (script-mode bool)] (-> (dyn NodeOps))
  (let [(mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (push! [(slice u8)] (mut sources) src)
    (let [stop (parse-program-sources (load sources) script-mode)]
      (al-free! [(slice u8)] (mut sources))
      stop)))

;; A realm: every Script source in evaluation order (docs/DECISIONS.md, realm).
(defn parse-program-scripts [(sources (ArrayList (slice u8)))] (-> (dyn NodeOps))
  (parse-program-sources sources true))

(defn parse-program-sources [(sources (ArrayList (slice u8))) (script-mode bool)] (-> (dyn NodeOps))
  (do
    (parse-syntax-scripts! sources script-mode false)
    ;; Syntax collection declares every closed-world property key and ordered hidden-class path
    ;; before JSL graphs are built. Runtime-key representation dispatch can therefore enumerate
    ;; the complete layout universe while JavaScript prototype traversal remains recursive JSL.
    (syntax-declare-object-shapes!)
    (jsl-lower-index! "jsl/compiler/index")
    (parser-settle-abi!)
    (let [start (start-make (ty-int-bot))
          stop (stop-make)
          (mut fi) 0]
      ;; Header pass: install all Fun/Parm nodes before lowering any call-bearing body. Hoisted
      ;; top-level declarations and admitted function values are Funs, all over the shared ABI;
      ;; other function forms are refused at their use.
      (loop (if (>= (load fi) (len (.funs (parser-state))))
                (break 0)
                (if (not (or (syntax-top-level-declaration? (load fi))
                             (syntax-fun-value-admitted? (syntax-fun-at (load fi)))))
                    (do (set! (mut fi) (+ (load fi) 1)) (continue))
                    (let [fp
                            (al-elem [SyntaxFun]
                                     (mut (.funs (parser-state)))
                                     (load fi))
                          argc (+ 2 (parser-abi-slots))]
                      (if (or (not (.simple-params fp))
                              (.generator fp)
                              (.async fp))
                          (unimplemented "default, rest, generator and async functions"
                                         "docs/GAPS.md — function environments")
                          0)
                      ;; JavaScript calling convention: return, `this` and every argument slot are
                      ;; dynamic values. `number` is evidence to discharge later, never a raw
                      ;; representation claim.
                      (let [fun
                              (fun-make start
                                        (parser-abi-sig)
                                        (if (= (load fi)
                                               (syntax-find-fun "main"))
                                            (parser-internal-main-name)
                                            (if (.hoisted fp)
                                                (parser-hoisted-fun-symbol (load fi))
                                                (parser-value-fun-name (load fi)))))
                            (mut i) 0]
                        ;; JSL declarations reserved the low closed-world identities. Every source
                        ;; declaration receives a distinct identity from the same compilation-local
                        ;; allocator; syntax-table position is not a symbol identity.
                        (set! (.fidx fp) (next-inline-fidx!))
                        (set! (.fun-nid fp) (n-nid fun))
                        ;; Slot 1 is the exact Call memory input, as in final Simple. The unknown-caller
                        ;; seed is Start's bulk memory; closed-world internal functions drop it with
                        ;; the matching Fun path before optimization.
                        (let [mem-parm
                                (parm-make-slot fun
                                                CALL-MEM
                                                (ty-mem 1 TY-BOT)
                                                "$mem")]
                          (parm-set-unknown-input! mem-parm
                                                   (proj-make start
                                                              1
                                                              "start.mem"))
                          (n-keep! mem-parm))
                        (loop (if (>= (load i) argc)
                                  (break 0)
                                  (do
                                    ;; Headers precede bodies, so hold parameter Phis alive until every
                                    ;; body and call edge has been installed. Slot 0 is `this`, slot 1
                                    ;; `new.target`; the formals follow.
                                    (n-keep! (parm-make fun
                                                        (load i)
                                                        (ty-dyn TAG-ANY)
                                                        (if (= (load i) 0)
                                                            "this"
                                                            (if (= (load i) 1)
                                                                "new.target"
                                                                (if (< (- (load i) 2) (len (.params fp)))
                                                                    (get (.params fp) (- (load i) 2))
                                                                    "$slot")))))
                                    (set! (mut i) (+ (load i) 1))
                                    (continue)))))
                      (set! (mut fi) (+ (load fi) 1))
                      (continue)))))
      ;; The realm's initial heap, as data: every hoisted Fun and its index exist now.
      (if (.script-mode (parser-state)) (realm-image-build!) 0)
      ;; Body pass: ScopeNode is the sole SSA environment. Statements update its ordinary graph
      ;; edges; no post-parse name-resolution or SSA construction pass exists.
      (set! (mut fi) 0)
      (loop (if (>= (load fi) (len (.funs (parser-state))))
                (break 0)
                (if (not (syntax-fun-lowered? (load fi)))
                    (do (set! (mut fi) (+ (load fi) 1)) (continue))
                    (let [f (syntax-fun-at (load fi))
                          fun (parser-node (.fun-nid f))
                          body-start (arena-node-count)
                          scope (scope-make)]
                      (if (syntax-fun-has-patterns? f)
                          (unimplemented "destructuring parameters" "docs/GAPS.md — destructuring")
                          0)
                      (set! (.current-fun (parser-state)) (load fi))
                      (set! (.propagates (parser-state)) false)
                      (set! (.current-ctrl (parser-state)) (n-nid fun))
                      (set! (.current-scope (parser-state)) (n-nid scope))
                      (n-add-def! scope (Some fun))
                      (match (fun-mem-parm fun)
                        (Some [m] (n-add-def! scope (Some m)))
                        (None []
                              (panic "parser: function memory Parm is missing")))
                      (scope-push! scope)
                      (parser-reset-returns!)
                      (let [(mut i) 0]
                        (loop (if (>= (load i) (len (.params f)))
                                  (break 0)
                                  (let [name (get (.params f) (load i))
                                        (mut later) (+ (load i) 1)
                                        (mut shadowed) false]
                                    ;; A non-strict JavaScript simple parameter list may repeat a
                                    ;; name. Every positional Parm still exists for the ABI, but only
                                    ;; the last occurrence introduces the body binding.
                                    (loop (if (>= (load later)
                                                  (len (.params f)))
                                              (break 0)
                                              (if (= (get (.params f)
                                                          (load later))
                                                     name)
                                                  (break (do
                                                           (set! (mut shadowed)
                                                                 true)
                                                           0))
                                                  (do
                                                    (set! (mut later)
                                                          (+ (load later) 1))
                                                    (continue)))))
                                    (if (not (load shadowed))
                                        (scope-define! scope
                                                       name
                                                       (ty-dyn TAG-ANY)
                                                       false
                                                       (match (fun-parm fun
                                                                        (+ (load i) 2))
                                                         (Some [p] p)
                                                         (None []
                                                               (unreachable-node))))
                                        0)
                                    (set! (mut i) (+ (load i) 1))
                                    (continue)))))
                      ;; An intrinsic belongs to no Script (`script` -1): it leaves the current
                      ;; Script index as it is.
                      (if (and (.script-mode (parser-state)) (>= (.script f) 0))
                          (set! (.script-index (parser-state))
                                (get (.scripts (parser-state)) (.script f)))
                          0)
                      (if (syntax-script-root? (load fi))
                          (lower-global-instantiation! (load fi))
                          (lower-instantiate-vars! (.body f)))
                      (lower-instantiate-lexicals! (.body f))
                      (lower-bind-body-functions! (.body f))
                      (let [terminated
                              (match (.expression-body f)
                                (Some [e] (do (parser-record-return! (lower-syntax-expr e)) 1))
                                (None [] (lower-syntax-statements (.body f))))]
                        ;; JavaScript functions return undefined when control reaches the closing brace.
                        (if (= terminated 0)
                            (parser-record-return! (dyn-undefined-make))
                            0)
                        ;; The filter's soundness check: a propagation path in a body it cleared.
                        (if (and (.propagates (parser-state)) (not (.may-throw f)))
                            (do
                              (p--str "\naot: parser: the may-throw filter cleared a function whose lowering propagates an exception: ")
                              (p--str (.name f))
                              (p--str "\n")
                              (panic "parser: syntactic may-throw filter is unsound for a construct in this function (add it to syntax-throw-walk-expr!)"))
                            0)
                        (let [ret (parser-build-return! fun)]
                          (fun-set-ret! fun ret)
                          ;; Header hoisting interleaves unrelated Fun/Parm nids before this body.
                          ;; Preserve Simple's per-function construction estimate by measuring only
                          ;; this lowering window; live-size remains the independent second cap.
                          (fun-set-approx-size! fun
                                                (- (arena-node-count)
                                                   body-start))
                          (stop-add-return! stop ret)))
                      ;; Branches normally merge back into `scope`; loops deliberately replace it
                      ;; with their false-edge exit Scope. Publish and discard the actual final
                      ;; environment, then discard an obsolete loop-entry environment separately.
                      (let [final-scope (parser-node (.current-scope (parser-state)))]
                        (scope-pop! final-scope)
                        (n-kill! final-scope)
                        (if (n-same? final-scope scope) 0 (n-kill! scope)))
                      (match (fun-mem-parm fun)
                        (Some [m] (n-unkeep! m))
                        (None [] 0))
                      (set! (mut fi) (+ (load fi) 1))
                      (continue)))))
      (parser-install-entry-wrapper! start stop)
      ;; Every semantic call is installed: lower the bodies of the JSL definitions the program
      ;; demanded, and of those they demand, before pessimistic Iter sees the graph. A definition
      ;; nothing reached has no graph (docs/DECISIONS.md, JSL definitions are built on demand).
      ;; A body's `%CallFunction` lowers against the program's value-call ABI, settled now.
      (jsl-set-value-call-abi! (parser-abi-slots) (parser-value-funptr-ty))
      (jsl-define-pending!)
      stop)))

(defn parse-program [(src (slice u8))] (-> (dyn NodeOps))
  (parse-program-mode src false))

(defn parse-script [(src (slice u8))] (-> (dyn NodeOps))
  (parse-program-mode src true))

;; Close the source and JSL call worlds only after pessimistic Iter has visited the Start-rooted
;; graph with every unknown-caller hook intact. Lazy Call->Fun links are installed by Opto; dropping
;; hooks in `parse-program` let pessimistic Iter compute an unlinked Fun as XCTRL before Opto linked
;; it and computed CTRL, violating the optimistic-below-pessimistic invariant.
(defn parser-close-world! [] (-> i64)
  (let [(mut fi) 0]
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break 0)
              (if (not (syntax-fun-lowered? (load fi)))
                  (do (set! (mut fi) (+ (load fi) 1)) (continue))
                  (let [f (syntax-fun-at (load fi))]
                    ;; Every source function, including source-level `main`, is closed-world. The
                    ;; compiler-owned wrapper alone retains the external Start hook.
                    (fun-drop-unknown-callers! (parser-node (.fun-nid f)))
                    (let [fun (parser-node (.fun-nid f))
                          (mut i) 0]
                      (loop (if (> (load i) (+ (parser-abi-slots) 1))
                                (break 0)
                                (do
                                  (match (fun-parm fun (load i))
                                    (Some [p] (n-unkeep! p))
                                    (None [] 0))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue)))))
                    (set! (mut fi) (+ (load fi) 1))
                    (continue)))))
    (jsl-close-world!)
    0))

;; Final Simple does not make every parsed function a code-generation root before optimistic SCCP.
;; Internal Returns are held temporarily while call discovery runs; otherwise Stop itself keeps an
;; inlined callee alive and its now-caller-controlled Return can GVN/share values across functions.
;; `main` remains the public program root throughout.
(defn parser-prepare-opto! [(stop (dyn NodeOps))] (-> i64)
  (let [entry-fun (parser-entry-fun)
        (mut i) 0
        (mut detached) 0]
    (loop (if (>= (load i) (n-nins stop))
              (break (load detached))
              (let [ret (n-in! stop (load i))]
                (match (return-fun ret)
                  (Some [fun]
                        ;; Stop inputs compress as internal Returns are removed. Function identity,
                        ;; not the mutable edge index, decides which Return is the public root.
                        (if (n-same? fun entry-fun)
                            (do (set! (mut i) (+ (load i) 1)) (continue))
                            (do
                              (n-keep! ret)
                              (n-del-def! stop (load i))
                              (set! (mut detached) (+ (load detached) 1))
                              (continue))))
                  (None [] (do (set! (mut i) (+ (load i) 1)) (continue)))))))))

;; Mirror final Simple's post-Opto `keepInCompUnit`: only functions whose Fun remains live and whose
;; control type is reachable are restored to Stop for machine lowering. The temporary keep is
;; released after the graph edge is installed so a dead/inlined body can be collected normally.
(defn parser-finish-opto! [(stop (dyn NodeOps))] (-> i64)
  (let [(mut fi) 0
        (mut retained) 0]
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break (load retained))
              (if (not (syntax-fun-lowered? (load fi)))
                  (do (set! (mut fi) (+ (load fi) 1)) (continue))
                  (let [syntax (syntax-fun-at (load fi))
                        fun (parser-node (.fun-nid syntax))]
                    (match (fun-ret fun)
                      (Some [ret]
                            ;; A function whose address is taken is a compilation-unit root even
                            ;; with no call site: the function object's code word names it.
                            (if (and (not (n-dead? fun))
                                     (not (ty-high? (n-ty fun)))
                                     (or (fun-escapes? fun) (not (fun-folding? fun))))
                                (do
                                  (stop-add-return! stop ret)
                                  (set! (mut retained) (+ (load retained) 1))
                                  (n-unkill! ret))
                                ;; Match the JSL lifetime protocol: an inlined or unreachable source
                                ;; Return has no compilation-unit owner and must detach from its former
                                ;; caller control as soon as the temporary Opto keep is released.
                                (n-unkill! ret)))
                      (None [] 0))
                    (set! (mut fi) (+ (load fi) 1))
                    (continue)))))))

;; Install final Simple's post-Opto code-generation entry hooks. Optimisation uses concrete
;; Call->Fun edges to discover and inline callees; machine code cannot retain those
;; interprocedural CFG cycles, so every surviving function is instead rooted at Start immediately
;; before unlinking. Matching raw Parm arms preserve the Region/Phi positional invariant without
;; claiming a new runtime value. RPC is reconstructed here because a single linked caller can make
;; it constant during Opto, but code generation always needs the architectural return address.
(defn parser-prepare-codegen! [(start (dyn NodeOps))] (-> i64)
  (let [(mut fi) 0
        (mut prepared) 0]
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break (+ (load prepared)
                        (fun-prepare-codegen! (parser-entry-fun) start)))
              (if (not (syntax-fun-lowered? (load fi)))
                  (do (set! (mut fi) (+ (load fi) 1)) (continue))
                  (let [syntax (syntax-fun-at (load fi))
                        fun (parser-node (.fun-nid syntax))]
                    (set! (mut prepared)
                          (+ (load prepared) (fun-prepare-codegen! fun start)))
                    (set! (mut fi) (+ (load fi) 1))
                    (continue)))))))

