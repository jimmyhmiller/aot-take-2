;; The recursive-descent JS/TS parser. Source text in, sea-of-nodes IR out.

;;
;; JavaScript first needs the thin syntax-only tree specified in docs/FRONTEND.md for cover
;; grammars, hoisting, forward type names and capture discovery. There is still NO typed AST or
;; second semantic IR. One lowering walk drives `aot.node.scope` directly, so a variable read is a
;; slot lookup that yields the node currently defining it and an assignment is a slot update — SSA
;; is constructed as a side effect of lowering rather than by a later pass. This preserves Simple's
;; central trick while accommodating syntax that cannot be committed on first token sight.
;;
;; Every construct here is a shape of graph, not a shape of tree:
;;
;;   if/else          dup the scope, parse both arms, merge; Phis appear only where the arms differ
;;   while/for        the loop protocol in `aot.node.scope` — dup, build, then finalize through
;;                    `scope-end-loop!`, which wires control and immediately fills Phi backedges
;;   && || ?:         short-circuit is a diamond, so these are `if` with a value
;;   try/catch        an exceptional edge (`aot.node.exception`); `finally` is duplicated onto
;;                    every path that leaves the block
;;   typeof x === "n" a guard, which is why `aot.node.scope`'s `scope-add-guards!` exists: the
;;                    narrowed value is installed in the slot on the taken edge
;;
;; TypeScript annotations are parsed by `aot.parse.tstype` and attached as DECLARED types. Declared
;; is not proven — see `aot.codegen.opto`.
;;
;; The admitted subset includes named function declarations, number-annotated parameters/returns,
;; integer literals, calls, bindings, assignment, blocks, conditional expressions, `if`/`else`,
;; basic `while`, and `+`, `-`, and `*`. Parsing first produces a THIN syntax tree, then lowering
;; constructs SSA directly. This is the required JavaScript divergence from final Simple's one-pass
;; parser: declarations are hoisted, so every Fun header exists before any body is lowered. The
;; semantic graph remains the only typed IR; syntax nodes carry spans and grammar shape, never
;; inferred types.
(module aot.parse.parser)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.call" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.scope" :use *)
(import "aot.type.type" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.parse.lexer" :use *)

(const SX-NUMBER 1)

(const SX-NAME 2)

(const SX-ADD 3)

(const SX-SUB 4)

(const SX-MUL 5)

(const SX-CALL 6)

(const SX-CONDITIONAL 7)

(const SS-LET 1)

(const SS-ASSIGN 2)

(const SS-RETURN 3)

(const SS-EXPR 4)

(const SS-BLOCK 5)

(const SS-IF 6)

(const SS-WHILE 7)

(defstruct SyntaxExpr
  [(kind i64)
   (lo i64)
   (hi i64)
   (number i64)
   (name (slice u8))
   (left i64)
   (right i64)
   (third i64)
   (args (ArrayList i64))])

(defstruct SyntaxFun
  [(name (slice u8))
   (params (ArrayList (slice u8)))
   (body (ArrayList i64))
   (lo i64)
   (hi i64)
   (fun-nid i64)])

(defstruct SyntaxStmt
  [(kind i64)
   (name (slice u8))
   (expr i64)
   (final bool)
   (body (ArrayList i64))
   (else-body (ArrayList i64))
   (lo i64)
   (hi i64)])

(defstruct ParserState
  [(exprs (ArrayList SyntaxExpr))
   (stmts (ArrayList SyntaxStmt))
   (funs (ArrayList SyntaxFun))
   (current-fun i64)
   (current-ctrl i64)
   (current-scope i64)
   (booted bool)])

(defn parser-state [] (-> (ptr ParserState))
  (primitive/alloc-static ParserState))

(defn parser-reset! [] (-> i64)
  (let [p (parser-state)]
    (if (not (.booted p))
        (do
          (set! (.exprs p) (al-new [SyntaxExpr] (alloc/malloc-allocator)))
          (set! (.stmts p) (al-new [SyntaxStmt] (alloc/malloc-allocator)))
          (set! (.funs p) (al-new [SyntaxFun] (alloc/malloc-allocator)))
          (set! (.booted p) true)
          0)
        (do
          (al-clear! [SyntaxExpr] (mut (.exprs p)))
          (al-clear! [SyntaxStmt] (mut (.stmts p)))
          (al-clear! [SyntaxFun] (mut (.funs p)))
          0))))

(defn parse-fail [(what (slice u8)) (t Token)] (-> i64)
  (do (panic-i what (.start t)) 0))

(defn take-token [] (-> Token)
  (lex-next! false))

(defn peek-token [] (-> Token)
  (lex-peek false))

(defn take-is [(text (slice u8))] (-> bool)
  (if (token-is (peek-token) text) (do (take-token) true) false))

(defn require-token [(text (slice u8))] (-> Token)
  (let [t (take-token)]
    (if (token-is t text)
        t
        (do (parse-fail "parser: expected token at byte" t) t))))

(defn require-ident [] (-> Token)
  (let [t (take-token)]
    (if (= (.kind t) TOK-IDENT)
        t
        (do (parse-fail "parser: expected identifier at byte" t) t))))

(defn syntax-expr-new [(kind i64) (lo i64) (hi i64)] (-> SyntaxExpr)
  (let [(mut x) (primitive/zeroed SyntaxExpr)]
    (set! (.kind (mut x)) kind)
    (set! (.lo (mut x)) lo)
    (set! (.hi (mut x)) hi)
    (load x)))

(defn syntax-add! [(x SyntaxExpr)] (-> i64)
  (do
    (push! [SyntaxExpr] (mut (.exprs (parser-state))) x)
    (len (.exprs (parser-state)))))

(defn syntax-at [(id i64)] (-> SyntaxExpr)
  (get (.exprs (parser-state)) (- id 1)))

(defn syntax-stmt-new [(kind i64) (lo i64) (hi i64)] (-> SyntaxStmt)
  (let [(mut s) (primitive/zeroed SyntaxStmt)]
    (set! (.kind (mut s)) kind)
    (set! (.lo (mut s)) lo)
    (set! (.hi (mut s)) hi)
    (load s)))

(defn syntax-stmt-add! [(s SyntaxStmt)] (-> i64)
  (do
    (push! [SyntaxStmt] (mut (.stmts (parser-state))) s)
    (len (.stmts (parser-state)))))

(defn syntax-stmt-at [(id i64)] (-> SyntaxStmt)
  (get (.stmts (parser-state)) (- id 1)))

(defn parse-number-value [(t Token)] (-> i64)
  (let [text (token-text t)
        (mut i) 0
        (mut n) 0]
    (loop (if (>= (load i) (len text))
              (break 0)
              (do
                (set! (mut n) (+ (* (load n) 10) (- (cast i64 (get text (load i))) 48)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load n)))

(defn parse-syntax-primary [] (-> i64)
  (let [t (take-token)]
    (if (= (.kind t) TOK-NUMBER)
        (let [(mut x) (syntax-expr-new SX-NUMBER (.start t) (.end t))]
          (set! (.number (mut x)) (parse-number-value t))
          (syntax-add! (load x)))
        (if (= (.kind t) TOK-IDENT)
            (let [(mut x) (syntax-expr-new SX-NAME (.start t) (.end t))]
              (set! (.name (mut x)) (token-text t))
              (syntax-add! (load x)))
            (if (token-is t "(")
                (let [x (parse-syntax-conditional)] (do (require-token ")") x))
                (do
                  ;; Strings and object literals are lexically recognized but not admitted until
                  ;; their runtime representations and memory nodes exist. Refusal is immediate.
                  (parse-fail "parser: primary is outside the admitted subset at byte" t)
                  0))))))

(defn parse-syntax-postfix [] (-> i64)
  (let [(mut base) (parse-syntax-primary)]
    (loop (if (not (take-is "("))
              (break 0)
              (let [(mut args) (al-new [i64] (alloc/malloc-allocator))]
                (if (not (take-is ")"))
                    (loop (do
                            (push! [i64] (mut args) (parse-syntax-conditional))
                            (if (take-is ",")
                                (continue)
                                (break (do (require-token ")") 0)))))
                    0)
                (let [callee (syntax-at (load base))
                      close (peek-token)
                      (mut x) (syntax-expr-new SX-CALL (.lo callee) (.start close))]
                  (if (!= (.kind callee) SX-NAME)
                      (parse-fail "parser: only named calls are admitted at byte" close)
                      0)
                  (set! (.name (mut x)) (.name callee))
                  (set! (.args (mut x)) (load args))
                  (set! (mut base) (syntax-add! (load x)))
                  (continue)))))
    (load base)))

(defn parse-syntax-mul [] (-> i64)
  (let [(mut lhs) (parse-syntax-postfix)]
    (loop (if (not (take-is "*"))
              (break 0)
              (let [rhs (parse-syntax-postfix)
                    l (syntax-at (load lhs))
                    r (syntax-at rhs)
                    (mut x) (syntax-expr-new SX-MUL (.lo l) (.hi r))]
                (set! (.left (mut x)) (load lhs))
                (set! (.right (mut x)) rhs)
                (set! (mut lhs) (syntax-add! (load x)))
                (continue))))
    (load lhs)))

(defn parse-syntax-add [] (-> i64)
  (let [(mut lhs) (parse-syntax-mul)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "+") (token-is t "-")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-mul)
                        l (syntax-at (load lhs))
                        r (syntax-at rhs)
                        kind (if (token-is t "+") SX-ADD SX-SUB)
                        (mut x) (syntax-expr-new kind (.lo l) (.hi r))]
                    (set! (.left (mut x)) (load lhs))
                    (set! (.right (mut x)) rhs)
                    (set! (mut lhs) (syntax-add! (load x)))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-conditional [] (-> i64)
  (let [condition (parse-syntax-add)]
    (if (not (take-is "?"))
        condition
        (let [when-true (parse-syntax-conditional)]
          (require-token ":")
          (let [when-false (parse-syntax-conditional)
                c (syntax-at condition)
                f (syntax-at when-false)
                (mut x) (syntax-expr-new SX-CONDITIONAL (.lo c) (.hi f))]
            (set! (.left (mut x)) condition)
            (set! (.right (mut x)) when-true)
            (set! (.third (mut x)) when-false)
            (syntax-add! (load x)))))))

(defn parse-number-annotation [] (-> i64)
  (do
    (require-token ":")
    (let [t (require-ident)]
      (if (not (token-is t "number"))
          (parse-fail "parser: only the number annotation is admitted at byte" t)
          0))))

(defn parse-optional-number-annotation [] (-> i64)
  (if (not (take-is ":"))
      0
      (let [t (require-ident)]
        (if (not (token-is t "number"))
            (parse-fail "parser: only the number annotation is admitted at byte" t)
            0))))

(defn parse-syntax-statement [] (-> i64)
  (let [first (peek-token)]
    (if (token-is first "while")
        (let [keyword (take-token)]
          (require-token "(")
          (let [condition (parse-syntax-conditional)]
            (require-token ")")
            (let [body-stmt (parse-syntax-statement)
                  parsed (syntax-stmt-at body-stmt)
                  (mut body) (al-new [i64] (alloc/malloc-allocator))
                  (mut stmt) (syntax-stmt-new SS-WHILE (.start keyword) (.hi parsed))]
              (push! [i64] (mut body) body-stmt)
              (set! (.expr (mut stmt)) condition)
              (set! (.body (mut stmt)) (load body))
              (syntax-stmt-add! (load stmt)))))
        (if (token-is first "if")
            (let [keyword (take-token)]
              (require-token "(")
              (let [condition (parse-syntax-conditional)]
                (require-token ")")
                (let [yes (parse-syntax-statement)
                      (mut yes-body) (al-new [i64] (alloc/malloc-allocator))
                      (mut no-body) (al-new [i64] (alloc/malloc-allocator))]
                  (push! [i64] (mut yes-body) yes)
                  (if (take-is "else")
                      (push! [i64] (mut no-body) (parse-syntax-statement))
                      0)
                  (let [last
                          (if (> (len (load no-body)) 0)
                              (syntax-stmt-at (get (load no-body) 0))
                              (syntax-stmt-at yes))
                        (mut stmt) (syntax-stmt-new SS-IF (.start keyword) (.hi last))]
                    (set! (.expr (mut stmt)) condition)
                    (set! (.body (mut stmt)) (load yes-body))
                    (set! (.else-body (mut stmt)) (load no-body))
                    (syntax-stmt-add! (load stmt))))))
            (if (or (token-is first "let") (token-is first "const"))
                (let [keyword (take-token)
                      name (require-ident)]
                  (parse-optional-number-annotation)
                  (require-token "=")
                  (let [expr (parse-syntax-conditional)
                        parsed (syntax-at expr)
                        (mut stmt) (syntax-stmt-new SS-LET (.start keyword) (.hi parsed))]
                    (take-is ";")
                    (set! (.name (mut stmt)) (token-text name))
                    (set! (.expr (mut stmt)) expr)
                    (set! (.final (mut stmt)) (token-is keyword "const"))
                    (syntax-stmt-add! (load stmt))))
                (if (token-is first "return")
                    (let [keyword (take-token)
                          expr (parse-syntax-conditional)
                          parsed (syntax-at expr)
                          (mut stmt) (syntax-stmt-new SS-RETURN (.start keyword) (.hi parsed))]
                      (take-is ";")
                      (set! (.expr (mut stmt)) expr)
                      (syntax-stmt-add! (load stmt)))
                    (if (token-is first "{")
                        (do
                          (take-token)
                          (let [(mut body) (al-new [i64] (alloc/malloc-allocator))]
                            (loop (if (token-is (peek-token) "}")
                                      (break 0)
                                      (do (push! [i64] (mut body) (parse-syntax-statement)) (continue))))
                            (let [close (require-token "}")
                                  (mut stmt) (syntax-stmt-new SS-BLOCK (.start first) (.end close))]
                              (set! (.body (mut stmt)) (load body))
                              (syntax-stmt-add! (load stmt)))))
                        (let [lhs (parse-syntax-conditional)
                              lhs-expr (syntax-at lhs)]
                          (if (take-is "=")
                              (if (!= (.kind lhs-expr) SX-NAME)
                                  (do
                                    (parse-fail "parser: assignment target is not a name at byte" first)
                                    0)
                                  (let [rhs (parse-syntax-conditional)
                                        parsed (syntax-at rhs)
                                        (mut stmt) (syntax-stmt-new SS-ASSIGN (.lo lhs-expr) (.hi parsed))]
                                    (take-is ";")
                                    (set! (.name (mut stmt)) (.name lhs-expr))
                                    (set! (.expr (mut stmt)) rhs)
                                    (syntax-stmt-add! (load stmt))))
                              (let [(mut stmt) (syntax-stmt-new SS-EXPR (.lo lhs-expr) (.hi lhs-expr))]
                                (take-is ";")
                                (set! (.expr (mut stmt)) lhs)
                                (syntax-stmt-add! (load stmt))))))))))))

(defn parse-syntax-statement-list [] (-> (ArrayList i64))
  (let [(mut body) (al-new [i64] (alloc/malloc-allocator))]
    (loop (if (token-is (peek-token) "}")
              (break 0)
              (do (push! [i64] (mut body) (parse-syntax-statement)) (continue))))
    (load body)))

(defn parse-syntax-function! [] (-> i64)
  (let [open (require-token "function")
        name (require-ident)
        (mut params) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (require-token "(")
    (if (not (take-is ")"))
        (loop (let [p (require-ident)]
                (parse-number-annotation)
                (push! [(slice u8)] (mut params) (token-text p))
                (if (take-is ",")
                    (continue)
                    (break (do (require-token ")") 0)))))
        0)
    (parse-number-annotation)
    (require-token "{")
    (let [body (parse-syntax-statement-list)]
      (let [close (require-token "}")
            (mut f) (primitive/zeroed SyntaxFun)]
        (set! (.name (mut f)) (token-text name))
        (set! (.params (mut f)) (load params))
        (set! (.body (mut f)) body)
        (set! (.lo (mut f)) (.start open))
        (set! (.hi (mut f)) (.end close))
        (push! [SyntaxFun] (mut (.funs (parser-state))) (load f))
        (len (.funs (parser-state)))))))

(defn syntax-fun-at [(i i64)] (-> SyntaxFun)
  (get (.funs (parser-state)) i))

(defn syntax-find-fun [(name (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len (.funs (parser-state))))
              (break -1)
              (let [f (syntax-fun-at (load i))]
                (if (= (.name f) name)
                    (break (load i))
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn parser-node [(nid i64)] (-> (dyn NodeOps))
  (match (arena-node nid) (Some [n] n) (None [] (unreachable-node))))

(defn lower-name [(name (slice u8))] (-> (dyn NodeOps))
  (match (scope-lookup (parser-node (.current-scope (parser-state))) name)
    (Some [value] value)
    (None [] (do (panic "parser: unknown binding during lowering") (unreachable-node)))))

(defn parser-set-current-ctrl! [(ctrl (dyn NodeOps))] (-> i64)
  (do
    (set! (.current-ctrl (parser-state)) (n-nid ctrl))
    (scope-set-ctrl! (parser-node (.current-scope (parser-state))) ctrl)))

;; JavaScript numeric operators are semantic calls, even in this deliberately integer-proven slice.
;; Boxing exposes the dynamic boundary to JSL; specialization may later cancel both pairs.
(defn lower-js-binary [(lhs (dyn NodeOps))
                       (rhs (dyn NodeOps))
                       (name (slice u8))] (-> (dyn NodeOps))
  (let [target (jsl-graph-of name)
        c (call-make (parser-node (.current-ctrl (parser-state))))]
    ;; JavaScript values are already dynamic at every source-level boundary. JSL owns any unboxing;
    ;; boxing again here would make the frontend silently choose an integer representation.
    (call-add-arg! c lhs)
    (call-add-arg! c rhs)
    (call-set-fptr! c (funptr-make target (jsl-fidx-of name)))
    (let [end (callend-make c)]
      (let [ctrl (cproj-make end RETURN-CTRL "js-binary.ctrl")]
        (parser-set-current-ctrl! ctrl))
      (proj-make end RETURN-VALUE "js-binary.value"))))

(defn lower-syntax-expr [(id i64)] (-> (dyn NodeOps))
  (let [x (syntax-at id)]
    (if (= (.kind x) SX-NUMBER)
        ;; A source literal is a JavaScript value. The raw integer exists only inside its Box and
        ;; may reappear after a proven JSL Unbox cancels that Box during specialization.
        (box-make (con-int (.number x)))
        (if (= (.kind x) SX-NAME)
            (lower-name (.name x))
            (if (= (.kind x) SX-ADD)
                (lower-js-binary (lower-syntax-expr (.left x))
                                 (lower-syntax-expr (.right x))
                                 "JsAdd")
                (if (= (.kind x) SX-SUB)
                    (lower-js-binary (lower-syntax-expr (.left x))
                                     (lower-syntax-expr (.right x))
                                     "JsSub")
                    (if (= (.kind x) SX-MUL)
                        (lower-js-binary (lower-syntax-expr (.left x))
                                         (lower-syntax-expr (.right x))
                                         "JsMul")
                        (if (= (.kind x) SX-CONDITIONAL)
                            (let [condition (lower-syntax-expr (.left x))
                                  iff (if-make (parser-node (.current-ctrl (parser-state))) condition)
                                  arms (if-arms! iff)]
                              ;; Both arms are built before either is exposed to peepholing. Branch
                              ;; expressions may contain calls, so each carries its own final control.
                              (parser-set-current-ctrl! (arms-true arms))
                              (let [yes (lower-syntax-expr (.right x))
                                    yes-ctrl (parser-node (.current-ctrl (parser-state)))]
                                ;; Switching the parser Scope to the false arm removes its only
                                ;; temporary use of the true control. Keep both products across
                                ;; that construction window; Region/Phi take ownership below.
                                (n-keep! yes-ctrl)
                                (n-keep! yes)
                                (parser-set-current-ctrl! (arms-false arms))
                                (let [no (lower-syntax-expr (.third x))
                                      no-ctrl (parser-node (.current-ctrl (parser-state)))
                                      region (region-make)
                                      phi
                                        (phi-make region
                                                  (ty-meet (n-ty yes) (n-ty no))
                                                  "conditional")]
                                  (region-add-path! region yes-ctrl)
                                  (region-add-path! region no-ctrl)
                                  (phi-add-value! phi yes)
                                  (phi-add-value! phi no)
                                  (parser-set-current-ctrl! region)
                                  (n-unkeep! yes-ctrl)
                                  (n-unkeep! yes)
                                  phi)))
                            (if (= (.kind x) SX-CALL)
                                (let [target-idx (syntax-find-fun (.name x))]
                                  (if (< target-idx 0)
                                      (do
                                        (panic "parser: call to undeclared function")
                                        (unreachable-node))
                                      (let [target-syntax (syntax-fun-at target-idx)
                                            target (parser-node (.fun-nid target-syntax))]
                                        (if (!= (len (.args x))
                                                (len (.params target-syntax)))
                                            (panic "parser: call argument count mismatch")
                                            0)
                                        (let [c (call-make (parser-node (.current-ctrl (parser-state))))
                                              (mut i) 0]
                                          (loop (if (>= (load i) (len (.args x)))
                                                    (break 0)
                                                    (do
                                                      (call-add-arg! c
                                                                     (lower-syntax-expr (get (.args x) (load i))))
                                                      (set! (mut i) (+ (load i) 1))
                                                      (continue))))
                                          (call-set-fptr! c (funptr-make target target-idx))
                                          (let [end (callend-make c)]
                                            (let [ctrl (cproj-make end RETURN-CTRL "call.ctrl")]
                                              (parser-set-current-ctrl! ctrl))
                                            (proj-make end RETURN-VALUE "call.value"))))))
                                (do
                                  (panic "parser: unknown syntax expression")
                                  (unreachable-node)))))))))))

(defn lower-syntax-statements [(stmts (ArrayList i64))] (-> i64)
  (let [(mut i) 0
        (mut return-nid) 0]
    (loop (if (>= (load i) (len stmts))
              (break 0)
              (do
                (if (!= (load return-nid) 0)
                    (panic "parser: statement follows return in admitted subset")
                    0)
                (let [stmt (syntax-stmt-at (get stmts (load i)))]
                  (if (= (.kind stmt) SS-LET)
                      (let [value (lower-syntax-expr (.expr stmt))]
                        (scope-define! (parser-node (.current-scope (parser-state)))
                                       (.name stmt)
                                       (ty-dyn TAG-ANY)
                                       (.final stmt)
                                       value))
                      (if (= (.kind stmt) SS-ASSIGN)
                          (scope-update! (parser-node (.current-scope (parser-state)))
                                         (.name stmt)
                                         (lower-syntax-expr (.expr stmt)))
                          (if (= (.kind stmt) SS-RETURN)
                              (set! (mut return-nid) (n-nid (lower-syntax-expr (.expr stmt))))
                              (if (= (.kind stmt) SS-EXPR)
                                  (do (lower-syntax-expr (.expr stmt)) 0)
                                  (if (= (.kind stmt) SS-BLOCK)
                                      (let [scope (parser-node (.current-scope (parser-state)))]
                                        (scope-push! scope)
                                        (let [nested-return (lower-syntax-statements (.body stmt))]
                                          (scope-pop! scope)
                                          (if (!= nested-return 0)
                                              (set! (mut return-nid) nested-return)
                                              0)))
                                      (if (= (.kind stmt) SS-IF)
                                          (let [condition (lower-syntax-expr (.expr stmt))
                                                iff
                                                  (if-make (parser-node (.current-ctrl (parser-state)))
                                                           condition)
                                                arms (if-arms! iff)
                                                true-scope (parser-node (.current-scope (parser-state)))
                                                false-scope (scope-dup true-scope false)]
                                            (scope-set-ctrl! true-scope (arms-true arms))
                                            (set! (.current-ctrl (parser-state))
                                                  (n-nid (arms-true arms)))
                                            (let [true-return (lower-syntax-statements (.body stmt))]
                                              (if (!= true-return 0)
                                                  (n-keep! (parser-node true-return))
                                                  0)
                                              (set! (.current-scope (parser-state))
                                                    (n-nid false-scope))
                                              (scope-set-ctrl! false-scope (arms-false arms))
                                              (set! (.current-ctrl (parser-state))
                                                    (n-nid (arms-false arms)))
                                              (let [false-return (lower-syntax-statements (.else-body stmt))
                                                    merged (scope-merge! true-scope false-scope)]
                                                (set! (.current-scope (parser-state)) (n-nid merged))
                                                (set! (.current-ctrl (parser-state))
                                                      (n-nid (scope-ctrl merged)))
                                                (if (and (= true-return 0) (= false-return 0))
                                                    0
                                                    (if (or (= true-return 0) (= false-return 0))
                                                        (panic "parser: only one if arm returns; function-exit merge required")
                                                        (let [answer
                                                                (phi-make (scope-ctrl merged)
                                                                          (ty-meet (n-ty (parser-node true-return))
                                                                                   (n-ty (parser-node false-return)))
                                                                          "if.return")]
                                                          (phi-add-value! answer
                                                                          (parser-node true-return))
                                                          (phi-add-value! answer
                                                                          (parser-node false-return))
                                                          (n-unkeep! (parser-node true-return))
                                                          (set! (mut return-nid) (n-nid answer))
                                                          0))))))
                                          (if (= (.kind stmt) SS-WHILE)
                                              (let [entry (parser-node (.current-scope (parser-state)))
                                                    head (loop-make (scope-ctrl entry))]
                                                (scope-set-ctrl! entry head)
                                                (let [body-scope (scope-dup entry true)]
                                                  (set! (.current-scope (parser-state))
                                                        (n-nid body-scope))
                                                  (set! (.current-ctrl (parser-state))
                                                        (n-nid (scope-ctrl body-scope)))
                                                  (let [condition (lower-syntax-expr (.expr stmt))
                                                        iff
                                                          (if-make (scope-ctrl body-scope)
                                                                   condition)
                                                        arms (if-arms! iff)]
                                                    ;; The exit sees predicate effects and the
                                                    ;; false edge. The body continues on true.
                                                    (scope-set-ctrl! body-scope
                                                                     (arms-false arms))
                                                    (let [exit-scope (scope-dup body-scope false)]
                                                      (scope-set-ctrl! body-scope
                                                                       (arms-true arms))
                                                      (set! (.current-ctrl (parser-state))
                                                            (n-nid (arms-true arms)))
                                                      (if (!= (lower-syntax-statements (.body stmt))
                                                              0)
                                                          (panic "parser: return inside while is not yet admitted")
                                                          0)
                                                      ;; This is one atomic protocol: backedge
                                                      ;; control first, then all materialized Phi
                                                      ;; backedges, before any peephole can run.
                                                      (scope-end-loop! entry
                                                                       body-scope
                                                                       exit-scope)
                                                      (set! (.current-scope (parser-state))
                                                            (n-nid exit-scope))
                                                      (set! (.current-ctrl (parser-state))
                                                            (n-nid (scope-ctrl exit-scope)))
                                                      0))))
                                              (panic "parser: unknown statement during lowering")))))))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load return-nid)))

(defn parse-program [(src (slice u8))] (-> (dyn NodeOps))
  (do
    (parser-reset!)
    (jsl-lower-index! "jsl/compiler/index")
    (lex-init! src)
    ;; Syntax pass: collect every declaration before graph construction. This is the hoisting
    ;; boundary; no semantic node is built while the cover grammar is still ambiguous.
    (loop (let [t (peek-token)]
            (if (= (.kind t) TOK-EOF)
                (break 0)
                (do (parse-syntax-function!) (continue)))))
    (let [start (start-make (ty-int-bot))
          stop (stop-make)
          (mut fi) 0]
      ;; Header pass: install all Fun/Parm nodes before lowering any call-bearing body.
      (loop (if (>= (load fi) (len (.funs (parser-state))))
                (break 0)
                (let [fp (al-elem [SyntaxFun] (mut (.funs (parser-state))) (load fi))
                      argc (len (.params fp))
                      (mut members) (al-new [i64] (alloc/malloc-allocator))]
                  ;; JavaScript calling convention: return and arguments are dynamic values.
                  ;; `number` is evidence to discharge later, never a raw representation claim.
                  (push! [i64] (mut members) (ty-dyn TAG-ANY))
                  (let [(mut i) 0]
                    (loop (if (>= (load i) argc)
                              (break 0)
                              (do
                                (push! [i64] (mut members) (ty-dyn TAG-ANY))
                                (set! (mut i) (+ (load i) 1))
                                (continue)))))
                  (let [fun (fun-make start (ty-tuple (al-slice (load members))) (.name fp))
                        (mut i) 0]
                    (set! (.fun-nid fp) (n-nid fun))
                    (loop (if (>= (load i) argc)
                              (break 0)
                              (do
                                ;; Headers precede bodies, so hold parameter Phis alive until every
                                ;; body and call edge has been installed.
                                (n-keep! (parm-make fun
                                                    (load i)
                                                    (ty-dyn TAG-ANY)
                                                    (get (.params fp) (load i))))
                                (set! (mut i) (+ (load i) 1))
                                (continue)))))
                  (set! (mut fi) (+ (load fi) 1))
                  (continue))))
      ;; Body pass: ScopeNode is the sole SSA environment. Statements update its ordinary graph
      ;; edges; no post-parse name-resolution or SSA construction pass exists.
      (set! (mut fi) 0)
      (loop (if (>= (load fi) (len (.funs (parser-state))))
                (break 0)
                (let [f (syntax-fun-at (load fi))
                      fun (parser-node (.fun-nid f))
                      scope (scope-make)]
                  (set! (.current-fun (parser-state)) (load fi))
                  (set! (.current-ctrl (parser-state)) (n-nid fun))
                  (set! (.current-scope (parser-state)) (n-nid scope))
                  (n-add-def! scope (Some fun))
                  (n-add-def! scope (Some (con-make TY-BOT)))
                  (scope-push! scope)
                  (let [(mut i) 0]
                    (loop (if (>= (load i) (len (.params f)))
                              (break 0)
                              (do
                                (scope-define! scope
                                               (get (.params f) (load i))
                                               (ty-dyn TAG-ANY)
                                               false
                                               (match (fun-parm fun (load i))
                                                 (Some [p] p)
                                                 (None [] (unreachable-node))))
                                (set! (mut i) (+ (load i) 1))
                                (continue)))))
                  (let [value-nid (lower-syntax-statements (.body f))
                        final-scope (parser-node (.current-scope (parser-state)))
                        value
                          (if (= value-nid 0)
                              (do
                                (panic "parser: function has no return in admitted subset")
                                (unreachable-node))
                              (parser-node value-nid))
                        ret
                          (return-make (scope-ctrl final-scope)
                                       (None [(dyn NodeOps)])
                                       value
                                       (None [(dyn NodeOps)])
                                       (Some fun))]
                    (fun-set-ret! fun ret)
                    (stop-add-return! stop ret))
                  ;; Branches normally merge back into `scope`; loops deliberately replace it
                  ;; with their false-edge exit Scope. Publish and discard the actual final
                  ;; environment, then discard an obsolete loop-entry environment separately.
                  (let [final-scope (parser-node (.current-scope (parser-state)))]
                    (scope-pop! final-scope)
                    (n-kill! final-scope)
                    (if (n-same? final-scope scope) 0 (n-kill! scope)))
                  (set! (mut fi) (+ (load fi) 1))
                  (continue))))
      ;; Closed world: all call edges are now known, so parameter types are driven only by them.
      (set! (mut fi) 0)
      (loop (if (>= (load fi) (len (.funs (parser-state))))
                (break 0)
                (let [f (syntax-fun-at (load fi))]
                  ;; `main` is the externally entered program root. Internal functions close over
                  ;; their concrete call sites; removing main's Start hook would make the entire
                  ;; Stop-rooted program unreachable during optimistic SCCP.
                  (if (= (.name f) "main")
                      0
                      (fun-drop-unknown-callers! (parser-node (.fun-nid f))))
                  (let [fun (parser-node (.fun-nid f))
                        (mut i) 0]
                    (loop (if (>= (load i) (len (.params f)))
                              (break 0)
                              (do
                                (match (fun-parm fun (load i))
                                  (Some [p] (n-unkeep! p))
                                  (None [] 0))
                                (set! (mut i) (+ (load i) 1))
                                (continue)))))
                  (set! (mut fi) (+ (load fi) 1))
                  (continue))))
      (jsl-close-world!)
      stop)))

(defn parse-statement [] (-> (dyn NodeOps))
  (do (unimplemented "parse-statement" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-expression [] (-> (dyn NodeOps))
  (lower-syntax-expr (parse-syntax-add)))

(defn parse-if [] (-> (dyn NodeOps))
  (do (unimplemented "parse-if" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-loop [] (-> (dyn NodeOps))
  (do (unimplemented "parse-loop" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-function [] (-> (dyn NodeOps))
  (do (unimplemented "parse-function" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-class [] (-> (dyn NodeOps))
  (do (unimplemented "parse-class" "S2 — src/parse/parser.coil") (unreachable-node)))

(defn parse-try [] (-> (dyn NodeOps))
  (do (unimplemented "parse-try" "S2 — src/parse/parser.coil") (unreachable-node)))
