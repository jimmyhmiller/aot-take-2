;; The recursive-descent JS/TS parser. Source text in, sea-of-nodes IR out.

;;
;; JavaScript first needs the thin syntax-only tree specified in docs/FRONTEND.md for cover
;; grammars, hoisting, forward type names and capture discovery. There is still NO typed AST or
;; second semantic IR. One lowering walk drives `aot.node.scope` directly, so a variable read is a
;; slot lookup that yields the node currently defining it and an assignment is a slot update — SSA
;; is constructed as a side effect of lowering rather than by a later pass. This preserves Simple's
;; central trick while accommodating syntax that cannot be committed on first token sight.
;;
;; Final Simple's Start receives escaped function identities from Stop memory, and public fields
;; remain callable even before that memory settles. Fun retains its unknown-caller hook for those
;; identities. Our external source boundary has no private-image visibility proof yet, so a
;; materialized function object conservatively retains its generic adapter's hook. This includes
;; returned function expressions and property-published functions, not only named declarations.
;;
;; Final Simple's parsePrimary resolves Scope first, then a type/class name, then creates an FRef
;; outside the enclosing function for later resolution. JavaScript's global object record is an
;; execution-time environment instead: at the external source boundary an otherwise unresolved
;; name checks that record, and a missing binding throws. typeof suppresses only an absent
;; binding; an existing getter's completion still propagates. Cross-unit lexical records need
;; their own resolution path before this object-record fallback (docs/DECISIONS.md).
;;
;; Every construct here is a shape of graph, not a shape of tree:
;;
;;   if/else          dup the scope, lower both arms, merge; Phis appear only where the arms differ
;;   while            the loop protocol in `aot.node.scope` — dup, build, then finalize through
;;                    `scope-end-loop!`, which wires control and immediately fills Phi backedges
;;   ?:               a full Scope diamond with a value Phi pinned to the merged Region
;;
;; Logical expressions use the same Scope diamond and keep their original operand value.
;; break/continue exit through pruned Scope merges into one labelled jump-target stack.
;; Exception unwinding and source-level narrowing remain unimplemented.
;;
;; Final Simple's `parseTrinary` builds the If and both CProjs, duplicates the current Scope for the
;; false arm before parsing the true arm, keeps each arm result across the opposing construction
;; window, restores the false Scope, then balances and merges the complete Scopes. The value Phi is
;; pinned to the Region produced by that merge. We preserve that order; in particular, memory is a
;; Scope slot and therefore joins with arm control rather than following the arm lowered last.
;;
;; Simple's `addReturn` keeps control, memory, and expression in a pruned return Scope until every
;; exit merges. We preserve that lifetime and merge shape in a function-local return accumulator.
;; Bare returns and live fallthrough contribute the canonical boxed `undefined`; recording any
;; return kills only that path's current control, so later syntax is unreachable without becoming a
;; parser error and a sibling branch or loop exit remains live.
;;
;; TypeScript primitive/union annotations are retained in syntax records as unproven evidence.
;; Runtime Parm/Phi types remain dynamic: annotation-driven proof discharge and diagnostics are
;; not implemented yet. Never narrow the executable graph merely because an annotation says so.
;;
;; The admitted subset includes named function declarations, number-annotated parameters/returns,
;; numeric, string, template, regex, array and object literals (with methods and accessors),
;; `this`, `new`, `super`, member chains, calls, bindings, function expressions, arrows,
;; generators, async functions and classes as syntax, the complete operator precedence (forms
;; without production JSL refuse at lowering by name),
;; blocks, `if`/`else`, `switch`, `while`, `do-while`, classic `for`, `break`/`continue` with
;; labels and labelled statements; `for-in/of`, `throw`, `try` and `with` parse and refuse
;; lowering by name. Grammar outside that set
;; fails closed as a compiler refusal, never as a proven SyntaxError; see
;; `token-cannot-start-expression?`. Parsing first produces a THIN syntax tree, then lowering
;; constructs SSA directly. This is the required JavaScript divergence from final Simple's one-pass
;; parser: declarations are hoisted, so every Fun header exists before any body is lowered. The
;; semantic graph remains the only typed IR; syntax nodes carry spans and grammar shape, never
;; inferred types.
;;
;; Lexical declarations differ from Simple's declaration-at-use rule: instantiate the direct
;; let/const declarations of each actual lexical scope before lowering any initializer. ScopeNode
;; owns local/block bindings and their initialization state. Retained Script root let/const
;; bindings instead use realm cells, including runtime TDZ and const-write completions, so
;; callbacks and later Scripts observe the same environment. Statement-only if/while bodies cannot
;; introduce lexical declarations without braces. TDZ reads/writes explicitly refuse compilation
;; until ReferenceError completions exist; they never resolve to an outer name or undefined.
(module aot.parse.parser)
(import "aot.codegen.compunit"
        :use
        [CuScriptDecl
         CuScriptDeclarations
         cu-script-declarations-copy
         CU-SCRIPT-VAR
         CU-SCRIPT-FUNCTION
         CU-SCRIPT-LET
         CU-SCRIPT-CONST
         CU-SCRIPT-CLASS
         CU-SCRIPT-PROPERTY-WRITE])
(import "aot.jsl.reader" :use [JSL-COMPILER-INDEX])
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "aot.codegen.callabi" :use *)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [hm-new hm-contains? hm-put! hm-free! i64-keyops])
(import "aot.node.imagefacts" :use [imagefacts-surface-demands! ImageDemand])
(import "coil.slice" :use [subslice slice-data slice-new])
(import "coil.str"
        :use
        [sb-new
         sb-push-byte!
         sb-push-str!
         sb-push-i64!
         sb-str
         sb-free!
         str-keyops-borrowed])
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.call" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.property" :use *)
(import "aot.node.compare" :use *)
(import "aot.rt.abi" :use *)
(import "aot.rt.number"
        :use
        [number-radix-value
         number-strtod!
         number-bits
         number-word
         NUMBER-INFINITY-BITS
         NUMBER-NAN-BITS])
(import "aot.node.gc" :use *)
(import "aot.node.jsops" :use *)
(import "aot.node.scope" :use *)
(import "aot.type.type" :use *)
(import "aot.shape" :use *)
(import "aot.heap" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.jsl.reader"
        :use
        [jsl-noinline?
         jsl-definition-form
         jsl-form-macro?
         jsl-load-library!
         jsl-throws?])
(import "aot.jsl.decls" :use *)
(import "aot.parse.lexer" :use *)
(import "aot.parse.tstype" :use *)
(import "aot.parse.regex" :use *)

;; The thin syntax tree is a pair of sum types. Every walk over it — strict early errors,
;; declaration collection, break validation, the hidden-class prepass and graph lowering — is an
;; exhaustive `match`, so adding a grammar production is a compile error at every site that has
;; not yet decided what to do with it. Records carry source spans and grammar shape only. Child
;; references are 1-based ids into the parser-owned side arrays; an absent optional child is
;; `None`, never a sentinel id. Operator variants name their JSL entry point directly.
;; One PropertyDefinition. Shorthand `{a}` is desugared to a named property valued by an
;; IdentifierReference at parse time; CoverInitializedName survives only to be reinterpreted as a
;; destructuring pattern and is otherwise a SyntaxError. Methods, accessors and generators are
;; not admitted yet and fail closed.
(defsum PropKey
  (KeyNamed [(key i64)])  ; interned shape key
  (KeyComputed [(expr i64)]))

(defsum ObjectEntry
  (PropValue [(key PropKey) (value i64)])
  (PropMethod [(key PropKey) (fun i64)])  ; method, getter or setter: see the SyntaxFun kind
  (PropSpread [(expr i64)])
  (PropCoverInit [(name (slice u8)) (init i64)]))

;; ClassElementName. Private names keep their spelling without `#`; class keys are not shape keys
;; until classes lower.
(defsum ClassKey
  (CkNamed [(name (slice u8))])
  (CkComputed [(expr i64)])
  (CkPrivate [(name (slice u8))]))

;; A field initializer and a static block each get a method-like SyntaxFun (they evaluate with a
;; home object and their own `arguments`/`await` rules); the field's initializer is that
;; function's expression body.
(defsum ClassElement
  (CeMethod [(key ClassKey) (static bool) (fun i64)])
  (CeField [(key ClassKey) (static bool) (init-fun (Option i64))])
  (CeStaticBlock [(fun i64)]))

(defstruct SyntaxClass
  [(name (slice u8))
   (heritage (Option i64))
   (elements (ArrayList ClassElement))
   (ctor i64)  ; the constructor record: the `constructor` element, or one synthesized empty
   (lo i64)
   (hi i64)])

;; A `.#name` or `#name in` reference awaiting the class that declares the name, and a declared
;; private name (a getter/setter pair may share one name).
(defstruct PrivateRef [(name (slice u8)) (depth i64)])

(defstruct PrivateDecl
  [(name (slice u8)) (static bool) (getter bool) (setter bool)])

;; Destructuring patterns. A binding pattern's leaves are names; an assignment pattern's leaves
;; may also be Reference expressions. Every element may carry a default initializer.
(defsum PatElem
  (PatHole)
  (PatItem [(pattern i64)]))

(defstruct PatProp [(key PropKey) (pattern i64)])

(defsum PatternNode
  (PatName [(name (slice u8))])
  (PatTarget [(expr i64)])  ; assignment pattern leaf: member, index or private member
  (PatObject [(props (ArrayList PatProp)) (rest (Option i64))])
  (PatArray [(elements (ArrayList PatElem)) (rest (Option i64))]))

(defstruct SyntaxPattern
  [(node PatternNode) (default (Option i64)) (lo i64) (hi i64)])

;; What a SyntaxFun is syntactically. Declarations hoist and name a Fun; the others are values.
(defsum FunKind
  (FunDeclaration)
  (FunExpression)
  (FunArrow)
  (FunMethod)
  (FunGetter)
  (FunSetter))

(defsum ArrayElement
  (ElemHole)
  (ElemExpr [(expr i64)])
  (ElemSpread [(expr i64)]))

(defsum SyntaxNode
  (SxNumber [(value i64) (value-float f64) (rep i64)])
  (SxString [(raw (slice u8)) (units (ArrayList i64)) (legacy-escape bool)])
  (SxName [(name (slice u8))])
  (SxSingleton [(name (slice u8))])  ; JsTrue, JsFalse, JsNull
  (SxGroup [(inner i64)])
  (SxObject [(entries (ArrayList ObjectEntry))])
  (SxArray [(elements (ArrayList ArrayElement))])
  (SxMember [(owner i64) (name (slice u8)) (optional bool)])  ; optional: this link is `?.`
  (SxIndex [(owner i64) (key i64) (optional bool)])
  (SxCall [(callee i64) (args (ArrayList i64)) (optional bool)])
  ;; The body of a standard global: a call to a JSL builtin (docs/DECISIONS.md, intrinsics).
  (SxIntrinsic [(builtin (slice u8)) (args (ArrayList i64))])
  (SxNew [(callee i64) (args (ArrayList i64))])
  (SxNewTarget)
  (SxThis)
  (SxSpread [(expr i64)])  ; only as an argument or array element
  (SxImportCall [(specifier i64) (options (Option i64))])
  (SxTemplate [(quasis (ArrayList i64)) (substitutions (ArrayList i64))])  ; quasis: SxString ids
  (SxTaggedTemplate [(tag i64) (template i64)])
  (SxRegex [(body (slice u8)) (flags (slice u8))])
  (SxFunction [(fun i64)])  ; function expression or arrow: index into the SyntaxFun table
  (SxYield [(argument (Option i64)) (delegate bool)])
  (SxAwait [(operand i64)])
  (SxSuper)  ; only as the owner of a member/index or the callee of a call
  (SxClass [(cls i64)])  ; class expression: index into the SyntaxClass table
  (SxDestructuringAssign [(pattern i64) (value i64)])
  (SxPrivateMember [(owner i64) (name (slice u8)) (optional bool)])
  (SxPrivateName [(name (slice u8))])  ; only as the left operand of `in`
  (SxUnary [(op (slice u8)) (operand i64)])
  (SxDelete [(operand i64)])
  (SxUpdate [(op (slice u8)) (prefix bool) (target i64)])
  (SxBinary [(op (slice u8)) (left i64) (right i64)])
  (SxAnd [(left i64) (right i64)])
  (SxOr [(left i64) (right i64)])
  (SxCoalesce [(left i64) (right i64)])
  (SxConditional [(condition i64) (when-true i64) (when-false i64)])
  (SxAssign [(target i64) (value i64)])
  (SxCompoundAssign [(op (slice u8)) (target i64) (value i64)])
  (SxLogicalAssign [(predicate (slice u8))
                    (rhs-on-true bool)
                    (target i64)
                    (value i64)])
  (SxComma [(left i64) (right i64)]))

(defstruct SyntaxExpr [(lo i64) (hi i64) (node SyntaxNode)])

;; The head of a `for` statement: nothing, a declaration statement (var/let/const, possibly a
;; list) or an expression. For-in/of heads reuse it with exactly one binding or one Reference.
(defsum ForInit
  (ForNoInit)
  (ForInitDecl [(stmt i64)])
  (ForInitExpr [(expr i64)])
  (ForInitPattern [(pattern i64)]))  ; an assignment pattern as a for-in/of head

(defsum SyntaxStmtNode
  (SsLet [(name (slice u8)) (init (Option i64)) (final bool) (annotation i64)])
  (SsVar [(name (slice u8)) (init (Option i64)) (annotation i64)])
  (SsLetPattern [(pattern i64) (init (Option i64)) (final bool)])
  (SsVarPattern [(pattern i64) (init (Option i64))])
  (SsDeclList [(decls (ArrayList i64))])
  (SsReturn [(value (Option i64))])
  (SsExpr [(expr i64)])
  (SsBlock [(body (ArrayList i64))])
  (SsIf [(condition i64) (then-stmt i64) (else-stmt (Option i64))])
  (SsWhile [(condition i64) (body i64)])
  (SsEmpty)
  (SsBreak [(label (Option (slice u8)))])
  (SsContinue [(label (Option (slice u8)))])
  (SsSwitch [(discriminant i64) (cases (ArrayList i64))])
  (SsCase [(selector (Option i64)) (body (ArrayList i64))])  ; None selects `default`
  (SsDoWhile [(body i64) (condition i64)])
  (SsFor [(init ForInit) (test (Option i64)) (update (Option i64)) (body i64)])
  (SsForIn [(head ForInit) (of bool) (right i64) (body i64) (awaited bool)])  ; awaited: `for await`
  (SsLabeled [(label (slice u8)) (body i64)])
  (SsThrow [(value i64)])
  (SsTry [(body i64)
          (catch-param (Option i64))
          (catch-body (Option i64))
          (finally-body (Option i64))])  ; catch-param: a pattern
  (SsWith [(object i64) (body i64)])
  (SsDebugger)
  (SsFunctionDecl [(fun i64)])
  (SsClassDecl [(cls i64)]))

(defstruct SyntaxStmt [(lo i64) (hi i64) (node SyntaxStmtNode)])

;; One breakable statement during lowering. `labels` are the labels naming it, `kind` decides
;; which unlabelled jumps it accepts, and a loop also owns the Scope its `continue`s merge into.
(const JUMP-LOOP 1)

(const JUMP-SWITCH 2)

(const JUMP-BLOCK 3)

;; A try statement's catch clause: the target of every throw and unwinding call inside its body.
(const JUMP-CATCH 4)

;; The synthetic Scope variable that carries a thrown value to its catch clause.
(const EXCEPTION-VAR "$aot$.exception")

;; A try statement's finally block: the target of every abrupt completion — a return, or a throw
;; the statement does not catch — that must run the block before leaving (docs/DECISIONS.md,
;; finally). The completion travels in two synthetic Scope variables: its kind and its value.
(const JUMP-FINALLY 5)

(const FINALLY-KIND-VAR "$aot$.finally.kind")

(const FINALLY-VALUE-VAR "$aot$.finally.value")

(const COMPLETION-NORMAL 0)

(const COMPLETION-RETURN 1)

(const COMPLETION-THROW 2)

(defstruct JumpTarget
  [(scope i64)
   (count i64)
   (continue-scope (Option i64))
   (continue-count i64)
   (kind i64)
   (completions i64)  ; a finally target: the completion kinds recorded into it, as bits
   (labels (ArrayList (slice u8)))])

;; A function header. The record is reserved when its keyword is seen so nested functions can
;; name their parent by index (parents therefore precede children), and filled when the body
;; closes. `strict` is settled after parsing from the directive and the enclosing function.
(defstruct SyntaxFun
  [(name (slice u8))
   (kind FunKind)
   (generator bool)
   (async bool)
   (params (ArrayList (slice u8)))
   (param-annotations (ArrayList i64))
   (param-defaults (ArrayList (Option i64)))
   (param-patterns (ArrayList (Option i64)))  ; a destructured parameter; its `params` name is ""
   (rest-param (Option (slice u8)))
   (rest-pattern (Option i64))
   (simple-params bool)
   (return-annotation i64)
   (body (ArrayList i64))
   (expression-body (Option i64))  ; an arrow's concise body
   (parent i64)  ; enclosing SyntaxFun index, or -1 at the top level
   (strict bool)
   (in-class bool)  ; class bodies are strict code
   (hoisted bool)  ; a top-level declaration (or the Script root): lowered as a closed-world Fun
   (value-taken bool)  ; materialized as a function object: its pointer escapes into values
   (lo i64)
   (hi i64)
   (fidx i64)
   (fun-nid i64)
   (adapter-fidx i64)
   (adapter-nid i64)
   (script i64)  ; the realm Script this function belongs to (its position in `scripts`)
   (may-throw bool)  ; can a call to this function complete with the exception sentinel? (syntactic fixpoint)
   (static-entry i64)  ; a hoisted declaration's function object in the static heap image, or -1
   (abi-builtin (slice u8))  ; an intrinsic whose JSL builtin takes the callable ABI: no local body, a forwarding entry
   (arguments-object bool)  ; its code names `arguments`: its entry passes the object in the slot after the formals
   (arguments-unmappable bool)  ; a sloppy mapped object's aliasing would be observable (refused)
   (class-ctor bool)  ; a class's constructor: [[Call]] without `new` is a TypeError
   (derived-ctor bool)  ; a derived class's constructor: `this` waits for `super()`
   (default-derived bool)  ; the synthesized `constructor(...args) { super(...args); }`
   (needs-callee bool)  ; its body needs the function object being called (`super`)
   (needs-home bool)  ; its body reads `super.x`: its function object carries its home object
   (class-index i64)  ; a class constructor: the class whose instance fields it initializes, or -1
   (owns-env bool)  ; a nested function captures one of its bindings: it allocates an environment
   (uses-env bool)  ; it mentions a captured binding of an enclosing activation, or encloses one
   (env-names (ArrayList (slice u8)))  ; its captured bindings, in environment slot order
   (env-lexical (ArrayList i64))  ; 1 where that binding is a lexical, whose slot starts empty
   (reads-captured-lexical bool)])  ; it reads one, so its read can be the dead zone's ReferenceError

;; A var-like global: a top-level `var` or function declaration of some Script of the realm. The
;; realm's global object carries one property per binding from the start.
(defstruct GlobalBinding
  [(name (slice u8))
   (script i64)  ; the first Script declaring the name
   (fun i64)  ; the last function declaration for the name, or -1 for a plain var
   (assigned bool)])  ; something in the realm may store to the name after instantiation

;; The function being parsed. Arrows inherit `this`, `new.target` and `super` from the nearest
;; enclosing non-arrow function, so those questions walk the stack through arrow contexts.
(defstruct FunContext
  [(fun i64)
   (generator bool)
   (async bool)
   (arrow bool)
   (method bool)
   (in-params bool)
   (script-root bool)  ; the Script's own statement list: not a function for `return`/`new.target`
   (field-init bool)  ; a class field initializer: `arguments` is an error
   (static-block bool)  ; a class static block: `return` and `await` are errors, `arguments` too
   (derived-constructor bool)])  ; `super()` is allowed here and in nested arrows

(defn syntax-fun-strict [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (.strict f)))

(defstruct ParserState
  [(exprs (ArrayList SyntaxExpr))
   (stmts (ArrayList SyntaxStmt))
   (funs (ArrayList SyntaxFun))
   (current-fun i64)
   (current-ctrl i64)
   (current-scope i64)
   (return-ctrls (ArrayList i64))
   (return-mems (ArrayList i64))
   (return-values (ArrayList i64))
   (jump-targets (ArrayList JumpTarget))
   (pending-labels (ArrayList (slice u8)))
   (entry-fun-nid i64)
   (script-mode bool)
   (syntax-only bool)
   (strict-pending bool)
   (script-index i64)
   (fun-contexts (ArrayList FunContext))
   (classes (ArrayList SyntaxClass))
   (patterns (ArrayList SyntaxPattern))
   (cover-consumed (ArrayList i64))  ; literals reinterpreted as patterns
   (rest-comma (ArrayList i64))  ; literals whose final `...` element was followed by a comma
   (annexb-blocks (ArrayList i64))  ; synthetic Blocks around `if (x) function f() {}`
   (abi-slots i64)  ; program-wide maximum formal count: every function's argument slots
   (abi-sig i64)  ; the shared boxed signature [ret this new.target slot…]
   (class-depth i64)  ; open class bodies: private-name scope
   (class-strict i64)  ; open class definitions, including name and heritage: strict code
   (private-refs (ArrayList PrivateRef))
   (new-callee bool)
   (spread-trailing-comma bool)  ; the last argument list ended `...x ,)`
   (no-in bool)
   (current-script i64)  ; the Script whose source is being parsed, or -1
   (scripts (ArrayList i64))  ; each Script's root function record, in evaluation order
   (script-declarations (ArrayList (ArrayList CuScriptDecl)))
   (script-functions (ArrayList (ArrayList i64)))  ; local declaration ordinal -> current SyntaxFun
   (callable-roots (ArrayList i64))  ; SyntaxFun IDs whose generic adapters retain unknown callers
   (callers-closed bool)
   (external-mutation bool)  ; source lowering must not assume this source set contains all writes
   (script-unit bool)  ; declarations and evaluation execute through retained Script initializers
   (globals (ArrayList GlobalBinding))
   (namespaces (ArrayList (slice u8)))  ; intrinsic namespace objects the realm materializes (`Math`)
   (namespace-entries (ArrayList i64))  ; their image entries, once the realm is laid out
   (jsl-loaded bool)  ; this compilation already loaded the JSL library
   (pending-bodies (ArrayList i64))  ; records materialized mid-lowering whose bodies wait for a boundary
   (lower-start i64)  ; the program Start and Stop once the passes run, for late materialization, or 0
   (lower-stop i64)
   (late-funs-cap i64)  ; capacities reserved for late materialization (`parser-reserve-late-materialization!`)
   (late-exprs-cap i64)
   (propagates bool)  ; the function being lowered emitted a path that returns the exception sentinel  ; the global object's one hidden class: every global added in table order
   (booted bool)])

(defn parser-state [] (-> (ptr ParserState))
  (compiler-state [ParserState] (primitive/alloc-static CompilerStateSlot)))

(defn parser-reset! [] (-> i64)
  (let [p (parser-state)]
    (if (not (.booted p))
        (do
          (set! (.exprs p) (al-new [SyntaxExpr] (compiler-allocator)))
          (set! (.stmts p) (al-new [SyntaxStmt] (compiler-allocator)))
          (set! (.funs p) (al-new [SyntaxFun] (compiler-allocator)))
          (set! (.return-ctrls p) (al-new [i64] (compiler-allocator)))
          (set! (.return-mems p) (al-new [i64] (compiler-allocator)))
          (set! (.return-values p) (al-new [i64] (compiler-allocator)))
          (set! (.jump-targets p)
                (al-new [JumpTarget] (compiler-allocator)))
          (set! (.pending-labels p)
                (al-new [(slice u8)] (compiler-allocator)))
          (set! (.entry-fun-nid p) 0)
          (set! (.fun-contexts p) (al-new [FunContext] (compiler-allocator)))
          (set! (.classes p) (al-new [SyntaxClass] (compiler-allocator)))
          (set! (.patterns p) (al-new [SyntaxPattern] (compiler-allocator)))
          (set! (.cover-consumed p) (al-new [i64] (compiler-allocator)))
          (set! (.rest-comma p) (al-new [i64] (compiler-allocator)))
          (set! (.annexb-blocks p) (al-new [i64] (compiler-allocator)))
          (set! (.class-depth p) 0)
          (set! (.class-strict p) 0)
          (set! (.private-refs p) (al-new [PrivateRef] (compiler-allocator)))
          (set! (.new-callee p) false)
          (set! (.spread-trailing-comma p) false)
          (set! (.no-in p) false)
          (set! (.current-script p) -1)
          (set! (.scripts p) (al-new [i64] (compiler-allocator)))
          (set! (.script-declarations p)
                (al-new [(ArrayList CuScriptDecl)] (compiler-allocator)))
          (set! (.script-functions p)
                (al-new [(ArrayList i64)] (compiler-allocator)))
          (set! (.callable-roots p) (al-new [i64] (compiler-allocator)))
          (set! (.callers-closed p) false)
          (set! (.external-mutation p) false)
          (set! (.script-unit p) false)
          (set! (.globals p) (al-new [GlobalBinding] (compiler-allocator)))
          (set! (.namespaces p) (al-new [(slice u8)] (compiler-allocator)))
          (set! (.namespace-entries p) (al-new [i64] (compiler-allocator)))
          (set! (.pending-bodies p) (al-new [i64] (compiler-allocator)))
          (set! (.lower-start p) 0)
          (set! (.lower-stop p) 0)
          (set! (.jsl-loaded p) false)
          (set! (.booted p) true)
          0)
        (do
          (al-for [entry (.exprs p)]
                  (let [expr entry]
                    (match (.node expr)
                      (SxString [raw units legacy]
                                (let [(mut owned) units]
                                  (al-free! [i64] (mut owned))))
                      (_ 0))))
          (al-clear! [SyntaxExpr] (mut (.exprs p)))
          (al-clear! [SyntaxStmt] (mut (.stmts p)))
          (al-clear! [SyntaxFun] (mut (.funs p)))
          (al-clear! [i64] (mut (.return-ctrls p)))
          (al-clear! [i64] (mut (.return-mems p)))
          (al-clear! [i64] (mut (.return-values p)))
          (al-clear! [JumpTarget] (mut (.jump-targets p)))
          (al-clear! [(slice u8)] (mut (.pending-labels p)))
          (set! (.entry-fun-nid p) 0)
          (al-clear! [FunContext] (mut (.fun-contexts p)))
          (al-clear! [SyntaxClass] (mut (.classes p)))
          (al-clear! [SyntaxPattern] (mut (.patterns p)))
          (al-clear! [i64] (mut (.cover-consumed p)))
          (al-clear! [i64] (mut (.rest-comma p)))
          (al-clear! [i64] (mut (.annexb-blocks p)))
          (set! (.class-depth p) 0)
          (set! (.class-strict p) 0)
          (al-clear! [PrivateRef] (mut (.private-refs p)))
          (set! (.new-callee p) false)
          (set! (.no-in p) false)
          (set! (.current-script p) -1)
          (al-clear! [i64] (mut (.scripts p)))
          (al-for [entries (.script-declarations p)]
                  (let [(mut owned) entries] (al-free! (mut owned))))
          (al-for [functions (.script-functions p)]
                  (let [(mut owned) functions] (al-free! (mut owned))))
          (al-clear! [(ArrayList CuScriptDecl)] (mut (.script-declarations p)))
          (al-clear! [(ArrayList i64)] (mut (.script-functions p)))
          (al-clear! (mut (.callable-roots p)))
          (set! (.callers-closed p) false)
          (set! (.external-mutation p) false)
          (set! (.script-unit p) false)
          (al-clear! [GlobalBinding] (mut (.globals p)))
          (al-clear! [(slice u8)] (mut (.namespaces p)))
          (al-clear! [i64] (mut (.namespace-entries p)))
          (set! (.jsl-loaded p) false)
          (al-clear! [i64] (mut (.pending-bodies p)))
          (set! (.lower-start p) 0)
          (set! (.lower-stop p) 0)
          0))))

(defn parse-fail [(what (slice u8)) (t Token)] (-> i64)
  (do (panic-i what (.start t)) 0))

;; Only proven grammar/early errors use this channel. A failure to recognize syntax in our
;; incomplete grammar must NOT become a SyntaxError. The syntax-only API never evaluates code.
;; When the token in front of the parser is one the lexer cannot classify (a non-ASCII identifier
;; character, a decorator), the error is about our lexer, not the program, and fails closed.
(defn syntax-error! [(message (slice u8))] (-> i64)
  (let [next (peek-token)]
    (if (token-lexically-unknown? next)
        (parse-fail "parser: lexically unclassified token is outside the admitted subset at byte"
                    next)
        (if (.syntax-only (parser-state))
            (parse-syntax-diagnostic! message)
            (panic message)))))

(defn take-token [] (-> Token)
  (lex-next! false))

(defn peek-token [] (-> Token)
  (lex-peek false))

(defn lex-second-is? [(text (slice u8))] (-> bool)
  (token-is (lex-peek-second false) text))

(defn lex-second-kind? [(kind i64)] (-> bool)
  (let [second (lex-peek-second false)] (= (.kind second) kind)))

(defn take-is [(text (slice u8))] (-> bool)
  (if (token-is (peek-token) text) (do (take-token) true) false))

(defn parser-in-function? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))
        (mut found) false]
    (al-for [entry contexts]
            (let [c entry]
              (if (or (.script-root c) (.static-block c))
                  0
                  (set! (mut found) true))))
    (load found)))

;; The nearest non-arrow context: arrows inherit these questions from their home.
(defn parser-ctx-home [] (-> FunContext)
  (let [contexts (.fun-contexts (parser-state))
        (mut i) (- (len contexts) 1)
        (mut answer) (primitive/zeroed FunContext)]
    (loop (if (< (load i) 0)
              (break 0)
              (let [c (get contexts (load i))]
                (if (.arrow c)
                    (do (set! (mut i) (- (load i) 1)) (continue))
                    (break (do (set! (mut answer) c) 0))))))
    (load answer)))

(defn parser-ctx-forbids-arguments? [] (-> bool)
  (let [home (parser-ctx-home)] (or (.field-init home) (.static-block home))))

(defn parser-ctx-static-block? [] (-> bool)
  (let [home (parser-ctx-home)] (.static-block home)))

(defn parser-ctx-allows-super-call? [] (-> bool)
  (let [home (parser-ctx-home)] (.derived-constructor home)))

;; A `super.x` reference in the method the nearest non-arrow context is parsing: its function object
;; carries the home object, and its entry passes that function object in the hidden callee slot.
(defn parser-ctx-needs-home! [] (-> i64)
  (let [home (parser-ctx-home)
        fi (.fun home)]
    (if (< fi 0)
        (panic "parser-ctx-needs-home!: a super property reference outside every function")
        (let [fp (syntax-fun-ptr fi)]
          (set! (.needs-home fp) true)
          (set! (.needs-callee fp) true)
          0))))

;; `return` is legal directly inside a function or arrow body, never in a static block or Script.
(defn parser-return-allowed? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        false
        (let [top (get contexts (- (len contexts) 1))]
          (or (.arrow top) (not (or (.script-root top) (.static-block top))))))))

(defn parser-current-fun [] (-> i64)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        -1
        (let [top (get contexts (- (len contexts) 1))] (.fun top)))))

(defn parser-ctx-generator? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        false
        (let [top (get contexts (- (len contexts) 1))] (.generator top)))))

(defn parser-ctx-async? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        false
        (let [top (get contexts (- (len contexts) 1))] (.async top)))))

(defn parser-ctx-in-params? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))]
    (if (= (len contexts) 0)
        false
        (let [top (get contexts (- (len contexts) 1))] (.in-params top)))))

;; The nearest non-arrow context decides `this`, `new.target` and `super` questions.
(defn parser-ctx-home-method? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))
        (mut i) (- (len contexts) 1)
        (mut answer) false]
    (loop (if (< (load i) 0)
              (break 0)
              (let [c (get contexts (load i))]
                (if (.arrow c)
                    (do (set! (mut i) (- (load i) 1)) (continue))
                    (break (do (set! (mut answer) (.method c)) 0))))))
    (load answer)))

(defn parser-ctx-allows-new-target? [] (-> bool)
  (let [contexts (.fun-contexts (parser-state))
        (mut found) false]
    (al-for [entry contexts]
            (let [c entry]
              (if (or (.arrow c) (.script-root c)) 0 (set! (mut found) true))))
    (load found)))

(defn parser-push-context! [(fun i64)
                            (generator bool)
                            (async bool)
                            (arrow bool)
                            (method bool)] (-> i64)
  (let [(mut c) (primitive/zeroed FunContext)]
    (set! (.fun (mut c)) fun)
    (set! (.generator (mut c)) generator)
    (set! (.async (mut c)) async)
    (set! (.arrow (mut c)) arrow)
    (set! (.method (mut c)) method)
    (set! (.script-root (mut c)) false)
    (set! (.field-init (mut c)) false)
    (set! (.static-block (mut c)) false)
    (set! (.derived-constructor (mut c)) false)
    (set! (.in-params (mut c)) true)
    (push! [FunContext] (mut (.fun-contexts (parser-state))) (load c))))

;; The Script's statement list gets a context so nested functions have a parent, without being
;; a function: `return`, `new.target` and `var` hoisting still see the Script.
(defn parser-push-root-context! [(fun i64)] (-> i64)
  (do
    (parser-push-context! fun false false false false)
    (let [count (len (.fun-contexts (parser-state)))
          top
            (al-elem [FunContext]
                     (mut (.fun-contexts (parser-state)))
                     (- count 1))]
      (set! (.script-root top) true)
      (set! (.in-params top) false)
      0)))

(defn parser-mark-top-context! [(field-init bool)
                                (static-block bool)
                                (derived bool)] (-> i64)
  (let [count (len (.fun-contexts (parser-state)))
        top
          (al-elem [FunContext]
                   (mut (.fun-contexts (parser-state)))
                   (- count 1))]
    (set! (.field-init top) field-init)
    (set! (.static-block top) static-block)
    (set! (.derived-constructor top) derived)
    0))

(defn parser-set-in-params! [(value bool)] (-> i64)
  (let [count (len (.fun-contexts (parser-state)))
        top
          (al-elem [FunContext]
                   (mut (.fun-contexts (parser-state)))
                   (- count 1))]
    (set! (.in-params top) value)
    0))

(defn parser-pop-context! [] (-> i64)
  (match (pop! (mut (.fun-contexts (parser-state))))
    (None [] (broken "parser-pop-context!: no function context"))
    (Some [c] 0)))

;; BindingIdentifier: a reserved word is a proven error; `yield` and `await` are reserved inside
;; generator and async bodies respectively. A sloppy `let` binding fails closed.
(defn syntax-check-binding-name! [(name (slice u8))] (-> i64)
  (if (and (= name "yield") (parser-ctx-generator?))
      (syntax-error! "parser: yield is not a valid binding identifier in a generator")
      (if (and (= name "await")
               (or (parser-ctx-async?) (parser-ctx-static-block?)))
          (syntax-error! "parser: await is not a valid binding identifier here")
          0)))

(defn require-binding-identifier [] (-> Token)
  (let [t (take-token)]
    (if (= (.kind t) TOK-IDENT)
        (do
          (if (token-escaped-reserved? t)
              (syntax-error! "parser: escaped reserved word cannot be a binding identifier")
              0)
          (syntax-check-binding-name! (token-text t))
          t)
        ;; `let` is a valid sloppy binding name; strict code rejects it in the strict pass and
        ;; lexical declarations reject it where they parse.
        (if (token-is t "let")
            t
            (if (= (.kind t) TOK-KEYWORD)
                (do
                  (syntax-error! "parser: reserved word cannot be a binding identifier")
                  t)
                ;; Every position that admits a BindingPattern parses it before asking for an
                ;; identifier, so a pattern here (an object rest element, a function name) is a
                ;; proven error. A token the lexer could not classify is not.
                (do
                  (if (token-lexically-unknown? t)
                      (parse-fail "parser: non-ASCII identifier is outside the admitted subset at byte"
                                  t)
                      (syntax-error! "parser: expected a binding identifier"))
                  t))))))

;; Tokens this lexer cannot classify: non-ASCII identifiers, decorators. A
;; grammar failure on one of these is not evidence about the program.
(defn token-lexically-unknown? [(t Token)] (-> bool)
  (and (= (.kind t) TOK-PUNCT)
       (let [x (token-text t)]
         (or (= x "@") (>= (get x 0) (cast u8 128))))))

;; A required token that is absent proves a SyntaxError in JavaScript Script code once the grammar
;; up to this point is complete; TypeScript entry mode keeps failing closed because annotations
;; and generics are only partially admitted there.
(defn required-token-missing! [(what (slice u8)) (t Token)] (-> i64)
  (if (and (.script-mode (parser-state)) (not (token-lexically-unknown? t)))
      (syntax-error! what)
      (parse-fail what t)))

(defn require-token [(text (slice u8))] (-> Token)
  (let [t (take-token)]
    (if (token-is t text)
        t
        (do (required-token-missing! "parser: unexpected token" t) t))))

(defn require-ident [] (-> Token)
  (let [t (take-token)]
    (if (= (.kind t) TOK-IDENT)
        t
        (do (required-token-missing! "parser: expected an identifier" t) t))))

;; Property IdentifierName permits reserved words, unlike a binding Identifier.
(defn require-property-name [] (-> Token)
  (let [t (take-token)]
    (if (or (= (.kind t) TOK-IDENT) (= (.kind t) TOK-KEYWORD))
        t
        (do (required-token-missing! "parser: expected a property name" t) t))))

(defn syntax-expr-new [(node SyntaxNode) (lo i64) (hi i64)] (-> SyntaxExpr)
  (let [(mut x) (primitive/zeroed SyntaxExpr)]
    (set! (.lo (mut x)) lo)
    (set! (.hi (mut x)) hi)
    (set! (.node (mut x)) node)
    (load x)))

(defn syntax-add! [(x SyntaxExpr)] (-> i64)
  (do
    (push! [SyntaxExpr] (mut (.exprs (parser-state))) x)
    (len (.exprs (parser-state)))))

(defn syntax-add-node! [(node SyntaxNode) (lo i64) (hi i64)] (-> i64)
  (syntax-add! (syntax-expr-new node lo hi)))

(defn syntax-at [(id i64)] (-> SyntaxExpr)
  (get (.exprs (parser-state)) (- id 1)))

(defn syntax-node [(id i64)] (-> SyntaxNode)
  (let [x (syntax-at id)] (.node x)))

(defn syntax-lo [(id i64)] (-> i64)
  (let [x (syntax-at id)] (.lo x)))

(defn syntax-hi [(id i64)] (-> i64)
  (let [x (syntax-at id)] (.hi x)))

(defn syntax-ungroup-id [(id i64)] (-> i64)
  (match (syntax-node id)
    (SxGroup [inner] (syntax-ungroup-id inner))
    (_ id)))

(defn syntax-name? [(id i64)] (-> bool)
  (match (syntax-node id) (SxName [name] true) (_ false)))

(defn syntax-member? [(id i64)] (-> bool)
  (match (syntax-node id) (SxMember [owner name optional] true) (_ false)))

;; Whether an OptionalExpression owns this member/call spine. Parentheses end the chain, so
;; `(a?.b).c` is an ordinary Reference while `a?.b.c` is not.
;; The innermost expression a member/call spine hangs from: `a.b(c)[d]` roots at `a`.
(defn syntax-spine-root [(id i64)] (-> i64)
  (match (syntax-node id)
    (SxMember [owner name optional] (syntax-spine-root owner))
    (SxPrivateMember [owner name optional] (syntax-spine-root owner))
    (SxIndex [owner key optional] (syntax-spine-root owner))
    (SxCall [callee args optional] (syntax-spine-root callee))
    (SxTaggedTemplate [tag template] (syntax-spine-root tag))
    (_ id)))

(defn syntax-optional-chain? [(id i64)] (-> bool)
  (match (syntax-node id)
    (SxMember [owner name optional]
              (or optional (syntax-optional-chain? owner)))
    (SxPrivateMember [owner name optional]
                     (or optional (syntax-optional-chain? owner)))
    (SxIndex [owner key optional] (or optional (syntax-optional-chain? owner)))
    (SxCall [callee args optional]
            (or optional (syntax-optional-chain? callee)))
    (SxTaggedTemplate [tag template] (syntax-optional-chain? tag))
    (_ false)))

;; ---------------------------------------------------------------------------
;; Destructuring patterns
(defn syntax-pattern-add! [(node PatternNode)
                           (default (Option i64))
                           (lo i64)
                           (hi i64)] (-> i64)
  (let [(mut x) (primitive/zeroed SyntaxPattern)]
    (set! (.node (mut x)) node)
    (set! (.default (mut x)) default)
    (set! (.lo (mut x)) lo)
    (set! (.hi (mut x)) hi)
    (push! [SyntaxPattern] (mut (.patterns (parser-state))) (load x))
    (len (.patterns (parser-state)))))

(defn syntax-pattern-at [(id i64)] (-> SyntaxPattern)
  (get (.patterns (parser-state)) (- id 1)))

(defn syntax-pattern-node [(id i64)] (-> PatternNode)
  (let [x (syntax-pattern-at id)] (.node x)))

(defn syntax-pattern-default [(id i64)] (-> (Option i64))
  (let [x (syntax-pattern-at id)] (.default x)))

;; The names a pattern binds, in source order.
(defn syntax-pattern-names! [(id i64) (out (mut (ArrayList (slice u8))))] (-> i64)
  (do
    (match (syntax-pattern-node id)
      (PatName [name] (push! [(slice u8)] (mut out) name))
      (PatTarget [expr] 0)
      (PatObject [props rest]
                 (do
                   (al-for [prop props]
                           (let [pp prop]
                             (syntax-pattern-names! (.pattern pp) (mut out))))
                   (match rest
                     (Some [r] (syntax-pattern-names! r (mut out)))
                     (None [] 0))))
      (PatArray [elements rest]
                (do
                  (al-for [element elements]
                          (match element
                            (PatItem [pat]
                                     (syntax-pattern-names! pat (mut out)))
                            (PatHole [] 0)))
                  (match rest
                    (Some [r] (syntax-pattern-names! r (mut out)))
                    (None [] 0)))))
    0))

;; The expressions a pattern owns: defaults, computed keys and Reference leaves.
(defn syntax-pattern-exprs! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-pattern-default id)
      (Some [d] (push! [i64] (mut out) d))
      (None [] 0))
    (match (syntax-pattern-node id)
      (PatName [name] 0)
      (PatTarget [expr] (push! [i64] (mut out) expr))
      (PatObject [props rest]
                 (do
                   (al-for [prop props]
                           (let [pp prop]
                             (match (.key pp)
                               (KeyComputed [e] (push! [i64] (mut out) e))
                               (_ 0))
                             (syntax-pattern-exprs! (.pattern pp) (mut out))))
                   (match rest
                     (Some [r] (syntax-pattern-exprs! r (mut out)))
                     (None [] 0))))
      (PatArray [elements rest]
                (do
                  (al-for [element elements]
                          (match element
                            (PatItem [pat]
                                     (syntax-pattern-exprs! pat (mut out)))
                            (PatHole [] 0)))
                  (match rest
                    (Some [r] (syntax-pattern-exprs! r (mut out)))
                    (None [] 0)))))
    0))

;; Every name a function binds through its parameters: plain names, destructured names and the
;; rest element.
(defn syntax-fun-bound-names [(f SyntaxFun)] (-> (ArrayList (slice u8)))
  (let [(mut names) (al-new [(slice u8)] (compiler-allocator))
        (mut i) 0]
    (loop (if (>= (load i) (len (.params f)))
              (break 0)
              (do
                (match (get (.param-patterns f) (load i))
                  (Some [pat] (syntax-pattern-names! pat (mut names)))
                  (None []
                        (push! [(slice u8)]
                               (mut names)
                               (get (.params f) (load i)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (match (.rest-param f)
      (Some [r] (push! [(slice u8)] (mut names) r))
      (None [] 0))
    (match (.rest-pattern f)
      (Some [r] (syntax-pattern-names! r (mut names)))
      (None [] 0))
    (load names)))

;; An assignment pattern reused as a binding pattern: every leaf must be a binding name.
(defn syntax-pattern-require-binding! [(id i64)] (-> i64)
  (do
    (match (syntax-pattern-node id)
      (PatName [name] (syntax-check-binding-name! name))
      (PatTarget [expr] (syntax-error! "parser: invalid binding pattern"))
      (PatObject [props rest]
                 (do
                   (al-for [prop props]
                           (let [pp prop]
                             (syntax-pattern-require-binding! (.pattern pp))))
                   (match rest
                     (Some [r] (syntax-pattern-require-binding! r))
                     (None [] 0))))
      (PatArray [elements rest]
                (do
                  (al-for [element elements]
                          (match element
                            (PatItem [pat]
                                     (syntax-pattern-require-binding! pat))
                            (PatHole [] 0)))
                  (match rest
                    (Some [r] (syntax-pattern-require-binding! r))
                    (None [] 0)))))
    0))

;; Whether any parameter of `f` is a destructuring pattern.
(defn syntax-fun-has-patterns? [(f SyntaxFun)] (-> bool)
  (let [(mut found) (match (.rest-pattern f) (Some [r] true) (None [] false))]
    (al-for [p (.param-patterns f)]
            (match p (Some [pat] (set! (mut found) true)) (None [] 0)))
    (load found)))

;; The one place that knows every variant's children. Generic walks (strict checks, and later any
;; syntax query that does not care about shape) iterate this list instead of repeating the match.
(defn syntax-expr-children! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-node id)
      (SxNumber [value value-float rep] 0)
      (SxString [raw units legacy] 0)
      (SxName [name] 0)
      (SxSingleton [name] 0)
      (SxGroup [inner] (push! [i64] (mut out) inner))
      (SxObject [entries]
                (do
                  (al-for [entry entries]
                          (match entry
                            (PropValue [key value]
                                       (do
                                         (match key
                                           (KeyComputed [e]
                                                        (push! [i64]
                                                               (mut out)
                                                               e))
                                           (_ 0))
                                         (push! [i64] (mut out) value)))
                            (PropMethod [key fun]
                                        (match key
                                          (KeyComputed [e]
                                                       (push! [i64] (mut out) e))
                                          (_ 0)))
                            (PropSpread [expr] (push! [i64] (mut out) expr))
                            (PropCoverInit [name init]
                                           (push! [i64] (mut out) init))))
                  0))
      (SxArray [elements]
               (do
                 (al-for [element elements]
                         (match element
                           (ElemHole [] 0)
                           (ElemExpr [expr] (push! [i64] (mut out) expr))
                           (ElemSpread [expr] (push! [i64] (mut out) expr))))
                 0))
      (SxMember [owner name optional] (push! [i64] (mut out) owner))
      (SxIndex [owner key optional]
               (do (push! [i64] (mut out) owner) (push! [i64] (mut out) key)))
      (SxCall [callee args optional]
              (do
                (push! [i64] (mut out) callee)
                (al-for [arg args] (push! [i64] (mut out) arg))
                0))
      (SxNew [callee args]
             (do
               (push! [i64] (mut out) callee)
               (al-for [arg args] (push! [i64] (mut out) arg))
               0))
      (SxNewTarget [] 0)
      (SxThis [] 0)
      (SxIntrinsic [builtin args] (al-for [a args] (push! [i64] (mut out) a)))
      (SxSpread [expr] (push! [i64] (mut out) expr))
      (SxImportCall [specifier options]
                    (do
                      (push! [i64] (mut out) specifier)
                      (match options
                        (Some [o] (push! [i64] (mut out) o))
                        (None [] 0))))
      (SxTemplate [quasis substitutions]
                  (do
                    (al-for [q quasis] (push! [i64] (mut out) q))
                    (al-for [e substitutions] (push! [i64] (mut out) e))
                    0))
      (SxTaggedTemplate [tag template]
                        (do
                          (push! [i64] (mut out) tag)
                          (push! [i64] (mut out) template)))
      (SxRegex [body flags] 0)
      (SxFunction [fun] 0)
      (SxYield [argument delegate]
               (match argument (Some [a] (push! [i64] (mut out) a)) (None [] 0)))
      (SxAwait [operand] (push! [i64] (mut out) operand))
      (SxSuper [] 0)
      (SxClass [cls] (syntax-class-exprs! cls (mut out)))
      (SxDestructuringAssign [pattern value]
                             (do
                               (syntax-pattern-exprs! pattern (mut out))
                               (push! [i64] (mut out) value)))
      (SxPrivateMember [owner name optional] (push! [i64] (mut out) owner))
      (SxPrivateName [name] 0)
      (SxUnary [op operand] (push! [i64] (mut out) operand))
      (SxDelete [operand] (push! [i64] (mut out) operand))
      (SxUpdate [op prefix target] (push! [i64] (mut out) target))
      (SxBinary [op left right]
                (do (push! [i64] (mut out) left) (push! [i64] (mut out) right)))
      (SxAnd [left right]
             (do (push! [i64] (mut out) left) (push! [i64] (mut out) right)))
      (SxOr [left right]
            (do (push! [i64] (mut out) left) (push! [i64] (mut out) right)))
      (SxCoalesce [left right]
                  (do
                    (push! [i64] (mut out) left)
                    (push! [i64] (mut out) right)))
      (SxConditional [condition when-true when-false]
                     (do
                       (push! [i64] (mut out) condition)
                       (push! [i64] (mut out) when-true)
                       (push! [i64] (mut out) when-false)))
      (SxAssign [target value]
                (do
                  (push! [i64] (mut out) target)
                  (push! [i64] (mut out) value)))
      (SxCompoundAssign [op target value]
                        (do
                          (push! [i64] (mut out) target)
                          (push! [i64] (mut out) value)))
      (SxLogicalAssign [predicate rhs-on-true target value]
                       (do
                         (push! [i64] (mut out) target)
                         (push! [i64] (mut out) value)))
      (SxComma [left right]
               (do (push! [i64] (mut out) left) (push! [i64] (mut out) right))))
    0))

;; Final Simple Parser.parseString consumes the quote, copies ordinary characters, and delegates
;; backslashes to escapedChar; EOF and unknown escapes fail at the literal. ECMAScript extends
;; that scanner with hex/Unicode, identity and legacy decimal/octal escapes and line continuations
;; (ECMA-262 12.9.4). Decode into code units, not UTF-8, to preserve lone surrogates. Raw spelling
;; is retained for Directive Prologues. Legacy escapes are checked after scope strictness is
;; known, including when a later directive makes an earlier literal strict. One growable buffer
;; receives raw UTF-8 runs and decoded escapes; no per-character allocation or runtime decoder.
(defn syntax-string-escape! [(units (mut (ArrayList i64)))
                             (legacy (mut bool))
                             (text (slice u8))
                             (index (mut i64))] (-> i64)
  (let [c (get text (load index))
        (mut value) (cast i64 c)]
    (set! index (+ (load index) 1))
    (if (or (= c (cast u8 120)) (= c (cast u8 117)))
        (let [braced
                (and (= c (cast u8 117))
                     (< (load index) (len text))
                     (= (get text (load index)) (cast u8 123)))
              limit (if (= c (cast u8 120)) 2 4)
              (mut digits) 0]
          (set! (mut value) 0)
          (if braced (set! index (+ (load index) 1)) 0)
          (loop (if (if braced
                        (and (< (load index) (len text))
                             (!= (get text (load index)) (cast u8 125)))
                        (< (load digits) limit))
                    (do
                      (if (>= (load index) (len text))
                          (syntax-error! "parser: truncated string escape")
                          0)
                      (let [digit (lex-digit-value (get text (load index)))]
                        (if (< digit 0)
                            (syntax-error! "parser: invalid hexadecimal string escape")
                            0)
                        (set! (mut value) (+ (* (load value) 16) digit))
                        ;; Bound on every digit prevents overflow even with arbitrarily many digits.
                        (if (> (load value) 0x10ffff)
                            (syntax-error! "parser: Unicode escape exceeds code point range")
                            0))
                      (set! index (+ (load index) 1))
                      (set! (mut digits) (+ (load digits) 1))
                      (continue))
                    (break 0)))
          (if braced
              (do
                (if (or (= (load digits) 0) (>= (load index) (len text)))
                    (syntax-error! "parser: incomplete braced Unicode escape")
                    0)
                (set! index (+ (load index) 1)))
              0))
        (if (lex-digit? c)
            (do
              (set! legacy
                    (or (load legacy)
                        (!= c (cast u8 48))
                        (and (< (load index) (len text))
                             (lex-digit? (get text (load index))))))
              (if (<= c (cast u8 55))
                  (let [limit (if (<= c (cast u8 51)) 3 2)
                        (mut digits) 1]
                    (set! (mut value) (- (cast i64 c) 48))
                    (loop (if (and (< (load digits) limit)
                                   (< (load index) (len text))
                                   (lex-radix-digit? (get text (load index)) 8))
                              (do
                                (set! (mut value)
                                      (+ (* (load value) 8)
                                         (- (cast i64 (get text (load index)))
                                            48)))
                                (set! index (+ (load index) 1))
                                (set! (mut digits) (+ (load digits) 1))
                                (continue))
                              (break 0))))
                  0))
            (set! (mut value)
                  (if (= c (cast u8 98))
                      8
                      (if (= c (cast u8 102))
                          12
                          (if (= c (cast u8 110))
                              10
                              (if (= c (cast u8 114))
                                  13
                                  (if (= c (cast u8 116))
                                      9
                                      (if (= c (cast u8 118)) 11 (cast i64 c))))))))))
    (if (<= (load value) 0xffff)
        (push! [i64] (mut units) (load value))
        (let [supplement (- (load value) 0x10000)]
          (push! [i64] (mut units) (+ 0xd800 (primitive/ishr supplement 10)))
          (push! [i64] (mut units) (+ 0xdc00 (& supplement 0x3ff)))))
    0))

;; Decode a string or template body into UTF-16 code units. `abs-start` is the source offset of
;; `text` so line continuations can be measured in place. Template bodies (TV) additionally
;; normalize CR and CRLF to LF and treat every legacy escape as a NotEscapeSequence error.
(defn syntax-decode-string-body! [(text (slice u8))
                                  (abs-start i64)
                                  (template bool)
                                  (units (mut (ArrayList i64)))
                                  (legacy (mut bool))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len text))
              (break 0)
              (do
                (if (= (get text (load i)) (cast u8 92))
                    (do
                      (set! (mut i) (+ (load i) 1))
                      (if (>= (load i) (len text))
                          (syntax-error! "parser: truncated string escape")
                          0)
                      (let [width (lex-line-width (+ abs-start (load i)))]
                        (if (> width 0)
                            (set! (mut i) (+ (load i) width))
                            (if (< (get text (load i)) (cast u8 128))
                                (do
                                  (syntax-string-escape! (mut units)
                                                         (mut legacy)
                                                         text
                                                         (mut i))
                                  (if (and template (load legacy))
                                      (syntax-error! "parser: octal escape sequence is not allowed in a template")
                                      0))
                                ;; Non-ASCII NonEscapeCharacter: the raw-run decoder below consumes
                                ;; its entire scalar, not merely the first UTF-8 byte.
                                0))))
                    0)
                (let [start (load i)]
                  (loop (if (and (< (load i) (len text))
                                 (!= (get text (load i)) (cast u8 92))
                                 (not (and template
                                           (= (get text (load i)) (cast u8 13)))))
                            (do (set! (mut i) (+ (load i) 1)) (continue))
                            (break 0)))
                  (jsl-string-append-utf8! (subslice [u8] text start (load i))
                                           (mut units))
                  (if (and template
                           (< (load i) (len text))
                           (= (get text (load i)) (cast u8 13)))
                      (do
                        (push! [i64] (mut units) 10)
                        (set! (mut i) (+ (load i) 1))
                        (if (and (< (load i) (len text))
                                 (= (get text (load i)) (cast u8 10)))
                            (set! (mut i) (+ (load i) 1))
                            0))
                      0))
                (continue))))
    0))

(defn syntax-string [(t Token)] (-> SyntaxExpr)
  (let [text (subslice [u8] (token-text t) 1 (- (- (.end t) (.start t)) 1))
        (mut units) (al-new [i64] (compiler-allocator))
        (mut legacy) false]
    (syntax-decode-string-body! text
                                (+ (.start t) 1)
                                false
                                (mut units)
                                (mut legacy))
    (syntax-expr-new (SxString
                       :raw text
                       :units (load units)
                       :legacy-escape (load legacy))
                     (.start t)
                     (.end t))))

;; One template quasi. A tagged template keeps only raw text: its cooked value may be undefined
;; and this compiler does not evaluate tagged templates yet.
(defn syntax-template-quasi [(part Token) (tagged bool)] (-> i64)
  (let [inner-end (- (.end part) (if (lex-template-continues? part) 2 1))
        text (subslice [u8] (lex-source) (+ (.start part) 1) inner-end)
        (mut units) (al-new [i64] (compiler-allocator))
        (mut legacy) false]
    (if tagged
        0
        (syntax-decode-string-body! text
                                    (+ (.start part) 1)
                                    true
                                    (mut units)
                                    (mut legacy)))
    (syntax-add-node! (SxString
                        :raw text
                        :units (load units)
                        :legacy-escape false)
                      (.start part)
                      (.end part))))

;; Declare the shapes the source spells out — object literals and the realm's global object —
;; before lowering, so a literal's layout is one canonical transition path however many places
;; build it. Nothing else is declared: a named write to an owner the compiler cannot see is a
;; runtime transition (`aot.rt.shapes`), never a compile-time one. The closure this pass once
;; took over every written key multiplied the shape universe by every permutation of those keys
;; (docs/DECISIONS.md, generic property access) and could not even close it.
(defn syntax-declare-object-shapes! [] (-> i64)
  (let [(mut i) 0
        (mut declared) 0]
    (loop (if (>= (load i) (len (.exprs (parser-state))))
              (break 0)
              (let [x (get (.exprs (parser-state)) (load i))]
                (match (.node x)
                  (SxObject [entries]
                            (let [(mut shape) SHAPE-EMPTY]
                              ;; The object-initializer `__proto__` setter mutates the stable
                              ;; prototype slot; it does not define a data property or create a
                              ;; hidden-class transition. Computed and spread entries refuse
                              ;; lowering, so they declare no layout here.
                              (al-for [entry entries]
                                      (match entry
                                        (PropValue [prop-key value]
                                                   (match prop-key
                                                     (KeyNamed [key]
                                                               (if (= (shape-key-name key)
                                                                      "__proto__")
                                                                   0
                                                                   (set! (mut shape)
                                                                         (shape-transition (load shape)
                                                                                           (shape-key-name key)))))
                                                     (_ 0)))
                                        (_ 0)))
                              (set! (mut declared) (+ (load declared) 1))))
                  (_ 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; The realm's global object is built by adding every var-like global in table order; a
    ;; lexically resolved global is a field access over that one hidden class.
    (if (> (len (.globals (parser-state))) 0)
        (let [(mut shape) SHAPE-EMPTY]
          (al-for [g (.globals (parser-state))]
                  (let [binding g]
                    (set! (mut shape)
                          (shape-transition (load shape) (.name binding)))))
          (set! (mut declared) (+ (load declared) 1))
          0)
        0)
    (load declared)))

(defn syntax-stmt-new [(node SyntaxStmtNode) (lo i64) (hi i64)] (-> SyntaxStmt)
  (let [(mut s) (primitive/zeroed SyntaxStmt)]
    (set! (.lo (mut s)) lo)
    (set! (.hi (mut s)) hi)
    (set! (.node (mut s)) node)
    (load s)))

(defn syntax-stmt-add! [(s SyntaxStmt)] (-> i64)
  (do
    (push! [SyntaxStmt] (mut (.stmts (parser-state))) s)
    (len (.stmts (parser-state)))))

(defn syntax-stmt-add-node! [(node SyntaxStmtNode) (lo i64) (hi i64)] (-> i64)
  (syntax-stmt-add! (syntax-stmt-new node lo hi)))

(defn syntax-stmt-at [(id i64)] (-> SyntaxStmt)
  (get (.stmts (parser-state)) (- id 1)))

(defn syntax-stmt-node [(id i64)] (-> SyntaxStmtNode)
  (let [s (syntax-stmt-at id)] (.node s)))

(defn syntax-stmt-lo [(id i64)] (-> i64)
  (let [x (get (.stmts (parser-state)) (- id 1))] (.lo x)))

(defn syntax-stmt-hi [(id i64)] (-> i64)
  (let [s (syntax-stmt-at id)] (.hi s)))

;; Nested statement ids of one statement, exhaustively. Declaration lists and case clauses are
;; grouping only; blocks, branches and loops introduce nesting the walks below care about.
(defn syntax-stmt-children! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-stmt-node id)
      (SsLet [name init final annotation] 0)
      (SsVar [name init annotation] 0)
      (SsLetPattern [pattern init final] 0)
      (SsVarPattern [pattern init] 0)
      (SsDeclList [decls] (do (al-for [d decls] (push! [i64] (mut out) d)) 0))
      (SsReturn [value] 0)
      (SsExpr [expr] 0)
      (SsBlock [body] (do (al-for [s body] (push! [i64] (mut out) s)) 0))
      (SsIf [condition then-stmt else-stmt]
            (do
              (push! [i64] (mut out) then-stmt)
              (match else-stmt (Some [e] (push! [i64] (mut out) e)) (None [] 0))))
      (SsWhile [condition body] (push! [i64] (mut out) body))
      (SsEmpty [] 0)
      (SsBreak [label] 0)
      (SsContinue [label] 0)
      (SsSwitch [discriminant cases]
                (do (al-for [c cases] (push! [i64] (mut out) c)) 0))
      (SsCase [selector body]
              (do (al-for [s body] (push! [i64] (mut out) s)) 0))
      (SsDoWhile [body condition] (push! [i64] (mut out) body))
      (SsFor [init test update body]
             (do
               (match init
                 (ForInitDecl [stmt] (push! [i64] (mut out) stmt))
                 (_ 0))
               (push! [i64] (mut out) body)))
      (SsForIn [head of right body awaited]
               (do
                 (match head
                   (ForInitDecl [stmt] (push! [i64] (mut out) stmt))
                   (_ 0))
                 (push! [i64] (mut out) body)))
      (SsLabeled [label body] (push! [i64] (mut out) body))
      (SsThrow [value] 0)
      (SsTry [body catch-param catch-body finally-body]
             (do
               (push! [i64] (mut out) body)
               (match catch-body
                 (Some [c] (push! [i64] (mut out) c))
                 (None [] 0))
               (match finally-body
                 (Some [f] (push! [i64] (mut out) f))
                 (None [] 0))))
      (SsWith [object body] (push! [i64] (mut out) body))
      (SsDebugger [] 0)
      (SsFunctionDecl [fun] 0)
      (SsClassDecl [cls] 0))
    0))

;; The expressions one statement owns, exhaustively — the counterpart of `syntax-stmt-children!`,
;; which gives its nested statements. A generic walk over a body reaches every expression of it by
;; iterating both; neither descends into a nested function record.
(defn syntax-stmt-exprs! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-stmt-node id)
      (SsLet [name init final annotation]
             (match init (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsVar [name init annotation]
             (match init (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsLetPattern [pattern init final]
                    (match init
                      (Some [e] (push! [i64] (mut out) e))
                      (None [] 0)))
      (SsVarPattern [pattern init]
                    (match init
                      (Some [e] (push! [i64] (mut out) e))
                      (None [] 0)))
      (SsDeclList [decls] 0)
      (SsReturn [value]
                (match value (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsExpr [expr] (push! [i64] (mut out) expr))
      (SsBlock [body] 0)
      (SsIf [condition then-stmt else-stmt] (push! [i64] (mut out) condition))
      (SsWhile [condition body] (push! [i64] (mut out) condition))
      (SsEmpty [] 0)
      (SsBreak [label] 0)
      (SsContinue [label] 0)
      (SsSwitch [discriminant cases] (push! [i64] (mut out) discriminant))
      (SsCase [selector body]
              (match selector (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsDoWhile [body condition] (push! [i64] (mut out) condition))
      (SsFor [init test update body]
             (do
               (match init
                 (ForInitExpr [e] (push! [i64] (mut out) e))
                 (_ 0))
               (match test (Some [e] (push! [i64] (mut out) e)) (None [] 0))
               (match update (Some [e] (push! [i64] (mut out) e)) (None [] 0))))
      (SsForIn [head of right body awaited]
               (do
                 (match head
                   (ForInitExpr [e] (push! [i64] (mut out) e))
                   (_ 0))
                 (push! [i64] (mut out) right)))
      (SsLabeled [label body] 0)
      (SsThrow [value] (push! [i64] (mut out) value))
      (SsTry [body catch-param catch-body finally-body] 0)
      (SsWith [object body] (push! [i64] (mut out) object))
      (SsDebugger [] 0)
      (SsFunctionDecl [fun] 0)
      (SsClassDecl [cls] 0))
    0))

;; The expressions a class body owns outside its methods: the heritage and computed keys.
;; Method bodies and field initializers are SyntaxFun records walked by the function passes.
(defn syntax-class-exprs! [(cls i64) (out (mut (ArrayList i64)))] (-> i64)
  (let [c (get (.classes (parser-state)) cls)]
    (match (.heritage c) (Some [h] (push! [i64] (mut out) h)) (None [] 0))
    (al-for [element (.elements c)]
            (let [key
                    (match element
                      (CeMethod [key is-static fun] key)
                      (CeField [key is-static init-fun] key)
                      (CeStaticBlock [fun] (CkNamed "")))]
              (match key (CkComputed [e] (push! [i64] (mut out) e)) (_ 0))))
    0))

;; Expression ids directly owned by one statement, exhaustively.
(defn syntax-stmt-exprs! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-stmt-node id)
      (SsLet [name init final annotation]
             (match init (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsVar [name init annotation]
             (match init (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsLetPattern [pattern init final]
                    (do
                      (syntax-pattern-exprs! pattern (mut out))
                      (match init
                        (Some [e] (push! [i64] (mut out) e))
                        (None [] 0))))
      (SsVarPattern [pattern init]
                    (do
                      (syntax-pattern-exprs! pattern (mut out))
                      (match init
                        (Some [e] (push! [i64] (mut out) e))
                        (None [] 0))))
      (SsDeclList [decls] 0)
      (SsReturn [value]
                (match value (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsExpr [expr] (push! [i64] (mut out) expr))
      (SsBlock [body] 0)
      (SsIf [condition then-stmt else-stmt] (push! [i64] (mut out) condition))
      (SsWhile [condition body] (push! [i64] (mut out) condition))
      (SsEmpty [] 0)
      (SsBreak [label] 0)
      (SsContinue [label] 0)
      (SsSwitch [discriminant cases] (push! [i64] (mut out) discriminant))
      (SsCase [selector body]
              (match selector (Some [e] (push! [i64] (mut out) e)) (None [] 0)))
      (SsDoWhile [body condition] (push! [i64] (mut out) condition))
      (SsFor [init test update body]
             (do
               (match init
                 (ForInitExpr [e] (push! [i64] (mut out) e))
                 (ForInitPattern [pat] (syntax-pattern-exprs! pat (mut out)))
                 (_ 0))
               (match test (Some [e] (push! [i64] (mut out) e)) (None [] 0))
               (match update (Some [e] (push! [i64] (mut out) e)) (None [] 0))))
      (SsForIn [head of right body awaited]
               (do
                 (match head
                   (ForInitExpr [e] (push! [i64] (mut out) e))
                   (ForInitPattern [pat] (syntax-pattern-exprs! pat (mut out)))
                   (_ 0))
                 (push! [i64] (mut out) right)))
      (SsLabeled [label body] 0)
      (SsThrow [value] (push! [i64] (mut out) value))
      (SsTry [body catch-param catch-body finally-body]
             (match catch-param
               (Some [pat] (syntax-pattern-exprs! pat (mut out)))
               (None [] 0)))
      (SsWith [object body] (push! [i64] (mut out) object))
      (SsDebugger [] 0)
      (SsFunctionDecl [fun] 0)
      (SsClassDecl [cls] (syntax-class-exprs! cls (mut out))))
    0))

;; Power-of-two radix integers: the exact conversion is shared with the runtime's StringToNumber
;; (aot.rt.number, `number-radix-value`).
(defn parse-radix-number [(text (slice u8)) (start i64) (width i64)] (-> f64)
  (number-radix-value text start width))

;; ECMAScript decimal integer literals denote binary64 Numbers, even when their spelling no longer
;; fits the signed-48 immediate payload. Parse through `strtod` first, then choose the compact int
;; representation only where binary64 is exact and the NaN-box payload can preserve every bit.
;; Accumulating in i64 first silently wrapped long spellings before this decision could be made.
(defn parse-number-value [(t Token)] (-> f64)
  (let [text (token-text t)]
    (if (= (.kind t) TOK-LEGACY-NUMBER)
        (parse-radix-number text 0 3)
        (if (and (> (len text) 2)
                 (= (get text 0) (cast u8 48))
                 (or (= (get text 1) (cast u8 120))
                     (= (get text 1) (cast u8 88))
                     (= (get text 1) (cast u8 98))
                     (= (get text 1) (cast u8 66))
                     (= (get text 1) (cast u8 111))
                     (= (get text 1) (cast u8 79))))
            (let [prefix (get text 1)]
              (parse-radix-number text
                                  2
                                  (if (or (= prefix (cast u8 120))
                                          (= prefix (cast u8 88)))
                                      4
                                      (if (or (= prefix (cast u8 98))
                                              (= prefix (cast u8 66)))
                                          1
                                          3))))
            (let [(mut normalized) (sb-new (compiler-allocator))]
              (for c
                (iter text)
                (if (!= c (cast u8 95)) (sb-push-byte! (mut normalized) c) 0))
              (let [size (len (sb-str (load normalized)))
                    consumed (primitive/alloc-stack i64)
                    value (number-strtod! (sb-str (load normalized)) consumed)]
                (if (!= (load consumed) size)
                    (parse-fail "parser: invalid numeric literal at byte" t)
                    0)
                (sb-free! (mut normalized))
                value))))))

(defn syntax-number [(t Token)] (-> SyntaxExpr)
  (let [value (parse-number-value t)]
    (syntax-expr-new (if (and (primitive/fcmp-le value 140737488355327.0)
                              (primitive/fcmp-eq value
                                                 (primitive/cast f64
                                                                 (primitive/cast i64
                                                                                 value))))
                         (SxNumber
                           :value (primitive/cast i64 value)
                           :value-float 0.0
                           :rep REP-INT)
                         (SxNumber
                           :value 0
                           :value-float value
                           :rep REP-DOUBLE))
                     (.start t)
                     (.end t))))

;; A token that can never begin an ECMAScript expression proves a SyntaxError. Tokens that begin
;; grammar this parser has not admitted yet (regex, template, array literal, function, class,
;; `this`, `new`, `super`, `import`, escaped or non-ASCII identifiers) must fail closed instead.
(defn token-cannot-start-expression? [(t Token)] (-> bool)
  (if (= (.kind t) TOK-EOF)
      true
      (if (= (.kind t) TOK-PUNCT)
          (let [x (token-text t)]
            (not (or (= x "(")
                     (= x "{")
                     (= x "#")
                     (= x "\\")
                     (= x "@")
                     (>= (get x 0) (cast u8 128)))))
          (if (= (.kind t) TOK-KEYWORD)
              (let [x (token-text t)]
                (not (or (= x "function")
                         (= x "class")
                         (= x "super")
                         (= x "let"))))
              false))))

(defn parse-primary-fallback [(t Token)] (-> i64)
  (if (token-cannot-start-expression? t)
      (syntax-error! "parser: expected an expression")
      (do
        (parse-fail "parser: primary is outside the admitted subset at byte" t)
        0)))

;; PropertyName as an interned shape key. IdentifierNames, plain ASCII string literals and
;; integral numeric literals canonicalize to the same key as the identifier spelling; escaped,
;; non-ASCII and non-integral spellings fail closed.
(defn syntax-property-key-name [(t Token)] (-> (slice u8))
  (if (or (= (.kind t) TOK-IDENT) (= (.kind t) TOK-KEYWORD))
      (token-text t)
      (if (= (.kind t) TOK-STRING)
          (let [inner
                  (subslice [u8] (token-text t) 1 (- (- (.end t) (.start t)) 1))]
            (for c
              (iter inner)
              (if (or (= c (cast u8 92)) (>= c (cast u8 128)))
                  (parse-fail "parser: escaped or non-ASCII string property keys are outside the admitted subset at byte"
                              t)
                  0))
            inner)
          (if (or (= (.kind t) TOK-NUMBER) (= (.kind t) TOK-LEGACY-NUMBER))
              (let [x (syntax-number t)]
                (match (.node x)
                  (SxNumber [value value-float rep]
                            (if (= rep REP-INT)
                                (let [(mut text) (sb-new (compiler-allocator))]
                                  ;; The key outlives the parse; the builder is deliberately retained.
                                  (sb-push-i64! (mut text) value)
                                  (sb-str (load text)))
                                (do
                                  (parse-fail "parser: non-integral numeric property keys are outside the admitted subset at byte"
                                              t)
                                  "")))
                  (_ "")))
              (do
                (parse-fail "parser: property key is outside the admitted subset at byte"
                            t)
                "")))))

(defn token-property-name? [(t Token)] (-> bool)
  (or (= (.kind t) TOK-IDENT)
      (= (.kind t) TOK-KEYWORD)
      (= (.kind t) TOK-STRING)
      (= (.kind t) TOK-NUMBER)
      (= (.kind t) TOK-LEGACY-NUMBER)
      (= (.kind t) TOK-BIGINT)
      (token-is t "[")
      (token-is t "#")))

;; After a complete list element only a separator or the closer may follow.
(defn parse-list-separator! [(close (slice u8)) (message (slice u8))] (-> bool)
  (let [t (peek-token)]
    (if (token-is t ",")
        (do (take-token) (take-is close))
        (if (token-is t close)
            (do (take-token) true)
            (do
              (syntax-error! message)
              true)))))

;; PropertyName: IdentifierName, string, number or `[expr]`, with what the definition needs to
;; know about its spelling afterwards.
(defstruct ParsedKey
  [(key PropKey)
   (name (slice u8))
   (ident bool)  ; spelled as an Identifier, so shorthand is possible
   (computed bool)
   (named-proto bool)
   (lo i64)
   (hi i64)])

(defn parse-syntax-property-key! [] (-> ParsedKey)
  (let [(mut k) (primitive/zeroed ParsedKey)
        t (peek-token)]
    (set! (.lo (mut k)) (.start t))
    (if (token-is t "[")
        (let [saved-no-in (.no-in (parser-state))]
          (take-token)
          (set! (.no-in (parser-state)) false)
          (let [expr (parse-syntax-assignment)]
            (set! (.no-in (parser-state)) saved-no-in)
            (require-closing! "]"
                              "parser: expected `]` after computed property name")
            (set! (.key (mut k)) (KeyComputed expr))
            (set! (.name (mut k)) "")
            (set! (.computed (mut k)) true)))
        (if (token-is t "#")
            (do
              (syntax-error! "parser: private names are not allowed in object literals")
              0)
            (if (not (token-property-name? t))
                (do
                  (syntax-error! "parser: expected a property name in object literal")
                  0)
                (let [key-token (take-token)
                      name (syntax-property-key-name key-token)]
                  (set! (.key (mut k)) (KeyNamed (shape-key-intern name)))
                  (set! (.name (mut k)) name)
                  ;; Shorthand needs an Identifier; an escaped reserved word is only an IdentifierName.
                  (set! (.ident (mut k))
                        (and (= (.kind key-token) TOK-IDENT)
                             (not (token-escaped-reserved? key-token))))
                  (set! (.named-proto (mut k))
                        (and (= name "__proto__")
                             (!= (.kind key-token) TOK-NUMBER)))))))
    (set! (.hi (mut k)) (lex-consumed-end))
    (load k)))

;; PropertyDefinition: `...spread`, `*gen(){}`, `get k(){}` / `set k(v){}` / `async k(){}` /
;; `async *k(){}`, `k(){}`, `k: value`, shorthand `k`, or the cover form `k = init`.
(defn parse-syntax-property-definition! [(saw-proto (mut bool))] (-> ObjectEntry)
  (let [first (peek-token)]
    (if (token-is first "...")
        (do (take-token) (PropSpread (parse-syntax-assignment)))
        (if (token-is first "*")
            (do
              (take-token)
              (let [k (parse-syntax-property-key!)]
                (parse-syntax-method! (.key k)
                                      (.name k)
                                      (FunMethod)
                                      true
                                      false
                                      (.start first))))
            (let [second (lex-peek-second false)
                  prefix
                    (and (= (.kind first) TOK-IDENT)
                         (or (token-is first "get")
                             (token-is first "set")
                             (token-is first "async"))
                         (or (token-property-name? second)
                             (token-is second "*"))
                         (not (and (token-is first "async") (.nl-before second))))]
              (if prefix
                  (do
                    (take-token)
                    (let [async (token-is first "async")
                          generator (and async (take-is "*"))
                          k (parse-syntax-property-key!)
                          kind
                            (if (token-is first "get")
                                (FunGetter)
                                (if (token-is first "set")
                                    (FunSetter)
                                    (FunMethod)))]
                      (parse-syntax-method! (.key k)
                                            (.name k)
                                            kind
                                            generator
                                            async
                                            (.start first))))
                  (let [k (parse-syntax-property-key!)
                        next (peek-token)]
                    (if (token-is next "(")
                        (parse-syntax-method! (.key k)
                                              (.name k)
                                              (FunMethod)
                                              false
                                              false
                                              (.lo k))
                        (if (token-is next ":")
                            (do
                              (take-token)
                              (if (.named-proto k)
                                  (if (load saw-proto)
                                      (syntax-error! "parser: duplicate __proto__ object-literal setter")
                                      (set! saw-proto true))
                                  0)
                              (PropValue (.key k) (parse-syntax-assignment)))
                            (if (.computed k)
                                (do
                                  (syntax-error! "parser: computed property name requires a value")
                                  (PropSpread 0))
                                (if (= (.name k) "let")
                                    ;; Sloppy shorthand `{let}`; strict code rejects the name.
                                    (PropValue (.key k)
                                               (syntax-add-node! (SxName "let")
                                                                 (.lo k)
                                                                 (.hi k)))
                                    (if (not (.ident k))
                                        (do
                                          (syntax-error! "parser: shorthand property requires an identifier")
                                          (PropSpread 0))
                                        (if (token-is next "=")
                                            (do
                                              (take-token)
                                              (PropCoverInit (.name k)
                                                             (parse-syntax-assignment)))
                                            (do
                                              (syntax-check-binding-name! (.name k))
                                              (PropValue (.key k)
                                                         (syntax-add-node! (SxName (.name k))
                                                                           (.lo k)
                                                                           (.hi k)))))))))))))))))

(defn parse-syntax-object-literal [(open Token)] (-> i64)
  (let [(mut entries) (al-new [ObjectEntry] (compiler-allocator))
        (mut saw-prototype-setter) false
        (mut rest-comma) false]
    (if (not (take-is "}"))
        (loop (let [entry
                      (parse-syntax-property-definition! (mut saw-prototype-setter))]
                (push! [ObjectEntry] (mut entries) entry)
                ;; `{...a,}` is a valid literal but never a pattern.
                (set! (mut rest-comma)
                      (match entry
                        (PropSpread [e] (token-is (peek-token) ","))
                        (_ false)))
                (if (parse-list-separator! "}"
                                           "parser: expected `,` or `}` in object literal")
                    (break 0)
                    (continue))))
        0)
    (let [id
            (syntax-add-node! (SxObject (load entries))
                              (.start open)
                              (lex-consumed-end))]
      (if (load rest-comma)
          (push! [i64] (mut (.rest-comma (parser-state))) id)
          0)
      id)))

(defn parse-syntax-array-literal [(open Token)] (-> i64)
  (let [(mut elements) (al-new [ArrayElement] (compiler-allocator))
        (mut rest-comma) false]
    (if (not (take-is "]"))
        (loop (let [first (peek-token)]
                (if (token-is first ",")
                    (do
                      (take-token)
                      (push! [ArrayElement] (mut elements) (ElemHole))
                      (if (take-is "]") (break 0) (continue)))
                    (do
                      (if (token-is first "...")
                          (do
                            (take-token)
                            (push! [ArrayElement]
                                   (mut elements)
                                   (ElemSpread (parse-syntax-assignment)))
                            ;; `[...a,]` is a valid literal but never a pattern.
                            (set! (mut rest-comma) (token-is (peek-token) ",")))
                          (do
                            (push! [ArrayElement]
                                   (mut elements)
                                   (ElemExpr (parse-syntax-assignment)))
                            (set! (mut rest-comma) false)))
                      (if (parse-list-separator! "]"
                                                 "parser: expected `,` or `]` in array literal")
                          (break 0)
                          (continue))))))
        0)
    (let [id
            (syntax-add-node! (SxArray (load elements))
                              (.start open)
                              (lex-consumed-end))]
      (if (load rest-comma)
          (push! [i64] (mut (.rest-comma (parser-state))) id)
          0)
      id)))

;; Arguments: AssignmentExpressions and `...spread`, with an optional trailing comma.
(defn parse-syntax-arguments [] (-> (ArrayList i64))
  (let [(mut args) (al-new [i64] (compiler-allocator))]
    (set! (.spread-trailing-comma (parser-state)) false)
    (if (not (take-is ")"))
        (loop (let [spread (token-is (peek-token) "...")]
                (if spread
                    (let [dots (take-token)
                          value (parse-syntax-assignment)]
                      (push! [i64]
                             (mut args)
                             (syntax-add-node! (SxSpread value)
                                               (.start dots)
                                               (syntax-hi value))))
                    (push! [i64] (mut args) (parse-syntax-assignment)))
                (let [comma (token-is (peek-token) ",")]
                  (if (parse-list-separator! ")"
                                             "parser: expected `,` or `)` in argument list")
                      (do
                        (if (and spread comma)
                            (set! (.spread-trailing-comma (parser-state)) true)
                            0)
                        (break 0))
                      (continue)))))
        0)
    (load args)))

;; `import(specifier)` / `import(specifier, options)` and the module-only `import.meta`, which is a
;; proven error in a Script. Phase imports (`import.source`, `import.defer`) are proposals this
;; parser fails closed on; any other `import.x` matches no production.
(defn parse-syntax-import-expression [(keyword Token)] (-> i64)
  (if (take-is ".")
      (let [name (take-token)]
        (if (token-is name "meta")
            (syntax-error! "parser: import.meta is only valid in a module")
            (if (or (token-is name "source") (token-is name "defer"))
                (parse-fail "parser: phase imports are outside the admitted subset at byte"
                            name)
                (syntax-error! "parser: unexpected token after import"))))
      (if (take-is "(")
          (do
            (if (token-is (peek-token) ")")
                (syntax-error! "parser: import() requires a specifier")
                0)
            (if (token-is (peek-token) "...")
                (syntax-error! "parser: import() does not accept spread arguments")
                0)
            (let [specifier (parse-syntax-assignment)
                  options
                    (if (and (take-is ",") (not (token-is (peek-token) ")")))
                        (do
                          (if (token-is (peek-token) "...")
                              (syntax-error! "parser: import() does not accept spread arguments")
                              0)
                          (let [o (parse-syntax-assignment)]
                            (take-is ",")
                            (Some o)))
                        (None [i64]))]
              (require-closing! ")"
                                "parser: import() accepts at most two arguments")
              (syntax-add-node! (SxImportCall specifier options)
                                (.start keyword)
                                (lex-consumed-end))))
          (syntax-error! "parser: import declarations are only valid in a module"))))

(defn parse-syntax-template [(open Token) (tagged bool)] (-> i64)
  (let [(mut quasis) (al-new [i64] (compiler-allocator))
        (mut substitutions) (al-new [i64] (compiler-allocator))
        (mut part) (lex-template-part! open)]
    (loop (do
            (push! [i64]
                   (mut quasis)
                   (syntax-template-quasi (load part) tagged))
            (if (lex-template-continues? (load part))
                (let [saved-no-in (.no-in (parser-state))]
                  (set! (.no-in (parser-state)) false)
                  (push! [i64] (mut substitutions) (parse-syntax-expression))
                  (set! (.no-in (parser-state)) saved-no-in)
                  (let [brace (peek-token)]
                    (if (token-is brace "}")
                        (do
                          (set! (mut part) (lex-template-part! brace))
                          (continue))
                        (break (syntax-error! "parser: expected `}` after template substitution")))))
                (break 0))))
    (syntax-add-node! (SxTemplate (load quasis) (load substitutions))
                      (.start open)
                      (lex-consumed-end))))

;; RegularExpressionFlags: each of d g i m s u v y at most once, and not both u and v.
(defn syntax-check-regex-flags! [(flags (slice u8))] (-> i64)
  (let [(mut seen) (al-new [u8] (compiler-allocator))]
    (for c
      (iter flags)
      (do
        (if (not (or (= c (cast u8 100))
                     (= c (cast u8 103))
                     (= c (cast u8 105))
                     (= c (cast u8 109))
                     (= c (cast u8 115))
                     (= c (cast u8 117))
                     (= c (cast u8 118))
                     (= c (cast u8 121))))
            (syntax-error! "parser: invalid regular expression flag")
            0)
        (al-for [earlier (load seen)]
                (if (or (= earlier c)
                        (and (= earlier (cast u8 117)) (= c (cast u8 118)))
                        (and (= earlier (cast u8 118)) (= c (cast u8 117))))
                    (syntax-error! "parser: duplicate or conflicting regular expression flag")
                    0))
        (push! [u8] (mut seen) c)))
    (al-free! [u8] (mut seen))
    0))

(defn parse-syntax-regex [(slash Token)] (-> i64)
  (let [t (lex-regex! slash)
        text (token-text t)
        (mut close) (- (len text) 1)]
    (loop (if (= (get text (load close)) (cast u8 47))
              (break 0)
              (do (set! (mut close) (- (load close) 1)) (continue))))
    (let [body (subslice [u8] text 1 (load close))
          flags (subslice [u8] text (+ (load close) 1) (len text))]
      (syntax-check-regex-flags! flags)
      ;; The pattern grammar is an early error of the enclosing program; a classification the
      ;; validator cannot make fails closed.
      (match (regex-validate body flags)
        (RegexOk [] 0)
        (RegexError [message] (syntax-error! message))
        (RegexUnknown [message] (parse-fail message t)))
      (syntax-add-node! (SxRegex body flags) (.start t) (.end t)))))

;; IdentifierReference, or the start of an arrow function / async function that shares its first
;; token with one. `yield`/`await` reaching this point inside their reserving contexts are errors:
;; the expression forms are parsed at the assignment and unary levels.
(defn parse-syntax-identifier-primary [(t Token)] (-> i64)
  (let [next (peek-token)
        same-line (not (.nl-before next))]
    ;; These are StringValue rules: an escaped spelling of the name is still the name.
    (if (token-escaped-reserved? t)
        (syntax-error! "parser: escaped reserved word cannot be an identifier")
        (if (and (= (token-text t) "yield") (parser-ctx-generator?))
            (syntax-error! "parser: yield expression is not allowed here")
            (if (and (= (token-text t) "await")
                     (or (parser-ctx-async?) (parser-ctx-static-block?)))
                (syntax-error! "parser: await expression is not allowed here")
                (if (and (= (token-text t) "arguments")
                         (parser-ctx-forbids-arguments?))
                    (syntax-error! "parser: arguments is not allowed in a class field initializer or static block")
                    (if (and (token-is t "async")
                             same-line
                             (not (.new-callee (parser-state)))
                             (or (token-is next "function")
                                 (= (.kind next) TOK-IDENT)
                                 (token-is next "(")))
                        (parse-syntax-async-head t)
                        (if (and same-line (token-is next "=>"))
                            (let [(mut params)
                                    (al-new [(slice u8)] (compiler-allocator))
                                  (mut defaults)
                                    (al-new [(Option i64)] (compiler-allocator))
                                  (mut patterns)
                                    (al-new [(Option i64)] (compiler-allocator))]
                              (syntax-check-binding-name! (token-text t))
                              (push! [(slice u8)] (mut params) (token-text t))
                              (push! [(Option i64)] (mut defaults) (None [i64]))
                              (push! [(Option i64)] (mut patterns) (None [i64]))
                              (parse-syntax-arrow-body! (.start t)
                                                        (load params)
                                                        (load defaults)
                                                        (load patterns)
                                                        (None [(slice u8)])
                                                        (None [i64])
                                                        true
                                                        false))
                            (syntax-add-node! (SxName (token-text t))
                                              (.start t)
                                              (.end t))))))))))

;; `async function …`, `async x => …`, `async (…) => …`, or an ordinary call `async(…)`
;; (CoverCallExpressionAndAsyncArrowHead).
(defn parse-syntax-async-head [(t Token)] (-> i64)
  (let [next (peek-token)]
    (if (token-is next "function")
        (parse-syntax-function-expression (take-token) true (.start t))
        (if (= (.kind next) TOK-IDENT)
            (let [param (take-token)
                  (mut params) (al-new [(slice u8)] (compiler-allocator))
                  (mut defaults) (al-new [(Option i64)] (compiler-allocator))
                  (mut patterns) (al-new [(Option i64)] (compiler-allocator))]
              (if (= (token-text param) "await")
                  (syntax-error! "parser: await is not a valid async arrow parameter")
                  0)
              (syntax-check-binding-name! (token-text param))
              (push! [(slice u8)] (mut params) (token-text param))
              (push! [(Option i64)] (mut defaults) (None [i64]))
              (push! [(Option i64)] (mut patterns) (None [i64]))
              (if (not (token-is (peek-token) "=>"))
                  (syntax-error! "parser: expected => after async arrow parameter")
                  0)
              (parse-syntax-arrow-body! (.start t)
                                        (load params)
                                        (load defaults)
                                        (load patterns)
                                        (None [(slice u8)])
                                        (None [i64])
                                        true
                                        true))
            (do
              (take-token)
              (let [args (parse-syntax-arguments)
                    trailing (.spread-trailing-comma (parser-state))
                    after (peek-token)]
                (if (and (token-is after "=>") (not (.nl-before after)))
                    (do
                      (if trailing
                          (syntax-error! "parser: rest parameter must be last")
                          0)
                      (parse-syntax-arrow-from-cover! (.start t) args true))
                    (let [callee
                            (syntax-add-node! (SxName "async")
                                              (.start t)
                                              (.end t))]
                      (syntax-add-node! (SxCall
                                          :callee callee
                                          :args args
                                          :optional false)
                                        (.start t)
                                        (lex-consumed-end))))))))))

;; `super.x`, `super[x]` inside a method (through arrows); `super(...)` only inside a derived
;; class constructor. Anything else is a proven error. A super property reference makes the home
;; object part of the method's function object, and its entry pass that object in the callee slot.
(defn parse-syntax-super [(t Token)] (-> i64)
  (let [next (peek-token)]
    (if (or (token-is next ".") (token-is next "["))
        (if (parser-ctx-home-method?)
            (do
              (parser-ctx-needs-home!)
              (syntax-add-node! (SxSuper) (.start t) (.end t)))
            (syntax-error! "parser: super property access is only allowed in a method"))
        (if (token-is next "(")
            (if (parser-ctx-allows-super-call?)
                (syntax-add-node! (SxSuper) (.start t) (.end t))
                (syntax-error! "parser: super call is only allowed in a derived class constructor"))
            (syntax-error! "parser: unexpected super")))))

;; CoverParenthesizedExpressionAndArrowParameterList. Parentheses restore the `[+In]` grammar.
;; The list is parsed as expressions; a following `=>` reinterprets it as ArrowFormalParameters,
;; otherwise an empty list, a rest element or a trailing comma is a proven error and the items
;; fold into a comma expression inside a group.
(defn parse-syntax-parenthesized [(open Token)] (-> i64)
  (let [saved-no-in (.no-in (parser-state))
        (mut items) (al-new [i64] (compiler-allocator))
        (mut arrow-only) false]
    (set! (.no-in (parser-state)) false)
    (if (take-is ")")
        (set! (mut arrow-only) true)
        (loop (if (token-is (peek-token) "...")
                  (let [dots (take-token)
                        target
                          (if (or (token-is (peek-token) "[")
                                  (token-is (peek-token) "{"))
                              (parse-syntax-primary)
                              (let [name (require-binding-identifier)]
                                (syntax-add-node! (SxName (token-text name))
                                                  (.start name)
                                                  (.end name))))]
                    (set! (mut arrow-only) true)
                    (if (token-is (peek-token) "=")
                        (syntax-error! "parser: rest parameter may not have a default")
                        0)
                    (push! [i64]
                           (mut items)
                           (syntax-add-node! (SxSpread target)
                                             (.start dots)
                                             (syntax-hi target)))
                    (if (take-is ")")
                        0
                        (syntax-error! "parser: rest parameter must be last"))
                    (break 0))
                  (do
                    (push! [i64] (mut items) (parse-syntax-assignment))
                    (if (take-is ",")
                        (if (take-is ")")
                            (break (do (set! (mut arrow-only) true) 0))
                            (continue))
                        (break (do
                                 (require-closing! ")"
                                                   "parser: expected `)` after expression")
                                 0)))))))
    (set! (.no-in (parser-state)) saved-no-in)
    (let [after (peek-token)]
      (if (and (token-is after "=>") (not (.nl-before after)))
          (parse-syntax-arrow-from-cover! (.start open) (load items) false)
          (if (load arrow-only)
              (syntax-error! "parser: expected an expression")
              (let [(mut expr) (get (load items) 0)
                    (mut i) 1]
                (loop (if (>= (load i) (len (load items)))
                          (break 0)
                          (let [rhs (get (load items) (load i))]
                            (set! (mut expr)
                                  (syntax-binary! (SxComma (load expr) rhs)
                                                  (load expr)
                                                  rhs))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (syntax-add-node! (SxGroup (load expr))
                                  (.start open)
                                  (lex-consumed-end))))))))

;; Refine cover-grammar items into ArrowFormalParameters: names, `name = default` and a trailing
;; `...rest`. Patterns fail closed; anything else, or a `yield`/`await` expression inside a
;; default, is a proven error. An async head reserves `await` as well.
;; A nested arrow's parameter names, defaults and concise body are part of the enclosing head.
(defn syntax-fun-params-mention? [(fun i64) (yield? bool) (await? bool)] (-> bool)
  (let [f (syntax-fun-at fun)
        (mut found) false]
    (al-for [name (.params f)]
            (if (or (and yield? (= name "yield")) (and await? (= name "await")))
                (set! (mut found) true)
                0))
    (match (.rest-param f)
      (Some [r]
            (if (or (and yield? (= r "yield")) (and await? (= r "await")))
                (set! (mut found) true)
                0))
      (None [] 0))
    (al-for [d (.param-defaults f)]
            (match d
              (Some [e]
                    (if (syntax-expr-contains? e yield? await?)
                        (set! (mut found) true)
                        0))
              (None [] 0)))
    ;; Destructured parameters: their bound names and the expressions they own.
    (let [(mut names) (al-new [(slice u8)] (compiler-allocator))
          (mut exprs) (al-new [i64] (compiler-allocator))]
      (al-for [p (.param-patterns f)]
              (match p
                (Some [pat]
                      (do
                        (syntax-pattern-names! pat (mut names))
                        (syntax-pattern-exprs! pat (mut exprs))))
                (None [] 0)))
      (match (.rest-pattern f)
        (Some [pat]
              (do
                (syntax-pattern-names! pat (mut names))
                (syntax-pattern-exprs! pat (mut exprs))))
        (None [] 0))
      (al-for [name (load names)]
              (if (or (and yield? (= name "yield"))
                      (and await? (= name "await")))
                  (set! (mut found) true)
                  0))
      (al-for [e (load exprs)]
              (if (syntax-expr-contains? e yield? await?)
                  (set! (mut found) true)
                  0))
      (al-free! [(slice u8)] (mut names))
      (al-free! [i64] (mut exprs)))
    (match (.expression-body f)
      (Some [e]
            (if (syntax-expr-contains? e yield? await?)
                (set! (mut found) true)
                0))
      (None [] 0))
    (load found)))

(defn syntax-expr-contains? [(id i64) (yield? bool) (await? bool)] (-> bool)
  (let [(mut children) (al-new [i64] (compiler-allocator))
        (mut found)
          (match (syntax-node id)
            (SxYield [argument delegate] yield?)
            (SxAwait [operand] await?)
            (SxName [name] (and await? (= name "await")))
            (SxFunction [fun] (syntax-fun-params-mention? fun yield? await?))
            (_ false))]
    (syntax-expr-children! id (mut children))
    (al-for [child (load children)]
            (if (syntax-expr-contains? child yield? await?)
                (set! (mut found) true)
                0))
    (al-free! [i64] (mut children))
    (load found)))

(defn parse-syntax-arrow-from-cover! [(lo i64)
                                      (items (ArrayList i64))
                                      (async bool)] (-> i64)
  (let [(mut params) (al-new [(slice u8)] (compiler-allocator))
        (mut defaults) (al-new [(Option i64)] (compiler-allocator))
        (mut patterns) (al-new [(Option i64)] (compiler-allocator))
        (mut rest) (None [(slice u8)])
        (mut rest-pattern) (None [i64])
        (mut simple) true
        (mut i) 0]
    (loop (if (>= (load i) (len items))
              (break 0)
              (let [item (get items (load i))]
                (if (syntax-expr-contains? item
                                           (parser-ctx-generator?)
                                           (or async (parser-ctx-async?)))
                    (syntax-error! "parser: yield or await is not allowed in arrow parameters")
                    0)
                (match (syntax-node item)
                  (SxName [name]
                          (do
                            (if async
                                (if (= name "await")
                                    (syntax-error! "parser: await is not a valid async arrow parameter")
                                    0)
                                0)
                            (push! [(slice u8)] (mut params) name)
                            (push! [(Option i64)] (mut defaults) (None [i64]))
                            (push! [(Option i64)] (mut patterns) (None [i64]))))
                  (SxAssign [target value]
                            (match (syntax-node target)
                              (SxName [name]
                                      (do
                                        (set! (mut simple) false)
                                        (push! [(slice u8)] (mut params) name)
                                        (push! [(Option i64)]
                                               (mut defaults)
                                               (Some value))
                                        (push! [(Option i64)]
                                               (mut patterns)
                                               (None [i64]))))
                              (SxObject [entries]
                                        (do
                                          (set! (mut simple) false)
                                          (push! [(slice u8)] (mut params) "")
                                          (push! [(Option i64)]
                                                 (mut defaults)
                                                 (Some value))
                                          (push! [(Option i64)]
                                                 (mut patterns)
                                                 (Some (syntax-cover-to-pattern! target
                                                                                 true)))))
                              (SxArray [elements]
                                       (do
                                         (set! (mut simple) false)
                                         (push! [(slice u8)] (mut params) "")
                                         (push! [(Option i64)]
                                                (mut defaults)
                                                (Some value))
                                         (push! [(Option i64)]
                                                (mut patterns)
                                                (Some (syntax-cover-to-pattern! target
                                                                                true)))))
                              (_ (syntax-error! "parser: invalid arrow function parameter"))))
                  (SxSpread [expr]
                            (do
                              (if (!= (load i) (- (len items) 1))
                                  (syntax-error! "parser: rest parameter must be last")
                                  0)
                              (set! (mut simple) false)
                              (match (syntax-node expr)
                                (SxName [name]
                                        (do (set! (mut rest) (Some name)) 0))
                                (SxObject [entries]
                                          (do
                                            (set! (mut rest-pattern)
                                                  (Some (syntax-cover-to-pattern! expr
                                                                                  true)))
                                            0))
                                (SxArray [elements]
                                         (do
                                           (set! (mut rest-pattern)
                                                 (Some (syntax-cover-to-pattern! expr
                                                                                 true)))
                                           0))
                                (SxAssign [target value]
                                          (syntax-error! "parser: rest parameter may not have a default"))
                                (_ (syntax-error! "parser: invalid arrow function parameter")))))
                  ;; `([a] = b) => …` parsed as a destructuring assignment; its pattern must be
                  ;; a binding pattern.
                  (SxDestructuringAssign [pattern value]
                                         (do
                                           (set! (mut simple) false)
                                           (syntax-pattern-require-binding! pattern)
                                           (push! [(slice u8)] (mut params) "")
                                           (push! [(Option i64)]
                                                  (mut defaults)
                                                  (Some value))
                                           (push! [(Option i64)]
                                                  (mut patterns)
                                                  (Some pattern))))
                  (SxObject [entries]
                            (do
                              (set! (mut simple) false)
                              (push! [(slice u8)] (mut params) "")
                              (push! [(Option i64)] (mut defaults) (None [i64]))
                              (push! [(Option i64)]
                                     (mut patterns)
                                     (Some (syntax-cover-to-pattern! item true)))))
                  (SxArray [elements]
                           (do
                             (set! (mut simple) false)
                             (push! [(slice u8)] (mut params) "")
                             (push! [(Option i64)] (mut defaults) (None [i64]))
                             (push! [(Option i64)]
                                    (mut patterns)
                                    (Some (syntax-cover-to-pattern! item true)))))
                  (_ (syntax-error! "parser: invalid arrow function parameter")))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (parse-syntax-arrow-body! lo
                              (load params)
                              (load defaults)
                              (load patterns)
                              (load rest)
                              (load rest-pattern)
                              (load simple)
                              async)))

;; BindingPattern: `[ elements ]` or `{ properties }` in a declaration, parameter or catch clause.
;; Elements are names or nested patterns with an optional `= default`; a rest element takes no
;; default and must be last; an object rest element is a plain name.
(defn parse-syntax-binding-element! [] (-> i64)
  (let [t (peek-token)
        target
          (if (or (token-is t "[") (token-is t "{"))
              (parse-syntax-binding-pattern!)
              (let [name (require-binding-identifier)]
                (syntax-pattern-add! (PatName (token-text name))
                                     (None [i64])
                                     (.start name)
                                     (.end name))))]
    (if (take-is "=")
        (let [value (parse-syntax-assignment)
              x (syntax-pattern-at target)]
          (syntax-pattern-add! (.node x) (Some value) (.lo x) (syntax-hi value)))
        target)))

(defn parse-syntax-binding-pattern! [] (-> i64)
  (let [open (take-token)]
    (if (token-is open "[")
        (let [(mut elements) (al-new [PatElem] (compiler-allocator))
              (mut rest) (None [i64])]
          (loop (let [t (peek-token)]
                  (if (token-is t "]")
                      (break (do (take-token) 0))
                      (if (token-is t ",")
                          (do
                            (take-token)
                            (push! [PatElem] (mut elements) (PatHole))
                            (continue))
                          (if (token-is t "...")
                              (do
                                (take-token)
                                (let [target
                                        (if (or (token-is (peek-token) "[")
                                                (token-is (peek-token) "{"))
                                            (parse-syntax-binding-pattern!)
                                            (let [name
                                                    (require-binding-identifier)]
                                              (syntax-pattern-add! (PatName (token-text name))
                                                                   (None [i64])
                                                                   (.start name)
                                                                   (.end name))))]
                                  (if (token-is (peek-token) "=")
                                      (syntax-error! "parser: rest element may not have a default")
                                      0)
                                  (set! (mut rest) (Some target))
                                  (if (take-is "]")
                                      0
                                      (syntax-error! "parser: rest element must be last"))
                                  (break 0)))
                              (do
                                (push! [PatElem]
                                       (mut elements)
                                       (PatItem (parse-syntax-binding-element!)))
                                (if (parse-list-separator! "]"
                                                           "parser: expected `,` or `]` in array pattern")
                                    (break 0)
                                    (continue))))))))
          (syntax-pattern-add! (PatArray (load elements) (load rest))
                               (None [i64])
                               (.start open)
                               (lex-consumed-end)))
        (let [(mut props) (al-new [PatProp] (compiler-allocator))
              (mut rest) (None [i64])]
          (loop (let [t (peek-token)]
                  (if (token-is t "}")
                      (break (do (take-token) 0))
                      (if (token-is t "...")
                          (do
                            (take-token)
                            (let [name (require-binding-identifier)]
                              (set! (mut rest)
                                    (Some (syntax-pattern-add! (PatName (token-text name))
                                                               (None [i64])
                                                               (.start name)
                                                               (.end name)))))
                            (if (take-is "}")
                                0
                                (syntax-error! "parser: rest element must be last"))
                            (break 0))
                          (let [k (parse-syntax-property-key!)
                                (mut prop) (primitive/zeroed PatProp)]
                            (set! (.key (mut prop)) (.key k))
                            (if (take-is ":")
                                (set! (.pattern (mut prop))
                                      (parse-syntax-binding-element!))
                                (do
                                  (if (not (.ident k))
                                      (syntax-error! "parser: shorthand binding property requires an identifier")
                                      0)
                                  (syntax-check-binding-name! (.name k))
                                  (set! (.pattern (mut prop))
                                        (let [target
                                                (syntax-pattern-add! (PatName (.name k))
                                                                     (None [i64])
                                                                     (.lo k)
                                                                     (.hi k))]
                                          (if (take-is "=")
                                              (let [value
                                                      (parse-syntax-assignment)]
                                                (syntax-pattern-add! (PatName (.name k))
                                                                     (Some value)
                                                                     (.lo k)
                                                                     (syntax-hi value)))
                                              target)))))
                            (push! [PatProp] (mut props) (load prop))
                            (if (parse-list-separator! "}"
                                                       "parser: expected `,` or `}` in object pattern")
                                (break 0)
                                (continue)))))))
          (syntax-pattern-add! (PatObject (load props) (load rest))
                               (None [i64])
                               (.start open)
                               (lex-consumed-end))))))

;; Reinterpret an object or array literal parsed by the cover grammar as a pattern. `binding`
;; patterns accept only names at the leaves; assignment patterns also accept Reference
;; expressions. Parentheses around a pattern, methods, call expressions, defaults on rest elements
;; and non-final rest elements are proven errors.
(defn syntax-mark-cover-consumed! [(expr i64)] (-> i64)
  (push! [i64] (mut (.cover-consumed (parser-state))) expr))

(defn syntax-cover-consumed? [(expr i64)] (-> bool)
  (let [(mut found) false]
    (al-for [id (.cover-consumed (parser-state))]
            (if (= id expr) (set! (mut found) true) 0))
    (load found)))

(defn syntax-cover-leaf! [(expr i64) (binding bool)] (-> i64)
  (let [x (syntax-at expr)]
    (match (.node x)
      (SxName [name]
              (do
                (if binding (syntax-check-binding-name! name) 0)
                (syntax-pattern-add! (PatName name)
                                     (None [i64])
                                     (.lo x)
                                     (.hi x))))
      (SxMember [owner name optional]
                (if (or binding (syntax-optional-chain? expr))
                    (syntax-error! "parser: invalid destructuring target")
                    (syntax-pattern-add! (PatTarget expr)
                                         (None [i64])
                                         (.lo x)
                                         (.hi x))))
      (SxPrivateMember [owner name optional]
                       (if (or binding (syntax-optional-chain? expr))
                           (syntax-error! "parser: invalid destructuring target")
                           (syntax-pattern-add! (PatTarget expr)
                                                (None [i64])
                                                (.lo x)
                                                (.hi x))))
      (SxIndex [owner key optional]
               (if (or binding (syntax-optional-chain? expr))
                   (syntax-error! "parser: invalid destructuring target")
                   (syntax-pattern-add! (PatTarget expr)
                                        (None [i64])
                                        (.lo x)
                                        (.hi x))))
      (_ (syntax-error! "parser: invalid destructuring target")))))

(defn syntax-cover-to-element! [(expr i64) (binding bool)] (-> i64)
  (let [x (syntax-at expr)]
    (match (.node x)
      (SxAssign [target value]
                (let [element (syntax-cover-to-element! target binding)
                      e (syntax-pattern-at element)]
                  (match (.default e)
                    (Some [d]
                          (syntax-error! "parser: invalid destructuring target"))
                    (None [] 0))
                  (syntax-pattern-add! (.node e) (Some value) (.lo e) (.hi x))))
      (SxObject [entries] (syntax-cover-to-pattern! expr binding))
      (SxArray [elements] (syntax-cover-to-pattern! expr binding))
      (SxGroup [inner]
               (if binding
                   (syntax-error! "parser: invalid binding pattern")
                   (let [target (syntax-ungroup-id expr)]
                     (match (syntax-node target)
                       (SxObject [entries]
                                 (syntax-error! "parser: a parenthesized pattern is not a valid target"))
                       (SxArray [elements]
                                (syntax-error! "parser: a parenthesized pattern is not a valid target"))
                       ;; `(a)` is a Reference, not a binding: keep the parentheses so a later
                       ;; reinterpretation as a binding pattern rejects it.
                       (SxName [name]
                               (syntax-pattern-add! (PatTarget expr)
                                                    (None [i64])
                                                    (.lo x)
                                                    (.hi x)))
                       (_ (syntax-cover-leaf! target binding))))))
      (_ (syntax-cover-leaf! expr binding)))))

(defn syntax-rest-comma? [(expr i64)] (-> bool)
  (let [(mut found) false]
    (al-for [id (.rest-comma (parser-state))]
            (if (= id expr) (set! (mut found) true) 0))
    (load found)))

(defn syntax-cover-to-pattern! [(expr i64) (binding bool)] (-> i64)
  (let [x (syntax-at expr)]
    (syntax-mark-cover-consumed! expr)
    (if (syntax-rest-comma? expr)
        (syntax-error! "parser: rest element must be last")
        0)
    (match (.node x)
      (SxObject [entries]
                (let [(mut props) (al-new [PatProp] (compiler-allocator))
                      (mut rest) (None [i64])
                      (mut i) 0]
                  (al-for [entry entries]
                          (do
                            (match (load rest)
                              (Some [r]
                                    (syntax-error! "parser: rest element must be last"))
                              (None [] 0))
                            (match entry
                              (PropValue [key value]
                                         (let [(mut prop)
                                                 (primitive/zeroed PatProp)]
                                           (set! (.key (mut prop)) key)
                                           (set! (.pattern (mut prop))
                                                 (syntax-cover-to-element! value
                                                                           binding))
                                           (push! [PatProp]
                                                  (mut props)
                                                  (load prop))))
                              (PropCoverInit [name init]
                                             (let [(mut prop)
                                                     (primitive/zeroed PatProp)]
                                               (if binding
                                                   (syntax-check-binding-name! name)
                                                   0)
                                               (set! (.key (mut prop))
                                                     (KeyNamed (shape-key-intern name)))
                                               (set! (.pattern (mut prop))
                                                     (syntax-pattern-add! (PatName name)
                                                                          (Some init)
                                                                          (.lo x)
                                                                          (syntax-hi init)))
                                               (push! [PatProp]
                                                      (mut props)
                                                      (load prop))))
                              (PropSpread [e]
                                          (do
                                            (match (syntax-node e)
                                              (SxObject [inner]
                                                        (syntax-error! "parser: object rest element must be a simple target"))
                                              (SxArray [inner]
                                                       (syntax-error! "parser: object rest element must be a simple target"))
                                              (SxAssign [target value]
                                                        (syntax-error! "parser: rest element may not have a default"))
                                              (_ 0))
                                            (set! (mut rest)
                                                  (Some (syntax-cover-to-element! e
                                                                                  binding)))))
                              (PropMethod [key fun]
                                          (syntax-error! "parser: invalid destructuring target")))
                            (set! (mut i) (+ (load i) 1))))
                  (syntax-pattern-add! (PatObject (load props) (load rest))
                                       (None [i64])
                                       (.lo x)
                                       (.hi x))))
      (SxArray [elements]
               (let [(mut items) (al-new [PatElem] (compiler-allocator))
                     (mut rest) (None [i64])]
                 (al-for [element elements]
                         (do
                           (match (load rest)
                             (Some [r]
                                   (syntax-error! "parser: rest element must be last"))
                             (None [] 0))
                           (match element
                             (ElemHole []
                                       (push! [PatElem] (mut items) (PatHole)))
                             (ElemExpr [e]
                                       (push! [PatElem]
                                              (mut items)
                                              (PatItem (syntax-cover-to-element! e
                                                                                 binding))))
                             (ElemSpread [e]
                                         (do
                                           (match (syntax-node e)
                                             (SxAssign [target value]
                                                       (syntax-error! "parser: rest element may not have a default"))
                                             (_ 0))
                                           (set! (mut rest)
                                                 (Some (syntax-cover-to-element! e
                                                                                 binding))))))))
                 (syntax-pattern-add! (PatArray (load items) (load rest))
                                      (None [i64])
                                      (.lo x)
                                      (.hi x))))
      (_ (do
           (broken "syntax-cover-to-pattern!: not an object or array literal")
           0)))))

(defn parse-syntax-primary [] (-> i64)
  (let [t (take-token)]
    (if (= (.kind t) TOK-BIGINT)
        (unimplemented "BigInt literal value lowering"
                       "jsl/compiler — BigInt runtime")
        0)
    (if (or (= (.kind t) TOK-NUMBER) (= (.kind t) TOK-LEGACY-NUMBER))
        (syntax-add! (syntax-number t))
        (if (or (token-is t "true") (token-is t "false") (token-is t "null"))
            (syntax-add-node! (SxSingleton (if (token-is t "true")
                                               "JsTrue"
                                               (if (token-is t "false")
                                                   "JsFalse"
                                                   "JsNull")))
                              (.start t)
                              (.end t))
            (if (or (= (.kind t) TOK-IDENT) (token-is t "let"))
                (parse-syntax-identifier-primary t)
                (if (= (.kind t) TOK-STRING)
                    (syntax-add! (syntax-string t))
                    (if (token-is t "(")
                        (parse-syntax-parenthesized t)
                        (if (token-is t "{")
                            (parse-syntax-object-literal t)
                            (if (token-is t "[")
                                (parse-syntax-array-literal t)
                                (if (token-is t "this")
                                    (syntax-add-node! (SxThis)
                                                      (.start t)
                                                      (.end t))
                                    (if (token-is t "super")
                                        (parse-syntax-super t)
                                        (if (token-is t "function")
                                            (parse-syntax-function-expression t
                                                                              false
                                                                              (.start t))
                                            (if (token-is t "class")
                                                (let [cls
                                                        (parse-syntax-class t
                                                                            false)]
                                                  (syntax-add-node! (SxClass cls)
                                                                    (.start t)
                                                                    (syntax-class-hi cls)))
                                                (if (token-is t "#")
                                                    (parse-syntax-private-in t)
                                                    (if (token-is t "import")
                                                        (parse-syntax-import-expression t)
                                                        (if (token-is t "`")
                                                            (parse-syntax-template t
                                                                                   false)
                                                            (if (and (= (.kind t)
                                                                        TOK-PUNCT)
                                                                     (or (token-is t
                                                                                   "/")
                                                                         (token-is t
                                                                                   "/=")))
                                                                (parse-syntax-regex t)
                                                                (parse-primary-fallback t))))))))))))))))))

;; The member/call suffix loop shared by MemberExpression (`allow-call` false, for a `new` callee),
;; CallExpression and OptionalExpression. A tagged template cannot follow an optional chain.
(defn parse-syntax-member-tail [(start i64) (allow-call bool)] (-> i64)
  (let [(mut base) start]
    (loop (let [t (peek-token)]
            (if (and (syntax-arrow? (load base))
                     (or (token-is t ".")
                         (token-is t "?.")
                         (token-is t "[")
                         (token-is t "`")
                         (and allow-call (token-is t "("))))
                (syntax-error! "parser: an arrow function cannot be accessed or called without parentheses")
                0)
            (if (token-is t ".")
                (do
                  (take-token)
                  (if (token-is (peek-token) "#")
                      (let [is-super
                              (match (syntax-node (load base))
                                (SxSuper [] true)
                                (_ false))
                            name (parse-syntax-private-name! (take-token))]
                        (if is-super
                            (syntax-error! "parser: super cannot access a private name")
                            0)
                        (set! (mut base)
                              (syntax-add-node! (SxPrivateMember
                                                  :owner (load base)
                                                  :name (token-text name)
                                                  :optional false)
                                                (syntax-lo (load base))
                                                (.end name))))
                      (let [member (require-property-name)]
                        (set! (mut base)
                              (syntax-add-node! (SxMember
                                                  :owner (load base)
                                                  :name (token-text member)
                                                  :optional false)
                                                (syntax-lo (load base))
                                                (.end member)))))
                  (continue))
                (if (token-is t "?.")
                    (do
                      (take-token)
                      (let [next (peek-token)]
                        (if (token-is next "(")
                            (do
                              (take-token)
                              (let [args (parse-syntax-arguments)]
                                (set! (mut base)
                                      (syntax-add-node! (SxCall
                                                          :callee (load base)
                                                          :args args
                                                          :optional true)
                                                        (syntax-lo (load base))
                                                        (lex-consumed-end)))))
                            (if (token-is next "[")
                                (let [saved-no-in (.no-in (parser-state))]
                                  (take-token)
                                  (set! (.no-in (parser-state)) false)
                                  (let [key (parse-syntax-expression)]
                                    (set! (.no-in (parser-state)) saved-no-in)
                                    (require-closing! "]"
                                                      "parser: expected `]` after computed member")
                                    (set! (mut base)
                                          (syntax-add-node! (SxIndex
                                                              :owner (load base)
                                                              :key key
                                                              :optional true)
                                                            (syntax-lo (load base))
                                                            (lex-consumed-end)))))
                                (if (token-is next "`")
                                    (syntax-error! "parser: tagged template is not allowed in an optional chain")
                                    (if (token-is next "#")
                                        (let [name
                                                (parse-syntax-private-name! (take-token))]
                                          (set! (mut base)
                                                (syntax-add-node! (SxPrivateMember
                                                                    :owner
                                                                      (load base)
                                                                    :name
                                                                      (token-text name)
                                                                    :optional
                                                                      true)
                                                                  (syntax-lo (load base))
                                                                  (.end name))))
                                        (if (or (= (.kind next) TOK-IDENT)
                                                (= (.kind next) TOK-KEYWORD))
                                            (let [member (take-token)]
                                              (set! (mut base)
                                                    (syntax-add-node! (SxMember
                                                                        :owner
                                                                          (load base)
                                                                        :name
                                                                          (token-text member)
                                                                        :optional
                                                                          true)
                                                                      (syntax-lo (load base))
                                                                      (.end member))))
                                            (syntax-error! "parser: expected a property, index or call after ?.")))))))
                      (continue))
                    (if (token-is t "[")
                        (let [saved-no-in (.no-in (parser-state))]
                          (take-token)
                          (set! (.no-in (parser-state)) false)
                          (let [key (parse-syntax-expression)]
                            (set! (.no-in (parser-state)) saved-no-in)
                            (require-closing! "]"
                                              "parser: expected `]` after computed member")
                            (set! (mut base)
                                  (syntax-add-node! (SxIndex
                                                      :owner (load base)
                                                      :key key
                                                      :optional false)
                                                    (syntax-lo (load base))
                                                    (lex-consumed-end)))
                            (continue)))
                        (if (and allow-call (token-is t "("))
                            (do
                              (take-token)
                              (let [args (parse-syntax-arguments)]
                                (set! (mut base)
                                      (syntax-add-node! (SxCall
                                                          :callee (load base)
                                                          :args args
                                                          :optional false)
                                                        (syntax-lo (load base))
                                                        (lex-consumed-end)))
                                (continue)))
                            (if (token-is t "`")
                                (do
                                  (if (syntax-optional-chain? (load base))
                                      (syntax-error! "parser: tagged template is not allowed in an optional chain")
                                      0)
                                  (take-token)
                                  (let [template (parse-syntax-template t true)]
                                    (set! (mut base)
                                          (syntax-add-node! (SxTaggedTemplate (load base)
                                                                              template)
                                                            (syntax-lo (load base))
                                                            (lex-consumed-end)))
                                    (continue)))
                                (break 0))))))))
    (load base)))

;; `new MemberExpression Arguments?`, `new new X()()`, and the meta property `new.target`, which
;; is a proven error outside a function body. An `import()` or optional chain cannot be a `new`
;; callee.
(defn parse-syntax-new [(keyword Token)] (-> i64)
  (if (take-is ".")
      (let [name (take-token)]
        (if (not (token-is name "target"))
            (syntax-error! "parser: expected new.target")
            (if (not (parser-ctx-allows-new-target?))
                (syntax-error! "parser: new.target is not allowed outside a function")
                (syntax-add-node! (SxNewTarget) (.start keyword) (.end name)))))
      (let [callee
              (if (token-is (peek-token) "new")
                  (parse-syntax-new (take-token))
                  (parse-syntax-member-tail (parse-syntax-primary) false))]
        (match (syntax-node (syntax-spine-root callee))
          (SxImportCall [specifier options]
                        (syntax-error! "parser: import() cannot be used with new"))
          (_ 0))
        (if (syntax-optional-chain? callee)
            (syntax-error! "parser: optional chain cannot be used with new")
            0)
        (syntax-reject-arrow-operand! callee)
        (let [args
                (if (take-is "(")
                    (parse-syntax-arguments)
                    (al-new [i64] (compiler-allocator)))]
          (syntax-add-node! (SxNew callee args)
                            (.start keyword)
                            (lex-consumed-end))))))

;; LeftHandSideExpression: NewExpression or CallExpression, with the shared suffix loop.
(defn parse-syntax-lhs [] (-> i64)
  (let [first (peek-token)
        base
          (if (token-is first "new")
              (parse-syntax-new (take-token))
              (parse-syntax-primary))]
    (parse-syntax-member-tail base true)))

;; AssignmentTargetType. A name or property Reference is simple. A CallExpression is invalid, but
;; only strict code proves it early: sloppy web-compatible code defers to a runtime ReferenceError,
;; so the strict pass reports it and lowering refuses it by name. Every other admitted expression
;; kind is proven invalid here. Parentheses are transparent for Reference targets, while a
;; parenthesized object literal can no longer be reinterpreted as a destructuring pattern.
(defn syntax-check-simple-target! [(id i64)
                                   (pattern-allowed bool)
                                   (web-compat bool)] (-> i64)
  (let [target-id (syntax-ungroup-id id)
        pattern (and pattern-allowed (= target-id id))]
    (if (syntax-optional-chain? target-id)
        (syntax-error! "parser: optional chain is not a valid assignment target")
        (match (syntax-node target-id)
          (SxName [name] 0)
          (SxMember [owner name optional] 0)
          (SxPrivateMember [owner name optional] 0)
          (SxIndex [owner key optional] 0)
          ;; Sloppy `f() = 1`, `f() += 1` and `f()++` defer to a runtime ReferenceError; logical
          ;; assignment and for-in/of heads never do.
          (SxCall [callee args optional]
                  (if web-compat
                      0
                      (syntax-error! "parser: call expression is not a valid assignment target")))
          (SxObject [entries]
                    (syntax-error! "parser: invalid assignment target"))
          (SxArray [elements]
                   (syntax-error! "parser: invalid assignment target"))
          (_ (syntax-error! "parser: invalid assignment target"))))))

(defn token-update-op-name [(t Token)] (-> (slice u8))
  (if (token-is t "++") "JsIncrement" "JsDecrement"))

;; UpdateExpression: postfix `++`/`--` must follow on the same line. A line terminator ends the
;; LeftHandSideExpression and the operator then begins a prefix update of the next statement.
(defn parse-syntax-update [] (-> i64)
  (let [lhs (parse-syntax-lhs)
        t (peek-token)]
    (if (and (or (token-is t "++") (token-is t "--")) (not (.nl-before t)))
        (do
          (take-token)
          (syntax-check-simple-target! lhs false true)
          (syntax-add-node! (SxUpdate
                              :op (token-update-op-name t)
                              :prefix false
                              :target (syntax-ungroup-id lhs))
                            (syntax-lo lhs)
                            (.end t)))
        lhs)))

(defn token-unary-operator? [(t Token)] (-> bool)
  (or (token-is t "!")
      (token-is t "void")
      (token-is t "-")
      (token-is t "+")
      (token-is t "typeof")
      (token-is t "~")
      (token-is t "delete")))

(defn token-unary-op-name [(t Token)] (-> (slice u8))
  (if (token-is t "!")
      "JsLogicalNot"
      (if (token-is t "void")
          "JsVoid"
          (if (token-is t "-")
              "JsNegate"
              (if (token-is t "typeof")
                  "JsTypeof"
                  (if (token-is t "~") "JsBitNot" "JsPositive"))))))

(defn parse-syntax-unary [] (-> i64)
  ;; Final Simple recursively parses unary minus before its multiplication loop. JavaScript
  ;; numeric conversion belongs to JSL; the parser never subtracts from zero (which loses -0).
  (let [t (peek-token)]
    (if (and (token-is t "await") (parser-ctx-async?))
        (do
          (take-token)
          (if (parser-ctx-in-params?)
              (syntax-error! "parser: await expression is not allowed in formal parameters")
              0)
          (let [operand (parse-syntax-unary)]
            (syntax-reject-arrow-operand! operand)
            (syntax-add-node! (SxAwait operand) (.start t) (syntax-hi operand))))
        (if (token-unary-operator? t)
            (do
              (take-token)
              (let [operand (parse-syntax-unary)
                    hi (syntax-hi operand)]
                (syntax-reject-arrow-operand! operand)
                (if (token-is t "delete")
                    (do
                      ;; Private names cannot be deleted, parenthesized or not.
                      (match (syntax-node (syntax-ungroup-id operand))
                        (SxPrivateMember [owner name optional]
                                         (syntax-error! "parser: private names cannot be deleted"))
                        (_ 0))
                      (syntax-add-node! (SxDelete operand) (.start t) hi))
                    (syntax-add-node! (SxUnary (token-unary-op-name t) operand)
                                      (.start t)
                                      hi))))
            (if (or (token-is t "++") (token-is t "--"))
                (do
                  (take-token)
                  (let [operand (parse-syntax-unary)]
                    (syntax-reject-arrow-operand! operand)
                    (syntax-check-simple-target! operand false true)
                    (syntax-add-node! (SxUpdate
                                        :op (token-update-op-name t)
                                        :prefix true
                                        :target (syntax-ungroup-id operand))
                                      (.start t)
                                      (syntax-hi operand))))
                (parse-syntax-update))))))

;; An ArrowFunction is a whole AssignmentExpression: it cannot be an operand, an object of a
;; member access, a callee, or a `new` target without parentheses.
(defn syntax-arrow? [(id i64)] (-> bool)
  (match (syntax-node id)
    (SxFunction [fun]
                (let [f (syntax-fun-at fun)]
                  (match (.kind f) (FunArrow [] true) (_ false))))
    (_ false)))

(defn syntax-reject-arrow-operand! [(id i64)] (-> i64)
  (if (syntax-arrow? id)
      (syntax-error! "parser: an arrow function cannot be an operand without parentheses")
      0))

(defn syntax-binary! [(node SyntaxNode) (lhs i64) (rhs i64)] (-> i64)
  (do
    ;; Assignment right-hand sides, comma operands and conditional arms are AssignmentExpressions.
    (match node
      (SxComma [l r] 0)
      (SxAssign [target value] 0)
      (SxCompoundAssign [op target value] 0)
      (SxLogicalAssign [predicate rhs-on-true target value] 0)
      (SxConditional [condition when-true when-false]
                     (syntax-reject-arrow-operand! condition))
      (_ (do
           (syntax-reject-arrow-operand! lhs)
           (syntax-reject-arrow-operand! rhs))))
    (syntax-add-node! node (syntax-lo lhs) (syntax-hi rhs))))

;; ExponentiationExpression is right-associative and its base is an UpdateExpression: a unary
;; operator directly before `**` is a proven SyntaxError, while a parenthesized unary is fine.
(defn parse-syntax-exponent [] (-> i64)
  (let [first (peek-token)
        base (parse-syntax-unary)]
    (if (token-is (peek-token) "**")
        (do
          (if (token-unary-operator? first)
              (syntax-error! "parser: unary operator before ** requires parentheses")
              0)
          (take-token)
          (let [rhs (parse-syntax-exponent)]
            (syntax-binary! (SxBinary
                              :op "JsExp"
                              :left base
                              :right rhs)
                            base
                            rhs)))
        base)))

(defn parse-syntax-mul [] (-> i64)
  (let [(mut lhs) (parse-syntax-exponent)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "*") (token-is t "/") (token-is t "%")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-exponent)
                        op
                          (if (token-is t "*")
                              "JsMul"
                              (if (token-is t "/") "JsDiv" "JsMod"))]
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-add [] (-> i64)
  (let [(mut lhs) (parse-syntax-mul)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "+") (token-is t "-")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-mul)
                        op (if (token-is t "+") "JsAdd" "JsSub")]
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-shift [] (-> i64)
  (let [(mut lhs) (parse-syntax-add)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "<<") (token-is t ">>") (token-is t ">>>")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-add)
                        op
                          (if (token-is t "<<")
                              "JsShl"
                              (if (token-is t ">>") "JsShr" "JsUshr"))]
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

;; RelationalExpression. `in` is a keyword operator here; the `[~In]` grammar parameter used by
;; for-statement heads is not needed until that statement is admitted.
(defn parse-syntax-relational [] (-> i64)
  (let [(mut lhs) (parse-syntax-shift)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "<")
                         (token-is t ">")
                         (token-is t "<=")
                         (token-is t ">=")
                         (token-is t "instanceof")
                         (and (token-is t "in") (not (.no-in (parser-state))))))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-shift)
                        op
                          (if (token-is t "<")
                              "JsLt"
                              (if (token-is t ">")
                                  "JsGt"
                                  (if (token-is t "<=")
                                      "JsLe"
                                      (if (token-is t ">=")
                                          "JsGe"
                                          (if (token-is t "instanceof")
                                              "JsInstanceof"
                                              "JsIn")))))]
                    (match (syntax-node rhs)
                      (SxPrivateName [name]
                                     (syntax-error! "parser: a private name can only be the left operand of in"))
                      (_ 0))
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-equality [] (-> i64)
  ;; Final Simple Parser.parseEquality loops over comparison operands, left-associatively.
  ;; JavaScript preserves that precedence but ===/!== mean JSL strict equality, not raw EQ.
  (let [(mut lhs) (parse-syntax-relational)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "===")
                         (token-is t "!==")
                         (token-is t "==")
                         (token-is t "!=")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-relational)
                        op
                          (if (token-is t "===")
                              "JsStrictEqual"
                              (if (token-is t "!==")
                                  "JsStrictNotEqual"
                                  (if (token-is t "==")
                                      "JsLooseEqual"
                                      "JsLooseNotEqual")))]
                    (set! (mut lhs)
                          (syntax-binary! (SxBinary
                                            :op op
                                            :left (load lhs)
                                            :right rhs)
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-bitand [] (-> i64)
  (let [(mut lhs) (parse-syntax-equality)]
    (loop (if (not (take-is "&"))
              (break 0)
              (let [rhs (parse-syntax-equality)]
                (set! (mut lhs)
                      (syntax-binary! (SxBinary
                                        :op "JsBitAnd"
                                        :left (load lhs)
                                        :right rhs)
                                      (load lhs)
                                      rhs))
                (continue))))
    (load lhs)))

(defn parse-syntax-bitxor [] (-> i64)
  (let [(mut lhs) (parse-syntax-bitand)]
    (loop (if (not (take-is "^"))
              (break 0)
              (let [rhs (parse-syntax-bitand)]
                (set! (mut lhs)
                      (syntax-binary! (SxBinary
                                        :op "JsBitXor"
                                        :left (load lhs)
                                        :right rhs)
                                      (load lhs)
                                      rhs))
                (continue))))
    (load lhs)))

(defn parse-syntax-bitor [] (-> i64)
  (let [(mut lhs) (parse-syntax-bitxor)]
    (loop (if (not (take-is "|"))
              (break 0)
              (let [rhs (parse-syntax-bitxor)]
                (set! (mut lhs)
                      (syntax-binary! (SxBinary
                                        :op "JsBitOr"
                                        :left (load lhs)
                                        :right rhs)
                                      (load lhs)
                                      rhs))
                (continue))))
    (load lhs)))

(defn parse-syntax-and [] (-> i64)
  (let [(mut lhs) (parse-syntax-bitor)]
    (loop (if (not (take-is "&&"))
              (break 0)
              (let [rhs (parse-syntax-bitor)]
                (set! (mut lhs)
                      (syntax-binary! (SxAnd (load lhs) rhs) (load lhs) rhs))
                (continue))))
    (load lhs)))

(defn syntax-logical-and-or? [(id i64)] (-> bool)
  (match (syntax-node id) (SxAnd [l r] true) (SxOr [l r] true) (_ false)))

(defn syntax-coalesce? [(id i64)] (-> bool)
  (match (syntax-node id) (SxCoalesce [l r] true) (_ false)))

(defn parse-syntax-short-circuit [] (-> i64)
  (let [(mut lhs) (parse-syntax-and)]
    (loop (let [t (peek-token)]
            (if (not (or (token-is t "||") (token-is t "??")))
                (break 0)
                (do
                  (take-token)
                  (let [rhs (parse-syntax-and)
                        coalesce (token-is t "??")]
                    ;; CoalesceExpression may not contain an unparenthesized LogicalOR/AND.
                    ;; Group nodes preserve this grammar distinction without semantic AST facts.
                    (if (if coalesce
                            (or (syntax-logical-and-or? (load lhs))
                                (match (syntax-node rhs)
                                  (SxAnd [l r] true)
                                  (_ false)))
                            (syntax-coalesce? (load lhs)))
                        (syntax-error! "parser: nullish and logical operators require parentheses")
                        0)
                    (set! (mut lhs)
                          (syntax-binary! (if coalesce
                                              (SxCoalesce (load lhs) rhs)
                                              (SxOr (load lhs) rhs))
                                          (load lhs)
                                          rhs))
                    (continue))))))
    (load lhs)))

(defn parse-syntax-conditional [] (-> i64)
  (let [condition (parse-syntax-short-circuit)]
    (if (not (take-is "?"))
        condition
        (let [when-true (parse-syntax-assignment)]
          (require-token ":")
          (let [when-false (parse-syntax-assignment)]
            (syntax-binary! (SxConditional
                              :condition condition
                              :when-true when-true
                              :when-false when-false)
                            condition
                            when-false))))))

(defn token-compound-operator-name [(op Token)] (-> (slice u8))
  (if (token-is op "+=")
      "JsAdd"
      (if (token-is op "-=")
          "JsSub"
          (if (token-is op "*=")
              "JsMul"
              (if (token-is op "/=")
                  "JsDiv"
                  (if (token-is op "%=")
                      "JsMod"
                      (if (token-is op "**=")
                          "JsExp"
                          (if (token-is op "<<=")
                              "JsShl"
                              (if (token-is op ">>=")
                                  "JsShr"
                                  (if (token-is op ">>>=")
                                      "JsUshr"
                                      (if (token-is op "&=")
                                          "JsBitAnd"
                                          (if (token-is op "|=")
                                              "JsBitOr"
                                              (if (token-is op "^=")
                                                  "JsBitXor"
                                                  "")))))))))))))

(defn token-logical-assignment? [(op Token)] (-> bool)
  (or (token-is op "&&=") (token-is op "||=") (token-is op "??=")))

;; Assignment is right-associative and below the conditional expression. Parentheses preserve a
;; Reference, but arithmetic/calls cannot be turned into one by discarding their expression.
;; Logical assignment short-circuits: the RHS and the PutValue both live on one edge, and `||=`
;; evaluates its RHS on the FALSE edge of the truthiness predicate.
;; YieldExpression: `yield`, `yield expr`, `yield* expr`. Its argument is optional and ends at a
;; line terminator or any token that cannot begin an expression.
(defn parse-syntax-yield [] (-> i64)
  (let [t (take-token)]
    (if (parser-ctx-in-params?)
        (syntax-error! "parser: yield expression is not allowed in formal parameters")
        0)
    (let [next (peek-token)]
      (if (.nl-before next)
          (syntax-add-node! (SxYield (None [i64]) false) (.start t) (.end t))
          (if (token-is next "*")
              (do
                (take-token)
                (let [argument (parse-syntax-assignment)]
                  (syntax-add-node! (SxYield (Some argument) true)
                                    (.start t)
                                    (syntax-hi argument))))
              (if (or (token-cannot-start-expression? next)
                      (token-is next "in")
                      (token-is next "of"))
                  (syntax-add-node! (SxYield (None [i64]) false)
                                    (.start t)
                                    (.end t))
                  (let [argument (parse-syntax-assignment)]
                    (syntax-add-node! (SxYield (Some argument) false)
                                      (.start t)
                                      (syntax-hi argument)))))))))

(defn parse-syntax-assignment [] (-> i64)
  (if (and (token-is (peek-token) "yield") (parser-ctx-generator?))
      (parse-syntax-yield)
      (parse-syntax-assignment-proper)))

;; An unparenthesized object or array literal on the left of `=` is a destructuring pattern.
(defn syntax-pattern-literal? [(id i64)] (-> bool)
  (match (syntax-node id)
    (SxObject [entries] true)
    (SxArray [elements] true)
    (_ false)))

(defn parse-syntax-assignment-proper [] (-> i64)
  (let [lhs (parse-syntax-conditional)
        op (peek-token)
        compound (token-compound-operator-name op)
        logical (token-logical-assignment? op)]
    (if (not (or (token-is op "=") (!= compound "") logical))
        lhs
        (do
          (take-token)
          (if (and (token-is op "=") (syntax-pattern-literal? lhs))
              ;; Destructuring assignment: the literal becomes an assignment pattern.
              (let [pattern (syntax-cover-to-pattern! lhs false)
                    rhs (parse-syntax-assignment)]
                (syntax-add-node! (SxDestructuringAssign pattern rhs)
                                  (syntax-lo lhs)
                                  (syntax-hi rhs)))
              (do
                (syntax-check-simple-target! lhs
                                             (token-is op "=")
                                             (not logical))
                (let [target (syntax-ungroup-id lhs)
                      rhs (parse-syntax-assignment)]
                  (syntax-binary! (if logical
                                      (SxLogicalAssign
                                        :predicate
                                          (if (token-is op "??=")
                                              "JsNullish"
                                              "JsTruthy")
                                        :rhs-on-true (not (token-is op "||="))
                                        :target target
                                        :value rhs)
                                      (if (token-is op "=")
                                          (SxAssign target rhs)
                                          (SxCompoundAssign
                                            :op compound
                                            :target target
                                            :value rhs)))
                                  lhs
                                  rhs))))))))

;; Expression: comma-separated AssignmentExpressions, left to right, valued by the last.
(defn parse-syntax-expression [] (-> i64)
  (let [(mut lhs) (parse-syntax-assignment)]
    (loop (if (not (take-is ","))
              (break 0)
              (let [rhs (parse-syntax-assignment)]
                (set! (mut lhs)
                      (syntax-binary! (SxComma (load lhs) rhs) (load lhs) rhs))
                (continue))))
    (load lhs)))

(defn parse-optional-annotation [] (-> i64)
  (if (not (take-is ":"))
      (ty-dyn TAG-ANY)
      (if (.script-mode (parser-state))
          (do
            (panic "parser: TypeScript annotations are not valid in JavaScript Script code")
            TY-INVALID)
          (tstype-parse))))

;; JavaScript's ASI is a parser decision. An omitted semicolon is legal only at a line terminator,
;; before `}`, or at EOF; accepting one between two same-line statements changes invalid source
;; into a different valid program.
(defn parse-statement-end! [] (-> i64)
  (if (take-is ";")
      0
      (let [next (peek-token)]
        (if (or (.nl-before next) (token-is next "}") (= (.kind next) TOK-EOF))
            0
            (syntax-error! "parser: expected semicolon or line terminator")))))

;; Statement keywords whose grammar is not admitted yet must fail before the expression path can
;; mistake them for a proven "expected an expression" error.
;; `break`/`continue` take an optional same-line LabelIdentifier; a line terminator ends them.
(defn parse-jump-label [] (-> (Option (slice u8)))
  (let [next (peek-token)]
    (if (and (not (.nl-before next)) (= (.kind next) TOK-IDENT))
        (do (take-token) (Some (token-text next)))
        (None [(slice u8)]))))

(defn parse-syntax-statement [] (-> i64)
  (let [t (peek-token)]
    (if (token-is t "switch")
        (parse-syntax-switch)
        (if (or (token-is t "break") (token-is t "continue"))
            (do
              (take-token)
              (let [label (parse-jump-label)]
                (parse-statement-end!)
                (syntax-stmt-add-node! (if (token-is t "break")
                                           (SsBreak label)
                                           (SsContinue label))
                                       (.start t)
                                       (lex-consumed-end))))
            (if (take-is ";")
                (syntax-stmt-add-node! (SsEmpty) (.start t) (.end t))
                (do
                  (if (and (token-is t "return")
                           (not (parser-return-allowed?)))
                      (syntax-error! "parser: return is not allowed here")
                      0)
                  (parse-syntax-statement-inner)))))))

(defn parse-syntax-switch [] (-> i64)
  (let [keyword (require-token "switch")
        (mut cases) (al-new [i64] (compiler-allocator))
        (mut has-default) false]
    (require-token "(")
    (let [value (parse-syntax-expression)]
      (require-token ")")
      (require-token "{")
      (loop (if (token-is (peek-token) "}")
                (break 0)
                (let [label (take-token)
                      selector
                        (if (token-is label "case")
                            (Some (parse-syntax-expression))
                            (if (token-is label "default")
                                (do
                                  (if (load has-default)
                                      (syntax-error! "parser: duplicate switch default")
                                      0)
                                  (set! (mut has-default) true)
                                  (None [i64]))
                                (do
                                  (parse-fail "parser: expected switch case/default at byte"
                                              label)
                                  (None [i64]))))
                      (mut body) (al-new [i64] (compiler-allocator))]
                  (require-token ":")
                  (loop (let [next (peek-token)]
                          (if (or (token-is next "case")
                                  (token-is next "default")
                                  (token-is next "}"))
                              (break 0)
                              (do
                                (push! [i64]
                                       (mut body)
                                       (parse-syntax-statement))
                                (continue)))))
                  (push! [i64]
                         (mut cases)
                         (syntax-stmt-add-node! (SsCase selector (load body))
                                                (.start label)
                                                (lex-consumed-end)))
                  (continue))))
      (let [close (require-token "}")]
        (syntax-stmt-add-node! (SsSwitch value (load cases))
                               (.start keyword)
                               (.end close))))))

;; A Statement position (the body of if/while/do/for/with/label) admits no declaration. `class`,
;; `const`, `let [`, a same-line `let x` and `async function` are proven SyntaxErrors there, as is a
;; FunctionDeclaration in a loop or `with` body; Annex B.3.3 admits `if (x) function f() {}` in
;; sloppy code as a Block holding the declaration (the strict pass rejects it in strict code). A
;; labelled function declaration is never a Statement body. A bare `let` is a sloppy identifier.
(defn let-starts-declaration? [] (-> bool)
  (or (lex-second-kind? TOK-IDENT)
      (lex-second-is? "let")
      (lex-second-is? "[")
      (lex-second-is? "{")))

(defn syntax-labelled-function? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsLabeled [label body]
               (match (syntax-stmt-node body)
                 (SsFunctionDecl [fun] true)
                 (_ (syntax-labelled-function? body))))
    (_ false)))

(defn syntax-annexb-block? [(id i64)] (-> bool)
  (let [(mut found) false]
    (al-for [b (.annexb-blocks (parser-state))]
            (if (= b id) (set! (mut found) true) 0))
    (load found)))

(defn parse-syntax-controlled-statement [(loop-body bool) (annexb-if bool)] (-> i64)
  (let [stmt (parse-syntax-controlled-statement-inner loop-body annexb-if)]
    (if (syntax-labelled-function? stmt)
        (syntax-error! "parser: labelled function declaration is not allowed in a statement position")
        0)
    stmt))

(defn parse-syntax-controlled-statement-inner [(loop-body bool)
                                               (annexb-if bool)] (-> i64)
  (let [t (peek-token)]
    (if (or (token-is t "class") (token-is t "const"))
        (syntax-error! "parser: declaration is not allowed in a statement position")
        (if (token-is t "let")
            ;; `let [` can never start a Statement; a same-line `let x` / `let {` is a lexical
            ;; declaration in a statement position. Otherwise `let` is a sloppy identifier and the
            ;; statement is an expression statement.
            (if (or (lex-second-is? "[")
                    (and (let [second (lex-peek-second false)]
                           (not (.nl-before second)))
                         (or (lex-second-kind? TOK-IDENT)
                             (lex-second-is? "let")
                             (lex-second-is? "{"))))
                (syntax-error! "parser: lexical declaration is not allowed in a statement position")
                (parse-syntax-expression-statement))
            (if (token-is t "function")
                (if loop-body
                    (syntax-error! "parser: function declaration is not allowed in a loop body")
                    (if (and annexb-if (not (lex-second-is? "*")))
                        (let [decl (parse-syntax-statement)
                              (mut body) (al-new [i64] (compiler-allocator))]
                          (push! [i64] (mut body) decl)
                          (let [id
                                  (syntax-stmt-add-node! (SsBlock (load body))
                                                         (syntax-stmt-lo decl)
                                                         (syntax-stmt-hi decl))]
                            (push! [i64]
                                   (mut (.annexb-blocks (parser-state)))
                                   id)
                            id))
                        (syntax-error! "parser: function declaration is not allowed in a statement position")))
                (if (and (token-is t "async") (lex-second-is? "function"))
                    (syntax-error! "parser: async function declaration is not allowed in a statement position")
                    (parse-syntax-statement)))))))

;; A declared name; `let` may not be lexically bound.
(defn parse-syntax-declared-name! [(is-var bool)] (-> Token)
  (let [t (require-binding-identifier)]
    (if (and (not is-var) (token-is t "let"))
        (syntax-error! "parser: let is not a valid lexical binding name")
        0)
    t))

(defn parse-syntax-lexical-pattern! [(is-var bool)] (-> i64)
  (let [pattern (parse-syntax-binding-pattern!)]
    (if is-var
        0
        (let [(mut names) (al-new [(slice u8)] (compiler-allocator))]
          (syntax-pattern-names! pattern (mut names))
          (al-for [name (load names)]
                  (if (= name "let")
                      (syntax-error! "parser: let is not a valid lexical binding name")
                      0))
          (al-free! [(slice u8)] (mut names))
          0))
    pattern))

;; ExpressionStatement, or a LabelledStatement that shares its first token with one. A labelled
;; item may be a plain FunctionDeclaration in sloppy code (the strict pass rejects it in strict
;; code); generator and async declarations are never labelled items.
(defn parse-syntax-expression-statement [] (-> i64)
  (let [expr (parse-syntax-expression)
        parsed (syntax-at expr)]
    (if (and (token-is (peek-token) ":") (syntax-name? expr))
        (let [label (match (syntax-node expr) (SxName [name] name) (_ ""))]
          (syntax-check-binding-name! label)
          (take-token)
          (let [body
                  (if (token-is (peek-token) "function")
                      (if (lex-second-is? "*")
                          (syntax-error! "parser: generator declaration is not allowed as a labelled item")
                          (parse-syntax-statement))
                      ;; Nested labels are checked by whichever Statement body holds the chain.
                      (parse-syntax-controlled-statement-inner false false))]
            (syntax-stmt-add-node! (SsLabeled label body)
                                   (.lo parsed)
                                   (syntax-stmt-hi body))))
        (do
          (parse-statement-end!)
          (syntax-stmt-add-node! (SsExpr expr) (.lo parsed) (.hi parsed))))))

;; VariableDeclarationList / LexicalDeclaration without the terminating semicolon. In a for-head
;; the missing `const` initializer is deferred: `for (const x of y)` is legal.
(defn parse-syntax-declaration-list [(for-head bool)] (-> i64)
  (let [keyword (take-token)
        is-var (token-is keyword "var")
        (mut declarations) (al-new [i64] (compiler-allocator))
        (mut hi) (.end keyword)]
    (loop (let [name-token (peek-token)]
            ;; BoundNames of a LexicalDeclaration may not contain `let`.
            (if (and (not is-var) (token-is name-token "let"))
                (syntax-error! "parser: `let` is not a valid lexically bound name")
                0)
            (if (or (token-is name-token "[") (token-is name-token "{"))
                (let [pattern (parse-syntax-lexical-pattern! is-var)
                      init
                        (if (take-is "=")
                            (Some (parse-syntax-assignment))
                            (do
                              (if (not for-head)
                                  (syntax-error! "parser: a destructuring declaration requires an initializer")
                                  0)
                              (None [i64])))
                      end (lex-consumed-end)
                      start
                        (if (= (len (load declarations)) 0)
                            (.start keyword)
                            (.start name-token))
                      node
                        (if is-var
                            (SsVarPattern pattern init)
                            (SsLetPattern
                              :pattern pattern
                              :init init
                              :final (token-is keyword "const")))]
                  (push! [i64]
                         (mut declarations)
                         (syntax-stmt-add-node! node start end))
                  (set! (mut hi) end)
                  (if (take-is ",") (continue) (break 0)))
                (let [name (parse-syntax-declared-name! is-var)
                      annotation (parse-optional-annotation)
                      init
                        (if (take-is "=")
                            (Some (parse-syntax-assignment))
                            (do
                              (if (and (token-is keyword "const")
                                       (not for-head))
                                  (syntax-error! "parser: const declaration requires an initializer")
                                  0)
                              (None [i64])))
                      end (lex-consumed-end)
                      start
                        (if (= (len (load declarations)) 0)
                            (.start keyword)
                            (.start name))
                      node
                        (if is-var
                            (SsVar
                              :name (token-text name)
                              :init init
                              :annotation annotation)
                            (SsLet
                              :name (token-text name)
                              :init init
                              :final (token-is keyword "const")
                              :annotation annotation))]
                  (push! [i64]
                         (mut declarations)
                         (syntax-stmt-add-node! node start end))
                  (set! (mut hi) end)
                  (if (take-is ",") (continue) (break 0))))))
    (if (= (len (load declarations)) 1)
        (get (load declarations) 0)
        (syntax-stmt-add-node! (SsDeclList (load declarations))
                               (.start keyword)
                               (load hi)))))

;; After a complete for-head expression only the separator can follow; anything else is a
;; proven error.
(defn require-closing! [(text (slice u8)) (message (slice u8))] (-> i64)
  (let [t (peek-token)]
    (if (token-is t text)
        (do (take-token) 0)
        (syntax-error! message))))

(defn parse-syntax-declarations [] (-> i64)
  (let [stmt (parse-syntax-declaration-list false)]
    (parse-statement-end!)
    stmt))

(defn syntax-stmt-lexical? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsLet [name init final annotation] true)
    (SsLetPattern [pattern init final] true)
    (SsDeclList [decls]
                (if (= (len decls) 0)
                    false
                    (syntax-stmt-lexical? (get decls 0))))
    (_ false)))

;; A for-in/of head declaration binds exactly one name without an initializer. Annex B admits
;; `for (var x = 1 in o)` in sloppy code; that is unsupported and fails closed.
;; `of` heads never take an initializer; Annex B.3.5 admits `for (var x = 1 in o)` for a plain
;; var binding in sloppy code (the strict pass rejects it in strict code).
(defn syntax-check-for-in-head! [(stmt i64) (of bool)] (-> i64)
  (match (syntax-stmt-node stmt)
    (SsVar [name init annotation]
           (match init
             (Some [e]
                   (if of
                       (syntax-error! "parser: for-of var binding cannot have an initializer")
                       0))
             (None [] 0)))
    (SsLet [name init final annotation]
           (match init
             (Some [e]
                   (syntax-error! "parser: for-in/of lexical binding cannot have an initializer"))
             (None [] 0)))
    (SsLetPattern [pattern init final]
                  (match init
                    (Some [e]
                          (syntax-error! "parser: for-in/of binding pattern cannot have an initializer"))
                    (None [] 0)))
    (SsVarPattern [pattern init]
                  (match init
                    (Some [e]
                          (syntax-error! "parser: for-in/of binding pattern cannot have an initializer"))
                    (None [] 0)))
    (SsDeclList [decls]
                (syntax-error! "parser: for-in/of head declares exactly one binding"))
    (_ (broken "syntax-check-for-in-head!: head is not a declaration"))))

(defn syntax-check-const-initializers! [(stmt i64)] (-> i64)
  (match (syntax-stmt-node stmt)
    (SsLet [name init final annotation]
           (if (and final (match init (Some [e] false) (None [] true)))
               (syntax-error! "parser: const declaration requires an initializer")
               0))
    (SsLetPattern [pattern init final]
                  (match init
                    (Some [e] 0)
                    (None []
                          (syntax-error! "parser: a destructuring declaration requires an initializer"))))
    (SsVarPattern [pattern init]
                  (match init
                    (Some [e] 0)
                    (None []
                          (syntax-error! "parser: a destructuring declaration requires an initializer"))))
    (SsDeclList [decls]
                (do (al-for [d decls] (syntax-check-const-initializers! d)) 0))
    (_ 0)))

;; for ( init ; test ; update ) body, for ( head in object ) body, for ( head of iterable ) body.
;; The head is parsed under the `[~In]` grammar so `in` can only mean for-in there.
(defn parse-syntax-for [] (-> i64)
  (let [keyword (require-token "for")
        awaited (token-is (peek-token) "await")]
    ;; `for await` exists only inside async functions; elsewhere `await` is an identifier that
    ;; cannot follow `for`.
    (if awaited
        (do
          (if (not (parser-ctx-async?))
              (syntax-error! "parser: for await is only allowed in an async function")
              0)
          (take-token)
          0)
        0)
    (require-token "(")
    (let [first (peek-token)
          saved-no-in (.no-in (parser-state))
          head
            (if (token-is first ";")
                (ForNoInit)
                (do
                  (set! (.no-in (parser-state)) true)
                  (if (or (token-is first "var")
                          (token-is first "const")
                          (and (token-is first "let") (let-starts-declaration?)))
                      (ForInitDecl (parse-syntax-declaration-list true))
                      ;; `for await (async of …)`: `async of` is not an arrow head here.
                      (if (and awaited
                               (token-is first "async")
                               (lex-second-is? "of"))
                          (let [t (take-token)]
                            (ForInitExpr (syntax-add-node! (SxName "async")
                                                           (.start t)
                                                           (.end t))))
                          (ForInitExpr (parse-syntax-expression))))))]
      (set! (.no-in (parser-state)) saved-no-in)
      (let [after (peek-token)
            of (and (= (.kind after) TOK-IDENT) (token-is after "of"))]
        (if (and awaited (not of))
            (syntax-error! "parser: for await requires an of clause")
            0)
        ;; `for (let of …)` and `for (async of …)` are excluded by lookahead; `for await` admits
        ;; `async`.
        (if (and of
                 (token-is first "let")
                 (match head (ForInitExpr [e] true) (_ false)))
            (syntax-error! "parser: for-of head cannot begin with let")
            0)
        (if (and of
                 (not awaited)
                 (token-is first "async")
                 (match head
                   (ForInitExpr [e]
                                (match (syntax-node e)
                                  (SxName [name] (= name "async"))
                                  (_ false)))
                   (_ false)))
            (syntax-error! "parser: for-of head cannot be the identifier async")
            0)
        (if (and (or (token-is after "in") of)
                 (match head (ForNoInit [] false) (_ true)))
            (do
              (take-token)
              (let [head-pattern
                      (match head
                        (ForInitExpr [expr]
                                     (match (syntax-node expr)
                                       (SxObject [entries]
                                                 (Some (syntax-cover-to-pattern! expr
                                                                                 false)))
                                       (SxArray [elements]
                                                (Some (syntax-cover-to-pattern! expr
                                                                                false)))
                                       (_ (do
                                            (syntax-check-simple-target! expr
                                                                         true
                                                                         false)
                                            (None [i64])))))
                        (ForInitDecl [stmt]
                                     (do
                                       (syntax-check-for-in-head! stmt of)
                                       (None [i64])))
                        (_ (None [i64])))
                    head
                      (match head-pattern
                        (Some [pat] (ForInitPattern pat))
                        (None [] head))
                    right
                      (if of
                          (parse-syntax-assignment)
                          (parse-syntax-expression))]
                (require-closing! ")"
                                  "parser: expected `)` after for-in/of head")
                (let [body (parse-syntax-controlled-statement true false)]
                  (syntax-stmt-add-node! (SsForIn
                                           :head head
                                           :of of
                                           :right right
                                           :body body
                                           :awaited awaited)
                                         (.start keyword)
                                         (syntax-stmt-hi body)))))
            (do
              ;; A const without initializer was deferred for the for-in/of case above.
              (match head
                (ForInitDecl [stmt] (syntax-check-const-initializers! stmt))
                (_ 0))
              (require-closing! ";"
                                "parser: expected `;` in for statement head")
              (let [test
                      (if (token-is (peek-token) ";")
                          (None [i64])
                          (Some (parse-syntax-expression)))]
                (require-closing! ";"
                                  "parser: expected `;` in for statement head")
                (let [update
                        (if (token-is (peek-token) ")")
                            (None [i64])
                            (Some (parse-syntax-expression)))]
                  (require-closing! ")"
                                    "parser: expected `)` after for statement head")
                  (let [body (parse-syntax-controlled-statement true false)]
                    (syntax-stmt-add-node! (SsFor
                                             :init head
                                             :test test
                                             :update update
                                             :body body)
                                           (.start keyword)
                                           (syntax-stmt-hi body)))))))))))

;; try Block Catch? Finally?; at least one of Catch/Finally. CatchParameter is a BindingIdentifier
;; or a BindingPattern, recorded as a pattern either way.
(defn parse-syntax-block-required [(what (slice u8))] (-> i64)
  (if (token-is (peek-token) "{")
      (parse-syntax-statement)
      (syntax-error! what)))

(defn parse-syntax-try [] (-> i64)
  (let [keyword (require-token "try")
        body (parse-syntax-block-required "parser: expected a block after try")
        (mut catch-param) (None [i64])
        (mut catch-body) (None [i64])
        (mut finally-body) (None [i64])]
    (if (take-is "catch")
        (do
          (if (take-is "(")
              (let [param (peek-token)]
                (set! (mut catch-param)
                      (Some (if (or (token-is param "[") (token-is param "{"))
                                (parse-syntax-binding-pattern!)
                                (let [name (require-binding-identifier)]
                                  (syntax-pattern-add! (PatName (token-text name))
                                                       (None [i64])
                                                       (.start name)
                                                       (.end name))))))
                (require-token ")")
                0)
              0)
          (set! (mut catch-body)
                (Some (parse-syntax-block-required "parser: expected a block after catch"))))
        0)
    (if (take-is "finally")
        (set! (mut finally-body)
              (Some (parse-syntax-block-required "parser: expected a block after finally")))
        0)
    (if (and (match (load catch-body) (None [] true) (_ false))
             (match (load finally-body) (None [] true) (_ false)))
        (syntax-error! "parser: try requires a catch or finally clause")
        0)
    (syntax-stmt-add-node! (SsTry
                             :body body
                             :catch-param (load catch-param)
                             :catch-body (load catch-body)
                             :finally-body (load finally-body))
                           (.start keyword)
                           (lex-consumed-end))))

(defn parse-syntax-statement-inner [] (-> i64)
  (let [first (peek-token)]
    ;; Import and export declarations exist only in the Module goal. `import(` and `import.` begin
    ;; expressions and take the ordinary expression-statement path below.
    (if (token-is first "export")
        (syntax-error! "parser: export declarations are only valid in a module")
        0)
    (if (and (token-is first "import")
             (not (or (lex-second-is? "(") (lex-second-is? "."))))
        (syntax-error! "parser: import declarations are only valid in a module")
        0)
    (if (token-is first "class")
        (let [cls (parse-syntax-class (take-token) true)]
          (syntax-stmt-add-node! (SsClassDecl cls)
                                 (.start first)
                                 (syntax-class-hi cls)))
        (if (or (token-is first "function")
                (and (token-is first "async")
                     (lex-second-is? "function")
                     (let [second (lex-peek-second false)]
                       (not (.nl-before second)))))
            (parse-syntax-function-declaration!)
            (if (token-is first "for")
                (parse-syntax-for)
                (if (token-is first "try")
                    (parse-syntax-try)
                    (if (token-is first "do")
                        (let [keyword (take-token)
                              body
                                (parse-syntax-controlled-statement true false)]
                          (require-token "while")
                          (require-token "(")
                          (let [condition (parse-syntax-expression)
                                close (require-token ")")]
                            ;; ASI: the `;` after a do-while's `)` may be omitted even without a line terminator.
                            (take-is ";")
                            (syntax-stmt-add-node! (SsDoWhile body condition)
                                                   (.start keyword)
                                                   (.end close))))
                        (if (token-is first "throw")
                            (let [keyword (take-token)
                                  next (peek-token)]
                              (if (.nl-before next)
                                  (syntax-error! "parser: line terminator is not allowed after throw")
                                  0)
                              (let [value (parse-syntax-expression)]
                                (parse-statement-end!)
                                (syntax-stmt-add-node! (SsThrow value)
                                                       (.start keyword)
                                                       (syntax-hi value))))
                            (if (token-is first "with")
                                (let [keyword (take-token)]
                                  (require-token "(")
                                  (let [object (parse-syntax-expression)]
                                    (require-token ")")
                                    (let [body
                                            (parse-syntax-controlled-statement false
                                                                               false)]
                                      (syntax-stmt-add-node! (SsWith object
                                                                     body)
                                                             (.start keyword)
                                                             (syntax-stmt-hi body)))))
                                (if (token-is first "debugger")
                                    (let [keyword (take-token)]
                                      (parse-statement-end!)
                                      (syntax-stmt-add-node! (SsDebugger)
                                                             (.start keyword)
                                                             (.end keyword)))
                                    (if (token-is first "while")
                                        (let [keyword (take-token)]
                                          (require-token "(")
                                          (let [condition
                                                  (parse-syntax-expression)]
                                            (require-token ")")
                                            (let [body
                                                    (parse-syntax-controlled-statement true
                                                                                       false)]
                                              (syntax-stmt-add-node! (SsWhile condition
                                                                              body)
                                                                     (.start keyword)
                                                                     (syntax-stmt-hi body)))))
                                        (if (token-is first "if")
                                            (let [keyword (take-token)]
                                              (require-token "(")
                                              (let [condition
                                                      (parse-syntax-expression)]
                                                (require-token ")")
                                                (let [yes
                                                        (parse-syntax-controlled-statement false
                                                                                           true)
                                                      no
                                                        (if (take-is "else")
                                                            (Some (parse-syntax-controlled-statement false
                                                                                                     true))
                                                            (None [i64]))
                                                      last
                                                        (match no
                                                          (Some [n] n)
                                                          (None [] yes))]
                                                  (syntax-stmt-add-node! (SsIf
                                                                           :condition
                                                                             condition
                                                                           :then-stmt
                                                                             yes
                                                                           :else-stmt
                                                                             no)
                                                                         (.start keyword)
                                                                         (syntax-stmt-hi last)))))
                                            (if (or (and (token-is first "let")
                                                         (let-starts-declaration?))
                                                    (token-is first "const")
                                                    (token-is first "var"))
                                                (parse-syntax-declarations)
                                                (if (token-is first "return")
                                                    (let [keyword (take-token)
                                                          next (peek-token)]
                                                      ;; Return is a restricted production: a line terminator ends it before the
                                                      ;; following expression. A missing expression is the JavaScript value
                                                      ;; `undefined`; the next line remains a separate, unreachable statement.
                                                      (if (or (.nl-before next)
                                                              (token-is next
                                                                        ";")
                                                              (token-is next
                                                                        "}")
                                                              (= (.kind next)
                                                                 TOK-EOF))
                                                          (do
                                                            (parse-statement-end!)
                                                            (syntax-stmt-add-node! (SsReturn (None [i64]))
                                                                                   (.start keyword)
                                                                                   (.end keyword)))
                                                          (let [expr
                                                                  (parse-syntax-expression)]
                                                            (parse-statement-end!)
                                                            (syntax-stmt-add-node! (SsReturn (Some expr))
                                                                                   (.start keyword)
                                                                                   (syntax-hi expr)))))
                                                    (if (token-is first "{")
                                                        (do
                                                          (take-token)
                                                          (let [(mut body)
                                                                  (al-new [i64]
                                                                          (compiler-allocator))]
                                                            (loop (if (token-is (peek-token)
                                                                                "}")
                                                                      (break 0)
                                                                      (do
                                                                        (push! [i64]
                                                                               (mut body)
                                                                               (parse-syntax-statement))
                                                                        (continue))))
                                                            (let [close
                                                                    (require-token "}")]
                                                              (syntax-stmt-add-node! (SsBlock (load body))
                                                                                     (.start first)
                                                                                     (.end close)))))
                                                        (parse-syntax-expression-statement))))))))))))))))

(defn parse-syntax-statement-list [] (-> (ArrayList i64))
  (let [(mut body) (al-new [i64] (compiler-allocator))]
    (loop (if (token-is (peek-token) "}")
              (break 0)
              (do (push! [i64] (mut body) (parse-syntax-statement)) (continue))))
    (load body)))

;; Reserve a SyntaxFun before its parameters are parsed so the record index is stable for nested
;; functions and for the `SxFunction`/`SsFunctionDecl` that will reference it.
(defn syntax-fun-reserve! [(name (slice u8))
                           (kind FunKind)
                           (generator bool)
                           (async bool)
                           (lo i64)] (-> i64)
  (let [(mut f) (primitive/zeroed SyntaxFun)
        index (len (.funs (parser-state)))]
    (set! (.name (mut f)) name)
    (set! (.kind (mut f)) kind)
    (set! (.generator (mut f)) generator)
    (set! (.async (mut f)) async)
    (set! (.params (mut f)) (al-new [(slice u8)] (compiler-allocator)))
    (set! (.param-annotations (mut f)) (al-new [i64] (compiler-allocator)))
    (set! (.param-defaults (mut f))
          (al-new [(Option i64)] (compiler-allocator)))
    (set! (.param-patterns (mut f))
          (al-new [(Option i64)] (compiler-allocator)))
    (set! (.rest-param (mut f)) (None [(slice u8)]))
    (set! (.rest-pattern (mut f)) (None [i64]))
    (set! (.simple-params (mut f)) true)
    (set! (.return-annotation (mut f)) (ty-dyn TAG-ANY))
    (set! (.body (mut f)) (al-new [i64] (compiler-allocator)))
    (set! (.expression-body (mut f)) (None [i64]))
    (set! (.parent (mut f)) (parser-current-fun))
    (set! (.in-class (mut f)) (> (.class-strict (parser-state)) 0))
    (set! (.hoisted (mut f)) false)
    (set! (.value-taken (mut f)) false)
    (set! (.strict (mut f)) false)
    (set! (.lo (mut f)) lo)
    (set! (.script (mut f)) (.current-script (parser-state)))
    (set! (.static-entry (mut f)) -1)
    (set! (.class-index (mut f)) -1)
    (set! (.env-names (mut f)) (al-new [(slice u8)] (compiler-allocator)))
    (set! (.env-lexical (mut f)) (al-new [i64] (compiler-allocator)))
    (push! [SyntaxFun] (mut (.funs (parser-state))) (load f))
    index))

(defn syntax-fun-ptr [(i i64)] (-> (ptr SyntaxFun))
  (al-elem [SyntaxFun] (mut (.funs (parser-state))) i))

;; FormalParameters after `(`, consuming `)`. Defaults, a rest element and destructuring
;; patterns make the list non-simple; a destructured parameter keeps "" in `params`.
(defn parse-syntax-formal-parameters! [(fp (ptr SyntaxFun))] (-> i64)
  (do
    (if (take-is ")")
        0
        (loop (if (token-is (peek-token) "...")
                  (let [dots (take-token)]
                    (set! (.simple-params fp) false)
                    (if (or (token-is (peek-token) "[")
                            (token-is (peek-token) "{"))
                        (set! (.rest-pattern fp)
                              (Some (parse-syntax-binding-pattern!)))
                        (let [name (require-binding-identifier)]
                          (set! (.rest-param fp) (Some (token-text name)))))
                    (if (token-is (peek-token) "=")
                        (syntax-error! "parser: rest parameter may not have a default")
                        0)
                    (if (take-is ")")
                        0
                        (syntax-error! "parser: rest parameter must be last"))
                    (break 0))
                  (let [pattern-param
                          (or (token-is (peek-token) "[")
                              (token-is (peek-token) "{"))
                        pattern
                          (if pattern-param
                              (Some (parse-syntax-binding-pattern!))
                              (None [i64]))
                        name-text
                          (if pattern-param
                              ""
                              (token-text (require-binding-identifier)))
                        annotation (parse-optional-annotation)]
                    (if pattern-param (set! (.simple-params fp) false) 0)
                    (push! [(slice u8)] (mut (.params fp)) name-text)
                    (push! [(Option i64)] (mut (.param-patterns fp)) pattern)
                    (push! [i64] (mut (.param-annotations fp)) annotation)
                    (if (take-is "=")
                        (do
                          (set! (.simple-params fp) false)
                          (push! [(Option i64)]
                                 (mut (.param-defaults fp))
                                 (Some (parse-syntax-assignment))))
                        (push! [(Option i64)]
                               (mut (.param-defaults fp))
                               (None [i64])))
                    (if (take-is ",")
                        (if (take-is ")") (break 0) (continue))
                        (break (do
                                 (require-closing! ")"
                                                   "parser: expected `,` or `)` in parameter list")
                                 0)))))))
    0))

;; Early errors every function shares once its parameters and body are known: duplicate
;; parameters where UniqueFormalParameters or non-simple lists forbid them (strict duplicates are
;; the strict pass's job), a `use strict` directive over a non-simple list, accessor arity, and
;; parameter/lexical conflicts (checked with the other declarations later).
(defn syntax-check-function-shape! [(index i64) (own-directive bool)] (-> i64)
  (let [f (syntax-fun-at index)
        unique
          (or (not (.simple-params f))
              (match (.kind f)
                (FunArrow [] true)
                (FunMethod [] true)
                (FunGetter [] true)
                (FunSetter [] true)
                (_ false)))]
    (if (and own-directive (not (.simple-params f)))
        (syntax-error! "parser: use strict directive is not allowed with a non-simple parameter list")
        0)
    (if unique
        (let [(mut bound) (syntax-fun-bound-names f)
              (mut i) 0]
          (loop (if (>= (load i) (len (load bound)))
                    (break 0)
                    (let [name (get (load bound) (load i))
                          (mut j) (+ (load i) 1)]
                      (loop (if (>= (load j) (len (load bound)))
                                (break 0)
                                (do
                                  (if (= name (get (load bound) (load j)))
                                      (syntax-error! "parser: duplicate parameter name")
                                      0)
                                  (set! (mut j) (+ (load j) 1))
                                  (continue))))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (al-free! [(slice u8)] (mut bound)))
        0)
    (match (.kind f)
      (FunGetter []
                 (if (or (> (len (.params f)) 0)
                         (match (.rest-param f) (Some [r] true) (None [] false)))
                     (syntax-error! "parser: getter must not have parameters")
                     0))
      (FunSetter []
                 (if (or (!= (len (.params f)) 1)
                         (match (.rest-param f) (Some [r] true) (None [] false)))
                     (syntax-error! "parser: setter must have exactly one parameter")
                     0))
      (_ 0))))

;; Parameters, optional return annotation and a braced body for every non-arrow function kind.
;; `name` was validated in the enclosing context; parameters and body use the function's own.
(defn parse-syntax-function-rest! [(index i64)
                                   (kind FunKind)
                                   (generator bool)
                                   (async bool)
                                   (derived-constructor bool)] (-> i64)
  (let [method
          (match kind
            (FunMethod [] true)
            (FunGetter [] true)
            (FunSetter [] true)
            (_ false))]
    (parser-push-context! index generator async false method)
    (parser-mark-top-context! false false derived-constructor)
    (require-token "(")
    (parse-syntax-formal-parameters! (syntax-fun-ptr index))
    (let [return-annotation (parse-optional-annotation)]
      (parser-set-in-params! false)
      (require-token "{")
      (let [body (parse-syntax-statement-list)
            close (require-token "}")
            own-directive (syntax-body-strict? body)
            fp (syntax-fun-ptr index)]
        (parser-pop-context!)
        (if own-directive (do (set! (.strict-pending (parser-state)) true) 0) 0)
        (set! (.return-annotation fp) return-annotation)
        (set! (.body fp) body)
        (set! (.hi fp) (.end close))
        (syntax-check-function-shape! index own-directive)
        index))))

;; `function` [*] name (…) {…} as a declaration statement. The name binds in the enclosing scope.
(defn parse-syntax-function-declaration! [] (-> i64)
  (let [first (take-token)
        async (token-is first "async")]
    (if async (do (require-token "function") 0) 0)
    (let [generator (take-is "*")
          name (require-binding-identifier)
          index
            (syntax-fun-reserve! (token-text name)
                                 (FunDeclaration)
                                 generator
                                 async
                                 (.start first))]
      (parse-syntax-function-rest! index (FunDeclaration) generator async false)
      (let [f (syntax-fun-at index)]
        (syntax-stmt-add-node! (SsFunctionDecl index) (.start first) (.hi f))))))

;; A function expression's own name is bound inside the function, so `function yield(){}` inside a
;; generator body is legal while a generator expression named `yield` is not.
(defn parse-syntax-function-expression-name [(generator bool) (async bool)] (-> (slice u8))
  (let [t (take-token)
        name (token-text t)]
    (if (and (!= (.kind t) TOK-IDENT) (not (token-is t "let")))
        (syntax-error! "parser: reserved word cannot be a function name")
        ;; The name binds inside the expression, so only its own kind reserves yield/await.
        (if (or (and (= name "yield") generator)
                (and (= name "await") async))
            (syntax-error! "parser: invalid function expression name")
            0))
    name))

(defn parse-syntax-function-expression [(keyword Token) (async bool) (lo i64)] (-> i64)
  (let [generator (take-is "*")
        name
          (if (token-is (peek-token) "(")
              ""
              (parse-syntax-function-expression-name generator async))]
    (let [index (syntax-fun-reserve! name (FunExpression) generator async lo)]
      (parse-syntax-function-rest! index (FunExpression) generator async false)
      (let [f (syntax-fun-at index)]
        (syntax-add-node! (SxFunction index) lo (.hi f))))))

;; ArrowFunction body after its parameters are settled: `=>` then a braced FunctionBody or a
;; ConciseBody AssignmentExpression. Arrows are never generators; `await` follows `async`.
(defn parse-syntax-arrow-body! [(lo i64)
                                (params (ArrayList (slice u8)))
                                (defaults (ArrayList (Option i64)))
                                (patterns (ArrayList (Option i64)))
                                (rest (Option (slice u8)))
                                (rest-pattern (Option i64))
                                (simple bool)
                                (async bool)] (-> i64)
  (let [arrow (take-token)]
    (if (not (token-is arrow "=>")) (syntax-error! "parser: expected =>") 0)
    (if (.nl-before arrow)
        (syntax-error! "parser: line terminator is not allowed before =>")
        0)
    (let [index (syntax-fun-reserve! "" (FunArrow) false async lo)
          fp (syntax-fun-ptr index)]
      (set! (.params fp) params)
      (set! (.param-defaults fp) defaults)
      (set! (.param-patterns fp) patterns)
      (set! (.rest-param fp) rest)
      (set! (.rest-pattern fp) rest-pattern)
      (set! (.simple-params fp) simple)
      (let [(mut i) 0]
        (loop (if (>= (load i) (len params))
                  (break 0)
                  (do
                    (push! [i64] (mut (.param-annotations fp)) (ty-dyn TAG-ANY))
                    (set! (mut i) (+ (load i) 1))
                    (continue)))))
      (parser-push-context! index false async true false)
      (parser-set-in-params! false)
      (if (token-is (peek-token) "{")
          (do
            (take-token)
            (let [body (parse-syntax-statement-list)
                  close (require-token "}")
                  own-directive (syntax-body-strict? body)
                  fp2 (syntax-fun-ptr index)]
              (parser-pop-context!)
              (if own-directive
                  (do (set! (.strict-pending (parser-state)) true) 0)
                  0)
              (set! (.body fp2) body)
              (set! (.hi fp2) (.end close))
              (syntax-check-function-shape! index own-directive)))
          (let [value (parse-syntax-assignment)
                fp2 (syntax-fun-ptr index)]
            (parser-pop-context!)
            (set! (.expression-body fp2) (Some value))
            (set! (.hi fp2) (syntax-hi value))
            (syntax-check-function-shape! index false)))
      (let [f (syntax-fun-at index)]
        (syntax-add-node! (SxFunction index) lo (.hi f))))))

;; MethodDefinition inside an object literal: `key(…) {…}`, `get key() {…}`, `set key(v) {…}`,
;; `*key(…)`, `async key(…)`, `async *key(…)`.
(defn parse-syntax-method! [(key PropKey)
                            (name (slice u8))
                            (kind FunKind)
                            (generator bool)
                            (async bool)
                            (lo i64)] (-> ObjectEntry)
  (let [index (syntax-fun-reserve! name kind generator async lo)]
    (parse-syntax-function-rest! index kind generator async false)
    (PropMethod key index)))

;; Strictness is settled after parsing: a function is strict when its own prologue says so, when
;; its enclosing function is, or when the Script is. Parents precede children in the table.
(defn syntax-settle-strictness! [] (-> i64)
  (let [p (parser-state)
        script-strict
          (if (.script-mode p)
              (let [root (syntax-fun-at (.script-index p))]
                (syntax-body-strict? (.body root)))
              false)
        (mut i) 0]
    (loop (if (>= (load i) (len (.funs p)))
              (break 0)
              (let [fp (syntax-fun-ptr (load i))
                    own (syntax-body-strict? (.body fp))
                    inherited
                      (if (< (.parent fp) 0)
                          false
                          (syntax-fun-strict (.parent fp)))]
                ;; A built-in (an intrinsic wrapper) is strict whatever the Script is: it receives
                ;; `this` as passed (ECMA-262 §10.3).
                (set! (.strict fp)
                      (or script-strict
                          own
                          inherited
                          (.in-class fp)
                          (syntax-intrinsic-fun? (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

;; Whether a statement list declares a nested function anywhere, which lowering cannot yet
;; instantiate as a binding.
(defn syntax-contains-function-decl? [(stmts (ArrayList i64))] (-> bool)
  (let [(mut found) false]
    (al-for [id stmts]
            (let [(mut children) (al-new [i64] (compiler-allocator))]
              (match (syntax-stmt-node id)
                (SsFunctionDecl [fun]
                                (let [f (syntax-fun-at fun)]
                                  (if (not (.hoisted f))
                                      (set! (mut found) true)
                                      0)))
                (_ 0))
              (syntax-stmt-children! id (mut children))
              (if (syntax-contains-function-decl? (load children))
                  (set! (mut found) true)
                  0)
              (al-free! [i64] (mut children))))
    (load found)))

(defn syntax-class-hi [(cls i64)] (-> i64)
  (let [c (get (.classes (parser-state)) cls)] (.hi c)))

;; `#name` must be one token pair with no space, never `#constructor`, and only inside a class.
;; Every reference is recorded for resolution when the declaring class closes.
(defn parse-syntax-private-name! [(hash Token)] (-> Token)
  (let [name (take-token)]
    (if (or (!= (.kind name) TOK-IDENT) (!= (.start name) (.end hash)))
        (syntax-error! "parser: expected a private name immediately after #")
        0)
    (if (= (token-text name) "constructor")
        (syntax-error! "parser: #constructor is not a valid private name")
        0)
    (if (= (.class-depth (parser-state)) 0)
        (syntax-error! "parser: private name used outside a class body")
        0)
    (let [(mut ref) (primitive/zeroed PrivateRef)]
      (set! (.name (mut ref)) (token-text name))
      (set! (.depth (mut ref)) (.class-depth (parser-state)))
      (push! [PrivateRef] (mut (.private-refs (parser-state))) (load ref)))
    name))

;; `#name in expr`: the private name is only ever the left operand of `in`.
(defn parse-syntax-private-in [(hash Token)] (-> i64)
  (let [name (parse-syntax-private-name! hash)]
    (if (or (not (token-is (peek-token) "in")) (.no-in (parser-state)))
        (syntax-error! "parser: a private name can only be tested with `in`")
        0)
    (syntax-add-node! (SxPrivateName (token-text name))
                      (.start hash)
                      (.end name))))

(defn syntax-declare-private! [(decls (mut (ArrayList PrivateDecl)))
                               (name (slice u8))
                               (is-static bool)
                               (getter bool)
                               (setter bool)] (-> i64)
  (let [(mut index) -1
        (mut i) 0]
    (loop (if (>= (load i) (len (load decls)))
              (break 0)
              (let [d (get (load decls) (load i))]
                (if (= (.name d) name) (set! (mut index) (load i)) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (< (load index) 0)
        (let [(mut d) (primitive/zeroed PrivateDecl)]
          (set! (.name (mut d)) name)
          (set! (.static (mut d)) is-static)
          (set! (.getter (mut d)) getter)
          (set! (.setter (mut d)) setter)
          (push! [PrivateDecl] (mut decls) (load d)))
        (let [d (al-elem [PrivateDecl] (mut decls) (load index))]
          ;; The only permitted duplicate is one getter plus one setter of the same staticness.
          (if (and (= (.static d) is-static)
                   (or (and getter (.setter d) (not (.getter d)))
                       (and setter (.getter d) (not (.setter d)))))
              (do (set! (.getter d) true) (set! (.setter d) true) 0)
              (syntax-error! "parser: duplicate private name"))))))

;; ClassElementName plus what the element rules need to know about its spelling.
(defstruct ParsedClassKey
  [(key ClassKey)
   (name (slice u8))
   (private bool)
   (computed bool)
   (lo i64)])

(defn parse-syntax-class-key! [] (-> ParsedClassKey)
  (let [(mut k) (primitive/zeroed ParsedClassKey)
        t (peek-token)]
    (set! (.lo (mut k)) (.start t))
    (if (token-is t "#")
        (let [name (parse-syntax-private-name! (take-token))]
          (set! (.key (mut k)) (CkPrivate (token-text name)))
          (set! (.name (mut k)) (token-text name))
          (set! (.private (mut k)) true))
        (if (token-is t "[")
            (let [saved-no-in (.no-in (parser-state))]
              (take-token)
              (set! (.no-in (parser-state)) false)
              (let [expr (parse-syntax-assignment)]
                (set! (.no-in (parser-state)) saved-no-in)
                (require-closing! "]"
                                  "parser: expected `]` after computed class element name")
                (set! (.key (mut k)) (CkComputed expr))
                (set! (.name (mut k)) "")
                (set! (.computed (mut k)) true)))
            (if (not (token-property-name? t))
                (do (syntax-error! "parser: expected a class element name") 0)
                (let [key-token (take-token)
                      name (syntax-property-key-name key-token)]
                  (set! (.key (mut k)) (CkNamed name))
                  (set! (.name (mut k)) name)))))
    (load k)))

(defn token-class-element-start? [(t Token)] (-> bool)
  (or (token-property-name? t) (token-is t "*")))

;; One ClassElement. `static` is a modifier unless it is itself the element name (`static(){}`,
;; `static = 1`, `static;`); `static {` opens a static block. `get`/`set`/`async`/`*` prefix a
;; method when a ClassElementName follows (no line terminator after `async`).
(defn parse-syntax-class-element! [(elements (mut (ArrayList ClassElement)))
                                   (privates (mut (ArrayList PrivateDecl)))
                                   (derived bool)
                                   (constructors (mut i64))] (-> i64)
  (let [first (peek-token)
        second (lex-peek-second false)
        is-static
          (and (token-is first "static")
               (= (.kind first) TOK-IDENT)
               (not (or (token-is second "(")
                        (token-is second "=")
                        (token-is second ";")
                        (token-is second "}"))))]
    (if is-static (do (take-token) 0) 0)
    (if (and is-static (token-is (peek-token) "{"))
        ;; ClassStaticBlock: a method-like body that may not `return`, use `await` or `arguments`.
        (let [open (take-token)
              index
                (syntax-fun-reserve! "static"
                                     (FunMethod)
                                     false
                                     false
                                     (.start first))]
          (parser-push-context! index false false false true)
          (parser-mark-top-context! false true false)
          (parser-set-in-params! false)
          (let [body (parse-syntax-statement-list)
                close (require-token "}")
                fp (syntax-fun-ptr index)]
            (parser-pop-context!)
            (set! (.body fp) body)
            (set! (.hi fp) (.end close))
            (push! [ClassElement] (mut elements) (CeStaticBlock index))
            0))
        (let [t (peek-token)
              next (lex-peek-second false)
              generator (token-is t "*")
              prefix
                (and (not generator)
                     (= (.kind t) TOK-IDENT)
                     (or (token-is t "get")
                         (token-is t "set")
                         (token-is t "async"))
                     (token-class-element-start? next)
                     (not (and (token-is t "async") (.nl-before next))))
              async (and prefix (token-is t "async"))
              getter (and prefix (token-is t "get"))
              setter (and prefix (token-is t "set"))]
          (if (or generator prefix) (do (take-token) 0) 0)
          (let [async-generator (and async (take-is "*"))
                k (parse-syntax-class-key!)
                after (peek-token)
                special (or generator prefix async-generator)]
            (if (token-is after "(")
                (let [constructor
                        (and (not is-static)
                             (not (.private k))
                             (not (.computed k))
                             (= (.name k) "constructor"))
                      kind
                        (if getter
                            (FunGetter)
                            (if setter (FunSetter) (FunMethod)))]
                  (if constructor
                      (do
                        (if special
                            (syntax-error! "parser: constructor cannot be a getter, setter, generator or async method")
                            0)
                        (if (> (load constructors) 0)
                            (syntax-error! "parser: duplicate constructor")
                            0)
                        (set! constructors (+ (load constructors) 1)))
                      0)
                  (if (and is-static
                           (not (.computed k))
                           (not (.private k))
                           (= (.name k) "prototype"))
                      (syntax-error! "parser: static method cannot be named prototype")
                      0)
                  (if (.private k)
                      (syntax-declare-private! (mut privates)
                                               (.name k)
                                               is-static
                                               getter
                                               setter)
                      0)
                  (let [index
                          (syntax-fun-reserve! (.name k)
                                               kind
                                               (or generator async-generator)
                                               async
                                               (.lo k))]
                    (parse-syntax-function-rest! index
                                                 kind
                                                 (or generator async-generator)
                                                 async
                                                 (and constructor derived))
                    (push! [ClassElement]
                           (mut elements)
                           (CeMethod
                             :key (.key k)
                             :static is-static
                             :fun index))
                    0))
                (do
                  (if special
                      (syntax-error! "parser: expected a method after get, set, async or *")
                      0)
                  (if (and (not (.computed k))
                           (not (.private k))
                           (= (.name k) "constructor"))
                      (syntax-error! "parser: a class field cannot be named constructor")
                      0)
                  (if (and is-static
                           (not (.computed k))
                           (not (.private k))
                           (= (.name k) "prototype"))
                      (syntax-error! "parser: a static class field cannot be named prototype")
                      0)
                  (if (.private k)
                      (syntax-declare-private! (mut privates)
                                               (.name k)
                                               is-static
                                               false
                                               false)
                      0)
                  (let [init
                          (if (take-is "=")
                              (let [index
                                      (syntax-fun-reserve! (.name k)
                                                           (FunMethod)
                                                           false
                                                           false
                                                           (.lo k))]
                                (parser-push-context! index
                                                      false
                                                      false
                                                      false
                                                      true)
                                (parser-mark-top-context! true false false)
                                (parser-set-in-params! false)
                                (let [value (parse-syntax-assignment)
                                      fp (syntax-fun-ptr index)]
                                  (parser-pop-context!)
                                  (set! (.expression-body fp) (Some value))
                                  (set! (.hi fp) (syntax-hi value))
                                  (Some index)))
                              (None [i64]))
                        end (peek-token)]
                    ;; A field ends at `;`, `}` or a line terminator.
                    (if (take-is ";")
                        0
                        (if (or (token-is end "}") (.nl-before end))
                            0
                            (syntax-error! "parser: expected `;` after class field")))
                    (push! [ClassElement]
                           (mut elements)
                           (CeField
                             :key (.key k)
                             :static is-static
                             :init-fun init))
                    0))))))))

;; ClassDeclaration / ClassExpression. Class code is strict; the name follows strict binding
;; rules. The heritage is a LeftHandSideExpression. Private references recorded inside resolve
;; against this class's declarations; unresolved ones belong to an enclosing class or are errors.
;; ClassHeritage is a LeftHandSideExpression. The parenthesized cover grammar can still yield an
;; arrow function here, which is an AssignmentExpression and therefore a proven error.
(defn parse-syntax-class-heritage [] (-> i64)
  (let [heritage (parse-syntax-lhs)]
    (match (syntax-node heritage)
      (SxFunction [fun]
                  (let [f (syntax-fun-at fun)]
                    (match (.kind f)
                      (FunArrow []
                                (syntax-error! "parser: class heritage must be a LeftHandSideExpression"))
                      (_ 0))))
      (_ 0))
    heritage))

(defn parse-syntax-class [(keyword Token) (declaration bool)] (-> i64)
  (set! (.class-strict (parser-state)) (+ (.class-strict (parser-state)) 1))
  (let [p (parser-state)
        lead (peek-token)
        name
          (if (or declaration (= (.kind lead) TOK-IDENT) (token-is lead "let"))
              (let [t (take-token)]
                (if (!= (.kind t) TOK-IDENT)
                    (do
                      (syntax-error! "parser: reserved word cannot be a class name")
                      0)
                    (do
                      (syntax-strict-binding! (token-text t))
                      (syntax-check-binding-name! (token-text t))))
                (token-text t))
              "")
        heritage
          (if (take-is "extends")
              (Some (parse-syntax-class-heritage))
              (None [i64]))
        derived (match heritage (Some [h] true) (None [] false))
        (mut elements) (al-new [ClassElement] (compiler-allocator))
        (mut privates) (al-new [PrivateDecl] (compiler-allocator))
        (mut constructors) 0]
    (set! (.class-depth p) (+ (.class-depth p) 1))
    (require-closing! "{" "parser: expected a class body")
    (loop (if (token-is (peek-token) "}")
              (break 0)
              (if (take-is ";")
                  (continue)
                  (do
                    (parse-syntax-class-element! (mut elements)
                                                 (mut privates)
                                                 derived
                                                 (mut constructors))
                    (continue)))))
    (let [close (require-token "}")
          depth (.class-depth p)
          (mut remaining) (al-new [PrivateRef] (compiler-allocator))]
      ;; Resolve this class's private references; pass unresolved ones to the enclosing class.
      (al-for [ref (.private-refs p)]
              (let [r ref]
                (if (< (.depth r) depth)
                    (push! [PrivateRef] (mut remaining) r)
                    (let [(mut declared) false]
                      (al-for [entry (load privates)]
                              (let [d entry]
                                (if (= (.name d) (.name r))
                                    (set! (mut declared) true)
                                    0)))
                      (if (load declared)
                          0
                          (if (= depth 1)
                              (syntax-error! "parser: reference to an undeclared private name")
                              (let [(mut outer) (primitive/zeroed PrivateRef)]
                                (set! (.name (mut outer)) (.name r))
                                (set! (.depth (mut outer)) (- depth 1))
                                (push! [PrivateRef]
                                       (mut remaining)
                                       (load outer)))))))))
      (al-clear! [PrivateRef] (mut (.private-refs p)))
      (al-for [r (load remaining)]
              (push! [PrivateRef] (mut (.private-refs p)) r))
      (al-free! [PrivateRef] (mut remaining))
      (al-free! [PrivateDecl] (mut privates))
      (set! (.class-depth p) (- depth 1))
      (set! (.class-strict p) (- (.class-strict p) 1))
      ;; The heritage and computed keys are strict code outside any method body.
      (match heritage (Some [h] (syntax-check-strict-expr! h)) (None [] 0))
      (al-for [element (load elements)]
              (let [key
                      (match element
                        (CeMethod [key is-static fun] key)
                        (CeField [key is-static init-fun] key)
                        (CeStaticBlock [fun] (CkNamed "")))]
                (match key (CkComputed [e] (syntax-check-strict-expr! e)) (_ 0))))
      (let [(mut c) (primitive/zeroed SyntaxClass)
            index (len (.classes p))
            ;; ClassDefinitionEvaluation synthesizes an empty constructor for a class body without
            ;; one (§15.7.14 step 10); a derived class's default forwards its arguments (§15.7.14).
            ctor
              (syntax-class-constructor-record! (load elements)
                                                name
                                                (.start keyword)
                                                derived
                                                index)]
        (set! (.ctor (mut c)) ctor)
        (set! (.name (mut c)) name)
        (set! (.heritage (mut c)) heritage)
        (set! (.elements (mut c)) (load elements))
        (set! (.lo (mut c)) (.start keyword))
        (set! (.hi (mut c)) (.end close))
        (push! [SyntaxClass] (mut (.classes p)) (load c))
        index))))

(defn syntax-fun-at [(i i64)] (-> SyntaxFun)
  (get (.funs (parser-state)) i))

;; The raw spelling of a string-literal expression statement, or None for any other statement.
(defn syntax-directive-text [(stmt-id i64)] (-> (Option (slice u8)))
  (match (syntax-stmt-node stmt-id)
    (SsExpr [expr]
            (match (syntax-node expr)
              (SxString [raw units legacy] (Some raw))
              (_ (None [(slice u8)]))))
    (_ (None [(slice u8)]))))

;; Simple has no strict-mode counterpart. ECMAScript directive prologues are local to Script or
;; FunctionBody: grouped strings, blocks and strings after a non-directive do not opt in. Script
;; strictness is inherited by its source functions, never from a sibling function's directive.
(defn syntax-body-strict? [(body (ArrayList i64))] (-> bool)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len body))
              (break false)
              (match (syntax-directive-text (get body (load i)))
                (Some [raw]
                      (if (= raw "use strict")
                          (break true)
                          (do (set! (mut i) (+ (load i) 1)) (continue))))
                (None [] (break false)))))))

(defn syntax-check-directives! [(body (ArrayList i64))] (-> i64)
  (if (syntax-body-strict? body)
      (do (set! (.strict-pending (parser-state)) true) 0)
      0))

(defn syntax-strict-reserved? [(name (slice u8))] (-> bool)
  (or (= name "implements")
      (= name "interface")
      (= name "let")
      (= name "package")
      (= name "private")
      (= name "protected")
      (= name "public")
      (= name "static")
      (= name "yield")))

(defn syntax-strict-binding! [(name (slice u8))] (-> i64)
  (if (or (= name "eval") (= name "arguments") (syntax-strict-reserved? name))
      (syntax-error! "parser: invalid strict-mode binding name")
      0))

;; Strict AssignmentTargetType: `eval`/`arguments` cannot be assigned, and a CallExpression
;; target is an early error rather than the sloppy runtime ReferenceError.
(defn syntax-check-strict-target! [(target i64)] (-> i64)
  (match (syntax-node target)
    (SxName [name] (syntax-strict-binding! name))
    (SxCall [callee args optional]
            (syntax-error! "parser: call expression is not a valid assignment target in strict code"))
    (_ 0)))

;; Inspect syntax rather than lowered values: unreachable code still has early errors and
;; property IdentifierNames are not IdentifierReferences.
(defn syntax-check-strict-expr! [(id i64)] (-> i64)
  (let [x (syntax-at id)
        (mut children) (al-new [i64] (compiler-allocator))]
    (match (.node x)
      (SxAssign [target value] (syntax-check-strict-target! target))
      (SxDestructuringAssign [pattern value]
                             (syntax-strict-pattern-names! pattern))
      (SxCompoundAssign [op target value] (syntax-check-strict-target! target))
      (SxLogicalAssign [predicate rhs-on-true target value]
                       (syntax-check-strict-target! target))
      (SxUpdate [op prefix target] (syntax-check-strict-target! target))
      (SxString [raw units legacy]
                (if legacy
                    (syntax-error! "parser: legacy string escape in strict code")
                    0))
      (SxName [name]
              (if (syntax-strict-reserved? name)
                  (syntax-error! "parser: reserved identifier in strict code")
                  0))
      (SxDelete [operand]
                (if (syntax-name? (syntax-ungroup-id operand))
                    (syntax-error! "parser: delete of an unqualified identifier in strict code")
                    0))
      (SxNumber [value value-float rep]
                (let [text (subslice [u8] (lex-source) (.lo x) (.hi x))]
                  (if (and (> (len text) 1)
                           (= (get text 0) (cast u8 48))
                           (lex-digit? (get text 1)))
                      (syntax-error! "parser: legacy numeric literal in strict code")
                      0)))
      (_ 0))
    (syntax-expr-children! id (mut children))
    (al-for [child (load children)] (syntax-check-strict-expr! child))
    (al-free! [i64] (mut children))
    0))

(defn syntax-strict-pattern-names! [(pattern i64)] (-> i64)
  (do
    (match (syntax-pattern-node pattern)
      (PatName [name] (syntax-strict-binding! name))
      (PatTarget [expr] (syntax-check-strict-target! (syntax-ungroup-id expr)))
      (PatObject [props rest]
                 (do
                   (al-for [prop props]
                           (let [pp prop]
                             (syntax-strict-pattern-names! (.pattern pp))))
                   (match rest
                     (Some [r] (syntax-strict-pattern-names! r))
                     (None [] 0))))
      (PatArray [elements rest]
                (do
                  (al-for [element elements]
                          (match element
                            (PatItem [pat] (syntax-strict-pattern-names! pat))
                            (PatHole [] 0)))
                  (match rest
                    (Some [r] (syntax-strict-pattern-names! r))
                    (None [] 0)))))
    0))

(defn syntax-check-strict-statements! [(stmts (ArrayList i64))] (-> i64)
  (do
    (al-for [id stmts]
            (let [(mut exprs) (al-new [i64] (compiler-allocator))
                  (mut children) (al-new [i64] (compiler-allocator))]
              (match (syntax-stmt-node id)
                (SsLet [name init final annotation]
                       (syntax-strict-binding! name))
                (SsVar [name init annotation] (syntax-strict-binding! name))
                (SsLetPattern [pattern init final]
                              (syntax-strict-pattern-names! pattern))
                (SsVarPattern [pattern init]
                              (syntax-strict-pattern-names! pattern))
                (SsWith [object body]
                        (syntax-error! "parser: with statement is not allowed in strict code"))
                (SsLabeled [label body]
                           (do
                             (if (syntax-strict-reserved? label)
                                 (syntax-error! "parser: reserved identifier in strict code")
                                 0)
                             (if (syntax-labelled-function? id)
                                 (syntax-error! "parser: labelled function declaration in strict code")
                                 0)))
                (SsBlock [body]
                         (if (syntax-annexb-block? id)
                             (syntax-error! "parser: function declaration in an if clause in strict code")
                             0))
                (SsTry [body catch-param catch-body finally-body]
                       (match catch-param
                         (Some [pat] (syntax-strict-pattern-names! pat))
                         (None [] 0)))
                (SsForIn [head of right body awaited]
                         (match head
                           (ForInitPattern [pat]
                                           (syntax-strict-pattern-names! pat))
                           (ForInitDecl [stmt]
                                        (match (syntax-stmt-node stmt)
                                          (SsVar [name init annotation]
                                                 (match init
                                                   (Some [e]
                                                         (syntax-error! "parser: for-in var initializer in strict code"))
                                                   (None [] 0)))
                                          (_ 0)))
                           (_ 0)))
                (_ 0))
              (syntax-stmt-exprs! id (mut exprs))
              (al-for [e (load exprs)] (syntax-check-strict-expr! e))
              (syntax-stmt-children! id (mut children))
              (syntax-check-strict-statements! (load children))
              (al-free! [i64] (mut exprs))
              (al-free! [i64] (mut children))))
    0))

(defn syntax-check-strict-functions! [] (-> i64)
  (let [p (parser-state)]
    (al-for [entry (.funs p)]
            (let [fun entry]
              (if (.strict fun)
                  (do
                    ;; Only declarations and named expressions bind their name; a method, accessor,
                    ;; field initializer or static block name is a property key.
                    (match (.kind fun)
                      (FunDeclaration [] (syntax-strict-binding! (.name fun)))
                      (FunExpression [] (syntax-strict-binding! (.name fun)))
                      (_ 0))
                    (let [(mut bound) (syntax-fun-bound-names fun)]
                      (al-for [name (load bound)] (syntax-strict-binding! name))
                      (al-free! [(slice u8)] (mut bound)))
                    (match (.expression-body fun)
                      (Some [e] (syntax-check-strict-expr! e))
                      (None [] 0))
                    (al-for [d (.param-defaults fun)]
                            (match d
                              (Some [e] (syntax-check-strict-expr! e))
                              (None [] 0)))
                    (let [(mut bound) (syntax-fun-bound-names fun)
                          (mut i) 0]
                      (loop (if (>= (load i) (len (load bound)))
                                (break 0)
                                (let [name (get (load bound) (load i))
                                      (mut j) (+ (load i) 1)]
                                  (loop (if (>= (load j) (len (load bound)))
                                            (break 0)
                                            (do
                                              (if (= name
                                                     (get (load bound) (load j)))
                                                  (syntax-error! "parser: duplicate strict-mode parameter")
                                                  0)
                                              (set! (mut j) (+ (load j) 1))
                                              (continue))))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))
                      (al-free! [(slice u8)] (mut bound)))
                    (syntax-check-strict-statements! (.body fun)))
                  0)))
    0))

;; `{a = 1}` is only valid when the object literal is reinterpreted as an assignment pattern.
;; Reinterpreted literals are marked consumed, so any surviving CoverInitializedName is a proven
;; SyntaxError.
(defn syntax-check-cover-initializers! [] (-> i64)
  (do
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.exprs (parser-state))))
                (break 0)
                (let [expr (get (.exprs (parser-state)) (load i))]
                  (match (.node expr)
                    (SxObject [entries]
                              (if (syntax-cover-consumed? (+ (load i) 1))
                                  0
                                  (do
                                    (al-for [entry entries]
                                            (match entry
                                              (PropCoverInit [name init]
                                                             (syntax-error! "parser: invalid shorthand property initializer"))
                                              (_ 0)))
                                    0)))
                    (_ 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    0))

(defn parser-source-entry-index [] (-> i64)
  (if (.script-mode (parser-state))
      (.script-index (parser-state))
      (syntax-find-fun "main")))

(defn syntax-direct-lexical? [(stmts (ArrayList i64)) (name (slice u8))] (-> bool)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len stmts))
              (break false)
              (let [found
                      (match (syntax-stmt-node (get stmts (load i)))
                        (SsLet [declared init final annotation]
                               (= declared name))
                        (SsLetPattern [pattern init final]
                                      (let [(mut names)
                                              (al-new [(slice u8)]
                                                      (compiler-allocator))]
                                        (syntax-pattern-names! pattern
                                                               (mut names))
                                        (let [hit
                                                (syntax-labels-contain? (load names)
                                                                        name)]
                                          (al-free! [(slice u8)] (mut names))
                                          hit)))
                        (SsDeclList [decls] (syntax-direct-lexical? decls name))
                        (SsClassDecl [cls]
                                     (let [c (get (.classes (parser-state)) cls)]
                                       (= (.name c) name)))
                        (_ false))]
                (if found
                    (break true)
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn syntax-script-binding? [(name (slice u8))] (-> bool)
  (if (not (.script-mode (parser-state)))
      false
      (let [root (syntax-fun-at (.script-index (parser-state)))]
        (syntax-direct-lexical? (.body root) name))))

;; Syntax-only BoundNames collection. VarDeclaredNames crosses blocks/branches; lexical names
;; cross only declaration-list grouping and the shared switch CaseBlock. Function bodies live in
;; separate SyntaxFun records and must not be traversed as part of an enclosing declaration set.
;; A FunctionDeclaration is var-like at the top level of a function body (TopLevelVarDeclaredNames)
;; and lexical inside a Block or CaseBlock. Top-level Script functions are hoisted Funs, not
;; bindings this collector reports. `top` is true only for the function body's own list.
(defn syntax-collect-declarations! [(stmts (ArrayList i64))
                                    (lexical bool)
                                    (names (mut (ArrayList (slice u8))))] (-> i64)
  (syntax-collect-declarations-at! stmts lexical false (mut names)))

(defn syntax-function-decl-names! [(stmts (ArrayList i64))
                                   (names (mut (ArrayList (slice u8))))] (-> i64)
  (do
    (al-for [id stmts]
            (match (syntax-stmt-node id)
              (SsFunctionDecl [fun]
                              (let [f (syntax-fun-at fun)]
                                (push! [(slice u8)] (mut names) (.name f))))
              (_ 0)))
    0))

(defn syntax-collect-declarations-at! [(stmts (ArrayList i64))
                                       (lexical bool)
                                       (top bool)
                                       (names (mut (ArrayList (slice u8))))] (-> i64)
  (do
    (al-for [id stmts]
            (let [(mut children) (al-new [i64] (compiler-allocator))
                  grouping
                    (match (syntax-stmt-node id)
                      (SsClassDecl [cls]
                                   (do
                                     (if lexical
                                         (let [c
                                                 (get (.classes (parser-state))
                                                      cls)]
                                           (push! [(slice u8)]
                                                  (mut names)
                                                  (.name c)))
                                         0)
                                     false))
                      (SsFunctionDecl [fun]
                                      (let [f (syntax-fun-at fun)]
                                        (if (not (.hoisted f))
                                            (if (= lexical (not top))
                                                (push! [(slice u8)]
                                                       (mut names)
                                                       (.name f))
                                                0)
                                            0)
                                        false))
                      (SsLet [name init final annotation]
                             (do
                               (if lexical
                                   (push! [(slice u8)] (mut names) name)
                                   0)
                               false))
                      (SsVar [name init annotation]
                             (do
                               (if lexical
                                   0
                                   (push! [(slice u8)] (mut names) name))
                               false))
                      (SsLetPattern [pattern init final]
                                    (do
                                      (if lexical
                                          (syntax-pattern-names! pattern
                                                                 (mut names))
                                          0)
                                      false))
                      (SsVarPattern [pattern init]
                                    (do
                                      (if lexical
                                          0
                                          (syntax-pattern-names! pattern
                                                                 (mut names)))
                                      false))
                      (SsDeclList [decls] true)
                      (SsCase [selector body] true)
                      (_ false))]
              (if (or (not lexical) grouping)
                  (do
                    (syntax-stmt-children! id (mut children))
                    (syntax-collect-declarations-at! (load children)
                                                     lexical
                                                     (and top grouping)
                                                     (mut names)))
                  0)
              (al-free! [i64] (mut children))))
    0))

;; Early errors are checked before graph construction, including unreachable nested blocks.
;; This is declaration-name validation, not a second semantic environment or SSA pass.
;; `top` marks a function body's own statement list, where function declarations are var-like.
;; Sloppy code tolerates duplicate FunctionDeclarations in a Block (Annex B.3.2.4); everything
;; else duplicated is an error.
(defn syntax-check-declarations! [(stmts (ArrayList i64))
                                  (parameters (ArrayList (slice u8)))
                                  (lexical-scope bool)
                                  (top bool)
                                  (strict bool)] (-> i64)
  (do
    (if lexical-scope
        (let [(mut names) (al-new [(slice u8)] (compiler-allocator))
              (mut vars) (al-new [(slice u8)] (compiler-allocator))
              (mut functions) (al-new [(slice u8)] (compiler-allocator))
              (mut i) 0]
          (syntax-collect-declarations-at! stmts true top (mut names))
          (syntax-collect-declarations-at! stmts false top (mut vars))
          (if top 0 (syntax-function-decl-names! stmts (mut functions)))
          (loop (if (>= (load i) (len (load names)))
                    (break 0)
                    (let [name (get (load names) (load i))
                          (mut j) (+ (load i) 1)]
                      (loop (if (>= (load j) (len (load names)))
                                (break 0)
                                (do
                                  (if (and (= name (get (load names) (load j)))
                                           (not (and (not strict)
                                                     (syntax-labels-contain? (load functions)
                                                                             name)
                                                     (syntax-all-plain-functions? stmts
                                                                                  name))))
                                      (syntax-error! "parser: duplicate lexical declaration")
                                      0)
                                  (set! (mut j) (+ (load j) 1))
                                  (continue))))
                      (al-for [var-name (load vars)]
                              (if (= name var-name)
                                  (syntax-error! "parser: lexical declaration conflicts with var declaration")
                                  0))
                      (al-for [parameter parameters]
                              (if (= name parameter)
                                  (syntax-error! "parser: lexical declaration conflicts with parameter")
                                  0))
                      (set! (mut i) (+ (load i) 1))
                      (continue)))))
        0)
    (let [empty (al-new [(slice u8)] (compiler-allocator))]
      (al-for [id stmts]
              (let [(mut children) (al-new [i64] (compiler-allocator))
                    ;; A for head is its own lexical scope containing the body, so a head `let`
                    ;; conflicts with the body's VarDeclaredNames and with itself.
                    scope
                      (match (syntax-stmt-node id)
                        (SsBlock [body] true)
                        (SsSwitch [discriminant cases] true)
                        (SsFor [init test update body] true)
                        (SsForIn [head of right body awaited] true)
                        (_ false))]
                (match (syntax-stmt-node id)
                  (SsTry [body catch-param catch-body finally-body]
                         (syntax-check-catch-parameter! catch-param catch-body))
                  (_ 0))
                (syntax-stmt-children! id (mut children))
                (syntax-check-declarations! (load children)
                                            empty
                                            scope
                                            false
                                            strict)
                (al-free! [i64] (mut children)))))
    0))

;; Annex B.3.2.4 tolerates duplicate FunctionDeclarations in a sloppy Block only when every
;; declaration of the name there is a plain (non-generator, non-async) function declaration.
(defn syntax-all-plain-functions? [(stmts (ArrayList i64)) (name (slice u8))] (-> bool)
  (let [(mut ok) true]
    (al-for [id stmts]
            (match (syntax-stmt-node id)
              (SsFunctionDecl [fun]
                              (let [f (syntax-fun-at fun)]
                                (if (and (= (.name f) name)
                                         (or (.generator f) (.async f)))
                                    (set! (mut ok) false)
                                    0)))
              (SsClassDecl [cls]
                           (let [c (get (.classes (parser-state)) cls)]
                             (if (= (.name c) name) (set! (mut ok) false) 0)))
              (SsLet [declared init final annotation]
                     (if (= declared name) (set! (mut ok) false) 0))
              (SsLetPattern [pattern init final] (set! (mut ok) false))
              (SsDeclList [decls]
                          (do
                            (al-for [d decls]
                                    (match (syntax-stmt-node d)
                                      (SsLet [declared init final annotation]
                                             (if (= declared name)
                                                 (set! (mut ok) false)
                                                 0))
                                      (SsLetPattern [pattern init final]
                                                    (set! (mut ok) false))
                                      (_ 0)))
                            0))
              (_ 0)))
    (load ok)))

;; The CatchParameter shares a scope with the catch Block's lexical declarations; a `var` of the
;; same name is permitted by Annex B.
(defn syntax-check-catch-parameter! [(param (Option i64))
                                     (catch-body (Option i64))] (-> i64)
  (match param
    (None [] 0)
    (Some [pattern]
          (let [(mut bound) (al-new [(slice u8)] (compiler-allocator))]
            (syntax-pattern-names! pattern (mut bound))
            ;; A destructuring catch parameter cannot repeat a name.
            (let [(mut i) 0]
              (loop (if (>= (load i) (len (load bound)))
                        (break 0)
                        (let [name (get (load bound) (load i))
                              (mut j) (+ (load i) 1)]
                          (loop (if (>= (load j) (len (load bound)))
                                    (break 0)
                                    (do
                                      (if (= name (get (load bound) (load j)))
                                          (syntax-error! "parser: duplicate catch parameter name")
                                          0)
                                      (set! (mut j) (+ (load j) 1))
                                      (continue))))
                          (set! (mut i) (+ (load i) 1))
                          (continue)))))
            (match catch-body
              (None [] 0)
              (Some [block]
                    (match (syntax-stmt-node block)
                      (SsBlock [body]
                               (let [(mut names)
                                       (al-new [(slice u8)]
                                               (compiler-allocator))]
                                 (syntax-collect-declarations! body
                                                               true
                                                               (mut names))
                                 (al-for [declared (load names)]
                                         (al-for [name (load bound)]
                                                 (if (= declared name)
                                                     (syntax-error! "parser: catch parameter conflicts with a lexical declaration")
                                                     0)))
                                 (al-free! [(slice u8)] (mut names))
                                 0))
                      (_ 0))))))))

(defn syntax-iteration-stmt? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsWhile [condition body] true)
    (SsDoWhile [body condition] true)
    (SsFor [init test update body] true)
    (SsForIn [head of right body awaited] true)
    (_ false)))

;; `a: b: while (…)` names the loop by both labels; only such labels are `continue` targets.
(defn syntax-labeled-iteration? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsLabeled [label body] (syntax-labeled-iteration? body))
    (_ (syntax-iteration-stmt? id))))

(defn syntax-labels-contain? [(labels (ArrayList (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (al-for [label labels] (if (= label name) (set! (mut found) true) 0))
    (load found)))

(defn syntax-check-jump-label! [(label (Option (slice u8)))
                                (labels (ArrayList (slice u8)))
                                (depth i64)
                                (unlabelled (slice u8))
                                (unknown (slice u8))] (-> i64)
  (match label
    (None [] (if (= depth 0) (syntax-error! unlabelled) 0))
    (Some [name]
          (if (syntax-labels-contain? labels name) 0 (syntax-error! unknown)))))

;; Early errors for break/continue/labels. `labels` is the enclosing label set, `loop-labels`
;; the subset naming an iteration statement; `breakable` and `loops` count enclosing targets for
;; the unlabelled forms. Labels are function-local; each SyntaxFun body starts empty.
(defn syntax-check-jumps! [(stmts (ArrayList i64))
                           (labels (mut (ArrayList (slice u8))))
                           (loop-labels (mut (ArrayList (slice u8))))
                           (breakable i64)
                           (loops i64)] (-> i64)
  (do
    (al-for [id stmts]
            (let [(mut children) (al-new [i64] (compiler-allocator))
                  handled
                    (match (syntax-stmt-node id)
                      (SsLabeled [label body]
                                 (let [iteration
                                         (syntax-labeled-iteration? body)]
                                   (if (syntax-labels-contain? (load labels)
                                                               label)
                                       (syntax-error! "parser: duplicate label")
                                       0)
                                   (push! [(slice u8)] (mut labels) label)
                                   (if iteration
                                       (push! [(slice u8)]
                                              (mut loop-labels)
                                              label)
                                       0)
                                   (push! [i64] (mut children) body)
                                   (syntax-check-jumps! (load children)
                                                        (mut labels)
                                                        (mut loop-labels)
                                                        breakable
                                                        loops)
                                   (pop! (mut labels))
                                   (if iteration
                                       (do (pop! (mut loop-labels)) 0)
                                       0)
                                   true))
                      (SsBreak [label]
                               (do
                                 (syntax-check-jump-label! label
                                                           (load labels)
                                                           breakable
                                                           "parser: break has no enclosing breakable statement"
                                                           "parser: break names an undefined label")
                                 true))
                      (SsContinue [label]
                                  (do
                                    (syntax-check-jump-label! label
                                                              (load loop-labels)
                                                              loops
                                                              "parser: continue has no enclosing iteration statement"
                                                              "parser: continue names a label that is not an enclosing iteration statement")
                                    true))
                      (_ false))
                  loop (syntax-iteration-stmt? id)
                  switch
                    (match (syntax-stmt-node id)
                      (SsSwitch [discriminant cases] true)
                      (_ false))]
              (if handled
                  0
                  (do
                    (syntax-stmt-children! id (mut children))
                    (syntax-check-jumps! (load children)
                                         (mut labels)
                                         (mut loop-labels)
                                         (if (or loop switch)
                                             (+ breakable 1)
                                             breakable)
                                         (if loop (+ loops 1) loops))))
              (al-free! [i64] (mut children))))
    0))

(defn syntax-restricted-global? [(name (slice u8))] (-> bool)
  (or (= name "undefined") (= name "Infinity") (= name "NaN")))

;; The value and function properties of the global object ECMA-262 §19 requires, and the
;; well-known constructors and namespaces. None is provided yet; a program naming one must not be
;; told the name is unresolvable (`typeof JSON` is "object" in every realm), so a read of one is
;; a runtime refusal, never `undefined`.
(defn syntax-standard-global? [(name (slice u8))] (-> bool)
  (or (= name "globalThis")
      (= name "eval")
      (= name "isFinite")
      (= name "isNaN")
      (= name "parseFloat")
      (= name "parseInt")
      (= name "decodeURI")
      (= name "decodeURIComponent")
      (= name "encodeURI")
      (= name "encodeURIComponent")
      (= name "Array")
      (= name "ArrayBuffer")
      (= name "BigInt")
      (= name "Boolean")
      (= name "DataView")
      (= name "Date")
      (= name "Error")
      (= name "EvalError")
      (= name "Function")
      (= name "Map")
      (= name "Number")
      (= name "Object")
      (= name "Promise")
      (= name "Proxy")
      (= name "RangeError")
      (= name "ReferenceError")
      (= name "RegExp")
      (= name "Set")
      (= name "String")
      (= name "Symbol")
      (= name "SyntaxError")
      (= name "TypeError")
      (= name "URIError")
      (= name "WeakMap")
      (= name "WeakRef")
      (= name "WeakSet")
      (= name "FinalizationRegistry")
      (= name "Atomics")
      (= name "JSON")
      (= name "Math")
      (= name "Reflect")
      (= name "AggregateError")
      (= name "SharedArrayBuffer")
      (= name "Iterator")
      (= name "Int8Array")
      (= name "Uint8Array")
      (= name "Uint8ClampedArray")
      (= name "Int16Array")
      (= name "Uint16Array")
      (= name "Int32Array")
      (= name "Uint32Array")
      (= name "Float32Array")
      (= name "Float64Array")
      (= name "BigInt64Array")
      (= name "BigUint64Array")))

;; A hoisted top-level declaration: what the closed-world Fun table and call resolution see.
;; Nested functions, expressions, arrows and methods are values and are not lowered yet.
(defn syntax-top-level-declaration? [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (.hoisted f)))

;; Whether the header pass gave this function record a Fun: hoisted declarations and admitted
;; function values.
;; A record with an entry: a local body (and its adapter), or only the forwarding entry of an ABI
;; builtin (`syntax-fun-forwarding?`).
(defn syntax-fun-lowered? [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (or (!= (.fun-nid f) 0) (!= (.adapter-nid f) 0))))

;; An intrinsic whose builtin takes the callable ABI itself: its public entry forwards every operand
;; and it has no local body (docs/DECISIONS.md, built-in closures).
(defn syntax-fun-forwarding? [(i i64)] (-> bool)
  (> (len (.abi-builtin (syntax-fun-ptr i))) 0))

;; Function values the closed world lowers today: plain declarations, expressions and arrows with
;; simple parameter lists. Methods, accessors, generators and async functions refuse at their use.
(defn syntax-fun-value-admitted? [(f SyntaxFun)] (-> bool)
  (and (match (.kind f)
         (FunDeclaration [] true)
         (FunExpression [] true)
         (FunArrow [] true)
         ;; A method or accessor is a function without [[Construct]] — a class constructor has one —
         ;; and `super` in one refuses where it is written (a home object waits).
         (FunMethod [] true)
         (FunGetter [] true)
         (FunSetter [] true))
       ;; Defaults, a rest parameter and destructuring parameters all lower.
       (not (.generator f))
       (not (.async f))))

;; Every source function shares one boxed signature: `this`, then the program-wide maximum formal
;; count of slots (docs/DECISIONS.md, function values).
(defn parser-abi-slots [] (-> i64)
  (.abi-slots (parser-state)))

(defn parser-abi-sig [] (-> i64)
  (.abi-sig (parser-state)))

(defn parser-settle-abi! [] (-> i64)
  (let [(mut slots) 0
        (mut members) (al-new [i64] (compiler-allocator))]
    ;; The hidden slots a record needs — its arguments object or the call's actuals, and the function
    ;; object being called — ride in the slots after its formals.
    (let [(mut fi) 0]
      (loop (if (>= (load fi) (len (.funs (parser-state))))
                (break 0)
                (let [needed
                        (+ (len (.params (syntax-fun-ptr (load fi))))
                           (syntax-fun-hidden-count (load fi)))]
                  (if (> needed (load slots)) (set! (mut slots) needed) 0)
                  (set! (mut fi) (+ (load fi) 1))
                  (continue)))))
    ;; A realm can materialize any declared intrinsic after this settles (the demand fixpoint), so
    ;; the slots cover every declared body, not only the ones materialized so far.
    (if (.script-mode (parser-state))
        (al-for [row (intrinsic-table)]
                (let [entry row]
                  (if (> (.arity entry) (load slots))
                      (set! (mut slots) (.arity entry))
                      0)))
        0)
    ;; A function returns a completion: its value, or the exception sentinel when it throws. Its
    ;; arguments are `this`, `new.target` (undefined for a call, the constructor for `new`:
    ;; docs/DECISIONS.md, new.target is an argument slot) and the program-wide formal slots.
    (push! [i64] (mut members) (ty-dyn TAG-COMPLETION))
    (let [(mut i) 0]
      (loop (if (> (load i) (+ (load slots) 1))
                (break 0)
                (do
                  (push! [i64] (mut members) (ty-dyn TAG-ANY))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (set! (.abi-slots (parser-state)) (load slots))
    (set! (.abi-sig (parser-state)) (ty-tuple (al-slice (load members))))
    0))

;; The object-file symbol of a hoisted declaration: its source name for the LAST declaration of
;; that name in the realm (the binding JavaScript observes), a compiler-owned dotted name for every
;; earlier one, so duplicate declarations within or across Scripts stay distinct for the linker.
(defn parser-hoisted-fun-symbol [(index i64)] (-> (slice u8))
  (let [f (syntax-fun-at index)
        (mut taken) false
        (mut j) (+ index 1)]
    (loop (if (>= (load j) (len (.funs (parser-state))))
              (break 0)
              (let [g (syntax-fun-at (load j))]
                (if (and (.hoisted g) (= (.name g) (.name f)))
                    (set! (mut taken) true)
                    0)
                (set! (mut j) (+ (load j) 1))
                (continue))))
    (if (load taken)
        (let [(mut sb) (sb-new (compiler-allocator))]
          (sb-push-str! (mut sb) "$aot$.")
          (sb-push-str! (mut sb) (.name f))
          (sb-push-str! (mut sb) ".")
          (sb-push-i64! (mut sb) index)
          (sb-str (mut sb)))
        (.name f))))

;; Compiler-owned symbol for a function value; a dot keeps it outside the source namespace.
(defn parser-value-fun-name [(index i64)] (-> (slice u8))
  (let [(mut sb) (sb-new (compiler-allocator))]
    (sb-push-str! (mut sb) "$aot$.fn.")
    (sb-push-i64! (mut sb) index)
    (sb-str (mut sb))))

(defn parser-callable-name [(index i64)] (-> (slice u8))
  (let [(mut sb) (sb-new (compiler-allocator))]
    (sb-push-str! (mut sb) "$aot$.entry.")
    (sb-push-i64! (mut sb) index)
    (sb-str (mut sb))))

;; The function-pointer set a code word loaded from any function object may hold: every function
;; the program lowered. At a reusable boundary it also admits an opaque ABI-compatible target;
;; known members still link, but their Returns cannot exhaust that call's possible behavior.
(defn parser-value-funptr-ty [] (-> i64)
  (let [(mut fidxs) (al-new [i64] (compiler-allocator))
        (mut i) 0]
    (loop (if (>= (load i) (len (.funs (parser-state))))
              (break 0)
              (do
                (if (and (syntax-fun-lowered? (load i))
                         (not (syntax-script-root? (load i))))
                    (let [f (syntax-fun-at (load i))]
                      (push! [i64] (mut fidxs) (.adapter-fidx f)))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [t
            (ty-funptr-boundary (callabi-signature)
                                (fidx-set-intern (al-slice (load fidxs)))
                                (.external-mutation (parser-state)))]
      (al-free! [i64] (mut fidxs))
      t)))

;; Final Simple ScopeNode.find searches Var inputs from innermost to outermost; lookup then
;; materializes a lazy loop Phi through update. Our separately lowered functions do not share
;; those Scope inputs. Before falling through to a realm name, recover the enclosing lexical
;; scopes from the syntax tree. Only statements containing the child's definition contribute:
;; sibling blocks, a switch discriminant and a catch's finally body have different environments.
;; Syntax ranges are local to the owning function's Script; never scan another Script's tree.
;; This identifies captures, not their storage: unsupported local environments still refuse.
(defn syntax-stmt-contains-position? [(id i64) (position i64)] (-> bool)
  (and (<= (syntax-stmt-lo id) position) (< position (syntax-stmt-hi id))))

(defn syntax-capture-loop-head! [(head ForInit)
                                 (names (mut (ArrayList (slice u8))))] (-> i64)
  (match head
    (ForInitDecl [stmt]
                 (let [(mut declarations) (al-new [i64] (compiler-allocator))]
                   (push! [i64] (mut declarations) stmt)
                   (syntax-collect-declarations! (load declarations)
                                                 true
                                                 (mut names))
                   (al-free! (mut declarations))
                   0))
    (_ 0)))

(defn syntax-capture-blocks! [(stmts (ArrayList i64))
                              (position i64)
                              (names (mut (ArrayList (slice u8))))] (-> i64)
  (al-for [id stmts]
          (if (syntax-stmt-contains-position? id position)
              (let [(mut children) (al-new [i64] (compiler-allocator))]
                (match (syntax-stmt-node id)
                  (SsBlock [body]
                           (syntax-collect-declarations! body true (mut names)))
                  (SsSwitch [discriminant cases]
                            (let [(mut in-cases) false]
                              (al-for [c cases]
                                      (if (syntax-stmt-contains-position? c
                                                                          position)
                                          (set! (mut in-cases) true)
                                          0))
                              (if (load in-cases)
                                  (syntax-collect-declarations! cases
                                                                true
                                                                (mut names))
                                  0)))
                  (SsFor [init test update body]
                         (syntax-capture-loop-head! init (mut names)))
                  (SsForIn [head of right body awaited]
                           (syntax-capture-loop-head! head (mut names)))
                  (SsTry [body catch-param catch-body finally-body]
                         (match catch-body
                           (Some [caught]
                                 (if (syntax-stmt-contains-position? caught
                                                                     position)
                                     (match catch-param
                                       (Some [pattern]
                                             (syntax-pattern-names! pattern
                                                                    (mut names)))
                                       (None [] 0))
                                     0))
                           (None [] 0)))
                  (_ 0))
                (syntax-stmt-children! id (mut children))
                (syntax-capture-blocks! (load children) position (mut names))
                (al-free! (mut children))
                0)
              0))
  0)

;; Root Script declarations belong to the realm; nested blocks within a Script do not.
;; A hoisted ordinary function still owns parameter/var/lexical bindings that children capture.
(defn syntax-enclosing-binding? [(fun i64) (name (slice u8))] (-> bool)
  (let [(mut current) (let [f (syntax-fun-at fun)] (.parent f))
        (mut child) fun
        (mut found) false]
    (loop (if (or (load found) (< (load current) 0))
              (break 0)
              (let [f (syntax-fun-at (load current))
                    child-fun (syntax-fun-at (load child))
                    (mut names) (al-new [(slice u8)] (compiler-allocator))]
                (syntax-capture-blocks! (.body f) (.lo child-fun) (mut names))
                (if (syntax-script-root? (load current))
                    0
                    (do
                      (al-for [p (.params f)]
                              (push! [(slice u8)] (mut names) p))
                      (match (.rest-param f)
                        (Some [r] (push! [(slice u8)] (mut names) r))
                        (None [] 0))
                      (syntax-collect-declarations! (.body f) false (mut names))
                      (syntax-collect-declarations! (.body f) true (mut names))
                      (syntax-function-decl-names! (.body f) (mut names))
                      (match (.kind f)
                        (FunExpression []
                                       (push! [(slice u8)]
                                              (mut names)
                                              (.name f)))
                        (_ 0))
                      0))
                (al-for [n (load names)]
                        (if (= n name) (set! (mut found) true) 0))
                (al-free! [(slice u8)] (mut names))
                (set! (mut child) (load current))
                (set! (mut current) (.parent f))
                (continue))))
    (load found)))

;; A record's own activation bindings: its parameters, its `var`s, its body function declarations
;; and, for a function expression, its own name. These live exactly as long as one call does, which
;; is what an environment record models.
(defn syntax-fun-activation-names! [(fi i64) (out (mut (ArrayList (slice u8))))] (-> i64)
  (let [f (syntax-fun-at fi)]
    ;; A Script's root binds the realm: its `var`s are global properties and its declarations are
    ;; the closed world's functions, neither of which a nested function captures.
    (if (syntax-script-root? fi)
        0
        (do
          (al-for [p (.params f)] (push! [(slice u8)] (mut out) p))
          (match (.rest-param f)
            (Some [r] (push! [(slice u8)] (mut out) r))
            (None [] 0))
          (syntax-collect-declarations! (.body f) false (mut out))
          (syntax-function-decl-names! (.body f) (mut out))
          (match (.kind f)
            (FunExpression [] (push! [(slice u8)] (mut out) (.name f)))
            (_ 0))
          0))))

;; A record's own block-scoped bindings: its body's `let`, `const` and `class` declarations, and
;; those of the blocks enclosing `position`. Their lifetime is a block, or one loop iteration, which
;; an activation's environment does not model, so capturing one still refuses by name.
(defn syntax-fun-lexical-names! [(fi i64)
                                 (position i64)
                                 (out (mut (ArrayList (slice u8))))] (-> i64)
  (let [f (syntax-fun-at fi)]
    (syntax-capture-blocks! (.body f) position (mut out))
    0))

;; A record's own body-level `let`, `const` and `class` bindings. One activation has exactly one of
;; each, so an environment slot models it — empty until its initialization, which is its temporal
;; dead zone. A block's lexicals are not these: a block inside a loop has one per iteration.
(defn syntax-fun-body-lexical-names! [(fi i64)
                                      (out (mut (ArrayList (slice u8))))] (-> i64)
  (let [f (syntax-fun-at fi)]
    (if (syntax-script-root? fi)
        0
        (do (syntax-collect-declarations! (.body f) true (mut out)) 0))))

;; Whether a captured binding of `owner` is one of its body lexicals, and so starts in its dead zone.
;; The capture pass recorded it beside the slot, so this is the slot's own answer.
(defn syntax-env-name-lexical? [(owner i64) (name (slice u8))] (-> bool)
  (let [f (syntax-fun-ptr owner)
        (mut i) 0
        (mut found) false]
    (al-for [n (.env-names f)]
            (do
              (if (and (= n name) (= (get (.env-lexical f) (load i)) 1))
                  (set! (mut found) true)
                  0)
              (set! (mut i) (+ (load i) 1))
              0))
    (load found)))

(defn syntax-names-contain? [(names (ArrayList (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (al-for [n names] (if (= n name) (set! (mut found) true) 0))
    (load found)))

;; Where a name one record mentions is bound: the innermost enclosing record binding it, and whether
;; that binding is one of the activation's own. A name the record binds itself, or that nothing
;; encloses, answers -1 and is not a capture.
(defstruct CaptureOwner [(fun i64) (activation bool)])

;; The compiler-only binding an arrow's `this` reads: the receiver of the nearest function around it.
(const THIS-CAPTURE-SLOT "$aot$.this-capture")

;; The nearest enclosing record that has a receiver of its own, for an arrow's `this`.
(defn syntax-receiver-owner [(fun i64)] (-> i64)
  (let [(mut current) (let [f (syntax-fun-at fun)] (.parent f))]
    (loop (if (< (load current) 0)
              (break -1)
              (let [f (syntax-fun-at (load current))]
                (match (.kind f)
                  (FunArrow [] (do (set! (mut current) (.parent f)) (continue)))
                  (_ (break (load current)))))))))

(defn syntax-capture-owner [(fun i64) (name (slice u8))] (-> CaptureOwner)
  (if (= name THIS-CAPTURE-SLOT)
      (if (syntax-fun-arrow? fun)
          (CaptureOwner :fun (syntax-receiver-owner fun) :activation true)
          (CaptureOwner :fun -1 :activation false))
      (let [(mut owner) -1
            (mut activation?) false
            (mut current) (let [f (syntax-fun-at fun)] (.parent f))
            (mut child) fun]
        (loop (if (or (>= (load owner) 0) (< (load current) 0))
                  (break 0)
                  (let [child-fun (syntax-fun-at (load child))
                        current-fun (syntax-fun-at (load current))
                        (mut activation)
                          (al-new [(slice u8)] (compiler-allocator))
                        (mut lexical) (al-new [(slice u8)] (compiler-allocator))]
                    (syntax-fun-activation-names! (load current)
                                                  (mut activation))
                    (syntax-fun-body-lexical-names! (load current)
                                                    (mut activation))
                    (syntax-fun-lexical-names! (load current)
                                               (.lo child-fun)
                                               (mut lexical))
                    (if (syntax-names-contain? (load lexical) name)
                        (do
                          (set! (mut owner) (load current))
                          (set! (mut activation?) false)
                          0)
                        (if (syntax-names-contain? (load activation) name)
                            (do
                              (set! (mut owner) (load current))
                              (set! (mut activation?) true)
                              0)
                            0))
                    (al-free! [(slice u8)] (mut activation))
                    (al-free! [(slice u8)] (mut lexical))
                    (set! (mut child) (load current))
                    (set! (mut current) (.parent current-fun))
                    (continue))))
        (CaptureOwner :fun (load owner) :activation (load activation?)))))

(defn syntax-fun-arrow? [(fi i64)] (-> bool)
  (let [f (syntax-fun-at fi)] (match (.kind f) (FunArrow [] true) (_ false))))

;; Every identifier one record's own code mentions, its nested records excluded — they ask the same
;; question for themselves. A class body's heritage and computed keys belong to the record around
;; the class; its methods and field initializers are records of their own.
(defn syntax-fun-references! [(fi i64) (out (mut (ArrayList (slice u8))))] (-> i64)
  (let [f (syntax-fun-at fi)]
    (al-for [s (.body f)] (syntax-reference-walk-stmt! s (mut out)))
    (match (.expression-body f)
      (Some [e] (syntax-reference-walk-expr! e (mut out)))
      (None [] 0))
    (al-for [d (.param-defaults f)]
            (match d
              (Some [init] (syntax-reference-walk-expr! init (mut out)))
              (None [] 0)))
    0))

(defn syntax-reference-walk-stmt! [(id i64) (out (mut (ArrayList (slice u8))))] (-> i64)
  (match (syntax-stmt-node id)
    ;; A nested record answers for itself; a class's own expressions belong to this record.
    (SsFunctionDecl [fun] 0)
    (SsClassDecl [cls] (syntax-reference-walk-class! cls (mut out)))
    (_ (let [(mut exprs) (al-new [i64] (compiler-allocator))
             (mut children) (al-new [i64] (compiler-allocator))]
         (syntax-stmt-exprs! id (mut exprs))
         (al-for [e (load exprs)] (syntax-reference-walk-expr! e (mut out)))
         (syntax-stmt-children! id (mut children))
         (al-for [c (load children)] (syntax-reference-walk-stmt! c (mut out)))
         (al-free! [i64] (mut exprs))
         (al-free! [i64] (mut children))
         0))))

(defn syntax-reference-walk-expr! [(id i64) (out (mut (ArrayList (slice u8))))] (-> i64)
  (match (syntax-node id)
    (SxName [name] (do (push! [(slice u8)] (mut out) name) 0))
    ;; An arrow's `this` is the receiver of the function around it, which is a capture like any
    ;; other; a non-arrow's is its own and is dropped by the resolution below. A `super` reference
    ;; reads that same receiver, and needs the home object besides, which is what refuses.
    (SxThis [] (do (push! [(slice u8)] (mut out) THIS-CAPTURE-SLOT) 0))
    (SxSuper [] (do (push! [(slice u8)] (mut out) THIS-CAPTURE-SLOT) 0))
    (SxFunction [fun] 0)
    (SxClass [cls] (syntax-reference-walk-class! cls (mut out)))
    (_ (let [(mut children) (al-new [i64] (compiler-allocator))]
         (syntax-expr-children! id (mut children))
         (al-for [c (load children)] (syntax-reference-walk-expr! c (mut out)))
         (al-free! [i64] (mut children))
         0))))

(defn syntax-reference-walk-class! [(cls i64)
                                    (out (mut (ArrayList (slice u8))))] (-> i64)
  (let [(mut exprs) (al-new [i64] (compiler-allocator))]
    (syntax-class-exprs! cls (mut exprs))
    (al-for [e (load exprs)] (syntax-reference-walk-expr! e (mut out)))
    (al-free! [i64] (mut exprs))
    0))

;; What is left of the capture refusal: an enclosing function's binding that its activation does not
;; own — a block's `let`, `const` or `class`, and a loop's per-iteration one above all, which has a
;; lifetime one environment slot cannot model.
(defn lower-require-uncaptured! [(name (slice u8))] (-> i64)
  (if (syntax-enclosing-binding? (.current-fun (parser-state)) name)
      (unimplemented "a captured binding of an enclosing block or loop iteration"
                     "docs/GAPS.md — function values and closures")
      0))

;; The program loop marks the declarations it parsed at the top level as hoisted Funs.
(defn syntax-mark-hoisted! [(stmt i64)] (-> i64)
  (match (syntax-stmt-node stmt)
    (SsFunctionDecl [fun]
                    (let [fp (syntax-fun-ptr fun)] (set! (.hoisted fp) true) 0))
    (_ 0)))

;; The function a source name resolves to. A Script's own declaration shadows a declared intrinsic of
;; the same name, whichever record was reserved first (an intrinsic can be materialized late).
(defn syntax-find-fun [(name (slice u8))] (-> i64)
  (let [own (syntax-find-fun-where name false)]
    (if (>= own 0) own (syntax-find-fun-where name true))))

;; The intrinsic record for a declared root, never a Script declaration that shadows its binding:
;; %Error% exists, and the language's errors use it, even where a Script declares `function Error`.
(defn syntax-find-intrinsic-fun [(name (slice u8))] (-> i64)
  (syntax-find-fun-where name true))

(defn syntax-find-fun-where [(name (slice u8)) (intrinsic bool)] (-> i64)
  ;; Function declarations are hoisted and later declarations replace earlier declarations of the
  ;; same binding. Resolve from the end so calls and the public entry observe that JavaScript rule;
  ;; obsolete bodies then disappear through the ordinary closed-world lifetime protocol.
  (let [(mut i) (- (len (.funs (parser-state))) 1)]
    (loop (if (< (load i) 0)
              (break -1)
              (let [f (syntax-fun-at (load i))]
                (if (and (= (.name f) name)
                         (syntax-top-level-declaration? (load i))
                         (= (syntax-intrinsic-fun? (load i)) intrinsic))
                    (break (load i))
                    (do (set! (mut i) (- (load i) 1)) (continue))))))))

(defn parser-node [(nid i64)] (-> (dyn NodeOps))
  (match (arena-node nid) (Some [n] n) (None [] (unreachable-node))))

(defn parser-internal-main-name [] (-> (slice u8))
  ;; A dot cannot occur in an admitted JavaScript identifier. Compiler-owned native symbols must
  ;; live outside the source namespace or a user declaration can collide with the renamed source
  ;; entry even though their graph identities and function indices are distinct.
  "$aot$.source_main")

(defn parser-entry-fun [] (-> (dyn NodeOps))
  (if (= (.entry-fun-nid (parser-state)) 0)
      (do
        (panic "parser-entry-fun: process-entry wrapper is not installed")
        (unreachable-node))
      (parser-node (.entry-fun-nid (parser-state)))))

;; Return the compilation unit's source Start through the compiler-owned process wrapper, rather
;; than by graph search: linked source/JSL callees also expose their own Starts in the Stop cone.
(defn parser-entry-arity [] (-> i64)
  (let [idx (parser-source-entry-index)]
    (if (< idx 0)
        (do (panic "parser-entry-arity: program has no main function") 0)
        (let [syntax (syntax-fun-at idx)]
          (len (.params syntax))))))

(defn parser-entry-start [] (-> (dyn NodeOps))
  (do
    ;; argc/argv belong to the host wrapper and never enter source `main`. The wrapper supplies the
    ;; ECMAScript value `undefined` for every declared-but-omitted source parameter.
    (match (n-in (parser-entry-fun) 1)
      (Some [start]
            (if (= (n-op start) OP-START)
                start
                (do
                  (panic "parser-entry-start: wrapper is not rooted at Start")
                  (unreachable-node))))
      (None []
            (do
              (panic "parser-entry-start: wrapper has no entry hook")
              (unreachable-node))))))

(defn lower-typeof-operand [(id i64)] (-> (dyn NodeOps))
  ;; Parentheses preserve a Reference. typeof skips GetValue only for an unresolvable name;
  ;; a declared TDZ binding must still take the normal read path. Our global environment is
  ;; incomplete in closed mode, so lack of a Scope slot does NOT prove that e.g. JSON is absent.
  ;; Retained units resolve the executing realm's declarative record before its object record.
  (let [unresolved
          (match (syntax-node (syntax-ungroup-id id))
            (SxName [name]
                    (and (< (scope-find (parser-node (.current-scope (parser-state)))
                                        name)
                            0)
                         ;; A function's `arguments` is its own binding (or an arrow's refused capture).
                         (not (and (= name "arguments")
                                   (not (syntax-script-root? (.current-fun (parser-state))))))
                         (not (syntax-restricted-global? name))
                         (or (.external-mutation (parser-state))
                             (not (syntax-standard-global? name)))
                         (not (syntax-script-binding? name))
                         (or (.external-mutation (parser-state))
                             (< (syntax-global-index name) 0))
                         (or (and (.external-mutation (parser-state))
                                  (>= (syntax-global-index name) 0))
                             (< (syntax-find-fun name) 0))
                         (not (syntax-enclosing-binding? (.current-fun (parser-state))
                                                         name))))
            (_ false))]
    ;; A reusable unit cannot prove that another Script has not supplied this object binding.
    ;; Preserve the runtime read, including getter completions. Closed programs retain their
    ;; existing absent-name fold; retained lexical imports preserve TDZ through the JSL read.
    (if unresolved
        (if (.external-mutation (parser-state))
            (match (syntax-node (syntax-ungroup-id id))
              (SxName [name]
                      (lower-completion! (lower-jsl-unary-value "JsGlobalTypeofOperand"
                                                                (keyref-make (shape-key-intern name)))))
              (_ (do
                   (panic "lower-typeof-operand: unresolved operand is not a name")
                   (unreachable-node))))
            (dyn-undefined-make))
        (lower-syntax-expr id))))

;; As in Simple, compiler-only names contain a dot, which cannot occur in an IdentifierName.
;; These SSA values are positive realm slot identities, never cell contents. They are created
;; only in the owning Script initializer; a separate function starts with its own Scope and
;; therefore cannot accidentally capture an initializer-local node. Unknown/imported names keep
;; ordinary resolution, so later Scripts can still introduce lexicals shadowing object bindings.
(defn lower-lexical-slot-name [(name (slice u8))] (-> (slice u8))
  (let [(mut b) (sb-new (compiler-allocator))]
    (sb-push-str! (mut b) "$aot$.lexical-slot.")
    (sb-push-str! (mut b) name)
    (sb-str (mut b))))

(defn lower-known-lexical-slot [(name (slice u8))] (-> (Option (dyn NodeOps)))
  (scope-lookup (parser-node (.current-scope (parser-state)))
                (lower-lexical-slot-name name)))

(defn lower-script-binding-read [(name (slice u8))] (-> (dyn NodeOps))
  (lower-completion! (match (lower-known-lexical-slot name)
                       (Some [slot]
                             (lower-jsl-unary-value "JsReadGlobalLexicalSlot"
                                                    slot))
                       (None []
                             (lower-jsl-unary-value "JsGlobalBindingRead"
                                                    (keyref-make (shape-key-intern name)))))))

;; A name in an expression: its environment slot when this activation's binding is captured, the
;; slot of an enclosing activation's when that is where it is bound, and otherwise the ordinary
;; resolution — a Scope binding, a realm lexical, a global.
;; PutValue for a Script's lexical binding.
(defn lower-script-binding-write! [(name (slice u8)) (value (dyn NodeOps))] (-> i64)
  (match (lower-known-lexical-slot name)
    (Some [slot]
          (do
            (n-keep! value)
            (let [(mut args) (al-new [(dyn NodeOps)] (compiler-allocator))
                  scope (parser-node (.current-scope (parser-state)))]
              (push! [(dyn NodeOps)] (mut args) slot)
              (push! [(dyn NodeOps)] (mut args) value)
              (let [w
                      (jsl-lower-macro-values "JsGlobalLexicalWrite"
                                              (load args)
                                              (parser-node (.current-ctrl (parser-state)))
                                              (scope-mem scope))]
                (al-free! [(dyn NodeOps)] (mut args))
                (parser-set-current-ctrl! (.ctrl w))
                (scope-set-mem! scope (.mem w))
                (lower-completion! (.value w))
                (n-unkeep! value)
                0))))
    (None []
          (do
            (lower-completion! (lower-jsl-values2 "JsGlobalBindingWrite"
                                                  (keyref-make (shape-key-intern name))
                                                  value))
            0))))

(defn lower-name [(name (slice u8))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        slot (scope-env-slot scope name)]
    (if (>= slot 0)
        (if (scope-env-tdz? scope name)
            (lower-environment-load-checked slot)
            (lower-environment-load slot))
        (if (>= (scope-find scope name) 0)
            (lower-name-uncaptured name)
            (let [owner
                    (syntax-capture-owner (.current-fun (parser-state)) name)]
              (if (and (>= (.fun owner) 0) (.activation owner))
                  (lower-environment-outer (.fun owner) name)
                  (lower-name-uncaptured name)))))))

(defn lower-name-uncaptured [(name (slice u8))] (-> (dyn NodeOps))
  (match (match (scope-lookup (parser-node (.current-scope (parser-state)))
                              name)
           (Some [value] (Some value))
           (None []
                 (if (= name "arguments")
                     (lower-arguments-object)
                     (None [(dyn NodeOps)]))))
    (Some [value] value)
    (None []
          (do
            (lower-require-uncaptured! name)
            ;; A Script's lexical binding is the realm's, read by name from wherever it is named:
            ;; its slot when the Script's own initializer knows it, and a runtime lookup — with the
            ;; dead-zone ReferenceError — from a function of the Script.
            (if (syntax-script-binding? name)
                (lower-script-binding-read name)
                ;; Resolve the non-writable global numeric/singleton values after lexical
                ;; bindings first because JavaScript permits a parameter or local to shadow that global;
                ;; only an unresolved identifier receives the canonical singleton.
                (if (= name "undefined")
                    (dyn-undefined-make)
                    (if (or (= name "Infinity") (= name "NaN"))
                        (lower-singleton (if (= name "Infinity")
                                             "JsInfinity"
                                             "JsNaN"))
                        ;; globalThis (§19.1.1) is the realm's global object, which `this` already names
                        ;; at a Script's top level.
                        (if (= name "globalThis")
                            (lower-global-object)
                            (if (>= (syntax-global-index name) 0)
                                (lower-global-load name)
                                (if (>= (syntax-find-fun name) 0)
                                    (lower-function-object (syntax-find-fun name))
                                    ;; Nothing in the Script or any enclosing function declares the
                                    ;; name: it is a Reference into the global object, resolved at
                                    ;; runtime as a property read or a ReferenceError.
                                    (if (.external-mutation (parser-state))
                                        (lower-completion! (lower-jsl-unary-value "JsGlobalBindingRead"
                                                                                  (keyref-make (shape-key-intern name))))
                                        (lower-jsl-unary-value "JsUnresolvedGlobalRead"
                                                               (keyref-make (shape-key-intern name))))))))))))))

(defn parser-set-current-ctrl! [(ctrl (dyn NodeOps))] (-> i64)
  (do
    (set! (.current-ctrl (parser-state)) (n-nid ctrl))
    (scope-set-ctrl! (parser-node (.current-scope (parser-state))) ctrl)))

;; A source operator is admitted by the grammar before its semantics exist in the production JSL
;; index. Refuse by the operator's JSL entry-point name so the missing definition is the message.
(defn lower-require-jsl! [(name (slice u8))] (-> i64)
  (if (jsl-defined? name)
      0
      (unimplemented name
                     "jsl/compiler/index — this operator's JSL definition is not in the production registry")))

;; JavaScript numeric operators are semantic calls for every admitted Number representation.
;; Values cross the dynamic boundary into JSL; specialization may expose raw integer or binary64
;; arithmetic, while mixed number/undefined flow retains the guarded generic path.
;; The JSL entry a source operator lowers to: the operators that can meet an object (and so call
;; user code through ToPrimitive) have operator definitions over their numeric cores
;; (jsl/compiler/toprimitive.jsl); every other name is its own entry.
(defn lower-operator-entry [(name (slice u8))] (-> (slice u8))
  (if (= name "JsAdd")
      "JsAddOperator"
      (if (= name "JsSub")
          "JsSubOperator"
          (if (= name "JsMul")
              "JsMulOperator"
              (if (= name "JsDiv")
                  "JsDivOperator"
                  (if (= name "JsLt")
                      "JsLtOperator"
                      (if (= name "JsGt")
                          "JsGtOperator"
                          (if (= name "JsLe")
                              "JsLeOperator"
                              (if (= name "JsGe")
                                  "JsGeOperator"
                                  (if (= name "JsNegate")
                                      "JsNegateOperator"
                                      (if (= name "JsPositive")
                                          "JsPositiveOperator"
                                          name)))))))))))

(defn lower-js-binary [(lhs (dyn NodeOps))
                       (rhs (dyn NodeOps))
                       (source-name (slice u8))] (-> (dyn NodeOps))
  (let [name (lower-operator-entry source-name)
        target (jsl-call-target name)
        scope (parser-node (.current-scope (parser-state)))
        c
          (call-make-with-mem (parser-node (.current-ctrl (parser-state)))
                              (scope-mem scope))]
    ;; JavaScript values are already dynamic at every source-level boundary. JSL owns any unboxing;
    ;; boxing again here would make the frontend silently choose an integer representation.
    (call-add-arg! c lhs)
    (call-add-arg! c rhs)
    ;; Nested argument lowering may advance both effects. The call consumes the state after all
    ;; arguments, not the snapshot from before their evaluation.
    (n-set-def! c CALL-CTRL (Some (parser-node (.current-ctrl (parser-state)))))
    (n-set-def! c CALL-MEM (Some (scope-mem scope)))
    (call-set-fptr! c target)
    (let [end (callend-make c)]
      (let [ctrl (cproj-make end RETURN-CTRL "js-binary.ctrl")]
        (parser-set-current-ctrl! ctrl))
      (scope-set-mem! scope (proj-make end RETURN-MEM "js-binary.mem"))
      ;; An operator that can call user code (ToPrimitive) completes abruptly: test its result.
      (let [value (proj-make end RETURN-VALUE "js-binary.value")]
        (if (jsl-throws? name) (lower-completion! value) value)))))

;; Source predicates cross the same semantic boundary as arithmetic. JSL handles both numeric
;; representations, signed zero, and NaN; its raw Boolean result is the compiler-internal predicate
;; expected by If and never escapes as a source-language value.
(defn lower-js-unary [(value (dyn NodeOps)) (source-name (slice u8))] (-> (dyn NodeOps))
  (let [name (lower-operator-entry source-name)
        target (jsl-call-target name)
        scope (parser-node (.current-scope (parser-state)))
        c
          (call-make-with-mem (parser-node (.current-ctrl (parser-state)))
                              (scope-mem scope))]
    (call-add-arg! c value)
    (n-set-def! c CALL-CTRL (Some (parser-node (.current-ctrl (parser-state)))))
    (n-set-def! c CALL-MEM (Some (scope-mem scope)))
    (call-set-fptr! c target)
    (let [end (callend-make c)]
      (let [ctrl (cproj-make end RETURN-CTRL "js-truthy.ctrl")]
        (parser-set-current-ctrl! ctrl))
      (scope-set-mem! scope (proj-make end RETURN-MEM "js-truthy.mem"))
      ;; An operator that can call user code (ToPrimitive) completes abruptly: test its result.
      (let [value (proj-make end RETURN-VALUE "js-truthy.value")]
        (if (jsl-throws? name) (lower-completion! value) value)))))

(defn lower-js-truthy [(value (dyn NodeOps))] (-> (dyn NodeOps))
  (lower-js-unary value "JsTruthy"))

;; Final Simple parseAsgn finds the Var before recursively parsing the RHS, then converts and
;; updates that same Scope binding. Its field path emits a memory-threaded Store. Here local `bound` is
;; likewise stable, while an object record's property set can change during the RHS. Retain its
;; environment, key and pre-RHS resolution as nodes until PutValue: strict unresolvable
;; assignment must still throw if the RHS creates the property (docs/DECISIONS.md).
;; A positive resolution is a stable realm lexical slot, -1 an object binding, zero unresolved.
;; Local/block bindings retain Simple's Scope inputs; retained Script root lexicals live in cells.
(defstruct SyntaxRef
  [(member bool)
   (name (slice u8))
   (owner-nid i64)
   (key-nid i64)
   (bound bool)
   (object-binding bool)
   (resolved-nid i64)
   (keyed bool)  ; `owner[key]`: key-nid is the evaluated key value, not an interned key
   (super bool)  ; `super.x`: owner-nid is the base above the home object, not the receiver
   (receiver-nid i64)  ; a super reference's `this`, the receiver of its [[Get]] and [[Set]]
   (captured-owner i64)])  ; a captured binding of an enclosing activation: the record owning it, or -1

(defn lower-ref-global-prepare! [(ref (ptr SyntaxRef))] (-> i64)
  (if (or (and (not (.script-unit (parser-state)))
               (syntax-script-binding? (.name ref)))
          (syntax-enclosing-binding? (.current-fun (parser-state)) (.name ref)))
      (unimplemented "nonlocal lexical assignment reference"
                     "docs/GAPS.md — lexical environments and closures")
      0)
  (let [owner (lower-global-object)
        key (keyref-make (shape-key-intern (.name ref)))
        scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (n-keep! owner)
    (n-keep! key)
    (push! [(dyn NodeOps)] (mut args) owner)
    (push! [(dyn NodeOps)] (mut args) key)
    (let [r
            (match (lower-known-lexical-slot (.name ref))
              (Some [slot]
                    (jsl-expr-result slot (scope-ctrl scope) (scope-mem scope)))
              (None []
                    (jsl-lower-macro-values "JsGlobalResolveReference"
                                            (load args)
                                            (scope-ctrl scope)
                                            (scope-mem scope))))]
      (al-free! (mut args))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (n-keep! (.value r))
      (set! (.object-binding ref) true)
      (set! (.owner-nid ref) (n-nid owner))
      (set! (.key-nid ref) (n-nid key))
      (set! (.resolved-nid ref) (n-nid (.value r)))
      0)))

;; Consume a retained environment Reference in the current post-expression Scope. Its nodes
;; stay kept until lower-ref-release!, including across a compound read and logical branches.
(defn lower-ref-global-apply! [(ref SyntaxRef)
                               (operation (slice u8))
                               (value (Option (dyn NodeOps)))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut args) (parser-node (.owner-nid ref)))
    (push! [(dyn NodeOps)] (mut args) (parser-node (.key-nid ref)))
    (push! [(dyn NodeOps)] (mut args) (parser-node (.resolved-nid ref)))
    (match value (Some [v] (push! [(dyn NodeOps)] (mut args) v)) (None [] 0))
    (push! [(dyn NodeOps)]
           (mut args)
           (con-int (if (syntax-fun-strict (.current-fun (parser-state))) 1 0)))
    (let [r
            (jsl-lower-macro-values operation
                                    (load args)
                                    (scope-ctrl scope)
                                    (scope-mem scope))]
      (al-free! (mut args))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (lower-completion! (.value r)))))

(defn lower-ref-name-prepare! [(ref (ptr SyntaxRef)) (name (slice u8))] (-> i64)
  (set! (.name ref) name)
  (set! (.captured-owner ref) -1)
  (set! (.bound ref)
        (>= (scope-find (parser-node (.current-scope (parser-state))) name) 0))
  ;; A binding of an enclosing activation is read and written through its environment record.
  (if (.bound ref)
      0
      (let [owner (syntax-capture-owner (.current-fun (parser-state)) name)]
        (if (and (>= (.fun owner) 0) (.activation owner))
            (do (set! (.captured-owner ref) (.fun owner)) 0)
            (lower-require-uncaptured! name))))
  (if (and (.external-mutation (parser-state))
           (not (.bound ref))
           (not (syntax-restricted-global? name)))
      (lower-ref-global-prepare! ref)
      0))

(defn lower-ref-prepare! [(target i64)] (-> SyntaxRef)
  (let [(mut ref) (primitive/zeroed SyntaxRef)]
    (set! (.captured-owner (mut ref)) -1)
    (match (syntax-node target)
      (SxIndex [owner key optional]
               (if (syntax-is-super? owner)
                   (lower-ref-super-prepare! (mut ref) key "")
                   (let [base (lower-syntax-expr owner)]
                     (n-keep! base)
                     (let [k (lower-syntax-expr key)]
                       (n-keep! k)
                       (set! (.member (mut ref)) true)
                       (set! (.keyed (mut ref)) true)
                       (set! (.owner-nid (mut ref)) (n-nid base))
                       (set! (.key-nid (mut ref)) (n-nid k))))))
      (SxPrivateMember [owner name optional]
                       (unimplemented "private class members"
                                      "docs/GAPS.md — classes"))
      (SxMember [owner name optional]
                (if (syntax-is-super? owner)
                    (lower-ref-super-prepare! (mut ref) -1 name)
                    (let [base (lower-syntax-expr owner)
                          key (keyref-make (shape-key-intern name))]
                      (n-keep! base)
                      (n-keep! key)
                      (set! (.member (mut ref)) true)
                      (set! (.owner-nid (mut ref)) (n-nid base))
                      (set! (.key-nid (mut ref)) (n-nid key)))))
      (SxName [name] (lower-ref-name-prepare! (mut ref) name))
      (SxCall [callee args optional]
              (unimplemented "call expression assignment target (sloppy runtime ReferenceError)"
                             "docs/GAPS.md — exceptions"))
      (_ (broken "lower-ref-prepare!: target survived syntax validation")))
    (load ref)))

;; A `super` reference (§13.3.7.3 MakeSuperPropertyReference), in the specification's order: the
;; method's `this`, which a derived constructor must have initialized, then the key of a computed
;; access, then the base — the object above the home object its function object carries.
(defn lower-ref-super-prepare! [(ref (ptr SyntaxRef))
                                (key-id i64)
                                (name (slice u8))] (-> i64)
  (let [receiver (lower-this)]
    (n-keep! receiver)
    (let [key
            (if (>= key-id 0)
                (lower-syntax-expr key-id)
                (keyref-make (shape-key-intern name)))]
      (n-keep! key)
      (let [base (lower-super-base)]
        (n-keep! base)
        (set! (.member ref) true)
        (set! (.super ref) true)
        (set! (.keyed ref) (>= key-id 0))
        (set! (.receiver-nid ref) (n-nid receiver))
        (set! (.key-nid ref) (n-nid key))
        (set! (.owner-nid ref) (n-nid base))
        0))))

(defn syntax-is-super? [(id i64)] (-> bool)
  (match (syntax-node (syntax-ungroup-id id)) (SxSuper [] true) (_ false)))

(defn lower-ref-get! [(ref SyntaxRef)] (-> (dyn NodeOps))
  (if (.object-binding ref)
      (lower-ref-global-apply! ref
                               "JsGlobalReferenceRead"
                               (None [(dyn NodeOps)]))
      (lower-ref-nonglobal-get! ref)))

(defn lower-ref-nonglobal-get! [(ref SyntaxRef)] (-> (dyn NodeOps))
  (if (.super ref)
      (lower-completion! (lower-jsl-values3 (if (.keyed ref)
                                                "JsSuperGetKeyed"
                                                "JsSuperGet")
                                            (parser-node (.owner-nid ref))
                                            (parser-node (.key-nid ref))
                                            (parser-node (.receiver-nid ref))))
      (if (.member ref)
          (let [scope (parser-node (.current-scope (parser-state)))
                (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
            (push! [(dyn NodeOps)] (mut args) (parser-node (.owner-nid ref)))
            (push! [(dyn NodeOps)] (mut args) (parser-node (.key-nid ref)))
            (let [loaded
                    (if (.keyed ref)
                        (lower-jsl-call-values "JsGetKeyed" (load args))
                        (lower-jsl-call-values "JsGetNamed" (load args)))]
              (al-free! [(dyn NodeOps)] (mut args))
              (parser-set-current-ctrl! (.ctrl loaded))
              (scope-set-mem! scope (.mem loaded))
              (lower-completion! (.value loaded))))
          (if (>= (.captured-owner ref) 0)
              (lower-environment-outer (.captured-owner ref) (.name ref))
              (lower-name (.name ref))))))

;; PutValue against the live post-RHS Scope. Non-strict PutValue to the three non-writable
;; globals has no effect; lexical shadows take Scope's ordinary update and const/TDZ checks. JSL
;; owns property semantics; descriptors, accessors and nullish-base exceptions remain its gaps.
(defn lower-ref-put! [(ref SyntaxRef) (value (dyn NodeOps))] (-> i64)
  (if (.object-binding ref)
      (do (lower-ref-global-apply! ref "JsGlobalReferenceWrite" (Some value)) 0)
      (lower-ref-nonglobal-put! ref value)))

(defn lower-ref-nonglobal-put! [(ref SyntaxRef) (value (dyn NodeOps))] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))]
    (if (.super ref)
        (let [(mut sargs) (al-new [(dyn NodeOps)] (compiler-allocator))]
          (push! [(dyn NodeOps)] (mut sargs) (parser-node (.owner-nid ref)))
          (push! [(dyn NodeOps)] (mut sargs) (parser-node (.key-nid ref)))
          (push! [(dyn NodeOps)] (mut sargs) value)
          (push! [(dyn NodeOps)] (mut sargs) (parser-node (.receiver-nid ref)))
          (push! [(dyn NodeOps)]
                 (mut sargs)
                 (con-int (if (.strict (syntax-fun-ptr (.current-fun (parser-state))))
                              1
                              0)))
          (let [stored
                  (lower-jsl-values (if (.keyed ref)
                                        "JsSuperSetKeyed"
                                        "JsSuperSet")
                                    (load sargs))]
            (al-free! [(dyn NodeOps)] (mut sargs))
            (lower-completion! stored)
            0))
        (if (.member ref)
            (let [(mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
              (push! [(dyn NodeOps)] (mut args) (parser-node (.owner-nid ref)))
              (push! [(dyn NodeOps)] (mut args) (parser-node (.key-nid ref)))
              (push! [(dyn NodeOps)] (mut args) value)
              ;; The site's strictness: a failed [[Set]] (a read-only or accessor-only property, a
              ;; non-extensible object, a primitive base) throws a TypeError only in strict code.
              (push! [(dyn NodeOps)]
                     (mut args)
                     (con-int (if (.strict (syntax-fun-ptr (.current-fun (parser-state))))
                                  1
                                  0)))
              (let [stored
                      (if (.keyed ref)
                          (lower-jsl-call-values "JsSetKeyed" (load args))
                          (lower-jsl-call-values "JsDefineOwnNamed" (load args)))]
                (al-free! [(dyn NodeOps)] (mut args))
                (parser-set-current-ctrl! (.ctrl stored))
                (scope-set-mem! scope (.mem stored))
                (lower-completion! (.value stored))
                0))
            (if (>= (.captured-owner ref) 0)
                (lower-environment-outer-store! (.captured-owner ref)
                                                (.name ref)
                                                value)
                (if (.bound ref)
                    (let [binding
                            (scope-var scope (scope-find scope (.name ref)))]
                      (if (.realm-constant binding)
                          (lower-throw-type-error! "Assignment to constant variable")
                          ;; A binding a nested function captures lives in this activation's environment.
                          (let [slot (scope-env-slot scope (.name ref))]
                            (if (>= slot 0)
                                (lower-environment-store! slot value)
                                (scope-update! scope (.name ref) value)))))
                    ;; A Script's lexical binding is the realm's: its slot where the initializer knows it,
                    ;; and by key from a function of the Script.
                    (if (syntax-script-binding? (.name ref))
                        (lower-script-binding-write! (.name ref) value)
                        (if (syntax-restricted-global? (.name ref))
                            ;; `undefined = 1`: silently ignored in sloppy code; a TypeError in strict code
                            ;; (the runtime's TypeError trap until exception objects exist).
                            (if (syntax-fun-strict (.current-fun (parser-state)))
                                (lower-throw-type-error! "Cannot assign to read only property")
                                0)
                            ;; Var-like globals are properties of the realm's global object; an undeclared
                            ;; name would create one at run time and refuses until that is implemented.
                            (if (>= (syntax-global-index (.name ref)) 0)
                                (lower-global-store! (.name ref) value)
                                (let [scope
                                        (parser-node (.current-scope (parser-state)))
                                      (mut wargs)
                                        (al-new [(dyn NodeOps)]
                                                (compiler-allocator))]
                                  (push! [(dyn NodeOps)]
                                         (mut wargs)
                                         (keyref-make (shape-key-intern (.name ref))))
                                  (push! [(dyn NodeOps)] (mut wargs) value)
                                  (let [w
                                          (jsl-lower-macro-values "JsUnresolvedGlobalWrite"
                                                                  (load wargs)
                                                                  (parser-node (.current-ctrl (parser-state)))
                                                                  (scope-mem scope))]
                                    (al-free! [(dyn NodeOps)] (mut wargs))
                                    (parser-set-current-ctrl! (.ctrl w))
                                    (scope-set-mem! scope (.mem w))
                                    0)))))))))))

(defn lower-ref-release! [(ref SyntaxRef)] (-> i64)
  (if (.object-binding ref) (n-unkeep! (parser-node (.resolved-nid ref))) 0)
  (if (.super ref) (n-unkeep! (parser-node (.receiver-nid ref))) 0)
  (if (or (.member ref) (.object-binding ref))
      (do
        (n-unkeep! (parser-node (.key-nid ref)))
        (n-unkeep! (parser-node (.owner-nid ref))))
      0))

;; Final Simple parseTrinary keeps the predicate, constructs both control projections, duplicates
;; Scope before either arm, retains arm values, then merges full Scopes and makes a Region Phi.
;; JavaScript differs in its result: && returns the original falsy operand, not Simple's zero.
;; || also retains its original truthy operand; ?? tests nullishness, not truthiness. Keep the
;; original value across both arm constructions, and merge memory so skipped RHS effects stay
;; skipped even after inlining, scheduling and GC lowering. There is no eager semantic call for
;; the operator itself: the predicate alone calls JSL, and the RHS lives on exactly one edge.
;; Logical assignment is the same diamond with PutValue on that same RHS edge.
(defn lower-short-circuit-core [(left (dyn NodeOps))
                                (predicate-name (slice u8))
                                (rhs-on-true bool)
                                (right-id i64)
                                (assign bool)
                                (ref SyntaxRef)] (-> (dyn NodeOps))
  (do
    (n-keep! left)
    (let [predicate (lower-js-unary left predicate-name)
          arms
            (if-arms! (if-make (parser-node (.current-ctrl (parser-state)))
                               predicate))
          rhs-scope (parser-node (.current-scope (parser-state)))
          skipped-scope (scope-dup rhs-scope false)]
      (parser-set-current-ctrl! (if rhs-on-true
                                    (arms-true arms)
                                    (arms-false arms)))
      (scope-set-ctrl! skipped-scope
                       (if rhs-on-true (arms-false arms) (arms-true arms)))
      (let [right (lower-syntax-expr right-id)]
        (n-keep! right)
        (if assign (lower-ref-put! ref right) 0)
        (let [merged
                (scope-merge! (parser-node (.current-scope (parser-state)))
                              skipped-scope)
              region (scope-ctrl merged)
              phi (phi-make region (ty-dyn TAG-ANY) "short-circuit")]
          (phi-add-value! phi right)
          (phi-add-value! phi left)
          (set! (.current-scope (parser-state)) (n-nid merged))
          (set! (.current-ctrl (parser-state)) (n-nid region))
          (n-unkeep! right)
          (n-unkeep! left)
          phi)))))

(defn lower-short-circuit [(left-id i64)
                           (right-id i64)
                           (predicate-name (slice u8))
                           (rhs-on-true bool)] (-> (dyn NodeOps))
  (lower-short-circuit-core (lower-syntax-expr left-id)
                            predicate-name
                            rhs-on-true
                            right-id
                            false
                            (primitive/zeroed SyntaxRef)))

(defn lower-logical-assignment [(predicate-name (slice u8))
                                (rhs-on-true bool)
                                (target i64)
                                (value i64)] (-> (dyn NodeOps))
  (let [ref (lower-ref-prepare! target)
        result
          (lower-short-circuit-core (lower-ref-get! ref)
                                    predicate-name
                                    rhs-on-true
                                    value
                                    true
                                    ref)]
    (lower-ref-release! ref)
    result))

(defn lower-singleton [(name (slice u8))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        args (al-new [(dyn NodeOps)] (compiler-allocator))
        result
          (jsl-lower-macro-values name
                                  args
                                  (scope-ctrl scope)
                                  (scope-mem scope))]
    (parser-set-current-ctrl! (.ctrl result))
    (scope-set-mem! scope (.mem result))
    (.value result)))

;; OrdinaryObjectCreate(%Object.prototype%) for a literal or a function's `prototype` object: the
;; raw object with %Object.prototype% as its [[Prototype]] when the realm materialized `Object`
;; (docs/DECISIONS.md, function objects), else the raw object whose prototype stays null.
(defn lower-fresh-ordinary-object [] (-> (dyn NodeOps))
  (lower-fresh-ordinary-object-layout SHAPE-EMPTY))

(defn lower-fresh-ordinary-object-layout [(layout i64)] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        raw
          (if (= layout SHAPE-EMPTY)
              (lower-jsl-nullary "JsNewObjectRaw")
              (let [(mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
                (push! (mut args) (con-int layout))
                (let [r
                        (jsl-lower-macro-values "JsNewObjectLiteralRaw"
                                                (load args)
                                                (parser-node (.current-ctrl (parser-state)))
                                                (scope-mem scope))]
                  (al-free! (mut args))
                  (parser-set-current-ctrl! (.ctrl r))
                  (scope-set-mem! scope (.mem r))
                  (.value r))))]
    (if (>= (parser-intrinsic-prototype-entry "Object.prototype") 0)
        (let [(mut sargs) (al-new [(dyn NodeOps)] (compiler-allocator))]
          (n-keep! raw)
          (push! [(dyn NodeOps)] (mut sargs) raw)
          (push! [(dyn NodeOps)]
                 (mut sargs)
                 (box-make (staticref-make (heap-intrinsic-entry "Object.prototype")
                                           REP-OBJECT)))
          (let [linked
                  (jsl-lower-macro-values "JsSetObjectLiteralPrototype"
                                          (load sargs)
                                          (parser-node (.current-ctrl (parser-state)))
                                          (scope-mem scope))]
            (al-free! [(dyn NodeOps)] (mut sargs))
            (parser-set-current-ctrl! (.ctrl linked))
            (scope-set-mem! scope (.mem linked))
            (n-unkeep! raw)
            (.value linked)))
        raw)))

;; Only fixed data keys participate in the private backing plan. Duplicates retain the first
;; slot and are still evaluated/stored every time. __proto__ is not an own data property.
;; Unsupported dynamic forms continue to refuse; this never approximates their semantics.
;; An accessor has no data slot: the plan stops at the first one, so every later key is added after
;; it, in source order, and insertion order stays what the definitions make it.
(defn lower-object-literal-layout [(entries (ArrayList ObjectEntry))] (-> i64)
  (let [(mut shape) SHAPE-EMPTY
        (mut planning) true]
    (al-for [entry entries]
            (match entry
              (PropValue [key value]
                         (match key
                           (KeyNamed [k]
                                     (if (or (not (load planning))
                                             (= (shape-key-name k) "__proto__"))
                                         0
                                         (do
                                           (set! (mut shape)
                                                 (shape-transition (load shape)
                                                                   (shape-key-name k)))
                                           0)))
                           ;; A computed key is not known here, so the fixed layout stops at it and every later
                           ;; definition is an ordinary one.
                           (KeyComputed [e] (do (set! (mut planning) false) 0))))
              (PropMethod [key fun]
                          (match key
                            (KeyNamed [k]
                                      (match (.kind (syntax-fun-ptr fun))
                                        (FunMethod []
                                                   (if (load planning)
                                                       (do
                                                         (set! (mut shape)
                                                               (shape-transition (load shape)
                                                                                 (shape-key-name k)))
                                                         0)
                                                       0))
                                        (_ (do (set! (mut planning) false) 0))))
                            (KeyComputed [e] (do (set! (mut planning) false) 0))))
              (PropSpread [expr] (do (set! (mut planning) false) 0))
              (PropCoverInit [name init]
                             (broken "lower-object-literal: CoverInitializedName survived validation"))))
    (load shape)))

(defn lower-object-literal [(entries (ArrayList ObjectEntry))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        created
          (lower-fresh-ordinary-object-layout (lower-object-literal-layout entries))
        (mut object-nid) (n-nid created)
        ;; Keys an accessor has defined so far: a later data definition of one replaces the accessor.
        (mut accessor-keys) (al-new [i64] (compiler-allocator))]
    (al-for [entry entries]
            (match entry
              (PropValue [prop-key value-id]
                         (match prop-key
                           ;; `[expr]: value` (§13.2.5.5): the key is evaluated and converted before
                           ;; the value, and the property is an ordinary definition.
                           (KeyComputed [e]
                                        (let [key (lower-literal-computed-key e)]
                                          (n-keep! key)
                                          (let [value
                                                  (lower-syntax-expr value-id)]
                                            (set! (mut object-nid)
                                                  (lower-literal-computed-data! (load object-nid)
                                                                                key
                                                                                value))
                                            (n-unkeep! key)
                                            0)))
                           (_ (let [key (lower-literal-named-key prop-key)
                                    value (lower-syntax-expr value-id)]
                                (set! (mut object-nid)
                                      (lower-literal-data! (load object-nid)
                                                           key
                                                           value
                                                           (load accessor-keys)))
                                0))))
              (PropMethod [prop-key fun]
                          (match prop-key
                            (KeyComputed [e]
                                         (let [key
                                                 (lower-literal-computed-key e)]
                                           (n-keep! key)
                                           (let [function
                                                   (lower-function-object fun)
                                                 setter
                                                   (match (.kind (syntax-fun-ptr fun))
                                                     (FunSetter [] 1)
                                                     (_ 0))
                                                 accessor
                                                   (match (.kind (syntax-fun-ptr fun))
                                                     (FunGetter [] true)
                                                     (FunSetter [] true)
                                                     (_ false))]
                                             (if accessor
                                                 (lower-literal-computed-accessor! (load object-nid)
                                                                                   key
                                                                                   function
                                                                                   setter)
                                                 (set! (mut object-nid)
                                                       (lower-literal-computed-data! (load object-nid)
                                                                                     key
                                                                                     function)))
                                             (n-unkeep! key)
                                             0)))
                            (_ (let [key (lower-literal-named-key prop-key)
                                     function (lower-function-object fun)]
                                 (match (.kind (syntax-fun-ptr fun))
                                   (FunMethod []
                                              (do
                                                (set! (mut object-nid)
                                                      (lower-literal-data! (load object-nid)
                                                                           key
                                                                           function
                                                                           (load accessor-keys)))
                                                0))
                                   (_ (let [setter
                                              (match (.kind (syntax-fun-ptr fun))
                                                (FunSetter [] 1)
                                                (_ 0))
                                            (mut args)
                                              (al-new [(dyn NodeOps)]
                                                      (compiler-allocator))]
                                        (push! [(dyn NodeOps)]
                                               (mut args)
                                               (parser-node (load object-nid)))
                                        (push! [(dyn NodeOps)]
                                               (mut args)
                                               (keyref-make key))
                                        (push! [(dyn NodeOps)]
                                               (mut args)
                                               function)
                                        (push! [(dyn NodeOps)]
                                               (mut args)
                                               (con-int setter))
                                        (let [r
                                                (lower-jsl-call-values "JsDefineLiteralAccessor"
                                                                       (load args))]
                                          (al-free! [(dyn NodeOps)] (mut args))
                                          (parser-set-current-ctrl! (.ctrl r))
                                          (scope-set-mem! scope (.mem r))
                                          (lower-completion! (.value r))
                                          (push! [i64] (mut accessor-keys) key)
                                          0))))))))
              (PropSpread [expr]
                          (let [source (lower-syntax-expr expr)]
                            (n-keep! source)
                            (let [target (match (arena-node (load object-nid))
                                           (Some [n] n)
                                           (None [] (unreachable-node)))]
                              (lower-completion!
                                (lower-jsl-values2 "JsCopyLiteralProperties" target source))
                              (n-unkeep! source)
                              0)))
              (PropCoverInit [name init]
                             (broken "lower-object-literal: CoverInitializedName survived validation"))))
    (al-free! [i64] (mut accessor-keys))
    (let [(mut finish-args) (al-new [(dyn NodeOps)] (compiler-allocator))]
      (push! [(dyn NodeOps)]
             (mut finish-args)
             (match (arena-node (load object-nid))
               (Some [n] n)
               (None [] (unreachable-node))))
      (let [finished
              (jsl-lower-macro-values "JsFinishObjectLiteral"
                                      (load finish-args)
                                      (parser-node (.current-ctrl (parser-state)))
                                      (scope-mem scope))]
        (.value finished)))))

(defn lower-literal-named-key [(prop-key PropKey)] (-> i64)
  (match prop-key
    (KeyNamed [k] k)
    (KeyComputed [e]
                 (do
                   (unimplemented "computed property keys"
                                  "docs/GAPS.md — property keys")
                   0))))

;; A computed key of an object literal: its value as a primitive, converted where it is written
;; (§13.2.5.5 step 1), so the interning at the definition cannot fail.
(defn lower-literal-computed-key [(expr i64)] (-> (dyn NodeOps))
  (lower-completion! (lower-jsl-values1 "JsComputedKeyPrimitive"
                                        (lower-syntax-expr expr))))

;; `[k]: value` and `[k]() {}`: an ordinary definition on the literal, whatever the key turns out to
;; be — a computed `__proto__` is a data property, not the literal's prototype.
(defn lower-literal-computed-data! [(object-nid i64)
                                    (key (dyn NodeOps))
                                    (value (dyn NodeOps))] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut args) (parser-node object-nid))
    (push! [(dyn NodeOps)] (mut args) key)
    (push! [(dyn NodeOps)] (mut args) value)
    (let [r (lower-jsl-values "JsDefineLiteralDataComputed" (load args))]
      (al-free! [(dyn NodeOps)] (mut args))
      (lower-completion! r)
      object-nid)))

(defn lower-literal-computed-accessor! [(object-nid i64)
                                        (key (dyn NodeOps))
                                        (function (dyn NodeOps))
                                        (setter i64)] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut args) (parser-node object-nid))
    (push! [(dyn NodeOps)] (mut args) key)
    (push! [(dyn NodeOps)] (mut args) function)
    (push! [(dyn NodeOps)] (mut args) (con-int setter))
    (let [r (lower-jsl-values "JsDefineLiteralAccessorComputed" (load args))]
      (al-free! [(dyn NodeOps)] (mut args))
      (lower-completion! r)
      0)))

;; `key: value` or `key() {}` on the literal under construction: CreateDataPropertyOrThrow, or
;; `__proto__: value`'s [[Prototype]]. The raw object node the next definition continues from.
(defn lower-literal-data! [(object-nid i64)
                           (key i64)
                           (value (dyn NodeOps))
                           (accessor-keys (ArrayList i64))] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))
        proto (= (shape-key-name key) "__proto__")
        (mut replaces) false
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (al-for [k accessor-keys] (if (= k key) (set! (mut replaces) true) 0))
    (push! [(dyn NodeOps)] (mut args) (parser-node object-nid))
    (if proto 0 (push! [(dyn NodeOps)] (mut args) (keyref-make key)))
    (push! [(dyn NodeOps)] (mut args) value)
    (if (and (load replaces) (not proto))
        ;; An accessor of this key was defined earlier in the literal.
        (let [r (lower-jsl-call-values "JsDefineLiteralData" (load args))]
          (al-free! [(dyn NodeOps)] (mut args))
          (parser-set-current-ctrl! (.ctrl r))
          (scope-set-mem! scope (.mem r))
          (lower-completion! (.value r))
          object-nid)
        (let [defined
                (jsl-lower-macro-values (if proto
                                            "JsSetObjectLiteralPrototype"
                                            "JsCreateDataPropertyNamed")
                                        (load args)
                                        (parser-node (.current-ctrl (parser-state)))
                                        (scope-mem scope))]
          (al-free! [(dyn NodeOps)] (mut args))
          (parser-set-current-ctrl! (.ctrl defined))
          (scope-set-mem! scope (.mem defined))
          (n-nid (.value defined))))))

;; ArrayLiteral (ECMA-262 §13.2.4.2): ArrayCreate(0), then each element is CreateDataProperty at the
;; next index and each elision advances the length; the JSL (`jsl/compiler/array.jsl`) owns every
;; step. Spread refuses by name until iteration exists.
(defn lower-array-literal [(elements (ArrayList ArrayElement))] (-> (dyn NodeOps))
  (let [(mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut args) (con-int 0))
    (let [scope (parser-node (.current-scope (parser-state)))
          created
            (jsl-lower-macro-values "JsNewArray"
                                    (load args)
                                    (parser-node (.current-ctrl (parser-state)))
                                    (scope-mem scope))
          (mut array-nid) (n-nid (.value created))
          (mut index) 0
          ;; Once a spread has run, the syntactic position no longer names the element's index.
          (mut spread-seen) false]
      (al-free! [(dyn NodeOps)] (mut args))
      (parser-set-current-ctrl! (.ctrl created))
      (scope-set-mem! scope (.mem created))
      (al-for [element elements]
              (do
                (match element
                  (ElemHole []
                            (let [(mut hargs)
                                    (al-new [(dyn NodeOps)]
                                            (compiler-allocator))
                                  scope2
                                    (parser-node (.current-scope (parser-state)))]
                              (push! [(dyn NodeOps)]
                                     (mut hargs)
                                     (parser-node (load array-nid)))
                              (let [r
                                      (jsl-lower-macro-values "JsArrayLiteralHole"
                                                              (load hargs)
                                                              (parser-node (.current-ctrl (parser-state)))
                                                              (scope-mem scope2))]
                                (al-free! [(dyn NodeOps)] (mut hargs))
                                (parser-set-current-ctrl! (.ctrl r))
                                (scope-set-mem! scope2 (.mem r))
                                (set! (mut array-nid) (n-nid (.value r))))))
                  (ElemExpr [expr]
                            (if (load spread-seen)
                                ;; After a spread the position is the array's own length.
                                (let [array (parser-node (load array-nid))]
                                  (n-keep! array)
                                  (let [value (lower-syntax-expr expr)
                                        appended
                                          (lower-completion! (lower-jsl-values2 "JsArrayAppend"
                                                                                array
                                                                                value))]
                                    (n-unkeep! array)
                                    (set! (mut array-nid) (n-nid appended))
                                    0))
                                (let [array (parser-node (load array-nid))]
                                  (n-keep! array)
                                  (let [value (lower-syntax-expr expr)
                                        (mut eargs)
                                          (al-new [(dyn NodeOps)]
                                                  (compiler-allocator))
                                        scope2
                                          (parser-node (.current-scope (parser-state)))]
                                    (n-keep! value)
                                    (push! [(dyn NodeOps)] (mut eargs) array)
                                    (push! [(dyn NodeOps)]
                                           (mut eargs)
                                           (con-int (load index)))
                                    (push! [(dyn NodeOps)] (mut eargs) value)
                                    (let [r
                                            (jsl-lower-macro-values "JsArrayLiteralElement"
                                                                    (load eargs)
                                                                    (parser-node (.current-ctrl (parser-state)))
                                                                    (scope-mem scope2))]
                                      (al-free! [(dyn NodeOps)] (mut eargs))
                                      (parser-set-current-ctrl! (.ctrl r))
                                      (scope-set-mem! scope2 (.mem r))
                                      (n-unkeep! value)
                                      (n-unkeep! array)
                                      (set! (mut array-nid) (n-nid (.value r))))))))
                  ;; `[...x]` (§13.2.4.2 step 5): the iterable is walked to exhaustion and each
                  ;; value appended, so the next element lands where the spread left off. That is
                  ;; also why a literal with a spread cannot use the fixed index above.
                  (ElemSpread [expr]
                              (let [array (parser-node (load array-nid))]
                                (n-keep! array)
                                (let [iterable (lower-syntax-expr expr)
                                      spread
                                        (lower-completion! (lower-jsl-values2 "JsArraySpreadInto"
                                                                              array
                                                                              iterable))]
                                  (n-unkeep! array)
                                  (set! (mut array-nid) (n-nid spread))
                                  (set! (mut spread-seen) true)
                                  0))))
                (set! (mut index) (+ (load index) 1))
                0))
      (parser-node (load array-nid)))))

;; Simple parseAddition/parseMultiplication attach the left operand to a new node before parsing
;; the right operand. Here JSL builds the operation after both values exist, so keep the left across
;; RHS Scope updates that could remove its last environment use; a local handle is insufficient.
(defn lower-syntax-binary [(left-id i64) (right-id i64) (name (slice u8))] (-> (dyn NodeOps))
  (do
    (lower-require-jsl! name)
    (let [left (lower-syntax-expr left-id)]
      (n-keep! left)
      (let [right (lower-syntax-expr right-id)
            result (lower-js-binary left right name)]
        (n-unkeep! left)
        ;; `lower-js-binary` tests the completion of every operator that can throw (`instanceof`,
        ;; `in`, and the ToPrimitive arms of arithmetic and comparison).
        result))))

(defn lower-conditional [(condition-id i64) (yes-id i64) (no-id i64)] (-> (dyn NodeOps))
  (let [condition (lower-js-truthy (lower-syntax-expr condition-id))
        iff (if-make (parser-node (.current-ctrl (parser-state))) condition)
        arms (if-arms! iff)
        true-scope (parser-node (.current-scope (parser-state)))
        false-scope (scope-dup true-scope false)]
    ;; A conditional expression is the same full Scope diamond as a statement `if`: calls in
    ;; either arm advance memory independently, so joining only control and the selected value
    ;; would let the following expression observe whichever arm happened to lower last.
    (scope-set-ctrl! true-scope (arms-true arms))
    (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
    (let [yes (lower-syntax-expr yes-id)
          yes-scope (parser-node (.current-scope (parser-state)))]
      ;; The true value is not an environment slot, so hold it while the false arm is lowered.
      ;; The true Scope owns its control and memory.
      (n-keep! yes)
      (set! (.current-scope (parser-state)) (n-nid false-scope))
      (scope-set-ctrl! false-scope (arms-false arms))
      (set! (.current-ctrl (parser-state)) (n-nid (arms-false arms)))
      (let [no (lower-syntax-expr no-id)]
        (n-keep! no)
        (let [merged (scope-merge! yes-scope false-scope)
              region (scope-ctrl merged)
              phi (phi-make region (ty-meet (n-ty yes) (n-ty no)) "conditional")]
          (phi-add-value! phi yes)
          (phi-add-value! phi no)
          (set! (.current-scope (parser-state)) (n-nid merged))
          (set! (.current-ctrl (parser-state)) (n-nid region))
          (n-unkeep! yes)
          (n-unkeep! no)
          phi)))))

;; A function object: an ordinary object's two words, the raw code word and a boxed environment
;; (null until closures exist), boxed under the FUNCTION prefix, with its fresh `prototype`
;; object (MakeConstructor). A hoisted declaration's object exists once per program run and lives
;; in the static heap image (`realm-image-build!`); every other function form allocates one per
;; evaluation, as the specification's InstantiateOrdinaryFunctionExpression does.
;; Why a record has no entry, named where it is used: the reason decides what to implement next.
(defn unimplemented-function-value [(fi i64)] (-> i64)
  (let [f (syntax-fun-at fi)]
    (if (.generator f)
        (unimplemented "a generator function as a value"
                       "docs/GAPS.md — generators")
        (if (.async f)
            (unimplemented "an async function as a value"
                           "docs/GAPS.md — promises and async functions")
            (unimplemented "a function record with no entry as a value"
                           "docs/GAPS.md — function values and closures")))))

(defn lower-function-object [(fun-index i64)] (-> (dyn NodeOps))
  (let [f (syntax-fun-at fun-index)]
    (if (>= (.static-entry f) 0)
        (box-make (staticref-make (.static-entry f) REP-FUNCTION))
        (if (.needs-home (syntax-fun-ptr fun-index))
            ;; MakeMethod (§10.2.7) gives a method its home object. Only a class defines one here;
            ;; an object literal's methods and an arrow's inherited `super` wait.
            (do
              (unimplemented "`super` outside a class method"
                             "docs/GAPS.md — classes")
              (unreachable-node))
            ;; A function that mentions a captured binding carries the environment it was created
            ;; in; every other one has none (docs/DECISIONS.md, closures).
            (lower-function-value fun-index
                                  (if (.uses-env (syntax-fun-ptr fun-index))
                                      (lower-environment-value)
                                      (dyn-null-make)))))))

;; A method's function object, carrying its home object (§10.2.7 MakeMethod): the class's prototype
;; object, or the constructor for a static member. `super.x` reads from the object above it.
(defn lower-method-object [(fun-index i64) (home (dyn NodeOps))] (-> (dyn NodeOps))
  (let [f (syntax-fun-at fun-index)]
    (if (>= (.static-entry f) 0)
        (do
          (broken "lower-method-object: a method with a home object was built into the image")
          (unreachable-node))
        (lower-function-value fun-index home))))

;; InstantiateOrdinaryFunctionExpression over a record's public entry, with the environment word a
;; method's home object fills and every other function value leaves null.
(defn lower-function-value [(fun-index i64) (env (dyn NodeOps))] (-> (dyn NodeOps))
  (if (not (syntax-fun-lowered? fun-index))
      (do
        (unimplemented-function-value fun-index)
        (unreachable-node))
      (let [scope (parser-node (.current-scope (parser-state)))
            ctrl (parser-node (.current-ctrl (parser-state)))
            flags (syntax-fun-construct-flags fun-index)
            made
              (lower-allocate-function ctrl
                                       (scope-mem scope)
                                       fun-index
                                       (lower-function-prototype-word)
                                       env
                                       (con-int flags))]
        (scope-set-mem! scope (.mem made))
        ;; A function with [[Construct]] gets MakeConstructor's `prototype`; an arrow does not, and
        ;; a class constructor receives the class's own prototype object instead (§15.7.14 step 15).
        (if (and (!= (& flags FUNCTION-FLAG-CONSTRUCTOR) 0)
                 (not (.class-ctor (syntax-fun-ptr fun-index))))
            (lower-make-constructor! (.ptr made) (.fnobj made))
            0)
        (.fnobj made))))

(defstruct FunctionAllocation
  [(ptr (dyn NodeOps)) (fnobj (dyn NodeOps)) (mem (dyn NodeOps))])

;; %Function.prototype% when the realm materialized `Function`, else null: every source function
;; object's [[Prototype]].
(defn lower-function-prototype-word [] (-> (dyn NodeOps))
  (if (>= (parser-intrinsic-prototype-entry "Function.prototype") 0)
      (box-make (staticref-make (heap-intrinsic-entry "Function.prototype")
                                REP-OBJECT))
      (dyn-null-make)))

;; A fresh function object for record `fun-index`'s public entry: [[Prototype]] `proto`, no properties, the entry's code word, the environment
;; word `env` and the FUNCTION-FLAG-* word `flags`. A source function value's environment is null; a
;; built-in closure's is what `%MakeClosure` passed.
(defn lower-allocate-function [(ctrl (dyn NodeOps))
                               (mem (dyn NodeOps))
                               (fun-index i64)
                               (proto (dyn NodeOps))
                               (env (dyn NodeOps))
                               (flags (dyn NodeOps))] (-> FunctionAllocation)
  (n-keep! proto)
  (n-keep! env)
  (n-keep! flags)
  (let [f (syntax-fun-at fun-index)
        target (parser-node (.adapter-nid f))
        fp (syntax-fun-ptr fun-index)
        fresh
          (new-make ctrl
                    (con-int FUNCTION-PAYLOAD-BYTES)
                    mem
                    SHAPE-EMPTY
                    (ty-struct "JsFunctionPayload"))
        ptr_ (proj-make fresh 0 "function.ptr")
        private (proj-make fresh 1 "function.private-memory")
        prototype-state
          (store-make ctrl
                      private
                      ptr_
                      (con-int OFFSET-OBJECT-PROTOTYPE)
                      proto
                      ALIAS-OBJECT-PROTOTYPE
                      (ty-dyn TAG-ANY))
        properties-state
          (store-make ctrl
                      prototype-state
                      ptr_
                      (con-int OFFSET-OBJECT-PROPERTIES)
                      (dyn-null-make)
                      ALIAS-OBJECT-PROPERTIES
                      (ty-dyn TAG-ANY))
        code-state
          (store-make ctrl
                      properties-state
                      ptr_
                      (con-int OFFSET-FUNCTION-CODE)
                      (funptr-make target (.adapter-fidx f))
                      ALIAS-FUNCTION-CODE
                      (parser-value-funptr-ty))
        env-state
          (store-make ctrl
                      code-state
                      ptr_
                      (con-int OFFSET-FUNCTION-ENV)
                      env
                      ALIAS-FUNCTION-ENV
                      (ty-dyn TAG-ANY))
        flags-state
          (store-make ctrl
                      env-state
                      ptr_
                      (con-int OFFSET-FUNCTION-FLAGS)
                      flags
                      ALIAS-FUNCTION-FLAGS
                      (ty-int-bot))
        merged (memmerge-make)]
    (n-unkeep! proto)
    (n-unkeep! env)
    (n-unkeep! flags)
    (memmerge-set-alias! merged ALIAS-BULK mem)
    (memmerge-set-alias! merged ALIAS-OBJECT-PROTOTYPE prototype-state)
    (memmerge-set-alias! merged ALIAS-OBJECT-PROPERTIES properties-state)
    (memmerge-set-alias! merged ALIAS-FUNCTION-CODE code-state)
    (memmerge-set-alias! merged ALIAS-FUNCTION-ENV env-state)
    (memmerge-set-alias! merged ALIAS-FUNCTION-FLAGS flags-state)
    ;; The pointer now escapes into a value: the Fun is never inlined away from under its
    ;; address. Closed-world callers supply argument evidence; at the external boundary,
    ;; materialization also keeps the generic adapter's unknown-caller hook.
    (set! (.value-taken fp) true)
    (fun-set-escapes! target)
    (FunctionAllocation
      :ptr ptr_
      :fnobj (box-make-rep-at (Some ctrl) ptr_ REP-FUNCTION)
      :mem merged)))

;; The JSL lowering's closure maker (`jsl-set-closure-maker!`): `(%MakeClosure "%Entry%" env flags)`
;; materializes the declared entry if the realm has not, then allocates its function object.
(defn parser-jsl-make-closure [(bytes (ptr u8))
                               (n i64)
                               (ctrl i64)
                               (mem i64)
                               (proto i64)
                               (env i64)
                               (flags i64)] (-> i64)
  (let [name (slice-new [u8] bytes n)
        table (intrinsic-table)
        row (intrinsic-index table name)]
    (if (< row 0)
        (panic "parser-jsl-make-closure: %MakeClosure names no declared entry")
        0)
    (let [declared (get table row)]
      (if (!= (.target declared) INTRINSIC-TARGET-ENTRY)
          (panic "parser-jsl-make-closure: %MakeClosure names an intrinsic that is not an entry")
          0))
    (if (< (syntax-find-entry-fun name) 0)
        (if (= (.lower-start (parser-state)) 0)
            (panic "parser-jsl-make-closure: a closure was made before the program's passes")
            (do (parser-materialize-intrinsic! (get table row)) 0))
        0)
    (let [fi (syntax-find-entry-fun name)
          made
            (lower-allocate-function (parser-node ctrl)
                                     (parser-node mem)
                                     fi
                                     (parser-node proto)
                                     (parser-node env)
                                     (parser-node flags))]
      (jsl-closure-set-memory! (n-nid (.mem made)))
      (n-nid (.fnobj made)))))

;; MakeConstructor (§10.2.5) on a freshly allocated function object: a fresh `prototype` object whose
;; `constructor` is the function, stored writable only on the raw function object.
(defn lower-make-constructor! [(ptr_ (dyn NodeOps)) (fnobj (dyn NodeOps))] (-> i64)
  (do
    (n-keep! fnobj)
    (let [proto-raw (lower-fresh-ordinary-object)
          (mut cargs) (al-new [(dyn NodeOps)] (compiler-allocator))]
      (n-keep! proto-raw)
      (push! [(dyn NodeOps)] (mut cargs) proto-raw)
      (push! [(dyn NodeOps)]
             (mut cargs)
             (keyref-make (shape-key-intern "constructor")))
      (push! [(dyn NodeOps)] (mut cargs) fnobj)
      (let [scope2 (parser-node (.current-scope (parser-state)))
            defined
              (jsl-lower-macro-values "JsCreateDataPropertyNamed"
                                      (load cargs)
                                      (parser-node (.current-ctrl (parser-state)))
                                      (scope-mem scope2))]
        (al-free! [(dyn NodeOps)] (mut cargs))
        (parser-set-current-ctrl! (.ctrl defined))
        (scope-set-mem! scope2 (.mem defined))
        (let [proto
                (lower-jsl-unary-value "JsFinishObjectLiteral"
                                       (.value defined))
              (mut pargs) (al-new [(dyn NodeOps)] (compiler-allocator))]
          (n-keep! proto)
          ;; MakeConstructor (§10.2.5): `prototype` is writable, not enumerable, not
          ;; configurable, on the raw fresh function object.
          (push! [(dyn NodeOps)] (mut pargs) ptr_)
          (push! [(dyn NodeOps)]
                 (mut pargs)
                 (keyref-make (shape-key-intern "prototype")))
          (push! [(dyn NodeOps)] (mut pargs) proto)
          (push! [(dyn NodeOps)]
                 (mut pargs)
                 (con-int SHAPE-ATTR-WRITABLE))
          (let [scope3 (parser-node (.current-scope (parser-state)))
                stored
                  (jsl-lower-macro-values "JsCreateDataPropertyAttrs"
                                          (load pargs)
                                          (parser-node (.current-ctrl (parser-state)))
                                          (scope-mem scope3))]
            (al-free! [(dyn NodeOps)] (mut pargs))
            (parser-set-current-ctrl! (.ctrl stored))
            (scope-set-mem! scope3 (.mem stored))
            (n-unkeep! proto)
            (n-unkeep! proto-raw)
            (n-unkeep! fnobj)
            0))))))

;; Call through a value. The callee and every actual are evaluated first, as the specification
;; orders them; then a FUNCTION guard either loads the code word and calls through the shared
;; ABI or hands the value to the runtime's abrupt-completion entry (a TypeError once exceptions
;; exist). Both arms merge as an ordinary Scope diamond.
;; ---------------------------------------------------------------------------
;; Exceptions: a sentinel completion and ordinary control flow (docs/DECISIONS.md, exceptions are
;; a sentinel completion)

;; The innermost catch target, or -1 when a throw leaves the function.
(defn parser-find-catch [] (-> i64)
  (let [p (parser-state)
        (mut i) (- (len (.jump-targets p)) 1)
        (mut found) -1]
    (loop (if (or (< (load i) 0) (>= (load found) 0))
              (break 0)
              (let [target (get (.jump-targets p) (load i))]
                (if (= (.kind target) JUMP-CATCH)
                    (set! (mut found) (load i))
                    (set! (mut i) (- (load i) 1)))
                (continue))))
    (load found)))

;; Carry `value` to the catch target `index`: bind the synthetic exception variable, then take the
;; same Scope-merging jump a `break` takes to a labeled block.
(defn lower-jump-to-catch! [(index i64) (value (dyn NodeOps))] (-> i64)
  (lower-jump-to-target! index (Some value)))

;; The nearest enclosing finally target, or -1.
(defn parser-find-finally [] (-> i64)
  (let [p (parser-state)
        (mut i) (- (len (.jump-targets p)) 1)
        (mut found) -1]
    (loop (if (or (< (load i) 0) (>= (load found) 0))
              (break 0)
              (let [target (get (.jump-targets p) (load i))]
                (if (= (.kind target) JUMP-FINALLY)
                    (set! (mut found) (load i))
                    (set! (mut i) (- (load i) 1)))
                (continue))))
    (load found)))

;; `return v`, or the propagation of an uncaught exception: inside a try with a finally block the
;; completion is recorded in the finally's variables and control jumps to the block; otherwise it
;; is the function's Return.
(defn lower-return-completion! [(value (dyn NodeOps))] (-> i64)
  (let [index (parser-find-finally)]
    (if (>= index 0)
        (let [scope (parser-node (.current-scope (parser-state)))]
          (n-keep! value)
          (parser-note-completion! index COMPLETION-RETURN)
          (scope-update! scope FINALLY-KIND-VAR (con-int COMPLETION-RETURN))
          (scope-update! scope FINALLY-VALUE-VAR value)
          (lower-jump-to-target! index (None [(dyn NodeOps)]))
          (n-unkeep! value)
          0)
        (parser-record-return! (lower-constructor-return value)))))

;; A thrown value leaving the current point (docs/DECISIONS.md, exceptions are a sentinel
;; completion): to the nearest try as a Scope jump (its catch, or its finally as a throw
;; completion); with no try around it, into the pending word, and the function completes with the
;; exception sentinel, which every caller tests.
(defn lower-throw-value! [(value (dyn NodeOps))] (-> i64)
  (let [catch-index (parser-find-catch)
        finally-index (parser-find-finally)]
    (n-keep! value)
    (if (>= catch-index 0)
        (lower-jump-to-catch! catch-index value)
        (if (>= finally-index 0)
            (let [scope (parser-node (.current-scope (parser-state)))]
              (parser-note-completion! finally-index COMPLETION-THROW)
              (scope-update! scope FINALLY-KIND-VAR (con-int COMPLETION-THROW))
              (scope-update! scope FINALLY-VALUE-VAR value)
              (lower-jump-to-target! finally-index (None [(dyn NodeOps)])))
            (do
              (lower-pending-store! value)
              (parser-note-propagation!)
              (parser-record-return! (dyn-exception-make)))))
    (n-unkeep! value)
    0))

;; The function being lowered can complete with the sentinel. The syntactic filter must have said
;; so, or a direct caller was built without its test (`syntax-fun-may-throw?`).
(defn parser-note-propagation! [] (-> i64)
  (do (set! (.propagates (parser-state)) true) 0))

;; Take the Scope-merging jump a `break` takes to target `index`, binding the synthetic exception
;; variable first when a value is carried.
(defn lower-jump-to-target! [(index i64) (value (Option (dyn NodeOps)))] (-> i64)
  (let [p (parser-state)
        scope (parser-node (.current-scope p))
        target (get (.jump-targets p) index)
        exit (parser-node (.scope target))
        outgoing (scope-dup scope false)
        depth (len (.levels (scope-node exit)))]
    (parser-set-current-ctrl! (xctrl-make))
    (loop (if (<= (len (.levels (scope-node outgoing))) depth)
              (break 0)
              (do (scope-pop! outgoing) (continue))))
    ;; Bind the carried value AFTER unwinding to the target's depth: a nested try's own level holds
    ;; another binding of the same synthetic name, and updating before the pops filled that one.
    (match value
      (Some [v] (scope-update! outgoing EXCEPTION-VAR v))
      (None [] 0))
    (scope-merge! exit outgoing)
    (let [meta (al-elem [JumpTarget] (mut (.jump-targets p)) index)]
      (set! (.count meta) (+ (.count meta) 1)))
    0))

;; The pending word of the runtime heap record: the thrown value while a throw unwinds.
(defn lower-pending-store! [(value (dyn NodeOps))] (-> i64)
  (let [p (parser-state)
        scope (parser-node (.current-scope p))
        mem (scope-mem scope)
        stored
          (store-make (parser-node (.current-ctrl p))
                      mem
                      (heapstate-make)
                      (con-int RT-HEAP-OFFSET-EXCEPTION-VALUE)
                      value
                      ALIAS-EXCEPTION-VALUE
                      (ty-dyn TAG-ANY))
        merged (memmerge-make)]
    (memmerge-set-alias! merged ALIAS-BULK (mem-effective mem ALIAS-BULK))
    (if (= (n-op mem) OP-MEMMERGE)
        (let [(mut a) 2]
          (loop (if (>= (load a) (n-nins mem))
                    (break 0)
                    (do
                      (match (n-in mem (load a))
                        (Some [slice]
                              (if (= (load a) ALIAS-EXCEPTION-VALUE)
                                  0
                                  (memmerge-set-alias! merged (load a) slice)))
                        (None [] 0))
                      (set! (mut a) (+ (load a) 1))
                      (continue)))))
        0)
    (memmerge-set-alias! merged ALIAS-EXCEPTION-VALUE stored)
    (scope-set-mem! scope merged)
    0))

(defn lower-pending-load [] (-> (dyn NodeOps))
  (let [p (parser-state)
        scope (parser-node (.current-scope p))]
    (load-make (parser-node (.current-ctrl p))
               (scope-mem scope)
               (heapstate-make)
               (con-int RT-HEAP-OFFSET-EXCEPTION-VALUE)
               ALIAS-EXCEPTION-VALUE
               (ty-dyn TAG-ANY))))

;; `throw v`: inside a try, a jump to its catch; otherwise set the pending word and leave the
;; function with undefined.
(defn lower-throw [(value-id i64)] (-> i64)
  (do
    (lower-throw-value! (lower-syntax-expr value-id))
    1))

;; After a call or operation whose result may be the exception sentinel: one TypeTest on the
;; result. On the exceptional arm the thrown value leaves the pending word (cleared) for the
;; enclosing try, or the function completes with the sentinel itself; the normal arm continues
;; with the result narrowed to a JavaScript value. The arm ends dead, so the merge keeps only the
;; normal continuation. Where the result's type already excludes the sentinel there is nothing to
;; test, and every call and throwing operation is asked: SCCP is the may-throw analysis. (A
;; syntactic may-throw fixpoint used to decide which calls were asked; it missed operators that
;; throw, and a missed site let the sentinel escape as a value. Nothing decides but the type.)
(defn lower-exception-check! [(value (dyn NodeOps))] (-> (dyn NodeOps))
  (let [p (parser-state)
        t (n-ty value)
        tags
          (match (ty-kind t)
            (TDyn [bits high int] (if high TAG-COMPLETION bits))
            (_ TAG-COMPLETION))]
    (if (= (primitive/iand tags TAG-EXCEPTION) 0)
        value
        (let [iff
                (if-make (parser-node (.current-ctrl p))
                         (typetest-make value TAG-EXCEPTION))
              arms (if-arms! iff)
              normal (parser-node (.current-scope p))
              unwinding (scope-dup normal false)]
          (n-keep! value)
          (set! (.current-scope p) (n-nid unwinding))
          (scope-set-ctrl! unwinding (arms-true arms))
          (set! (.current-ctrl p) (n-nid (arms-true arms)))
          (if (or (>= (parser-find-catch) 0) (>= (parser-find-finally) 0))
              (let [thrown (lower-pending-load)]
                (n-keep! thrown)
                (lower-pending-store! (con-int 0))
                (lower-throw-value! thrown)
                (n-unkeep! thrown))
              (do
                (parser-note-propagation!)
                (parser-record-return! (dyn-exception-make))))
          (let [taken (parser-node (.current-scope p))
                narrowed
                  (cast-make (arms-false arms)
                             value
                             (ty-dyn (primitive/iand tags
                                                     (primitive/ixor TAG-COMPLETION
                                                                     TAG-EXCEPTION))))]
            (n-keep! narrowed)
            (scope-set-ctrl! normal (arms-false arms))
            (let [merged (scope-merge! normal taken)]
              (set! (.current-scope p) (n-nid merged))
              (set! (.current-ctrl p) (n-nid (scope-ctrl merged)))
              (n-unkeep! narrowed)
              (n-unkeep! value)
              narrowed))))))

;; `try { body } catch (e) { handler } finally { tail }`. The catch target is a Scope with the
;; synthetic exception variable; every throw and unwinding call in the body merges into it. The
;; handler binds `e` from that variable in its own level. `finally` runs after the normal merge;
;; an abrupt completion crossing it refuses by name.
(defn lower-try [(body i64)
                 (catch-param (Option i64))
                 (catch-body (Option i64))
                 (finally-body (Option i64))] (-> i64)
  (let [p (parser-state)
        scope (parser-node (.current-scope p))
        has-finally (match finally-body (Some [_] true) (None [] false))]
    (scope-push! scope)
    (scope-define! scope
                   EXCEPTION-VAR
                   (ty-dyn TAG-ANY)
                   false
                   (dyn-undefined-make))
    ;; With a finally block, every abrupt completion of the body or handler records its kind and
    ;; value here and jumps to the block; the normal path arrives with kind 0.
    (if has-finally
        (do
          (scope-define! scope
                         FINALLY-KIND-VAR
                         (ty-int-bot)
                         false
                         (con-int COMPLETION-NORMAL))
          (scope-define! scope
                         FINALLY-VALUE-VAR
                         (ty-dyn TAG-ANY)
                         false
                         (dyn-undefined-make))
          (let [fin-exit (scope-dup scope false)]
            (scope-set-ctrl! fin-exit (xctrl-make))
            (parser-push-jump! fin-exit JUMP-FINALLY)))
        0)
    (let [exit (scope-dup (parser-node (.current-scope p)) false)]
      (scope-set-ctrl! exit (xctrl-make))
      (parser-push-jump! exit JUMP-CATCH)
      (let [terminated (lower-syntax-statement body)
            target (parser-pop-jump!)
            after-body (parser-node (.current-scope p))]
        (match catch-body
          (None []
                ;; No catch: a throw out of the body runs the finally block with a throw completion.
                (if (> (.count target) 0)
                    (if has-finally
                        (do
                          (lower-throw-completion-into-finally! exit)
                          (parser-use-scope! after-body))
                        (unimplemented "try/finally without catch (rethrow through finally)"
                                       "docs/GAPS.md — exceptions"))
                    0))
          (Some [handler]
                (do
                  ;; The handler runs in the merged throw Scope with `e` bound in a fresh level. With a
                  ;; finally block its own throws land in a second catch target that feeds the block.
                  (parser-use-scope! exit)
                  (scope-push! exit)
                  (match catch-param
                    (Some [pattern]
                          (match (syntax-pattern-node pattern)
                            (PatName [name]
                                     (scope-define! (parser-node (.current-scope p))
                                                    name
                                                    (ty-dyn TAG-ANY)
                                                    false
                                                    (match (scope-lookup (parser-node (.current-scope p))
                                                                         EXCEPTION-VAR)
                                                      (Some [thrown] thrown)
                                                      (None []
                                                            (unreachable-node)))))
                            ;; `catch ({message})`: the thrown value is what the pattern binds from.
                            (_ (lower-pattern-bind! pattern
                                                    (match (scope-lookup (parser-node (.current-scope p))
                                                                         EXCEPTION-VAR)
                                                      (Some [thrown] thrown)
                                                      (None [] (unreachable-node)))
                                                    PATTERN-PARAM))))
                    (None [] 0))
                  (let [rethrow
                          (scope-dup (parser-node (.current-scope p)) false)]
                    (scope-set-ctrl! rethrow (xctrl-make))
                    (if has-finally (parser-push-jump! rethrow JUMP-CATCH) 0)
                    (lower-syntax-statement handler)
                    (if has-finally
                        (let [rethrow-target (parser-pop-jump!)
                              handler-scope (parser-node (.current-scope p))]
                          (if (> (.count rethrow-target) 0)
                              (do
                                (scope-pop! rethrow)
                                (lower-throw-completion-into-finally! rethrow))
                              0)
                          (parser-use-scope! handler-scope))
                        0))
                  (scope-pop! (parser-node (.current-scope p)))
                  (let [merged
                          (scope-merge! after-body
                                        (parser-node (.current-scope p)))]
                    (parser-use-scope! merged)))))
        (match finally-body
          (Some [tail]
                (let [fin-target (parser-pop-jump!)
                      normal (parser-node (.current-scope p))]
                  (if (!= (.kind fin-target) JUMP-FINALLY)
                      (broken "lower-try: the finally target is not on top of the jump stack")
                      0)
                  ;; Every completion meets here: the normal path (kind 0), returns (kind 1) and
                  ;; throws (kind 2). The block runs once over the merge, then the completion resumes.
                  (parser-use-scope! (scope-merge! normal
                                                   (parser-node (.scope fin-target))))
                  (lower-syntax-statement tail)
                  (lower-finally-dispatch! fin-target)
                  0))
          (None [] 0))
        (scope-pop! (parser-node (.current-scope p)))
        (if (and (!= terminated 0) (= (.count target) 0) (not has-finally)) 1 0)))))

;; Arrivals at a catch-like target that has no handler of its own (a try/finally without catch,
;; or a throw inside the handler) continue as a throw completion into the finally block.
(defn lower-throw-completion-into-finally! [(arrivals (dyn NodeOps))] (-> i64)
  (let [p (parser-state)
        index (parser-find-finally)]
    (parser-use-scope! arrivals)
    (let [thrown
            (match (scope-lookup arrivals EXCEPTION-VAR)
              (Some [v] v)
              (None [] (unreachable-node)))]
      (n-keep! thrown)
      (parser-note-completion! index COMPLETION-THROW)
      (scope-update! arrivals FINALLY-KIND-VAR (con-int COMPLETION-THROW))
      (scope-update! arrivals FINALLY-VALUE-VAR thrown)
      (lower-jump-to-target! index (None [(dyn NodeOps)]))
      (n-unkeep! thrown)
      0)))

;; After the finally block: resume the recorded completion. Each arm is a Scope diamond whose taken
;; side ends dead (a return or a throw severs control), so the merge keeps only the normal path.
;; Only the kinds some path recorded into this target get an arm: a block nothing throws into has
;; no throw arm, so it emits no propagation path (and the may-throw filter's guard stays honest).
(defn lower-finally-dispatch! [(target JumpTarget)] (-> i64)
  (do
    (if (!= (primitive/iand (.completions target)
                            (primitive/ishl 1 COMPLETION-RETURN))
            0)
        (lower-completion-arm! COMPLETION-RETURN)
        0)
    (if (!= (primitive/iand (.completions target)
                            (primitive/ishl 1 COMPLETION-THROW))
            0)
        (lower-completion-arm! COMPLETION-THROW)
        0)
    0))

;; A completion of `kind` is recorded into the finally target `index`.
(defn parser-note-completion! [(index i64) (kind i64)] (-> i64)
  (let [meta (al-elem [JumpTarget] (mut (.jump-targets (parser-state))) index)]
    (set! (.completions meta)
          (primitive/ior (.completions meta) (primitive/ishl 1 kind)))
    0))

(defn lower-completion-arm! [(kind i64)] (-> i64)
  (let [p (parser-state)
        normal (parser-node (.current-scope p))
        kind-value
          (match (scope-lookup normal FINALLY-KIND-VAR)
            (Some [v] v)
            (None [] (unreachable-node)))
        iff
          (if-make (parser-node (.current-ctrl p))
                   (eq-make kind-value (con-int kind)))
        arms (if-arms! iff)
        taken (scope-dup normal false)]
    (set! (.current-scope p) (n-nid taken))
    (scope-set-ctrl! taken (arms-true arms))
    (set! (.current-ctrl p) (n-nid (arms-true arms)))
    (let [value
            (match (scope-lookup taken FINALLY-VALUE-VAR)
              (Some [v] v)
              (None [] (unreachable-node)))]
      (if (= kind COMPLETION-RETURN)
          (lower-return-completion! value)
          (lower-throw-value! value)))
    (let [ended (parser-node (.current-scope p))]
      (scope-set-ctrl! normal (arms-false arms))
      (let [merged (scope-merge! normal ended)]
        (set! (.current-scope p) (n-nid merged))
        (set! (.current-ctrl p) (n-nid (scope-ctrl merged)))
        0))))

;; A call through a value with `this` = undefined: a plain `f(...)`.
(defn lower-value-call [(callee (dyn NodeOps))
                        (args (ArrayList i64))
                        (label (slice u8))] (-> (dyn NodeOps))
  (lower-value-call-with-receiver callee
                                  (dyn-undefined-make)
                                  (dyn-undefined-make)
                                  args
                                  (lower-callee-message label
                                                        " is not a function")))

;; The TypeError message for a call through a non-callable: the callee as the source spelled it
;; (`f`, `o.m`, `this.x`, `a[…]`), as engines report it, so a failing program names its callee.
(defn lower-callee-message [(label (slice u8)) (suffix (slice u8))] (-> (slice u8))
  (let [(mut sb) (sb-new (compiler-allocator))]
    (sb-push-str! (mut sb) label)
    (sb-push-str! (mut sb) suffix)
    (sb-str (mut sb))))

;; A callee expression's spelling for that message. Only the shapes a message can name usefully
;; are spelled; anything else is `value`.
(defn syntax-callee-label [(id i64)] (-> (slice u8))
  (match (syntax-node (syntax-ungroup-id id))
    (SxName [name] name)
    (SxThis [] "this")
    (SxMember [owner name optional]
              (lower-callee-message (lower-callee-message (syntax-callee-label owner)
                                                          ".")
                                    name))
    (SxIndex [owner key optional]
             (lower-callee-message (syntax-callee-label owner) "[...]"))
    (SxCall [callee args optional]
            (lower-callee-message (syntax-callee-label callee) "(...)"))
    (_ "value")))

;; A call through a value. `receiver` becomes the callee's `this` slot; sloppy functions map an
;; undefined receiver to the global object at their entry (JsSloppyThis). `new-target` is the
;; callee's `new.target` slot: undefined for a call, the constructor for `new` (lower-new).
;; `message` is the TypeError's text when the callee is not callable.
(defn lower-value-call-with-receiver [(callee (dyn NodeOps))
                                      (receiver (dyn NodeOps))
                                      (new-target (dyn NodeOps))
                                      (args (ArrayList i64))
                                      (message (slice u8))] (-> (dyn NodeOps))
  (let [(mut actuals) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (n-keep! callee)
    (n-keep! receiver)
    (n-keep! new-target)
    (al-for [a args]
            (let [v (lower-syntax-expr a)]
              (n-keep! v)
              (push! [(dyn NodeOps)] (mut actuals) v)))
    (let [result
            (lower-value-call-with-receiver-values callee
                                                   receiver
                                                   new-target
                                                   (load actuals)
                                                   message)]
      (al-for [v (load actuals)] (n-unkeep! v))
      (n-unkeep! new-target)
      (n-unkeep! receiver)
      (n-unkeep! callee)
      (al-free! (mut actuals))
      result)))

;; The call itself, over actuals the caller already evaluated in source order and keeps alive.
(defn lower-value-call-with-receiver-values [(callee (dyn NodeOps))
                                             (receiver (dyn NodeOps))
                                             (new-target (dyn NodeOps))
                                             (actuals (ArrayList (dyn NodeOps)))
                                             (message (slice u8))] (-> (dyn NodeOps))
  (let [(mut operands) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (let [scope (parser-node (.current-scope (parser-state)))
          packed (callabi-pack! (scope-ctrl scope) (scope-mem scope) actuals)]
      (scope-set-mem! scope (.memory packed))
      (push! [(dyn NodeOps)] (mut operands) callee)
      (push! [(dyn NodeOps)] (mut operands) receiver)
      (push! [(dyn NodeOps)] (mut operands) new-target)
      (push! [(dyn NodeOps)] (mut operands) (.count packed))
      (push! [(dyn NodeOps)] (mut operands) (.vector packed))
      (al-for [v (.direct packed)] (push! [(dyn NodeOps)] (mut operands) v))
      (push! [(dyn NodeOps)] (mut operands) (lower-ascii-string message))
      ;; The shared JSL body owns unknown callable dispatch and error construction. A proven
      ;; function needs neither; expose its ordinary code-pointer call for optimization.
      ;; The caller owns exactly one completion check, after all argument evaluation.
      (let [t (n-ty callee)
            r
              (if (and (not (ty-high? t)) (ty-isa? t (ty-dyn TAG-FUNCTION)))
                  (let [code
                          (load-make (scope-ctrl scope)
                                     (scope-mem scope)
                                     (unbox-make callee REP-FUNCTION)
                                     (con-int OFFSET-FUNCTION-CODE)
                                     ALIAS-FUNCTION-CODE
                                     (parser-value-funptr-ty))
                        end
                          (callabi-invoke! (scope-ctrl scope)
                                           (scope-mem scope)
                                           code
                                           callee
                                           receiver
                                           new-target
                                           packed)]
                    (jsl-expr-result (proj-make end
                                                RETURN-VALUE
                                                "value-call.value")
                                     (cproj-make end
                                                 RETURN-CTRL
                                                 "value-call.ctrl")
                                     (proj-make end RETURN-MEM "value-call.mem")))
                  (lower-jsl-call-values "JsInvokeCallable" (load operands)))]
        (parser-set-current-ctrl! (.ctrl r))
        (scope-set-mem! scope (.mem r))
        (let [result (lower-completion! (.value r))]
          (al-free! (mut operands))
          result)))))

;; The completion of a JSL operation that may throw (a property access on undefined or null is a
;; TypeError raised inside JsGetNamed): tested for the sentinel, which is nothing when the operand
;; types already folded the throwing arm away.
(defn lower-completion! [(result (dyn NodeOps))] (-> (dyn NodeOps))
  (lower-exception-check! result))

;; The language raising a TypeError at a source site: JsThrowTypeError with the message returns
;; the sentinel, and the check unwinds it at once.
(defn lower-throw-type-error! [(message (slice u8))] (-> i64)
  (let [(mut values) (al-new [(dyn NodeOps)] (compiler-allocator))
        text (lower-ascii-string message)]
    (n-keep! text)
    (push! [(dyn NodeOps)] (mut values) text)
    (let [scope (parser-node (.current-scope (parser-state)))
          r (lower-jsl-call-values "JsThrowTypeError" (load values))]
      (n-unkeep! text)
      (al-free! [(dyn NodeOps)] (mut values))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (lower-exception-check! (.value r))
      0)))

(defn lower-ascii-string [(text (slice u8))] (-> (dyn NodeOps))
  (let [(mut units) (al-new [i64] (compiler-allocator))
        (mut i) 0]
    (loop (if (>= (load i) (len text))
              (break 0)
              (do
                (push! [i64]
                       (mut units)
                       (primitive/cast i64 (get text (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [scope (parser-node (.current-scope (parser-state)))
          lowered
            (jsl-lower-string-units (load units)
                                    (parser-node (.current-ctrl (parser-state)))
                                    (scope-mem scope))]
      (al-free! [i64] (mut units))
      (parser-set-current-ctrl! (.ctrl lowered))
      (scope-set-mem! scope (.mem lowered))
      (box-make-at (Some (.ctrl lowered)) (.value lowered)))))

;; A JSL macro with no arguments at the current point.
(defn lower-jsl-nullary [(name (slice u8))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))
        r
          (jsl-lower-macro-values name
                                  (load args)
                                  (parser-node (.current-ctrl (parser-state)))
                                  (scope-mem scope))]
    (al-free! [(dyn NodeOps)] (mut args))
    (parser-set-current-ctrl! (.ctrl r))
    (scope-set-mem! scope (.mem r))
    (.value r)))

;; A JSL definition over one value at the current point. Its declaration chooses
;; macro expansion versus an ordinary evidence-gated builtin call.
(defn lower-jsl-unary-value [(name (slice u8)) (value (dyn NodeOps))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut args) value)
    (let [r
            (match (jsl-definition-form name)
              (None []
                    (do
                      (panic "lower-jsl-unary-value: unknown JSL definition")
                      (jsl-expr-result (unreachable-node)
                                       (parser-node (.current-ctrl (parser-state)))
                                       (scope-mem scope))))
              (Some [form]
                    (if (jsl-form-macro? form)
                        (jsl-lower-macro-values name
                                                (load args)
                                                (parser-node (.current-ctrl (parser-state)))
                                                (scope-mem scope))
                        (lower-jsl-call-values name (load args)))))]
      (al-free! [(dyn NodeOps)] (mut args))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (.value r))))

;; A call to a JSL builtin over already-lowered values, threaded through the current Scope.
(defn lower-jsl-call-values [(name (slice u8))
                             (values (ArrayList (dyn NodeOps)))] (-> JslExprResult)
  (let [scope (parser-node (.current-scope (parser-state)))
        target (jsl-call-target name)
        c
          (call-make-with-mem (parser-node (.current-ctrl (parser-state)))
                              (scope-mem scope))]
    (al-for [v values] (call-add-arg! c v))
    (call-set-fptr! c target)
    (let [end (callend-make c)]
      (if (jsl-noinline? name) (callend-set-never-inline! end) 0)
      (jsl-expr-result (proj-make end RETURN-VALUE "jsl.call.value")
                       (cproj-make end RETURN-CTRL "jsl.call.ctrl")
                       (proj-make end RETURN-MEM "jsl.call.mem")))))

;; `o[k]`: a runtime key; refuses at run time until keys intern and arrays exist.
(defn lower-keyed-read [(owner-id i64) (key-id i64)] (-> (dyn NodeOps))
  (let [owner (lower-syntax-expr owner-id)]
    (n-keep! owner)
    (let [k (lower-syntax-expr key-id)
          answer (lower-value-keyed-read owner k)]
      (n-unkeep! owner)
      answer)))

;; The same read over an owner and key the caller already evaluated and keeps alive.
(defn lower-value-keyed-read [(owner (dyn NodeOps)) (k (dyn NodeOps))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (n-keep! owner)
    (n-keep! k)
    (push! [(dyn NodeOps)] (mut args) owner)
    (push! [(dyn NodeOps)] (mut args) k)
    (let [r (lower-jsl-call-values "JsGetKeyed" (load args))]
      (al-free! [(dyn NodeOps)] (mut args))
      (n-unkeep! k)
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (let [checked (lower-completion! (.value r))]
        (n-unkeep! owner)
        checked))))

(defn lower-keyed-call [(owner-id i64) (key-id i64) (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [owner (lower-syntax-expr owner-id)]
    (n-keep! owner)
    (let [k (lower-syntax-expr key-id)
          scope (parser-node (.current-scope (parser-state)))
          (mut margs) (al-new [(dyn NodeOps)] (compiler-allocator))]
      (n-keep! k)
      (push! [(dyn NodeOps)] (mut margs) owner)
      (push! [(dyn NodeOps)] (mut margs) k)
      (let [r (lower-jsl-call-values "JsGetKeyed" (load margs))]
        (al-free! [(dyn NodeOps)] (mut margs))
        (n-unkeep! k)
        (parser-set-current-ctrl! (.ctrl r))
        (scope-set-mem! scope (.mem r))
        (let [checked (lower-completion! (.value r))
              answer
                (lower-value-call-with-receiver checked
                                                owner
                                                (dyn-undefined-make)
                                                args
                                                (lower-callee-message (lower-callee-message (syntax-callee-label owner-id)
                                                                                            "[...]")
                                                                      " is not a function"))]
          (n-unkeep! owner)
          answer)))))

;; `new F(args)` (EvaluateNew, ECMA-262 §13.3.5.1.1): F, then every argument, in source order; then
;; JsConstructReceiver refuses a value without [[Construct]] with the TypeError and gives the
;; receiver (a fresh object from F's `prototype` for an ordinary base constructor, undefined for a
;; built-in one); F runs with that receiver and itself as `new.target`, and JsConstructResult keeps
;; an object it returned, else the receiver. The semantics are JSL; this only orders evaluation.
(defn lower-new [(callee-id i64) (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [callee (lower-syntax-expr callee-id)
        (mut actuals) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (n-keep! callee)
    (al-for [a args]
            (let [v (lower-syntax-expr a)]
              (n-keep! v)
              (push! [(dyn NodeOps)] (mut actuals) v)))
    (let [scope (parser-node (.current-scope (parser-state)))
          message
            (lower-ascii-string (lower-callee-message (syntax-callee-label callee-id)
                                                      " is not a constructor"))
          (mut cargs) (al-new [(dyn NodeOps)] (compiler-allocator))]
      (push! [(dyn NodeOps)] (mut cargs) callee)
      (push! [(dyn NodeOps)] (mut cargs) message)
      (let [prepared (lower-jsl-call-values "JsConstructReceiver" (load cargs))]
        (al-free! [(dyn NodeOps)] (mut cargs))
        (parser-set-current-ctrl! (.ctrl prepared))
        (scope-set-mem! scope (.mem prepared))
        (let [receiver (lower-completion! (.value prepared))]
          (n-keep! receiver)
          (let [returned
                  (lower-value-call-with-receiver-values callee
                                                         receiver
                                                         callee
                                                         (load actuals)
                                                         (lower-callee-message (syntax-callee-label callee-id)
                                                                               " is not a constructor"))
                (mut rargs) (al-new [(dyn NodeOps)] (compiler-allocator))]
            (n-keep! returned)
            (push! [(dyn NodeOps)] (mut rargs) returned)
            (push! [(dyn NodeOps)] (mut rargs) receiver)
            (let [scope2 (parser-node (.current-scope (parser-state)))
                  result
                    (jsl-lower-macro-values "JsConstructResult"
                                            (load rargs)
                                            (parser-node (.current-ctrl (parser-state)))
                                            (scope-mem scope2))]
              (al-free! [(dyn NodeOps)] (mut rargs))
              (parser-set-current-ctrl! (.ctrl result))
              (scope-set-mem! scope2 (.mem result))
              (n-unkeep! returned)
              (n-unkeep! receiver)
              (al-for [v (load actuals)] (n-unkeep! v))
              (al-free! (mut actuals))
              (n-unkeep! callee)
              (.value result))))))))

;; `o.m(args)`: the owner is evaluated once and is both the property base and the receiver.
(defn lower-member-call [(owner-id i64)
                         (name (slice u8))
                         (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [owner (lower-syntax-expr owner-id)]
    (n-keep! owner)
    (let [scope (parser-node (.current-scope (parser-state)))
          (mut margs) (al-new [(dyn NodeOps)] (compiler-allocator))]
      (push! [(dyn NodeOps)] (mut margs) owner)
      (push! [(dyn NodeOps)] (mut margs) (keyref-make (shape-key-intern name)))
      (let [loaded (lower-jsl-call-values "JsGetNamed" (load margs))]
        (al-free! [(dyn NodeOps)] (mut margs))
        (parser-set-current-ctrl! (.ctrl loaded))
        (scope-set-mem! scope (.mem loaded))
        (let [checked (lower-completion! (.value loaded))
              answer
                (lower-value-call-with-receiver checked
                                                owner
                                                (dyn-undefined-make)
                                                args
                                                (lower-callee-message (lower-callee-message (lower-callee-message (syntax-callee-label owner-id)
                                                                                                                  ".")
                                                                                            name)
                                                                      " is not a function"))]
          (n-unkeep! owner)
          answer)))))

;; `this`: the receiver slot of the enclosing non-arrow function, mapped for sloppy code; the
;; global object at a Script's top level. An arrow's `this` is a capture of its enclosing
;; function's and waits for closures.
;; `new.target`: the second argument slot of the enclosing non-arrow function — undefined when it
;; was called, the constructor when it was constructed (docs/DECISIONS.md, new.target is an argument
;; slot). The parser refused it outside a function; an arrow's is a capture and waits for closures.
(defn lower-new-target [] (-> (dyn NodeOps))
  (let [p (parser-state)
        f (syntax-fun-at (.current-fun p))]
    (if (syntax-script-root? (.current-fun p))
        (do
          (panic "lower-new-target: new.target at a Script root (the parser admits it only in a function)")
          (unreachable-node))
        (match (.kind f)
          (FunArrow []
                    (do
                      (unimplemented "arrow function `new.target` (a capture of the enclosing function's)"
                                     "docs/GAPS.md — function values and closures")
                      (unreachable-node)))
          (_ (let [fun (parser-node (.fun-nid f))]
               (match (fun-parm fun 1)
                 (Some [t] t)
                 (None [] (unreachable-node)))))))))

(defn lower-this [] (-> (dyn NodeOps))
  (let [p (parser-state)
        f (syntax-fun-at (.current-fun p))]
    (if (.derived-ctor (syntax-fun-ptr (.current-fun p)))
        ;; A derived constructor's `this` is the binding `super()` initializes, in its dead zone
        ;; until then (§9.1.1.3.4).
        (lower-completion! (lower-jsl-values1 "JsRequireThisInitialized"
                                              (lower-derived-this-value (.current-fun p))))
        (if (syntax-script-root? (.current-fun p))
            (lower-global-object)
            (match (.kind f)
              ;; An arrow's `this` is the receiver of the function around it, read from the
              ;; environment that function put it in (docs/DECISIONS.md, closures).
              (FunArrow []
                        (let [owner (syntax-receiver-owner (.current-fun p))]
                          (if (< owner 0)
                              (do
                                (unimplemented "arrow function `this` outside every function"
                                               "docs/GAPS.md — function values and closures")
                                (unreachable-node))
                              (lower-environment-outer owner THIS-CAPTURE-SLOT))))
              (_ (let [fun (parser-node (.fun-nid f))
                       receiver
                         (match (fun-parm fun 0)
                           (Some [r] r)
                           (None [] (unreachable-node)))]
                   (if (.strict f)
                       receiver
                       (let [scope (parser-node (.current-scope p))
                             (mut margs)
                               (al-new [(dyn NodeOps)] (compiler-allocator))]
                         (push! [(dyn NodeOps)] (mut margs) receiver)
                         (let [mapped
                                 (jsl-lower-macro-values (if (.script-mode p)
                                                             "JsSloppyThis"
                                                             "JsSloppyThisNoRealm")
                                                         (load margs)
                                                         (parser-node (.current-ctrl p))
                                                         (scope-mem scope))]
                           (al-free! [(dyn NodeOps)] (mut margs))
                           (parser-set-current-ctrl! (.ctrl mapped))
                           (scope-set-mem! scope (.mem mapped))
                           (.value mapped)))))))))))

;; FunctionDeclarations at the top level of a function body are var-like bindings initialized
;; with their function objects on entry (FunctionDeclarationInstantiation).
(defn lower-bind-body-functions! [(stmts (ArrayList i64))] (-> i64)
  (do
    (al-for [id stmts]
            (match (syntax-stmt-node id)
              (SsFunctionDecl [fun]
                              (let [f (syntax-fun-at fun)]
                                (if (.hoisted f)
                                    0
                                    (lower-binding-write! (.name f)
                                                          (lower-function-object fun)))))
              (_ 0)))
    0))

(defn lower-member-read [(owner-id i64) (name (slice u8))] (-> (dyn NodeOps))
  (lower-value-member-read (lower-syntax-expr owner-id) name))

;; The same read from an owner the caller already evaluated: what a `?.` link needs, since a chain
;; evaluates its base once and then applies link after link to the value it holds.
(defn lower-value-member-read [(owner (dyn NodeOps)) (name (slice u8))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut args) owner)
    (push! [(dyn NodeOps)] (mut args) (keyref-make (shape-key-intern name)))
    (let [lowered (lower-jsl-call-values "JsGetNamed" (load args))]
      (al-free! [(dyn NodeOps)] (mut args))
      (parser-set-current-ctrl! (.ctrl lowered))
      (scope-set-mem! scope (.mem lowered))
      (lower-completion! (.value lowered)))))


;; ---------------------------------------------------------------------------
;; Optional chains (ECMA-262 §13.3.9)
;;
;; `a?.b.c(d)` evaluates `a` once; if it is null or undefined the WHOLE chain is undefined and
;; nothing after the `?.` runs — not the `.c` read, not the call, not `d`. Skipping the rest of the
;; chain rather than one link is why a chain lowers as a list rather than by recursion on the
;; syntax tree: each `?.` opens a diamond whose nullish arm is an arrival at one merge past the
;; last link, the way `break` arrives at a loop's exit. The chain's base is the operand of its
;; first `?.`, lowered by the ordinary walk, so a direct call or a `super` base keeps its lowering.
(defstruct ChainState
  [(value (dyn NodeOps))
   ;; The `this` a call link uses: the base of the member access it follows, undefined otherwise.
   (receiver (dyn NodeOps))
   ;; The Scope every short-circuited arm has arrived in, by nid; -1 before the first `?.`.
   (arrivals i64)])

;; The links of a chain, innermost first. The returned id is the chain's base.
(defn syntax-chain-links! [(id i64) (out (mut (ArrayList i64)))] (-> i64)
  (let [base
          (match (syntax-node id)
            (SxMember [owner name optional]
                      (if optional owner (syntax-chain-links! owner (mut out))))
            (SxIndex [owner key optional]
                     (if optional owner (syntax-chain-links! owner (mut out))))
            (SxCall [callee args optional]
                    (if optional callee (syntax-chain-links! callee (mut out))))
            (SxPrivateMember [owner name optional]
                             (unimplemented "private class members" "docs/GAPS.md — classes"))
            (_ (broken "syntax-chain-links!: a chain link that is not a member, index or call")))]
    (push! [i64] (mut out) id)
    base))

(defn syntax-chain-link-optional? [(id i64)] (-> bool)
  (match (syntax-node id)
    (SxMember [owner name optional] optional)
    (SxIndex [owner key optional] optional)
    (SxCall [callee args optional] optional)
    (_ false)))

(defn lower-optional-chain [(id i64)] (-> (dyn NodeOps))
  (let [(mut links) (al-new [i64] (compiler-allocator))
        base-id (syntax-chain-links! id (mut links))
        (mut state) (primitive/zeroed ChainState)]
    (set! (.value (mut state)) (lower-syntax-expr base-id))
    (set! (.receiver (mut state)) (dyn-undefined-make))
    (set! (.arrivals (mut state)) -1)
    (let [final (lower-chain-links (load links) 0 (load state))]
      (al-free! [i64] (mut links))
      (lower-chain-merge final))))

(defn lower-chain-links [(links (ArrayList i64))
                         (i i64)
                         (state ChainState)] (-> ChainState)
  (if (>= i (len links))
      state
      (lower-chain-links links (+ i 1) (lower-chain-link (get links i) state))))

;; One link: its `?.` guard, then the read or the call it performs.
(defn lower-chain-link [(link i64) (state ChainState)] (-> ChainState)
  (let [value (.value state)
        receiver (.receiver state)]
    (n-keep! value)
    (n-keep! receiver)
    (let [arrivals
            (if (syntax-chain-link-optional? link)
                (lower-chain-guard value (.arrivals state))
                (.arrivals state))
          (mut next) (primitive/zeroed ChainState)]
      (set! (.arrivals (mut next)) arrivals)
      (match (syntax-node link)
        (SxMember [owner name optional]
                  (do
                    (set! (.receiver (mut next)) value)
                    (set! (.value (mut next)) (lower-value-member-read value name))
                    0))
        (SxIndex [owner key optional]
                 (let [k (lower-syntax-expr key)]
                   (set! (.receiver (mut next)) value)
                   (set! (.value (mut next)) (lower-value-keyed-read value k))
                   0))
        (SxCall [callee args optional]
                (do
                  (set! (.value (mut next))
                        (if (syntax-args-have-spread? args)
                            (lower-spread-call value receiver args)
                            (lower-value-call-with-receiver value
                                                            receiver
                                                            (dyn-undefined-make)
                                                            args
                                                            (lower-callee-message (syntax-callee-label callee)
                                                                                  " is not a function"))))
                  (set! (.receiver (mut next)) (dyn-undefined-make))
                  0))
        (_ (broken "lower-chain-link: a chain link that is not a member, index or call")))
      (n-unkeep! receiver)
      (n-unkeep! value)
      (load next))))

;; A `?.` whose base is nullish leaves the chain here, carrying the Scope it left in to the merge.
(defn lower-chain-guard [(value (dyn NodeOps)) (arrivals i64)] (-> i64)
  (let [predicate (lower-js-unary value "JsNullish")
        arms
          (if-arms! (if-make (parser-node (.current-ctrl (parser-state)))
                             predicate))
        live (parser-node (.current-scope (parser-state)))
        skipped (scope-dup live false)]
    (parser-set-current-ctrl! (arms-false arms))
    (scope-set-ctrl! skipped (arms-true arms))
    (if (< arrivals 0)
        (do
          (n-keep! skipped)
          (n-nid skipped))
        ;; A chain with several `?.` merges their arms as they appear. The value is undefined on
        ;; every one of them, so only the Scope needs a Phi here.
        (let [prior (parser-node arrivals)]
          (scope-merge! prior skipped)
          arrivals))))

;; Past the last link: the chain's value on the live path, undefined on every short-circuited one.
(defn lower-chain-merge [(state ChainState)] (-> (dyn NodeOps))
  (if (< (.arrivals state) 0)
      (do
        (broken "lower-chain-merge: an optional chain with no `?.`")
        (.value state))
      (let [value (.value state)
            live (parser-node (.current-scope (parser-state)))
            arrivals (parser-node (.arrivals state))]
        (n-keep! value)
        ;; The merge kills the arrivals Scope, which a kept node refuses.
        (n-unkeep! arrivals)
        (let [merged (scope-merge! live arrivals)
              region (scope-ctrl merged)
              phi (phi-make region (ty-dyn TAG-ANY) "optional-chain")]
          (phi-add-value! phi value)
          (phi-add-value! phi (dyn-undefined-make))
          (set! (.current-scope (parser-state)) (n-nid merged))
          (set! (.current-ctrl (parser-state)) (n-nid region))
          (n-unkeep! value)
          phi))))

(defn lower-named-call [(name (slice u8)) (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [bound
          (or (>= (scope-find (parser-node (.current-scope (parser-state)))
                              name)
                  0)
              (syntax-script-binding? name)
              (syntax-enclosing-binding? (.current-fun (parser-state)) name))
        global (syntax-global-index name)
        ;; A realm global is a direct call only when nothing ever assigns the name; a plain
        ;; function-entry program keeps its hoisted declarations.
        target-idx
          (if bound
              -1
              (if (>= global 0)
                  (syntax-global-direct-fun global)
                  (syntax-find-fun name)))]
    (if (or bound
            (< target-idx 0)
            (and (>= target-idx 0)
                 (or (syntax-fun-forwarding? target-idx)
                     ;; Its entry fills a hidden slot from the call itself: the callee it was called
                     ;; with (its environment, its home object), an arguments object, a rest array.
                     (.needs-callee (syntax-fun-ptr target-idx))
                     (match (syntax-fun-hidden-builtin target-idx)
                       (Some [b] true)
                       (None [] false)))))
        ;; A binding, not a hoisted declaration, a forwarding entry (it has no local body to call
        ;; directly) or a function whose entry fills a hidden slot from the call itself (an
        ;; arguments object, a rest parameter): call through whatever value it holds.
        (lower-value-call (lower-name name) args name)
        (let [target-syntax (syntax-fun-at target-idx)
              target (parser-node (.fun-nid target-syntax))
              scope (parser-node (.current-scope (parser-state)))
              c
                (call-make-with-mem (parser-node (.current-ctrl (parser-state)))
                                    (scope-mem scope))
              formal-count (parser-abi-slots)
              (mut i) 0]
          ;; An intrinsic's body sees exactly the arguments it declares; a longer argument list
          ;; would be dropped silently, so it refuses by name instead.
          (if (syntax-intrinsic-fun? target-idx)
              (let [table (intrinsic-table)
                    entry
                      (get table (intrinsic-index table (.name target-syntax)))]
                (if (> (len args) (.arity entry))
                    (unimplemented "more arguments than the intrinsic admits (the slot ABI carries no argument count)"
                                   "docs/GAPS.md — intrinsics")
                    0))
              0)
          ;; JavaScript evaluates every actual left-to-right. The shared ABI carries `this`,
          ;; `new.target` (undefined: this is a call) and the program-wide slot count: extra
          ;; actuals still run for effects, while omitted slots receive the canonical boxed undefined.
          (call-add-arg! c (dyn-undefined-make))
          (call-add-arg! c (dyn-undefined-make))
          (loop (if (>= (load i) (len args))
                    (break 0)
                    (do
                      (let [actual (lower-syntax-expr (get args (load i)))]
                        (if (< (load i) formal-count)
                            (call-add-arg! c actual)
                            0))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (loop (if (>= (load i) formal-count)
                    (break 0)
                    (do
                      (call-add-arg! c (dyn-undefined-make))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (n-set-def! c
                      CALL-CTRL
                      (Some (parser-node (.current-ctrl (parser-state)))))
          (n-set-def! c
                      CALL-MEM
                      (Some (scope-mem (parser-node (.current-scope (parser-state))))))
          (call-set-fptr! c (funptr-make target (.fidx target-syntax)))
          (let [end (callend-make c)]
            (let [ctrl (cproj-make end RETURN-CTRL "call.ctrl")]
              (parser-set-current-ctrl! ctrl))
            (scope-set-mem! (parser-node (.current-scope (parser-state)))
                            (proj-make end RETURN-MEM "call.mem"))
            (let [value (proj-make end RETURN-VALUE "call.value")]
              ;; The callee's completion: tested when the filter says the callee may throw; else
              ;; the filter's proof narrows the result to a value (the Cast folds once SCCP
              ;; sharpens the callee's return type).
              (if (syntax-fun-may-throw? target-idx)
                  (lower-exception-check! value)
                  (cast-make (parser-node (.current-ctrl (parser-state)))
                             value
                             (ty-dyn TAG-ANY)))))))))

;; Final Simple parseAsgn recursively parses the RHS, updates the lexical Scope and returns the
;; assigned value. opAssign keeps the old value across RHS parsing, then computes and updates.
;; Here syntax preserves the Reference until this walk. Evaluate its base once, GetValue before
;; a compound RHS, and PutValue after the JSL arithmetic call. Reacquire the current Scope after
;; each expression: a conditional/short-circuit RHS can replace it. Keeps protect reference/value
;; nodes across that replacement.
;; The delete operator (§13.5.1.2), one JSL entry per form of the operand, which keeps its Reference
;; through parentheses: a property Reference is ToObject and [[Delete]] with the site's strictness
;; (`JsDeleteNamed`, `JsDeleteKeyed`); a name is DeleteBinding on the environment that resolves it
;; (strict code rejects `delete name` early); anything else is evaluated and is true.
(defn lower-delete [(operand i64)] (-> (dyn NodeOps))
  (let [target (syntax-ungroup-id operand)
        strict (if (syntax-fun-strict (.current-fun (parser-state))) 1 0)]
    (match (syntax-node target)
      (SxMember [owner name optional]
                (if optional
                    (do
                      (unimplemented "delete of an optional chain"
                                     "docs/GAPS.md — nullish short-circuit chains")
                      (unreachable-node))
                    (let [base (lower-syntax-expr owner)]
                      (lower-delete-call "JsDeleteNamed"
                                         base
                                         (keyref-make (shape-key-intern name))
                                         strict))))
      (SxIndex [owner key optional]
               (if optional
                   (do
                     (unimplemented "delete of an optional chain"
                                    "docs/GAPS.md — nullish short-circuit chains")
                     (unreachable-node))
                   (let [base (lower-syntax-expr owner)]
                     (n-keep! base)
                     (let [k (lower-syntax-expr key)]
                       (n-unkeep! base)
                       (lower-delete-call "JsDeleteKeyed" base k strict)))))
      (SxPrivateMember [owner name optional]
                       (do
                         (unimplemented "private class members"
                                        "docs/GAPS.md — classes")
                         (unreachable-node)))
      (SxName [name] (lower-delete-name name))
      (_ (do (lower-syntax-expr operand) (lower-singleton "JsTrue"))))))

(defn lower-delete-call [(entry (slice u8))
                         (base (dyn NodeOps))
                         (key (dyn NodeOps))
                         (strict i64)] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut args) base)
    (push! [(dyn NodeOps)] (mut args) key)
    (push! [(dyn NodeOps)] (mut args) (con-int strict))
    (let [r (lower-jsl-call-values entry (load args))]
      (al-free! [(dyn NodeOps)] (mut args))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (lower-completion! (.value r)))))

;; `delete name` in sloppy code. A function's or a block's binding, an enclosing function's, a
;; Script's lexical binding and the global `undefined`, `NaN` and `Infinity` are never deletable,
;; and nothing is evaluated. A retained unit resolves the name in the executing realm first
;; (`JsGlobalReferenceDelete`). A closed program deletes from its global object — a declared var or
;; function refuses there, being non-configurable, and an unresolvable name answers true — except an
;; intrinsic's binding, whose reads this compilation folds to the intrinsic itself.
(defn lower-delete-name [(name (slice u8))] (-> (dyn NodeOps))
  (let [p (parser-state)]
    (if (and (= name "arguments") (not (syntax-script-root? (.current-fun p))))
        (unimplemented "implicit arguments object binding"
                       "docs/GAPS.md — function objects")
        0)
    (if (or (>= (scope-find (parser-node (.current-scope p)) name) 0)
            (syntax-enclosing-binding? (.current-fun p) name)
            (syntax-script-binding? name)
            (syntax-restricted-global? name))
        (lower-singleton "JsFalse")
        (if (.external-mutation p)
            (let [(mut ref) (primitive/zeroed SyntaxRef)]
              (lower-ref-name-prepare! (mut ref) name)
              (lower-delete-global-reference (load ref)))
            (if (and (< (syntax-global-index name) 0)
                     (>= (syntax-find-fun name) 0)
                     (syntax-intrinsic-fun? (syntax-find-fun name)))
                (do
                  (unimplemented "delete of an intrinsic's global binding in a closed program"
                                 "docs/GAPS.md — property deletion")
                  (unreachable-node))
                (lower-delete-call "JsDeleteNamed"
                                   (lower-global-object)
                                   (keyref-make (shape-key-intern name))
                                   0))))))

(defn lower-delete-global-reference [(ref SyntaxRef)] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut args) (parser-node (.owner-nid ref)))
    (push! [(dyn NodeOps)] (mut args) (parser-node (.key-nid ref)))
    (push! [(dyn NodeOps)] (mut args) (parser-node (.resolved-nid ref)))
    (let [r
            (jsl-lower-macro-values "JsGlobalReferenceDelete"
                                    (load args)
                                    (scope-ctrl scope)
                                    (scope-mem scope))]
      (al-free! [(dyn NodeOps)] (mut args))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (let [value (lower-completion! (.value r))]
        (n-keep! value)
        (lower-ref-release! ref)
        (n-unkeep! value)
        value))))

(defn lower-assignment [(op (slice u8)) (target i64) (value-id i64)] (-> (dyn NodeOps))
  (let [compound (!= op "")
        ref (lower-ref-prepare! target)
        (mut old-nid) 0]
    (if compound
        (do
          (lower-require-jsl! op)
          (let [old (lower-ref-get! ref)]
            (n-keep! old)
            (set! (mut old-nid) (n-nid old))))
        0)
    (let [rhs (lower-syntax-expr value-id)
          value
            (if compound
                (lower-js-binary (parser-node (load old-nid)) rhs op)
                rhs)]
      (n-keep! value)
      (if compound (n-unkeep! (parser-node (load old-nid))) 0)
      (lower-ref-put! ref value)
      (lower-ref-release! ref)
      (n-unkeep! value)
      value)))

;; UpdateExpression: oldValue = ToNumeric(GetValue(ref)); newValue = oldValue ± 1; PutValue;
;; the result is newValue for a prefix operator and oldValue (already numeric) for a postfix one.
(defn lower-update [(op (slice u8)) (prefix bool) (target i64)] (-> (dyn NodeOps))
  (let [ref (lower-ref-prepare! target)
        old (lower-js-unary (lower-ref-get! ref) "JsPositive")]
    (n-keep! old)
    (let [new (lower-js-unary old op)]
      (n-keep! new)
      (lower-ref-put! ref new)
      (lower-ref-release! ref)
      (n-unkeep! new)
      (n-unkeep! old)
      (if prefix new old))))

;; Source provenance is a scoped construction context. Nested expressions temporarily narrow it;
;; after they return, the enclosing operator regains its complete expression range. Node inputs and
;; later graph rewrites merge these ranges, so optimization does not erase attribution.
(defn lower-syntax-expr [(id i64)] (-> (dyn NodeOps))
  (let [x (syntax-at id)
        origin
          (n-origin-enter! (match (.node x)
                             (SxCall [callee args optional] "call")
                             (SxNew [callee args] "construct")
                             (SxMember [owner name optional] "named-read")
                             (SxIndex [owner key optional] "keyed-read")
                             (SxName [name] "binding-read")
                             (SxObject [properties] "object-literal")
                             (SxArray [elements] "array-literal")
                             (_ "expression"))
                           "frontend"
                           (.lo x)
                           (.hi x))
        old-lo (n-source-context-lo)
        old-hi (n-source-context-hi)]
    (n-source-context-set! (.lo x) (.hi x))
    (let [answer
            (match (.node x)
              ;; A source literal is a JavaScript value. The raw integer exists only inside its
              ;; Box and may reappear after a proven JSL Unbox cancels that Box during
              ;; specialization.
              (SxNumber [value value-float rep]
                        (box-make-at (Some (parser-node (.current-ctrl (parser-state))))
                                     (if (= rep REP-INT)
                                         (con-int value)
                                         (con-flt value-float))))
              (SxString [raw units legacy]
                        (let [scope
                                (parser-node (.current-scope (parser-state)))
                              lowered
                                (jsl-lower-string-units units
                                                        (parser-node (.current-ctrl (parser-state)))
                                                        (scope-mem scope))]
                          (parser-set-current-ctrl! (.ctrl lowered))
                          (scope-set-mem! scope (.mem lowered))
                          (box-make-at (Some (.ctrl lowered)) (.value lowered))))
              (SxName [name] (lower-name name))
              (SxSingleton [name] (lower-singleton name))
              (SxGroup [inner] (lower-syntax-expr inner))
              (SxObject [entries] (lower-object-literal entries))
              (SxArray [elements] (lower-array-literal elements))
              (SxMember [owner name optional]
                        (if (syntax-optional-chain? id)
                            (lower-optional-chain id)
                            (if (syntax-is-super? owner)
                                (lower-super-read id)
                                (lower-member-read owner name))))
              (SxIndex [owner key optional]
                       (if (syntax-optional-chain? id)
                           (lower-optional-chain id)
                           (if (syntax-is-super? owner)
                               (lower-super-read id)
                               (lower-keyed-read owner key))))
              (SxCall [callee args optional]
                      (if (syntax-optional-chain? id)
                          (lower-optional-chain id)
                          (if (syntax-args-have-spread? args)
                              ;; A spread makes the argument count a runtime question: the call
                              ;; takes an argument array (§13.3.8.1).
                              (match (syntax-node (syntax-ungroup-id callee))
                                (SxMember [owner member optional]
                                          (lower-spread-member-call owner
                                                                    (lower-member-key member)
                                                                    args))
                                (SxIndex [owner key optional]
                                         (lower-spread-member-call owner
                                                                   (lower-syntax-expr key)
                                                                   args))
                                (_ (lower-spread-call (lower-syntax-expr callee)
                                                      (dyn-undefined-make)
                                                      args)))
                              (match (syntax-node (syntax-ungroup-id callee))
                                (SxSuper [] (lower-super-call args))
                                (SxName [name] (lower-named-call name args))
                                (SxMember [owner member optional]
                                          (if (syntax-is-super? owner)
                                              (lower-super-member-call (syntax-ungroup-id callee)
                                                                       args
                                                                       (lower-callee-message "super."
                                                                                             member))
                                              (lower-member-call owner
                                                                 member
                                                                 args)))
                                (SxPrivateMember [owner member optional]
                                                 (do
                                                   (unimplemented "private method calls"
                                                                  "docs/GAPS.md — classes")
                                                   (unreachable-node)))
                                (SxIndex [owner key optional]
                                         (if (syntax-is-super? owner)
                                             (lower-super-member-call (syntax-ungroup-id callee)
                                                                      args
                                                                      "super[...]")
                                             (lower-keyed-call owner
                                                               key
                                                               args)))
                                (_ (lower-value-call (lower-syntax-expr callee)
                                                     args
                                                     (syntax-callee-label callee)))))))
              (SxNew [callee args] (lower-new callee args))
              (SxNewTarget [] (lower-new-target))
              (SxThis [] (lower-this))
              (SxIntrinsic [builtin args] (lower-intrinsic-call builtin args))
              (SxSpread [expr]
                        (do
                          (unimplemented "spread arguments"
                                         "docs/GAPS.md — iteration protocol")
                          (unreachable-node)))
              (SxImportCall [specifier options]
                            (do
                              (unimplemented "dynamic import()"
                                             "docs/GAPS.md — modules")
                              (unreachable-node)))
              ;; A substitution-free template is exactly its cooked string.
              (SxTemplate [quasis substitutions]
                          (if (= (len substitutions) 0)
                              (lower-syntax-expr (get quasis 0))
                              (lower-template quasis substitutions)))
              (SxTaggedTemplate [tag template]
                                (do
                                  (unimplemented "tagged templates"
                                                 "docs/GAPS.md — function values")
                                  (unreachable-node)))
              (SxRegex [body flags]
                       (do
                         (unimplemented "regular expression objects"
                                        "docs/GAPS.md — RegExp")
                         (unreachable-node)))
              (SxFunction [fun] (lower-function-object fun))
              (SxYield [argument delegate]
                       (do
                         (unimplemented "generator yield"
                                        "docs/GAPS.md — generators")
                         (unreachable-node)))
              (SxAwait [operand]
                       (do
                         (unimplemented "await"
                                        "docs/GAPS.md — promises and async functions")
                         (unreachable-node)))
              ;; `super` is never a value of its own: it is the owner of a member or index (handled
              ;; there) or the callee of a call.
              (SxSuper []
                       (do
                         (broken "lower-syntax-expr: a bare `super` survived syntax validation")
                         (unreachable-node)))
              (SxClass [cls] (lower-class cls))
              ;; `({a} = o)` and `[x, y] = xs` (§13.15.5): the value is the assignment's own result,
              ;; and every leaf is a Reference rather than a fresh binding.
              (SxDestructuringAssign [pattern value]
                                     (let [assigned (lower-syntax-expr value)]
                                       (n-keep! assigned)
                                       (lower-pattern-bind! pattern assigned PATTERN-ASSIGN)
                                       (n-unkeep! assigned)
                                       assigned))
              (SxPrivateMember [owner name optional]
                               (do
                                 (unimplemented "private class members"
                                                "docs/GAPS.md — classes")
                                 (unreachable-node)))
              (SxPrivateName [name]
                             (do
                               (unimplemented "private brand checks"
                                              "docs/GAPS.md — classes")
                               (unreachable-node)))
              (SxUnary [op operand]
                       (do
                         (lower-require-jsl! op)
                         (lower-js-unary (if (= op "JsTypeof")
                                             (lower-typeof-operand operand)
                                             (lower-syntax-expr operand))
                                         op)))
              (SxDelete [operand] (lower-delete operand))
              (SxUpdate [op prefix target] (lower-update op prefix target))
              (SxBinary [op left right] (lower-syntax-binary left right op))
              (SxAnd [left right]
                     (lower-short-circuit left right "JsTruthy" true))
              (SxOr [left right]
                    (lower-short-circuit left right "JsTruthy" false))
              (SxCoalesce [left right]
                          (lower-short-circuit left right "JsNullish" true))
              (SxConditional [condition when-true when-false]
                             (lower-conditional condition when-true when-false))
              (SxAssign [target value] (lower-assignment "" target value))
              (SxCompoundAssign [op target value]
                                (lower-assignment op target value))
              (SxLogicalAssign [predicate rhs-on-true target value]
                               (lower-logical-assignment predicate
                                                         rhs-on-true
                                                         target
                                                         value))
              (SxComma [left right]
                       (do (lower-syntax-expr left) (lower-syntax-expr right))))]
      (n-source-context-set! old-lo old-hi)
      (n-origin-leave! origin)
      answer)))

;; Final Simple's `Parser.addReturn` accumulates a pruned return Scope holding control, memory, and
;; `$expr`, then kills the current control. Later exits merge into that accumulator and function
;; fallthrough contributes its default value only while control remains live. These three nid lists
;; are the same pruned accumulator: source locals are irrelevant after exit, while control, memory,
;; and value are all kept until one final Return owns them.
(defn parser-reset-returns! [] (-> i64)
  (let [p (parser-state)]
    (al-clear! [i64] (mut (.return-ctrls p)))
    (al-clear! [i64] (mut (.return-mems p)))
    (al-clear! [i64] (mut (.return-values p)))
    0))

(defn parser-record-return! [(value (dyn NodeOps))] (-> i64)
  (let [p (parser-state)
        scope (parser-node (.current-scope p))
        ctrl (scope-ctrl scope)
        ;; Force lazy loop memory before severing the current control, exactly as Simple does.
        mem (scope-mem scope)
        dead (xctrl-make)]
    (n-keep! ctrl)
    (n-keep! mem)
    (n-keep! value)
    (push! [i64] (mut (.return-ctrls p)) (n-nid ctrl))
    (push! [i64] (mut (.return-mems p)) (n-nid mem))
    (push! [i64] (mut (.return-values p)) (n-nid value))
    (scope-set-ctrl! scope dead)
    (set! (.current-ctrl p) (n-nid dead))
    1))

;; Final Simple jumpTo duplicates the current Scope, kills current control, pops lexical levels
;; to the target depth and merges the pruned copy into the exit Scope. We retain that order and
;; keep the target while nested loops replace the active Scope. Unlike a return, a break carries
;; surviving variable bindings as well as control/memory. Simple's `_continueScope` starts null
;; and the first continue's pruned copy BECOMES it; later continues merge into it, and the loop
;; bottom merges last (`jumpTo(_continueScope)`) before the `for` update and the backedge. Labels
;; name a target explicitly; unlabelled `break` takes the nearest loop or switch and unlabelled
;; `continue` the nearest loop. `finally` unwinding remains UNIMPLEMENTED with exceptions.
(defn parser-push-jump! [(exit (dyn NodeOps)) (kind i64)] (-> i64)
  (let [p (parser-state)
        (mut target) (primitive/zeroed JumpTarget)
        (mut labels) (al-new [(slice u8)] (compiler-allocator))]
    (al-for [label (.pending-labels p)] (push! [(slice u8)] (mut labels) label))
    (al-clear! [(slice u8)] (mut (.pending-labels p)))
    (set! (.scope (mut target)) (n-nid exit))
    (set! (.kind (mut target)) kind)
    (set! (.completions (mut target)) 0)
    (set! (.continue-scope (mut target)) (None [i64]))
    (set! (.labels (mut target)) (load labels))
    (n-keep! exit)
    (push! [JumpTarget] (mut (.jump-targets p)) (load target))))

(defn parser-pop-jump! [] (-> JumpTarget)
  (match (pop! (mut (.jump-targets (parser-state))))
    (None []
          (do
            (broken "parser-pop-jump!: no target")
            (primitive/zeroed JumpTarget)))
    (Some [target]
          (let [saved target
                (mut labels) (.labels saved)]
            (n-unkeep! (parser-node (.scope saved)))
            (al-free! [(slice u8)] (mut labels))
            saved))))

(defn parser-find-jump [(label (Option (slice u8))) (continue? bool)] (-> i64)
  (let [p (parser-state)
        (mut i) (- (len (.jump-targets p)) 1)]
    (loop (if (< (load i) 0)
              (break (do
                       (broken "parser-find-jump: no target after syntax validation")
                       -1))
              (let [target (get (.jump-targets p) (load i))
                    matches
                      (match label
                        (Some [name]
                              (syntax-labels-contain? (.labels target) name))
                        (None []
                              (if continue?
                                  (= (.kind target) JUMP-LOOP)
                                  (or (= (.kind target) JUMP-LOOP)
                                      (= (.kind target) JUMP-SWITCH)))))]
                (if matches
                    (break (load i))
                    (do (set! (mut i) (- (load i) 1)) (continue))))))))

(defn parser-record-jump! [(label (Option (slice u8))) (continue? bool)] (-> i64)
  (let [p (parser-state)
        index (parser-find-jump label continue?)
        finally-index (parser-find-finally)
        target (get (.jump-targets p) index)
        exit (parser-node (.scope target))
        outgoing (scope-dup (parser-node (.current-scope p)) false)
        depth (len (.levels (scope-node exit)))]
    ;; A break or continue that would leave a try with a finally block must run the block first.
    (if (> finally-index index)
        (unimplemented "break or continue crossing a finally block"
                       "docs/GAPS.md — exceptions")
        0)
    (parser-set-current-ctrl! (xctrl-make))
    (loop (if (<= (len (.levels (scope-node outgoing))) depth)
              (break 0)
              (do (scope-pop! outgoing) (continue))))
    (let [meta (al-elem [JumpTarget] (mut (.jump-targets p)) index)]
      (if continue?
          (do
            (match (.continue-scope meta)
              (None []
                    (do
                      (n-keep! outgoing)
                      (set! (.continue-scope meta) (Some (n-nid outgoing)))
                      0))
              (Some [cs] (do (scope-merge! (parser-node cs) outgoing) 0)))
            (set! (.continue-count meta) (+ (.continue-count meta) 1)))
          (do
            (scope-merge! exit outgoing)
            (set! (.count meta) (+ (.count meta) 1)))))
    1))

;; The loop bottom: merge the live fallthrough into the continue Scope, which then becomes the
;; current Scope. Returns whether any path reaches the loop's update/condition/backedge.
(defn parser-close-continues! [(terminated i64)] (-> bool)
  (let [p (parser-state)
        index (- (len (.jump-targets p)) 1)
        target (get (.jump-targets p) index)]
    (match (.continue-scope target)
      (None [] (= terminated 0))
      (Some [cs]
            (let [cont (parser-node cs)]
              (scope-merge! cont (parser-node (.current-scope p)))
              (n-unkeep! cont)
              (parser-use-scope! cont)
              true)))))

(defn parser-release-return-keeps! [] (-> i64)
  (let [p (parser-state)
        (mut i) 0]
    (loop (if (>= (load i) (len (.return-values p)))
              (break 0)
              (do
                (n-unkeep! (parser-node (get (.return-ctrls p) (load i))))
                (n-unkeep! (parser-node (get (.return-mems p) (load i))))
                (n-unkeep! (parser-node (get (.return-values p) (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))))

(defn parser-build-return! [(fun (dyn NodeOps))] (-> (dyn NodeOps))
  (let [p (parser-state)
        count (len (.return-values p))]
    (if (= count 0)
        (do
          (panic "parser-build-return!: function has no exit")
          (unreachable-node))
        (let [ret
                (if (= count 1)
                    (return-make (parser-node (get (.return-ctrls p) 0))
                                 (Some (parser-node (get (.return-mems p) 0)))
                                 (parser-node (get (.return-values p) 0))
                                 (None [(dyn NodeOps)])
                                 (Some fun))
                    (let [region (region-make)
                          memphi
                            (memphi-make region ALIAS-BULK TY-BOT "$return.mem")
                          ;; A function returns a completion: a value, or the exception sentinel.
                          valuephi
                            (phi-make region
                                      (ty-dyn TAG-COMPLETION)
                                      "$return.value")
                          (mut i) 0]
                      (loop (if (>= (load i) count)
                                (break 0)
                                (do
                                  (region-add-path! region
                                                    (parser-node (get (.return-ctrls p)
                                                                      (load i))))
                                  (memphi-add-state! memphi
                                                     (parser-node (get (.return-mems p)
                                                                       (load i))))
                                  (phi-add-value! valuephi
                                                  (parser-node (get (.return-values p)
                                                                    (load i))))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))
                      (return-make region
                                   (Some memphi)
                                   valuephi
                                   (None [(dyn NodeOps)])
                                   (Some fun))))]
          (parser-release-return-keeps!)
          ret))))

;; Instantiate direct lexical bindings, including comma-separated declarations without a new scope.
(defn lower-instantiate-lexicals! [(stmts (ArrayList i64))] (-> i64)
  (do
    (al-for [id stmts]
            (match (syntax-stmt-node id)
              (SsLet [name init final annotation]
                     ;; A captured lexical was already bound to its environment slot at entry, empty
                     ;; until its initialization (docs/DECISIONS.md, closures).
                     (if (>= (scope-env-slot (parser-node (.current-scope (parser-state)))
                                             name)
                             0)
                         0
                         (scope-declare! (parser-node (.current-scope (parser-state)))
                                         name
                                         (ty-dyn TAG-ANY)
                                         final)))
              ;; A pattern declares every name it names, each in its own dead zone until the
              ;; declaration runs (§14.3.1.2).
              (SsLetPattern [pattern init final]
                            (let [(mut names) (al-new [(slice u8)] (compiler-allocator))]
                              (syntax-pattern-names! pattern (mut names))
                              (al-for [name (load names)]
                                      (if (>= (scope-env-slot (parser-node (.current-scope (parser-state))) name) 0)
                                          0
                                          (scope-declare! (parser-node (.current-scope (parser-state)))
                                                          name
                                                          (ty-dyn TAG-ANY)
                                                          final)))
                              (al-free! [(slice u8)] (mut names))
                              0))
              ;; A class declaration is a lexical binding of its name, in its temporal dead zone
              ;; until the class is evaluated.
              (SsClassDecl [cls]
                           (if (>= (scope-env-slot (parser-node (.current-scope (parser-state)))
                                                   (syntax-class-name cls))
                                   0)
                               0
                               (scope-declare! (parser-node (.current-scope (parser-state)))
                                               (syntax-class-name cls)
                                               (ty-dyn TAG-ANY)
                                               true)))
              (SsDeclList [decls] (lower-instantiate-lexicals! decls))
              (SsCase [selector body] (lower-instantiate-lexicals! body))
              ;; A block-level FunctionDeclaration is a lexical binding initialized on block entry.
              ;; The function body's own list is instantiated var-like by `lower-bind-body-functions!`
              ;; instead, which finds the var already defined.
              (SsFunctionDecl [fun]
                              (let [f (syntax-fun-at fun)
                                    scope
                                      (parser-node (.current-scope (parser-state)))]
                                (if (or (.hoisted f)
                                        (>= (scope-find scope (.name f)) 0))
                                    0
                                    (scope-define! scope
                                                   (.name f)
                                                   (ty-dyn TAG-ANY)
                                                   false
                                                   (lower-function-object fun)))))
              (_ 0)))
    0))

;; Final Simple installs parameters in its function Scope before parsing the body. JavaScript's
;; FunctionDeclarationInstantiation additionally hoists var names out of nested statements.
;; Preserve existing parameters and repeated var bindings; initialize only new slots to JSL
;; undefined. Initializers remain at their original execution positions. Script object-environment
;; bindings and the implicit arguments object are explicitly outside this implementation boundary.
(defn lower-instantiate-vars! [(stmts (ArrayList i64))] (-> i64)
  (let [(mut names) (al-new [(slice u8)] (compiler-allocator))
        scope (parser-node (.current-scope (parser-state)))]
    (syntax-collect-declarations! stmts false (mut names))
    (al-for [name (load names)]
            (if (< (scope-find scope name) 0)
                (do
                  (if (= name "arguments")
                      (unimplemented "implicit arguments object binding"
                                     "docs/GAPS.md — function environments")
                      0)
                  (scope-define! scope
                                 name
                                 (ty-dyn TAG-ANY)
                                 false
                                 (lower-singleton "JsUndefined")))
                0))
    0))

(defn parser-use-scope! [(scope (dyn NodeOps))] (-> i64)
  (do
    (set! (.current-scope (parser-state)) (n-nid scope))
    (set! (.current-ctrl (parser-state)) (n-nid (scope-ctrl scope)))
    0))

;; Simple has no JavaScript CaseBlock. Its ordinary If/CProj/Scope diamonds and jumpTo exits
;; provide the graph machinery; JSL IsStrictlyEqual supplies case matching. First evaluate the
;; discriminant outside the switch lexical scope. Instantiate that scope once, then evaluate case
;; selectors in source order on only the unmatched path. Default receives the final unmatched
;; path even when it appears in the middle. Finally lower bodies in source order, merging each
;; selected entry with the preceding fallthrough. Thus fallthrough never re-evaluates a selector.
;; All clauses share one lexical scope. Runtime TDZ state across differently initialized case
;; paths is still unsupported by Scope and must refuse, not join TOP as a JavaScript value.
(defn syntax-case-body [(id i64)] (-> (ArrayList i64))
  (match (syntax-stmt-node id)
    (SsCase [selector body] body)
    (_ (do
         (broken "syntax-case-body: switch clause is not a case")
         (al-new [i64] (compiler-allocator))))))

(defn lower-switch [(discriminant i64) (cases (ArrayList i64))] (-> i64)
  (let [value (lower-syntax-expr discriminant)
        outer (parser-node (.current-scope (parser-state)))
        exit (scope-dup outer false)
        (mut entries) (al-new [i64] (compiler-allocator))
        (mut default-index) -1
        (mut i) 0
        (mut fallthrough) 0]
    (n-keep! value)
    (scope-set-ctrl! exit (xctrl-make))
    (parser-push-jump! exit JUMP-SWITCH)
    (scope-push! outer)
    (lower-instantiate-lexicals! cases)
    (loop (if (>= (load i) (len cases))
              (break 0)
              (let [selector-id
                      (match (syntax-stmt-node (get cases (load i)))
                        (SsCase [selector body] selector)
                        (_ (do
                             (broken "lower-switch: clause is not a case")
                             (None [i64]))))]
                (match selector-id
                  (None []
                        (do
                          (set! (mut default-index) (load i))
                          ;; A parser-only pending entry, patched after all selectors, never a value.
                          (push! [i64] (mut entries) 0)))
                  (Some [selector-expr]
                        (let [selector (lower-syntax-expr selector-expr)
                              predicate
                                (lower-js-truthy (lower-js-binary value
                                                                  selector
                                                                  "JsStrictEqual"))
                              selected
                                (parser-node (.current-scope (parser-state)))
                              iff (if-make (scope-ctrl selected) predicate)
                              arms (if-arms! iff)
                              unmatched (scope-dup selected false)]
                          (scope-set-ctrl! selected (arms-true arms))
                          (scope-set-ctrl! unmatched (arms-false arms))
                          (n-keep! selected)
                          (push! [i64] (mut entries) (n-nid selected))
                          (parser-use-scope! unmatched))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (n-unkeep! value)
    (let [unmatched (parser-node (.current-scope (parser-state)))]
      (if (>= (load default-index) 0)
          (do
            (n-keep! unmatched)
            (set! (mut entries) (load default-index) (n-nid unmatched)))
          (do (scope-pop! unmatched) (scope-merge! exit unmatched) 0)))
    (set! (mut i) 0)
    (loop (if (>= (load i) (len cases))
              (break 0)
              (let [entry (parser-node (get (load entries) (load i)))]
                (n-unkeep! entry)
                (parser-use-scope! (if (= (load fallthrough) 0)
                                       entry
                                       (scope-merge! entry
                                                     (parser-node (load fallthrough)))))
                (let [terminated
                        (lower-syntax-statements (syntax-case-body (get cases
                                                                        (load i))))
                      current (parser-node (.current-scope (parser-state)))]
                  (if (= terminated 0)
                      (set! (mut fallthrough) (n-nid current))
                      (do (set! (mut fallthrough) 0) (n-kill! current))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (!= (load fallthrough) 0)
        (let [last (parser-node (load fallthrough))]
          (scope-pop! last)
          (scope-merge! exit last)
          0)
        0)
    (let [target (parser-pop-jump!)]
      (parser-use-scope! exit)
      (if (or (< (load default-index) 0)
              (!= (load fallthrough) 0)
              (> (.count target) 0))
          0
          1))))

(defn lower-block [(body (ArrayList i64))] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))]
    (scope-push! scope)
    (lower-instantiate-lexicals! body)
    (let [nested-return (lower-syntax-statements body)]
      ;; A loop replaces the active Scope with its exit Scope. Pop the live environment, never
      ;; the stale entry handle.
      (scope-pop! (parser-node (.current-scope (parser-state))))
      nested-return)))

(defn lower-if [(condition-id i64) (then-stmt i64) (else-stmt (Option i64))] (-> i64)
  (let [condition (lower-js-truthy (lower-syntax-expr condition-id))
        iff (if-make (parser-node (.current-ctrl (parser-state))) condition)
        arms (if-arms! iff)
        true-scope (parser-node (.current-scope (parser-state)))
        false-scope (scope-dup true-scope false)]
    (scope-set-ctrl! true-scope (arms-true arms))
    (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
    (let [true-return (lower-syntax-statement then-stmt)
          true-exit (parser-node (.current-scope (parser-state)))]
      (set! (.current-scope (parser-state)) (n-nid false-scope))
      (scope-set-ctrl! false-scope (arms-false arms))
      (set! (.current-ctrl (parser-state)) (n-nid (arms-false arms)))
      (let [false-return
              (match else-stmt
                (Some [e] (lower-syntax-statement e))
                (None [] 0))
            merged
              (scope-merge! true-exit
                            (parser-node (.current-scope (parser-state))))]
        (set! (.current-scope (parser-state)) (n-nid merged))
        (set! (.current-ctrl (parser-state)) (n-nid (scope-ctrl merged)))
        (if (and (!= true-return 0) (!= false-return 0)) 1 0)))))

;; Every loop follows final Simple's atomic protocol: an open Loop and lazy binding Phis are built
;; first, then `scope-end-loop!` installs the control backedge and every materialized Phi backedge
;; without exposing an intermediate graph. The condition and body can resolve every lazy sentinel
;; (notably memory plus all assigned variables). The resulting edge replacements may leave the
;; parser's raw `entry` pointer as its only owner, so it is held from before construction until
;; `scope-end-loop!` has consumed every entry slot.
(defn lower-loop-head! [] (-> (dyn NodeOps))
  (let [entry (parser-node (.current-scope (parser-state)))
        head (loop-make (scope-ctrl entry))]
    (n-keep! entry)
    (scope-set-ctrl! entry head)
    (parser-use-scope! (scope-dup entry true))
    entry))

;; `while (test) body` and `for (…; test; update) body`. An absent `for` test is Simple's `con(1)`.
;; The exit Scope sees the predicate's effects and the false edge; the body continues on true.
(defn lower-test-loop [(test (Option i64)) (update (Option i64)) (body i64)] (-> i64)
  (let [entry (lower-loop-head!)
        condition
          (match test
            (Some [e] (lower-js-truthy (lower-syntax-expr e)))
            (None [] (con-int 1)))
        condition-scope (parser-node (.current-scope (parser-state)))
        iff (if-make (scope-ctrl condition-scope) condition)
        arms (if-arms! iff)]
    (scope-set-ctrl! condition-scope (arms-false arms))
    (let [exit-scope (scope-dup condition-scope false)]
      (parser-push-jump! exit-scope JUMP-LOOP)
      (scope-set-ctrl! condition-scope (arms-true arms))
      (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
      (let [terminated (lower-syntax-statement body)
            live (parser-close-continues! terminated)]
        ;; The update runs after the body and every continue, only on a live path.
        (if live
            (match update (Some [e] (do (lower-syntax-expr e) 0)) (None [] 0))
            0)
        ;; This is one atomic protocol: backedge control first, then all materialized Phi
        ;; backedges, before any peephole can run.
        (scope-end-loop! entry
                         (parser-node (.current-scope (parser-state)))
                         exit-scope)
        (parser-pop-jump!)
        (n-unkeep! entry)
        (parser-use-scope! exit-scope)
        0))))

(defn lower-while [(condition-id i64) (body i64)] (-> i64)
  (lower-test-loop (Some condition-id) (None [i64]) body))

;; `do body while (test)`. The exit Scope cannot be the predicate's false edge before the body
;; exists, so it starts dead (XCtrl) and receives breaks and the false edge by merge, exactly as
;; the switch exit does. When nothing reaches the condition, the backedge is dead and the code
;; after the loop is unreachable unless a break reached the exit.
(defn lower-do-while [(body i64) (condition-id i64)] (-> i64)
  (let [entry (lower-loop-head!)
        exit-scope
          (scope-dup (parser-node (.current-scope (parser-state))) false)]
    (scope-set-ctrl! exit-scope (xctrl-make))
    (parser-push-jump! exit-scope JUMP-LOOP)
    (let [terminated (lower-syntax-statement body)
          live (parser-close-continues! terminated)]
      (if live
          (let [condition (lower-js-truthy (lower-syntax-expr condition-id))
                condition-scope (parser-node (.current-scope (parser-state)))
                iff (if-make (scope-ctrl condition-scope) condition)
                arms (if-arms! iff)
                false-scope (scope-dup condition-scope false)]
            (scope-set-ctrl! false-scope (arms-false arms))
            (scope-merge! exit-scope false-scope)
            (scope-set-ctrl! condition-scope (arms-true arms))
            (scope-end-loop! entry condition-scope exit-scope))
          (scope-end-loop! entry
                           (parser-node (.current-scope (parser-state)))
                           exit-scope))
      (let [target (parser-pop-jump!)]
        (n-unkeep! entry)
        (parser-use-scope! exit-scope)
        (if (and (not live) (= (.count target) 0)) 1 0)))))

(defn lower-instantiate-lexical-stmt! [(stmt i64)] (-> i64)
  (let [(mut one) (al-new [i64] (compiler-allocator))]
    (push! [i64] (mut one) stmt)
    (lower-instantiate-lexicals! (load one))
    (al-free! [i64] (mut one))
    0))

;; Final Simple parseFor pushes a block scope for the index variables, parses the declaration,
;; runs the shared looping protocol and pops that scope. A head `let` is one binding here, not a
;; per-iteration copy: without closures the per-iteration environment is unobservable, and this
;; must change when captured environments arrive.
(defn lower-for [(init ForInit)
                 (test (Option i64))
                 (update (Option i64))
                 (body i64)] (-> i64)
  (do
    (scope-push! (parser-node (.current-scope (parser-state))))
    (match init
      (ForNoInit [] 0)
      (ForInitDecl [stmt]
                   (do
                     (lower-instantiate-lexical-stmt! stmt)
                     (lower-syntax-statement stmt)))
      (ForInitExpr [e] (do (lower-syntax-expr e) 0))
      (ForInitPattern [pattern]
                      (unimplemented "destructuring for-in/of heads"
                                     "docs/GAPS.md — destructuring")))
    (let [terminated (lower-test-loop test update body)]
      (scope-pop! (parser-node (.current-scope (parser-state))))
      terminated)))

;; A JSL definition applied to already-lowered values, macro or builtin, threaded through the Scope.
(defn lower-jsl-values [(name (slice u8)) (values (ArrayList (dyn NodeOps)))] (-> (dyn NodeOps))
  (let [scope (parser-node (.current-scope (parser-state)))
        r
          (match (jsl-definition-form name)
            (None []
                  (do
                    (panic "lower-jsl-values: unknown JSL definition")
                    (jsl-expr-result (unreachable-node)
                                     (scope-ctrl scope)
                                     (scope-mem scope))))
            (Some [form]
                  (if (jsl-form-macro? form)
                      (jsl-lower-macro-values name
                                              values
                                              (scope-ctrl scope)
                                              (scope-mem scope))
                      (lower-jsl-call-values name values))))]
    (parser-set-current-ctrl! (.ctrl r))
    (scope-set-mem! scope (.mem r))
    (.value r)))

(defn lower-jsl-values0 [(name (slice u8))] (-> (dyn NodeOps))
  (let [(mut values) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (let [v (lower-jsl-values name (load values))]
      (al-free! [(dyn NodeOps)] (mut values))
      v)))

(defn lower-jsl-values2 [(name (slice u8)) (a (dyn NodeOps)) (b (dyn NodeOps))] (-> (dyn NodeOps))
  (let [(mut values) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut values) a)
    (push! [(dyn NodeOps)] (mut values) b)
    (let [v (lower-jsl-values name (load values))]
      (al-free! [(dyn NodeOps)] (mut values))
      v)))

(defn lower-jsl-values3 [(name (slice u8))
                         (a (dyn NodeOps))
                         (b (dyn NodeOps))
                         (c (dyn NodeOps))] (-> (dyn NodeOps))
  (let [(mut values) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut values) a)
    (push! [(dyn NodeOps)] (mut values) b)
    (push! [(dyn NodeOps)] (mut values) c)
    (let [v (lower-jsl-values name (load values))]
      (al-free! [(dyn NodeOps)] (mut values))
      v)))

;; The compiler-only Scope names a for-in loop carries across its iterations; the dot keeps them out
;; of every IdentifierName, and an inner loop's names shadow an outer loop's in its own level.
(const FOR-IN-OBJECT "$aot$.for-in.object")

(const FOR-IN-KEYS "$aot$.for-in.keys")

(const FOR-IN-CURSOR "$aot$.for-in.cursor")

;; `for (head in right) body` (§14.7.5.6 ForIn/OfHeadEvaluation, §14.7.5.7 ForIn/OfBodyEvaluation).
;; The head's lexical names are in their temporal dead zone while `right` evaluates; undefined and
;; null enumerate nothing; otherwise JSL lists the enumerable string keys once, when the loop starts
;; (`JsForInKeys`, EnumerateObjectProperties), and each iteration skips a key the object no longer
;; has (`JsForInNext`), binds the key and runs the body. The loop itself is Simple's: a loop head,
;; a predicate, the body on true, continues closed, the backedge. A `let` or `const` head is a fresh
;; binding per iteration, a `var` or an expression head a PutValue through its Reference.
(defn lower-for-in [(head ForInit) (right i64) (body i64)] (-> i64)
  (do
    (scope-push! (parser-node (.current-scope (parser-state))))
    (match head
      (ForInitDecl [stmt]
                   (match (syntax-stmt-node stmt)
                     (SsLet [name init final annotation]
                            (lower-instantiate-lexical-stmt! stmt))
                     ;; Annex B.3.5: a sloppy `var` head may carry an initializer, assigned first.
                     (SsVar [name init annotation]
                            (lower-syntax-statement stmt))
                     ;; A pattern head declares its names here and binds them per iteration.
                     (SsLetPattern [pattern init final]
                                   (lower-instantiate-lexical-stmt! stmt))
                     (SsVarPattern [pattern init] 0)
                     (_ (broken "for-in/of head: not a binding statement"))))
      (ForInitPattern [pattern]
                      (unimplemented "destructuring for-in/of heads"
                                     "docs/GAPS.md — destructuring"))
      (_ 0))
    (let [object (lower-syntax-expr right)]
      (n-keep! object)
      (scope-pop! (parser-node (.current-scope (parser-state))))
      (let [keys
              (lower-completion! (lower-jsl-unary-value "JsForInKeys" object))
            scope (parser-node (.current-scope (parser-state)))]
        (n-keep! keys)
        (scope-push! scope)
        (scope-define! scope FOR-IN-OBJECT (ty-dyn TAG-ANY) false object)
        (scope-define! scope FOR-IN-KEYS (ty-dyn TAG-ANY) false keys)
        (scope-define! scope
                       FOR-IN-CURSOR
                       (ty-dyn TAG-ANY)
                       false
                       (lower-singleton "JsForInFirst"))
        (n-unkeep! keys)
        (n-unkeep! object)
        (let [entry (lower-loop-head!)
              next
                (lower-jsl-values3 "JsForInNext"
                                   (lower-for-in-slot FOR-IN-OBJECT)
                                   (lower-for-in-slot FOR-IN-KEYS)
                                   (lower-for-in-slot FOR-IN-CURSOR))]
          (n-keep! next)
          (let [condition
                  (lower-js-truthy (lower-jsl-unary-value "JsForInHasKey" next))
                condition-scope (parser-node (.current-scope (parser-state)))
                iff (if-make (scope-ctrl condition-scope) condition)
                arms (if-arms! iff)]
            (scope-set-ctrl! condition-scope (arms-false arms))
            (let [exit-scope (scope-dup condition-scope false)]
              (parser-push-jump! exit-scope JUMP-LOOP)
              (scope-set-ctrl! condition-scope (arms-true arms))
              (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
              (let [key
                      (lower-jsl-values2 "JsForInKeyAt"
                                         (lower-for-in-slot FOR-IN-KEYS)
                                         next)]
                (n-keep! key)
                (scope-update! (parser-node (.current-scope (parser-state)))
                               FOR-IN-CURSOR
                               (lower-jsl-unary-value "JsForInAfter" next))
                (n-unkeep! next)
                (scope-push! (parser-node (.current-scope (parser-state))))
                (lower-for-in-bind! head key)
                (n-unkeep! key)
                (let [terminated (lower-syntax-statement body)]
                  ;; The iteration's binding ends with the body; a continue already left it (its Scope
                  ;; is cut to the loop's depth), and continues rejoin before the backedge with the
                  ;; cursor already past this key.
                  (scope-pop! (parser-node (.current-scope (parser-state))))
                  (parser-close-continues! terminated)
                  (scope-end-loop! entry
                                   (parser-node (.current-scope (parser-state)))
                                   exit-scope)
                  (parser-pop-jump!)
                  (n-unkeep! entry)
                  (parser-use-scope! exit-scope)
                  (scope-pop! (parser-node (.current-scope (parser-state))))
                  0)))))))))

;; The compiler-only Scope names a for-of loop carries across its iterations: the iterator and the
;; `next` method read from it once, as GetIterator does (§7.4.2 step 5).
(const FOR-OF-ITERATOR "$aot$.for-of.iterator")

(const FOR-OF-NEXT "$aot$.for-of.next")

;; True on every path through the body, false on the path the exhausted iterator takes: at the
;; loop's exit it is the Phi that says whether control left early, and an early exit closes the
;; iterator (§7.4.9). An iterator that answered `done` is already closed and must not be returned to.
(const FOR-OF-EARLY "$aot$.for-of.early")

;; ForIn/OfBodyEvaluation (§14.7.5.7) over the iteration protocol: the iterable is evaluated once,
;; GetIterator answers the iterator and its `next`, and each iteration calls `next`, stops on a
;; truthy `done`, and binds `value` in the head's own binding. A `break` or a `return` leaves through
;; the exit scope, where the iterator is closed (§7.4.9) — the loop's normal end does not close it,
;; because an exhausted iterator is already done.
(defn lower-for-of [(head ForInit) (right i64) (body i64)] (-> i64)
  (do
    (scope-push! (parser-node (.current-scope (parser-state))))
    (match head
      (ForInitDecl [stmt]
                   (match (syntax-stmt-node stmt)
                     (SsLet [name init final annotation]
                            (lower-instantiate-lexical-stmt! stmt))
                     (SsVar [name init annotation]
                            (lower-syntax-statement stmt))
                     ;; A pattern head declares its names here and binds them per iteration.
                     (SsLetPattern [pattern init final]
                                   (lower-instantiate-lexical-stmt! stmt))
                     (SsVarPattern [pattern init] 0)
                     (_ (broken "for-in/of head: not a binding statement"))))
      (ForInitPattern [pattern]
                      (unimplemented "destructuring for-in/of heads"
                                     "docs/GAPS.md — destructuring"))
      (_ 0))
    (let [iterable (lower-syntax-expr right)]
      (n-keep! iterable)
      (scope-pop! (parser-node (.current-scope (parser-state))))
      (let [iterator
              (lower-completion! (lower-jsl-values1 "JsGetIterator" iterable))]
        (n-unkeep! iterable)
        (n-keep! iterator)
        (let [next
                (lower-completion! (lower-jsl-values1 "JsIteratorNextMethod"
                                                      iterator))
              scope (parser-node (.current-scope (parser-state)))]
          (n-keep! next)
          (scope-push! scope)
          (scope-define! scope FOR-OF-ITERATOR (ty-dyn TAG-ANY) false iterator)
          (scope-define! scope FOR-OF-NEXT (ty-dyn TAG-ANY) false next)
          (scope-define! scope
                         FOR-OF-EARLY
                         (ty-dyn TAG-ANY)
                         false
                         (lower-singleton "JsTrue"))
          (n-unkeep! next)
          (n-unkeep! iterator)
          (let [entry (lower-loop-head!)
                result
                  (lower-completion! (lower-jsl-values2 "JsIteratorStep"
                                                        (lower-for-in-slot FOR-OF-ITERATOR)
                                                        (lower-for-in-slot FOR-OF-NEXT)))]
            (n-keep! result)
            (let [done
                    (lower-js-truthy (lower-completion! (lower-jsl-values1 "JsIteratorDone"
                                                                           result)))
                  condition-scope (parser-node (.current-scope (parser-state)))
                  iff (if-make (scope-ctrl condition-scope) done)
                  arms (if-arms! iff)]
              ;; `done` true leaves the loop; the false arm is the body.
              (scope-set-ctrl! condition-scope (arms-true arms))
              (let [exit-scope (scope-dup condition-scope false)]
                ;; Only the exhausted path is not an early exit; the body keeps the true it was
                ;; given, so a `break` carries it into this same scope and the Phi says so.
                (scope-update! exit-scope
                               FOR-OF-EARLY
                               (lower-singleton "JsFalse"))
                (parser-push-jump! exit-scope JUMP-LOOP)
                (scope-set-ctrl! condition-scope (arms-false arms))
                (set! (.current-ctrl (parser-state)) (n-nid (arms-false arms)))
                (let [value
                        (lower-completion! (lower-jsl-values1 "JsIteratorValue"
                                                              result))]
                  (n-keep! value)
                  (n-unkeep! result)
                  (scope-push! (parser-node (.current-scope (parser-state))))
                  (lower-for-in-bind! head value)
                  (n-unkeep! value)
                  (let [terminated (lower-syntax-statement body)]
                    (scope-pop! (parser-node (.current-scope (parser-state))))
                    (parser-close-continues! terminated)
                    (scope-end-loop! entry
                                     (parser-node (.current-scope (parser-state)))
                                     exit-scope)
                    (parser-pop-jump!)
                    (n-unkeep! entry)
                    (parser-use-scope! exit-scope)
                    (lower-for-of-close!)
                    (scope-pop! (parser-node (.current-scope (parser-state))))
                    0))))))))))

;; At the loop's exit: the iterator is closed exactly when control left the body early.
(defn lower-for-of-close! [] (-> i64)
  (let [early (lower-js-truthy (lower-for-in-slot FOR-OF-EARLY))
        scope (parser-node (.current-scope (parser-state)))
        iff (if-make (scope-ctrl scope) early)
        arms (if-arms! iff)
        skipped (scope-dup scope false)]
    (scope-set-ctrl! scope (arms-true arms))
    (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
    (lower-completion! (lower-jsl-values1 "JsIteratorClose"
                                          (lower-for-in-slot FOR-OF-ITERATOR)))
    (scope-set-ctrl! skipped (arms-false arms))
    (let [merged
            (scope-merge! (parser-node (.current-scope (parser-state))) skipped)]
      (set! (.current-scope (parser-state)) (n-nid merged))
      (set! (.current-ctrl (parser-state)) (n-nid (scope-ctrl merged)))
      0)))

(defn lower-for-in-slot [(name (slice u8))] (-> (dyn NodeOps))
  (match (scope-lookup (parser-node (.current-scope (parser-state))) name)
    (Some [v] v)
    (None []
          (do
            (broken "lower-for-in-slot: loop state is not in scope")
            (unreachable-node)))))

;; The iteration's key reaches the head: a fresh lexical binding, or PutValue through the var's or the
;; expression's Reference, evaluated anew each iteration (§14.7.5.7 steps 6.g-6.i).
;; ---------------------------------------------------------------------------
;; Destructuring (docs/DECISIONS.md, destructuring)
;;
;; BindingInitialization (§8.6.2) and DestructuringAssignmentEvaluation (§13.15.5) are one walk over
;; a pattern with a value: how a *leaf* is bound is the only difference between a declaration, a
;; parameter and an assignment, so the walk takes that as a mode and everything else — defaults,
;; nesting, an object pattern's property reads, an array pattern's iterator — is shared.

;; A lexical declaration's binding: instantiated, and initialized here.
(const PATTERN-LET 0)

;; A `var` or a parameter: the binding exists and this writes it.
(const PATTERN-VAR 1)

;; An assignment pattern: every leaf is a Reference, which may be a member access.
(const PATTERN-ASSIGN 2)

;; A parameter or a catch clause: the binding is introduced here, by this walk.
(const PATTERN-PARAM 3)

(defn lower-pattern-bind! [(pattern i64) (value (dyn NodeOps)) (mode i64)] (-> i64)
  (let [p (syntax-pattern-at pattern)
        ;; `= default` applies when the value is undefined, whatever the target shape (§8.6.2).
        bound (parser-node (match (.default p)
                             (Some [init] (n-nid (lower-parameter-default value init)))
                             (None [] (n-nid value))))]
    (n-keep! bound)
    (match (.node p)
      (PatName [name] (lower-pattern-name! name bound mode))
      (PatTarget [expr]
                 (let [ref (lower-ref-prepare! expr)]
                   (lower-ref-put! ref bound)
                   (lower-ref-release! ref)
                   0))
      (PatObject [props rest] (lower-pattern-object! props rest bound mode))
      (PatArray [elements rest] (lower-pattern-array! elements rest bound mode)))
    (n-unkeep! bound)
    0))

;; A leaf name, by mode.
(defn lower-pattern-name! [(name (slice u8)) (value (dyn NodeOps)) (mode i64)] (-> i64)
  (if (= mode PATTERN-PARAM)
      (do (scope-define! (parser-node (.current-scope (parser-state))) name (ty-dyn TAG-ANY) false value) 0)
  (if (= mode PATTERN-LET)
      (let [scope (parser-node (.current-scope (parser-state)))]
        (if (>= (scope-find scope name) 0)
            (lower-binding-initialize! name value)
            (if (and (syntax-script-root? (.current-fun (parser-state)))
                     (syntax-script-binding? name))
                (lower-script-declaration-effect! "JsInitializeGlobalLexicalBinding" name (Some value))
                (broken "lower-pattern-name!: the lexical binding was not instantiated"))))
      (let [(mut ref) (primitive/zeroed SyntaxRef)]
        (lower-ref-name-prepare! (mut ref) name)
        (lower-ref-put! (load ref) value)
        (lower-ref-release! (load ref))
        0))))

;; `{a, b: t, [k]: u}` (§13.15.5.5): each property is read from the value, in source order, and the
;; read itself is what refuses an undefined or null value (RequireObjectCoercible).
(defn lower-pattern-object! [(props (ArrayList PatProp))
                             (rest (Option i64))
                             (value (dyn NodeOps))
                             (mode i64)] (-> i64)
  (let [wants-rest (match rest (Some [_] true) (None [] false))
        ;; `{a, ...rest}`: the properties the pattern names are excluded from the copy, by the key
        ;; identity each one was read under — so a computed key is converted once, here.
        excluded (if wants-rest
                     (lower-jsl-values0 "JsExcludedKeys")
                     (dyn-undefined-make))]
    (n-keep! value)
    (n-keep! excluded)
    (al-for [prop props]
            (let [entry prop
                  key (match (.key entry)
                        (KeyNamed [k] (keyref-make k))
                        (KeyComputed [e] (lower-literal-computed-key e)))]
              (n-keep! key)
              (if wants-rest
                  (do
                    (lower-jsl-values2 (match (.key entry)
                                         (KeyNamed [k] "JsExcludeKey")
                                         (KeyComputed [e] "JsExcludeComputedKey"))
                                       excluded
                                       key)
                    0)
                  0)
              (let [read (lower-completion!
                           (lower-jsl-values2 (match (.key entry)
                                                (KeyNamed [k] "JsGetNamed")
                                                (KeyComputed [e] "JsGetKeyed"))
                                              value
                                              key))]
                (n-unkeep! key)
                (lower-pattern-bind! (.pattern entry) read mode))))
    (match rest
      (Some [r]
            (lower-pattern-bind! r
                                 (lower-completion!
                                   (lower-jsl-values2 "JsObjectRest" value excluded))
                                 mode))
      (None [] 0))
    (n-unkeep! excluded)
    (n-unkeep! value)
    0))

;; `[a, , b, ...r]` (§8.6.2): the value is iterated, each target takes the next value — undefined
;; once the iterator is done — and an iterator the pattern did not exhaust is closed.
(defn lower-pattern-array! [(elements (ArrayList PatElem))
                            (rest (Option i64))
                            (value (dyn NodeOps))
                            (mode i64)] (-> i64)
  (let [iterator (lower-completion! (lower-jsl-values1 "JsGetIterator" value))]
    (n-keep! iterator)
    (let [next (lower-completion! (lower-jsl-values1 "JsIteratorNextMethod" iterator))]
      (n-keep! next)
      (let [state (lower-jsl-values0 "JsDestructureState")]
        (n-keep! state)
        (al-for [element elements]
                (let [taken (lower-completion!
                              (lower-jsl-values3 "JsDestructureStep" iterator next state))]
                  (match element
                    (PatHole [] 0)
                    (PatItem [pat] (lower-pattern-bind! pat taken mode)))))
        (match rest
          (Some [r]
                (let [remaining (lower-completion!
                                  (lower-jsl-values3 "JsDestructureRest" iterator next state))]
                  (lower-pattern-bind! r remaining mode)))
          (None [] 0))
        (lower-completion! (lower-jsl-values2 "JsDestructureClose" iterator state))
        (n-unkeep! state)
        (n-unkeep! next)
        (n-unkeep! iterator)
        0))))

(defn lower-for-in-bind! [(head ForInit) (key (dyn NodeOps))] (-> i64)
  (match head
    (ForInitDecl [stmt]
                 (match (syntax-stmt-node stmt)
                   (SsLet [name init final annotation]
                          (scope-define! (parser-node (.current-scope (parser-state)))
                                         name
                                         (ty-dyn TAG-ANY)
                                         final
                                         key))
                   (SsVar [name init annotation]
                          (let [(mut ref) (primitive/zeroed SyntaxRef)]
                            (lower-ref-name-prepare! (mut ref) name)
                            (lower-ref-put! (load ref) key)
                            (lower-ref-release! (load ref))
                            0))
                   ;; `for (const {a} of xs)`: each iteration's value binds the head's pattern.
                   (SsLetPattern [pattern init final]
                                 (lower-pattern-bind! pattern key PATTERN-PARAM))
                   (SsVarPattern [pattern init]
                                 (lower-pattern-bind! pattern key PATTERN-VAR))
                   (_ (broken "lower-for-in-bind!: a head that is not a binding"))))
    (ForInitExpr [target]
                 (let [ref (lower-ref-prepare! target)]
                   (lower-ref-put! ref key)
                   (lower-ref-release! ref)
                   0))
    (_ (unimplemented "destructuring for-in/of heads"
                      "docs/GAPS.md — destructuring"))))

;; A label on a loop or switch names that statement's jump target; the labels accumulate until
;; the target is pushed. Any other labelled statement is a break-only block target.
(defn syntax-stmt-takes-labels? [(id i64)] (-> bool)
  (match (syntax-stmt-node id)
    (SsLabeled [label body] true)
    (SsSwitch [discriminant cases] true)
    (_ (syntax-iteration-stmt? id))))

(defn lower-labeled [(label (slice u8)) (body i64)] (-> i64)
  (do
    (push! [(slice u8)] (mut (.pending-labels (parser-state))) label)
    (if (syntax-stmt-takes-labels? body)
        (lower-syntax-statement body)
        (let [current (parser-node (.current-scope (parser-state)))
              exit (scope-dup current false)]
          (scope-set-ctrl! exit (xctrl-make))
          (parser-push-jump! exit JUMP-BLOCK)
          (let [terminated (lower-syntax-statement body)
                target (parser-pop-jump!)
                merged
                  (scope-merge! (parser-node (.current-scope (parser-state)))
                                exit)]
            (parser-use-scope! merged)
            (if (and (!= terminated 0) (= (.count target) 0)) 1 0))))))

;; Return 1 when every path exits; each exit has transferred ownership to its return/break target.
(defn lower-syntax-statement [(id i64)] (-> i64)
  (match (syntax-stmt-node id)
    (SsLet [name init final annotation]
           (let [value
                   (match init
                     (Some [e] (lower-syntax-expr e))
                     (None [] (lower-singleton "JsUndefined")))]
             (if (>= (scope-find (parser-node (.current-scope (parser-state)))
                                 name)
                     0)
                 (lower-binding-initialize! name value)
                 (if (and (syntax-script-root? (.current-fun (parser-state)))
                          (syntax-script-binding? name))
                     (do
                       (lower-script-declaration-effect! "JsInitializeGlobalLexicalBinding"
                                                         name
                                                         (Some value))
                       ;; The realm cell remains published for callbacks and later Scripts.
                       ;; Within this Script, successful initialization dominates every later
                       ;; read of this immutable binding. Unknown calls cannot rebind a const.
                       ;; Reuse its SSA value just as Simple's Scope does for local definitions.
                       ;; Mutable let bindings remain memory-dependent realm reads.
                       (if final
                           (scope-define-realm-constant! (parser-node (.current-scope (parser-state)))
                                                         name
                                                         value)
                           0))
                     (panic "lower-syntax-statement: lexical declaration has no binding")))
             0))
    (SsVar [name init annotation]
           (match init
             (Some [e]
                   ;; VariableDeclaration evaluation resolves its Reference before the
                   ;; initializer, then performs PutValue (ECMA-262 14.3.2.1). Declaration
                   ;; instantiation has already created the binding; this is assignment.
                   (let [(mut ref) (primitive/zeroed SyntaxRef)]
                     (lower-ref-name-prepare! (mut ref) name)
                     (let [value (lower-syntax-expr e)]
                       (n-keep! value)
                       (lower-ref-put! (load ref) value)
                       (lower-ref-release! (load ref))
                       (n-unkeep! value))
                     0))
             (None [] 0)))
    ;; `let {a} = o;` and `var [x] = xs;`: the initializer is one value, and the pattern binds
    ;; every name it names (§14.3.3.5, §14.3.2.1).
    (SsLetPattern [pattern init final]
                  (let [value (match init
                                (Some [e] (lower-syntax-expr e))
                                (None [] (lower-singleton "JsUndefined")))]
                    (lower-pattern-bind! pattern value PATTERN-LET)
                    0))
    (SsVarPattern [pattern init]
                  (let [value (match init
                                (Some [e] (lower-syntax-expr e))
                                (None [] (lower-singleton "JsUndefined")))]
                    (lower-pattern-bind! pattern value PATTERN-VAR)
                    0))
    (SsDeclList [decls] (lower-syntax-statements decls))
    (SsReturn [value]
              (lower-return-completion! (match value
                                          (Some [e] (lower-syntax-expr e))
                                          (None [] (dyn-undefined-make)))))
    (SsExpr [expr] (do (lower-syntax-expr expr) 0))
    (SsBlock [body] (lower-block body))
    (SsIf [condition then-stmt else-stmt]
          (lower-if condition then-stmt else-stmt))
    (SsWhile [condition body] (lower-while condition body))
    (SsEmpty [] 0)
    (SsBreak [label] (parser-record-jump! label false))
    (SsContinue [label] (parser-record-jump! label true))
    (SsSwitch [discriminant cases] (lower-switch discriminant cases))
    (SsCase [selector body]
            (do
              (broken "lower-syntax-statement: case clause outside its switch")
              0))
    (SsDoWhile [body condition] (lower-do-while body condition))
    (SsFor [init test update body] (lower-for init test update body))
    (SsForIn [head of right body awaited]
             (if awaited
                 (unimplemented "for-await-of asynchronous iteration"
                                "docs/GAPS.md — iteration statements")
                 (if of
                     (lower-for-of head right body)
                     (lower-for-in head right body))))
    (SsLabeled [label body] (lower-labeled label body))
    (SsThrow [value] (lower-throw value))
    (SsTry [body catch-param catch-body finally-body]
           (lower-try body catch-param catch-body finally-body))
    (SsWith [object body]
            (unimplemented "with object environment" "docs/GAPS.md — with"))
    ;; `debugger` has no observable semantics outside a debugger and lowers to nothing.
    (SsDebugger [] 0)
    ;; A hoisted top-level declaration is already a Fun; nothing executes at its statement.
    ;; A nested declaration was bound on entry; nothing executes at the statement itself.
    (SsFunctionDecl [fun]
                    (if (syntax-fun-lowered? fun)
                        0
                        (unimplemented "generator and async function declarations"
                                       "docs/GAPS.md — function environments")))
    (SsClassDecl [cls] (lower-class-declaration! cls))))

(defn lower-syntax-statements [(stmts (ArrayList i64))] (-> i64)
  (let [(mut i) 0
        (mut terminated) 0]
    (loop (if (or (>= (load i) (len stmts)) (!= (load terminated) 0))
              (break 0)
              (do
                (set! (mut terminated)
                      (lower-syntax-statement (get stmts (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load terminated)))

;; The source-level `main` is an ordinary boxed JavaScript function. A distinct compiler-owned
;; function owns the platform symbol `main`, calls that source function without raw argc/argv, and
;; is the only Return on which ARM64 applies the process-exit conversion. Keeping this call out of
;; the inliner makes both ABIs explicit in the final graph and lets ordinary source calls to `main`
;; continue to observe its boxed result.
(defn parser-install-entry-wrapper! [(start (dyn NodeOps)) (stop (dyn NodeOps))] (-> i64)
  (let [main-idx (parser-source-entry-index)
        p (parser-state)]
    (if (< main-idx 0)
        (panic "parser-install-entry-wrapper!: program has no main function")
        (let [wrapper
              ;; Darwin enters `main(int argc, char **argv)`. Only argc needs a signature slot to
              ;; describe the incoming register bank; the wrapper intentionally ignores both host
              ;; values and supplies boxed undefined for every omitted JavaScript argument.
              (fun-make start
                        (ty-tuple-of2 (ty-dyn TAG-ANY) (ty-int-bot))
                        "main")
                mem-parm
              (parm-make-slot wrapper CALL-MEM (ty-mem 1 TY-BOT) "$mem") exits
              (region-make) exit-mem
              (memphi-make exits 1 TY-BOT "entry.exit.mem") exit-value
              (phi-make exits (ty-dyn TAG-COMPLETION) "entry.exit.value")
                (mut targets)
              (al-new [i64] (compiler-allocator)) (mut ctrl-nid)
              (n-nid wrapper) (mut mem-nid)
              (n-nid mem-parm) (mut value-nid)
              (n-nid (dyn-undefined-make))]
          (parm-set-unknown-input! mem-parm
                                   (proj-make start 1 "entry.start.mem"))
          (n-keep! mem-parm)
          (n-keep! exit-mem)
          (n-keep! exit-value)
          ;; A realm evaluates its Scripts in order, threading control and memory through each
          ;; root call; a function-entry program calls its source `main` once.
          (if (.script-mode p)
              (al-for [root (.scripts p)] (push! [i64] (mut targets) root))
              (push! [i64] (mut targets) main-idx))
          (al-for [target-idx (load targets)]
                  (let [syntax (syntax-fun-at target-idx)
                        target (parser-node (.fun-nid syntax))
                        c
                          (call-make-with-mem (parser-node (load ctrl-nid))
                                              (parser-node (load mem-nid)))]
                    (let [(mut i) 0]
                      (loop (if (> (load i) (+ (parser-abi-slots) 1))
                                (break 0)
                                (do
                                  (call-add-arg! c (dyn-undefined-make))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue)))))
                    (call-set-fptr! c (funptr-make target (.fidx syntax)))
                    (let [end (callend-make c)]
                      (callend-set-never-inline! end)
                      ;; An uncaught Script exception reports and exits the wrapper, never entering
                      ;; a later Script. The common exit works for both process and embedded entry.
                      (let [ctrl (cproj-make end RETURN-CTRL "entry.ctrl")
                            mem (proj-make end RETURN-MEM "entry.mem")
                            value (proj-make end RETURN-VALUE "entry.value")
                            iff
                              (if-make ctrl (typetest-make value TAG-EXCEPTION))
                            arms (if-arms! iff)
                            thrown
                              (load-make (arms-true arms)
                                         mem
                                         (heapstate-make)
                                         (con-int RT-HEAP-OFFSET-EXCEPTION-VALUE)
                                         ALIAS-EXCEPTION-VALUE
                                         (ty-dyn TAG-ANY))
                            report (jsop-make (arms-true arms) mem JS-UNCAUGHT)]
                        (jsop-add-arg! report thrown)
                        (region-add-path! exits (arms-true arms))
                        (memphi-add-state! exit-mem
                                           (proj-make report
                                                      1
                                                      "entry.uncaught.mem"))
                        (phi-add-value! exit-value (box-make (con-int 3)))
                        (set! (mut ctrl-nid) (n-nid (arms-false arms)))
                        (set! (mut mem-nid) (n-nid mem))
                        (set! (mut value-nid) (n-nid value))))))
          (region-add-path! exits (parser-node (load ctrl-nid)))
          (memphi-add-state! exit-mem (parser-node (load mem-nid)))
          (phi-add-value! exit-value (parser-node (load value-nid)))
          (let [ret
                  (return-make exits
                               (Some exit-mem)
                               exit-value
                               (None [(dyn NodeOps)])
                               (Some wrapper))]
            (fun-set-ret! wrapper ret)
            (stop-add-return! stop ret))
          (al-free! [i64] (mut targets))
          (n-unkeep! mem-parm)
          (n-unkeep! exit-mem)
          (n-unkeep! exit-value)
          (set! (.entry-fun-nid p) (n-nid wrapper))
          0))))

;; Script is a grammar goal, not source text wrapped in a function. Its statement spans remain
;; original, Return is forbidden even in nested blocks, and declarations named main are ordinary
;; declarations. A private zero-argument Fun is only its AOT execution container. A realm is an
;; ordered list of Scripts sharing one global object (docs/DECISIONS.md, realm); each Script keeps
;; its own directive prologue and strictness. Global lexical cells shared with source functions
;; remain unimplemented; those accesses fail explicitly instead of borrowing a function-local snapshot.
(defn parse-syntax-program-mode! [(src (slice u8))
                                  (script-mode bool)
                                  (syntax-only bool)] (-> i64)
  (let [(mut sources) (al-new [(slice u8)] (compiler-allocator))]
    (push! [(slice u8)] (mut sources) src)
    (let [answer (parse-syntax-scripts! (load sources) script-mode syntax-only)]
      (al-free! [(slice u8)] (mut sources))
      answer)))

;; One source's syntax pass: collect every declaration before graph construction. This is the
;; hoisting boundary; no semantic node is built while the cover grammar is still ambiguous.
(defn parse-syntax-one-source! [(src (slice u8))
                                (script i64)
                                (script-mode bool)
                                (syntax-only bool)] (-> i64)
  (do
    (lex-init! src)
    (set! (.typed-diagnostics (lexer-state)) syntax-only)
    (set! (.current-script (parser-state)) script)
    (let [(mut script-body) (al-new [i64] (compiler-allocator))
          root-index
            (if script-mode
                (let [(mut symbol) (sb-new (compiler-allocator))]
                  (sb-push-str! (mut symbol) "$aot$.script.")
                  (sb-push-i64! (mut symbol) script)
                  (syntax-fun-reserve! (sb-str (mut symbol))
                                       (FunDeclaration)
                                       false
                                       false
                                       0))
                -1)]
      (if script-mode
          (do
            (set! (.script-index (parser-state)) root-index)
            (push! [i64] (mut (.scripts (parser-state))) root-index)
            (parser-push-root-context! root-index))
          0)
      (loop (let [t (peek-token)]
              (if (= (.kind t) TOK-EOF)
                  (break 0)
                  (do
                    ;; Function-entry mode admits only top-level function declarations; a Script
                    ;; is a statement list whose function declarations are hoisted Funs.
                    (if (not script-mode)
                        (if (or (token-is t "function") (token-is t "async"))
                            (syntax-mark-hoisted! (parse-syntax-function-declaration!))
                            (parse-fail "parser: expected a function declaration at byte"
                                        t))
                        (let [stmt (parse-syntax-statement)]
                          (syntax-mark-hoisted! stmt)
                          (push! [i64] (mut script-body) stmt)))
                    (continue)))))
      (if script-mode
          (let [root (syntax-fun-ptr root-index)]
            (parser-pop-context!)
            (syntax-check-directives! (load script-body))
            (set! (.return-annotation root) (ty-dyn TAG-UNDEFINED))
            (set! (.body root) (load script-body))
            (set! (.hi root) (len src))
            (set! (.hoisted root) true)
            ;; These standard global properties are non-configurable. GlobalDeclarationInstantiation
            ;; rejects a top-level lexical binding over them; block/function locals may shadow them.
            ;; Typed SyntaxError/TypeError delivery is still part of the missing exception host.
            (if (and (not syntax-only)
                     (not (.script-unit (parser-state)))
                     (or (syntax-script-binding? "undefined")
                         (syntax-script-binding? "Infinity")
                         (syntax-script-binding? "NaN")))
                (panic "parser: Script lexical declaration conflicts with a restricted global property")
                0)
            (let [(mut i) 0]
              (loop (if (>= (load i) (len (.funs (parser-state))))
                        (break 0)
                        (let [f (syntax-fun-at (load i))]
                          (if (and (not (syntax-script-root? (load i)))
                                   (syntax-top-level-declaration? (load i)))
                              (do
                                (if (and (not syntax-only)
                                         (not (.script-unit (parser-state)))
                                         (syntax-restricted-global? (.name f)))
                                    (panic "parser: Script function cannot replace a non-writable global property")
                                    0)
                                (if (syntax-script-binding? (.name f))
                                    (syntax-error! "parser: Script lexical declaration conflicts with a function declaration")
                                    0))
                              0)
                          (set! (mut i) (+ (load i) 1))
                          (continue))))))
          0))
    0))

(defn parse-syntax-scripts! [(sources (ArrayList (slice u8)))
                             (script-mode bool)
                             (syntax-only bool)] (-> i64)
  (parse-syntax-scripts-with-boundary! sources script-mode syntax-only false))

(defn parse-syntax-scripts-with-boundary! [(sources (ArrayList (slice u8)))
                                           (script-mode bool)
                                           (syntax-only bool)
                                           (external-mutation bool)] (-> i64)
  (parse-syntax-scripts-config! sources
                                script-mode
                                syntax-only
                                external-mutation
                                false))

(defn parse-syntax-scripts-config! [(sources (ArrayList (slice u8)))
                                    (script-mode bool)
                                    (syntax-only bool)
                                    (external-mutation bool)
                                    (script-unit bool)] (-> i64)
  (do
    (parser-reset!)
    (set! (.script-unit (parser-state)) script-unit)
    (set! (.external-mutation (parser-state)) external-mutation)
    (set! (.script-mode (parser-state)) script-mode)
    (set! (.syntax-only (parser-state)) syntax-only)
    (set! (.strict-pending (parser-state)) false)
    (set! (.script-index (parser-state)) -1)
    (if (and (not script-mode) (!= (len sources) 1))
        (panic "parser: function-entry mode compiles exactly one source")
        0)
    (let [(mut si) 0]
      (loop (if (>= (load si) (len sources))
                (break 0)
                (do
                  (parse-syntax-one-source! (get sources (load si))
                                            (load si)
                                            script-mode
                                            syntax-only)
                  (set! (mut si) (+ (load si) 1))
                  (continue)))))
    (if script-mode
        (do (syntax-declare-intrinsics!) (syntax-collect-globals!))
        0)
    (syntax-settle-strictness!)
    (syntax-check-cover-initializers!)
    (al-for [f (.funs (parser-state))]
            (let [fun f]
              (syntax-check-declarations! (.body fun)
                                          (syntax-fun-bound-names fun)
                                          true
                                          true
                                          (.strict fun))
              (let [(mut labels) (al-new [(slice u8)] (compiler-allocator))
                    (mut loop-labels) (al-new [(slice u8)] (compiler-allocator))]
                (syntax-check-jumps! (.body fun)
                                     (mut labels)
                                     (mut loop-labels)
                                     0
                                     0))))
    ;; Strict code runs (docs/DECISIONS.md, strict code runs): its early errors are checked above,
    ;; a strict function's receiver is taken as it is (`lower-this`), and a strict write to a
    ;; non-writable global is a TypeError (`lower-ref-put!`).
    (syntax-check-strict-functions!)
    (syntax-compute-captures!)
    (syntax-compute-may-throw!)))

;; ---------------------------------------------------------------------------
;; Which bindings a nested function captures (docs/DECISIONS.md, closures)
;;
;; A binding one activation owns and a nested function mentions cannot stay an SSA value: the two
;; functions share it, and either may write it. Such a binding moves into the activation's
;; environment record, a JS array whose element 0 is the enclosing environment and whose other
;; elements are its captured bindings in a fixed order. A record that mentions a captured binding
;; reaches the chain through the function object it was called with, so it needs the callee slot.
;;
;; The pass is one sweep: every record's own references, resolved against the records enclosing it.
;; A name bound by a block, a `let`, a `const` or a class of an enclosing function is not an
;; activation binding — its lifetime is a block or a loop iteration — and capturing it still refuses
;; by name where it is written.
;; Whether a record reads a captured `let`, `const` or `class` — its own or an enclosing
;; activation's — whose slot is empty until its initialization runs. The capture pass recorded it.
(defn syntax-fun-reads-captured-lexical? [(fi i64)] (-> bool)
  (let [f (syntax-fun-ptr fi)] (.reads-captured-lexical f)))

(defn syntax-compute-captures! [] (-> i64)
  (let [p (parser-state)
        count (len (.funs p))
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break 0)
              (do
                (syntax-capture-record! (load i))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

;; One record's references, resolved against the records enclosing it. The ancestor chain is walked
;; once and each ancestor's names are collected once, with every name still unresolved tested
;; against that level: the innermost binding wins, which is what dropping a name on resolution
;; means. Resolving one name at a time would recollect an ancestor's declarations per name.
(defn syntax-capture-record! [(fi i64)] (-> i64)
  (let [(mut names) (al-new [(slice u8)] (compiler-allocator))]
    (syntax-fun-references! fi (mut names))
    (let [(mut pending) (al-new [(slice u8)] (compiler-allocator))]
      ;; One entry per distinct name, so an ancestor level is tested once for each. An arrow's
      ;; `this` is not bound by name: it is the receiver of the nearest function around it.
      (al-for [name (load names)]
              (if (= name THIS-CAPTURE-SLOT)
                  (if (syntax-fun-arrow? fi)
                      (let [owner (syntax-receiver-owner fi)]
                        (if (>= owner 0)
                            (syntax-capture-binding! owner name fi false)
                            0))
                      0)
                  (if (syntax-names-contain? (load pending) name)
                      0
                      (do (push! [(slice u8)] (mut pending) name) 0))))
      (al-free! [(slice u8)] (mut names))
      (let [(mut child) fi
            (mut current) (let [f (syntax-fun-at fi)] (.parent f))]
        (loop (if (or (< (load current) 0) (= (len (load pending)) 0))
                  (break 0)
                  (let [child-fun (syntax-fun-at (load child))
                        current-fun (syntax-fun-at (load current))
                        (mut activation)
                          (al-new [(slice u8)] (compiler-allocator))
                        (mut lexical) (al-new [(slice u8)] (compiler-allocator))
                        (mut unresolved)
                          (al-new [(slice u8)] (compiler-allocator))]
                    (syntax-fun-activation-names! (load current)
                                                  (mut activation))
                    (syntax-fun-lexical-names! (load current)
                                               (.lo child-fun)
                                               (mut lexical))
                    (let [(mut body-lexical)
                            (al-new [(slice u8)] (compiler-allocator))]
                      (syntax-fun-body-lexical-names! (load current)
                                                      (mut body-lexical))
                      (al-for [name (load pending)]
                              (if (syntax-names-contain? (load lexical) name)
                                  ;; A block's binding: resolved here, and not capturable.
                                  0
                                  (if (syntax-names-contain? (load body-lexical)
                                                             name)
                                      (syntax-capture-binding! (load current)
                                                               name
                                                               fi
                                                               true)
                                      (if (syntax-names-contain? (load activation)
                                                                 name)
                                          (syntax-capture-binding! (load current)
                                                                   name
                                                                   fi
                                                                   false)
                                          (do
                                            (push! [(slice u8)]
                                                   (mut unresolved)
                                                   name)
                                            0)))))
                      (al-free! [(slice u8)] (mut body-lexical)))
                    (al-free! [(slice u8)] (mut activation))
                    (al-free! [(slice u8)] (mut lexical))
                    (al-free! [(slice u8)] (mut pending))
                    (set! (mut pending) (load unresolved))
                    (set! (mut child) (load current))
                    (set! (mut current) (.parent current-fun))
                    (continue))))
        (al-free! [(slice u8)] (mut pending))
        0))))

;; `name` is a binding of `owner` that `user`, a function inside it, mentions: give it a slot in
;; `owner`'s environment, and mark every record from `user` out to `owner` as needing the chain.
;; A lexical binding's slot is empty until its initialization, so whoever reads it can throw.
(defn syntax-capture-binding! [(owner i64)
                               (name (slice u8))
                               (user i64)
                               (lexical bool)] (-> i64)
  (let [op (syntax-fun-ptr owner)]
    (if (syntax-names-contain? (.env-names op) name)
        0
        (do
          (push! [(slice u8)] (mut (.env-names op)) name)
          (push! [i64] (mut (.env-lexical op)) (if lexical 1 0))
          0))
    ;; Both sides read the slot through the checked load: the owner's own read of a binding it has
    ;; put in the environment is the dead zone's ReferenceError too.
    (if lexical
        (do
          (set! (.reads-captured-lexical (syntax-fun-ptr user)) true)
          (set! (.reads-captured-lexical op) true)
          0)
        0)
    (set! (.owns-env op) true)
    (let [(mut current) user]
      (loop (if (= (load current) owner)
                (break 0)
                (let [fp (syntax-fun-ptr (load current))]
                  (set! (.uses-env fp) true)
                  (set! (.needs-callee fp) true)
                  (set! (mut current) (.parent fp))
                  (if (< (load current) 0)
                      (broken "syntax-capture-binding!: the owner does not enclose the user")
                      0)
                  (continue)))))
    0))

;; ---------------------------------------------------------------------------
;; Which functions can complete with the exception sentinel
;;
;; The truth is the type: a callee's return type carries TAG-EXCEPTION exactly when a throw path
;; reaches its Return, and `lower-exception-check!` folds to nothing where the type excludes it.
;; This syntactic fixpoint is an optimization over that truth: a direct call to a function it
;; proves cannot throw gets no test built at all (the result is narrowed by a Cast instead), which
;; keeps the parse volume and the optimizer's work proportional to the calls that can throw. A
;; function throws directly when a `throw`, a call whose target the syntax cannot name (a value, a
;; member, a constructor, a reassigned global), a property access (a TypeError on undefined or
;; null), an `instanceof` (a TypeError on a non-callable right operand) or a strict write to a
;; restricted global sits outside every try-with-catch in its body; it throws indirectly when a
;; directly named callee may throw. Shadowing a hoisted name with a local binding still counts as a
;; call to the hoisted function.
;;
;; The filter can only under-approximate by missing a throwing construct, and that is caught: a
;; body whose lowering emits a propagation path (`parser-note-propagation!`) while the filter said
;; it cannot throw is a hard error naming the function, never a silent miscompile.
(defn syntax-fun-may-throw? [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (.may-throw f)))

;; Walk one function's statements once, recording direct throws and named call edges.
;; `protected` is true inside a try body that has a catch clause.
;; Whether an array literal spreads an iterable into itself, which walks it.
(defn syntax-elements-have-spread? [(elements (ArrayList ArrayElement))] (-> bool)
  (let [(mut found) false]
    (al-for [e elements]
            (match e (ElemSpread [expr] (set! (mut found) true)) (_ 0)))
    (load found)))

;; Whether evaluating an object literal can throw for a reason other than its property values, which
;; the walk reaches on its own: a computed key's conversion to a property key
;; (`JsComputedKeyPrimitive`), and an accessor definition, which is a DefinePropertyOrThrow on the
;; literal under construction (`JsDefineLiteralAccessor`).
(defn syntax-literal-defines-may-throw? [(entries (ArrayList ObjectEntry))] (-> bool)
  (let [(mut found) false]
    (al-for [entry entries]
            (match entry
              (PropValue [key value]
                         (match key
                           (KeyComputed [e] (set! (mut found) true))
                           (_ 0)))
              (PropMethod [key fun]
                          (do
                            (match key
                              (KeyComputed [e] (set! (mut found) true))
                              (_ 0))
                            (match (.kind (syntax-fun-ptr fun))
                              (FunGetter [] (set! (mut found) true))
                              (FunSetter [] (set! (mut found) true))
                              (_ 0))
                            0))
              ;; A spread reads every own enumerable property of its source and defines each one.
              (PropSpread [expr] (set! (mut found) true))
              (_ 0)))
    (load found)))

(defn syntax-throw-walk-expr! [(id i64)
                               (protected bool)
                               (direct (mut bool))
                               (edges (mut (ArrayList i64)))] (-> i64)
  (do
    (match (syntax-node id)
      ;; External object bindings can be absent or accessor-backed. This early syntactic pass
      ;; has no Scope, so it conservatively includes local names; graph return types still
      ;; eliminate sentinel checks once lowering proves a local read cannot throw.
      (SxName [name]
              ;; A Script's lexical binding is read from the realm, and a read before its
              ;; initialization is the dead zone's ReferenceError.
              (if (and (not protected)
                       (or (.external-mutation (parser-state))
                           (syntax-script-binding? name)))
                  (set! direct true)
                  0))
      (SxCall [callee args optional]
              (if protected
                  0
                  ;; A spread argument walks an iterable, which is user code and throws, whatever
                  ;; the callee turns out to be.
                  (if (syntax-args-have-spread? args)
                      (set! direct true)
                      (match (syntax-node (syntax-ungroup-id callee))
                        (SxName [name]
                                (let [idx (syntax-find-fun name)
                                      g (syntax-global-index name)]
                                  (if (or (< idx 0)
                                          (and (>= g 0)
                                               (or (.external-mutation (parser-state))
                                                   (.assigned (syntax-global-ptr g)))))
                                      (set! direct true)
                                      (push! [i64] (mut edges) idx))))
                        (_ (set! direct true))))))
      (SxNew [callee args] (if protected 0 (set! direct true)))
      ;; A delete throws on an undefined or null base and, in strict code, when [[Delete]] refuses.
      (SxDelete [operand] (if protected 0 (set! direct true)))
      ;; A substitution is ToString'd, which can call user code and throw.
      (SxTemplate [quasis substitutions]
                  (if (and (not protected) (> (len substitutions) 0))
                      (set! direct true)
                      0))
      ;; A class definition defines its prototype links and members, each of which can throw.
      (SxClass [cls] (if protected 0 (set! direct true)))
      ;; A destructuring assignment reads properties or walks an iterator.
      (SxDestructuringAssign [pattern value] (if protected 0 (set! direct true)))
      ;; An array literal with a spread walks an iterable, which throws.
      (SxArray [elements]
               (if (or protected (not (syntax-elements-have-spread? elements)))
                   0
                   (set! direct true)))
      ;; An object literal converts a computed key and defines an accessor, either of which throws.
      (SxObject [entries]
                (if (or protected
                        (not (syntax-literal-defines-may-throw? entries)))
                    0
                    (set! direct true)))
      ;; A property access on undefined or null is a TypeError.
      (SxMember [owner name optional] (if protected 0 (set! direct true)))
      (SxIndex [owner key optional] (if protected 0 (set! direct true)))
      ;; `instanceof` with a non-callable right operand is a TypeError. The operator is recorded
      ;; by its JSL entry point (a campaign found the source spelling compared here: the filter
      ;; then cleared every function whose only throw was an `instanceof`).
      (SxBinary [op left right]
                (if (and (not protected) (syntax-operator-may-throw? op))
                    (set! direct true)
                    0))
      ;; A unary, update or compound operator whose JSL can throw (ToPrimitive calls user code).
      (SxUnary [op operand]
               (if (and (not protected) (syntax-operator-may-throw? op))
                   (set! direct true)
                   0))
      (SxUpdate [op prefix target] (if protected 0 (set! direct true)))
      (SxCompoundAssign [op target value]
                        (if (and (not protected)
                                 (syntax-operator-may-throw? op))
                            (set! direct true)
                            0))
      ;; A strict write to `undefined`, `NaN` or `Infinity` is a TypeError; sloppy code ignores it,
      ;; but the filter does not know the function's strictness here and stays conservative.
      (SxAssign [target value]
                (if protected
                    0
                    (match (syntax-node (syntax-ungroup-id target))
                      (SxName [name]
                              (if (syntax-restricted-global? name)
                                  (set! direct true)
                                  0))
                      (_ 0))))
      (_ 0))
    (let [(mut kids) (al-new [i64] (compiler-allocator))]
      (syntax-expr-children! id (mut kids))
      (al-for [k (load kids)]
              (syntax-throw-walk-expr! k protected (mut direct) (mut edges)))
      (al-free! [i64] (mut kids))
      0)))

(defn syntax-throw-walk-stmt! [(id i64)
                               (protected bool)
                               (direct (mut bool))
                               (edges (mut (ArrayList i64)))] (-> i64)
  (match (syntax-stmt-node id)
    (SsVar [name init annotation]
           (match init
             (Some [e]
                   (do
                     ;; The implicit PutValue is not an expression child of this declaration.
                     (if (and (not protected)
                              (or (.external-mutation (parser-state))
                                  (syntax-restricted-global? name)))
                         (set! direct true)
                         0)
                     (syntax-throw-walk-expr! e
                                              protected
                                              (mut direct)
                                              (mut edges))))
             (None [] 0)))
    (SsThrow [value]
             (do
               (if protected 0 (set! direct true))
               (syntax-throw-walk-expr! value
                                        protected
                                        (mut direct)
                                        (mut edges))))
    (SsTry [body catch-param catch-body finally-body]
           (do
             (syntax-throw-walk-stmt! body
                                      (or protected
                                          (match catch-body
                                            (Some [_] true)
                                            (None [] false)))
                                      (mut direct)
                                      (mut edges))
             ;; A destructured catch parameter reads properties of the thrown value or walks it as
             ;; an iterator. That binding runs in the handler, which this try does not protect.
             (match catch-param
               (Some [pattern]
                     (match (syntax-pattern-node pattern)
                       (PatName [name] 0)
                       (_ (if protected 0 (set! direct true)))))
               (None [] 0))
             (match catch-body
               (Some [h]
                     (syntax-throw-walk-stmt! h
                                              protected
                                              (mut direct)
                                              (mut edges)))
               (None [] 0))
             (match finally-body
               (Some [t]
                     (syntax-throw-walk-stmt! t
                                              protected
                                              (mut direct)
                                              (mut edges)))
               (None [] 0))))
    ;; A for-in head's PutValue, per iteration, is not an expression child: in a retained unit a var
    ;; head is an environment write that can throw.
    (SsForIn [head of right body awaited]
             (do
               ;; A for-of drives the iteration protocol: GetIterator, `next` and the result's
               ;; property reads are all calls into user code, and each of them throws.
               (if (and (not protected)
                        (or of (.external-mutation (parser-state))))
                   (set! direct true)
                   0)
               (syntax-throw-walk-parts! id protected (mut direct) (mut edges))))
    ;; A class declaration evaluates the class: its member definitions can throw.
    (SsClassDecl [cls] (if protected 0 (set! direct true)))
    ;; A destructuring declaration reads properties or walks an iterator, and both throw.
    (SsLetPattern [pattern init final]
                  (do
                    (if protected 0 (set! direct true))
                    (syntax-throw-walk-parts! id protected (mut direct) (mut edges))))
    (SsVarPattern [pattern init]
                  (do
                    (if protected 0 (set! direct true))
                    (syntax-throw-walk-parts! id protected (mut direct) (mut edges))))
    (_ (syntax-throw-walk-parts! id protected (mut direct) (mut edges)))))

(defn syntax-throw-walk-parts! [(id i64)
                                (protected bool)
                                (direct (mut bool))
                                (edges (mut (ArrayList i64)))] (-> i64)
  (let [(mut kids) (al-new [i64] (compiler-allocator))
        (mut exprs) (al-new [i64] (compiler-allocator))]
    (syntax-stmt-exprs! id (mut exprs))
    (al-for [e (load exprs)]
            (syntax-throw-walk-expr! e protected (mut direct) (mut edges)))
    (syntax-stmt-children! id (mut kids))
    (al-for [k (load kids)]
            (syntax-throw-walk-stmt! k protected (mut direct) (mut edges)))
    (al-free! [i64] (mut exprs))
    (al-free! [i64] (mut kids))
    0))

(defn syntax-compute-may-throw! [] (-> i64)
  (let [p (parser-state)
        count (len (.funs p))
        (mut edge-from) (al-new [i64] (compiler-allocator))
        (mut edge-to) (al-new [i64] (compiler-allocator))
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break 0)
              (let [f (syntax-fun-ptr (load i))
                    ;; Boundary mode is known during syntax collection; retained-unit mode is
                    ;; selected afterward. An external Script's declaration checks may throw
                    ;; even when its body contains only function declarations.
                    (mut direct)
                      (or (and (.external-mutation p)
                               (syntax-script-root? (load i)))
                          ;; A forwarding entry's builtin can complete with any exception, and a class
                          ;; constructor throws when it is called without `new`.
                          (> (len (.abi-builtin f)) 0)
                          (.class-ctor f)
                          ;; A captured lexical is read through its environment slot, which is empty
                          ;; in its temporal dead zone: that read is a ReferenceError.
                          (syntax-fun-reads-captured-lexical? (load i))
                          ;; A destructuring parameter reads properties or walks an iterator, and
                          ;; both of those throw.
                          (syntax-fun-has-patterns? f))
                    (mut edges) (al-new [i64] (compiler-allocator))]
                (al-for [id (.body f)]
                        (syntax-throw-walk-stmt! id
                                                 false
                                                 (mut direct)
                                                 (mut edges)))
                (match (.expression-body f)
                  (Some [e]
                        (syntax-throw-walk-expr! e
                                                 false
                                                 (mut direct)
                                                 (mut edges)))
                  (None [] 0))
                ;; A parameter default is an expression of this function too.
                (al-for [d (.param-defaults f)]
                        (match d
                          (Some [init]
                                (syntax-throw-walk-expr! init
                                                         false
                                                         (mut direct)
                                                         (mut edges)))
                          (None [] 0)))
                (set! (.may-throw f) (load direct))
                (al-for [t (load edges)]
                        (do
                          (push! [i64] (mut edge-from) (load i))
                          (push! [i64] (mut edge-to) t)))
                (al-free! [i64] (mut edges))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; Propagate along call edges to a fixpoint.
    (let [(mut changed) true]
      (loop (if (not (load changed))
                (break 0)
                (do
                  (set! (mut changed) false)
                  (let [(mut e) 0]
                    (loop (if (>= (load e) (len (load edge-from)))
                              (break 0)
                              (let [from
                                      (syntax-fun-ptr (get (load edge-from)
                                                           (load e)))
                                    to (get (load edge-to) (load e))]
                                (if (and (not (.may-throw from))
                                         (syntax-fun-may-throw? to))
                                    (do
                                      (set! (.may-throw from) true)
                                      (set! (mut changed) true))
                                    0)
                                (set! (mut e) (+ (load e) 1))
                                (continue)))))
                  (continue)))))
    (al-free! [i64] (mut edge-from))
    (al-free! [i64] (mut edge-to))
    0))

;; ---------------------------------------------------------------------------
;; The realm's var-like globals
;;
;; Every top-level `var` and function declaration of every Script is a property of the one global
;; object from the start. Functions are recorded first so a same-Script `var` of the same name
;; keeps the function's instantiation; a second function declaration anywhere means the name is
;; reassigned at some Script's instantiation, so calls to it go through the loaded value.
(defn syntax-script-root? [(i i64)] (-> bool)
  (let [(mut found) false]
    (al-for [root (.scripts (parser-state))]
            (if (= root i) (set! (mut found) true) 0))
    (load found)))

(defn syntax-global-index [(name (slice u8))] (-> i64)
  (let [globals (.globals (parser-state))
        (mut i) 0]
    (loop (if (>= (load i) (len globals))
              (break -1)
              (let [b (get globals (load i))]
                (if (= (.name b) name)
                    (break (load i))
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn syntax-global-ptr [(g i64)] (-> (ptr GlobalBinding))
  (al-elem [GlobalBinding] (mut (.globals (parser-state))) g))

(defn syntax-global-declare! [(name (slice u8)) (script i64) (fun i64)] (-> i64)
  (let [existing (syntax-global-index name)]
    (if (< existing 0)
        (do
          (push! [GlobalBinding]
                 (mut (.globals (parser-state)))
                 (GlobalBinding
                   :name name
                   :script script
                   :fun fun
                   :assigned false))
          0)
        (let [g (syntax-global-ptr existing)]
          (if (>= fun 0)
              (do
                (if (>= (.fun g) 0) (set! (.assigned g) true) 0)
                (set! (.fun g) fun))
              0)
          0))))

(defn syntax-mark-assigned-global! [(name (slice u8))] (-> i64)
  (let [g (syntax-global-index name)]
    (if (>= g 0) (do (set! (.assigned (syntax-global-ptr g)) true) 0) 0)))

;; Every name an assignment target can store to. Patterns are walked conservatively: any name
;; appearing inside one counts, whether or not it is a binding position.
(defn syntax-mark-assigned-target! [(target i64)] (-> i64)
  (match (syntax-node target)
    (SxName [name] (syntax-mark-assigned-global! name))
    (SxGroup [inner] (syntax-mark-assigned-target! inner))
    (SxArray [elements]
             (do
               (al-for [element elements]
                       (match element
                         (ElemHole [] 0)
                         (ElemExpr [expr] (syntax-mark-assigned-target! expr))
                         (ElemSpread [expr] (syntax-mark-assigned-target! expr))))
               0))
    (SxObject [entries]
              (do
                (al-for [entry entries]
                        (match entry
                          (PropValue [key value]
                                     (syntax-mark-assigned-target! value))
                          (PropCoverInit [name init]
                                         (syntax-mark-assigned-global! name))
                          (PropSpread [expr]
                                      (syntax-mark-assigned-target! expr))
                          (_ 0)))
                0))
    (SxAssign [inner value] (syntax-mark-assigned-target! inner))
    (_ 0)))

(defn syntax-mark-assigned-pattern! [(pattern i64)] (-> i64)
  (let [(mut names) (al-new [(slice u8)] (compiler-allocator))]
    (syntax-pattern-names! pattern (mut names))
    (al-for [name (load names)] (syntax-mark-assigned-global! name))
    (al-free! [(slice u8)] (mut names))
    0))

(defn syntax-mark-assigned-globals! [] (-> i64)
  (do
    (al-for [x (.exprs (parser-state))]
            (let [expr x]
              (match (.node expr)
                (SxAssign [target value] (syntax-mark-assigned-target! target))
                (SxCompoundAssign [op target value]
                                  (syntax-mark-assigned-target! target))
                (SxLogicalAssign [predicate rhs-on-true target value]
                                 (syntax-mark-assigned-target! target))
                (SxUpdate [op prefix target]
                          (syntax-mark-assigned-target! target))
                (_ 0))))
    (al-for [st (.stmts (parser-state))]
            (let [stmt st]
              (match (.node stmt)
                (SsVar [name init annotation]
                       (match init
                         (Some [e] (syntax-mark-assigned-global! name))
                         (None [] 0)))
                (SsVarPattern [pattern init]
                              (syntax-mark-assigned-pattern! pattern))
                (SsForIn [head of right body awaited]
                         (match head
                           (ForInitDecl [decl]
                                        (match (syntax-stmt-node decl)
                                          (SsVar [name init annotation]
                                                 (syntax-mark-assigned-global! name))
                                          (SsVarPattern [pattern init]
                                                        (syntax-mark-assigned-pattern! pattern))
                                          (_ 0)))
                           (ForInitExpr [expr]
                                        (syntax-mark-assigned-target! expr))
                           (ForInitPattern [pattern]
                                           (syntax-mark-assigned-pattern! pattern))
                           (ForNoInit [] 0)))
                (_ 0))))
    0))

;; ---------------------------------------------------------------------------
;; Standard globals — the builtin library (docs/DECISIONS.md, intrinsics)
;;
;; A standard global is a hoisted function whose body is one JSL builtin: `Error(m)` is the
;; function record `Error(a0)` with the expression body `(SxIntrinsic "JsIntrinsicError" [this,
;; Error, a0])`. Everything else — its Fun, its function object with a `prototype` object, direct
;; and value calls, inlining, `new`, `instanceof` — is what every source function already gets.
;; Only the intrinsics a program names (and the ones those depend on, an Error subclass's parent)
;; are materialized: the realm is closed, so the rest simply do not exist in it.
;;
;; WHICH intrinsics exist, their bodies, prototype chains, property values and attributes are
;; JSL `(intrinsic ...)` declarations (`jsl/compiler/intrinsics.jsl`, read by aot.jsl.decls).
;; This section only flattens them into one row per function or namespace object.
(defn intrinsic-namespace? [(entry Intrinsic)] (-> bool)
  (and (= (.owner entry) "") (= (.target entry) INTRINSIC-TARGET-NAMESPACE)))

(defn syntax-namespace-index [(name (slice u8))] (-> i64)
  (let [p (parser-state)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load found) 0) (>= (load i) (len (.namespaces p))))
              (break 0)
              (do
                (if (= (get (.namespaces p) (load i)) name)
                    (set! (mut found) (load i))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; The image entry of a materialized namespace object; panics for one the realm did not lay out.
(defn syntax-namespace-entry [(name (slice u8))] (-> i64)
  (let [p (parser-state)
        i (syntax-namespace-index name)]
    (if (or (< i 0) (>= i (len (.namespace-entries p))))
        (do
          (panic "syntax-namespace-entry: the realm did not lay out this namespace")
          0)
        (get (.namespace-entries p) i))))

(defn intrinsic-method? [(entry Intrinsic)] (-> bool)
  (!= (.owner entry) ""))

;; The flattened declarations (`jsl-intrinsic-table`). Reading them loads the JSL library, which
;; `parse-program-sources-config` then lowers without loading it again.
(defn intrinsic-table [] (-> (ArrayList Intrinsic))
  (do
    (parser-load-jsl!)
    (jsl-intrinsic-table)))

;; Load the production JSL library once per compilation; lowering then uses it without reloading.
(defn parser-load-jsl! [] (-> i64)
  (let [p (parser-state)]
    (if (.jsl-loaded p)
        0
        (do
          (jsl-load-library! JSL-COMPILER-INDEX)
          (set! (.jsl-loaded p) true)
          0))))

;; May the JSL definition an operator lowers to complete abruptly? The syntactic may-throw filter asks
;; before any graph exists, so it loads the library if collection has not.
(defn syntax-operator-may-throw? [(op (slice u8))] (-> bool)
  (do (parser-load-jsl!) (jsl-throws? (lower-operator-entry op))))

(defn intrinsic-index [(table (ArrayList Intrinsic)) (name (slice u8))] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) (len table)) (>= (load found) 0))
              (break 0)
              (do
                (let [entry (get table (load i))]
                  (if (= (.name entry) name) (set! (mut found) (load i)) 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; Does any expression in the realm name `name` as an identifier?
(defn syntax-names-identifier? [(name (slice u8))] (-> bool)
  (let [(mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) (len (.exprs (parser-state)))) (load found))
              (break 0)
              (do
                (let [x (get (.exprs (parser-state)) (load i))]
                  (match (.node x)
                    (SxName [n] (if (= n name) (set! (mut found) true) 0))
                    (_ 0)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

(defn syntax-intrinsic-fun? [(i i64)] (-> bool)
  (let [f (syntax-fun-at i)] (and (.hoisted f) (< (.script f) 0))))

;; FUNCTION-FLAG-* of a function record's object. MakeConstructor (§10.2.5) gives an ordinary
;; function declaration or expression that is not a generator or async a base [[Construct]];
;; arrows, methods and accessors have none (§15.3.4, §15.4). A built-in has [[Construct]] exactly
;; when its JSL declaration says `:constructor`, and creates its own result from NewTarget.
(defn syntax-fun-construct-flags [(i i64)] (-> i64)
  (if (syntax-intrinsic-fun? i)
      (if (syntax-intrinsic-constructor? i) FUNCTION-FLAG-CONSTRUCTOR 0)
      (let [f (syntax-fun-at i)]
        (if (or (.generator f) (.async f))
            0
            (if (.class-ctor f)
                ;; A class constructor constructs; calling it without `new` is a TypeError its body
                ;; raises (§15.7.14). A base class creates its own `this`; a derived one's comes from
                ;; `super()`, so it has no base [[Construct]].
                (if (.derived-ctor f)
                    FUNCTION-FLAG-CONSTRUCTOR
                    (+ FUNCTION-FLAG-CONSTRUCTOR FUNCTION-FLAG-BASE-CONSTRUCTOR))
                (match (.kind f)
                  (FunDeclaration []
                                  (+ FUNCTION-FLAG-CONSTRUCTOR
                                     FUNCTION-FLAG-BASE-CONSTRUCTOR))
                  (FunExpression []
                                 (+ FUNCTION-FLAG-CONSTRUCTOR
                                    FUNCTION-FLAG-BASE-CONSTRUCTOR))
                  (_ 0)))))))

;; An intrinsic declared `:constructor` (not a global function, method or namespace).
(defn syntax-intrinsic-constructor? [(i i64)] (-> bool)
  (if (syntax-intrinsic-fun? i)
      (let [table (intrinsic-table)
            f (syntax-fun-at i)
            entry (get table (intrinsic-index table (.name f)))]
        (and (not (intrinsic-method? entry))
             (= (.kind entry) JSL-INTRINSIC-CONSTRUCTOR)))
      false))

;; Reserve the function record and the global binding of one intrinsic (once). A namespace has no
;; function: it is recorded for the realm layout and bound as a plain global.
(defn syntax-declare-intrinsic! [(entry Intrinsic)] (-> i64)
  (if (intrinsic-namespace? entry)
      (if (>= (syntax-namespace-index (.name entry)) 0)
          0
          (do
            (push! [(slice u8)]
                   (mut (.namespaces (parser-state)))
                   (.name entry))
            (syntax-global-declare! (.name entry) -1 -1)
            0))
      (if (= (.target entry) INTRINSIC-TARGET-ENTRY)
          (syntax-declare-intrinsic-entry! entry)
          (if (>= (syntax-find-intrinsic-fun (.name entry)) 0)
              0
              (let [index
                      (syntax-fun-reserve! (.name entry)
                                           (FunDeclaration)
                                           false
                                           false
                                           0)
                    fp (syntax-fun-ptr index)
                    (mut args) (al-new [i64] (compiler-allocator))
                    (mut i) 0]
                (set! (.hoisted fp) true)
                (set! (.script fp) -1)
                (set! (.parent fp) -1)
                ;; A built-in function receives `this` as the caller passed it (ECMA-262 §10.3: built-ins
                ;; are not sloppy functions); no receiver mapping at its entry.
                (set! (.strict fp) true)
                (if (.abi entry)
                    ;; The builtin is the entry itself: no formals, no body.
                    (do
                      (set! (.abi-builtin fp) (.builtin entry))
                      (set! (.may-throw fp) true)
                      0)
                    (do
                      ;; A constructor's body is (this new.target callee a0 a1 ...): the receiver, `new.target`
                      ;; (undefined when called, the constructor when constructed: how the body tells the two
                      ;; apart), the constructor's own function object (its `prototype` is what a plain call
                      ;; still needs), then the arguments. A method's is (this a0 a1 ...): it has no global
                      ;; binding to name itself by and no use for its own object.
                      (push! [i64] (mut args) (syntax-add-node! (SxThis) 0 0))
                      (if (intrinsic-method? entry)
                          0
                          (do
                            (push! [i64]
                                   (mut args)
                                   (syntax-add-node! (SxNewTarget) 0 0))
                            (push! [i64]
                                   (mut args)
                                   (syntax-add-node! (SxName :name (.name entry))
                                                     0
                                                     0))))
                      (loop (if (>= (load i) (.arity entry))
                                (break 0)
                                (let [(mut sb) (sb-new (compiler-allocator))]
                                  (sb-push-str! (mut sb) "$aot$arg")
                                  (sb-push-i64! (mut sb) (load i))
                                  (let [pname (sb-str (mut sb))]
                                    (push! [(slice u8)]
                                           (mut (.params fp))
                                           pname)
                                    (push! [i64]
                                           (mut (.param-annotations fp))
                                           (ty-dyn TAG-ANY))
                                    (push! [(Option i64)]
                                           (mut (.param-defaults fp))
                                           (None [i64]))
                                    (push! [(Option i64)]
                                           (mut (.param-patterns fp))
                                           (None [i64]))
                                    (push! [i64]
                                           (mut args)
                                           (syntax-add-node! (SxName :name pname)
                                                             0
                                                             0)))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))
                      (set! (.expression-body fp)
                            (Some (syntax-add-node! (SxIntrinsic :builtin
                                                                   (.builtin entry)
                                                      :args (load args))
                                                    0
                                                    0)))
                      0))
                (if (intrinsic-method? entry)
                    0
                    ;; A binding a Script function declaration already owns stays that function's.
                    (let [g (syntax-global-index (.name entry))]
                      (if (and (>= g 0) (>= (.fun (syntax-global-ptr g)) 0))
                          0
                          (syntax-global-declare! (.name entry) -1 index))))
                0)))))

;; An entry (`(intrinsic %Name% :entry Builtin)`): a record with only a forwarding entry, no global
;; binding, no function object of its own and no image presence. It is not hoisted, so no source
;; name resolves to it; `%MakeClosure` names it.
(defn syntax-declare-intrinsic-entry! [(entry Intrinsic)] (-> i64)
  (if (>= (syntax-find-entry-fun (.name entry)) 0)
      0
      (let [index
              (syntax-fun-reserve! (.name entry) (FunDeclaration) false false 0)
            fp (syntax-fun-ptr index)]
        (set! (.hoisted fp) false)
        (set! (.script fp) -1)
        (set! (.parent fp) -1)
        (set! (.strict fp) true)
        (set! (.abi-builtin fp) (.builtin entry))
        (set! (.may-throw fp) true)
        0)))

;; The record of a declared entry, or -1.
(defn syntax-find-entry-fun [(name (slice u8))] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load found) 0)
                  (>= (load i) (len (.funs (parser-state)))))
              (break 0)
              (let [f (syntax-fun-ptr (load i))]
                (if (and (= (.name f) name)
                         (not (.hoisted f))
                         (> (len (.abi-builtin f)) 0))
                    (set! (mut found) (load i))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; The intrinsics declared during syntax collection, before the Scripts' own declarations so a
;; Script redefining `Object` shadows it as JavaScript says it does.
;;
;; A shared-realm provider, and any other external Script unit that is not a provider's client,
;; carries the entire declared surface: another unit it cannot see may observe any of it. A closed
;; program declares the roots its identifiers bind (with their parents) and the ones its image objects
;; need for their declared [[Prototype]] chains; every other intrinsic materializes by demand while
;; the program lowers (`parser-settle-realm!`). A provider's client carries the foundational chain
;; objects and the roots its identifiers bind, never a method (docs/DECISIONS.md, the provider
;; carries the declared surface).
(defn syntax-declare-intrinsics! [] (-> i64)
  (let [p (parser-state)
        table (intrinsic-table)
        mode (.link-mode (jsl-graphs))
        full
          (or (= mode JSL-LINK-PROVIDER)
              (and (.external-mutation p) (= mode JSL-LINK-LOCAL)))
        (mut any-root) false
        (mut i) 0]
    (loop (if (>= (load i) (len table))
              (break 0)
              (let [entry (get table (load i))]
                (if (and (not (intrinsic-method? entry))
                         ;; An entry has no name a source identifier binds; only a full surface carries it up front.
                         (or full
                             (and (!= (.target entry) INTRINSIC-TARGET-ENTRY)
                                  (syntax-names-identifier? (.name entry)))))
                    (do
                      (if (!= (.parent entry) "")
                          (let [pi (intrinsic-index table (.parent entry))]
                            (if (< pi 0)
                                (panic "syntax-declare-intrinsics!: an intrinsic names an unknown parent")
                                (syntax-declare-intrinsic! (get table pi))))
                          0)
                      (syntax-declare-intrinsic! entry)
                      (set! (mut any-root) true)
                      0)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; Declared chains end at %Object.prototype%, and every function object's [[Prototype]] is
    ;; %Function.prototype%: a realm with an intrinsic root, a hoisted function in its image, or an
    ;; external boundary (whose callers observe those chains) has both.
    (if (or (load any-root)
            (.external-mutation p)
            (syntax-has-hoisted-function?))
        (do
          (syntax-declare-intrinsic! (get table
                                          (intrinsic-index table "Object")))
          (syntax-declare-intrinsic! (get table
                                          (intrinsic-index table "Function")))
          0)
        0)
    (if (and (.external-mutation p) (= mode JSL-LINK-IMPORT))
        (do
          ;; A client's language-raised errors must name the canonical prototypes; a later unit
          ;; cannot repair a null [[Prototype]] by canonicalizing identities.
          (syntax-declare-intrinsic! (get table (intrinsic-index table "Error")))
          (syntax-declare-intrinsic! (get table
                                          (intrinsic-index table "TypeError")))
          (syntax-declare-intrinsic! (get table
                                          (intrinsic-index table
                                                           "ReferenceError")))
          (syntax-declare-intrinsic! (get table
                                          (intrinsic-index table "SyntaxError")))
          0)
        0)
    (if full
        (do
          (set! (mut i) 0)
          (loop (if (>= (load i) (len table))
                    (break 0)
                    (let [entry (get table (load i))]
                      (if (intrinsic-method? entry)
                          (syntax-declare-intrinsic! entry)
                          0)
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          0)
        0)
    0))

;; Does the realm hold a hoisted source function other than a Script root (an image object)?
(defn syntax-has-hoisted-function? [] (-> bool)
  (let [(mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) (len (.funs (parser-state)))))
              (break 0)
              (let [f (syntax-fun-at (load i))]
                (if (and (.hoisted f)
                         (not (syntax-script-root? (load i)))
                         (not (syntax-intrinsic-fun? (load i))))
                    (set! (mut found) true)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; The body of an intrinsic: its JSL builtin over the lowered operands.
(defn lower-intrinsic-call [(builtin (slice u8)) (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [(mut values) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (al-for [a args]
            (let [v (lower-syntax-expr a)]
              (n-keep! v)
              (push! [(dyn NodeOps)] (mut values) v)))
    (let [scope (parser-node (.current-scope (parser-state)))
          r (lower-jsl-call-values builtin (load values))]
      (al-for [v (load values)] (n-unkeep! v))
      (al-free! [(dyn NodeOps)] (mut values))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (.value r))))

;; Every `this.name = …` target in a statement's own code (functions have their own `this`; their
;; bodies are separate records and are not entered).
(defn syntax-collect-this-properties! [(stmt i64)
                                       (names (mut (ArrayList (slice u8))))] (-> i64)
  (let [(mut exprs) (al-new [i64] (compiler-allocator))
        (mut stmts) (al-new [i64] (compiler-allocator))]
    (syntax-stmt-exprs! stmt (mut exprs))
    (al-for [e (load exprs)]
            (syntax-collect-this-properties-expr! e (mut names)))
    (syntax-stmt-children! stmt (mut stmts))
    (al-for [child (load stmts)]
            (syntax-collect-this-properties! child (mut names)))
    (al-free! [i64] (mut exprs))
    (al-free! [i64] (mut stmts))
    0))

(defn syntax-collect-this-properties-expr! [(id i64)
                                            (names (mut (ArrayList (slice u8))))] (-> i64)
  (do
    (match (syntax-node id)
      (SxAssign [target value]
                (match (syntax-node (syntax-ungroup-id target))
                  (SxMember [owner name optional]
                            (match (syntax-node (syntax-ungroup-id owner))
                              (SxThis []
                                      (do
                                        (push! [(slice u8)] (mut names) name)
                                        0))
                              (_ 0)))
                  (_ 0)))
      (_ 0))
    (let [(mut kids) (al-new [i64] (compiler-allocator))]
      (syntax-expr-children! id (mut kids))
      (al-for [k (load kids)]
              (syntax-collect-this-properties-expr! k (mut names)))
      (al-free! [i64] (mut kids))
      0)))

(defn syntax-script-lexicals! [(stmts (ArrayList i64))
                               (entries (mut (ArrayList CuScriptDecl)))] (-> i64)
  (al-for [id stmts]
          (match (syntax-stmt-node id)
            (SsLet [name init final annotation]
                   (push! [CuScriptDecl]
                          (mut entries)
                          (CuScriptDecl
                            :name name
                            :kind (if final CU-SCRIPT-CONST CU-SCRIPT-LET)
                            :function-ordinal -1)))
            (SsLetPattern [pattern init final]
                          (let [(mut names)
                                  (al-new [(slice u8)] (compiler-allocator))]
                            (syntax-pattern-names! pattern (mut names))
                            (al-for [name (load names)]
                                    (push! [CuScriptDecl]
                                           (mut entries)
                                           (CuScriptDecl
                                             :name name
                                             :kind
                                               (if final
                                                   CU-SCRIPT-CONST
                                                   CU-SCRIPT-LET)
                                             :function-ordinal -1)))
                            (al-free! (mut names))))
            (SsClassDecl [cls]
                         (let [c (get (.classes (parser-state)) cls)]
                           (push! [CuScriptDecl]
                                  (mut entries)
                                  (CuScriptDecl
                                    :name (.name c)
                                    :kind CU-SCRIPT-CLASS
                                    :function-ordinal -1))))
            (SsDeclList [decls] (syntax-script-lexicals! decls (mut entries)))
            (_ 0)))
  0)

;; One declaration plan drives global collection and both instantiation paths. Names in these
;; generation-local plans borrow syntax storage; capture below deep-copies them. Only the parser's
;; parallel binding table knows SyntaxFun indices. The exported plan uses Script-local ordinals.
(defn syntax-build-script-declarations! [(script i64)] (-> i64)
  (let [p (parser-state)
        root (syntax-fun-at (get (.scripts p) script))
        (mut entries) (al-new [CuScriptDecl] (compiler-allocator))
        (mut functions) (al-new [i64] (compiler-allocator))
        (mut names) (al-new [(slice u8)] (compiler-allocator))]
    (if (!= script (len (.script-declarations p)))
        (panic "syntax-build-script-declarations!: plans must follow Script order")
        0)
    (al-for [id (.body root)]
            (match (syntax-stmt-node id)
              (SsFunctionDecl [fun]
                              (let [f (syntax-fun-at fun)]
                                (push! [CuScriptDecl]
                                       (mut entries)
                                       (CuScriptDecl
                                         :name (.name f)
                                         :kind CU-SCRIPT-FUNCTION
                                         :function-ordinal
                                           (len (load functions))))
                                (push! [i64] (mut functions) fun)))
              (_ 0)))
    (syntax-collect-declarations! (.body root) false (mut names))
    (al-for [name (load names)]
            (push! [CuScriptDecl]
                   (mut entries)
                   (CuScriptDecl
                     :name name
                     :kind CU-SCRIPT-VAR
                     :function-ordinal -1)))
    (syntax-script-lexicals! (.body root) (mut entries))
    (al-clear! (mut names))
    (al-for [id (.body root)] (syntax-collect-this-properties! id (mut names)))
    (al-for [name (load names)]
            (push! [CuScriptDecl]
                   (mut entries)
                   (CuScriptDecl
                     :name name
                     :kind CU-SCRIPT-PROPERTY-WRITE
                     :function-ordinal -1)))
    (al-free! (mut names))
    (push! [(ArrayList CuScriptDecl)]
           (mut (.script-declarations p))
           (load entries))
    (push! [(ArrayList i64)] (mut (.script-functions p)) (load functions))
    0))

(defn parser-capture-script-declarations [(script i64)] (-> CuScriptDeclarations)
  (let [p (parser-state)]
    (if (or (< script 0) (>= script (len (.script-declarations p))))
        (panic "parser-capture-script-declarations: unknown Script")
        0)
    (cu-script-declarations-copy (syntax-fun-strict (get (.scripts p) script))
                                 (get (.script-declarations p) script))))

(defn syntax-script-declared-function [(script i64) (ordinal i64)] (-> i64)
  (let [p (parser-state)]
    (if (or (< script 0) (>= script (len (.script-functions p))))
        (panic "syntax-script-declared-function: unknown Script")
        0)
    (let [functions (get (.script-functions p) script)]
      (if (or (< ordinal 0) (>= ordinal (len functions)))
          (panic "syntax-script-declared-function: unknown declaration ordinal")
          0)
      (get functions ordinal))))

(defn syntax-collect-globals! [] (-> i64)
  (let [p (parser-state)
        (mut si) 0]
    (loop (if (>= (load si) (len (.scripts p)))
              (break 0)
              (do
                (syntax-build-script-declarations! (load si))
                (al-for [entry (get (.script-declarations p) (load si))]
                        (let [e entry]
                          (if (= (.kind e) CU-SCRIPT-FUNCTION)
                              (syntax-global-declare! (.name e)
                                                      (load si)
                                                      (syntax-script-declared-function (load si)
                                                                                       (.function-ordinal e)))
                              (if (or (= (.kind e) CU-SCRIPT-VAR)
                                      (= (.kind e) CU-SCRIPT-PROPERTY-WRITE))
                                  (syntax-global-declare! (.name e)
                                                          (load si)
                                                          -1)
                                  0))))
                (set! (mut si) (+ (load si) 1))
                (continue))))
    (syntax-mark-assigned-globals!)
    0))

;; The realm's global object as a proven raw object at the current point.
(defn lower-global-object-raw [] (-> (dyn NodeOps))
  (unbox-make (lower-global-object) REP-OBJECT))

;; The Script whose code is being lowered.
(defn parser-current-script [] (-> i64)
  (let [f (syntax-fun-at (.current-fun (parser-state)))] (.script f)))

;; The Fun a call to global `g` may name directly, or -1: a never-reassigned function declaration
;; the calling Script can already see.
(defn syntax-global-direct-fun [(g i64)] (-> i64)
  (let [b (get (.globals (parser-state)) g)]
    (if (and (not (.external-mutation (parser-state)))
             (>= (.fun b) 0)
             (not (.assigned b))
             (<= (.script b) (parser-current-script)))
        (.fun b)
        -1)))

;; Closed-program globals use their image address. Reusable Script units read the executing
;; realm's root; the template retained by this compilation does not establish global identity.
(defn lower-global-object [] (-> (dyn NodeOps))
  (let [p (parser-state)
        scope (parser-node (.current-scope p))]
    (if (>= (heap-global-reference-entry) 0)
        (box-make (staticref-make (heap-global-reference-entry) REP-OBJECT))
        (realm-global-object-load (parser-node (.current-ctrl p))
                                  (scope-mem scope)))))

(defn lower-global-load [(name (slice u8))] (-> (dyn NodeOps))
  ;; A declaration records a name, not permission to read its descriptor storage as a value.
  ;; Another unit can replace a configurable global with an accessor or remove it. Use the same
  ;; JSL environment read as an imported name, including its completion. Closed compilation
  ;; retains its existing own-slot path and earlier-Script diagnostics.
  (if (< (syntax-global-index name) 0)
      (panic "lower-global-load: name is not a realm global")
      0)
  (if (.external-mutation (parser-state))
      (lower-completion! (lower-jsl-unary-value "JsGlobalBindingRead"
                                                (keyref-make (shape-key-intern name))))
      (lower-closed-global-load name)))

(defn lower-closed-global-load [(name (slice u8))] (-> (dyn NodeOps))
  (let [g (syntax-global-index name)
        p (parser-state)]
    (if (< g 0) (panic "lower-global-load: name is not a realm global") 0)
    ;; Top-level code of an earlier Script reading a global a later Script declares runs before
    ;; that declaration is instantiated: a ReferenceError, unimplemented. A function body resolves
    ;; the name when it is called, which is after every Script's instantiation in the common case
    ;; (the harness's functions naming the test's globals); a call made too early reads the slot's
    ;; initial undefined instead of the ReferenceError (docs/GAPS.md).
    (let [b (get (.globals p) g)]
      (if (and (> (.script b) (parser-current-script))
               (syntax-script-root? (.current-fun p)))
          (unimplemented "reference to a global declared only by a later Script (ReferenceError before its instantiation)"
                         "docs/GAPS.md — shared global-object bindings")
          0))
    (let [object (lower-global-object-raw)
          scope (parser-node (.current-scope p))
          ;; An access on the global object, an image object: it folds to the image word or to a
          ;; fixed-offset load once the closed-world facts are in (aot.node.property,
          ;; prop-image-resolve!).
          loaded
            (prop-access-emit (parser-node (.current-ctrl p))
                              (scope-mem scope)
                              object
                              (None [(dyn NodeOps)])
                              (shape-key-intern name)
                              PROP-LOAD)]
      (parser-set-current-ctrl! (.ctrl loaded))
      (scope-set-mem! scope (.mem loaded))
      (.value loaded))))

(defn lower-global-store! [(name (slice u8)) (value (dyn NodeOps))] (-> i64)
  (let [g (syntax-global-index name)
        p (parser-state)]
    (if (< g 0) (panic "lower-global-store!: name is not a realm global") 0)
    (n-keep! value)
    (let [object (lower-global-object-raw)
          scope (parser-node (.current-scope p))
          stored
            (prop-access-emit (parser-node (.current-ctrl p))
                              (scope-mem scope)
                              object
                              (Some value)
                              (shape-key-intern name)
                              PROP-STORE)]
      (n-unkeep! value)
      (parser-set-current-ctrl! (.ctrl stored))
      (scope-set-mem! scope (.mem stored))
      0)))

;; Realm creation as data: the static heap image (aot.heap, docs/DECISIONS.md, the realm image).
;;
;; Everything a realm holds before its first statement runs is laid out here, once, after the
;; header pass has given every hoisted function its Fun and index: the global object with an
;; `undefined` property per var-like global in table order (so its hidden class is the table's),
;; one function object with its `prototype` object per hoisted declaration of every Script and per
;; materialized intrinsic, the properties CreateIntrinsics gives an Error prototype, and the
;; global object's initial words — the intrinsics, then the first Script's own function
;; declarations in order, later declarations winning, exactly the stores GlobalDeclarationInstantiation
;; would have made before that Script's first statement. A later Script's function step stays a
;; store at its start (`lower-global-instantiation!`): the first Script runs before it and must
;; still see `undefined`.
;; Reusable Script units omit source bindings from this template. Their initializers check and
;; create those bindings in the executing global; only intrinsic properties exist on adoption.
;; globalThis (§19.1.1): the global object itself, writable and configurable but not enumerable.
;; It is a property whose value is its own carrier, so it is defined here rather than declared.
(defn realm-image-global-this! [(global i64)] (-> i64)
  (heap-define-own-attrs! global
                          "globalThis"
                          (heap-ref-word DYNAMIC-PREFIX-OBJECT global)
                          HEAP-WORD-REF
                          (+ SHAPE-ATTR-WRITABLE SHAPE-ATTR-CONFIGURABLE)))

(defn realm-image-build! [] (-> i64)
  (let [p (parser-state)
        global (heap-add-object! DYNAMIC-NULL-WORD)]
    (if (.script-unit p)
        (do
          ;; SetDefaultGlobalBindings: these singleton properties participate in runtime
          ;; declaration checks even when source identifier reads can use a constant.
          (heap-define-own-attrs! global
                                  "undefined"
                                  DYNAMIC-UNDEFINED-WORD
                                  HEAP-WORD-CONST
                                  0)
          (heap-define-own-attrs! global
                                  "Infinity"
                                  NUMBER-INFINITY-BITS
                                  HEAP-WORD-CONST
                                  0)
          (heap-define-own-attrs! global
                                  "NaN"
                                  NUMBER-NAN-BITS
                                  HEAP-WORD-CONST
                                  0)
          (realm-image-global-this! global)
          0)
        (do
          (al-for [g (.globals p)]
                  (let [binding g]
                    ;; CreateGlobalVarBinding / CreateGlobalFunctionBinding (§9.1.1.4.17–18): writable,
                    ;; enumerable, not configurable.
                    (heap-define-own-attrs! global
                                            (.name binding)
                                            DYNAMIC-UNDEFINED-WORD
                                            HEAP-WORD-CONST
                                            (+ SHAPE-ATTR-WRITABLE
                                               SHAPE-ATTR-ENUMERABLE))))
          0))
    (heap-set-global! global)
    ;; The phases below run over every record in declaration order, so the image's entry and
    ;; property order is the realm's declaration order. `realm-image-add-intrinsic!` runs the same
    ;; phases for one record materialized later, before the image facts exist.
    (realm-image-each-hoisted! (primitive/fnptr-of realm-image-function-object!))
    (realm-image-each-intrinsic! (primitive/fnptr-of realm-image-root-binding!))
    (al-clear! [i64] (mut (.namespace-entries p)))
    (al-for [name (.namespaces p)] (realm-image-namespace! name))
    (realm-image-each-intrinsic! (primitive/fnptr-of realm-image-method-placement!))
    (realm-image-each-intrinsic! (primitive/fnptr-of realm-image-register-prototype!))
    (realm-image-link-function-prototypes!)
    (realm-image-link-object-prototypes!)
    (realm-image-each-intrinsic! (primitive/fnptr-of realm-image-constructor-record-setup!))
    ;; Closed programs preinstall the first Script's functions. Reusable Script units execute
    ;; this step through the retained initializer so adoption alone does not evaluate a Script.
    (if (and (> (len (.scripts p)) 0) (not (.script-unit p)))
        (do
          (al-for [entry (get (.script-declarations p) 0)]
                  (let [e entry]
                    (if (= (.kind e) CU-SCRIPT-FUNCTION)
                        (let [declared
                                (syntax-fun-at (syntax-script-declared-function 0
                                                                                (.function-ordinal e)))]
                          (heap-define-own-attrs! global
                                                  (.name e)
                                                  (heap-ref-word DYNAMIC-PREFIX-FUNCTION
                                                                 (.static-entry declared))
                                                  HEAP-WORD-REF
                                                  (+ SHAPE-ATTR-WRITABLE
                                                     SHAPE-ATTR-ENUMERABLE)))
                        0)))
          0)
        0)
    0))

(defn realm-image-each-hoisted! [(step (fnptr c [i64] i64))] (-> i64)
  (let [(mut fi) 0]
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break 0)
              (let [f (syntax-fun-at (load fi))]
                (if (and (.hoisted f) (not (syntax-script-root? (load fi))))
                    (primitive/call-ptr step (load fi))
                    0)
                (set! (mut fi) (+ (load fi) 1))
                (continue))))))

(defn realm-image-each-intrinsic! [(step (fnptr c [i64] i64))] (-> i64)
  (let [(mut fi) 0]
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break 0)
              (do
                (if (syntax-intrinsic-fun? (load fi))
                    (primitive/call-ptr step (load fi))
                    0)
                (set! (mut fi) (+ (load fi) 1))
                (continue))))))

(defn realm-image-intrinsic-entry [(fi i64)] (-> Intrinsic)
  (let [table (intrinsic-table)
        f (syntax-fun-at fi)]
    (get table (intrinsic-index table (.name f)))))

;; A hoisted declaration's or intrinsic's function object, MakeConstructor included.
(defn realm-image-function-object! [(fi i64)] (-> i64)
  (let [f (syntax-fun-at fi)]
    (if (not (syntax-fun-lowered? fi))
        (unimplemented-function-value fi)
        0)
    (let [flags (syntax-fun-construct-flags fi)
          constructor (!= (& flags FUNCTION-FLAG-CONSTRUCTOR) 0)
          fobj
            (heap-add-function! (.adapter-fidx f)
                                DYNAMIC-NULL-WORD
                                flags)
          proto (if constructor (heap-add-object! DYNAMIC-NULL-WORD) -1)
          fp (syntax-fun-ptr fi)]
      ;; MakeConstructor (§10.2.5): `prototype` writable only, `constructor` writable and
      ;; configurable. A function without [[Construct]] has neither.
      (if constructor
          (heap-define-own-attrs! proto
                                  "constructor"
                                  (heap-ref-word DYNAMIC-PREFIX-FUNCTION fobj)
                                  HEAP-WORD-REF
                                  (+ SHAPE-ATTR-WRITABLE
                                     SHAPE-ATTR-CONFIGURABLE))
          0)
      ;; A built-in function (CreateBuiltinFunction, §10.3.4) defines `length` then `name`, both
      ;; configurable only; a built-in constructor's `prototype` is neither writable, enumerable
      ;; nor configurable (§20-§23).
      (if (syntax-intrinsic-fun? fi)
          (let [entry (realm-image-intrinsic-entry fi)]
            (heap-define-own-attrs! fobj
                                    "length"
                                    (number-word (primitive/cast f64
                                                                 (.length entry)))
                                    HEAP-WORD-CONST
                                    SHAPE-ATTR-CONFIGURABLE)
            (heap-define-own-attrs! fobj
                                    "name"
                                    (realm-image-ascii-string-word (if (intrinsic-method? entry)
                                                                       (.prop entry)
                                                                       (.name entry)))
                                    HEAP-WORD-REF
                                    SHAPE-ATTR-CONFIGURABLE))
          0)
      (if constructor
          (heap-define-own-attrs! fobj
                                  "prototype"
                                  (heap-ref-word DYNAMIC-PREFIX-OBJECT proto)
                                  HEAP-WORD-REF
                                  (if (syntax-intrinsic-fun? fi)
                                      0
                                      SHAPE-ATTR-WRITABLE))
          0)
      (set! (.static-entry fp) fobj)
      ;; The pointer escapes into a value: the Fun is never inlined away from under its address. At
      ;; an external boundary this object may be observed without a local call site, so caller
      ;; closure must keep its generic hook.
      (set! (.value-taken fp) true)
      (fun-set-escapes! (parser-node (.adapter-nid f)))
      ;; The code word is typed as the finite set of every value-taken function; the linker
      ;; (`opto-link-cg!`) resolves each index through the registry a FunPtr would have filled.
      (arena-register-function! (.adapter-fidx f)
                                (parser-node (.adapter-nid f)))
      0)))

;; A global intrinsic function's binding, with its declared attributes.
(defn realm-image-root-binding! [(fi i64)] (-> i64)
  (let [f (syntax-fun-at fi)
        entry (realm-image-intrinsic-entry fi)
        g (syntax-global-index (.name f))
        ;; A closed program's Script function declaration owns the binding (preinstalled below).
        shadowed
          (and (not (.script-unit (parser-state)))
               (>= g 0)
               (let [b (get (.globals (parser-state)) g)]
                 (and (>= (.fun b) 0) (not (syntax-intrinsic-fun? (.fun b))))))]
    (if (or (intrinsic-method? entry) shadowed)
        0
        (heap-define-own-attrs! (heap-global-entry)
                                (.name f)
                                (heap-ref-word DYNAMIC-PREFIX-FUNCTION
                                               (.static-entry f))
                                HEAP-WORD-REF
                                (.attrs entry)))))

;; A namespace object (`Math`): an ordinary object, the global binding's word, the well-known
;; name, and its declared data properties.
(defn realm-image-namespace! [(name (slice u8))] (-> i64)
  (let [p (parser-state)
        table (intrinsic-table)
        obj (heap-add-object! DYNAMIC-NULL-WORD)
        entry (get table (intrinsic-index table name))]
    (push! [i64] (mut (.namespace-entries p)) obj)
    (if (.anonymous entry)
        ;; An object the specification names and a program cannot: no global binding, and the
        ;; registry name is the one JSL asks for (docs/DECISIONS.md, iteration).
        (let [(mut b) (sb-new (compiler-allocator))]
          (sb-push-str! (mut b) name)
          (sb-push-str! (mut b) ".prototype")
          (heap-set-intrinsic! (sb-str (mut b)) obj)
          0)
        (do
          (heap-define-own-attrs! (heap-global-entry)
                                  name
                                  (heap-ref-word DYNAMIC-PREFIX-OBJECT obj)
                                  HEAP-WORD-REF
                                  (.attrs entry))
          (heap-set-intrinsic! name obj)
          0))
    (realm-image-intrinsic-data! entry obj -1)))

;; A built-in method on its owner's object, with its declared attributes.
(defn realm-image-method-placement! [(fi i64)] (-> i64)
  (let [f (syntax-fun-at fi)
        entry (realm-image-intrinsic-entry fi)]
    (if (intrinsic-method? entry)
        (let [carrier
                (if (= (.target entry) INTRINSIC-TARGET-NAMESPACE)
                    (syntax-namespace-entry (.owner entry))
                    (let [owner
                            (syntax-fun-at (syntax-find-intrinsic-fun (.owner entry)))]
                      (if (= (.target entry) INTRINSIC-TARGET-PROTOTYPE)
                          (realm-image-prototype-of (.static-entry owner))
                          (.static-entry owner))))]
          (let [;; An accessor row's value is the pair object a descriptor holds — `get` and `set`,
                ;; in that order — and its property carries the accessor attribute, exactly as a
                ;; getter defined at run time does (docs/DECISIONS.md, image accessors).
                word
                  (if (.accessor entry)
                      (heap-ref-word DYNAMIC-PREFIX-OBJECT
                                     (realm-image-accessor-pair (.static-entry f)))
                      (heap-ref-word DYNAMIC-PREFIX-FUNCTION (.static-entry f)))
                ;; An accessor property has no writable bit: `get` and `set` replace the value,
                ;; and only enumerable and configurable remain of what the row declared.
                attrs
                  (if (.accessor entry)
                      (+ (& (.attrs entry) (+ SHAPE-ATTR-ENUMERABLE SHAPE-ATTR-CONFIGURABLE))
                         SHAPE-ATTR-ACCESSOR)
                      (.attrs entry))]
            (if (.symbol-key entry)
                ;; `Array.prototype[@@iterator]`: the key is the well-known Symbol the row names,
                ;; whose id the compiler minted with the Symbol itself (docs/DECISIONS.md,
                ;; iteration).
                (heap-define-own-key-attrs! carrier
                                            (realm-image-well-known-key (.prop entry))
                                            word
                                            HEAP-WORD-REF
                                            attrs)
                (heap-define-own-attrs! carrier (.prop entry) word HEAP-WORD-REF attrs))))
        0)))

;; The pair object an accessor property holds: `get` is the row's getter and `set` is undefined.
;; A descriptor reads these two names, so they are ordinary data properties of an ordinary object.
(defn realm-image-accessor-pair [(getter-entry i64)] (-> i64)
  (let [pair (heap-add-object! DYNAMIC-NULL-WORD)]
    (heap-define-own-attrs! pair
                            "get"
                            (heap-ref-word DYNAMIC-PREFIX-FUNCTION getter-entry)
                            HEAP-WORD-REF
                            (+ (+ SHAPE-ATTR-WRITABLE SHAPE-ATTR-ENUMERABLE) SHAPE-ATTR-CONFIGURABLE))
    (heap-define-own-attrs! pair
                            "set"
                            DYNAMIC-UNDEFINED-WORD
                            HEAP-WORD-CONST
                            (+ (+ SHAPE-ATTR-WRITABLE SHAPE-ATTR-ENUMERABLE) SHAPE-ATTR-CONFIGURABLE))
    pair))

;; The key of the well-known Symbol a row names: `Symbol.iterator` for "iterator".
(defn realm-image-well-known-key [(name (slice u8))] (-> i64)
  (let [(mut b) (sb-new (compiler-allocator))]
    (sb-push-str! (mut b) "Symbol.")
    (sb-push-str! (mut b) name)
    (shape-key-intern-symbol! (sb-str (mut b)))))

;; A materialized constructor's prototype is a well-known intrinsic the lowering may name
;; (`%IntrinsicPrototype "Array.prototype"`).
(defn realm-image-register-prototype! [(fi i64)] (-> i64)
  (if (not (syntax-intrinsic-constructor? fi))
      0
      (let [f (syntax-fun-at fi)
            (mut sb) (sb-new (compiler-allocator))]
        (sb-push-str! (mut sb) (.name f))
        (sb-push-str! (mut sb) ".prototype")
        (heap-set-intrinsic! (sb-str (mut sb))
                             (realm-image-prototype-of (.static-entry f))))))

;; With `Function` materialized, every function object in the image has %Function.prototype% as
;; its [[Prototype]] (§10.2.3 MakeConstructor / OrdinaryFunctionCreate), including the intrinsics.
(defn realm-image-link-function-prototypes! [] (-> i64)
  (let [function-fun (syntax-find-intrinsic-fun "Function")]
    (if (< function-fun 0)
        0
        (let [function-syntax (syntax-fun-at function-fun)
              function-proto
                (realm-image-prototype-of (.static-entry function-syntax))
              (mut fi) 0]
          (loop (if (>= (load fi) (len (.funs (parser-state))))
                    (break 0)
                    (let [f (syntax-fun-at (load fi))]
                      (if (>= (.static-entry f) 0)
                          (heap-set-prototype! (.static-entry f)
                                               (heap-ref-word DYNAMIC-PREFIX-OBJECT
                                                              function-proto)
                                               HEAP-WORD-REF)
                          0)
                      (set! (mut fi) (+ (load fi) 1))
                      (continue))))))))

;; With `Object` materialized, every intrinsic prototype that heads its own chain, every namespace
;; object and every hoisted source function's `prototype` object continues to %Object.prototype%
;; (ECMA-262 §20.5.3.1, §21.3, §23.1.3.1, MakeConstructor).
(defn realm-image-link-object-prototypes! [] (-> i64)
  (let [p (parser-state)
        object-fun (syntax-find-intrinsic-fun "Object")]
    (if (< object-fun 0)
        0
        (let [object-syntax (syntax-fun-at object-fun)
              object-proto
                (realm-image-prototype-of (.static-entry object-syntax))
              word (heap-ref-word DYNAMIC-PREFIX-OBJECT object-proto)
              (mut fi) 0]
          (al-for [ns (.namespace-entries p)]
                  (heap-set-prototype! ns word HEAP-WORD-REF))
          (loop (if (>= (load fi) (len (.funs p)))
                    (break 0)
                    (do
                      (if (and (syntax-intrinsic-fun? (load fi))
                               (!= (load fi) object-fun))
                          (let [f (syntax-fun-at (load fi))
                                entry (realm-image-intrinsic-entry (load fi))]
                            (if (and (syntax-intrinsic-constructor? (load fi))
                                     (= (.parent entry) ""))
                                (heap-set-prototype! (realm-image-prototype-of (.static-entry f))
                                                     word
                                                     HEAP-WORD-REF)
                                0))
                          (let [f (syntax-fun-at (load fi))]
                            (if (and (.hoisted f)
                                     (not (syntax-intrinsic-fun? (load fi)))
                                     (not (syntax-script-root? (load fi)))
                                     (>= (.static-entry f) 0)
                                     (!= (& (syntax-fun-construct-flags (load fi))
                                            FUNCTION-FLAG-CONSTRUCTOR)
                                         0))
                                (heap-set-prototype! (realm-image-prototype-of (.static-entry f))
                                                     word
                                                     HEAP-WORD-REF)
                                0)))
                      (set! (mut fi) (+ (load fi) 1))
                      (continue))))))))

(defn realm-image-constructor-record-setup! [(fi i64)] (-> i64)
  (if (not (syntax-intrinsic-constructor? fi))
      0
      (let [f (syntax-fun-at fi)]
        (realm-image-constructor-setup! (realm-image-intrinsic-entry fi)
                                        (.static-entry f)))))

;; The `prototype` object of an image function object.
(defn realm-image-prototype-of [(fobj i64)] (-> i64)
  (heap-ref-entry (heap-own-word fobj "prototype")))

;; The image word of an ASCII string (declared names and values; JSL sources are ASCII here).
(defn realm-image-ascii-string-word [(text (slice u8))] (-> i64)
  (let [(mut units) (al-new [i64] (compiler-allocator))]
    (al-for [b text]
            (if (>= (primitive/cast i64 b) 128)
                (unimplemented "non-ASCII intrinsic string values (UTF-8 to UTF-16)"
                               "src/parse/parser.coil — realm-image-ascii-string-word")
                (push! [i64] (mut units) (primitive/cast i64 b))))
    (let [word
            (heap-ref-word DYNAMIC-PREFIX-STRING
                           (heap-add-string! (load units)))]
      (al-free! [i64] (mut units))
      word)))

;; A well-known Symbol's image entry: its description string and the unminted key word every Symbol
;; carries. One entry per declaration, so `Symbol.iterator` is one value for the program's life.
(defn realm-image-well-known-symbol-word [(description (slice u8))] (-> i64)
  (let [existing (heap-well-known-symbol-entry description)]
    (if (>= existing 0)
        (heap-ref-word DYNAMIC-PREFIX-SYMBOL existing)
        (let [entry (heap-add-symbol! (realm-image-ascii-string-word description)
                                      HEAP-WORD-REF
                                      (shape-key-intern-symbol! description))]
          ;; Registered by description so an assembler can bind this unit's Symbol to the one an
          ;; earlier unit allocated (codegen/image.coil, image-shared-bindings).
          (heap-set-well-known-symbol! description entry)
          (heap-ref-word DYNAMIC-PREFIX-SYMBOL entry)))))

;; An intrinsic's declared data properties, in declaration order: rows targeting `prototype` go on
;; `proto`, the others on `root` (a namespace passes -1 for `proto`; the reader admits prototype
;; rows only on a constructor).
(defn realm-image-intrinsic-data! [(entry Intrinsic) (root i64) (proto i64)] (-> i64)
  (do
    (al-for [row (.data entry)]
            (let [prop row
                  carrier
                    (if (= (.target prop) JSL-INTRINSIC-TARGET-PROTOTYPE)
                        proto
                        root)]
              (if (< carrier 0)
                  (panic "realm-image-intrinsic-data!: a prototype row on an object without a prototype")
                  0)
              (if (= (.value-kind prop) JSL-INTRINSIC-VALUE-NUMBER)
                  (heap-define-own-attrs! carrier
                                          (.key prop)
                                          (.bits prop)
                                          HEAP-WORD-CONST
                                          (.attrs prop))
                  (if (= (.value-kind prop) JSL-INTRINSIC-VALUE-SYMBOL)
                      ;; A well-known Symbol: one image allocation, whose identity is the value.
                      (heap-define-own-attrs! carrier
                                              (.key prop)
                                              (realm-image-well-known-symbol-word (.text prop))
                                              HEAP-WORD-REF
                                              (.attrs prop))
                      (heap-define-own-attrs! carrier
                                              (.key prop)
                                              (realm-image-ascii-string-word (.text prop))
                                              HEAP-WORD-REF
                                              (.attrs prop))))))
    0))

;; A constructor's declared prototype setup: its data rows, then for a `:parent` the [[Prototype]]
;; link from its prototype object to the parent's (ECMA-262 §20.5.6.3: a NativeError prototype's
;; [[Prototype]] is %Error.prototype%). A constructor without a parent was linked to
;; %Object.prototype% with the other ordinary prototypes.
(defn realm-image-constructor-setup! [(entry Intrinsic) (fobj i64)] (-> i64)
  (let [proto (realm-image-prototype-of fobj)]
    (realm-image-intrinsic-data! entry fobj proto)
    (if (= (.parent entry) "")
        0
        (let [pi (syntax-find-intrinsic-fun (.parent entry))]
          (if (< pi 0)
              (panic "realm-image-constructor-setup!: the parent intrinsic was not declared")
              0)
          (let [pf (syntax-fun-at pi)]
            (if (< (.static-entry pf) 0)
                (panic "realm-image-constructor-setup!: the parent has no image object")
                0)
            (heap-set-prototype! proto
                                 (heap-ref-word DYNAMIC-PREFIX-OBJECT
                                                (realm-image-prototype-of (.static-entry pf)))
                                 HEAP-WORD-REF))))))

;; Closed programs retain their static var/first-function setup. Reusable Script units perform
;; object-record declaration checks and creation through their retained initialization entries.
(defn lower-global-instantiation! [(root-index i64)] (-> i64)
  (let [f (syntax-fun-at root-index)]
    (if (.script-unit (parser-state))
        (lower-script-object-instantiation! (.script f))
        (do
          ;; A Script's `let`, `const` and `class` are realm lexical bindings in both unit kinds: a
          ;; function of the Script reads one by name at run time, which a Scope value living in the
          ;; initializer could never give it.
          (al-for [entry
                   (get (.script-declarations (parser-state)) (.script f))]
                  (let [e entry]
                    (if (or (= (.kind e) CU-SCRIPT-LET)
                            (= (.kind e) CU-SCRIPT-CONST)
                            (= (.kind e) CU-SCRIPT-CLASS))
                        (lower-script-create-lexical-slot! (.name e)
                                                           (!= (.kind e)
                                                               CU-SCRIPT-CONST))
                        0)))
          (if (= (.script f) 0)
              0
              (do
                (al-for [entry
                         (get (.script-declarations (parser-state)) (.script f))]
                        (let [e entry]
                          (if (= (.kind e) CU-SCRIPT-FUNCTION)
                              (lower-global-store! (.name e)
                                                   (lower-function-object (syntax-script-declared-function (.script f)
                                                                                                           (.function-ordinal e))))
                              0)))
                0))))))

;; Declaration effects use the same completion/control/memory protocol as source expressions.
(defn lower-script-declaration-effect! [(operation (slice u8))
                                        (name (slice u8))
                                        (value (Option (dyn NodeOps)))] (-> i64)
  (match value (Some [v] (n-keep! v)) (None [] 0))
  (let [scope (parser-node (.current-scope (parser-state)))
        slot
          (if (= operation "JsInitializeGlobalLexicalBinding")
              (lower-known-lexical-slot name)
              (None [(dyn NodeOps)]))
        selected
          (match slot
            (Some [_] "JsInitializeGlobalLexicalSlot")
            (None [] operation))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)]
           (mut args)
           (match slot
             (Some [s] s)
             (None [] (keyref-make (shape-key-intern name)))))
    (match value (Some [v] (push! [(dyn NodeOps)] (mut args) v)) (None [] 0))
    (let [r
            (match (jsl-definition-form selected)
              (None []
                    (do
                      (panic "lower-script-declaration-effect!: missing JSL operation")
                      (jsl-expr-result (unreachable-node)
                                       (scope-ctrl scope)
                                       (scope-mem scope))))
              (Some [form]
                    (if (jsl-form-macro? form)
                        (jsl-lower-macro-values selected
                                                (load args)
                                                (scope-ctrl scope)
                                                (scope-mem scope))
                        (lower-jsl-call-values selected (load args)))))]
      (al-free! (mut args))
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (lower-completion! (.value r))
      (match value (Some [v] (n-unkeep! v)) (None [] 0))
      0)))

(defn lower-script-create-lexical-slot! [(name (slice u8)) (writable bool)] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! (mut args) (keyref-make (shape-key-intern name)))
    (push! (mut args) (con-int (if writable 1 0)))
    (let [r
            (jsl-lower-macro-values "JsCreateGlobalLexicalSlot"
                                    (load args)
                                    (scope-ctrl scope)
                                    (scope-mem scope))]
      (parser-set-current-ctrl! (.ctrl r))
      (scope-set-mem! scope (.mem r))
      (scope-define! scope
                     (lower-lexical-slot-name name)
                     (ty-int-range 1 0x7fffffffffffffff)
                     true
                     (.value r))
      (al-free! (mut args))
      0)))

;; Simple's parseDeclaration parses the initializer (or selects the declared type's default),
;; derives finality/inferred type, converts the value, then Scope.define rejects a repeated name.
;; JavaScript Script units execute the object-record portion of GlobalDeclarationInstantiation
;; (ECMA-262 16.1.7):
;; select last function declarations in reverse order, check those names, check vars, then define
;; selected functions in source order and create vars. No store precedes the complete check pass.
;; The name set borrows parser-owned bytes only for this lowering; emitted keys are symbolic.
;; Retained root lexicals use realm cells rather than Scope SSA values. Check existing lexical
;; names/restricted properties, then var conflicts before function/var admissibility; only after
;; the complete check pass create uninitialized lexical cells, functions, and vars, in that order.
(defn lower-script-object-instantiation! [(script i64)] (-> i64)
  (let [entries (get (.script-declarations (parser-state)) script)
        (mut names)
          (hm-new [(slice u8) i64] (compiler-allocator) (str-keyops-borrowed))
        (mut functions) (al-new [CuScriptDecl] (compiler-allocator))
        (mut variables) (al-new [(slice u8)] (compiler-allocator))
        (mut i) (len entries)]
    (al-for [entry entries]
            (let [e entry]
              (if (or (= (.kind e) CU-SCRIPT-LET)
                      (= (.kind e) CU-SCRIPT-CONST)
                      (= (.kind e) CU-SCRIPT-CLASS))
                  (lower-script-declaration-effect! "JsCheckGlobalLexicalDeclaration"
                                                    (.name e)
                                                    (None [(dyn NodeOps)]))
                  0)))
    (al-for [entry entries]
            (let [e entry]
              (if (or (= (.kind e) CU-SCRIPT-VAR)
                      (= (.kind e) CU-SCRIPT-FUNCTION))
                  (lower-script-declaration-effect! "JsCheckGlobalVarLexicalConflict"
                                                    (.name e)
                                                    (None [(dyn NodeOps)]))
                  0)))
    (loop (if (= (load i) 0)
              (break 0)
              (do
                (set! (mut i) (- (load i) 1))
                (let [e (get entries (load i))]
                  (if (and (= (.kind e) CU-SCRIPT-FUNCTION)
                           (not (hm-contains? (load names) (.name e))))
                      (do
                        (set! (mut names) (.name e) 1)
                        (push! [CuScriptDecl] (mut functions) e)
                        (lower-script-declaration-effect! "JsCheckGlobalFunctionDeclaration"
                                                          (.name e)
                                                          (None [(dyn NodeOps)])))
                      0))
                (continue))))
    (al-for [entry entries]
            (let [e entry]
              (if (and (= (.kind e) CU-SCRIPT-VAR)
                       (not (hm-contains? (load names) (.name e))))
                  (do
                    (set! (mut names) (.name e) 1)
                    (push! [(slice u8)] (mut variables) (.name e))
                    (lower-script-declaration-effect! "JsCheckGlobalVarDeclaration"
                                                      (.name e)
                                                      (None [(dyn NodeOps)])))
                  0)))
    (al-for [entry entries]
            (let [e entry]
              (if (or (= (.kind e) CU-SCRIPT-LET)
                      (= (.kind e) CU-SCRIPT-CONST)
                      (= (.kind e) CU-SCRIPT-CLASS))
                  (lower-script-create-lexical-slot! (.name e)
                                                     (!= (.kind e)
                                                         CU-SCRIPT-CONST))
                  0)))
    (set! (mut i) (len (load functions)))
    (loop (if (= (load i) 0)
              (break 0)
              (do
                (set! (mut i) (- (load i) 1))
                (let [e (get (load functions) (load i))]
                  (lower-script-declaration-effect! "JsCreateGlobalFunctionBinding"
                                                    (.name e)
                                                    (Some (lower-function-object (syntax-script-declared-function script
                                                                                                                  (.function-ordinal e))))))
                (continue))))
    (al-for [name (load variables)]
            (lower-script-declaration-effect! "JsCreateGlobalVarBinding"
                                              name
                                              (None [(dyn NodeOps)])))
    (hm-free! (mut names))
    (al-free! (mut functions))
    (al-free! (mut variables))
    0))

(defn parse-program-mode [(src (slice u8)) (script-mode bool)] (-> (dyn NodeOps))
  (let [(mut sources) (al-new [(slice u8)] (compiler-allocator))]
    (push! [(slice u8)] (mut sources) src)
    (let [stop (parse-program-sources (load sources) script-mode)]
      (al-free! [(slice u8)] (mut sources))
      stop)))

;; A realm: every Script source in evaluation order (docs/DECISIONS.md, realm).
(defn parse-program-scripts [(sources (ArrayList (slice u8)))] (-> (dyn NodeOps))
  (parse-program-sources sources true))

(defn parse-program-sources [(sources (ArrayList (slice u8)))
                             (script-mode bool)] (-> (dyn NodeOps))
  (parse-program-sources-with-boundary sources script-mode false))

(defn parse-program-sources-with-boundary [(sources (ArrayList (slice u8)))
                                           (script-mode bool)
                                           (external-mutation bool)] (-> (dyn NodeOps))
  (parse-program-sources-config sources script-mode external-mutation false))

;; The header of one function record: its Fun, memory Parm and every argument-slot Parm over the
;; shared ABI. Headers precede bodies so a body can call any function the program declares.
(defn parser-fun-header! [(fi i64) (start (dyn NodeOps))] (-> i64)
  ;; A forwarding record has no local body; its entry is built with the adapters.
  (if (or (syntax-fun-forwarding? fi)
          (not (or (syntax-top-level-declaration? fi)
                   (syntax-fun-value-admitted? (syntax-fun-at fi)))))
      0
      (let [fp
              (al-elem [SyntaxFun]
                       (mut (.funs (parser-state)))
                       fi)
            argc (+ 2 (parser-abi-slots))]
        (if (or (.generator fp) (.async fp))
            (unimplemented "generator and async functions"
                           "docs/GAPS.md — function environments")
            0)
        ;; JavaScript calling convention: return, `this` and every argument slot are
        ;; dynamic values. `number` is evidence to discharge later, never a raw
        ;; representation claim.
        (let [fun
                (fun-make start
                          (parser-abi-sig)
                          (if (= fi
                                 (syntax-find-fun "main"))
                              (parser-internal-main-name)
                              (if (.hoisted fp)
                                  (parser-hoisted-fun-symbol fi)
                                  (parser-value-fun-name fi))))
              (mut i) 0]
          ;; JSL declarations reserved the low closed-world identities. Every source
          ;; declaration receives a distinct identity from the same compilation-local
          ;; allocator; syntax-table position is not a symbol identity.
          (set! (.fidx fp) (next-inline-fidx!))
          (set! (.fun-nid fp) (n-nid fun))
          ;; Slot 1 is the exact Call memory input, as in final Simple. The unknown-caller
          ;; seed is Start's bulk memory; closed-world internal functions drop it with
          ;; the matching Fun path before optimization.
          (let [mem-parm
                  (parm-make-slot fun
                                  CALL-MEM
                                  (ty-mem 1 TY-BOT)
                                  "$mem")]
            (parm-set-unknown-input! mem-parm
                                     (proj-make start
                                                1
                                                "start.mem"))
            (n-keep! mem-parm))
          (loop (if (>= (load i) argc)
                    (break 0)
                    (do
                      ;; Headers precede bodies, so hold parameter Phis alive until every
                      ;; body and call edge has been installed. Slot 0 is `this`, slot 1
                      ;; `new.target`; the formals follow.
                      (n-keep! (parm-make fun
                                          (load i)
                                          (ty-dyn TAG-ANY)
                                          (if (= (load i) 0)
                                              "this"
                                              (if (= (load i) 1)
                                                  "new.target"
                                                  (if (< (- (load i)
                                                            2)
                                                         (len (.params fp)))
                                                      (get (.params fp)
                                                           (- (load i)
                                                              2))
                                                      "$slot")))))
                      (set! (mut i) (+ (load i) 1))
                      (continue)))))
        0)))

;; The stable callable entry of one lowered function record: its adapter over the shared ABI.
(defn parser-fun-adapter! [(fi i64) (start (dyn NodeOps)) (stop (dyn NodeOps))] (-> i64)
  (if (syntax-fun-forwarding? fi)
      (parser-fun-forwarding! fi start stop)
      (if (and (syntax-fun-lowered? fi)
               (or (.script-unit (parser-state))
                   (not (syntax-script-root? fi))))
          (let [fp (syntax-fun-ptr fi)
                adapter
                  (callabi-adapter! start
                                    (parser-node (.fun-nid fp))
                                    (.fidx fp)
                                    (len (.params fp))
                                    (parser-callable-name fi)
                                    (parser-hidden-builders fi))]
            (set! (.adapter-fidx fp) (next-inline-fidx!))
            (set! (.adapter-nid fp) (n-nid adapter))
            (if (syntax-script-root? fi)
                (fun-set-escapes! adapter)
                0)
            (arena-register-function! (.adapter-fidx fp) adapter)
            (match (fun-ret adapter)
              (Some [ret] (stop-add-return! stop ret))
              (None []
                    (panic "parser: callable adapter has no Return"))))
          0)))

;; An ABI builtin's public entry (`callabi-forwarding-adapter!`): the record's one function identity,
;; so `fidx` and `adapter-fidx` agree and there is no local Fun.
(defn parser-fun-forwarding! [(fi i64)
                              (start (dyn NodeOps))
                              (stop (dyn NodeOps))] (-> i64)
  (if (!= (.adapter-nid (syntax-fun-ptr fi)) 0)
      0
      (let [fp (syntax-fun-ptr fi)
            entry
              (callabi-forwarding-adapter! start
                                           (jsl-call-target (.abi-builtin fp))
                                           (parser-callable-name fi))
            fidx (next-inline-fidx!)]
        (set! (.fidx fp) fidx)
        (set! (.adapter-fidx fp) fidx)
        (set! (.adapter-nid fp) (n-nid entry))
        (arena-register-function! fidx entry)
        (match (fun-ret entry)
          (Some [ret] (stop-add-return! stop ret))
          (None [] (panic "parser-fun-forwarding!: the entry has no Return")))
        0)))

;; The body of one lowered function record, through ScopeNode as the sole SSA environment.
(defn parser-fun-body! [(fi i64) (stop (dyn NodeOps))] (-> i64)
  (if (or (not (syntax-fun-lowered? fi)) (syntax-fun-forwarding? fi))
      0
      (let [f (syntax-fun-at fi)
            fun (parser-node (.fun-nid f))
            body-start (arena-node-count)
            scope (scope-make)]
        (set! (.current-fun (parser-state)) fi)
        (set! (.propagates (parser-state)) false)
        (set! (.current-ctrl (parser-state)) (n-nid fun))
        (set! (.current-scope (parser-state)) (n-nid scope))
        (n-add-def! scope (Some fun))
        (match (fun-mem-parm fun)
          (Some [m] (n-add-def! scope (Some m)))
          (None []
                (panic "parser: function memory Parm is missing")))
        (scope-push! scope)
        (parser-reset-returns!)
        (let [(mut i) 0]
          (loop (if (>= (load i) (len (.params f)))
                    (break 0)
                    (let [name (get (.params f) (load i))
                          pattern (get (.param-patterns f) (load i))
                          (mut later) (+ (load i) 1)
                          (mut shadowed) false]
                      ;; A destructuring parameter has no name of its own: its slot's actual, after
                      ;; the parameter's own default, is the value the pattern binds from (§8.6.2).
                      (match pattern
                        (Some [pat]
                              (let [actual (match (fun-parm fun (+ (load i) 2))
                                             (Some [p] p)
                                             (None [] (unreachable-node)))
                                    supplied (parser-node
                                               (match (get (.param-defaults f) (load i))
                                                 (Some [init] (n-nid (lower-parameter-default actual init)))
                                                 (None [] (n-nid actual))))]
                                (lower-pattern-bind! pat supplied PATTERN-PARAM)))
                        (None [] 0))
                      ;; A non-strict JavaScript simple parameter list may repeat a
                      ;; name. Every positional Parm still exists for the ABI, but only
                      ;; the last occurrence introduces the body binding.
                      (loop (if (>= (load later)
                                    (len (.params f)))
                                (break 0)
                                (if (= (get (.params f)
                                            (load later))
                                       name)
                                    (break (do
                                             (set! (mut shadowed)
                                                   true)
                                             0))
                                    (do
                                      (set! (mut later)
                                            (+ (load later) 1))
                                      (continue)))))
                      (if (or (load shadowed) (match pattern (Some [x] true) (None [] false)))
                          0
                          ;; A default merged Scopes, so later parameters bind into the live one.
                          (scope-define! (parser-node (.current-scope (parser-state)))
                                         name
                                         (ty-dyn TAG-ANY)
                                         false
                                         (match (fun-parm fun
                                                          (+ (load i)
                                                             2))
                                           (Some [p] p)
                                           (None []
                                                 (unreachable-node)))))
                      ;; A default is evaluated, in order, when the actual is undefined; it sees the
                      ;; parameters bound before it. A pattern parameter already applied its own.
                      (match (if (match pattern (Some [x] true) (None [] false))
                                 (None [i64])
                                 (get (.param-defaults f) (load i)))
                        (Some [init]
                              (let [defaulted
                                      (lower-parameter-default (match (fun-parm fun
                                                                                (+ (load i)
                                                                                   2))
                                                                 (Some [p] p)
                                                                 (None []
                                                                       (unreachable-node)))
                                                               init)]
                                (if (load shadowed)
                                    0
                                    (scope-update! (parser-node (.current-scope (parser-state)))
                                                   name
                                                   defaulted))
                                0))
                        (None [] 0))
                      (set! (mut i) (+ (load i) 1))
                      (continue)))))
        ;; The rest parameter is the actuals from the formal count on; its entry passed them in the
        ;; hidden slot (§10.2.11 step 28).
        (match (.rest-param f)
          (Some [rest-name]
                (let [(mut rest-args)
                        (al-new [(dyn NodeOps)] (compiler-allocator))]
                  (push! [(dyn NodeOps)]
                         (mut rest-args)
                         (lower-hidden-slot-parm fi fun))
                  (push! [(dyn NodeOps)]
                         (mut rest-args)
                         (con-int (len (.params f))))
                  (let [rest (lower-jsl-values "JsRestFrom" (load rest-args))]
                    (al-free! [(dyn NodeOps)] (mut rest-args))
                    (scope-define! (parser-node (.current-scope (parser-state)))
                                   rest-name
                                   (ty-dyn TAG-ANY)
                                   false
                                   rest)
                    0)))
          (None [] 0))
        ;; The activation's environment, before anything can read a captured binding.
        (lower-environment-entry! fi fun)
        (lower-class-constructor-entry! fi fun)
        (lower-derived-this-entry! fi
                                   (parser-node (.current-scope (parser-state))))
        (lower-bind-arguments-object! fi scope fun)
        ;; An intrinsic belongs to no Script (`script` -1): it leaves the current
        ;; Script index as it is.
        (if (and (.script-mode (parser-state)) (>= (.script f) 0))
            (set! (.script-index (parser-state))
                  (get (.scripts (parser-state)) (.script f)))
            0)
        (if (syntax-script-root? fi)
            (lower-global-instantiation! fi)
            (lower-instantiate-vars! (.body f)))
        ;; A Script root's lexicals are the realm's in both unit kinds, never Scope values.
        (if (syntax-script-root? fi) 0 (lower-instantiate-lexicals! (.body f)))
        (lower-bind-body-functions! (.body f))
        (let [terminated
                (if (.default-derived f)
                    ;; `constructor(...args) { super(...args); }` (§15.7.14 step 10.b).
                    (do (lower-default-derived-body! fi fun) 0)
                    (match (.expression-body f)
                      (Some [e]
                            (do
                              (parser-record-return! (lower-syntax-expr e))
                              1))
                      (None [] (lower-syntax-statements (.body f)))))]
          ;; JavaScript functions return undefined when control reaches the closing brace.
          (if (= terminated 0)
              (parser-record-return! (lower-constructor-return (dyn-undefined-make)))
              0)
          ;; The filter's soundness check: a propagation path in a body it cleared.
          (if (and (.propagates (parser-state))
                   (not (.may-throw f)))
              (do
                (p--str "\naot: parser: the may-throw filter cleared a function whose lowering propagates an exception: ")
                (p--str (.name f))
                (p--str "\n")
                (panic "parser: syntactic may-throw filter is unsound for a construct in this function (add it to syntax-throw-walk-expr!)"))
              0)
          (let [ret (parser-build-return! fun)]
            (fun-set-ret! fun ret)
            ;; Header hoisting interleaves unrelated Fun/Parm nids before this body.
            ;; Preserve Simple's per-function construction estimate by measuring only
            ;; this lowering window; live-size remains the independent second cap.
            (fun-set-approx-size! fun
                                  (- (arena-node-count)
                                     body-start))
            (stop-add-return! stop ret)))
        ;; Branches normally merge back into `scope`; loops deliberately replace it
        ;; with their false-edge exit Scope. Publish and discard the actual final
        ;; environment, then discard an obsolete loop-entry environment separately.
        (let [final-scope (parser-node (.current-scope (parser-state)))]
          (scope-pop! final-scope)
          (n-kill! final-scope)
          (if (n-same? final-scope scope) 0 (n-kill! scope)))
        (match (fun-mem-parm fun)
          (Some [m] (n-unkeep! m))
          (None [] 0))
        0)))

;; Materialize one declared intrinsic once the program's headers exist and before the image facts do:
;; its record, header, adapter, image objects and properties, in the phase order
;; `realm-image-build!` uses, with the realm's prototype links refreshed. Its owner (a method's) or
;; parent (a constructor's) is materialized first. The body waits in `pending-bodies`, because a
;; demand can arrive in the middle of lowering another body (`parser-lower-pending-bodies!`).
;; Answers whether anything was added.
(defn parser-materialize-intrinsic! [(entry Intrinsic)] (-> bool)
  (let [p (parser-state)
        table (intrinsic-table)
        start (parser-node (.lower-start p))
        stop (parser-node (.lower-stop p))]
    (if (or (= (.lower-start p) 0) (= (.lower-stop p) 0))
        (panic "parser-materialize-intrinsic!: the program's passes have not begun")
        0)
    (if (or (and (intrinsic-namespace? entry)
                 (>= (syntax-namespace-index (.name entry)) 0))
            (and (= (.target entry) INTRINSIC-TARGET-ENTRY)
                 (>= (syntax-find-entry-fun (.name entry)) 0))
            (and (not (intrinsic-namespace? entry))
                 (!= (.target entry) INTRINSIC-TARGET-ENTRY)
                 (>= (syntax-find-intrinsic-fun (.name entry)) 0)))
        false
        (if (= (.target entry) INTRINSIC-TARGET-ENTRY)
            ;; An entry is only its forwarding Fun: no image object, no body.
            (do
              (syntax-declare-intrinsic! entry)
              (parser-check-late-reservation!)
              (let [fi (- (len (.funs p)) 1)]
                (parser-fun-header! fi start)
                (parser-fun-adapter! fi start stop)
                true))
            (do
              (if (!= (.parent entry) "")
                  (parser-materialize-intrinsic! (get table
                                                      (intrinsic-index table
                                                                       (.parent entry))))
                  false)
              (if (intrinsic-method? entry)
                  (parser-materialize-intrinsic! (get table
                                                      (intrinsic-index table
                                                                       (.owner entry))))
                  false)
              (syntax-declare-intrinsic! entry)
              (parser-check-late-reservation!)
              (if (intrinsic-namespace? entry)
                  (do
                    (realm-image-namespace! (.name entry))
                    (realm-image-link-object-prototypes!)
                    (parser-materialize-chain-roots!)
                    true)
                  (let [fi (- (len (.funs p)) 1)]
                    (syntax-intrinsic-may-throw! fi)
                    (parser-fun-header! fi start)
                    (parser-fun-adapter! fi start stop)
                    (realm-image-function-object! fi)
                    (realm-image-root-binding! fi)
                    (realm-image-method-placement! fi)
                    (realm-image-register-prototype! fi)
                    (realm-image-link-function-prototypes!)
                    (realm-image-link-object-prototypes!)
                    (realm-image-constructor-record-setup! fi)
                    (push! [i64] (mut (.pending-bodies p)) fi)
                    (parser-materialize-chain-roots!)
                    true)))))))

;; Late materialization appends records, syntax nodes and global bindings while lowering holds
;; pointers into those lists (`syntax-fun-ptr` across a lowering that demands an intrinsic). Reserve
;; room for everything the declared surface can add, so no append reallocates under such a pointer;
;; `parser-materialize-intrinsic!` refuses to exceed the reservation.
(defn parser-reserve-late-materialization! [] (-> i64)
  (let [p (parser-state)
        table (intrinsic-table)
        rows (len table)
        (mut widest) 0]
    (al-for [r table]
            (let [row r]
              (if (> (.arity row) (load widest))
                  (set! (mut widest) (.arity row))
                  0)))
    (al-reserve! [SyntaxFun] (mut (.funs p)) (+ (len (.funs p)) rows))
    ;; An intrinsic record adds `this`, `new.target`, its own name, one name per slot and its body.
    (al-reserve! [SyntaxExpr]
                 (mut (.exprs p))
                 (+ (len (.exprs p)) (* rows (+ (load widest) 4))))
    (al-reserve! [GlobalBinding] (mut (.globals p)) (+ (len (.globals p)) rows))
    (al-reserve! [(slice u8)]
                 (mut (.namespaces p))
                 (+ (len (.namespaces p)) rows))
    (set! (.late-exprs-cap p) (al-cap [SyntaxExpr] (.exprs p)))
    (set! (.late-funs-cap p) (al-cap [SyntaxFun] (.funs p)))
    0))

(defn parser-check-late-reservation! [] (-> i64)
  (let [p (parser-state)]
    (if (or (!= (al-cap [SyntaxFun] (.funs p)) (.late-funs-cap p))
            (!= (al-cap [SyntaxExpr] (.exprs p)) (.late-exprs-cap p)))
        (panic "parser-materialize-intrinsic!: late materialization outgrew its reservation (a list reallocated under lowering pointers)")
        0)))

;; Every declared [[Prototype]] chain ends at %Object.prototype%, and every function object's is
;; %Function.prototype%: a realm that materialized any intrinsic has both.
(defn parser-materialize-chain-roots! [] (-> i64)
  (let [table (intrinsic-table)]
    (parser-materialize-intrinsic! (get table (intrinsic-index table "Object")))
    (parser-materialize-intrinsic! (get table
                                        (intrinsic-index table "Function")))
    0))

;; Lower the bodies of records materialized since the last boundary; a body can materialize more.
(defn parser-lower-pending-bodies! [] (-> i64)
  (let [p (parser-state)
        stop (parser-node (.lower-stop p))
        (mut i) 0]
    (loop (if (>= (load i) (len (.pending-bodies p)))
              (break 0)
              (do
                (parser-fun-body! (get (.pending-bodies p) (load i)) stop)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (al-clear! [i64] (mut (.pending-bodies p)))
    (load i)))

;; An intrinsic record's may-throw: its body is one JSL builtin call over its parameters, so the
;; syntactic walk has no call edges to other records.
(defn syntax-intrinsic-may-throw! [(fi i64)] (-> i64)
  (if (syntax-fun-forwarding? fi)
      0
      (let [f (syntax-fun-ptr fi)
            (mut direct) false
            (mut edges) (al-new [i64] (compiler-allocator))]
        (match (.expression-body f)
          (Some [e] (syntax-throw-walk-expr! e false (mut direct) (mut edges)))
          (None []
                (panic "syntax-intrinsic-may-throw!: an intrinsic record has no expression body")))
        (if (> (len (load edges)) 0)
            (panic "syntax-intrinsic-may-throw!: an intrinsic body calls a source function")
            0)
        (set! (.may-throw f) (load direct))
        (al-free! [i64] (mut edges))
        0)))

;; A well-known intrinsic prototype a lowering names (`Object.prototype` for a literal,
;; `Function.prototype` for a function object, `%IntrinsicPrototype` in JSL): the reference is a
;; demand, so the realm materializes its declared constructor first. Its image entry, or -1 where
;; the program has no realm (function-entry mode) or does not declare the constructor.
(defn parser-intrinsic-prototype-entry [(name (slice u8))] (-> i64)
  (do
    (parser-demand-intrinsic-prototype! name)
    (heap-intrinsic-entry name)))

(defn parser-demand-intrinsic-prototype! [(name (slice u8))] (-> i64)
  (let [p (parser-state)
        suffix ".prototype"]
    (if (not (.script-mode p))
        0
        (if (or (<= (len name) (len suffix))
                (!= (subslice [u8] name (- (len name) (len suffix)) (len name))
                    suffix))
            (panic "parser-demand-intrinsic-prototype!: not a well-known prototype name")
            (let [table (intrinsic-table)
                  i
                    (intrinsic-index table
                                     (subslice [u8]
                                               name
                                               0
                                               (- (len name) (len suffix))))]
              (if (< i 0)
                  0
                  (do
                    (if (= (.lower-start p) 0)
                        (panic "parser-demand-intrinsic-prototype!: a prototype was named before the program's passes")
                        0)
                    (parser-materialize-intrinsic! (get table i))
                    0)))))))

;; The JSL lowering's hook (`jsl-set-intrinsic-demand!`).
(defn parser-jsl-demand-intrinsic [(bytes (ptr u8)) (n i64)] (-> i64)
  (parser-demand-intrinsic-prototype! (slice-new [u8] bytes n)))

;; ---------------------------------------------------------------------------
;; The realm is materialized by demand (docs/DECISIONS.md)
;;
;; A closed program's realm holds the declared intrinsics the program can observe. Identifier
;; references to a declared root are bindings resolved during syntax collection; implicit references
;; (a literal's or a function's prototype, `%IntrinsicPrototype` in JSL) materialize at the reference;
;; everything else — `o.m`, `o[k]`, `this.Array`, reflection — is observed on the graphs by
;; `imagefacts-surface-demands!` and materialized here, scan after scan, until a scan observes nothing
;; new. Only then are the value-call code-word types final.

;; The declared row an observation (owner, key) selects: a root on the global object, or a method
;; on a materialized carrier (a constructor's function object or `prototype`, or a namespace).
(defn parser-row-observed? [(row Intrinsic) (d ImageDemand)] (-> bool)
  (let [key-matches
          (or (< (.key d) 0)
              (if (and (intrinsic-method? row) (.symbol-key row))
                  ;; A symbol-keyed row is observed by the well-known Symbol's key id: its `prop` is
                  ;; the Symbol's name, which no property name reaches.
                  (= (.key d) (realm-image-well-known-key (.prop row)))
                  (shape-key-name-eq? (.key d)
                                      (if (intrinsic-method? row)
                                          (.prop row)
                                          (.name row)))))]
    (if (not key-matches)
        false
        (if (not (intrinsic-method? row))
            (= (.owner d) (heap-global-entry))
            (if (= (.target row) INTRINSIC-TARGET-NAMESPACE)
                (let [ns (syntax-namespace-index (.owner row))]
                  (and (>= ns 0)
                       (< ns (len (.namespace-entries (parser-state))))
                       (= (.owner d)
                          (get (.namespace-entries (parser-state)) ns))))
                (let [fi (syntax-find-intrinsic-fun (.owner row))]
                  (if (< fi 0)
                      false
                      (let [f (syntax-fun-at fi)]
                        (if (< (.static-entry f) 0)
                            false
                            (if (= (.target row) INTRINSIC-TARGET-PROTOTYPE)
                                (and (syntax-intrinsic-constructor? fi)
                                     (= (.owner d)
                                        (realm-image-prototype-of (.static-entry f))))
                                (= (.owner d) (.static-entry f))))))))))))

;; The Funs `parser-close-world!` will leave with unknown callers: the process entry and every
;; adapter `parser-adapter-open?` keeps open.
(defn parser-open-funs [] (-> (ArrayList i64))
  (let [(mut open) (al-new [i64] (compiler-allocator))
        (mut fi) 0]
    (push! [i64] (mut open) (n-nid (parser-entry-fun)))
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break 0)
              (let [f (syntax-fun-at (load fi))]
                (if (and (syntax-fun-lowered? (load fi))
                         (!= (.adapter-nid f) 0)
                         (parser-adapter-open? (load fi)))
                    (push! [i64] (mut open) (.adapter-nid f))
                    0)
                (set! (mut fi) (+ (load fi) 1))
                (continue))))
    (load open)))

;; One scan: materialize every declared row some observation selects. Answers whether any was added.
(defn parser-apply-surface-demands! [] (-> bool)
  (let [demands
          (imagefacts-surface-demands! (.external-mutation (parser-state))
                                       (parser-open-funs))
        table (intrinsic-table)
        (mut seen) (hm-new [i64 bool] (compiler-allocator) (i64-keyops))
        (mut added) false]
    (al-for [item demands]
            (let [d item
                  ;; Owner and key fit in one word: entries and key ids are far below 2^31.
                  id (+ (* (+ (.owner d) 1) 2147483648) (+ (.key d) 1))]
              (if (hm-contains? (load seen) id)
                  0
                  (do
                    (set! (mut seen) id true)
                    (al-for [r table]
                            (let [row r]
                              (if (and (parser-row-observed? row d)
                                       (parser-materialize-intrinsic! row))
                                  (do
                                    ;; `AOT_REALM_TRACE=1` narrates each row the scan materialized and why.
                                    (if (!= (primitive/cast i64
                                                            (os/getenv c"AOT_REALM_TRACE"))
                                            0)
                                        (do
                                          (println "realm: {s} observed as (entry {}, key {})"
                                                   (.name row)
                                                   (.owner d)
                                                   (.key d))
                                          0)
                                        0)
                                    (set! (mut added) true))
                                  0)))))))
    (hm-free! (mut seen))
    (load added)))

;; Lower pending parser bodies and JSL definitions until neither has work: each can demand the other.
(defn parser-drain-lowering! [] (-> i64)
  (loop (do
          (jsl-define-pending!)
          (if (> (parser-lower-pending-bodies!) 0) (continue) (break 0)))))

;; The fixpoint, then the final value-call type: every function a code word can hold now exists.
(defn parser-settle-realm! [] (-> i64)
  (let [p (parser-state)]
    (parser-drain-lowering!)
    (if (and (.script-mode p) (parser-realm-by-demand?))
        (loop (if (parser-apply-surface-demands!)
                  (do (parser-drain-lowering!) (continue))
                  (break 0)))
        0)
    (let [final (parser-value-funptr-ty)
          count (arena-node-count)
          (mut i) 1]
      (jsl-set-value-call-abi! final)
      (loop (if (> (load i) count)
                (break 0)
                (do
                  (match (arena-node (load i))
                    (Some [n]
                          (if (and (not (n-dead? n))
                                   (or (= (n-op n) OP-LOAD)
                                       (= (n-op n) OP-STORE))
                                   (= (mem-alias-of-node n) ALIAS-FUNCTION-CODE))
                              (mem-redeclare-code-word! n final)
                              0))
                    (None [] 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      0)))

;; A closed program decides its realm by demand. A shared-realm provider carries the declared
;; surface, its clients carry none of its methods, and any other external Script unit carries the
;; declared surface too, since another unit it cannot see may observe any of it.
(defn parser-realm-by-demand? [] (-> bool)
  (not (.external-mutation (parser-state))))

(defn parse-program-sources-config [(sources (ArrayList (slice u8)))
                                    (script-mode bool)
                                    (external-mutation bool)
                                    (script-unit bool)] (-> (dyn NodeOps))
  (do
    (if (and script-unit (or (not script-mode) (not external-mutation)))
        (panic "parse-program-sources-config: Script units require an external Script boundary")
        0)
    (parse-syntax-scripts-config! sources
                                  script-mode
                                  false
                                  external-mutation
                                  script-unit)
    (set! (.script-unit (parser-state)) script-unit)
    (heap-use-shared-global! script-unit)
    ;; Syntax collection declares every closed-world property key and ordered hidden-class path
    ;; before JSL graphs are built. Runtime-key representation dispatch can therefore enumerate
    ;; the complete layout universe while JavaScript prototype traversal remains recursive JSL.
    (syntax-declare-object-shapes!)
    (if (.jsl-loaded (parser-state))
        (jsl-lower-loaded-index!)
        (jsl-lower-index! JSL-COMPILER-INDEX))
    (syntax-analyze-arguments!)
    (parser-settle-abi!)
    (let [start (start-make (ty-int-bot))
          stop (stop-make)
          (mut fi) 0]
      (set! (.lower-start (parser-state)) (n-nid start))
      (set! (.lower-stop (parser-state)) (n-nid stop))
      (parser-reserve-late-materialization!)
      (jsl-set-intrinsic-demand! (primitive/fnptr-of parser-jsl-demand-intrinsic))
      (jsl-set-closure-maker! (primitive/fnptr-of parser-jsl-make-closure))
      ;; Header pass: install all Fun/Parm nodes before lowering any call-bearing body. Hoisted
      ;; top-level declarations and admitted function values are Funs, all over the shared ABI;
      ;; other function forms are refused at their use.
      (loop (if (>= (load fi) (len (.funs (parser-state))))
                (break 0)
                (do
                  (parser-fun-header! (load fi) start)
                  (set! (mut fi) (+ (load fi) 1))
                  (continue))))
      ;; Function objects publish stable entries. Build their adapters after all local headers so
      ;; bodies and initial heap code words can name either entry without forward placeholders.
      (set! (mut fi) 0)
      (loop (if (>= (load fi) (len (.funs (parser-state))))
                (break 0)
                (do
                  (parser-fun-adapter! (load fi) start stop)
                  (set! (mut fi) (+ (load fi) 1))
                  (continue))))
      ;; The realm's initial heap, as data: every hoisted Fun and its index exist now.
      (if (.script-mode (parser-state)) (realm-image-build!) 0)
      ;; Body pass: ScopeNode is the sole SSA environment. Statements update its ordinary graph
      ;; edges; no post-parse name-resolution or SSA construction pass exists.
      ;; Only the records that exist now: one materialized while a body lowers waits in
      ;; `pending-bodies` and is lowered once, by `parser-settle-realm!`.
      (set! (mut fi) 0)
      (let [body-count (len (.funs (parser-state)))]
        (loop (if (>= (load fi) body-count)
                  (break 0)
                  (do
                    (parser-fun-body! (load fi) stop)
                    (set! (mut fi) (+ (load fi) 1))
                    (continue)))))
      (parser-install-entry-wrapper! start stop)
      ;; Every semantic call is installed: lower the bodies of the JSL definitions the program
      ;; demanded, and of those they demand, before pessimistic Iter sees the graph. A definition
      ;; nothing reached has no graph (docs/DECISIONS.md, JSL definitions are built on demand).
      ;; A body's `%CallFunction` lowers against the program's value-call ABI, settled now.
      (jsl-set-value-call-abi! (parser-value-funptr-ty))
      (parser-settle-realm!)
      stop)))

(defn parse-program [(src (slice u8))] (-> (dyn NodeOps))
  (parse-program-mode src false))

(defn parse-script [(src (slice u8))] (-> (dyn NodeOps))
  (parse-program-mode src true))

;; Close the source and JSL call worlds only after pessimistic Iter has visited the Start-rooted
;; graph with every unknown-caller hook intact. Lazy Call->Fun links are installed by Opto; dropping
;; hooks in `parse-program` let pessimistic Iter compute an unlinked Fun as XCTRL before Opto linked
;; it and computed CTRL, violating the optimistic-below-pessimistic invariant.
;; Explicit roots are generation-local; ordinary function-pointer materialization does not imply
;; unknown callers. Keeping those two facts separate preserves closed-world specialization.
(defn parser-callable-root? [(index i64)] (-> bool)
  (let [(mut found) false]
    (al-for [root (.callable-roots (parser-state))]
            (if (= root index) (set! (mut found) true) 0))
    (load found)))

(defn parser-adapter-open? [(index i64)] (-> bool)
  (let [f (syntax-fun-at index)]
    (or (parser-callable-root? index)
        (and (.script-unit (parser-state)) (syntax-script-root? index))
        (and (.external-mutation (parser-state)) (.value-taken f)))))

;; Final Simple's FunNode keeps the StartCU hook for escaped function identities and refuses
;; Region collapse while callers remain unknown. Here a declared source root exposes only its
;; generic JavaScript adapter. That adapter's vector/count parameters stay unconstrained by this
;; compilation's callers; its call into the program-local body ABI remains an ordinary graph edge.
;; This is caller retention, not a claim about global mutation or the callback/import closure.
(defn parser-add-callable-root! [(script i64) (ordinal i64)] (-> i64)
  (let [p (parser-state)
        index (syntax-script-declared-function script ordinal)
        f (syntax-fun-at index)]
    (if (.callers-closed p)
        (panic "parser-add-callable-root!: caller closure is already fixed")
        0)
    (if (not (.external-mutation p))
        (panic "parser-add-callable-root!: external mutation boundary must precede source lowering")
        0)
    (if (or (= (.adapter-nid f) 0) (not (syntax-fun-lowered? index)))
        (panic "parser-add-callable-root!: declaration has no lowered generic entry")
        0)
    (let [adapter (parser-node (.adapter-nid f))]
      (if (not (fun-unknown-callers? adapter))
          (panic "parser-add-callable-root!: generic entry has lost its unknown-caller hook")
          0)
      (fun-set-escapes! adapter))
    (if (not (parser-callable-root? index))
        (push! [i64] (mut (.callable-roots p)) index)
        0)
    0))

(defn parser-close-world! [] (-> i64)
  (if (.callers-closed (parser-state))
      (panic "parser-close-world!: callers already closed")
      0)
  (set! (.callers-closed (parser-state)) true)
  (let [(mut fi) 0]
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break 0)
              (if (not (syntax-fun-lowered? (load fi)))
                  (do (set! (mut fi) (+ (load fi) 1)) (continue))
                  (let [f (syntax-fun-at (load fi))]
                    ;; Internal source bodies use the complete local ABI caller set. Selected
                    ;; generic adapters also admit callers outside this compilation.
                    (if (!= (.fun-nid f) 0)
                        (fun-drop-unknown-callers! (parser-node (.fun-nid f)))
                        0)
                    (if (and (!= (.adapter-nid f) 0)
                             (not (parser-adapter-open? (load fi))))
                        (fun-drop-unknown-callers! (parser-node (.adapter-nid f)))
                        0)
                    (if (= (.fun-nid f) 0)
                        0
                        (let [fun (parser-node (.fun-nid f))
                              (mut i) 0]
                          (loop (if (> (load i) (+ (parser-abi-slots) 1))
                                    (break 0)
                                    (do
                                      (match (fun-parm fun (load i))
                                        (Some [p] (n-unkeep! p))
                                        (None [] 0))
                                      (set! (mut i) (+ (load i) 1))
                                      (continue))))))
                    (set! (mut fi) (+ (load fi) 1))
                    (continue)))))
    (jsl-close-world!)
    0))

;; Final Simple does not make every parsed function a code-generation root before optimistic SCCP.
;; Internal Returns are held temporarily while call discovery runs; otherwise Stop itself keeps an
;; inlined callee alive and its now-caller-controlled Return can GVN/share values across functions.
;; `main` remains the public program root throughout.
(defn parser-prepare-opto! [(stop (dyn NodeOps))] (-> i64)
  (let [entry-fun (parser-entry-fun)
        (mut i) 0
        (mut detached) 0]
    (loop (if (>= (load i) (n-nins stop))
              (break (load detached))
              (let [ret (n-in! stop (load i))]
                (match (return-fun ret)
                  (Some [fun]
                        ;; Stop inputs compress as internal Returns are removed. Function identity,
                        ;; not the mutable edge index, decides which Return is the public root.
                        (if (n-same? fun entry-fun)
                            (do (set! (mut i) (+ (load i) 1)) (continue))
                            (do
                              (n-keep! ret)
                              (n-del-def! stop (load i))
                              (set! (mut detached) (+ (load detached) 1))
                              (continue))))
                  (None [] (do (set! (mut i) (+ (load i) 1)) (continue)))))))))

;; Mirror final Simple's post-Opto `keepInCompUnit`: only functions whose Fun remains live and whose
;; control type is reachable are restored to Stop for machine lowering. The temporary keep is
;; released after the graph edge is installed so a dead/inlined body can be collected normally.
(defn parser-retain-fun! [(stop (dyn NodeOps)) (fun (dyn NodeOps))] (-> i64)
  (match (fun-ret fun)
    (Some [ret]
          (let [live
                  (and (not (n-dead? fun))
                       (not (ty-high? (n-ty fun)))
                       (or (fun-escapes? fun) (not (fun-folding? fun))))]
            (if live (stop-add-return! stop ret) 0)
            (n-unkill! ret)
            (if live 1 0)))
    (None [] 0)))

(defn parser-finish-opto! [(stop (dyn NodeOps))] (-> i64)
  (let [(mut fi) 0
        (mut retained) 0]
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break (load retained))
              (if (not (syntax-fun-lowered? (load fi)))
                  (do (set! (mut fi) (+ (load fi) 1)) (continue))
                  (let [syntax (syntax-fun-at (load fi))]
                    (if (!= (.fun-nid syntax) 0)
                        (set! (mut retained)
                              (+ (load retained)
                                 (parser-retain-fun! stop
                                                     (parser-node (.fun-nid syntax)))))
                        0)
                    (if (!= (.adapter-nid syntax) 0)
                        (set! (mut retained)
                              (+ (load retained)
                                 (parser-retain-fun! stop
                                                     (parser-node (.adapter-nid syntax)))))
                        0)
                    (set! (mut fi) (+ (load fi) 1))
                    (continue)))))))

;; Install final Simple's post-Opto code-generation entry hooks. Optimisation uses concrete
;; Call->Fun edges to discover and inline callees; machine code cannot retain those
;; interprocedural CFG cycles, so every surviving function is instead rooted at Start immediately
;; before unlinking. Matching raw Parm arms preserve the Region/Phi positional invariant without
;; claiming a new runtime value. RPC is reconstructed here because a single linked caller can make
;; it constant during Opto, but code generation always needs the architectural return address.
(defn parser-prepare-codegen! [(start (dyn NodeOps))] (-> i64)
  (let [(mut fi) 0
        (mut prepared) 0]
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break (+ (load prepared)
                        (fun-prepare-codegen! (parser-entry-fun) start)))
              (if (not (syntax-fun-lowered? (load fi)))
                  (do (set! (mut fi) (+ (load fi) 1)) (continue))
                  (let [syntax (syntax-fun-at (load fi))]
                    (if (!= (.fun-nid syntax) 0)
                        (set! (mut prepared)
                              (+ (load prepared)
                                 (fun-prepare-codegen! (parser-node (.fun-nid syntax))
                                                       start)))
                        0)
                    (if (!= (.adapter-nid syntax) 0)
                        (set! (mut prepared)
                              (+ (load prepared)
                                 (fun-prepare-codegen! (parser-node (.adapter-nid syntax))
                                                       start)))
                        0)
                    (set! (mut fi) (+ (load fi) 1))
                    (continue)))))))

(defn parse-statement [] (-> (dyn NodeOps))
  (do
    (unimplemented "parse-statement" "S2 — src/parse/parser.coil")
    (unreachable-node)))

(defn parse-expression [] (-> (dyn NodeOps))
  (lower-syntax-expr (parse-syntax-add)))

(defn parse-if [] (-> (dyn NodeOps))
  (do
    (unimplemented "parse-if" "S2 — src/parse/parser.coil")
    (unreachable-node)))

(defn parse-loop [] (-> (dyn NodeOps))
  (do
    (unimplemented "parse-loop" "S2 — src/parse/parser.coil")
    (unreachable-node)))

(defn parse-function [] (-> (dyn NodeOps))
  (do
    (unimplemented "parse-function" "S2 — src/parse/parser.coil")
    (unreachable-node)))

(defn parse-class [] (-> (dyn NodeOps))
  (do
    (unimplemented "parse-class" "S2 — src/parse/parser.coil")
    (unreachable-node)))

(defn parse-try [] (-> (dyn NodeOps))
  (do
    (unimplemented "parse-try" "S2 — src/parse/parser.coil")
    (unreachable-node)))

;; ---------------------------------------------------------------------------
;; The arguments object (docs/DECISIONS.md, the arguments object)
;;
;; A function whose own code names `arguments`, with no parameter of that name, has an arguments
;; object (FunctionDeclarationInstantiation, §10.2.11 steps 15-22). Making it when only a shadowing
;; declaration is ever read is unobservable, so the syntactic mention decides. Its public entry
;; builds it from the call's count and actuals and passes it in a hidden slot after the formals.
;;
;; A sloppy function with simple parameters gets a mapped object: its indices below the formal
;; count alias the formals. That aliasing is observable only through a write — to a formal, or to an
;; index of the object through any alias of it. So this compiler builds the object once, unaliased,
;; exactly when that is indistinguishable: no formal is assigned anywhere in the function, and every
;; mention of `arguments` is the owner of a property read (`arguments.length`, `arguments[i]`),
;; never written, deleted, called as a receiver or passed on. Otherwise it refuses by name. With no
;; formals nothing is mapped and every use is admitted.
(defstruct ArgumentsScan [(names bool) (unmappable bool) (rebinds bool)])  ; rebinds: `arguments` itself is written

(defn syntax-arguments-formal? [(fi i64) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (al-for [p (.params (syntax-fun-ptr fi))]
            (if (= p name) (set! (mut found) true) 0))
    (load found)))

(defn syntax-arguments-visit! [(fi i64)
                               (id i64)
                               (read-owner bool)
                               (scan (mut ArgumentsScan))] (-> i64)
  (match (syntax-node id)
    (SxName [name]
            (if (= name "arguments")
                (do
                  (set! (.names scan) true)
                  (if read-owner 0 (set! (.unmappable scan) true))
                  0)
                0))
    (SxGroup [inner] (syntax-arguments-visit! fi inner read-owner (mut scan)))
    (SxMember [owner name optional]
              (syntax-arguments-visit! fi owner true (mut scan)))
    (SxIndex [owner key optional]
             (do
               (syntax-arguments-visit! fi owner true (mut scan))
               (syntax-arguments-visit! fi key false (mut scan))))
    (SxAssign [target value]
              (do
                (syntax-arguments-target! fi target (mut scan))
                (syntax-arguments-visit! fi value false (mut scan))))
    (SxCompoundAssign [op target value]
                      (do
                        (syntax-arguments-target! fi target (mut scan))
                        (syntax-arguments-visit! fi value false (mut scan))))
    (SxLogicalAssign [predicate rhs-on-true target value]
                     (do
                       (syntax-arguments-target! fi target (mut scan))
                       (syntax-arguments-visit! fi value false (mut scan))))
    (SxUpdate [op prefix target]
              (syntax-arguments-target! fi target (mut scan)))
    (SxDelete [operand] (syntax-arguments-target! fi operand (mut scan)))
    (SxCall [callee args optional]
            (do
              ;; A member call passes its owner as the receiver: the object escapes.
              (match (syntax-node (syntax-ungroup-id callee))
                (SxMember [owner name opt]
                          (syntax-arguments-visit! fi owner false (mut scan)))
                (SxIndex [owner key opt]
                         (do
                           (syntax-arguments-visit! fi owner false (mut scan))
                           (syntax-arguments-visit! fi key false (mut scan))))
                (_ (syntax-arguments-visit! fi callee false (mut scan))))
              (al-for [a args] (syntax-arguments-visit! fi a false (mut scan)))
              0))
    (_ (let [(mut kids) (al-new [i64] (compiler-allocator))]
         (syntax-expr-children! id (mut kids))
         (al-for [k (load kids)]
                 (syntax-arguments-visit! fi k false (mut scan)))
         (al-free! [i64] (mut kids))
         0))))

;; A write's target: a formal or `arguments` itself is written; a property of anything is written
;; through its owner, which therefore escapes the read-only use.
(defn syntax-arguments-target! [(fi i64)
                                (target i64)
                                (scan (mut ArgumentsScan))] (-> i64)
  (let [t (syntax-ungroup-id target)]
    (match (syntax-node t)
      (SxName [name]
              (do
                (if (= name "arguments")
                    (do (set! (.names scan) true) (set! (.rebinds scan) true) 0)
                    0)
                (if (or (= name "arguments") (syntax-arguments-formal? fi name))
                    (set! (.unmappable scan) true)
                    0)
                0))
      (SxMember [owner name optional]
                (syntax-arguments-visit! fi owner false (mut scan)))
      (SxIndex [owner key optional]
               (do
                 (syntax-arguments-visit! fi owner false (mut scan))
                 (syntax-arguments-visit! fi key false (mut scan))))
      (_ (syntax-arguments-visit! fi t false (mut scan))))))

(defn syntax-arguments-stmt! [(fi i64) (id i64) (scan (mut ArgumentsScan))] (-> i64)
  (do
    (match (syntax-stmt-node id)
      ;; `var x = …` redeclaring a formal assigns it.
      (SsVar [name init annotation]
             (match init
               (Some [e]
                     (if (syntax-arguments-formal? fi name)
                         (set! (.unmappable scan) true)
                         0))
               (None [] 0)))
      (SsForIn [head of right body awaited]
               (match head
                 (ForInitExpr [e] (syntax-arguments-target! fi e (mut scan)))
                 (ForInitDecl [stmt]
                              (match (syntax-stmt-node stmt)
                                (SsVar [name init annotation]
                                       (if (syntax-arguments-formal? fi name)
                                           (set! (.unmappable scan) true)
                                           0))
                                (_ 0)))
                 (_ 0)))
      (_ 0))
    (let [(mut exprs) (al-new [i64] (compiler-allocator))
          (mut kids) (al-new [i64] (compiler-allocator))]
      (syntax-stmt-exprs! id (mut exprs))
      (al-for [e (load exprs)]
              ;; A for-in expression head was visited as a target above.
              (if (match (syntax-stmt-node id)
                    (SsForIn [head of right body awaited]
                             (match head (ForInitExpr [h] (= h e)) (_ false)))
                    (_ false))
                  0
                  (syntax-arguments-visit! fi e false (mut scan))))
      (syntax-stmt-children! id (mut kids))
      (al-for [k (load kids)] (syntax-arguments-stmt! fi k (mut scan)))
      (al-free! [i64] (mut exprs))
      (al-free! [i64] (mut kids))
      0)))

;; Mark every non-root, non-intrinsic function that has an arguments object, and whether its object
;; cannot stand for a mapped one.
(defn syntax-analyze-arguments! [] (-> i64)
  (let [(mut fi) 0]
    (loop (if (>= (load fi) (len (.funs (parser-state))))
              (break 0)
              (do
                (if (or (syntax-script-root? (load fi))
                        (syntax-fun-forwarding? (load fi))
                        ;; An arrow has no arguments object of its own: its mention is a capture.
                        (match (.kind (syntax-fun-ptr (load fi)))
                          (FunArrow [] true)
                          (_ false))
                        (syntax-arguments-formal? (load fi) "arguments"))
                    0
                    (let [fp (syntax-fun-ptr (load fi))
                          (mut scan) (primitive/zeroed ArgumentsScan)]
                      (al-for [s (.body fp)]
                              (syntax-arguments-stmt! (load fi) s (mut scan)))
                      (match (.expression-body fp)
                        (Some [e]
                              (syntax-arguments-visit! (load fi)
                                                       e
                                                       false
                                                       (mut scan)))
                        (None [] 0))
                      (set! (.arguments-object fp) (.names scan))
                      ;; Assigning `arguments` itself rebinds the object: refused with or without formals.
                      (set! (.arguments-unmappable fp)
                            (and (.names scan)
                                 (or (.rebinds scan)
                                     (and (.unmappable scan)
                                          (> (len (.params fp)) 0)))))
                      0))
                (set! (mut fi) (+ (load fi) 1))
                (continue))))))

;; The compiler-only Scope name holding a function's arguments object.
(const ARGUMENTS-OBJECT-SLOT "$aot$.arguments")

;; A function with an arguments object binds it from the hidden slot after its formals. Strict code
;; and non-simple parameter lists make an unmapped object whose `callee` is the %ThrowTypeError%
;; accessor, which this realm does not declare yet; a mapped object whose aliasing a write could
;; observe is refused (`syntax-analyze-arguments!`).
(defn lower-bind-arguments-object! [(fi i64)
                                    (scope (dyn NodeOps))
                                    (fun (dyn NodeOps))] (-> i64)
  (let [f (syntax-fun-ptr fi)]
    (if (not (.arguments-object f))
        0
        (do
          (if (or (.strict f) (not (.simple-params f)))
              (unimplemented "strict and non-simple arguments objects (the callee accessor is %ThrowTypeError%)"
                             "docs/GAPS.md — the arguments object")
              0)
          (if (.arguments-unmappable f)
              (unimplemented "a mapped arguments object whose aliasing of formals a write could observe"
                             "docs/GAPS.md — the arguments object")
              0)
          (scope-define! scope
                         ARGUMENTS-OBJECT-SLOT
                         (ty-dyn TAG-ANY)
                         false
                         (match (fun-parm fun (+ (len (.params f)) 2))
                           (Some [p] p)
                           (None []
                                 (do
                                   (broken "lower-bind-arguments-object!: the hidden slot has no Parm")
                                   (unreachable-node)))))
          0))))

;; `arguments` not otherwise bound: the current function's own object, or a capture from an arrow.
(defn lower-arguments-object [] (-> (Option (dyn NodeOps)))
  (let [p (parser-state)
        fi (.current-fun p)]
    (if (syntax-script-root? fi)
        (None [(dyn NodeOps)])
        (match (.kind (syntax-fun-ptr fi))
          (FunArrow []
                    (do
                      (unimplemented "arrow function `arguments` (a capture of the enclosing function's)"
                                     "docs/GAPS.md — function values and closures")
                      (Some (unreachable-node))))
          (_ (if (.arguments-object (syntax-fun-ptr fi))
                 (scope-lookup (parser-node (.current-scope p))
                               ARGUMENTS-OBJECT-SLOT)
                 (None [(dyn NodeOps)])))))))

;; A template with substitutions (§13.2.8.6): the first cooked string, then for each substitution its
;; value, ToString'd at once (an object through ToPrimitive, which can throw; a Symbol is a TypeError),
;; and the next cooked string (`JsTemplateAppend`).
(defn lower-template [(quasis (ArrayList i64)) (substitutions (ArrayList i64))] (-> (dyn NodeOps))
  (let [(mut acc) (lower-syntax-expr (get quasis 0))
        (mut i) 0]
    (loop (if (>= (load i) (len substitutions))
              (break 0)
              (do
                (n-keep! (load acc))
                (let [value (lower-syntax-expr (get substitutions (load i)))]
                  (n-keep! value)
                  (let [quasi (lower-syntax-expr (get quasis (+ (load i) 1)))]
                    (n-unkeep! value)
                    (n-unkeep! (load acc))
                    (set! (mut acc)
                          (lower-completion! (lower-jsl-values3 "JsTemplateAppend"
                                                                (load acc)
                                                                value
                                                                quasi)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load acc)))

;; The ABI builtin that fills a record's hidden slot, the one after its formals: the actuals as an
;; array for a rest parameter, or the function's arguments object. A record with neither has no
;; hidden slot.
(defn syntax-fun-hidden-builtin [(fi i64)] (-> (Option (slice u8)))
  (let [f (syntax-fun-ptr fi)]
    (if (or (.default-derived f)
            (match (.rest-param f) (Some [r] true) (None [] false)))
        (Some "JsCallArgumentsArray")
        (if (.arguments-object f)
            (Some "JsCreateArgumentsObject")
            (None [(slice u8)])))))

;; The hidden slots after a record's formals, in order: the call's actuals (or its arguments object)
;; and the function object being called. A record with neither has none.
(defn syntax-fun-hidden-count [(fi i64)] (-> i64)
  (+ (match (syntax-fun-hidden-builtin fi) (Some [b] 1) (None [] 0))
     (if (.needs-callee (syntax-fun-ptr fi)) 1 0)))

(defn syntax-fun-callee-slot [(fi i64)] (-> i64)
  (+ (len (.params (syntax-fun-ptr fi)))
     (match (syntax-fun-hidden-builtin fi) (Some [b] 1) (None [] 0))))

;; The hidden slot's Parm, which the entry filled.
(defn lower-hidden-slot-parm [(fi i64) (fun (dyn NodeOps))] (-> (dyn NodeOps))
  (match (fun-parm fun (+ (len (.params (syntax-fun-ptr fi))) 2))
    (Some [p] p)
    (None []
          (do
            (broken "lower-hidden-slot-parm: the hidden slot has no Parm")
            (unreachable-node)))))

;; A parameter's default (§8.6.3 IteratorBindingInitialization): the actual when it is not undefined,
;; the initializer's value otherwise, evaluated in the scope where the earlier parameters are bound.
(defn lower-parameter-default [(actual (dyn NodeOps)) (init i64)] (-> (dyn NodeOps))
  (let [condition (n-peephole! (typetest-make actual TAG-UNDEFINED))
        iff (if-make (parser-node (.current-ctrl (parser-state))) condition)
        arms (if-arms! iff)
        supplied-scope (parser-node (.current-scope (parser-state)))
        missing-scope (scope-dup supplied-scope false)]
    (n-keep! actual)
    (set! (.current-scope (parser-state)) (n-nid missing-scope))
    (scope-set-ctrl! missing-scope (arms-true arms))
    (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
    (let [defaulted (lower-syntax-expr init)]
      (n-keep! defaulted)
      (let [missing-exit (parser-node (.current-scope (parser-state)))]
        (scope-set-ctrl! supplied-scope (arms-false arms))
        (let [merged (scope-merge! missing-exit supplied-scope)
              phi
                (phi-make (scope-ctrl merged)
                          (ty-dyn TAG-ANY)
                          "parameter.default")]
          (phi-add-value! phi defaulted)
          (phi-add-value! phi actual)
          (set! (.current-scope (parser-state)) (n-nid merged))
          (set! (.current-ctrl (parser-state)) (n-nid (scope-ctrl merged)))
          (n-unkeep! defaulted)
          (n-unkeep! actual)
          (n-peephole! phi))))))

;; The record a class's `constructor` element names, or a fresh empty one standing for the default
;; constructor. Class code is strict.
(defn syntax-class-constructor-record! [(elements (ArrayList ClassElement))
                                        (name (slice u8))
                                        (lo i64)
                                        (derived bool)
                                        (class-index i64)] (-> i64)
  (let [(mut found) -1]
    (al-for [element elements]
            (match element
              (CeMethod [key is-static fun]
                        (if is-static
                            0
                            (match key
                              (CkNamed [k]
                                       (if (= k "constructor")
                                           (set! (mut found) fun)
                                           0))
                              (_ 0))))
              (_ 0)))
    (if (>= (load found) 0)
        (let [fp (syntax-fun-ptr (load found))]
          (set! (.class-ctor fp) true)
          (set! (.derived-ctor fp) derived)
          (set! (.class-index fp) class-index)
          ;; A derived constructor's `super()` needs the function object being called.
          (if derived (set! (.needs-callee fp) true) 0)
          (load found))
        (let [index (syntax-fun-reserve! name (FunMethod) false false lo)
              fp (syntax-fun-ptr index)]
          (set! (.strict fp) true)
          (set! (.in-class fp) true)
          (set! (.class-ctor fp) true)
          (set! (.derived-ctor fp) derived)
          (set! (.class-index fp) class-index)
          ;; The default derived constructor forwards the call's arguments to `super`.
          (set! (.default-derived fp) derived)
          (set! (.needs-callee fp) derived)
          index))))

;; ---------------------------------------------------------------------------
;; Classes (docs/DECISIONS.md, classes)
;;
;; ClassDefinitionEvaluation (§15.7.14) for a base class: the constructor is the `constructor`
;; element's record, or the empty one the parse synthesized; its function object gets the class's
;; prototype object with the specified attributes, and every method and accessor is defined —
;; non-enumerable — on that prototype, or on the constructor when it is static. Heritage, fields,
;; static blocks, computed keys and private names refuse by name.
(defn lower-class [(cls i64)] (-> (dyn NodeOps))
  (let [c (get (.classes (parser-state)) cls)
        derived (match (.heritage c) (Some [h] true) (None [] false))
        (mut parent-nid) 0]
    (match (.heritage c)
      (Some [h]
            (let [v (lower-syntax-expr h)]
              (n-keep! v)
              (set! (mut parent-nid) (n-nid v))
              0))
      (None [] 0))
    ;; The prototype object precedes the constructor, which takes it as its home object.
    (let [proto
            (if derived
                (let [parent (parser-node (load parent-nid))
                      parent-proto
                        (lower-jsl-values1 "JsClassHeritagePrototype" parent)]
                  (lower-jsl-values1 "JsNewClassPrototype" parent-proto))
                (lower-jsl-values0 "JsNewBaseClassPrototype"))]
      (n-keep! proto)
      (let [ctor (lower-method-object (.ctor c) proto)]
        (n-keep! ctor)
        (let [linked
                (if derived
                    (lower-completion! (lower-jsl-values3 "JsLinkDerivedClass"
                                                          ctor
                                                          (parser-node (load parent-nid))
                                                          proto))
                    (lower-completion! (lower-jsl-values2 "JsLinkClassPrototype"
                                                          ctor
                                                          proto)))]
          (if derived (n-unkeep! (parser-node (load parent-nid))) 0)
          ;; Every element's property name is evaluated where it is written, in element order
          ;; (§15.7.14 step 25), and a method is defined at once; a static field's initializer and a
          ;; static block wait for step 29, so the keys are kept until then.
          (let [(mut keys) (al-new [(dyn NodeOps)] (compiler-allocator))
                (mut i) 0]
            (al-for [element (.elements c)]
                    ;; A static block has no property name; every other element's is evaluated here.
                    (let [key
                            (match element
                              (CeMethod [key is-static fun]
                                        (lower-class-key key))
                              (CeField [key is-static init-fun]
                                       (lower-class-key key))
                              (CeStaticBlock [fun] (dyn-undefined-make)))]
                      (n-keep! key)
                      (push! [(dyn NodeOps)] (mut keys) key)
                      (match element
                        (CeMethod [k is-static fun]
                                  (if (= fun (.ctor c))
                                      0
                                      (lower-class-member! (if is-static
                                                               ctor
                                                               proto)
                                                           k
                                                           key
                                                           fun)))
                        (_ 0))
                      0))
            (al-for [element (.elements c)]
                    (do
                      (match element
                        (CeField [key is-static init-fun]
                                 ;; A static field is defined on the constructor, with the
                                 ;; constructor as its `this`, in declaration order; an instance
                                 ;; field waits for a construction.
                                 (if is-static
                                     (lower-define-field! ctor
                                                          key
                                                          (get (load keys)
                                                               (load i))
                                                          init-fun)
                                     0))
                        ;; A static block is a body run with the constructor as its `this`, in the
                        ;; same order as the static fields it sits among (§15.7.14 step 29).
                        (CeStaticBlock [fun]
                                       (do (lower-static-block! fun ctor) 0))
                        (_ 0))
                      (set! (mut i) (+ (load i) 1))
                      0))
            (al-for [key (load keys)] (n-unkeep! key))
            (al-free! [(dyn NodeOps)] (mut keys)))
          (n-unkeep! proto)
          (n-unkeep! ctor)
          ctor)))))

;; One class element's property name (§15.7.14 ClassElementName): an interned key, or the value of a
;; computed one, converted to a primitive where it is written so the interning cannot fail later.
(defn lower-class-key [(key ClassKey)] (-> (dyn NodeOps))
  (match key
    (CkNamed [k] (keyref-make (shape-key-intern k)))
    (CkComputed [e]
                (lower-completion! (lower-jsl-values1 "JsComputedKeyPrimitive"
                                                      (lower-syntax-expr e))))
    (CkPrivate [k]
               (do
                 (unimplemented "private class elements"
                                "docs/GAPS.md — classes")
                 (unreachable-node)))))

(defn class-key-computed? [(key ClassKey)] (-> bool)
  (match key (CkComputed [e] true) (_ false)))

;; One method or accessor of a class, on the prototype object or on the constructor.
(defn lower-class-member! [(target (dyn NodeOps))
                           (key ClassKey)
                           (key-value (dyn NodeOps))
                           (fun i64)] (-> i64)
  (let [computed (class-key-computed? key)
        ;; MakeMethod (§15.7.14 step 25): the home object is the object the member is defined on.
        function (lower-method-object fun target)
        setter (match (.kind (syntax-fun-ptr fun)) (FunSetter [] 1) (_ 0))
        accessor
          (match (.kind (syntax-fun-ptr fun))
            (FunGetter [] true)
            (FunSetter [] true)
            (_ false))
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut args) target)
    (push! [(dyn NodeOps)] (mut args) key-value)
    (push! [(dyn NodeOps)] (mut args) function)
    (if accessor (push! [(dyn NodeOps)] (mut args) (con-int setter)) 0)
    (let [defined
            (lower-jsl-values (if accessor
                                  (if computed
                                      "JsDefineClassAccessorComputed"
                                      "JsDefineClassAccessor")
                                  (if computed
                                      "JsDefineClassMethodComputed"
                                      "JsDefineClassMethod"))
                              (load args))]
      (al-free! [(dyn NodeOps)] (mut args))
      (lower-completion! defined)
      0)))

(defn lower-jsl-values1 [(name (slice u8)) (a (dyn NodeOps))] (-> (dyn NodeOps))
  (let [(mut values) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut values) a)
    (let [v (lower-completion! (lower-jsl-values name (load values)))]
      (al-free! [(dyn NodeOps)] (mut values))
      v)))

;; `class C { … }` as a statement: the class value initializes C's lexical binding.
(defn lower-class-declaration! [(cls i64)] (-> i64)
  (let [p (parser-state)
        name (syntax-class-name cls)
        value (lower-class cls)]
    (if (>= (scope-find (parser-node (.current-scope p)) name) 0)
        (lower-binding-initialize! name value)
        (if (and (syntax-script-root? (.current-fun p))
                 (syntax-script-binding? name))
            (lower-script-declaration-effect! "JsInitializeGlobalLexicalBinding"
                                              name
                                              (Some value))
            (panic "lower-class-declaration!: the class binding was not instantiated")))
    0))

(defn syntax-class-name [(cls i64)] (-> (slice u8))
  (let [c (get (.classes (parser-state)) cls)] (.name c)))

;; A class constructor's entry (§15.7.14, the [[Call]] of a class constructor): calling it without
;; `new` — so with an undefined `new.target` — is a TypeError before anything else runs.
(defn lower-class-constructor-entry! [(fi i64) (fun (dyn NodeOps))] (-> i64)
  (if (not (.class-ctor (syntax-fun-ptr fi)))
      0
      (let [new-target
              (match (fun-parm fun 1)
                (Some [p] p)
                (None []
                      (do
                        (broken "lower-class-constructor-entry!: no new.target Parm")
                        (unreachable-node))))
            iff
              (if-make (parser-node (.current-ctrl (parser-state)))
                       (n-peephole! (typetest-make new-target TAG-UNDEFINED)))
            arms (if-arms! iff)
            scope (parser-node (.current-scope (parser-state)))
            constructed (scope-dup scope false)]
        ;; The called path throws and never joins the constructed one.
        (scope-set-ctrl! scope (arms-true arms))
        (set! (.current-ctrl (parser-state)) (n-nid (arms-true arms)))
        (lower-throw-type-error! "Class constructor cannot be invoked without 'new'")
        (scope-set-ctrl! constructed (arms-false arms))
        (set! (.current-scope (parser-state)) (n-nid constructed))
        (set! (.current-ctrl (parser-state)) (n-nid (arms-false arms)))
        ;; A base constructor's instance fields are defined on its `this` before its body runs
        ;; (§10.2.2 step 8); a derived one's wait for `super()`.
        (if (.derived-ctor (syntax-fun-ptr fi))
            0
            (lower-instance-fields! fi (lower-receiver-parm fi)))
        0)))

;; The ABI builtins that fill a record's hidden slots, in slot order.
(defn parser-hidden-builders [(fi i64)] (-> (ArrayList (dyn NodeOps)))
  (let [(mut builders) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (match (syntax-fun-hidden-builtin fi)
      (Some [builder]
            (push! [(dyn NodeOps)] (mut builders) (jsl-call-target builder)))
      (None [] 0))
    (if (.needs-callee (syntax-fun-ptr fi))
        (push! [(dyn NodeOps)] (mut builders) (jsl-call-target "JsCallCallee"))
        0)
    (load builders)))

;; The compiler-only Scope name holding a derived constructor's `this`, which `super()` initializes.
(const DERIVED-THIS-SLOT "$aot$.this")

;; A derived constructor's `this` starts uninitialized; `super()` binds it (§9.1.1.3).
(defn lower-derived-this-entry! [(fi i64) (scope (dyn NodeOps))] (-> i64)
  (if (.derived-ctor (syntax-fun-ptr fi))
      (do
        (scope-define! scope
                       DERIVED-THIS-SLOT
                       (ty-dyn TAG-ANY)
                       false
                       (dyn-undefined-make))
        0)
      0))

;; `super(...)` (§13.3.7.1): the parent constructor is the running constructor's [[Prototype]], which
;; the entry passed in the hidden callee slot; its result becomes `this`, and a second `super()` in
;; one constructor is a ReferenceError.
(defn lower-super-call [(args (ArrayList i64))] (-> (dyn NodeOps))
  (let [p (parser-state)
        fi (.current-fun p)]
    (if (not (.derived-ctor (syntax-fun-ptr fi)))
        (do
          (unimplemented "`super()` outside a derived constructor"
                         "docs/GAPS.md — classes")
          (unreachable-node))
        (let [array (lower-arguments-array args)]
          (n-keep! array)
          (let [fun (parser-node (.fun-nid (syntax-fun-ptr fi)))
                callee (lower-hidden-callee fi fun)
                new-target
                  (match (fun-parm fun 1)
                    (Some [t] t)
                    (None [] (unreachable-node)))
                constructed
                  (lower-completion! (lower-jsl-values3 "JsSuperConstruct"
                                                        callee
                                                        new-target
                                                        array))]
            (n-unkeep! array)
            (n-keep! constructed)
            (let [scope (parser-node (.current-scope p))
                  bound
                    (lower-completion! (lower-jsl-values2 "JsRequireThisUninitialized"
                                                          (lower-derived-this-value fi)
                                                          constructed))]
              (n-unkeep! constructed)
              (scope-update! (parser-node (.current-scope p))
                             DERIVED-THIS-SLOT
                             bound)
              (lower-instance-fields! fi bound)
              (dyn-undefined-make)))))))

;; The current derived constructor's `this` binding, before any initialization check.
(defn lower-derived-this-value [(fi i64)] (-> (dyn NodeOps))
  (match (scope-lookup (parser-node (.current-scope (parser-state)))
                       DERIVED-THIS-SLOT)
    (Some [v] v)
    (None []
          (do
            (broken "lower-derived-this-value: the derived `this` binding is missing")
            (unreachable-node)))))

;; ---------------------------------------------------------------------------
;; Environments (docs/DECISIONS.md, closures)

;; The compiler-only Scope name holding the running activation's environment record.
(const ENVIRONMENT-SLOT "$aot$.env")

;; The environment a record hands to the function objects it creates: its own record when it owns
;; one, else the environment it was called with, else null.
(defn lower-environment-value [] (-> (dyn NodeOps))
  (match (scope-lookup (parser-node (.current-scope (parser-state)))
                       ENVIRONMENT-SLOT)
    (Some [env] env)
    (None [] (dyn-null-make))))

;; A record's environment at entry: a fresh record over the one it was called with when nested
;; functions capture its bindings, else that one unchanged. Its captured parameters are stored into
;; their slots at once, so every later read of them is the slot.
(defn lower-environment-entry! [(fi i64) (fun (dyn NodeOps))] (-> i64)
  (let [f (syntax-fun-ptr fi)]
    (if (and (.needs-home f) (.uses-env f))
        (do
          (unimplemented "a method that both reads `super` and captures a binding"
                         "docs/GAPS.md — function values and closures")
          0)
        (if (not (or (.owns-env f) (.uses-env f)))
            0
            (let [scope (parser-node (.current-scope (parser-state)))
                  outer
                    (if (.uses-env f)
                        (lower-completion! (lower-jsl-values1 "JsFunctionEnvironment"
                                                              (lower-hidden-callee fi
                                                                                   fun)))
                        (dyn-null-make))]
              (if (not (.owns-env f))
                  (do
                    (scope-define! scope
                                   ENVIRONMENT-SLOT
                                   (ty-dyn TAG-ANY)
                                   true
                                   outer)
                    0)
                  (let [env
                          (lower-jsl-values2 "JsNewEnvironment"
                                             outer
                                             (con-int (len (.env-names f))))]
                    (scope-define! scope
                                   ENVIRONMENT-SLOT
                                   (ty-dyn TAG-ANY)
                                   true
                                   env)
                    ;; A captured parameter's actual is its first value; every other captured
                    ;; binding is stored where its declaration or assignment runs.
                    (lower-environment-parameters! fi)
                    0)))))))

;; Each captured binding of the running record becomes a Scope binding that lives in a slot: a
;; parameter keeps the value its Parm already bound, and the rest start undefined.
(defn lower-environment-parameters! [(fi i64)] (-> i64)
  (let [f (syntax-fun-ptr fi)
        (mut slot) 1]
    (al-for [name (.env-names f)]
            (let [scope (parser-node (.current-scope (parser-state)))]
              (if (= name THIS-CAPTURE-SLOT)
                  ;; The receiver an arrow inside this function reads as `this`.
                  (if (.derived-ctor (syntax-fun-ptr fi))
                      (unimplemented "an arrow that reads `this` in a derived constructor"
                                     "docs/GAPS.md — classes")
                      (do
                        (lower-environment-store! (load slot) (lower-this))
                        (scope-define-captured! scope
                                                name
                                                (ty-dyn TAG-ANY)
                                                true
                                                (load slot)
                                                (dyn-undefined-make))))
                  (if (>= (scope-find scope name) 0)
                      ;; A parameter: its actual is the binding's first value, and the binding lives in
                      ;; the slot from here on.
                      (let [value (lower-name-uncaptured name)]
                        (lower-environment-store! (load slot) value)
                        (scope-mark-captured! (parser-node (.current-scope (parser-state)))
                                              name
                                              (load slot)))
                      (if (syntax-env-name-lexical? fi name)
                          ;; A body-level `let`, `const` or `class`: its slot stays empty until its
                          ;; initialization runs, which is its temporal dead zone (§9.1.1.1.6).
                          (scope-define-captured-lexical! scope
                                                          name
                                                          (ty-dyn TAG-ANY)
                                                          false
                                                          (load slot)
                                                          (dyn-undefined-make))
                          ;; A `var` or a body function declaration: undefined from instantiation on, as
                          ;; FunctionDeclarationInstantiation binds it (§10.2.11 step 27); instantiation
                          ;; then finds the binding here and leaves it alone, and each write goes to the
                          ;; slot.
                          (do
                            (lower-environment-store! (load slot)
                                                      (dyn-undefined-make))
                            (scope-define-captured! scope
                                                    name
                                                    (ty-dyn TAG-ANY)
                                                    false
                                                    (load slot)
                                                    (dyn-undefined-make))))))
              (set! (mut slot) (+ (load slot) 1))
              0))
    0))

;; InitializeBinding for a binding of the running activation: a captured lexical's slot was empty
;; until now, and filling it ends its temporal dead zone.
(defn lower-binding-initialize! [(name (slice u8)) (value (dyn NodeOps))] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))
        slot (scope-env-slot scope name)]
    (if (>= slot 0)
        (lower-environment-store! slot value)
        (scope-initialize! scope name value))))

;; A write to a binding of the running activation, wherever it lives.
(defn lower-binding-write! [(name (slice u8)) (value (dyn NodeOps))] (-> i64)
  (let [scope (parser-node (.current-scope (parser-state)))
        slot (scope-env-slot scope name)]
    (if (>= slot 0)
        (lower-environment-store! slot value)
        (scope-update! scope name value))))

(defn lower-environment-store! [(slot i64) (value (dyn NodeOps))] (-> i64)
  (lower-jsl-values3 "JsEnvStore"
                     (lower-environment-value)
                     (con-int slot)
                     value)
  0)

(defn lower-environment-load [(slot i64)] (-> (dyn NodeOps))
  (lower-jsl-values2 "JsEnvSlot" (lower-environment-value) (con-int slot)))

;; A captured lexical's read: an empty slot is its temporal dead zone, which is a ReferenceError.
(defn lower-environment-load-checked [(slot i64)] (-> (dyn NodeOps))
  (lower-completion! (lower-jsl-values2 "JsEnvSlotInitialized"
                                        (lower-environment-value)
                                        (con-int slot))))

;; A binding of an enclosing activation: the environment `depth` links above the running one, and
;; its slot there. Depth counts the records between the two that own an environment.
(defn lower-environment-outer [(owner i64) (name (slice u8))] (-> (dyn NodeOps))
  (let [ancestor
          (lower-jsl-values2 "JsEnvAncestor"
                             (lower-environment-value)
                             (con-int (syntax-environment-depth (.current-fun (parser-state))
                                                                owner)))]
    (if (syntax-env-name-lexical? owner name)
        (lower-completion! (lower-jsl-values2 "JsEnvSlotInitialized"
                                              ancestor
                                              (con-int (syntax-environment-slot owner
                                                                                name))))
        (lower-jsl-values2 "JsEnvSlot"
                           ancestor
                           (con-int (syntax-environment-slot owner name))))))

(defn lower-environment-outer-store! [(owner i64)
                                      (name (slice u8))
                                      (value (dyn NodeOps))] (-> i64)
  (let [ancestor
          (lower-jsl-values2 "JsEnvAncestor"
                             (lower-environment-value)
                             (con-int (syntax-environment-depth (.current-fun (parser-state))
                                                                owner)))]
    (n-keep! ancestor)
    (let [slot (syntax-environment-slot owner name)]
      (lower-completion! (lower-jsl-values3 "JsEnvStore"
                                            ancestor
                                            (con-int slot)
                                            value))
      (n-unkeep! ancestor)
      0)))

;; The slot `name` has in `owner`'s environment record.
(defn syntax-environment-slot [(owner i64) (name (slice u8))] (-> i64)
  (let [f (syntax-fun-ptr owner)
        (mut slot) 1
        (mut answer) -1]
    (al-for [n (.env-names f)]
            (do
              (if (and (< (load answer) 0) (= n name))
                  (set! (mut answer) (load slot))
                  0)
              (set! (mut slot) (+ (load slot) 1))
              0))
    (if (< (load answer) 0)
        (broken "syntax-environment-slot: the owner has no slot for a captured binding")
        0)
    (load answer)))

;; How many environment records separate the one `user` holds from `owner`'s: the records between
;; them that own one, the user's own included when it does.
(defn syntax-environment-depth [(user i64) (owner i64)] (-> i64)
  (let [(mut depth) 0
        (mut current) user]
    (loop (if (= (load current) owner)
              (break 0)
              (let [f (syntax-fun-ptr (load current))]
                (if (.owns-env f) (set! (mut depth) (+ (load depth) 1)) 0)
                (set! (mut current) (.parent f))
                (if (< (load current) 0)
                    (break (do
                             (broken "syntax-environment-depth: the owner does not enclose the user")
                             0))
                    (continue)))))
    (load depth)))

;; InitializeInstanceElements (§10.2.11): each instance field of the class, in declaration order,
;; defined on the object being constructed — for a base constructor before its body runs, for a
;; derived one the moment `super()` binds `this` (§13.3.7.1 step 8).
(defn lower-instance-fields! [(fi i64) (receiver (dyn NodeOps))] (-> i64)
  (let [cls (.class-index (syntax-fun-ptr fi))]
    (if (< cls 0)
        0
        (let [c (get (.classes (parser-state)) cls)]
          (n-keep! receiver)
          (al-for [element (.elements c)]
                  (match element
                    (CeField [key is-static init-fun]
                             (if is-static
                                 0
                                 (if (class-key-computed? key)
                                     ;; Its key was evaluated once, where the class was: a
                                     ;; construction would have to read it back from the class.
                                     (unimplemented "a computed key on an instance field"
                                                    "docs/GAPS.md — classes")
                                     (lower-define-field! receiver
                                                          key
                                                          (lower-class-key key)
                                                          init-fun))))
                    (_ 0)))
          (n-unkeep! receiver)
          0))))

;; DefineField (§10.2.11): CreateDataPropertyOrThrow of the initializer's value — undefined when the
;; field has none — on the object the field belongs to. The initializer is a function of `this`
;; alone: the constructor's parameters and body bindings are not in its scope, so it is called, not
;; inlined.
(defn lower-define-field! [(target (dyn NodeOps))
                           (key ClassKey)
                           (key-value (dyn NodeOps))
                           (init (Option i64))] (-> i64)
  (let [computed (class-key-computed? key)
        value
          (match init
            (Some [f] (lower-field-initializer f target))
            (None [] (dyn-undefined-make)))]
    (n-keep! value)
    (let [(mut args) (al-new [(dyn NodeOps)] (compiler-allocator))]
      (push! [(dyn NodeOps)] (mut args) target)
      (push! [(dyn NodeOps)] (mut args) key-value)
      (push! [(dyn NodeOps)] (mut args) value)
      (let [defined
              (lower-jsl-values (if computed
                                    "JsDefineFieldComputed"
                                    "JsDefineField")
                                (load args))]
        (al-free! [(dyn NodeOps)] (mut args))
        (lower-completion! defined)
        (n-unkeep! value)
        0))))

;; A static block: its record's entry called with the constructor as the receiver, its value dropped.
(defn lower-static-block! [(fi i64) (ctor (dyn NodeOps))] (-> i64)
  (if (.needs-home (syntax-fun-ptr fi))
      (do
        (unimplemented "`super` in a class static block"
                       "docs/GAPS.md — classes")
        0)
      (if (not (syntax-fun-lowered? fi))
          (do
            (unimplemented "a class static block that is not an admitted function value"
                           "docs/GAPS.md — classes")
            0)
          (do (lower-receiver-entry-call fi ctor) 0))))

;; A field initializer's value: its record's entry called with the field's object as the receiver.
(defn lower-field-initializer [(fi i64) (receiver (dyn NodeOps))] (-> (dyn NodeOps))
  (if (.needs-home (syntax-fun-ptr fi))
      (do
        (unimplemented "`super` in a class field initializer"
                       "docs/GAPS.md — classes")
        (unreachable-node))
      (if (not (syntax-fun-lowered? fi))
          (do
            (unimplemented "a class field initializer that is not an admitted function value"
                           "docs/GAPS.md — classes")
            (unreachable-node))
          (lower-receiver-entry-call fi receiver))))

;; A direct call of a record's own entry with a receiver and no arguments.
(defn lower-receiver-entry-call [(fi i64) (receiver (dyn NodeOps))] (-> (dyn NodeOps))
  (let [target-syntax (syntax-fun-at fi)
        target (parser-node (.fun-nid target-syntax))
        scope (parser-node (.current-scope (parser-state)))
        c
          (call-make-with-mem (parser-node (.current-ctrl (parser-state)))
                              (scope-mem scope))
        formal-count (parser-abi-slots)
        (mut i) 0]
    (call-add-arg! c receiver)
    (call-add-arg! c (dyn-undefined-make))
    (loop (if (>= (load i) formal-count)
              (break 0)
              (do
                (call-add-arg! c (dyn-undefined-make))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (n-set-def! c CALL-CTRL (Some (parser-node (.current-ctrl (parser-state)))))
    (n-set-def! c
                CALL-MEM
                (Some (scope-mem (parser-node (.current-scope (parser-state))))))
    (call-set-fptr! c (funptr-make target (.fidx target-syntax)))
    (let [end (callend-make c)]
      (parser-set-current-ctrl! (cproj-make end RETURN-CTRL "call.ctrl"))
      (scope-set-mem! (parser-node (.current-scope (parser-state)))
                      (proj-make end RETURN-MEM "call.mem"))
      (let [value (proj-make end RETURN-VALUE "call.value")]
        (if (syntax-fun-may-throw? fi)
            (lower-exception-check! value)
            (cast-make (parser-node (.current-ctrl (parser-state)))
                       value
                       (ty-dyn TAG-ANY)))))))

;; MakeSuperPropertyReference (§13.3.7.3): the base of a `super` reference is the object above the
;; running method's home object, which its function object carries. Its receiver is the method's
;; own `this`, so an inherited accessor runs on the current object.
(defn lower-super-base [] (-> (dyn NodeOps))
  (let [p (parser-state)
        fi (.current-fun p)]
    (if (not (.needs-home (syntax-fun-ptr fi)))
        ;; An arrow inherits `super` from the method around it, which is a capture.
        (do
          (unimplemented "`super` through an arrow function"
                         "docs/GAPS.md — lexical environments and closures")
          (unreachable-node))
        (let [fun (parser-node (.fun-nid (syntax-fun-ptr fi)))
              callee (lower-hidden-callee fi fun)]
          (lower-completion! (lower-jsl-values1 "JsSuperBase" callee))))))

;; `super.x` and `super[k]` as a value: the reference, read and released.
(defn lower-super-read [(target i64)] (-> (dyn NodeOps))
  (let [ref (lower-ref-prepare! target)
        value (lower-ref-get! ref)]
    (lower-ref-release! ref)
    value))

;; `super.m(args)` and `super[k](args)`: the method is found on the base object and called with the
;; running method's `this` — the receiver of a super call is never the base (§13.3.7.1).
(defn lower-super-member-call [(target i64)
                               (args (ArrayList i64))
                               (label (slice u8))] (-> (dyn NodeOps))
  (let [ref (lower-ref-prepare! target)
        function (lower-ref-get! ref)]
    (n-keep! function)
    (let [answer
            (lower-value-call-with-receiver function
                                            (parser-node (.receiver-nid ref))
                                            (dyn-undefined-make)
                                            args
                                            (lower-callee-message label
                                                                  " is not a function"))]
      (n-unkeep! function)
      (lower-ref-release! ref)
      answer)))

;; The function object being called, from the hidden slot its entry filled.
(defn lower-hidden-callee [(fi i64) (fun (dyn NodeOps))] (-> (dyn NodeOps))
  (match (fun-parm fun (+ (syntax-fun-callee-slot fi) 2))
    (Some [c] c)
    (None []
          (do
            (broken "lower-hidden-callee: the callee slot has no Parm")
            (unreachable-node)))))

;; An argument list as an array, for the calls that take any number of them (`super`).
(defn lower-arguments-array [(args (ArrayList i64))] (-> (dyn NodeOps))
  (let [(mut elements) (al-new [ArrayElement] (compiler-allocator))]
    ;; A spread argument contributes every value of its iterable, in place (§13.3.8.1).
    (al-for [a args]
            (match (syntax-node (syntax-ungroup-id a))
              (SxSpread [expr]
                        (push! [ArrayElement] (mut elements) (ElemSpread expr)))
              (_ (push! [ArrayElement] (mut elements) (ElemExpr a)))))
    (let [array (lower-array-literal (load elements))]
      (al-free! [ArrayElement] (mut elements))
      array)))

;; Whether an argument list contains a spread, which makes its length a runtime question and the
;; call one over an argument array (`JsCallWithArray`) rather than the fixed slots.
(defn syntax-args-have-spread? [(args (ArrayList i64))] (-> bool)
  (let [(mut found) false]
    (al-for [a args]
            (match (syntax-node (syntax-ungroup-id a))
              (SxSpread [expr] (set! (mut found) true))
              (_ 0)))
    (load found)))

;; The key of a named member call, as a value: the receiver is evaluated once and is both the
;; property's base and the call's `this`.
(defn lower-member-key [(name (slice u8))] (-> (dyn NodeOps))
  (keyref-make (shape-key-intern name)))

;; `o.m(...xs)`: the owner is evaluated once, the method read from it, and the call takes the
;; argument array with the owner as its receiver.
(defn lower-spread-member-call [(owner-id i64)
                                (key (dyn NodeOps))
                                (args (ArrayList i64))] (-> (dyn NodeOps))
  (let [owner (lower-syntax-expr owner-id)]
    (n-keep! owner)
    (n-keep! key)
    (let [method
            (lower-completion! (lower-jsl-values2 (if (= (n-op key) OP-KEYREF)
                                                      "JsGetNamed"
                                                      "JsGetKeyed")
                                                  owner
                                                  key))]
      (n-unkeep! key)
      (let [answer (lower-spread-call method owner args)]
        (n-unkeep! owner)
        answer))))

;; `f(...xs)` and `o.m(...xs)`: the arguments become one array and the call takes it, which is the
;; same path a bound function's call already used.
(defn lower-spread-call [(callee (dyn NodeOps))
                         (receiver (dyn NodeOps))
                         (args (ArrayList i64))] (-> (dyn NodeOps))
  (n-keep! callee)
  (n-keep! receiver)
  (let [array (lower-arguments-array args)
        answer
          (lower-completion! (lower-jsl-values4 "JsCallWithArray"
                                                callee
                                                receiver
                                                (dyn-undefined-make)
                                                array))]
    (n-unkeep! receiver)
    (n-unkeep! callee)
    answer))

(defn lower-jsl-values4 [(name (slice u8))
                         (a (dyn NodeOps))
                         (b (dyn NodeOps))
                         (c (dyn NodeOps))
                         (d (dyn NodeOps))] (-> (dyn NodeOps))
  (let [(mut values) (al-new [(dyn NodeOps)] (compiler-allocator))]
    (push! [(dyn NodeOps)] (mut values) a)
    (push! [(dyn NodeOps)] (mut values) b)
    (push! [(dyn NodeOps)] (mut values) c)
    (push! [(dyn NodeOps)] (mut values) d)
    (let [v (lower-jsl-values name (load values))]
      (al-free! [(dyn NodeOps)] (mut values))
      v)))

;; A constructor's returned value (§10.2.2 step 13): an object wins; a base constructor otherwise
;; answers its `this`, and a derived one requires `super()` to have run and refuses a primitive.
(defn lower-constructor-return [(value (dyn NodeOps))] (-> (dyn NodeOps))
  (let [p (parser-state)
        fi (.current-fun p)]
    (if (not (.class-ctor (syntax-fun-ptr fi)))
        value
        (if (.derived-ctor (syntax-fun-ptr fi))
            (lower-completion! (lower-jsl-values2 "JsConstructorResult"
                                                  value
                                                  (lower-derived-this-value fi)))
            (lower-jsl-values2 "JsBaseConstructorResult"
                               value
                               (lower-receiver-parm fi))))))

(defn lower-receiver-parm [(fi i64)] (-> (dyn NodeOps))
  (match (fun-parm (parser-node (.fun-nid (syntax-fun-ptr fi))) 0)
    (Some [r] r)
    (None []
          (do
            (broken "lower-receiver-parm: no receiver Parm")
            (unreachable-node)))))

;; The default derived constructor's body: `super(...args)` over the call's own actuals, which its
;; entry passed in the hidden slot.
(defn lower-default-derived-body! [(fi i64) (fun (dyn NodeOps))] (-> i64)
  (let [array (lower-hidden-slot-parm fi fun)
        callee (lower-hidden-callee fi fun)
        new-target
          (match (fun-parm fun 1) (Some [t] t) (None [] (unreachable-node)))
        constructed
          (lower-completion! (lower-jsl-values3 "JsSuperConstruct"
                                                callee
                                                new-target
                                                array))]
    (n-keep! constructed)
    (let [bound
            (lower-completion! (lower-jsl-values2 "JsRequireThisUninitialized"
                                                  (lower-derived-this-value fi)
                                                  constructed))]
      (n-unkeep! constructed)
      (scope-update! (parser-node (.current-scope (parser-state)))
                     DERIVED-THIS-SLOT
                     bound)
      (lower-instance-fields! fi bound)
      0)))
