;; The type lattice.

;;
;; Types form a symmetric complete bounded lattice, interned so that identity is equality. A `Ty`
;; is a dense `i64` index into the intern table — small, hashable, printable, serialisable, and
;; usable as a bitset offset, which is what every worklist and golden test wants.
;;
;; The payload is a `defsum`, deliberately: forgetting a kind in `meet` is a silent miscompile, and
;; an exhaustive `match` turns that class of mistake into a compile error. Variable-arity children
;; (tuple members, struct fields, shape field lists) live in a side array addressed by
;; `(offset,len)`, which keeps the sum small and non-recursive.
;;
;; The lattice is dual-symmetric: `dual` flips high and low, `join(a,b) = dual(meet(dual a, dual b))`,
;; and `isa(a,b)` is `meet(a,b) == B` — see `ty-isa?` for why that direction and not the other.
;; Getting `dual` wrong breaks the optimistic analysis in ways the pessimistic one cannot see, so
;; `dual(dual(t)) == t` is a tested identity.
(module aot.type.type)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "aot.util.panic" :use *)
(import "aot.type.scalar" :use * :reexport)
(import "aot.type.fun" :use * :reexport)
(import "aot.type.dyn" :use * :reexport)
(import "aot.type.mem" :use * :reexport)
(import "aot.type.text" :use * :reexport)

;; ---------------------------------------------------------------------------
;; The kinds
;;
;; Ordered so that the "simple" kinds — those with no children and no payload — come first.
(defsum TyKind
  ;; --- simple: no payload, no children ---
  (TBot)  ; ALL — the bottom of the lattice; "any value at all"
  (TTop)  ; ANY — the top; the ABSENCE of information, not a claim
  (TCtrl)  ; reachable control
  (TXCtrl)  ; unreachable control (the high element of the control axis)
  (TNil)  ; low null, all flavours
  (TXNil)  ; high/choice null
  ;; --- scalars ---
  (TInt [(lo i64) (hi i64) (widen i64)])  ; inclusive range plus Simple's -3..3 widen stage
  (TFlt [(sz i64) (bits i64)])  ; -64/-32 high, 0 CONSTANT (IEEE-754 bits), 32/64 low
  ;; --- pointers ---
  ;; Nullability is a four-point set lattice: 0 none/high, 1 nil-only, 2 non-null-only, 3 either.
  (TPtr [(nilstate i64) (to i64)])
  (TMemPtr [(nilstate i64) (strct i64) (identity i64)])
  (TFunPtr [(sig i64) (fidx i64) (high bool) (external bool)])  ; known identities plus an opaque ABI-compatible target class
  ;; --- memory and aggregates ---
  ;; `one`: a private slice — its element type describes exactly the object of its last store, not
  ;; the alias in general (Simple's TypeMem._one). Public readers must not trust it.
  (TMem [(alias i64) (elem i64) (one bool)])
  (TStruct [(nameoff i64) (namelen i64) (fldoff i64) (fldlen i64)])
  (TTuple [(off i64) (len i64)])
  (TRpc [(off i64) (len i64)])
  ;; --- beyond Simple: the dynamic axis, shapes, strings ---
  (TDyn [(tags i64) (high bool) (int i64) (identity i64)])
  (TIdentity [(members i64) (complement bool)])
  (TShape [(shapes i64)])  ; a shape-set id — see aot.shape
  (TStr [(conoff i64) (conlen i64)]))

;; Well-known interned ids. Assigned by `ty-boot!` in exactly this order, so they are constants and
;; every printed graph and golden hash agrees across runs.
(const TY-INVALID 0)  ; never a real type; a header `ty` of 0 means "never computed"

(const TY-BOT 1)

(const TY-TOP 2)

(const TY-CTRL 3)

(const TY-XCTRL 4)

(const TY-NIL 5)

(const TY-XNIL 6)

;; ---------------------------------------------------------------------------
;; The intern table
;;
;; One global table per process. `kinds` is indexed by `Ty`; `kids` is the shared side array;
;; `index` maps a structural hash to the head of a chain, and `chain` is the parallel next-link.
(defstruct TyTable
  [(kinds (ArrayList TyKind))
   (kids (ArrayList i64))
   (bytes (ArrayList u8))  ; structural names and string constants
   ;; Canonical, unbounded function-index sets.  A TFunPtr stores an id into these arrays rather
   ;; than a machine-word bitset, so function 64 cannot alias function 0.
   (fidx-offs (ArrayList i64))
   (fidx-lens (ArrayList i64))
   (fidx-members (ArrayList i64))
   (chain (ArrayList i64))
   (index (HashMap i64 i64))
   (booted bool)])

(defn ty-table [] (-> (ptr TyTable))
  (compiler-state [TyTable] (primitive/alloc-static CompilerStateSlot)))

(defn ty-boot! [] (-> i64)
  (let [t (ty-table)]
    (if (.booted t)
        0
        (let [a (compiler-allocator)]
          (set! (.kinds t) (al-new [TyKind] a))
          (set! (.kids t) (al-new [i64] a))
          (set! (.bytes t) (al-new [u8] a))
          (set! (.fidx-offs t) (al-new [i64] a))
          (set! (.fidx-lens t) (al-new [i64] a))
          (set! (.fidx-members t) (al-new [i64] a))
          (set! (.chain t) (al-new [i64] a))
          (set! (.index t) (hm-new [i64 i64] a (i64-keyops)))
          (set! (.booted t) true)
          ;; Slot 0 is TY-INVALID and is never handed out.
          (push! (field t kinds) (TBot))
          (push! (field t chain) 0)
          ;; Set id zero is the empty set.
          (push! [i64] (mut (.fidx-offs t)) 0)
          (push! [i64] (mut (.fidx-lens t)) 0)
          ;; The simple types, in the order their constants declare.
          (ty-intern (TBot))
          (ty-intern (TTop))
          (ty-intern (TCtrl))
          (ty-intern (TXCtrl))
          (ty-intern (TNil))
          (ty-intern (TXNil))
          0))))

(defn ty-kind [(t i64)] (-> TyKind)
  (do
    (ty-boot!)
    (if (or (<= t 0) (>= t (len (.kinds (ty-table)))))
        (do (panic-i "ty-kind: type id out of range" t) (TBot))
        (get (.kinds (ty-table)) t))))

(defn ty-count [] (-> i64)
  (do (ty-boot!) (len (.kinds (ty-table)))))

;; ---------------------------------------------------------------------------
;; Structural hash and equality — what interning is built on
(defn bytes--hash [(off i64) (ln i64)] (-> i64)
  (let [(mut h) (+ 0x811c9dc5 ln)
        (mut i) 0]
    (loop (if (>= (load i) ln)
              (break 0)
              (do
                (set! (mut h)
                      (* (^ (load h)
                            (primitive/cast i64
                                            (get (.bytes (ty-table))
                                                 (+ off (load i)))))
                         0x01000193))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load h)))

(defn bytes--eq? [(ao i64) (an i64) (bo i64) (bn i64)] (-> bool)
  (if (!= an bn)
      false
      (let [(mut i) 0
            (mut same) true]
        (loop (if (or (>= (load i) an) (not (load same)))
                  (break 0)
                  (do
                    (if (!= (get (.bytes (ty-table)) (+ ao (load i)))
                            (get (.bytes (ty-table)) (+ bo (load i))))
                        (set! (mut same) false)
                        0)
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (load same))))

(defn bytes--slice-eq? [(off i64) (ln i64) (s (slice u8))] (-> bool)
  (if (!= ln (len s))
      false
      (let [(mut i) 0
            (mut same) true]
        (loop (if (or (>= (load i) ln) (not (load same)))
                  (break 0)
                  (do
                    (if (!= (get (.bytes (ty-table)) (+ off (load i)))
                            (get s (load i)))
                        (set! (mut same) false)
                        0)
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (load same))))

(defn kids--hash [(off i64) (ln i64)] (-> i64)
  (let [(mut h) (+ (* ln 191) 0x9e3779b9)
        (mut i) 0]
    (loop (if (>= (load i) ln)
              (break 0)
              (do
                (set! (mut h)
                      (^ (* (load h) 31)
                         (get (.kids (ty-table)) (+ off (load i)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load h)))

(defn kids--eq? [(ao i64) (an i64) (bo i64) (bn i64)] (-> bool)
  (if (!= an bn)
      false
      (let [(mut i) 0
            (mut same) true]
        (loop (if (or (>= (load i) an) (not (load same)))
                  (break 0)
                  (do
                    (if (!= (get (.kids (ty-table)) (+ ao (load i)))
                            (get (.kids (ty-table)) (+ bo (load i))))
                        (set! (mut same) false)
                        0)
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (load same))))

(defn ty-hash [(k TyKind)] (-> i64)
  (match k
    (TBot [] 0x100)
    (TTop [] 0x101)
    (TCtrl [] 0x102)
    (TXCtrl [] 0x103)
    (TNil [] 0x104)
    (TXNil [] 0x105)
    (TInt [lo hi widen] (^ (^ (* lo 1000003) (* hi 31)) (* widen 37)))
    (TFlt [sz bits] (^ (* sz 7919) bits))
    (TPtr [nilstate to] (^ (* nilstate 17) (* to 131)))
    (TMemPtr [nilstate strct identity]
             (^ (^ (* nilstate 23) (* strct 137)) (* identity 1013)))
    (TFunPtr [sig fidx high external]
             (^ (^ (^ (* sig 139) (* fidx 149)) (if high 151 157))
                (if external 163 167)))
    (TMem [alias elem one] (^ (^ (* alias 151) (* elem 157)) (if one 5 0)))
    (TStruct [no nl fo fl] (^ (bytes--hash no nl) (kids--hash fo fl)))
    (TTuple [off ln] (tuple--hash off ln))
    (TRpc [off len] (kids--hash off len))
    (TDyn [tags high int identity]
          (^ (^ (^ (* tags 199) (if high 7 11)) (* int 1009)) (* identity 1013)))
    (TIdentity [members complement]
               (^ (* members 1019) (if complement 1021 1031)))
    (TShape [shapes] (* shapes 211))
    (TStr [co cl] (bytes--hash co cl))))

(defn ty-kind-eq? [(a TyKind) (b TyKind)] (-> bool)
  (match a
    (TBot [] (match b (TBot [] true) (_ false)))
    (TTop [] (match b (TTop [] true) (_ false)))
    (TCtrl [] (match b (TCtrl [] true) (_ false)))
    (TXCtrl [] (match b (TXCtrl [] true) (_ false)))
    (TNil [] (match b (TNil [] true) (_ false)))
    (TXNil [] (match b (TXNil [] true) (_ false)))
    (TInt [lo hi widen]
          (match b
            (TInt [l2 h2 w2] (and (and (= lo l2) (= hi h2)) (= widen w2)))
            (_ false)))
    ;; Float constants are identities of their IEEE-754 encodings, not numeric equality.  This
    ;; keeps +0 and -0 distinct and makes a repeated same-payload NaN intern normally.
    (TFlt [sz bits]
          (match b (TFlt [s2 b2] (and (= sz s2) (= bits b2))) (_ false)))
    (TPtr [ns to] (match b (TPtr [n2 t2] (and (= ns n2) (= to t2))) (_ false)))
    (TMemPtr [ns s identity]
             (match b
               (TMemPtr [n2 s2 id2] (and (= ns n2) (= s s2) (= identity id2)))
               (_ false)))
    (TFunPtr [sg fx hi ex]
             (match b
               (TFunPtr [g2 x2 h2 e2]
                        (and (and (= sg g2) (= fx x2)) (= hi h2) (= ex e2)))
               (_ false)))
    (TMem [al el o1]
          (match b
            (TMem [a2 e2 o2] (and (= al a2) (= el e2) (= o1 o2)))
            (_ false)))
    (TStruct [no nl fo fl]
             (match b
               (TStruct [a2 b2 c2 d2]
                        (and (bytes--eq? no nl a2 b2) (kids--eq? fo fl c2 d2)))
               (_ false)))
    (TTuple [o l] (match b (TTuple [o2 l2] (tuple--eq? o l o2 l2)) (_ false)))
    (TRpc [o l] (match b (TRpc [o2 l2] (kids--eq? o l o2 l2)) (_ false)))
    (TDyn [tg th ti identity]
          (match b
            (TDyn [g2 h2 i2 id2]
                  (and (= tg g2) (= th h2) (= ti i2) (= identity id2)))
            (_ false)))
    (TIdentity [members complement]
               (match b
                 (TIdentity [m2 c2] (and (= members m2) (= complement c2)))
                 (_ false)))
    (TShape [sh] (match b (TShape [h2] (= sh h2)) (_ false)))
    (TStr [co cl] (match b (TStr [o2 l2] (bytes--eq? co cl o2 l2)) (_ false)))))

;; Intern `k`, returning its `Ty`. Identity is equality from here on.
(defn ty-intern [(k TyKind)] (-> i64)
  (let [t (ty-table)
        h (ty-hash k)
        (mut cur)
          (match (get (.index t) h)
            (Some [v] v)
            (None [] 0))]
    (loop (if (= (load cur) 0)
              (break 0)
              (if (ty-kind-eq? (get (.kinds t) (load cur)) k)
                  (break 0)
                  (do
                    (set! (mut cur) (get (.chain t) (load cur)))
                    (continue)))))
    (if (!= (load cur) 0)
        (load cur)
        (let [id (len (.kinds t))
              head
                (match (get (.index t) h)
                  (Some [v] v)
                  (None [] 0))]
          (push! (field t kinds) k)
          (push! (field t chain) head)
          (set! (field t index) h id)
          id))))

;; ---------------------------------------------------------------------------
;; Predicates
(defn ty-simple? [(t i64)] (-> bool)
  (match (ty-kind t)
    (TBot [] true)
    (TTop [] true)
    (TCtrl [] true)
    (TXCtrl [] true)
    (TNil [] true)
    (TXNil [] true)
    (_ false)))

;; High = at or above the lattice centreline.
;;
;; NOTE, and it is the whole of the proven-type rule: `TTop` is the ABSENCE of information, while
;; every other high type is a CLAIM someone computed. `ty-high?` answers a question about the
;; lattice, NOT the question "may a rewrite act on this". That second question is `ty-proven?`.
(defn ty-high? [(t i64)] (-> bool)
  (match (ty-kind t)
    (TTop [] true)
    (TXCtrl [] true)
    (TXNil [] true)
    ;; A HIGH integer is a range with its bounds REVERSED — Simple's `TypeInteger.isHigh()` is
    ;; literally `_min > _max`. `ty-dual` produces exactly that by swapping them, and it is the only
    ;; thing that may: `ty-int-range` refuses lo > hi, so a reversed range can only have come from a
    ;; dual. It reads as "the empty set of integers", which is the high end of the integer axis.
    ;;
    ;; Missing this case makes `ty-high?` answer a per-axis question with a single-axis test, and
    ;; every `compute` that guards on it silently treats an unanalysed integer as a known one.
    (TInt [lo hi widen] (> lo hi))
    ;; A dynamic type is high exactly when its flag says so.
    (TDyn [tags high int identity] high)
    (TIdentity [members complement] (and (= members 0) (not complement)))
    (TFunPtr [sig fidx high external] high)
    (TPtr [nilstate to] (and (< nilstate 2) (ty-high? to)))
    (TMemPtr [nilstate strct identity] (and (< nilstate 2) (ty-high? strct)))
    (TMem [alias elem one] (ty-high? elem))
    ;; Likewise a high float: `ty-dual` negates the width tag.
    (TFlt [sz bits] (< sz 0))
    (_ false)))

(defn ty-constant? [(t i64)] (-> bool)
  (match (ty-kind t)
    (TInt [lo hi widen] (= lo hi))
    (TFlt [sz bits] (= sz 0))
    (TNil [] true)
    ;; Simple canonicalizes null through TypeNil. Our pointer families retain their referent
    ;; beside the four-state null bitset: state 1 contains only the zero pointer. It is a real
    ;; machine constant, unlike nullable state 3 and non-null state 2.
    (TPtr [nilstate to] (= nilstate 1))
    (TMemPtr [nilstate strct identity] (= nilstate 1))
    ;; A low singleton undefined or null tag denotes the language's one undefined or one null
    ;; value, and the exception tag its one sentinel word. Other dynamic singleton tags (bool, int,
    ;; double, string, object...) still contain several distinct payloads.
    (TDyn [tags high int identity]
          (and (not high)
               (or (= tags TAG-UNDEFINED)
                   (= tags TAG-NULL)
                   (= tags TAG-EXCEPTION))))
    (_ false)))

(defn ty-high-or-const? [(t i64)] (-> bool)
  (or (ty-high? t) (ty-constant? t)))

;; ---------------------------------------------------------------------------
;; dual / meet / join / isa
(defn ty-dual [(t i64)] (-> i64)
  (match (ty-kind t)
    (TBot [] TY-TOP)
    (TTop [] TY-BOT)
    (TCtrl [] TY-XCTRL)
    (TXCtrl [] TY-CTRL)
    (TNil [] TY-XNIL)
    (TXNil [] TY-NIL)
    ;; An integer range duals by swapping its bounds: [lo..hi] is the low interval, [hi..lo] the
    ;; high "choice" one. Simple encodes both with the same struct and a reversed test.
    (TInt [lo hi widen]
          (if (= lo hi)
              t
              (ty-intern (TInt
                           :lo hi
                           :hi lo
                           :widen (- 0 widen)))))
    ;; A float duals the same way. `sz` 0 means "not a constant" and is its own dual at the
    ;; per-width bottom; a constant float duals to the matching high constant, which we encode by
    ;; negating the width tag rather than adding a second field.
    ;; A CONSTANT float is SELF-DUAL — it sits on the centreline. Everything else flips its width
    ;; sign, which is exactly Simple's `_isConstant() ? this : new TypeFloat(-_sz, 0)`.
    (TFlt [sz bits]
          (if (= sz 0) (ty-intern (TFlt 0 bits)) (ty-intern (TFlt (- 0 sz) 0))))
    ;; The dynamic axis duals by flipping the high/low flag and KEEPING the set. That is why the flag
    ;; exists: a pure set with complement-duality has no centreline, so nothing could be `high`.
    ;; The integer component duals with it, through the integer lattice's own dual.
    (TDyn [tags high int identity]
          (ty-dyn-state tags (not high) (ty-dual int) (ty-dual identity)))
    (TIdentity [members complement]
               (ty-intern (TIdentity members (not complement))))
    (TFunPtr [sig fidx high external]
             (ty-intern (TFunPtr
                          :sig (ty-dual sig)
                          :fidx fidx
                          :high (not high)
                          :external external)))
    ;; Pointer nullability is an independent two-point axis; the referent duals recursively.
    (TPtr [nilstate to] (ty-ptr-state (^ nilstate 3) (ty-dual to)))
    (TMemPtr [nilstate strct identity]
             (ty-memptr-identity-state (^ nilstate 3)
                                       (ty-dual strct)
                                       (ty-dual identity)))
    ;; A memory slice keeps its alias identity across duality and duals its contents.
    ;; The private flag is the memory lattice's own high/low side: TOP memory is private TOP,
    ;; BOT memory is public BOT, and the dual flips it with the element.
    (TMem [alias elem one] (ty-mem-state alias (ty-dual elem) (not one)))
    ;; Named JS object layouts are nominal centreline identities. Structural field facts live in
    ;; shapes, so there is no hidden open/closed coordinate here to invent.
    (TStruct [nameoff namelen fldoff fldlen] t)
    ;; A tuple duals MEMBERWISE. `dual(IF_TRUE)` is therefore `(~ctrl, ctrl)`, which is `IF_FALSE` —
    ;; and that symmetry is what makes `join` on If outcomes mean the right thing.
    (TTuple [off ln]
            (let [a (compiler-allocator)
                  (mut members) (al-new [i64] a)
                  (mut i) 0]
              (loop (if (>= (load i) ln)
                        (break 0)
                        (do
                          (push! [i64]
                                 (mut members)
                                 (ty-dual (ty-tuple-at t (load i))))
                          (set! (mut i) (+ (load i) 1))
                          (continue))))
              (let [answer (ty-tuple (al-slice (load members)))]
                (al-free! [i64] (mut members))
                answer)))
    (TRpc [off ln]
          (let [a (compiler-allocator)
                (mut members) (al-new [i64] a)
                (mut i) 0]
            (loop (if (>= (load i) ln)
                      (break 0)
                      (do
                        (push! [i64]
                               (mut members)
                               (ty-dual (get (.kids (ty-table))
                                             (+ off (load i)))))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))
            (let [answer (ty-rpc (al-slice (load members)))]
              (al-free! [i64] (mut members))
              answer)))
    (_ (do
         (unimplemented "ty-dual for this kind"
                        "docs/LAYOUT.md — src/type/, S1")
         TY-BOT))))

;; The lattice meet. Commutative, associative, idempotent and monotone — every one of which is a
;; tested property, because a `meet` that is merely "mostly right" produces a compiler that is
;; mostly right.
(defn ty-meet [(a i64) (b i64)] (-> i64)
  (cond (= a b) a
        (= a TY-BOT) TY-BOT
        (= b TY-BOT) TY-BOT
        (= a TY-TOP) b
        (= b TY-TOP) a
        :else (ty-meet-hard a b)))

(defn ty-meet-hard [(a i64) (b i64)] (-> i64)
  (match (ty-kind a)
    ;; Control is its own mini-lattice: any - ~ctrl - ctrl - all.
    (TCtrl [] (match (ty-kind b) (TXCtrl [] TY-CTRL) (_ TY-BOT)))
    (TXCtrl [] (match (ty-kind b) (TCtrl [] TY-CTRL) (_ TY-BOT)))
    ;; Integer ranges meet by widening to the union interval.
    (TInt [alo ahi awiden]
          (match (ty-kind b)
            (TInt [blo bhi bwiden]
                  ;; Unlike the public range constructor, meet must also construct the reversed
                  ;; HIGH intervals produced by dual. Simple's `TypeInteger.make` accepts both;
                  ;; rejecting the high result here breaks every nontrivial integer join.
                  (let [lo (if (< alo blo) alo blo)
                        hi (if (> ahi bhi) ahi bhi)
                        widen (if (> awiden bwiden) awiden bwiden)]
                    (ty-intern (TInt
                                 :lo lo
                                 :hi hi
                                 :widen (if (= lo hi) 0 widen)))))
            ;; An int and a float have no common refinement short of BOT. In JavaScript both are
            ;; `number`, but that unification belongs on the DYNAMIC axis (src/type/dyn.coil), not
            ;; here: these two are raw machine representations, and merging them silently would let
            ;; an unboxed int flow where a double is expected.
            (_ TY-BOT)))
    ;; Simple's TypeFloat.xmeet orders the five points by width/highness, with a special test for
    ;; whether a constant is exactly representable as f32.  Identity was already rejected by the
    ;; caller, so equal-bit constants never enter this path.
    (TFlt [asz abits]
          (match (ty-kind b)
            (TFlt [bsz bbits]
                  (let [i0sz (if (< asz bsz) asz bsz)
                        i0bits (if (< asz bsz) abits bbits)
                        i1sz (if (< asz bsz) bsz asz)
                        i1bits (if (< asz bsz) bbits abits)]
                    (cond (= i1sz 64) (ty-intern (TFlt 64 0))
                          (= i0sz -64) (ty-intern (TFlt i1sz i1bits))
                          (= i1sz 32)
                            (if (and (= i0sz 0)
                                     (not (flt--bits-f32? i0bits)))
                                (ty-intern (TFlt 64 0))
                                (ty-intern (TFlt 32 0)))
                          (!= i1sz 0) (ty-intern (TFlt i1sz i1bits))
                          (= i0sz -32)
                            (if (flt--bits-f32? i1bits)
                                (ty-intern (TFlt 0 i1bits))
                                (ty-intern (TFlt 64 0)))
                          ;; Both are unequal constants.
                          (and (flt--bits-f32? i0bits)
                               (flt--bits-f32? i1bits))
                            (ty-intern (TFlt 32 0))
                          :else (ty-intern (TFlt 64 0)))))
            (_ TY-BOT)))
    ;; Nil meets its own dual back to nil, exactly as control does.
    (TNil [] (match (ty-kind b) (TXNil [] TY-NIL) (_ TY-BOT)))
    (TXNil [] (match (ty-kind b) (TNil [] TY-NIL) (_ TY-BOT)))
    ;; The dynamic axis is a complemented finite-set lattice. A HIGH set stores the bits whose
    ;; complement it denotes, so the mixed meet is set difference, not a low union.
    ;; The integer component meets through the integer lattice alongside the set, and
    ;; `ty-dyn-make` restores its canonical form for the resulting set.
    (TDyn [atags ahigh aint aid]
          (match (ty-kind b)
            (TDyn [btags bhigh bint bid]
                  (if (= ahigh bhigh)
                      (if ahigh
                          ;; complement(A) union complement(B) = complement(A intersect B)
                          (ty-dyn-state (primitive/iand atags btags)
                                        true
                                        (ty-meet aint bint)
                                        (ty-meet aid bid))
                          (ty-dyn-state (primitive/ior atags btags)
                                        false
                                        (ty-meet aint bint)
                                        (ty-meet aid bid)))
                      ;; A high set and a low one denote complement(A) and B, so their meet denotes
                      ;; complement(A) union B — and it is a LOW set, because a meet with anything
                      ;; below the centreline lands below it. Representing the same denotation high
                      ;; would leave the meet above one of its own arguments, and `ty-isa?`, which
                      ;; asks whether the meet is that argument, would then answer no for a value
                      ;; that is the whole set.
                      (if ahigh
                          (ty-dyn-state (primitive/ior (primitive/ixor TAG-COMPLETION
                                                                       atags)
                                                       btags)
                                        false
                                        (ty-meet aint bint)
                                        (ty-meet aid bid))
                          (ty-dyn-state (primitive/ior (primitive/ixor TAG-COMPLETION
                                                                       btags)
                                                       atags)
                                        false
                                        (ty-meet aint bint)
                                        (ty-meet aid bid)))))
            (_ TY-BOT)))
    (TIdentity [am ac]
               (match (ty-kind b)
                 (TIdentity [bm bc]
                            (ty-intern (TIdentity (if (= ac bc)
                                                      (if ac
                                                          (fidx-set-intersection am
                                                                                 bm)
                                                          (fidx-set-union am bm))
                                                      (if ac
                                                          (fidx-set-difference am
                                                                               bm)
                                                          (fidx-set-difference bm
                                                                               am)))
                                                  (or ac bc))))
                 (_ TY-BOT)))
    ;; Function pointers mirror the dynamic set axis, but also meet their complete signatures.
    (TFunPtr [asig afidx ahigh aexternal]
             (match (ty-kind b)
               (TFunPtr [bsig bfidx bhigh bexternal]
                        (ty-intern (TFunPtr
                                     :sig (ty-meet asig bsig)
                                     :fidx
                                       (if (= ahigh bhigh)
                                           (if ahigh
                                               (fidx-set-intersection afidx
                                                                      bfidx)
                                               (fidx-set-union afidx bfidx))
                                           (if ahigh
                                               (fidx-set-difference afidx bfidx)
                                               (fidx-set-difference bfidx afidx)))
                                     :high (or ahigh bhigh)
                                     :external
                                       (if (= ahigh bhigh)
                                           (if ahigh
                                               (and aexternal bexternal)
                                               (or aexternal bexternal))
                                           (if ahigh
                                               (and aexternal (not bexternal))
                                               (and bexternal (not aexternal)))))))
               (_ TY-BOT)))
    (TPtr [anil ato]
          (match (ty-kind b)
            (TPtr [bnil bto]
                  (ty-ptr-state (primitive/ior anil bnil) (ty-meet ato bto)))
            (_ TY-BOT)))
    (TMemPtr [anil astrct aid]
             (match (ty-kind b)
               (TMemPtr [bnil bstrct bid]
                        (ty-memptr-identity-state (primitive/ior anil bnil)
                                                  (ty-meet astrct bstrct)
                                                  (ty-meet aid bid)))
               (_ TY-BOT)))
    ;; Alias 1 is bulk memory. A high bulk slice is the neutral element for a precise alias;
    ;; otherwise unequal aliases collapse to bulk, exactly as Simple's TypeMem.xmeet.
    (TMem [aalias aelem aone]
          (match (ty-kind b)
            (TMem [balias belem bone]
                  (let [alias
                          (cond (= aalias balias) aalias
                                (and (= aalias 1) (ty-high? aelem)) balias
                                (and (= balias 1) (ty-high? belem)) aalias
                                :else 1)]
                    ;; Two private slices of one object stay private; anything else is public.
                    (ty-mem-state alias (ty-meet aelem belem) (and aone bone))))
            (_ TY-BOT)))
    (TStruct [an al afo afl]
             (match (ty-kind b)
               (TStruct [bn bl bfo bfl]
                        (if (and (bytes--eq? an al bn bl)
                                 (kids--eq? afo afl bfo bfl))
                            a
                            TY-BOT))
               (_ TY-BOT)))
    ;; Two tuples meet MEMBERWISE, and only when their arities agree. Different arities have no
    ;; common refinement — a two-member If outcome and a three-member Start outcome are not
    ;; comparable, and pretending otherwise would let a Proj read a member that does not exist.
    (TTuple [aoff aln]
            (match (ty-kind b)
              (TTuple [boff bln]
                      (if (!= aln bln)
                          TY-BOT
                          (let [alc (compiler-allocator)
                                (mut members) (al-new [i64] alc)
                                (mut i) 0]
                            (loop (if (>= (load i) aln)
                                      (break 0)
                                      (do
                                        (push! [i64]
                                               (mut members)
                                               (ty-meet (ty-tuple-at a (load i))
                                                        (ty-tuple-at b (load i))))
                                        (set! (mut i) (+ (load i) 1))
                                        (continue))))
                            (let [answer (ty-tuple (al-slice (load members)))]
                              (al-free! [i64] (mut members))
                              answer))))
              (_ TY-BOT)))
    (TRpc [aoff aln]
          (match (ty-kind b)
            (TRpc [boff bln]
                  (if (!= aln bln)
                      TY-BOT
                      (let [alc (compiler-allocator)
                            (mut members) (al-new [i64] alc)
                            (mut i) 0]
                        (loop (if (>= (load i) aln)
                                  (break 0)
                                  (do
                                    (push! [i64]
                                           (mut members)
                                           (ty-meet (get (.kids (ty-table))
                                                         (+ aoff (load i)))
                                                    (get (.kids (ty-table))
                                                         (+ boff (load i)))))
                                    (set! (mut i) (+ (load i) 1))
                                    (continue))))
                        (let [answer (ty-rpc (al-slice (load members)))]
                          (al-free! [i64] (mut members))
                          answer))))
            (_ TY-BOT)))
    (_ (do
         (unimplemented "ty-meet for this kind pair"
                        "docs/LAYOUT.md — src/type/, S1")
         TY-BOT))))

(defn ty-join [(a i64) (b i64)] (-> i64)
  (ty-dual (ty-meet (ty-dual a) (ty-dual b))))

;; `a isa b` — a is at least as specific as b; every value a admits, b admits too.
;;
;; The direction is `meet(a,b) == B`, not `== a`. Meet moves DOWN toward BOT (more values), so the
;; meet of a specific type with a general one is the GENERAL one, and that is what identifies b as
;; the upper bound. Writing `== a` inverts the whole relation, which reads plausibly and makes
;; every `Cast` discharge itself: `ty-isa? ANY t` would be true for every t.
(defn ty-isa? [(a i64) (b i64)] (-> bool)
  (= (ty-meet a b) b))
