;; The dynamic value axis: tag sets, the dynamic integer range, identity, shape sets and the JS string type.

(module aot.type.dyn)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "aot.util.panic" :use *)
(import "aot.type.type"
        :use
        [TTop
         TMemPtr
         TDyn
         TIdentity
         TY-BOT
         ty-table
         ty-boot!
         ty-kind
         ty-intern
         ty-high?
         ty-dual])
(import "aot.type.scalar" :use *)
(import "aot.type.fun" :use *)
(import "aot.type.mem" :use *)

;; ---------------------------------------------------------------------------
;; THE DYNAMIC AXIS
;;
;; Simple has no equivalent — this is the axis that makes the lattice describe JavaScript rather
;; than C, and its design is ours.
;;
;; A dynamic value's type is a SET OF TAGS: undefined, null, bool, int, double, string, symbol,
;; object, function. Held as a bitset, with a HIGH/LOW flag:
;;
;;   LOW  S  "the value is one of S"       — a claim someone computed. Bigger S is LOWER.
;;   HIGH S  its mirror                     — the optimistic form the dual produces.
;;
;; The flag is why the axis needs one at all: a pure set with complement-duality has no centreline,
;; so nothing could answer `ty-high?`, and the optimistic pass would have nowhere to start.
;;
;; ## meet
;;
;;   low A  meet low B   = low (A ∪ B)      more possibilities is more general
;;   high A meet high B  = high (A ∩ B)     empty canonicalizes to low(ALL)
;;   low A meet high B  = high (B − A)     because high B denotes complement(B)
;;   high A meet low B  = high (A − B)
;;
;; ## What this buys
;;
;; A SINGLETON low set is a proven representation, so the value unboxes. Two tags is a guard with two
;; arms. The full set is the generic path. A TypeScript annotation lands here: `number` is
;; int-or-double, `string` is the string tag, and whether the guard folds is decided by the
;; interprocedural fixpoint agreeing with it — never by the annotation alone.

;; ## The integer component
;;
;; A dynamic type also carries `int`, an integer type describing the payload of its `int` member
;; (docs/DECISIONS.md, "A dynamic integer carries its range"). `Box(2)` is `dyn{int:2}`.
;;
;; The dynamic type is the PRODUCT of the tag set and that integer type: meet and dual act on each
;; part independently, the set by the complemented-set rules above and the component by the integer
;; lattice. A product of lattices is a lattice, so every law holds without special cases. Masking the
;; component by whether the set holds `int` was tried and breaks either duality or absorption, because
;; a high set's stored bits and its denotation disagree about membership.
;;
;; Precision comes from the constructors instead. A set without `int` is built with the integer TOP,
;; which contributes nothing when it meets a set that has integers; a set with `int` and no known
;; payload is built with the integer BOTTOM.
;;
;; The one canonicalization is the payload range, which a boxed integer cannot exceed: a low range
;; that is not strictly inside the signed-48 payload is "any integer", spelled as the integer bottom,
;; and a high range is canonicalized through its dual to the integer top. Both preserve meet.

;; The signed-48 payload range of a compact integer word (docs/DECISIONS.md, dynamic words).
(const TY-DYN-INT-PAYLOAD-LO -140737488355328)

(const TY-DYN-INT-PAYLOAD-HI 140737488355327)

;; Is a LOW integer range strictly inside the signed-48 payload range?
(defn ty-dyn--int-inside? [(r i64)] (-> bool)
  (and (>= (ty-int-lo r) TY-DYN-INT-PAYLOAD-LO)
       (and (<= (ty-int-hi r) TY-DYN-INT-PAYLOAD-HI)
            (not (and (= (ty-int-lo r) TY-DYN-INT-PAYLOAD-LO)
                      (= (ty-int-hi r) TY-DYN-INT-PAYLOAD-HI))))))

(defn ty-dyn--canonical-int [(r i64)] (-> i64)
  (cond (not (ty-int? r))
          (panic "ty-dyn: the integer component must be an integer type")
        (ty-high? r)
          (if (ty-dyn--int-inside? (ty-dual r)) r (ty-dual (ty-int-bot)))
        (ty-dyn--int-inside? r) r
        :else (ty-int-bot)))

;; The one constructor. low(empty) and high(ALL) spell the same set, as do high(empty) and low(ALL);
;; the component is independent of that spelling and is kept.
(defn ty-dyn-make [(tags i64) (high bool) (int i64)] (-> i64)
  (ty-dyn-state tags high int (ty-dyn-default-identity tags high)))

(defn ty-dyn-state [(tags i64) (high bool) (int i64) (identity i64)] (-> i64)
  (do
    (ty-boot!)
    (if (= tags 0)
        (ty-intern (TDyn
                     :tags TAG-COMPLETION
                     :high (not high)
                     :int (ty-dyn--canonical-int int)
                     :identity identity))
        (ty-intern (TDyn
                     :tags tags
                     :high high
                     :int (ty-dyn--canonical-int int)
                     :identity identity)))))

;; Simple TypeMemPtr meets its independent pointer coordinates and duals each coordinate.
;; JavaScript additionally needs stable image identities, independent of mutable object state.
;; This coordinate is the finite/cofinite powerset lattice over image entry numbers: meet is
;; union, dual is complement, and join is intersection. Empty and universal are distinct types.
;; Sets reuse the canonical integer-set storage used by function targets, not their type domain.
;; No cardinality cutoff is applied inside meet: truncation there would break associativity.
;; Property consumers may impose a precision budget without changing these algebraic laws.
(defn ty-identity-top [] (-> i64)
  (do (ty-boot!) (ty-intern (TIdentity 0 false))))

(defn ty-identity-bot [] (-> i64)
  (do (ty-boot!) (ty-intern (TIdentity 0 true))))

(defn ty-identity-single [(entry i64)] (-> i64)
  (do (ty-boot!) (ty-intern (TIdentity (fidx-set-single entry) false))))

(defn ty-dyn-default-identity [(tags i64) (high bool)] (-> i64)
  (if (= (!= (& tags TAG-DYNAMIC-REFERENCE) 0) (not high))
      (ty-identity-bot)
      (ty-identity-top)))

(defn ty-value-identity [(t i64)] (-> i64)
  (match (ty-kind t)
    (TDyn [_ _ _ identity] identity)
    (TMemPtr [_ _ identity] identity)
    (TTop [] (ty-identity-top))
    (_ (ty-identity-bot))))

(defn ty-with-identity [(t i64) (identity i64)] (-> i64)
  (match (ty-kind t)
    (TDyn [tags high int _] (ty-dyn-state tags high int identity))
    (TMemPtr [nilstate strct _]
             (ty-memptr-identity-state nilstate strct identity))
    (_ t)))

;; Returns a named image entry only for an exact finite singleton. It is never a runtime address.
(defn ty-image-entry [(t i64)] (-> i64)
  (match (ty-kind (ty-value-identity t))
    (TIdentity [members complement]
               (if (and (not complement)
                        (= (get (.fidx-lens (ty-table)) members) 1))
                   (get (.fidx-members (ty-table))
                        (get (.fidx-offs (ty-table)) members))
                   -1))
    (_ (panic "ty-image-entry: invalid identity coordinate"))))

;; The integer component a constructor gives a set with no known payload.
(defn ty-dyn--default-int [(tags i64) (high bool)] (-> i64)
  (let [has-int (!= (primitive/iand tags TAG-INT) 0)]
    (if (= has-int (not high)) (ty-int-bot) (ty-dual (ty-int-bot)))))

;; Build a low (claimed) tag set, with no fact about its integer payload. The empty low set and
;; empty high complement are the two equivalent endpoint spellings, so low(empty) is high(ALL).
(defn ty-dyn [(tags i64)] (-> i64)
  (ty-dyn-make tags false (ty-dyn--default-int tags false)))

;; Build the high (optimistic) mirror. Canonicalize high(empty), whose complement is the full
;; dynamic universe, to low(ALL). Per-family endpoints remain dynamic types rather than collapsing
;; to global TOP/BOT; consumers still need to know that the value has the dynamic representation.
(defn ty-dyn-high [(tags i64)] (-> i64)
  (ty-dyn-make tags true (ty-dyn--default-int tags true)))

;; A low set whose `int` member's payload lies in the integer type `int`.
(defn ty-dyn-with-int [(tags i64) (int i64)] (-> i64)
  (ty-dyn-make tags false int))

;; The integer component: the payload range of the `int` member (the integer bottom when unknown).
(defn ty-dyn-int [(t i64)] (-> i64)
  (match (ty-kind t)
    (TDyn [tags high int identity] int)
    (_ (do (panic "ty-dyn-int: not a dynamic type") TY-BOT))))

(defn ty-dyn? [(t i64)] (-> bool)
  (match (ty-kind t) (TDyn [tags high int identity] true) (_ false)))

(defn ty-dyn-tags [(t i64)] (-> i64)
  (match (ty-kind t)
    (TDyn [tags high int identity] tags)
    (_ (do (panic "ty-dyn-tags: not a dynamic type") 0))))

(defn ty-dyn-high? [(t i64)] (-> bool)
  (match (ty-kind t) (TDyn [tags high int identity] high) (_ false)))

;; Exactly one tag, and LOW — a proven representation. This is the test that decides whether a value
;; can be unboxed and kept in a register rather than as a NaN-boxed word.
(defn ty-monomorphic? [(t i64)] (-> bool)
  (match (ty-kind t)
    (TDyn [tags high int identity]
          (and (not high)
               (and (!= tags 0) (= (primitive/iand tags (- tags 1)) 0))))
    (_ false)))

;; Does this tag set contain that one?
(defn ty-dyn-has? [(t i64) (tag i64)] (-> bool)
  (!= (primitive/iand (ty-dyn-tags t) tag) 0))

;; The tag bitset. One bit per NaN-box tag.
(const TAG-UNDEFINED 1)

(const TAG-NULL 2)

(const TAG-BOOL 4)

(const TAG-INT 8)

(const TAG-DOUBLE 16)

(const TAG-STRING 32)

(const TAG-SYMBOL 64)

(const TAG-OBJECT 128)

(const TAG-FUNCTION 256)

;; An Array exotic object (docs/DECISIONS.md, arrays): its own family, so `%IsArray` is one prefix
;; test and SCCP proves array-ness the way it proves function-ness.
(const TAG-ARRAY 1024)

;; Only these dynamic families can carry a relocatable heap address in their NaN-box payload.
;; Keeping the predicate on the lattice type lets register allocation and barrier/stack-map
;; construction agree about singleton scalars such as null and undefined. A high dynamic type is
;; conservative because its eventual tag is not yet known.
(const TAG-DYNAMIC-REFERENCE
       (+ TAG-STRING (+ TAG-SYMBOL (+ TAG-OBJECT (+ TAG-FUNCTION TAG-ARRAY)))))

(defn ty-dyn-may-reference? [(t i64)] (-> bool)
  (and (ty-dyn? t)
       (or (ty-dyn-high? t)
           (!= (primitive/iand (ty-dyn-tags t) TAG-DYNAMIC-REFERENCE) 0))))

(const TAG-ANY 1535)

;; The exception sentinel: not a JavaScript value. A function that throws returns a word carrying
;; this tag and leaves the thrown value in the runtime's pending word; the caller's check is a
;; TypeTest for it (docs/DECISIONS.md, exceptions are a sentinel completion). It lives on the tag
;; axis so SCCP does the may-throw analysis: a callee whose return type excludes it folds every
;; check at its callers, and a value that may carry it is visibly not a JavaScript value.
(const TAG-EXCEPTION 512)

;; Every word a function may return: a JavaScript value or the sentinel. The dynamic axis's full
;; universe; every complement is taken against it, never against TAG-ANY.
(const TAG-COMPLETION 2047)

;; `number` in TypeScript is int-or-double. The compiler keeps them apart because an int is worth
;; keeping unboxed, while the language says they are one type.
(const TAG-NUMBER 24)

(defn ty-shape-set [(shapes i64)] (-> i64)
  (do (unimplemented "ty-shape-set" "the shape unit — src/type/type.coil") 0))

(defn ty-str [] (-> i64)
  (do (unimplemented "ty-str" "the string unit — src/type/type.coil") 0))
