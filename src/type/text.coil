;; Type text: the printed form of every type.

(module aot.type.text)
(import "aot.util.arena" :use [compiler-allocator])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.str"
        :use
        [StrBuf sb-new sb-push-str! sb-push-i64! sb-push-byte! sb-str])
(import "aot.type.type"
        :use
        [TBot
         TTop
         TCtrl
         TXCtrl
         TNil
         TXNil
         TInt
         TFlt
         TPtr
         TMemPtr
         TFunPtr
         TMem
         TStruct
         TTuple
         TRpc
         TDyn
         TIdentity
         TShape
         TStr
         TY-INVALID
         ty-table
         ty-kind
         ty-constant?
         ty-dual])
(import "aot.type.scalar" :use *)
(import "aot.type.fun" :use *)
(import "aot.type.dyn" :use *)

;; ---------------------------------------------------------------------------
;; Text
;;
;; The one notation for a type, used by diagnostics, graph dumps and (later) the text parser and
;; JSL annotations. Simple prints types with `str()`; this is the same job with a fixed grammar:
;;   BOT TOP CTRL XCTRL NIL XNIL
;;   int:5  int[lo..hi]  ~int  (high)        flt:1.5  flt  f32  ~flt  ~f32
;;   dyn{undefined,int}  dyn  ~dyn{...}       *Name  ?*Name  !*Name  (memptr: either/nil/non-null)
;;   {a,b->r}#3,5  ~{...}#..  (function pointers: signature then the index set)
;;   mem#alias:elem  (tuple members)  rpc[n]  Name  shape#n  str"..."
(defn ty-text-into! [(b (mut StrBuf)) (t i64)] (-> i64)
  (if (= t TY-INVALID)
      (do (sb-push-str! (mut b) "INVALID") 0)
      (match (ty-kind t)
        (TBot [] (do (sb-push-str! (mut b) "BOT") 0))
        (TTop [] (do (sb-push-str! (mut b) "TOP") 0))
        (TCtrl [] (do (sb-push-str! (mut b) "CTRL") 0))
        (TXCtrl [] (do (sb-push-str! (mut b) "XCTRL") 0))
        (TNil [] (do (sb-push-str! (mut b) "NIL") 0))
        (TXNil [] (do (sb-push-str! (mut b) "XNIL") 0))
        (TInt [lo hi widen]
              (do
                (cond (> lo hi) (sb-push-str! (mut b) "~int")
                      (= lo hi)
                        (do
                          (sb-push-str! (mut b) "int:")
                          (sb-push-i64! (mut b) lo))
                      (and (= lo -9223372036854775808)
                           (= hi 9223372036854775807))
                        (sb-push-str! (mut b) "int")
                      :else
                        (do
                          (sb-push-str! (mut b) "int[")
                          (sb-push-i64! (mut b) lo)
                          (sb-push-str! (mut b) "..")
                          (sb-push-i64! (mut b) hi)
                          (sb-push-str! (mut b) "]")))
                (if (!= widen 0)
                    (do (sb-push-str! (mut b) "^") (sb-push-i64! (mut b) widen))
                    0)
                0))
        (TFlt [sz bits]
              (do
                (if (= sz 0)
                    (let [v (flt--from-bits bits)
                          whole (primitive/cast i64 v)]
                      (sb-push-str! (mut b) "flt:")
                      (if (primitive/fcmp-eq (primitive/cast f64 whole) v)
                          (sb-push-i64! (mut b) whole)
                          (do
                            (sb-push-str! (mut b) "bits:")
                            (sb-push-i64! (mut b) bits))))
                    (do
                      (if (< sz 0) (sb-push-str! (mut b) "~") 0)
                      (sb-push-str! (mut b)
                                    (if (or (= sz 32) (= sz -32)) "f32" "flt"))))
                0))
        (TPtr [nilstate to]
              (do
                (sb-push-str! (mut b)
                              (cond (= nilstate 3) "?ptr("
                                    (= nilstate 1) "nilptr("
                                    (= nilstate 2) "!ptr("
                                    :else "~ptr("))
                (ty-text-into! (mut b) to)
                (sb-push-str! (mut b) ")")
                0))
        (TMemPtr [nilstate strct identity]
                 (do
                   (sb-push-str! (mut b)
                                 (cond (= nilstate 3) "?*"
                                       (= nilstate 1) "nil*"
                                       (= nilstate 2) "!*"
                                       :else "~*"))
                   (ty-text-into! (mut b) strct)
                   (if (= identity
                          (if (< nilstate 2)
                              (ty-identity-top)
                              (ty-identity-bot)))
                       0
                       (ty-text-into! (mut b) identity))
                   0))
        (TFunPtr [sig fidx high external]
                 (do
                   (if high (sb-push-str! (mut b) "~") 0)
                   (sb-push-str! (mut b) "{")
                   (let [n (ty-tuple-len sig)
                         (mut i) 1]
                     (loop (if (>= (load i) n)
                               (break 0)
                               (do
                                 (if (> (load i) 1)
                                     (sb-push-str! (mut b) ",")
                                     0)
                                 (ty-text-into! (mut b)
                                                (ty-tuple-at sig (load i)))
                                 (set! (mut i) (+ (load i) 1))
                                 (continue))))
                     (sb-push-str! (mut b) "->")
                     (if (> n 0) (ty-text-into! (mut b) (ty-tuple-at sig 0)) 0))
                   (sb-push-str! (mut b) (if external "}+external#" "}#"))
                   (let [table (ty-table)
                         off (get (.fidx-offs table) fidx)
                         ln (get (.fidx-lens table) fidx)
                         (mut i) 0]
                     (loop (if (>= (load i) ln)
                               (break 0)
                               (do
                                 (if (> (load i) 0)
                                     (sb-push-str! (mut b) ",")
                                     0)
                                 (sb-push-i64! (mut b)
                                               (get (.fidx-members table)
                                                    (+ off (load i))))
                                 (set! (mut i) (+ (load i) 1))
                                 (continue)))))
                   0))
        (TMem [alias elem one]
              (do
                (sb-push-str! (mut b) "mem#")
                (sb-push-i64! (mut b) alias)
                (sb-push-str! (mut b) (if one "!:" ":"))
                (ty-text-into! (mut b) elem)
                0))
        (TStruct [nameoff namelen fldoff fldlen]
                 (let [(mut i) 0
                       bytes (.bytes (ty-table))]
                   (loop (if (>= (load i) namelen)
                             (break 0)
                             (do
                               (sb-push-byte! (mut b)
                                              (get bytes (+ nameoff (load i))))
                               (set! (mut i) (+ (load i) 1))
                               (continue))))
                   0))
        (TTuple [off ln]
                (let [(mut i) 0]
                  (sb-push-str! (mut b) "(")
                  (loop (if (>= (load i) ln)
                            (break 0)
                            (do
                              (if (> (load i) 0) (sb-push-str! (mut b) ",") 0)
                              (ty-text-into! (mut b)
                                             (get (.kids (ty-table))
                                                  (+ off (load i))))
                              (set! (mut i) (+ (load i) 1))
                              (continue))))
                  (sb-push-str! (mut b) ")")
                  0))
        (TRpc [off ln]
              (do
                (sb-push-str! (mut b) "rpc[")
                (sb-push-i64! (mut b) ln)
                (sb-push-str! (mut b) "]")
                0))
        (TIdentity [members complement]
                   (do
                     (sb-push-str! (mut b) (if complement "@except[" "@image["))
                     (let [(mut i) 0
                           n (get (.fidx-lens (ty-table)) members)
                           off (get (.fidx-offs (ty-table)) members)]
                       (loop (if (>= (load i) n)
                                 (break 0)
                                 (do
                                   (if (> (load i) 0)
                                       (sb-push-str! (mut b) ",")
                                       0)
                                   (sb-push-i64! (mut b)
                                                 (get (.fidx-members (ty-table))
                                                      (+ off (load i))))
                                   (set! (mut i) (+ (load i) 1))
                                   (continue)))))
                     (sb-push-str! (mut b) "]")
                     0))
        (TDyn [tags high int identity]
              (do
                (if high (sb-push-str! (mut b) "~") 0)
                (sb-push-str! (mut b) "dyn")
                (if (= identity (ty-dyn-default-identity tags high))
                    0
                    (ty-text-into! (mut b) identity))
                (if (and (= tags TAG-ANY)
                         (= int (ty-dyn--default-int tags high)))
                    0
                    (let [(mut first) true]
                      (sb-push-str! (mut b) "{")
                      (ty-text-tag! (mut b)
                                    tags
                                    TAG-UNDEFINED
                                    "undefined"
                                    (mut first))
                      (ty-text-tag! (mut b) tags TAG-NULL "null" (mut first))
                      (ty-text-tag! (mut b) tags TAG-BOOL "bool" (mut first))
                      (ty-text-tag! (mut b) tags TAG-INT "int" (mut first))
                      ;; A known integer payload prints after its tag: `int:2`, `int[1..30]`.
                      (if (and (!= (primitive/iand tags TAG-INT) 0)
                               (!= int
                                   (if high (ty-dual (ty-int-bot)) (ty-int-bot))))
                          (do
                            (if (ty-constant? int)
                                (do
                                  (sb-push-str! (mut b) ":")
                                  (sb-push-i64! (mut b) (ty-int-lo int))
                                  0)
                                (do
                                  (sb-push-str! (mut b) "[")
                                  (sb-push-i64! (mut b) (ty-int-lo int))
                                  (sb-push-str! (mut b) "..")
                                  (sb-push-i64! (mut b) (ty-int-hi int))
                                  (sb-push-str! (mut b) "]")
                                  (if (!= (ty-int-widen int) 0)
                                      (do
                                        (sb-push-str! (mut b) "^")
                                        (sb-push-i64! (mut b)
                                                      (ty-int-widen int))
                                        0)
                                      0)
                                  0))
                            0)
                          0)
                      (ty-text-tag! (mut b)
                                    tags
                                    TAG-DOUBLE
                                    "double"
                                    (mut first))
                      (ty-text-tag! (mut b)
                                    tags
                                    TAG-STRING
                                    "string"
                                    (mut first))
                      (ty-text-tag! (mut b)
                                    tags
                                    TAG-SYMBOL
                                    "symbol"
                                    (mut first))
                      (ty-text-tag! (mut b)
                                    tags
                                    TAG-OBJECT
                                    "object"
                                    (mut first))
                      (ty-text-tag! (mut b)
                                    tags
                                    TAG-FUNCTION
                                    "function"
                                    (mut first))
                      (ty-text-tag! (mut b)
                                    tags
                                    TAG-ARRAY
                                    "array"
                                    (mut first))
                      (ty-text-tag! (mut b)
                                    tags
                                    TAG-EXCEPTION
                                    "exception"
                                    (mut first))
                      (sb-push-str! (mut b) "}")
                      0))
                0))
        (TShape [shapes]
                (do
                  (sb-push-str! (mut b) "shape#")
                  (sb-push-i64! (mut b) shapes)
                  0))
        (TStr [conoff conlen]
              (let [(mut i) 0
                    bytes (.bytes (ty-table))]
                (sb-push-str! (mut b) "str\"")
                (loop (if (>= (load i) conlen)
                          (break 0)
                          (do
                            (sb-push-byte! (mut b)
                                           (get bytes (+ conoff (load i))))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (sb-push-str! (mut b) "\"")
                0)))))

(defn ty-text-tag! [(b (mut StrBuf))
                    (tags i64)
                    (tag i64)
                    (name (slice u8))
                    (first (mut bool))] (-> i64)
  (if (= (primitive/iand tags tag) 0)
      0
      (do
        (if (load first) 0 (sb-push-str! (mut b) ","))
        (sb-push-str! (mut b) name)
        (set! (mut first) false)
        0)))

;; A type as text. The returned slice is owned by the caller's allocator lifetime: diagnostics
;; print it and move on.
(defn ty-text [(t i64)] (-> (slice u8))
  (let [(mut b) (sb-new (compiler-allocator))]
    (ty-text-into! (mut b) t)
    (sb-str (mut b))))
