;; The interference graph: a backwards liveness walk per block, kills, and adjacency.      IFG

(module aot.codegen.regalloc.ifg)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.codegen.regmask" :use *)
(import "aot.codegen.regalloc.lrg" :use *)
(import "aot.codegen.regalloc.trace" :use *)
(import "aot.codegen.regalloc.build" :use *)
(import "aot.codegen.regalloc.split" :use *)

(defn ra-ifg-base [] (-> i64)
  (+ (ra-lrg-count) 1))

(defn ra-ifg-build-count [] (-> i64)
  (.ifg-build-count (ra-state)))

(defn ra-live-key [(block-id i64) (lrg i64)] (-> i64)
  (+ (* block-id (ra-ifg-base)) lrg))

(defn ra-liveout-nid [(block (dyn NodeOps)) (lrg i64)] (-> i64)
  (if (or (<= lrg 0) (> lrg (ra-lrg-count)))
      (do (panic-i "ra-liveout-nid: LRG out of range" lrg) 0)
      (match (get (.liveouts (ra-state))
                  (ra-live-key (n-nid block) (ra-find! lrg)))
        (Some [nid] nid)
        (None [] 0))))

(defn ra-ifg-key [(a i64) (b i64)] (-> i64)
  (let [la (ra-find! a)
        lb (ra-find! b)
        lo (if (< la lb) la lb)
        hi (if (< la lb) lb la)]
    (+ (* lo (ra-ifg-base)) hi)))

(defn ra-ifg-interferes? [(a i64) (b i64)] (-> bool)
  (let [state (ra-state)
        la (ra-find! a)
        lb (ra-find! b)
        (mut edge) (get (.adj-heads state) (ra-find! a))
        (mut found) false]
    (if (= la lb)
        false
        (do
          (loop (if (or (< (load edge) 0) (load found))
                    (break 0)
                    (do
                      (let [other (get (.adj-to state) (load edge))]
                        (if (and (> other 0) (= (ra-find! other) lb))
                            (set! (mut found) true)
                            0))
                      (set! (mut edge) (get (.adj-next state) (load edge)))
                      (continue))))
          (load found)))))

(defn ra-ifg-add-arc! [(from i64) (to i64)] (-> i64)
  (let [state (ra-state)
        idx (len (.adj-to state))]
    (push! [i64] (mut (.adj-to state)) to)
    (push! [i64] (mut (.adj-next state)) (get (.adj-heads state) from))
    (set! (mut (.adj-heads state)) from idx)
    0))

(defn ra-ifg-add! [(a i64) (b i64)] (-> i64)
  (let [la (ra-find! a)
        lb (ra-find! b)]
    (if (= la lb)
        0
        (let [key (ra-ifg-key la lb)]
          (if (hm-contains? (.ifg (ra-state)) key)
              0
              (do
                (set! (mut (.ifg (ra-state))) key true)
                (ra-ifg-add-arc! la lb)
                (ra-ifg-add-arc! lb la)
                0))))))

(defn ra-ifg-merge-adjacency! [(winner i64) (loser i64)] (-> i64)
  (let [state (ra-state)
        (mut edge) (get (.adj-heads state) loser)]
    (loop (if (< (load edge) 0)
              (break 0)
              (let [raw-other (get (.adj-to state) (load edge))
                    other (if (> raw-other 0) (ra-find! raw-other) 0)]
                (if (and (> other 0) (!= other winner))
                    (let [(mut back) (get (.adj-heads state) other)
                          (mut winner-edge) -1
                          (mut loser-edge) -1]
                      (loop (if (< (load back) 0)
                                (break 0)
                                (do
                                  (let [raw (get (.adj-to state) (load back))]
                                    (if (> raw 0)
                                        (let [canonical (ra-find! raw)]
                                          (if (= canonical winner)
                                              (if (= raw loser)
                                                  (set! (mut loser-edge)
                                                        (load back))
                                                  (set! (mut winner-edge)
                                                        (load back)))
                                              0))
                                        0))
                                  (set! (mut back)
                                        (get (.adj-next state) (load back)))
                                  (continue))))
                      (if (>= (load loser-edge) 0)
                          (if (>= (load winner-edge) 0)
                              (set! (mut (.adj-to state)) (load loser-edge) 0)
                              (set! (mut (.adj-to state))
                                    (load loser-edge)
                                    winner))
                          0)
                      (if (not (ra-ifg-interferes? winner other))
                          (ra-ifg-add-arc! winner other)
                          0))
                    0)
                (set! (mut edge) (get (.adj-next state) (load edge)))
                (continue))))
    (set! (mut (.adj-heads state)) loser -1)
    0))

(defn ra-adj-next-generation! [] (-> i64)
  (let [next (+ (.visit-generation (ra-state)) 1)]
    (set! (.visit-generation (ra-state)) next)
    next))

(defn ra-adj-mark-count! [(id i64) (generation i64) (count (mut i64))] (-> i64)
  (let [state (ra-state)
        leader (ra-find! id)
        (mut edge) (get (.adj-heads state) leader)]
    (loop (if (< (load edge) 0)
              (break 0)
              (do
                (let [raw (get (.adj-to state) (load edge))]
                  (if (> raw 0)
                      (let [other (ra-find! raw)]
                        (if (and (!= other leader)
                                 (!= (get (.visit-marks state) other)
                                     generation))
                            (do
                              (set! (mut (.visit-marks state)) other generation)
                              (set! count (+ (load count) 1)))
                            0))
                      0))
                (set! (mut edge) (get (.adj-next state) (load edge)))
                (continue))))
    0))

(defn ra-adj-degree [(id i64)] (-> i64)
  (let [generation (ra-adj-next-generation!)
        (mut count) 0]
    (ra-adj-mark-count! id generation (mut count))
    (load count)))

(defn ra-adj-union-degree [(a i64) (b i64)] (-> i64)
  (let [state (ra-state)
        generation (ra-adj-next-generation!)
        la (ra-find! a)
        lb (ra-find! b)
        (mut count) 0]
    ;; The proposed pair itself is not part of the merged neighborhood.
    (set! (mut (.visit-marks state)) la generation)
    (set! (mut (.visit-marks state)) lb generation)
    (ra-adj-mark-count! la generation (mut count))
    (ra-adj-mark-count! lb generation (mut count))
    (load count)))

(defn ra-self-conflict! [(lrg i64) (n (dyn NodeOps))] (-> i64)
  (let [leader (ra-find! lrg)
        key (+ (* leader (.self-conflict-base (ra-state))) (n-nid n))]
    (if (not (hm-contains? (.self-conflicts (ra-state)) key))
        (push! [i64] (mut (.self-conflict-nids (ra-state))) (n-nid n))
        0)
    (set! (mut (.self-conflicts (ra-state))) key true)
    (ra-fail! leader)))

(defn ra-ifg-push-work! [(block (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (get (.on-work (ra-state)) id)
        0
        (do
          (set! (mut (.on-work (ra-state))) id true)
          (push! [i64] (mut (.work (ra-state))) id)))))

(defn ra-ifg-pop-work! [] (-> (Option (dyn NodeOps)))
  (match (pop! [i64] (mut (.work (ra-state))))
    (None [] (None [(dyn NodeOps)]))
    (Some [id]
          (do
            (set! (mut (.on-work (ra-state))) id false)
            (match (arena-node id)
              (Some [n] (Some n))
              (None []
                    (do
                      (panic-i "ra-ifg-pop-work!: missing block" id)
                      (None [(dyn NodeOps)]))))))))

(defn ra-live-scratch! [] (-> RaLive)
  (let [state (ra-state)
        (mut live) (primitive/zeroed RaLive)
        (mut i) 0]
    ;; Clear only what the previous block touched; grow to the current live-range count.
    (loop (if (>= (load i) (len (.live-scratch-ids state)))
              (break 0)
              (do
                (set! (mut (.live-scratch-defs state))
                      (get (.live-scratch-ids state) (load i))
                      0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (al-clear! [i64] (mut (.live-scratch-ids state)))
    (loop (if (> (len (.live-scratch-defs state)) (ra-lrg-count))
              (break 0)
              (do
                (push! [i64] (mut (.live-scratch-defs state)) 0)
                (push! [i64] (mut (.live-scratch-positions state)) 0)
                (continue))))
    (set! (.defs (mut live)) (field state live-scratch-defs))
    (set! (.ids (mut live)) (field state live-scratch-ids))
    (set! (.positions (mut live)) (field state live-scratch-positions))
    (load live)))

(defn ra-live-get [(live (mut RaLive)) (lrg i64)] (-> i64)
  (let [leader (ra-find! lrg)]
    (if (< leader (len (load (.defs live)))) (get (load (.defs live)) leader) 0)))

;; Final Simple IFG.do_node removes a killed definition from TMP before iterating its live keys.
;; Retaining dead keys here made every later instruction revisit historical definitions, and
;; reactivation appended duplicate keys. A sparse set keeps exactly the live keys: remove by
;; swapping the last key into its slot, updating its position; insertion happens only on 0 -> live.
;; Definitions are cleared on removal, so the next block only needs to reset surviving keys.
(defn ra-live-set! [(live (mut RaLive)) (lrg i64) (nid i64)] (-> i64)
  (let [leader (ra-find! lrg)]
    (if (>= leader (len (load (.defs live))))
        (panic-i "ra-live-set!: live range outside the dense live set" leader)
        0)
    (let [old (get (load (.defs live)) leader)]
      (if (= nid 0)
          (if (!= old 0)
              (let [position (get (load (.positions live)) leader)
                    last-index (- (len (load (.ids live))) 1)
                    last (get (load (.ids live)) last-index)]
                (set! (.ids live) position last)
                (set! (.positions live) last position)
                (pop! [i64] (.ids live))
                0)
              0)
          (if (= old 0)
              (do
                (set! (.positions live) leader (len (load (.ids live))))
                (push! [i64] (.ids live) leader)
                0)
              0)))
    (set! (.defs live) leader nid)
    0))

(defn ra-ifg-live-new [(block (dyn NodeOps))] (-> RaLive)
  (let [(mut live) (ra-live-scratch!)
        (mut edge) (get (.liveout-heads (ra-state)) (n-nid block))]
    (loop (if (< (load edge) 0)
              (break 0)
              (do
                (let [lrg (get (.liveout-lrgs (ra-state)) (load edge))]
                  (match (get (.liveouts (ra-state))
                              (ra-live-key (n-nid block) lrg))
                    (Some [nid] (ra-live-set! (mut live) lrg nid))
                    (None []
                          (broken "ra-ifg-live-new: sparse live-out index has no definition"))))
                (set! (mut edge) (get (.liveout-next (ra-state)) (load edge)))
                (continue))))
    (load live)))

(defn ra-ifg-check-self! [(lrg i64) (n (dyn NodeOps)) (prior-id i64)] (-> i64)
  (if (and (!= prior-id 0) (!= prior-id (n-nid n)))
      (do
        (match (arena-node prior-id)
          (Some [prior] (ra-self-conflict! lrg prior))
          (None [] 0))
        (ra-self-conflict! lrg n))
      0))

(defn ra-gc-site-op? [(op i64)] (-> bool)
  (or (= op OP-CALL) (= op OP-NEW) (= op OP-JSOP) (= op OP-SAFEPOINT)))

(defn ra-stack-required? [(lrg i64)] (-> bool)
  (get (.stack-required (ra-state)) (ra-find! lrg)))

;; The target is fixed for a round. Its immutable register universe is a round fact, not another
;; mask to reconstruct at each call visited by the backwards liveness worklist.
(defn ra-allocatable-registers [] (-> (ptr RegMask))
  (let [state (ra-state)]
    (match (.allocatable-registers state)
      (Some [mask] mask)
      (None []
            (let [mask (mach-active-allocatable)]
              (set! (.allocatable-registers state) (Some mask))
              mask)))))

(defn ra-ifg-kills! [(mach (dyn MachNode)) (live (mut RaLive))] (-> i64)
  (do
    ;; Simple subtracts ABI clobbers from live masks. GC placement is a separate constraint:
    ;; movable references need writable stack homes even when the ABI preserves their register.
    ;; Scalar values may retain callee-save registers across runtime calls. JavaScript calls
    ;; still use the all-volatile ABI. Barrier is non-collecting and only kills its scratch.
    (let [op (m-ideal-op mach)
          root-site (ra-gc-site-op? op)]
      ;; Calls carry their ABI kills on CallEnd, but the return-PC stack map belongs to Call.
      ;; Apply root placement at that exact instruction even when its own kill map is absent.
      (match (if root-site
                 (Some (match (m-killmap mach)
                         (Some [mask] mask)
                         (None [] (mask-empty))))
                 (m-killmap mach))
        (None [] 0)
        (Some [kills]
              (let [(mut i) 0
                    ;; This is a target-wide proof, not an inference from an already-empty mask.
                    ;; Runtime calls that preserve any allocatable register do not establish it.
                    no-registers
                      (mask-empty? (mask-sub (ra-allocatable-registers) kills))]
                (loop (if (>= (load i) (len (load (.ids live))))
                          (break 0)
                          (let [lrg (ra-find! (get (load (.ids live)) (load i)))]
                            (if (!= (ra-live-get (mut live) lrg) 0)
                                (do
                                  (let [kind (ra-lrg-kind lrg)]
                                    (if (or no-registers
                                            (and root-site
                                                 (or (= kind LRG-RAW-REF)
                                                     (= kind LRG-BOXED))))
                                        (set! (mut (.stack-required (ra-state)))
                                              lrg
                                              true)
                                        0)
                                    (if (and (or (= kind LRG-RAW-REF)
                                                 (= kind LRG-BOXED))
                                             root-site)
                                        (do
                                          (ra-lrg-and-mask! lrg
                                                            (selected-gc-root-mask))
                                          0)
                                        0))
                                  (match (ra-lrg-mask lrg)
                                    (Some [allowed]
                                          (if (mask-overlap? allowed kills)
                                              (do
                                                (ra-lrg-sub-mask! lrg kills)
                                                0)
                                              0))
                                    (None [] 0)))
                                0)
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                0))))))

(defn ra-ifg-node! [(n (dyn NodeOps)) (live (mut RaLive))] (-> i64)
  (ra-trace-visit! n)
  (match (mach-of n)
    (None [] 0)
    (Some [mach]
          (let [def-lrg (ra-lrg-of! n)]
            (if (!= def-lrg 0)
                (do
                  (ra-ifg-check-self! def-lrg
                                      n
                                      (ra-live-get (mut live) def-lrg))
                  (ra-live-set! (mut live) def-lrg 0))
                0)
            (if (or (= (m-ideal-op mach) OP-PHI)
                    (= (m-ideal-op mach) OP-MEMPHI))
                0
                (do
                  (ra-ifg-kills! mach (mut live))
                  (if (!= def-lrg 0)
                      (let [(mut live-index) 0]
                        (loop (if (>= (load live-index)
                                      (len (load (.ids live))))
                                  (break 0)
                                  (let [other
                                          (ra-find! (get (load (.ids live))
                                                         (load live-index)))]
                                    (if (and (!= (ra-live-get (mut live) other)
                                                 0)
                                             (!= other def-lrg))
                                        (match (ra-lrg-mask def-lrg)
                                          (Some [def-mask]
                                                (match (ra-lrg-mask other)
                                                  (Some [other-mask]
                                                        (if (mask-overlap? def-mask
                                                                           other-mask)
                                                            (match (m-outregmap mach)
                                                              (Some [out-mask]
                                                                    (if (mask-singleton? out-mask)
                                                                        (do
                                                                          (ra-lrg-deny-reg! other
                                                                                            (mask-first out-mask))
                                                                          0)
                                                                        (ra-ifg-add! def-lrg
                                                                                     other)))
                                                              (None [] 0))
                                                            0))
                                                  (None [] 0)))
                                          (None [] 0))
                                        0)
                                    (set! (mut live-index)
                                          (+ (load live-index) 1))
                                    (continue)))))
                      0)
                  ;; An input without a register mask is not a use of the value: it is an
                  ;; ordering edge — a GCM anti-dependence (a Load this node's memory effect
                  ;; must follow) or a memory or control operand. Such an input neither keeps
                  ;; the value live nor asks a register of it: the value's live range ends at
                  ;; its last register use, and a Load kept alive only by the Store it must
                  ;; precede would otherwise cross every call between them with no use the
                  ;; splitter may split before, and never colour. (Simple marks every input
                  ;; live and lets `insertBefore` split before a mask-less use; the same range
                  ;; ends in the same place either way, on the stack there and at its last
                  ;; register use here.)
                  (let [(mut i) 1]
                    (loop (if (>= (load i) (n-nins n))
                              (break 0)
                              (do
                                (match (n-in n (load i))
                                  (Some [def]
                                        (let [input-lrg (ra-lrg-of! def)]
                                          (if (and (!= input-lrg 0)
                                                   (match (m-regmap mach
                                                                    (load i))
                                                     (Some [_] true)
                                                     (None [] false)))
                                              (do
                                                (ra-ifg-check-self! input-lrg
                                                                    def
                                                                    (ra-live-get (mut live)
                                                                                 input-lrg))
                                                (match (m-regmap mach (load i))
                                                  (Some [use-mask]
                                                        (if (mask-singleton? use-mask)
                                                            (let [(mut live-index)
                                                                    0]
                                                              (loop (if (>= (load live-index)
                                                                            (len (load (.ids live))))
                                                                        (break 0)
                                                                        (let [other
                                                                                (ra-find! (get (load (.ids live))
                                                                                               (load live-index)))]
                                                                          (if (and (!= other
                                                                                       input-lrg)
                                                                                   (!= (ra-live-get (mut live)
                                                                                                    other)
                                                                                       0))
                                                                              (do
                                                                                (ra-lrg-deny-reg! other
                                                                                                  (mask-first use-mask))
                                                                                0)
                                                                              0)
                                                                          (set! (mut live-index)
                                                                                (+ (load live-index)
                                                                                   1))
                                                                          (continue)))))
                                                            0))
                                                  (None [] 0))
                                                (ra-live-set! (mut live)
                                                              input-lrg
                                                              (n-nid def)))
                                              0)))
                                  (None [] 0))
                                (set! (mut i) (+ (load i) 1))
                                (continue)))))
                  0))))))

(defn ra-ifg-block-of [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [id (n-block-nid n)]
    (match (arena-node id)
      (Some [block] block)
      (None []
            (do
              (n-panic! "ra-ifg-block-of: the node was never placed in a block"
                        n)
              (unreachable-node))))))

(defn ra-ifg-edge-def [(current (dyn NodeOps)) (arm i64) (def-id i64)] (-> i64)
  (match (arena-node def-id)
    (None [] def-id)
    (Some [def]
          (match (mach-of def)
            (Some [mach]
                  (if (and (or (= (m-ideal-op mach) OP-PHI)
                               (= (m-ideal-op mach) OP-MEMPHI))
                           (= (n-block-nid def) (n-nid current))
                           (> arm 0)
                           (< arm (n-nins def)))
                      (match (n-in def arm)
                        (Some [input] (n-nid input))
                        (None [] def-id))
                      def-id))
            (None [] def-id)))))

(defn ra-ifg-merge-def! [(block (dyn NodeOps)) (lrg i64) (def-id i64)] (-> bool)
  (let [state (ra-state)
        block-id (n-nid block)
        key (ra-live-key block-id lrg)]
    (match (get (.liveouts (ra-state)) key)
      (None []
            (do
              (set! (mut (.liveouts state)) key def-id)
              (let [edge (len (.liveout-lrgs state))]
                (push! [i64] (mut (.liveout-lrgs state)) lrg)
                (push! [i64]
                       (mut (.liveout-next state))
                       (get (.liveout-heads state) block-id))
                (set! (mut (.liveout-heads state)) block-id edge))
              true))
      (Some [prior-id]
            (do
              (if (!= prior-id def-id)
                  (match (arena-node def-id)
                    (Some [def] (ra-ifg-check-self! lrg def prior-id))
                    (None [] 0))
                  0)
              false)))))

(defn ra-ifg-merge-live! [(current (dyn NodeOps))
                          (pred (dyn NodeOps))
                          (arm i64)
                          (live (mut RaLive))] (-> i64)
  (let [block (ra-ifg-block-of pred)
        (mut changed) false
        (mut live-index) 0]
    (loop (if (>= (load live-index) (len (load (.ids live))))
              (break 0)
              (let [lrg (ra-find! (get (load (.ids live)) (load live-index)))
                    live-def (ra-live-get (mut live) lrg)]
                (if (!= live-def 0)
                    (let [def-id (ra-ifg-edge-def current arm live-def)
                          inserted (ra-ifg-merge-def! block lrg def-id)]
                      (if inserted (set! (mut changed) true) 0))
                    0)
                (set! (mut live-index) (+ (load live-index) 1))
                (continue))))
    ;; Phi arms are implicit uses on their matching predecessor edges. A backwards walk kills the
    ;; Phi definition at the merge head, so these edge uses must be added explicitly. In
    ;; particular, a loop-invariant backedge arm remains live through the cold entry edge; merging
    ;; it with a different entry arm in the shared Phi LRG records the self-conflict that drives
    ;; Simple's cold-then-hot edge splitting.
    (let [(mut si) 1]
      (loop (if (>= (load si) (code-schedule-count current))
                (break 0)
                (let [phi (code-schedule-at current (load si))]
                  (if (and (ra-phi? phi) (> arm 0) (< arm (n-nins phi)))
                      (match (n-in phi arm)
                        (Some [input]
                              (let [input-lrg (ra-lrg-of! input)]
                                (if (and (!= input-lrg 0)
                                         (ra-ifg-merge-def! block
                                                            input-lrg
                                                            (n-nid input)))
                                    (set! (mut changed) true)
                                    0)))
                        (None [] 0))
                      0)
                  (set! (mut si) (+ (load si) 1))
                  (continue)))))
    (if (load changed) (ra-ifg-push-work! block) 0)
    0))

(defn ra-ifg-propagate! [(block (dyn NodeOps)) (live (mut RaLive))] (-> i64)
  (match (mach-of block)
    (None [] 0)
    (Some [mach]
          (let [op (m-ideal-op mach)]
            (if (or (= op OP-START) (= op OP-FUN))
                0
                (if (or (= op OP-REGION) (= op OP-LOOP) (= op OP-STOP))
                    (let [(mut i) 1]
                      (loop (if (>= (load i) (n-nins block))
                                (break 0)
                                (do
                                  (match (n-in block (load i))
                                    (Some [pred]
                                          (ra-ifg-merge-live! block
                                                              pred
                                                              (load i)
                                                              (mut live)))
                                    (None [] 0))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue)))))
                    (match (n-in block 0)
                      (Some [pred] (ra-ifg-merge-live! block pred 0 (mut live)))
                      (None [] 0))))))))

;; Phi definitions happen in parallel at a Region head. Distinct surviving Phi results therefore
;; overlap at their definition point and cannot share a register. Simple's backwards IFG walk
;; obtains the same constraint from the simultaneously live Phi ranges; recording it explicitly
;; keeps that invariant independent of Coil's schedule order and eager use-count reclamation.
(defn ra-ifg-interfere-phis! [(block (dyn NodeOps))] (-> i64)
  (let [(mut i) 1]
    (loop (if (>= (load i) (code-schedule-count block))
              (break 0)
              (let [left (code-schedule-at block (load i))]
                (if (or (= (ra-ideal-op left) OP-PHI)
                        (= (ra-ideal-op left) OP-MEMPHI))
                    (let [(mut j) (+ (load i) 1)]
                      (loop (if (>= (load j) (code-schedule-count block))
                                (break 0)
                                (let [right (code-schedule-at block (load j))]
                                  (if (or (= (ra-ideal-op right) OP-PHI)
                                          (= (ra-ideal-op right) OP-MEMPHI))
                                      (let [left-lrg (ra-lrg-of! left)
                                            right-lrg (ra-lrg-of! right)]
                                        (if (and (!= left-lrg 0)
                                                 (!= right-lrg 0))
                                            (match (ra-lrg-mask left-lrg)
                                              (Some [left-mask]
                                                    (match (ra-lrg-mask right-lrg)
                                                      (Some [right-mask]
                                                            (if (mask-overlap? left-mask
                                                                               right-mask)
                                                                (ra-ifg-add! left-lrg
                                                                             right-lrg)
                                                                0))
                                                      (None [] 0)))
                                              (None [] 0))
                                            0))
                                      0)
                                  (set! (mut j) (+ (load j) 1))
                                  (continue)))))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))))

(defn ra-ifg-do-block! [(block (dyn NodeOps))] (-> i64)
  (let [(mut live) (ra-ifg-live-new block)
        (mut i) (- (code-schedule-count block) 1)]
    (ra-ifg-interfere-phis! block)
    ;; The head itself is structural; its kill mask (not its ordinary inputs) is applied after the
    ;; body walk, exactly where CallEnd clobbers become live-across-call constraints.
    (loop (if (<= (load i) 0)
              (break 0)
              (do
                (ra-ifg-node! (code-schedule-at block (load i)) (mut live))
                (set! (mut i) (- (load i) 1))
                (continue))))
    (match (mach-of block)
      (Some [mach] (ra-ifg-kills! mach (mut live)))
      (None [] 0))
    (ra-ifg-propagate! block (mut live))
    0))

(defn ra-build-ifg! [(round i64)] (-> bool)
  (do
    round
    (set! (.ifg-build-count (ra-state)) (+ (.ifg-build-count (ra-state)) 1))
    (hm-clear! [i64 i64] (mut (.liveouts (ra-state))))
    (al-clear! [i64] (mut (.liveout-lrgs (ra-state))))
    (al-clear! [i64] (mut (.liveout-next (ra-state))))
    (hm-clear! [i64 bool] (mut (.ifg (ra-state))))
    (hm-clear! [i64 bool] (mut (.self-conflicts (ra-state))))
    (al-clear! [i64] (mut (.adj-to (ra-state))))
    (al-clear! [i64] (mut (.adj-next (ra-state))))
    (al-clear! [i64] (mut (.work (ra-state))))
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.adj-heads (ra-state))))
                (break 0)
                (do
                  (set! (mut (.adj-heads (ra-state))) (load i) -1)
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) (len (.liveout-heads (ra-state))))
                (break 0)
                (do
                  (set! (mut (.liveout-heads (ra-state))) (load i) -1)
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) (len (.on-work (ra-state))))
                (break 0)
                (do
                  (set! (mut (.on-work (ra-state))) (load i) false)
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) (code-cfg-count))
                (break 0)
                (let [cfg (code-cfg-at (load i))]
                  (if (cfg-block-head-of? cfg) (ra-ifg-push-work! cfg) 0)
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (loop (match (ra-ifg-pop-work!)
            (None [] (break 0))
            (Some [block] (do (ra-ifg-do-block! block) (continue)))))
    (ra-propagate-singleton-masks!)
    (ra-success?)))
