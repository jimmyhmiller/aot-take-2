;; Splitting mechanics and the policy dispatcher: placing copies and clones around uses and definitions.

(module aot.codegen.regalloc.split)
(import "aot.util.arena" :use [compiler-allocator])
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.looptree" :use [looptree-depth-of])
(import "aot.codegen.listsched" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.codegen.regmask" :use *)
(import "aot.codegen.regalloc.lrg" :use *)
(import "aot.codegen.regalloc.trace" :use *)
(import "aot.codegen.regalloc.ifg" :use *)
(import "aot.codegen.regalloc.colour" :use *)
(import "aot.codegen.regalloc.split-self" :use *)
(import "aot.codegen.regalloc.split-loop" :use *)
(import "aot.codegen.regalloc.split-empty" :use *)

(defn ra-split-block-for-use [(use_ (dyn NodeOps)) (idx i64)] (-> (dyn NodeOps))
  (match (mach-of use_)
    (Some [mach]
          (if (and (or (= (m-ideal-op mach) OP-PHI)
                       (= (m-ideal-op mach) OP-MEMPHI))
                   (> idx 0))
              (let [region (n-in! use_ 0)
                    pred (n-in! region idx)]
                (ra-ifg-block-of pred))
              (ra-ifg-block-of use_)))
    (None []
          (do
            (panic "ra-split-block-for-use: use is not a machine node")
            (unreachable-node)))))

(defn ra-place-copy! [(copy (dyn NodeOps)) (block (dyn NodeOps))] (-> i64)
  (do
    (n-set-block-nid! copy (n-nid block))
    (n-set-early-nid! copy (n-nid block))
    0))

;; Whether the last scheduled node of `block` is its control tail (a branch, call or jump the
;; layout will not synthesize). A block that falls through ends in an ordinary node.
(defn ra-block-has-tail? [(block (dyn NodeOps))] (-> bool)
  (let [count (code-schedule-count block)]
    (and (> count 1)
         (let [last (code-schedule-at block (- count 1))]
           (and (cfg? last) (not (n-same? last block)))))))

;; Final Simple's `Node.insertBefore`: the copy takes the slot immediately before its use, or, for a
;; Phi use, the end of the predecessor block ahead of its tail. The block order is authoritative
;; from here on; nothing reschedules it.
(defn ra-anchor-before-use! [(copy (dyn NodeOps))
                             (value (dyn NodeOps))
                             (use_ (dyn NodeOps))
                             (block (dyn NodeOps))] (-> i64)
  (do
    value
    (if (ra-phi? use_)
        (code-schedule-insert-before-tail! block
                                           (ra-block-has-tail? block)
                                           (n-nid copy))
        (do
          (code-schedule-insert-before! block (n-nid use_) (n-nid copy))
          (code-record-before-use! copy use_)))
    0))

;; Final Simple's `Node.insertAfter`: directly after the definition, past the entry cluster.
(defn ra-anchor-after-def! [(copy (dyn NodeOps))
                            (def (dyn NodeOps))
                            (block (dyn NodeOps))] (-> i64)
  (do
    (code-schedule-insert-after! block
                                 (n-nid def)
                                 (n-nid copy)
                                 (sched-entry-prefix-end block))
    (code-record-after-def! copy def)
    0))

;; Final Simple's makeSplit clones cheap machine definitions when their output mask can satisfy the
;; constrained use. This is not an optional peephole: repeatedly inserting a Split after a
;; cloneable Box leaves the same short fixed-register conflict for the next round. Re-materializing
;; the Box at the use shortens its source live range and makes allocation converge.
(defn ra-clone-compatible-with-use? [(value-mach (dyn MachNode))
                                     (use_ (dyn NodeOps))
                                     (idx i64)] (-> bool)
  (match (m-outregmap value-mach)
    (None [] false)
    (Some [value-mask]
          (match (mach-of use_)
            (None [] false)
            (Some [use-mach]
                  (match (m-regmap use-mach idx)
                    (None [] false)
                    (Some [use-mask] (overlaps? value-mask use-mask))))))))

(defn ra-bind-clone-at! [(copy (dyn NodeOps))
                         (value (dyn NodeOps))
                         (value-mach (dyn MachNode))
                         (use_ (dyn NodeOps))
                         (block (dyn NodeOps))] (-> i64)
  (do
    ;; Target clones copy their raw input slots but have no output edges. Rebind through NodeOps so
    ;; def-use edges remain exact after RA.
    (if (!= (n-nouts copy) 0)
        (broken "ra-bind-clone-at!: fresh clone has outputs")
        0)
    (loop (if (= (n-nins copy) 0)
              (break 0)
              (do
                (pop! (mut (.ins (hdr copy))))
                (continue))))
    (n-add-def! copy (Some block))
    (let [(mut input) 1]
      (loop (if (>= (load input) (n-nins value))
                (break 0)
                (do
                  ;; Do not inherit a scheduling-only anchor from an older rematerialization.
                  ;; Machine register inputs are the semantic operands; input zero is replaced by
                  ;; the placement control above.
                  (match (m-regmap value-mach (load input))
                    (Some [_] (n-add-def! copy (n-in value (load input))))
                    (None [] 0))
                  (set! (mut input) (+ (load input) 1))
                  (continue)))))
    (ra-anchor-before-use! copy value use_ block)
    (ra-place-copy! copy block)
    0))

;; Has this range no register location left? Then it lives on the stack, and a rematerialized
;; constant (register-only by construction) cannot be one of its members: a Phi merging constants
;; across a call is the common case. Simple never meets it because its calls spare the callee-saved
;; registers; a frame that preserves nothing (docs/DECISIONS.md, the compile-time architecture)
;; meets it constantly, and re-cloning the constant every round would never converge.
(defn ra-lrg-register-free? [(lrg i64)] (-> bool)
  (match (ra-lrg-mask lrg)
    (Some [mask]
          (none? (minus mask (RegMask::stack (mach-active-max-reg)))))
    (None [] false)))

(defn ra-clone-for-use [(value (dyn NodeOps))
                        (use_ (dyn NodeOps))
                        (idx i64)
                        (block (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (match (mach-of value)
    (None [] (None [(dyn NodeOps)]))
    (Some [value-mach]
          ;; The clone is inserted immediately before its use and never moves (the block order
          ;; is authoritative), so a clobber between the original and the use is exactly the
          ;; case a clone at the use resolves; nothing here asks whether the original survives.
          (if (or (not (m-clone-cheap? value-mach))
                  (not (ra-clone-compatible-with-use? value-mach use_ idx))
                  ;; A Phi arm joins the Phi's range. When that range lives on the stack, a
                  ;; register-only clone cannot be its member: copy the constant into the slot
                  ;; with a Split (whose own short register range feeds the store) instead.
                  ;; Any other use reads a register, and a clone right before it is what Simple's
                  ;; "re-clone closer to the target use" means.
                  (and (ra-phi? use_)
                       (!= (ra-lrg-of! use_) 0)
                       (ra-lrg-register-free? (ra-lrg-of! use_))))
              (None [(dyn NodeOps)])
              (match (m-clone value-mach)
                (None []
                      (do
                        (panic "ra-clone-for-use: clone-cheap machine refused to clone")
                        (None [(dyn NodeOps)])))
                (Some [copy]
                      (do
                        (ra-bind-clone-at! copy value value-mach use_ block)
                        (Some copy))))))))

(defn ra-split-before-use-node-mode! [(round i64)
                                      (lrg i64)
                                      (use_ (dyn NodeOps))
                                      (idx i64)
                                      (kind i64)
                                      (skip-old bool)] (-> (dyn NodeOps))
  (if (or (< idx 1) (>= idx (n-nins use_)))
      (do
        (panic-i "ra-split-before-use-node-mode!: input index out of range" idx)
        (unreachable-node))
      (let [value
              (match (n-in use_ idx)
                (Some [input] input)
                (None []
                      (do
                        (panic-i "ra-split-before-use-node-mode!: selected input disappeared"
                                 (n-nid use_))
                        (unreachable-node))))
            block (ra-split-block-for-use use_ idx)]
        (match (ra-clone-for-use value use_ idx block)
          (Some [copy]
                (do
                  (n-set-def! use_ idx (Some copy))
                  ;; Replacing the final use of an earlier cheap rematerialization leaves that
                  ;; definition in the durable schedule unless we retire it explicitly. A dead
                  ;; clone would otherwise be rediscovered as a register-bearing definition in
                  ;; every allocation round and be rematerialized forever. Cheap machine nodes
                  ;; are pure by contract, so an empty output multiset makes this value dead.
                  (if (= (n-nouts value) 0) (n-kill! value) 0)
                  copy))
          (None []
                (let [split (mach-make-split lrg kind round block value)
                      ;; An older copy made for THIS use, in this block: the new copy replaces it
                      ;; (Simple's insertBefore bypasses it). Any other split — an after-definition
                      ;; copy moving a fixed-register value out of its register — is a value in
                      ;; its own right and stays in the chain; bypassing it undid it every round.
                      older-copy-for-use
                        (and skip-old
                             (= (n-op value) OP-MACH-SPLIT)
                             (= (n-block-nid value) (n-nid block))
                             (= (code-before-use-target value) (n-nid use_)))]
                  (ra-place-copy! split block)
                  ;; The value may itself be a copy anchored before this use that we keep; its use
                  ;; is now the new split, and its anchor must say so, or the two race for the slot.
                  (if (and (not older-copy-for-use)
                           (= (code-before-use-target value) (n-nid use_)))
                      (code-record-before-use! value split)
                      0)
                  ;; Final Simple's `insertBefore(use)`: the copy sits immediately before its use.
                  ;; Left to the list scheduler it floats up the block and may cross a safepoint
                  ;; (a runtime property store, an allocation) between it and the use; a managed
                  ;; copy live across a safepoint must live on the stack, which a register copy
                  ;; cannot, and every later round re-makes the same copy in the same place.
                  (ra-anchor-before-use! split value use_ block)
                  (n-set-def! use_ idx (Some split))
                  ;; Simple's insertBefore bypasses an older same-block Split after placing the new
                  ;; one. Rebinding after the use moves preserves the old Split until the new input
                  ;; is ready, then ordinary last-use death removes the obsolete copy.
                  (if older-copy-for-use
                      (n-set-def! split 1 (Some (n-in! value 1)))
                      0)
                  split))))))

(defn ra-split-before-use-node! [(round i64)
                                 (lrg i64)
                                 (use_ (dyn NodeOps))
                                 (idx i64)
                                 (kind i64)] (-> (dyn NodeOps))
  (ra-split-before-use-node-mode! round lrg use_ idx kind true))

(defn ra-split-after-def-node! [(round i64)
                                (lrg i64)
                                (def (dyn NodeOps))
                                (kind i64)] (-> (dyn NodeOps))
  (let [a (compiler-allocator)
        (mut uses) (al-new [i64] a)
        (mut indices) (al-new [i64] a)
        (mut seen-uses) (hm-new [i64 bool] a (i64-keyops))
        (mut oi) 0]
    ;; Snapshot every register-bearing use before constructing the split, because binding the split
    ;; itself adds a new output and every subsequent n-set-def! mutates this def's output multiset.
    (loop (if (>= (load oi) (n-nouts def))
              (break 0)
              (do
                (match (n-out def (load oi))
                  (Some [use_]
                        (ra-snapshot-register-use! def
                                                   use_
                                                   (mut uses)
                                                   (mut indices)
                                                   (mut seen-uses)))
                  (None [] 0))
                (set! (mut oi) (+ (load oi) 1))
                (continue))))
    (let [block (ra-ifg-block-of def)
          split (mach-make-split lrg kind round block def)
          (mut i) 0]
      (ra-place-copy! split block)
      (ra-anchor-after-def! split def block)
      (if (ra-trace?)
          (do
            (println "ra:   after-def split {s} rewiring {} uses"
                     (n-text split)
                     (len (load uses)))
            0)
          0)
      (loop (if (>= (load i) (len (load uses)))
                (break 0)
                (do
                  (match (arena-node (get (load uses) (load i)))
                    (Some [use_]
                          (n-set-def! use_
                                      (get (load indices) (load i))
                                      (Some split)))
                    (None []
                          (panic "ra-split-after-def-node!: snapshotted use disappeared")))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      split)))

;; ---------------------------------------------------------------------------
;; Splitting

;; Split every failed live range. Sorted by live-range id so that splitting is DETERMINISTIC —
;; an allocator whose output depends on hash order is not reproducible, and a golden test over it
;; is worthless.
(defn ra-split-all! [(round i64)] (-> i64)
  (let [(mut lrg) 1
        (mut count) 0]
    (loop (if (> (load lrg) (ra-lrg-count))
              (break 0)
              (do
                (if (and (= (ra-find! (load lrg)) (load lrg))
                         (ra-lrg-failed? (load lrg)))
                    (if (ra-split-one! round (load lrg))
                        (set! (mut count) (+ (load count) 1))
                        0)
                    0)
                (set! (mut lrg) (+ (load lrg) 1))
                (continue))))
    ;; A bypassed copy dies when its last use is rewired; Simple's `removeSplit` edits the block
    ;; list, and compaction is that edit over the flat schedule.
    (if (> (load count) 0) (code-schedule-compact!) 0)
    (load count)))

(defn ra-phi? [(n (dyn NodeOps))] (-> bool)
  (match (mach-of n)
    (Some [mach] (= (m-ideal-op mach) OP-PHI))
    (None [] false)))

(defn ra-ideal-op [(n (dyn NodeOps))] (-> i64)
  (match (mach-of n) (Some [mach] (m-ideal-op mach)) (None [] (n-op n))))

(defn ra-loop-phi? [(n (dyn NodeOps))] (-> bool)
  (and (ra-phi? n) (> (n-nins n) 0) (= (ra-ideal-op (n-in! n 0)) OP-LOOP)))

(defn ra-two-address-input [(n (dyn NodeOps))] (-> i64)
  (match (mach-of n) (Some [mach] (m-two-address mach)) (None [] 0)))

;; Pre-color form of Simple's sameBlockNoClobber. A single adjacent Split already provides the
;; needed boundary when its source location is not overwritten between definition and copy.
(defn ra-same-block-no-clobber? [(split (dyn NodeOps))] (-> bool)
  (if (or (!= (n-op split) OP-MACH-SPLIT) (<= (n-nins split) 1))
      false
      (let [def (n-in! split 1)
            block (ra-ifg-block-of split)]
        (if (!= (n-block-nid def) (n-nid block))
            false
            (let [def-head-nid
                    (if (and (= (ra-ideal-op def) OP-PROJ) (> (n-nins def) 0))
                        (n-nid (n-in! def 0))
                        (n-nid def))
                  def-lrg (ra-lrg-of! def)
                  assigned (if (= def-lrg 0) -1 (n-reg def))
                  defreg
                    (if (>= assigned 0)
                        assigned
                        (if (= def-lrg 0)
                            -1
                            (match (ra-lrg-mask def-lrg)
                              (Some [mask]
                                    (if (none? mask) -1 (first-reg mask)))
                              (None [] -1))))
                  (mut i) (- (ra-block-schedule-index block (n-nid split)) 1)
                  (mut clear) (>= defreg 0)
                  (mut found) false]
              (loop (if (or (< (load i) 0) (not (load clear)) (load found))
                        (break 0)
                        (let [n (code-schedule-at block (load i))]
                          (if (= (n-nid n) def-head-nid)
                              (set! (mut found) true)
                              (if (or (and (!= (ra-lrg-of! n) 0)
                                           (= (ra-lrg-of! n) def-lrg))
                                      (= (n-reg n) defreg))
                                  (set! (mut clear) false)
                                  0))
                          (set! (mut i) (- (load i) 1))
                          (continue))))
              (and (load clear) (load found)))))))

(defn ra-unique-block-successor [(block (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [(mut i) (- (code-schedule-count block) 1)
        (mut tail) (None [(dyn NodeOps)])
        (mut successor) (None [(dyn NodeOps)])
        (mut many) false]
    (loop (if (or (< (load i) 0)
                  (match (load tail) (Some [_] true) (None [] false)))
              (break 0)
              (let [n (code-schedule-at block (load i))]
                (if (cfg? n) (set! (mut tail) (Some n)) 0)
                (set! (mut i) (- (load i) 1))
                (continue))))
    (match (load tail)
      (None [] (None [(dyn NodeOps)]))
      (Some [tail-node]
            (do
              (set! (mut i) 0)
              (loop (if (or (>= (load i) (n-nouts tail-node)) (load many))
                        (break 0)
                        (do
                          (match (n-out tail-node (load i))
                            (Some [use_]
                                  (if (cfg? use_)
                                      (match (load successor)
                                        (None []
                                              (set! (mut successor) (Some use_)))
                                        (Some [prior]
                                              (if (n-same? prior use_)
                                                  0
                                                  (set! (mut many) true))))
                                      0))
                            (None [] 0))
                          (set! (mut i) (+ (load i) 1))
                          (continue))))
              (if (load many) (None [(dyn NodeOps)]) (load successor)))))))

;; If a shallow block falls directly into a Loop and the candidate sits in its clone/Split-only
;; tail, splitting around the nominal shallow depth buys nothing. Final Simple treats that tail as
;; part of the loop; this prevents the allocator from repeatedly cutting the same loop entry.
(defn ra-split-effective-depth [(n (dyn NodeOps))
                                (block (dyn NodeOps))
                                (current-min i64)] (-> i64)
  (let [depth (looptree-depth-of block)]
    (if (>= depth current-min)
        depth
        (match (ra-unique-block-successor block)
          (Some [successor]
                (if (and (= (ra-ideal-op successor) OP-LOOP)
                         (> (n-nins successor) 1)
                         (= (n-block-nid (n-in! successor 1)) (n-nid block)))
                    (let [(mut i) (- (code-schedule-count block) 2)
                          (mut answer) depth
                          loop-depth (looptree-depth-of successor)]
                      (loop (if (< (load i) 0)
                                (break 0)
                                (let [out (code-schedule-at block (load i))]
                                  (if (n-same? out n)
                                      (do
                                        (set! (mut answer) loop-depth)
                                        (break 0))
                                      (if (or (= (n-op out) OP-MACH-SPLIT)
                                              (match (mach-of out)
                                                (Some [mach]
                                                      (m-clone-cheap? mach))
                                                (None [] false)))
                                          0
                                          (break 0)))
                                  (set! (mut i) (- (load i) 1))
                                  (continue))))
                      (load answer))
                    depth))
          (None [] depth)))))

;; Spill a selected CalleeSave exactly around its useful body lifetime. Final Simple's generic
;; splitByLoop reaches the same shape for a whole-function save range: one split immediately after
;; the fixed entry definition and one immediately before each boundary use, normally Return. The
;; middle range is then free to occupy a stack slot while another live range uses the callee-save
;; register across calls.
(defn ra-snapshot-register-use! [(def (dyn NodeOps))
                                 (use_ (dyn NodeOps))
                                 (uses (mut (ArrayList i64)))
                                 (indices (mut (ArrayList i64)))
                                 (seen (mut (HashMap i64 bool)))] (-> i64)
  (if (hm-contains? (load seen) (n-nid use_))
      0
      (do
        (set! (mut seen) (n-nid use_) true)
        (match (mach-of use_)
          (Some [mach]
                (let [(mut idx) 1]
                  (loop (if (>= (load idx) (n-nins use_))
                            (break 0)
                            (do
                              (match (n-in use_ (load idx))
                                (Some [input]
                                      (if (n-same? input def)
                                          (match (m-regmap mach (load idx))
                                            (Some [_]
                                                  (do
                                                    (push! [i64]
                                                           (mut uses)
                                                           (n-nid use_))
                                                    (push! [i64]
                                                           (mut indices)
                                                           (load idx))))
                                            (None [] 0))
                                          0))
                                (None [] 0))
                              (set! (mut idx) (+ (load idx) 1))
                              (continue))))))
          (None [] 0)))))

;; Final Simple's `findAllLRG` starts from one representative def/use and expands through same-LRG
;; inputs plus every output use. Failed-range splitting is therefore proportional to that range's
;; def-use component, not to the complete compilation arena.
(defn ra-lrg-member-push! [(members (mut (ArrayList i64)))
                           (seen (mut (HashMap i64 bool)))
                           (nid i64)] (-> i64)
  (if (or (<= nid 0) (hm-contains? (load seen) nid))
      0
      (match (arena-node nid)
        (Some [n]
              (if (n-dead? n)
                  0
                  (do
                    (set! (mut seen) nid true)
                    (push! [i64] (mut members) nid))))
        (None [] 0))))

(defn ra-find-all-lrg [(lrg i64)] (-> (ArrayList i64))
  (let [a (compiler-allocator)
        state (ra-state)
        leader (ra-find! lrg)
        (mut members) (al-new [i64] a)
        (mut seen) (hm-new [i64 bool] a (i64-keyops))
        (mut index) 0]
    (ra-lrg-member-push! (mut members)
                         (mut seen)
                         (get (.mach-defs state) leader))
    (ra-lrg-member-push! (mut members)
                         (mut seen)
                         (get (.mach-uses state) leader))
    (ra-lrg-member-push! (mut members)
                         (mut seen)
                         (get (.split-defs state) leader))
    (ra-lrg-member-push! (mut members)
                         (mut seen)
                         (get (.split-uses state) leader))
    (loop (if (>= (load index) (len (load members)))
              (break 0)
              (do
                (match (arena-node (get (load members) (load index)))
                  (Some [n]
                        (do
                          ;; A representative machine use need not itself define this LRG. Always
                          ;; cross its matching input edges so input-only global/rematerializable
                          ;; definitions enter the component. Output expansion, by contrast, is
                          ;; meaningful only for a node that actually defines the range.
                          (let [(mut ii) 0]
                            (loop (if (>= (load ii) (n-nins n))
                                      (break 0)
                                      (do
                                        (match (n-in n (load ii))
                                          (Some [def]
                                                (if (= (ra-lrg-of! def) leader)
                                                    (ra-lrg-member-push! (mut members)
                                                                         (mut seen)
                                                                         (n-nid def))
                                                    0))
                                          (None [] 0))
                                        (set! (mut ii) (+ (load ii) 1))
                                        (continue)))))
                          (if (= (ra-lrg-of! n) leader)
                              (let [(mut oi) 0]
                                (loop (if (>= (load oi) (n-nouts n))
                                          (break 0)
                                          (do
                                            (match (n-out n (load oi))
                                              (Some [use_]
                                                    (ra-lrg-member-push! (mut members)
                                                                         (mut seen)
                                                                         (n-nid use_)))
                                              (None [] 0))
                                            (set! (mut oi) (+ (load oi) 1))
                                            (continue)))))
                              0)))
                  (None [] 0))
                (set! (mut index) (+ (load index) 1))
                (continue))))
    (load members)))

(defn ra-split-one! [(round i64) (lrg i64)] (-> bool)
  (do
    (if (ra-trace?) (do (println "ra: split lrg {}" (ra-find! lrg)) 0) 0)
    (ra-split-one-policy! round lrg)))

(defn ra-split-one-policy! [(round i64) (lrg i64)] (-> bool)
  (if (ra-lrg-has-self-conflict? lrg)
      (do
        (ra-trace-policy! "self-conflict")
        (ra-split-self-conflict! round lrg))
      (if (ra-lrg-has-callee-save-def? lrg)
          (do
            (ra-trace-policy! "callee-save")
            (ra-split-callee-save! round lrg))
          (let [leader (ra-find! lrg)
                state (ra-state)
                fixed-defs (get (.fixed-def-counts state) leader)
                fixed-uses (get (.fixed-use-counts state) leader)
                empty (ra-lrg-mask-empty? leader)]
            (cond (and empty (ra-stack-required? leader))
                    (do
                      (ra-trace-policy! "required-stack-boundaries")
                      (ra-split-by-loop-boundary! round leader))
                  (and empty
                       (<= fixed-defs 1)
                       (<= fixed-uses 1)
                       (> (+ fixed-defs fixed-uses) 0))  ;; Simple's empty1 returns true even when a cloneable fixed def with multiple
                  ;; uses causes both insertion guards to skip. A shared XZR constant joined to
                  ;; nonconstant Phi arms reaches that case here. Only claim the cheap split
                  ;; when it changed an edge; otherwise use the ordinary boundary splitter.
                  (if (do
                        (ra-trace-policy! "empty-simple")
                        (ra-split-empty-simple! round leader))
                      true
                      (do
                        (ra-trace-policy! "loop-boundary (after empty-simple)")
                        (ra-split-by-loop-boundary! round leader)))
                    (and empty
                         (not (get (.multi-defs state) leader))
                         (<= fixed-defs 1)
                         (> fixed-uses 1))
                  (if (do
                        (ra-trace-policy! "empty-by-use-class")
                        (ra-split-empty-by-use-class! round leader))
                      true
                      (do
                        (ra-trace-policy! "loop-boundary (after use-class)")
                        (ra-split-by-loop-boundary! round leader)))
                    (and empty
                         (get (.multi-defs state) leader)
                         (> fixed-uses 1)
                         (<= fixed-defs 1))
                  (if (do
                        (ra-trace-policy! "empty-single-uses")
                        (ra-split-empty-single-uses! round leader))
                      true
                      (do
                        (ra-trace-policy! "loop-boundary (after single-uses)")
                        (ra-split-by-loop-boundary! round leader)))
                    (do
                      (ra-trace-policy! "fixed-neighbour-defs")
                      (ra-split-fixed-neighbour-defs! round leader))
                  true
                    (do
                      (ra-trace-policy! "loop-boundary")
                      (ra-split-by-loop-boundary! round leader))
                  true :else
                  (do
                    (ra-trace-policy! "pressure-use")
                    (ra-split-pressure-use! round leader)))))))
