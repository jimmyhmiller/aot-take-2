;; Owned native images and the Darwin/AArch64 memory installer.

;;
;; Final Simple's Encoding keeps instruction bytes separate from relocation records: references
;; within a chunk are resolved by layout, while references across chunks retain their symbol and
;; instruction offset until export. Its buffers can move until encoding finishes. We capture only
;; after emission/relocation, copying every byte and resolving graph identities to image-local
;; symbol indices. No node, arena ID, or borrowed name survives in a CodeImage.
;;
;; Simple exports these records through an object writer. Our additional consumer installs them
;; directly. BL imports use a nearby absolute-address veneer (LDR X16; BR X16), so arbitrary runtime
;; addresses need not fit a signed branch. X16 is already killed by the runtime call ABI. PAGE21
;; and PAGEOFF12 are checked against the actual installation addresses. A bounded 64MiB text image
;; keeps every end veneer within BL26 reach; an oversized image fails before allocating storage.
(module aot.codegen.image)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use [slice-data])
(import "coil.mem" :as mem)
(import "aot.util.panic" :use *)
(import "aot.util.arena" :use [compiler-allocator])
(import "aot.codegen.encoding" :use *)
(import "aot.codegen.objfile" :use *)
(import "aot.codegen.gcmeta" :use *)
(import "aot.codegen.compunit"
        :use
        [CuScriptDecl
         CuScriptDeclarations
         cu-script-declarations-copy
         cu-script-declarations-free!
         CU-SCRIPT-FUNCTION])
(import "aot.node.dynamic" :use [DYNAMIC-PREFIX-OBJECT])
(import "aot.node.cpus.arm64.call" :use [arm64-call-node])
(import "aot.heap" :use *)
(import "aot.shape"
        :use
        [shape-table-bytes
         SHAPE-EMPTY
         FUNCTION-PAYLOAD-BYTES
         OBJECT-PAYLOAD-BYTES])
(import "aot.rt.rt" :use [rt-read-u64])
(import "aot.codegen.image.abi" :use * :reexport)
(import "aot.codegen.image.persist" :use * :reexport)
(import "aot.codegen.image.install" :use * :reexport)
(import "aot.codegen.image.run" :use * :reexport)

(defstruct ImageSymbol
  [(segment i64) (offset i64) (name (slice u8)) (abi (slice u8))])

(const IMAGE-SYM-TEXT 1)

(const IMAGE-SYM-DATA 2)

(const IMAGE-SYM-IMPORT 3)

(defstruct ImageFixup [(kind i64) (offset i64) (symbol i64)])

;; Ordinal -> payload offset in this image's data template, never a compiler heap-entry index or
;; installed address. The owning CodeImage keeps both these bindings and the declaration names.
(defstruct ImageScript
  [(declarations CuScriptDeclarations)
   (functions (slice i64))
   (initializer i64)])  ; text symbol index, or -1 for closed-program capture

;; Names are specification identities, offsets belong to this data template. These records
;; describe layout ownership; they do not grant permission to alias a closed-world image.
(const IMAGE-REALM-GLOBAL 1)

(const IMAGE-REALM-INTRINSIC 2)

;; A well-known Symbol ("Symbol.iterator"). It is bound like an intrinsic, so every unit sees one
;; Symbol, but it has no properties and never enters the property merge.
(const IMAGE-REALM-SYMBOL 3)

(defstruct ImageRealmObject
  [(kind i64) (name (slice u8)) (offset i64) (callable bool)])

(defstruct CodeImage
  [(text (slice u8))
   (data (slice u8))
   (maps (slice u8))
   (shapes (slice u8))
   (symbols (ArrayList ImageSymbol))
   (fixups (ArrayList ImageFixup))
   (code-fixups (ArrayList ImageFixup))
   (map-sites (ArrayList EncMapSite))
   (unit-sites (ArrayList EncUnitSite))
   (scripts (ArrayList ImageScript))
   (realm-objects (ArrayList ImageRealmObject))
   (entry i64)
   (installations i64)])

(defn image-copy [(bytes (slice u8))] (-> (slice u8))
  (let [copy
          (match (alloc/alloc [u8] (alloc/malloc-allocator) (len bytes))
            (Some [p] p)
            (None [] (do (panic "image-copy: allocation failed") "")))]
    (mem/mem-copy [u8] (slice-data copy) (slice-data bytes) (len bytes))
    copy))

(defn image-capture-mode [(platform-entry bool)] (-> CodeImage)
  (obj-symbols-build!)
  (let [a (alloc/malloc-allocator)
        map-source (gc-stackmap-bytes)
        shape-source (shape-table-bytes)
        maps (image-copy map-source)
        shapes (image-copy shape-source)
        (mut syms) (al-new [ImageSymbol] a)
        (mut fixups) (al-new [ImageFixup] a)
        (mut codes) (al-new [ImageFixup] a)
        (mut map-sites) (al-new [EncMapSite] a)
        (mut unit-sites) (al-new [EncUnitSite] a)
        (mut entry) -1
        (mut i) 0]
    (alloc/free [u8] (compiler-allocator) map-source)
    (alloc/free [u8] (compiler-allocator) shape-source)
    (loop (if (>= (load i) (enc-definition-count))
              (break 0)
              (do
                (push! [ImageSymbol]
                       (mut syms)
                       (ImageSymbol
                         :segment IMAGE-SYM-TEXT
                         :offset (enc-definition-offset (load i))
                         :name (image-copy (enc-definition-name (load i)))
                         :abi
                           (let [fun
                                   (arm64-call-node (enc-definition-source (load i)))]
                             (image-abi-describe (.signature fun)
                                                 (.process-entry fun)))))
                (if (and platform-entry
                         (= (enc-definition-name (load i)) "main"))
                    (set! (mut entry) (enc-definition-offset (load i)))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (heap-count))
              (break 0)
              (do
                (push! [ImageSymbol]
                       (mut syms)
                       (ImageSymbol
                         :segment IMAGE-SYM-DATA
                         :offset (heap-entry-offset (load i))
                         :name (image-copy (heap-symbol (load i)))
                         :abi (image-copy "")))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (macho-undefined-count))
              (break 0)
              (do
                (push! [ImageSymbol]
                       (mut syms)
                       (ImageSymbol
                         :segment IMAGE-SYM-IMPORT
                         :offset 0
                         :name (image-copy (macho-undefined-name (load i)))
                         :abi (image-import-abi (macho-undefined-name (load i)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (enc-symbol-fixup-count))
              (break 0)
              (do
                (push! [ImageFixup]
                       (mut fixups)
                       (ImageFixup
                         :kind (enc-symbol-fixup-kind (load i))
                         :offset (enc-symbol-fixup-offset (load i))
                         :symbol (macho-symbol-index-for-fixup (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (heap-code-fixup-count))
              (break 0)
              (do
                (push! [ImageFixup]
                       (mut codes)
                       (ImageFixup
                         :kind MACHO-RELOC-UNSIGNED64
                         :offset (heap-code-fixup-offset (load i))
                         :symbol (macho-code-fixup-symbol (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (and platform-entry (< (load entry) 0))
        (panic "image-capture: no platform entry")
        0)
    (al-for [site (.map-sites (enc-state))]
            (push! [EncMapSite] (mut map-sites) site))
    (al-for [site (.unit-sites (enc-state))]
            (push! [EncUnitSite] (mut unit-sites) site))
    (CodeImage
      :text (image-copy (enc-bytes))
      :data (image-copy (heap-image-bytes))
      :maps maps
      :shapes shapes
      :symbols (load syms)
      :fixups (load fixups)
      :code-fixups (load codes)
      :map-sites (load map-sites)
      :unit-sites (load unit-sites)
      :scripts (al-new [ImageScript] a)
      :realm-objects (al-new [ImageRealmObject] a)
      :entry (load entry)
      :installations 0)))

(defn image-capture [] (-> CodeImage)
  (image-capture-mode true))

(defn image-capture-unit [] (-> CodeImage)
  (image-capture-mode false))

(defn image-add-realm-object! [(im (ptr CodeImage))
                               (kind i64)
                               (name (slice u8))
                               (offset i64)
                               (callable bool)] (-> i64)
  (if (or (> (.installations im) 0)
          (not (or (= kind IMAGE-REALM-GLOBAL)
                   (= kind IMAGE-REALM-INTRINSIC)
                   (= kind IMAGE-REALM-SYMBOL)))
          (and (= kind IMAGE-REALM-SYMBOL) callable)
          (if (= kind IMAGE-REALM-GLOBAL)
              (or (!= (len name) 0) callable)
              (= (len name) 0)))
      (panic "image-add-realm-object!: invalid realm identity or live installation")
      0)
  (al-for [object (.realm-objects im)]
          (let [o object]
            (if (and (= (.kind o) kind) (= (.name o) name))
                (panic "image-add-realm-object!: duplicate realm identity")
                0)))
  (let [(mut payload) false
        (mut code) false]
    (al-for [symbol (.symbols im)]
            (let [s symbol]
              (if (and (= (.segment s) IMAGE-SYM-DATA) (= (.offset s) offset))
                  (set! (mut payload) true)
                  0)))
    (al-for [fixup (.code-fixups im)]
            (let [f fixup]
              (if (and (= (.offset f) (+ offset 16))
                       (>= (.symbol f) 0)
                       (< (.symbol f) (len (.symbols im))))
                  (let [s (get (.symbols im) (.symbol f))]
                    (if (or (= (.segment s) IMAGE-SYM-TEXT)
                            (= (.segment s) IMAGE-SYM-IMPORT))
                        (set! (mut code) true)
                        0))
                  0)))
    (if (or (< offset HEAP-HEADER-BYTES)
            (!= (& offset 7) 0)
            (> offset
               (- (len (.data im))
                  (if callable FUNCTION-PAYLOAD-BYTES OBJECT-PAYLOAD-BYTES)))
            (not (load payload))
            (and callable (not (load code))))
        (panic "image-add-realm-object!: identity does not name an object payload")
        0))
  (let [data (slice-data (.data im))]
    (if (or (!= (rt-read-u64 data (- offset HEAP-HEADER-BYTES))
                (if callable FUNCTION-PAYLOAD-BYTES OBJECT-PAYLOAD-BYTES))
            (!= (rt-read-u64 data (- offset 8)) SHAPE-EMPTY))
        (panic "image-add-realm-object!: incompatible object layout")
        0)
    (if (and (= kind IMAGE-REALM-GLOBAL)
             (!= (rt-read-u64 data 16)
                 (| (primitive/ishl DYNAMIC-PREFIX-OBJECT 48) offset)))
        (panic "image-add-realm-object!: global identity differs from the image root")
        0))
  (push! [ImageRealmObject]
         (mut (.realm-objects im))
         (ImageRealmObject
           :kind kind
           :name (image-copy name)
           :offset offset
           :callable callable))
  0)

;; Capture borrows its inputs only for this call. A binding must name an exported data payload
;; whose code slot has a callable relocation; an arbitrary in-bounds byte offset is not a function.
;; CodeImage's relocation retains whether that target is local text, an import, or the invariant
;; trap for a body removed under this closed world. Capturing an object does not resurrect its body
;; or certify reuse under another caller set.
(defn image-add-script! [(im (ptr CodeImage))
                         (strict bool)
                         (entries (ArrayList CuScriptDecl))
                         (functions (ArrayList i64))] (-> i64)
  (if (> (.installations im) 0)
      (panic "image-add-script!: image has live installations")
      0)
  (let [(mut count) 0]
    (al-for [entry entries]
            (let [e entry]
              (if (= (.kind e) CU-SCRIPT-FUNCTION)
                  (set! (mut count) (+ (load count) 1))
                  0)))
    (if (!= (load count) (len functions))
        (panic "image-add-script!: function binding count mismatch")
        0))
  (al-for [offset functions]
          (let [(mut data-symbol) false
                (mut code-slot) false]
            (al-for [symbol (.symbols im)]
                    (let [s symbol]
                      (if (and (= (.segment s) IMAGE-SYM-DATA)
                               (= (.offset s) offset))
                          (set! (mut data-symbol) true)
                          0)))
            (al-for [fixup (.code-fixups im)]
                    (let [f fixup]
                      (if (and (= (.offset f) (+ offset 16))
                               (>= (.symbol f) 0)
                               (< (.symbol f) (len (.symbols im))))
                          (let [s (get (.symbols im) (.symbol f))]
                            (if (or (= (.segment s) IMAGE-SYM-TEXT)
                                    (= (.segment s) IMAGE-SYM-IMPORT))
                                (set! (mut code-slot) true)
                                0))
                          0)))
            (if (or (< offset HEAP-HEADER-BYTES)
                    (> offset (- (len (.data im)) 32))
                    (!= (& offset 7) 0)
                    (not (load data-symbol))
                    (not (load code-slot)))
                (panic "image-add-script!: binding does not name a function object")
                0)))
  (let [declarations (cu-script-declarations-copy strict entries)
        (mut offsets) (al-new [i64] (alloc/malloc-allocator))]
    (al-for [offset functions] (push! [i64] (mut offsets) offset))
    (let [owned (al-into-slice (mut offsets))]
      (push! [ImageScript]
             (mut (.scripts im))
             (ImageScript
               :declarations declarations
               :functions owned
               :initializer -1))))
  0)

(defn image-bind-script-initializer! [(im (ptr CodeImage))
                                      (script i64)
                                      (name (slice u8))] (-> i64)
  (if (or (> (.installations im) 0)
          (< script 0)
          (>= script (len (.scripts im))))
      (panic "image-bind-script-initializer!: invalid Script or live installation")
      0)
  (let [(mut found) -1
        (mut i) 0
        record (get (.scripts im) script)]
    (if (!= (.initializer record) -1)
        (panic "image-bind-script-initializer!: Script already bound")
        0)
    (al-for [symbol (.symbols im)]
            (let [s symbol]
              (if (and (= (.segment s) IMAGE-SYM-TEXT) (= (.name s) name))
                  (do
                    (if (>= (load found) 0)
                        (panic "image-bind-script-initializer!: ambiguous text symbol")
                        0)
                    (if (not (image-abi-script-entry? (.abi s)))
                        (panic "image-bind-script-initializer!: initializer lacks the generic Script ABI")
                        0)
                    (set! (mut found) (load i)))
                  0)
              (set! (mut i) (+ (load i) 1))))
    (if (< (load found) 0)
        (panic "image-bind-script-initializer!: missing text symbol")
        0)
    (set! (mut (.scripts im))
          script
          (ImageScript
            :declarations (.declarations record)
            :functions (.functions record)
            :initializer (load found))))
  0)

(defn image-free! [(im (ptr CodeImage))] (-> i64)
  (if (> (.installations im) 0)
      (panic "image-free!: image has live installations")
      0)
  (let [a (alloc/malloc-allocator)]
    (al-for [script (.scripts im)]
            (let [(mut s) script]
              (cu-script-declarations-free! (mut (.declarations (mut s))))
              (alloc/free [i64] a (.functions (mut s)))))
    (al-free! (mut (.scripts im)))
    (al-for [object (.realm-objects im)]
            (let [o object] (alloc/free [u8] a (.name o))))
    (al-free! (mut (.realm-objects im)))
    (al-for [symbol (.symbols im)]
            (let [s symbol]
              (alloc/free [u8] a (.name s))
              (alloc/free [u8] a (.abi s))))
    (alloc/free [u8] a (.text im))
    (alloc/free [u8] a (.data im))
    (alloc/free [u8] a (.maps im))
    (alloc/free [u8] a (.shapes im))
    (al-free! (mut (.symbols im)))
    (al-free! (mut (.fixups im)))
    (al-free! (mut (.code-fixups im)))
    (al-free! (mut (.map-sites im)))
    (al-free! (mut (.unit-sites im)))
    (set! im (primitive/zeroed CodeImage))
    0))
