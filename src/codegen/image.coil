;; Owned native images and the Darwin/AArch64 memory installer.
;;
;; Final Simple's Encoding keeps instruction bytes separate from relocation records: references
;; within a chunk are resolved by layout, while references across chunks retain their symbol and
;; instruction offset until export. Its buffers can move until encoding finishes. We capture only
;; after emission/relocation, copying every byte and resolving graph identities to image-local
;; symbol indices. No node, arena ID, or borrowed name survives in a CodeImage.
;;
;; Simple exports these records through an object writer. Our additional consumer installs them
;; directly. BL imports use a nearby absolute-address veneer (LDR X16; BR X16), so arbitrary runtime
;; addresses need not fit a signed branch. X16 is already killed by the runtime call ABI. PAGE21
;; and PAGEOFF12 are checked against the actual installation addresses. A bounded 64MiB text image
;; keeps every end veneer within BL26 reach; an oversized image fails before allocating storage.
(module aot.codegen.image)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.str" :use [str-keyops-borrowed])
(import "coil.slice" :use [slice-new slice-data])
(import "coil.mem" :as mem)
(import "aot.util.panic" :use *)
(import "aot.util.arena" :use [compiler-allocator])
(import "aot.codegen.encoding" :use *)
(import "aot.codegen.objfile" :use *)
(import "aot.codegen.gcmeta" :use *)
(import "aot.codegen.compunit" :use [CuShapeAssembly cu-shapes-compose cu-remap-static-shapes! cu-shapes-free!
                                    CuScriptDecl CuScriptDeclarations cu-script-declarations-copy cu-script-declarations-free!
                                    CU-SCRIPT-FUNCTION CU-SCRIPT-VAR CU-SCRIPT-PROPERTY-WRITE
                                    CU-SCRIPT-LET CU-SCRIPT-CONST])
(import "aot.node.node" :use [arena-external-named])
(import "aot.node.dynamic" :use [DYNAMIC-PREFIX-OBJECT])
(import "aot.node.cpus.arm64.call" :use [arm64-call-node])
(import "aot.type.type" :use *)
(import "aot.heap" :use *)
(import "aot.shape" :use [shape-table-bytes SHAPE-EMPTY FUNCTION-PAYLOAD-BYTES OBJECT-PAYLOAD-BYTES])
(import "aot.rt.abi" :use *)
(import "aot.rt.shapes" :use [SHAPES-HEADER-BYTES SHAPES-RECORD-BYTES SHAPES-KEY-RECORD-BYTES SHAPES-VERSION shapes-blob-magic?])
(import "aot.rt.rt" :use [rt-symbol-address rt-symbol-lookup rt-realm-destroy! rt-heap rt-code-register-identities! rt-code-unregister! rt-code-find rt-code-pin! rt-code-unit-slot rt-stackmap-find rt-read-u32 rt-read-u64])

(extern mmap :cc c [(ptr u8) u64 i32 i32 i32 i64] (-> (ptr u8)))
(extern munmap :cc c [(ptr u8) u64] (-> i32))
(extern pthread_jit_write_protect_np :cc c [i32] (-> void))
(extern sys_icache_invalidate :cc c [(ptr u8) u64] (-> void))

(const IMAGE-TEXT-LIMIT 67108864)
(const IMAGE-PROT-RW 3)
(const IMAGE-PROT-RWX 7)
(const IMAGE-MAP-PRIVATE-ANON 0x1002)
(const IMAGE-MAP-JIT 0x800)

(defstruct ImageSymbol [(segment i64) (offset i64) (name (slice u8)) (abi (slice u8))])
(const IMAGE-SYM-TEXT 1)
(const IMAGE-SYM-DATA 2)
(const IMAGE-SYM-IMPORT 3)
(defstruct ImageFixup [(kind i64) (offset i64) (symbol i64)])
;; Ordinal -> payload offset in this image's data template, never a compiler heap-entry index or
;; installed address. The owning CodeImage keeps both these bindings and the declaration names.
(defstruct ImageScript [(declarations CuScriptDeclarations) (functions (slice i64))
                        (initializer i64)])  ; text symbol index, or -1 for closed-program capture
;; Names are specification identities, offsets belong to this data template. These records
;; describe layout ownership; they do not grant permission to alias a closed-world image.
(const IMAGE-REALM-GLOBAL 1)
(const IMAGE-REALM-INTRINSIC 2)
(defstruct ImageRealmObject [(kind i64) (name (slice u8)) (offset i64) (callable bool)])
(defstruct CodeImage
  [(text (slice u8)) (data (slice u8)) (maps (slice u8)) (shapes (slice u8))
   (symbols (ArrayList ImageSymbol)) (fixups (ArrayList ImageFixup))
   (code-fixups (ArrayList ImageFixup)) (map-sites (ArrayList EncMapSite))
   (unit-sites (ArrayList EncUnitSite)) (scripts (ArrayList ImageScript))
   (realm-objects (ArrayList ImageRealmObject)) (entry i64) (installations i64)])

(defn image-copy [(bytes (slice u8))] (-> (slice u8))
  (let [copy (match (alloc/alloc [u8] (alloc/malloc-allocator) (len bytes))
                (Some [p] p)
                (None [] (do (panic "image-copy: allocation failed") "")))]
    (mem/mem-copy [u8] (slice-data copy) (slice-data bytes) (len bytes))
    copy))

;; Simple serializes declared function types beside external names; our native-only artifact
;; also needs an arena-independent machine contract before IR serialization exists. These bytes
;; describe representation and calling convention, not nominal types or value-range proofs.
;; Version 1 fixes Darwin/AArch64's register banks, 64-bit stack slots, heap register, NaN boxes,
;; and the current GC/raw-pointer distinction. A change to those contracts bumps this version.
(const IMAGE-ABI-VERSION 5)
(const IMAGE-ABI-HEADER 20)
(const IMAGE-ABI-INTERNAL 1)
(const IMAGE-ABI-HOST-ENTRY 2)
(const IMAGE-ABI-UNKNOWN 0)
(const IMAGE-ABI-INTEGER 1)
(const IMAGE-ABI-FLOAT 2)
(const IMAGE-ABI-BOXED 3)
(const IMAGE-ABI-MANAGED 4)
(const IMAGE-ABI-HOST-POINTER 5)
(const IMAGE-ABI-CODE-POINTER 6)
(const IMAGE-ABI-BOXED-SCALAR 7)

(defn image-abi-class [(t i64)] (-> i64)
  (if (ty-int? t) IMAGE-ABI-INTEGER
      (if (ty-flt? t) IMAGE-ABI-FLOAT
          (if (ty-dyn? t) (if (ty-dyn-may-reference? t) IMAGE-ABI-BOXED IMAGE-ABI-BOXED-SCALAR)
              (if (ty-memptr? t) IMAGE-ABI-MANAGED
                  (if (ty-funptr? t) IMAGE-ABI-CODE-POINTER
                      (if (ty-ptr? t) IMAGE-ABI-HOST-POINTER IMAGE-ABI-UNKNOWN)))))))

(defn image-abi-describe [(signature i64) (host-entry bool)] (-> (slice u8))
  (if (or (not (ty-tuple? signature)) (= (ty-tuple-len signature) 0))
      (panic "image-abi-describe: missing callable signature") 0)
  (let [(mut bytes) (al-new [u8] (compiler-allocator)) (mut i) 0]
    (obj-put-slice! (mut bytes) "AOTCABI\0")
    (obj-put4! (mut bytes) IMAGE-ABI-VERSION)
    (obj-put4! (mut bytes) (if host-entry IMAGE-ABI-HOST-ENTRY IMAGE-ABI-INTERNAL))
    (obj-put4! (mut bytes) (- (ty-tuple-len signature) 1))
    (loop (if (>= (load i) (ty-tuple-len signature)) (break 0)
              (do (obj-put1! (mut bytes) (image-abi-class (ty-tuple-at signature (load i))))
                  (set! (mut i) (+ (load i) 1)) (continue))))
    (let [owned (image-copy (al-slice (load bytes)))]
      (al-free! (mut bytes))
      owned)))

(defn image-abi-compatible? [(expected (slice u8)) (actual (slice u8))] (-> bool)
  (let [(mut valid)
          (and (> (len expected) IMAGE-ABI-HEADER) (= (len expected) (len actual))
               (= (slice-new (slice-data expected) IMAGE-ABI-HEADER)
                  (slice-new (slice-data actual) IMAGE-ABI-HEADER))
               (= (slice-new (slice-data expected) 8) "AOTCABI\0")
               (= (rt-read-u32 (slice-data expected) 8) IMAGE-ABI-VERSION)
               (= (rt-read-u32 (slice-data expected) 12) IMAGE-ABI-INTERNAL)
               (= (rt-read-u32 (slice-data expected) 16) (- (len expected) (+ IMAGE-ABI-HEADER 1))))
        (mut i) IMAGE-ABI-HEADER]
    (loop (if (or (not (load valid)) (>= (load i) (len expected))) (break 0)
              (let [want (primitive/cast i64 (get expected (load i)))
                    have (primitive/cast i64 (get actual (load i)))]
                ;; A provider may return a scalar box to a general boxed caller. Conversely,
                ;; an argument known to be a scalar box may enter a general boxed parameter.
                ;; The reverse directions could hide a managed reference from a stack map.
                (if (or (= want IMAGE-ABI-UNKNOWN) (> want IMAGE-ABI-BOXED-SCALAR)
                        (= have IMAGE-ABI-UNKNOWN) (> have IMAGE-ABI-BOXED-SCALAR)
                        (not (or (= want have)
                                 (if (= (load i) IMAGE-ABI-HEADER)
                                     (and (= want IMAGE-ABI-BOXED) (= have IMAGE-ABI-BOXED-SCALAR))
                                     (and (= want IMAGE-ABI-BOXED-SCALAR) (= have IMAGE-ABI-BOXED))))))
                    (set! (mut valid) false) 0)
                (set! (mut i) (+ (load i) 1)) (continue))))
    (load valid)))

(defn image-import-abi [(name (slice u8))] (-> (slice u8))
  (match (arena-external-named name)
    (Some [decl] (let [d decl] (image-abi-describe (.signature d) false)))
    ;; Runtime imports are resolved exclusively by this executable's fixed runtime table.
    (None [] (image-copy ""))))

(defn image-capture-mode [(platform-entry bool)] (-> CodeImage)
  (obj-symbols-build!)
  (let [a (alloc/malloc-allocator)
        map-source (gc-stackmap-bytes) shape-source (shape-table-bytes)
        maps (image-copy map-source) shapes (image-copy shape-source)
        (mut syms) (al-new [ImageSymbol] a)
        (mut fixups) (al-new [ImageFixup] a)
        (mut codes) (al-new [ImageFixup] a)
        (mut map-sites) (al-new [EncMapSite] a)
        (mut unit-sites) (al-new [EncUnitSite] a)
        (mut entry) -1 (mut i) 0]
    (alloc/free [u8] (compiler-allocator) map-source)
    (alloc/free [u8] (compiler-allocator) shape-source)
    (loop (if (>= (load i) (enc-definition-count)) (break 0)
              (do
                (push! [ImageSymbol] (mut syms)
                       (ImageSymbol :segment IMAGE-SYM-TEXT :offset (enc-definition-offset (load i))
                                    :name (image-copy (enc-definition-name (load i)))
                                    :abi (let [fun (arm64-call-node (enc-definition-source (load i)))]
                                           (image-abi-describe (.signature fun) (.process-entry fun)))))
                (if (and platform-entry (= (enc-definition-name (load i)) "main"))
                    (set! (mut entry) (enc-definition-offset (load i))) 0)
                (set! (mut i) (+ (load i) 1)) (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (heap-count)) (break 0)
              (do
                (push! [ImageSymbol] (mut syms)
                       (ImageSymbol :segment IMAGE-SYM-DATA :offset (heap-entry-offset (load i))
                                    :name (image-copy (heap-symbol (load i))) :abi (image-copy "")))
                (set! (mut i) (+ (load i) 1)) (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (macho-undefined-count)) (break 0)
              (do
                (push! [ImageSymbol] (mut syms)
                       (ImageSymbol :segment IMAGE-SYM-IMPORT :offset 0
                                    :name (image-copy (macho-undefined-name (load i)))
                                    :abi (image-import-abi (macho-undefined-name (load i)))))
                (set! (mut i) (+ (load i) 1)) (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (enc-symbol-fixup-count)) (break 0)
              (do
                (push! [ImageFixup] (mut fixups)
                       (ImageFixup :kind (enc-symbol-fixup-kind (load i))
                                   :offset (enc-symbol-fixup-offset (load i))
                                   :symbol (macho-symbol-index-for-fixup (load i))))
                (set! (mut i) (+ (load i) 1)) (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (heap-code-fixup-count)) (break 0)
              (do
                (push! [ImageFixup] (mut codes)
                       (ImageFixup :kind MACHO-RELOC-UNSIGNED64
                                   :offset (heap-code-fixup-offset (load i))
                                   :symbol (macho-code-fixup-symbol (load i))))
                (set! (mut i) (+ (load i) 1)) (continue))))
    (if (and platform-entry (< (load entry) 0)) (panic "image-capture: no platform entry") 0)
    (al-for [site (.map-sites (enc-state))] (push! [EncMapSite] (mut map-sites) site))
    (al-for [site (.unit-sites (enc-state))] (push! [EncUnitSite] (mut unit-sites) site))
    (CodeImage :text (image-copy (enc-bytes)) :data (image-copy (heap-image-bytes))
               :maps maps :shapes shapes :symbols (load syms) :fixups (load fixups)
               :code-fixups (load codes) :map-sites (load map-sites) :unit-sites (load unit-sites)
               :scripts (al-new [ImageScript] a) :realm-objects (al-new [ImageRealmObject] a)
               :entry (load entry) :installations 0)))

(defn image-capture [] (-> CodeImage) (image-capture-mode true))
(defn image-capture-unit [] (-> CodeImage) (image-capture-mode false))

(defn image-add-realm-object! [(im (ptr CodeImage)) (kind i64) (name (slice u8))
                              (offset i64) (callable bool)] (-> i64)
  (if (or (> (.installations im) 0)
          (not (or (= kind IMAGE-REALM-GLOBAL) (= kind IMAGE-REALM-INTRINSIC)))
          (if (= kind IMAGE-REALM-GLOBAL) (or (!= (len name) 0) callable) (= (len name) 0)))
      (panic "image-add-realm-object!: invalid realm identity or live installation") 0)
  (al-for [object (.realm-objects im)]
    (let [o object]
      (if (and (= (.kind o) kind) (= (.name o) name))
          (panic "image-add-realm-object!: duplicate realm identity") 0)))
  (let [(mut payload) false (mut code) false]
    (al-for [symbol (.symbols im)]
      (let [s symbol]
        (if (and (= (.segment s) IMAGE-SYM-DATA) (= (.offset s) offset))
            (set! (mut payload) true) 0)))
    (al-for [fixup (.code-fixups im)]
      (let [f fixup]
        (if (and (= (.offset f) (+ offset 16)) (>= (.symbol f) 0) (< (.symbol f) (len (.symbols im))))
            (let [s (get (.symbols im) (.symbol f))]
              (if (or (= (.segment s) IMAGE-SYM-TEXT) (= (.segment s) IMAGE-SYM-IMPORT))
                  (set! (mut code) true) 0)) 0)))
    (if (or (< offset HEAP-HEADER-BYTES) (!= (& offset 7) 0)
            (> offset (- (len (.data im)) (if callable FUNCTION-PAYLOAD-BYTES OBJECT-PAYLOAD-BYTES)))
            (not (load payload)) (and callable (not (load code))))
        (panic "image-add-realm-object!: identity does not name an object payload") 0))
  (let [data (slice-data (.data im))]
    (if (or (!= (rt-read-u64 data (- offset HEAP-HEADER-BYTES)) (if callable FUNCTION-PAYLOAD-BYTES OBJECT-PAYLOAD-BYTES))
            (!= (rt-read-u64 data (- offset 8)) SHAPE-EMPTY))
        (panic "image-add-realm-object!: incompatible object layout") 0)
    (if (and (= kind IMAGE-REALM-GLOBAL)
             (!= (rt-read-u64 data 16) (| (primitive/ishl DYNAMIC-PREFIX-OBJECT 48) offset)))
        (panic "image-add-realm-object!: global identity differs from the image root") 0))
  (push! [ImageRealmObject] (mut (.realm-objects im))
         (ImageRealmObject :kind kind :name (image-copy name) :offset offset :callable callable))
  0)

;; Capture borrows its inputs only for this call. A binding must name an exported data payload
;; whose code slot has a callable relocation; an arbitrary in-bounds byte offset is not a function.
;; CodeImage's relocation retains whether that target is local text, an import, or the invariant
;; trap for a body removed under this closed world. Capturing an object does not resurrect its body
;; or certify reuse under another caller set.
(defn image-add-script! [(im (ptr CodeImage)) (strict bool)
                         (entries (ArrayList CuScriptDecl)) (functions (ArrayList i64))] (-> i64)
  (if (> (.installations im) 0) (panic "image-add-script!: image has live installations") 0)
  (let [(mut count) 0]
    (al-for [entry entries]
      (let [e entry] (if (= (.kind e) CU-SCRIPT-FUNCTION) (set! (mut count) (+ (load count) 1)) 0)))
    (if (!= (load count) (len functions)) (panic "image-add-script!: function binding count mismatch") 0))
  (al-for [offset functions]
    (let [(mut data-symbol) false (mut code-slot) false]
      (al-for [symbol (.symbols im)]
        (let [s symbol]
          (if (and (= (.segment s) IMAGE-SYM-DATA) (= (.offset s) offset))
              (set! (mut data-symbol) true) 0)))
      (al-for [fixup (.code-fixups im)]
        (let [f fixup]
          (if (and (= (.offset f) (+ offset 16)) (>= (.symbol f) 0) (< (.symbol f) (len (.symbols im))))
              (let [s (get (.symbols im) (.symbol f))]
                (if (or (= (.segment s) IMAGE-SYM-TEXT) (= (.segment s) IMAGE-SYM-IMPORT))
                    (set! (mut code-slot) true) 0)) 0)))
      (if (or (< offset HEAP-HEADER-BYTES) (> offset (- (len (.data im)) 32))
              (!= (& offset 7) 0) (not (load data-symbol)) (not (load code-slot)))
          (panic "image-add-script!: binding does not name a function object") 0)))
  (let [declarations (cu-script-declarations-copy strict entries)
        (mut offsets) (al-new [i64] (alloc/malloc-allocator))]
    (al-for [offset functions] (push! [i64] (mut offsets) offset))
    (let [owned (al-into-slice (mut offsets))]
      (push! [ImageScript] (mut (.scripts im))
             (ImageScript :declarations declarations :functions owned :initializer -1))))
  0)

(defn image-bind-script-initializer! [(im (ptr CodeImage)) (script i64) (name (slice u8))] (-> i64)
  (if (or (> (.installations im) 0) (< script 0) (>= script (len (.scripts im))))
      (panic "image-bind-script-initializer!: invalid Script or live installation") 0)
  (let [(mut found) -1 (mut i) 0 record (get (.scripts im) script)]
    (if (!= (.initializer record) -1) (panic "image-bind-script-initializer!: Script already bound") 0)
    (al-for [symbol (.symbols im)]
      (let [s symbol]
        (if (and (= (.segment s) IMAGE-SYM-TEXT) (= (.name s) name))
            (do (if (>= (load found) 0) (panic "image-bind-script-initializer!: ambiguous text symbol") 0)
                (if (not (image-abi-script-entry? (.abi s)))
                    (panic "image-bind-script-initializer!: initializer lacks the generic Script ABI") 0)
                (set! (mut found) (load i))) 0)
        (set! (mut i) (+ (load i) 1))))
    (if (< (load found) 0) (panic "image-bind-script-initializer!: missing text symbol") 0)
    (set! (mut (.scripts im)) script
          (ImageScript :declarations (.declarations record) :functions (.functions record) :initializer (load found))))
  0)

;; Validate the serialized generic entry contract without consulting compiler-generation types.
;; Result is a completion box; arguments are callee/this/new.target boxes, count, managed
;; overflow vector and three direct boxed arguments (callable ABI version 2).
(defn image-abi-script-entry? [(abi (slice u8))] (-> bool)
  (and (= (len abi) (+ IMAGE-ABI-HEADER 9))
       (= (slice-new (slice-data abi) 8) "AOTCABI\0")
       (= (rt-read-u32 (slice-data abi) 8) IMAGE-ABI-VERSION)
       (= (rt-read-u32 (slice-data abi) 12) IMAGE-ABI-INTERNAL)
       (= (rt-read-u32 (slice-data abi) 16) 8)
       (or (= (primitive/cast i64 (get abi 20)) IMAGE-ABI-BOXED)
           (= (primitive/cast i64 (get abi 20)) IMAGE-ABI-BOXED-SCALAR))
       (= (primitive/cast i64 (get abi 21)) IMAGE-ABI-BOXED)
       (= (primitive/cast i64 (get abi 22)) IMAGE-ABI-BOXED)
       (= (primitive/cast i64 (get abi 23)) IMAGE-ABI-BOXED)
       (= (primitive/cast i64 (get abi 24)) IMAGE-ABI-INTEGER)
       (= (primitive/cast i64 (get abi 25)) IMAGE-ABI-MANAGED)
       (= (primitive/cast i64 (get abi 26)) IMAGE-ABI-BOXED)
       (= (primitive/cast i64 (get abi 27)) IMAGE-ABI-BOXED)
       (= (primitive/cast i64 (get abi 28)) IMAGE-ABI-BOXED)))

(defn image-free! [(im (ptr CodeImage))] (-> i64)
  (if (> (.installations im) 0) (panic "image-free!: image has live installations") 0)
  (let [a (alloc/malloc-allocator)]
    (al-for [script (.scripts im)]
      (let [(mut s) script]
        (cu-script-declarations-free! (mut (.declarations (mut s))))
        (alloc/free [i64] a (.functions (mut s)))))
    (al-free! (mut (.scripts im)))
    (al-for [object (.realm-objects im)] (let [o object] (alloc/free [u8] a (.name o))))
    (al-free! (mut (.realm-objects im)))
    (al-for [symbol (.symbols im)]
      (let [s symbol] (alloc/free [u8] a (.name s)) (alloc/free [u8] a (.abi s))))
    (alloc/free [u8] a (.text im)) (alloc/free [u8] a (.data im))
    (alloc/free [u8] a (.maps im)) (alloc/free [u8] a (.shapes im))
    (al-free! (mut (.symbols im))) (al-free! (mut (.fixups im)))
    (al-free! (mut (.code-fixups im)))
    (al-free! (mut (.map-sites im)))
    (al-free! (mut (.unit-sites im)))
    (set! im (primitive/zeroed CodeImage))
    0))

(defstruct InstalledImage
  [(text (ptr u8)) (text-bytes u64) (entry i64) (code-id i64)
   (owner (ptr CodeImage)) (imports (ArrayList i64)) (dependencies (ArrayList i64))])

;; Bindings borrow their spelling only for installation. The installer copies resolved addresses
;; and pins providers by registered code identity, never retaining caller-owned binding storage.
(defstruct ImageBinding [(name (slice u8)) (address i64) (provider i64) (abi (slice u8))])

(defn image-export-binding [(im (ptr CodeImage)) (loaded (ptr InstalledImage))
                           (export-name (slice u8)) (import-name (slice u8))] (-> ImageBinding)
  (if (or (!= im (.owner loaded)) (= (.code-id loaded) 0) (= (len import-name) 0))
      (panic "image-export-binding: invalid installation or import name") 0)
  (let [(mut found) -1 (mut i) 0]
    (al-for [symbol (.symbols im)]
      (let [s symbol]
        (if (and (= (.segment s) IMAGE-SYM-TEXT) (= (.name s) export-name))
            (do (if (>= (load found) 0) (panic "image-export-binding: ambiguous export name") 0)
                (set! (mut found) (load i)) 0) 0)
        (set! (mut i) (+ (load i) 1))))
    (if (< (load found) 0) (panic "image-export-binding: missing export") 0)
    (let [symbol (get (.symbols im) (load found))]
      (ImageBinding :name import-name :address (image-address im loaded (load found))
                    :provider (.code-id loaded) :abi (.abi symbol)))))

(defn image-script-initializer-binding [(im (ptr CodeImage)) (loaded (ptr InstalledImage))
                                        (script i64) (import-name (slice u8))] (-> ImageBinding)
  (if (or (< script 0) (>= script (len (.scripts im))))
      (panic "image-script-initializer-binding: unknown Script") 0)
  (let [record (get (.scripts im) script) index (.initializer record)]
    (if (or (< index 0) (>= index (len (.symbols im))))
        (panic "image-script-initializer-binding: Script has no retained initializer") 0)
    (let [symbol (get (.symbols im) index)]
      (if (not (image-abi-script-entry? (.abi symbol)))
          (panic "image-script-initializer-binding: invalid initializer ABI") 0)
      (image-export-binding im loaded (.name symbol) import-name))))

(defn image-address [(im (ptr CodeImage)) (loaded (ptr InstalledImage)) (symbol i64)] (-> i64)
  (if (or (< symbol 0) (>= symbol (len (.symbols im))))
      (panic "image-address: invalid symbol index") 0)
  (let [s (get (.symbols im) symbol)]
    (case (.segment s)
      IMAGE-SYM-TEXT (+ (primitive/cast i64 (.text loaded)) (.offset s))
      IMAGE-SYM-DATA (panic "image-address: static data requires a realm unit binding")
      IMAGE-SYM-IMPORT (get (.imports loaded) symbol)
      (panic "image-address: invalid symbol segment"))))

(defn image-put4! [(base (ptr u8)) (offset i64) (bits i64)] (-> i64)
  (set! (primitive/cast (ptr u32) (primitive/index base offset)) (primitive/cast u32 bits))
  0)

(defn image-map-token-word [(token i64) (reg i64) (word i64)] (-> i64)
  (if (or (< token 0) (< reg 0) (> reg 30) (< word 0) (> word 3))
      (panic "image-map-token-word: invalid token, register or word") 0)
  (| (if (= word 0) 0xd2800000 0xf2800000)
     (| (primitive/ishl word 21)
        (| (primitive/ishl (& (primitive/ishr token (* word 16)) 0xffff) 5) reg))))

(defn image-install-map-tokens! [(im (ptr CodeImage)) (loaded (ptr InstalledImage))] (-> i64)
  (al-for [site (.map-sites im)]
    (let [s site token (rt-map-token (.code-id loaded) (.local-id s)) (mut word) 0]
      (if (or (< (.offset s) 0) (> (.offset s) (- (len (.text im)) 16))
              (< (rt-stackmap-find (slice-data (.maps im)) (len (.maps im)) (.local-id s)) 0))
          (panic "image-install-map-tokens!: map relocation has no code or metadata") 0)
      (loop (if (>= (load word) 4) (break 0)
                (let [offset (+ (.offset s) (* (load word) 4))
                      original (primitive/cast i64 (load (primitive/cast (ptr u32)
                                  (primitive/index (.text loaded) offset))))]
                  (if (!= original (image-map-token-word (.local-id s) (.reg s) (load word)))
                      (panic "image-install-map-tokens!: unexpected instruction sequence") 0)
                  (image-put4! (.text loaded) offset (image-map-token-word token (.reg s) (load word)))
                  (set! (mut word) (+ (load word) 1)) (continue))))))
  0)

;; Pure instruction relocation, separately tested at positive/negative range boundaries.
(defn image-relocate-word [(kind i64) (word i64) (pc i64) (target i64)] (-> i64)
  (case kind
    ENC-FIXUP-A64-BL26
    (let [delta (- target pc)]
      (if (or (!= (% delta 4) 0) (< delta -134217728) (>= delta 134217728))
          (panic "image-relocate-word: BL26 out of range") 0)
      (| (& word 0xfc000000) (& (primitive/ishr delta 2) 0x03ffffff)))
    ENC-FIXUP-A64-PAGE21
    (let [pages (primitive/ishr (- (& target -4096) (& pc -4096)) 12)]
      (if (or (< pages -1048576) (>= pages 1048576))
          (panic "image-relocate-word: ADRP out of range") 0)
      (| (& word 0x9f00001f)
         (| (primitive/ishl (& pages 3) 29)
            (primitive/ishl (& (primitive/ishr pages 2) 0x7ffff) 5))))
    ENC-FIXUP-A64-PAGEOFF12
    (| (& word 0xffc003ff) (primitive/ishl (& target 4095) 10))
    (panic "image-relocate-word: unknown fixup")))

(defstruct ImageImports [(addresses (ArrayList i64)) (dependencies (ArrayList i64))])

(defn image-resolve-imports [(im (ptr CodeImage)) (bindings (ArrayList ImageBinding))] (-> ImageImports)
  (let [(mut addresses) (al-new [i64] (alloc/malloc-allocator))
        (mut dependencies) (al-new [i64] (alloc/malloc-allocator)) (mut index) 0]
    ;; Validate explicit bindings before executable allocation or provider pinning.
    (al-for [binding bindings]
      (let [b binding (mut matches) 0 (mut prior) 0]
        (if (!= (rt-symbol-lookup (.name b)) 0) (panic "image-resolve-imports: runtime symbol cannot be rebound") 0)
        (match (rt-code-find (.provider b))
          (Some [range]
            (let [r range]
              (if (or (< (.address b) (.text r)) (>= (- (.address b) (.text r)) (.text-bytes r)))
                  (panic "image-resolve-imports: binding is outside its provider") 0)))
          (None [] (panic "image-resolve-imports: provider is no longer installed")))
        (loop (if (>= (load prior) (load index)) (break 0)
                  (let [p (get bindings (load prior))]
                    (if (= (.name p) (.name b)) (panic "image-resolve-imports: duplicate binding") 0)
                    (set! (mut prior) (+ (load prior) 1)) (continue))))
        (al-for [symbol (.symbols im)]
          (let [s symbol]
            (if (and (= (.segment s) IMAGE-SYM-IMPORT) (= (.name s) (.name b)))
                (do (if (not (image-abi-compatible? (.abi s) (.abi b)))
                        (panic "image-resolve-imports: incompatible callable ABI") 0)
                    (set! (mut matches) (+ (load matches) 1))) 0)))
        (if (!= (load matches) 1) (panic "image-resolve-imports: binding must name one import") 0)
        (set! (mut index) (+ (load index) 1))))
    (al-for [symbol (.symbols im)]
      (let [s symbol (mut address) 0]
        (if (= (.segment s) IMAGE-SYM-IMPORT)
            (do
              (al-for [binding bindings]
                (let [b binding]
                  (if (= (.name b) (.name s))
                      (do (set! (mut address) (.address b))
                          (push! [i64] (mut dependencies) (.provider b)) 0) 0)))
              (if (= (load address) 0)
                  (do
                    (if (> (len (.abi s)) 0) (panic "image-resolve-imports: declared unit import requires a provider binding") 0)
                    (set! (mut address) (rt-symbol-address (.name s)))) 0))
            0)
        (push! [i64] (mut addresses) (load address))))
    (ImageImports :addresses (load addresses) :dependencies (load dependencies))))

(defn image-unit-identity-count [(im (ptr CodeImage)) (kind i64)] (-> i64)
  (if (not (or (= kind ENC-UNIT-KEY) (= kind ENC-UNIT-SHAPE)))
      (panic "image-unit-identity-count: unknown identity kind") 0)
  (let [blob (.shapes im)]
    (if (= (len blob) 0)
        (if (= kind ENC-UNIT-KEY) 1 2)
        (let [p (slice-data blob)]
          (if (or (< (len blob) SHAPES-HEADER-BYTES) (not (shapes-blob-magic? p)))
              (panic "image-unit-identity-count: invalid unit namespace header") 0)
          (let [shapes (rt-read-u32 p 12) keys (rt-read-u32 p 16) names (rt-read-u32 p 20)]
            (if (or (!= (rt-read-u32 p 8) SHAPES-VERSION) (< shapes 2) (< keys 1)
                    (!= (+ (+ (+ SHAPES-HEADER-BYTES (* shapes SHAPES-RECORD-BYTES))
                               (* keys SHAPES-KEY-RECORD-BYTES)) names) (len blob)))
                (panic "image-unit-identity-count: invalid unit namespace extent") 0)
            (if (= kind ENC-UNIT-KEY) keys shapes))))))

(defn image-install-unit-sites! [(im (ptr CodeImage)) (loaded (ptr InstalledImage))] (-> i64)
  (let [slot (rt-code-unit-slot (.code-id loaded))]
    (if (or (<= slot 0) (> slot RT-CODE-ID-LIMIT))
        (panic "image-install-unit-sites!: installation slot outside the ABI") 0)
    (al-for [site (.unit-sites im)]
      (let [s site off (.offset s) reg (.reg s)]
        (if (or (< reg 0) (> reg 30) (= reg 28))
            (panic "image-install-unit-sites!: invalid slot scratch register") 0)
        (if (= (.kind s) ENC-UNIT-DATA)
            (if (or (< (len (.data im)) 32) (< (.local-id s) 0)
                    (>= (.local-id s) (rt-read-u32 (slice-data (.data im)) 12)))
                (panic "image-install-unit-sites!: static identity outside the unit image") 0)
            (let [count (image-unit-identity-count im (.kind s))]
              (if (or (<= (.local-id s) 0) (>= (.local-id s) count))
                  (panic "image-install-unit-sites!: identity outside the unit namespace") 0)))
        (if (or (< off 0) (> off (- (len (.text im)) 8)) (!= (% off 4) 0))
            (panic "image-install-unit-sites!: relocation outside text") 0)
        (if (or (!= (rt-read-u32 (slice-data (.text im)) off) (| 0xd2800000 reg))
                (!= (rt-read-u32 (slice-data (.text im)) (+ off 4)) (| 0xf2a00000 reg)))
            (panic "image-install-unit-sites!: relocation is not the reserved slot sequence") 0)
        (image-put4! (.text loaded) off (| (| 0xd2800000 reg) (primitive/ishl (& slot 0xffff) 5)))
        (image-put4! (.text loaded) (+ off 4) (| (| 0xf2a00000 reg) (primitive/ishl (primitive/ishr slot 16) 5)))))
    0))

(defn image-install-bound [(im (ptr CodeImage)) (bindings (ArrayList ImageBinding))] (-> InstalledImage)
  (if (.booted (rt-heap)) (panic "image-install-bound: a realm is active") 0)
  (let [text-bytes (obj-align-up (+ (obj-align-up (len (.text im)) 8)
                                    (* (len (.symbols im)) 16)) 16384)]
    (if (> text-bytes IMAGE-TEXT-LIMIT)
        (panic "image-install: text and veneers exceed the 64MiB image limit") 0)
    (let [imports (image-resolve-imports im bindings)
          text (mmap (primitive/cast (ptr u8) 0) (primitive/cast u64 text-bytes)
                     (primitive/cast i32 IMAGE-PROT-RWX)
                     (primitive/cast i32 (| IMAGE-MAP-PRIVATE-ANON IMAGE-MAP-JIT)) -1 0)
          loaded (primitive/alloc-stack InstalledImage)
          veneer-start (obj-align-up (len (.text im)) 8)]
      (set! loaded (InstalledImage :text text :text-bytes (primitive/cast u64 text-bytes)
                                  :entry (if (< (.entry im) 0) 0 (+ (primitive/cast i64 text) (.entry im)))
                                  :code-id 0 :owner im
                                  :imports (.addresses imports) :dependencies (.dependencies imports)))
      (if (= (primitive/cast i64 text) -1)
          (panic "image-install: executable mapping failed") 0)
      (set! (.code-id loaded)
            (rt-code-register-identities! (primitive/cast i64 text) (len (.text im))
                                          (slice-data (.maps im)) (len (.maps im))
                                          (image-unit-identity-count im ENC-UNIT-KEY)
                                          (image-unit-identity-count im ENC-UNIT-SHAPE)))
      (al-for [provider (.dependencies loaded)] (rt-code-pin! provider true))
      (set! (.installations im) (+ (.installations im) 1))
      (pthread_jit_write_protect_np 0)
      (mem/mem-copy [u8] text (slice-data (.text im)) (len (.text im)))
      (image-install-map-tokens! im loaded)
      (image-install-unit-sites! im loaded)
      (let [(mut i) 0]
        (al-for [s (.symbols im)]
          (let [symbol s offset (+ veneer-start (* (load i) 16))]
            ;; ldr x16,pc+8; br x16; absolute target. BR preserves the original BL's LR.
            (if (= (.segment symbol) IMAGE-SYM-DATA)
                ;; Data symbols have no process address and cannot be branch targets.
                (image-put4! text offset 0xd4200000)
                (do (image-put4! text offset 0x58000050)
            (image-put4! text (+ offset 4) 0xd61f0200)
            (set! (primitive/cast (ptr i64) (primitive/index text (+ offset 8)))
                  (image-address im loaded (load i))) 0))
            (set! (mut i) (+ (load i) 1)))))
      (al-for [fixup (.fixups im)]
        (let [f fixup pc (+ (primitive/cast i64 text) (.offset f))
              target (image-address im loaded (.symbol f))
              branch-target
                (if (and (= (.kind f) ENC-FIXUP-A64-BL26)
                         (or (< (- target pc) -134217728) (>= (- target pc) 134217728)))
                    (+ (primitive/cast i64 text) (+ veneer-start (* (.symbol f) 16)))
                    target)]
          (if (or (< (.offset f) 0) (> (+ (.offset f) 4) (len (.text im))))
              (panic "image-install: code relocation outside text") 0)
          (image-put4! text (.offset f)
                       (image-relocate-word (.kind f)
                         (primitive/cast i64 (load (primitive/cast (ptr u32) (primitive/index text (.offset f)))))
                         pc branch-target))))
      (sys_icache_invalidate text (primitive/cast u64 text-bytes))
      (pthread_jit_write_protect_np 1)
      (load loaded))))

(defn image-install [(im (ptr CodeImage))] (-> InstalledImage)
  (let [(mut bindings) (al-new [ImageBinding] (alloc/malloc-allocator))
        loaded (image-install-bound im (load bindings))]
    (al-free! (mut bindings))
    loaded))

(defn image-uninstall! [(loaded (ptr InstalledImage))] (-> i64)
  (rt-code-unregister! (.code-id loaded))
  (al-for [provider (.dependencies loaded)] (rt-code-pin! provider false))
  (if (!= (munmap (.text loaded) (.text-bytes loaded)) (primitive/cast i32 0))
      (panic "image-uninstall!: munmap failed") 0)
  (set! (.installations (.owner loaded)) (- (.installations (.owner loaded)) 1))
  (al-free! (mut (.imports loaded)))
  (al-free! (mut (.dependencies loaded)))
  (set! loaded (primitive/zeroed InstalledImage))
  0)

(defn image-require-installed! [(loaded (ptr InstalledImage))] (-> i64)
  (match (rt-code-find (.code-id loaded))
    (Some [range]
      (let [r range]
        (if (!= (.text r) (primitive/cast i64 (.text loaded)))
            (panic "image-require-installed!: installation does not own its code range") 0)))
    (None [] (panic "image-require-installed!: code is not installed"))))

(defn image-instantiate-data [(loaded (ptr InstalledImage))] (-> (slice u8))
  (if (.booted (rt-heap)) (panic "image-instantiate-data: a realm is active") 0)
  (image-require-installed! loaded)
  (let [im (.owner loaded) data (image-copy (.data im))]
    (al-for [site (.unit-sites im)]
      (let [s site]
        (if (and (= (len data) 0) (= (.kind s) ENC-UNIT-DATA))
            (panic "image-instantiate-data: static references require a data image") 0)))
    (al-for [fixup (.code-fixups im)]
      (let [f fixup]
        (if (or (< (.offset f) 0) (> (.offset f) (- (len data) 8)))
            (panic "image-instantiate-data: code pointer outside data") 0)
        (set! (primitive/cast (ptr i64) (primitive/index (slice-data data) (.offset f)))
              (image-address im loaded (.symbol f)))))
    data))

(defn image-program-has-code? [(units (ArrayList (ptr InstalledImage))) (id i64)] (-> bool)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len units)) (break false)
              (let [unit (get units (load i))]
                (if (= (.code-id unit) id) (break true)
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

;; A native program supplies its complete installed closure. Assemble the unit namespaces in the
;; supplied order, then remap only fresh data copies and bind the corresponding immutable maps.
;; Realm copies and their roots die after return; installed text and symbolic artifacts survive.
(defn image-run-program! [(loaded (ptr InstalledImage)) (units (ArrayList (ptr InstalledImage)))] (-> i64)
  (image-run-program-mode! loaded units false))

;; Shared source composition is explicit: ordinary native programs keep their private image
;; semantics. Only retained external-boundary Scripts authorize realm object unification.
(defn image-run-shared-program! [(loaded (ptr InstalledImage)) (units (ArrayList (ptr InstalledImage)))] (-> i64)
  (image-run-program-mode! loaded units true))

(defstruct ImageRealmTarget [(address i64) (callable bool)])

(defn image-shared-object! [(index (mut (HashMap (slice u8) ImageRealmTarget)))
                            (object ImageRealmObject) (copy (slice u8))
                            (bindings (mut (ArrayList RtObjectBinding)))] (-> i64)
  (let [address (+ (primitive/cast i64 (slice-data copy)) (.offset object))]
    (match (get (load index) (.name object))
      (Some [prior]
        (let [p prior]
          (if (!= (.callable p) (.callable object))
              (panic "image-shared-object!: conflicting intrinsic object kinds") 0)
          (push! [RtObjectBinding] (mut bindings) (RtObjectBinding :source address :target (.address p)))
          (if (= (.kind object) IMAGE-REALM-GLOBAL)
              (set! (primitive/cast (ptr i64) (primitive/index (slice-data copy) 16)) 0) 0)))
      (None [] (do (set! (mut index) (.name object) (ImageRealmTarget :address address :callable (.callable object))) 0)))
    0))

;; Simple has no native realms. We assemble identities by owned semantic name, separately from
;; code symbols and unit-local offsets. First occurrence supplies the canonical payload; the
;; runtime validates and merges initial property sets after rewriting all template references.
;; No closed-world artifact can enter this path merely because its native ABI happens to match.
(defn image-shared-bindings [(units (ArrayList (ptr InstalledImage))) (copies (ArrayList (slice u8)))]
                            (-> (ArrayList RtObjectBinding))
  (let [a (alloc/malloc-allocator)
        (mut named) (hm-new [(slice u8) ImageRealmTarget] a (str-keyops-borrowed))
        (mut bindings) (al-new [RtObjectBinding] a) (mut i) 0]
    (al-for [unit units]
      (let [im (.owner unit) copy (get copies (load i))]
        (if (= (len (.realm-objects im)) 0)
            (if (and (> (len copy) 0) (!= (rt-read-u64 (slice-data copy) 16) 0))
                (panic "image-shared-bindings: unnamed image cannot publish the shared global") 0)
            (do
              (if (= (len (.scripts im)) 0) (panic "image-shared-bindings: realm identities require retained Scripts") 0)
              (al-for [script (.scripts im)]
                (let [s script]
                  (if (< (.initializer s) 0) (panic "image-shared-bindings: closed-world Script cannot share its realm") 0)
                  (al-for [declaration (.entries (.declarations s))]
                    (let [d declaration]
                      (if (not (or (= (.kind d) CU-SCRIPT-VAR) (= (.kind d) CU-SCRIPT-FUNCTION)
                                   (= (.kind d) CU-SCRIPT-PROPERTY-WRITE)
                                   (= (.kind d) CU-SCRIPT-LET) (= (.kind d) CU-SCRIPT-CONST)))
                          (unimplemented "shared Script lexical environments" "docs/GAPS.md — lexical environments and closures") 0)))))
              (al-for [object (.realm-objects im)]
                (let [o object]
                  (image-shared-object! (mut named) o copy (mut bindings))))
              0))
        (set! (mut i) (+ (load i) 1))))
    (if (not (hm-contains? (load named) "")) (panic "image-shared-bindings: missing shared global") 0)
    (hm-free! (mut named))
    (load bindings)))

(defn image-run-program-mode! [(loaded (ptr InstalledImage)) (units (ArrayList (ptr InstalledImage)))
                               (shared bool)] (-> i64)
  (if (.booted (rt-heap)) (panic "image-run-program!: another realm is active") 0)
  (image-require-installed! loaded)
  (if (or (= (.entry loaded) 0) (not (image-program-has-code? units (.code-id loaded))))
      (panic "image-run-program!: missing platform entry installation") 0)
  (let [im (.owner loaded) (mut i) 0]
    (al-for [unit units]
      (image-require-installed! unit)
      (al-for [dep (.dependencies unit)]
        (if (not (image-program-has-code? units dep))
            (panic "image-run-program!: missing imported code installation") 0))
      (let [(mut j) 0]
        (loop (if (>= (load j) (load i)) (break 0)
                  (let [previous (get units (load j))]
                    (if (= (.code-id previous) (.code-id unit))
                        (panic "image-run-program!: duplicate code installation") 0)
                    (set! (mut j) (+ (load j) 1)) (continue)))))
      (set! (mut i) (+ (load i) 1)))
    (let [a (alloc/malloc-allocator) assembly (primitive/alloc-stack CuShapeAssembly)
          (mut blobs) (al-new [(slice u8)] a) (mut primary) -1
          (mut copies) (al-new [(slice u8)] a) (mut descriptors) (al-new [RtProgramUnit] a)]
      (al-for [unit units] (push! [(slice u8)] (mut blobs) (.shapes (.owner unit))))
      (set! assembly (cu-shapes-compose (load blobs)))
      (al-free! (mut blobs))
      (set! (mut i) 0)
      (al-for [unit units]
        (let [copy (image-instantiate-data unit) map (get (.units assembly) (load i))]
          (cu-remap-static-shapes! copy map)
          (push! [(slice u8)] (mut copies) copy)
          (if (= (.code-id unit) (.code-id loaded))
              (set! (mut primary) (load i))
              (push! [RtProgramUnit] (mut descriptors)
                     (RtProgramUnit :code-id (.code-id unit) :image (slice-data copy) :image-bytes (len copy)
                                    :keys (.keys map) :shape-ids (.shapes map))))
          (set! (mut i) (+ (load i) 1))))
      (if (< (load primary) 0) (panic "image-run-program!: entry lost during assembly") 0)
      (let [data (get (load copies) (load primary)) map (get (.units assembly) (load primary))
            (mut bindings) (if shared (image-shared-bindings units (load copies)) (al-new [RtObjectBinding] a))]
        (set! (rt-program)
              (RtProgram :text (.text loaded) :text-bytes (primitive/cast u64 (len (.text im)))
                         :maps (slice-data (.maps im)) :map-bytes (primitive/cast u64 (len (.maps im)))
                         :shapes (slice-data (.blob assembly)) :shape-bytes (primitive/cast u64 (len (.blob assembly)))
                         :image (if (= (len data) 0) (primitive/cast (ptr u8) 0) (slice-data data))
                         :image-bytes (primitive/cast u64 (len data))
                         :code-id (.code-id loaded) :units (al-slice (load descriptors))
                         :keys (.keys map) :shape-ids (.shapes map)
                         :object-bindings (al-slice (load bindings))
                         :object-property-merges (al-slice (load bindings))))
      (let [entry (primitive/cast (fnptr c [] i64) (primitive/cast (ptr u8) (.entry loaded)))
            result (primitive/call-ptr entry)]
        (rt-realm-destroy!)
        (al-free! (mut bindings))
        (al-for [copy (load copies)] (alloc/free [u8] a copy))
        (al-free! (mut copies)) (al-free! (mut descriptors))
        (cu-shapes-free! assembly)
        result)))))

(defn image-run! [(im (ptr CodeImage)) (loaded (ptr InstalledImage))] (-> i64)
  (if (!= im (.owner loaded)) (panic "image-run!: wrong artifact") 0)
  (let [(mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
    (push! [(ptr InstalledImage)] (mut units) loaded)
    (let [result (image-run-program! loaded (load units))]
      (al-free! (mut units)) result)))
