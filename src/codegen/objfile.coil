;; Object files: Mach-O and ELF, written byte by byte.

;;
;; Per CLAUDE.md's second rule there is no C here and no library doing this for us: the bytes are
;; ours. `cc` is invoked as a LINKER over the object we produce, never as a compiler for our code.
;;
;; Beyond the minimum, this must emit multiple function symbols, internal and runtime relocations,
;; function sizes, and the stack-map section the collector reads.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S7.
(module aot.codegen.objfile)
(import "aot.util.panic" :use *)

(defn macho-write [(path (slice u8))] (-> i64)
  (do (unimplemented "macho-write" "S7 — src/codegen/objfile.coil") 0))

(defn elf-write [(path (slice u8))] (-> i64)
  (do (unimplemented "elf-write" "S7 — src/codegen/objfile.coil") 0))
