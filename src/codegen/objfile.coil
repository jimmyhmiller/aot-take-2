;; Object files, written byte-by-byte from final encoding state.

;;
;; Final Simple constructs sections, symbols and relocations before freezing offsets. We preserve
;; that order and never depend on host struct layout. Mach-O comes first for the arm64 host: a real
;; MH_OBJECT with one `__TEXT,__text` section, external definitions, undefined targets, and
;; ARM64_RELOC_BRANCH26 records. ELF follows from the same generic records.
(module aot.codegen.objfile)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.str" :use [str-keyops str-keyops-borrowed])
(import "coil.fs" :as fs)
(import "coil.slice" :use [slice-new])
(import "coil.subprocess" :as subprocess)
(import "aot.util.panic" :use *)
(import "aot.codegen.encoding" :use *)
(import "aot.codegen.gcmeta" :use *)
(import "aot.shape" :use [shape-table-bytes SHAPE-STRING])
(import "aot.codegen.codegen"
        :use
        [code-string-count
         code-string-units
         code-string-symbol
         code-string-index-of-symbol
         code-string-offset
         code-string-table-bytes])

(const MACHO-SEGMENT-SIZE 152)

(const MACHO-SYMTAB-SIZE 24)

(const MACHO-BUILD-VERSION-SIZE 24)

(const MACHO-DATA-OFFSET 232)

(defn obj-put1! [(out (mut (ArrayList u8))) (v i64)] (-> i64)
  (do (push! [u8] (mut out) (primitive/cast u8 v)) 0))

(defn obj-put2! [(out (mut (ArrayList u8))) (v i64)] (-> i64)
  (do (obj-put1! (mut out) v) (obj-put1! (mut out) (primitive/ishr v 8)) 0))

(defn obj-put4! [(out (mut (ArrayList u8))) (v i64)] (-> i64)
  (do (obj-put2! (mut out) v) (obj-put2! (mut out) (primitive/ishr v 16)) 0))

(defn obj-put8! [(out (mut (ArrayList u8))) (v i64)] (-> i64)
  (do (obj-put4! (mut out) v) (obj-put4! (mut out) (primitive/ishr v 32)) 0))

(defn obj-put-slice! [(out (mut (ArrayList u8))) (bytes (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len bytes))
              (break 0)
              (do
                (obj-put1! (mut out) (primitive/cast i64 (get bytes (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))))

(defn obj-put-name16! [(out (mut (ArrayList u8))) (name (slice u8))] (-> i64)
  (let [(mut i) 0]
    (if (> (len name) 16)
        (panic "obj-put-name16!: Mach-O name exceeds 16 bytes")
        0)
    (loop (if (>= (load i) 16)
              (break 0)
              (do
                (obj-put1! (mut out)
                           (if (< (load i) (len name))
                               (primitive/cast i64 (get name (load i)))
                               0))
                (set! (mut i) (+ (load i) 1))
                (continue))))))

(defn obj-pad-to! [(out (mut (ArrayList u8))) (offset i64)] (-> i64)
  (do
    (if (> (len (load out)) offset)
        (panic-i "obj-pad-to!: offset already passed" offset)
        0)
    (loop (if (>= (len (load out)) offset)
              (break 0)
              (do (obj-put1! (mut out) 0) (continue))))))

(defn macho-relocation-bits [(kind i64)] (-> i64)
  (if (= kind ENC-FIXUP-A64-BL26)
      0x2d000000
      (if (= kind ENC-FIXUP-A64-PAGE21)
          0x3d000000
          (if (= kind ENC-FIXUP-A64-PAGEOFF12)
              0x4c000000
              (do
                (panic-i "macho-relocation-bits: unsupported fixup kind" kind)
                0)))))

(defn elf-relocation-type [(kind i64)] (-> i64)
  ;; R_AARCH64_CALL26, R_AARCH64_ADR_PREL_PG_HI21, R_AARCH64_ADD_ABS_LO12_NC.
  (if (= kind ENC-FIXUP-A64-BL26)
      283
      (if (= kind ENC-FIXUP-A64-PAGE21)
          275
          (if (= kind ENC-FIXUP-A64-PAGEOFF12)
              277
              (do
                (panic-i "elf-relocation-type: unsupported fixup kind" kind)
                0)))))

;; ---------------------------------------------------------------------------
;; The object's symbol table, resolved once per write.
;;
;; Symbol numbering: text definitions first (their encoder order), then the string literals
;; (`__aot_strings`, table order), then every undefined target once, in first-appearance order.
;; Every fixup is resolved to its symbol index exactly once here, through hash lookups; the writers
;; then read the answers. Resolving per relocation by scanning definitions, strings and earlier
;; fixups made object writing quadratic in the relocation count.
;;
;; A nonnegative fidx is the closed-world identity and must never fall back to spelling: after a
;; graph-copy or lifecycle bug, name fallback can bind a call to a different definition and turn
;; corrupted metadata into a silent miscompile. A fidx with no definition in this object names a
;; function compiled elsewhere (the runtime's JSL) and is undefined here by its symbol name; only
;; explicit externs (fidx -1) resolve a definition by symbol.
(defstruct ObjSymbols
  [(booted bool)
   (fixup-symbol (ArrayList i64))  ; per fixup: its symbol index
   (undefined-names (ArrayList (slice u8)))])  ; deduplicated, first appearance first

(defn obj-symbols [] (-> (ptr ObjSymbols))
  (let [t (primitive/alloc-static ObjSymbols)]
    (if (.booted t)
        t
        (let [a (alloc/malloc-allocator)]
          (set! (.fixup-symbol t) (al-new [i64] a))
          (set! (.undefined-names t) (al-new [(slice u8)] a))
          (set! (.booted t) true)
          t))))

(defn obj-symbols-build! [] (-> i64)
  (let [a (alloc/malloc-allocator)
        t (obj-symbols)
        ndefs (enc-definition-count)
        nstrings (code-string-count)
        (mut def-by-fidx) (hm-new [i64 i64] a (i64-keyops))
        (mut def-by-name) (hm-new [(slice u8) i64] a (str-keyops-borrowed))
        (mut string-by-name) (hm-new [(slice u8) i64] a (str-keyops))
        (mut undefined-by-name)
          (hm-new [(slice u8) i64] a (str-keyops-borrowed))
        (mut i) 0]
    (al-clear! [i64] (mut (.fixup-symbol t)))
    (al-clear! [(slice u8)] (mut (.undefined-names t)))
    (loop (if (>= (load i) ndefs)
              (break 0)
              (do
                (if (>= (enc-definition-fidx (load i)) 0)
                    (do
                      (set! (mut def-by-fidx)
                            (enc-definition-fidx (load i))
                            (load i))
                      0)
                    0)
                (set! (mut def-by-name) (enc-definition-name (load i)) (load i))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) nstrings)
              (break 0)
              (do
                (set! (mut string-by-name)
                      (code-string-symbol (load i))
                      (load i))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (enc-symbol-fixup-count))
              (break 0)
              (let [fidx (enc-symbol-fixup-fidx (load i))
                    name (enc-symbol-fixup-name (load i))
                    defined
                      (if (>= fidx 0)
                          (match (get (load def-by-fidx) fidx)
                            (Some [d] d)
                            (None [] -1))
                          (match (get (load def-by-name) name)
                            (Some [d] d)
                            (None [] -1)))
                    string-index
                      (if (>= fidx 0)
                          -1
                          (match (get (load string-by-name) name)
                            (Some [k] k)
                            (None [] -1)))
                    symbol
                      (if (>= defined 0)
                          defined
                          (if (>= string-index 0)
                              (+ ndefs string-index)
                              (+ ndefs
                                 (+ nstrings
                                    (match (get (load undefined-by-name) name)
                                      (Some [k] k)
                                      (None []
                                            (let [k (len (.undefined-names t))]
                                              (push! [(slice u8)]
                                                     (mut (.undefined-names t))
                                                     name)
                                              (set! (mut undefined-by-name)
                                                    name
                                                    k)
                                              k)))))))]
                (push! [i64] (mut (.fixup-symbol t)) symbol)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

;; The Mach-O symbol index a fixup relocates against.
(defn macho-symbol-index-for-fixup [(fixup i64)] (-> i64)
  (get (.fixup-symbol (obj-symbols)) fixup))

(defn macho-undefined-count [] (-> i64)
  (len (.undefined-names (obj-symbols))))

(defn macho-undefined-name [(k i64)] (-> (slice u8))
  (get (.undefined-names (obj-symbols)) k))

(defn macho-put-str! [(strtab (mut (ArrayList u8))) (name (slice u8))] (-> i64)
  (let [offset (len (load strtab))]
    (obj-put1! (mut strtab) 95)
    (obj-put-slice! (mut strtab) name)
    (obj-put1! (mut strtab) 0)
    offset))

(defn macho-bytes [] (-> (slice u8))
  (obj-symbols-build!)
  (let [a (alloc/malloc-allocator)
        (mut out) (al-new [u8] a)
        (mut strtab) (al-new [u8] a)
        (mut def-strx) (al-new [i64] a)
        (mut string-strx) (al-new [i64] a)
        (mut undef-strx) (al-new [i64] a)
        stackmaps (gc-stackmap-bytes)
        stackmap-size (len stackmaps)
        has-stackmaps (> stackmap-size 0)
        ;; The static shape table travels with the stack maps: both are data the runtime reads
        ;; through `getsectiondata`, and a program that made no shapes has no table.
        shapes (shape-table-bytes)
        shapes-size (len shapes)
        has-shapes (> shapes-size 0)
        ;; String literals: the runtime reads them as immortal string payloads (aot.node.dynamic,
        ;; StrConst); each is a local symbol in this section.
        strings (code-string-table-bytes SHAPE-STRING)
        strings-size (len strings)
        has-strings (> strings-size 0)
        nstrings (code-string-count)
        nsects
          (+ 1
             (+ (if has-stackmaps 1 0)
                (+ (if has-shapes 1 0) (if has-strings 1 0))))
        strings-sect (+ 1 (+ (if has-stackmaps 1 0) (+ (if has-shapes 1 0) 1)))
        segment-size (+ 72 (* 80 nsects))
        data-offset
          (+ 32 (+ segment-size (+ MACHO-SYMTAB-SIZE MACHO-BUILD-VERSION-SIZE)))
        text-size (enc-byte-count)
        nreloc (enc-symbol-fixup-count)
        ndefs (enc-definition-count)
        nundef (macho-undefined-count)
        nsyms (+ ndefs (+ nstrings nundef))
        stackmap-offset (obj-align-up (+ data-offset text-size) 8)
        stackmap-end
          (if has-stackmaps
              (+ stackmap-offset stackmap-size)
              (+ data-offset text-size))
        shapes-offset (obj-align-up stackmap-end 8)
        shapes-end (if has-shapes (+ shapes-offset shapes-size) stackmap-end)
        strings-offset (obj-align-up shapes-end 8)
        data-end (if has-strings (+ strings-offset strings-size) shapes-end)
        reloff (obj-align-up data-end 4)
        symoff (+ reloff (* nreloc 8))
        stroff (+ symoff (* nsyms 16))
        (mut i) 0]
    (obj-put1! (mut strtab) 0)
    (loop (if (>= (load i) ndefs)
              (break 0)
              (do
                (push! [i64]
                       (mut def-strx)
                       (macho-put-str! (mut strtab)
                                       (enc-definition-name (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [(mut si) 0]
      (loop (if (>= (load si) nstrings)
                (break 0)
                (do
                  (push! [i64]
                         (mut string-strx)
                         (macho-put-str! (mut strtab)
                                         (code-string-symbol (load si))))
                  (set! (mut si) (+ (load si) 1))
                  (continue)))))
    (set! (mut i) 0)
    (loop (if (>= (load i) nundef)
              (break 0)
              (do
                (push! [i64]
                       (mut undef-strx)
                       (macho-put-str! (mut strtab)
                                       (macho-undefined-name (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))

    ;; mach_header_64: arm64 MH_OBJECT with segment, symbol table and platform version.
    (obj-put4! (mut out) 0xfeedfacf)
    (obj-put4! (mut out) 0x0100000c)
    (obj-put4! (mut out) 0)
    (obj-put4! (mut out) 1)
    (obj-put4! (mut out) 3)
    (obj-put4! (mut out)
               (+ segment-size (+ MACHO-SYMTAB-SIZE MACHO-BUILD-VERSION-SIZE)))
    (obj-put4! (mut out) 0)
    (obj-put4! (mut out) 0)
    (obj-put4! (mut out) 0x19)
    (obj-put4! (mut out) segment-size)
    (obj-put-name16! (mut out) "")
    (obj-put8! (mut out) 0)
    (obj-put8! (mut out) (- data-end data-offset))
    (obj-put8! (mut out) data-offset)
    (obj-put8! (mut out) (- data-end data-offset))
    (obj-put4! (mut out) 7)
    (obj-put4! (mut out) 7)
    (obj-put4! (mut out) nsects)
    (obj-put4! (mut out) 0)
    (obj-put-name16! (mut out) "__text")
    (obj-put-name16! (mut out) "__TEXT")
    (obj-put8! (mut out) 0)
    (obj-put8! (mut out) text-size)
    (obj-put4! (mut out) data-offset)
    (obj-put4! (mut out) 2)
    (obj-put4! (mut out) reloff)
    (obj-put4! (mut out) nreloc)
    (obj-put4! (mut out) 0x80000400)
    (obj-put4! (mut out) 0)
    (obj-put4! (mut out) 0)
    (obj-put4! (mut out) 0)
    (if has-stackmaps
        (do
          (obj-put-name16! (mut out) "__aot_stackmaps")
          (obj-put-name16! (mut out) "__DATA")
          (obj-put8! (mut out) (- stackmap-offset data-offset))
          (obj-put8! (mut out) stackmap-size)
          (obj-put4! (mut out) stackmap-offset)
          (obj-put4! (mut out) 3)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0))
        0)
    (if has-shapes
        (do
          (obj-put-name16! (mut out) "__aot_shapes")
          (obj-put-name16! (mut out) "__DATA")
          (obj-put8! (mut out) (- shapes-offset data-offset))
          (obj-put8! (mut out) shapes-size)
          (obj-put4! (mut out) shapes-offset)
          (obj-put4! (mut out) 3)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0))
        0)
    (if has-strings
        (do
          (obj-put-name16! (mut out) "__aot_strings")
          (obj-put-name16! (mut out) "__DATA")
          (obj-put8! (mut out) (- strings-offset data-offset))
          (obj-put8! (mut out) strings-size)
          (obj-put4! (mut out) strings-offset)
          (obj-put4! (mut out) 3)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0)
          (obj-put4! (mut out) 0))
        0)
    (obj-put4! (mut out) 2)
    (obj-put4! (mut out) MACHO-SYMTAB-SIZE)
    (obj-put4! (mut out) symoff)
    (obj-put4! (mut out) nsyms)
    (obj-put4! (mut out) stroff)
    (obj-put4! (mut out) (len (load strtab)))
    ;; LC_BUILD_VERSION: macOS 11.0 is the first arm64 macOS deployment target.
    (obj-put4! (mut out) 0x32)
    (obj-put4! (mut out) MACHO-BUILD-VERSION-SIZE)
    (obj-put4! (mut out) 1)
    (obj-put4! (mut out) 0x000b0000)
    (obj-put4! (mut out) 0)
    (obj-put4! (mut out) 0)
    (if (!= (len (load out)) data-offset)
        (panic-i "macho-bytes: load-command size mismatch" (len (load out)))
        0)

    (obj-put-slice! (mut out) (enc-bytes))
    (if has-stackmaps
        (do
          (obj-pad-to! (mut out) stackmap-offset)
          (obj-put-slice! (mut out) stackmaps))
        0)
    (if has-shapes
        (do
          (obj-pad-to! (mut out) shapes-offset)
          (obj-put-slice! (mut out) shapes))
        0)
    (if has-strings
        (do
          (obj-pad-to! (mut out) strings-offset)
          (obj-put-slice! (mut out) strings))
        0)
    (obj-pad-to! (mut out) reloff)
    (set! (mut i) 0)
    (loop (if (>= (load i) nreloc)
              (break 0)
              (do
                (obj-put4! (mut out) (enc-symbol-fixup-offset (load i)))
                ;; r_type in the top nibble: BRANCH26 (2, pcrel), PAGE21 (3, pcrel) or PAGEOFF12
                ;; (4, absolute); r_extern set, r_length 4 bytes.
                (obj-put4! (mut out)
                           (| (macho-symbol-index-for-fixup (load i))
                              (macho-relocation-bits (enc-symbol-fixup-kind (load i)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))

    ;; nlist_64 definitions, then deduplicated undefined targets.
    (set! (mut i) 0)
    (loop (if (>= (load i) ndefs)
              (break 0)
              (do
                (obj-put4! (mut out) (get (load def-strx) (load i)))
                (obj-put1! (mut out) 0x0f)
                (obj-put1! (mut out) 1)
                (obj-put2! (mut out) 0)
                (obj-put8! (mut out) (enc-definition-offset (load i)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; String literals: local symbols in the strings section, at each payload.
    (set! (mut i) 0)
    (loop (if (>= (load i) nstrings)
              (break 0)
              (do
                (obj-put4! (mut out) (get (load string-strx) (load i)))
                (obj-put1! (mut out) 0x0e)
                (obj-put1! (mut out) strings-sect)
                (obj-put2! (mut out) 0)
                (obj-put8! (mut out)
                           (+ (- strings-offset data-offset)
                              (code-string-offset (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) nundef)
              (break 0)
              (do
                (obj-put4! (mut out) (get (load undef-strx) (load i)))
                (obj-put1! (mut out) 1)
                (obj-put1! (mut out) 0)
                (obj-put2! (mut out) 0)
                (obj-put8! (mut out) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (obj-put-slice! (mut out) (al-slice (load strtab)))
    (al-slice (load out))))

(defn macho-write [(path (slice u8))] (-> i64)
  (let [a (alloc/malloc-allocator)
        bytes (macho-bytes)]
    (try (try-or! (fs/write-file a path bytes) -1))))

(defn obj-align-up [(v i64) (alignment i64)] (-> i64)
  (* alignment (/ (+ v (- alignment 1)) alignment)))

(defn elf-put-str! [(strtab (mut (ArrayList u8))) (name (slice u8))] (-> i64)
  (let [offset (len (load strtab))]
    (obj-put-slice! (mut strtab) name)
    (obj-put1! (mut strtab) 0)
    offset))

(defn elf-symbol-index-for-fixup [(fixup i64)] (-> i64)
  ;; Null and local .text section symbols occupy indices zero and one.
  (+ 2 (macho-symbol-index-for-fixup fixup)))

(defn elf-put-section-header! [(out (mut (ArrayList u8)))
                               (name i64)
                               (kind i64)
                               (flags i64)
                               (offset i64)
                               (size i64)
                               (link i64)
                               (info i64)
                               (alignment i64)
                               (entsize i64)] (-> i64)
  (do
    (obj-put4! (mut out) name)
    (obj-put4! (mut out) kind)
    (obj-put8! (mut out) flags)
    (obj-put8! (mut out) 0)
    (obj-put8! (mut out) offset)
    (obj-put8! (mut out) size)
    (obj-put4! (mut out) link)
    (obj-put4! (mut out) info)
    (obj-put8! (mut out) alignment)
    (obj-put8! (mut out) entsize)
    0))

(defn elf-bytes [] (-> (slice u8))
  (obj-symbols-build!)
  (let [a (alloc/malloc-allocator)
        (mut out) (al-new [u8] a)
        (mut strtab) (al-new [u8] a)
        (mut shstr) (al-new [u8] a)
        (mut def-strx) (al-new [i64] a)
        (mut string-strx) (al-new [i64] a)
        (mut undef-strx) (al-new [i64] a)
        stackmaps (gc-stackmap-bytes)
        stackmap-size (len stackmaps)
        has-stackmaps (> stackmap-size 0)
        shapes (shape-table-bytes)
        shapes-size (len shapes)
        has-shapes (> shapes-size 0)
        strings (code-string-table-bytes SHAPE-STRING)
        strings-size (len strings)
        has-strings (> strings-size 0)
        nstrings (code-string-count)
        extra-sections
          (+ (if has-stackmaps 1 0)
             (+ (if has-shapes 1 0) (if has-strings 1 0)))
        ;; .text 1, .rela.text 2, .symtab 3, .strtab 4, then the data sections in order.
        strings-shndx (+ 5 (+ (if has-stackmaps 1 0) (if has-shapes 1 0)))
        text-size (enc-byte-count)
        nreloc (enc-symbol-fixup-count)
        ndefs (enc-definition-count)
        nundef (macho-undefined-count)
        nsyms (+ 2 (+ ndefs (+ nstrings nundef)))
        text-off 64
        rela-off (obj-align-up (+ text-off text-size) 8)
        rela-size (* nreloc 24)
        sym-off (obj-align-up (+ rela-off rela-size) 8)
        sym-size (* nsyms 24)
        str-off (+ sym-off sym-size)
        (mut i) 0]
    (obj-put1! (mut strtab) 0)
    (loop (if (>= (load i) ndefs)
              (break 0)
              (do
                (push! [i64]
                       (mut def-strx)
                       (elf-put-str! (mut strtab)
                                     (enc-definition-name (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [(mut si) 0]
      (loop (if (>= (load si) nstrings)
                (break 0)
                (do
                  (push! [i64]
                         (mut string-strx)
                         (elf-put-str! (mut strtab)
                                       (code-string-symbol (load si))))
                  (set! (mut si) (+ (load si) 1))
                  (continue)))))
    (set! (mut i) 0)
    (loop (if (>= (load i) nundef)
              (break 0)
              (do
                (push! [i64]
                       (mut undef-strx)
                       (elf-put-str! (mut strtab)
                                     (macho-undefined-name (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (obj-put1! (mut shstr) 0)
    (let [text-name (elf-put-str! (mut shstr) ".text")
          rela-name (elf-put-str! (mut shstr) ".rela.text")
          sym-name (elf-put-str! (mut shstr) ".symtab")
          str-name (elf-put-str! (mut shstr) ".strtab")
          stackmap-name
            (if has-stackmaps (elf-put-str! (mut shstr) ".aot_stackmaps") 0)
          shapes-name (if has-shapes (elf-put-str! (mut shstr) ".aot_shapes") 0)
          strings-name
            (if has-strings (elf-put-str! (mut shstr) ".aot_strings") 0)
          shstr-name (elf-put-str! (mut shstr) ".shstrtab")
          stackmap-off (obj-align-up (+ str-off (len (load strtab))) 8)
          stackmap-end
            (if has-stackmaps
                (+ stackmap-off stackmap-size)
                (+ str-off (len (load strtab))))
          shapes-off (obj-align-up stackmap-end 8)
          shapes-end (if has-shapes (+ shapes-off shapes-size) stackmap-end)
          strings-off (obj-align-up shapes-end 8)
          shstr-off (if has-strings (+ strings-off strings-size) shapes-end)
          shoff (obj-align-up (+ shstr-off (len (load shstr))) 8)]
      ;; ELF64 header, little-endian, ET_REL, EM_AARCH64.
      (obj-put1! (mut out) 0x7f)
      (obj-put1! (mut out) 0x45)
      (obj-put1! (mut out) 0x4c)
      (obj-put1! (mut out) 0x46)
      (obj-put1! (mut out) 2)
      (obj-put1! (mut out) 1)
      (obj-put1! (mut out) 1)
      (loop (if (>= (len (load out)) 16)
                (break 0)
                (do (obj-put1! (mut out) 0) (continue))))
      (obj-put2! (mut out) 1)
      (obj-put2! (mut out) 183)
      (obj-put4! (mut out) 1)
      (obj-put8! (mut out) 0)
      (obj-put8! (mut out) 0)
      (obj-put8! (mut out) shoff)
      (obj-put4! (mut out) 0)
      (obj-put2! (mut out) 64)
      (obj-put2! (mut out) 0)
      (obj-put2! (mut out) 0)
      (obj-put2! (mut out) 64)
      (obj-put2! (mut out) (+ 6 extra-sections))
      (obj-put2! (mut out) (+ 5 extra-sections))
      (obj-put-slice! (mut out) (enc-bytes))
      (obj-pad-to! (mut out) rela-off)

      ;; Elf64_Rela: r_offset, r_info=(symbol<<32)|R_AARCH64_CALL26, addend zero.
      (set! (mut i) 0)
      (loop (if (>= (load i) nreloc)
                (break 0)
                (do
                  (obj-put8! (mut out) (enc-symbol-fixup-offset (load i)))
                  (obj-put8! (mut out)
                             (| (primitive/ishl (elf-symbol-index-for-fixup (load i))
                                                32)
                                (elf-relocation-type (enc-symbol-fixup-kind (load i)))))
                  (obj-put8! (mut out) 0)
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (obj-pad-to! (mut out) sym-off)

      ;; Null and local section symbols.
      (loop (if (>= (len (load out)) (+ sym-off 24))
                (break 0)
                (do (obj-put1! (mut out) 0) (continue))))
      (obj-put4! (mut out) 0)
      (obj-put1! (mut out) 3)
      (obj-put1! (mut out) 0)
      (obj-put2! (mut out) 1)
      (obj-put8! (mut out) 0)
      (obj-put8! (mut out) 0)
      (set! (mut i) 0)
      (loop (if (>= (load i) ndefs)
                (break 0)
                (do
                  (obj-put4! (mut out) (get (load def-strx) (load i)))
                  (obj-put1! (mut out) 0x12)
                  (obj-put1! (mut out) 0)
                  (obj-put2! (mut out) 1)
                  (obj-put8! (mut out) (enc-definition-offset (load i)))
                  (obj-put8! (mut out) (enc-definition-size (load i)))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      ;; String literals: local object symbols in .aot_strings at each payload.
      (set! (mut i) 0)
      (loop (if (>= (load i) nstrings)
                (break 0)
                (do
                  (obj-put4! (mut out) (get (load string-strx) (load i)))
                  (obj-put1! (mut out) 0x01)
                  (obj-put1! (mut out) 0)
                  (obj-put2! (mut out) strings-shndx)
                  (obj-put8! (mut out) (code-string-offset (load i)))
                  (obj-put8! (mut out)
                             (+ 8 (* 2 (len (code-string-units (load i))))))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) nundef)
                (break 0)
                (do
                  (obj-put4! (mut out) (get (load undef-strx) (load i)))
                  (obj-put1! (mut out) 0x10)
                  (obj-put1! (mut out) 0)
                  (obj-put2! (mut out) 0)
                  (obj-put8! (mut out) 0)
                  (obj-put8! (mut out) 0)
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (obj-put-slice! (mut out) (al-slice (load strtab)))
      (if has-stackmaps
          (do
            (obj-pad-to! (mut out) stackmap-off)
            (obj-put-slice! (mut out) stackmaps))
          0)
      (if has-shapes
          (do
            (obj-pad-to! (mut out) shapes-off)
            (obj-put-slice! (mut out) shapes))
          0)
      (if has-strings
          (do
            (obj-pad-to! (mut out) strings-off)
            (obj-put-slice! (mut out) strings))
          0)
      (obj-put-slice! (mut out) (al-slice (load shstr)))
      (obj-pad-to! (mut out) shoff)
      (elf-put-section-header! (mut out) 0 0 0 0 0 0 0 0 0)
      (elf-put-section-header! (mut out)
                               text-name
                               1
                               6
                               text-off
                               text-size
                               0
                               0
                               4
                               0)
      (elf-put-section-header! (mut out)
                               rela-name
                               4
                               0
                               rela-off
                               rela-size
                               3
                               1
                               8
                               24)
      (elf-put-section-header! (mut out) sym-name 2 0 sym-off sym-size 4 2 8 24)
      (elf-put-section-header! (mut out)
                               str-name
                               3
                               0
                               str-off
                               (len (load strtab))
                               0
                               0
                               1
                               0)
      (if has-stackmaps
          (elf-put-section-header! (mut out)
                                   stackmap-name
                                   1
                                   2
                                   stackmap-off
                                   stackmap-size
                                   0
                                   0
                                   8
                                   0)
          0)
      (if has-shapes
          (elf-put-section-header! (mut out)
                                   shapes-name
                                   1
                                   2
                                   shapes-off
                                   shapes-size
                                   0
                                   0
                                   8
                                   0)
          0)
      (if has-strings
          (elf-put-section-header! (mut out)
                                   strings-name
                                   1
                                   3
                                   strings-off
                                   strings-size
                                   0
                                   0
                                   8
                                   0)
          0)
      (elf-put-section-header! (mut out)
                               shstr-name
                               3
                               0
                               shstr-off
                               (len (load shstr))
                               0
                               0
                               1
                               0)
      (al-slice (load out)))))

(defn elf-write [(path (slice u8))] (-> i64)
  (let [a (alloc/malloc-allocator)
        bytes (elf-bytes)]
    (try (try-or! (fs/write-file a path bytes) -1))))

(defn obj-run-process [(program (slice u8)) (args (slice (slice u8)))] (-> i64)
  (let [a (alloc/malloc-allocator)
        child (primitive/alloc-stack subprocess/Child)]
    (try (let [_
                 (try-or! (subprocess/spawn a
                                            child
                                            program
                                            args
                                            (subprocess/inherit-stdio)
                                            (subprocess/inherit-stdio)
                                            (subprocess/inherit-stdio))
                          -1)]
           (let [code
                   (match (subprocess/child-wait child)
                     (Err [_] -1)
                     (Ok [status]
                         (match status
                           (subprocess/Exited [exit-code] exit-code)
                           (subprocess/Signaled [signal] (- 0 signal)))))]
             (match (subprocess/child-close child) (Ok [_] 0) (Err [_] 0))
             code)))))

(defn macho-link! [(object (slice u8)) (output (slice u8))] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 3))]
    (set! (primitive/index args 0) object)
    (set! (primitive/index args 1) "-o")
    (set! (primitive/index args 2) output)
    (obj-run-process "cc" (slice-new (primitive/index args 0) 3))))

;; Production-generated programs link the separately compiled Coil runtime artifact. Keep the
;; two-object boundary explicit: the first object is this compiler's generated program, while the
;; second is Coil source compiled by the manifest's `[artifacts.runtime]` build edge. Focused
;; backend tests may continue using `macho-link!` when they intentionally contain no runtime calls.
(defn macho-link-runtime! [(object (slice u8))
                           (runtime (slice u8))
                           (output (slice u8))] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 4))]
    (set! (primitive/index args 0) object)
    (set! (primitive/index args 1) runtime)
    (set! (primitive/index args 2) "-o")
    (set! (primitive/index args 3) output)
    (obj-run-process "cc" (slice-new (primitive/index args 0) 4))))

(defn run-executable! [(path (slice u8))] (-> i64)
  (obj-run-process path (slice-new (primitive/cast (ptr (slice u8)) 0) 0)))
