;; Local scheduling: the order of instructions WITHIN one block.

;;
;; GCM says which block; this says which order. The input is a dependency DAG over the block's
;; nodes — data edges, memory anti-dependencies, call ordering, and fixed-register constraints —
;; and the output is a linear order that respects it.
;;
;; The terminator goes last, always. Nodes that define a fixed register are placed as close to
;; their consumer as possible, because a fixed-register live range that spans other fixed uses of
;; the same register forces a copy the allocator cannot remove.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S6.
(module aot.codegen.listsched)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(defn sched-block! [(block (dyn NodeOps))] (-> i64)
  (do (unimplemented "sched-block!" "S6 — src/codegen/listsched.coil") 0))

(defn sched-run! [] (-> i64)
  (do (unimplemented "sched-run!" "S6 — src/codegen/listsched.coil") 0))
