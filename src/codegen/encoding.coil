;; Machine instructions to bytes, with stable node offsets and typed fixups.

;;
;; Final Simple lays out CFG blocks, records every instruction's start and selected size, emits in
;; exactly that order, then patches local PC-relative references. Short-form relaxation repeats
;; layout until sizes stop changing. AArch64 conditional branches grow monotonically from B.cond to
;; an inverted-condition/B26 pair; keeping layout separate from emission lets that growth stabilize
;; before bytes or typed fixups are recorded.
;;
;; Final Simple's Split retains its owning LRG and asks that LRG for the function during encoding.
;; Our machine nodes retain stable block ownership instead, so final layout caches block-to-Fun
;; ownership once and gives repeated spill sizing/emission the same constant-time answer.
(module aot.codegen.encoding)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.heap" :use [heap-image-build!])
(import "aot.codegen.encoding.layout" :use * :reexport)
(import "aot.codegen.encoding.veneer" :use * :reexport)
(import "aot.codegen.encoding.literal" :use * :reexport)

(const ENCODER-HANDLE 1)

;; Optional diagnostic observer. It measures the real production layout passes; the normal
;; compiler does not read a clock or format strings for each instruction.
(defstruct EncLayoutObserver
  [(enabled bool) (callback (fnptr c [(slice u8)] i64))])

(defn enc-layout-observer [] (-> (ptr EncLayoutObserver))
  (compiler-state [EncLayoutObserver]
                  (primitive/alloc-static CompilerStateSlot)))

(defn enc-set-layout-observer! [(callback (fnptr c [(slice u8)] i64))] (-> i64)
  (set! (.callback (enc-layout-observer)) callback)
  (set! (.enabled (enc-layout-observer)) true)
  0)

(defn enc-layout-observe! [(name (slice u8))] (-> i64)
  (if (.enabled (enc-layout-observer))
      (primitive/call-ptr (.callback (enc-layout-observer)) name)
      0))

;; Local fixup kinds are target-independent descriptions of the bit field being patched. Keeping
;; them here, rather than smuggling target callbacks through integers, makes relocation ownership
;; explicit and lets the object writer distinguish local branches from symbol relocations later.
(const ENC-FIXUP-A64-B19 1)

(const ENC-FIXUP-A64-B26 2)

(const ENC-FIXUP-A64-BL26 3)

;; ADRP/ADD page-relative address materialization against a defined function symbol, as Simple's
;; arm port emits for a function-pointer value (`TFPARM`). Always symbol fixups: the page of a
;; text address is known only to the linker.
(const ENC-FIXUP-A64-PAGE21 4)

(const ENC-FIXUP-A64-PAGEOFF12 5)

;; An installation-qualified GC map token uses a fixed four-word MOVZ/MOVK sequence. Its local
;; ID remains valid for object export; a memory installer patches the installation's high word.
;; Like Simple's chunk relocations, these records are separate from immutable instruction bytes.
(defstruct EncMapSite [(offset i64) (local-id i64) (reg i64)])

(const ENC-UNIT-DATA 1)

(const ENC-UNIT-KEY 2)

(const ENC-UNIT-SHAPE 3)

(defstruct EncUnitSite [(offset i64) (kind i64) (local-id i64) (reg i64)])

;; Flush pending literals after at most 256KiB of code. In the worst case every four-byte
;; instruction contributes a distinct eight-byte literal, so source-to-last-slot distance stays
;; below 3*256KiB, safely inside AArch64 LDR-literal's signed ±1MiB reach.
(const ENC-LITERAL-CODE-SPAN 262144)

;; Veneer hubs are at most 32MiB apart and transfers longer than 64MiB route through them. This
;; leaves a full 64MiB of headroom inside B26's ±128MiB reach for hub entries and later relaxation.
(const ENC-VENEER-HUB-SPAN 33554432)

(const ENC-VENEER-ROUTE-SPAN 67108864)

(defstruct EncodingState
  [(bits (ArrayList u8))
   (starts (ArrayList i64))
   (lengths (ArrayList i64))
   (fixup-kinds (ArrayList i64))
   (fixup-sources (ArrayList i64))
   (fixup-addends (ArrayList i64))
   (fixup-targets (ArrayList i64))
   (symbol-kinds (ArrayList i64))
   (symbol-sources (ArrayList i64))
   (symbol-addends (ArrayList i64))
   (symbol-fidxs (ArrayList i64))
   (symbol-names (ArrayList (slice u8)))
   (map-sites (ArrayList EncMapSite))
   (unit-sites (ArrayList EncUnitSite))
   (literal-sources (ArrayList i64))
   (literal-bits (ArrayList i64))
   (literal-offsets (ArrayList i64))
   (literal-indices (ArrayList i64))
   (literal-emitted (ArrayList bool))
   (island-before-sources (ArrayList i64))
   (island-first-literals (ArrayList i64))
   (island-literal-counts (ArrayList i64))
   (island-offsets (ArrayList i64))
   (island-sizes (ArrayList i64))
   (veneer-hub-before-sources (ArrayList i64))
   (veneer-hub-offsets (ArrayList i64))
   (veneer-hub-sizes (ArrayList i64))
   (veneer-hub-entry-counts (ArrayList i64))
   (veneer-hub-first-entries (ArrayList i64))
   (veneer-hub-last-entries (ArrayList i64))
   (veneer-hub-indices (ArrayList i64))
   (veneer-entry-hubs (ArrayList i64))
   (veneer-entry-ordinals (ArrayList i64))
   (veneer-entry-in-hub-next (ArrayList i64))
   (veneer-entry-next (ArrayList i64))
   (veneer-entry-targets (ArrayList i64))
   (veneer-route-sources (ArrayList i64))
   (veneer-first-by-source (ArrayList i64))
   (definition-sources (ArrayList i64))
   (definition-fidxs (ArrayList i64))
   (definition-names (ArrayList (slice u8)))
   (definition-local (ArrayList bool))
   (definition-ends (ArrayList i64))
   (layout-blocks (ArrayList i64))
   (layout-jumps (ArrayList i64))
   ;; Block-to-Fun ownership is immutable during final layout. Stack spill sizing and emission both
   ;; ask for it, so cache it once instead of repeating dominator walks for every access.
   (owner-funs (ArrayList i64))
   (owner-ready bool)
   (owner-walk-visits i64)
   (owner-cfg-version i64)
   (laid-out bool)
   (emitted bool)
   (initialized bool)])

(defn enc-state [] (-> (ptr EncodingState))
  (compiler-state [EncodingState] (primitive/alloc-static CompilerStateSlot)))

(defn enc-reset! [] (-> i64)
  (let [a (compiler-allocator)
        state (enc-state)
        (mut i) 0]
    (set! (.bits state) (al-new [u8] a))
    (set! (.starts state) (al-new [i64] a))
    (set! (.lengths state) (al-new [i64] a))
    (set! (.fixup-kinds state) (al-new [i64] a))
    (set! (.fixup-sources state) (al-new [i64] a))
    (set! (.fixup-addends state) (al-new [i64] a))
    (set! (.fixup-targets state) (al-new [i64] a))
    (set! (.symbol-kinds state) (al-new [i64] a))
    (set! (.symbol-sources state) (al-new [i64] a))
    (set! (.symbol-addends state) (al-new [i64] a))
    (set! (.symbol-fidxs state) (al-new [i64] a))
    (set! (.symbol-names state) (al-new [(slice u8)] a))
    (set! (.map-sites state) (al-new [EncMapSite] a))
    (set! (.unit-sites state) (al-new [EncUnitSite] a))
    (set! (.literal-sources state) (al-new [i64] a))
    (set! (.literal-bits state) (al-new [i64] a))
    (set! (.literal-offsets state) (al-new [i64] a))
    (set! (.literal-indices state) (al-new [i64] a))
    (set! (.literal-emitted state) (al-new [bool] a))
    (set! (.island-before-sources state) (al-new [i64] a))
    (set! (.island-first-literals state) (al-new [i64] a))
    (set! (.island-literal-counts state) (al-new [i64] a))
    (set! (.island-offsets state) (al-new [i64] a))
    (set! (.island-sizes state) (al-new [i64] a))
    (set! (.veneer-hub-before-sources state) (al-new [i64] a))
    (set! (.veneer-hub-offsets state) (al-new [i64] a))
    (set! (.veneer-hub-sizes state) (al-new [i64] a))
    (set! (.veneer-hub-entry-counts state) (al-new [i64] a))
    (set! (.veneer-hub-first-entries state) (al-new [i64] a))
    (set! (.veneer-hub-last-entries state) (al-new [i64] a))
    (set! (.veneer-hub-indices state) (al-new [i64] a))
    (set! (.veneer-entry-hubs state) (al-new [i64] a))
    (set! (.veneer-entry-ordinals state) (al-new [i64] a))
    (set! (.veneer-entry-in-hub-next state) (al-new [i64] a))
    (set! (.veneer-entry-next state) (al-new [i64] a))
    (set! (.veneer-entry-targets state) (al-new [i64] a))
    (set! (.veneer-route-sources state) (al-new [i64] a))
    (set! (.veneer-first-by-source state) (al-new [i64] a))
    (set! (.definition-sources state) (al-new [i64] a))
    (set! (.definition-fidxs state) (al-new [i64] a))
    (set! (.definition-names state) (al-new [(slice u8)] a))
    (set! (.definition-local state) (al-new [bool] a))
    (set! (.definition-ends state) (al-new [i64] a))
    (set! (.layout-blocks state) (al-new [i64] a))
    (set! (.layout-jumps state) (al-new [i64] a))
    (set! (.owner-funs state) (al-new [i64] a))
    (loop (if (> (load i) (arena-node-count))
              (break 0)
              (do
                (push! [i64] (mut (.starts state)) -1)
                (push! [i64] (mut (.lengths state)) -1)
                (push! [i64] (mut (.literal-indices state)) -1)
                (push! [i64] (mut (.veneer-hub-indices state)) -1)
                (push! [i64] (mut (.veneer-first-by-source state)) -1)
                (push! [i64] (mut (.owner-funs state)) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (.owner-ready state) false)
    (set! (.owner-walk-visits state) 0)
    (set! (.owner-cfg-version state) (cfg-edit-version))
    (set! (.laid-out state) false)
    (set! (.emitted state) false)
    (set! (.initialized state) true)
    0))

(defn enc-ensure-node-capacity! [(n (dyn NodeOps))] (-> i64)
  (let [state (enc-state)]
    (loop (if (> (len (.starts state)) (n-nid n))
              (break 0)
              (do
                (push! [i64] (mut (.starts state)) -1)
                (push! [i64] (mut (.lengths state)) -1)
                (push! [i64] (mut (.literal-indices state)) -1)
                (push! [i64] (mut (.veneer-hub-indices state)) -1)
                (push! [i64] (mut (.veneer-first-by-source state)) -1)
                (push! [i64] (mut (.owner-funs state)) 0)
                (continue))))
    0))

(defn enc-layout-block-count [] (-> i64)
  (len (.layout-blocks (enc-state))))

(defn enc-layout-block-at [(i i64)] (-> (dyn NodeOps))
  (if (or (< i 0) (>= i (enc-layout-block-count)))
      (do
        (panic-i "enc-layout-block-at: index out of range" i)
        (unreachable-node))
      (match (arena-node (get (.layout-blocks (enc-state)) i))
        (Some [block] block)
        (None []
              (do
                (panic-i "enc-layout-block-at: block is missing" i)
                (unreachable-node))))))

(defn enc-layout-jump-at [(i i64)] (-> (Option (dyn NodeOps)))
  (if (or (< i 0) (>= i (enc-layout-block-count)))
      (do
        (panic-i "enc-layout-jump-at: index out of range" i)
        (None [(dyn NodeOps)]))
      (let [nid (get (.layout-jumps (enc-state)) i)]
        (if (= nid 0) (None [(dyn NodeOps)]) (arena-node nid)))))

(defn enc-add-local-fixup-at! [(encoder i64)
                               (kind i64)
                               (source (dyn NodeOps))
                               (addend i64)
                               (target (dyn NodeOps))] (-> i64)
  (do
    (enc-require-handle encoder)
    (if (or (< kind ENC-FIXUP-A64-B19) (> kind ENC-FIXUP-A64-BL26))
        (panic-i "enc-add-local-fixup!: unknown fixup kind" kind)
        0)
    (push! [i64] (mut (.fixup-kinds (enc-state))) kind)
    (push! [i64] (mut (.fixup-sources (enc-state))) (n-nid source))
    (push! [i64] (mut (.fixup-addends (enc-state))) addend)
    (push! [i64] (mut (.fixup-targets (enc-state))) (n-nid target))
    0))

(defn enc-add-local-fixup! [(encoder i64)
                            (kind i64)
                            (source (dyn NodeOps))
                            (target (dyn NodeOps))] (-> i64)
  (enc-add-local-fixup-at! encoder kind source 0 target))

(defn enc-fixup-count [] (-> i64)
  (len (.fixup-kinds (enc-state))))

(defn enc-add-symbol-fixup-at! [(encoder i64)
                                (kind i64)
                                (source (dyn NodeOps))
                                (addend i64)
                                (fidx i64)
                                (name (slice u8))] (-> i64)
  (do
    (enc-require-handle encoder)
    (if (not (or (= kind ENC-FIXUP-A64-BL26)
                 (= kind ENC-FIXUP-A64-PAGE21)
                 (= kind ENC-FIXUP-A64-PAGEOFF12)))
        (panic-i "enc-add-symbol-fixup!: unsupported fixup kind" kind)
        0)
    (push! [i64] (mut (.symbol-kinds (enc-state))) kind)
    (push! [i64] (mut (.symbol-sources (enc-state))) (n-nid source))
    (push! [i64] (mut (.symbol-addends (enc-state))) addend)
    (push! [i64] (mut (.symbol-fidxs (enc-state))) fidx)
    (push! [(slice u8)] (mut (.symbol-names (enc-state))) name)
    0))

(defn enc-add-symbol-fixup! [(encoder i64)
                             (kind i64)
                             (source (dyn NodeOps))
                             (fidx i64)
                             (name (slice u8))] (-> i64)
  (enc-add-symbol-fixup-at! encoder kind source 0 fidx name))

(defn enc-symbol-fixup-count [] (-> i64)
  (len (.symbol-kinds (enc-state))))

(defn enc-symbol-fixup-kind [(i i64)] (-> i64)
  (get (.symbol-kinds (enc-state)) i))

(defn enc-symbol-fixup-offset [(i i64)] (-> i64)
  (match (arena-node (get (.symbol-sources (enc-state)) i))
    (Some [source]
          (+ (enc-op-start source) (get (.symbol-addends (enc-state)) i)))
    (None [] (do (panic-i "enc-symbol-fixup-offset: missing source" i) 0))))

(defn enc-symbol-fixup-fidx [(i i64)] (-> i64)
  (get (.symbol-fidxs (enc-state)) i))

(defn enc-symbol-fixup-name [(i i64)] (-> (slice u8))
  (get (.symbol-names (enc-state)) i))

(defn enc-add-map-site! [(encoder i64) (local-id i64) (reg i64)] (-> i64)
  (enc-require-handle encoder)
  (if (or (<= local-id 0) (> local-id 0xffffffff) (< reg 0) (> reg 30))
      (panic "enc-add-map-site!: invalid local map identity or register")
      0)
  (push! [EncMapSite]
         (mut (.map-sites (enc-state)))
         (EncMapSite
           :offset (enc-byte-count)
           :local-id local-id
           :reg reg)))

(defn enc-add-unit-site! [(encoder i64) (kind i64) (local-id i64) (reg i64)] (-> i64)
  (enc-require-handle encoder)
  (if (or (< local-id 0)
          (> local-id 0xffffffff)
          (< reg 0)
          (> reg 30)
          (= reg 28)
          (not (or (= kind ENC-UNIT-DATA)
                   (= kind ENC-UNIT-KEY)
                   (= kind ENC-UNIT-SHAPE))))
      (panic "enc-add-unit-site!: invalid reference kind or local identity")
      0)
  (push! [EncUnitSite]
         (mut (.unit-sites (enc-state)))
         (EncUnitSite
           :offset (enc-byte-count)
           :kind kind
           :local-id local-id
           :reg reg)))

(defn enc-has-veneer-route? [(source (dyn NodeOps))] (-> bool)
  (and (< (n-nid source) (len (.veneer-first-by-source (enc-state))))
       (>= (get (.veneer-first-by-source (enc-state)) (n-nid source)) 0)))

(defn enc-add-planned-veneer-fixup! [(encoder i64)
                                     (source (dyn NodeOps))
                                     (addend i64)] (-> i64)
  (let [state (enc-state)
        (mut entry) (get (.veneer-first-by-source state) (n-nid source))
        (mut guard) 0]
    (if (< (load entry) 0)
        (panic-i "enc-add-planned-veneer-fixup!: source has no route"
                 (n-nid source))
        0)
    (loop (let [next (get (.veneer-entry-next state) (load entry))]
            (if (>= next 0)
                (do
                  (set! (mut entry) next)
                  (set! (mut guard) (+ (load guard) 1))
                  (if (> (load guard) (len (.veneer-entry-hubs state)))
                      (panic "enc-add-planned-veneer-fixup!: route did not converge")
                      (continue)))
                (let [target-nid
                        (get (.veneer-entry-targets state) (load entry))]
                  (match (arena-node target-nid)
                    (Some [target]
                          (break (enc-add-local-fixup-at! encoder
                                                          ENC-FIXUP-A64-B26
                                                          source
                                                          addend
                                                          target)))
                    (None []
                          (break (panic-i "enc-add-planned-veneer-fixup!: missing target"
                                          target-nid))))))))))

(defn enc-add-f64-literal! [(encoder i64) (source (dyn NodeOps)) (bits i64)] (-> i64)
  (do
    (enc-require-handle encoder)
    (if (.laid-out (enc-state))
        (let [idx (get (.literal-indices (enc-state)) (n-nid source))]
          (if (or (< idx 0)
                  (>= idx (len (.literal-bits (enc-state))))
                  (!= (get (.literal-bits (enc-state)) idx) bits))
              (panic-i "enc-add-f64-literal!: emitted literal disagrees with layout"
                       (n-nid source))
              (set! (mut (.literal-emitted (enc-state))) idx true)))
        (do
          ;; Isolated instruction encoding has no layout pass; relocation retains the compact
          ;; trailing-pool fallback for that diagnostic/test mode.
          (push! [i64] (mut (.literal-sources (enc-state))) (n-nid source))
          (push! [i64] (mut (.literal-bits (enc-state))) bits)
          (push! [i64] (mut (.literal-offsets (enc-state))) -1)
          (push! [bool] (mut (.literal-emitted (enc-state))) true)))
    0))

(defn enc-literal-count [] (-> i64)
  (len (.literal-sources (enc-state))))

(defn enc-literal-offset [(i i64)] (-> i64)
  (get (.literal-offsets (enc-state)) i))

(defn enc-add-definition! [(encoder i64)
                           (source (dyn NodeOps))
                           (fidx i64)
                           (name (slice u8))] (-> i64)
  (enc-add-definition-with-linkage! encoder source fidx name false))

(defn enc-add-definition-with-linkage! [(encoder i64) (source (dyn NodeOps))
                                       (fidx i64) (name (slice u8)) (local bool)] (-> i64)
  (do
    (enc-require-handle encoder)
    (push! [i64] (mut (.definition-sources (enc-state))) (n-nid source))
    (push! [i64] (mut (.definition-fidxs (enc-state))) fidx)
    (push! [(slice u8)] (mut (.definition-names (enc-state))) name)
    (push! [bool] (mut (.definition-local (enc-state))) local)
    (push! [i64] (mut (.definition-ends (enc-state))) -1)
    0))

(defn enc-definition-count [] (-> i64)
  (len (.definition-sources (enc-state))))

(defn enc-definition-local? [(i i64)] (-> bool)
  (get (.definition-local (enc-state)) i))

(defn enc-definition-source [(i i64)] (-> (dyn NodeOps))
  (match (arena-node (get (.definition-sources (enc-state)) i))
    (Some [source] source)
    (None []
          (do
            (panic "enc-definition-source: missing source")
            (unreachable-node)))))

(defn enc-definition-offset [(i i64)] (-> i64)
  (match (arena-node (get (.definition-sources (enc-state)) i))
    (Some [source] (enc-op-start source))
    (None [] (do (panic-i "enc-definition-offset: missing source" i) 0))))

(defn enc-definition-fidx [(i i64)] (-> i64)
  (get (.definition-fidxs (enc-state)) i))

(defn enc-definition-name [(i i64)] (-> (slice u8))
  (get (.definition-names (enc-state)) i))

(defn enc-end-definition! [(encoder i64)
                           (source (dyn NodeOps))
                           (last-instruction (dyn NodeOps))] (-> i64)
  (let [(mut i) 0
        (mut found) false]
    (enc-require-handle encoder)
    (loop (if (or (>= (load i) (enc-definition-count)) (load found))
              (break 0)
              (do
                (match (arena-node (get (.definition-sources (enc-state))
                                        (load i)))
                  (Some [definition]
                        (if (n-same? definition source)
                            (do
                              (set! (mut (.definition-ends (enc-state)))
                                    (load i)
                                    (+ (enc-op-start last-instruction)
                                       (enc-op-length last-instruction)))
                              (set! (mut found) true))
                            0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; Isolated instruction tests may encode a Return without first emitting its Fun. Complete
    ;; scheduled emission registers the definition and therefore always records the explicit end.
    0))

(defn enc-definition-size [(i i64)] (-> i64)
  (let [start (enc-definition-offset i)
        explicit (get (.definition-ends (enc-state)) i)]
    (if (>= explicit 0)
        (- explicit start)
        ;; A hand-built/object-only graph may omit Return. Bound it by the next function, or text.
        (let [(mut j) 0
              (mut end) (enc-byte-count)]
          (loop (if (>= (load j) (enc-definition-count))
                    (break (- (load end) start))
                    (do
                      (let [candidate (enc-definition-offset (load j))]
                        (if (and (> candidate start) (< candidate (load end)))
                            (set! (mut end) candidate)
                            0))
                      (set! (mut j) (+ (load j) 1))
                      (continue))))))))

(defn enc-add8! [(encoder i64) (word i64)] (-> i64)
  (do
    (enc-add4! encoder word)
    (enc-add4! encoder (primitive/ishr word 32))
    0))

(defn enc-require-handle [(encoder i64)] (-> i64)
  (if (= encoder ENCODER-HANDLE)
      0
      (panic-i "encoding: invalid encoder handle" encoder)))

(defn enc-byte-count [] (-> i64)
  (len (.bits (enc-state))))

(defn enc-bytes [] (-> (slice u8))
  (al-slice (.bits (enc-state))))

(defn enc-byte-at [(i i64)] (-> u8)
  (if (or (< i 0) (>= i (enc-byte-count)))
      (do (panic-i "enc-byte-at: index out of range" i) (primitive/cast u8 0))
      (get (.bits (enc-state)) i)))

(defn enc-add1! [(encoder i64) (byte i64)] (-> i64)
  (do
    (enc-require-handle encoder)
    (push! [u8] (mut (.bits (enc-state))) (primitive/cast u8 byte))
    0))

(defn enc-add4! [(encoder i64) (word i64)] (-> i64)
  (let [(mut i) 0
        (mut x) word]
    (enc-require-handle encoder)
    (loop (if (>= (load i) 4)
              (break 0)
              (do
                (enc-add1! encoder (primitive/iand (load x) 255))
                (set! (mut x) (primitive/ishr (load x) 8))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

(defn enc-read4 [(i i64)] (-> i64)
  (if (or (< i 0) (> (+ i 4) (enc-byte-count)))
      (panic-i "enc-read4: index out of range" i)
      (primitive/ior (primitive/cast i64 (enc-byte-at i))
                     (primitive/ior (primitive/ishl (primitive/cast i64
                                                                    (enc-byte-at (+ i
                                                                                    1)))
                                                    8)
                                    (primitive/ior (primitive/ishl (primitive/cast i64
                                                                                   (enc-byte-at (+ i
                                                                                                   2)))
                                                                   16)
                                                   (primitive/ishl (primitive/cast i64
                                                                                   (enc-byte-at (+ i
                                                                                                   3)))
                                                                   24))))))

(defn enc-patch4! [(encoder i64) (i i64) (word i64)] (-> i64)
  (let [(mut j) 0
        (mut x) word]
    (enc-require-handle encoder)
    (if (or (< i 0) (> (+ i 4) (enc-byte-count)))
        (panic-i "enc-patch4!: index out of range" i)
        0)
    (loop (if (>= (load j) 4)
              (break 0)
              (do
                (set! (mut (.bits (enc-state)))
                      (+ i (load j))
                      (primitive/cast u8 (primitive/iand (load x) 255)))
                (set! (mut x) (primitive/ishr (load x) 8))
                (set! (mut j) (+ (load j) 1))
                (continue))))
    0))

(defn enc-op-start [(n (dyn NodeOps))] (-> i64)
  (if (or (>= (n-nid n) (len (.starts (enc-state))))
          (< (get (.starts (enc-state)) (n-nid n)) 0))
      (panic-i "enc-op-start: node was not laid out" (n-nid n))
      (get (.starts (enc-state)) (n-nid n))))

(defn enc-op-length [(n (dyn NodeOps))] (-> i64)
  (if (or (>= (n-nid n) (len (.lengths (enc-state))))
          (< (get (.lengths (enc-state)) (n-nid n)) 0))
      (panic-i "enc-op-length: node was not laid out" (n-nid n))
      (get (.lengths (enc-state)) (n-nid n))))

(defn enc-reg [(encoder i64) (n (dyn NodeOps))] (-> i64)
  (do
    (enc-require-handle encoder)
    (if (< (n-reg n) 0)
        (panic-i "enc-reg: machine value has no allocated location" (n-nid n))
        (n-reg n))))

(defn enc-ideal-op [(n (dyn NodeOps))] (-> i64)
  (match (mach-of n) (Some [mach] (m-ideal-op mach)) (None [] (n-op n))))

(defn enc-emit-function-padding! [(n (dyn NodeOps))] (-> i64)
  (if (= (enc-ideal-op n) OP-FUN)
      (do
        (loop (if (>= (enc-byte-count) (enc-op-start n))
                  (break 0)
                  (do
                    ;; AArch64's architectural NOP keeps alignment bytes executable and
                    ;; disassembly-stable if control ever reaches them through malformed input.
                    (enc-add4! ENCODER-HANDLE 0xd503201f)
                    (continue))))
        (if (> (enc-byte-count) (enc-op-start n))
            (panic-i "enc-emit-function-padding!: padding crossed function start"
                     (n-nid n))
            0))
      0))

(defn enc-emit! [] (-> i64)
  (do
    ;; Static-reference instructions contain section-relative payload offsets, independent of
    ;; the realm's eventual data address. Heap layout is immutable throughout machine emission.
    (heap-image-build!)
    (if (not (.laid-out (enc-state))) (enc-layout!) 0)
    (al-clear! [u8] (mut (.bits (enc-state))))
    (al-clear! [EncMapSite] (mut (.map-sites (enc-state))))
    (al-clear! [EncUnitSite] (mut (.unit-sites (enc-state))))
    (let [(mut ci) 0
          (mut next-island) 0]
      (loop (if (>= (load ci) (enc-layout-block-count))
                (break 0)
                (let [block (enc-layout-block-at (load ci))
                      (mut i) 0]
                  (loop (if (>= (load i) (code-schedule-count block))
                            (break 0)
                            (let [n (code-schedule-at block (load i))]
                              (match (mach-of n)
                                (Some [mach]
                                      (do
                                        (enc-emit-veneer-hub-before! n)
                                        (enc-emit-literal-islands-before! (n-nid n)
                                                                          (mut next-island))
                                        (enc-emit-function-padding! n)
                                        (let [before (enc-byte-count)]
                                          (if (!= before (enc-op-start n))
                                              (panic-i "enc-emit!: emitted offset disagrees with layout"
                                                       (n-nid n))
                                              0)
                                          (m-encoding mach ENCODER-HANDLE)
                                          (if (!= (- (enc-byte-count) before)
                                                  (enc-op-length n))
                                              (panic-i "enc-emit!: wrong size; actual*1000000+expected*1000+op"
                                                       (+ (+ (* (- (enc-byte-count)
                                                                   before)
                                                                1000000)
                                                             (* (enc-op-length n)
                                                                1000))
                                                          (m-ideal-op mach)))
                                              0))))
                                (None [] 0))
                              (set! (mut i) (+ (load i) 1))
                              (continue))))
                  (match (enc-layout-jump-at (load ci))
                    (Some [jump]
                          (match (mach-of jump)
                            (Some [mach]
                                  (do
                                    (enc-emit-veneer-hub-before! jump)
                                    (enc-emit-literal-islands-before! (n-nid jump)
                                                                      (mut next-island))
                                    (let [before (enc-byte-count)]
                                      (if (!= before (enc-op-start jump))
                                          (panic-i "enc-emit!: synthetic jump offset disagrees with layout"
                                                   (n-nid jump))
                                          0)
                                      (m-encoding mach ENCODER-HANDLE)
                                      (if (!= (- (enc-byte-count) before)
                                              (enc-op-length jump))
                                          (panic-i "enc-emit!: synthetic jump emitted wrong size"
                                                   (n-nid jump))
                                          0))))
                            (None []
                                  (panic "enc-emit!: synthetic jump is not a machine node"))))
                    (None [] 0))
                  (set! (mut ci) (+ (load ci) 1))
                  (continue))))
      (enc-emit-literal-islands-before! 0 (mut next-island))
      (if (!= (load next-island) (enc-literal-island-count))
          (panic-i "enc-emit!: unplaced literal island" (load next-island))
          0))
    (set! (.emitted (enc-state)) true)
    (enc-byte-count)))

(defn enc-local-fixup-patch! [(i i64)] (-> i64)
  (let [state (enc-state)
        kind (get (.fixup-kinds state) i)
        source-nid (get (.fixup-sources state) i)
        source-addend (get (.fixup-addends state) i)
        target-nid (get (.fixup-targets state) i)
        source
          (match (arena-node source-nid)
            (Some [n] n)
            (None []
                  (do
                    (panic-i "enc-relocate!: missing fixup source" source-nid)
                    (unreachable-node))))
        target
          (match (arena-node target-nid)
            (Some [n] n)
            (None []
                  (do
                    (panic-i "enc-relocate!: missing fixup target" target-nid)
                    (unreachable-node))))
        at (+ (enc-op-start source) source-addend)
        first-veneer
          (if (= kind ENC-FIXUP-A64-B26)
              (get (.veneer-first-by-source state) source-nid)
              -1)
        destination
          (if (>= first-veneer 0)
              (enc-veneer-entry-offset first-veneer)
              (enc-op-start target))
        delta (- destination at)
        scaled (/ delta 4)
        old (enc-read4 at)]
    (if (!= (* scaled 4) delta)
        (panic-i "enc-relocate!: AArch64 branch target is not word aligned"
                 delta)
        0)
    (if (= kind ENC-FIXUP-A64-B19)
        (if (or (< scaled -262144) (> scaled 262143))
            (panic-i "enc-relocate!: AArch64 conditional branch is out of range"
                     delta)
            (enc-patch4! ENCODER-HANDLE
                         at
                         (primitive/ior (primitive/iand old
                                                        (primitive/ixor (primitive/ishl 0x7ffff
                                                                                        5)
                                                                        -1))
                                        (primitive/ishl (primitive/iand scaled
                                                                        0x7ffff)
                                                        5))))
        (if (or (< scaled -33554432) (> scaled 33554431))
            (panic-i "enc-relocate!: AArch64 branch is out of range" delta)
            (enc-patch4! ENCODER-HANDLE
                         at
                         (primitive/ior (primitive/iand old
                                                        (primitive/ixor 0x3ffffff
                                                                        -1))
                                        (primitive/iand scaled 0x3ffffff)))))
    0))

;; Local fixups are resolved here. Symbol-bearing fixups remain typed records for the object writer;
;; they are deliberately not represented as local node ids.
(defn enc-relocate! [] (-> i64)
  (if (not (.emitted (enc-state)))
      (panic "enc-relocate!: bytes have not been emitted")
      (let [(mut i) 0]
        (loop (if (>= (load i) (enc-fixup-count))
                  (break 0)
                  (do
                    (enc-local-fixup-patch! (load i))
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (enc-veneer-fixups!)
        (enc-literal-pools!))))
