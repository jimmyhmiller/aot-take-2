;; Encoding: machine nodes to bytes, and the relocations that patch them.

;;
;; Two passes, because a branch displacement depends on the size of everything between it and its
;; target, and that size can depend on displacements. Pass one assigns provisional sizes and block
;; addresses; pass two shrinks what can be shrunk and repeats until nothing changes. Encoding
;; before that fixpoint is how a branch ends up off by the size of the instruction that shrank.
;;
;; Cold blocks are laid out out-of-line, which is the only place the cold hint on a guard's slow
;; path is consumed.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S6.
(module aot.codegen.encoding)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(defn enc-layout! [] (-> i64)
  (do (unimplemented "enc-layout!" "S6 — src/codegen/encoding.coil") 0))

(defn enc-emit! [] (-> i64)
  (do (unimplemented "enc-emit!" "S6 — src/codegen/encoding.coil") 0))

(defn enc-relocate! [] (-> i64)
  (do (unimplemented "enc-relocate!" "S6 — src/codegen/encoding.coil") 0))
