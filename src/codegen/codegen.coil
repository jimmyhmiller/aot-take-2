;; Shared compilation state and the phase contract enforced by the production driver.

;;
;; The pipeline is EXPLICIT and ONE-WAY. Each phase asserts the phase it expects to follow and
;; advances the marker, so a pass that runs out of order fails at its own entry rather than on the
;; malformed graph it produces three phases later.
;;
;; This module imports the graph one-way. The node arena, the id counter and the GVN table live in
;; `aot.node.node` precisely so that this file can depend on the graph without the graph depending
;; back on it.
;;
;; `pipeline-compile-macho!` owns the executable source-to-object driver. It enters every phase
;; here before running that phase, including the current single-unit no-persist serialization
;; boundary. The remaining `code-drive!` entry is deliberately a hard-error compatibility shell:
;; it has neither source nor object arguments and therefore cannot drive the production pipeline.
(module aot.codegen.codegen)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

;; The phases, in order. Every one of these exists in the finished compiler; none is optional and
;; none is added later.
(const PHASE-NONE 0)

(const PHASE-PARSE 1)  ; source text -> sea-of-nodes IR, through ScopeNode

(const PHASE-ITER 2)  ; pessimistic peepholes to a fixpoint

(const PHASE-OPTO 3)  ; optimistic interprocedural SCCP; discovers the call graph

(const PHASE-TYPECHECK 4)  ; the last check for bad programs

(const PHASE-LOOPTREE 5)  ; build the loop tree; break infinite loops

(const PHASE-SERIALIZE 6)  ; the ideal graph into the object file, for cross-unit inlining

(const PHASE-UNLINK 7)  ; unlink call sites before machine lowering

(const PHASE-SELECT 8)  ; instruction selection: ideal nodes -> machine nodes

(const PHASE-SCHEDULE 9)  ; global code motion

(const PHASE-LOCALSCHED 10)  ; block-local scheduling

(const PHASE-REGALLOC 11)  ; graph-colouring register allocation

(const PHASE-ENCODING 12)  ; encoding and relocations

(const PHASE-EXPORT 13)  ; the object file

(defstruct CodeGen
  [(phase i64)
   (seed i64)  ; the worklist seed. VARY THIS: order-dependent bugs appear on a minority.
   (cpu i64)  ; which machine port
   (start-nid i64)  ; selected Start root during backend phases
   (stop-nid i64)  ; selected Stop root during backend phases
   (cfg (ArrayList i64))  ; CFG node ids in reverse postorder
   ;; Local instruction order is not stored in Node.outs: those are semantic def-use edges and
   ;; may contain duplicates. `schedule` is flattened block order; lo/hi are indexed by block nid.
   (schedule (ArrayList i64))
   (sched-lo (ArrayList i64))
   (sched-hi (ArrayList i64))
   ;; Split/clone nid -> exact non-Phi use nid. Final Simple mutates the CFG block's ordered
   ;; output list in `insertBefore`; our flattened schedule records that durable placement here.
   (before-use (ArrayList i64))
   ;; Split nid -> exact definition nid, mirroring Simple's `insertAfter` ordered-list mutation.
   (after-def (ArrayList i64))
   (booted bool)])

(defn code [] (-> (ptr CodeGen))
  (primitive/alloc-static CodeGen))

(defn code-phase [] (-> i64)
  (.phase (code)))

;; Advance to `next`, asserting it follows the current phase. A pass that runs out of order dies
;; here, naming both phases, rather than corrupting the graph quietly.
(defn code-enter-phase! [(next i64)] (-> i64)
  (let [cur (code-phase)]
    (if (!= next (+ cur 1))
        (panic-i "code-enter-phase!: phases run out of order" next)
        (do (set! (.phase (code)) next) 0))))

(defn code-reset! [(seed i64)] (-> i64)
  (let [a (alloc/malloc-allocator)]
    (set! (.phase (code)) PHASE-NONE)
    (set! (.seed (code)) seed)
    (set! (.start-nid (code)) 0)
    (set! (.stop-nid (code)) 0)
    (set! (.cfg (code)) (al-new [i64] a))
    (set! (.schedule (code)) (al-new [i64] a))
    (set! (.sched-lo (code)) (al-new [i64] a))
    (set! (.sched-hi (code)) (al-new [i64] a))
    (set! (.before-use (code)) (al-new [i64] a))
    (set! (.after-def (code)) (al-new [i64] a))
    (set! (.booted (code)) true)
    0))

(defn code-record-after-def! [(n (dyn NodeOps)) (def (dyn NodeOps))] (-> i64)
  (let [id (n-nid n)]
    (loop (if (> (len (.after-def (code))) id)
              (break 0)
              (do
                (push! [i64] (mut (.after-def (code))) 0)
                (continue))))
    (set! (mut (.after-def (code))) id (n-nid def))
    0))

(defn code-record-before-use! [(n (dyn NodeOps)) (use_ (dyn NodeOps))] (-> i64)
  (let [id (n-nid n)]
    (loop (if (> (len (.before-use (code))) id)
              (break 0)
              (do
                (push! [i64] (mut (.before-use (code))) 0)
                (continue))))
    (set! (mut (.before-use (code))) id (n-nid use_))
    0))

(defn code-before-use-target [(n (dyn NodeOps))] (-> i64)
  (let [id (n-nid n)]
    (if (or (< id 0) (>= id (len (.before-use (code)))))
        0
        (get (.before-use (code)) id))))

(defn code-after-def-target [(n (dyn NodeOps))] (-> i64)
  (let [id (n-nid n)]
    (if (or (< id 0) (>= id (len (.after-def (code)))))
        0
        (if (= (get (.after-def (code)) id) 0)
            0
            ;; Allocation can insert another Split between this copy and its original def.
            ;; Simple's insertAfterAndReplace rewires that input in the authoritative order;
            ;; our rebuilt schedule must follow the CURRENT def-use edge, not an old nid.
            (n-nid (n-in! n 1))))))

(defn code-set-roots! [(start (dyn NodeOps)) (stop (dyn NodeOps))] (-> i64)
  (do
    (set! (.start-nid (code)) (n-nid start))
    (set! (.stop-nid (code)) (n-nid stop))
    0))

(defn code-start [] (-> (dyn NodeOps))
  (match (arena-node (.start-nid (code)))
    (Some [n] n)
    (None [] (do (panic "code-start: backend Start root is not installed") (unreachable-node)))))

(defn code-stop [] (-> (dyn NodeOps))
  (match (arena-node (.stop-nid (code)))
    (Some [n] n)
    (None [] (do (panic "code-stop: backend Stop root is not installed") (unreachable-node)))))

(defn code-cfg-count [] (-> i64)
  (len (.cfg (code))))

(defn code-cfg-at [(i i64)] (-> (dyn NodeOps))
  (if (or (< i 0) (>= i (len (.cfg (code)))))
      (do (panic-i "code-cfg-at: index out of range" i) (unreachable-node))
      (match (arena-node (get (.cfg (code)) i))
        (Some [n] n)
        (None [] (do (panic-i "code-cfg-at: missing CFG node" (get (.cfg (code)) i))
                     (unreachable-node))))))

(defn code-schedule-reset! [] (-> i64)
  (let [limit (+ (arena-node-count) 1)
        (mut i) 0]
    (al-clear! [i64] (mut (.schedule (code))))
    (al-clear! [i64] (mut (.sched-lo (code))))
    (al-clear! [i64] (mut (.sched-hi (code))))
    (loop (if (>= (load i) limit)
              (break 0)
              (do
                (push! [i64] (mut (.sched-lo (code))) -1)
                (push! [i64] (mut (.sched-hi (code))) -1)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

(defn code-schedule-begin-block! [(block (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (or (< id 0) (>= id (len (.sched-lo (code)))))
        (panic-i "code-schedule-begin-block!: block id outside schedule table" id)
        (do
          (set! (mut (.sched-lo (code))) id (len (.schedule (code))))
          (set! (mut (.sched-hi (code))) id -1)
          0))))

(defn code-schedule-add! [(block (dyn NodeOps)) (n (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (or (< id 0)
            (>= id (len (.sched-lo (code))))
            (< (get (.sched-lo (code)) id) 0)
            (>= (get (.sched-hi (code)) id) 0))
        (panic-i "code-schedule-add!: block is not open" id)
        (push! [i64] (mut (.schedule (code))) (n-nid n)))))

(defn code-schedule-end-block! [(block (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (or (< id 0)
            (>= id (len (.sched-lo (code))))
            (< (get (.sched-lo (code)) id) 0)
            (>= (get (.sched-hi (code)) id) 0))
        (panic-i "code-schedule-end-block!: block is not open" id)
        (do (set! (mut (.sched-hi (code))) id (len (.schedule (code)))) 0))))

(defn code-schedule-ready? [(block (dyn NodeOps))] (-> bool)
  (let [id (n-nid block)]
    (and (>= id 0)
         (and (< id (len (.sched-lo (code))))
              (and (>= (get (.sched-lo (code)) id) 0)
                   (>= (get (.sched-hi (code)) id) 0))))))

(defn code-schedule-count [(block (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (not (code-schedule-ready? block))
        (panic-i "code-schedule-count: block has no completed schedule" id)
        (- (get (.sched-hi (code)) id) (get (.sched-lo (code)) id)))))

(defn code-schedule-at [(block (dyn NodeOps)) (i i64)] (-> (dyn NodeOps))
  (let [id (n-nid block)
        count (code-schedule-count block)]
    (if (or (< i 0) (>= i count))
        (do (panic-i "code-schedule-at: index out of range" i) (unreachable-node))
        (match (arena-node (get (.schedule (code)) (+ (get (.sched-lo (code)) id) i)))
          (Some [n] n)
          (None [] (do (panic "code-schedule-at: scheduled node is missing")
                       (unreachable-node)))))))

(defn code-schedule-compact! [] (-> i64)
  ;; Post-colouring may subsume no-op Split nodes. Their removal cannot invalidate the established
  ;; instruction order, whereas running the dependency scheduler again can: register assignment is
  ;; already fixed, so an otherwise independent definition may no longer move into a proven
  ;; no-clobber interval. Compact the authoritative schedule in place, preserving every survivor's
  ;; relative order exactly as final Simple's ordered block-output removal does.
  (let [a (alloc/malloc-allocator)
        (mut next) (al-new [i64] a)
        (mut ci) 0
        (mut removed) 0]
    (loop (if (>= (load ci) (len (.cfg (code))))
              (break 0)
              (do
                (match (arena-node (get (.cfg (code)) (load ci)))
                  (Some [block]
                        (if (code-schedule-ready? block)
                            (let [id (n-nid block)
                                  old-lo (get (.sched-lo (code)) id)
                                  old-hi (get (.sched-hi (code)) id)
                                  (mut at) old-lo]
                              (set! (mut (.sched-lo (code))) id (len (load next)))
                              (loop (if (>= (load at) old-hi)
                                        (break 0)
                                        (do
                                          (match (arena-node (get (.schedule (code)) (load at)))
                                            (Some [n]
                                                  (if (n-dead? n)
                                                      (set! (mut removed) (+ (load removed) 1))
                                                      (push! [i64] (mut next) (n-nid n))))
                                            (None []
                                                  (panic "code-schedule-compact!: scheduled node disappeared")))
                                          (set! (mut at) (+ (load at) 1))
                                          (continue))))
                              (set! (mut (.sched-hi (code))) id (len (load next))))
                            0))
                  (None [] (panic "code-schedule-compact!: CFG block disappeared")))
                (set! (mut ci) (+ (load ci) 1))
                (continue))))
    (set! (.schedule (code)) (load next))
    (load removed)))

(defn code-schedule-honor-before-uses! [(block (dyn NodeOps))] (-> i64)
  ;; Stable-move every recorded copy to the slots immediately preceding its use. The dependency
  ;; scheduler has already proved def-before-copy-before-use; moving the copies of one use AS A
  ;; GROUP, in their scheduled order, keeps that proof (a copy of a copy stays after its input,
  ;; both being anchored to the same use) and mirrors Simple's authoritative
  ;; `cfg._outputs.insert(copy, use-index)` placement.
  (let [lo (get (.sched-lo (code)) (n-nid block))
        count (code-schedule-count block)
        a (alloc/malloc-allocator)
        (mut group) (al-new [i64] a)
        (mut use-index) 1
        (mut moved) 0]
    (loop (if (>= (load use-index) count)
              (break 0)
              (let [use-id (get (.schedule (code)) (+ lo (load use-index)))
                    (mut copy-index) 1]
                (al-clear! [i64] (mut group))
                (loop (if (>= (load copy-index) (load use-index))
                          (break 0)
                          (let [copy-id (get (.schedule (code)) (+ lo (load copy-index)))]
                            (if (and (< copy-id (len (.before-use (code))))
                                     (= (get (.before-use (code)) copy-id) use-id))
                                (push! [i64] (mut group) copy-id)
                                0)
                            (set! (mut copy-index) (+ (load copy-index) 1))
                            (continue))))
                (if (> (len (load group)) 0)
                    ;; Compact everything before the use that is not in the group, then lay the
                    ;; group down directly before the use in its scheduled order.
                    (let [(mut write) 1 (mut read) 1]
                      (loop (if (>= (load read) (load use-index))
                                (break 0)
                                (let [id (get (.schedule (code)) (+ lo (load read)))
                                      (mut in-group) false
                                      (mut gi) 0]
                                  (loop (if (>= (load gi) (len (load group)))
                                            (break 0)
                                            (do
                                              (if (= (get (load group) (load gi)) id) (set! (mut in-group) true) 0)
                                              (set! (mut gi) (+ (load gi) 1))
                                              (continue))))
                                  (if (load in-group)
                                      0
                                      (do
                                        (if (!= (load write) (load read)) (set! (mut moved) (+ (load moved) 1)) 0)
                                        (set! (mut (.schedule (code))) (+ lo (load write)) id)
                                        (set! (mut write) (+ (load write) 1))))
                                  (set! (mut read) (+ (load read) 1))
                                  (continue))))
                      (let [(mut gi) 0]
                        (loop (if (>= (load gi) (len (load group)))
                                  (break 0)
                                  (do
                                    (set! (mut (.schedule (code))) (+ lo (load write)) (get (load group) (load gi)))
                                    (set! (mut write) (+ (load write) 1))
                                    (set! (mut gi) (+ (load gi) 1))
                                    (continue)))))
                      (if (!= (load write) (load use-index))
                          (panic-i "code-schedule-honor-before-uses!: group placement lost a slot" (load write))
                          0))
                    0)
                (set! (mut use-index) (+ (load use-index) 1))
                (continue))))
    (al-free! [i64] (mut group))
    (load moved)))

(defn code-schedule-honor-after-defs! [(block (dyn NodeOps)) (entry-prefix-end i64)] (-> i64)
  ;; Stable-move each after-definition split back to the slot directly following its definition.
  ;; Multiple copies after the same definition retain scheduler order and remain adjacent.
  (let [lo (get (.sched-lo (code)) (n-nid block))
        count (code-schedule-count block)
        (mut copy-index) 1
        (mut moved) 0]
    (loop (if (>= (load copy-index) count)
              (break 0)
              (let [copy-id (get (.schedule (code)) (+ lo (load copy-index)))]
                (if (and (< copy-id (len (.after-def (code))))
                         (!= (get (.after-def (code)) copy-id) 0))
                    (let [def-id (code-after-def-target (code-schedule-at block (load copy-index)))
                          (mut def-index) 0
                          (mut found) -1]
                      (loop (if (or (>= (load def-index) (load copy-index))
                                    (>= (load found) 0))
                                (break 0)
                                (do
                                  (if (= (get (.schedule (code)) (+ lo (load def-index))) def-id)
                                      (set! (mut found) (load def-index))
                                      0)
                                  (set! (mut def-index) (+ (load def-index) 1))
                                  (continue))))
                      (let [(mut insert-index)
                              (if (< (load found) entry-prefix-end)
                                  entry-prefix-end
                                  (+ (load found) 1))]
                      ;; Preserve earlier sibling copies instead of reversing their established
                      ;; order each time another copy is moved behind the same definition.
                      (loop (if (and (< (load insert-index) (load copy-index))
                                     (= (code-after-def-target (code-schedule-at block (load insert-index))) def-id))
                                (do (set! (mut insert-index) (+ (load insert-index) 1)) (continue))
                                (break 0)))
                      (if (and (>= (load found) 0) (> (load copy-index) (load insert-index)))
                          (let [(mut i) (load copy-index)]
                            (loop (if (<= (load i) (load insert-index))
                                      (break 0)
                                      (do
                                        (set! (mut (.schedule (code)))
                                              (+ lo (load i))
                                              (get (.schedule (code)) (+ lo (- (load i) 1))))
                                        (set! (mut i) (- (load i) 1))
                                        (continue))))
                            (set! (mut (.schedule (code))) (+ lo (load insert-index)) copy-id)
                            (set! (mut moved) (+ (load moved) 1)))
                          0)))
                    0)
                (set! (mut copy-index) (+ (load copy-index) 1))
                (continue))))
    (load moved)))

;; Run the pipeline up to and including `upto`. The whole compiler is this function.
(defn code-drive! [(upto i64)] (-> i64)
  (do (unimplemented "code-drive!" "S1 — src/codegen/codegen.coil") 0))
