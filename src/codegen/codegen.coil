;; Shared compilation state and the phase contract enforced by the production driver.

;;
;; The pipeline is EXPLICIT and ONE-WAY. Each phase asserts the phase it expects to follow and
;; advances the marker, so a pass that runs out of order fails at its own entry rather than on the
;; malformed graph it produces three phases later.
;;
;; This module imports the graph one-way. The node arena, the id counter and the GVN table live in
;; `aot.node.node` precisely so that this file can depend on the graph without the graph depending
;; back on it.
;;
;; `pipeline-compile-macho!` owns the executable source-to-object driver. It enters every phase
;; here before running that phase, including the current single-unit no-persist serialization
;; boundary. The remaining `code-drive!` entry is deliberately a hard-error compatibility shell:
;; it has neither source nor object arguments and therefore cannot drive the production pipeline.
(module aot.codegen.codegen)
(import "coil.primitive" :as primitive)
(import "coil.time" :as time)
(import "coil.os" :as os)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.str" :use [sb-new sb-push-str! sb-push-i64! sb-str])
(import "aot.util.panic" :use *)
(import "aot.util.ary" :use [al-insert-at! al-remove-at!])
(import "aot.node.node" :use *)
(import "aot.codegen.regmask" :use [mask-arena-reset!])

;; The phases, in order. Every one of these exists in the finished compiler; none is optional and
;; none is added later.
(const PHASE-NONE 0)

(const PHASE-PARSE 1)  ; source text -> sea-of-nodes IR, through ScopeNode

(const PHASE-ITER 2)  ; pessimistic peepholes to a fixpoint

(const PHASE-OPTO 3)  ; optimistic interprocedural SCCP; discovers the call graph

(const PHASE-TYPECHECK 4)  ; the last check for bad programs

(const PHASE-LOOPTREE 5)  ; build the loop tree; break infinite loops

(const PHASE-SERIALIZE 6)  ; the ideal graph into the object file, for cross-unit inlining

(const PHASE-UNLINK 7)  ; unlink call sites before machine lowering

(const PHASE-SELECT 8)  ; instruction selection: ideal nodes -> machine nodes

(const PHASE-SCHEDULE 9)  ; global code motion

(const PHASE-LOCALSCHED 10)  ; block-local scheduling

(const PHASE-REGALLOC 11)  ; graph-colouring register allocation

(const PHASE-ENCODING 12)  ; encoding and relocations

(const PHASE-EXPORT 13)  ; the object file

(defstruct CodeGen
  [(phase i64)
   (seed i64)  ; the worklist seed. VARY THIS: order-dependent bugs appear on a minority.
   (cpu i64)  ; which machine port
   (start-nid i64)  ; selected Start root during backend phases
   (stop-nid i64)  ; selected Stop root during backend phases
   (cfg (ArrayList i64))  ; CFG node ids in reverse postorder
   ;; Local instruction order is not stored in Node.outs: those are semantic def-use edges and
   ;; may contain duplicates. Each block head owns an ordered member list, indexed by block nid,
   ;; exactly Simple's `cfg._outputs` order: the allocator inserts copies into it in place.
   (schedule (ArrayList (ArrayList i64)))
   (sched-open (ArrayList bool))  ; per block nid: begun and not yet ended
   (sched-ready (ArrayList bool))  ; per block nid: a completed schedule
   ;; The last compile's shape, for the budget gates (docs/COMPILE-TIME.md §7): allocation rounds,
   ;; scheduled machine nodes, blocks, CalleeSave and Cast machine nodes.
   (stat-rounds i64)
   (stat-machine-nodes i64)
   (stat-blocks i64)
   (stat-callee-saves i64)
   (stat-casts i64)
   ;; Split/clone nid -> exact non-Phi use nid. Final Simple mutates the CFG block's ordered
   ;; output list in `insertBefore`; our flattened schedule records that durable placement here.
   (before-use (ArrayList i64))
   ;; Split nid -> exact definition nid, mirroring Simple's `insertAfter` ordered-list mutation.
   (after-def (ArrayList i64))
   (booted bool)])

(defn code [] (-> (ptr CodeGen))
  (primitive/alloc-static CodeGen))

(defn code-phase [] (-> i64)
  (.phase (code)))

;; Advance to `next`, asserting it follows the current phase. A pass that runs out of order dies
;; here, naming both phases, rather than corrupting the graph quietly.
;; `AOT_TIME=1`: print each phase's wall time as the next begins, so a slow compile names its phase.
(defstruct CodeTimeFlag [(state i64)])  ; 0 unread, 1 on, 2 off

(defn code-time? [] (-> bool)
  (let [f (primitive/alloc-static CodeTimeFlag)]
    (if (= (.state f) 0)
        (set! (.state f) (if (!= (primitive/cast i64 (os/getenv c"AOT_TIME")) 0) 1 2))
        0)
    (= (.state f) 1)))

(defn code-phase-clock [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn code-time-phase! [(finished i64) (next i64)] (-> i64)
  (if (not (code-time?))
      0
      (let [now (try (let [ms (try-or! (time/monotonic-now-ms) 0)] ms))
            clock (code-phase-clock)]
        (if (!= finished PHASE-NONE)
            (do
              (println "aot time: phase {} took {} ms; arena {} nodes (entering phase {})"
                       finished
                       (- now (load clock))
                       (arena-node-count)
                       next)
              0)
            ;; The clock was started by `code-reset!`: everything before the first phase is startup
            ;; (booting the arena and types, loading the JSL library).
            (if (!= (load clock) 0)
                (do (println "aot time: startup took {} ms" (- now (load clock))) 0)
                0))
        (set! clock now)
        0)))

;; The last phase has no successor to report it; the pipeline calls this after the object is written.
(defn code-time-finish! [] (-> i64)
  (if (not (code-time?))
      0
      (let [now (try (let [ms (try-or! (time/monotonic-now-ms) 0)] ms))
            clock (code-phase-clock)]
        (println "aot time: phase {} took {} ms" (code-phase) (- now (load clock)))
        (set! clock now)
        0)))

;; Start the phase clock so the first phase entry can report startup time.
(defn code-time-start! [] (-> i64)
  (if (not (code-time?))
      0
      (let [now (try (let [ms (try-or! (time/monotonic-now-ms) 0)] ms))]
        (set! (code-phase-clock) now)
        0)))

(defn code-enter-phase! [(next i64)] (-> i64)
  (let [cur (code-phase)]
    (if (!= next (+ cur 1))
        (panic-i "code-enter-phase!: phases run out of order" next)
        (do
          (code-time-phase! cur next)
          ;; A phase boundary is the one place a bulk CFG edit (unlinking, selection) is known to
          ;; have finished: refresh every cached dominator depth before the next pass reads one.
          (invalidate-cfg!)
          (set! (.phase (code)) next)
          0))))

(defn code-reset! [(seed i64)] (-> i64)
  (let [a (alloc/malloc-allocator)]
    (code-time-start!)
    (mask-arena-reset!)
    (set! (.phase (code)) PHASE-NONE)
    (set! (.seed (code)) seed)
    (set! (.start-nid (code)) 0)
    (set! (.stop-nid (code)) 0)
    (set! (.cfg (code)) (al-new [i64] a))
    (set! (.schedule (code)) (al-new [(ArrayList i64)] a))
    (set! (.sched-open (code)) (al-new [bool] a))
    (set! (.sched-ready (code)) (al-new [bool] a))
    (set! (.before-use (code)) (al-new [i64] a))
    (set! (.after-def (code)) (al-new [i64] a))
    (set! (.booted (code)) true)
    0))

(defn code-record-after-def! [(n (dyn NodeOps)) (def (dyn NodeOps))] (-> i64)
  (let [id (n-nid n)]
    (loop (if (> (len (.after-def (code))) id)
              (break 0)
              (do
                (push! [i64] (mut (.after-def (code))) 0)
                (continue))))
    (set! (mut (.after-def (code))) id (n-nid def))
    0))

(defn code-record-before-use! [(n (dyn NodeOps)) (use_ (dyn NodeOps))] (-> i64)
  (let [id (n-nid n)]
    (loop (if (> (len (.before-use (code))) id)
              (break 0)
              (do
                (push! [i64] (mut (.before-use (code))) 0)
                (continue))))
    (set! (mut (.before-use (code))) id (n-nid use_))
    0))

(defn code-before-use-target [(n (dyn NodeOps))] (-> i64)
  (let [id (n-nid n)]
    (if (or (< id 0) (>= id (len (.before-use (code)))))
        0
        (get (.before-use (code)) id))))

(defn code-after-def-target [(n (dyn NodeOps))] (-> i64)
  (let [id (n-nid n)]
    (if (or (< id 0) (>= id (len (.after-def (code)))))
        0
        (if (= (get (.after-def (code)) id) 0)
            0
            ;; Allocation can insert another Split between this copy and its original def.
            ;; Simple's insertAfterAndReplace rewires that input in the authoritative order;
            ;; our rebuilt schedule must follow the CURRENT def-use edge, not an old nid.
            (n-nid (n-in! n 1))))))

(defn code-set-roots! [(start (dyn NodeOps)) (stop (dyn NodeOps))] (-> i64)
  (do
    (set! (.start-nid (code)) (n-nid start))
    (set! (.stop-nid (code)) (n-nid stop))
    0))

(defn code-start [] (-> (dyn NodeOps))
  (match (arena-node (.start-nid (code)))
    (Some [n] n)
    (None []
          (do
            (panic "code-start: backend Start root is not installed")
            (unreachable-node)))))

(defn code-stop [] (-> (dyn NodeOps))
  (match (arena-node (.stop-nid (code)))
    (Some [n] n)
    (None []
          (do
            (panic "code-stop: backend Stop root is not installed")
            (unreachable-node)))))

(defn code-cfg-count [] (-> i64)
  (len (.cfg (code))))

(defn code-cfg-at [(i i64)] (-> (dyn NodeOps))
  (if (or (< i 0) (>= i (len (.cfg (code)))))
      (do (panic-i "code-cfg-at: index out of range" i) (unreachable-node))
      (match (arena-node (get (.cfg (code)) i))
        (Some [n] n)
        (None []
              (do
                (panic-i "code-cfg-at: missing CFG node" (get (.cfg (code)) i))
                (unreachable-node))))))

;; Per-block member lists, sized for every node id the arena has handed out.
(defn code-schedule-reset! [] (-> i64)
  (let [limit (+ (arena-node-count) 1)
        a (alloc/malloc-allocator)
        (mut i) 0]
    (al-clear! [(ArrayList i64)] (mut (.schedule (code))))
    (al-clear! [bool] (mut (.sched-open (code))))
    (al-clear! [bool] (mut (.sched-ready (code))))
    (loop (if (>= (load i) limit)
              (break 0)
              (do
                (push! [(ArrayList i64)] (mut (.schedule (code))) (al-new [i64] a))
                (push! [bool] (mut (.sched-open (code))) false)
                (push! [bool] (mut (.sched-ready (code))) false)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

(defn code-schedule--slot [(block (dyn NodeOps)) (who (slice u8))] (-> i64)
  (let [id (n-nid block)]
    (if (or (< id 0) (>= id (len (.schedule (code)))))
        (do (panic-i "code-schedule: block id outside the schedule table" id) 0)
        (do who id))))

(defn code-schedule-begin-block! [(block (dyn NodeOps))] (-> i64)
  (let [id (code-schedule--slot block "begin")]
    (al-clear! [i64] (mut (al-elem [(ArrayList i64)] (mut (.schedule (code))) id)))
    (set! (mut (.sched-open (code))) id true)
    (set! (mut (.sched-ready (code))) id false)
    0))

(defn code-schedule-add! [(block (dyn NodeOps)) (n (dyn NodeOps))] (-> i64)
  (let [id (code-schedule--slot block "add")]
    (if (not (get (.sched-open (code)) id))
        (panic-i "code-schedule-add!: block is not open" id)
        (do (push! [i64] (mut (al-elem [(ArrayList i64)] (mut (.schedule (code))) id)) (n-nid n)) 0))))

(defn code-schedule-end-block! [(block (dyn NodeOps))] (-> i64)
  (let [id (code-schedule--slot block "end")]
    (if (not (get (.sched-open (code)) id))
        (panic-i "code-schedule-end-block!: block is not open" id)
        (do
          (set! (mut (.sched-open (code))) id false)
          (set! (mut (.sched-ready (code))) id true)
          0))))

(defn code-schedule-ready? [(block (dyn NodeOps))] (-> bool)
  (let [id (n-nid block)]
    (and (>= id 0) (< id (len (.sched-ready (code)))) (get (.sched-ready (code)) id))))

(defn code-schedule-count [(block (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (not (code-schedule-ready? block))
        (panic-i "code-schedule-count: block has no completed schedule" id)
        (len (get (.schedule (code)) id)))))

(defn code-schedule-at [(block (dyn NodeOps)) (i i64)] (-> (dyn NodeOps))
  (let [id (n-nid block)
        count (code-schedule-count block)]
    (if (or (< i 0) (>= i count))
        (do
          (panic-i "code-schedule-at: index out of range" i)
          (unreachable-node))
        (match (arena-node (get (get (.schedule (code)) id) i))
          (Some [n] n)
          (None []
                (do
                  (panic "code-schedule-at: scheduled node is missing")
                  (unreachable-node)))))))

;; Record the shape of the allocated program for the budget gates (the pipeline counts, since only
;; it can ask a machine node for its ideal opcode).
(defn code-set-stats! [(rounds i64) (nodes i64) (blocks i64) (saves i64) (casts i64)] (-> i64)
  (do
    (set! (.stat-rounds (code)) rounds)
    (set! (.stat-machine-nodes (code)) nodes)
    (set! (.stat-blocks (code)) blocks)
    (set! (.stat-callee-saves (code)) saves)
    (set! (.stat-casts (code)) casts)
    0))

(defn code-stat-rounds [] (-> i64) (.stat-rounds (code)))
(defn code-stat-machine-nodes [] (-> i64) (.stat-machine-nodes (code)))
(defn code-stat-blocks [] (-> i64) (.stat-blocks (code)))
(defn code-stat-callee-saves [] (-> i64) (.stat-callee-saves (code)))
(defn code-stat-casts [] (-> i64) (.stat-casts (code)))

(defn code-schedule-compact! [] (-> i64)
  ;; Post-colouring may subsume no-op Split nodes, and splitting rewires copies to death. Their
  ;; removal cannot invalidate the established instruction order, whereas running the dependency
  ;; scheduler again can: register assignment is already fixed. Drop dead members in place,
  ;; preserving every survivor's relative order exactly as Simple's ordered block-output removal.
  (let [(mut ci) 0
        (mut removed) 0]
    (loop (if (>= (load ci) (len (.cfg (code))))
              (break 0)
              (do
                (match (arena-node (get (.cfg (code)) (load ci)))
                  (Some [block]
                        (if (code-schedule-ready? block)
                            (let [id (n-nid block)
                                  (mut i) 0]
                              (loop (if (>= (load i) (len (get (.schedule (code)) id)))
                                        (break 0)
                                        (match (arena-node (get (get (.schedule (code)) id) (load i)))
                                          (Some [n]
                                                (if (n-dead? n)
                                                    (do
                                                      (al-remove-at! [i64] (mut (al-elem [(ArrayList i64)] (mut (.schedule (code))) id)) (load i))
                                                      (set! (mut removed) (+ (load removed) 1)))
                                                    (do (set! (mut i) (+ (load i) 1)) (continue))))
                                          (None []
                                                (panic "code-schedule-compact!: scheduled node disappeared"))))))
                            0))
                  (None []
                        (panic "code-schedule-compact!: CFG block disappeared")))
                (set! (mut ci) (+ (load ci) 1))
                (continue))))
    (load removed)))

;; The position of `nid` in this block's schedule, or -1.
(defn code-schedule-position [(block (dyn NodeOps)) (nid i64)] (-> i64)
  (let [members (get (.schedule (code)) (n-nid block))
        count (code-schedule-count block)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) count) (>= (load found) 0))
              (break 0)
              (do
                (if (= (get members (load i)) nid) (set! (mut found) (load i)) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; Insert `nid` at `index` of `block`'s schedule: Simple's `cfg._outputs.insert`. The list scheduler
;; runs once, before allocation; the allocator's copies are inserted here and never re-scheduled.
(defn code-schedule-insert-at! [(block (dyn NodeOps)) (index i64) (nid i64)] (-> i64)
  (let [id (n-nid block)
        count (code-schedule-count block)]
    (if (or (< index 0) (> index count))
        (panic-i "code-schedule-insert-at!: index outside the block" index)
        (do (al-insert-at! [i64] (mut (al-elem [(ArrayList i64)] (mut (.schedule (code))) id)) index nid) 0))))

;; Simple's `insertBefore(use)`: immediately before the use in the use's block.
(defn code-schedule-insert-before! [(block (dyn NodeOps)) (use-nid i64) (nid i64)] (-> i64)
  (let [at (code-schedule-position block use-nid)]
    (if (< at 0)
        (panic-i "code-schedule-insert-before!: use is not scheduled in the block" use-nid)
        (code-schedule-insert-at! block at nid))))

;; Simple's `insertBefore(phi, arm)`: at the end of the predecessor block, ahead of its control
;; tail when the tail is scheduled (a block that falls through has none).
(defn code-schedule-insert-before-tail! [(block (dyn NodeOps)) (has-tail bool) (nid i64)] (-> i64)
  (let [count (code-schedule-count block)]
    (code-schedule-insert-at! block (if has-tail (- count 1) count) nid)))

;; Simple's `insertAfter(def)`: directly after the definition, but never inside the block's entry
;; cluster (`floor`: the index after the Phis, Parms and CalleeSaves), where Simple also skips.
(defn code-schedule-insert-after! [(block (dyn NodeOps)) (def-nid i64) (nid i64) (floor i64)] (-> i64)
  (let [at (code-schedule-position block def-nid)]
    (if (< at 0)
        (panic-i "code-schedule-insert-after!: definition is not scheduled in the block" def-nid)
        (code-schedule-insert-at! block (if (< (+ at 1) floor) floor (+ at 1)) nid))))

;; Whether `nid` is in this block's current local schedule.
(defn code-schedule-index-of [(block (dyn NodeOps)) (nid i64)] (-> bool)
  (>= (code-schedule-position block nid) 0))

;; Run the pipeline up to and including `upto`. The whole compiler is this function.
(defn code-drive! [(upto i64)] (-> i64)
  (do (unimplemented "code-drive!" "S1 — src/codegen/codegen.coil") 0))
