;; Shared compilation state and the phase contract enforced by the production driver.

;;
;; The pipeline is EXPLICIT and ONE-WAY. Each phase asserts the phase it expects to follow and
;; advances the marker, so a pass that runs out of order fails at its own entry rather than on the
;; malformed graph it produces three phases later.
;;
;; This module imports the graph one-way. The node arena, the id counter and the GVN table live in
;; `aot.node.node` precisely so that this file can depend on the graph without the graph depending
;; back on it.
;;
;; `pipeline-compile-macho!` owns the executable source-to-object driver. It enters every phase
;; here before running that phase, including the current single-unit no-persist serialization
;; boundary. The remaining `code-drive!` entry is deliberately a hard-error compatibility shell:
;; it has neither source nor object arguments and therefore cannot drive the production pipeline.
(module aot.codegen.codegen)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

;; The phases, in order. Every one of these exists in the finished compiler; none is optional and
;; none is added later.
(const PHASE-NONE 0)

(const PHASE-PARSE 1)  ; source text -> sea-of-nodes IR, through ScopeNode

(const PHASE-ITER 2)  ; pessimistic peepholes to a fixpoint

(const PHASE-OPTO 3)  ; optimistic interprocedural SCCP; discovers the call graph

(const PHASE-TYPECHECK 4)  ; the last check for bad programs

(const PHASE-LOOPTREE 5)  ; build the loop tree; break infinite loops

(const PHASE-SERIALIZE 6)  ; the ideal graph into the object file, for cross-unit inlining

(const PHASE-UNLINK 7)  ; unlink call sites before machine lowering

(const PHASE-SELECT 8)  ; instruction selection: ideal nodes -> machine nodes

(const PHASE-SCHEDULE 9)  ; global code motion

(const PHASE-LOCALSCHED 10)  ; block-local scheduling

(const PHASE-REGALLOC 11)  ; graph-colouring register allocation

(const PHASE-ENCODING 12)  ; encoding and relocations

(const PHASE-EXPORT 13)  ; the object file

(defstruct CodeGen
  [(phase i64)
   (seed i64)  ; the worklist seed. VARY THIS: order-dependent bugs appear on a minority.
   (cpu i64)  ; which machine port
   (start-nid i64)  ; selected Start root during backend phases
   (stop-nid i64)  ; selected Stop root during backend phases
   (cfg (ArrayList i64))  ; CFG node ids in reverse postorder
   ;; Local instruction order is not stored in Node.outs: those are semantic def-use edges and
   ;; may contain duplicates. `schedule` is flattened block order; lo/hi are indexed by block nid.
   (schedule (ArrayList i64))
   (sched-lo (ArrayList i64))
   (sched-hi (ArrayList i64))
   (booted bool)])

(defn code [] (-> (ptr CodeGen))
  (primitive/alloc-static CodeGen))

(defn code-phase [] (-> i64)
  (.phase (code)))

;; Advance to `next`, asserting it follows the current phase. A pass that runs out of order dies
;; here, naming both phases, rather than corrupting the graph quietly.
(defn code-enter-phase! [(next i64)] (-> i64)
  (let [cur (code-phase)]
    (if (!= next (+ cur 1))
        (panic-i "code-enter-phase!: phases run out of order" next)
        (do (set! (.phase (code)) next) 0))))

(defn code-reset! [(seed i64)] (-> i64)
  (let [a (alloc/malloc-allocator)]
    (set! (.phase (code)) PHASE-NONE)
    (set! (.seed (code)) seed)
    (set! (.start-nid (code)) 0)
    (set! (.stop-nid (code)) 0)
    (set! (.cfg (code)) (al-new [i64] a))
    (set! (.schedule (code)) (al-new [i64] a))
    (set! (.sched-lo (code)) (al-new [i64] a))
    (set! (.sched-hi (code)) (al-new [i64] a))
    (set! (.booted (code)) true)
    0))

(defn code-set-roots! [(start (dyn NodeOps)) (stop (dyn NodeOps))] (-> i64)
  (do
    (set! (.start-nid (code)) (n-nid start))
    (set! (.stop-nid (code)) (n-nid stop))
    0))

(defn code-start [] (-> (dyn NodeOps))
  (match (arena-node (.start-nid (code)))
    (Some [n] n)
    (None [] (do (panic "code-start: backend Start root is not installed") (unreachable-node)))))

(defn code-stop [] (-> (dyn NodeOps))
  (match (arena-node (.stop-nid (code)))
    (Some [n] n)
    (None [] (do (panic "code-stop: backend Stop root is not installed") (unreachable-node)))))

(defn code-cfg-count [] (-> i64)
  (len (.cfg (code))))

(defn code-cfg-at [(i i64)] (-> (dyn NodeOps))
  (if (or (< i 0) (>= i (len (.cfg (code)))))
      (do (panic-i "code-cfg-at: index out of range" i) (unreachable-node))
      (match (arena-node (get (.cfg (code)) i))
        (Some [n] n)
        (None [] (do (panic-i "code-cfg-at: missing CFG node" (get (.cfg (code)) i))
                     (unreachable-node))))))

(defn code-schedule-reset! [] (-> i64)
  (let [limit (+ (arena-node-count) 1)
        (mut i) 0]
    (al-clear! [i64] (mut (.schedule (code))))
    (al-clear! [i64] (mut (.sched-lo (code))))
    (al-clear! [i64] (mut (.sched-hi (code))))
    (loop (if (>= (load i) limit)
              (break 0)
              (do
                (push! [i64] (mut (.sched-lo (code))) -1)
                (push! [i64] (mut (.sched-hi (code))) -1)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

(defn code-schedule-begin-block! [(block (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (or (< id 0) (>= id (len (.sched-lo (code)))))
        (panic-i "code-schedule-begin-block!: block id outside schedule table" id)
        (do
          (set! (mut (.sched-lo (code))) id (len (.schedule (code))))
          (set! (mut (.sched-hi (code))) id -1)
          0))))

(defn code-schedule-add! [(block (dyn NodeOps)) (n (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (or (< id 0)
            (>= id (len (.sched-lo (code))))
            (< (get (.sched-lo (code)) id) 0)
            (>= (get (.sched-hi (code)) id) 0))
        (panic-i "code-schedule-add!: block is not open" id)
        (push! [i64] (mut (.schedule (code))) (n-nid n)))))

(defn code-schedule-end-block! [(block (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (or (< id 0)
            (>= id (len (.sched-lo (code))))
            (< (get (.sched-lo (code)) id) 0)
            (>= (get (.sched-hi (code)) id) 0))
        (panic-i "code-schedule-end-block!: block is not open" id)
        (do (set! (mut (.sched-hi (code))) id (len (.schedule (code)))) 0))))

(defn code-schedule-count [(block (dyn NodeOps))] (-> i64)
  (let [id (n-nid block)]
    (if (or (< id 0)
            (>= id (len (.sched-lo (code))))
            (< (get (.sched-lo (code)) id) 0)
            (< (get (.sched-hi (code)) id) 0))
        (panic-i "code-schedule-count: block has no completed schedule" id)
        (- (get (.sched-hi (code)) id) (get (.sched-lo (code)) id)))))

(defn code-schedule-at [(block (dyn NodeOps)) (i i64)] (-> (dyn NodeOps))
  (let [id (n-nid block)
        count (code-schedule-count block)]
    (if (or (< i 0) (>= i count))
        (do (panic-i "code-schedule-at: index out of range" i) (unreachable-node))
        (match (arena-node (get (.schedule (code)) (+ (get (.sched-lo (code)) id) i)))
          (Some [n] n)
          (None [] (do (panic "code-schedule-at: scheduled node is missing")
                       (unreachable-node)))))))

;; Run the pipeline up to and including `upto`. The whole compiler is this function.
(defn code-drive! [(upto i64)] (-> i64)
  (do (unimplemented "code-drive!" "S1 — src/codegen/codegen.coil") 0))
