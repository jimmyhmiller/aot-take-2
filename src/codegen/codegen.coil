;; The compilation driver: the phase pipeline and the singleton it runs over.

;;
;; The pipeline is EXPLICIT and ONE-WAY. Each phase asserts the phase it expects to follow and
;; advances the marker, so a pass that runs out of order fails at its own entry rather than on the
;; malformed graph it produces three phases later.
;;
;; This module imports the graph one-way. The node arena, the id counter and the GVN table live in
;; `aot.node.node` precisely so that this file can depend on the graph without the graph depending
;; back on it.
;;
;; SCAFFOLD: the phase order is final and is the architecture; bodies hard-error.
(module aot.codegen.codegen)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

;; The phases, in order. Every one of these exists in the finished compiler; none is optional and
;; none is added later.
(const PHASE-NONE 0)

(const PHASE-PARSE 1)  ; source text -> sea-of-nodes IR, through ScopeNode

(const PHASE-ITER 2)  ; pessimistic peepholes to a fixpoint

(const PHASE-OPTO 3)  ; optimistic interprocedural SCCP; discovers the call graph

(const PHASE-TYPECHECK 4)  ; the last check for bad programs

(const PHASE-LOOPTREE 5)  ; build the loop tree; break infinite loops

(const PHASE-SERIALIZE 6)  ; the ideal graph into the object file, for cross-unit inlining

(const PHASE-UNLINK 7)  ; unlink call sites before machine lowering

(const PHASE-SELECT 8)  ; instruction selection: ideal nodes -> machine nodes

(const PHASE-SCHEDULE 9)  ; global code motion

(const PHASE-LOCALSCHED 10)  ; block-local scheduling

(const PHASE-REGALLOC 11)  ; graph-colouring register allocation

(const PHASE-ENCODING 12)  ; encoding and relocations

(const PHASE-EXPORT 13)  ; the object file

(defstruct CodeGen
  [(phase i64)
   (seed i64)  ; the worklist seed. VARY THIS: order-dependent bugs appear on a minority.
   (cpu i64)  ; which machine port
   (booted bool)])

(defn code [] (-> (ptr CodeGen))
  (primitive/alloc-static CodeGen))

(defn code-phase [] (-> i64)
  (.phase (code)))

;; Advance to `next`, asserting it follows the current phase. A pass that runs out of order dies
;; here, naming both phases, rather than corrupting the graph quietly.
(defn code-enter-phase! [(next i64)] (-> i64)
  (let [cur (code-phase)]
    (if (!= next (+ cur 1))
        (panic-i "code-enter-phase!: phases run out of order" next)
        (do (set! (.phase (code)) next) 0))))

(defn code-reset! [(seed i64)] (-> i64)
  (do
    (set! (.phase (code)) PHASE-NONE)
    (set! (.seed (code)) seed)
    (set! (.booted (code)) true)
    0))

;; Run the pipeline up to and including `upto`. The whole compiler is this function.
(defn code-drive! [(upto i64)] (-> i64)
  (do (unimplemented "code-drive!" "S1 — src/codegen/codegen.coil") 0))
