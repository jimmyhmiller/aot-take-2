;; The machine port interface.

;;
;; Simple's `Machine` is an abstract class; here it is a trait, and each CPU port provides one
;; implementation. Instruction selection is `mach-select`, which maps one ideal node to one machine
;; node — a per-port `case` over the opcode, which is the ONE place a port is allowed to know the
;; whole ideal opcode set.
;;
;; SCAFFOLD: the trait is final; the ports hard-error. Filled in at S6.
(module aot.codegen.machine)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(deftrait Machine [Self]
  ;; "arm64", "x86_64".
  (mach-name [(self (ptr Self))] (-> (slice u8)))
  ;; Human-readable register names, indexed by register number.
  (mach-reg-name [(self (ptr Self)) (reg i64)] (-> (slice u8)))
  ;; Ideal node -> machine node. The port's only whole-opcode-set dispatch.
  (mach-select [(self (ptr Self)) (n (dyn NodeOps))] (-> (dyn NodeOps)))
  ;; Registers a call clobbers.
  (mach-caller-save [(self (ptr Self))] (-> i64))
  ;; Registers that are never saved: a stack pointer, a hardwired zero.
  (mach-never-save [(self (ptr Self))] (-> i64))
  ;; Where argument `arg` of a call with signature `sig` must live.
  (mach-arg-mask [(self (ptr Self)) (sig i64) (arg i64)] (-> i64))
  ;; Where a result must live.
  (mach-ret-mask [(self (ptr Self)) (sig i64)] (-> i64))
  ;; A register-to-register (or slot-to-slot) copy, used by splitting.
  (mach-split [(self (ptr Self)) (lrg i64)] (-> (dyn NodeOps))))

;; The machine nodes themselves: what the allocator and encoder ask of them.
(deftrait MachNode [Self]
  (m-regmap [(self (ptr Self)) (i i64)] (-> i64))  ; mask allowed on input i
  (m-outregmap [(self (ptr Self))] (-> i64))  ; mask allowed for the result
  (m-killmap [(self (ptr Self))] (-> i64))  ; registers destroyed
  (m-two-address [(self (ptr Self))] (-> i64))  ; 0, or the input the output must share
  (m-commutes [(self (ptr Self))] (-> bool))
  (m-encoding [(self (ptr Self))] (-> i64))  ; append bytes, gather relocations
  (m-asm [(self (ptr Self))] (-> (slice u8))))
