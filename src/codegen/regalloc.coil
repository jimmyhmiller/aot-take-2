;; ============================================================================

;; REGISTER ALLOCATION  —  port of Simple's RegAlloc, BuildLRG, IFG, Coalesce, LRG
;; ============================================================================
;;
;; Graph colouring, in ROUNDS. Simple's own summary of the main algorithm, which is the contract:
;;
;;     Repeat until coloured:
;;       Build Live Ranges (LRGs)
;;       - Intersect allowed registers
;;       If hard conflicts (LRGs with no allowed registers)
;;       - Pre-split conflicted LRGs, and repeat
;;       Build Interference Graph (IFG)
;;       - Self conflicts split now
;;       Colour (remove trivial first then any until empty; reverse assign colours)
;;       - If colour fails:
;;       - - Split uncolourable LRGs
;;
;; "Attempt, split, retry" IS the algorithm. An allocator that cannot iterate cannot handle a
;; program that genuinely needs spills. Simple caps it at 8 rounds and hard-errors past that rather
;; than looping forever — a budget that is exceeded is a bug in splitting, not a reason to keep
;; going.
;;
;; ## Two economies worth preserving
;;
;; **Liveness and the interference graph are built in ONE pass.** One fewer traversal per round,
;; and there are up to eight rounds.
;;
;; **A single-register def or use DENIES rather than INTERFERES.** If a live range can only live in
;; RAX, then instead of adding interference edges to every neighbour, it simply removes RAX from
;; each neighbour's allowed set. Simple measures this as a 5x smaller IFG — and the IFG is the only
;; O(n^2) structure in the allocator. Almost every function call does this, as do oddball
;; fixed-register ops like older div/mod/mul.
;;
;; ## What makes this harder than a textbook allocator
;;
;; **Fixed constraints.** Calling conventions pin arguments and results to particular registers, and
;; some machine ops demand a specific one. These are not preferences; a colouring that ignores them
;; is wrong, not merely slow.
;;
;; **Caller/callee save.** A live range crossing a call must be in a callee-save register or be
;; spilled. Simple materialises this: before allocation it adds a `CalleeSave` node to every
;; function's Return for each callee-save register, so the requirement becomes ordinary interference
;; in the same graph rather than a special case in the colourer.
;;
;; **Stack slots continue the register numbering.** Registers are numbered densely from 0, and spill
;; slots continue upward from the last register. So a "register" is either a real register or a
;; spill slot, and SPILLING IS JUST ASSIGNING A HIGHER-NUMBERED REGISTER — not a separate mechanism.
;; See src/codegen/regmask.coil.
;;
;; **Loop Phis get one chance.** A loop Phi that self-conflicts is first split only on its COLD
;; edges; if it self-conflicts again on the next round, its hot def and back edge are split too.
;; Splitting the hot edge first would put a copy in the loop body for a conflict that the cold split
;; would have resolved.
;;
;; ## Safepoint liveness carries KINDS, not just liveness  (our addition — Simple has no GC)
;;
;; A slot live at a safepoint is a raw reference, a NaN-boxed word that may CONTAIN a reference, or
;; a scalar — and the collector needs to know which. Liveness that only answers "is it live" cannot
;; produce a stack map for a moving collector, so the kind rides along with the live range from
;; here into src/codegen/gcmeta.coil.
;;
;; ## Post-colouring
;;
;; `postColor` removes no-op spills — a split whose two halves ended up in the same register is a
;; register-to-register move from a register to itself.
;;
;; SCAFFOLD: the algorithm above is final; bodies hard-error. Filled in at S6.
(module aot.codegen.regalloc)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

;; Simple gives up after 8 rounds. Exceeding it means splitting is not making progress.
(const RA-MAX-ROUNDS 8)

;; Live-range kinds, for the stack map. Not in Simple; required by a moving collector.
(const LRG-SCALAR 0)

(const LRG-RAW-REF 1)

(const LRG-BOXED 2)

;; ---------------------------------------------------------------------------
;; The top driver

;; Insert CalleeSave nodes, cache register masks for New and Call, then round after round of
;; colour-or-split until coloured or the budget is exhausted.
(defn ra-run! [] (-> i64)
  (do (unimplemented "ra-run!" "S6 — src/codegen/regalloc.coil") 0))

;; One round: BuildLRG, then IFG build, then coalesce, then colour. Returns true when coloured.
;; Short-circuits: a hard register conflict in BuildLRG means there is no point building the IFG.
(defn ra-graph-colour! [(round i64)] (-> bool)
  (do (unimplemented "ra-graph-colour!" "S6 — src/codegen/regalloc.coil") false))

;; ---------------------------------------------------------------------------
;; The four stages

;; Build live ranges and intersect their allowed register sets. Fails the round on a live range
;; whose allowed set is empty — a hard conflict, which is pre-split before anything else runs.
(defn ra-build-lrg! [(round i64)] (-> bool)
  (do (unimplemented "ra-build-lrg!" "S6 — src/codegen/regalloc.coil") false))

;; Build the interference graph — liveness and interference in ONE pass. A single-register def or
;; use DENIES its register to neighbours rather than adding an edge.
(defn ra-build-ifg! [(round i64)] (-> bool)
  (do (unimplemented "ra-build-ifg!" "S6 — src/codegen/regalloc.coil") false))

;; Coalesce away copies whose two ends do not interfere.
(defn ra-coalesce! [(round i64)] (-> bool)
  (do (unimplemented "ra-coalesce!" "S6 — src/codegen/regalloc.coil") false))

;; Colour: remove trivially-colourable nodes first, then any, until the graph is empty; then assign
;; colours in reverse removal order. False if some live range could not be coloured.
(defn ra-colour! [(round i64)] (-> bool)
  (do (unimplemented "ra-colour!" "S6 — src/codegen/regalloc.coil") false))

;; ---------------------------------------------------------------------------
;; Splitting

;; Split every failed live range. Sorted by live-range id so that splitting is DETERMINISTIC —
;; an allocator whose output depends on hash order is not reproducible, and a golden test over it
;; is worthless.
(defn ra-split-all! [(round i64)] (-> i64)
  (do (unimplemented "ra-split-all!" "S6 — src/codegen/regalloc.coil") 0))

(defn ra-split-one! [(round i64) (lrg i64)] (-> bool)
  (do (unimplemented "ra-split-one!" "S6 — src/codegen/regalloc.coil") false))

;; A live range that conflicts with ITSELF — typically a Phi whose inputs need different registers.
;; Loop Phis are split cold-edges-first; see the header.
(defn ra-split-self-conflict! [(round i64) (lrg i64)] (-> bool)
  (do (unimplemented "ra-split-self-conflict!" "S6 — src/codegen/regalloc.coil") false))

;; Remove no-op spills: a split whose halves landed in the same register.
(defn ra-post-colour! [] (-> i64)
  (do (unimplemented "ra-post-colour!" "S6 — src/codegen/regalloc.coil") 0))
