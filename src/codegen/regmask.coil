;; Register masks and the stack-slot numbering.

;;
;; Registers are numbered densely from 0, and STACK SLOTS CONTINUE THAT NUMBERING upward from the
;; last register. A "register" in the allocator is therefore either a real register or a spill
;; slot, and spilling is assigning a higher-numbered register rather than a separate mechanism.
;;
;; A mask is a bitset over that numbering: which locations may hold this value.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S6.
(module aot.codegen.regmask)
(import "aot.util.panic" :use *)

(defn mask-empty [] (-> i64)
  0)

(defn mask-of [(reg i64)] (-> i64)
  (do (unimplemented "mask-of" "S6 — src/codegen/regmask.coil") 0))

(defn mask-and [(a i64) (b i64)] (-> i64)
  (do (unimplemented "mask-and" "S6 — src/codegen/regmask.coil") 0))

(defn mask-size [(m i64)] (-> i64)
  (do (unimplemented "mask-size" "S6 — src/codegen/regmask.coil") 0))
