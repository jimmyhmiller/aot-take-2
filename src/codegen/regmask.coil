;; ============================================================================

;; REGISTER MASKS  —  final-Simple semantics without a fixed bit ceiling
;; ============================================================================
;;
;; Allocation uses one location namespace: physical registers first, then incoming argument and
;; spill slots. Final Simple's fixed 128 bits are explicitly a capacity compromise. arm64 consumes
;; locations 0..64 before stack slot zero, so copying that limit would leave only 63 stack slots.
;;
;; A mask is therefore an immutable bitset plus `stack-tail`. Explicit words can name any fixed
;; location. `stack-tail` means every location at or above `stack-base` is allowed, faithfully
;; representing the conceptually infinite spill mask. Operations produce fresh masks, so
;; machine-node constraints and LRG intersections never share mutable storage.
;;
;; Representation, chosen by measurement: the first two words (locations 0..127, every register and
;; the first spill slots) live inline, and words beyond them are an ArrayList created only when
;; such a location is named explicitly (a deep spill slot as a singleton); Simple's two `long`s are
;; the same shape. Masks are bump-allocated from chunks the compiler resets once per compile
;; (`mask-arena-reset!`): the allocator asks for a mask operation at every live range it visits at
;; every kill, and a malloc per operation was a large share of allocation time.
(module aot.codegen.regmask)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)

(const MASK-WORD-BITS 64)

(const MASK-INLINE-WORDS 2)

(const MASK-CHUNK 4096)

(defstruct RegMask
  [(stack-tail i64)
   (stack-base i64)
   (w0 i64)
   (w1 i64)
   (more (ArrayList i64))  ; words 2.., present only when an explicit location >= 128 was named
   (has-more bool)])

;; The bump arena: stable chunks, reused across compiles.
(defstruct MaskArena
  [(chunks (ArrayList (ptr RegMask)))
   (chunk i64)  ; index of the chunk being filled
   (used i64)  ; masks handed out of that chunk
   (booted bool)])

(defn mask-arena [] (-> (ptr MaskArena))
  (let [t
          (compiler-state [MaskArena]
                          (primitive/alloc-static CompilerStateSlot))]
    (if (.booted t)
        t
        (do
          (set! (.chunks t) (al-new [(ptr RegMask)] (compiler-allocator)))
          (set! (.chunk t) 0)
          (set! (.used t) 0)
          (set! (.booted t) true)
          t))))

;; Start a compile: every mask made before this is dead. Chunks are kept and refilled.
(defn mask-arena-reset! [] (-> i64)
  (let [t (mask-arena)]
    (set! (.chunk t) 0)
    (set! (.used t) 0)
    0))

(defn mask--alloc [] (-> (ptr RegMask))
  (let [t (mask-arena)]
    (if (>= (.used t) MASK-CHUNK)
        (do (set! (.chunk t) (+ (.chunk t) 1)) (set! (.used t) 0))
        0)
    (if (>= (.chunk t) (len (.chunks t)))
        (push! [(ptr RegMask)]
               (mut (.chunks t))
               (match (alloc/alloc [RegMask] (compiler-allocator) MASK-CHUNK)
                 (Some [chunk] (alloc/alloc-slice-data [RegMask] chunk))
                 (None []
                       (do
                         (alloc/oom-at c"mask--alloc: chunk" (* MASK-CHUNK 64))
                         (primitive/cast (ptr RegMask) 0)))))
        0)
    (let [p (primitive/index (get (.chunks t) (.chunk t)) (.used t))]
      (set! (.used t) (+ (.used t) 1))
      p)))

;; The tail rendered as one word: every bit at or above `base` within word `word`.
(defn mask--tail-word [(stack-tail i64) (base i64) (word i64)] (-> i64)
  (if (= stack-tail 0)
      0
      (let [word-lo (* word MASK-WORD-BITS)]
        (if (>= word-lo base)
            -1
            (if (<= (+ word-lo MASK-WORD-BITS) base)
                0
                (primitive/ishl -1 (- base word-lo)))))))

(impl RegMask
  ;; Stored words are authoritative (they carry the tail's bits where the tail covers them, and may
  ;; punch holes in it); the tail alone answers for words beyond the stored ones.
  (new [(stack-tail i64) (stack-base i64)]
       (-> (ptr RegMask))
       (let [p (mask--alloc)]
         (set! (.stack-tail p) stack-tail)
         (set! (.stack-base p) stack-base)
         (set! (.w0 p) (mask--tail-word stack-tail stack-base 0))
         (set! (.w1 p) (mask--tail-word stack-tail stack-base 1))
         (set! (.has-more p) false)
         p))

  (none []
        (-> (ptr RegMask))
        (RegMask::new 0 0))

  ;; A permanent copy outside the arena, for the few masks a target caches across compiles (its
  ;; register classes, its kill set). Everything else dies at `mask-arena-reset!`.
  (pin [(m (ptr RegMask))]
       (-> (ptr RegMask))
       (let [a (compiler-allocator)
             p (alloc/unwrap-ptr [RegMask] (alloc/create [RegMask] a))]
         (set! (.stack-tail p) (.stack-tail m))
         (set! (.stack-base p) (.stack-base m))
         (set! (.w0 p) (.w0 m))
         (set! (.w1 p) (.w1 m))
         (set! (.has-more p) (.has-more m))
         (if (.has-more m)
             (do
               (set! (.more p) (al-new [i64] a))
               (al-for [w (.more m)] (push! [i64] (mut (.more p)) w)))
             0)
         p))

  ;; Explicit words present (inline plus any deep words).
  (nwords [(m (ptr RegMask))]
          (-> i64)
          (if (.has-more m)
              (+ MASK-INLINE-WORDS (len (.more m)))
              MASK-INLINE-WORDS))

  (explicit-word [(m (ptr RegMask)) (word i64)]
                 (-> i64)
                 (if (= word 0)
                     (.w0 m)
                     (if (= word 1)
                         (.w1 m)
                         (get (.more m) (- word MASK-INLINE-WORDS)))))

  ;; Word `word` of the mask: a stored word as it is, the tail beyond the stored words.
  (word-at [(m (ptr RegMask)) (word i64)]
           (-> i64)
           (if (< word 0)
               0
               (if (< word (nwords m))
                   (explicit-word m word)
                   (mask--tail-word (.stack-tail m) (.stack-base m) word))))

  ;; Store word `word`; deep words created on the way are the tail's rendering, so they stay exact.
  (set-word! [(m (ptr RegMask)) (word i64) (value i64)]
             (-> i64)
             (if (= word 0)
                 (do (set! (.w0 m) value) 0)
                 (if (= word 1)
                     (do (set! (.w1 m) value) 0)
                     (do
                       (if (not (.has-more m))
                           (do
                             (set! (.more m)
                                   (al-new [i64] (compiler-allocator)))
                             (set! (.has-more m) true))
                           0)
                       (loop (if (> (len (.more m)) (- word MASK-INLINE-WORDS))
                                 (break 0)
                                 (do
                                   (push! [i64]
                                          (mut (.more m))
                                          (mask--tail-word (.stack-tail m)
                                                           (.stack-base m)
                                                           (+ MASK-INLINE-WORDS
                                                              (len (.more m)))))
                                   (continue))))
                       (set! (mut (.more m)) (- word MASK-INLINE-WORDS) value)
                       0))))

  (stack [(stack-base i64)]
         (-> (ptr RegMask))
         (if (< stack-base 0)
             (do
               (panic-i "mask-stack: negative stack base" stack-base)
               (RegMask::none))
             (RegMask::new 1 stack-base)))

  (set-explicit! [(m (ptr RegMask)) (reg i64)]
                 (-> i64)
                 (let [word (/ reg MASK-WORD-BITS)
                       bit (% reg MASK-WORD-BITS)]
                   ;; `mask-word`, not the raw stored word: a deep word may not exist yet, and a new stored word
                   ;; must carry the tail's bits it now speaks for.
                   (set-word! m
                              word
                              (| (word-at m word) (primitive/ishl 1 bit)))))

  (of [(reg i64)]
      (-> (ptr RegMask))
      (if (< reg 0)
          (do (panic-i "mask-of: negative register" reg) (RegMask::none))
          (let [m (RegMask::none)]
            (set-explicit! m reg)
            m)))

  (range [(lo i64) (hi i64)]
         (-> (ptr RegMask))
         (if (or (< lo 0) (< hi lo))
             (do (panic "mask-range: invalid inclusive range") (RegMask::none))
             (let [m (RegMask::none)
                   (mut reg) lo]
               (loop (if (> (load reg) hi)
                         (break 0)
                         (do
                           (set-explicit! m (load reg))
                           (set! (mut reg) (+ (load reg) 1))
                           (continue))))
               m)))

  (has-reg? [(m (ptr RegMask)) (reg i64)]
            (-> bool)
            (if (< reg 0)
                false
                (let [word (/ reg MASK-WORD-BITS)
                      bit (% reg MASK-WORD-BITS)]
                  (if (< word (nwords m))
                      (!= (& (explicit-word m word) (primitive/ishl 1 bit)) 0)
                      (and (!= (.stack-tail m) 0) (>= reg (.stack-base m)))))))

  (intersect [(a (ptr RegMask)) (b (ptr RegMask))]
             (-> (ptr RegMask))
             (mask--binary a b 0))

  (union [(a (ptr RegMask)) (b (ptr RegMask))]
         (-> (ptr RegMask))
         (mask--binary a b 1))

  (minus [(a (ptr RegMask)) (b (ptr RegMask))]
         (-> (ptr RegMask))
         (mask--binary a b 2))

  (overlaps? [(a (ptr RegMask)) (b (ptr RegMask))]
             (-> bool)
             (let [words
                     (if (> (nwords a) (nwords b))
                         (nwords a)
                         (nwords b))
                   (mut i) 0
                   (mut yes) false]
               (loop (if (or (>= (load i) words) (load yes))
                         (break 0)
                         (do
                           (if (!= (& (word-at a (load i)) (word-at b (load i)))
                                   0)
                               (set! (mut yes) true)
                               0)
                           (set! (mut i) (+ (load i) 1))
                           (continue))))
               (or (load yes)
                   (and (!= (.stack-tail a) 0) (!= (.stack-tail b) 0)))))

  (none? [(m (ptr RegMask))]
         (-> bool)
         (if (!= (.stack-tail m) 0)
             false
             (let [(mut i) 0
                   (mut empty) true]
               (loop (if (or (>= (load i) (nwords m)) (not (load empty)))
                         (break 0)
                         (do
                           (if (!= (explicit-word m (load i)) 0)
                               (set! (mut empty) false)
                               0)
                           (set! (mut i) (+ (load i) 1))
                           (continue))))
               (load empty))))

  ;; Infinite stack masks report -1. Pressure code intersects with the finite physical mask first.
  (size [(m (ptr RegMask))]
        (-> i64)
        (if (!= (.stack-tail m) 0)
            -1
            (let [(mut i) 0
                  (mut count) 0]
              (loop (if (>= (load i) (nwords m))
                        (break 0)
                        (do
                          (set! (mut count)
                                (+ (load count)
                                   (primitive/popcount (explicit-word m
                                                                      (load i)))))
                          (set! (mut i) (+ (load i) 1))
                          (continue))))
              (load count))))

  (singleton? [(m (ptr RegMask))]
              (-> bool)
              (= (size m) 1))

  (first-reg [(m (ptr RegMask))]
             (-> i64)
             (let [(mut i) 0]
               (loop (if (>= (load i) (nwords m))
                         (break (if (!= (.stack-tail m) 0) (.stack-base m) -1))
                         (let [word (explicit-word m (load i))]
                           (if (!= word 0)
                               (break (+ (* (load i) MASK-WORD-BITS)
                                         (primitive/ctz word)))
                               (do (set! (mut i) (+ (load i) 1)) (continue))))))))

  (same-set? [(a (ptr RegMask)) (b (ptr RegMask))]
             (-> bool)
             (if (or (!= (.stack-tail a) (.stack-tail b))
                     (and (!= (.stack-tail a) 0)
                          (!= (.stack-base a) (.stack-base b))))
                 false
                 (let [words
                         (if (> (nwords a) (nwords b))
                             (nwords a)
                             (nwords b))
                       (mut i) 0
                       (mut same) true]
                   (loop (if (or (>= (load i) words) (not (load same)))
                             (break 0)
                             (do
                               (if (!= (word-at a (load i))
                                       (word-at b (load i)))
                                   (set! (mut same) false)
                                   0)
                               (set! (mut i) (+ (load i) 1))
                               (continue))))
                   (load same)))))

;; op: 0 intersection, 1 union, 2 subtraction.
(defn mask--binary [(a (ptr RegMask)) (b (ptr RegMask)) (op i64)] (-> (ptr RegMask))
  (let [tail
          (if (= op 0)
              (and (!= (.stack-tail a) 0) (!= (.stack-tail b) 0))
              (if (= op 1)
                  (or (!= (.stack-tail a) 0) (!= (.stack-tail b) 0))
                  (and (!= (.stack-tail a) 0) (= (.stack-tail b) 0))))
        base
          (if tail
              (if (= op 0)
                  (if (> (.stack-base a) (.stack-base b))
                      (.stack-base a)
                      (.stack-base b))
                  (if (= op 1)
                      (if (and (!= (.stack-tail a) 0) (!= (.stack-tail b) 0))
                          (if (< (.stack-base a) (.stack-base b))
                              (.stack-base a)
                              (.stack-base b))
                          (if (!= (.stack-tail a) 0)
                              (.stack-base a)
                              (.stack-base b)))
                      (.stack-base a)))
              0)
        out (RegMask::new (if tail 1 0) base)
        explicit-words
          (if (> (nwords a) (nwords b))
              (nwords a)
              (nwords b))
        a-bound
          (if (!= (.stack-tail a) 0) (+ (/ (.stack-base a) MASK-WORD-BITS) 1) 0)
        b-bound
          (if (!= (.stack-tail b) 0) (+ (/ (.stack-base b) MASK-WORD-BITS) 1) 0)
        words
          (if (> explicit-words a-bound)
              (if (> explicit-words b-bound) explicit-words b-bound)
              (if (> a-bound b-bound) a-bound b-bound))
        (mut i) 0]
    (loop (if (>= (load i) words)
              (break 0)
              (let [aw (word-at a (load i))
                    bw (word-at b (load i))
                    word
                      (if (= op 0)
                          (& aw bw)
                          (if (= op 1) (| aw bw) (& aw (^ bw -1))))]
                ;; Every computed word is stored: a stored word is authoritative and may punch a
                ;; hole in the tail; a deep word equal to the tail's own rendering is left implied.
                (if (or (< (load i) MASK-INLINE-WORDS)
                        (!= word (mask--tail-word (if tail 1 0) base (load i))))
                    (set-word! out (load i) word)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    out))
