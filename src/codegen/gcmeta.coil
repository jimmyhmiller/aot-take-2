;; GC metadata: where safepoints go, and the stack maps they carry.

;;
;; Safepoint PLACEMENT is a policy decision made here, not in the graph: at every call, at every
;; loop back edge, and at every allocation. The nodes themselves are abstract (`aot.node.gc`) so
;; that the policy can change without touching them.
;;
;; A STACK MAP RECORDS KINDS, NOT MERELY LIVENESS. Because a NaN-boxed word may contain a
;; reference, each live slot is tagged raw-reference, boxed-word, or scalar. A collector handed
;; only "which slots are live" cannot tell a double from a pointer, and a moving collector that
;; guesses corrupts the heap.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S8.
(module aot.codegen.gcmeta)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.gc" :use *)
(import "aot.type.type" :use *)
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.encoding" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.codegen.regalloc" :use *)

(const SLOT-SCALAR 0)

(const SLOT-RAW-REF 1)

(const SLOT-BOXED 2)

(defstruct GcMetaState
  [(safepoint-nids (ArrayList i64))
   (return-pcs (ArrayList i64))
   (frame-sizes (ArrayList i64))
   (rpc-offsets (ArrayList i64))
   (slot-los (ArrayList i64))
   (slot-his (ArrayList i64))
   (locations (ArrayList i64))
   (kinds (ArrayList i64))
   (ready bool)])

(defn gcmeta-state [] (-> (ptr GcMetaState))
  (primitive/alloc-static GcMetaState))

(defn gcmeta-reset! [] (-> i64)
  (let [a (alloc/malloc-allocator) state (gcmeta-state)]
    (set! (.safepoint-nids state) (al-new [i64] a))
    (set! (.return-pcs state) (al-new [i64] a))
    (set! (.frame-sizes state) (al-new [i64] a))
    (set! (.rpc-offsets state) (al-new [i64] a))
    (set! (.slot-los state) (al-new [i64] a))
    (set! (.slot-his state) (al-new [i64] a))
    (set! (.locations state) (al-new [i64] a))
    (set! (.kinds state) (al-new [i64] a))
    (set! (.ready state) true)
    0))

(defn gcmeta-ready? [] (-> bool)
  (.ready (gcmeta-state)))

(defn gc-stackmap-count [] (-> i64)
  (if (gcmeta-ready?) (len (.safepoint-nids (gcmeta-state))) 0))

(defn gcmeta-put1! [(out (mut (ArrayList u8))) (v i64)] (-> i64)
  (do (push! [u8] (mut out) (primitive/cast u8 v)) 0))

(defn gcmeta-put4! [(out (mut (ArrayList u8))) (v i64)] (-> i64)
  (do
    (gcmeta-put1! (mut out) v)
    (gcmeta-put1! (mut out) (primitive/ishr v 8))
    (gcmeta-put1! (mut out) (primitive/ishr v 16))
    (gcmeta-put1! (mut out) (primitive/ishr v 24))
    0))

(defn gcmeta-put8! [(out (mut (ArrayList u8))) (v i64)] (-> i64)
  (do (gcmeta-put4! (mut out) v) (gcmeta-put4! (mut out) (primitive/ishr v 32)) 0))

;; One target-neutral section format is consumed by both object writers and the runtime:
;;   magic[8] = "AOTSMAP\0", u32 version, u32 record-count;
;;   record = u64 safepoint-id, u64 text-relative-return-pc, u32 slot-count,
;;            u32 frame-size, u32 saved-rpc-offset, u32 reserved;
;;   slot = u32 caller-SP-relative-byte-offset, u8 kind, u8[3] reserved.
;; Fixed-width records keep parsing allocation-free and make malformed-section bounds checks exact.
(defn gc-stackmap-bytes [] (-> (slice u8))
  (let [a (alloc/malloc-allocator) (mut out) (al-new [u8] a) (mut i) 0]
    (if (not (gcmeta-ready?))
        (al-slice (load out))
        (do
          (gcmeta-put1! (mut out) 0x41)
          (gcmeta-put1! (mut out) 0x4f)
          (gcmeta-put1! (mut out) 0x54)
          (gcmeta-put1! (mut out) 0x53)
          (gcmeta-put1! (mut out) 0x4d)
          (gcmeta-put1! (mut out) 0x41)
          (gcmeta-put1! (mut out) 0x50)
          (gcmeta-put1! (mut out) 0)
          (gcmeta-put4! (mut out) 3)
          (gcmeta-put4! (mut out) (gc-stackmap-count))
          (loop (if (>= (load i) (gc-stackmap-count))
                    (break 0)
                    (do
                      (gcmeta-put8! (mut out) (gc-stackmap-safepoint-nid (load i)))
                      (gcmeta-put8! (mut out) (gc-stackmap-return-pc (load i)))
                      (gcmeta-put4! (mut out) (gc-stackmap-slot-count (load i)))
                      (gcmeta-put4! (mut out) (gc-stackmap-frame-size (load i)))
                      (gcmeta-put4! (mut out) (gc-stackmap-rpc-offset (load i)))
                      (gcmeta-put4! (mut out) 0)
                      (let [(mut slot) 0]
                        (loop (if (>= (load slot) (gc-stackmap-slot-count (load i)))
                                  (break 0)
                                  (do
                                    (gcmeta-put4! (mut out)
                                                  (gc-stackmap-location (load i) (load slot)))
                                    (gcmeta-put1! (mut out)
                                                  (gc-stackmap-kind (load i) (load slot)))
                                    (gcmeta-put1! (mut out) 0)
                                    (gcmeta-put1! (mut out) 0)
                                    (gcmeta-put1! (mut out) 0)
                                    (set! (mut slot) (+ (load slot) 1))
                                    (continue)))))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (al-slice (load out))))))

(defn gc-stackmap-safepoint-nid [(i i64)] (-> i64)
  (get (.safepoint-nids (gcmeta-state)) i))

(defn gc-stackmap-return-pc [(i i64)] (-> i64)
  (get (.return-pcs (gcmeta-state)) i))

(defn gc-stackmap-slot-count [(i i64)] (-> i64)
  (- (get (.slot-his (gcmeta-state)) i) (get (.slot-los (gcmeta-state)) i)))

(defn gc-stackmap-frame-size [(i i64)] (-> i64)
  (get (.frame-sizes (gcmeta-state)) i))

(defn gc-stackmap-rpc-offset [(i i64)] (-> i64)
  (get (.rpc-offsets (gcmeta-state)) i))

(defn gc-stackmap-location [(map-index i64) (slot-index i64)] (-> i64)
  (get (.locations (gcmeta-state))
       (+ (get (.slot-los (gcmeta-state)) map-index) slot-index)))

(defn gc-stackmap-kind [(map-index i64) (slot-index i64)] (-> i64)
  (get (.kinds (gcmeta-state)) (+ (get (.slot-los (gcmeta-state)) map-index) slot-index)))

(defn gc-safepoint-op? [(n (dyn NodeOps))] (-> bool)
  (match (mach-of n)
    (Some [mach]
          (let [op (m-ideal-op mach)]
            (or (= op OP-CALL)
                (= op OP-NEW)
                (= op OP-JSOP)
                (= op OP-SAFEPOINT))))
    (None [] false)))

(defn gc-explicit-safepoint? [(n (dyn NodeOps))] (-> bool)
  (match (mach-of n) (Some [mach] (= (m-ideal-op mach) OP-SAFEPOINT)) (None [] false)))

(defn gc-schedule-position [(block (dyn NodeOps)) (needle (dyn NodeOps))] (-> i64)
  (let [(mut i) 0 (mut answer) -1]
    (loop (if (or (>= (load i) (code-schedule-count block)) (>= (load answer) 0))
              (break (load answer))
              (do
                (if (n-same? (code-schedule-at block (load i)) needle)
                    (set! (mut answer) (load i))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load answer)))

(defn gc-block-node [(nid i64)] (-> (Option (dyn NodeOps)))
  (if (= nid 0) (None [(dyn NodeOps)]) (arena-node nid)))

(defn gc-block-dominates? [(dom (dyn NodeOps)) (block (dyn NodeOps))] (-> bool)
  (let [(mut cur) (Some block) (mut found) false (mut guard) 0]
    (loop (if (or (load found)
                  (match (load cur) (Some [_] false) (None [] true)))
              (break (load found))
              (match (load cur)
                (Some [n]
                      (if (n-same? n dom)
                          (set! (mut found) true)
                          (if (> (load guard) (arena-node-count))
                              (do
                                (panic-i "gc-block-dominates?: idom chain did not converge"
                                         (n-nid block))
                                (set! (mut cur) (None [(dyn NodeOps)])))
                              (do
                                (set! (mut cur) (cfg-idom-of n))
                                (set! (mut guard) (+ (load guard) 1))
                                (continue)))))
                (None [] (break false)))))
    (load found)))

(defn gc-effective-use-block [(use (dyn NodeOps)) (input i64)] (-> (Option (dyn NodeOps)))
  (match (mach-of use)
    (Some [mach]
          (if (and (= (m-ideal-op mach) OP-PHI) (> input 0))
              (match (n-in use 0)
                (Some [region]
                      (match (n-in region input)
                        (Some [pred] (gc-block-node (n-block-nid pred)))
                        (None [] (None [(dyn NodeOps)]))))
                (None [] (None [(dyn NodeOps)])))
              (gc-block-node (n-block-nid use))))
    (None [] (gc-block-node (n-block-nid use)))))

(defn gc-use-after-safepoint? [(sp (dyn NodeOps))
                               (sp-block (dyn NodeOps))
                               (value (dyn NodeOps))
                               (use (dyn NodeOps))] (-> bool)
  (if (n-same? use sp)
      false
      (let [(mut input) 0 (mut after) false]
        (loop (if (or (>= (load input) (n-nins use)) (load after))
                  (break (load after))
                  (do
                    (match (n-in use (load input))
                      (Some [def]
                            (if (n-same? def value)
                                (match (gc-effective-use-block use (load input))
                                  (Some [use-block]
                                        (if (n-same? use-block sp-block)
                                            (let [sp-pos (gc-schedule-position sp-block sp)
                                                  use-pos (gc-schedule-position sp-block use)]
                                              ;; Phi operands are consumed on the predecessor edge,
                                              ;; after every scheduled instruction in that block.
                                              (if (or (< use-pos 0) (> use-pos sp-pos))
                                                  (set! (mut after) true)
                                                  0))
                                            (if (gc-block-dominates? sp-block use-block)
                                                (set! (mut after) true)
                                                0)))
                                  (None [] 0))
                                0))
                      (None [] 0))
                    (set! (mut input) (+ (load input) 1))
                    (continue))))
        (load after))))

;; Verify R2 after selection and scheduling, when both instruction order and cross-block dominance
;; are authoritative. Earlier uses of a live value remain legal; any same-block-later or dominated
;; use must read the relocation projection instead of the pre-safepoint definition.
(defn gc-verify-relocations? [] (-> bool)
  (let [(mut ci) 0 (mut valid) true]
    (loop (if (or (>= (load ci) (code-cfg-count)) (not (load valid)))
              (break (load valid))
              (let [block (code-cfg-at (load ci)) (mut si) 0]
                (loop (if (or (>= (load si) (code-schedule-count block)) (not (load valid)))
                          (break 0)
                          (let [sp (code-schedule-at block (load si))]
                            (if (gc-explicit-safepoint? sp)
                                (let [(mut live-input) 2]
                                  (loop (if (or (>= (load live-input) (n-nins sp))
                                                (not (load valid)))
                                            (break 0)
                                            (do
                                              (match (n-in sp (load live-input))
                                              (Some [value]
                                                    (let [(mut oi) 0]
                                                      (loop (if (or (>= (load oi) (n-nouts value))
                                                                    (not (load valid)))
                                                                (break 0)
                                                                (do
                                                                  (match (n-out value (load oi))
                                                                    (Some [use]
                                                                          (if (gc-use-after-safepoint?
                                                                                sp block value use)
                                                                              (set! (mut valid) false)
                                                                              0))
                                                                    (None [] 0))
                                                                  (set! (mut oi) (+ (load oi) 1))
                                                                  (continue))))))
                                                (None [] (set! (mut valid) false)))
                                              (set! (mut live-input) (+ (load live-input) 1))
                                              (continue)))))
                                0)
                            (set! (mut si) (+ (load si) 1))
                            (continue))))
                (set! (mut ci) (+ (load ci) 1))
                (continue))))
    (load valid)))

;; ---------------------------------------------------------------------------
;; Liveness for the stack maps
;;
;; The maps need, at each safepoint, exactly the live ranges that hold a managed value across it.
;; That is a liveness fact about the FINAL graph — after coalescing removed copies and rewired
;; phi arms — so it is computed here from that graph, as one backward dataflow over live-range
;; ids. The allocator's own live-out table is the wrong source: it names definition nodes as they
;; stood when the interference graph was built, and a phi arm it recorded may since have been
;; coalesced away (the node is dead, the arm now another node in another live range), which once
;; left a phi's range "live" through a predecessor it was never in and asked the map for a stack
;; home that range legitimately does not have.
;;
;; Phi arms are uses on their predecessor edge, not in the merge block, exactly as the allocator
;; treats them; phi definitions kill at the merge head.

(defstruct GcLiveness
  [(lrgs i64)
   (words i64)                  ; 64-bit words per block row
   (blocks i64)
   (index (ArrayList i64))      ; node id -> block index + 1, zero for non-blocks
   (out (ArrayList i64))        ; blocks x words, one bit per live range
   (samples (ArrayList i64))])  ; lrg -> some node in it, for messages

(defn gc-liveness-block-index [(lv (ptr GcLiveness)) (block (dyn NodeOps))] (-> i64)
  (let [nid (n-nid block)]
    (if (or (< nid 0) (>= nid (len (.index lv))))
        (do (n-panic! "gc-liveness-block-index: node outside the arena" block) -1)
        (- (get (.index lv) nid) 1))))

(defn gc-liveness-out? [(lv (ptr GcLiveness)) (b i64) (lrg i64)] (-> bool)
  (!= (primitive/iand (get (.out lv) (+ (* b (.words lv)) (primitive/ishr lrg 6)))
                      (primitive/ishl 1 (primitive/iand lrg 63)))
      0))

(defn gc-liveness-set-out! [(lv (ptr GcLiveness)) (b i64) (lrg i64)] (-> i64)
  (let [at (+ (* b (.words lv)) (primitive/ishr lrg 6))]
    (set! (mut (.out lv)) at (primitive/ior (get (.out lv) at) (primitive/ishl 1 (primitive/iand lrg 63))))
    0))

;; Simple has no collector and no second liveness. Ours is one word-level dataflow over live-range
;; ids: a backward walk of each block once gives its GEN (uses exposed upward) and KILL (definitions)
;; rows; Phi arms are uses on their predecessor edge and are OR-ed into that predecessor's live-out
;; once, before the fixpoint; then a block worklist runs live-in = GEN | (OUT & ~KILL) and pushes
;; each predecessor whose OUT grew, 64 live ranges per word. The earlier version re-walked every
;; node of every block on every iteration and tested one bit at a time; it cost as much as the
;; whole optimizer on the test262 harness.

(defn gc-row-at [(lv (ptr GcLiveness)) (b i64)] (-> i64)
  (* b (.words lv)))

(defn gc-bit-set! [(rows (mut (ArrayList i64))) (row i64) (lrg i64)] (-> i64)
  (let [at (+ row (primitive/ishr lrg 6))]
    (set! (mut rows) at (primitive/ior (get (load rows) at) (primitive/ishl 1 (primitive/iand lrg 63))))
    0))

(defn gc-bit-clear! [(rows (mut (ArrayList i64))) (row i64) (lrg i64)] (-> i64)
  (let [at (+ row (primitive/ishr lrg 6))]
    (set! (mut rows) at (primitive/iand (get (load rows) at) (primitive/ixor (primitive/ishl 1 (primitive/iand lrg 63)) -1)))
    0))

;; The predecessor controls of a block head, as the allocator walks them: a Region, Loop or Stop
;; head lists them from input 1 (the index is the Phi arm); any other head has one at input 0;
;; Start and Fun have none. Fills `preds` with (predecessor block index, arm) pairs; returns the count.
(defn gc-block-preds! [(lv (ptr GcLiveness)) (block (dyn NodeOps)) (preds (mut (ArrayList i64)))] (-> i64)
  (do
    (al-clear! [i64] (mut preds))
    (match (mach-of block)
      (None [] 0)
      (Some [mach]
            (let [op (m-ideal-op mach)]
              (if (or (= op OP-START) (= op OP-FUN))
                  0
                  (if (or (= op OP-REGION) (= op OP-LOOP) (= op OP-STOP))
                      (let [(mut i) 1]
                        (loop (if (>= (load i) (n-nins block))
                                  (break 0)
                                  (do
                                    (match (n-in block (load i))
                                      (Some [pred]
                                            (let [pb (gc-liveness-block-index lv (ra-ifg-block-of pred))]
                                              (if (< pb 0)
                                                  (n-panic! "gc-block-preds!: predecessor is not a CFG block" pred)
                                                  0)
                                              (push! [i64] (mut preds) pb)
                                              (push! [i64] (mut preds) (load i))))
                                      (None [] 0))
                                    (set! (mut i) (+ (load i) 1))
                                    (continue)))))
                      (match (n-in block 0)
                        (Some [pred]
                              (let [pb (gc-liveness-block-index lv (ra-ifg-block-of pred))]
                                (if (< pb 0) (n-panic! "gc-block-preds!: predecessor is not a CFG block" pred) 0)
                                (push! [i64] (mut preds) pb)
                                (push! [i64] (mut preds) 0)))
                        (None [] 0)))))))
    (/ (len (load preds)) 2)))

;; GEN and KILL of one block from a single backward walk. Phi arms are edge uses: OR-ed straight
;; into the predecessor's live-out row.
(defn gc-block-gen-kill! [(lv (ptr GcLiveness))
                          (block (dyn NodeOps))
                          (b i64)
                          (gen (mut (ArrayList i64)))
                          (kill (mut (ArrayList i64)))
                          (preds (mut (ArrayList i64)))] (-> i64)
  (let [row (gc-row-at lv b)
        (mut i) (- (code-schedule-count block) 1)]
    (loop (if (< (load i) 0)
              (break 0)
              (let [n (code-schedule-at block (load i))]
                (match (mach-of n)
                  (None [] 0)
                  (Some [mach]
                        (do
                          (if (!= (n-lrg n) 0)
                              (let [l (ra-find! (n-lrg n))]
                                (gc-bit-clear! (mut gen) row l)
                                (gc-bit-set! (mut kill) row l))
                              0)
                          (if (or (= (m-ideal-op mach) OP-PHI) (= (m-ideal-op mach) OP-MEMPHI))
                              0
                              (let [(mut k) 1]
                                (loop (if (>= (load k) (n-nins n))
                                          (break 0)
                                          (do
                                            (match (m-regmap mach (load k))
                                              (Some [_]
                                                    (match (n-in n (load k))
                                                      (Some [def]
                                                            (if (!= (n-lrg def) 0)
                                                                (gc-bit-set! (mut gen) row (ra-find! (n-lrg def)))
                                                                0))
                                                      (None [] 0)))
                                              (None [] 0))
                                            (set! (mut k) (+ (load k) 1))
                                            (continue))))))
                          0)))
                (set! (mut i) (- (load i) 1))
                (continue))))
    (let [npreds (gc-block-preds! lv block (mut preds))
          (mut si) 0]
      (if (> npreds 0)
          (loop (if (>= (load si) (code-schedule-count block))
                    (break 0)
                    (let [phi (code-schedule-at block (load si))]
                      (if (ra-phi? phi)
                          (let [(mut p) 0]
                            (loop (if (>= (load p) npreds)
                                      (break 0)
                                      (let [pb (get (load preds) (* 2 (load p)))
                                            arm (get (load preds) (+ (* 2 (load p)) 1))]
                                        (if (and (> arm 0) (< arm (n-nins phi)))
                                            (match (n-in phi arm)
                                              (Some [input]
                                                    (if (!= (n-lrg input) 0)
                                                        (gc-liveness-set-out! lv pb (ra-find! (n-lrg input)))
                                                        0))
                                              (None [] 0))
                                            0)
                                        (set! (mut p) (+ (load p) 1))
                                        (continue)))))
                          0)
                      (set! (mut si) (+ (load si) 1))
                      (continue))))
          0))
    0))

(defn gc-compute-liveness! [] (-> (ptr GcLiveness))
  (let [a (alloc/malloc-allocator)
        lv (alloc/unwrap-ptr [GcLiveness] (alloc/create [GcLiveness] a))
        lrgs (+ (ra-lrg-count) 1)
        blocks (code-cfg-count)]
    (set! (.lrgs lv) lrgs)
    (set! (.words lv) (+ (primitive/ishr lrgs 6) 1))
    (set! (.blocks lv) blocks)
    (set! (.index lv) (al-new [i64] a))
    (set! (.out lv) (al-new [i64] a))
    (set! (.samples lv) (al-new [i64] a))
    (let [(mut i) 0]
      (loop (if (> (load i) (arena-node-count))
                (break 0)
                (do (push! [i64] (mut (.index lv)) 0) (set! (mut i) (+ (load i) 1)) (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) blocks)
                (break 0)
                (do
                  (set! (mut (.index lv)) (n-nid (code-cfg-at (load i))) (+ (load i) 1))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) (* blocks (.words lv)))
                (break 0)
                (do (push! [i64] (mut (.out lv)) 0) (set! (mut i) (+ (load i) 1)) (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) lrgs)
                (break 0)
                (do (push! [i64] (mut (.samples lv)) 0)
                    (set! (mut i) (+ (load i) 1)) (continue))))
      ;; A representative node per live range, live nodes preferred, for the messages.
      (set! (mut i) 1)
      (loop (if (> (load i) (arena-node-count))
                (break 0)
                (do
                  (match (arena-node (load i))
                    (Some [n]
                          (if (and (!= (n-lrg n) 0) (not (n-dead? n)))
                              (let [l (ra-find! (n-lrg n))]
                                (if (= (get (.samples lv) l) 0) (set! (mut (.samples lv)) l (load i)) 0))
                              0))
                    (None [] 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    ;; GEN/KILL once per block, then the worklist fixpoint on words.
    (let [words (.words lv)
          (mut gen) (al-new [i64] a)
          (mut kill) (al-new [i64] a)
          (mut preds) (al-new [i64] a)
          (mut work) (al-new [i64] a)
          (mut on-work) (al-new [bool] a)
          (mut i) 0]
      (loop (if (>= (load i) (* blocks words))
                (break 0)
                (do (push! [i64] (mut gen) 0) (push! [i64] (mut kill) 0) (set! (mut i) (+ (load i) 1)) (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) blocks)
                (break 0)
                (let [block (code-cfg-at (load i))]
                  (if (code-schedule-ready? block)
                      (gc-block-gen-kill! lv block (load i) (mut gen) (mut kill) (mut preds))
                      0)
                  ;; Successors before predecessors: the reverse order converges in few passes.
                  (push! [i64] (mut work) (- (- blocks 1) (load i)))
                  (push! [bool] (mut on-work) true)
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (loop (match (pop! (mut work))
              (None [] (break 0))
              (Some [b]
                    (let [block (code-cfg-at b)
                          row (gc-row-at lv b)
                          npreds (gc-block-preds! lv block (mut preds))
                          (mut p) 0]
                      (set! (mut on-work) b false)
                      (loop (if (>= (load p) npreds)
                                (break 0)
                                (let [pb (get (load preds) (* 2 (load p)))
                                      prow (gc-row-at lv pb)
                                      (mut w) 0
                                      (mut grew) false]
                                  (loop (if (>= (load w) words)
                                            (break 0)
                                            (let [in-word
                                                    (primitive/ior (get (load gen) (+ row (load w)))
                                                                   (primitive/iand (get (.out lv) (+ row (load w)))
                                                                                   (primitive/ixor (get (load kill) (+ row (load w))) -1)))
                                                  old (get (.out lv) (+ prow (load w)))
                                                  merged (primitive/ior old in-word)]
                                              (if (!= merged old)
                                                  (do (set! (mut (.out lv)) (+ prow (load w)) merged) (set! (mut grew) true))
                                                  0)
                                              (set! (mut w) (+ (load w) 1))
                                              (continue))))
                                  (if (and (load grew) (not (get (load on-work) pb)))
                                      (do (push! [i64] (mut work) pb) (set! (mut on-work) pb true))
                                      0)
                                  (set! (mut p) (+ (load p) 1))
                                  (continue))))
                      (continue)))))
      (al-free! [i64] (mut gen))
      (al-free! [i64] (mut kill))
      (al-free! [i64] (mut preds))
      (al-free! [i64] (mut work))
      (al-free! [bool] (mut on-work)))
    lv))

;; The live-out of a block as the map recorder wants it: a node id per live range, zero when dead.
;; Fill the recorder's node-id live set for `block` from its live-out row: zero everything the
;; previous block set, then walk only the set bits. One scratch per compile, not an lrgs-sized
;; array per block (that allocation was the single largest cost of the stack-map phase).
(defn gc-live-fill! [(lv (ptr GcLiveness)) (block (dyn NodeOps)) (live (mut (ArrayList i64)))] (-> i64)
  (let [b (gc-liveness-block-index lv block)
        row (gc-row-at lv b)
        (mut i) 0]
    (if (< b 0) (n-panic! "gc-live-fill!: block is not in the CFG table" block) 0)
    (loop (if (>= (len (load live)) (.lrgs lv))
              (break 0)
              (do (push! [i64] (mut live) 0) (continue))))
    (loop (if (>= (load i) (len (load live)))
              (break 0)
              (do (if (!= (get (load live) (load i)) 0) (set! (mut live) (load i) 0) 0)
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
    (let [(mut w) 0]
      (loop (if (>= (load w) (.words lv))
                (break 0)
                (let [(mut word) (get (.out lv) (+ row (load w)))]
                  (loop (if (= (load word) 0)
                            (break 0)
                            (let [bit (primitive/ctz (load word))
                                  lrg (+ (* (load w) 64) bit)]
                              (if (> lrg 0)
                                  (let [sample (get (.samples lv) lrg)]
                                    (if (= sample 0)
                                        (do (panic-i "gc-live-fill!: a live range with no live node is live-out" lrg) 0)
                                        (set! (mut live) lrg sample)))
                                  0)
                              (set! (mut word) (primitive/iand (load word) (- (load word) 1)))
                              (continue))))
                  (set! (mut w) (+ (load w) 1))
                  (continue)))))
    0))

;; A step of the recorder's own walk within a block, over the node-id form of the live set.
(defn gc-live-step-nids! [(n (dyn NodeOps)) (lv (ptr GcLiveness)) (live (mut (ArrayList i64)))] (-> i64)
  (match (mach-of n)
    (None [] 0)
    (Some [mach]
          (do
            (if (!= (n-lrg n) 0) (set! (mut live) (ra-find! (n-lrg n)) 0) 0)
            (if (or (= (m-ideal-op mach) OP-PHI) (= (m-ideal-op mach) OP-MEMPHI))
                0
                (let [(mut i) 1]
                  (loop (if (>= (load i) (n-nins n))
                            (break 0)
                            (do
                              (match (m-regmap mach (load i))
                                (Some [_]
                                      (match (n-in n (load i))
                                        (Some [def]
                                              (if (!= (n-lrg def) 0)
                                                  (set! (mut live) (ra-find! (n-lrg def)) (n-nid def))
                                                  0))
                                        (None [] 0)))
                                (None [] 0))
                              (set! (mut i) (+ (load i) 1))
                              (continue))))))
            0))))

(defn gc-safepoint-fun [(safepoint (dyn NodeOps))] (-> (dyn NodeOps))
  (if (!= (n-block-nid safepoint) 0)
      (enc-enclosing-fun safepoint)
      (if (> (code-cfg-count) 0)
          (code-cfg-at 0)
          (do
            (panic-i "gc-safepoint-fun: safepoint has no owning function" (n-nid safepoint))
            safepoint))))

(defn gc-record-stackmap! [(safepoint (dyn NodeOps)) (live (ArrayList i64))] (-> i64)
  (let [state (gcmeta-state)
        fun (gc-safepoint-fun safepoint)
        lo (len (.locations state))
        (mut lrg) 1]
    (push! [i64] (mut (.safepoint-nids state)) (n-nid safepoint))
    (push! [i64]
           (mut (.return-pcs state))
           (+ (enc-op-start safepoint) (enc-op-length safepoint)))
    (push! [i64] (mut (.frame-sizes state)) (mach-active-frame-size fun))
    (push! [i64] (mut (.rpc-offsets state)) (mach-active-saved-rpc-offset fun))
    (push! [i64] (mut (.slot-los state)) lo)
    (loop (if (> (load lrg) (ra-lrg-count))
              (break 0)
              (let [nid (get live (load lrg)) kind (ra-lrg-kind (load lrg))]
                (if (and (= (ra-find! (load lrg)) (load lrg))
                         (and (!= nid 0)
                              (or (= kind LRG-RAW-REF) (= kind LRG-BOXED))))
                    (match (arena-node nid)
                      (Some [value]
                            (let [location (ra-lrg-reg (load lrg))]
                            (if (< location (mach-active-max-reg))
                                (do
                                  (println "gc-record-stackmap!: live across {s}" (n-text safepoint))
                                  (println "  lrg {} kind {} reg {}" (load lrg) kind location)
                                  (n-panic! "gc-record-stackmap!: live reference has no stack home (register-allocated across a safepoint)" value))
                                (do
                                  (push! [i64]
                                         (mut (.locations state))
                                         (if (= (n-block-nid safepoint) 0)
                                             (* (- location (mach-active-max-reg)) 8)
                                             (mach-active-stack-offset
                                               (enc-enclosing-fun safepoint)
                                               location)))
                                  (push! [i64]
                                         (mut (.kinds state))
                                         (if (= kind LRG-RAW-REF) SLOT-RAW-REF SLOT-BOXED))))))
                      (None [] (panic-i "gc-record-stackmap!: missing live value" nid)))
                    0)
                (set! (mut lrg) (+ (load lrg) 1))
                (continue))))
    (push! [i64] (mut (.slot-his state)) (len (.locations state)))
    0))

(defn gc-place-safepoints! [] (-> i64)
  (do (unimplemented "gc-place-safepoints!" "S8 — src/codegen/gcmeta.coil") 0))

(defn gc-build-stackmaps! [] (-> i64)
  (do
    (gcmeta-reset!)
    (let [lv (gc-compute-liveness!)
          (mut live) (al-new [i64] (alloc/malloc-allocator))
          (mut ci) 0]
      (loop (if (>= (load ci) (code-cfg-count))
              (break 0)
              (let [block (code-cfg-at (load ci))
                    filled (gc-live-fill! lv block (mut live))
                    (mut i) (if (code-schedule-ready? block)
                                (- (code-schedule-count block) 1)
                                -1)]
                  ;; GCM's CFG table may retain a target-global or dead block which deliberately
                  ;; has no durable local schedule. It emits no instructions and therefore cannot
                  ;; own a return-PC stack map. Only executable scheduled blocks participate.
                  (if (code-schedule-ready? block)
                      (loop (if (< (load i) 0)
                                (break 0)
                                (let [n (code-schedule-at block (load i))]
                                  ;; A return-PC map describes the state AFTER the safepoint
                                  ;; instruction. Snapshot reverse liveness before stepping across
                                  ;; the instruction; stepping first incorrectly records call
                                  ;; arguments that die in the call as resumed roots.
                                  (if (gc-safepoint-op? n)
                                      (gc-record-stackmap! n (load live))
                                      0)
                                  (gc-live-step-nids! n lv (mut live))
                                  (set! (mut i) (- (load i) 1))
                                  (continue))))
                      0)
                  (set! (mut ci) (+ (load ci) 1))
                  (continue)))))
    (gc-stackmap-count)))

(defn gc-mark-input-cone! [(n (dyn NodeOps)) (reachable (mut (ArrayList bool)))] (-> i64)
  (if (get (load reachable) (n-nid n))
      0
      (do
        (set! (mut reachable) (n-nid n) true)
        (let [(mut i) 0]
          (loop (if (>= (load i) (n-nins n))
                    (break 0)
                    (do
                      (match (n-in n (load i))
                        (Some [input] (gc-mark-input-cone! input (mut reachable)))
                        (None [] 0))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))))))

(defn gc-value-may-reference? [(t i64)] (-> bool)
  (or (ty-memptr? t) (ty-dyn-may-reference? t)))

(defn gc-lower-barriers-marked! [(reachable (ArrayList bool))] (-> i64)
  (let [a (alloc/malloc-allocator) (mut nid) 1 (mut inserted) 0]
    ;; Snapshot the arena bound. Newly created Barriers are results, never candidate Stores.
    (let [limit (arena-node-count)]
      (loop (if (> (load nid) limit)
                (break 0)
                (do
                  (match (arena-node (load nid))
                    (Some [store]
                          (if (and (or (= (len reachable) 0) (get reachable (n-nid store)))
                                   (and (= (n-op store) OP-STORE)
                                        ;; Host memory (the heap record) is not a heap object: the
                                        ;; collector forwards its roots itself, so no card is dirtied.
                                        (ty-memptr? (n-ty (n-in! store MEM-PTR)))
                                   (let [t (n-ty (n-in! store STORE-VAL))]
                                     (gc-value-may-reference? t))))
                              (let [(mut oi) 0 (mut already) false]
                                (loop (if (or (>= (load oi) (n-nouts store)) (load already))
                                          (break 0)
                                          (do
                                            (match (n-out store (load oi))
                                              (Some [use]
                                                    (if (= (n-op use) OP-BARRIER)
                                                        (set! (mut already) true)
                                                        0))
                                              (None [] 0))
                                            (set! (mut oi) (+ (load oi) 1))
                                            (continue))))
                                (if (load already)
                                    0
                                    (let [(mut users) (al-new [i64] a) (mut ui) 0]
                                      ;; Capture users before constructing the Barrier, which adds
                                      ;; its own Store use and must remain on the pre-barrier state.
                                      (set! (mut oi) 0)
                                      (loop (if (>= (load oi) (n-nouts store))
                                                (break 0)
                                                (do
                                                  (match (n-out store (load oi))
                                                    (Some [use]
                                                          (push! [i64] (mut users) (n-nid use)))
                                                    (None [] 0))
                                                  (set! (mut oi) (+ (load oi) 1))
                                                  (continue))))
                                      (let [barrier
                                              (barrier-make (n-in! store MEM-CTRL)
                                                            store
                                                            (n-in! store MEM-PTR)
                                                            (n-in! store STORE-VAL))]
                                        (loop (if (>= (load ui) (len (load users)))
                                                  (break 0)
                                                  (do
                                                    (match (arena-node (get (load users) (load ui)))
                                                      (Some [use]
                                                            (let [(mut input) 0]
                                                              (loop (if (>= (load input)
                                                                            (n-nins use))
                                                                        (break 0)
                                                                        (do
                                                                          (match (n-in use
                                                                                       (load input))
                                                                            (Some [def]
                                                                                  (if (n-same? def store)
                                                                                      (n-set-def! use
                                                                                                  (load input)
                                                                                                  (Some barrier))
                                                                                      0))
                                                                            (None [] 0))
                                                                          (set! (mut input)
                                                                                (+ (load input) 1))
                                                                          (continue))))))
                                                      (None [] 0))
                                                    (set! (mut ui) (+ (load ui) 1))
                                                    (continue))))
                                        (set! (mut inserted) (+ (load inserted) 1))))))
                              0))
                    (None [] 0))
                  (set! (mut nid) (+ (load nid) 1))
                  (continue)))))
    (load inserted)))

(defn gc-lower-barriers! [] (-> i64)
  (gc-lower-barriers-marked! (al-new [bool] (alloc/malloc-allocator))))

(defn gc-lower-barriers-from! [(root (dyn NodeOps))] (-> i64)
  (let [(mut reachable) (al-new [bool] (alloc/malloc-allocator)) (mut i) 0]
    (loop (if (> (load i) (arena-node-count))
              (break 0)
              (do
                (push! [bool] (mut reachable) false)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (gc-mark-input-cone! root (mut reachable))
    (gc-lower-barriers-marked! (load reachable))))
