;; ============================================================================

;; ITERATE PEEPHOLES TO A FIXPOINT  —  port of Simple's `IterPeeps.java`
;; ============================================================================
;;
;; The pessimistic pass. Every type starts wherever parsing left it and only FALLS; peepholes
;; rewrite the graph until nothing more applies.
;;
;; ## The invariant, and it is checkable
;;
;;     For every node: either it is ON the worklist, or NO peephole applies to it.
;;
;; Simple checks this directly (`progressOnList`) under an expensive-assert flag. It is quadratic —
;; linear check at each of linearly many steps — so it is sampled rather than always on. Keep it,
;; and keep it runnable: when a new rule misbehaves this assert is what localises it, and a
;; correctness check you cannot turn on is not a check.
;;
;; ## The seeded random worklist is not a detail
;;
;; The worklist pops in a SEEDED RANDOM order, deliberately. A rewrite that is only correct under
;; one traversal order is a broken rewrite, and a fixed order hides that behind a green gate. The
;; seed is recorded in every failure so a red run reproduces exactly.
;;
;; Vary it. Order-dependent bugs in a sea-of-nodes optimiser show up on a MINORITY of seeds.
;;
;; ## The two worklists — inlining lives inside this fixpoint
;;
;; There is a second worklist, of CallEnd nodes, and ONE loop interleaves them. Simple's `iterate`:
;;
;;     didInline = false; defer = []
;;     loop:
;;       iteratePeeps()                       ; clean up everything that does not grow the code
;;       inlined = false
;;       while (cend = workInline.pop()):
;;         if cend is dead: continue
;;         d = cend.maybeInline()
;;         if d == DEFER: defer.push(cend)
;;         if d >  0:     inlined = true; BREAK   ; one at a time, then re-clean
;;       if inlined:      didInline = true; continue
;;       if !didInline:   break                   ; nothing fired and nothing fired earlier: done
;;       didInline = false; requeue(defer); defer.clear()
;;
;; Three things to preserve exactly:
;;
;; - ONE inline per round, then re-run peepholes. Inlining is the only transform here that GROWS
;;   the graph, so it is rationed and the cleanup runs between.
;; - The DEFER list is retried only after some inline actually fired. If nothing fired, nothing
;;   that was waiting on cleanup can have become ready, so retrying would spin.
;; - `iteratePeeps` pushes every CallEnd it peepholes onto the inline worklist, so a call that
;;   sharpens becomes a candidate without anyone tracking that explicitly.
;;
;; ## The inner loop, and the "free go again"
;;
;;     while (n = work.pop()):
;;       if n is dead: continue
;;       x = n.peepholeOpt()
;;       if n is a CallEnd: workInline.push(n)
;;       if x != null:
;;         if x is dead: continue
;;         if x has no type yet: x.setType(x.compute())     ; brand-new nodes need an initial type
;;         push all of N's outputs (the CHANGING node, not x)
;;         push x itself — "everybody gets a free go again in case they didn't get made in their
;;                          final form"
;;
;; That last line is load-bearing: `idealize` may return a node built out of other fresh nodes that
;; have not themselves been peepholed, and without the free re-queue they never are.
;;
;; Note it pushes the outputs of `n`, the node that CHANGED — not of `x`, which may be a
;; pre-existing node whose neighbours are already settled.
;;
;; STATUS: implemented, including the INLINE worklist and its interleaving.
(module aot.codegen.iterpeeps)
(import "aot.node.versions"
        :use
        [versions-admit-round! versions-reroute-closed-round!])
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "coil.time" :as time)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.cfgof" :use [cfg-stat-idepths-computed cfg-stat-owner-steps])
(import "aot.node.call" :use *)
(import "aot.type.type" :use *)

;; ---------------------------------------------------------------------------

;; Run every code-reducing, type-lifting peephole until the node worklist is dry.
;;
;; Simple's inner loop, in full — and the tail of it is load-bearing in a way that is easy to miss:
;;
;;     while (n = work.pop()):
;;       if n is dead: continue
;;       x = n.peepholeOpt()
;;       if n is a CallEnd: workInline.push(n)
;;       if x != null:
;;         if x is dead: continue
;;         if x has no type: x.setType(x.compute())     ; brand-new nodes need an initial type
;;         if x != n or x is not a Constant:
;;           push n's OUTPUTS        — the node that CHANGED, not x
;;           push x                  — "a free go again in case it wasn't made in final form"
;;           push x's INPUTS         — a self-returning peephole may have rewritten its own edges,
;;                                     and the new defs gained a user whose own backwards,
;;                                     user-sensitive peepholes may now apply
;;           if x != n:
;;             push n's INPUTS       — they have a new user
;;             push x's OUTPUTS
;;             n.subsume(x)          ; <<< THE REPLACEMENT. Without this the loop peepholes
;;                                   ;     nodes and never wires the result into the graph.
;; A fixpoint over N nodes converges in a small multiple of N visits; a pair of peepholes undoing
;; each other never does. The budget is generous enough never to fire on a converging graph, and
;; the ring of recent rewrites names the oscillation when it trips.
(const ITER-VISITS-PER-NODE 256)

(const ITER-TRACE-RING 16)

(defn iter--budget-exceeded! [(trace (ArrayList i64)) (next i64) (count i64)] (-> i64)
  (do
    (p--str "\naot: PANIC: iter-peeps!: the peephole fixpoint did not converge after ")
    (p--int count)
    (p--str " visits over ")
    (p--int (arena-node-count))
    (p--str " nodes; the most recent rewrites, oldest first (rewritten node -> replacement):\n")
    (let [(mut i) 0]
      (loop (if (>= (load i) ITER-TRACE-RING)
                (break 0)
                (let [slot (% (+ next (load i)) ITER-TRACE-RING)
                      from (get trace (* 2 slot))
                      to (get trace (+ (* 2 slot) 1))]
                  (if (!= from 0)
                      (do
                        (p--str "  ")
                        (match (arena-node from)
                          (Some [a] (p--str (n-text a)))
                          (None [] (p--str "(collected)")))
                        (p--str "\n    -> ")
                        (match (arena-node to)
                          (Some [b] (p--str (n-text b)))
                          (None [] (p--str "(collected)")))
                        (p--str "\n")
                        0)
                      0)
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (panic "iter-peeps!: peephole fixpoint did not converge")))

(defn iter-peeps! [] (-> i64)
  (let [(mut count) 0
        budget (* ITER-VISITS-PER-NODE (+ (arena-node-count) 4096))
        (mut trace) (al-new [i64] (compiler-allocator))
        (mut next) 0]
    (let [(mut fill) 0]
      (loop (if (>= (load fill) (* 2 ITER-TRACE-RING))
                (break 0)
                (do
                  (push! [i64] (mut trace) 0)
                  (set! (mut fill) (+ (load fill) 1))
                  (continue)))))
    (loop (match (code-work-pop!)
            (None [] (break 0))
            (Some [id]
                  (match (arena-node id)
                    (None [] (continue))
                    (Some [n]
                          (if (n-dead? n)
                              (continue)
                              (do
                                (set! (mut count) (+ (load count) 1))
                                (if (> (load count) budget)
                                    (iter--budget-exceeded! (load trace)
                                                            (load next)
                                                            (load count))
                                    0)
                                ;; Every CallEnd VISITED becomes an inline candidate. This is how a
                                ;; call that sharpens enters the inline worklist without anyone
                                ;; tracking candidates explicitly.
                                (if (= (n-op n) OP-CALLEND)
                                    (do
                                      (code-inline-push! (n-nid n))
                                      ;; The same visit makes it a SPECIALIZE candidate. A Call's
                                      ;; visit does too, below: a site's proof reads its ARGUMENTS'
                                      ;; types, and an argument that sharpens re-visits the Call
                                      ;; without necessarily re-visiting the CallEnd.
                                      (code-specialize-push! (n-nid n)))
                                    0)
                                (if (= (n-op n) OP-CALL)
                                    (match (call-cend n)
                                      (Some [end] (code-specialize-push! (n-nid end)))
                                      (None [] 0))
                                    0)
                                (match (n-peephole-opt! n)
                                  (None [] 0)
                                  (Some [x]
                                        (do
                                          (set! (mut trace)
                                                (* 2 (load next))
                                                (n-nid n))
                                          (set! (mut trace)
                                                (+ (* 2 (load next)) 1)
                                                (n-nid x))
                                          (set! (mut next)
                                                (% (+ (load next) 1)
                                                   ITER-TRACE-RING))
                                          (iter--apply! n x)
                                          ;; A peephole can depend on nodes outside its immediate
                                          ;; input/output neighbourhood.  Simple wakes and clears
                                          ;; those dependency edges after every successful peep.
                                          (n-move-deps-to-worklist! n)
                                          0)))
                                ;; Worklist iteration is also the dead-code pass.  A node whose last
                                ;; use disappeared without being part of a subsume must not survive
                                ;; merely because no later phase happens to notice it.
                                (if (and (and (not (n-dead? n)) (n-unused? n))
                                         (!= (n-op n) OP-STOP))
                                    (n-kill! n)
                                    0)
                                (continue))))))))
    (al-free! [i64] (mut trace))
    (load count)))

;; Simple's `iteratePeeps` re-queues `x._outputs` when `n` is replaced by an existing `x`: x gained
;; users, and a user of x may look at its siblings. When x is the shared `undefined`, "its users" is
;; every call that pads an argument and every Parm those reach — ~1,500 nodes at 120 call sites,
;; re-queued 2,255 times. We diverge for Constants: a Constant's value and inputs never change, and
;; replacing a node with that existing Constant does not expose a new user-sensitive peephole on
;; any of its old users. The replacement's new user is already queued by `code-add-outputs! n`.
;; `iter-check-fixpoint` after every round verifies that no peephole progress is omitted. This makes
;; the wide scaling program linear; docs/SCALING.md §7 records the counts and generated-code impact.

;; The replacement half of the loop above.
(defn iter--apply! [(n (dyn NodeOps)) (x (dyn NodeOps))] (-> i64)
  (if (n-dead? x)
      0
      (do
        (if (= (n-ty x) TY-INVALID) (n-set-ty! x (compute x)) 0)
        ;; A Constant that returned itself has nothing to propagate.
        (if (and (n-same? x n) (= (n-op x) OP-CON))
            0
            (do
              (code-add-outputs! n)
              (code-add! x)
              (code-add-inputs! x)
              (if (n-same? x n)
                  0
                  (do
                    (code-add-inputs! n)
                    (if (= (n-op x) OP-CON)
                        0
                        (code-add-outputs! x))
                    ;; Keep `x` alive across the surgery: subsuming `n` kills it, and that
                    ;; cascade can reach `x` if `x` has no users yet.
                    (n-keep! x)
                    (n-subsume! n x)
                    (n-unkeep! x)
                    0)))))))

;; The outer loop: peepholes and inlining interleaved, to a fixpoint.
;; `AOT_TIME=1`, read once, as `aot.codegen.codegen` reads it for the phase timer. This module sits
;; below that one, so it asks the environment itself rather than importing upward.
(defstruct IterTimeFlag [(state i64)])  ; 0 unread, 1 on, 2 off

(defn iter--time? [] (-> bool)
  (let [f (compiler-state [IterTimeFlag] (primitive/alloc-static CompilerStateSlot))]
    (if (= (.state f) 0)
        (set! (.state f)
              (if (!= (primitive/cast i64 (os/getenv c"AOT_TIME")) 0) 1 2))
        0)
    (= (.state f) 1)))

;; Zero when the clock cannot be read: a breakdown is a diagnostic, never a reason to fail.
(defn iter--now-ms [] (-> i64)
  (try (let [ms (try-or! (time/monotonic-now-ms) 0)] ms)))

;; Queue every live CallEnd as a specialize candidate. One walk per fixpoint.
(defn iter--seed-specialize-candidates! [] (-> i64)
  (let [cnt (arena-node-count)
        (mut i) 1]
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (and (= (n-op n) OP-CALLEND) (not (n-dead? n)))
                            (code-specialize-push! (n-nid n))
                            0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

(defn iter-run! [] (-> i64)
  ;; Simple's `iterate`, exactly:
  ;;
  ;;     didInline = false; defer = []
  ;;     loop:
  ;;       iteratePeeps()                       ; clean up everything that does not grow the code
  ;;       inlined = false
  ;;       while (cend = workInline.pop()):
  ;;         if cend is dead: continue
  ;;         d = cend.maybeInline()
  ;;         if d == DEFER: defer.push(cend)
  ;;         if d >  0:     inlined = true; BREAK   ; ONE at a time, then re-clean
  ;;       if inlined:      didInline = true; continue
  ;;       if !didInline:   break                   ; nothing fired, and nothing fired earlier
  ;;       didInline = false; requeue(defer); defer.clear()
  ;;
  ;; Three things to preserve exactly:
  ;;
  ;;   ONE inline per round, then re-run peepholes. Inlining is the only transform here that
  ;;   GROWS the graph, so it is rationed and the cleanup runs between.
  ;;
  ;;   The DEFER list is retried only after some inline ACTUALLY FIRED. If nothing fired, nothing
  ;;   waiting on cleanup can have become ready, so retrying would spin.
  ;;
  ;;   `iter-peeps!` pushes every CallEnd it visits onto the inline worklist, so a call that
  ;;   sharpens becomes a candidate without anyone tracking that explicitly.
  (let [(mut did-inline) false
        (mut rounds) 0
        ;; `AOT_TIME=1`: where a fixpoint's wall time went, by the four things a round does. The
        ;; phase timer says "the optimizer is slow"; this says which quarter of it.
        (mut t-peeps) 0
        (mut t-specialize) 0
        (mut t-inline) 0
        (mut t-versions) 0
        ;; The two counted costs that are NOT visits, split by which half of a round paid them.
        (mut deps-peeps) 0
        (mut deps-inline) 0
        (mut idepths-peeps) 0
        (mut idepths-inline) 0
        (mut owner-inline) 0
        (mut n-specialized) 0
        (mut n-inlined) 0
        (mut n-visits) 0
        ;; Every round inlines exactly one call site and never creates a new source-level site,
        ;; so the number of rounds is bounded by the sites the graph ever holds. A round count far
        ;; beyond the arena means cloning keeps manufacturing sites: report the recent ones.
        (mut recent) (al-new [i64] (compiler-allocator))]
    ;; Every live site is asked at least once per fixpoint, as the arena scan guaranteed — but
    ;; ONCE here, not once per round. After this a site is asked again only when it is visited.
    (iter--seed-specialize-candidates!)
    (loop (do
            (let [t0 (if (iter--time?) (iter--now-ms) 0)
                  deps0 (code-stat-dep-asks)
                  idepths0 (cfg-stat-idepths-computed)
                  visited (iter-peeps!)]
              (set! (mut deps-peeps) (+ (load deps-peeps) (- (code-stat-dep-asks) deps0)))
              (set! (mut idepths-peeps)
                    (+ (load idepths-peeps) (- (cfg-stat-idepths-computed) idepths0)))
              (set! (mut n-visits) (+ (load n-visits) visited))
              (if (iter--time?)
                  (set! (mut t-peeps) (+ (load t-peeps) (- (iter--now-ms) t0)))
                  0))
            ;; A completed local cleanup may prove that a surviving call fits an already admitted
            ;; primary contract. Retarget one such edge before source specialization or inlining;
            ;; the next cleanup consumes the callee summary through the ordinary CallEnd rules.
            (if (> (versions-reroute-closed-round!) 0)
                (do
                  (set! (mut did-inline) true)
                  (set! (mut rounds) (+ (load rounds) 1))
                  (continue))
                0)
            ;; One source expansion, like one clone inline, is followed by ordinary cleanup.
            ;; The shared generic callee may remain, so specialization is real code growth.
            ;; Admission has its own compilation-wide growth budget and preserves proof contracts.
            (let [t1 (if (iter--time?) (iter--now-ms) 0)
                  specialized (specialize-admit-round!)]
              (if (iter--time?)
                  (set! (mut t-specialize) (+ (load t-specialize) (- (iter--now-ms) t1)))
                  0)
              (if (> specialized 0)
                  (do
                    (set! (mut n-specialized) (+ (load n-specialized) 1))
                    (set! (mut did-inline) true)
                    (set! (mut rounds) (+ (load rounds) 1))
                    (if (> (load rounds) (+ 1024 (arena-node-count)))
                        (iter--rounds-exceeded! (load recent) (load rounds))
                        0)
                    (continue))
                  0))
            (let [t2 (if (iter--time?) (iter--now-ms) 0)
                  arena-before-inline (arena-node-count)
                  deps2 (code-stat-dep-asks)
                  idepths2 (cfg-stat-idepths-computed)
                  owner2 (cfg-stat-owner-steps)
                  fired (iter--one-inline!)]
              (set! (mut owner-inline) (+ (load owner-inline) (- (cfg-stat-owner-steps) owner2)))
              (set! (mut deps-inline) (+ (load deps-inline) (- (code-stat-dep-asks) deps2)))
              (set! (mut idepths-inline)
                    (+ (load idepths-inline) (- (cfg-stat-idepths-computed) idepths2)))
              (if (iter--time?)
                  (set! (mut t-inline) (+ (load t-inline) (- (iter--now-ms) t2)))
                  0)
              (if fired
                  (do
                    ;; A raw graph copy preserves already-optimized types and does not enqueue
                    ;; every copied node. Under a local scope the caller's contract can make a
                    ;; formerly dead deep arm live, so seed the complete new clone once.
                    (if (code-work-scope-active?)
                        (iter--seed-new-scope! arena-before-inline)
                        0)
                    (set! (mut n-inlined) (+ (load n-inlined) 1))
                    (set! (mut did-inline) true)
                    (set! (mut rounds) (+ (load rounds) 1))
                    (push! [i64] (mut recent) (iter-last-inlined))
                    (if (> (load rounds) (+ 1024 (arena-node-count)))
                        (iter--rounds-exceeded! (load recent) (load rounds))
                        0)
                    (continue))
                  (if (not (load did-inline))
                      ;; Retained entries are for calls that survive ordinary inlining. Drain
                      ;; even the deferred inline work before estimating a trial's benefit.
                      (if (and (not (code-work-scope-active?))
                               (> (versions-admit-round!) 0))
                          (do (set! (mut did-inline) true)
                              (set! (mut rounds) (+ (load rounds) 1)) (continue))
                          (break 0))
                      (do
                        (set! (mut did-inline) false)
                        ;; The retry asks with FRESH sizes: bodies shrank under the cleanup since
                        ;; they were measured, and a deferral on a stale size must not outlive
                        ;; this sweep (`fun-size-invalidate!`'s contract).
                        (fun-size-epoch-bump!)
                        (iter--requeue-deferred!)
                        (specialize-requeue-deferred!)
                        (continue)))))))
    (let [s (iter-stats)]
      (set! (.rounds s) (+ (.rounds s) (load rounds)))
      (set! (.visits s) (+ (.visits s) (load n-visits)))
      (set! (.specialized s) (+ (.specialized s) (load n-specialized)))
      (set! (.inlined s) (+ (.inlined s) (load n-inlined))))
    (if (iter--time?)
        (do
          (println "aot time:   iter-run: {} rounds ({} specialized, {} inlined); {} peephole visits, {} inline candidates asked; peeps {} ms, specialize {} ms, inline {} ms; arena {}"
                   (load rounds)
                   (load n-specialized)
                   (load n-inlined)
                   (load n-visits)
                   (.asked (iter--inline-asked))
                   (load t-peeps)
                   (load t-specialize)
                   (load t-inline)
                   (arena-node-count))
          (println "aot time:     deps asked: {} in peeps, {} in inline; idepths computed: {} in peeps, {} in inline; owner-walk steps in inline: {}"
                   (load deps-peeps)
                   (load deps-inline)
                   (load idepths-peeps)
                   (load idepths-inline)
                   (load owner-inline))
          0)
        0)
    (load rounds)))

(defn iter--seed-new-scope! [(before i64)] (-> i64)
  (let [limit (arena-node-count)
        (mut nid) (+ before 1)
        (mut seeded) 0]
    (loop (if (> (load nid) limit)
              (break 0)
              (do
                (match (arena-node (load nid))
                  (Some [node]
                        (if (or (n-dead? node)
                                (not (code-work-scope-accepts? (load nid))))
                            0
                            (do
                              (if (= (n-pesi-ty node) TY-INVALID)
                                  0
                                  (n-force-ty! node (n-pesi-ty node)))
                              (code-add! node)
                              (set! (mut seeded) (+ (load seeded) 1)))))
                  (None [] 0))
                (set! (mut nid) (+ (load nid) 1))
                (continue))))
    (load seeded)))

;; Seed every live node in the arena onto the worklist. Used to start a fixpoint over a graph that
;; was built by hand rather than parsed.
(defn iter-seed-all! [] (-> i64)
  (let [cnt (arena-node-count)
        (mut i) 1
        (mut added) 0]
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (n-dead? n)
                            0
                            (do
                              (code-add! n)
                              (set! (mut added) (+ (load added) 1)))))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load added)))

;; Seed exactly the compilation root's connected component. Final Simple's `Node.walk` visits the
;; node, then inputs, then outputs. Following both directions is essential for lazy calls: a FunPtr
;; reaches the Fun through an input, but the callee Return and body are reached through Fun outputs.
;; Distinct, unreferenced JSL declaration Starts remain outside this component. The visited set makes
;; control/Phi/call cycles safe.
(defn iter-seed-connected-walk! [(n (dyn NodeOps))
                                 (seen (mut (ArrayList bool)))] (-> i64)
  (if (or (n-dead? n) (get (load seen) (n-nid n)))
      0
      (do
        (set! (mut seen) (n-nid n) true)
        (let [(mut i) 0
              (mut added) 1]
          (code-add! n)
          (loop (if (>= (load i) (n-nins n))
                    (break 0)
                    (do
                      (match (n-in n (load i))
                        (Some [input]
                              (set! (mut added)
                                    (+ (load added)
                                       (iter-seed-connected-walk! input
                                                                  (mut seen)))))
                        (None [] 0))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (set! (mut i) 0)
          (loop (if (>= (load i) (n-nouts n))
                    (break (load added))
                    (do
                      (match (n-out n (load i))
                        (Some [output]
                              (set! (mut added)
                                    (+ (load added)
                                       (iter-seed-connected-walk! output
                                                                  (mut seen)))))
                        (None [] 0))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))))))

(defn iter-seed-connected! [(root (dyn NodeOps))] (-> i64)
  (let [(mut seen) (al-new [bool] (compiler-allocator))
        (mut i) 0]
    ;; Parsing and JSL declaration enqueue construction neighborhoods eagerly. At the phase
    ;; boundary discard that partial queue and establish one exact root-owned pessimistic solve.
    (code-clear-worklists!)
    (loop (if (> (load i) (arena-node-count))
              (break 0)
              (do
                (push! [bool] (mut seen) false)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (iter-seed-connected-walk! root (mut seen))))

;; THE INVARIANT: for every live node, either it is ON the worklist, or NO peephole applies to it.
;;
;; Simple's `progressOnList`. It sets `_midAssert` and then simply CALLS `peepholeOpt` on every node
;; not on the worklist, asserting it returns null — the flag is what makes that safe, because it
;; suppresses worklist pushes and dependency registration for the duration.
;;
;; Quadratic: linear at each of linearly many steps. Sampled in normal runs, forced on when a rule
;; set is misbehaving — it is what localises a peephole that fires without re-queueing.
;;
;; As in Simple, this checks all four parts of the invariant: computed types still move in the
;; pessimistic direction; ordinary worklist membership excuses a pending peephole; inline-worklist
;; membership excuses a pending inline; and every other live node has a use and no applicable
;; peephole.  Returns the number of violations; 0 is success.
(defn iter--check-fixpoint [(scoped bool)] (-> i64)
  (let [cnt (arena-node-count)
        (mut i) 1
        (mut bad) 0]
    (set-mid-assert! true)
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (or (n-dead? n)
                                (and scoped
                                     (not (code-work-scope-accepts? (n-nid n)))))
                            0
                            (do
                              ;; Types must be forwards even for a node already awaiting work.
                              (let [fresh (compute n)]
                                (if (= fresh TY-INVALID)
                                    (panic-i "iter-check-fixpoint: live node computed TY-INVALID; op"
                                             (n-op n))
                                    0)
                                (if (ty-isa? (ty-erase-widen fresh)
                                             (ty-erase-widen (n-ty n)))
                                    0
                                    (set! (mut bad) (+ (load bad) 1))))
                              (if (code-on-worklist? (n-nid n))
                                  0
                                  (do
                                    (if (and (= (n-op n) OP-CALLEND)
                                             (not (code-on-inline-worklist? (n-nid n))))
                                        (if (> (callend-inline-candidate n) 0)
                                            (set! (mut bad) (+ (load bad) 1))
                                            0)
                                        0)
                                    (if (and (n-unused? n)
                                             (!= (n-op n) OP-STOP))
                                        (set! (mut bad) (+ (load bad) 1))
                                        0)
                                    (match (n-peephole-opt! n)
                                      (Some [_]
                                            (set! (mut bad) (+ (load bad) 1)))
                                      (None [] 0)))))))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set-mid-assert! false)
    (load bad)))

(defn iter-check-fixpoint [] (-> i64)
  (iter--check-fixpoint false))

(defn iter-check-scope-fixpoint [] (-> i64)
  (iter--check-fixpoint true))

;; How many live nodes there are to check — the counted floor under `iter-check-fixpoint`.
(defn iter-live-count [] (-> i64)
  (let [cnt (arena-node-count)
        (mut i) 1
        (mut live) 0]
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (n-dead? n) 0 (set! (mut live) (+ (load live) 1))))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load live)))

;; The seed this run is using. Recorded in every failure report so a red run reproduces.
(defn iter-seed [] (-> i64)
  (code-seed))

;; ---------------------------------------------------------------------------
;; The inline worklist
;;
;; A SECOND worklist, of CallEnd nodes. `iter-peeps!` pushes every CallEnd it visits onto it, so a
;; call that sharpens becomes a candidate without anyone tracking that explicitly.

;; Pop candidates until ONE fires. Deferred candidates are collected and retried later — but only
;; after something actually fired, because otherwise nothing waiting on cleanup can have become
;; ready and retrying would spin.
;;
;; Returns true when an inline happened.
(defstruct IterInlineTrace [(last i64)])

(defn iter-inline-trace [] (-> (ptr IterInlineTrace))
  (compiler-state [IterInlineTrace] (primitive/alloc-static CompilerStateSlot)))

;; The CallEnd the most recent inline round fired on.
(defn iter-last-inlined [] (-> i64)
  (.last (iter-inline-trace)))

(defn iter--rounds-exceeded! [(recent (ArrayList i64)) (rounds i64)] (-> i64)
  (do
    (p--str "\naot: PANIC: iter-run!: inlining did not converge after ")
    (p--int rounds)
    (p--str " rounds over ")
    (p--int (arena-node-count))
    (p--str " nodes; the most recently inlined CallEnds, oldest first:\n")
    (let [(mut i) (if (> (len recent) 12) (- (len recent) 12) 0)]
      (loop (if (>= (load i) (len recent))
                (break 0)
                (do
                  (p--str "  ")
                  (match (arena-node (get recent (load i)))
                    (Some [c] (p--str (n-text c)))
                    (None []
                          (do
                            (p--str "#")
                            (p--int (get recent (load i)))
                            (p--str " (collected)"))))
                  (p--str "\n")
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (panic "iter-run!: inlining did not converge")))

;; `AOT_INLINE_TRACE=1`, read once: print every inline decision, the callee, its sizes and callers.
(defstruct InlineTraceFlag [(state i64)])

(defn inline-trace? [] (-> bool)
  (let [f
          (compiler-state [InlineTraceFlag]
                          (primitive/alloc-static CompilerStateSlot))]
    (if (= (.state f) 0)
        (set! (.state f)
              (if (!= (primitive/cast i64 (os/getenv c"AOT_INLINE_TRACE")) 0)
                  1
                  2))
        0)
    (= (.state f) 1)))

;; The Fun a CallEnd's Call names, when its function pointer is a single local FunPtr.
(defn iter--callee-fun [(cend (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (match (n-in-safe cend 0)
    (Some [c]
          (if (= (n-op c) OP-CALL)
              (let [fp (call-fptr c)]
                (if (= (n-op fp) OP-FUNPTR)
                    (match (n-in fp 0)
                      (Some [f]
                            (if (= (n-op f) OP-FUN)
                                (Some f)
                                (None [(dyn NodeOps)])))
                      (None [] (None [(dyn NodeOps)])))
                    (None [(dyn NodeOps)])))
              (None [(dyn NodeOps)])))
    (None [] (None [(dyn NodeOps)]))))

;; Printed before the decision acts: an inline that fires consumes the CallEnd.
(defn iter--trace-inline-query [(cend (dyn NodeOps))] (-> i64)
  (match (iter--callee-fun cend)
    (Some [f]
          (do
            (println "inline: #{} -> {s} approx {} live {} callers {}"
                     (n-nid cend)
                     (fun-name f)
                     (fun-approx-size f)
                     (fun-live-body-size f)
                     (- (n-nins f) 1))
            0))
    (None []
          (do
            (println "inline: #{} -> (no single local callee)" (n-nid cend))
            0))))

;; What the fixpoints of one compilation cost, in COUNTS: the numbers `docs/SCALING.md` gates on. A
;; wall-clock assertion measures the machine's load; these are deterministic. Cumulative across every
;; `iter-run!` of a compile, cleared by `iter-stats-reset!`.
(defstruct IterStats
  [(rounds i64) (visits i64) (specialized i64) (inlined i64)])

(defn iter-stats [] (-> (ptr IterStats))
  (compiler-state [IterStats] (primitive/alloc-static CompilerStateSlot)))

(defn iter-stats-reset! [] (-> i64)
  (let [s (iter-stats)]
    (set! (.rounds s) 0)
    (set! (.visits s) 0)
    (set! (.specialized s) 0)
    (set! (.inlined s) 0)
    (set! (.asked (iter--inline-asked)) 0)
    0))

(defn iter-stat-rounds [] (-> i64) (.rounds (iter-stats)))

(defn iter-stat-visits [] (-> i64) (.visits (iter-stats)))

(defn iter-stat-specialized [] (-> i64) (.specialized (iter-stats)))

(defn iter-stat-inlined [] (-> i64) (.inlined (iter-stats)))

(defn iter-stat-inline-asks [] (-> i64) (.asked (iter--inline-asked)))

;; How many inline candidates were asked, for the `AOT_TIME` breakdown: a round that asks hundreds to
;; admit one is where a quadratic hides.
(defstruct IterInlineAsked [(asked i64)])

(defn iter--inline-asked [] (-> (ptr IterInlineAsked))
  (compiler-state [IterInlineAsked] (primitive/alloc-static CompilerStateSlot)))

(defn iter--one-inline! [] (-> bool)
  (let [(mut fired) false]
    (loop (match (code-inline-pop!)
            (None [] (break 0))
            (Some [id]
                  (set! (.asked (iter--inline-asked)) (+ (.asked (iter--inline-asked)) 1))
                  (match (arena-node id)
                    (None [] (continue))
                    (Some [cend]
                          (if (n-dead? cend)
                              (continue)
                              (let [traced
                                      (if (inline-trace?)
                                          (iter--trace-inline-query cend)
                                          0)
                                    d (callend-maybe-inline! cend)]
                                (if (inline-trace?)
                                    (if (= d INLINE-DEFER)
                                        (do
                                          (println "inline:   decision {} ({s})"
                                                   d
                                                   (inline-defer-reason))
                                          0)
                                        (do
                                          (println "inline:   decision {}" d)
                                          0))
                                    0)
                                (if (= d INLINE-DEFER)
                                    (do (code-defer-inline! id) (continue))
                                    (if (> d 0)
                                        (do
                                          (set! (.last (iter-inline-trace)) id)
                                          ;; The inline invalidated its caller's size itself
                                          ;; (`callend-maybe-inline-ordinary!`); no other body grew.
                                          ;; Inlining blows every cached idepth past the inline
                                          ;; point (Simple's CallEndNode): bump the version once.
                                          (invalidate-cfg-depths!)
                                          (set! (mut fired) true)
                                          (break 0))
                                        (continue))))))))))
    (load fired)))

;; Move every deferred candidate back onto the inline worklist.
(defn iter--requeue-deferred! [] (-> i64)
  (code-requeue-deferred!))
