;; ============================================================================

;; ITERATE PEEPHOLES TO A FIXPOINT  —  port of Simple's `IterPeeps.java`
;; ============================================================================
;;
;; The pessimistic pass. Every type starts wherever parsing left it and only FALLS; peepholes
;; rewrite the graph until nothing more applies.
;;
;; ## The invariant, and it is checkable
;;
;;     For every node: either it is ON the worklist, or NO peephole applies to it.
;;
;; Simple checks this directly (`progressOnList`) under an expensive-assert flag. It is quadratic —
;; linear check at each of linearly many steps — so it is sampled rather than always on. Keep it,
;; and keep it runnable: when a new rule misbehaves this assert is what localises it, and a
;; correctness check you cannot turn on is not a check.
;;
;; ## The seeded random worklist is not a detail
;;
;; The worklist pops in a SEEDED RANDOM order, deliberately. A rewrite that is only correct under
;; one traversal order is a broken rewrite, and a fixed order hides that behind a green gate. The
;; seed is recorded in every failure so a red run reproduces exactly.
;;
;; Vary it. Order-dependent bugs in a sea-of-nodes optimiser show up on a MINORITY of seeds.
;;
;; ## The two worklists — inlining lives inside this fixpoint
;;
;; There is a second worklist, of CallEnd nodes, and ONE loop interleaves them. Simple's `iterate`:
;;
;;     didInline = false; defer = []
;;     loop:
;;       iteratePeeps()                       ; clean up everything that does not grow the code
;;       inlined = false
;;       while (cend = workInline.pop()):
;;         if cend is dead: continue
;;         d = cend.maybeInline()
;;         if d == DEFER: defer.push(cend)
;;         if d >  0:     inlined = true; BREAK   ; one at a time, then re-clean
;;       if inlined:      didInline = true; continue
;;       if !didInline:   break                   ; nothing fired and nothing fired earlier: done
;;       didInline = false; requeue(defer); defer.clear()
;;
;; Three things to preserve exactly:
;;
;; - ONE inline per round, then re-run peepholes. Inlining is the only transform here that GROWS
;;   the graph, so it is rationed and the cleanup runs between.
;; - The DEFER list is retried only after some inline actually fired. If nothing fired, nothing
;;   that was waiting on cleanup can have become ready, so retrying would spin.
;; - `iteratePeeps` pushes every CallEnd it peepholes onto the inline worklist, so a call that
;;   sharpens becomes a candidate without anyone tracking that explicitly.
;;
;; ## The inner loop, and the "free go again"
;;
;;     while (n = work.pop()):
;;       if n is dead: continue
;;       x = n.peepholeOpt()
;;       if n is a CallEnd: workInline.push(n)
;;       if x != null:
;;         if x is dead: continue
;;         if x has no type yet: x.setType(x.compute())     ; brand-new nodes need an initial type
;;         push all of N's outputs (the CHANGING node, not x)
;;         push x itself — "everybody gets a free go again in case they didn't get made in their
;;                          final form"
;;
;; That last line is load-bearing: `idealize` may return a node built out of other fresh nodes that
;; have not themselves been peepholed, and without the free re-queue they never are.
;;
;; Note it pushes the outputs of `n`, the node that CHANGED — not of `x`, which may be a
;; pre-existing node whose neighbours are already settled.
;;
;; STATUS: implemented, including the INLINE worklist and its interleaving.
(module aot.codegen.iterpeeps)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.call" :use *)
(import "aot.node.copy" :use *)
(import "aot.type.type" :use *)

;; ---------------------------------------------------------------------------

;; Run every code-reducing, type-lifting peephole until the node worklist is dry.
;;
;; Simple's inner loop, in full — and the tail of it is load-bearing in a way that is easy to miss:
;;
;;     while (n = work.pop()):
;;       if n is dead: continue
;;       x = n.peepholeOpt()
;;       if n is a CallEnd: workInline.push(n)
;;       if x != null:
;;         if x is dead: continue
;;         if x has no type: x.setType(x.compute())     ; brand-new nodes need an initial type
;;         if x != n or x is not a Constant:
;;           push n's OUTPUTS        — the node that CHANGED, not x
;;           push x                  — "a free go again in case it wasn't made in final form"
;;           push x's INPUTS         — a self-returning peephole may have rewritten its own edges,
;;                                     and the new defs gained a user whose own backwards,
;;                                     user-sensitive peepholes may now apply
;;           if x != n:
;;             push n's INPUTS       — they have a new user
;;             push x's OUTPUTS
;;             n.subsume(x)          ; <<< THE REPLACEMENT. Without this the loop peepholes
;;                                   ;     nodes and never wires the result into the graph.
;; A fixpoint over N nodes converges in a small multiple of N visits; a pair of peepholes undoing
;; each other never does. The budget is generous enough never to fire on a converging graph, and
;; the ring of recent rewrites names the oscillation when it trips.
(const ITER-VISITS-PER-NODE 256)

(const ITER-TRACE-RING 16)

(defn iter--budget-exceeded! [(trace (ArrayList i64)) (next i64) (count i64)] (-> i64)
  (do
    (p--str "\naot: PANIC: iter-peeps!: the peephole fixpoint did not converge after ")
    (p--int count)
    (p--str " visits over ")
    (p--int (arena-node-count))
    (p--str " nodes; the most recent rewrites, oldest first (rewritten node -> replacement):\n")
    (let [(mut i) 0]
      (loop (if (>= (load i) ITER-TRACE-RING)
                (break 0)
                (let [slot (% (+ next (load i)) ITER-TRACE-RING)
                      from (get trace (* 2 slot))
                      to (get trace (+ (* 2 slot) 1))]
                  (if (!= from 0)
                      (do
                        (p--str "  ")
                        (match (arena-node from) (Some [a] (p--str (n-text a))) (None [] (p--str "(collected)")))
                        (p--str "\n    -> ")
                        (match (arena-node to) (Some [b] (p--str (n-text b))) (None [] (p--str "(collected)")))
                        (p--str "\n")
                        0)
                      0)
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (panic "iter-peeps!: peephole fixpoint did not converge")))

(defn iter-peeps! [] (-> i64)
  (let [(mut count) 0
        budget (* ITER-VISITS-PER-NODE (+ (arena-node-count) 4096))
        (mut trace) (al-new [i64] (alloc/malloc-allocator))
        (mut next) 0]
    (let [(mut fill) 0]
      (loop (if (>= (load fill) (* 2 ITER-TRACE-RING))
                (break 0)
                (do (push! [i64] (mut trace) 0) (set! (mut fill) (+ (load fill) 1)) (continue)))))
    (loop (match (code-work-pop!)
            (None [] (break 0))
            (Some [id]
                  (match (arena-node id)
                    (None [] (continue))
                    (Some [n]
                          (if (n-dead? n)
                              (continue)
                              (do
                                (set! (mut count) (+ (load count) 1))
                                (if (> (load count) budget)
                                    (iter--budget-exceeded! (load trace) (load next) (load count))
                                    0)
                                ;; Every CallEnd VISITED becomes an inline candidate. This is how a
                                ;; call that sharpens enters the inline worklist without anyone
                                ;; tracking candidates explicitly.
                                (if (= (n-op n) OP-CALLEND) (code-inline-push! (n-nid n)) 0)
                                (match (n-peephole-opt! n)
                                  (None [] 0)
                                  (Some [x]
                                        (do
                                          (set! (mut trace) (* 2 (load next)) (n-nid n))
                                          (set! (mut trace) (+ (* 2 (load next)) 1) (n-nid x))
                                          (set! (mut next) (% (+ (load next) 1) ITER-TRACE-RING))
                                          (iter--apply! n x)
                                          ;; A peephole can depend on nodes outside its immediate
                                          ;; input/output neighbourhood.  Simple wakes and clears
                                          ;; those dependency edges after every successful peep.
                                          (n-move-deps-to-worklist! n)
                                          0)))
                                ;; Worklist iteration is also the dead-code pass.  A node whose last
                                ;; use disappeared without being part of a subsume must not survive
                                ;; merely because no later phase happens to notice it.
                                (if (and (and (not (n-dead? n)) (n-unused? n))
                                         (!= (n-op n) OP-STOP))
                                    (n-kill! n)
                                    0)
                                (continue))))))))
    (al-free! [i64] (mut trace))
    (load count)))

;; The replacement half of the loop above.
(defn iter--apply! [(n (dyn NodeOps)) (x (dyn NodeOps))] (-> i64)
  (if (n-dead? x)
      0
      (do
        (if (= (n-ty x) TY-INVALID) (n-set-ty! x (compute x)) 0)
        ;; A Constant that returned itself has nothing to propagate.
        (if (and (n-same? x n) (= (n-op x) OP-CON))
            0
            (do
              (code-add-outputs! n)
              (code-add! x)
              (code-add-inputs! x)
              (if (n-same? x n)
                  0
                  (do
                    (code-add-inputs! n)
                    (code-add-outputs! x)
                    ;; Keep `x` alive across the surgery: subsuming `n` kills it, and that
                    ;; cascade can reach `x` if `x` has no users yet.
                    (n-keep! x)
                    (n-subsume! n x)
                    (n-unkeep! x)
                    0)))))))

;; The outer loop: peepholes and inlining interleaved, to a fixpoint.
(defn iter-run! [] (-> i64)
  ;; Simple's `iterate`, exactly:
  ;;
  ;;     didInline = false; defer = []
  ;;     loop:
  ;;       iteratePeeps()                       ; clean up everything that does not grow the code
  ;;       inlined = false
  ;;       while (cend = workInline.pop()):
  ;;         if cend is dead: continue
  ;;         d = cend.maybeInline()
  ;;         if d == DEFER: defer.push(cend)
  ;;         if d >  0:     inlined = true; BREAK   ; ONE at a time, then re-clean
  ;;       if inlined:      didInline = true; continue
  ;;       if !didInline:   break                   ; nothing fired, and nothing fired earlier
  ;;       didInline = false; requeue(defer); defer.clear()
  ;;
  ;; Three things to preserve exactly:
  ;;
  ;;   ONE inline per round, then re-run peepholes. Inlining is the only transform here that
  ;;   GROWS the graph, so it is rationed and the cleanup runs between.
  ;;
  ;;   The DEFER list is retried only after some inline ACTUALLY FIRED. If nothing fired, nothing
  ;;   waiting on cleanup can have become ready, so retrying would spin.
  ;;
  ;;   `iter-peeps!` pushes every CallEnd it visits onto the inline worklist, so a call that
  ;;   sharpens becomes a candidate without anyone tracking that explicitly.
  (let [(mut did-inline) false
        (mut rounds) 0
        ;; Every round inlines exactly one call site and never creates a new source-level site,
        ;; so the number of rounds is bounded by the sites the graph ever holds. A round count far
        ;; beyond the arena means cloning keeps manufacturing sites: report the recent ones.
        (mut recent) (al-new [i64] (alloc/malloc-allocator))]
    (loop (do
            (iter-peeps!)
            (let [fired (iter--one-inline!)]
              (if fired
                  (do
                    (set! (mut did-inline) true)
                    (set! (mut rounds) (+ (load rounds) 1))
                    (push! [i64] (mut recent) (iter-last-inlined))
                    (if (> (load rounds) (+ 1024 (arena-node-count)))
                        (iter--rounds-exceeded! (load recent) (load rounds))
                        0)
                    (continue))
                  (if (not (load did-inline))
                      (break 0)
                      (do
                        (set! (mut did-inline) false)
                        (iter--requeue-deferred!)
                        (continue)))))))
    (load rounds)))

;; Seed every live node in the arena onto the worklist. Used to start a fixpoint over a graph that
;; was built by hand rather than parsed.
(defn iter-seed-all! [] (-> i64)
  (let [cnt (arena-node-count)
        (mut i) 1
        (mut added) 0]
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (n-dead? n)
                            0
                            (do (code-add! n) (set! (mut added) (+ (load added) 1)))))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load added)))

;; Seed exactly the compilation root's connected component. Final Simple's `Node.walk` visits the
;; node, then inputs, then outputs. Following both directions is essential for lazy calls: a FunPtr
;; reaches the Fun through an input, but the callee Return and body are reached through Fun outputs.
;; Distinct, unreferenced JSL declaration Starts remain outside this component. The visited set makes
;; control/Phi/call cycles safe.
(defn iter-seed-connected-walk! [(n (dyn NodeOps)) (seen (mut (ArrayList bool)))] (-> i64)
  (if (or (n-dead? n) (get (load seen) (n-nid n)))
      0
      (do
        (set! (mut seen) (n-nid n) true)
        (let [(mut i) 0
              (mut added) 1]
          (code-add! n)
          (loop (if (>= (load i) (n-nins n))
                    (break 0)
                    (do
                      (match (n-in n (load i))
                        (Some [input]
                              (set! (mut added)
                                    (+ (load added)
                                       (iter-seed-connected-walk! input (mut seen)))))
                        (None [] 0))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (set! (mut i) 0)
          (loop (if (>= (load i) (n-nouts n))
                    (break (load added))
                    (do
                      (match (n-out n (load i))
                        (Some [output]
                              (set! (mut added)
                                    (+ (load added)
                                       (iter-seed-connected-walk! output (mut seen)))))
                        (None [] 0))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))))))

(defn iter-seed-connected! [(root (dyn NodeOps))] (-> i64)
  (let [(mut seen) (al-new [bool] (alloc/malloc-allocator))
        (mut i) 0]
    ;; Parsing and JSL declaration enqueue construction neighborhoods eagerly. At the phase
    ;; boundary discard that partial queue and establish one exact root-owned pessimistic solve.
    (code-clear-worklists!)
    (loop (if (> (load i) (arena-node-count))
              (break 0)
              (do
                (push! [bool] (mut seen) false)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (iter-seed-connected-walk! root (mut seen))))

;; THE INVARIANT: for every live node, either it is ON the worklist, or NO peephole applies to it.
;;
;; Simple's `progressOnList`. It sets `_midAssert` and then simply CALLS `peepholeOpt` on every node
;; not on the worklist, asserting it returns null — the flag is what makes that safe, because it
;; suppresses worklist pushes and dependency registration for the duration.
;;
;; Quadratic: linear at each of linearly many steps. Sampled in normal runs, forced on when a rule
;; set is misbehaving — it is what localises a peephole that fires without re-queueing.
;;
;; As in Simple, this checks all four parts of the invariant: computed types still move in the
;; pessimistic direction; ordinary worklist membership excuses a pending peephole; inline-worklist
;; membership excuses a pending inline; and every other live node has a use and no applicable
;; peephole.  Returns the number of violations; 0 is success.
(defn iter-check-fixpoint [] (-> i64)
  (let [cnt (arena-node-count)
        (mut i) 1
        (mut bad) 0]
    (set-mid-assert! true)
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (n-dead? n)
                            0
                            (do
                              ;; Types must be forwards even for a node already awaiting work.
                              (let [fresh (compute n)]
                                (if (= fresh TY-INVALID)
                                    (panic-i "iter-check-fixpoint: live node computed TY-INVALID; op"
                                             (n-op n))
                                    0)
                                (if (ty-isa? fresh (n-ty n))
                                    0
                                    (set! (mut bad) (+ (load bad) 1))))
                              (if (code-on-worklist? (n-nid n))
                                  0
                                  (do
                                    (if (and (= (n-op n) OP-CALLEND)
                                             (not (code-on-inline-worklist? (n-nid n))))
                                        (if (> (callend-inline-candidate n) 0)
                                            (set! (mut bad) (+ (load bad) 1))
                                            0)
                                        0)
                                    (if (and (n-unused? n) (!= (n-op n) OP-STOP))
                                        (set! (mut bad) (+ (load bad) 1))
                                        0)
                                    (match (n-peephole-opt! n)
                                      (Some [_] (set! (mut bad) (+ (load bad) 1)))
                                      (None [] 0)))))))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set-mid-assert! false)
    (load bad)))

;; How many live nodes there are to check — the counted floor under `iter-check-fixpoint`.
(defn iter-live-count [] (-> i64)
  (let [cnt (arena-node-count)
        (mut i) 1
        (mut live) 0]
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n] (if (n-dead? n) 0 (set! (mut live) (+ (load live) 1))))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load live)))

;; The seed this run is using. Recorded in every failure report so a red run reproduces.
(defn iter-seed [] (-> i64)
  (code-seed))

;; ---------------------------------------------------------------------------
;; The inline worklist
;;
;; A SECOND worklist, of CallEnd nodes. `iter-peeps!` pushes every CallEnd it visits onto it, so a
;; call that sharpens becomes a candidate without anyone tracking that explicitly.

;; Pop candidates until ONE fires. Deferred candidates are collected and retried later — but only
;; after something actually fired, because otherwise nothing waiting on cleanup can have become
;; ready and retrying would spin.
;;
;; Returns true when an inline happened.
(defstruct IterInlineTrace [(last i64)])

(defn iter-inline-trace [] (-> (ptr IterInlineTrace))
  (primitive/alloc-static IterInlineTrace))

;; The CallEnd the most recent inline round fired on.
(defn iter-last-inlined [] (-> i64)
  (.last (iter-inline-trace)))

(defn iter--rounds-exceeded! [(recent (ArrayList i64)) (rounds i64)] (-> i64)
  (do
    (p--str "\naot: PANIC: iter-run!: inlining did not converge after ")
    (p--int rounds)
    (p--str " rounds over ")
    (p--int (arena-node-count))
    (p--str " nodes; the most recently inlined CallEnds, oldest first:\n")
    (let [(mut i) (if (> (len recent) 12) (- (len recent) 12) 0)]
      (loop (if (>= (load i) (len recent))
                (break 0)
                (do
                  (p--str "  ")
                  (match (arena-node (get recent (load i)))
                    (Some [c] (p--str (n-text c)))
                    (None [] (do (p--str "#") (p--int (get recent (load i))) (p--str " (collected)"))))
                  (p--str "\n")
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (panic "iter-run!: inlining did not converge")))

(defn iter--one-inline! [] (-> bool)
  (let [(mut fired) false]
    (loop (match (code-inline-pop!)
            (None [] (break 0))
            (Some [id]
                  (match (arena-node id)
                    (None [] (continue))
                    (Some [cend]
                          (if (n-dead? cend)
                              (continue)
                              (let [d (callend-maybe-inline! cend)]
                                (if (= d INLINE-DEFER)
                                    (do (code-defer-inline! id) (continue))
                                    (if (> d 0)
                                        (do
                                          (set! (.last (iter-inline-trace)) id)
                                          (fun-size-epoch-bump!)
                                          (set! (mut fired) true)
                                          (break 0))
                                        (continue))))))))))
    (load fired)))

;; Move every deferred candidate back onto the inline worklist.
(defn iter--requeue-deferred! [] (-> i64)
  (code-requeue-deferred!))
