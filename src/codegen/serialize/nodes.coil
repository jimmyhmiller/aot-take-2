;; The complete ideal-node arena in a durable graph artifact.
;;
;; Simple's final serializer first assigns a deterministic dense order, emits subclass payloads,
;; allocates every empty node shell while reading, and only then reconnects ordered inputs. That
;; two-pass order is required for cycles and sharing. We discover the deterministic closure from
;; Stop through ordered inputs plus the IR's explicit semantic back-references, excluding dead
;; parser Scope state and other abandoned arena nodes. Backend caches, uses, dependencies and
;; worklists are deliberately absent: n-init! recreates empty process-local state and n-add-def!
;; rebuilds exact duplicate uses from the serialized ordered inputs.
(module aot.codegen.serialize.nodes)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.primitive" :as primitive)
(import "aot.util.arena" :use [compiler-allocator])
(import "aot.util.panic" :use [panic-i])
(import "aot.codegen.objfile" :use [obj-put1! obj-put8!])
(import "aot.codegen.serialize.bytes" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.bits" :use *)
(import "aot.node.compare" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.call" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.gc" :use *)
(import "aot.node.jsops" :use *)
(import "aot.node.property" :use *)
(import "aot.type.type" :use [TY-INVALID])

(defn ser-write-name! [(out (mut (ArrayList u8))) (name (slice u8))] (-> i64)
  (ser-put-bytes! (mut out) name))

(defn ser-node-index [(indices (HashMap i64 i64)) (nid i64)] (-> i64)
  (if (= nid 0)
      0
      (match (get indices nid)
        (Some [index] index)
        (None []
              (do
                (panic-i "ser-node-index: reference outside graph closure" nid)
                0)))))

(defn ser-write-node-payload! [(out (mut (ArrayList u8)))
                               (indices (HashMap i64 i64))
                               (n (dyn NodeOps))] (-> i64)
  (let [op (n-op n)]
    (case op OP-START
          (obj-put8! (mut out)
                     (.arg-ty (primitive/cast (ptr StartNode) (hdr n))))
            OP-IF
          (obj-put1! (mut out)
                     (if (.never (primitive/cast (ptr IfNode) (hdr n))) 1 0))
            OP-NEVER
          (obj-put1! (mut out)
                     (if (.never (primitive/cast (ptr IfNode) (hdr n))) 1 0))
            OP-CPROJ
          (let [p (primitive/cast (ptr CProjNode) (hdr n))]
            (obj-put8! (mut out) (.idx p))
            (ser-write-name! (mut out) (.name p)))
            OP-PROJ
          (let [p (primitive/cast (ptr ProjNode) (hdr n))]
            (obj-put8! (mut out) (.idx p))
            (ser-write-name! (mut out) (.name p)))
            OP-RETURN
          (obj-put8! (mut out)
                     (ser-node-index indices
                                     (.fun-nid (primitive/cast (ptr ReturnNode)
                                                               (hdr n)))))
            OP-PHI
          (let [p (primitive/cast (ptr PhiNode) (hdr n))]
            (obj-put8! (mut out) (.declared p))
            (ser-write-name! (mut out) (.name p)))
            OP-MEMPHI
          (let [p (primitive/cast (ptr PhiNode) (hdr n))]
            (obj-put8! (mut out) (.declared p))
            (ser-write-name! (mut out) (.name p)))
            OP-LOAD
          (let [p (primitive/cast (ptr LoadNode) (hdr n))]
            (obj-put8! (mut out) (.alias p))
            (obj-put8! (mut out) (.declared p))
            (obj-put1! (mut out) (if (.bounded p) 1 0)))
            OP-STORE
          (let [p (primitive/cast (ptr StoreNode) (hdr n))]
            (obj-put8! (mut out) (.alias p))
            (obj-put8! (mut out) (.declared p)))
            OP-NEW
          (let [p (primitive/cast (ptr NewNode) (hdr n))]
            (obj-put8! (mut out) (.shape p))
            (obj-put8! (mut out) (.object-ty p)))
            OP-MEMMERGE
          (obj-put1! (mut out)
                     (if (.in-progress (primitive/cast (ptr MemMergeNode)
                                                       (hdr n)))
                         1
                         0))
            OP-CON
          (obj-put8! (mut out) (.con-ty (primitive/cast (ptr ConNode) (hdr n))))
            OP-EXTERN
          (obj-put8! (mut out)
                     (.con-ty (primitive/cast (ptr ExternalNode) (hdr n))))
            OP-KEYREF
          (obj-put8! (mut out)
                     (.local-id (primitive/cast (ptr UnitRefNode) (hdr n))))
            OP-SHAPEREF
          (obj-put8! (mut out)
                     (.local-id (primitive/cast (ptr UnitRefNode) (hdr n))))
            OP-ADD
          (obj-put8! (mut out) (.mode (primitive/cast (ptr AddNode) (hdr n))))
            OP-SUB
          (obj-put8! (mut out) (.mode (primitive/cast (ptr SubNode) (hdr n))))
            OP-MUL
          (obj-put8! (mut out) (.mode (primitive/cast (ptr MulNode) (hdr n))))
            OP-DIV
          (obj-put8! (mut out) (.mode (primitive/cast (ptr DivNode) (hdr n))))
            OP-MINUS
          (obj-put8! (mut out) (.mode (primitive/cast (ptr MinusNode) (hdr n))))
            OP-AND
          (obj-put8! (mut out) (.mode (primitive/cast (ptr BitsNode) (hdr n))))
            OP-OR
          (obj-put8! (mut out) (.mode (primitive/cast (ptr BitsNode) (hdr n))))
            OP-XOR
          (obj-put8! (mut out) (.mode (primitive/cast (ptr BitsNode) (hdr n))))
            OP-SHL
          (obj-put8! (mut out) (.mode (primitive/cast (ptr BitsNode) (hdr n))))
            OP-SHR
          (obj-put8! (mut out) (.mode (primitive/cast (ptr BitsNode) (hdr n))))
            OP-SAR
          (obj-put8! (mut out) (.mode (primitive/cast (ptr BitsNode) (hdr n))))
            OP-EQ
          (obj-put8! (mut out) (.mode (primitive/cast (ptr CmpNode) (hdr n))))
            OP-NE
          (obj-put8! (mut out) (.mode (primitive/cast (ptr CmpNode) (hdr n))))
            OP-LT
          (obj-put8! (mut out) (.mode (primitive/cast (ptr CmpNode) (hdr n))))
            OP-LE
          (obj-put8! (mut out) (.mode (primitive/cast (ptr CmpNode) (hdr n))))
            OP-ULT
          (obj-put8! (mut out) (.mode (primitive/cast (ptr CmpNode) (hdr n))))
            OP-STATICREF
          (let [p (primitive/cast (ptr StaticRefNode) (hdr n))]
            (obj-put8! (mut out) (.entry p))
            (obj-put8! (mut out) (.rep p)))
            OP-BOX
          (obj-put8! (mut out) (.rep (primitive/cast (ptr BoxNode) (hdr n))))
            OP-UNBOX
          (obj-put8! (mut out) (.rep (primitive/cast (ptr UnboxNode) (hdr n))))
            OP-TYPETEST
          (obj-put8! (mut out)
                     (.tags (primitive/cast (ptr TypeTestNode) (hdr n))))
            OP-CAST
          (obj-put8! (mut out)
                     (.cast-ty (primitive/cast (ptr CastNode) (hdr n))))
            OP-FUN
          (let [p (primitive/cast (ptr FunNode) (hdr n))]
            (obj-put8! (mut out) (.sig p))
            (ser-write-name! (mut out) (.name p))
            (ser-write-name! (mut out) (.code-name p))
            (obj-put1! (mut out) (if (.folding p) 1 0))
            (obj-put1! (mut out) (if (.escapes p) 1 0))
            (obj-put8! (mut out) (.approx-size p))
            (obj-put8! (mut out) (.live-size p))
            (obj-put8! (mut out) (.live-size-epoch p))
            (obj-put1! (mut out) (if (.jsl p) 1 0))
            (obj-put8! (mut out) (ser-node-index indices (.version-root p)))
            (obj-put1! (mut out) (if (.version-entry p) 1 0))
            (obj-put1! (mut out) (if (.version-open p) 1 0))
            (obj-put8! (mut out) (ser-node-index indices (.ret-nid p))))
            OP-PARM
          (let [p (primitive/cast (ptr ParmNode) (hdr n))]
            (obj-put8! (mut out) (.idx p))
            (obj-put8! (mut out) (.declared p))
            (ser-write-name! (mut out) (.name p)))
            OP-FUNPTR
          (obj-put8! (mut out)
                     (.fptr-ty (primitive/cast (ptr FunPtrNode) (hdr n))))
            OP-CALL
          (obj-put8! (mut out)
                     (ser-node-index indices
                                     (.cend-nid (primitive/cast (ptr CallNode)
                                                                (hdr n)))))
            OP-CALLEND
          (let [p (primitive/cast (ptr CallEndNode) (hdr n))]
            (obj-put1! (mut out) (if (.folding p) 1 0))
            (obj-put1! (mut out) (if (.never-inline p) 1 0))
            (obj-put8! (mut out) (.decision p)))
            OP-JSOP
          (obj-put8! (mut out) (.prim (primitive/cast (ptr JsOpNode) (hdr n))))
            OP-PROPLOAD
          (let [p (primitive/cast (ptr PropAccessNode) (hdr n))]
            (obj-put8! (mut out) (.key p))
            (obj-put8! (mut out) (.kind p))
            (obj-put8! (mut out) (.attrs p))
            (obj-put8! (mut out) (ser-node-index indices (.res-mem p)))
            (obj-put8! (mut out) (ser-node-index indices (.res-value p))))
            OP-PROPSTORE
          (let [p (primitive/cast (ptr PropAccessNode) (hdr n))]
            (obj-put8! (mut out) (.key p))
            (obj-put8! (mut out) (.kind p))
            (obj-put8! (mut out) (.attrs p))
            (obj-put8! (mut out) (ser-node-index indices (.res-mem p)))
            (obj-put8! (mut out) (ser-node-index indices (.res-value p))))
            OP-STOP
          0 OP-XCTRL
          0 OP-REGION
          0 OP-LOOP
          0 OP-READONLY
          0 OP-SAFEPOINT
          0 OP-BARRIER
          0 OP-HEAPSTATE
          0 OP-NOT
          0 OP-TOFLOAT
          0 OP-TOINT
          0 OP-ROUNDF32
          0 (panic-i "ser-write-node-payload!: unsupported ideal opcode" op))))

(defn ser-gather-node! [(nodes (mut (ArrayList (dyn NodeOps))))
                        (indices (mut (HashMap i64 i64)))
                        (n (dyn NodeOps))] (-> i64)
  (if (hm-contains? (load indices) (n-nid n))
      0
      (do
        (push! [(dyn NodeOps)] (mut nodes) n)
        (set! (mut indices) (n-nid n) (len (load nodes)))
        0)))

(defn ser-gather-nid! [(nodes (mut (ArrayList (dyn NodeOps))))
                       (indices (mut (HashMap i64 i64)))
                       (nid i64)] (-> i64)
  (if (= nid 0)
      0
      (match (arena-node nid)
        (Some [n] (ser-gather-node! (mut nodes) (mut indices) n))
        (None [] (panic-i "ser-gather-nid!: missing semantic reference" nid)))))

(defn ser-gather-nodes [(root (dyn NodeOps))
                        (indices (mut (HashMap i64 i64)))] (-> (ArrayList (dyn NodeOps)))
  (let [(mut nodes) (al-new [(dyn NodeOps)] (compiler-allocator))
        (mut at) 0]
    (ser-gather-node! (mut nodes) (mut indices) root)
    (loop (if (>= (load at) (len (load nodes)))
              (break 0)
              (let [n (get (load nodes) (load at))
                    (mut i) 0]
                (loop (if (>= (load i) (n-nins n))
                          (break 0)
                          (do
                            (match (n-in n (load i))
                              (Some [input]
                                    (ser-gather-node! (mut nodes)
                                                      (mut indices)
                                                      input))
                              (None [] 0))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (let [op (n-op n)]
                  (cond (= op OP-FUN)
                          (let [p (primitive/cast (ptr FunNode) (hdr n))]
                            (ser-gather-nid! (mut nodes)
                                             (mut indices)
                                             (.version-root p))
                            (ser-gather-nid! (mut nodes)
                                             (mut indices)
                                             (.ret-nid p)))
                        (= op OP-RETURN)
                          (ser-gather-nid! (mut nodes)
                                           (mut indices)
                                           (.fun-nid (primitive/cast (ptr ReturnNode)
                                                                     (hdr n))))
                        (= op OP-CALL)
                          (ser-gather-nid! (mut nodes)
                                           (mut indices)
                                           (.cend-nid (primitive/cast (ptr CallNode)
                                                                      (hdr n))))
                        (or (= op OP-PROPLOAD) (= op OP-PROPSTORE))
                          (let [p (primitive/cast (ptr PropAccessNode) (hdr n))]
                            (ser-gather-nid! (mut nodes)
                                             (mut indices)
                                             (.res-mem p))
                            (ser-gather-nid! (mut nodes)
                                             (mut indices)
                                             (.res-value p)))
                        :else 0))
                (set! (mut at) (+ (load at) 1))
                (continue))))
    (load nodes)))

(defn ser-write-nodes! [(out (mut (ArrayList u8))) (root (dyn NodeOps))] (-> i64)
  (let [(mut indices) (hm-new [i64 i64] (compiler-allocator) (i64-keyops))
        (mut nodes) (ser-gather-nodes root (mut indices))]
    (obj-put8! (mut out) (len (load nodes)))
    (obj-put8! (mut out) (ser-node-index (load indices) (n-nid root)))
    (al-for [n (load nodes)]
            (obj-put8! (mut out) (n-op n))
            (obj-put8! (mut out) (n-ty n))
            (obj-put8! (mut out) (n-pesi-ty n))
            (obj-put8! (mut out) (.origin (hdr n)))
            (obj-put8! (mut out) (.source-lo (hdr n)))
            (obj-put8! (mut out) (.source-hi (hdr n)))
            (ser-write-node-payload! (mut out) (load indices) n)
            (obj-put8! (mut out) (n-nins n))
            (let [(mut i) 0]
              (loop (if (>= (load i) (n-nins n))
                        (break 0)
                        (do
                          (obj-put8! (mut out)
                                     (match (n-in n (load i))
                                       (Some [input]
                                             (ser-node-index (load indices)
                                                             (n-nid input)))
                                       (None [] 0)))
                          (set! (mut i) (+ (load i) 1))
                          (continue))))))
    (hm-free! (mut indices))
    (al-free! (mut nodes))
    0))

;; Names must outlive the artifact input buffer, which a disk-cache caller may release immediately.
(defn ser-read-owned-name! [(c (ptr SerCursor))] (-> (slice u8))
  (let [bytes (ser-read-bytes! c)
        (mut owned) (al-new [u8] (compiler-allocator))]
    (let [(mut i) 0]
      (loop (if (>= (load i) (len bytes))
                (break 0)
                (do
                  (push! [u8] (mut owned) (get bytes (load i)))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (al-into-slice (mut owned))))

(defn ser-raw-shell! [(op i64) (c (ptr SerCursor))] (-> (dyn NodeOps))
  (let [a (compiler-allocator)
        n
          (case op OP-START
                (let [p (unwrap-ptr [StartNode] (create [StartNode] a))]
                  (set! (.arg-ty p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-STOP
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [StopNode]
                                                (create [StopNode] a)))
                  OP-XCTRL
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [XCtrlNode]
                                                (create [XCtrlNode] a)))
                  OP-REGION
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [RegionNode]
                                                (create [RegionNode] a)))
                  OP-LOOP
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [LoopNode]
                                                (create [LoopNode] a)))
                  OP-IF
                (let [p (unwrap-ptr [IfNode] (create [IfNode] a))]
                  (set! (.never p) (ser-read-bool! c))
                  (primitive/make-dyn NodeOps p))
                  OP-NEVER
                (let [p (unwrap-ptr [IfNode] (create [IfNode] a))]
                  (set! (.never p) (ser-read-bool! c))
                  (primitive/make-dyn NodeOps p))
                  OP-CPROJ
                (let [p (unwrap-ptr [CProjNode] (create [CProjNode] a))]
                  (set! (.idx p) (ser-read8! c))
                  (set! (.name p) (ser-read-owned-name! c))
                  (primitive/make-dyn NodeOps p))
                  OP-PROJ
                (let [p (unwrap-ptr [ProjNode] (create [ProjNode] a))]
                  (set! (.idx p) (ser-read8! c))
                  (set! (.name p) (ser-read-owned-name! c))
                  (primitive/make-dyn NodeOps p))
                  OP-RETURN
                (let [p (unwrap-ptr [ReturnNode] (create [ReturnNode] a))]
                  (set! (.fun-nid p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-PHI
                (let [p (unwrap-ptr [PhiNode] (create [PhiNode] a))]
                  (set! (.declared p) (ser-read8! c))
                  (set! (.name p) (ser-read-owned-name! c))
                  (primitive/make-dyn NodeOps p))
                  OP-MEMPHI
                (let [p (unwrap-ptr [PhiNode] (create [PhiNode] a))]
                  (set! (.declared p) (ser-read8! c))
                  (set! (.name p) (ser-read-owned-name! c))
                  (primitive/make-dyn NodeOps p))
                  OP-LOAD
                (let [p (unwrap-ptr [LoadNode] (create [LoadNode] a))]
                  (set! (.alias p) (ser-read8! c))
                  (set! (.declared p) (ser-read8! c))
                  (set! (.bounded p) (ser-read-bool! c))
                  (primitive/make-dyn NodeOps p))
                  OP-STORE
                (let [p (unwrap-ptr [StoreNode] (create [StoreNode] a))]
                  (set! (.alias p) (ser-read8! c))
                  (set! (.declared p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-NEW
                (let [p (unwrap-ptr [NewNode] (create [NewNode] a))]
                  (set! (.shape p) (ser-read8! c))
                  (set! (.object-ty p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-MEMMERGE
                (let [p (unwrap-ptr [MemMergeNode] (create [MemMergeNode] a))]
                  (set! (.in-progress p) (ser-read-bool! c))
                  (primitive/make-dyn NodeOps p))
                  OP-READONLY
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [ReadOnlyNode]
                                                (create [ReadOnlyNode] a)))
                  OP-CON
                (let [p (unwrap-ptr [ConNode] (create [ConNode] a))]
                  (set! (.con-ty p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-EXTERN
                (let [p (unwrap-ptr [ExternalNode] (create [ExternalNode] a))]
                  (set! (.con-ty p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-KEYREF
                (let [p (unwrap-ptr [UnitRefNode] (create [UnitRefNode] a))]
                  (set! (.local-id p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-SHAPEREF
                (let [p (unwrap-ptr [UnitRefNode] (create [UnitRefNode] a))]
                  (set! (.local-id p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-ADD
                (let [p (unwrap-ptr [AddNode] (create [AddNode] a))]
                  (set! (.mode p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-SUB
                (let [p (unwrap-ptr [SubNode] (create [SubNode] a))]
                  (set! (.mode p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-MUL
                (let [p (unwrap-ptr [MulNode] (create [MulNode] a))]
                  (set! (.mode p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-DIV
                (let [p (unwrap-ptr [DivNode] (create [DivNode] a))]
                  (set! (.mode p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-MINUS
                (let [p (unwrap-ptr [MinusNode] (create [MinusNode] a))]
                  (set! (.mode p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-AND
                (ser-bits-shell! op c) OP-OR
                (ser-bits-shell! op c) OP-XOR
                (ser-bits-shell! op c) OP-SHL
                (ser-bits-shell! op c) OP-SHR
                (ser-bits-shell! op c) OP-SAR
                (ser-bits-shell! op c) OP-NOT
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [NotNode] (create [NotNode] a)))
                  OP-TOFLOAT
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [ToFloatNode]
                                                (create [ToFloatNode] a)))
                  OP-TOINT
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [ToIntNode]
                                                (create [ToIntNode] a)))
                  OP-ROUNDF32
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [RoundF32Node]
                                                (create [RoundF32Node] a)))
                  OP-EQ
                (ser-cmp-shell! op c) OP-NE
                (ser-cmp-shell! op c) OP-LT
                (ser-cmp-shell! op c) OP-LE
                (ser-cmp-shell! op c) OP-ULT
                (ser-cmp-shell! op c) OP-STATICREF
                (let [p (unwrap-ptr [StaticRefNode] (create [StaticRefNode] a))]
                  (set! (.entry p) (ser-read8! c))
                  (set! (.rep p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-BOX
                (let [p (unwrap-ptr [BoxNode] (create [BoxNode] a))]
                  (set! (.rep p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-UNBOX
                (let [p (unwrap-ptr [UnboxNode] (create [UnboxNode] a))]
                  (set! (.rep p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-TYPETEST
                (let [p (unwrap-ptr [TypeTestNode] (create [TypeTestNode] a))]
                  (set! (.tags p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-CAST
                (let [p (unwrap-ptr [CastNode] (create [CastNode] a))]
                  (set! (.cast-ty p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-FUN
                (ser-fun-shell! c) OP-PARM
                (let [p (unwrap-ptr [ParmNode] (create [ParmNode] a))]
                  (set! (.idx p) (ser-read8! c))
                  (set! (.declared p) (ser-read8! c))
                  (set! (.name p) (ser-read-owned-name! c))
                  (primitive/make-dyn NodeOps p))
                  OP-FUNPTR
                (let [p (unwrap-ptr [FunPtrNode] (create [FunPtrNode] a))]
                  (set! (.fptr-ty p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-CALL
                (let [p (unwrap-ptr [CallNode] (create [CallNode] a))]
                  (set! (.cend-nid p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-CALLEND
                (let [p (unwrap-ptr [CallEndNode] (create [CallEndNode] a))]
                  (set! (.folding p) (ser-read-bool! c))
                  (set! (.never-inline p) (ser-read-bool! c))
                  (set! (.frozen-ty p) TY-INVALID)
                  (set! (.decision p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-JSOP
                (let [p (unwrap-ptr [JsOpNode] (create [JsOpNode] a))]
                  (set! (.prim p) (ser-read8! c))
                  (primitive/make-dyn NodeOps p))
                  OP-HEAPSTATE
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [HeapStateNode]
                                                (create [HeapStateNode] a)))
                  OP-SAFEPOINT
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [SafepointNode]
                                                (create [SafepointNode] a)))
                  OP-BARRIER
                (primitive/make-dyn NodeOps
                                    (unwrap-ptr [BarrierNode]
                                                (create [BarrierNode] a)))
                  OP-PROPLOAD
                (ser-prop-shell! c) OP-PROPSTORE
                (ser-prop-shell! c)
                  (do
                    (set! (.ok c) false)
                    (primitive/make-dyn NodeOps
                                        (unwrap-ptr [XCtrlNode]
                                                    (create [XCtrlNode] a)))))]
    (n-init! n op)
    n))

(defn ser-bits-shell! [(op i64) (c (ptr SerCursor))] (-> (dyn NodeOps))
  (let [p (unwrap-ptr [BitsNode] (create [BitsNode] (compiler-allocator)))]
    (set! (.op-kind p) op)
    (set! (.mode p) (ser-read8! c))
    (primitive/make-dyn NodeOps p)))

(defn ser-cmp-shell! [(op i64) (c (ptr SerCursor))] (-> (dyn NodeOps))
  (let [p (unwrap-ptr [CmpNode] (create [CmpNode] (compiler-allocator)))]
    (set! (.op-kind p) op)
    (set! (.mode p) (ser-read8! c))
    (primitive/make-dyn NodeOps p)))

(defn ser-fun-shell! [(c (ptr SerCursor))] (-> (dyn NodeOps))
  (let [p (unwrap-ptr [FunNode] (create [FunNode] (compiler-allocator)))]
    (set! (.sig p) (ser-read8! c))
    (set! (.name p) (ser-read-owned-name! c))
    (set! (.code-name p) (ser-read-owned-name! c))
    (set! (.folding p) (ser-read-bool! c))
    (set! (.escapes p) (ser-read-bool! c))
    (set! (.approx-size p) (ser-read8! c))
    (set! (.live-size p) (ser-read8! c))
    (set! (.live-size-epoch p) (ser-read8! c))
    (set! (.jsl p) (ser-read-bool! c))
    (set! (.version-root p) (ser-read8! c))
    (set! (.version-entry p) (ser-read-bool! c))
    (set! (.version-open p) (ser-read-bool! c))
    (set! (.ret-nid p) (ser-read8! c))
    (primitive/make-dyn NodeOps p)))

(defn ser-prop-shell! [(c (ptr SerCursor))] (-> (dyn NodeOps))
  (let [p
          (unwrap-ptr [PropAccessNode]
                      (create [PropAccessNode] (compiler-allocator)))]
    (set! (.key p) (ser-read8! c))
    (set! (.kind p) (ser-read8! c))
    (set! (.attrs p) (ser-read8! c))
    (set! (.res-mem p) (ser-read8! c))
    (set! (.res-value p) (ser-read8! c))
    (primitive/make-dyn NodeOps p)))

(defstruct SerNodeRecord
  [(node (dyn NodeOps))
   (ins (slice i64))
   (origin i64)
   (source-lo i64)
   (source-hi i64)])

(defn ser-read-nodes! [(c (ptr SerCursor))] (-> (Option (dyn NodeOps)))
  (let [count (ser-read8! c)
        root-id (ser-read8! c)
        (mut records) (al-new [SerNodeRecord] (compiler-allocator))
        (mut id) 1]
    (if (or (< count 1) (< root-id 1) (> root-id count)) (set! (.ok c) false) 0)
    (loop (if (or (not (.ok c)) (> (load id) count))
              (break 0)
              (let [op (ser-read8! c)
                    ty (ser-read8! c)
                    pesi (ser-read8! c)
                    origin (ser-read8! c)
                    source-lo (ser-read8! c)
                    source-hi (ser-read8! c)
                    n (ser-raw-shell! op c)
                    input-count (ser-read8! c)
                    (mut inputs) (al-new [i64] (compiler-allocator))]
                (if (!= (n-nid n) (load id)) (set! (.ok c) false) 0)
                (if (or (< input-count 0)
                        (> input-count (/ (ser-remaining c) 8)))
                    (set! (.ok c) false)
                    (let [(mut i) 0]
                      (loop (if (>= (load i) input-count)
                                (break 0)
                                (let [input (ser-read8! c)]
                                  (if (or (< input 0) (> input count))
                                      (set! (.ok c) false)
                                      0)
                                  (push! [i64] (mut inputs) input)
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))))
                (n-force-ty! n ty)
                (n-set-pesi-ty! n pesi)
                (let [owned-inputs (al-into-slice (mut inputs))]
                  (push! [SerNodeRecord]
                         (mut records)
                         (SerNodeRecord
                           :node n
                           :ins owned-inputs
                           :origin origin
                           :source-lo source-lo
                           :source-hi source-hi)))
                (set! (mut id) (+ (load id) 1))
                (continue))))
    ;; Phase two: exact ordered edges. n-add-def! reconstructs each reciprocal use position.
    (let [(mut at) 0]
      (loop (if (or (not (.ok c)) (>= (load at) (len (load records))))
                (break 0)
                (let [record (get (load records) (load at))
                      (mut i) 0]
                  (loop (if (>= (load i) (len (.ins record)))
                            (break 0)
                            (let [input (get (.ins record) (load i))]
                              (if (= input 0)
                                  (n-add-def! (.node record)
                                              (None [(dyn NodeOps)]))
                                  (match (arena-node input)
                                    (Some [definition]
                                          (n-add-def! (.node record)
                                                      (Some definition)))
                                    (None [] (set! (.ok c) false))))
                              (set! (mut i) (+ (load i) 1))
                              (continue))))
                  ;; Adding inputs merges their source ranges. Restore the serialized diagnostic
                  ;; range only after all structural edge effects have completed.
                  (set! (.origin (hdr (.node record))) (.origin record))
                  (set! (.source-lo (hdr (.node record))) (.source-lo record))
                  (set! (.source-hi (hdr (.node record))) (.source-hi record))
                  (set! (mut at) (+ (load at) 1))
                  (continue)))))
    (if (not (.ok c))
        (None [(dyn NodeOps)])
        (arena-node root-id))))
