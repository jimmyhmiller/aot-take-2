;; The complete structural type table in an ideal-graph artifact.
;;
;; Simple gathers only types reachable from serialized nodes and remaps their child IDs. Our type
;; table is already dense, interned and compilation-local, so the equivalent deterministic closure
;; is the table prefix itself. We write every structural pool plus every tagged TyKind in ID order.
;; Loading starts from a fresh boot table, restores the pools, interns kinds in the same order and
;; requires every resulting ID to agree. No process-local offset or set ID is trusted implicitly.
(module aot.codegen.serialize.types)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "aot.util.panic" :use [panic panic-i])
(import "aot.type.type" :use *)
(import "aot.codegen.objfile" :use [obj-put1! obj-put8! obj-put-slice!])
(import "aot.codegen.serialize.bytes" :use *)

(const SER-TY-BOT 1)
(const SER-TY-TOP 2)
(const SER-TY-CTRL 3)
(const SER-TY-XCTRL 4)
(const SER-TY-NIL 5)
(const SER-TY-XNIL 6)
(const SER-TY-INT 7)
(const SER-TY-FLT 8)
(const SER-TY-PTR 9)
(const SER-TY-MEMPTR 10)
(const SER-TY-FUNPTR 11)
(const SER-TY-MEM 12)
(const SER-TY-STRUCT 13)
(const SER-TY-TUPLE 14)
(const SER-TY-RPC 15)
(const SER-TY-DYN 16)
(const SER-TY-IDENTITY 17)
(const SER-TY-SHAPE 18)
(const SER-TY-STR 19)

(defn ser-write-i64-array! [(out (mut (ArrayList u8)))
                            (values (ArrayList i64))] (-> i64)
  (obj-put8! (mut out) (len values))
  (al-for [value values] (obj-put8! (mut out) value))
  0)

(defn ser-write-type-kind! [(out (mut (ArrayList u8))) (kind TyKind)] (-> i64)
  (match kind
    (TBot [] (obj-put1! (mut out) SER-TY-BOT))
    (TTop [] (obj-put1! (mut out) SER-TY-TOP))
    (TCtrl [] (obj-put1! (mut out) SER-TY-CTRL))
    (TXCtrl [] (obj-put1! (mut out) SER-TY-XCTRL))
    (TNil [] (obj-put1! (mut out) SER-TY-NIL))
    (TXNil [] (obj-put1! (mut out) SER-TY-XNIL))
    (TInt [lo hi widen]
          (do (obj-put1! (mut out) SER-TY-INT)
              (obj-put8! (mut out) lo)
              (obj-put8! (mut out) hi)
              (obj-put8! (mut out) widen)))
    (TFlt [size bits]
          (do (obj-put1! (mut out) SER-TY-FLT)
              (obj-put8! (mut out) size)
              (obj-put8! (mut out) bits)))
    (TPtr [nilstate to]
          (do (obj-put1! (mut out) SER-TY-PTR)
              (obj-put8! (mut out) nilstate)
              (obj-put8! (mut out) to)))
    (TMemPtr [nilstate strct identity]
             (do (obj-put1! (mut out) SER-TY-MEMPTR)
                 (obj-put8! (mut out) nilstate)
                 (obj-put8! (mut out) strct)
                 (obj-put8! (mut out) identity)))
    (TFunPtr [sig fidx high external]
             (do (obj-put1! (mut out) SER-TY-FUNPTR)
                 (obj-put8! (mut out) sig)
                 (obj-put8! (mut out) fidx)
                 (ser-put-bool! (mut out) high)
                 (ser-put-bool! (mut out) external)))
    (TMem [alias elem one]
          (do (obj-put1! (mut out) SER-TY-MEM)
              (obj-put8! (mut out) alias)
              (obj-put8! (mut out) elem)
              (ser-put-bool! (mut out) one)))
    (TStruct [nameoff namelen fldoff fldlen]
             (do (obj-put1! (mut out) SER-TY-STRUCT)
                 (obj-put8! (mut out) nameoff)
                 (obj-put8! (mut out) namelen)
                 (obj-put8! (mut out) fldoff)
                 (obj-put8! (mut out) fldlen)))
    (TTuple [off count]
            (do (obj-put1! (mut out) SER-TY-TUPLE)
                (obj-put8! (mut out) off)
                (obj-put8! (mut out) count)))
    (TRpc [off count]
          (do (obj-put1! (mut out) SER-TY-RPC)
              (obj-put8! (mut out) off)
              (obj-put8! (mut out) count)))
    (TDyn [tags high int identity]
          (do (obj-put1! (mut out) SER-TY-DYN)
              (obj-put8! (mut out) tags)
              (ser-put-bool! (mut out) high)
              (obj-put8! (mut out) int)
              (obj-put8! (mut out) identity)))
    (TIdentity [members complement]
               (do (obj-put1! (mut out) SER-TY-IDENTITY)
                   (obj-put8! (mut out) members)
                   (ser-put-bool! (mut out) complement)))
    (TShape [shapes]
            (do (obj-put1! (mut out) SER-TY-SHAPE)
                (obj-put8! (mut out) shapes)))
    (TStr [conoff conlen]
          (do (obj-put1! (mut out) SER-TY-STR)
              (obj-put8! (mut out) conoff)
              (obj-put8! (mut out) conlen)))))

(defn ser-write-types! [(out (mut (ArrayList u8)))] (-> i64)
  (let [table (ty-table)]
    (ser-write-i64-array! (mut out) (.kids table))
    (obj-put8! (mut out) (len (.bytes table)))
    (obj-put-slice! (mut out) (al-slice (.bytes table)))
    (ser-write-i64-array! (mut out) (.fidx-offs table))
    (ser-write-i64-array! (mut out) (.fidx-lens table))
    (ser-write-i64-array! (mut out) (.fidx-members table))
    (obj-put8! (mut out) (ty-count))
    (let [(mut id) 0]
      (loop (if (>= (load id) (ty-count))
                (break 0)
                (do
                  (ser-write-type-kind! (mut out) (get (.kinds table) (load id)))
                  (set! (mut id) (+ (load id) 1))
                  (continue)))))
    0))

(defn ser-read-i64-array-into! [(c (ptr SerCursor))
                                (out (mut (ArrayList i64)))] (-> i64)
  (let [count (ser-read8! c)]
    (if (or (< count 0) (> count (/ (ser-remaining c) 8)))
        (set! (.ok c) false)
        (do
          (al-clear! (mut out))
          (let [(mut i) 0]
            (loop (if (>= (load i) count)
                      (break 0)
                      (do
                        (push! [i64] (mut out) (ser-read8! c))
                        (set! (mut i) (+ (load i) 1))
                        (continue)))))))
    0))

(defn ser-read-type-kind! [(c (ptr SerCursor))] (-> TyKind)
  (let [tag (ser-read1! c)]
    (case tag SER-TY-BOT (TBot)
          SER-TY-TOP (TTop)
          SER-TY-CTRL (TCtrl)
          SER-TY-XCTRL (TXCtrl)
          SER-TY-NIL (TNil)
          SER-TY-XNIL (TXNil)
          SER-TY-INT
            (let [lo (ser-read8! c)]
              (let [hi (ser-read8! c)]
                (TInt :lo lo :hi hi :widen (ser-read8! c))))
          SER-TY-FLT
            (let [size (ser-read8! c)] (TFlt :sz size :bits (ser-read8! c)))
          SER-TY-PTR
            (let [nilstate (ser-read8! c)]
              (TPtr :nilstate nilstate :to (ser-read8! c)))
          SER-TY-MEMPTR
            (let [nilstate (ser-read8! c)]
              (let [strct (ser-read8! c)]
                (TMemPtr
                  :nilstate nilstate
                  :strct strct
                  :identity (ser-read8! c))))
          SER-TY-FUNPTR
            (let [sig (ser-read8! c)]
              (let [fidx (ser-read8! c)]
                (let [high (ser-read-bool! c)]
                  (TFunPtr
                    :sig sig
                    :fidx fidx
                    :high high
                    :external (ser-read-bool! c)))))
          SER-TY-MEM
            (let [alias (ser-read8! c)]
              (let [elem (ser-read8! c)]
                (TMem :alias alias :elem elem :one (ser-read-bool! c))))
          SER-TY-STRUCT
            (let [nameoff (ser-read8! c)]
              (let [namelen (ser-read8! c)]
                (let [fldoff (ser-read8! c)]
                  (TStruct
                    :nameoff nameoff
                    :namelen namelen
                    :fldoff fldoff
                    :fldlen (ser-read8! c)))))
          SER-TY-TUPLE
            (let [off (ser-read8! c)] (TTuple :off off :len (ser-read8! c)))
          SER-TY-RPC
            (let [off (ser-read8! c)] (TRpc :off off :len (ser-read8! c)))
          SER-TY-DYN
            (let [tags (ser-read8! c)]
              (let [high (ser-read-bool! c)]
                (let [int (ser-read8! c)]
                  (TDyn
                    :tags tags
                    :high high
                    :int int
                    :identity (ser-read8! c)))))
          SER-TY-IDENTITY
            (let [members (ser-read8! c)]
              (TIdentity :members members :complement (ser-read-bool! c)))
          SER-TY-SHAPE (TShape :shapes (ser-read8! c))
          SER-TY-STR
            (let [conoff (ser-read8! c)]
              (TStr :conoff conoff :conlen (ser-read8! c)))
          (do (set! (.ok c) false) (TBot)))))

(defn ser-type-pools-valid? [] (-> bool)
  (let [table (ty-table)
        (mut valid) (and (> (len (.fidx-offs table)) 0)
                         (= (len (.fidx-offs table)) (len (.fidx-lens table))))
        (mut i) 0]
    (loop (if (or (not (load valid)) (>= (load i) (len (.fidx-offs table))))
              (break 0)
              (let [off (get (.fidx-offs table) (load i))
                    count (get (.fidx-lens table) (load i))]
                (if (or (< off 0)
                        (< count 0)
                        (> off (len (.fidx-members table)))
                        (> count (- (len (.fidx-members table)) off)))
                    (set! (mut valid) false)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load valid)))

(defn ser-read-types! [(c (ptr SerCursor))] (-> bool)
  (do
    (ty-boot!)
    (if (!= (ty-count) 7)
        (panic "ser-read-types!: type table is not fresh")
        0)
    (let [table (ty-table)]
      (ser-read-i64-array-into! c (mut (.kids table)))
      (let [bytes (ser-read-bytes! c)]
        (al-clear! (mut (.bytes table)))
        (let [(mut i) 0]
          (loop (if (>= (load i) (len bytes))
                    (break 0)
                    (do
                      (push! [u8] (mut (.bytes table)) (get bytes (load i)))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))))
      (ser-read-i64-array-into! c (mut (.fidx-offs table)))
      (ser-read-i64-array-into! c (mut (.fidx-lens table)))
      (ser-read-i64-array-into! c (mut (.fidx-members table)))
      (if (not (ser-type-pools-valid?)) (set! (.ok c) false) 0)
      (let [count (ser-read8! c)
            (mut id) 0]
        (if (< count 7) (set! (.ok c) false) 0)
        (loop (if (or (not (.ok c)) (>= (load id) count))
                  (break 0)
                  (let [kind (ser-read-type-kind! c)]
                    (if (< (load id) 7)
                        (if (not (ty-kind-eq? (get (.kinds table) (load id)) kind))
                            (set! (.ok c) false)
                            0)
                        (let [actual (ty-intern kind)]
                          (if (!= actual (load id))
                              (do
                                (panic-i "ser-read-types!: type ID changed" actual)
                                (set! (.ok c) false))
                              0)))
                    (set! (mut id) (+ (load id) 1))
                    (continue)))))
      (.ok c))))
