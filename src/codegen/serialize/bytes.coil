;; Checked little-endian primitives shared by the ideal-graph artifact sections.
(module aot.codegen.serialize.bytes)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [subslice slice-data])
(import "aot.codegen.objfile" :use [obj-put1! obj-put8! obj-put-slice!])
(import "aot.rt.rt" :use [rt-read-u64])

(defstruct SerCursor [(bytes (slice u8)) (at i64) (ok bool)])

(defn ser-put-bool! [(out (mut (ArrayList u8))) (value bool)] (-> i64)
  (obj-put1! (mut out) (if value 1 0)))

(defn ser-put-bytes! [(out (mut (ArrayList u8))) (bytes (slice u8))] (-> i64)
  (obj-put8! (mut out) (len bytes))
  (obj-put-slice! (mut out) bytes))

(defn ser-remaining [(c (ptr SerCursor))] (-> i64)
  (- (len (.bytes c)) (.at c)))

(defn ser-can-read? [(c (ptr SerCursor)) (bytes i64)] (-> bool)
  (and (.ok c) (>= bytes 0) (<= bytes (ser-remaining c))))

(defn ser-read1! [(c (ptr SerCursor))] (-> i64)
  (if (not (ser-can-read? c 1))
      (do (set! (.ok c) false) 0)
      (let [value (primitive/cast i64 (get (.bytes c) (.at c)))]
        (set! (.at c) (+ (.at c) 1))
        value)))

(defn ser-read8! [(c (ptr SerCursor))] (-> i64)
  (if (not (ser-can-read? c 8))
      (do (set! (.ok c) false) 0)
      (let [value (rt-read-u64 (slice-data (.bytes c)) (.at c))]
        (set! (.at c) (+ (.at c) 8))
        value)))

(defn ser-read-bool! [(c (ptr SerCursor))] (-> bool)
  (let [value (ser-read1! c)]
    (if (> value 1) (set! (.ok c) false) 0)
    (= value 1)))

(defn ser-read-bytes! [(c (ptr SerCursor))] (-> (slice u8))
  (let [count (ser-read8! c)]
    (if (not (ser-can-read? c count))
        (do (set! (.ok c) false) "")
        (let [start (.at c)]
          (set! (.at c) (+ start count))
          (subslice (.bytes c) start (+ start count))))))
