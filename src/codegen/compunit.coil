;; Compilation units: the dependency tree, and linking IR across it.

;;
;; A unit is one source file plus the object file it produces. Units form a tree mirroring the
;; source tree, and a unit's dependencies are the units whose declarations it reads.
;;
;; THE CLOSED WORLD IS ASSEMBLED HERE. Every decision in this compiler that folds a check away
;; rests on seeing every function that can be called; this module is what establishes that the set
;; is complete. A unit that cannot be resolved is a hard error, not a fallback to an open-world
;; assumption — a silent fallback would leave guards folded on evidence that no longer holds.
;;
;; Final Simple's TypeStruct interns declared field names/types/aliases; its layout groups fields
;; by size and derives offsets after optimization. JavaScript's hidden-class tree instead fixes
;; a boxed field's offset at its introducing transition (aot.shape). Unit composition must retain
;; that order and those offsets. We intern key bytes, map parents before children, and canonicalize
;; complete transition rows, preserving attributes and non-extensible marker edges. Sorting keys
;; or equating shapes by their property sets would silently change compiled field offsets.
;;
;; Owned shape assembly is implemented below. Source dependency resolution and IR linking remain
;; named hard errors; native calling compatibility alone cannot establish the closed world.
(module aot.codegen.compunit)
(import "aot.util.panic" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.str" :use [str-keyops-borrowed])
(import "coil.slice" :use [slice-data slice-new])
(import "aot.rt.shapes" :use [SHAPES-VERSION SHAPES-HEADER-BYTES SHAPES-RECORD-BYTES
                               SHAPES-KEY-RECORD-BYTES SHAPES-WORD-BYTES SHAPES-FLAG-NONEXTENSIBLE
                               shapes-read-u32 shapes-blob-magic?])
(import "aot.shape" :use [SHAPE-STRING SHAPE-ELEMENTS])
(import "aot.rt.rt" :use [RT-IMAGE-FIXED-BYTES RT-IMAGE-VERSION RT-HEADER-BYTES
                           rt-image-magic? rt-read-u32 rt-read-u64 rt-align8])

;; Script instantiation metadata is source-level: no realm key, Fun index, node or heap entry
;; belongs here. Function ordinals enumerate this Script's top-level declarations, including
;; duplicates in source order. A global-property write is an effect, not a var declaration;
;; keeping it distinct prevents a future unit assembler from hoisting its assignment.
(const CU-SCRIPT-VAR 1)
(const CU-SCRIPT-FUNCTION 2)
(const CU-SCRIPT-LET 3)
(const CU-SCRIPT-CONST 4)
(const CU-SCRIPT-PROPERTY-WRITE 5)
(const CU-SCRIPT-CLASS 6)
(defstruct CuScriptDecl [(name (slice u8)) (kind i64) (function-ordinal i64)])
(defstruct CuScriptDeclarations [(strict bool) (entries (slice CuScriptDecl))])
;; A source callable root is a declaration identity, not an emitted symbol or parser Fun index.
(defstruct CuScriptCallableRoot [(script i64) (ordinal i64)])

;; Deep capture: the caller owns the entries and each name until free. Parser plans may borrow
;; token storage within a compiler generation; this artifact never does.
(defn cu-script-declarations-copy [(strict bool) (entries (ArrayList CuScriptDecl))] (-> CuScriptDeclarations)
  (let [a (alloc/malloc-allocator) (mut out) (al-new [CuScriptDecl] a) (mut ordinal) 0]
    (al-for [entry entries]
      (let [e entry (mut name) (al-new [u8] a)]
        (if (or (< (.kind e) CU-SCRIPT-VAR) (> (.kind e) CU-SCRIPT-CLASS)
                (and (= (len (.name e)) 0) (!= (.kind e) CU-SCRIPT-PROPERTY-WRITE)))
            (panic "cu-script-declarations-copy: invalid declaration") 0)
        (if (= (.kind e) CU-SCRIPT-FUNCTION)
            (do (if (!= (.function-ordinal e) (load ordinal))
                    (panic "cu-script-declarations-copy: noncontiguous function ordinal") 0)
                (set! (mut ordinal) (+ (load ordinal) 1)))
            (if (!= (.function-ordinal e) -1)
                (panic "cu-script-declarations-copy: nonfunction has a function ordinal") 0))
        (al-extend! [u8] (mut name) (slice-data (.name e)) (len (.name e)))
        (let [owned (al-into-slice (mut name))]
          (push! [CuScriptDecl] (mut out)
                 (CuScriptDecl :name owned :kind (.kind e) :function-ordinal (.function-ordinal e))))))
    (let [owned (al-into-slice (mut out))]
      (CuScriptDeclarations :strict strict :entries owned))))

(defn cu-script-declarations-free! [(plan (ptr CuScriptDeclarations))] (-> i64)
  (let [a (alloc/malloc-allocator) (mut i) 0]
    (loop (if (>= (load i) (len (.entries plan))) (break 0)
              (let [entry (get (.entries plan) (load i))]
                (alloc/free [u8] a (.name entry))
                (set! (mut i) (+ (load i) 1)) (continue))))
    (alloc/free [CuScriptDecl] a (.entries plan))
    (set! plan (primitive/zeroed CuScriptDeclarations))
    0))

;; These artifacts own malloc-backed storage, not compiler-generation pointers. Unit order fixes
;; deterministic program identities; callers use the maps, never assume IDs survive composition.
(defstruct CuIdentityMap [(keys (slice i64)) (shapes (slice i64))])
(defstruct CuShapeAssembly [(blob (slice u8)) (units (ArrayList CuIdentityMap))])
(defstruct CuShapeRow [(parent i64) (key i64) (offset i64) (fields i64) (attrs i64) (flags i64)])
(defstruct CuShapeBuilder
  [(names (ArrayList (slice u8))) (rows (ArrayList CuShapeRow))
   (key-index (HashMap (slice u8) i64)) (row-index (HashMap CuShapeRow i64))])

(defn cu-shape-row-hash [(raw (ptr i8)) (size i64)] (-> i64)
  (let [r (primitive/cast (ptr CuShapeRow) raw)]
    (+ (* (+ (* (+ (* (.parent r) 31) (.key r)) 31) (.offset r)) 31)
       (+ (* (+ (* (.fields r) 31) (.attrs r)) 31) (.flags r)))))

(defn cu-shape-row-eq [(left (ptr i8)) (right (ptr i8)) (size i64)] (-> bool)
  (let [a (primitive/cast (ptr CuShapeRow) left) b (primitive/cast (ptr CuShapeRow) right)]
    (and (= (.parent a) (.parent b)) (= (.key a) (.key b)) (= (.offset a) (.offset b))
         (= (.fields a) (.fields b)) (= (.attrs a) (.attrs b)) (= (.flags a) (.flags b)))))

(defn cu-shape-row-keyops [] (-> (ptr KeyOps))
  (let [ops (primitive/alloc-static KeyOps)]
    (set! (.hash ops) (primitive/fnptr-of cu-shape-row-hash))
    (set! (.eq ops) (primitive/fnptr-of cu-shape-row-eq))
    (set! (.size ops) (primitive/sizeof CuShapeRow))
    ops))

(defn cu-shape-builder-new [] (-> CuShapeBuilder)
  (let [a (alloc/malloc-allocator) (mut names) (al-new [(slice u8)] a)
        (mut rows) (al-new [CuShapeRow] a)]
    (push! [(slice u8)] (mut names) "")
    (push! [CuShapeRow] (mut rows) (primitive/zeroed CuShapeRow))
    (push! [CuShapeRow] (mut rows) (primitive/zeroed CuShapeRow))
    (CuShapeBuilder :names (load names) :rows (load rows)
                    :key-index (hm-new [(slice u8) i64] a (str-keyops-borrowed))
                    :row-index (hm-new [CuShapeRow i64] a (cu-shape-row-keyops)))))

(defn cu-shape-builder-free! [(builder (ptr CuShapeBuilder))] (-> i64)
  ;; The index borrows names; destroy it before releasing its key storage.
  (hm-free! (mut (.key-index builder)))
  (hm-free! (mut (.row-index builder)))
  (let [(mut i) 1]
    (loop (if (>= (load i) (len (.names builder))) (break 0)
              (do (alloc/free [u8] (alloc/malloc-allocator) (get (.names builder) (load i)))
                  (set! (mut i) (+ (load i) 1)) (continue)))))
  (al-free! (mut (.names builder))) (al-free! (mut (.rows builder)))
  0)

(defn cu-shape-key! [(builder (ptr CuShapeBuilder)) (name (slice u8))] (-> i64)
  (match (get (.key-index builder) name)
    (Some [id] id)
    (None []
      (let [(mut bytes) (al-new [u8] (alloc/malloc-allocator)) id (len (.names builder))]
        (al-extend! [u8] (mut bytes) (slice-data name) (len name))
        (let [owned (al-into-slice (mut bytes))]
          (push! [(slice u8)] (mut (.names builder)) owned)
          (set! (mut (.key-index builder)) owned id)
          id)))))

(defn cu-shape-row! [(builder (ptr CuShapeBuilder)) (row CuShapeRow)] (-> i64)
  (match (get (.row-index builder) row)
    (Some [id] id)
    (None [] (let [id (len (.rows builder))]
               (push! [CuShapeRow] (mut (.rows builder)) row)
               (set! (mut (.row-index builder)) row id)
               id))))

(defn cu-shape-has-key? [(builder (ptr CuShapeBuilder)) (parent i64) (key i64)] (-> bool)
  (let [(mut at) parent]
    (loop (if (<= (load at) 1) (break false)
              (let [row (get (.rows builder) (load at))]
                (if (= (.key row) key) (break true)
                    (do (set! (mut at) (.parent row)) (continue))))))))

(defn cu-shape-import! [(builder (ptr CuShapeBuilder)) (blob (slice u8))] (-> CuIdentityMap)
  (let [a (alloc/malloc-allocator) (mut keys) (al-new [i64] a) (mut shapes) (al-new [i64] a)]
    (push! [i64] (mut keys) 0)
    (push! [i64] (mut shapes) 0) (push! [i64] (mut shapes) 1)
    (if (> (len blob) 0)
        (let [p (slice-data blob)]
          (if (or (< (len blob) SHAPES-HEADER-BYTES) (not (shapes-blob-magic? p)))
              (panic "cu-shape-import!: invalid shape blob header") 0)
          (if (!= (shapes-read-u32 p 8) SHAPES-VERSION)
              (panic "cu-shape-import!: unsupported shape blob version") 0)
          (let [shape-count (shapes-read-u32 p 12) key-count (shapes-read-u32 p 16)
                name-bytes (shapes-read-u32 p 20)
                key-start (+ SHAPES-HEADER-BYTES (* shape-count SHAPES-RECORD-BYTES))
                names-start (+ key-start (* key-count SHAPES-KEY-RECORD-BYTES)) (mut k) 0]
            (if (or (< shape-count 2) (< key-count 1) (!= (+ names-start name-bytes) (len blob)))
                (panic "cu-shape-import!: shape blob counts disagree with its extent") 0)
            ;; Invalid/root rows contain no fields. Requiring them explicitly avoids interpreting
            ;; an arbitrary row as the shared root of two otherwise incompatible graphs.
            (loop (if (>= (load k) (* 2 SHAPES-RECORD-BYTES)) (break 0)
                      (do (if (!= (shapes-read-u32 p (+ SHAPES-HEADER-BYTES (load k))) 0)
                              (panic "cu-shape-import!: malformed invalid or root shape") 0)
                          (set! (mut k) (+ (load k) 4)) (continue))))
            (set! (mut k) 0)
            (loop (if (>= (load k) key-count) (break 0)
                      (let [at (+ key-start (* (load k) SHAPES-KEY-RECORD-BYTES))
                            offset (shapes-read-u32 p at) bytes (shapes-read-u32 p (+ at 4))]
                        (if (or (> offset name-bytes) (> bytes (- name-bytes offset)))
                            (panic "cu-shape-import!: key name outside name storage") 0)
                        (if (= (load k) 0)
                            (if (or (!= offset 0) (!= bytes 0))
                                (panic "cu-shape-import!: malformed invalid key") 0)
                            (do (if (= bytes 0) (panic "cu-shape-import!: empty property key is not admitted") 0)
                                (push! [i64] (mut keys)
                                       (cu-shape-key! builder (slice-new [u8] (primitive/index p (+ names-start offset)) bytes))) 0))
                        (set! (mut k) (+ (load k) 1)) (continue))))
            (set! (mut k) 2)
            (loop (if (>= (load k) shape-count) (break 0)
                      (let [at (+ SHAPES-HEADER-BYTES (* (load k) SHAPES-RECORD-BYTES))
                            parent (shapes-read-u32 p at) key (shapes-read-u32 p (+ at 4))
                            offset (shapes-read-u32 p (+ at 8)) fields (shapes-read-u32 p (+ at 12))
                            attrs (shapes-read-u32 p (+ at 16)) flags (shapes-read-u32 p (+ at 20))]
                        (if (or (< parent 1) (>= parent (load k)) (>= key key-count) (> attrs 15)
                                (> flags SHAPES-FLAG-NONEXTENSIBLE))
                            (panic "cu-shape-import!: invalid transition identity or flags") 0)
                        (let [mapped-parent (get (load shapes) parent) mapped-key (get (load keys) key)
                              before (get (.rows builder) mapped-parent)]
                          (if (= key 0)
                              (if (or (!= offset 0xffffffff) (!= fields (.fields before)) (!= attrs 0)
                                      (!= (.flags before) 0) (!= flags SHAPES-FLAG-NONEXTENSIBLE))
                                  (panic "cu-shape-import!: invalid non-extensible marker") 0)
                              (if (or (!= (.flags before) 0) (!= flags (.flags before))
                                      (!= fields (+ (.fields before) 1))
                                      (!= offset (* (.fields before) SHAPES-WORD-BYTES))
                                      (cu-shape-has-key? builder mapped-parent mapped-key))
                                  (panic "cu-shape-import!: transition changes an existing field layout") 0))
                          (push! [i64] (mut shapes)
                            (cu-shape-row! builder
                              (CuShapeRow :parent mapped-parent :key mapped-key :offset offset
                                          :fields fields :attrs attrs :flags flags))))
                        (set! (mut k) (+ (load k) 1)) (continue)))))
          0) 0)
    (let [owned-keys (al-into-slice (mut keys)) owned-shapes (al-into-slice (mut shapes))]
      (CuIdentityMap :keys owned-keys :shapes owned-shapes))))

(defn cu-shape-put-u32! [(out (mut (ArrayList u8))) (value i64)] (-> i64)
  (if (or (< value 0) (> value 0xffffffff)) (panic "cu-shape-put-u32!: shape metadata exceeds its format") 0)
  (let [(mut i) 0]
    (loop (if (>= (load i) 4) (break 0)
              (do (push! [u8] (mut out) (primitive/cast u8 (& (primitive/ishr value (* 8 (load i))) 255)))
                  (set! (mut i) (+ (load i) 1)) (continue))))))

(defn cu-shape-emit [(builder (ptr CuShapeBuilder))] (-> (slice u8))
  (let [(mut out) (al-new [u8] (alloc/malloc-allocator)) (mut bytes) 0 (mut offset) 0]
    (al-for [name (.names builder)] (set! (mut bytes) (+ (load bytes) (len name))))
    (al-extend! [u8] (mut out) (slice-data "AOTSHAPE") 8)
    (cu-shape-put-u32! (mut out) SHAPES-VERSION)
    (cu-shape-put-u32! (mut out) (len (.rows builder)))
    (cu-shape-put-u32! (mut out) (len (.names builder)))
    (cu-shape-put-u32! (mut out) (load bytes))
    (al-for [row (.rows builder)]
      (let [r row]
        (cu-shape-put-u32! (mut out) (.parent r)) (cu-shape-put-u32! (mut out) (.key r))
        (cu-shape-put-u32! (mut out) (.offset r)) (cu-shape-put-u32! (mut out) (.fields r))
        (cu-shape-put-u32! (mut out) (.attrs r)) (cu-shape-put-u32! (mut out) (.flags r))))
    (al-for [name (.names builder)]
      (cu-shape-put-u32! (mut out) (load offset)) (cu-shape-put-u32! (mut out) (len name))
      (set! (mut offset) (+ (load offset) (len name))))
    (al-for [name (.names builder)] (al-extend! [u8] (mut out) (slice-data name) (len name)))
    (al-into-slice (mut out))))

(defn cu-shapes-compose [(blobs (ArrayList (slice u8)))] (-> CuShapeAssembly)
  (let [builder (primitive/alloc-stack CuShapeBuilder)
        (mut units) (al-new [CuIdentityMap] (alloc/malloc-allocator))]
    (set! builder (cu-shape-builder-new))
    (al-for [blob blobs] (push! [CuIdentityMap] (mut units) (cu-shape-import! builder blob)))
    (let [bytes (cu-shape-emit builder)]
      (cu-shape-builder-free! builder)
      (CuShapeAssembly :blob bytes :units (load units)))))

(defn cu-remap-key [(map CuIdentityMap) (key i64)] (-> i64)
  (if (or (<= key 0) (>= key (len (.keys map)))) (panic "cu-remap-key: unknown unit-local key") 0)
  (get (.keys map) key))

(defn cu-remap-shape [(map CuIdentityMap) (shape i64)] (-> i64)
  (if (or (= shape SHAPE-STRING) (= shape SHAPE-ELEMENTS)) shape
      (do (if (or (<= shape 0) (>= shape (len (.shapes map))))
              (panic "cu-remap-shape: unknown unit-local shape") 0)
          (get (.shapes map) shape))))

;; Relocate shape identities in a fresh writable image copy, before runtime reference adoption.
;; The template and mapping stay immutable. First validate all headers/maps; only the second pass
;; writes. Reference/code fixups and the global word are unchanged and keep their own validators.
(defn cu-remap-static-shapes! [(bytes (slice u8)) (map CuIdentityMap)] (-> i64)
  (if (= (len bytes) 0) 0
      (let [p (slice-data bytes)]
        (if (or (< (len bytes) RT-IMAGE-FIXED-BYTES) (not (rt-image-magic? p))
                (!= (rt-read-u32 p 8) RT-IMAGE-VERSION) (!= (% (len bytes) 8) 0)
                (!= (% (primitive/cast i64 p) 8) 0))
            (panic "cu-remap-static-shapes!: invalid image header or alignment") 0)
        (let [entries (rt-read-u32 p 28) count (rt-read-u32 p 12)
              (mut offset) entries (mut seen) 0]
          (if (or (< entries (+ RT-IMAGE-FIXED-BYTES (* 4 (rt-read-u32 p 24))))
                  (> entries (len bytes)) (!= (% entries 8) 0))
              (panic "cu-remap-static-shapes!: invalid entry-table extent") 0)
          (loop (if (>= (load offset) (len bytes)) (break 0)
                    (do
                      (if (> RT-HEADER-BYTES (- (len bytes) (load offset)))
                          (panic "cu-remap-static-shapes!: truncated object header") 0)
                      (let [size (rt-read-u64 p (load offset))
                            shape (rt-read-u64 p (+ (load offset) 16))]
                        (if (or (< size 0) (> size (- (- (len bytes) (load offset)) RT-HEADER-BYTES)))
                            (panic "cu-remap-static-shapes!: object payload exceeds the image") 0)
                        (cu-remap-shape map shape)
                        (set! (mut offset) (+ (load offset) (rt-align8 (+ RT-HEADER-BYTES size))))
                        (set! (mut seen) (+ (load seen) 1)) (continue)))))
          (if (!= (load seen) count) (panic "cu-remap-static-shapes!: object count disagrees with headers") 0)
          (set! (mut offset) entries)
          (loop (if (>= (load offset) (len bytes)) (break 0)
                    (let [size (rt-read-u64 p (load offset))
                          slot (primitive/cast (ptr i64) (primitive/index p (+ (load offset) 16)))]
                      (set! slot (cu-remap-shape map (load slot)))
                      (set! (mut offset) (+ (load offset) (rt-align8 (+ RT-HEADER-BYTES size))))
                      (continue))))
          0))))

(defn cu-shapes-free! [(assembly (ptr CuShapeAssembly))] (-> i64)
  (let [a (alloc/malloc-allocator)]
    (al-for [unit (.units assembly)]
      (let [u unit] (alloc/free [i64] a (.keys u)) (alloc/free [i64] a (.shapes u))))
    (al-free! (mut (.units assembly)))
    (alloc/free [u8] a (.blob assembly))
    (set! assembly (primitive/zeroed CuShapeAssembly))
    0))

(defn cu-load! [(path (slice u8))] (-> i64)
  (do (unimplemented "cu-load!" "S7 — src/codegen/compunit.coil") 0))

(defn cu-resolve-deps! [] (-> i64)
  (do (unimplemented "cu-resolve-deps!" "S7 — src/codegen/compunit.coil") 0))

(defn cu-link! [] (-> i64)
  (do (unimplemented "cu-link!" "S7 — src/codegen/compunit.coil") 0))
