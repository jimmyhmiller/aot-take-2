;; Compilation units: the dependency tree, and linking IR across it.

;;
;; A unit is one source file plus the object file it produces. Units form a tree mirroring the
;; source tree, and a unit's dependencies are the units whose declarations it reads.
;;
;; THE CLOSED WORLD IS ASSEMBLED HERE. Every decision in this compiler that folds a check away
;; rests on seeing every function that can be called; this module is what establishes that the set
;; is complete. A unit that cannot be resolved is a hard error, not a fallback to an open-world
;; assumption — a silent fallback would leave guards folded on evidence that no longer holds.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S7.
(module aot.codegen.compunit)
(import "aot.util.panic" :use *)

(defn cu-load! [(path (slice u8))] (-> i64)
  (do (unimplemented "cu-load!" "S7 — src/codegen/compunit.coil") 0))

(defn cu-resolve-deps! [] (-> i64)
  (do (unimplemented "cu-resolve-deps!" "S7 — src/codegen/compunit.coil") 0))

(defn cu-link! [] (-> i64)
  (do (unimplemented "cu-link!" "S7 — src/codegen/compunit.coil") 0))
