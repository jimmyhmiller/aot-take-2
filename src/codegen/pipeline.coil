;; Source-to-object compilation for the currently admitted closed-world frontend.
;;
;; Final Simple's CodeGen driver runs one-way through parse, pessimistic iteration, optimistic SCCP,
;; type checking, loop-tree construction, serialization, unlink, selection, GCM, local scheduling,
;; iterative allocation, encoding and export. This module owns the same executable ordering. The
;; single-unit frontend does not yet persist serialized IR; that format remains the compilation-unit
;; boundary, while every semantic and machine phase required to execute this unit runs here.
(module aot.codegen.pipeline)
(import "aot.node.versions" :use [versions-finish-opto! versions-prepare-codegen! versions-close-admission!])
(import "aot.util.arena" :use [compiler-allocator compiler-state CompilerStateSlot])
(import "aot.print.text" :use *)
(import "aot.print.dot" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.boot" :use *)
(import "aot.node.node" :use *)
(import "aot.node.property" :use *)
(import "aot.node.imagefacts" :use *)
(import "aot.node.control" :use *)
(import "aot.node.call" :use *)
(import "aot.node.constant" :use [con-make con-int external-make])
(import "aot.node.memory" :use [ALIAS-BULK load-make])
(import "aot.shape" :use [ALIAS-EXCEPTION-VALUE])
(import "aot.node.dynamic" :use [typetest-make box-make])
(import "aot.node.phi" :use [phi-make phi-add-value!])
(import "aot.node.gc" :use [heapstate-make])
(import "aot.node.jsops" :use [jsop-make jsop-add-arg! JS-UNCAUGHT])
(import "aot.rt.abi" :use [RT-HEAP-OFFSET-EXCEPTION-VALUE])
(import "aot.type.type" :use *)
(import "aot.codegen.callabi" :use [callabi-signature callabi-script-sequence!])
(import "aot.codegen.codegen" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.codegen.iterpeeps" :use *)
(import "aot.codegen.opto" :use *)
(import "aot.facts" :use *)
(import "aot.codegen.typecheck" :use *)
(import "aot.codegen.looptree" :use *)
(import "aot.codegen.gcmeta" :use *)
(import "aot.codegen.gcm" :use *)
(import "aot.codegen.listsched" :use *)
(import "aot.codegen.regalloc" :use *)
(import "aot.codegen.encoding" :use *)
(import "aot.codegen.objfile" :use *)
(import "aot.codegen.image" :use [CodeImage image-capture image-add-script! image-bind-script-initializer!
                                 ImageBinding image-abi-script-entry?
                                 image-add-realm-object! IMAGE-REALM-GLOBAL IMAGE-REALM-INTRINSIC
                                 IMAGE-REALM-SYMBOL])
(import "aot.codegen.compunit" :use [CuScriptCallableRoot])
(import "aot.heap" :use [heap-entry-offset heap-global-entry heap-intrinsic-count
                         heap-intrinsic-entry-at heap-intrinsic-name-at
                         heap-well-known-symbol-count heap-well-known-symbol-entry-at
                         heap-well-known-symbol-name-at])
(import "aot.node.cpus.arm64" :use *)
(import "aot.jsl.lower" :use *)
(import "aot.parse.parser" :use *)

;; The rounds of image facts and optimistic optimization. Every graph exists once the world is
;; closed, so the closed-world image facts (aot.node.imagefacts) are computed and the optimistic pass
;; folds under them. The pass then leaves a smaller graph: an accessor arm that was live only because
;; no attribute type had folded yet is gone, and with it the setter call that made every assigned
;; object escape. A rescan of that graph yields facts at least as good, and every fold of the earlier
;; round stays justified: it was proved on facts of a program the round only rewrote equivalently.
;; Each scan and opto solve completes. Repeating them is optional precision work, bounded by
;; PIPELINE-FACTS-ROUNDS. An early exit requires exact snapshot equality; exhausting the budget
;; does not claim convergence of the combined analyses. All published facts remain conservative.
(const PIPELINE-FACTS-ROUNDS 3)

;; Capture only after encoding has fixed the static-image layout. Source-local function ordinals
;; bind to payload offsets in the owned image; no SyntaxFun or heap-entry identity escapes.
(defn pipeline-capture-script-image [] (-> CodeImage)
  (let [(mut image) (image-capture) p (parser-state) (mut script) 0
        (mut offsets) (al-new [i64] (compiler-allocator))]
    (if (= (len (.scripts p)) 0) (panic "pipeline-capture-script-image: no Script compilation") 0)
    (image-add-realm-object! (mut image) IMAGE-REALM-GLOBAL "" (heap-entry-offset (heap-global-entry)) false)
    (let [(mut intrinsic) 0]
      (loop (if (>= (load intrinsic) (heap-intrinsic-count)) (break 0)
                (do (image-add-realm-object! (mut image) IMAGE-REALM-INTRINSIC
                                             (heap-intrinsic-name-at (load intrinsic))
                                             (heap-entry-offset (heap-intrinsic-entry-at (load intrinsic))) false)
                    (set! (mut intrinsic) (+ (load intrinsic) 1)) (continue))))
      ;; Each well-known Symbol this unit allocated, by description, so a later unit's copy binds to
      ;; an earlier unit's and `Symbol.iterator` stays one value across the realm.
      (set! (mut intrinsic) 0)
      (loop (if (>= (load intrinsic) (heap-well-known-symbol-count)) (break 0)
                (do (image-add-realm-object! (mut image) IMAGE-REALM-SYMBOL
                                             (heap-well-known-symbol-name-at (load intrinsic))
                                             (heap-entry-offset (heap-well-known-symbol-entry-at (load intrinsic)))
                                             false)
                    (set! (mut intrinsic) (+ (load intrinsic) 1)) (continue))))
      (set! (mut intrinsic) 0)
      (loop (if (>= (load intrinsic) (len (.funs p))) (break 0)
                (do (if (syntax-intrinsic-fun? (load intrinsic))
                        (let [f (syntax-fun-at (load intrinsic))]
                          (image-add-realm-object! (mut image) IMAGE-REALM-INTRINSIC (.name f)
                                                   (heap-entry-offset (.static-entry f)) true)) 0)
                    (set! (mut intrinsic) (+ (load intrinsic) 1)) (continue)))))
    (loop (if (>= (load script) (len (.scripts p))) (break 0)
              (do
                (al-clear! (mut offsets))
                (al-for [fun (get (.script-functions p) (load script))]
                  (let [f (syntax-fun-at fun)]
                    (if (< (.static-entry f) 0)
                        (panic "pipeline-capture-script-image: declaration has no static function object") 0)
                    (push! [i64] (mut offsets) (heap-entry-offset (.static-entry f)))))
                (image-add-script! (mut image) (syntax-fun-strict (get (.scripts p) (load script)))
                                   (get (.script-declarations p) (load script)) (load offsets))
                (if (.script-unit p)
                    (image-bind-script-initializer! (mut image) (load script)
                                                     (parser-callable-name (get (.scripts p) (load script)))) 0)
                (set! (mut script) (+ (load script) 1)) (continue))))
    (al-free! (mut offsets))
    (load image)))

(defn pipeline-opto-under-facts! [(stop (dyn NodeOps))] (-> i64)
  (do
    (imagefacts-compute-with-boundary! (.external-mutation (parser-state)))
    (parser-prepare-opto! stop)
    (opto-run!)
    (let [(mut round) 1]
      (loop (if (>= (load round) PIPELINE-FACTS-ROUNDS)
                (break 0)
                (let [(mut before) (facts-detach!)]
                  (imagefacts-compute-with-boundary! (.external-mutation (parser-state)))
                  (let [same (facts-current-equal? (mut before))]
                    (facts-release-table! (mut before))
                  (if same
                      (break 0)
                      (do
                        (opto-run!)
                        (set! (mut round) (+ (load round) 1))
                        (continue))))))))
    (if (> (versions-close-admission!) 0) (opto-run!) 0)))
(defn pipeline-selected-start? [(n (dyn NodeOps))] (-> bool)
  (match (mach-of n) (Some [mach] (= (m-ideal-op mach) OP-START)) (None [] false)))

(defn pipeline-find-selected-start [(stop (dyn NodeOps))] (-> (dyn NodeOps))
  (match (n-walk-find stop (primitive/fnptr-of pipeline-selected-start?))
    (Some [start] start)
    (None [] (do (panic "pipeline-find-selected-start: selected Start is unreachable")
                 (unreachable-node)))))

(defn pipeline-compile-macho-mode! [(source (slice u8)) (object-path (slice u8)) (seed i64)
                                    (script-mode bool)] (-> i64)
  (let [(mut sources) (al-new [(slice u8)] (compiler-allocator))]
    (push! [(slice u8)] (mut sources) source)
    (let [answer (pipeline-compile-macho-sources! (load sources) object-path seed script-mode)]
      (al-free! [(slice u8)] (mut sources))
      answer)))

;; A realm: every Script source in evaluation order (docs/DECISIONS.md, realm). Function-entry
;; mode takes exactly one source.
;; The shape of the allocated program, for the budget gates (docs/COMPILE-TIME.md §7).
(defn pipeline-record-stats! [(rounds i64)] (-> i64)
  (let [(mut ci) 0 (mut nodes) 0 (mut blocks) 0 (mut saves) 0 (mut casts) 0]
    (loop (if (>= (load ci) (code-cfg-count))
              (break 0)
              (let [block (code-cfg-at (load ci))]
                (if (code-schedule-ready? block)
                    (let [(mut i) 0]
                      (set! (mut blocks) (+ (load blocks) 1))
                      (loop (if (>= (load i) (code-schedule-count block))
                                (break 0)
                                (let [n (code-schedule-at block (load i))]
                                  (set! (mut nodes) (+ (load nodes) 1))
                                  (match (mach-of n)
                                    (Some [m]
                                          (do
                                            (if (= (m-ideal-op m) OP-MACH-CALLEE-SAVE) (set! (mut saves) (+ (load saves) 1)) 0)
                                            (if (= (m-ideal-op m) OP-CAST) (set! (mut casts) (+ (load casts) 1)) 0)))
                                    (None [] 0))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue)))))
                    0)
                (set! (mut ci) (+ (load ci) 1))
                (continue))))
    (code-set-stats! rounds (load nodes) (load blocks) (load saves) (load casts))))

(defn pipeline-encode-sources! [(sources (ArrayList (slice u8)))
                                (seed i64) (script-mode bool)] (-> i64)
  (let [(mut roots) (al-new [CuScriptCallableRoot] (compiler-allocator))]
    (pipeline-encode-sources-with-roots! sources seed script-mode (load roots))
    (al-free! (mut roots))
    0))

(defn pipeline-encode-sources-with-roots! [(sources (ArrayList (slice u8)))
                                         (seed i64) (script-mode bool)
                                         (roots (ArrayList CuScriptCallableRoot))] (-> i64)
  (pipeline-encode-sources-config! sources seed script-mode roots (> (len roots) 0) false))

;; A retained Script unit: one of a realm's separately compiled Scripts. A unit may consist entirely
;; of top-level setup and function-valued properties, so its external boundary cannot depend on a
;; nonempty list of named declaration roots. It is always a client of the runtime-library provider
;; (`pipeline-shared-jsl-image`), which carries the realm's declared surface and the shared JSL
;; definitions: no unit can see what another unit observes (docs/DECISIONS.md, the provider carries
;; the declared surface).
(defn pipeline-encode-script-unit! [(sources (ArrayList (slice u8))) (seed i64)] (-> i64)
  (let [(mut roots) (al-new [CuScriptCallableRoot] (compiler-allocator))]
    (pipeline-encode-sources-jsl-config! sources seed true (load roots) true true JSL-LINK-IMPORT)
    (al-free! (mut roots)) 0))

;; Compile an empty retained Script realm plus exported JSL boundaries with unknown callers.
;; Its initializer is never executed. Image installation binds its realm references alongside
;; the consuming Scripts, so no test's global objects or closed-world facts enter this artifact.
(defn pipeline-shared-jsl-image [(seed i64)] (-> CodeImage)
  (let [(mut sources) (al-new [(slice u8)] (compiler-allocator))
        (mut roots) (al-new [CuScriptCallableRoot] (compiler-allocator))]
    (push! [(slice u8)] (mut sources) "")
    (pipeline-encode-sources-jsl-config! (load sources) seed true (load roots) true true JSL-LINK-PROVIDER)
    (let [image (pipeline-capture-script-image)]
      (al-free! (mut sources)) (al-free! (mut roots)) image)))

(defn pipeline-encode-sources-config! [(sources (ArrayList (slice u8))) (seed i64) (script-mode bool)
                                      (roots (ArrayList CuScriptCallableRoot))
                                      (external-mutation bool) (script-unit bool)] (-> i64)
  (pipeline-encode-sources-jsl-config! sources seed script-mode roots external-mutation script-unit JSL-LINK-LOCAL))

(defn pipeline-encode-sources-jsl-config! [(sources (ArrayList (slice u8))) (seed i64) (script-mode bool)
                                          (roots (ArrayList CuScriptCallableRoot))
                                          (external-mutation bool) (script-unit bool) (jsl-mode i64)] (-> i64)
  (do
    (boot! seed)
    (code-reset! seed)
    (jsl-set-link-mode! jsl-mode)
    (code-enter-phase! PHASE-PARSE)
    (let [stop (parse-program-sources-config sources script-mode external-mutation script-unit)]
      (if (= jsl-mode JSL-LINK-PROVIDER) (jsl-root-provider! (parser-entry-start)) 0)
      (al-for [root roots]
        (let [r root] (parser-add-callable-root! (.script r) (.ordinal r))))
      (let [start (parser-entry-start)]
        (n-keep! start)
        (code-enter-phase! PHASE-ITER)
        ;; Unlike source Returns, JSL Returns are not initially rooted at Stop. Hold their bodies
        ;; before the pessimistic connected-graph sweep can collect them; Opto later decides which
        ;; closed-world definitions become compilation-unit roots.
        (jsl-prepare-opto!)
        (iter-seed-connected! stop)
        (iter-run!)
        (code-enter-phase! PHASE-OPTO)
        (parser-close-world!)
        (pipeline-opto-under-facts! stop)
        ;; Sweep the complete arena after the last rationed inline. Nodes disconnected by that
        ;; final graph surgery (especially Call/CallEnd shells) may not otherwise receive another
        ;; sparse-worklist visit, but later CFG passes require the live graph to be closed.
        (iter-seed-all!)
        (iter-run!)
        ;; Property accesses that no proof resolved take the generic dispatch exactly once, after
        ;; inlining has had every chance to expose their owners; peephole the expansions.
        (property-expand-all!)
        (iter-seed-all!)
        (iter-run!)
        (parser-finish-opto! stop)
        (jsl-finish-opto! stop)
        (versions-finish-opto! stop)
        (code-enter-phase! PHASE-TYPECHECK)
        (typecheck-run! stop)
        (code-enter-phase! PHASE-LOOPTREE)
        (looptree-build! start stop)
        ;; This compiler currently emits a single compilation unit directly. Keep the same
        ;; explicit serialization boundary as final Simple even though there is no persisted IR
        ;; payload to write between loop-tree construction and target lowering yet.
        (code-enter-phase! PHASE-SERIALIZE)
        (gc-lower-barriers-from! stop)
        (code-enter-phase! PHASE-UNLINK)
        (parser-prepare-codegen! start)
        (jsl-prepare-codegen! start)
        (versions-prepare-codegen! start)
        (call-unlink-all!)
        (n-unkeep! start)
        (pipeline-encode-machine! stop)))))

;; The source frontend and generated Script hosts share the backend phase order from final
;; Simple's CodeGen.driver: selection, global/local scheduling, allocation, encoding, export.
;; Precise GC maps use final instruction offsets between layout and emission.
(defn pipeline-encode-machine! [(stop (dyn NodeOps))] (-> i64)
  (do
        (code-enter-phase! PHASE-SELECT)
        (let [selected-stop (arm64-select-graph stop)
              selected-start (pipeline-find-selected-start selected-stop)]
          (code-set-roots! selected-start selected-stop)
          (code-enter-phase! PHASE-SCHEDULE)
          (gcm-build-cfg!)
          (code-enter-phase! PHASE-LOCALSCHED)
          (sched-run!)
          (code-enter-phase! PHASE-REGALLOC)
          (pipeline-record-stats! (ra-run!))
          (code-enter-phase! PHASE-ENCODING)
          (enc-layout!)
          ;; Return-PC offsets are final only after layout, while the object writer consumes the
          ;; serialized maps during export. Build precise typed maps in that interval; constructing
          ;; them before layout records stale PCs, and after emission omits them from the object.
          (gc-build-stackmaps!)
          (enc-emit!)
          (enc-relocate!)
          (code-enter-phase! PHASE-EXPORT)
          0)))

;; Compile an ordered host against retained initializer bindings, without parsing source or
;; revisiting provider graphs. Bindings remain caller-owned through installation; image capture
;; owns the host's symbol names and bytes. The platform entry reports an uncaught completion by
;; the same runtime path as a source program. This entry returns status zero on normal completion.
(defn pipeline-script-sequence-image [(bindings (ArrayList ImageBinding)) (seed i64)] (-> CodeImage)
  (al-for [binding bindings]
    (let [b binding]
      (if (or (= (len (.name b)) 0) (not (image-abi-script-entry? (.abi b))))
          (panic "pipeline-script-sequence-image: expected named Script initializer binding") 0)))
  (boot! seed) (code-reset! seed)
  (code-enter-phase! PHASE-PARSE)
  (let [start (start-make (ty-int-bot)) stop (stop-make)
        main (fun-make start (ty-tuple-of2 (ty-dyn TAG-COMPLETION) (ty-int-bot)) "main")
        memory (con-make (ty-mem ALIAS-BULK TY-BOT))
        (mut targets) (al-new [(dyn NodeOps)] (compiler-allocator))
        (mut index) 1]
    (al-for [binding bindings]
      (let [b binding]
        (push! [(dyn NodeOps)] (mut targets)
          (external-make (arena-declare-external! (load index) (.name b) (callabi-signature))))
        (set! (mut index) (+ (load index) 1))))
    (let [sequence (callabi-script-sequence! main memory (load targets))
          arms (if-arms! (if-make (.control sequence) (typetest-make (.completion sequence) TAG-EXCEPTION)))
          thrown (load-make (arms-true arms) (.memory sequence) (heapstate-make)
                           (con-int RT-HEAP-OFFSET-EXCEPTION-VALUE) ALIAS-EXCEPTION-VALUE (ty-dyn TAG-ANY))
          report (jsop-make (arms-true arms) (.memory sequence) JS-UNCAUGHT)
          exit (region-make)
          exit-memory (phi-make exit (ty-mem ALIAS-BULK TY-BOT) "host.memory")
          status (phi-make exit (ty-dyn TAG-INT) "host.status")]
      (jsop-add-arg! report thrown)
      (region-add-path! exit (arms-true arms))
      (phi-add-value! exit-memory (proj-make report 1 "host.uncaught.memory"))
      (phi-add-value! status (box-make (con-int 3)))
      (region-add-path! exit (arms-false arms))
      (phi-add-value! exit-memory (.memory sequence))
      (phi-add-value! status (box-make (con-int 0)))
    (let [ret (return-make exit (Some exit-memory) status
                           (None [(dyn NodeOps)]) (Some main))]
      (fun-set-ret! main ret) (stop-add-return! stop ret)
      (n-keep! start)
      (code-enter-phase! PHASE-ITER) (iter-seed-connected! stop) (iter-run!)
      (code-enter-phase! PHASE-OPTO) (opto-run!)
      (code-enter-phase! PHASE-TYPECHECK) (typecheck-run! stop)
      (code-enter-phase! PHASE-LOOPTREE) (looptree-build! start stop)
      (code-enter-phase! PHASE-SERIALIZE) (gc-lower-barriers-from! stop)
      (code-enter-phase! PHASE-UNLINK) (fun-prepare-codegen! main start) (call-unlink-all!)
      (n-unkeep! start)
      (pipeline-encode-machine! stop)
      (al-free! (mut targets))
      (image-capture)))))

(defn pipeline-compile-macho-sources! [(sources (ArrayList (slice u8))) (object-path (slice u8))
                                       (seed i64) (script-mode bool)] (-> i64)
  (pipeline-encode-sources! sources seed script-mode)
  (let [answer (macho-write object-path)]
    (code-time-finish!)
    answer))

;; The phases `aot dump` can stop after. Selection and later phases dump the selected graph.
(defn pipeline-dump-phase-known? [(phase (slice u8))] (-> bool)
  (or (= phase "parse") (= phase "iter") (= phase "opto") (= phase "typecheck")
      (= phase "select") (= phase "gcm") (= phase "sched") (= phase "regalloc")))

(defn pipeline--dump-text [(root (dyn NodeOps)) (dot bool)] (-> (slice u8))
  (if dot (dot-graph root) (graph-print root)))

;; Run the compilation pipeline up to and including `phase`, then render the graph as text (one
;; node per line) or Graphviz. The same phase sequence as `pipeline-compile-macho-mode!`, stopped
;; early; an unknown phase name is a hard error listing the known ones.
(defn pipeline-dump-mode! [(source (slice u8)) (phase (slice u8)) (seed i64) (script-mode bool) (dot bool)]
  (-> (slice u8))
  (let [(mut sources) (al-new [(slice u8)] (compiler-allocator))]
    (push! [(slice u8)] (mut sources) source)
    (let [answer (pipeline-dump-sources! (load sources) phase seed script-mode dot)]
      (al-free! [(slice u8)] (mut sources))
      answer)))

(defn pipeline-dump-sources! [(sources (ArrayList (slice u8))) (phase (slice u8)) (seed i64) (script-mode bool) (dot bool)]
                          (-> (slice u8))
  (do
    (if (not (pipeline-dump-phase-known? phase))
        (panic "pipeline-dump-mode!: unknown phase; known: parse iter opto typecheck select gcm sched regalloc")
        0)
    (boot! seed)
    (code-reset! seed)
    (code-enter-phase! PHASE-PARSE)
    (let [stop (parse-program-sources sources script-mode)]
      (if (= phase "parse")
          (pipeline--dump-text stop dot)
          (let [start (parser-entry-start)]
            (n-keep! start)
            (code-enter-phase! PHASE-ITER)
            (jsl-prepare-opto!)
            (iter-seed-connected! stop)
            (iter-run!)
            (if (= phase "iter")
                (pipeline--dump-text stop dot)
                (do
                  (code-enter-phase! PHASE-OPTO)
                  (parser-close-world!)
                  (pipeline-opto-under-facts! stop)
                  (iter-seed-all!)
                  (iter-run!)
                  (property-expand-all!)
                  (iter-seed-all!)
                  (iter-run!)
                  (parser-finish-opto! stop)
                  (jsl-finish-opto! stop)
                  (versions-finish-opto! stop)
                  (if (= phase "opto")
                      (pipeline--dump-text stop dot)
                      (do
                        (code-enter-phase! PHASE-TYPECHECK)
                        (typecheck-run! stop)
                        (if (= phase "typecheck")
                            (pipeline--dump-text stop dot)
                            (do
                              (code-enter-phase! PHASE-LOOPTREE)
                              (looptree-build! start stop)
                              (code-enter-phase! PHASE-SERIALIZE)
                              (gc-lower-barriers-from! stop)
                              (code-enter-phase! PHASE-UNLINK)
                              (parser-prepare-codegen! start)
                              (jsl-prepare-codegen! start)
                              (versions-prepare-codegen! start)
                              (call-unlink-all!)
                              (n-unkeep! start)
                              (code-enter-phase! PHASE-SELECT)
                              (let [selected-stop (arm64-select-graph stop)
                                    selected-start (pipeline-find-selected-start selected-stop)]
                                (code-set-roots! selected-start selected-stop)
                                (if (= phase "select")
                                    (pipeline--dump-text selected-stop dot)
                                    (do
                                      (code-enter-phase! PHASE-SCHEDULE)
                                      (gcm-build-cfg!)
                                      (if (= phase "gcm")
                                          (pipeline--dump-text selected-stop dot)
                                          (do
                                            (code-enter-phase! PHASE-LOCALSCHED)
                                            (sched-run!)
                                            (if (= phase "sched")
                                                (pipeline--dump-text selected-stop dot)
                                                (do
                                                  (code-enter-phase! PHASE-REGALLOC)
                                                  (ra-run!)
                                                  (pipeline--dump-text selected-stop dot)))))))))))))))))))

(defn pipeline-compile-macho! [(source (slice u8)) (object-path (slice u8)) (seed i64)] (-> i64)
  (pipeline-compile-macho-mode! source object-path seed false))

(defn pipeline-compile-script-macho! [(source (slice u8)) (object-path (slice u8)) (seed i64)] (-> i64)
  (pipeline-compile-macho-mode! source object-path seed true))

(defn pipeline-compile-link-run-mode! [(source (slice u8))
                                  (object-path (slice u8))
                                  (executable-path (slice u8))
                                  (seed i64) (script-mode bool)] (-> i64)
  (let [(mut sources) (al-new [(slice u8)] (compiler-allocator))]
    (push! [(slice u8)] (mut sources) source)
    (let [answer (pipeline-compile-link-run-sources! (load sources) object-path executable-path seed script-mode)]
      (al-free! [(slice u8)] (mut sources))
      answer)))

(defn pipeline-compile-link-run-sources! [(sources (ArrayList (slice u8)))
                                          (object-path (slice u8))
                                          (executable-path (slice u8))
                                          (seed i64) (script-mode bool)] (-> i64)
  (do
    (pipeline-compile-macho-sources! sources object-path seed script-mode)
    (if (!= (macho-link-runtime! object-path "build/release/aot-runtime.o" executable-path) 0)
        (panic "pipeline-compile-link-run!: linker failed")
        0)
    (run-executable! executable-path)))

(defn pipeline-compile-link-run! [(source (slice u8)) (object-path (slice u8))
                                  (executable-path (slice u8)) (seed i64)] (-> i64)
  (pipeline-compile-link-run-mode! source object-path executable-path seed false))

(defn pipeline-compile-script-link-run! [(source (slice u8)) (object-path (slice u8))
                                         (executable-path (slice u8)) (seed i64)] (-> i64)
  (pipeline-compile-link-run-mode! source object-path executable-path seed true))
