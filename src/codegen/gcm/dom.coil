;; The dominator index GCM queries: preorder intervals over the block tree, and the LCA of two blocks.

(module aot.codegen.gcm.dom)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.codegen.codegen" :use *)

;; Final Simple's late scheduler uses a parallel dominator-chain walk for LCA. Here the
;; late-pass CFG is fixed: index its ordinary idom answers with binary ancestors once, then
;; answer in O(log CFG). Outside that pass or after control edits, use the ordinary walk.
;; The index never participates in computing its own region dominators.
(defstruct GcmDominatorIndex
  [(nodes (ArrayList i64))
   (slots (ArrayList i64))
   (parents (ArrayList i64))
   (depths (ArrayList i64))
   (jumps (ArrayList i64))
   (levels i64)
   (active bool)
   (ready bool)
   (version i64)
   (control-version i64)
   (queries i64)
   (steps i64)])

(defn gcm-dom-index [] (-> (ptr GcmDominatorIndex))
  (compiler-state [GcmDominatorIndex]
                  (primitive/alloc-static CompilerStateSlot)))

(defn gcm-dom-add! [(index (ptr GcmDominatorIndex)) (nid i64)] (-> i64)
  (let [old (get (.slots index) nid)]
    (if (!= old 0)
        old
        (let [slot (len (.nodes index))]
          (push! [i64] (mut (.nodes index)) nid)
          (push! [i64] (mut (.parents index)) 0)
          (push! [i64] (mut (.depths index)) 0)
          (set! (mut (.slots index)) nid slot)
          slot))))

(defn gcm-dom-begin! [] (-> i64)
  (let [index (gcm-dom-index)
        a (compiler-allocator)
        (mut path) (al-new [i64] a)
        (mut i) 0]
    (set! (.active index) false)
    (if (.ready index)
        (do
          (al-free! (mut (.nodes index)))
          (al-free! (mut (.slots index)))
          (al-free! (mut (.parents index)))
          (al-free! (mut (.depths index)))
          (al-free! (mut (.jumps index)))
          0)
        0)
    (set! (.nodes index) (al-new [i64] a))
    (set! (.slots index) (al-new [i64] a))
    (set! (.parents index) (al-new [i64] a))
    (set! (.depths index) (al-new [i64] a))
    (set! (.jumps index) (al-new [i64] a))
    (push! [i64] (mut (.nodes index)) 0)
    (push! [i64] (mut (.parents index)) 0)
    (push! [i64] (mut (.depths index)) 0)
    (loop (if (> (load i) (arena-node-count))
              (break 0)
              (do
                (push! [i64] (mut (.slots index)) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) (code-cfg-count))
              (break 0)
              (do
                (gcm-dom-add! index (n-nid (code-cfg-at (load i))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; Include ancestors even if the supplied CFG table contains only a subset.
    (set! (mut i) 1)
    (loop (if (>= (load i) (len (.nodes index)))
              (break 0)
              (do
                (match (arena-node (get (.nodes index) (load i)))
                  (Some [n]
                        (match (cfg-idom-of n)
                          (Some [parent]
                                (let [parent-slot
                                        (gcm-dom-add! index (n-nid parent))]
                                  (set! (mut (.parents index))
                                        (load i)
                                        parent-slot)))
                          (None [] 0)))
                  (None [] (broken "gcm-dom-begin!: missing control node")))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; Exact tree depths, not conservative idepth values retained across peepholes.
    (set! (mut i) 1)
    (loop (if (>= (load i) (len (.nodes index)))
              (break 0)
              (let [(mut cur) (load i)]
                (al-clear! (mut path))
                (loop (if (or (= (load cur) 0)
                              (!= (get (.depths index) (load cur)) 0))
                          (break 0)
                          (do
                            (push! [i64] (mut path) (load cur))
                            (if (> (len (load path)) (len (.nodes index)))
                                (broken "gcm-dom-begin!: cyclic dominator chain")
                                0)
                            (set! (mut cur) (get (.parents index) (load cur)))
                            (continue))))
                (loop (match (pop! [i64] (mut path))
                        (None [] (break 0))
                        (Some [slot]
                              (do
                                (set! (mut (.depths index))
                                      slot
                                      (+ 1
                                         (get (.depths index)
                                              (get (.parents index) slot))))
                                (continue)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [count (len (.nodes index))
          (mut width) 1
          (mut level) 0]
      (loop (if (>= (load width) count)
                (break 0)
                (do
                  (set! (mut i) 0)
                  (loop (if (>= (load i) count)
                            (break 0)
                            (do
                              (push! [i64]
                                     (mut (.jumps index))
                                     (if (= (load level) 0)
                                         (get (.parents index) (load i))
                                         (let [row (* (- (load level) 1) count)
                                               halfway
                                                 (get (.jumps index)
                                                      (+ row (load i)))]
                                           (get (.jumps index) (+ row halfway)))))
                              (set! (mut i) (+ (load i) 1))
                              (continue))))
                  (set! (mut level) (+ (load level) 1))
                  (set! (mut width) (* (load width) 2))
                  (continue))))
      (set! (.levels index) (load level)))
    (al-free! (mut path))
    (set! (.queries index) 0)
    (set! (.steps index) 0)
    (set! (.version index) (cfg-edit-version))
    (set! (.control-version index) (cfg-version))
    (set! (.active index) true)
    (set! (.ready index) true)
    0))

(defn gcm-idom-lca [(a (dyn NodeOps)) (b (Option (dyn NodeOps)))] (-> (Option (dyn NodeOps)))
  (let [index (gcm-dom-index)]
    (if (or (not (.active index))
            (!= (.version index) (cfg-edit-version))
            (!= (.control-version index) (cfg-version)))
        (idom-lca-nodes a b)
        (match b
          (None [] (Some a))
          (Some [other]
                (let [left
                        (if (< (n-nid a) (len (.slots index)))
                            (get (.slots index) (n-nid a))
                            0)
                      right
                        (if (< (n-nid other) (len (.slots index)))
                            (get (.slots index) (n-nid other))
                            0)]
                  (if (or (= left 0) (= right 0))
                      (idom-lca-nodes a b)
                      (let [ld (get (.depths index) left)
                            rd (get (.depths index) right)
                            (mut l) (if (>= ld rd) left right)
                            (mut r) (if (>= ld rd) right left)
                            difference (if (>= ld rd) (- ld rd) (- rd ld))
                            count (len (.nodes index))
                            (mut level) 0
                            (mut steps) 0]
                        (set! (.queries index) (+ (.queries index) 1))
                        (loop (if (>= (load level) (.levels index))
                                  (break 0)
                                  (do
                                    (if (!= (primitive/iand difference
                                                            (primitive/ishl 1
                                                                            (load level)))
                                            0)
                                        (set! (mut l)
                                              (get (.jumps index)
                                                   (+ (* (load level) count)
                                                      (load l))))
                                        0)
                                    (set! (mut steps) (+ (load steps) 1))
                                    (set! (mut level) (+ (load level) 1))
                                    (continue))))
                        (if (!= (load l) (load r))
                            (do
                              (set! (mut level) (- (.levels index) 1))
                              (loop (if (< (load level) 0)
                                        (break 0)
                                        (let [row (* (load level) count)
                                              lp
                                                (get (.jumps index)
                                                     (+ row (load l)))
                                              rp
                                                (get (.jumps index)
                                                     (+ row (load r)))]
                                          (if (!= lp rp)
                                              (do
                                                (set! (mut l) lp)
                                                (set! (mut r) rp))
                                              0)
                                          (set! (mut steps) (+ (load steps) 1))
                                          (set! (mut level) (- (load level) 1))
                                          (continue))))
                              (set! (mut l) (get (.parents index) (load l))))
                            0)
                        (set! (.steps index) (+ (.steps index) (load steps)))
                        (if (= (load l) 0)
                            (None [(dyn NodeOps)])
                            (arena-node (get (.nodes index) (load l))))))))))))
