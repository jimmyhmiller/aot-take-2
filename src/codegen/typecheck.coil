;; The last check for bad programs, after the optimiser has learned everything it can.

;;
;; Running this AFTER optimisation rather than before is deliberate: an error that the optimiser
;; can prove unreachable is not an error, and an annotation the optimiser discharged needs no
;; report. What remains here is what is genuinely wrong on a reachable path.
;;
(module aot.codegen.typecheck)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.call" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.verify" :use *)

(defn typecheck-run! [] (-> i64)
  (do
    (if (not (live-unboxes-proven?))
        (panic "typecheck-run!: a reachable Unbox lacks representation proof")
        0)
    (let [(mut nid) 1]
      (loop (if (> (load nid) (arena-node-count))
                (break 0)
                (do
                  (match (arena-node (load nid))
                    (Some [n]
                          (if (and (= (n-op n) OP-CALL)
                                   (and (not (n-dead? n))
                                        (match (n-in n CALL-MEM)
                                          (Some [_] false)
                                          (None [] true))))
                              (panic-i "typecheck-run!: reachable Call has null memory" (n-nid n))
                              0))
                    (None [] 0))
                  (set! (mut nid) (+ (load nid) 1))
                  (continue)))))
    (let [error (verify-all)]
      (if (!= error VERR-OK)
          (panic-i "typecheck-run!: graph verification failed" error)
          0))))
