;; The last check for bad programs, after the optimiser has learned everything it can.
;;
;; Final Simple runs this phase after Opto and, in order:
;;
;;   1. walks only the graph reachable from Stop and collects every node whose `err()` is non-null;
;;   2. prefers an error whose inputs are not BOTTOM, avoiding a secondary diagnostic from a
;;      poisoned input;
;;   3. among independent memory/CFG errors, prefers earlier source/control order;
;;   4. reports any unresolved nominal type only after node errors.
;;
;; Running AFTER optimisation is load-bearing: dead control is already gone, so an error the
;; optimiser proved unreachable is not an error.
;;
;; This compiler's admitted frontend rejects source-shape/name errors while parsing and does not
;; yet expose Simple's per-node source-location `err()` hook. The remaining post-Opto obligations
;; are therefore explicit and fail closed here: every reachable dynamic Unbox must carry a proven
;; representation, every reachable Call must have memory, and the complete graph must satisfy the
;; verifier. When per-node semantic diagnostics are added, they belong in a Stop-reachable walk
;; with Simple's poison/source/control ordering above, not in the all-arena invariant checks.
;;
(module aot.codegen.typecheck)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.call" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.verify" :use *)

(defn typecheck-reachable! [(stop (dyn NodeOps))] (-> i64)
  (let [a (alloc/malloc-allocator)
        (mut seen) (al-new [bool] a)
        (mut work) (al-new [i64] a)
        limit (+ (arena-node-count) 1)
        (mut i) 0]
    (loop (if (>= (load i) limit)
              (break 0)
              (do
                (push! [bool] (mut seen) false)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (push! [i64] (mut work) (n-nid stop))
    (loop (match (pop! [i64] (mut work))
            (None [] (break 0))
            (Some [nid]
                  (if (get (load seen) nid)
                      (continue)
                      (do
                        (set! (mut seen) nid true)
                        (match (arena-node nid)
                          (Some [n]
                                (do
                                  (if (and (= (n-op n) OP-UNBOX) (not (unbox-proven? n)))
                                      (panic-i "typecheck-run!: reachable Unbox lacks representation proof"
                                               (n-nid n))
                                      0)
                                  (if (and (= (n-op n) OP-CALL)
                                           (match (n-in n CALL-MEM)
                                             (Some [_] false)
                                             (None [] true)))
                                      (panic-i "typecheck-run!: reachable Call has null memory"
                                               (n-nid n))
                                      0)
                                  (let [(mut input) 0]
                                    (loop (if (>= (load input) (n-nins n))
                                              (break 0)
                                              (do
                                                (match (n-in n (load input))
                                                  (Some [def]
                                                        (if (get (load seen) (n-nid def))
                                                            0
                                                            (push! [i64]
                                                                   (mut work)
                                                                   (n-nid def))))
                                                  (None [] 0))
                                                (set! (mut input) (+ (load input) 1))
                                                (continue)))))))
                          (None [] (panic-i "typecheck-reachable!: missing arena node" nid)))
                        (continue))))))
    0))

(defn typecheck-run! [(stop (dyn NodeOps))] (-> i64)
  (do
    ;; Semantic obligations follow the same Stop input closure as final Simple's `Stop.walk`.
    ;; Structural verification remains whole-arena so stale asymmetric edges cannot hide outside
    ;; the compiled program.
    (typecheck-reachable! stop)
    (let [error (verify-all)]
      (if (!= error VERR-OK)
          (panic-i "typecheck-run!: graph verification failed" error)
          0))))
