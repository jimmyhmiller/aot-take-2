;; Retained Script compilation cache. Simple's Encoding separates owned bytes

;; and relocations from installed addresses; CodeImage captures that boundary here. This cache
;; stores those artifacts, never graph nodes or installed realm state. The immutable JSL provider
;; additionally has a cross-process graph/image artifact in `aot.codegen.providercache`; ordinary
;; Script and host entries remain process-local. Simple has no equivalent JavaScript source/JSL
;; cache or lease protocol.
;;
;; Exact ordered source bytes, worklist seed, and the complete production JSL snapshot form the
;; in-memory key. The provider's disk key also hashes the exact running executable, which fixes
;; compiler/runtime/target versions. External-mutation Script
;; compilation is the only mode admitted. Handles are monotonic, not reusable slot indices.
;; Acquisition invalidates compiler scratch, even on a hit; borrowed input is copied first.
;; A bounded LRU evicts only unleased, uninstalled artifacts. Cache teardown validates the whole
;; set before freeing anything. The caller must release each acquisition after its last use.
(module aot.codegen.sourcecache)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "coil.str" :use [sb-new sb-push-str! sb-push-i64! sb-str sb-free!])
(import "aot.util.panic" :use [panic])
(import "aot.util.arena" :use [compiler-session-reset! compiler-region])
(import "aot.codegen.image"
        :use
        [CodeImage
         InstalledImage
         ImageBinding
         image-copy
         image-free!
         image-install
         image-install-bound
         image-uninstall!
         image-script-initializer-binding
         image-run-shared-program!
         image-run!
         image-abi-script-entry?
         image-export-binding
         IMAGE-SYM-IMPORT])
(import "aot.codegen.pipeline"
        :use
        [pipeline-encode-script-unit!
         pipeline-capture-script-image
         pipeline-script-sequence-image
         pipeline-shared-jsl-artifact
         ProviderArtifact])
(import "aot.codegen.providercache"
        :use
        [ProviderCacheLock
         provider-cache-load
         provider-cache-publish!
         provider-cache-lock!
         provider-cache-unlock!])
(import "aot.codegen.serialize" :use [ser-read-graph])
(import "aot.jsl.reader"
        :use
        [jsl-library jsl-load-library! JSL-COMPILER-INDEX])

(defstruct CachedScript
  [(image CodeImage)
   (helpers (ptr CachedJslLibrary))
   (sources (ArrayList (slice u8)))
   (library (ArrayList (slice u8)))
   (seed i64)
   (handle i64)
   (used i64)
   (leases i64)])

(defstruct SourceCache
  [(entries (ArrayList (ptr CachedScript)))
   (libraries (ArrayList (ptr CachedJslLibrary)))
   (library-hits i64)
   (library-misses i64)
   (provider-disk-hits i64)
   (provider-disk-misses i64)
   (hosts (ArrayList (ptr CachedScriptHost)))
   (capacity i64)
   (clock i64)
   (hits i64)
   (misses i64)
   (evictions i64)
   (host-hits i64)
   (host-misses i64)
   (host-evictions i64)
   (scratch-peak i64)])

(defstruct CachedScriptHost
  [(image CodeImage) (count i64) (seed i64) (used i64)])

(defstruct CachedJslLibrary
  [(image CodeImage)
   (graph (slice u8))
   (library (ArrayList (slice u8)))
   (seed i64)
   (users i64)])

;; Process-wide identities prevent a handle from one cache accidentally naming another's slot.
(defn source-cache-next-handle! [] (-> i64)
  (let [next (primitive/alloc-static i64)]
    (if (= (load next) 9223372036854775807)
        (panic "source-cache-next-handle!: handle space exhausted")
        0)
    (set! next (+ (load next) 1))
    (load next)))

(defn source-cache-new [(capacity i64)] (-> SourceCache)
  (if (<= capacity 0) (panic "source-cache-new: capacity must be positive") 0)
  (SourceCache
    :entries (al-new [(ptr CachedScript)] (alloc/malloc-allocator))
    :libraries (al-new [(ptr CachedJslLibrary)] (alloc/malloc-allocator))
    :library-hits 0
    :library-misses 0
    :provider-disk-hits 0
    :provider-disk-misses 0
    :hosts (al-new [(ptr CachedScriptHost)] (alloc/malloc-allocator))
    :capacity capacity
    :clock 0
    :hits 0
    :misses 0
    :evictions 0
    :host-hits 0
    :host-misses 0
    :host-evictions 0
    :scratch-peak 0))

(defn source-cache-provider-artifact-free! [(artifact (ptr ProviderArtifact))] (-> i64)
  (do
    (image-free! (field artifact image))
    (alloc/free [u8] (alloc/malloc-allocator) (.graph artifact))
    0))

(defn source-cache-provider-trace [(event (slice u8))] (-> i64)
  (if (= (primitive/cast i64 (os/getenv c"AOT_PROVIDER_TRACE")) 0)
      0
      (do (println "aot provider cache: {s}" event) 0)))

(defn source-cache-provider-disk-artifact [(cache (ptr SourceCache))
                                           (key (ArrayList (slice u8)))
                                           (seed i64)] (-> (Option ProviderArtifact))
  (match (provider-cache-load key seed)
    (Some [loaded]
      (let [artifact (primitive/alloc-stack ProviderArtifact)]
        (set! artifact loaded)
        ;; A container and native image can both be intact while the graph format is stale. Decode
        ;; it in the disposable compiler generation before admitting the disk hit.
        (match (ser-read-graph (.graph artifact))
          (Some [_]
            (do
              (set! (.provider-disk-hits cache) (+ (.provider-disk-hits cache) 1))
              (source-cache-provider-trace "hit")
              (compiler-session-reset!)
              (Some (load artifact))))
          (None []
            (do
              (source-cache-provider-artifact-free! artifact)
              (compiler-session-reset!)
              (None [ProviderArtifact]))))))
    (None [] (None [ProviderArtifact]))))

(defn source-cache-provider-build [(key (ArrayList (slice u8)))
                                   (seed i64)] (-> ProviderArtifact)
  (let [built (pipeline-shared-jsl-artifact seed)
        owned (primitive/alloc-stack ProviderArtifact)]
    (set! owned built)
    (provider-cache-publish! key seed owned)
    built))

(defn source-cache-provider-artifact [(cache (ptr SourceCache))
                                      (key (ArrayList (slice u8)))
                                      (seed i64)] (-> ProviderArtifact)
  (compiler-session-reset!)
  (match (source-cache-provider-disk-artifact cache key seed)
    (Some [loaded] loaded)
    (None []
      (do
        (set! (.provider-disk-misses cache) (+ (.provider-disk-misses cache) 1))
        (source-cache-provider-trace "miss")
        (match (provider-cache-lock! key seed)
          (None [] (source-cache-provider-build key seed))
          (Some [acquired]
            (let [lock (primitive/alloc-stack ProviderCacheLock)]
              (set! lock acquired)
              ;; A contender may have published while flock blocked. Recheck under the lock.
              (match (source-cache-provider-disk-artifact cache key seed)
                (Some [loaded]
                  (do (provider-cache-unlock! lock) loaded))
                (None []
                  (let [built (source-cache-provider-build key seed)]
                    (provider-cache-unlock! lock)
                    built))))))))))

;; Artifact identity is exact JSL bytes plus seed; compiler, runtime and target ABI/layout are
;; fixed by this running executable. Keep at most capacity+1 snapshots: one spare allows a miss
;; to replace a victim Script without releasing an artifact while its entry still owns it.
(defn source-cache-library! [(cache (ptr SourceCache))
                             (key (ArrayList (slice u8)))
                             (seed i64)] (-> (ptr CachedJslLibrary))
  (let [(mut found) (primitive/cast (ptr CachedJslLibrary) 0)
        (mut victim) -1
        (mut i) 0]
    (al-for [library (.libraries cache)]
            (if (and (= (.seed library) seed)
                     (source-cache-strings-equal? (.library library) key))
                (set! (mut found) library)
                0)
            (if (and (= (.users library) 0)
                     (= (.installations (.image library)) 0))
                (set! (mut victim) (load i))
                0)
            (set! (mut i) (+ (load i) 1)))
    (if (!= (primitive/cast i64 (load found)) 0)
        (do
          (set! (.library-hits cache) (+ (.library-hits cache) 1))
          (load found))
        (let [a (alloc/malloc-allocator)
              library (alloc/unwrap-ptr (alloc/create [CachedJslLibrary] a))
              owned (source-cache-copy-strings key)]
          (if (and (>= (len (.libraries cache)) (+ (.capacity cache) 1))
                   (< (load victim) 0))
              (panic "source-cache-library!: all library snapshots are in use")
              0)
          (let [artifact (primitive/alloc-stack ProviderArtifact)]
            (set! artifact (source-cache-provider-artifact cache key seed))
            (set! library
                  (CachedJslLibrary
                    :image (.image artifact)
                    :graph (.graph artifact)
                    :library owned
                    :seed seed
                    :users 0)))
          (let [(mut actual) (source-cache-library-key)]
            (if (not (source-cache-strings-equal? owned (load actual)))
                (panic "source-cache-library!: JSL changed during provider compilation")
                0)
            (source-cache-free-strings! (mut actual)))
          (source-cache-record-scratch! cache)
          (compiler-session-reset!)
          (if (>= (len (.libraries cache)) (+ (.capacity cache) 1))
              (let [old (get (.libraries cache) (load victim))]
                (image-free! (field old image))
                (alloc/free [u8] (alloc/malloc-allocator) (.graph old))
                (source-cache-free-strings! (field old library))
                (alloc/destroy [CachedJslLibrary] a old)
                (set! (mut (.libraries cache)) (load victim) library))
              (push! [(ptr CachedJslLibrary)] (mut (.libraries cache)) library))
          (set! (.library-misses cache) (+ (.library-misses cache) 1))
          library))))

(defn source-cache-record-scratch! [(cache (ptr SourceCache))] (-> i64)
  (let [reserved (.reserved (compiler-region))]
    (if (> reserved (.scratch-peak cache))
        (set! (.scratch-peak cache) reserved)
        0)))

(defn source-cache-copy-strings [(strings (ArrayList (slice u8)))] (-> (ArrayList (slice u8)))
  (let [(mut copies) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (al-for [s strings] (push! [(slice u8)] (mut copies) (image-copy s)))
    (load copies)))

(defn source-cache-free-strings! [(strings (ptr (ArrayList (slice u8))))] (-> i64)
  (al-for [s (load strings)] (alloc/free [u8] (alloc/malloc-allocator) s))
  (al-free! strings)
  0)

(defn source-cache-strings-equal? [(left (ArrayList (slice u8)))
                                   (right (ArrayList (slice u8)))] (-> bool)
  (let [(mut i) 0
        (mut same) (= (len left) (len right))]
    (loop (if (or (not (load same)) (>= (load i) (len left)))
              (break (load same))
              (do
                (if (!= (get left (load i)) (get right (load i)))
                    (set! (mut same) false)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))))

;; Length-delimited list elements preserve both source boundaries and dependency order.
;; These owned bytes remain valid after jsl-library-clear! or another library load.
(defn source-cache-library-key [] (-> (ArrayList (slice u8)))
  (let [library (jsl-library)
        (mut key) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (if (not (.loaded library))
        (panic "source-cache-library-key: no loaded library")
        0)
    (push! [(slice u8)] (mut key) (image-copy (.path library)))
    (push! [(slice u8)] (mut key) (image-copy (.index library)))
    (al-for [unit (.units library)]
            (let [u unit]
              (push! [(slice u8)] (mut key) (image-copy (.path u)))
              (push! [(slice u8)] (mut key) (image-copy (.source u)))))
    (load key)))

(defn source-cache-entry! [(cache (ptr SourceCache)) (handle i64)] (-> (ptr CachedScript))
  (if (<= (.capacity cache) 0) (panic "source-cache-entry!: closed cache") 0)
  (let [(mut found) (primitive/cast (ptr CachedScript) 0)]
    (al-for [entry (.entries cache)]
            (if (= (.handle entry) handle) (set! (mut found) entry) 0))
    (if (= (primitive/cast i64 (load found)) 0)
        (panic "source-cache-entry!: stale or foreign handle")
        0)
    (load found)))

(defn source-cache-image! [(cache (ptr SourceCache)) (handle i64)] (-> (ptr CodeImage))
  (let [entry (source-cache-entry! cache handle)]
    (if (<= (.leases entry) 0)
        (panic "source-cache-image!: handle has no lease")
        0)
    (field entry image)))

(defn source-cache-release! [(cache (ptr SourceCache)) (handle i64)] (-> i64)
  (let [entry (source-cache-entry! cache handle)]
    (if (<= (.leases entry) 0)
        (panic "source-cache-release!: handle has no lease")
        0)
    (set! (.leases entry) (- (.leases entry) 1))
    0))

(defn source-cache-retain! [(cache (ptr SourceCache)) (handle i64)] (-> i64)
  (let [entry (source-cache-entry! cache handle)]
    (if (or (<= (.leases entry) 0) (= (.leases entry) 9223372036854775807))
        (panic "source-cache-retain!: absent or exhausted lease")
        0)
    (set! (.leases entry) (+ (.leases entry) 1))
    0))

;; Selection order is execution order, independently of provider installation order. Repeated
;; selections reuse one installation and execute the initializer again. Programs retain their
;; own lease per distinct provider, so callers can release their acquisitions after construction.
(defstruct SourceScriptSelection [(handle i64) (script i64)])

(defstruct SourceProgram
  [(cache (ptr SourceCache))
   (handles (ArrayList i64))
   (helpers (ptr InstalledImage))
   (providers (ArrayList (ptr InstalledImage)))
   (host (ptr CodeImage))
   (installed InstalledImage)])

;; Hosts contain ordinal imports only, never provider addresses. Their shape is determined by
;; selection count and seed, independently of source keys. Installation supplies fresh bindings
;; and pins the actual providers. Keep a separate bounded LRU; installed hosts cannot be evicted.
;; This helper consumes only the canonical script::N bindings built by source-program-new.
(defn source-cache-host! [(cache (ptr SourceCache))
                          (bindings (ArrayList ImageBinding))
                          (seed i64)] (-> (ptr CodeImage))
  (if (<= (.capacity cache) 0) (panic "source-cache-host!: closed cache") 0)
  (let [(mut ordinal) 0]
    (al-for [binding bindings]
            (let [b binding
                  (mut expected) (sb-new (alloc/malloc-allocator))]
              (sb-push-str! (mut expected) "script::")
              (sb-push-i64! (mut expected) (load ordinal))
              (if (or (!= (.name b) (sb-str (load expected)))
                      (not (image-abi-script-entry? (.abi b))))
                  (panic "source-cache-host!: expected canonical Script initializer binding")
                  0)
              (sb-free! (mut expected))
              (set! (mut ordinal) (+ (load ordinal) 1)))))
  (if (= (.clock cache) 9223372036854775807)
      (panic "source-cache-host!: clock exhausted")
      0)
  (set! (.clock cache) (+ (.clock cache) 1))
  (let [(mut found) (primitive/cast (ptr CachedScriptHost) 0)
        (mut victim) -1
        (mut oldest) 9223372036854775807
        (mut index) 0]
    (al-for [host (.hosts cache)]
            (if (and (= (.count host) (len bindings)) (= (.seed host) seed))
                (set! (mut found) host)
                0)
            (if (and (= (.installations (.image host)) 0)
                     (< (.used host) (load oldest)))
                (do
                  (set! (mut victim) (load index))
                  (set! (mut oldest) (.used host))
                  0)
                0)
            (set! (mut index) (+ (load index) 1)))
    (if (!= (primitive/cast i64 (load found)) 0)
        (let [host (load found)]
          (set! (.used host) (.clock cache))
          (set! (.host-hits cache) (+ (.host-hits cache) 1))
          (field host image))
        (do
          (if (and (>= (len (.hosts cache)) (.capacity cache))
                   (< (load victim) 0))
              (panic "source-cache-host!: capacity exhausted by installed hosts")
              0)
          (compiler-session-reset!)
          (let [host
                  (alloc/unwrap-ptr (alloc/create [CachedScriptHost]
                                                  (alloc/malloc-allocator)))]
            (set! host
                  (CachedScriptHost
                    :image (pipeline-script-sequence-image bindings seed)
                    :count (len bindings)
                    :seed seed
                    :used (.clock cache)))
            (source-cache-record-scratch! cache)
            (compiler-session-reset!)
            (if (>= (len (.hosts cache)) (.capacity cache))
                (let [old (get (.hosts cache) (load victim))]
                  (image-free! (field old image))
                  (alloc/destroy [CachedScriptHost]
                                 (alloc/malloc-allocator)
                                 old)
                  (set! (mut (.hosts cache)) (load victim) host)
                  (set! (.host-evictions cache) (+ (.host-evictions cache) 1))
                  0)
                (push! [(ptr CachedScriptHost)] (mut (.hosts cache)) host))
            (set! (.host-misses cache) (+ (.host-misses cache) 1))
            (field host image))))))

(defn source-program-provider-index [(handles (ArrayList i64)) (handle i64)] (-> i64)
  (let [(mut index) 0
        (mut found) -1]
    (al-for [h handles]
            (if (= h handle) (set! (mut found) (load index)) 0)
            (set! (mut index) (+ (load index) 1)))
    (load found)))

;; Validate the whole request before installing code or retaining any additional leases.
;; In particular, a cache may hold old leased artifacts after a JSL edit. Those images remain
;; owned, but mixing their runtime semantics with a new snapshot is not an admissible program.
(defn source-program-new [(cache (ptr SourceCache))
                          (selections (ArrayList SourceScriptSelection))
                          (seed i64)] (-> (ptr SourceProgram))
  (if (<= (.capacity cache) 0) (panic "source-program-new: closed cache") 0)
  (let [(mut first) (primitive/cast (ptr CachedScript) 0)]
    (al-for [selection selections]
            (let [s selection
                  entry (source-cache-entry! cache (.handle s))
                  im (source-cache-image! cache (.handle s))]
              (if (or (< (.script s) 0) (>= (.script s) (len (.scripts im))))
                  (panic "source-program-new: unknown Script selection")
                  0)
              (let [script (get (.scripts im) (.script s))]
                (if (< (.initializer script) 0)
                    (panic "source-program-new: Script has no retained initializer")
                    0))
              (if (= (primitive/cast i64 (load first)) 0)
                  (set! (mut first) entry)
                  (if (not (source-cache-strings-equal? (.library (load first))
                                                        (.library entry)))
                      (panic "source-program-new: incompatible JSL snapshots")
                      0)))))
  (let [a (alloc/malloc-allocator)
        program (alloc/unwrap-ptr (alloc/create [SourceProgram] a))
        (mut bindings) (al-new [ImageBinding] a)
        (mut helper-bindings) (al-new [ImageBinding] a)
        (mut names) (al-new [(slice u8)] a)
        (mut index) 0]
    (set! program
          (SourceProgram
            :cache cache
            :handles (al-new [i64] a)
            :helpers (primitive/cast (ptr InstalledImage) 0)
            :providers (al-new [(ptr InstalledImage)] a)
            :host (primitive/cast (ptr CodeImage) 0)
            :installed (primitive/zeroed InstalledImage)))
    (if (> (len selections) 0)
        (let [selection (get selections 0)
              library (.helpers (source-cache-entry! cache (.handle selection)))]
          (if (!= (primitive/cast i64 library) 0)
              (let [provider
                      (alloc/unwrap-ptr (alloc/create [InstalledImage] a))
                    im (field library image)]
                (set! provider (image-install im))
                (set! (.helpers program) provider))
              0))
        0)
    ;; Consume all borrowed selections before host compilation resets compiler scratch.
    (al-for [selection selections]
            (let [s selection
                  (mut provider-index)
                    (source-program-provider-index (.handles program)
                                                   (.handle s))]
              (if (< (load provider-index) 0)
                  (let [provider
                          (alloc/unwrap-ptr (alloc/create [InstalledImage] a))]
                    (source-cache-retain! cache (.handle s))
                    (al-clear! (mut helper-bindings))
                    (if (!= (primitive/cast i64 (.helpers program)) 0)
                        (let [helper (.helpers program)
                              im (source-cache-image! cache (.handle s))]
                          (al-for [symbol (.symbols im)]
                                  (let [sym symbol]
                                    (if (and (= (.segment sym) IMAGE-SYM-IMPORT)
                                             (> (len (.abi sym)) 0))
                                        (push! [ImageBinding]
                                               (mut helper-bindings)
                                               (image-export-binding (.owner helper)
                                                                     helper
                                                                     (.name sym)
                                                                     (.name sym)))
                                        0))))
                        0)
                    (set! provider
                          (image-install-bound (source-cache-image! cache
                                                                    (.handle s))
                                               (load helper-bindings)))
                    (set! (mut provider-index) (len (.handles program)))
                    (push! [i64] (mut (.handles program)) (.handle s))
                    (push! [(ptr InstalledImage)]
                           (mut (.providers program))
                           provider))
                  0)
              (let [(mut name) (sb-new a)]
                (sb-push-str! (mut name) "script::")
                (sb-push-i64! (mut name) (load index))
                (let [owned-name (image-copy (sb-str (load name)))
                      provider (get (.providers program) (load provider-index))]
                  (push! [(slice u8)] (mut names) owned-name)
                  (push! [ImageBinding]
                         (mut bindings)
                         (image-script-initializer-binding (.owner provider)
                                                           provider
                                                           (.script s)
                                                           owned-name)))
                (sb-free! (mut name)))
              (set! (mut index) (+ (load index) 1))))
    (set! (.host program) (source-cache-host! cache (load bindings) seed))
    (set! (.installed program)
          (image-install-bound (.host program) (load bindings)))
    (source-cache-free-strings! (mut names))
    (al-free! (mut bindings))
    (al-free! (mut helper-bindings))
    program))

(defn source-program-run! [(program (ptr SourceProgram))] (-> i64)
  (if (= (len (.providers program)) 0)
      (image-run! (.host program) (field program installed))
      (let [(mut units) (al-new [(ptr InstalledImage)] (alloc/malloc-allocator))]
        (push! [(ptr InstalledImage)] (mut units) (field program installed))
        (if (!= (primitive/cast i64 (.helpers program)) 0)
            (push! [(ptr InstalledImage)] (mut units) (.helpers program))
            0)
        (al-for [provider (.providers program)]
                (push! [(ptr InstalledImage)] (mut units) provider))
        (let [result
                (image-run-shared-program! (field program installed)
                                           (load units))]
          (al-free! (mut units))
          result))))

(defn source-program-free! [(program (ptr SourceProgram))] (-> i64)
  ;; Drop the importer's provider pins before uninstalling providers or releasing source leases.
  (image-uninstall! (field program installed))
  (al-for [provider (.providers program)]
          (image-uninstall! provider)
          (alloc/destroy [InstalledImage] (alloc/malloc-allocator) provider))
  (if (!= (primitive/cast i64 (.helpers program)) 0)
      (do
        (image-uninstall! (.helpers program))
        (alloc/destroy [InstalledImage]
                       (alloc/malloc-allocator)
                       (.helpers program)))
      0)
  (al-for [handle (.handles program)]
          (source-cache-release! (.cache program) handle))
  (al-free! (mut (.providers program)))
  (al-free! (mut (.handles program)))
  (alloc/destroy [SourceProgram] (alloc/malloc-allocator) program))

(defn source-cache-drop-entry! [(entry (ptr CachedScript))] (-> i64)
  (if (or (!= (.leases entry) 0) (!= (.installations (.image entry)) 0))
      (panic "source-cache-drop-entry!: artifact is in use")
      0)
  (image-free! (mut (.image entry)))
  (if (!= (primitive/cast i64 (.helpers entry)) 0)
      (let [library (.helpers entry)]
        (if (<= (.users library) 0)
            (panic "source-cache-drop-entry!: library ownership underflow")
            0)
        (set! (.users library) (- (.users library) 1)))
      0)
  (source-cache-free-strings! (mut (.sources entry)))
  (source-cache-free-strings! (mut (.library entry)))
  (alloc/destroy [CachedScript] (alloc/malloc-allocator) entry))

(defn source-cache-acquire! [(cache (ptr SourceCache))
                             (sources (ArrayList (slice u8)))
                             (seed i64)] (-> i64)
  (if (or (<= (.capacity cache) 0) (= (len sources) 0))
      (panic "source-cache-acquire!: closed cache or empty source list")
      0)
  (if (= (.clock cache) 9223372036854775807)
      (panic "source-cache-acquire!: handle space exhausted")
      0)
  (let [(mut owned) (source-cache-copy-strings sources)
        (mut found) (primitive/cast (ptr CachedScript) 0)
        (mut victim) -1
        (mut oldest) 9223372036854775807
        (mut i) 0]
    (compiler-session-reset!)
    (jsl-load-library! JSL-COMPILER-INDEX)
    (let [(mut library) (source-cache-library-key)]
      (set! (.clock cache) (+ (.clock cache) 1))
      (al-for [entry (.entries cache)]
              (if (and (= (.seed entry) seed)
                       (source-cache-strings-equal? (.sources entry)
                                                    (load owned))
                       (source-cache-strings-equal? (.library entry)
                                                    (load library)))
                  (set! (mut found) entry)
                  0)
              (if (and (= (.leases entry) 0)
                       (= (.installations (.image entry)) 0)
                       (< (.used entry) (load oldest)))
                  (do
                    (set! (mut victim) (load i))
                    (set! (mut oldest) (.used entry))
                    0)
                  0)
              (set! (mut i) (+ (load i) 1)))
      (if (!= (primitive/cast i64 (load found)) 0)
          (let [entry (load found)]
            (if (= (.leases entry) 9223372036854775807)
                (panic "source-cache-acquire!: lease count exhausted")
                0)
            (set! (.leases entry) (+ (.leases entry) 1))
            (set! (.used entry) (.clock cache))
            (set! (.hits cache) (+ (.hits cache) 1))
            (source-cache-free-strings! (mut owned))
            (source-cache-free-strings! (mut library))
            (compiler-session-reset!)
            (.handle entry))
          (do
            (if (and (>= (len (.entries cache)) (.capacity cache))
                     (< (load victim) 0))
                (panic "source-cache-acquire!: capacity exhausted by live artifacts")
                0)
            (pipeline-encode-script-unit! (load owned) seed)
            (let [entry
                    (alloc/unwrap-ptr (alloc/create [CachedScript]
                                                    (alloc/malloc-allocator)))]
              ;; Capture the library actually used by the compilation, not a precompile guess.
              (source-cache-free-strings! (mut library))
              (set! entry
                    (CachedScript
                      :image (pipeline-capture-script-image)
                      :helpers (primitive/cast (ptr CachedJslLibrary) 0)
                      :sources (load owned)
                      :library (source-cache-library-key)
                      :seed seed
                      :handle (source-cache-next-handle!)
                      :used (.clock cache)
                      :leases 1))
              (source-cache-record-scratch! cache)
              ;; A failed/unsupported client has no native dependency to install. Capture a
              ;; successful client's owned image first, then acquire its provider. Otherwise
              ;; each worker replacement would compile the provider before rejecting its test.
              (let [helpers (source-cache-library! cache (.library entry) seed)]
                (set! (.helpers entry) helpers)
                (if (!= (primitive/cast i64 helpers) 0)
                    (do
                      (if (not (source-cache-strings-equal? (.library helpers)
                                                            (.library entry)))
                          (panic "source-cache-acquire!: JSL changed between helper and Script compilation")
                          0)
                      (set! (.users helpers) (+ (.users helpers) 1)))
                    0)
                (if (>= (len (.entries cache)) (.capacity cache))
                    (do
                      (source-cache-drop-entry! (get (.entries cache)
                                                     (load victim)))
                      (set! (mut (.entries cache)) (load victim) entry)
                      (set! (.evictions cache) (+ (.evictions cache) 1))
                      0)
                    (push! [(ptr CachedScript)] (mut (.entries cache)) entry))
                (set! (.misses cache) (+ (.misses cache) 1))
                (source-cache-record-scratch! cache)
                (compiler-session-reset!)
                (.handle entry))))))))

(defn source-cache-free! [(cache (ptr SourceCache))] (-> i64)
  (if (<= (.capacity cache) 0) (panic "source-cache-free!: closed cache") 0)
  (al-for [entry (.entries cache)]
          (if (or (!= (.leases entry) 0) (!= (.installations (.image entry)) 0))
              (panic "source-cache-free!: artifact is in use")
              0))
  (al-for [host (.hosts cache)]
          (if (!= (.installations (.image host)) 0)
              (panic "source-cache-free!: host is installed")
              0))
  (al-for [host (.hosts cache)]
          (image-free! (field host image))
          (alloc/destroy [CachedScriptHost] (alloc/malloc-allocator) host))
  (al-free! (mut (.hosts cache)))
  (al-for [entry (.entries cache)] (source-cache-drop-entry! entry))
  (al-for [library (.libraries cache)]
          (if (or (!= (.users library) 0)
                  (!= (.installations (.image library)) 0))
              (panic "source-cache-free!: library remains in use")
              0)
          (image-free! (field library image))
          (alloc/free [u8] (alloc/malloc-allocator) (.graph library))
          (source-cache-free-strings! (field library library))
          (alloc/destroy [CachedJslLibrary] (alloc/malloc-allocator) library))
  (al-free! (mut (.libraries cache)))
  (al-free! (mut (.entries cache)))
  (set! (.capacity cache) 0)
  0)
