;; The ideal graph, serialized into the object file.

;;
;; This is what makes separate compilation compatible with cross-unit inlining: an object file
;; carries not only machine code but the IR it came from, so a later compilation can inline a
;; function it did not compile. Without it, separate compilation and whole-program optimisation
;; are alternatives; with it they are the same thing.
;;
;; The format is the opcode tag plus the packed edges and payload, which is why every node kind
;; carries an `op` and not merely a vtable.
;;
(module aot.codegen.serialize)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "aot.codegen.objfile" :use [obj-put-slice! obj-put8!])
(import "aot.node.node" :use *)
(import "aot.codegen.serialize.bytes" :use * :reexport)
(import "aot.codegen.serialize.types" :use * :reexport)
(import "aot.codegen.serialize.nodes" :use * :reexport)

(const GRAPH-ARTIFACT-VERSION 1)

(defn ser-write-graph [(root (dyn NodeOps))] (-> (slice u8))
  (let [(mut out) (al-new [u8] (alloc/malloc-allocator))]
    (obj-put-slice! (mut out) "AOTGRAPH")
    (obj-put8! (mut out) GRAPH-ARTIFACT-VERSION)
    (ser-write-types! (mut out))
    (ser-write-nodes! (mut out) root)
    (al-into-slice (mut out))))

(defn ser-read-header! [(c (ptr SerCursor))] (-> bool)
  (let [(mut i) 0 (mut same) true]
    (loop (if (or (not (load same)) (>= (load i) 8))
              (break 0)
              (do
                (if (!= (ser-read1! c) (primitive/cast i64 (get "AOTGRAPH" (load i))))
                    (set! (mut same) false)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (or (not (load same)) (!= (ser-read8! c) GRAPH-ARTIFACT-VERSION))
        (set! (.ok c) false)
        0)
    (.ok c)))

;; Reading is deliberately into a fresh compiler session. A malformed entry returns None; the
;; caller discards that session and recompiles the provider graph.
(defn ser-read-graph [(bytes (slice u8))] (-> (Option (dyn NodeOps)))
  (let [c (alloc/unwrap-ptr
            (alloc/create [SerCursor] (alloc/malloc-allocator)))]
    (set! c (SerCursor :bytes bytes :at 0 :ok true))
    (ser-read-header! c)
    (if (.ok c) (ser-read-types! c) false)
    (let [root
            (if (.ok c)
                (ser-read-nodes! c)
                (None [(dyn NodeOps)]))]
      (let [valid (and (.ok c) (= (.at c) (len bytes)))]
        (alloc/destroy [SerCursor] (alloc/malloc-allocator) c)
        (if valid root (None [(dyn NodeOps)]))))))
