;; The ideal graph, serialized into the object file.

;;
;; This is what makes separate compilation compatible with cross-unit inlining: an object file
;; carries not only machine code but the IR it came from, so a later compilation can inline a
;; function it did not compile. Without it, separate compilation and whole-program optimisation
;; are alternatives; with it they are the same thing.
;;
;; The format is the opcode tag plus the packed edges and payload, which is why every node kind
;; carries an `op` and not merely a vtable.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S7.
(module aot.codegen.serialize)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(defn ser-write-graph [(root (dyn NodeOps))] (-> i64)
  (do (unimplemented "ser-write-graph" "S7 — src/codegen/serialize.coil") 0))

(defn ser-read-graph [(bytes (slice u8))] (-> (dyn NodeOps))
  (do (unimplemented "ser-read-graph" "S7 — src/codegen/serialize.coil") (unreachable-node)))
