;; Own-key enumeration: shape keys, Object.keys, getOwnPropertyNames and the argument tail.

(module aot.rt.keys)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.mem" :as mem)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :as io)
(import "coil.os" :as os)
(import "coil.time" :as time)
(import "aot.rt.shapes" :use *)
(import "aot.rt.number" :use *)
(import "aot.rt.layout" :use *)
(import "aot.rt.heap" :use *)
(import "aot.rt.gc" :use *)
(import "aot.rt.string" :use *)
(import "aot.rt.property" :use *)
(import "aot.rt.array" :use *)

;; An ordinary object's own string property keys in OrdinaryOwnPropertyKeys order (§10.1.11.1):
;; the array-index keys ascending, then the other keys in insertion order — the shape tree's edges
;; from the root to the object's shape. Marker and hole rows name no key. `all` keeps the
;; non-enumerable keys too (getOwnPropertyNames, for-in's shadowing); otherwise they are passed over.
(defn rt-shape-keys! [(shape i64) (out (mut (ArrayList i64))) (all bool)] (-> i64)
  (let [(mut chain) (al-new [i64] (alloc/malloc-allocator))
        (mut indices) (al-new [i64] (alloc/malloc-allocator))
        (mut s) shape]
    (loop (if (or (= (load s) 0) (= (load s) SHAPES-ROOT))
              (break 0)
              (do
                (if (and (!= (shapes-key (load s)) 0)
                         (and (not (shapes-key-symbol? (shapes-key (load s))))
                              (or all
                                  (!= (& (shapes-attrs (load s))
                                         SHAPES-ATTR-ENUMERABLE)
                                      0))))
                    (push! [i64] (mut chain) (shapes-key (load s)))
                    0)
                (set! (mut s) (shapes-parent (load s)))
                (continue))))
    ;; The index keys, sorted by insertion into a list kept ascending.
    (al-for [key (load chain)]
            (let [index (number-array-index-of-name (shapes-key-name key))]
              (if (>= index 0)
                  (let [(mut at) (len (load indices))]
                    (push! [i64] (mut indices) key)
                    (loop (if (or (= (load at) 0)
                                  (<= (number-array-index-of-name (shapes-key-name (get (load indices)
                                                                                        (- (load at)
                                                                                           1))))
                                      index))
                              (break 0)
                              (do
                                (set! (al-elem [i64] (mut indices) (load at))
                                      (get (load indices) (- (load at) 1)))
                                (set! (mut at) (- (load at) 1))
                                (continue))))
                    (set! (al-elem [i64] (mut indices) (load at)) key))
                  0)))
    (al-for [key (load indices)] (push! [i64] (mut out) key))
    (let [(mut i) (- (len (load chain)) 1)]
      (loop (if (< (load i) 0)
                (break 0)
                (let [key (get (load chain) (load i))]
                  (if (< (number-array-index-of-name (shapes-key-name key)) 0)
                      (push! [i64] (mut out) key)
                      0)
                  (set! (mut i) (- (load i) 1))
                  (continue)))))
    (al-free! [i64] (mut indices))
    (al-free! [i64] (mut chain))
    0))

;; The runtime capability behind `%ObjectKeys`: an ordinary object's own enumerable keys as a fresh
;; array of strings in OrdinaryOwnPropertyKeys order, on `proto` (%Array.prototype%, or null without a
;; realm). The array is rooted across every string allocation and re-read.
(defn rt-object-keys [(obj i64) (proto i64) (map-id i64) (caller-sp i64)] (-> i64)
  (rt-object-key-strings obj proto false map-id caller-sp))

;; `%ObjectOwnNames`: every own string key, the non-enumerable ones included, in the same order.
(defn rt-object-own-names [(obj i64) (proto i64) (map-id i64) (caller-sp i64)] (-> i64)
  (rt-object-key-strings obj proto true map-id caller-sp))

(defn rt-object-key-strings [(obj i64)
                             (proto i64)
                             (all bool)
                             (map-id i64)
                             (caller-sp i64)] (-> i64)
  (let [(mut keys) (al-new [i64] (alloc/malloc-allocator))
        storage (rt-storage-of obj)
        arr-root (primitive/alloc-stack i64)]
    (rt-heap-boot!)
    (if (= storage 0)
        0
        (rt-shape-keys! (rt-payload-shape storage) (mut keys) all))
    (set! arr-root (rt-array-new (len (load keys)) proto map-id caller-sp))
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (load keys)))
                (break 0)
                (let [string
                        (rt-string-from-utf8 (shapes-key-name (get (load keys)
                                                                   (load i)))
                                             map-id
                                             caller-sp
                                             arr-root)]
                  (rt-array-store (load arr-root)
                                  (load i)
                                  (rt-box-string string)
                                  map-id
                                  caller-sp)
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (al-free! [i64] (mut keys))
    (load arr-root)))

;; `%ArgumentTail`: the callable ABI's overflow vector for an argument list held in an array — the
;; elements from index 3, a hole read as undefined, one boxed word each under SHAPE-ELEMENTS, as a
;; caller's vector is (aot.codegen.callabi). Null when there is no overflow. The array is rooted
;; across the allocation and re-read.
(defn rt-argument-tail [(arr i64) (map-id i64) (caller-sp i64)] (-> i64)
  (let [arr-root (primitive/alloc-stack i64)
        none (primitive/alloc-stack i64)]
    (set! arr-root arr)
    (set! none 0)
    (rt-heap-boot!)
    (let [count (rt-array-length arr)]
      (if (<= count 3)
          0
          (let [vector
                  (rt-array-alloc-store (- count 3)
                                        map-id
                                        caller-sp
                                        arr-root
                                        none)
                moved (load arr-root)
                (mut i) 3]
            (loop (if (>= (load i) count)
                      (break 0)
                      (do
                        (let [word (rt-array-load moved (load i))]
                          (set! (primitive/cast (ptr i64)
                                                (+ vector (* (- (load i) 3) 8)))
                                word)
                          (aot-rt-write-barrier vector word RT-BARRIER-BOXED))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))
            vector)))))
