;; Number conversions shared by the compiler and the runtime: the exact radix-integer conversion a
;; numeric literal needs at compile time and StringToNumber needs at run time, the decimal
;; conversion through libc's correctly rounded `strtod`, and the NaN-box word a Number takes.
;;
;; ECMA-262 §7.1.4.1.1 StringToNumber: StrWhiteSpace trimmed from both ends, the empty string is
;; +0, then one of `Infinity`, a signed decimal literal (digits, an optional fraction, an optional
;; exponent), or an unsigned 0x/0o/0b integer literal; anything else is NaN. Numeric separators
;; are not part of the string grammar. The decimal spelling is handed to `strtod` only after the
;; grammar accepted it, so `strtod`'s wider syntax (hexadecimal floats, `inf`, `nan`) never leaks.
(module aot.rt.number)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "aot.util.panic" :use *)

(extern strtod :cc c [(ptr i8) (ptr (ptr i8))] (-> f64))

(const NUMBER-INFINITY-BITS 9218868437227405312)

(const NUMBER-NAN-BITS 9221120237041090560)

;; The binary64 with these bits (a store and a typed load; `cast` converts numerically).
(defn number-from-bits [(bits i64)] (-> f64)
  (let [slot (primitive/alloc-stack i64)]
    (set! slot bits)
    (load (primitive/cast (ptr f64) slot))))

(defn number-bits [(x f64)] (-> i64)
  (let [slot (primitive/alloc-stack f64)]
    (set! slot x)
    (load (primitive/cast (ptr i64) slot))))

(defn number-nan [] (-> f64)
  (number-from-bits NUMBER-NAN-BITS))

(defn number-infinity [] (-> f64)
  (number-from-bits NUMBER-INFINITY-BITS))

;; The value of an ASCII digit in radix up to 16, or -1.
(defn number-digit-value [(c u8)] (-> i64)
  (if (and (>= c (cast u8 48)) (<= c (cast u8 57)))
      (- (cast i64 c) 48)
      (if (and (>= c (cast u8 97)) (<= c (cast u8 102)))
          (- (cast i64 c) 87)
          (if (and (>= c (cast u8 65)) (<= c (cast u8 70))) (- (cast i64 c) 55) -1))))

;; Power-of-two radix integers need only their leading 53 bits, a guard bit and sticky remainder.
;; Round once, ties to even; repeated floating multiply/add would double-round long spellings.
;; `width` is the bits per digit (1, 3 or 4); `_` separators are skipped for the literal grammar.
(defn number-radix-value [(text (slice u8)) (start i64) (width i64)] (-> f64)
  (let [(mut i) start
        (mut bits) 0
        (mut head) 0
        (mut sticky) false]
    (loop (if (>= (load i) (len text))
              (break 0)
              (do
                (if (!= (get text (load i)) (cast u8 95))
                    (let [digit (number-digit-value (get text (load i)))
                          (mut shift) (- width 1)]
                      (loop (if (< (load shift) 0)
                                (break 0)
                                (let [bit (primitive/iand (primitive/ishr digit (load shift)) 1)]
                                  (if (or (> (load bits) 0) (= bit 1))
                                      (do
                                        (if (< (load bits) 1025)
                                            (set! (mut bits) (+ (load bits) 1))
                                            0)
                                        (if (<= (load bits) 54)
                                            (set! (mut head) (+ (primitive/ishl (load head) 1) bit))
                                            (if (= bit 1) (set! (mut sticky) true) 0)))
                                      0)
                                  (set! (mut shift) (- (load shift) 1))
                                  (continue)))))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (<= (load bits) 53)
        (primitive/cast f64 (load head))
        (let [(mut mantissa) (primitive/ishr (load head) 1)
              (mut exponent) (- (load bits) 1)]
          (if (and (= (primitive/iand (load head) 1) 1)
                   (or (load sticky) (= (primitive/iand (load mantissa) 1) 1)))
              (set! (mut mantissa) (+ (load mantissa) 1))
              0)
          (if (= (load mantissa) 9007199254740992)
              (do
                (set! (mut mantissa) (primitive/ishr (load mantissa) 1))
                (set! (mut exponent) (+ (load exponent) 1)))
              0)
          (if (> (load exponent) 1023)
              (number-infinity)
              (number-from-bits (+ (primitive/ishl (+ (load exponent) 1023) 52)
                                   (- (load mantissa) 4503599627370496))))))))

;; `strtod` over `text`, which must contain no NUL; `consumed` receives how many bytes it read.
(defn number-strtod! [(text (slice u8)) (consumed (ptr i64))] (-> f64)
  (let [a (alloc/malloc-allocator)
        (mut bytes) (al-new [u8] a)]
    (let [(mut i) 0]
      (loop (if (>= (load i) (len text))
                (break 0)
                (do (push! [u8] (mut bytes) (get text (load i)))
                    (set! (mut i) (+ (load i) 1))
                    (continue)))))
    (push! [u8] (mut bytes) (cast u8 0))
    (let [buf (primitive/cast (ptr i8) (slice-data (al-slice (load bytes))))
          end (primitive/alloc-stack (ptr i8))
          value (strtod buf end)]
      (set! consumed (- (primitive/cast i64 (load end)) (primitive/cast i64 buf)))
      (al-free! [u8] (mut bytes))
      value)))

(defn number--digit? [(c u8)] (-> bool)
  (and (>= c (cast u8 48)) (<= c (cast u8 57))))

;; Does `text` from `i` spell StrUnsignedDecimalLiteral exactly to its end?
;;   Infinity | DecimalDigits [. DecimalDigits?] [ExponentPart] | . DecimalDigits [ExponentPart]
(defn number--unsigned-decimal? [(text (slice u8)) (start i64)] (-> bool)
  (let [n (len text)
        (mut i) start
        (mut int-digits) 0
        (mut frac-digits) 0]
    (if (and (= (- n start) 8)
             (= (get text start) (cast u8 73))
             (= (get text (+ start 1)) (cast u8 110))
             (= (get text (+ start 2)) (cast u8 102))
             (= (get text (+ start 3)) (cast u8 105))
             (= (get text (+ start 4)) (cast u8 110))
             (= (get text (+ start 5)) (cast u8 105))
             (= (get text (+ start 6)) (cast u8 116))
             (= (get text (+ start 7)) (cast u8 121)))
        true
        (do
          (loop (if (and (< (load i) n) (number--digit? (get text (load i))))
                    (do (set! (mut int-digits) (+ (load int-digits) 1))
                        (set! (mut i) (+ (load i) 1))
                        (continue))
                    (break 0)))
          (if (and (< (load i) n) (= (get text (load i)) (cast u8 46)))
              (do
                (set! (mut i) (+ (load i) 1))
                (loop (if (and (< (load i) n) (number--digit? (get text (load i))))
                          (do (set! (mut frac-digits) (+ (load frac-digits) 1))
                              (set! (mut i) (+ (load i) 1))
                              (continue))
                          (break 0))))
              0)
          (if (= (+ (load int-digits) (load frac-digits)) 0)
              false
              (do
                ;; ExponentPart: e|E [+|-] DecimalDigits
                (if (and (< (load i) n)
                         (or (= (get text (load i)) (cast u8 101)) (= (get text (load i)) (cast u8 69))))
                    (let [(mut exp-digits) 0]
                      (set! (mut i) (+ (load i) 1))
                      (if (and (< (load i) n)
                               (or (= (get text (load i)) (cast u8 43)) (= (get text (load i)) (cast u8 45))))
                          (set! (mut i) (+ (load i) 1))
                          0)
                      (loop (if (and (< (load i) n) (number--digit? (get text (load i))))
                                (do (set! (mut exp-digits) (+ (load exp-digits) 1))
                                    (set! (mut i) (+ (load i) 1))
                                    (continue))
                                (break 0)))
                      (if (= (load exp-digits) 0) (set! (mut i) (+ n 1)) 0))
                    0)
                (= (load i) n)))))))

;; Are the bytes from `start` all digits of the given radix, and at least one?
(defn number--radix-digits? [(text (slice u8)) (start i64) (radix i64)] (-> bool)
  (let [n (len text) (mut i) start (mut ok) (< start n)]
    (loop (if (or (not (load ok)) (>= (load i) n))
              (break 0)
              (let [d (number-digit-value (get text (load i)))]
                (if (or (< d 0) (>= d radix)) (set! (mut ok) false) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load ok)))

;; StringToNumber over the trimmed ASCII spelling (the caller trims StrWhiteSpace and hands over
;; only ASCII: a non-ASCII character can be nothing but NaN once the whitespace is gone).
(defn number-string-to-number [(text (slice u8))] (-> f64)
  (let [n (len text)]
    (if (= n 0)
        (primitive/cast f64 0)
        (if (and (> n 2) (= (get text 0) (cast u8 48))
                 (or (= (get text 1) (cast u8 120)) (= (get text 1) (cast u8 88))))
            (if (number--radix-digits? text 2 16) (number-radix-value text 2 4) (number-nan))
            (if (and (> n 2) (= (get text 0) (cast u8 48))
                     (or (= (get text 1) (cast u8 111)) (= (get text 1) (cast u8 79))))
                (if (number--radix-digits? text 2 8) (number-radix-value text 2 3) (number-nan))
                (if (and (> n 2) (= (get text 0) (cast u8 48))
                         (or (= (get text 1) (cast u8 98)) (= (get text 1) (cast u8 66))))
                    (if (number--radix-digits? text 2 2) (number-radix-value text 2 1) (number-nan))
                    (let [signed (or (= (get text 0) (cast u8 43)) (= (get text 0) (cast u8 45)))
                          negative (= (get text 0) (cast u8 45))
                          start (if signed 1 0)]
                      (if (not (number--unsigned-decimal? text start))
                          (number-nan)
                          (if (and (= (- n start) 8) (= (get text start) (cast u8 73)))
                              (if negative (- (primitive/cast f64 0) (number-infinity)) (number-infinity))
                              (let [consumed (primitive/alloc-stack i64)
                                    value (number-strtod! text consumed)]
                                value))))))))))

;; The NaN-box word of a Number: a compact signed-48 immediate when the value is an integer that
;; fits and is not -0 (the compiler's own rule for literals), else the raw binary64 bits.
(defn number-word [(x f64)] (-> i64)
  (let [bits (number-bits x)
        exponent (primitive/iand (primitive/ishr bits 52) 0x7ff)]
    ;; NaN, the infinities and every magnitude of 2^47 or more are raw bits; the cast below is only
    ;; taken where it cannot trap.
    (if (or (= exponent 0x7ff) (>= exponent (+ 1023 47)))
        bits
        (let [truncated (primitive/cast i64 x)]
          (if (and (primitive/fcmp-eq (primitive/cast f64 truncated) x)
                   (!= bits -9223372036854775808))
              (+ 0x7ff9000000000000 (primitive/iand truncated 0x0000ffffffffffff))
              bits)))))

;; ---------------------------------------------------------------------------
;; Math (ECMA-262 §21.3): the functions libm provides, and the few the specification defines
;; differently from C. Each Math.* function is JSL over `%MathUnary`/`%MathBinary` with one of
;; these operation codes; the compiler's table (`aot.node.jsops`) and this one are the same list.

(extern sqrt :cc c [f64] (-> f64))
(extern sin :cc c [f64] (-> f64))
(extern cos :cc c [f64] (-> f64))
(extern tan :cc c [f64] (-> f64))
(extern asin :cc c [f64] (-> f64))
(extern acos :cc c [f64] (-> f64))
(extern atan :cc c [f64] (-> f64))
(extern sinh :cc c [f64] (-> f64))
(extern cosh :cc c [f64] (-> f64))
(extern tanh :cc c [f64] (-> f64))
(extern asinh :cc c [f64] (-> f64))
(extern acosh :cc c [f64] (-> f64))
(extern atanh :cc c [f64] (-> f64))
(extern exp :cc c [f64] (-> f64))
(extern expm1 :cc c [f64] (-> f64))
(extern log :cc c [f64] (-> f64))
(extern log1p :cc c [f64] (-> f64))
(extern log2 :cc c [f64] (-> f64))
(extern log10 :cc c [f64] (-> f64))
(extern cbrt :cc c [f64] (-> f64))
(extern floor :cc c [f64] (-> f64))
(extern ceil :cc c [f64] (-> f64))
(extern trunc :cc c [f64] (-> f64))
(extern pow :cc c [f64 f64] (-> f64))
(extern atan2 :cc c [f64 f64] (-> f64))
(extern hypot :cc c [f64 f64] (-> f64))
(extern arc4random :cc c [] (-> u32))

(const MATH-OP-SQRT 1)
(const MATH-OP-SIN 2)
(const MATH-OP-COS 3)
(const MATH-OP-TAN 4)
(const MATH-OP-ASIN 5)
(const MATH-OP-ACOS 6)
(const MATH-OP-ATAN 7)
(const MATH-OP-SINH 8)
(const MATH-OP-COSH 9)
(const MATH-OP-TANH 10)
(const MATH-OP-ASINH 11)
(const MATH-OP-ACOSH 12)
(const MATH-OP-ATANH 13)
(const MATH-OP-EXP 14)
(const MATH-OP-EXPM1 15)
(const MATH-OP-LOG 16)
(const MATH-OP-LOG1P 17)
(const MATH-OP-LOG2 18)
(const MATH-OP-LOG10 19)
(const MATH-OP-CBRT 20)
(const MATH-OP-FLOOR 21)
(const MATH-OP-CEIL 22)
(const MATH-OP-TRUNC 23)
(const MATH-OP-ROUND 24)
(const MATH-OP-FROUND 25)
(const MATH-OP-POW 40)
(const MATH-OP-ATAN2 41)
(const MATH-OP-HYPOT 42)

(defn number-negative-zero [] (-> f64)
  (number-from-bits -9223372036854775808))

(defn number-nan? [(x f64)] (-> bool)
  (not (primitive/fcmp-eq x x)))

;; Math.round (§21.3.2.28): the integer closest to x, ties toward +∞; -0 for −0.5 ≤ x < 0 and for
;; -0; NaN, the infinities and every integer are themselves. The C `round` rounds ties away from
;; zero, so this is written out: floor(x + 0.5) would also lose the tie for magnitudes above 2^52,
;; where every binary64 is already an integer.
(defn number-math-round [(x f64)] (-> f64)
  (if (or (number-nan? x) (primitive/fcmp-eq (floor x) x))
      x
      (if (or (>= x (primitive/cast f64 4503599627370496)) (<= x (primitive/cast f64 -4503599627370496)))
          x
          (let [f (floor x)
                r (if (>= (- x f) (primitive/cast f64 0.5)) (+ f (primitive/cast f64 1)) f)]
            (if (and (primitive/fcmp-eq r (primitive/cast f64 0)) (< x (primitive/cast f64 0)))
                (number-negative-zero)
                r)))))

;; Math.fround (§21.3.2.17): the nearest binary32, back in binary64.
(defn number-math-fround [(x f64)] (-> f64)
  (primitive/cast f64 (primitive/cast f32 x)))

(defn number-math-unary [(op i64) (x f64)] (-> f64)
  (case op
        MATH-OP-SQRT (sqrt x)
        MATH-OP-SIN (sin x)
        MATH-OP-COS (cos x)
        MATH-OP-TAN (tan x)
        MATH-OP-ASIN (asin x)
        MATH-OP-ACOS (acos x)
        MATH-OP-ATAN (atan x)
        MATH-OP-SINH (sinh x)
        MATH-OP-COSH (cosh x)
        MATH-OP-TANH (tanh x)
        MATH-OP-ASINH (asinh x)
        MATH-OP-ACOSH (acosh x)
        MATH-OP-ATANH (atanh x)
        MATH-OP-EXP (exp x)
        MATH-OP-EXPM1 (expm1 x)
        MATH-OP-LOG (log x)
        MATH-OP-LOG1P (log1p x)
        MATH-OP-LOG2 (log2 x)
        MATH-OP-LOG10 (log10 x)
        MATH-OP-CBRT (cbrt x)
        MATH-OP-FLOOR (floor x)
        MATH-OP-CEIL (ceil x)
        MATH-OP-TRUNC (trunc x)
        MATH-OP-ROUND (number-math-round x)
        MATH-OP-FROUND (number-math-fround x)
        (do (panic-i "number-math-unary: unknown operation" op) x)))

;; Math.pow follows Number::exponentiate (§6.1.6.1.3), which departs from C `pow` in two cases:
;; any exponent NaN gives NaN (C: 1**NaN is 1), and ±1 raised to ±∞ gives NaN (C: 1).
(defn number-math-pow [(x f64) (y f64)] (-> f64)
  (if (number-nan? y)
      (number-nan)
      (if (and (primitive/fcmp-eq (number-math-unary MATH-OP-FLOOR (if (< x (primitive/cast f64 0)) (- (primitive/cast f64 0) x) x))
                                  (primitive/cast f64 1))
               (and (primitive/fcmp-eq (if (< x (primitive/cast f64 0)) (- (primitive/cast f64 0) x) x) (primitive/cast f64 1))
                    (or (primitive/fcmp-eq y (number-infinity)) (primitive/fcmp-eq y (- (primitive/cast f64 0) (number-infinity))))))
          (number-nan)
          (pow x y))))

(defn number-math-binary [(op i64) (x f64) (y f64)] (-> f64)
  (case op
        MATH-OP-POW (number-math-pow x y)
        MATH-OP-ATAN2 (atan2 x y)
        MATH-OP-HYPOT (hypot x y)
        (do (panic-i "number-math-binary: unknown operation" op) x)))

;; Math.random (§21.3.2.27): 53 random bits from the system source, as a binary64 in [0, 1).
(defn number-math-random [] (-> f64)
  (let [hi (primitive/cast i64 (arc4random))
        lo (primitive/cast i64 (arc4random))
        bits (primitive/ior (primitive/ishl (primitive/iand hi 0x1fffff) 32) (primitive/iand lo 0xffffffff))]
    (/ (primitive/cast f64 bits) (primitive/cast f64 9007199254740992))))

;; ---------------------------------------------------------------------------
;; parseInt and parseFloat (§19.2.5, §19.2.4) over a string's code units. The callers give the
;; code units through `unit-at`, so the same functions serve the runtime's UTF-16 strings and the
;; compiler's tests.

(defn number--radix-digit [(unit i64)] (-> i64)
  (if (and (>= unit 48) (<= unit 57))
      (- unit 48)
      (if (and (>= unit 97) (<= unit 122))
          (- unit 87)
          (if (and (>= unit 65) (<= unit 90)) (- unit 55) -1))))

;; parseInt(string, radix): skip StrWhiteSpace, take a sign, resolve the radix (0 → 10, with a
;; `0x` prefix meaning 16 when the radix is 10 or absent), then the longest run of digits below the
;; radix; no digit is NaN. The value is exact below 2^53 in any radix; above it, the digits are
;; accumulated in binary64, which the specification permits for every radix but 10, where the
;; correctly rounded value comes from `strtod` over the digit run.
(defn number--parse-int-digits [(units (slice i64)) (start i64) (radix i64) (negative bool)] (-> f64)
  (let [n (len units)
        (mut i) start
        (mut value) (primitive/cast f64 0)
        (mut digits) (al-new [u8] (alloc/malloc-allocator))]
    (loop (if (>= (load i) n)
              (break 0)
              (let [d (number--radix-digit (get units (load i)))]
                (if (or (< d 0) (>= d radix))
                    (break 0)
                    (do
                      (set! (mut value) (+ (* (load value) (primitive/cast f64 radix)) (primitive/cast f64 d)))
                      (push! [u8] (mut digits) (primitive/cast u8 (get units (load i))))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))))
    (if (= (load i) start)
        (do (al-free! [u8] (mut digits)) (number-nan))
        (let [magnitude (if (= radix 10)
                            (let [consumed (primitive/alloc-stack i64)]
                              (number-strtod! (al-slice (load digits)) consumed))
                            (load value))]
          (al-free! [u8] (mut digits))
          (if negative
              (if (primitive/fcmp-eq magnitude (primitive/cast f64 0))
                  (number-negative-zero)
                  (- (primitive/cast f64 0) magnitude))
              magnitude)))))

(defn number-parse-int [(units (slice i64)) (radix0 i64)] (-> f64)
  (let [n (len units)
        (mut i) 0]
    (loop (if (and (< (load i) n) (number--unit-whitespace? (get units (load i))))
              (do (set! (mut i) (+ (load i) 1)) (continue))
              (break 0)))
    (let [negative (and (< (load i) n) (= (get units (load i)) 45))
          signed (and (< (load i) n) (or (= (get units (load i)) 43) (= (get units (load i)) 45)))
          after-sign (if signed (+ (load i) 1) (load i))
          ;; Radix 0 reads as 10; an out-of-range radix is NaN; only 16 (given or defaulted) admits
          ;; the `0x` prefix.
          radix (if (= radix0 0) 10 radix0)
          hex-prefix (and (or (= radix0 0) (= radix0 16))
                          (and (< (+ after-sign 1) n)
                               (and (= (get units after-sign) 48)
                                    (or (= (get units (+ after-sign 1)) 120) (= (get units (+ after-sign 1)) 88)))))]
      (if (or (< radix 2) (> radix 36))
          (number-nan)
          (number--parse-int-digits units
                                    (if hex-prefix (+ after-sign 2) after-sign)
                                    (if hex-prefix 16 radix)
                                    negative)))))

;; StrWhiteSpaceChar (§7.1.4.1.1): WhiteSpace and LineTerminator code units.
(defn number--unit-whitespace? [(unit i64)] (-> bool)
  (or (= unit 9) (= unit 10) (= unit 11) (= unit 12) (= unit 13) (= unit 32)
      (= unit 0xa0) (= unit 0x1680)
      (and (>= unit 0x2000) (<= unit 0x200a))
      (= unit 0x2028) (= unit 0x2029) (= unit 0x202f) (= unit 0x205f)
      (= unit 0x3000) (= unit 0xfeff)))

(defn number--unit-digit? [(unit i64)] (-> bool)
  (and (>= unit 48) (<= unit 57)))

;; The length of the longest prefix of `units` from `start` that is a StrDecimalLiteral:
;;   [+-] ( Infinity | Digits [. Digits?] [e[+-]Digits] | . Digits [e[+-]Digits] )
;; Zero when no prefix qualifies.
(defn number--decimal-prefix [(units (slice i64)) (start i64)] (-> i64)
  (let [n (len units)
        (mut i) start]
    (if (and (< (load i) n) (or (= (get units (load i)) 43) (= (get units (load i)) 45)))
        (set! (mut i) (+ (load i) 1))
        0)
    (if (and (<= (+ (load i) 8) n)
             (and (= (get units (load i)) 73) (= (get units (+ (load i) 1)) 110)
                  (and (= (get units (+ (load i) 2)) 102) (= (get units (+ (load i) 3)) 105)
                       (and (= (get units (+ (load i) 4)) 110) (= (get units (+ (load i) 5)) 105)
                            (and (= (get units (+ (load i) 6)) 116) (= (get units (+ (load i) 7)) 121))))))
        (- (+ (load i) 8) start)
        (let [int-start (load i)]
          (loop (if (and (< (load i) n) (number--unit-digit? (get units (load i))))
                    (do (set! (mut i) (+ (load i) 1)) (continue))
                    (break 0)))
          (let [int-digits (- (load i) int-start)
                (mut frac-digits) 0]
            (if (and (< (load i) n) (= (get units (load i)) 46))
                (let [frac-start (+ (load i) 1)
                      (mut j) frac-start]
                  (loop (if (and (< (load j) n) (number--unit-digit? (get units (load j))))
                            (do (set! (mut j) (+ (load j) 1)) (continue))
                            (break 0)))
                  (set! (mut frac-digits) (- (load j) frac-start))
                  ;; `.` alone, or a `.` after no integer digits with no fraction, ends the literal
                  ;; before the point.
                  (if (or (> int-digits 0) (> (load frac-digits) 0))
                      (set! (mut i) (load j))
                      0))
                0)
            (if (and (= int-digits 0) (= (load frac-digits) 0))
                0
                (do
                  ;; An exponent counts only when it has digits.
                  (if (and (< (load i) n) (or (= (get units (load i)) 101) (= (get units (load i)) 69)))
                      (let [(mut j) (+ (load i) 1)]
                        (if (and (< (load j) n) (or (= (get units (load j)) 43) (= (get units (load j)) 45)))
                            (set! (mut j) (+ (load j) 1))
                            0)
                        (let [exp-start (load j)]
                          (loop (if (and (< (load j) n) (number--unit-digit? (get units (load j))))
                                    (do (set! (mut j) (+ (load j) 1)) (continue))
                                    (break 0)))
                          (if (> (load j) exp-start) (set! (mut i) (load j)) 0)))
                      0)
                  (- (load i) start))))))))

;; parseFloat(string): skip StrWhiteSpace, then the longest StrDecimalLiteral prefix, or NaN.
(defn number-parse-float [(units (slice i64))] (-> f64)
  (let [n (len units)
        (mut i) 0]
    (loop (if (and (< (load i) n) (number--unit-whitespace? (get units (load i))))
              (do (set! (mut i) (+ (load i) 1)) (continue))
              (break 0)))
    (let [count (number--decimal-prefix units (load i))]
      (if (= count 0)
          (number-nan)
          (let [(mut bytes) (al-new [u8] (alloc/malloc-allocator))
                (mut k) 0]
            (loop (if (>= (load k) count)
                      (break 0)
                      (do
                        (push! [u8] (mut bytes) (primitive/cast u8 (get units (+ (load i) (load k)))))
                        (set! (mut k) (+ (load k) 1))
                        (continue))))
            (let [text (al-slice (load bytes))
                  signed (or (= (get text 0) (cast u8 43)) (= (get text 0) (cast u8 45)))
                  negative (= (get text 0) (cast u8 45))
                  body (if signed 1 0)
                  value (if (and (= (- count body) 8) (= (get text body) (cast u8 73)))
                            (if negative (- (primitive/cast f64 0) (number-infinity)) (number-infinity))
                            (let [consumed (primitive/alloc-stack i64)]
                              (number-strtod! text consumed)))]
              (al-free! [u8] (mut bytes))
              value))))))
