;; Number conversions shared by the compiler and the runtime: the exact radix-integer conversion a
;; numeric literal needs at compile time and StringToNumber needs at run time, the decimal
;; conversion through libc's correctly rounded `strtod`, and the NaN-box word a Number takes.
;;
;; ECMA-262 §7.1.4.1.1 StringToNumber: StrWhiteSpace trimmed from both ends, the empty string is
;; +0, then one of `Infinity`, a signed decimal literal (digits, an optional fraction, an optional
;; exponent), or an unsigned 0x/0o/0b integer literal; anything else is NaN. Numeric separators
;; are not part of the string grammar. The decimal spelling is handed to `strtod` only after the
;; grammar accepted it, so `strtod`'s wider syntax (hexadecimal floats, `inf`, `nan`) never leaks.
(module aot.rt.number)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)

(extern strtod :cc c [(ptr i8) (ptr (ptr i8))] (-> f64))

(const NUMBER-INFINITY-BITS 9218868437227405312)

(const NUMBER-NAN-BITS 9221120237041090560)

;; The binary64 with these bits (a store and a typed load; `cast` converts numerically).
(defn number-from-bits [(bits i64)] (-> f64)
  (let [slot (primitive/alloc-stack i64)]
    (set! slot bits)
    (load (primitive/cast (ptr f64) slot))))

(defn number-bits [(x f64)] (-> i64)
  (let [slot (primitive/alloc-stack f64)]
    (set! slot x)
    (load (primitive/cast (ptr i64) slot))))

(defn number-nan [] (-> f64)
  (number-from-bits NUMBER-NAN-BITS))

(defn number-infinity [] (-> f64)
  (number-from-bits NUMBER-INFINITY-BITS))

;; The value of an ASCII digit in radix up to 16, or -1.
(defn number-digit-value [(c u8)] (-> i64)
  (if (and (>= c (cast u8 48)) (<= c (cast u8 57)))
      (- (cast i64 c) 48)
      (if (and (>= c (cast u8 97)) (<= c (cast u8 102)))
          (- (cast i64 c) 87)
          (if (and (>= c (cast u8 65)) (<= c (cast u8 70))) (- (cast i64 c) 55) -1))))

;; Power-of-two radix integers need only their leading 53 bits, a guard bit and sticky remainder.
;; Round once, ties to even; repeated floating multiply/add would double-round long spellings.
;; `width` is the bits per digit (1, 3 or 4); `_` separators are skipped for the literal grammar.
(defn number-radix-value [(text (slice u8)) (start i64) (width i64)] (-> f64)
  (let [(mut i) start
        (mut bits) 0
        (mut head) 0
        (mut sticky) false]
    (loop (if (>= (load i) (len text))
              (break 0)
              (do
                (if (!= (get text (load i)) (cast u8 95))
                    (let [digit (number-digit-value (get text (load i)))
                          (mut shift) (- width 1)]
                      (loop (if (< (load shift) 0)
                                (break 0)
                                (let [bit (primitive/iand (primitive/ishr digit (load shift)) 1)]
                                  (if (or (> (load bits) 0) (= bit 1))
                                      (do
                                        (if (< (load bits) 1025)
                                            (set! (mut bits) (+ (load bits) 1))
                                            0)
                                        (if (<= (load bits) 54)
                                            (set! (mut head) (+ (primitive/ishl (load head) 1) bit))
                                            (if (= bit 1) (set! (mut sticky) true) 0)))
                                      0)
                                  (set! (mut shift) (- (load shift) 1))
                                  (continue)))))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (<= (load bits) 53)
        (primitive/cast f64 (load head))
        (let [(mut mantissa) (primitive/ishr (load head) 1)
              (mut exponent) (- (load bits) 1)]
          (if (and (= (primitive/iand (load head) 1) 1)
                   (or (load sticky) (= (primitive/iand (load mantissa) 1) 1)))
              (set! (mut mantissa) (+ (load mantissa) 1))
              0)
          (if (= (load mantissa) 9007199254740992)
              (do
                (set! (mut mantissa) (primitive/ishr (load mantissa) 1))
                (set! (mut exponent) (+ (load exponent) 1)))
              0)
          (if (> (load exponent) 1023)
              (number-infinity)
              (number-from-bits (+ (primitive/ishl (+ (load exponent) 1023) 52)
                                   (- (load mantissa) 4503599627370496))))))))

;; `strtod` over `text`, which must contain no NUL; `consumed` receives how many bytes it read.
(defn number-strtod! [(text (slice u8)) (consumed (ptr i64))] (-> f64)
  (let [a (alloc/malloc-allocator)
        (mut bytes) (al-new [u8] a)]
    (let [(mut i) 0]
      (loop (if (>= (load i) (len text))
                (break 0)
                (do (push! [u8] (mut bytes) (get text (load i)))
                    (set! (mut i) (+ (load i) 1))
                    (continue)))))
    (push! [u8] (mut bytes) (cast u8 0))
    (let [buf (primitive/cast (ptr i8) (slice-data (al-slice (load bytes))))
          end (primitive/alloc-stack (ptr i8))
          value (strtod buf end)]
      (set! consumed (- (primitive/cast i64 (load end)) (primitive/cast i64 buf)))
      (al-free! [u8] (mut bytes))
      value)))

(defn number--digit? [(c u8)] (-> bool)
  (and (>= c (cast u8 48)) (<= c (cast u8 57))))

;; Does `text` from `i` spell StrUnsignedDecimalLiteral exactly to its end?
;;   Infinity | DecimalDigits [. DecimalDigits?] [ExponentPart] | . DecimalDigits [ExponentPart]
(defn number--unsigned-decimal? [(text (slice u8)) (start i64)] (-> bool)
  (let [n (len text)
        (mut i) start
        (mut int-digits) 0
        (mut frac-digits) 0]
    (if (and (= (- n start) 8)
             (= (get text start) (cast u8 73))
             (= (get text (+ start 1)) (cast u8 110))
             (= (get text (+ start 2)) (cast u8 102))
             (= (get text (+ start 3)) (cast u8 105))
             (= (get text (+ start 4)) (cast u8 110))
             (= (get text (+ start 5)) (cast u8 105))
             (= (get text (+ start 6)) (cast u8 116))
             (= (get text (+ start 7)) (cast u8 121)))
        true
        (do
          (loop (if (and (< (load i) n) (number--digit? (get text (load i))))
                    (do (set! (mut int-digits) (+ (load int-digits) 1))
                        (set! (mut i) (+ (load i) 1))
                        (continue))
                    (break 0)))
          (if (and (< (load i) n) (= (get text (load i)) (cast u8 46)))
              (do
                (set! (mut i) (+ (load i) 1))
                (loop (if (and (< (load i) n) (number--digit? (get text (load i))))
                          (do (set! (mut frac-digits) (+ (load frac-digits) 1))
                              (set! (mut i) (+ (load i) 1))
                              (continue))
                          (break 0))))
              0)
          (if (= (+ (load int-digits) (load frac-digits)) 0)
              false
              (do
                ;; ExponentPart: e|E [+|-] DecimalDigits
                (if (and (< (load i) n)
                         (or (= (get text (load i)) (cast u8 101)) (= (get text (load i)) (cast u8 69))))
                    (let [(mut exp-digits) 0]
                      (set! (mut i) (+ (load i) 1))
                      (if (and (< (load i) n)
                               (or (= (get text (load i)) (cast u8 43)) (= (get text (load i)) (cast u8 45))))
                          (set! (mut i) (+ (load i) 1))
                          0)
                      (loop (if (and (< (load i) n) (number--digit? (get text (load i))))
                                (do (set! (mut exp-digits) (+ (load exp-digits) 1))
                                    (set! (mut i) (+ (load i) 1))
                                    (continue))
                                (break 0)))
                      (if (= (load exp-digits) 0) (set! (mut i) (+ n 1)) 0))
                    0)
                (= (load i) n)))))))

;; Are the bytes from `start` all digits of the given radix, and at least one?
(defn number--radix-digits? [(text (slice u8)) (start i64) (radix i64)] (-> bool)
  (let [n (len text) (mut i) start (mut ok) (< start n)]
    (loop (if (or (not (load ok)) (>= (load i) n))
              (break 0)
              (let [d (number-digit-value (get text (load i)))]
                (if (or (< d 0) (>= d radix)) (set! (mut ok) false) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load ok)))

;; StringToNumber over the trimmed ASCII spelling (the caller trims StrWhiteSpace and hands over
;; only ASCII: a non-ASCII character can be nothing but NaN once the whitespace is gone).
(defn number-string-to-number [(text (slice u8))] (-> f64)
  (let [n (len text)]
    (if (= n 0)
        (primitive/cast f64 0)
        (if (and (> n 2) (= (get text 0) (cast u8 48))
                 (or (= (get text 1) (cast u8 120)) (= (get text 1) (cast u8 88))))
            (if (number--radix-digits? text 2 16) (number-radix-value text 2 4) (number-nan))
            (if (and (> n 2) (= (get text 0) (cast u8 48))
                     (or (= (get text 1) (cast u8 111)) (= (get text 1) (cast u8 79))))
                (if (number--radix-digits? text 2 8) (number-radix-value text 2 3) (number-nan))
                (if (and (> n 2) (= (get text 0) (cast u8 48))
                         (or (= (get text 1) (cast u8 98)) (= (get text 1) (cast u8 66))))
                    (if (number--radix-digits? text 2 2) (number-radix-value text 2 1) (number-nan))
                    (let [signed (or (= (get text 0) (cast u8 43)) (= (get text 0) (cast u8 45)))
                          negative (= (get text 0) (cast u8 45))
                          start (if signed 1 0)]
                      (if (not (number--unsigned-decimal? text start))
                          (number-nan)
                          (if (and (= (- n start) 8) (= (get text start) (cast u8 73)))
                              (if negative (- (primitive/cast f64 0) (number-infinity)) (number-infinity))
                              (let [consumed (primitive/alloc-stack i64)
                                    value (number-strtod! text consumed)]
                                value))))))))))

;; The NaN-box word of a Number: a compact signed-48 immediate when the value is an integer that
;; fits and is not -0 (the compiler's own rule for literals), else the raw binary64 bits.
(defn number-word [(x f64)] (-> i64)
  (let [bits (number-bits x)
        exponent (primitive/iand (primitive/ishr bits 52) 0x7ff)]
    ;; NaN, the infinities and every magnitude of 2^47 or more are raw bits; the cast below is only
    ;; taken where it cannot trap.
    (if (or (= exponent 0x7ff) (>= exponent (+ 1023 47)))
        bits
        (let [truncated (primitive/cast i64 x)]
          (if (and (primitive/fcmp-eq (primitive/cast f64 truncated) x)
                   (!= bits -9223372036854775808))
              (+ 0x7ff9000000000000 (primitive/iand truncated 0x0000ffffffffffff))
              bits)))))
