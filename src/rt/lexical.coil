;; Realm lexical cells: top-level let and const storage with its initialization state.

(module aot.rt.lexical)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.mem" :as mem)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :as io)
(import "coil.os" :as os)
(import "coil.time" :as time)
(import "aot.util.panic" :use *)
(import "aot.rt.abi" :use *)
(import "aot.rt.shapes" :use *)
(import "aot.rt.layout" :use *)
(import "aot.rt.heap" :use *)

;; Final Simple ScopeNode maps parser variables to graph inputs, with lexical depth tracking;
;; it has no native shared global declarative record. Our independently compiled Scripts need
;; realm-owned cells after their initializer frames return. Names use the program's remapped
;; string-key identities. Slots are one-based, stable until realm destruction, and never deleted
;; (global let/const/class bindings are non-deletable). Zero from find means an absent binding.
;;
;; These are storage primitives, not JS exception implementations. JSL must check initialized /
;; writable state and produce ReferenceError / TypeError completions before value access. The
;; assertions here guard that contract. Creation/initialization preconditions also belong to
;; Script declaration instantiation. Malloc growth cannot collect JS values; initialized cells
;; are explicit roots scanned by minor and major GC, so writes need no heap remembered card.
(defn rt-global-lexical-find [(key i64)] (-> i64)
  (if (or (not (.booted (rt-heap))) (not (shapes-booted?)))
      (panic "rt-global-lexical-find: realm is not booted")
      0)
  (if (or (<= key 0) (> key (shapes-key-count)))
      (panic "rt-global-lexical-find: invalid program key")
      0)
  (match (get (.global-lexical-slots (rt-heap)) key)
    (Some [slot] slot)
    (None [] 0)))

(defn rt-global-lexical-cell [(slot i64)] (-> (ptr RtGlobalLexical))
  (let [heap (rt-heap)]
    (if (or (not (.booted heap))
            (<= slot 0)
            (> slot (len (.global-lexicals heap))))
        (panic "rt-global-lexical-cell: invalid realm slot")
        0)
    (al-elem (field heap global-lexicals) (- slot 1))))

(defn rt-global-lexical-create! [(key i64) (writable bool)] (-> i64)
  (if (!= (rt-global-lexical-find key) 0)
      (panic "rt-global-lexical-create!: binding already exists")
      0)
  (let [heap (rt-heap)
        slot (+ (len (.global-lexicals heap)) 1)]
    (push! [RtGlobalLexical]
           (mut (.global-lexicals heap))
           (RtGlobalLexical
             :value RT-DYNAMIC-UNDEFINED-WORD
             :initialized false
             :writable writable))
    (set! (mut (.global-lexical-slots heap)) key slot)
    slot))

(defn rt-global-lexical-state [(slot i64)] (-> i64)
  (let [cell (rt-global-lexical-cell slot)]
    (| (if (.initialized cell) RT-LEXICAL-INITIALIZED 0)
       (if (.writable cell) RT-LEXICAL-WRITABLE 0))))

;; Native primitive operands use 64-bit words, including this Boolean flag.
(defn rt-global-lexical-create-word [(key i64) (writable i64)] (-> i64)
  (if (and (!= writable 0) (!= writable 1))
      (panic "rt-global-lexical-create-word: writable flag must be zero or one")
      0)
  (rt-global-lexical-create! key (= writable 1)))

(defn rt-global-lexical-value [(slot i64)] (-> i64)
  (let [cell (rt-global-lexical-cell slot)]
    (if (not (.initialized cell))
        (panic "rt-global-lexical-value: uninitialized binding")
        0)
    (.value cell)))

(defn rt-global-lexical-initialize! [(slot i64) (value i64)] (-> i64)
  (let [cell (rt-global-lexical-cell slot)]
    (if (.initialized cell)
        (panic "rt-global-lexical-initialize!: binding already initialized")
        0)
    (set! (.value cell) value)
    (set! (.initialized cell) true)
    value))

(defn rt-global-lexical-store! [(slot i64) (value i64)] (-> i64)
  (let [cell (rt-global-lexical-cell slot)]
    (if (not (.initialized cell))
        (panic "rt-global-lexical-store!: uninitialized binding")
        0)
    (if (not (.writable cell))
        (panic "rt-global-lexical-store!: immutable binding")
        0)
    (set! (.value cell) value)
    value))
