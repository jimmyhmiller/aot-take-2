;; The runtime heap record as the generated code sees it.
;;
;; Emitted allocation fast paths read `RtHeap` fields through the heap-state register, so the
;; struct's layout is an ABI shared by `src/rt/rt.coil` (which owns the record) and the target
;; encoders (which bake field offsets into instructions). Both sides import the layout from here
;; and name fields through the offset constants below, which the compiler folds from the struct
;; itself. Reordering a field can therefore never desynchronize the two sides: the encoder reads
;; the same number the runtime lays out, and `rt-heap-abi-check!` refuses an offset the load and
;; store immediates cannot express.
(module aot.rt.abi)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "aot.util.panic" :use *)

(defstruct RtStaticImage [(base i64) (bytes i64) (entries i64)])

;; Non-deletable global lexical cells belong to one execution realm. Generated references
;; retain a slot, never a pointer into the growable array. State is independent of value bits.
(defstruct RtGlobalLexical [(value i64) (initialized bool) (writable bool)])
(const RT-LEXICAL-INITIALIZED 1)
(const RT-LEXICAL-WRITABLE 2)

(defstruct RtHeap
  [(from (ptr u8))
   (young-other (ptr u8))
   (to (ptr u8))
   (old-other (ptr u8))
   (cards (ptr u8))
   (other-cards (ptr u8))
   (starts (ptr i64))
   (other-starts (ptr i64))
   (card-count i64)
   (capacity i64)
   (old-capacity i64)
   (used i64)
   (young-copied-used i64)
   (young-scan i64)
   (to-used i64)
   (scan i64)
   (copied-used i64)
   (major bool)
   (force-major bool)
   (stress bool)
   ;; `AOT_RT_GC_VERIFY`: check every frame root and every heap reference word before and after
   ;; each collection, naming the first stale pointer by frame, return PC and slot.
   (verify bool)
   (booted bool)
   (fast-disabled i64)
   ;; The realm's global object as a boxed word, published once by the entry code and forwarded
   ;; as a root by every collection. Zero means no realm has started.
   (global-object i64)
   ;; The pending exception: the thrown boxed word while a throw is unwinding (a function that
   ;; throws returns the exception sentinel and leaves the value here), zero otherwise; forwarded
   ;; as a root while nonzero. Generated code reads and writes it as memory.
   (exception-value i64)
   ;; Installed text selects its stable slot in this realm-owned table. Slot zero belongs to
   ;; linked executables; positive slots belong to registered code installations.
   (unit-bases (ptr i64))
   (unit-count i64)
   ;; Local static-object ordinals resolve through a realm-owned payload-address map. Keeping
   ;; this separate from image bases lets assembly bind object identity independently of layout.
   (unit-objects (ptr i64))
   (object-maps (ArrayList (slice i64)))
   ;; Slot-indexed pointers to immutable local-to-program identity arrays. Explicit maps are
   ;; borrowed from RtProgram; identity maps for ordinary linked programs are realm-owned.
   (unit-keys (ptr i64))
   (unit-shapes (ptr i64))
   (default-keys (slice i64))
   (default-shapes (slice i64))
   ;; Borrowed, relocated data regions. All remain roots until realm destruction; the owner must
   ;; retain their bytes for that lifetime. The realm owns only the registry, never these bytes.
   (static-images (ArrayList RtStaticImage))
   (object-bindings-finalized bool)
   (object-properties-finalized bool)
   (assembling-properties bool)
   (global-lexicals (ArrayList RtGlobalLexical))
   (global-lexical-slots (HashMap i64 i64))])

;; Resolved, realm-local payload addresses supplied by the assembler before execution. Targets
;; must be terminal canonical objects, not other sources in this batch. The compiler/assembler
;; owns semantic authorization; the runtime checks storage, layout and local injectivity.
(defstruct RtObjectBinding [(source i64) (target i64)])

;; Metadata supplied by an in-memory program. A zero text address selects the linked executable
;; adapter. This descriptor borrows installed storage until the execution has returned.
(defstruct RtProgramUnit
  [(code-id i64) (image (ptr u8)) (image-bytes i64)
   (keys (slice i64)) (shape-ids (slice i64))])

(defstruct RtProgram
  [(text (ptr u8)) (text-bytes u64)
   (maps (ptr u8)) (map-bytes u64)
   (shapes (ptr u8)) (shape-bytes u64)
   (image (ptr u8)) (image-bytes u64)
   (code-id i64) (units (slice RtProgramUnit))
   (keys (slice i64)) (shape-ids (slice i64))
   (object-bindings (slice RtObjectBinding))
   ;; Property unions run after identity binding, before Script execution. Both objects must
   ;; be adopted ordinary/function payloads with canonicalized prototype/value references.
   (object-property-merges (slice RtObjectBinding))])

(defn rt-program [] (-> (ptr RtProgram))
  (primitive/alloc-static RtProgram))

;; A collecting call carries a local map ID in the low word and an installed-code identity in
;; the high word. Code identity zero is the ordinary linked executable. Installation supplies
;; positive identities without changing immutable stack-map records or compiler-local node IDs.
(const RT-CODE-ID-LIMIT 0x7fffffff)
(const RT-LOCAL-MAP-ID-LIMIT 0xffffffff)

(defn rt-map-token [(code-id i64) (local-id i64)] (-> i64)
  (if (or (< code-id 0) (> code-id RT-CODE-ID-LIMIT)
          (<= local-id 0) (> local-id RT-LOCAL-MAP-ID-LIMIT))
      (panic "rt-map-token: code or local map identity is outside the ABI") 0)
  (| (primitive/ishl code-id 32) local-id))

;; Byte offsets of the fields generated code touches.
(const RT-HEAP-OFFSET-FROM (primitive/offsetof RtHeap from))
(const RT-HEAP-OFFSET-CAPACITY (primitive/offsetof RtHeap capacity))
(const RT-HEAP-OFFSET-USED (primitive/offsetof RtHeap used))
(const RT-HEAP-OFFSET-FAST-DISABLED (primitive/offsetof RtHeap fast-disabled))
(const RT-HEAP-OFFSET-GLOBAL-OBJECT (primitive/offsetof RtHeap global-object))
(const RT-HEAP-OFFSET-EXCEPTION-VALUE (primitive/offsetof RtHeap exception-value))
(const RT-HEAP-OFFSET-UNIT-BASES (primitive/offsetof RtHeap unit-bases))
(const RT-HEAP-OFFSET-UNIT-OBJECTS (primitive/offsetof RtHeap unit-objects))
(const RT-HEAP-OFFSET-UNIT-KEYS (primitive/offsetof RtHeap unit-keys))
(const RT-HEAP-OFFSET-UNIT-SHAPES (primitive/offsetof RtHeap unit-shapes))

;; An unsigned-offset LDR/STR of a 64-bit register scales its 12-bit immediate by eight.
(const RT-HEAP-MAX-ENCODABLE-OFFSET (* 8 4095))

(defn rt-heap-abi-offset-ok? [(offset i64)] (-> bool)
  (and (= (% offset 8) 0) (>= offset 0) (<= offset RT-HEAP-MAX-ENCODABLE-OFFSET)))

;; Every offset the encoders bake in must be a scaled 12-bit immediate.
(defn rt-heap-abi-check! [] (-> i64)
  (if (and (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-FROM)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-CAPACITY)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-USED)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-FAST-DISABLED)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-GLOBAL-OBJECT)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-EXCEPTION-VALUE)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-UNIT-BASES)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-UNIT-OBJECTS)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-UNIT-KEYS)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-UNIT-SHAPES))
      0
      (do (panic "rt-heap-abi-check!: an RtHeap field the generated code reads is not a scaled 12-bit offset") 0)))
