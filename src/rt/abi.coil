;; The runtime heap record as the generated code sees it.
;;
;; Emitted allocation fast paths read `RtHeap` fields through the heap-state register, so the
;; struct's layout is an ABI shared by `src/rt/rt.coil` (which owns the record) and the target
;; encoders (which bake field offsets into instructions). Both sides import the layout from here
;; and name fields through the offset constants below, which the compiler folds from the struct
;; itself. Reordering a field can therefore never desynchronize the two sides: the encoder reads
;; the same number the runtime lays out, and `rt-heap-abi-check!` refuses an offset the load and
;; store immediates cannot express.
(module aot.rt.abi)
(import "coil.primitive" :as primitive)
(import "aot.util.panic" :use *)

(defstruct RtHeap
  [(from (ptr u8))
   (young-other (ptr u8))
   (to (ptr u8))
   (old-other (ptr u8))
   (cards (ptr u8))
   (other-cards (ptr u8))
   (starts (ptr i64))
   (other-starts (ptr i64))
   (card-count i64)
   (capacity i64)
   (old-capacity i64)
   (used i64)
   (young-copied-used i64)
   (young-scan i64)
   (to-used i64)
   (scan i64)
   (copied-used i64)
   (major bool)
   (force-major bool)
   (stress bool)
   ;; `AOT_RT_GC_VERIFY`: check every frame root and every heap reference word before and after
   ;; each collection, naming the first stale pointer by frame, return PC and slot.
   (verify bool)
   (booted bool)
   (fast-disabled i64)
   ;; The realm's global object as a boxed word, published once by the entry code and forwarded
   ;; as a root by every collection. Zero means no realm has started.
   (global-object i64)
   ;; The pending exception: the thrown boxed word while a throw is unwinding (a function that
   ;; throws returns the exception sentinel and leaves the value here), zero otherwise; forwarded
   ;; as a root while nonzero. Generated code reads and writes it as memory.
   (exception-value i64)
   ;; The static heap image (`__aot_heap`, aot.heap): the realm's initial objects, relocated in
   ;; place at boot, never moved, scanned as roots by every collection. Zero when the program has
   ;; no image.
   (static-base i64)
   (static-bytes i64)
   (static-entries i64)])

;; Byte offsets of the fields generated code touches.
(const RT-HEAP-OFFSET-FROM (primitive/offsetof RtHeap from))
(const RT-HEAP-OFFSET-CAPACITY (primitive/offsetof RtHeap capacity))
(const RT-HEAP-OFFSET-USED (primitive/offsetof RtHeap used))
(const RT-HEAP-OFFSET-FAST-DISABLED (primitive/offsetof RtHeap fast-disabled))
(const RT-HEAP-OFFSET-GLOBAL-OBJECT (primitive/offsetof RtHeap global-object))
(const RT-HEAP-OFFSET-EXCEPTION-VALUE (primitive/offsetof RtHeap exception-value))

;; An unsigned-offset LDR/STR of a 64-bit register scales its 12-bit immediate by eight.
(const RT-HEAP-MAX-ENCODABLE-OFFSET (* 8 4095))

(defn rt-heap-abi-offset-ok? [(offset i64)] (-> bool)
  (and (= (% offset 8) 0) (>= offset 0) (<= offset RT-HEAP-MAX-ENCODABLE-OFFSET)))

;; Every offset the encoders bake in must be a scaled 12-bit immediate.
(defn rt-heap-abi-check! [] (-> i64)
  (if (and (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-FROM)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-CAPACITY)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-USED)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-FAST-DISABLED)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-GLOBAL-OBJECT)
           (rt-heap-abi-offset-ok? RT-HEAP-OFFSET-EXCEPTION-VALUE))
      0
      (do (panic "rt-heap-abi-check!: an RtHeap field the generated code reads is not a scaled 12-bit offset") 0)))
