;; Symbol values: creation, keys and descriptions.

(module aot.rt.symbol)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.mem" :as mem)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :as io)
(import "coil.os" :as os)
(import "coil.time" :as time)
(import "aot.rt.shapes" :use *)
(import "aot.rt.layout" :use *)
(import "aot.rt.heap" :use *)
(import "aot.rt.gc" :use *)

;; Symbol(description) (ECMA-262 §20.4.1.1): a fresh Symbol, whose identity is the allocation
;; itself — two Symbols are the same value exactly when they are the same allocation, which is why
;; the collector forwards the word like any other reference. Its payload holds the description it
;; was created with, a boxed string or the boxed undefined, and nothing else: a Symbol has no
;; properties of its own, and its prototype methods reach %Symbol.prototype% through the boxed
;; value's family, never through a stored word. Returns the raw payload, which the caller boxes.
(defn rt-symbol-new [(description i64) (map-id i64) (caller-sp i64)] (-> i64)
  (let [desc-root (primitive/alloc-stack i64)]
    (set! desc-root description)
    (rt-heap-boot!)
    (let [sym
            (rt-alloc-rooted RT-SYMBOL-PAYLOAD-BYTES
                             SHAPES-ROOT
                             map-id
                             caller-sp
                             desc-root
                             (primitive/cast (ptr i64) 0)
                             true)
          moved (load desc-root)]
      (set! (primitive/cast (ptr i64) (+ sym RT-OFFSET-SYMBOL-DESCRIPTION))
            moved)
      (aot-rt-write-barrier sym moved RT-BARRIER-BOXED)
      ;; Its property key word starts unminted; `rt-symbol-key` fills it the first time the Symbol
      ;; is used as one. The word the collector scans beside the description is therefore always a
      ;; raw integer, never a reference it would have to forward.
      (set! (primitive/cast (ptr i64) (+ sym RT-OFFSET-SYMBOL-KEY)) 0)
      sym)))

;; The property key this Symbol is (`%SymbolKey`), minted on first use and stable after it. A
;; well-known Symbol is image data whose key word is unminted for the same reason: key ids are the
;; running program's, and the image is written before it starts.
(defn rt-symbol-key [(symbol i64)] (-> i64)
  (let [existing
          (load (primitive/cast (ptr i64) (+ symbol RT-OFFSET-SYMBOL-KEY)))]
    (if (!= existing 0)
        existing
        (let [minted (shapes-mint-symbol-key!)]
          (set! (primitive/cast (ptr i64) (+ symbol RT-OFFSET-SYMBOL-KEY))
                minted)
          minted))))

;; The description a Symbol was created with, for `description` and `toString`.
(defn rt-symbol-description [(symbol i64)] (-> i64)
  (load (primitive/cast (ptr i64) (+ symbol RT-OFFSET-SYMBOL-DESCRIPTION))))
