;; The runtime's hidden-class tree: the compiler's static shapes, then the ones programs make.

;;
;; `aot.shape` builds the transition tree the compiler proves things about: every object literal,
;; every statically visible store, every global-object layout has a shape id there, and a fast
;; path is a Load at an offset that id fixes. That tree is emitted into the object file as the
;; `__aot_shapes` blob and is the first `static-count` entries of this one.
;;
;; A store the compiler could not see — `assert.sameValue = ...` on an object read from a global,
;; a property added inside a function whose receiver has many shapes — adds a property at run
;; time. Enumerating every compile-time shape at such a site is unsound (a later store's transition
;; is a shape the site never tests for) and unbounded (k dynamic keys on n shapes reach n·k!
;; layouts). So the generic path is the same tree, continued at run time: `shapes-transition`
;; memoises `(parent, key)` exactly as the compiler does, and a shape it creates has an id past
;; every static one, so no fast path can mistake it for a layout it proved.
;;
;; Offsets follow the compiler's rule — a field's offset is fixed by the edge introducing it and
;; inherited by every descendant — so a static fast path and a runtime lookup on a static shape
;; name the same word.
;;
;; Blob layout (little-endian), written by `shape-table-bytes`:
;;   0   "AOTSHAPE"
;;   8   u32 version (2), u32 shape count (slot 0 invalid, slot 1 the field-less root)
;;   16  u32 key count (slot 0 invalid), u32 name bytes
;;   24  per shape: u32 parent, u32 key, u32 byte offset (all ones for a marker row), u32 field
;;       count, u32 attributes (SHAPES-ATTR-*), u32 flags (SHAPES-FLAG-*)
;;       per key: u32 name offset, u32 name length
;;       name bytes
;;
;; Attributes ride on the edge that introduces a field (aot.shape): a key with different
;; attributes is a different shape. A marker row (key zero) adds no field and carries the
;; non-extensible flag, which every descendant inherits.
(module aot.rt.shapes)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use [slice-new])
(import "aot.util.panic" :use *)

;; The field-less root; every object starts here. Agrees with `SHAPE-EMPTY`.
(const SHAPES-ROOT 1)

(const SHAPES-VERSION 2)

(const SHAPES-HEADER-BYTES 24)

(const SHAPES-RECORD-BYTES 24)

(const SHAPES-ATTR-WRITABLE 1)

(const SHAPES-ATTR-ENUMERABLE 2)

(const SHAPES-ATTR-CONFIGURABLE 4)

(const SHAPES-ATTR-ACCESSOR 8)

(const SHAPES-ATTRS-DEFAULT 7)

(const SHAPES-FLAG-NONEXTENSIBLE 1)

(const SHAPES-KEY-RECORD-BYTES 8)

(const SHAPES-WORD-BYTES 8)

(defstruct RtShapes
  [(blob (ptr u8))
   (blob-bytes i64)
   (static-count i64)
   (key-count i64)
   (name-bytes i64)
   (parent (ArrayList i64))
   (key (ArrayList i64))
   (offset (ArrayList i64))
   (field-count (ArrayList i64))
   (attrs (ArrayList i64))
   (flags (ArrayList i64))
   (runtime-keys (ArrayList (slice u8)))  ; names interned at run time, ids past the static ones
   (booted bool)])

(defn rt-shapes [] (-> (ptr RtShapes))
  (primitive/alloc-static RtShapes))

(defn shapes-read-u32 [(p (ptr u8)) (off i64)] (-> i64)
  (| (primitive/cast i64 (load (primitive/index p off)))
     (| (primitive/ishl (primitive/cast i64 (load (primitive/index p (+ off 1)))) 8)
        (| (primitive/ishl (primitive/cast i64 (load (primitive/index p (+ off 2)))) 16)
           (primitive/ishl (primitive/cast i64 (load (primitive/index p (+ off 3)))) 24)))))

(defn shapes-blob-magic? [(p (ptr u8))] (-> bool)
  (and (= (primitive/cast i64 (load (primitive/index p 0))) 0x41)
       (and (= (primitive/cast i64 (load (primitive/index p 1))) 0x4f)
            (and (= (primitive/cast i64 (load (primitive/index p 2))) 0x54)
                 (and (= (primitive/cast i64 (load (primitive/index p 3))) 0x53)
                      (and (= (primitive/cast i64 (load (primitive/index p 4))) 0x48)
                           (and (= (primitive/cast i64 (load (primitive/index p 5))) 0x41)
                                (and (= (primitive/cast i64 (load (primitive/index p 6))) 0x50)
                                     (= (primitive/cast i64 (load (primitive/index p 7))) 0x45)))))))))

;; Adopt the static table. A null blob is a program that made no shapes: the tree is the root
;; alone and keys start after the invalid slot.
(defn shapes-boot! [(blob (ptr u8)) (bytes i64)] (-> i64)
  (let [s (rt-shapes)]
    (if (.booted s)
        0
        (let [a (alloc/malloc-allocator)]
          (set! (.parent s) (al-new [i64] a))
          (set! (.key s) (al-new [i64] a))
          (set! (.offset s) (al-new [i64] a))
          (set! (.field-count s) (al-new [i64] a))
          (set! (.attrs s) (al-new [i64] a))
          (set! (.flags s) (al-new [i64] a))
          (set! (.runtime-keys s) (al-new [(slice u8)] a))
          (if (= (primitive/cast i64 blob) 0)
              (do
                (set! (.blob s) blob)
                (set! (.blob-bytes s) 0)
                (set! (.static-count s) (+ SHAPES-ROOT 1))
                (set! (.key-count s) 1)
                (set! (.name-bytes s) 0)
                0)
              (do
                (if (< bytes SHAPES-HEADER-BYTES)
                    (panic-i "shapes-boot!: __aot_shapes is shorter than its header" bytes)
                    0)
                (if (not (shapes-blob-magic? blob))
                    (panic "shapes-boot!: __aot_shapes has the wrong magic")
                    0)
                (if (!= (shapes-read-u32 blob 8) SHAPES-VERSION)
                    (panic-i "shapes-boot!: unsupported __aot_shapes version" (shapes-read-u32 blob 8))
                    0)
                (set! (.blob s) blob)
                (set! (.blob-bytes s) bytes)
                (set! (.static-count s) (shapes-read-u32 blob 12))
                (set! (.key-count s) (shapes-read-u32 blob 16))
                (set! (.name-bytes s) (shapes-read-u32 blob 20))
                (if (< (.static-count s) (+ SHAPES-ROOT 1))
                    (panic-i "shapes-boot!: static table lacks the root" (.static-count s))
                    0)
                (if (!= bytes
                        (+ SHAPES-HEADER-BYTES
                           (+ (* (.static-count s) SHAPES-RECORD-BYTES)
                              (+ (* (.key-count s) SHAPES-KEY-RECORD-BYTES) (.name-bytes s)))))
                    (panic-i "shapes-boot!: __aot_shapes size disagrees with its counts" bytes)
                    0)
                0))
          (set! (.booted s) true)
          0))))

(defn shapes-booted? [] (-> bool)
  (.booted (rt-shapes)))

;; Every shape id in existence: static ones then runtime ones, contiguous.
(defn shapes-count [] (-> i64)
  (let [s (rt-shapes)] (+ (.static-count s) (len (.parent s)))))

(defn shapes-valid? [(shape i64)] (-> bool)
  (and (>= shape SHAPES-ROOT) (< shape (shapes-count))))

(defn shapes-check! [(shape i64) (who (slice u8))] (-> i64)
  (if (shapes-valid? shape) 0 (panic-i who shape)))

(defn shapes-static-field [(shape i64) (field i64)] (-> i64)
  (let [s (rt-shapes)]
    (shapes-read-u32 (.blob s) (+ SHAPES-HEADER-BYTES (+ (* shape SHAPES-RECORD-BYTES) (* field 4))))))

(defn shapes-parent [(shape i64)] (-> i64)
  (let [s (rt-shapes)]
    (shapes-check! shape "shapes-parent: invalid shape")
    (if (< shape (.static-count s))
        (shapes-static-field shape 0)
        (get (.parent s) (- shape (.static-count s))))))

;; The key the edge into `shape` introduced; zero for the root.
(defn shapes-key [(shape i64)] (-> i64)
  (let [s (rt-shapes)]
    (shapes-check! shape "shapes-key: invalid shape")
    (if (< shape (.static-count s))
        (shapes-static-field shape 1)
        (get (.key s) (- shape (.static-count s))))))

;; The byte offset of the field the edge into `shape` introduced; -1 for a marker row.
(defn shapes-offset [(shape i64)] (-> i64)
  (let [s (rt-shapes)]
    (shapes-check! shape "shapes-offset: invalid shape")
    (if (< shape (.static-count s))
        (let [raw (shapes-static-field shape 2)] (if (= raw 0xffffffff) -1 raw))
        (get (.offset s) (- shape (.static-count s))))))

(defn shapes-attrs [(shape i64)] (-> i64)
  (let [s (rt-shapes)]
    (shapes-check! shape "shapes-attrs: invalid shape")
    (if (< shape (.static-count s))
        (shapes-static-field shape 4)
        (get (.attrs s) (- shape (.static-count s))))))

(defn shapes-flags [(shape i64)] (-> i64)
  (let [s (rt-shapes)]
    (shapes-check! shape "shapes-flags: invalid shape")
    (if (< shape (.static-count s))
        (shapes-static-field shape 5)
        (get (.flags s) (- shape (.static-count s))))))

(defn shapes-extensible? [(shape i64)] (-> bool)
  (= (& (shapes-flags shape) SHAPES-FLAG-NONEXTENSIBLE) 0))

(defn shapes-field-count [(shape i64)] (-> i64)
  (let [s (rt-shapes)]
    (shapes-check! shape "shapes-field-count: invalid shape")
    (if (< shape (.static-count s))
        (shapes-static-field shape 3)
        (get (.field-count s) (- shape (.static-count s))))))

;; Every key id in existence: the compiler's, then the ones interned at run time, contiguous.
(defn shapes-key-count [] (-> i64)
  (let [s (rt-shapes)] (+ (- (.key-count s) 1) (len (.runtime-keys s)))))

;; The UTF-8 name of a key: a static one straight from the blob, a runtime one from its copy.
(defn shapes-key-name [(key i64)] (-> (slice u8))
  (let [s (rt-shapes)]
    (if (or (<= key 0) (> key (shapes-key-count)))
        (do (panic-i "shapes-key-name: invalid key" key) "")
        (if (>= key (.key-count s))
            (get (.runtime-keys s) (- key (.key-count s)))
            (let [records (+ SHAPES-HEADER-BYTES (* (.static-count s) SHAPES-RECORD-BYTES))
                  entry (+ records (* key SHAPES-KEY-RECORD-BYTES))
                  off (shapes-read-u32 (.blob s) entry)
                  ln (shapes-read-u32 (.blob s) (+ entry 4))
                  names (+ records (* (.key-count s) SHAPES-KEY-RECORD-BYTES))]
              (slice-new (primitive/index (.blob s) (+ names off)) ln))))))

(defn shapes-bytes-eq? [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (len a) (len b))
      false
      (let [(mut i) 0 (mut same) true]
        (loop (if (or (>= (load i) (len a)) (not (load same)))
                  (break 0)
                  (do
                    (if (!= (get a (load i)) (get b (load i))) (set! (mut same) false) 0)
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (load same))))

;; The key id of a UTF-8 name: the compiler's id when it interned the name, else a runtime id,
;; minted once (property keys are identities; the runtime tree transitions on them). Linear, as the
;; compiler's table is; the copy of a new name is the runtime's own.
(defn shapes-intern-key [(name (slice u8))] (-> i64)
  (let [s (rt-shapes)
        count (shapes-key-count)
        (mut key) 1
        (mut found) 0]
    (loop (if (or (> (load key) count) (!= (load found) 0))
              (break 0)
              (do
                (if (shapes-bytes-eq? (shapes-key-name (load key)) name)
                    (set! (mut found) (load key))
                    (set! (mut key) (+ (load key) 1)))
                (continue))))
    (if (!= (load found) 0)
        (load found)
        (let [a (alloc/malloc-allocator)
              (mut copy) (al-new [u8] a)
              (mut i) 0]
          (loop (if (>= (load i) (len name))
                    (break 0)
                    (do (push! [u8] (mut copy) (get name (load i))) (set! (mut i) (+ (load i) 1)) (continue))))
          (push! [(slice u8)] (mut (.runtime-keys s)) (al-slice (load copy)))
          (+ count 1)))))

;; The row introducing `key` into `shape`, or 0. Walks toward the root: a field is found at the
;; edge that introduced it; marker rows (key zero) are passed over.
(defn shapes-find-row [(shape0 i64) (key i64)] (-> i64)
  (let [(mut shape) shape0 (mut answer) 0]
    (shapes-check! shape0 "shapes-find-row: invalid shape")
    (if (<= key 0) (panic-i "shapes-find-row: invalid key" key) 0)
    (loop (if (or (= (load shape) SHAPES-ROOT) (!= (load answer) 0))
              (break 0)
              (do
                (if (= (shapes-key (load shape)) key)
                    (set! (mut answer) (load shape))
                    (set! (mut shape) (shapes-parent (load shape))))
                (continue))))
    (load answer)))

;; The byte offset of `key` in `shape`, or -1 when the shape has no such field.
(defn shapes-lookup-offset [(shape i64) (key i64)] (-> i64)
  (let [row (shapes-find-row shape key)]
    (if (= row 0) -1 (shapes-offset row))))

;; The attributes of `key` in `shape`, or -1 when the shape has no such field.
(defn shapes-lookup-attrs [(shape i64) (key i64)] (-> i64)
  (let [row (shapes-find-row shape key)]
    (if (= row 0) -1 (shapes-attrs row))))

(defn shapes-has-key? [(shape i64) (key i64)] (-> bool)
  (>= (shapes-lookup-offset shape key) 0))

;; Follow (or create) the edge adding `key` to `shape` as a default data property, memoised on
;; `(shape, key, attrs)` so identical property orders share a layout and its transition. Adding a
;; present key changes no layout.
(defn shapes-transition [(shape i64) (key i64)] (-> i64)
  (shapes-transition-attrs shape key SHAPES-ATTRS-DEFAULT))

(defn shapes-transition-attrs [(shape i64) (key i64) (attrs i64)] (-> i64)
  (do
    (shapes-check! shape "shapes-transition: invalid parent shape")
    (if (<= key 0) (panic-i "shapes-transition: invalid key" key) 0)
    (if (not (shapes-extensible? shape)) (panic "shapes-transition: the shape is not extensible") 0)
    (if (shapes-has-key? shape key)
        shape
        (let [s (rt-shapes)
              count (shapes-count)
              (mut child) (+ SHAPES-ROOT 1)
              (mut found) 0]
          ;; Linear over all shapes, as the compiler's table is: transitions are cold next to the
          ;; accesses they serve. A per-parent index can replace this without changing identities.
          (loop (if (or (>= (load child) count) (!= (load found) 0))
                    (break 0)
                    (do
                      (if (and (= (shapes-parent (load child)) shape)
                               (and (= (shapes-key (load child)) key)
                                    (= (shapes-attrs (load child)) attrs)))
                          (set! (mut found) (load child))
                          (set! (mut child) (+ (load child) 1)))
                      (continue))))
          (if (!= (load found) 0)
              (load found)
              (let [fields (shapes-field-count shape)]
                (push! [i64] (mut (.parent s)) shape)
                (push! [i64] (mut (.key s)) key)
                (push! [i64] (mut (.offset s)) (* fields SHAPES-WORD-BYTES))
                (push! [i64] (mut (.field-count s)) (+ fields 1))
                (push! [i64] (mut (.attrs s)) attrs)
                (push! [i64] (mut (.flags s)) (shapes-flags shape))
                count))))))

;; [[PreventExtensions]]: the marker child of `shape`, memoised.
(defn shapes-prevent-extensions [(shape i64)] (-> i64)
  (do
    (shapes-check! shape "shapes-prevent-extensions: invalid shape")
    (if (not (shapes-extensible? shape))
        shape
        (let [s (rt-shapes)
              count (shapes-count)
              (mut child) (+ SHAPES-ROOT 1)
              (mut found) 0]
          (loop (if (or (>= (load child) count) (!= (load found) 0))
                    (break 0)
                    (do
                      (if (and (= (shapes-parent (load child)) shape)
                               (and (= (shapes-key (load child)) 0)
                                    (!= (& (shapes-flags (load child)) SHAPES-FLAG-NONEXTENSIBLE) 0)))
                          (set! (mut found) (load child))
                          (set! (mut child) (+ (load child) 1)))
                      (continue))))
          (if (!= (load found) 0)
              (load found)
              (do
                (push! [i64] (mut (.parent s)) shape)
                (push! [i64] (mut (.key s)) 0)
                (push! [i64] (mut (.offset s)) -1)
                (push! [i64] (mut (.field-count s)) (shapes-field-count shape))
                (push! [i64] (mut (.attrs s)) 0)
                (push! [i64] (mut (.flags s)) (| (shapes-flags shape) SHAPES-FLAG-NONEXTENSIBLE))
                count))))))

;; The shape with `shape`'s fields, order and flags, except that `key` carries `attrs`: the
;; layout is unchanged, so an object's backing store keeps its words and takes the new shape id.
(defn shapes-reshape-attrs [(shape i64) (key i64) (attrs i64)] (-> i64)
  (let [(mut rows) (al-new [i64] (alloc/malloc-allocator))
        (mut s) shape]
    (if (= (shapes-find-row shape key) 0) (panic "shapes-reshape-attrs: key is not in shape") 0)
    (loop (if (= (load s) SHAPES-ROOT)
              (break 0)
              (do (push! [i64] (mut rows) (load s)) (set! (mut s) (shapes-parent (load s))) (continue))))
    (let [(mut i) (- (len (load rows)) 1)
          (mut cur) SHAPES-ROOT]
      (loop (if (< (load i) 0)
                (break 0)
                (let [row (get (load rows) (load i))
                      k (shapes-key row)]
                  (if (= k 0)
                      (set! (mut cur) (shapes-prevent-extensions (load cur)))
                      (set! (mut cur) (shapes-transition-attrs (load cur) k (if (= k key) attrs (shapes-attrs row)))))
                  (set! (mut i) (- (load i) 1))
                  (continue))))
      (al-free! [i64] (mut rows))
      (load cur))))
