(defn rt-symbol-address [(name (slice u8))] (-> i64)
  (let [address (rt-symbol-lookup name)]
    (if (= address 0)
        (do
          (p--str "\n  unresolved import: ")
          (p--str name)
          (panic "rt-symbol-address: unresolved runtime import"))
        0)
    address))

