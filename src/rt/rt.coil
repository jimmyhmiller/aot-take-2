;; The runtime, in Coil.

;;
;; CLAUDE.md's second rule has a consequence that lands here: whatever a compiled program needs at
;; runtime — allocation, the collector, string primitives, host I/O — is Coil compiled into the
;; binary or machine code we emit. There is no C shim, and `cc` is used as a linker only.
;;
;; So this module owns an ABI that WE define, between emitted machine code and Coil-compiled
;; runtime functions: which registers carry what, how a NaN-boxed word crosses the boundary, how a
;; safepoint hands the collector its stack map, and how a thrown value unwinds.
;;
;; Allocation and the stop-the-world generational collector are live. The generated allocation ABI
;; supplies a stack-map identity and caller SP; the runtime discovers the linked stack-map section,
;; relocates every described root, ages first survivors, promotes repeated survivors, scans dirty
;; old-space cards, compacts
;; the old generation when required, and retries allocation. Throwing retains its named hard-error
;; body.
(module aot.rt.rt)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.mem" :as mem)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.str" :use [sb-new sb-push-str! sb-push-i64! sb-str sb-free!])
(import "coil.io" :as io)
(import "coil.os" :as os)
(import "coil.time" :as time)
(import "coil.slice" :use [slice-new slice-data])
(import "aot.util.panic" :use *)
(import "aot.rt.abi" :use *)
(import "aot.rt.shapes" :use *)
(import "aot.rt.number" :use *)

;; Darwin publishes the main executable header and libSystem's section lookup routine. This keeps
;; stack-map discovery inside Coil while avoiding an unresolved generated-data symbol in the
;; separately compiled runtime object. The generated object already contributes the authoritative
;; `__DATA,__aot_stackmaps` section.
(extern getsectiondata
        :cc
        c
        [(ptr u8) (ptr i8) (ptr i8) (ptr u64)]
        (-> (ptr u8)))

;; Installed code outlives individual realms. Each range borrows immutable map bytes from its
;; installation until unregister; no compiler-arena pointer enters this registry. Mutations are
;; allowed only between executions, before a realm has live frames or function objects.
;; Simple's runtime is the host JVM and does not supply a native moving-GC code registry. This is
;; our runtime boundary: qualify the first map by installation, subsequent maps by actual PCs.
(defstruct RtCodeRange [(id i64) (text i64) (text-bytes i64) (maps (ptr u8)) (map-bytes i64)
                       (dependents i64) (unit-slot i64) (key-count i64) (shape-count i64)])
(defstruct RtCodeRegistry [(ranges (ArrayList RtCodeRange)) (next-id i64) (ready bool)])

(defn rt-code-registry [] (-> (ptr RtCodeRegistry))
  (let [r (primitive/alloc-static RtCodeRegistry)]
    (if (not (.ready r))
        (do (set! (.ranges r) (al-new [RtCodeRange] (alloc/malloc-allocator)))
            (set! (.next-id r) 1) (set! (.ready r) true) 0) 0)
    r))

(defn rt-code-count [] (-> i64) (len (.ranges (rt-code-registry))))

(defn rt-code-find [(id i64)] (-> (Option RtCodeRange))
  (let [(mut i) 0 ranges (.ranges (rt-code-registry))]
    (loop (if (>= (load i) (len ranges)) (break (None [RtCodeRange]))
              (let [r (get ranges (load i))]
                (if (= (.id r) id) (break (Some r))
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn rt-code-for-return-pc [(pc i64)] (-> (Option RtCodeRange))
  (let [(mut i) 0 ranges (.ranges (rt-code-registry))]
    (loop (if (>= (load i) (len ranges)) (break (None [RtCodeRange]))
              (let [r (get ranges (load i))]
                ;; A return PC names the byte after its call, including a call at a range's end.
                (if (and (> pc (.text r)) (<= (- pc (.text r)) (.text-bytes r)))
                    (break (Some r))
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn rt-code-maps-valid? [(maps (ptr u8)) (bytes i64) (text-bytes i64)] (-> bool)
  (if (or (= (primitive/cast i64 maps) 0) (not (rt-stackmap-header-valid? maps bytes)))
      false
      (let [(mut ids) (hm-new [i64 bool] (alloc/malloc-allocator) (i64-keyops))
            (mut at) RT-STACKMAP-HEADER-BYTES (mut i) 0 (mut valid) true]
        (loop (if (or (not (load valid)) (>= (load i) (rt-read-u32 maps 12))) (break 0)
                  (if (> (load at) (- bytes RT-STACKMAP-RECORD-BYTES))
                      (do (set! (mut valid) false) (break 0))
                      (let [id (rt-read-u64 maps (load at))
                            pc (rt-read-u64 maps (+ (load at) 8))
                            slots (rt-read-u32 maps (+ (load at) 16))
                            size (+ RT-STACKMAP-RECORD-BYTES (* slots RT-STACKMAP-SLOT-BYTES))]
                        (if (or (<= id 0) (> id RT-LOCAL-MAP-ID-LIMIT) (< pc 0) (> pc text-bytes)
                                (> size (- bytes (load at)))
                                (match (get (load ids) id) (Some [_] true) (None [] false)))
                            (do (set! (mut valid) false) (break 0))
                            (do (set! (mut ids) id true)
                                (set! (mut at) (+ (load at) size))
                                (set! (mut i) (+ (load i) 1)) (continue)))))))
        (hm-free! (mut ids))
        (and (load valid) (= (load at) bytes)))))

;; Slots can be reused only after unregistration, when no realm or dependent code can refer to
;; the old installation. Code identities themselves are never reused. Table size depends on live
;; installations rather than the number of tests this worker has processed.
(defn rt-code-slot-used? [(slot i64)] (-> bool)
  (let [ranges (.ranges (rt-code-registry)) (mut i) 0]
    (loop (if (>= (load i) (len ranges)) (break false)
              (let [r (get ranges (load i))]
                (if (= (.unit-slot r) slot) (break true)
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn rt-code-next-slot [] (-> i64)
  (let [(mut slot) 1]
    (loop (if (rt-code-slot-used? (load slot))
              (do (set! (mut slot) (+ (load slot) 1)) (continue))
              (break (load slot))))))

(defn rt-code-unit-slot [(id i64)] (-> i64)
  (if (= id 0) 0
      (match (rt-code-find id)
        (Some [range] (let [r range] (.unit-slot r)))
        (None [] (panic "rt-code-unit-slot: unknown code installation")))))

(defn rt-code-unit-count [] (-> i64)
  (let [(mut count) 1]
    (al-for [range (.ranges (rt-code-registry))]
      (let [r range]
        (if (>= (.unit-slot r) (load count)) (set! (mut count) (+ (.unit-slot r) 1)) 0)))
    (load count)))

(defn rt-code-register-identities! [(text i64) (text-bytes i64) (maps (ptr u8)) (map-bytes i64)
                                   (key-count i64) (shape-count i64)] (-> i64)
  (if (.booted (rt-heap)) (panic "rt-code-register!: a realm is active") 0)
  (if (or (<= text 0) (<= text-bytes 0) (> text-bytes (- 0x7fffffffffffffff text))
          (not (rt-code-maps-valid? maps map-bytes text-bytes)))
      (panic "rt-code-register!: invalid code range or stack maps") 0)
  (if (or (< key-count 1) (> key-count 0xffffffff) (< shape-count 2) (> shape-count 0xffffffff))
      (panic "rt-code-register-identities!: invalid unit namespace counts") 0)
  (let [registry (rt-code-registry) id (.next-id registry)]
    (if (> id RT-CODE-ID-LIMIT) (panic "rt-code-register!: code identity space exhausted") 0)
    (al-for [range (.ranges registry)]
      (let [r range]
        (if (and (< text (+ (.text r) (.text-bytes r))) (< (.text r) (+ text text-bytes)))
            (panic "rt-code-register!: overlapping code ranges") 0)))
    (push! [RtCodeRange] (mut (.ranges registry))
           (RtCodeRange :id id :text text :text-bytes text-bytes :maps maps :map-bytes map-bytes :dependents 0
                        :unit-slot (rt-code-next-slot) :key-count key-count :shape-count shape-count))
    (set! (.next-id registry) (+ id 1))
    id))

;; Register code with no unit metadata references (the GC registry's standalone client).
(defn rt-code-register! [(text i64) (text-bytes i64) (maps (ptr u8)) (map-bytes i64)] (-> i64)
  (rt-code-register-identities! text text-bytes maps map-bytes 1 2))

(defn rt-code-pin! [(id i64) (retain bool)] (-> i64)
  (if (.booted (rt-heap)) (panic "rt-code-pin!: a realm is active") 0)
  (let [registry (rt-code-registry) (mut i) 0]
    (loop (if (>= (load i) (len (.ranges registry)))
              (break (panic "rt-code-pin!: unknown code identity"))
              (let [r (al-elem [RtCodeRange] (mut (.ranges registry)) (load i))]
                (if (= (.id r) id)
                    (do
                      (if (or (and retain (= (.dependents r) 0x7fffffffffffffff))
                              (and (not retain) (= (.dependents r) 0)))
                          (panic "rt-code-pin!: invalid dependency count") 0)
                      (set! (.dependents r) (+ (.dependents r) (if retain 1 -1)))
                      (break 0))
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn rt-code-unregister! [(id i64)] (-> i64)
  (if (.booted (rt-heap)) (panic "rt-code-unregister!: a realm is active") 0)
  (let [registry (rt-code-registry) (mut i) 0]
    (loop (if (>= (load i) (len (.ranges registry)))
              (break (panic "rt-code-unregister!: unknown code identity"))
              (let [r (get (.ranges registry) (load i))]
                (if (= (.id r) id)
                    (let [last (get (.ranges registry) (- (len (.ranges registry)) 1))]
                      (if (> (.dependents r) 0) (panic "rt-code-unregister!: installed code still imports this range") 0)
                      (set! (mut (.ranges registry)) (load i) last)
                      (pop! (mut (.ranges registry)))
                      (if (= (len (.ranges registry)) 0) (al-free! (mut (.ranges registry))) 0)
                      (break 0))
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defstruct RtFrameCursor [(maps (ptr u8)) (map-bytes i64) (text i64) (record i64) (sp i64)])

;; One walker supplies both tracing and verification, so crossing an image boundary cannot
;; update one pass while leaving the other on the previous image's map table.
(defn rt-frame-next! [(cursor (ptr RtFrameCursor))] (-> i64)
  (let [pc (load (primitive/cast (ptr i64)
                  (+ (.sp cursor) (rt-stackmap-rpc-offset (.maps cursor) (.record cursor)))))
        size (rt-stackmap-frame-size (.maps cursor) (.record cursor))]
    (if (or (<= size 0) (> size (- 0x7fffffffffffffff (.sp cursor))))
        (panic "rt-frame-next!: a frame record does not advance the walk") 0)
    (set! (.sp cursor) (+ (.sp cursor) size))
    (match (rt-code-for-return-pc pc)
      (Some [range]
        (let [r range record (rt-stackmap-find-return-pc (.maps r) (.map-bytes r) (- pc (.text r)))]
          (if (< record 0) (panic "rt-frame-next!: registered caller has no stack map") 0)
          (set! (.maps cursor) (.maps r)) (set! (.map-bytes cursor) (.map-bytes r))
          (set! (.text cursor) (.text r)) (set! (.record cursor) record) 0))
      (None []
        (do (set! (.record cursor)
                   (rt-stackmap-find-return-pc (.maps cursor) (.map-bytes cursor) (- pc (.text cursor))))
            0)))))

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))

(extern strtoll :cc c [(ptr i8) (ptr (ptr i8)) i32] (-> i64))

(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))

(extern strtod :cc c [(ptr i8) (ptr (ptr i8))] (-> f64))

(extern atexit :cc c [(fnptr c [] i64)] (-> i32))

(const RT-HEADER-BYTES 24)

(const RT-MAX-PAYLOAD-BYTES 0x7fffffffffffffef)

(const RT-STACKMAP-HEADER-BYTES 16)

(const RT-STACKMAP-RECORD-BYTES 32)

(const RT-STACKMAP-SLOT-BYTES 8)

(const RT-DEFAULT-HEAP-BYTES 0x4000000)

(const RT-DEFAULT-NURSERY-BYTES 0x800000)

(const RT-CARD-BYTES 512)

(const RT-BARRIER-RAW 1)

(const RT-BARRIER-BOXED 2)

(const RT-CARD-DIRTY-BOXED 1)

(const RT-CARD-DIRTY-RAW 2)

(const RT-META-HAS-BOXED 1)

(const RT-META-HAS-RAW 2)

(const RT-META-SURVIVED 4)

(const RT-DYNAMIC-PREFIX-OBJECT 0x7fff)

;; Heap references also travel under the string and function prefixes; the collector must
;; forward all three. A function payload's raw code word is a text address whose high half is
;; never one of these, so payload scanning leaves it alone.
(const RT-DYNAMIC-PREFIX-STRING 0x7ffd)

(const RT-DYNAMIC-PREFIX-FUNCTION 0xfff9)

;; A Symbol is a traced allocation of its own: its identity IS the reference, and its payload holds
;; the description it was created with (docs/DECISIONS.md, symbols). The collector forwards it like
;; any other reference.
(const RT-DYNAMIC-PREFIX-SYMBOL 0x7ffe)

(const RT-SYMBOL-PAYLOAD-BYTES 16)

(const RT-OFFSET-SYMBOL-DESCRIPTION 0)

;; The second payload word is the Symbol's property key id, a raw integer the collector's payload
;; scan leaves alone (no prefix of a reference).
(const RT-OFFSET-SYMBOL-KEY 8)

;; The exception sentinel a throwing function returns (`aot.node.dynamic`): never a reference.
(const RT-DYNAMIC-PREFIX-EXCEPTION 0xfffa)

;; The exception sentinel word itself: what a property lookup answers when the JSL slow path must
;; decide (an accessor found, a read-only property, a non-extensible object).
(const RT-DYNAMIC-EXCEPTION-WORD 0xfffa000000000000)

;; A boxed compact integer: prefix 0x7ff9 over a signed 48-bit payload (`aot.node.dynamic`).
(const RT-DYNAMIC-PREFIX-INT 0x7ff9)

(const RT-DYNAMIC-PAYLOAD-MASK 0x0000ffffffffffff)

(const RT-SHAPE-NOSCAN-BIT 0x4000000000000000)

;; The string layout's shape id (`SHAPE-STRING` in aot.shape): the noscan bit over identity 1.
(const RT-SHAPE-STRING 0x4000000000000001)

;; The boxed `undefined` word and an ordinary object's payload layout, as the compiler fixes them
;; (`aot.node.dynamic`, `aot.shape`); tests/rt-shapes-test.coil asserts the agreement.
(const RT-DYNAMIC-UNDEFINED-WORD 0x7ffa000000000000)

(const RT-DYNAMIC-NULL-WORD 0x7ffb000000000000)

(const RT-OFFSET-OBJECT-PROPERTIES 8)

;; Array exotic objects (docs/DECISIONS.md, arrays; `aot.shape` fixes the same numbers). The
;; payload begins like an object's, then the boxed elements store and the raw length word. The
;; store is a heap object of shape RT-SHAPE-ELEMENTS whose payload is one boxed word per slot; a
;; slot no element was ever defined at holds the hole word, which is neither a value nor a
;; reference and never leaves the runtime.
(const RT-OFFSET-ARRAY-ELEMENTS 16)

(const RT-OFFSET-ARRAY-LENGTH 24)

(const RT-ARRAY-PAYLOAD-BYTES 32)

;; A function object's payload (aot.shape FUNCTION-PAYLOAD-BYTES): prototype, properties, raw code,
;; boxed environment and raw flags words. The runtime never allocates one; it recognizes adopted ones.
(const RT-FUNCTION-PAYLOAD-BYTES 40)

(const RT-OBJECT-PAYLOAD-BYTES 16)

(const RT-SHAPE-ELEMENTS 0x2000000000000001)

(const RT-DYNAMIC-PREFIX-ARRAY 0xfffb)

(const RT-DYNAMIC-HOLE-WORD 0xfffc000000000000)

(const RT-ARRAY-MIN-CAPACITY 4)

;; 2^32 - 2: the largest array index (ECMA-262 §6.1.7).
(const RT-ARRAY-MAX-INDEX 4294967294)

;; The static heap image header (aot.heap documents the layout).
(const RT-IMAGE-VERSION 1)

(const RT-IMAGE-FIXED-BYTES 32)

(defstruct RtStats
  [(enabled bool)
   (minor-count i64)
   (minor-nanos i64)
   (major-count i64)
   (major-nanos i64)
   (allocated-objects i64)
   (allocated-bytes i64)
   (promoted-objects i64)
   (promoted-bytes i64)
   (barrier-calls i64)
   (barrier-dirties i64)
   (remembered-cards i64)
   (collection-start i64)
   (collection-old-used i64)])

(defn rt-heap [] (-> (ptr RtHeap))
  (primitive/alloc-static RtHeap))

(defn rt-stats [] (-> (ptr RtStats))
  (primitive/alloc-static RtStats))

(defn rt-stats-now [] (-> i64)
  (try (let [instant (try-or! (time/monotonic-now) 0)]
         (let [value (primitive/alloc-stack time/Instant)]
           (set! value instant)
           (+ (* (.sec value) 1000000000) (.nsec value))))))

(defn rt-stats-print! [(label (slice u8)) (value i64)] (-> i64)
  (try (let [stream (io/stderr)
             _ (try-or! (io/print-str stream label) 0)
             _ (try-or! (io/print-int stream value) 0)
             _ (try-or! (io/print-str stream "\n") 0)]
         0)))

(defn rt-stats-report [] (-> i64)
  (let [stats (rt-stats)]
    (if (.enabled stats)
        (do
          (try (let [_
                       (try-or! (io/print-str (io/stderr) "aot-gc-stats-v1\n")
                                0)]
                 0))
          (rt-stats-print! "minor_collections=" (.minor-count stats))
          (rt-stats-print! "minor_time_ns=" (.minor-nanos stats))
          (rt-stats-print! "major_collections=" (.major-count stats))
          (rt-stats-print! "major_time_ns=" (.major-nanos stats))
          (rt-stats-print! "allocated_objects=" (.allocated-objects stats))
          (rt-stats-print! "allocated_bytes=" (.allocated-bytes stats))
          (rt-stats-print! "promoted_objects=" (.promoted-objects stats))
          (rt-stats-print! "promoted_bytes=" (.promoted-bytes stats))
          (rt-stats-print! "collector_barrier_calls=" (.barrier-calls stats))
          (rt-stats-print! "collector_barrier_dirties="
                           (.barrier-dirties stats))
          (rt-stats-print! "remembered_cards=" (.remembered-cards stats)))
        0)))

(defn rt-heap-reset-generational! [(nursery-capacity i64) (old-capacity i64)] (-> i64)
  (do
    (if (< nursery-capacity 64)
        (alloc/oom-at c"rt-heap-reset-generational!: nursery capacity"
                      nursery-capacity)
        0)
    (if (< old-capacity 64)
        (alloc/oom-at c"rt-heap-reset-generational!: old capacity" old-capacity)
        0)
    (let [heap (rt-heap)]
      (rt-heap-release!)
      (set! (.unit-count heap) (rt-code-unit-count))
      (set! (.unit-bases heap) (primitive/cast (ptr i64)
                               (alloc/malloc (primitive/cast isize (* 8 (.unit-count heap))))))
      (if (= (primitive/cast i64 (.unit-bases heap)) 0)
          (alloc/oom-at c"rt-heap-reset-generational!: unit bases" (.unit-count heap)) 0)
      (mem/mem-zero [u8] (primitive/cast (ptr u8) (.unit-bases heap)) (* 8 (.unit-count heap)))
      (set! (.unit-keys heap) (rt-unit-empty-table (.unit-count heap)))
      (set! (.unit-shapes heap) (rt-unit-empty-table (.unit-count heap)))
      (set! (.unit-objects heap) (rt-unit-empty-table (.unit-count heap)))
      (set! (.object-maps heap) (al-new [(slice i64)] (alloc/malloc-allocator)))
      (set! (.global-lexicals heap) (al-new [RtGlobalLexical] (alloc/malloc-allocator)))
      (set! (.global-lexical-slots heap) (hm-new [i64 i64] (alloc/malloc-allocator) (i64-keyops)))
      (set! (.from heap)
            (primitive/cast (ptr u8)
                            (alloc/malloc (primitive/cast isize
                                                          nursery-capacity))))
      (set! (.young-other heap)
            (primitive/cast (ptr u8)
                            (alloc/malloc (primitive/cast isize
                                                          nursery-capacity))))
      (set! (.to heap)
            (primitive/cast (ptr u8)
                            (alloc/malloc (primitive/cast isize old-capacity))))
      (set! (.old-other heap)
            (primitive/cast (ptr u8)
                            (alloc/malloc (primitive/cast isize old-capacity))))
      (let [card-count (/ (+ old-capacity (- RT-CARD-BYTES 1)) RT-CARD-BYTES)]
        (set! (.card-count heap) card-count)
        (set! (.cards heap)
              (primitive/cast (ptr u8)
                              (alloc/malloc (primitive/cast isize card-count))))
        (set! (.other-cards heap)
              (primitive/cast (ptr u8)
                              (alloc/malloc (primitive/cast isize card-count))))
        (set! (.starts heap)
              (primitive/cast (ptr i64)
                              (alloc/malloc (primitive/cast isize
                                                            (* card-count 8)))))
        (set! (.other-starts heap)
              (primitive/cast (ptr i64)
                              (alloc/malloc (primitive/cast isize
                                                            (* card-count 8))))))
      (if (or (= (primitive/cast i64 (.from heap)) 0)
              (= (primitive/cast i64 (.young-other heap)) 0)
              (= (primitive/cast i64 (.to heap)) 0)
              (= (primitive/cast i64 (.old-other heap)) 0)
              (= (primitive/cast i64 (.cards heap)) 0)
              (= (primitive/cast i64 (.other-cards heap)) 0)
              (= (primitive/cast i64 (.starts heap)) 0)
              (= (primitive/cast i64 (.other-starts heap)) 0))
          (alloc/oom-at c"rt-heap-reset-generational!" old-capacity)
          0)
      (mem/mem-zero [u8] (.cards heap) (.card-count heap))
      (mem/mem-zero [u8] (.other-cards heap) (.card-count heap))
      (mem/mem-zero [u8]
                    (primitive/cast (ptr u8) (.starts heap))
                    (* (.card-count heap) 8))
      (mem/mem-zero [u8]
                    (primitive/cast (ptr u8) (.other-starts heap))
                    (* (.card-count heap) 8))
      (set! (.capacity heap) nursery-capacity)
      (set! (.old-capacity heap) old-capacity)
      (set! (.used heap) 0)
      (set! (.young-copied-used heap) 0)
      (set! (.young-scan heap) 0)
      (set! (.to-used heap) 0)
      (set! (.scan heap) 0)
      (set! (.copied-used heap) 0)
      (set! (.major heap) false)
      (set! (.force-major heap) false)
      (set! (.stress heap) false)
      (set! (.fast-disabled heap) 0)
      (set! (.static-images heap) (al-new [RtStaticImage] (alloc/malloc-allocator)))
      (set! (.booted heap) true)
      0)))

(defn rt-heap-reset! [(capacity i64)] (-> i64)
  (rt-heap-reset-generational! capacity capacity))

;; Final Simple ScopeNode maps parser variables to graph inputs, with lexical depth tracking;
;; it has no native shared global declarative record. Our independently compiled Scripts need
;; realm-owned cells after their initializer frames return. Names use the program's remapped
;; string-key identities. Slots are one-based, stable until realm destruction, and never deleted
;; (global let/const/class bindings are non-deletable). Zero from find means an absent binding.
;;
;; These are storage primitives, not JS exception implementations. JSL must check initialized /
;; writable state and produce ReferenceError / TypeError completions before value access. The
;; assertions here guard that contract. Creation/initialization preconditions also belong to
;; Script declaration instantiation. Malloc growth cannot collect JS values; initialized cells
;; are explicit roots scanned by minor and major GC, so writes need no heap remembered card.
(defn rt-global-lexical-find [(key i64)] (-> i64)
  (if (or (not (.booted (rt-heap))) (not (shapes-booted?)))
      (panic "rt-global-lexical-find: realm is not booted") 0)
  (if (or (<= key 0) (> key (shapes-key-count)))
      (panic "rt-global-lexical-find: invalid program key") 0)
  (match (get (.global-lexical-slots (rt-heap)) key)
    (Some [slot] slot) (None [] 0)))

(defn rt-global-lexical-cell [(slot i64)] (-> (ptr RtGlobalLexical))
  (let [heap (rt-heap)]
    (if (or (not (.booted heap)) (<= slot 0) (> slot (len (.global-lexicals heap))))
        (panic "rt-global-lexical-cell: invalid realm slot") 0)
    (al-elem (field heap global-lexicals) (- slot 1))))

(defn rt-global-lexical-create! [(key i64) (writable bool)] (-> i64)
  (if (!= (rt-global-lexical-find key) 0)
      (panic "rt-global-lexical-create!: binding already exists") 0)
  (let [heap (rt-heap) slot (+ (len (.global-lexicals heap)) 1)]
    (push! [RtGlobalLexical] (mut (.global-lexicals heap))
           (RtGlobalLexical :value RT-DYNAMIC-UNDEFINED-WORD :initialized false :writable writable))
    (set! (mut (.global-lexical-slots heap)) key slot)
    slot))

(defn rt-global-lexical-state [(slot i64)] (-> i64)
  (let [cell (rt-global-lexical-cell slot)]
    (| (if (.initialized cell) RT-LEXICAL-INITIALIZED 0)
       (if (.writable cell) RT-LEXICAL-WRITABLE 0))))

;; Native primitive operands use 64-bit words, including this Boolean flag.
(defn rt-global-lexical-create-word [(key i64) (writable i64)] (-> i64)
  (if (and (!= writable 0) (!= writable 1))
      (panic "rt-global-lexical-create-word: writable flag must be zero or one") 0)
  (rt-global-lexical-create! key (= writable 1)))

(defn rt-global-lexical-value [(slot i64)] (-> i64)
  (let [cell (rt-global-lexical-cell slot)]
    (if (not (.initialized cell)) (panic "rt-global-lexical-value: uninitialized binding") 0)
    (.value cell)))

(defn rt-global-lexical-initialize! [(slot i64) (value i64)] (-> i64)
  (let [cell (rt-global-lexical-cell slot)]
    (if (.initialized cell) (panic "rt-global-lexical-initialize!: binding already initialized") 0)
    (set! (.value cell) value)
    (set! (.initialized cell) true)
    value))

(defn rt-global-lexical-store! [(slot i64) (value i64)] (-> i64)
  (let [cell (rt-global-lexical-cell slot)]
    (if (not (.initialized cell)) (panic "rt-global-lexical-store!: uninitialized binding") 0)
    (if (not (.writable cell)) (panic "rt-global-lexical-store!: immutable binding") 0)
    (set! (.value cell) value)
    value))

(defn rt-heap-boot! [] (-> i64)
  (if (.booted (rt-heap))
      0
      (let [configured (getenv c"AOT_RT_HEAP_BYTES")]
        (do
          (if (= (primitive/cast i64 configured) 0)
              (rt-heap-reset-generational! RT-DEFAULT-NURSERY-BYTES
                                           RT-DEFAULT-HEAP-BYTES)
              (let [end (primitive/alloc-stack (ptr i8))
                    bytes (strtoll configured end 10)]
                (if (or (= (primitive/cast i64 (load end))
                           (primitive/cast i64 configured))
                        (< bytes 64))
                    (alloc/oom-at c"AOT_RT_HEAP_BYTES" bytes)
                    (rt-heap-reset-generational! bytes bytes))))
          (set! (.stress (rt-heap))
                (!= (primitive/cast i64 (getenv c"AOT_RT_GC_STRESS")) 0))
          (set! (.verify (rt-heap))
                (!= (primitive/cast i64 (getenv c"AOT_RT_GC_VERIFY")) 0))
          (if (and (!= (primitive/cast i64 (getenv c"AOT_RT_GC_STATS")) 0)
                   (not (.enabled (rt-stats))))
              (do
                (set! (.enabled (rt-stats)) true)
                ;; File executables report at exit. Embedded executions report per realm and
                ;; must not accumulate atexit registrations in a long-lived worker.
                (if (and (= (primitive/cast i64 (.text (rt-program))) 0)
                         (!= (primitive/cast i64 (atexit (primitive/fnptr-of rt-stats-report))) 0))
                    (panic "rt-heap-boot!: cannot register GC statistics reporter")
                    0))
              0)
          (set! (.fast-disabled (rt-heap))
                (if (or (.stress (rt-heap)) (.enabled (rt-stats))) 1 0))
          (rt-shapes-boot!)
          (rt-unit-identities-boot!)
          (rt-statics-boot!)
          0))))

(defn rt-align8 [(bytes i64)] (-> i64)
  (& (+ bytes 7) -8))

(defn rt-heap-used [] (-> i64)
  (do (rt-heap-boot!) (.used (rt-heap))))

(defn rt-heap-state [] (-> i64)
  (do (rt-heap-boot!) (primitive/cast i64 (rt-heap))))

(defn rt-in-from-space? [(payload i64)] (-> bool)
  (let [heap (rt-heap)
        base (primitive/cast i64 (.from heap))]
    (and (>= payload (+ base RT-HEADER-BYTES))
         (< payload (+ base (.used heap))))))

(defn rt-in-old-space? [(payload i64)] (-> bool)
  (let [heap (rt-heap)
        base (primitive/cast i64 (.to heap))
        limit
          (if (and (not (.major heap)) (> (.copied-used heap) (.to-used heap)))
              (.copied-used heap)
              (.to-used heap))]
    (and (>= payload (+ base RT-HEADER-BYTES)) (< payload (+ base limit)))))

(defn rt-in-young-destination? [(payload i64)] (-> bool)
  (let [heap (rt-heap)
        base (primitive/cast i64 (.young-other heap))]
    (and (>= payload (+ base RT-HEADER-BYTES))
         (< payload (+ base (.young-copied-used heap))))))

(defn rt-in-collect-space? [(payload i64)] (-> bool)
  (or (rt-in-from-space? payload)
      (and (.major (rt-heap)) (rt-in-old-space? payload))))

(defn rt-register-old-object! [(offset i64) (total i64) (other bool)] (-> i64)
  (let [heap (rt-heap)
        space (if other (.old-other heap) (.to heap))
        cards (if other (.other-cards heap) (.cards heap))
        starts (if other (.other-starts heap) (.starts heap))
        first (/ offset RT-CARD-BYTES)
        last (/ (- (+ offset total) 1) RT-CARD-BYTES)
        (mut card) first]
    ;; The high 56 metadata bits hold the owning card-byte address shifted left by eight; the low
    ;; byte remains the exact scan-kind mask. Generated barriers can therefore reject young owners
    ;; from the object header alone, without calling the runtime or loading global heap state.
    (let [header (primitive/cast (ptr i64) (primitive/index space offset))
          flags (& (load (primitive/index header 1)) 0xff)
          card-address (primitive/cast i64 (primitive/index cards first))]
      (set! (primitive/index header 1)
            (| (primitive/ishl card-address 8) flags)))
    (loop (if (> (load card) last)
              (break 0)
              (let [entry (primitive/index starts (load card))
                    value (+ offset 1)]
                (if (or (= (load entry) 0) (< value (load entry)))
                    (set! entry value)
                    0)
                (set! (mut card) (+ (load card) 1))
                (continue))))))

(defn rt-heap-allocate-active [(bytes i64) (shape i64)] (-> i64)
  (let [heap (rt-heap)
        total (rt-align8 (+ bytes RT-HEADER-BYTES))]
    (if (> (+ (.used heap) total) (.capacity heap))
        0
        (let [base (primitive/index (.from heap) (.used heap))
              payload (primitive/index base RT-HEADER-BYTES)
              header (primitive/cast (ptr i64) base)]
          (set! (.used heap) (+ (.used heap) total))
          (set! (primitive/index header 0) bytes)
          (set! (primitive/index header 1)
                (if (!= (& shape RT-SHAPE-NOSCAN-BIT) 0) 0 RT-META-HAS-BOXED))
          (set! (primitive/index header 2) shape)
          (mem/mem-zero [u8] payload bytes)
          (if (.enabled (rt-stats))
              (do
                (set! (.allocated-objects (rt-stats))
                      (+ (.allocated-objects (rt-stats)) 1))
                (set! (.allocated-bytes (rt-stats))
                      (+ (.allocated-bytes (rt-stats)) total))
                0)
              0)
          (primitive/cast i64 payload)))))

(defn rt-heap-allocate-old [(bytes i64) (shape i64)] (-> i64)
  (let [heap (rt-heap)
        total (rt-align8 (+ bytes RT-HEADER-BYTES))]
    (if (> (+ (.to-used heap) total) (.old-capacity heap))
        0
        (let [base (primitive/index (.to heap) (.to-used heap))
              payload (primitive/index base RT-HEADER-BYTES)
              header (primitive/cast (ptr i64) base)]
          (set! (.to-used heap) (+ (.to-used heap) total))
          (set! (primitive/index header 0) bytes)
          (set! (primitive/index header 1)
                (if (!= (& shape RT-SHAPE-NOSCAN-BIT) 0) 0 RT-META-HAS-BOXED))
          (set! (primitive/index header 2) shape)
          (mem/mem-zero [u8] payload bytes)
          (rt-register-old-object! (- (.to-used heap) total) total false)
          (if (.enabled (rt-stats))
              (do
                (set! (.allocated-objects (rt-stats))
                      (+ (.allocated-objects (rt-stats)) 1))
                (set! (.allocated-bytes (rt-stats))
                      (+ (.allocated-bytes (rt-stats)) total))
                0)
              0)
          (primitive/cast i64 payload)))))

(defn rt-forward [(payload i64)] (-> i64)
  (if (or (= payload 0) (not (rt-in-collect-space? payload)))
      payload
      (let [heap (rt-heap)
            old-header (primitive/index (primitive/cast (ptr i64) payload) -3)
            bytes (load (primitive/index old-header 0))
            shape (load (primitive/index old-header 2))]
        (if (< shape 0)
            (- 0 shape)
            (let [total (rt-align8 (+ bytes RT-HEADER-BYTES))
                  meta (load (primitive/index old-header 1))
                  promote (or (.major heap) (!= (& meta RT-META-SURVIVED) 0))
                  destination
                    (if (.major heap)
                        (.old-other heap)
                        (if promote (.to heap) (.young-other heap)))
                  destination-used
                    (if promote (.copied-used heap) (.young-copied-used heap))
                  destination-capacity
                    (if promote (.old-capacity heap) (.capacity heap))]
              (if (> (+ destination-used total) destination-capacity)
                  (alloc/oom-at c"rt-forward: live objects exceed destination generation"
                                total)
                  0)
              (let [new-base (primitive/index destination destination-used)
                    new-payload (primitive/index new-base RT-HEADER-BYTES)]
                (mem/mem-copy [u8]
                              new-base
                              (primitive/cast (ptr u8) old-header)
                              total)
                (if promote
                    (set! (.copied-used heap) (+ (.copied-used heap) total))
                    (do
                      (set! (.young-copied-used heap)
                            (+ (.young-copied-used heap) total))
                      (set! (primitive/index (primitive/cast (ptr i64) new-base)
                                             1)
                            (| meta RT-META-SURVIVED))))
                (if (and (.enabled (rt-stats))
                         (and promote (not (.major heap))))
                    (do
                      (set! (.promoted-objects (rt-stats))
                            (+ (.promoted-objects (rt-stats)) 1))
                      (set! (.promoted-bytes (rt-stats))
                            (+ (.promoted-bytes (rt-stats)) total))
                      0)
                    0)
                (if promote
                    (rt-register-old-object! (- (.copied-used heap) total)
                                             total
                                             (.major heap))
                    0)
                (set! (primitive/index old-header 2)
                      (- 0 (primitive/cast i64 new-payload)))
                (primitive/cast i64 new-payload)))))))

;; The high 16 bits of a boxed word, as an unsigned prefix.
(defn rt-word-prefix [(word i64)] (-> i64)
  (& (primitive/ishr word 48) 0xffff))

;; Whether a boxed word carries a heap reference: an object, a string, a function object, an array
;; or a Symbol.
(defn rt-word-object? [(word i64)] (-> bool)
  (let [prefix (rt-word-prefix word)]
    (or (= prefix RT-DYNAMIC-PREFIX-OBJECT)
        (= prefix RT-DYNAMIC-PREFIX-STRING)
        (= prefix RT-DYNAMIC-PREFIX-FUNCTION)
        (= prefix RT-DYNAMIC-PREFIX-SYMBOL)
        (= prefix RT-DYNAMIC-PREFIX-ARRAY))))

(defn rt-forward-boxed [(word i64)] (-> i64)
  (if (not (rt-word-object? word))
      word
      (| (primitive/ishl (rt-word-prefix word) 48)
         (& (rt-forward (& word RT-DYNAMIC-PAYLOAD-MASK))
            RT-DYNAMIC-PAYLOAD-MASK))))

(defn rt-scan-copied! [] (-> i64)
  (let [heap (rt-heap)]
    (loop (if (and (>= (.young-scan heap) (.young-copied-used heap))
                   (>= (.scan heap) (.copied-used heap)))
              (break 0)
              (let [scan-young
                      (and (not (.major heap))
                           (< (.young-scan heap) (.young-copied-used heap)))
                    space
                      (if scan-young
                          (.young-other heap)
                          (if (.major heap) (.old-other heap) (.to heap)))
                    offset (if scan-young (.young-scan heap) (.scan heap))
                    base (primitive/index space offset)
                    header (primitive/cast (ptr i64) base)
                    bytes (load (primitive/index header 0))
                    payload
                      (primitive/cast (ptr i64)
                                      (primitive/index base RT-HEADER-BYTES))
                    meta (load (primitive/index header 1))
                    shape (load (primitive/index header 2))
                    words
                      (if (!= (& shape RT-SHAPE-NOSCAN-BIT) 0) 0 (/ bytes 8))
                    (mut i) 0]
                ;; Current ordinary-object payload slots are all JavaScript values. String and
                ;; typed-array layouts will carry explicit scan descriptors before entering this
                ;; collector, rather than being conservatively mistaken for boxed fields.
                (loop (if (>= (load i) words)
                          (break 0)
                          (let [slot (primitive/index payload (load i))
                                word (load slot)]
                            (if (and (!= (& meta RT-META-HAS-RAW) 0)
                                     (rt-in-collect-space? word))
                                (let [forwarded (rt-forward word)]
                                  (set! slot forwarded)
                                  (if (and (not scan-young)
                                           (and (not (.major heap))
                                                (rt-in-young-destination? forwarded)))
                                      (aot-rt-write-barrier (primitive/cast i64
                                                                            payload)
                                                            forwarded
                                                            RT-BARRIER-RAW)
                                      0))
                                (let [forwarded (rt-forward-boxed word)]
                                  (set! slot forwarded)
                                  (if (and (not scan-young)
                                           (and (not (.major heap))
                                                (and (rt-word-object? forwarded)
                                                     (rt-in-young-destination? (& forwarded
                                                                                  RT-DYNAMIC-PAYLOAD-MASK)))))
                                      (aot-rt-write-barrier (primitive/cast i64
                                                                            payload)
                                                            forwarded
                                                            RT-BARRIER-BOXED)
                                      0)))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (if scan-young
                    (set! (.young-scan heap)
                          (+ (.young-scan heap)
                             (rt-align8 (+ bytes RT-HEADER-BYTES))))
                    (set! (.scan heap)
                          (+ (.scan heap) (rt-align8 (+ bytes RT-HEADER-BYTES)))))
                (continue))))))

(defn rt-scan-remembered! [] (-> i64)
  (let [heap (rt-heap)
        (mut card) 0]
    (loop (if (>= (load card) (.card-count heap))
              (break 0)
              (let [dirty (primitive/index (.cards heap) (load card))
                    start (load (primitive/index (.starts heap) (load card)))]
                (if (and (!= (primitive/cast i64 (load dirty)) 0) (> start 0))
                    (let [(mut cursor) (- start 1)
                          ;; Keep the card dirty only while scanning observes an edge into the
                          ;; survivor destination. Promotion itself records any new old-to-young
                          ;; edges created while its fields are forwarded.
                          (mut keep) 0
                          limit (* (+ (load card) 1) RT-CARD-BYTES)]
                      (if (.enabled (rt-stats))
                          (set! (.remembered-cards (rt-stats))
                                (+ (.remembered-cards (rt-stats)) 1))
                          0)
                      (loop (if (or (>= (load cursor) (.to-used heap))
                                    (>= (load cursor) limit))
                                (break 0)
                                (let [base
                                        (primitive/index (.to heap)
                                                         (load cursor))
                                      header (primitive/cast (ptr i64) base)
                                      bytes (load (primitive/index header 0))
                                      shape (load (primitive/index header 2))
                                      payload
                                        (primitive/cast (ptr i64)
                                                        (primitive/index base
                                                                         RT-HEADER-BYTES))
                                      words
                                        (if (!= (& shape RT-SHAPE-NOSCAN-BIT) 0)
                                            0
                                            (/ bytes 8))
                                      (mut i) 0]
                                  (loop (if (>= (load i) words)
                                            (break 0)
                                            (let [slot
                                                    (primitive/index payload
                                                                     (load i))
                                                  word (load slot)]
                                              (if (and (!= (& (primitive/cast i64
                                                                              (load dirty))
                                                              RT-CARD-DIRTY-RAW)
                                                           0)
                                                       (rt-in-from-space? word))
                                                  (let [forwarded
                                                          (rt-forward word)]
                                                    (set! slot forwarded)
                                                    (if (rt-in-young-destination? forwarded)
                                                        (set! (mut keep)
                                                              (| (load keep)
                                                                 RT-CARD-DIRTY-RAW))
                                                        0))
                                                  (if (!= (& (primitive/cast i64
                                                                             (load dirty))
                                                             RT-CARD-DIRTY-BOXED)
                                                          0)
                                                      (let [forwarded
                                                              (rt-forward-boxed word)]
                                                        (set! slot forwarded)
                                                        (if (and (rt-word-object? forwarded)
                                                                 (rt-in-young-destination? (& forwarded
                                                                                              RT-DYNAMIC-PAYLOAD-MASK)))
                                                            (set! (mut keep)
                                                                  (| (load keep)
                                                                     RT-CARD-DIRTY-BOXED))
                                                            0))
                                                      0))
                                              (set! (mut i) (+ (load i) 1))
                                              (continue))))
                                  (set! (mut cursor)
                                        (+ (load cursor)
                                           (rt-align8 (+ bytes RT-HEADER-BYTES))))
                                  (continue))))
                      (set! dirty (primitive/cast u8 (load keep))))
                    0)
                (if (and (!= (primitive/cast i64 (load dirty)) 0) (= start 0))
                    (set! dirty 0)
                    0)
                (set! (mut card) (+ (load card) 1))
                (continue))))))

(defn rt-begin-collection! [] (-> i64)
  (let [heap (rt-heap)
        major
          (or (.force-major heap)
              (> (+ (.to-used heap) (.used heap)) (.old-capacity heap)))]
    (set! (.major heap) major)
    (if (.enabled (rt-stats))
        (do
          (set! (.collection-start (rt-stats)) (rt-stats-now))
          (set! (.collection-old-used (rt-stats)) (.to-used heap))
          0)
        0)
    (if major
        (do
          (mem/mem-zero [u8] (.other-cards heap) (.card-count heap))
          (mem/mem-zero [u8]
                        (primitive/cast (ptr u8) (.other-starts heap))
                        (* (.card-count heap) 8))
          0)
        0)
    (set! (.scan heap) (if major 0 (.to-used heap)))
    (set! (.copied-used heap) (if major 0 (.to-used heap)))
    (set! (.young-scan heap) 0)
    (set! (.young-copied-used heap) 0)
    0))

(defn rt-finish-collection! [] (-> i64)
  (let [heap (rt-heap)
        was-major (.major heap)]
    (if (.major heap)
        (let [old-active (.to heap)
              old-cards (.cards heap)
              old-starts (.starts heap)]
          (set! (.to heap) (.old-other heap))
          (set! (.old-other heap) old-active)
          (set! (.cards heap) (.other-cards heap))
          (set! (.other-cards heap) old-cards)
          (set! (.starts heap) (.other-starts heap))
          (set! (.other-starts heap) old-starts))
        (let [old-young (.from heap)]
          (set! (.from heap) (.young-other heap))
          (set! (.young-other heap) old-young)))
    (set! (.to-used heap) (.copied-used heap))
    (set! (.used heap) (if was-major 0 (.young-copied-used heap)))
    (set! (.scan heap) 0)
    (set! (.copied-used heap) 0)
    (set! (.young-copied-used heap) 0)
    (set! (.young-scan heap) 0)
    (set! (.major heap) false)
    (set! (.force-major heap) false)
    (if (.enabled (rt-stats))
        (let [elapsed (- (rt-stats-now) (.collection-start (rt-stats)))]
          (if was-major
              (do
                (set! (.major-count (rt-stats)) (+ (.major-count (rt-stats)) 1))
                (set! (.major-nanos (rt-stats))
                      (+ (.major-nanos (rt-stats)) elapsed))
                0)
              (do
                (set! (.minor-count (rt-stats)) (+ (.minor-count (rt-stats)) 1))
                (set! (.minor-nanos (rt-stats))
                      (+ (.minor-nanos (rt-stats)) elapsed))
                0)))
        0)
    (.used heap)))

;; ---------------------------------------------------------------------------
;; Heap and root verification (`AOT_RT_GC_VERIFY`)
;;
;; Between collections every reference — a frame root the maps describe, or a payload word of a
;; live object — must point into the active young space or the active old space. A pointer into
;; the inactive semispace of either generation is a reference the collector never saw: a root
;; missing from a stack map, a wrongly typed live range, or a store the barrier did not cover.
;; The checks run outside the collection proper, so the space predicates describe settled state.
(defn rt-live-payload? [(payload i64)] (-> bool)
  (or (rt-in-from-space? payload) (rt-in-old-space? payload)))

(defn rt-stale-payload? [(payload i64)] (-> bool)
  (let [heap (rt-heap)
        young-base (primitive/cast i64 (.young-other heap))
        old-base (primitive/cast i64 (.old-other heap))]
    (or (and (>= payload young-base)
             (< payload (+ young-base (.capacity heap))))
        (and (>= payload old-base)
             (< payload (+ old-base (.old-capacity heap)))))))

(defn rt-verify-print! [(label (slice u8)) (value i64)] (-> i64)
  (try (let [stream (io/stderr)
             _ (try-or! (io/print-str stream "  ") 0)
             _ (try-or! (io/print-str stream label) 0)
             _ (try-or! (io/print-int stream value) 0)
             _ (try-or! (io/print-str stream "\n") 0)]
         0)))

(defn rt-verify-fail! [(what (slice u8))
                       (phase (slice u8))
                       (word i64)
                       (kind i64)] (-> i64)
  (do
    (try (let [stream (io/stderr)
               _ (try-or! (io/print-str stream "aot-gc-verify: ") 0)
               _ (try-or! (io/print-str stream what) 0)
               _ (try-or! (io/print-str stream " (") 0)
               _ (try-or! (io/print-str stream phase) 0)
               _ (try-or! (io/print-str stream " collection)\n") 0)]
           0))
    (rt-verify-print! "word=" word)
    (rt-verify-print! "kind=" kind)
    (rt-verify-print! "young_base=" (primitive/cast i64 (.from (rt-heap))))
    (rt-verify-print! "young_used=" (.used (rt-heap)))
    (rt-verify-print! "old_base=" (primitive/cast i64 (.to (rt-heap))))
    (rt-verify-print! "old_used=" (.to-used (rt-heap)))
    (rt-verify-print! "stale_young_base="
                      (primitive/cast i64 (.young-other (rt-heap))))
    (rt-verify-print! "stale_old_base="
                      (primitive/cast i64 (.old-other (rt-heap))))
    0))

;; The referenced payload of a root or field word, or zero when the word is not a reference.
;; Raw kinds are always addresses; boxed kinds reference only under a heap prefix.
(defn rt-reference-payload [(word i64) (raw bool)] (-> i64)
  (if raw word (if (rt-word-object? word) (& word RT-DYNAMIC-PAYLOAD-MASK) 0)))

;; An image object lives in the object file's `__aot_heap` section: outside every heap space,
;; never moved, scanned as a root, and a valid reference all the same.
(defn rt-static-payload? [(payload i64)] (-> bool)
  (let [images (.static-images (rt-heap)) (mut i) 0]
    (loop (if (>= (load i) (len images)) (break false)
              (let [region (get images (load i))]
                (if (and (>= payload (+ (.base region) (+ (.entries region) RT-HEADER-BYTES)))
                         (< payload (+ (.base region) (.bytes region))))
                    (break true)
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn rt-verify-reference? [(word i64) (raw bool)] (-> bool)
  (let [payload (rt-reference-payload word raw)]
    (or (= payload 0)
        (rt-static-payload? payload)
        (and (rt-live-payload? payload)
             (> (load (primitive/index (primitive/cast (ptr i64) payload) -1))
                0)))))

(defn rt-verify-frames! [(maps (ptr u8))
                         (map-bytes i64)
                         (record i64)
                         (caller-sp i64)
                         (text-base i64)
                         (walk-callers bool)
                         (phase (slice u8))] (-> i64)
  (let [cursor (primitive/alloc-stack RtFrameCursor)]
    (set! cursor (RtFrameCursor :maps maps :map-bytes map-bytes :text text-base :record record :sp caller-sp))
    (loop (if (< (.record cursor) 0)
              (break 0)
              (let [current-maps (.maps cursor) current-record (.record cursor)
                    slots (rt-stackmap-slot-count current-maps current-record)
                    (mut i) 0]
                (loop (if (>= (load i) slots)
                          (break 0)
                          (let [location
                                  (rt-stackmap-slot-location current-maps
                                                             current-record
                                                             (load i))
                                kind
                                  (rt-stackmap-slot-kind current-maps
                                                         current-record
                                                         (load i))
                                word
                                  (load (primitive/cast (ptr i64)
                                                        (+ (.sp cursor)
                                                           location)))]
                            (if (rt-verify-reference? word (= kind 1))
                                0
                                (do
                                  (rt-verify-fail! "stale frame root"
                                                   phase
                                                   word
                                                   kind)
                                  (rt-verify-print! "record="
                                                    current-record)
                                  (rt-verify-print! "return_pc="
                                                    (rt-read-u64 current-maps
                                                                 (+ current-record
                                                                    8)))
                                  (rt-verify-print! "safepoint_map_id="
                                                    (rt-read-u64 current-maps
                                                                 current-record))
                                  (rt-verify-print! "slot=" (load i))
                                  (rt-verify-print! "location=" location)
                                  (rt-verify-print! "frame_size="
                                                    (rt-stackmap-frame-size current-maps
                                                                            current-record))
                                  (panic "aot-gc-verify: a frame root is not a live reference")))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (if walk-callers (rt-frame-next! cursor) (do (set! (.record cursor) -1) 0))
                (continue))))))

(defn rt-verify-space! [(space (ptr u8))
                        (used i64)
                        (phase (slice u8))
                        (old bool)] (-> i64)
  (let [(mut offset) 0]
    (loop (if (>= (load offset) used)
              (break 0)
              (let [header
                      (primitive/cast (ptr i64)
                                      (primitive/index space (load offset)))
                    bytes (load (primitive/index header 0))
                    meta (load (primitive/index header 1))
                    shape (load (primitive/index header 2))
                    payload
                      (primitive/cast (ptr i64)
                                      (primitive/index space
                                                       (+ (load offset)
                                                          RT-HEADER-BYTES)))
                    words
                      (if (!= (& shape RT-SHAPE-NOSCAN-BIT) 0) 0 (/ bytes 8))
                    (mut i) 0]
                (if (or (< bytes 0) (<= shape 0))
                    (do
                      (rt-verify-fail! "malformed live object header"
                                       phase
                                       shape
                                       0)
                      (rt-verify-print! "space_offset=" (load offset))
                      (rt-verify-print! "bytes=" bytes)
                      (panic "aot-gc-verify: live object header is malformed"))
                    0)
                (loop (if (>= (load i) words)
                          (break 0)
                          (let [word (load (primitive/index payload (load i)))
                                raw-stale
                                  (and (!= (& meta RT-META-HAS-RAW) 0)
                                       (rt-stale-payload? word))]
                            (if (or raw-stale
                                    (not (rt-verify-reference? word false)))
                                (do
                                  (rt-verify-fail! (if old
                                                       "stale field in old object"
                                                       "stale field in young object")
                                                   phase
                                                   word
                                                   (if raw-stale 1 2))
                                  (rt-verify-print! "object_payload="
                                                    (primitive/cast i64 payload))
                                  (rt-verify-print! "field_word_index="
                                                    (load i))
                                  (rt-verify-print! "object_shape=" shape)
                                  (rt-verify-print! "object_meta=" meta)
                                  (panic "aot-gc-verify: a live object holds a stale reference"))
                                0)
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (set! (mut offset)
                      (+ (load offset) (rt-align8 (+ bytes RT-HEADER-BYTES))))
                (continue))))))

(defn rt-verify-heap! [(phase (slice u8))] (-> i64)
  (let [heap (rt-heap)]
    (if (rt-verify-reference? (.global-object heap) false)
        0
        (do
          (rt-verify-fail! "stale global object root"
                           phase
                           (.global-object heap)
                           2)
          (panic "aot-gc-verify: the global object root is not a live reference")))
    (if (or (= (.exception-value heap) 0)
            (rt-verify-reference? (.exception-value heap) false))
        0
        (do
          (rt-verify-fail! "stale pending exception root"
                           phase
                           (.exception-value heap)
                           2)
          (panic "aot-gc-verify: the pending exception is not a live reference")))
    (rt-verify-space! (.from heap) (.used heap) phase false)
    (al-for [binding (.global-lexicals heap)]
      (let [cell binding]
        (if (and (.initialized cell) (not (rt-verify-reference? (.value cell) false)))
            (do (rt-verify-fail! "stale global lexical root" phase (.value cell) 2)
                (panic "aot-gc-verify: global lexical value is not a live reference")) 0)))
    (rt-verify-space! (.to heap) (.to-used heap) phase true)
    (rt-verify-statics! phase)))

;; The realm's global object root. Generated code publishes and reads it as ordinary memory through
;; the heap-state register (`RtHeap.global-object`); the collector forwards it here.
(defn rt-forward-realm-roots! [] (-> i64)
  (let [heap (rt-heap)]
    (set! (.global-object heap) (rt-forward-boxed (.global-object heap)))
    (if (!= (.exception-value heap) 0)
        (set! (.exception-value heap)
              (rt-forward-boxed (.exception-value heap)))
        0)
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.global-lexicals heap))) (break 0)
        (let [cell (al-elem (field heap global-lexicals) (load i))]
          (if (.initialized cell) (set! (.value cell) (rt-forward-boxed (.value cell))) 0)
          (set! (mut i) (+ (load i) 1)) (continue)))))
    0))

;; A string's code units as UTF-8, the same pairing `rt-intern-key` performs.
(defn rt-string-utf8! [(string i64) (out (mut (ArrayList u8)))] (-> i64)
  (let [length (rt-string-length string)
        (mut i) 0]
    (loop (if (>= (load i) length)
              (break 0)
              (let [unit (rt-string-code-unit string (load i))]
                (if (and (>= unit 0xd800)
                         (< unit 0xdc00)
                         (< (+ (load i) 1) length))
                    (let [low (rt-string-code-unit string (+ (load i) 1))]
                      (if (and (>= low 0xdc00) (< low 0xe000))
                          (do
                            (rt-utf8-push! (mut out)
                                           (+ 0x10000
                                              (+ (* (- unit 0xd800) 0x400)
                                                 (- low 0xdc00))))
                            (set! (mut i) (+ (load i) 2)))
                          (do
                            (rt-utf8-push! (mut out) unit)
                            (set! (mut i) (+ (load i) 1)))))
                    (do
                      (rt-utf8-push! (mut out) unit)
                      (set! (mut i) (+ (load i) 1))))
                (continue))))
    0))

;; [[Get]] of an ASCII-named property along an object's prototype chain, for the runtime's own
;; reports: own storage first, then the prototype word at the payload's first slot. Undefined when
;; no object on the chain has it. Bounded, so a cyclic chain cannot hang the report.
(defn rt-report-get [(payload i64) (name (slice u8))] (-> i64)
  (let [key (shapes-intern-key name)
        (mut current) payload
        (mut answer) RT-DYNAMIC-UNDEFINED-WORD
        (mut depth) 0
        (mut done) false]
    (loop (if (or (load done) (> (load depth) 64))
              (break 0)
              (let [off (rt-prop-offset (load current) key)]
                (if (>= off 0)
                    (do
                      (set! (mut answer)
                            (load (primitive/cast (ptr i64)
                                                  (+ (rt-storage-of (load current))
                                                     off))))
                      (set! (mut done) true))
                    (let [proto (load (primitive/cast (ptr i64) (load current)))]
                      (if (or (= (rt-word-prefix proto)
                                 RT-DYNAMIC-PREFIX-OBJECT)
                              (= (rt-word-prefix proto)
                                 RT-DYNAMIC-PREFIX-FUNCTION)
                              (= (rt-word-prefix proto) RT-DYNAMIC-PREFIX-ARRAY))
                          (set! (mut current) (& proto RT-DYNAMIC-PAYLOAD-MASK))
                          (set! (mut done) true))))
                (set! (mut depth) (+ (load depth) 1))
                (continue))))
    (load answer)))

;; A JavaScript value rendered for a report, the way an engine prints an uncaught value: a string
;; as itself, a number, the literals, and an object by its `name` and `message` when it has them
;; (an Error), else `[object]`, `[function]` or `[array]`. Anything not a tagged word is a double,
;; shown by its bit pattern.
(defn rt-render-value! [(value i64) (out (mut (ArrayList u8)))] (-> i64)
  (let [prefix (rt-word-prefix value)
        payload (& value RT-DYNAMIC-PAYLOAD-MASK)]
    (if (= prefix RT-DYNAMIC-PREFIX-STRING)
        (rt-string-utf8! payload (mut out))
        (if (= prefix RT-DYNAMIC-PREFIX-INT)
            (let [signed
                    (if (>= payload 0x800000000000)
                        (- payload 0x1000000000000)
                        payload)
                  (mut sb) (sb-new (alloc/malloc-allocator))]
              (sb-push-i64! (mut sb) signed)
              (rt-push-bytes! (mut out) (sb-str (mut sb)))
              (sb-free! (mut sb))
              0)
            (if (= value RT-DYNAMIC-UNDEFINED-WORD)
                (rt-push-bytes! (mut out) "undefined")
                (if (= prefix 0x7ffb)
                    (rt-push-bytes! (mut out) "null")
                    (if (= prefix 0x7ffc)
                        (rt-push-bytes! (mut out)
                                        (if (= payload 0) "false" "true"))
                        (if (= prefix 0x7ffe)
                            (rt-push-bytes! (mut out) "[symbol]")
                            (if (or (= prefix RT-DYNAMIC-PREFIX-OBJECT)
                                    (= prefix RT-DYNAMIC-PREFIX-FUNCTION)
                                    (= prefix RT-DYNAMIC-PREFIX-ARRAY))
                                (let [name (rt-report-get payload "name")
                                      message (rt-report-get payload "message")]
                                  (if (= (rt-word-prefix name)
                                         RT-DYNAMIC-PREFIX-STRING)
                                      (do
                                        (rt-string-utf8! (& name
                                                            RT-DYNAMIC-PAYLOAD-MASK)
                                                         (mut out))
                                        (if (= (rt-word-prefix message)
                                               RT-DYNAMIC-PREFIX-STRING)
                                            (do
                                              (rt-push-bytes! (mut out) ": ")
                                              (rt-string-utf8! (& message
                                                                  RT-DYNAMIC-PAYLOAD-MASK)
                                                               (mut out)))
                                            0))
                                      (do
                                        (rt-push-bytes! (mut out)
                                                        (if (= prefix
                                                               RT-DYNAMIC-PREFIX-FUNCTION)
                                                            "[function]"
                                                            (if (= prefix
                                                                   RT-DYNAMIC-PREFIX-ARRAY)
                                                                "[array]"
                                                                "[object]")))
                                        ;; An error type without a `name` on its chain (test262's Test262Error) still
                                        ;; carries its message.
                                        (if (= (rt-word-prefix message)
                                               RT-DYNAMIC-PREFIX-STRING)
                                            (do
                                              (rt-push-bytes! (mut out) ": ")
                                              (rt-string-utf8! (& message
                                                                  RT-DYNAMIC-PAYLOAD-MASK)
                                                               (mut out)))
                                            0))))
                                ;; A double: its bit pattern reinterpreted. An integral value prints as an integer;
                                ;; any other prints its integer part with a marker, which is enough for a report.
                                (let [cell (primitive/alloc-stack i64)
                                      (mut sb) (sb-new (alloc/malloc-allocator))]
                                  (set! cell value)
                                  (let [f (load (primitive/cast (ptr f64) cell))
                                        truncated (primitive/cast i64 f)]
                                    (sb-push-i64! (mut sb) truncated)
                                    (if (primitive/fcmp-eq (primitive/cast f64
                                                                           truncated)
                                                           f)
                                        0
                                        (sb-push-str! (mut sb)
                                                      " (non-integral number)"))
                                    (rt-push-bytes! (mut out) (sb-str (mut sb)))
                                    (sb-free! (mut sb))
                                    0)))))))))
    0))

(defn rt-push-bytes! [(out (mut (ArrayList u8))) (text (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len text))
              (break 0)
              (do
                (push! [u8] (mut out) (get text (load i)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

;; The exception the program left uncaught after its last Script. Reported and fatal: status 3,
;; distinct from the compiler's own exit classes. The value is rendered (an Error by name and
;; message) so a failing program names its failure; the boxed word follows for the debugger.
(defn rt-uncaught [(value i64)] (-> i64)
  (do
    (try (let [stream (io/stderr)
               (mut text) (al-new [u8] (alloc/malloc-allocator))
               _ (rt-render-value! value (mut text))
               _ (try-or! (io/print-str stream "aot: uncaught exception: ") 0)
               _ (try-or! (io/print-str stream (al-slice (load text))) 0)
               _ (try-or! (io/print-str stream " (boxed word ") 0)
               _ (try-or! (io/print-int stream value) 0)
               _ (try-or! (io/print-str stream ")\n") 0)]
           (al-free! (mut text))
           0))
    (if (= (primitive/cast i64 (.text (rt-program))) 0)
        (do (os/_exit (primitive/cast i32 3)) 0)
        0)
    value))

(defn rt-collect-one-root! [(root (ptr i64))] (-> i64)
  (let [heap (rt-heap)]
    (rt-begin-collection!)
    (rt-forward-realm-roots!)
    (rt-scan-static-roots!)
    (set! root (rt-forward (load root)))
    (if (not (.major heap)) (rt-scan-remembered!) 0)
    (rt-scan-copied!)
    (rt-finish-collection!)
    (+ (.to-used heap) (.used heap))))

(defn rt-collect-from-maps! [(maps (ptr u8))
                             (map-bytes i64)
                             (map-id i64)
                             (caller-sp i64)] (-> i64)
  (rt-collect-from-maps-with-roots! maps
                                    map-bytes
                                    map-id
                                    caller-sp
                                    (primitive/cast (ptr i64) 0)
                                    (primitive/cast (ptr i64) 0)))

(defn rt-scan-stackmap-frame! [(maps (ptr u8)) (record i64) (sp i64)] (-> i64)
  (let [slots (rt-stackmap-slot-count maps record)
        (mut i) 0]
    (loop (if (>= (load i) slots)
              (break 0)
              (let [root
                      (primitive/cast (ptr i64)
                                      (+ sp
                                         (rt-stackmap-slot-location maps
                                                                    record
                                                                    (load i))))
                    kind (rt-stackmap-slot-kind maps record (load i))]
                (if (= kind 1)
                    (set! root (rt-forward (load root)))
                    (if (= kind 2)
                        (set! root (rt-forward-boxed (load root)))
                        (panic-i "rt-scan-stackmap-frame!: invalid root kind"
                                 kind)))
                (set! (mut i) (+ (load i) 1))
                (continue))))))

;; Runtime helpers that allocate may hold raw managed arguments in their own Coil frame. Generated
;; stack maps describe the caller but deliberately know nothing about that runtime frame, so the
;; helper supplies up to two explicit root addresses to the same collection before scanning starts.
;; A null address means no extra root. Keeping this inside the collector avoids a second collection
;; protocol and ensures every root participates in one forwarding closure.
(defn rt-collect-from-maps-with-roots! [(maps (ptr u8))
                                        (map-bytes i64)
                                        (map-id i64)
                                        (caller-sp i64)
                                        (root-a (ptr i64))
                                        (root-b (ptr i64))] (-> i64)
  (rt-collect-from-maps-with-roots-at! maps
                                       map-bytes
                                       map-id
                                       caller-sp
                                       root-a
                                       root-b
                                       false
                                       0
                                       false))

(defn rt-collect-from-maps-with-roots-at! [(maps (ptr u8))
                                           (map-bytes i64)
                                           (map-id i64)
                                           (caller-sp i64)
                                           (root-a (ptr i64))
                                           (root-b (ptr i64))
                                           (boxed-b bool)
                                           (text-base i64)
                                           (walk-callers bool)] (-> i64)
  (let [boot (.assembling-properties (rt-heap))
        record (if boot -1 (rt-stackmap-find maps map-bytes map-id))]
    (if (and boot (or (!= map-id 0) (!= caller-sp 0) walk-callers))
        (panic "rt-collect-from-maps-with-roots-at!: boot collection cannot contain generated frames") 0)
    (if (and (< record 0) (not boot))
        (do
          (panic-i "rt-collect-from-maps-with-roots!: missing safepoint map"
                   map-id)
          0)
        (let [heap (rt-heap)]
          (if (.verify heap)
              (do
                (if boot 0 (rt-verify-frames! maps
                                   map-bytes
                                   record
                                   caller-sp
                                   text-base
                                   walk-callers
                                   "before"))
                (rt-verify-heap! "before"))
              0)
          (rt-begin-collection!)
          (rt-forward-realm-roots!)
          (rt-scan-static-roots!)
          (if (!= (primitive/cast i64 root-a) 0)
              (set! root-a (rt-forward (load root-a)))
              0)
          ;; `root-b` is a raw payload address, or a boxed word when `boxed-b` (the runtime helper
          ;; holds a JavaScript value, whose prefix the forwarding keeps).
          (if (!= (primitive/cast i64 root-b) 0)
              (set! root-b
                    (if boxed-b
                        (rt-forward-boxed (load root-b))
                        (rt-forward (load root-b))))
              0)
          (let [cursor (primitive/alloc-stack RtFrameCursor)]
            (set! cursor (RtFrameCursor :maps maps :map-bytes map-bytes :text text-base :record record :sp caller-sp))
            (loop (if (< (.record cursor) 0)
                      (break 0)
                      (do
                        (rt-scan-stackmap-frame! (.maps cursor) (.record cursor) (.sp cursor))
                        (if walk-callers
                            (rt-frame-next! cursor)
                            (do (set! (.record cursor) -1) 0))
                        (continue)))))
          (if (not (.major heap)) (rt-scan-remembered!) 0)
          (rt-scan-copied!)
          (let [used (rt-finish-collection!)]
            (if (.verify heap)
                (do
                  (if boot 0 (rt-verify-frames! maps
                                     map-bytes
                                     record
                                     caller-sp
                                     text-base
                                     walk-callers
                                     "after"))
                  (rt-verify-heap! "after"))
                0)
            used)))))

(defn rt-linked-stackmaps [(size (ptr u64))] (-> (ptr u8))
  (if (!= (primitive/cast i64 (.text (rt-program))) 0)
      (do (set! size (.map-bytes (rt-program))) (.maps (rt-program)))
      (getsectiondata (primitive/cast (ptr u8)
                                  (primitive/linker-address _mh_execute_header))
                  c"__DATA"
                  c"__aot_stackmaps"
                  size)))

(defn rt-linked-text [(size (ptr u64))] (-> (ptr u8))
  (if (!= (primitive/cast i64 (.text (rt-program))) 0)
      (do (set! size (.text-bytes (rt-program))) (.text (rt-program)))
      (getsectiondata (primitive/cast (ptr u8)
                                  (primitive/linker-address _mh_execute_header))
                  c"__TEXT"
                  c"__text"
                  size)))

(defn rt-collect-linked! [(map-id i64) (caller-sp i64)] (-> i64)
  (rt-collect-linked-with-roots! map-id caller-sp
                                 (primitive/cast (ptr i64) 0) (primitive/cast (ptr i64) 0) false))

(defn rt-collect-linked-with-roots! [(map-id i64)
                                     (caller-sp i64)
                                     (root-a (ptr i64))
                                     (root-b (ptr i64))
                                     (boxed-b bool)] (-> i64)
  (if (< map-id 0) (panic "rt-collect-linked-with-roots!: invalid map token") 0)
  (if (.assembling-properties (rt-heap))
      ;; Boot assembly has no generated frame. Use the same forwarding closure and verifier,
      ;; with only realm/static roots and the runtime helper's explicit roots.
      (rt-collect-from-maps-with-roots-at! (primitive/cast (ptr u8) 0) 0 map-id caller-sp
                                           root-a root-b boxed-b 0 false)
      (rt-collect-generated-with-roots! map-id caller-sp root-a root-b boxed-b)))

(defn rt-collect-generated-with-roots! [(map-id i64) (caller-sp i64) (root-a (ptr i64))
                                       (root-b (ptr i64)) (boxed-b bool)] (-> i64)
  (if (> (primitive/ishr map-id 32) 0)
      (match (rt-code-find (primitive/ishr map-id 32))
        (Some [range]
          (let [r range]
            (rt-collect-from-maps-with-roots-at! (.maps r) (.map-bytes r)
                                                 (& map-id RT-LOCAL-MAP-ID-LIMIT) caller-sp
                                                 root-a root-b boxed-b (.text r) true)))
        (None [] (panic "rt-collect-linked-with-roots!: map token names unregistered code")))
  (let [size (primitive/alloc-stack u64)
        text-size (primitive/alloc-stack u64)
        maps (rt-linked-stackmaps size)
        linked-text (rt-linked-text text-size)]
    (if (or (= (primitive/cast i64 maps) 0)
            (= (primitive/cast i64 linked-text) 0))
        (do
          (panic "rt-collect-linked-with-roots!: executable has no __aot_stackmaps section")
          0)
        (rt-collect-from-maps-with-roots-at! maps
                                             (primitive/cast i64 (load size))
                                             map-id
                                             caller-sp
                                             root-a
                                             root-b
                                             boxed-b
                                             (primitive/cast i64 linked-text)
                                             true)))))

(defn rt-read-u32 [(p (ptr u8)) (off i64)] (-> i64)
  (| (primitive/cast i64 (load (primitive/index p off)))
     (| (primitive/ishl (primitive/cast i64
                                        (load (primitive/index p (+ off 1))))
                        8)
        (| (primitive/ishl (primitive/cast i64
                                           (load (primitive/index p (+ off 2))))
                           16)
           (primitive/ishl (primitive/cast i64
                                           (load (primitive/index p (+ off 3))))
                           24)))))

(defn rt-read-u64 [(p (ptr u8)) (off i64)] (-> i64)
  (| (rt-read-u32 p off) (primitive/ishl (rt-read-u32 p (+ off 4)) 32)))

(defn rt-stackmap-header-valid? [(maps (ptr u8)) (bytes i64)] (-> bool)
  (and (>= bytes RT-STACKMAP-HEADER-BYTES)
       (and (= (rt-read-u64 maps 0) 0x0050414d53544f41)
            (= (rt-read-u32 maps 8) 3))))

;; Return the byte offset of `map-id`'s record, or -1. Bounds are checked before every variable-size
;; advance so malformed object metadata cannot turn collection into an arbitrary memory walk.
(defn rt-stackmap-find [(maps (ptr u8)) (bytes i64) (map-id i64)] (-> i64)
  (if (not (rt-stackmap-header-valid? maps bytes))
      -1
      (let [count (rt-read-u32 maps 12)
            (mut record) RT-STACKMAP-HEADER-BYTES
            (mut i) 0]
        (loop (if (>= (load i) count)
                  (break -1)
                  (if (> (+ (load record) RT-STACKMAP-RECORD-BYTES) bytes)
                      (break -1)
                      (let [slots (rt-read-u32 maps (+ (load record) 16))
                            size
                              (+ RT-STACKMAP-RECORD-BYTES
                                 (* slots RT-STACKMAP-SLOT-BYTES))]
                        (if (> (+ (load record) size) bytes)
                            (break -1)
                            (if (= (rt-read-u64 maps (load record)) map-id)
                                (break (load record))
                                (do
                                  (set! (mut record) (+ (load record) size))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue)))))))))))

(defn rt-stackmap-find-return-pc [(maps (ptr u8)) (bytes i64) (return-pc i64)] (-> i64)
  (if (not (rt-stackmap-header-valid? maps bytes))
      -1
      (let [count (rt-read-u32 maps 12)
            (mut record) RT-STACKMAP-HEADER-BYTES
            (mut i) 0]
        (loop (if (>= (load i) count)
                  (break -1)
                  (if (> (+ (load record) RT-STACKMAP-RECORD-BYTES) bytes)
                      (break -1)
                      (let [slots (rt-read-u32 maps (+ (load record) 16))
                            size
                              (+ RT-STACKMAP-RECORD-BYTES
                                 (* slots RT-STACKMAP-SLOT-BYTES))]
                        (if (> (+ (load record) size) bytes)
                            (break -1)
                            (if (= (rt-read-u64 maps (+ (load record) 8))
                                   return-pc)
                                (break (load record))
                                (do
                                  (set! (mut record) (+ (load record) size))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue)))))))))))

(defn rt-stackmap-frame-size [(maps (ptr u8)) (record i64)] (-> i64)
  (rt-read-u32 maps (+ record 20)))

(defn rt-stackmap-rpc-offset [(maps (ptr u8)) (record i64)] (-> i64)
  (rt-read-u32 maps (+ record 24)))

(defn rt-stackmap-slot-count [(maps (ptr u8)) (record i64)] (-> i64)
  (rt-read-u32 maps (+ record 16)))

(defn rt-stackmap-slot-location [(maps (ptr u8)) (record i64) (slot i64)] (-> i64)
  (rt-read-u32 maps
               (+ (+ record RT-STACKMAP-RECORD-BYTES)
                  (* slot RT-STACKMAP-SLOT-BYTES))))

(defn rt-stackmap-slot-kind [(maps (ptr u8)) (record i64) (slot i64)] (-> i64)
  (primitive/cast i64
                  (load (primitive/index maps
                                         (+ (+ (+ record
                                                  RT-STACKMAP-RECORD-BYTES)
                                               (* slot RT-STACKMAP-SLOT-BYTES))
                                            4)))))

;; Every managed pointer names the first payload byte. The three words immediately before it are
;; runtime-owned and never participate in shape offsets:
;;
;;   payload[-24] = payload byte count
;;   payload[-16] = collector metadata
;;   payload[ -8] = hidden-class shape ID
;;
;; Keeping the public pointer payload-relative makes offset zero mean the first field, exactly as
;; `shape-offset` and the ideal Load/Store nodes require. `malloc` is only the runtime's backing
;; store; generated code never calls a host allocator and never knows this header representation.
(defn rt-alloc [(bytes i64) (shape i64) (map-id i64) (caller-sp i64)] (-> i64)
  (do
    ;; `map-id` and `caller-sp` identify the writable roots at this allocation. They become active
    ;; when nursery exhaustion invokes the moving collector; accepting them here makes omission at
    ;; any generated allocation impossible even before the collector policy starts collecting.
    map-id
    caller-sp
    (if (or (< bytes 0) (> bytes RT-MAX-PAYLOAD-BYTES))
        (alloc/oom-at c"aot_rt_alloc: invalid payload size" bytes)
        0)
    (if (<= shape 0)
        (alloc/oom-at c"aot_rt_alloc: invalid shape" shape)
        0)
    (rt-heap-boot!)
    (if (and (.stress (rt-heap)) (> map-id 0))
        (rt-collect-linked! map-id caller-sp)
        0)
    (if (> (rt-align8 (+ bytes RT-HEADER-BYTES)) (.capacity (rt-heap)))
        (let [payload (rt-heap-allocate-old bytes shape)]
          (if (!= payload 0)
              payload
              (do
                (set! (.force-major (rt-heap)) true)
                (rt-collect-linked! map-id caller-sp)
                (let [retry (rt-heap-allocate-old bytes shape)]
                  (if (= retry 0)
                      (alloc/oom-at c"aot_rt_alloc: large object exceeds old generation"
                                    bytes)
                      retry)))))
        (let [payload (rt-heap-allocate-active bytes shape)]
          (if (= payload 0)
              (do
                (rt-collect-linked! map-id caller-sp)
                (let [retry (rt-heap-allocate-active bytes shape)]
                  (if (= retry 0)
                      ;; A minor collection can fill the survivor nursery with first survivors.
                      ;; That is not heap exhaustion. With no intervening allocation, every
                      ;; remaining young object is now aged: the next minor promotes it, or the
                      ;; existing capacity policy chooses a major. Both empty the nursery. Keep
                      ;; using the same writable root maps, which the first collection updated.
                      (do
                        (rt-collect-linked! map-id caller-sp)
                        (let [promoted (rt-heap-allocate-active bytes shape)]
                          (if (= promoted 0)
                              (alloc/oom-at c"aot_rt_alloc: nursery unavailable after promotion"
                                            bytes)
                              promoted)))
                      retry)))
              payload)))))

(defn rt-payload-bytes [(payload i64)] (-> i64)
  (load (primitive/index (primitive/cast (ptr i64) payload) -3)))

(defn rt-payload-shape [(payload i64)] (-> i64)
  (load (primitive/index (primitive/cast (ptr i64) payload) -1)))

(defn rt-string-length [(string i64)] (-> i64)
  (load (primitive/cast (ptr i64) string)))

(defn rt-string-code-unit [(string i64) (index i64)] (-> i64)
  (primitive/cast i64
                  (load (primitive/index (primitive/cast (ptr u16) string)
                                         (+ 4 index)))))

(defn rt-string-set-code-unit! [(string i64) (index i64) (unit i64)] (-> i64)
  (do
    (set! (primitive/index (primitive/cast (ptr u16) string) (+ 4 index))
          (primitive/cast u16 unit))
    unit))

(defn rt-string-eq [(left i64) (right i64)] (-> i64)
  (let [left-length (rt-string-length left)
        right-length (rt-string-length right)]
    (if (!= left-length right-length)
        0
        (let [(mut i) 0
              (mut equal) 1]
          (loop (if (or (= (load equal) 0) (>= (load i) left-length))
                    (break 0)
                    (do
                      (if (!= (rt-string-code-unit left (load i))
                              (rt-string-code-unit right (load i)))
                          (set! (mut equal) 0)
                          0)
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (load equal)))))

;; ECMA-262's abstract relational comparison on two strings is lexicographic over UTF-16 code
;; units. Return -1/0/1 so JSL decides which relational operator it is implementing.
(defn rt-string-compare [(left i64) (right i64)] (-> i64)
  (let [left-length (rt-string-length left)
        right-length (rt-string-length right)
        limit (if (< left-length right-length) left-length right-length)
        (mut i) 0
        (mut answer) 0]
    (loop (if (or (!= (load answer) 0) (>= (load i) limit))
              (break 0)
              (let [a (rt-string-code-unit left (load i))
                    b (rt-string-code-unit right (load i))]
                (if (< a b)
                    (set! (mut answer) -1)
                    (if (> a b) (set! (mut answer) 1) 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (!= (load answer) 0)
        (load answer)
        (if (< left-length right-length)
            -1
            (if (> left-length right-length) 1 0)))))

(defn rt-string-concat [(left i64)
                        (right i64)
                        (shape i64)
                        (map-id i64)
                        (caller-sp i64)] (-> i64)
  (let [left-root (primitive/alloc-stack i64)
        right-root (primitive/alloc-stack i64)]
    (set! left-root left)
    (set! right-root right)
    (rt-heap-boot!)
    (if (and (.stress (rt-heap)) (> map-id 0))
        (rt-collect-linked-with-roots! map-id
                                       caller-sp
                                       left-root
                                       right-root
                                       false)
        0)
    (let [left-length (rt-string-length left)
          right-length (rt-string-length right)
          length (+ left-length right-length)]
      (if (or (< length left-length)
              (> length (/ (- RT-MAX-PAYLOAD-BYTES 8) 2)))
          (alloc/oom-at c"aot_rt_string_concat: string is too large" length)
          0)
      (let [bytes (+ 8 (* length 2))
            large
              (> (rt-align8 (+ bytes RT-HEADER-BYTES)) (.capacity (rt-heap)))
            initial
              (if large
                  (rt-heap-allocate-old bytes shape)
                  (rt-heap-allocate-active bytes shape))
            result
              (if (!= initial 0)
                  initial
                  (do
                    (if large (set! (.force-major (rt-heap)) true) 0)
                    (rt-collect-linked-with-roots! map-id
                                                   caller-sp
                                                   left-root
                                                   right-root
                                                   false)
                    (let [retry
                            (if large
                                (rt-heap-allocate-old bytes shape)
                                (rt-heap-allocate-active bytes shape))]
                      (if (= retry 0)
                          (alloc/oom-at c"aot_rt_string_concat: object exceeds generation"
                                        bytes)
                          retry))))]
        (set! (primitive/cast (ptr i64) result) length)
        (let [(mut i) 0]
          (loop (if (>= (load i) left-length)
                    (break 0)
                    (do
                      (rt-string-set-code-unit! result
                                                (load i)
                                                (rt-string-code-unit (load left-root)
                                                                     (load i)))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (set! (mut i) 0)
          (loop (if (>= (load i) right-length)
                    (break 0)
                    (do
                      (rt-string-set-code-unit! result
                                                (+ left-length (load i))
                                                (rt-string-code-unit (load right-root)
                                                                     (load i)))
                      (set! (mut i) (+ (load i) 1))
                      (continue)))))
        result))))

;; A fresh string of `length` code units, zero-filled, with `root` (a raw string payload the caller
;; still needs) kept alive and re-read across any collection the allocation triggers.
(defn rt-alloc-string [(length i64)
                       (shape i64)
                       (map-id i64)
                       (caller-sp i64)
                       (root (ptr i64))] (-> i64)
  (do
    (if (> length (/ (- RT-MAX-PAYLOAD-BYTES 8) 2))
        (alloc/oom-at c"aot_rt_alloc_string: string is too large" length)
        0)
    (let [result
            (rt-alloc-rooted (+ 8 (* length 2))
                             shape
                             map-id
                             caller-sp
                             root
                             (primitive/cast (ptr i64) 0)
                             false)]
      (set! (primitive/cast (ptr i64) result) length)
      result)))

;; The runtime capability behind `%Substring`: the code units of [start, end), which the caller
;; has already clamped into the string.
(defn rt-substring [(string i64)
                    (start i64)
                    (end i64)
                    (shape i64)
                    (map-id i64)
                    (caller-sp i64)] (-> i64)
  (let [root (primitive/alloc-stack i64)]
    (set! root string)
    (rt-heap-boot!)
    (if (or (< start 0) (> start end) (> end (rt-string-length string)))
        (panic-i "aot_rt_substring: bounds outside the string" end)
        0)
    (let [length (- end start)
          result (rt-alloc-string length shape map-id caller-sp root)
          (mut i) 0]
      (loop (if (>= (load i) length)
                (break 0)
                (do
                  (rt-string-set-code-unit! result
                                            (load i)
                                            (rt-string-code-unit (load root)
                                                                 (+ start
                                                                    (load i))))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      result)))

;; The runtime capability behind `%StringFromCharCode`: a one-unit string of the code unit.
(defn rt-string-from-code [(unit i64) (shape i64) (map-id i64) (caller-sp i64)] (-> i64)
  (let [none (primitive/alloc-stack i64)]
    (set! none 0)
    (rt-heap-boot!)
    (let [result (rt-alloc-string 1 shape map-id caller-sp none)]
      (rt-string-set-code-unit! result 0 (& unit 0xffff))
      result)))

(defn rt-collect [(map-id i64) (caller-sp i64)] (-> i64)
  (rt-collect-linked! map-id caller-sp))

;; ---------------------------------------------------------------------------
;; Number::toString(x, 10) — ECMA-262 §6.1.6.1.20.
;;
;; The digits are the shortest decimal that reads back as the same double (the spec's "k is as
;; small as possible"): try one more significant digit at a time through `snprintf("%.*e")` and
;; accept the first that `strtod` returns unchanged; the spec's tie rule (the closest such digit
;; string, then the even one) is what a correctly rounded printf produces for that precision. The
;; layout rules then place the point or choose the exponent form exactly as the section lists them.
(defn rt-number-word-value [(word i64)] (-> f64)
  (if (= (rt-word-prefix word) RT-DYNAMIC-PREFIX-INT)
      (let [payload (& word RT-DYNAMIC-PAYLOAD-MASK)
            signed
              (if (!= (& payload 0x800000000000) 0)
                  (- payload 0x1000000000000)
                  payload)]
        (primitive/cast f64 signed))
      (let [slot (primitive/alloc-stack i64)]
        (set! slot word)
        (load (primitive/cast (ptr f64) slot)))))

(defn rt-ascii-push! [(buf (ptr u8)) (n (ptr i64)) (c i64)] (-> i64)
  (do
    (set! (primitive/index buf (load n)) (primitive/cast u8 c))
    (set! n (+ (load n) 1))
    0))

(defn rt-ascii-push-int! [(buf (ptr u8)) (n (ptr i64)) (v0 i64)] (-> i64)
  (let [tmp (primitive/alloc-stack (array u8 24))
        tp (primitive/cast (ptr u8) tmp)
        (mut v) v0
        (mut k) 0]
    (if (= (load v) 0) (rt-ascii-push! buf n 48) 0)
    (loop (if (= (load v) 0)
              (break 0)
              (do
                (set! (primitive/index tp (load k))
                      (primitive/cast u8 (+ 48 (% (load v) 10))))
                (set! (mut k) (+ (load k) 1))
                (set! (mut v) (/ (load v) 10))
                (continue))))
    (loop (if (= (load k) 0)
              (break 0)
              (do
                (set! (mut k) (- (load k) 1))
                (rt-ascii-push! buf
                                n
                                (primitive/cast i64
                                                (load (primitive/index tp
                                                                       (load k)))))
                (continue))))
    0))

;; The shortest digit string of a positive finite double into `digits` (k bytes, returned) and its
;; decimal exponent `n` such that value = 0.d1d2...dk × 10^n.
(defn rt-shortest-digits! [(x f64) (digits (ptr u8)) (n (ptr i64))] (-> i64)
  (let [buf (primitive/alloc-stack (array i8 64))
        bp (primitive/cast (ptr i8) buf)
        end (primitive/alloc-stack (ptr i8))
        (mut precision) 0
        (mut k) 0]
    (loop (if (> (load precision) 17)
              (break 0)
              (do
                (snprintf bp 64 c"%.*e" (primitive/cast i32 (load precision)) x)
                (if (primitive/fcmp-eq (strtod bp end) x)
                    (let [(mut i) 0
                          (mut count) 0
                          (mut exp) 0
                          (mut neg) false
                          (mut at-exp) false]
                      ;; d.ddd…e±XX: collect the digits, then the exponent.
                      (loop (if (= (primitive/cast i64
                                                   (load (primitive/index bp
                                                                          (load i))))
                                   0)
                                (break 0)
                                (let [c
                                        (primitive/cast i64
                                                        (load (primitive/index bp
                                                                               (load i))))]
                                  (if (load at-exp)
                                      (if (= c 45)
                                          (set! (mut neg) true)
                                          (if (and (>= c 48) (<= c 57))
                                              (set! (mut exp)
                                                    (+ (* (load exp) 10)
                                                       (- c 48)))
                                              0))
                                      (if (= c 101)
                                          (set! (mut at-exp) true)
                                          (if (and (>= c 48) (<= c 57))
                                              (do
                                                (set! (primitive/index digits
                                                                       (load count))
                                                      (primitive/cast u8 c))
                                                (set! (mut count)
                                                      (+ (load count) 1)))
                                              0)))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))
                      ;; Trailing zeros are not significant.
                      (loop (if (and (> (load count) 1)
                                     (= (primitive/cast i64
                                                        (load (primitive/index digits
                                                                               (- (load count)
                                                                                  1))))
                                        48))
                                (do
                                  (set! (mut count) (- (load count) 1))
                                  (continue))
                                (break 0)))
                      (set! n (+ (if (load neg) (- 0 (load exp)) (load exp)) 1))
                      (set! (mut k) (load count))
                      (break 0))
                    (do
                      (set! (mut precision) (+ (load precision) 1))
                      (continue))))))
    (if (= (load k) 0)
        (panic "rt-shortest-digits!: no precision reproduced the double")
        0)
    (load k)))

;; Write Number::toString(x) as ASCII into `out` (at most 32 bytes), returning its length.
(defn rt-number-to-ascii! [(x0 f64) (out (ptr u8))] (-> i64)
  (let [n (primitive/alloc-stack i64)
        count (primitive/alloc-stack i64)
        digits (primitive/alloc-stack (array u8 32))
        dp (primitive/cast (ptr u8) digits)
        (mut x) x0]
    (set! count 0)
    (if (not (primitive/fcmp-eq (load x) (load x)))
        (do
          (rt-ascii-push! out count 78)
          (rt-ascii-push! out count 97)
          (rt-ascii-push! out count 78)
          0)
        (if (primitive/fcmp-eq (load x) 0.0)
            (rt-ascii-push! out count 48)
            (do
              (if (primitive/fcmp-lt (load x) 0.0)
                  (do
                    (rt-ascii-push! out count 45)
                    (set! (mut x) (primitive/fsub 0.0 (load x)))
                    0)
                  0)
              (if (primitive/fcmp-eq (load x) (primitive/fdiv 1.0 0.0))
                  (let [word "Infinity"
                        (mut i) 0]
                    (loop (if (>= (load i) (len word))
                              (break 0)
                              (do
                                (rt-ascii-push! out
                                                count
                                                (primitive/cast i64
                                                                (get word
                                                                     (load i))))
                                (set! (mut i) (+ (load i) 1))
                                (continue)))))
                  (let [k (rt-shortest-digits! (load x) dp n)
                        nn (load n)]
                    (if (and (<= k nn) (<= nn 21))
                        ;; Digits then zeros.
                        (let [(mut i) 0]
                          (loop (if (>= (load i) nn)
                                    (break 0)
                                    (do
                                      (rt-ascii-push! out
                                                      count
                                                      (if (< (load i) k)
                                                          (primitive/cast i64
                                                                          (load (primitive/index dp
                                                                                                 (load i))))
                                                          48))
                                      (set! (mut i) (+ (load i) 1))
                                      (continue)))))
                        (if (and (< 0 nn) (<= nn 21))
                            ;; The point inside the digits.
                            (let [(mut i) 0]
                              (loop (if (>= (load i) k)
                                        (break 0)
                                        (do
                                          (if (= (load i) nn)
                                              (rt-ascii-push! out count 46)
                                              0)
                                          (rt-ascii-push! out
                                                          count
                                                          (primitive/cast i64
                                                                          (load (primitive/index dp
                                                                                                 (load i)))))
                                          (set! (mut i) (+ (load i) 1))
                                          (continue)))))
                            (if (and (< -6 nn) (<= nn 0))
                                ;; 0.000ddd
                                (let [(mut i) 0]
                                  (rt-ascii-push! out count 48)
                                  (rt-ascii-push! out count 46)
                                  (loop (if (>= (load i) (- 0 nn))
                                            (break 0)
                                            (do
                                              (rt-ascii-push! out count 48)
                                              (set! (mut i) (+ (load i) 1))
                                              (continue))))
                                  (set! (mut i) 0)
                                  (loop (if (>= (load i) k)
                                            (break 0)
                                            (do
                                              (rt-ascii-push! out
                                                              count
                                                              (primitive/cast i64
                                                                              (load (primitive/index dp
                                                                                                     (load i)))))
                                              (set! (mut i) (+ (load i) 1))
                                              (continue)))))
                                ;; d.ddde±x
                                (let [(mut i) 1
                                      e (- nn 1)]
                                  (rt-ascii-push! out
                                                  count
                                                  (primitive/cast i64
                                                                  (load (primitive/index dp
                                                                                         0))))
                                  (if (> k 1)
                                      (do
                                        (rt-ascii-push! out count 46)
                                        (loop (if (>= (load i) k)
                                                  (break 0)
                                                  (do
                                                    (rt-ascii-push! out
                                                                    count
                                                                    (primitive/cast i64
                                                                                    (load (primitive/index dp
                                                                                                           (load i)))))
                                                    (set! (mut i)
                                                          (+ (load i) 1))
                                                    (continue)))))
                                      0)
                                  (rt-ascii-push! out count 101)
                                  (rt-ascii-push! out count (if (< e 0) 45 43))
                                  (rt-ascii-push-int! out
                                                      count
                                                      (if (< e 0) (- 0 e) e))
                                  0)))))))))
    (load count)))

;; The runtime capability behind `%InternKey`: a string's property-key id (ToPropertyKey's
;; identity step). The string's UTF-16 code units are encoded as UTF-8 for the key table, whose
;; names are the compiler's source spellings.
(defn rt-utf8-push! [(out (mut (ArrayList u8))) (cp i64)] (-> i64)
  (do
    (if (< cp 0x80)
        (push! [u8] (mut out) (primitive/cast u8 cp))
        (if (< cp 0x800)
            (do
              (push! [u8]
                     (mut out)
                     (primitive/cast u8 (| 0xc0 (primitive/ishr cp 6))))
              (push! [u8] (mut out) (primitive/cast u8 (| 0x80 (& cp 0x3f)))))
            (if (< cp 0x10000)
                (do
                  (push! [u8]
                         (mut out)
                         (primitive/cast u8 (| 0xe0 (primitive/ishr cp 12))))
                  (push! [u8]
                         (mut out)
                         (primitive/cast u8
                                         (| 0x80 (& (primitive/ishr cp 6) 0x3f))))
                  (push! [u8]
                         (mut out)
                         (primitive/cast u8 (| 0x80 (& cp 0x3f)))))
                (do
                  (push! [u8]
                         (mut out)
                         (primitive/cast u8 (| 0xf0 (primitive/ishr cp 18))))
                  (push! [u8]
                         (mut out)
                         (primitive/cast u8
                                         (| 0x80
                                            (& (primitive/ishr cp 12) 0x3f))))
                  (push! [u8]
                         (mut out)
                         (primitive/cast u8
                                         (| 0x80 (& (primitive/ishr cp 6) 0x3f))))
                  (push! [u8]
                         (mut out)
                         (primitive/cast u8 (| 0x80 (& cp 0x3f))))))))
    0))

(defn rt-intern-key [(string i64)] (-> i64)
  (let [a (alloc/malloc-allocator)
        (mut bytes) (al-new [u8] a)
        length (rt-string-length string)
        (mut i) 0]
    (rt-heap-boot!)
    (loop (if (>= (load i) length)
              (break 0)
              (let [unit (rt-string-code-unit string (load i))]
                ;; A surrogate pair is one code point; a lone surrogate keeps its own encoding.
                (if (and (>= unit 0xd800)
                         (< unit 0xdc00)
                         (< (+ (load i) 1) length))
                    (let [low (rt-string-code-unit string (+ (load i) 1))]
                      (if (and (>= low 0xdc00) (< low 0xe000))
                          (do
                            (rt-utf8-push! (mut bytes)
                                           (+ 0x10000
                                              (+ (* (- unit 0xd800) 0x400)
                                                 (- low 0xdc00))))
                            (set! (mut i) (+ (load i) 2)))
                          (do
                            (rt-utf8-push! (mut bytes) unit)
                            (set! (mut i) (+ (load i) 1)))))
                    (do
                      (rt-utf8-push! (mut bytes) unit)
                      (set! (mut i) (+ (load i) 1))))
                (continue))))
    (let [key (shapes-intern-key (al-slice (load bytes)))]
      (al-free! [u8] (mut bytes))
      key)))

;; The runtime capability behind `%NumberToString`: a boxed number word to a fresh string.
(defn rt-number-to-string [(word i64) (shape i64) (map-id i64) (caller-sp i64)] (-> i64)
  (let [ascii (primitive/alloc-stack (array u8 32))
        ap (primitive/cast (ptr u8) ascii)]
    (rt-heap-boot!)
    (let [length (rt-number-to-ascii! (rt-number-word-value word) ap)
          result
            (rt-alloc-rooted (+ 8 (* length 2))
                             shape
                             map-id
                             caller-sp
                             (primitive/cast (ptr i64) 0)
                             (primitive/cast (ptr i64) 0)
                             false)
          (mut i) 0]
      (set! (primitive/cast (ptr i64) result) length)
      (loop (if (>= (load i) length)
                (break 0)
                (do
                  (rt-string-set-code-unit! result
                                            (load i)
                                            (primitive/cast i64
                                                            (load (primitive/index ap
                                                                                   (load i)))))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      result)))

;; ---------------------------------------------------------------------------
;; Generic own-property access over the runtime shape tree (`aot.rt.shapes`).
;;
;; Generated code takes these when the owner's layout is not statically known: a raw ordinary
;; object payload, a property-key id, and for a store the boxed value. An object's properties word
;; (payload offset 8) is null or a boxed backing store whose header shape says where each key is.
(defn rt-linked-shapes [(size (ptr u64))] (-> (ptr u8))
  (if (!= (primitive/cast i64 (.text (rt-program))) 0)
      (do (set! size (.shape-bytes (rt-program))) (.shapes (rt-program)))
      (getsectiondata (primitive/cast (ptr u8)
                                  (primitive/linker-address _mh_execute_header))
                  c"__DATA"
                  c"__aot_shapes"
                  size)))

(defn rt-shapes-boot! [] (-> i64)
  (if (shapes-booted?)
      0
      (let [size (primitive/alloc-stack u64)]
        (set! size 0)
        (let [blob (rt-linked-shapes size)]
          (shapes-boot! blob (primitive/cast i64 (load size)))))))

(defn rt-linked-heap-image [(size (ptr u64))] (-> (ptr u8))
  (if (!= (primitive/cast i64 (.text (rt-program))) 0)
      (do (set! size (.image-bytes (rt-program))) (.image (rt-program)))
      (getsectiondata (primitive/cast (ptr u8)
                                  (primitive/linker-address _mh_execute_header))
                  c"__DATA"
                  c"__aot_heap"
                  size)))

;; Execution storage is owned independently of compiled code. The installed descriptor and image
;; remain live until this destroys the realm's heap and all runtime-created shape/key storage.
(defn rt-heap-release! [] (-> i64)
  (let [h (rt-heap) a (alloc/malloc-allocator)]
    (if (.booted h)
        (do
          (alloc/free [u8] a (slice-new [u8] (.from h) (.capacity h)))
          (alloc/free [u8] a (slice-new [u8] (.young-other h) (.capacity h)))
          (alloc/free [u8] a (slice-new [u8] (.to h) (.old-capacity h)))
          (alloc/free [u8] a (slice-new [u8] (.old-other h) (.old-capacity h)))
          (alloc/free [u8] a (slice-new [u8] (.cards h) (.card-count h)))
          (alloc/free [u8] a (slice-new [u8] (.other-cards h) (.card-count h)))
          (alloc/free [i64] a (slice-new [i64] (.starts h) (.card-count h)))
          (alloc/free [i64] a (slice-new [i64] (.other-starts h) (.card-count h)))
          (al-free! [RtStaticImage] (mut (.static-images h)))
          (al-free! [RtGlobalLexical] (mut (.global-lexicals h)))
          (hm-free! (mut (.global-lexical-slots h)))
          (alloc/free [i64] a (slice-new [i64] (.unit-bases h) (.unit-count h)))
          (alloc/free [i64] a (slice-new [i64] (.unit-keys h) (.unit-count h)))
          (alloc/free [i64] a (slice-new [i64] (.unit-shapes h) (.unit-count h)))
          (alloc/free [i64] a (slice-new [i64] (.unit-objects h) (.unit-count h)))
          (al-for [objects (.object-maps h)] (alloc/free [i64] a objects))
          (al-free! (mut (.object-maps h)))
          (alloc/free [i64] a (.default-keys h))
          (alloc/free [i64] a (.default-shapes h))
          0)
        0)
    (set! h (primitive/zeroed RtHeap))
    0))

(defn rt-realm-destroy! [] (-> i64)
    (rt-heap-release!)
    (shapes-destroy!)
    (rt-stats-report)
    (set! (rt-stats) (primitive/zeroed RtStats))
    (set! (rt-program) (primitive/zeroed RtProgram))
    0)

(defn rt-image-magic? [(p (ptr u8))] (-> bool)
  (and (= (primitive/cast i64 (load (primitive/index p 0))) 0x41)
       (and (= (primitive/cast i64 (load (primitive/index p 1))) 0x4f)
            (and (= (primitive/cast i64 (load (primitive/index p 2))) 0x54)
                 (and (= (primitive/cast i64 (load (primitive/index p 3))) 0x48)
                      (and (= (primitive/cast i64 (load (primitive/index p 4)))
                              0x45)
                           (and (= (primitive/cast i64
                                                   (load (primitive/index p 5)))
                                   0x41)
                                (and (= (primitive/cast i64
                                                        (load (primitive/index p
                                                                               6)))
                                        0x50)
                                     (= (primitive/cast i64
                                                        (load (primitive/index p
                                                                               7)))
                                        0)))))))))

;; Adopt the static heap image (aot.heap documents the layout). Every REF word the header lists
;; holds its tag prefix over a section offset; the section's load address is added once, here,
;; and the boxed global object word the header carries becomes the realm root. Code words were
;; relocated by the linker. Generated code runs only after the process entry has booted the heap,
;; so no word is read before it is relocated.
;; A realm may adopt multiple disjoint images. Adoption borrows writable bytes until teardown;
;; callers supply a fresh copy, retain it, and resolve shape/key identities before execution.
;; Only one image may publish the global root. Other units must bind that existing realm global.
(defn rt-statics-adopt! [(blob (ptr u8)) (bytes i64)] (-> i64)
  (let [heap (rt-heap)
        base (primitive/cast i64 blob)]
    (if (not (.booted heap)) (panic "rt-statics-adopt!: no active realm") 0)
    (if (.object-bindings-finalized heap) (panic "rt-statics-adopt!: realm object bindings are finalized") 0)
    (if (or (<= base 0) (!= (% base 8) 0) (< bytes 0)
            (> bytes (- RT-DYNAMIC-PAYLOAD-MASK base)))
        (panic "rt-statics-adopt!: invalid image address range") 0)
    (al-for [item (.static-images heap)]
      (let [region item]
        (if (and (< base (+ (.base region) (.bytes region)))
                 (< (.base region) (+ base bytes)))
            (panic "rt-statics-adopt!: image overlaps an already adopted region") 0)))
    (if (< bytes RT-IMAGE-FIXED-BYTES)
        (panic-i "rt-statics-adopt!: __aot_heap is shorter than its header"
                 bytes)
        0)
    (if (not (rt-image-magic? blob))
        (panic "rt-statics-adopt!: __aot_heap has the wrong magic")
        0)
    (if (!= (rt-read-u32 blob 8) RT-IMAGE-VERSION)
        (panic-i "rt-statics-adopt!: unsupported __aot_heap version"
                 (rt-read-u32 blob 8))
        0)
    (let [count (rt-read-u32 blob 12)
          global (rt-read-u64 blob 16)
          nrelocs (rt-read-u32 blob 24)
          entries (rt-read-u32 blob 28)
          (mut k) 0]
      (if (and (!= global 0) (!= (.global-object heap) 0))
          (panic "rt-statics-adopt!: a realm already has a global root") 0)
      (if (> (+ RT-IMAGE-FIXED-BYTES (* 4 nrelocs)) entries)
          (panic-i "rt-statics-adopt!: relocation list overruns the entries"
                   nrelocs)
          0)
      (if (or (> entries bytes) (!= (% entries 8) 0) (!= (% bytes 8) 0))
          (panic-i "rt-statics-adopt!: entries start past the section" entries)
          0)
      (loop (if (>= (load k) nrelocs)
                (break 0)
                (let [offset
                        (rt-read-u32 blob
                                     (+ RT-IMAGE-FIXED-BYTES (* 4 (load k))))]
                  (if (or (< offset entries) (> (+ offset 8) bytes) (!= (% offset 8) 0))
                      (panic-i "rt-statics-adopt!: relocation outside the entries"
                               offset)
                      0)
                  (set! (mut k) (+ (load k) 1))
                  (continue))))
      ;; Walk the entries once: the count must land exactly on the section's end.
      (let [(mut offset) entries
            (mut seen) 0]
        (loop (if (>= (load offset) bytes)
                  (break 0)
                  (do
                    (if (> RT-HEADER-BYTES (- bytes (load offset)))
                        (panic "rt-statics-adopt!: truncated entry header") 0)
                    (let [header
                          (primitive/cast (ptr i64)
                                          (primitive/index blob (load offset)))
                        payload-bytes (load (primitive/index header 0))]
                    (if (or (< payload-bytes 0)
                            (> payload-bytes (- (- bytes (load offset)) RT-HEADER-BYTES)))
                        (panic-i "rt-statics-adopt!: an entry overruns the section"
                                 (load offset))
                        0)
                    (set! (mut seen) (+ (load seen) 1))
                    (set! (mut offset)
                          (+ (load offset)
                             (rt-align8 (+ payload-bytes RT-HEADER-BYTES))))
                    (continue)))))
        (if (!= (load seen) count)
            (panic-i "rt-statics-adopt!: entry count disagrees with the walk"
                     (load seen))
            0))
      ;; Bounds validation above is read-only. Relocate only after checking disjointness too.
      (set! (mut k) 0)
      (loop (if (>= (load k) nrelocs) (break 0)
                (let [offset (rt-read-u32 blob (+ RT-IMAGE-FIXED-BYTES (* 4 (load k))))
                      slot (primitive/cast (ptr i64) (primitive/index blob offset))
                      word (load slot)]
                  (set! slot (| (& word (primitive/inot RT-DYNAMIC-PAYLOAD-MASK))
                                (+ base (& word RT-DYNAMIC-PAYLOAD-MASK))))
                  (set! (mut k) (+ (load k) 1)) (continue))))
      (push! [RtStaticImage] (mut (.static-images heap))
             (RtStaticImage :base base :bytes bytes :entries entries))
      (if (!= global 0)
          (set! (.global-object heap)
                (| (& global (primitive/inot RT-DYNAMIC-PAYLOAD-MASK))
                   (+ base (& global RT-DYNAMIC-PAYLOAD-MASK))))
          0)
      0)))

;; Simple executes in the host JVM and has no per-realm native metadata bindings. Our installed
;; code keeps a slot while each execution supplies its own canonical identity maps. Bindings are
;; immutable until teardown. Explicit arrays belong to the program assembler and must outlive the
;; realm; the identity fallback is allocated here once and shared by same-namespace units.
(defn rt-unit-empty-table [(count i64)] (-> (ptr i64))
  (let [p (primitive/cast (ptr i64) (alloc/malloc (primitive/cast isize (* count 8))))]
    (if (= (primitive/cast i64 p) 0) (alloc/oom-at c"rt-unit-empty-table" count) 0)
    (mem/mem-zero [i64] p count)
    p))

(defn rt-unit-identity-map [(count i64)] (-> (slice i64))
  (let [(mut words) (al-new [i64] (alloc/malloc-allocator)) (mut i) 0]
    (loop (if (>= (load i) count) (break 0)
              (do (push! [i64] (mut words) (load i))
                  (set! (mut i) (+ (load i) 1)) (continue))))
    (al-into-slice (mut words))))

(defn rt-unit-identities-bind! [(code-id i64) (keys (slice i64)) (shape-ids (slice i64))] (-> i64)
  (let [h (rt-heap) slot (rt-code-unit-slot code-id)]
    (if (or (not (.booted h)) (not (shapes-booted?)) (>= slot (.unit-count h)))
        (panic "rt-unit-identities-bind!: realm namespace or binding slot is unavailable") 0)
    (if (or (!= (load (primitive/index (.unit-keys h) slot)) 0)
            (!= (load (primitive/index (.unit-shapes h) slot)) 0))
        (panic "rt-unit-identities-bind!: installation is already bound") 0)
    (if (or (< (len keys) 1) (< (len shape-ids) 2))
        (panic "rt-unit-identities-bind!: missing identity maps") 0)
    (if (= code-id 0)
        (if (or (< (len keys) (+ (shapes-key-count) 1)) (< (len shape-ids) (shapes-count)))
            (panic "rt-unit-identities-bind!: linked namespace maps are incomplete") 0)
        (match (rt-code-find code-id)
          (Some [range]
            (let [r range]
              (if (or (< (len keys) (.key-count r)) (< (len shape-ids) (.shape-count r)))
                  (panic "rt-unit-identities-bind!: maps do not cover the installed unit namespace") 0)))
          (None [] (panic "rt-unit-identities-bind!: code is not installed"))))
    (if (or (!= (get keys 0) 0) (!= (get shape-ids 0) 0) (!= (get shape-ids 1) 1))
        (panic "rt-unit-identities-bind!: invalid reserved identities") 0)
    ;; Distinct canonical names in one unit must remain distinct after assembly. The optimizer
    ;; may fold KeyRef equality without knowing the eventual words. Check injectivity in linear
    ;; expected time and release scratch before publishing the borrowed map.
    (let [(mut i) 1 (mut seen) (hm-new [i64 bool] (alloc/malloc-allocator) (i64-keyops))]
      (loop (if (>= (load i) (len keys)) (break 0)
                (let [key (get keys (load i))]
                  (if (or (<= key 0) (> key (shapes-key-count)))
                      (panic "rt-unit-identities-bind!: key is outside the realm namespace") 0)
                  (if (hm-contains? (load seen) key)
                      (panic "rt-unit-identities-bind!: distinct local keys alias in the realm namespace") 0)
                  (set! (mut seen) key true)
                  (set! (mut i) (+ (load i) 1)) (continue))))
      (hm-free! (mut seen)))
    (let [(mut i) 2]
      (loop (if (>= (load i) (len shape-ids)) (break 0)
                (let [shape (get shape-ids (load i))]
                  (if (or (<= shape 1) (>= shape (shapes-count)))
                      (panic "rt-unit-identities-bind!: shape is outside the realm namespace") 0)
                  (set! (mut i) (+ (load i) 1)) (continue)))))
    ;; Publish only after both complete maps pass validation.
    (set! (primitive/index (.unit-keys h) slot) (primitive/cast i64 (slice-data keys)))
    (set! (primitive/index (.unit-shapes h) slot) (primitive/cast i64 (slice-data shape-ids)))
    0))

(defn rt-unit-identities-bind-program! [(code-id i64) (keys (slice i64)) (shape-ids (slice i64))] (-> i64)
  (if (and (= (len keys) 0) (= (len shape-ids) 0))
      (rt-unit-identities-bind! code-id (.default-keys (rt-heap)) (.default-shapes (rt-heap)))
      (rt-unit-identities-bind! code-id keys shape-ids)))

(defn rt-unit-identities-boot! [] (-> i64)
  (let [h (rt-heap) program (rt-program) units (.units program) (mut i) 0]
    (if (or (not (.booted h)) (not (shapes-booted?)))
        (panic "rt-unit-identities-boot!: realm namespace is unavailable") 0)
    (if (or (> (len (.default-keys h)) 0) (> (len (.default-shapes h)) 0))
        (panic "rt-unit-identities-boot!: identity maps already exist") 0)
    (set! (.default-keys h) (rt-unit-identity-map (+ (shapes-key-count) 1)))
    (set! (.default-shapes h) (rt-unit-identity-map (shapes-count)))
    (rt-unit-identities-bind-program! (.code-id program) (.keys program) (.shape-ids program))
    (loop (if (>= (load i) (len units)) (break 0)
              (let [unit (get units (load i))]
                (rt-unit-identities-bind-program! (.code-id unit) (.keys unit) (.shape-ids unit))
                (set! (mut i) (+ (load i) 1)) (continue))))))

(defn rt-unit-adopt! [(code-id i64) (blob (ptr u8)) (bytes i64)] (-> i64)
  (let [heap (rt-heap) slot (rt-code-unit-slot code-id)]
    (if (or (not (.booted heap)) (>= slot (.unit-count heap)))
        (panic "rt-unit-adopt!: no realm binding slot") 0)
    (if (!= (load (primitive/index (.unit-bases heap) slot)) 0)
        (panic "rt-unit-adopt!: unit already bound in this realm") 0)
    (rt-statics-adopt! blob bytes)
    ;; Adoption checked the complete entry walk before publishing the static region. Build the
    ;; local-ordinal map from those payload boundaries, never from arbitrary data symbols. These
    ;; addresses stay valid until realm teardown because adopted images are immovable GC roots.
    (let [(mut objects) (al-new [i64] (alloc/malloc-allocator))
          (mut offset) (rt-read-u32 blob 28)]
      (loop (if (>= (load offset) bytes) (break 0)
                (let [header (primitive/cast (ptr i64) (primitive/index blob (load offset)))]
                  (push! [i64] (mut objects) (+ (primitive/cast i64 header) RT-HEADER-BYTES))
                  (set! (mut offset) (+ (load offset) (rt-align8 (+ (load header) RT-HEADER-BYTES))))
                  (continue))))
      (let [owned (al-into-slice (mut objects))]
        (push! [(slice i64)] (mut (.object-maps heap)) owned)
        (set! (primitive/index (.unit-objects heap) slot) (primitive/cast i64 (slice-data owned)))))
    (set! (primitive/index (.unit-bases heap) slot) (primitive/cast i64 blob))
    0))

;; Apply a canonical binding to a raw address or a NaN-boxed reference, preserving its tag.
(defn rt-object-bound-word [(aliases (HashMap i64 i64)) (word i64) (raw bool)] (-> i64)
  (match (get aliases (rt-reference-payload word raw))
    (Some [target] (if raw target (| (& word (primitive/inot RT-DYNAMIC-PAYLOAD-MASK)) target)))
    (None [] word)))

;; This is a boot-time operation over adopted, immovable images. Validate the complete batch
;; before changing any map or field. Simple has no native realm rebinding; our extra invariant
;; is that code lookups and template-held references must observe the same canonical object.
(defn rt-unit-bind-objects! [(bindings (slice RtObjectBinding))] (-> i64)
  (let [heap (rt-heap)]
    (if (or (not (.booted heap)) (.object-bindings-finalized heap)
            (!= (.used heap) 0) (!= (.to-used heap) 0))
        (panic "rt-unit-bind-objects!: bindings require an unstarted realm") 0)
    (if (> (len bindings) 0)
        (let [a (alloc/malloc-allocator)
              (mut payloads) (hm-new [i64 bool] a (i64-keyops))
              (mut aliases) (hm-new [i64 i64] a (i64-keyops))
              (mut seen) (hm-new [i64 bool] a (i64-keyops)) (mut i) 0]
          ;; Exact payload starts, rather than the range-only static-region membership test.
          (al-for [image (.static-images heap)]
            (let [region image (mut offset) (.entries region)]
              (loop (if (>= (load offset) (.bytes region)) (break 0)
                        (let [header (primitive/cast (ptr i64) (+ (.base region) (load offset)))]
                          (set! (mut payloads) (+ (primitive/cast i64 header) RT-HEADER-BYTES) true)
                          (set! (mut offset) (+ (load offset) (rt-align8 (+ (load header) RT-HEADER-BYTES))))
                          (continue))))))
          (loop (if (>= (load i) (len bindings)) (break 0)
                    (let [binding (get bindings (load i)) source (.source binding) target (.target binding)]
                      (if (or (= source target) (not (hm-contains? (load payloads) source))
                              (not (hm-contains? (load payloads) target)))
                          (panic "rt-unit-bind-objects!: binding must name distinct adopted payloads") 0)
                      (if (hm-contains? (load aliases) source)
                          (panic "rt-unit-bind-objects!: duplicate source object") 0)
                      (let [s (primitive/cast (ptr i64) source) t (primitive/cast (ptr i64) target)]
                        (if (or (!= (load (primitive/index s -3)) (load (primitive/index t -3)))
                                (!= (load (primitive/index s -2)) (load (primitive/index t -2)))
                                (!= (load (primitive/index s -1)) (load (primitive/index t -1))))
                            (panic "rt-unit-bind-objects!: incompatible payload layout") 0))
                      (set! (mut aliases) source target)
                      (set! (mut i) (+ (load i) 1)) (continue))))
          (set! (mut i) 0)
          (loop (if (>= (load i) (len bindings)) (break 0)
                    (let [binding (get bindings (load i))]
                      (if (hm-contains? (load aliases) (.target binding))
                          (panic "rt-unit-bind-objects!: target is not a canonical object") 0)
                      (set! (mut i) (+ (load i) 1)) (continue))))
          (al-for [image (.static-images heap)]
            (let [region image (mut offset) (.entries region)]
              (hm-clear! (mut seen))
              (loop (if (>= (load offset) (.bytes region)) (break 0)
                        (let [header (primitive/cast (ptr i64) (+ (.base region) (load offset)))
                              target (rt-object-bound-word (load aliases) (+ (primitive/cast i64 header) RT-HEADER-BYTES) true)]
                          (if (hm-contains? (load seen) target)
                              (panic "rt-unit-bind-objects!: distinct local objects would alias") 0)
                          (set! (mut seen) target true)
                          (set! (mut offset) (+ (load offset) (rt-align8 (+ (load header) RT-HEADER-BYTES))))
                          (continue))))))
          ;; Validation is complete. The same terminal mapping updates generated-code lookups,
          ;; boxed reference relocations inside templates, and the published global root.
          (al-for [objects (.object-maps heap)]
            (set! (mut i) 0)
            (loop (if (>= (load i) (len objects)) (break 0)
                      (do (set! (primitive/index (slice-data objects) (load i))
                                (rt-object-bound-word (load aliases) (get objects (load i)) true))
                          (set! (mut i) (+ (load i) 1)) (continue)))))
          (al-for [image (.static-images heap)]
            (let [region image blob (primitive/cast (ptr u8) (.base region)) count (rt-read-u32 blob 24)]
              (set! (mut i) 0)
              (loop (if (>= (load i) count) (break 0)
                        (let [offset (rt-read-u32 blob (+ RT-IMAGE-FIXED-BYTES (* 4 (load i))))
                              slot (primitive/cast (ptr i64) (primitive/index blob offset))]
                          (set! slot (rt-object-bound-word (load aliases) (load slot) false))
                          (set! (mut i) (+ (load i) 1)) (continue))))))
          (set! (.global-object heap) (rt-object-bound-word (load aliases) (.global-object heap) false))
          (hm-free! (mut seen)) (hm-free! (mut aliases)) (hm-free! (mut payloads))) 0)
    (set! (.object-bindings-finalized heap) true)
    0))

(defn rt-statics-boot! [] (-> i64)
  (let [size (primitive/alloc-stack u64)]
    (set! size 0)
    (let [blob (rt-linked-heap-image size)]
      (if (= (primitive/cast i64 blob) 0)
          0
          (rt-unit-adopt! (.code-id (rt-program)) blob (primitive/cast i64 (load size)))))
    (let [units (.units (rt-program)) (mut i) 0]
      (loop (if (>= (load i) (len units)) (break 0)
                (let [unit (get units (load i))]
                  (if (< (.image-bytes unit) 0) (panic "rt-statics-boot!: negative unit image extent") 0)
                  (if (> (.image-bytes unit) 0)
                      (rt-unit-adopt! (.code-id unit) (.image unit) (.image-bytes unit)) 0)
                  (set! (mut i) (+ (load i) 1)) (continue)))))
    (rt-unit-bind-objects! (.object-bindings (rt-program)))
    (rt-unit-merge-object-properties! (.object-property-merges (rt-program)))
    0))

(defstruct RtInitialPropertyKey [(object i64) (key i64)])
(defstruct RtInitialProperty [(object i64) (key i64) (value i64) (attrs i64)])

(defn rt-initial-property-hash [(raw (ptr i8)) (bytes i64)] (-> i64)
  (let [k (primitive/cast (ptr RtInitialPropertyKey) raw)] (+ (* (.object k) 31) (.key k))))

(defn rt-initial-property-eq [(left (ptr i8)) (right (ptr i8)) (bytes i64)] (-> bool)
  (let [a (primitive/cast (ptr RtInitialPropertyKey) left) b (primitive/cast (ptr RtInitialPropertyKey) right)]
    (and (= (.object a) (.object b)) (= (.key a) (.key b)))))

(defn rt-initial-property-keyops [] (-> (ptr KeyOps))
  (let [ops (primitive/alloc-static KeyOps)]
    (set! (.hash ops) (primitive/fnptr-of rt-initial-property-hash))
    (set! (.eq ops) (primitive/fnptr-of rt-initial-property-eq))
    (set! (.size ops) (primitive/sizeof RtInitialPropertyKey))
    ops))

;; Simple has no per-realm intrinsic snapshots. Our assembler supplies authorized object pairs
;; after canonical identity binding. Validate the entire union before writing: exact adopted
;; object starts, fixed object layouts, equal prototypes, and matching duplicate descriptors and
;; SameValue values. Enumerate backing-store transitions in insertion order. Pending additions
;; from earlier sources participate in conflict checks before any allocation or mutation.
;; Only initial static references enter the plan; their adopted images root them across GC.
(defn rt-unit-merge-object-properties! [(merges (slice RtObjectBinding))] (-> i64)
  (let [h (rt-heap)]
    (if (or (not (.booted h)) (not (.object-bindings-finalized h)) (.object-properties-finalized h)
            (!= (.used h) 0) (!= (.to-used h) 0))
        (panic "rt-unit-merge-object-properties!: requires a bound, unstarted realm") 0)
    (if (> (len merges) 0)
        (let [a (alloc/malloc-allocator)
              (mut objects) (hm-new [i64 bool] a (i64-keyops))
              (mut pending) (al-new [RtInitialProperty] a)
              (mut index) (hm-new [RtInitialPropertyKey i64] a (rt-initial-property-keyops))
              (mut rows) (al-new [i64] a) (mut i) 0]
          (al-for [image (.static-images h)]
            (let [region image (mut offset) (.entries region)]
              (loop (if (>= (load offset) (.bytes region)) (break 0)
                (let [header (primitive/cast (ptr i64) (+ (.base region) (load offset)))
                      bytes (load header)]
                  (if (and (or (= bytes RT-OBJECT-PAYLOAD-BYTES) (= bytes RT-FUNCTION-PAYLOAD-BYTES))
                           (= (load (primitive/index header 1)) RT-META-HAS-BOXED)
                           (= (load (primitive/index header 2)) SHAPES-ROOT))
                      (set! (mut objects) (+ (primitive/cast i64 header) RT-HEADER-BYTES) true) 0)
                  (set! (mut offset) (+ (load offset) (rt-align8 (+ bytes RT-HEADER-BYTES)))) (continue))))))
          (loop (if (>= (load i) (len merges)) (break 0)
            (let [pair (get merges (load i)) source (.source pair) target (.target pair)]
              (if (or (= source target) (not (hm-contains? (load objects) source))
                      (not (hm-contains? (load objects) target)))
                  (panic "rt-unit-merge-object-properties!: invalid adopted object pair") 0)
              (if (or (!= (rt-payload-bytes source) (rt-payload-bytes target))
                      (!= (load (primitive/cast (ptr i64) source)) (load (primitive/cast (ptr i64) target))))
                  (panic "rt-unit-merge-object-properties!: incompatible object kind or prototype") 0)
              (al-clear! (mut rows))
              (let [storage (rt-storage-of source) (mut shape) (if (= storage 0) SHAPES-ROOT (rt-payload-shape storage))
                    target-storage (rt-storage-of target)
                    target-shape (if (= target-storage 0) SHAPES-ROOT (rt-payload-shape target-storage))]
                (if (!= (shapes-extensible? (load shape)) (shapes-extensible? target-shape))
                    (panic "rt-unit-merge-object-properties!: incompatible extensibility") 0)
                (loop (if (<= (load shape) SHAPES-ROOT) (break 0)
                  (do (if (> (shapes-key (load shape)) 0) (push! [i64] (mut rows) (load shape)) 0)
                      (set! (mut shape) (shapes-parent (load shape))) (continue))))
                (let [(mut row-index) (len (load rows))]
                  (loop (if (= (load row-index) 0) (break 0)
                    (do (set! (mut row-index) (- (load row-index) 1))
                        (let [row (get (load rows) (load row-index)) key (shapes-key row) attrs (shapes-attrs row)
                              value (load (primitive/cast (ptr i64) (+ storage (shapes-offset row))))
                              id (RtInitialPropertyKey :object target :key key)
                              offset (shapes-lookup-offset target-shape key)]
                          (match (get (load index) id)
                            (Some [at]
                              (let [prior (get (load pending) at)]
                                (if (or (!= attrs (.attrs prior)) (not (rt-same-value value (.value prior))))
                                    (panic "rt-unit-merge-object-properties!: conflicting pending property") 0)))
                            (None []
                              (if (>= offset 0)
                                  (if (or (!= attrs (shapes-lookup-attrs target-shape key))
                                          (not (rt-same-value value (load (primitive/cast (ptr i64) (+ target-storage offset))))))
                                      (panic "rt-unit-merge-object-properties!: conflicting existing property") 0)
                                  (do (if (not (shapes-extensible? target-shape))
                                          (panic "rt-unit-merge-object-properties!: target is not extensible") 0)
                                      (set! (mut index) id (len (load pending)))
                                      (push! [RtInitialProperty] (mut pending)
                                        (RtInitialProperty :object target :key key :value value :attrs attrs)))))))
                        (continue))))))
              (set! (mut i) (+ (load i) 1)) (continue))))
          ;; All inputs remain static roots; rt-prop-define roots the receiver and value while
          ;; allocating each new backing store. No accessor function executes during definition.
          (set! (.assembling-properties h) true)
          (al-for [property (load pending)]
            (let [p property mask (if (= (& (.attrs p) SHAPES-ATTR-ACCESSOR) 0) 15 28)]
              (if (!= (rt-prop-define (.object p) (.key p) (.value p) (.attrs p) mask 0 0) 0)
                  (panic "rt-unit-merge-object-properties!: validated definition failed") 0)))
          (set! (.assembling-properties h) false)
          (al-free! (mut rows)) (hm-free! (mut index)) (al-free! (mut pending)) (hm-free! (mut objects))) 0)
    (set! (.object-properties-finalized h) true)
    0))

;; Image objects are roots: forward every reference word of every scanned entry, as
;; `rt-scan-copied!` does for a copied object. Nothing here moves, so no card is dirtied — the
;; whole image is rescanned by every collection, minor or major.
(defn rt-scan-static-image! [(region RtStaticImage)] (-> i64)
    (if (= (.base region) 0)
        0
        (let [(mut offset) (.entries region)]
          (loop (if (>= (load offset) (.bytes region))
                    (break 0)
                    (let [header
                            (primitive/cast (ptr i64)
                                            (+ (.base region)
                                               (load offset)))
                          bytes (load (primitive/index header 0))
                          meta (load (primitive/index header 1))
                          shape (load (primitive/index header 2))
                          payload
                            (primitive/cast (ptr i64)
                                            (+ (.base region)
                                               (+ (load offset) RT-HEADER-BYTES)))
                          words
                            (if (!= (& shape RT-SHAPE-NOSCAN-BIT) 0)
                                0
                                (/ bytes 8))
                          (mut i) 0]
                      (loop (if (>= (load i) words)
                                (break 0)
                                (let [slot (primitive/index payload (load i))
                                      word (load slot)]
                                  (if (and (!= (& meta RT-META-HAS-RAW) 0)
                                           (rt-in-collect-space? word))
                                      (set! slot (rt-forward word))
                                      (set! slot (rt-forward-boxed word)))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))
                      (set! (mut offset)
                            (+ (load offset)
                               (rt-align8 (+ bytes RT-HEADER-BYTES))))
                      (continue)))))))

(defn rt-scan-static-roots! [] (-> i64)
  (al-for [region (.static-images (rt-heap))] (rt-scan-static-image! region))
  0)

;; `AOT_RT_GC_VERIFY`: every reference word of every image object must be live.
(defn rt-verify-static-image! [(region RtStaticImage) (phase (slice u8))] (-> i64)
    (if (= (.base region) 0)
        0
        (let [(mut offset) (.entries region)]
          (loop (if (>= (load offset) (.bytes region))
                    (break 0)
                    (let [header
                            (primitive/cast (ptr i64)
                                            (+ (.base region)
                                               (load offset)))
                          bytes (load (primitive/index header 0))
                          meta (load (primitive/index header 1))
                          shape (load (primitive/index header 2))
                          payload
                            (primitive/cast (ptr i64)
                                            (+ (.base region)
                                               (+ (load offset) RT-HEADER-BYTES)))
                          words
                            (if (!= (& shape RT-SHAPE-NOSCAN-BIT) 0)
                                0
                                (/ bytes 8))
                          (mut i) 0]
                      (loop (if (>= (load i) words)
                                (break 0)
                                (let [word
                                        (load (primitive/index payload (load i)))
                                      raw
                                        (and (!= (& meta RT-META-HAS-RAW) 0)
                                             (rt-live-payload? word))]
                                  (if (rt-verify-reference? word raw)
                                      0
                                      (do
                                        (rt-verify-fail! "stale image object field"
                                                         phase
                                                         word
                                                         (if raw 1 2))
                                        (panic "aot-gc-verify: an image object holds a stale reference")))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))
                      (set! (mut offset)
                            (+ (load offset)
                               (rt-align8 (+ bytes RT-HEADER-BYTES))))
                      (continue)))))))

(defn rt-verify-statics! [(phase (slice u8))] (-> i64)
  (al-for [region (.static-images (rt-heap))] (rt-verify-static-image! region phase))
  0)

(defn rt-box-string [(payload i64)] (-> i64)
  (| (primitive/ishl RT-DYNAMIC-PREFIX-STRING 48) payload))

(defn rt-box-object [(payload i64)] (-> i64)
  (| (primitive/ishl RT-DYNAMIC-PREFIX-OBJECT 48) payload))

;; The backing-store payload of an ordinary object, or zero when it has none yet.
(defn rt-storage-of [(obj i64)] (-> i64)
  (let [word
          (load (primitive/cast (ptr i64) (+ obj RT-OFFSET-OBJECT-PROPERTIES)))]
    (if (= (rt-word-prefix word) RT-DYNAMIC-PREFIX-OBJECT)
        (& word RT-DYNAMIC-PAYLOAD-MASK)
        0)))

;; The byte offset of `key` in `obj`'s backing store, or -1 when `obj` has no such own property.
(defn rt-prop-offset [(obj i64) (key i64)] (-> i64)
  (let [storage (rt-storage-of obj)]
    (if (= storage 0)
        -1
        (shapes-lookup-offset (rt-payload-shape storage) key))))

(defn rt-prop-get-own [(obj i64) (key i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (let [off (rt-prop-offset obj key)]
      (if (< off 0)
          RT-DYNAMIC-UNDEFINED-WORD
          (load (primitive/cast (ptr i64) (+ (rt-storage-of obj) off)))))))

(defn rt-prop-has-own [(obj i64) (key i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (if (< (rt-prop-offset obj key) 0) 0 1)))

;; The first object on `obj`'s prototype chain (the receiver excluded) with an own `key`, as the
;; boxed word its predecessor's [[Prototype]] slot holds (`%PropChainHolder`); null when none.
(defn rt-prop-chain-holder [(obj i64) (key i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (let [(mut current) obj
          (mut answer) RT-DYNAMIC-NULL-WORD
          (mut walking) true]
      (loop (if (not (load walking))
                (break 0)
                (let [word (load (primitive/cast (ptr i64) (+ (load current) 0)))]
                  (if (rt-word-object? word)
                      (let [proto (& word RT-DYNAMIC-PAYLOAD-MASK)]
                        ;; An Array exotic prototype stops the walk whatever the key: its `length` and
                        ;; elements are own properties no shape records, so the JSL asks it.
                        (if (or (= (rt-word-prefix word) RT-DYNAMIC-PREFIX-ARRAY)
                                (>= (rt-prop-offset proto key) 0))
                            (do (set! (mut answer) word) (set! (mut walking) false))
                            (set! (mut current) proto))
                        (continue))
                      (do (set! (mut walking) false) (continue))))))
      (load answer))))

;; Ordinary [[Get]] of a data property (`%PropGetNamed`, JS-PROP-GET): the own word, else the first
;; prototype's holding the key, else undefined. An accessor found anywhere answers the exception
;; sentinel, and the JSL reads the pair itself.
(defn rt-prop-get [(obj i64) (key i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (let [(mut current) obj
          (mut answer) RT-DYNAMIC-UNDEFINED-WORD
          (mut walking) true]
      (loop (if (not (load walking))
                (break 0)
                (let [storage (rt-storage-of (load current))
                      shape (if (= storage 0) SHAPES-ROOT (rt-payload-shape storage))
                      off (if (= storage 0) -1 (shapes-lookup-offset shape key))]
                  (if (>= off 0)
                      (do
                        (set! (mut answer)
                              (if (= (& (shapes-lookup-attrs shape key) SHAPES-ATTR-ACCESSOR) 0)
                                  (load (primitive/cast (ptr i64) (+ storage off)))
                                  RT-DYNAMIC-EXCEPTION-WORD))
                        (set! (mut walking) false)
                        (continue))
                      (let [word (load (primitive/cast (ptr i64) (+ (load current) 0)))]
                        (if (rt-word-object? word)
                            ;; An Array exotic prototype's own properties include `length` and its
                            ;; elements, which no shape records: the sentinel hands the read to the JSL.
                            (if (= (rt-word-prefix word) RT-DYNAMIC-PREFIX-ARRAY)
                                (do (set! (mut answer) RT-DYNAMIC-EXCEPTION-WORD) (set! (mut walking) false) (continue))
                                (do (set! (mut current) (& word RT-DYNAMIC-PAYLOAD-MASK)) (continue)))
                            (do (set! (mut walking) false) (continue))))))))
      (load answer))))

;; The fast cases of OrdinarySet with `obj` as receiver (`%PropSetNamed`, JS-PROP-SET): an own
;; writable data property takes the value; an absent key is added to an extensible object when no
;; prototype holds it as an accessor or a read-only property (an inherited writable data property
;; is shadowed, ECMA-262 §10.1.9.2). Everything else — an own accessor or read-only property, an
;; inherited accessor or read-only property, a non-extensible object — answers the exception
;; sentinel and is the JSL's to decide. The value word on success.
(defn rt-prop-set [(obj i64)
                   (key i64)
                   (value i64)
                   (map-id i64)
                   (caller-sp i64)] (-> i64)
  (let [obj-root (primitive/alloc-stack i64)
        value-root (primitive/alloc-stack i64)]
    (set! obj-root obj)
    (set! value-root value)
    (rt-heap-boot!)
    (let [storage (rt-storage-of obj)
          shape (if (= storage 0) SHAPES-ROOT (rt-payload-shape storage))
          off (if (= storage 0) -1 (shapes-lookup-offset shape key))]
      (if (>= off 0)
          (if (= (& (shapes-lookup-attrs shape key) (| SHAPES-ATTR-ACCESSOR SHAPES-ATTR-WRITABLE))
                 SHAPES-ATTR-WRITABLE)
              (do
                (set! (primitive/cast (ptr i64) (+ storage off)) value)
                (aot-rt-write-barrier storage value RT-BARRIER-BOXED)
                value)
              RT-DYNAMIC-EXCEPTION-WORD)
          (if (not (shapes-extensible? shape))
              RT-DYNAMIC-EXCEPTION-WORD
              (let [holder (rt-prop-chain-holder obj key)]
                (if (and (!= holder RT-DYNAMIC-NULL-WORD)
                         (or (= (rt-word-prefix holder) RT-DYNAMIC-PREFIX-ARRAY)
                             (!= (& (rt-prop-attributes (& holder RT-DYNAMIC-PAYLOAD-MASK) key)
                                (| SHAPES-ATTR-ACCESSOR SHAPES-ATTR-WRITABLE))
                             SHAPES-ATTR-WRITABLE)))
                    RT-DYNAMIC-EXCEPTION-WORD
                    (rt--prop-add! obj-root
                                   value-root
                                   shape
                                   key
                                   SHAPES-ATTRS-DEFAULT
                                   map-id
                                   caller-sp))))))))

;; The attributes of `obj`'s own `key` (`%PropAttributes`): SHAPES-ATTR-* bits; -1 when absent and
;; the object is extensible, -2 when absent and it is not.
(defn rt-prop-attributes [(obj i64) (key i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (let [storage (rt-storage-of obj)
          shape (if (= storage 0) SHAPES-ROOT (rt-payload-shape storage))
          attrs (shapes-lookup-attrs shape key)]
      (if (>= attrs 0)
          attrs
          (if (shapes-extensible? shape) -1 -2)))))

;; Allocate for a runtime helper that holds a raw managed argument and a boxed JavaScript value
;; across the allocation: both are roots of any collection it triggers, and the caller re-reads them
;; afterwards. Mirrors `rt-alloc` for generated code, with the helper's frame as the extra roots.
(defn rt-alloc-rooted [(bytes i64)
                       (shape i64)
                       (map-id i64)
                       (caller-sp i64)
                       (root-a (ptr i64))
                       (root-b (ptr i64))
                       (boxed-b bool)] (-> i64)
  (do
    (if (and (.stress (rt-heap)) (or (> map-id 0) (.assembling-properties (rt-heap))))
        (rt-collect-linked-with-roots! map-id caller-sp root-a root-b boxed-b)
        0)
    (let [large (> (rt-align8 (+ bytes RT-HEADER-BYTES)) (.capacity (rt-heap)))
          initial
            (if large
                (rt-heap-allocate-old bytes shape)
                (rt-heap-allocate-active bytes shape))]
      (if (!= initial 0)
          initial
          (do
            (if large (set! (.force-major (rt-heap)) true) 0)
            (rt-collect-linked-with-roots! map-id
                                           caller-sp
                                           root-a
                                           root-b
                                           boxed-b)
            (let [retry
                    (if large
                        (rt-heap-allocate-old bytes shape)
                        (rt-heap-allocate-active bytes shape))]
              (if (= retry 0)
                  (alloc/oom-at c"aot_rt_alloc_rooted: object exceeds generation"
                                bytes)
                  retry)))))))

;; [[DefineOwnProperty]] of a data property on an ordinary object at run time. A present key is a
;; store in place; a new key is a transition: a fresh backing store of the child shape receives the
;; old fields and the value, then replaces the object's properties word. Both writes pass the
;; generational barrier, as generated stores do.
(defn rt-prop-set-own [(obj i64)
                       (key i64)
                       (value i64)
                       (map-id i64)
                       (caller-sp i64)] (-> i64)
  (rt-prop-set-own-attrs obj key value SHAPES-ATTRS-DEFAULT map-id caller-sp))

;; The store with the attributes an added key takes (`%PropStoreOwnNamedAttrs`): a present
;; writable data property takes the value and keeps its own attributes, as under `rt-prop-set-own`.
(defn rt-prop-set-own-attrs [(obj i64)
                             (key i64)
                             (value i64)
                             (attrs i64)
                             (map-id i64)
                             (caller-sp i64)] (-> i64)
  (let [obj-root (primitive/alloc-stack i64)
        value-root (primitive/alloc-stack i64)]
    (set! obj-root obj)
    (set! value-root value)
    (rt-heap-boot!)
    (let [storage (rt-storage-of obj)
          shape (if (= storage 0) SHAPES-ROOT (rt-payload-shape storage))
          off (if (= storage 0) -1 (shapes-lookup-offset shape key))]
      (if (>= off 0)
          (do
            (set! (primitive/cast (ptr i64) (+ storage off)) value)
            (aot-rt-write-barrier storage value RT-BARRIER-BOXED)
            value)
          ;; JSL asks the attributes first, so a non-extensible object never reaches this store; a
          ;; caller that did keeps the object as it is rather than corrupt a shape.
          (if (shapes-extensible? shape)
              (rt--prop-add! obj-root
                             value-root
                             shape
                             key
                             attrs
                             map-id
                             caller-sp)
              value)))))

;; Add `key` with `attrs` to the object at `obj-root`, whose backing store has `shape` (the root
;; when it has none): a fresh store one word longer under the child shape, the old words copied,
;; the value in the new word, the store installed. The roots are re-read after the allocation,
;; which may have moved both. The value word.
(defn rt--prop-add! [(obj-root (ptr i64))
                     (value-root (ptr i64))
                     (shape i64)
                     (key i64)
                     (attrs i64)
                     (map-id i64)
                     (caller-sp i64)] (-> i64)
  (let [child (shapes-transition-attrs shape key attrs)
        fields (shapes-field-count shape)
        fresh
          (rt-alloc-rooted (* (+ fields 1) SHAPES-WORD-BYTES)
                           child
                           map-id
                           caller-sp
                           obj-root
                           value-root
                           true)
        moved-obj (load obj-root)
        moved-value (load value-root)
        old (rt-storage-of moved-obj)
        (mut i) 0]
    (loop (if (>= (load i) fields)
              (break 0)
              (do
                (set! (primitive/cast (ptr i64)
                                      (+ fresh (* (load i) SHAPES-WORD-BYTES)))
                      (load (primitive/cast (ptr i64)
                                            (+ old
                                               (* (load i) SHAPES-WORD-BYTES)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (primitive/cast (ptr i64) (+ fresh (* fields SHAPES-WORD-BYTES)))
          moved-value)
    (aot-rt-write-barrier fresh moved-value RT-BARRIER-BOXED)
    (let [boxed (rt-box-object fresh)]
      (set! (primitive/cast (ptr i64) (+ moved-obj RT-OFFSET-OBJECT-PROPERTIES))
            boxed)
      (aot-rt-write-barrier moved-obj boxed RT-BARRIER-BOXED)
      moved-value)))

;; A backing store's shape word (the payload's header word), rewritten when a define changes an
;; attribute or the object stops being extensible: the layout is the same, the id is not.
(defn rt-storage-set-shape! [(storage i64) (shape i64)] (-> i64)
  (do (set! (primitive/index (primitive/cast (ptr i64) storage) -1) shape) 0))

;; [[IsExtensible]] (`%IsExtensible`): 1 or 0.
(defn rt-object-extensible [(obj i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (let [storage (rt-storage-of obj)]
      (if (= storage 0)
          1
          (if (shapes-extensible? (rt-payload-shape storage)) 1 0)))))

;; [[PreventExtensions]] (`%PreventExtensions`): the store takes the marker shape; an object with no
;; store yet gets an empty one so the flag has somewhere to live. Always succeeds (1).
(defn rt-object-prevent-extensions [(obj i64) (map-id i64) (caller-sp i64)] (-> i64)
  (let [obj-root (primitive/alloc-stack i64)
        value-root (primitive/alloc-stack i64)]
    (set! obj-root obj)
    (set! value-root RT-DYNAMIC-UNDEFINED-WORD)
    (rt-heap-boot!)
    (let [storage (rt-storage-of obj)]
      (if (= storage 0)
          (let [fresh
                  (rt-alloc-rooted SHAPES-WORD-BYTES
                                   (shapes-prevent-extensions SHAPES-ROOT)
                                   map-id
                                   caller-sp
                                   obj-root
                                   value-root
                                   true)
                moved-obj (load obj-root)]
            (set! (primitive/cast (ptr i64) fresh) RT-DYNAMIC-UNDEFINED-WORD)
            (let [boxed (rt-box-object fresh)]
              (set! (primitive/cast (ptr i64)
                                    (+ moved-obj RT-OFFSET-OBJECT-PROPERTIES))
                    boxed)
              (aot-rt-write-barrier moved-obj boxed RT-BARRIER-BOXED)
              1))
          (do
            (rt-storage-set-shape! storage
                                   (shapes-prevent-extensions (rt-payload-shape storage)))
            1)))))

;; SetIntegrityLevel (§7.3.15; `%ObjectIntegrity`): level 1 seals (every property non-configurable),
;; level 2 freezes (data properties also non-writable); then [[PreventExtensions]].
(defn rt-object-integrity [(obj i64) (level i64) (map-id i64) (caller-sp i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (let [storage (rt-storage-of obj)]
      (if (!= storage 0)
          (let [(mut keys) (al-new [i64] (alloc/malloc-allocator))
                (mut shape) (rt-payload-shape storage)
                (mut s) (load shape)]
            (loop (if (or (= (load s) 0) (= (load s) SHAPES-ROOT))
                      (break 0)
                      (do
                        (if (!= (shapes-key (load s)) 0)
                            (push! [i64] (mut keys) (shapes-key (load s)))
                            0)
                        (set! (mut s) (shapes-parent (load s)))
                        (continue))))
            (al-for [key (load keys)]
                    (let [cur (shapes-lookup-attrs (load shape) key)
                          next
                            (& cur
                               (primitive/inot (if (and (= level 2)
                                                        (= (& cur
                                                              SHAPES-ATTR-ACCESSOR)
                                                           0))
                                                   (+ SHAPES-ATTR-CONFIGURABLE
                                                      SHAPES-ATTR-WRITABLE)
                                                   SHAPES-ATTR-CONFIGURABLE)))]
                      (if (!= next cur)
                          (set! (mut shape)
                                (shapes-reshape-attrs (load shape) key next))
                          0)))
            (al-free! [i64] (mut keys))
            (rt-storage-set-shape! storage (load shape))
            0)
          0)
      (rt-object-prevent-extensions obj map-id caller-sp))))

;; TestIntegrityLevel (§7.3.16; `%TestIntegrity`): 1 when the object is not extensible and every
;; own property is non-configurable (level 1) or also non-writable data (level 2).
(defn rt-object-test-integrity [(obj i64) (level i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (if (= (rt-object-extensible obj) 1)
        0
        (let [storage (rt-storage-of obj)
              (mut ok) true
              (mut s) (if (= storage 0) SHAPES-ROOT (rt-payload-shape storage))]
          (loop (if (or (not (load ok)) (= (load s) 0) (= (load s) SHAPES-ROOT))
                    (break 0)
                    (let [attrs (shapes-attrs (load s))]
                      (if (!= (shapes-key (load s)) 0)
                          (if (or (!= (& attrs SHAPES-ATTR-CONFIGURABLE) 0)
                                  (and (= level 2)
                                       (and (= (& attrs SHAPES-ATTR-ACCESSOR) 0)
                                            (!= (& attrs SHAPES-ATTR-WRITABLE)
                                                0))))
                              (set! (mut ok) false)
                              0)
                          0)
                      (set! (mut s) (shapes-parent (load s)))
                      (continue))))
          (if (load ok) 1 0)))))

;; SameValue (§7.2.10) over words: strings by content, everything else by word — the Number word
;; is canonical (a compact integer is never spelled as binary64 bits), so equal Numbers are equal
;; words, NaN included; +0 and -0 differ.
(defn rt-same-value [(a i64) (b i64)] (-> bool)
  (if (and (= (rt-word-prefix a) RT-DYNAMIC-PREFIX-STRING)
           (= (rt-word-prefix b) RT-DYNAMIC-PREFIX-STRING))
      (!= (rt-string-eq (& a RT-DYNAMIC-PAYLOAD-MASK)
                        (& b RT-DYNAMIC-PAYLOAD-MASK))
          0)
      (= a b)))

;; The fields a property descriptor named (`%PropDefine`'s mask).
(const RT-DEFINE-HAS-VALUE 1)

(const RT-DEFINE-HAS-WRITABLE 2)

(const RT-DEFINE-HAS-ENUMERABLE 4)

(const RT-DEFINE-HAS-CONFIGURABLE 8)

(const RT-DEFINE-ACCESSOR 16)

;; ValidateAndApplyPropertyDescriptor (§10.1.6.3) for an ordinary object (`%PropDefine`): `attrs`
;; carries the named attributes' values, `mask` which were named (an accessor descriptor names
;; ACCESSOR and passes the accessor pair as `value`). The answer: 0 applied, 1 rejected by a
;; non-configurable current property, 2 rejected because the object is not extensible.
(defn rt-prop-define [(obj i64)
                      (key i64)
                      (value i64)
                      (attrs i64)
                      (mask i64)
                      (map-id i64)
                      (caller-sp i64)] (-> i64)
  (let [obj-root (primitive/alloc-stack i64)
        value-root (primitive/alloc-stack i64)]
    (set! obj-root obj)
    (set! value-root value)
    (rt-heap-boot!)
    (let [storage (rt-storage-of obj)
          shape (if (= storage 0) SHAPES-ROOT (rt-payload-shape storage))
          cur (shapes-lookup-attrs shape key)
          accessor (!= (& mask RT-DEFINE-ACCESSOR) 0)
          names-data
            (or (!= (& mask RT-DEFINE-HAS-VALUE) 0)
                (!= (& mask RT-DEFINE-HAS-WRITABLE) 0))]
      (if (< cur 0)
          ;; A new property: absent attribute fields default to false.
          (if (not (shapes-extensible? shape))
              2
              (let [new-attrs
                      (+ (if accessor
                             SHAPES-ATTR-ACCESSOR
                             (if (!= (& mask RT-DEFINE-HAS-WRITABLE) 0)
                                 (& attrs SHAPES-ATTR-WRITABLE)
                                 0))
                         (+ (if (!= (& mask RT-DEFINE-HAS-ENUMERABLE) 0)
                                (& attrs SHAPES-ATTR-ENUMERABLE)
                                0)
                            (if (!= (& mask RT-DEFINE-HAS-CONFIGURABLE) 0)
                                (& attrs SHAPES-ATTR-CONFIGURABLE)
                                0)))
                    word
                      (if (or accessor (!= (& mask RT-DEFINE-HAS-VALUE) 0))
                          value
                          RT-DYNAMIC-UNDEFINED-WORD)]
                (set! value-root word)
                (rt--prop-add! obj-root
                               value-root
                               shape
                               key
                               new-attrs
                               map-id
                               caller-sp)
                0))
          (if (= mask 0)
              0
              (let [off (shapes-lookup-offset shape key)
                    current (load (primitive/cast (ptr i64) (+ storage off)))
                    cur-accessor (!= (& cur SHAPES-ATTR-ACCESSOR) 0)
                    configurable (!= (& cur SHAPES-ATTR-CONFIGURABLE) 0)
                    kind-changes
                      (if accessor
                          (not cur-accessor)
                          (and names-data cur-accessor))
                    rejected
                      (and (not configurable)
                           (or (and (!= (& mask RT-DEFINE-HAS-CONFIGURABLE) 0)
                                    (!= (& attrs SHAPES-ATTR-CONFIGURABLE) 0))
                               (and (!= (& mask RT-DEFINE-HAS-ENUMERABLE) 0)
                                    (!= (& attrs SHAPES-ATTR-ENUMERABLE)
                                        (& cur SHAPES-ATTR-ENUMERABLE)))
                               kind-changes
                               (if cur-accessor
                                   ;; A non-configurable accessor: the pair may not change.
                                   (and accessor
                                        (not (rt-same-value value current)))
                                   (and (= (& cur SHAPES-ATTR-WRITABLE) 0)
                                        (or (and (!= (& mask
                                                        RT-DEFINE-HAS-WRITABLE)
                                                     0)
                                                 (!= (& attrs
                                                        SHAPES-ATTR-WRITABLE)
                                                     0))
                                            (and (!= (& mask
                                                        RT-DEFINE-HAS-VALUE)
                                                     0)
                                                 (not (rt-same-value value
                                                                     current))))))))]
                (if rejected
                    1
                    (let [kept
                            (& cur
                               (+ SHAPES-ATTR-ENUMERABLE
                                  SHAPES-ATTR-CONFIGURABLE))
                          enumerable
                            (if (!= (& mask RT-DEFINE-HAS-ENUMERABLE) 0)
                                (& attrs SHAPES-ATTR-ENUMERABLE)
                                (& kept SHAPES-ATTR-ENUMERABLE))
                          configurable-bit
                            (if (!= (& mask RT-DEFINE-HAS-CONFIGURABLE) 0)
                                (& attrs SHAPES-ATTR-CONFIGURABLE)
                                (& kept SHAPES-ATTR-CONFIGURABLE))
                          new-kind-accessor
                            (if accessor
                                true
                                (if names-data false cur-accessor))
                          writable
                            (if new-kind-accessor
                                0
                                (if (!= (& mask RT-DEFINE-HAS-WRITABLE) 0)
                                    (& attrs SHAPES-ATTR-WRITABLE)
                                    (if cur-accessor
                                        0
                                        (& cur SHAPES-ATTR-WRITABLE))))
                          new-attrs
                            (+ (if new-kind-accessor
                                   SHAPES-ATTR-ACCESSOR
                                   writable)
                               (+ enumerable configurable-bit))
                          word
                            (if accessor
                                value
                                (if (!= (& mask RT-DEFINE-HAS-VALUE) 0)
                                    value
                                    (if kind-changes
                                        RT-DYNAMIC-UNDEFINED-WORD
                                        current)))]
                      (if (!= new-attrs cur)
                          (rt-storage-set-shape! storage
                                                 (shapes-reshape-attrs shape
                                                                       key
                                                                       new-attrs))
                          0)
                      (set! (primitive/cast (ptr i64) (+ storage off)) word)
                      (aot-rt-write-barrier storage word RT-BARRIER-BOXED)
                      0))))))))

;; OrdinaryDelete (§10.1.10.1) of an ordinary object's own named property (`%PropDelete`): 0 when
;; the object no longer has the property — it had none, or it was configurable and is removed — and
;; 1 when a non-configurable property refuses. The store keeps its words and takes the shape with a
;; hole where the field was (`shapes-delete`), so every other field keeps its offset; the freed word
;; is cleared so it retains nothing. No allocation, so no safepoint.
(defn rt-prop-delete [(obj i64) (key i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (let [storage (rt-storage-of obj)]
      (if (= storage 0)
          0
          (let [shape (rt-payload-shape storage)
                row (shapes-find-row shape key)]
            (if (= row 0)
                0
                (if (= (& (shapes-attrs row) SHAPES-ATTR-CONFIGURABLE) 0)
                    1
                    (do
                      (set! (primitive/cast (ptr i64) (+ storage (shapes-offset row)))
                            RT-DYNAMIC-UNDEFINED-WORD)
                      (rt-storage-set-shape! storage (shapes-delete shape key))
                      0))))))))

;; An array element becomes a hole (`%ArrayDeleteIndex`, the element case of an Array's
;; [[Delete]], §10.4.2): elements are configurable, so it always succeeds; the length is unchanged.
(defn rt-array-delete [(arr i64) (index i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (if (= (rt-array-has arr index) 1)
        (set! (primitive/cast (ptr i64) (+ (rt-array-elements arr) (* index 8)))
              RT-DYNAMIC-HOLE-WORD)
        0)
    0))

;; Non-collecting post-write boundary. An old object that receives a young reference dirties its
;; 512-byte address card with the compiler-proven raw/boxed value kind. Minor collection uses the
;; parallel object-start table to rescan only objects intersecting dirty cards.
(defn aot-rt-write-barrier [(obj i64) (val i64) (kind i64)] (-> i64)
  (let [_
          (if (.enabled (rt-stats))
              (set! (.barrier-calls (rt-stats))
                    (+ (.barrier-calls (rt-stats)) 1))
              0)
        payload (if (rt-word-object? obj) (& obj RT-DYNAMIC-PAYLOAD-MASK) obj)
        value-payload
          (if (= kind RT-BARRIER-RAW)
              val
              (if (= kind RT-BARRIER-BOXED)
                  (if (rt-word-object? val) (& val RT-DYNAMIC-PAYLOAD-MASK) 0)
                  (panic-i "aot-rt-write-barrier: invalid value kind" kind)))]
    (if (and (rt-in-old-space? payload)
             (or (rt-in-from-space? value-payload)
                 (rt-in-young-destination? value-payload)))
        (let [heap (rt-heap)
              card (/ (- payload (primitive/cast i64 (.to heap))) RT-CARD-BYTES)
              entry (primitive/index (.cards heap) card)
              dirty
                (if (= kind RT-BARRIER-RAW)
                    RT-CARD-DIRTY-RAW
                    RT-CARD-DIRTY-BOXED)]
          (do
            (if (and (.enabled (rt-stats))
                     (= (primitive/cast i64 (load entry)) 0))
                (set! (.barrier-dirties (rt-stats))
                      (+ (.barrier-dirties (rt-stats)) 1))
                0)
            (set! entry
                  (primitive/cast u8
                                  (| (primitive/cast i64 (load entry)) dirty)))))
        0)
    (if (or (rt-in-from-space? payload)
            (rt-in-old-space? payload)
            (rt-static-payload? payload))
        (let [meta (primitive/index (primitive/cast (ptr i64) payload) -2)
              bit (if (= kind RT-BARRIER-RAW) RT-META-HAS-RAW RT-META-HAS-BOXED)]
          (set! meta (| (load meta) bit)))
        0)
    0))

(defn rt-throw [(val i64)] (-> i64)
  (do (unimplemented "rt-throw" "S8 — src/rt/rt.coil") 0))

;; TypeError completions raised by compiler-recognized guards, such as calling a value that is
;; not callable. Exceptions are unimplemented, so this is a hard error with the JavaScript name.
(defn rt-throw-type-error [] (-> i64)
  (do
    (unimplemented "TypeError: value is not callable (exception completions)"
                   "S8 — src/rt/rt.coil")
    0))

;; Generated code reached an arm the compiler proved unreachable — a backing store missing or a
;; hidden class other than the one statically fixed for the owner. This is never a JavaScript
;; error; it is the runtime half of a compiler invariant, and it aborts by design.
(defn rt-trap-invariant [] (-> i64)
  (do
    (panic "aot_rt_trap_invariant: generated code reached a state the compiler proved impossible")
    0))

;; Arithmetic reached an object operand: ToPrimitive (valueOf/toString) is not implemented. A
;; runtime refusal keeps every arithmetic guard chain total so the rest of the program compiles.
(defn rt-unimplemented-to-primitive [] (-> i64)
  (do
    (unimplemented "ToPrimitive on an object operand of arithmetic"
                   "docs/GAPS.md — conversions")
    0))

(defn rt-unimplemented-to-string [] (-> i64)
  (do
    (unimplemented "ToString of a non-string operand in string concatenation"
                   "docs/GAPS.md — conversions")
    0))

(defn rt-unimplemented-to-object [] (-> i64)
  (do
    (unimplemented "ToObject on a primitive (wrapper objects: `new String(x)`, `Object(1)`)"
                   "docs/GAPS.md — builtins")
    0))

;; ---------------------------------------------------------------------------
;; Array exotic objects: the elements store (docs/DECISIONS.md, arrays)
;;
;; Generated code reaches elements only through these entries. An array's `length` is the raw word
;; at RT-OFFSET-ARRAY-LENGTH; its elements store holds `capacity` slots, `capacity >= length`, and
;; every slot at or past `length`, and every slot inside it that no element was defined at, is the
;; hole. Growth reallocates the store (doubling), copies, fills holes and installs the new store
;; through the barrier; the array itself keeps its identity, as JavaScript requires.
(defn rt-array-elements [(arr i64)] (-> i64)
  (let [word (load (primitive/cast (ptr i64) (+ arr RT-OFFSET-ARRAY-ELEMENTS)))]
    (if (= (rt-word-prefix word) RT-DYNAMIC-PREFIX-OBJECT)
        (& word RT-DYNAMIC-PAYLOAD-MASK)
        0)))

(defn rt-array-capacity [(store i64)] (-> i64)
  (if (= store 0) 0 (/ (rt-payload-bytes store) 8)))

(defn rt-array-length [(arr i64)] (-> i64)
  (load (primitive/cast (ptr i64) (+ arr RT-OFFSET-ARRAY-LENGTH))))

(defn rt-array-set-length-word! [(arr i64) (n i64)] (-> i64)
  (do (set! (primitive/cast (ptr i64) (+ arr RT-OFFSET-ARRAY-LENGTH)) n) 0))

(defn rt-elements-fill-holes! [(store i64) (from i64) (to i64)] (-> i64)
  (let [(mut i) from]
    (loop (if (>= (load i) to)
              (break 0)
              (do
                (set! (primitive/cast (ptr i64) (+ store (* (load i) 8)))
                      RT-DYNAMIC-HOLE-WORD)
                (set! (mut i) (+ (load i) 1))
                (continue))))))

;; A store of `capacity` hole slots. `arr-root` (a raw array payload, or null) and `boxed-root`
;; (a boxed word, or null) are rooted across the allocation and re-read by the caller.
(defn rt-array-alloc-store [(capacity i64)
                            (map-id i64)
                            (caller-sp i64)
                            (arr-root (ptr i64))
                            (boxed-root (ptr i64))] (-> i64)
  (let [store
          (rt-alloc-rooted (* capacity 8)
                           RT-SHAPE-ELEMENTS
                           map-id
                           caller-sp
                           arr-root
                           boxed-root
                           true)]
    (rt-elements-fill-holes! store 0 capacity)
    store))

;; Symbol(description) (ECMA-262 §20.4.1.1): a fresh Symbol, whose identity is the allocation
;; itself — two Symbols are the same value exactly when they are the same allocation, which is why
;; the collector forwards the word like any other reference. Its payload holds the description it
;; was created with, a boxed string or the boxed undefined, and nothing else: a Symbol has no
;; properties of its own, and its prototype methods reach %Symbol.prototype% through the boxed
;; value's family, never through a stored word. Returns the raw payload, which the caller boxes.
(defn rt-symbol-new [(description i64) (map-id i64) (caller-sp i64)] (-> i64)
  (let [desc-root (primitive/alloc-stack i64)]
    (set! desc-root description)
    (rt-heap-boot!)
    (let [sym
            (rt-alloc-rooted RT-SYMBOL-PAYLOAD-BYTES
                             SHAPES-ROOT
                             map-id
                             caller-sp
                             desc-root
                             (primitive/cast (ptr i64) 0)
                             true)
          moved (load desc-root)]
      (set! (primitive/cast (ptr i64) (+ sym RT-OFFSET-SYMBOL-DESCRIPTION)) moved)
      (aot-rt-write-barrier sym moved RT-BARRIER-BOXED)
      ;; Its property key word starts unminted; `rt-symbol-key` fills it the first time the Symbol
      ;; is used as one. The word the collector scans beside the description is therefore always a
      ;; raw integer, never a reference it would have to forward.
      (set! (primitive/cast (ptr i64) (+ sym RT-OFFSET-SYMBOL-KEY)) 0)
      sym)))

;; The property key this Symbol is (`%SymbolKey`), minted on first use and stable after it. A
;; well-known Symbol is image data whose key word is unminted for the same reason: key ids are the
;; running program's, and the image is written before it starts.
(defn rt-symbol-key [(symbol i64)] (-> i64)
  (let [existing (load (primitive/cast (ptr i64) (+ symbol RT-OFFSET-SYMBOL-KEY)))]
    (if (!= existing 0)
        existing
        (let [minted (shapes-mint-symbol-key!)]
          (set! (primitive/cast (ptr i64) (+ symbol RT-OFFSET-SYMBOL-KEY)) minted)
          minted))))

;; The description a Symbol was created with, for `description` and `toString`.
(defn rt-symbol-description [(symbol i64)] (-> i64)
  (load (primitive/cast (ptr i64) (+ symbol RT-OFFSET-SYMBOL-DESCRIPTION))))

;; ArrayCreate (ECMA-262 §10.4.2.2): a fresh array of `length` holes whose [[Prototype]] is the
;; boxed `proto` word. Returns the raw array payload.
(defn rt-array-new [(length i64) (proto i64) (map-id i64) (caller-sp i64)] (-> i64)
  (let [proto-root (primitive/alloc-stack i64)
        store-root (primitive/alloc-stack i64)]
    (set! proto-root proto)
    (set! store-root 0)
    (rt-heap-boot!)
    (if (or (< length 0) (> length RT-ARRAY-MAX-INDEX))
        (panic-i "aot_rt_array_new: length is not an array length" length)
        0)
    (let [capacity
            (if (< length RT-ARRAY-MIN-CAPACITY) RT-ARRAY-MIN-CAPACITY length)
          store
            (rt-array-alloc-store capacity
                                  map-id
                                  caller-sp
                                  (primitive/cast (ptr i64) 0)
                                  proto-root)]
      (set! store-root store)
      (let [arr
              (rt-alloc-rooted RT-ARRAY-PAYLOAD-BYTES
                               SHAPES-ROOT
                               map-id
                               caller-sp
                               store-root
                               proto-root
                               true)
            moved-store (load store-root)
            moved-proto (load proto-root)
            elements (rt-box-object moved-store)]
        (set! (primitive/cast (ptr i64) (+ arr 0)) moved-proto)
        (aot-rt-write-barrier arr moved-proto RT-BARRIER-BOXED)
        (set! (primitive/cast (ptr i64) (+ arr RT-OFFSET-OBJECT-PROPERTIES))
              0x7ffb000000000000)
        (set! (primitive/cast (ptr i64) (+ arr RT-OFFSET-ARRAY-ELEMENTS))
              elements)
        (aot-rt-write-barrier arr elements RT-BARRIER-BOXED)
        (rt-array-set-length-word! arr length)
        arr))))

;; HasProperty of an array index on the array itself: inside the length and not a hole.
(defn rt-array-has [(arr i64) (index i64)] (-> i64)
  (if (or (< index 0) (>= index (rt-array-length arr)))
      0
      (let [store (rt-array-elements arr)]
        (if (or (= store 0) (>= index (rt-array-capacity store)))
            0
            (if (= (load (primitive/cast (ptr i64) (+ store (* index 8))))
                   RT-DYNAMIC-HOLE-WORD)
                0
                1)))))

;; The element at `index`, or undefined for a hole or an index outside the length. (The prototype
;; chain a hole falls through to is the JSL's business: `JsArrayGetIndex`.)
(defn rt-array-load [(arr i64) (index i64)] (-> i64)
  (if (= (rt-array-has arr index) 0)
      RT-DYNAMIC-UNDEFINED-WORD
      (load (primitive/cast (ptr i64) (+ (rt-array-elements arr) (* index 8))))))

;; Make room for `needed` slots, keeping the array's identity: a larger store, the live elements
;; copied, the rest holes, installed through the barrier. Roots `arr` and the boxed `value` the
;; caller is about to store; both are re-read from the roots afterwards.
(defn rt-array-grow! [(arr-root (ptr i64))
                      (value-root (ptr i64))
                      (needed i64)
                      (map-id i64)
                      (caller-sp i64)] (-> i64)
  (let [old (rt-array-elements (load arr-root))
        capacity (rt-array-capacity old)]
    (if (<= needed capacity)
        0
        (let [doubled (* 2 capacity)
              target
                (if (< doubled needed)
                    needed
                    (if (< doubled RT-ARRAY-MIN-CAPACITY)
                        RT-ARRAY-MIN-CAPACITY
                        doubled))
              fresh
                (rt-array-alloc-store target
                                      map-id
                                      caller-sp
                                      arr-root
                                      value-root)
              moved-arr (load arr-root)
              moved-old (rt-array-elements moved-arr)
              live (rt-array-length moved-arr)
              (mut i) 0]
          (loop (if (or (>= (load i) live)
                        (>= (load i) (rt-array-capacity moved-old)))
                    (break 0)
                    (do
                      (set! (primitive/cast (ptr i64) (+ fresh (* (load i) 8)))
                            (load (primitive/cast (ptr i64)
                                                  (+ moved-old (* (load i) 8)))))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (let [elements (rt-box-object fresh)]
            (set! (primitive/cast (ptr i64)
                                  (+ moved-arr RT-OFFSET-ARRAY-ELEMENTS))
                  elements)
            (aot-rt-write-barrier moved-arr elements RT-BARRIER-BOXED)
            0)))))

;; [[Set]] of an array index on the array itself: the element is stored and the length grows to
;; cover it (ArraySetLength's "index >= length" half). Returns the value.
(defn rt-array-store [(arr i64)
                      (index i64)
                      (value i64)
                      (map-id i64)
                      (caller-sp i64)] (-> i64)
  (let [arr-root (primitive/alloc-stack i64)
        value-root (primitive/alloc-stack i64)]
    (set! arr-root arr)
    (set! value-root value)
    (rt-heap-boot!)
    (if (or (< index 0) (> index RT-ARRAY-MAX-INDEX))
        (panic-i "aot_rt_array_store: index is not an array index" index)
        0)
    (rt-array-grow! arr-root value-root (+ index 1) map-id caller-sp)
    (let [moved-arr (load arr-root)
          moved-value (load value-root)
          store (rt-array-elements moved-arr)]
      (set! (primitive/cast (ptr i64) (+ store (* index 8))) moved-value)
      (aot-rt-write-barrier store moved-value RT-BARRIER-BOXED)
      (if (>= index (rt-array-length moved-arr))
          (rt-array-set-length-word! moved-arr (+ index 1))
          0)
      moved-value)))

;; ArraySetLength (ECMA-262 §10.4.2.4) once the new length is a valid array length: a shorter
;; length drops the elements past it (they become holes so the collector may reclaim them); a
;; longer one extends with holes, growing the store if it must. Returns the length.
(defn rt-array-set-length [(arr i64) (length i64) (map-id i64) (caller-sp i64)] (-> i64)
  (let [arr-root (primitive/alloc-stack i64)
        none (primitive/alloc-stack i64)]
    (set! arr-root arr)
    (set! none 0)
    (rt-heap-boot!)
    (if (or (< length 0) (> length (+ RT-ARRAY-MAX-INDEX 1)))
        (panic-i "aot_rt_array_set_length: not an array length" length)
        0)
    (let [current (rt-array-length arr)]
      (if (< length current)
          (do
            (rt-elements-fill-holes! (rt-array-elements arr) length current)
            (rt-array-set-length-word! arr length)
            length)
          (do
            (rt-array-grow! arr-root none length map-id caller-sp)
            (rt-array-set-length-word! (load arr-root) length)
            length)))))

;; The array index a canonical numeric string denotes (ECMA-262 §6.1.7: "0", or a decimal with
;; no leading zero whose value is at most 2^32 - 2), or -1 for any other string.
;; The runtime capability behind `%StringToNumber` (ECMA-262 §7.1.4.1.1): StrWhiteSpace trimmed
;; from both ends of the UTF-16 spelling, the ASCII remainder parsed by `aot.rt.number`, and the
;; Number returned as its boxed word. A non-ASCII character surviving the trim is outside every
;; numeric production, so the result is NaN without a copy.
(defn rt-str-whitespace? [(unit i64)] (-> bool)
  (or (= unit 9)
      (= unit 10)
      (= unit 11)
      (= unit 12)
      (= unit 13)
      (= unit 32)
      (= unit 0xa0)
      (= unit 0x1680)
      (and (>= unit 0x2000) (<= unit 0x200a))
      (= unit 0x2028)
      (= unit 0x2029)
      (= unit 0x202f)
      (= unit 0x205f)
      (= unit 0x3000)
      (= unit 0xfeff)))

(defn rt-string-to-number [(string i64)] (-> i64)
  (let [n (rt-string-length string)
        (mut lo) 0
        (mut hi) n]
    (loop (if (and (< (load lo) (load hi))
                   (rt-str-whitespace? (rt-string-code-unit string (load lo))))
              (do (set! (mut lo) (+ (load lo) 1)) (continue))
              (break 0)))
    (loop (if (and (< (load lo) (load hi))
                   (rt-str-whitespace? (rt-string-code-unit string
                                                            (- (load hi) 1))))
              (do (set! (mut hi) (- (load hi) 1)) (continue))
              (break 0)))
    (let [a (alloc/malloc-allocator)
          (mut bytes) (al-new [u8] a)
          (mut i) (load lo)
          (mut ascii) true]
      (loop (if (or (not (load ascii)) (>= (load i) (load hi)))
                (break 0)
                (let [unit (rt-string-code-unit string (load i))]
                  (if (> unit 127)
                      (set! (mut ascii) false)
                      (push! [u8] (mut bytes) (primitive/cast u8 unit)))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (let [value
              (if (load ascii)
                  (number-string-to-number (al-slice (load bytes)))
                  (number-nan))]
        (al-free! [u8] (mut bytes))
        (number-word value)))))

;; Math over NaN-boxed words (`%MathUnary`, `%MathBinary`, `%MathRandom`; aot.rt.number): the
;; operand words are Numbers already (the JSL side did ToNumber), the result is the Number word.
(defn rt-math-unary [(op i64) (x i64)] (-> i64)
  (number-word (number-math-unary op (rt-number-word-value x))))

(defn rt-math-binary [(op i64) (x i64) (y i64)] (-> i64)
  (number-word (number-math-binary op
                                   (rt-number-word-value x)
                                   (rt-number-word-value y))))

(defn rt-math-random [] (-> i64)
  (number-word (number-math-random)))

(defn rt--string-units [(string i64)] (-> (ArrayList i64))
  (let [n (rt-string-length string)
        (mut units) (al-new [i64] (alloc/malloc-allocator))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break 0)
              (do
                (push! [i64] (mut units) (rt-string-code-unit string (load i)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load units)))

;; parseInt(string, radix) and parseFloat(string) (`%ParseInt`, `%ParseFloat`) over a string's code
;; units; the grammar lives in aot.rt.number.
(defn rt-parse-int [(string i64) (radix i64)] (-> i64)
  (let [(mut units) (rt--string-units string)
        value (number-parse-int (al-slice (load units)) radix)]
    (al-free! [i64] (mut units))
    (number-word value)))

(defn rt-parse-float [(string i64)] (-> i64)
  (let [(mut units) (rt--string-units string)
        value (number-parse-float (al-slice (load units)))]
    (al-free! [i64] (mut units))
    (number-word value)))

;; The `Function` constructor compiles source text at run time; this compiler is ahead-of-time and
;; has no evaluator (docs/DESIGN.md, strictly AOT).
(defn rt-unimplemented-dynamic-code [] (-> i64)
  (do
    (unimplemented "the Function constructor (source text compiled at run time; this compiler is ahead-of-time)"
                   "docs/GAPS.md — function objects")
    0))

;; The array index key `key` names, or -1 (`%KeyArrayIndex`): the static or runtime key table's name.
(defn rt-key-array-index [(key i64)] (-> i64)
  (do
    (rt-heap-boot!)
    (number-array-index-of-name (shapes-key-name key))))

;; An ordinary object's own string property keys in OrdinaryOwnPropertyKeys order (§10.1.11.1):
;; the array-index keys ascending, then the other keys in insertion order — the shape tree's edges
;; from the root to the object's shape. Marker and hole rows name no key. `all` keeps the
;; non-enumerable keys too (getOwnPropertyNames, for-in's shadowing); otherwise they are passed over.
(defn rt-shape-keys! [(shape i64) (out (mut (ArrayList i64))) (all bool)] (-> i64)
  (let [(mut chain) (al-new [i64] (alloc/malloc-allocator))
        (mut indices) (al-new [i64] (alloc/malloc-allocator))
        (mut s) shape]
    (loop (if (or (= (load s) 0) (= (load s) SHAPES-ROOT))
              (break 0)
              (do
                (if (and (!= (shapes-key (load s)) 0)
                         (and (not (shapes-key-symbol? (shapes-key (load s))))
                              (or all
                                  (!= (& (shapes-attrs (load s)) SHAPES-ATTR-ENUMERABLE)
                                      0))))
                    (push! [i64] (mut chain) (shapes-key (load s)))
                    0)
                (set! (mut s) (shapes-parent (load s)))
                (continue))))
    ;; The index keys, sorted by insertion into a list kept ascending.
    (al-for [key (load chain)]
            (let [index (number-array-index-of-name (shapes-key-name key))]
              (if (>= index 0)
                  (let [(mut at) (len (load indices))]
                    (push! [i64] (mut indices) key)
                    (loop (if (or (= (load at) 0)
                                  (<= (number-array-index-of-name (shapes-key-name (get (load indices) (- (load at) 1))))
                                      index))
                              (break 0)
                              (do
                                (set! (al-elem [i64] (mut indices) (load at)) (get (load indices) (- (load at) 1)))
                                (set! (mut at) (- (load at) 1))
                                (continue))))
                    (set! (al-elem [i64] (mut indices) (load at)) key))
                  0)))
    (al-for [key (load indices)] (push! [i64] (mut out) key))
    (let [(mut i) (- (len (load chain)) 1)]
      (loop (if (< (load i) 0)
                (break 0)
                (let [key (get (load chain) (load i))]
                  (if (< (number-array-index-of-name (shapes-key-name key)) 0)
                      (push! [i64] (mut out) key)
                      0)
                  (set! (mut i) (- (load i) 1))
                  (continue)))))
    (al-free! [i64] (mut indices))
    (al-free! [i64] (mut chain))
    0))

;; A fresh string holding a key's UTF-8 name decoded to UTF-16, with `root` kept alive.
(defn rt-string-from-utf8 [(name (slice u8))
                           (map-id i64)
                           (caller-sp i64)
                           (root (ptr i64))] (-> i64)
  (let [(mut units) (al-new [i64] (alloc/malloc-allocator))
        (mut i) 0
        n (len name)]
    (loop (if (>= (load i) n)
              (break 0)
              (let [b0 (primitive/cast i64 (get name (load i)))]
                (if (< b0 0x80)
                    (do
                      (push! [i64] (mut units) b0)
                      (set! (mut i) (+ (load i) 1)))
                    (if (< b0 0xe0)
                        (do
                          (push! [i64]
                                 (mut units)
                                 (+ (primitive/ishl (& b0 0x1f) 6)
                                    (& (primitive/cast i64
                                                       (get name (+ (load i) 1)))
                                       0x3f)))
                          (set! (mut i) (+ (load i) 2)))
                        (if (< b0 0xf0)
                            (do
                              (push! [i64]
                                     (mut units)
                                     (+ (primitive/ishl (& b0 0x0f) 12)
                                        (+ (primitive/ishl (& (primitive/cast i64
                                                                              (get name
                                                                                   (+ (load i)
                                                                                      1)))
                                                              0x3f)
                                                           6)
                                           (& (primitive/cast i64
                                                              (get name
                                                                   (+ (load i)
                                                                      2)))
                                              0x3f))))
                              (set! (mut i) (+ (load i) 3)))
                            (let [cp
                                    (+ (primitive/ishl (& b0 0x07) 18)
                                       (+ (primitive/ishl (& (primitive/cast i64
                                                                             (get name
                                                                                  (+ (load i)
                                                                                     1)))
                                                             0x3f)
                                                          12)
                                          (+ (primitive/ishl (& (primitive/cast i64
                                                                                (get name
                                                                                     (+ (load i)
                                                                                        2)))
                                                                0x3f)
                                                             6)
                                             (& (primitive/cast i64
                                                                (get name
                                                                     (+ (load i)
                                                                        3)))
                                                0x3f))))]
                              (push! [i64]
                                     (mut units)
                                     (+ 0xd800
                                        (primitive/ishr (- cp 0x10000) 10)))
                              (push! [i64]
                                     (mut units)
                                     (+ 0xdc00 (& (- cp 0x10000) 0x3ff)))
                              (set! (mut i) (+ (load i) 4))))))
                (continue))))
    (let [result
            (rt-alloc-string (len (load units))
                             RT-SHAPE-STRING
                             map-id
                             caller-sp
                             root)
          (mut k) 0]
      (loop (if (>= (load k) (len (load units)))
                (break 0)
                (do
                  (rt-string-set-code-unit! result
                                            (load k)
                                            (get (load units) (load k)))
                  (set! (mut k) (+ (load k) 1))
                  (continue))))
      (al-free! [i64] (mut units))
      result)))

;; The runtime capability behind `%ObjectKeys`: an ordinary object's own enumerable keys as a fresh
;; array of strings in OrdinaryOwnPropertyKeys order, on `proto` (%Array.prototype%, or null without a
;; realm). The array is rooted across every string allocation and re-read.
(defn rt-object-keys [(obj i64) (proto i64) (map-id i64) (caller-sp i64)] (-> i64)
  (rt-object-key-strings obj proto false map-id caller-sp))

;; `%ObjectOwnNames`: every own string key, the non-enumerable ones included, in the same order.
(defn rt-object-own-names [(obj i64) (proto i64) (map-id i64) (caller-sp i64)] (-> i64)
  (rt-object-key-strings obj proto true map-id caller-sp))

(defn rt-object-key-strings [(obj i64) (proto i64) (all bool) (map-id i64) (caller-sp i64)] (-> i64)
  (let [(mut keys) (al-new [i64] (alloc/malloc-allocator))
        storage (rt-storage-of obj)
        arr-root (primitive/alloc-stack i64)]
    (rt-heap-boot!)
    (if (= storage 0) 0 (rt-shape-keys! (rt-payload-shape storage) (mut keys) all))
    (set! arr-root (rt-array-new (len (load keys)) proto map-id caller-sp))
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (load keys)))
                (break 0)
                (let [string
                        (rt-string-from-utf8 (shapes-key-name (get (load keys)
                                                                   (load i)))
                                             map-id
                                             caller-sp
                                             arr-root)]
                  (rt-array-store (load arr-root)
                                  (load i)
                                  (rt-box-string string)
                                  map-id
                                  caller-sp)
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (al-free! [i64] (mut keys))
    (load arr-root)))

;; `%ArgumentTail`: the callable ABI's overflow vector for an argument list held in an array — the
;; elements from index 3, a hole read as undefined, one boxed word each under SHAPE-ELEMENTS, as a
;; caller's vector is (aot.codegen.callabi). Null when there is no overflow. The array is rooted
;; across the allocation and re-read.
(defn rt-argument-tail [(arr i64) (map-id i64) (caller-sp i64)] (-> i64)
  (let [arr-root (primitive/alloc-stack i64)
        none (primitive/alloc-stack i64)]
    (set! arr-root arr)
    (set! none 0)
    (rt-heap-boot!)
    (let [count (rt-array-length arr)]
      (if (<= count 3)
          0
          (let [vector (rt-array-alloc-store (- count 3) map-id caller-sp arr-root none)
                moved (load arr-root)
                (mut i) 3]
            (loop (if (>= (load i) count)
                      (break 0)
                      (do
                        (let [word (rt-array-load moved (load i))]
                          (set! (primitive/cast (ptr i64) (+ vector (* (- (load i) 3) 8))) word)
                          (aot-rt-write-barrier vector word RT-BARRIER-BOXED))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))
            vector)))))

(defn rt-array-index-of-string [(string i64)] (-> i64)
  (let [n (rt-string-length string)]
    (if (or (= n 0) (> n 10))
        -1
        (let [first (rt-string-code-unit string 0)]
          (if (and (= first 48) (= n 1))
              0
              (if (or (< first 49) (> first 57))
                  -1
                  (let [(mut i) 1
                        (mut value) (- first 48)
                        (mut ok) true]
                    (loop (if (or (not (load ok)) (>= (load i) n))
                              (break 0)
                              (let [c (rt-string-code-unit string (load i))]
                                (if (or (< c 48) (> c 57))
                                    (set! (mut ok) false)
                                    (set! (mut value)
                                          (+ (* (load value) 10) (- c 48))))
                                (set! (mut i) (+ (load i) 1))
                                (continue))))
                    (if (and (load ok) (<= (load value) RT-ARRAY-MAX-INDEX))
                        (load value)
                        -1))))))))

(defn rt-unimplemented-keyed-access [] (-> i64)
  (do
    (unimplemented "computed property access with a runtime key (`o[k]`, arrays)"
                   "docs/GAPS.md — property keys")
    0))

(defn rt-unimplemented-unresolved-global [(key i64)] (-> i64)
  (let [(mut b) (sb-new (alloc/malloc-allocator))]
    (rt-heap-boot!)
    (sb-push-str! (mut b) "reference to the undeclared global `")
    (sb-push-str! (mut b) (shapes-key-name key))
    (sb-push-str! (mut b)
                  "` (a standard global not provided yet, a global object property, or a ReferenceError)")
    (unimplemented (sb-str (mut b)) "docs/GAPS.md — global environments")
    0))

(defn rt-unimplemented-no-realm [] (-> i64)
  (do
    (unimplemented "sloppy `this` with an undefined receiver in a function-entry program (no global object)"
                   "docs/GAPS.md — receivers and the global object")
    0))

;; Generated objects speak a deliberately small C-ABI-shaped boundary to the Coil runtime object.
;; These names are part of the object format: target selection emits relocations against them, so
;; namespace-mangled Coil symbols would make a correct runtime body unreachable at final link.
;; The embedded loader resolves only this runtime's declared ABI, never arbitrary host symbols.
(defn rt-symbol-lookup [(name (slice u8))] (-> i64)
  (let [(mut address) 0]
    (if (= name "aot_rt_alloc")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-alloc)))) 0)
    (if (= name "aot_rt_heap_state")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-heap-state)))) 0)
    (if (= name "aot_rt_collect")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-collect)))) 0)
    (if (= name "aot_rt_string_length")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-string-length)))) 0)
    (if (= name "aot_rt_string_code_unit")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-string-code-unit)))) 0)
    (if (= name "aot_rt_string_eq")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-string-eq)))) 0)
    (if (= name "aot_rt_string_compare")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-string-compare)))) 0)
    (if (= name "aot_rt_string_concat")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-string-concat)))) 0)
    (if (= name "aot_rt_substring")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-substring)))) 0)
    (if (= name "aot_rt_string_from_code")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-string-from-code)))) 0)
    (if (= name "aot_rt_write_barrier")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of aot-rt-write-barrier)))) 0)
    (if (= name "aot_rt_throw")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-throw)))) 0)
    (if (= name "aot_rt_throw_type_error")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-throw-type-error)))) 0)
    (if (= name "aot_rt_trap_invariant")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-trap-invariant)))) 0)
    (if (= name "aot_rt_unimplemented_to_primitive")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-unimplemented-to-primitive)))) 0)
    (if (= name "aot_rt_unimplemented_to_string")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-unimplemented-to-string)))) 0)
    (if (= name "aot_rt_string_to_number")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-string-to-number)))) 0)
    (if (= name "aot_rt_math_unary")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-math-unary)))) 0)
    (if (= name "aot_rt_math_binary")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-math-binary)))) 0)
    (if (= name "aot_rt_math_random")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-math-random)))) 0)
    (if (= name "aot_rt_parse_int")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-parse-int)))) 0)
    (if (= name "aot_rt_parse_float")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-parse-float)))) 0)
    (if (= name "aot_rt_unimplemented_no_realm")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-unimplemented-no-realm)))) 0)
    (if (= name "aot_rt_unimplemented_dynamic_code")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-unimplemented-dynamic-code)))) 0)
    (if (= name "aot_rt_key_array_index")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-key-array-index)))) 0)
    (if (= name "aot_rt_object_keys")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-object-keys)))) 0)
    (if (= name "aot_rt_argument_tail")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-argument-tail)))) 0)
    (if (= name "aot_rt_object_own_names")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-object-own-names)))) 0)
    (if (= name "aot_rt_uncaught")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-uncaught)))) 0)
    (if (= name "aot_rt_number_to_string")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-number-to-string)))) 0)
    (if (= name "aot_rt_intern_key")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-intern-key)))) 0)
    (if (= name "aot_rt_global_lexical_find")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-global-lexical-find)))) 0)
    (if (= name "aot_rt_global_lexical_create")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-global-lexical-create-word)))) 0)
    (if (= name "aot_rt_global_lexical_state")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-global-lexical-state)))) 0)
    (if (= name "aot_rt_global_lexical_value")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-global-lexical-value)))) 0)
    (if (= name "aot_rt_global_lexical_initialize")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-global-lexical-initialize!)))) 0)
    (if (= name "aot_rt_global_lexical_store")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-global-lexical-store!)))) 0)
    (if (= name "aot_rt_prop_get_own")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-get-own)))) 0)
    (if (= name "aot_rt_prop_has_own")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-has-own)))) 0)
    (if (= name "aot_rt_prop_attributes")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-attributes)))) 0)
    (if (= name "aot_rt_prop_chain_holder")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-chain-holder)))) 0)
    (if (= name "aot_rt_prop_define")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-define)))) 0)
    (if (= name "aot_rt_object_extensible")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-object-extensible)))) 0)
    (if (= name "aot_rt_object_prevent_extensions")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-object-prevent-extensions)))) 0)
    (if (= name "aot_rt_object_integrity")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-object-integrity)))) 0)
    (if (= name "aot_rt_object_test_integrity")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-object-test-integrity)))) 0)
    (if (= name "aot_rt_prop_set_own")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-set-own)))) 0)
    (if (= name "aot_rt_prop_set_own_attrs")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-set-own-attrs)))) 0)
    (if (= name "aot_rt_prop_get")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-get)))) 0)
    (if (= name "aot_rt_prop_set")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-set)))) 0)
    (if (= name "aot_rt_symbol_new")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-symbol-new)))) 0)
    (if (= name "aot_rt_symbol_key")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-symbol-key)))) 0)
    (if (= name "aot_rt_symbol_description")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-symbol-description)))) 0)
    (if (= name "aot_rt_array_new")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-array-new)))) 0)
    (if (= name "aot_rt_array_load")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-array-load)))) 0)
    (if (= name "aot_rt_array_has")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-array-has)))) 0)
    (if (= name "aot_rt_array_delete")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-array-delete)))) 0)
    (if (= name "aot_rt_prop_delete")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-prop-delete)))) 0)
    (if (= name "aot_rt_array_store")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-array-store)))) 0)
    (if (= name "aot_rt_array_set_length")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-array-set-length)))) 0)
    (if (= name "aot_rt_array_index_of_string")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-array-index-of-string)))) 0)
    (if (= name "aot_rt_unimplemented_to_object")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-unimplemented-to-object)))) 0)
    (if (= name "aot_rt_unimplemented_keyed_access")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-unimplemented-keyed-access)))) 0)
    (if (= name "aot_rt_unimplemented_unresolved_global")
        (set! (mut address) (primitive/cast i64 (primitive/cast (ptr u8) (primitive/fnptr-of rt-unimplemented-unresolved-global)))) 0)
    (load address)))

(defn rt-symbol-address [(name (slice u8))] (-> i64)
  (let [address (rt-symbol-lookup name)]
    (if (= address 0)
        (do (p--str "\n  unresolved import: ") (p--str name)
            (panic "rt-symbol-address: unresolved runtime import")) 0)
    address))

(export-c [rt-alloc :as "aot_rt_alloc"]
          [rt-heap-state :as "aot_rt_heap_state"]
          [rt-collect :as "aot_rt_collect"]
          [rt-string-length :as "aot_rt_string_length"]
          [rt-string-code-unit :as "aot_rt_string_code_unit"]
          [rt-string-eq :as "aot_rt_string_eq"]
          [rt-string-compare :as "aot_rt_string_compare"]
          [rt-string-concat :as "aot_rt_string_concat"]
          [rt-substring :as "aot_rt_substring"]
          [rt-string-from-code :as "aot_rt_string_from_code"]
          [aot-rt-write-barrier :as "aot_rt_write_barrier"]
          [rt-throw :as "aot_rt_throw"]
          [rt-throw-type-error :as "aot_rt_throw_type_error"]
          [rt-trap-invariant :as "aot_rt_trap_invariant"]
          [rt-unimplemented-to-primitive
           :as
           "aot_rt_unimplemented_to_primitive"]
          [rt-unimplemented-to-string :as "aot_rt_unimplemented_to_string"]
          [rt-string-to-number :as "aot_rt_string_to_number"]
          [rt-math-unary :as "aot_rt_math_unary"]
