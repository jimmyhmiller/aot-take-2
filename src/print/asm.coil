;; Disassembly printing: blocks, addresses, encodings, and one instruction per line.

;;
;; The register names come from the machine port, so this file is target-independent.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S6.
(module aot.print.asm)
(import "aot.util.panic" :use *)

(defn asm-print [] (-> (slice u8))
  (do (unimplemented "asm-print" "S6 — src/print/asm.coil") ""))
