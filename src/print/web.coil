;; Structured browser snapshots of the ideal graph.

;; The browser is deliberately a presentation client. Opcode families, edge kinds, input order,
;; and graph identity are decided here from the actual ideal graph and serialized as JSON. The
;; JavaScript viewer may filter or arrange these facts, but it never reconstructs compiler meaning.
(module aot.print.web)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-push-byte! sb-push-i64! sb-finish!])
(import "aot.node.node" :use *)
(import "aot.print.dot" :use [dot-control-op? dot-find-all])

(defn web-hex! [(b (mut StrBuf)) (v u8)] (-> i64)
  (let [digit (if (< v (cast u8 10)) (+ v (cast u8 48)) (+ (- v (cast u8 10)) (cast u8 97)))]
    (sb-push-byte! (mut b) digit)))

(defn web-json-string! [(b (mut StrBuf)) (s (slice u8))] (-> i64)
  (let [(mut i) 0]
    (sb-push-byte! (mut b) (cast u8 34))
    (loop (if (>= (load i) (len s))
              (break 0)
              (let [c (get s (load i))]
                (if (= c (cast u8 34))
                    (sb-push-str! (mut b) "\\\"")
                    (if (= c (cast u8 92))
                        (sb-push-str! (mut b) "\\\\")
                        (if (= c (cast u8 10))
                            (sb-push-str! (mut b) "\\n")
                            (if (= c (cast u8 13))
                                (sb-push-str! (mut b) "\\r")
                                (if (= c (cast u8 9))
                                    (sb-push-str! (mut b) "\\t")
                                    (if (< c (cast u8 32))
                                        (do
                                          (sb-push-str! (mut b) "\\u00")
                                          (web-hex! (mut b) (cast u8 (/ (cast i64 c) 16)))
                                          (web-hex! (mut b) (cast u8 (% (cast i64 c) 16))))
                                        (sb-push-byte! (mut b) c)))))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (sb-push-byte! (mut b) (cast u8 34))))

(defn web-memory-op? [(op i64)] (-> bool)
  (or (= op OP-LOAD)
      (= op OP-STORE)
      (= op OP-NEW)
      (= op OP-MEMMERGE)
      (= op OP-MEMPHI)
      (= op OP-READONLY)))

(defn web-call-op? [(op i64)] (-> bool)
  (or (= op OP-FUN)
      (= op OP-PARM)
      (= op OP-CALL)
      (= op OP-CALLEND)
      (= op OP-FUNPTR)
      (= op OP-RETURN)))

(defn web-dynamic-op? [(op i64)] (-> bool)
  (or (= op OP-BOX) (= op OP-UNBOX) (= op OP-TYPETEST) (= op OP-CAST)))

(defn web-property-op? [(op i64)] (-> bool)
  (or (= op OP-PROPLOAD)
      (= op OP-PROPSTORE)
      (= op OP-ARRAYLOAD)
      (= op OP-ARRAYSTORE)
      (= op OP-ARRAYLEN)))

(defn web-node-kind [(n (dyn NodeOps))] (-> (slice u8))
  (let [op (n-op n)]
    (if (dot-control-op? op)
        "control"
        (if (web-memory-op? op)
            "memory"
            (if (web-call-op? op)
                "call"
                (if (or (= op OP-SAFEPOINT) (= op OP-BARRIER))
                    "gc"
                    (if (web-dynamic-op? op)
                        "dynamic"
                        (if (web-property-op? op) "property" "value"))))))))

(defn web-edge-kind [(use (dyn NodeOps)) (def (dyn NodeOps))] (-> (slice u8))
  (let [op (n-op def)]
    (if (dot-control-op? op)
        "control"
        (if (web-memory-op? op)
            "memory"
            (if (or (= (n-op use) OP-SAFEPOINT)
                    (= (n-op use) OP-BARRIER)
                    (= op OP-SAFEPOINT)
                    (= op OP-BARRIER))
                "gc"
                (if (or (= op OP-PROJ) (= op OP-CPROJ)) "projection" "value"))))))

(defn web-emit-node! [(b (mut StrBuf)) (n (dyn NodeOps)) (first? bool)] (-> i64)
  (do
    (if first? 0 (sb-push-byte! (mut b) (cast u8 44)))
    (sb-push-str! (mut b) "{\"id\":")
    (sb-push-i64! (mut b) (n-nid n))
    (sb-push-str! (mut b) ",\"op\":")
    (sb-push-i64! (mut b) (n-op n))
    (sb-push-str! (mut b) ",\"label\":")
    (web-json-string! (mut b) (label n))
    (sb-push-str! (mut b) ",\"kind\":")
    (web-json-string! (mut b) (web-node-kind n))
    (sb-push-str! (mut b) "}")
    0))

(defn web-emit-edge! [(b (mut StrBuf))
                      (use (dyn NodeOps))
                      (def (dyn NodeOps))
                      (index i64)
                      (first? bool)] (-> i64)
  (do
    (if first? 0 (sb-push-byte! (mut b) (cast u8 44)))
    (sb-push-str! (mut b) "{\"use\":")
    (sb-push-i64! (mut b) (n-nid use))
    (sb-push-str! (mut b) ",\"def\":")
    (sb-push-i64! (mut b) (n-nid def))
    (sb-push-str! (mut b) ",\"index\":")
    (sb-push-i64! (mut b) index)
    (sb-push-str! (mut b) ",\"kind\":")
    (web-json-string! (mut b) (web-edge-kind use def))
    (sb-push-str! (mut b) "}")
    0))

(defn web-graph-json [(root (dyn NodeOps)) (phase (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        (mut b) (sb-new a)
        (mut all) (dot-find-all root)
        (mut i) 0]
    (sb-push-str! (mut b) "{\"phase\":")
    (web-json-string! (mut b) phase)
    (sb-push-str! (mut b) ",\"root\":")
    (sb-push-i64! (mut b) (n-nid root))
    (sb-push-str! (mut b) ",\"nodes\":[")
    (loop (if (>= (load i) (len (load all)))
              (break 0)
              (do
                (web-emit-node! (mut b) (get (load all) (load i)) (= (load i) 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (sb-push-str! (mut b) "],\"edges\":[")
    (set! (mut i) 0)
    (let [(mut first?) true]
      (loop (if (>= (load i) (len (load all)))
                (break 0)
                (let [n (get (load all) (load i)) (mut j) 0]
                  (loop (if (>= (load j) (n-nins n))
                            (break 0)
                            (do
                              (match (n-in n (load j))
                                (Some [def]
                                  (do
                                    (web-emit-edge! (mut b) n def (load j) (load first?))
                                    (set! (mut first?) false)))
                                (None [] 0))
                              (set! (mut j) (+ (load j) 1))
                              (continue))))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (sb-push-str! (mut b) "]}")
    (al-free! [(dyn NodeOps)] (mut all))
    (sb-finish! (mut b))))
