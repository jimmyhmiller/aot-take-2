;; Structured browser snapshots of the ideal graph.

;; Simple's final GraphVisualizer walks the cyclic graph through inputs and outputs, folds Proj and
;; CProj into ports on their Multi producer, lays definitions above uses with rankdir=BT, keeps a
;; Region and its Phis on one rank, and removes rank pressure from Loop/Phi backedges. Control is a
;; yellow box, Fun a double box, Phi a pale-yellow ellipse; remaining node colors follow the value
;; type (integer light blue, float aqua, memory blue, pointers green, function pointers orange).
;; Edges run use-to-definition, retain their input index, color by the definition's type, and make
;; the Phi-to-Region ownership edge dotted. These are semantic rules, not Canvas guesses, so this
;; module serializes the shape, color, projection, rank, and edge-style facts explicitly.
;;
;; The browser remains a presentation client. It may perform layout over these facts, but it never
;; reconstructs opcode families or compiler meaning.
(module aot.print.web)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-push-byte! sb-push-i64! sb-finish!])
(import "aot.util.panic" :use [panic])
(import "aot.node.node" :use *)
(import "aot.node.control" :use [cfg? cproj-idx proj-idx])
(import "aot.codegen.codegen" :use [PHASE-ENCODING code-phase code-schedule-count code-schedule-at])
(import "aot.codegen.encoding" :use [enc-byte-at enc-layout-block-at enc-layout-block-count enc-layout-jump-at enc-op-length enc-op-start])
(import "aot.codegen.machine" :use [mach-of m-asm m-ideal-op])
(import "aot.print.dot" :use [dot-control-op? dot-find-all])
(import "aot.type.type" :use *)

(defn web-hex! [(b (mut StrBuf)) (v u8)] (-> i64)
  (let [digit (if (< v (cast u8 10)) (+ v (cast u8 48)) (+ (- v (cast u8 10)) (cast u8 97)))]
    (sb-push-byte! (mut b) digit)))

(defn web-json-string! [(b (mut StrBuf)) (s (slice u8))] (-> i64)
  (let [(mut i) 0]
    (sb-push-byte! (mut b) (cast u8 34))
    (loop (if (>= (load i) (len s))
              (break 0)
              (let [c (get s (load i))]
                (if (= c (cast u8 34))
                    (sb-push-str! (mut b) "\\\"")
                    (if (= c (cast u8 92))
                        (sb-push-str! (mut b) "\\\\")
                        (if (= c (cast u8 10))
                            (sb-push-str! (mut b) "\\n")
                            (if (= c (cast u8 13))
                                (sb-push-str! (mut b) "\\r")
                                (if (= c (cast u8 9))
                                    (sb-push-str! (mut b) "\\t")
                                    (if (< c (cast u8 32))
                                        (do
                                          (sb-push-str! (mut b) "\\u00")
                                          (web-hex! (mut b) (cast u8 (/ (cast i64 c) 16)))
                                          (web-hex! (mut b) (cast u8 (% (cast i64 c) 16))))
                                        (sb-push-byte! (mut b) c)))))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (sb-push-byte! (mut b) (cast u8 34))))

(defn web-op [(n (dyn NodeOps))] (-> i64)
  (match (mach-of n) (Some [mach] (m-ideal-op mach)) (None [] (n-op n))))

(defn web-memory-op? [(op i64)] (-> bool)
  (or (= op OP-LOAD)
      (= op OP-STORE)
      (= op OP-NEW)
      (= op OP-MEMMERGE)
      (= op OP-MEMPHI)
      (= op OP-READONLY)))

(defn web-call-op? [(op i64)] (-> bool)
  (or (= op OP-FUN)
      (= op OP-PARM)
      (= op OP-CALL)
      (= op OP-CALLEND)
      (= op OP-FUNPTR)
      (= op OP-RETURN)))

(defn web-dynamic-op? [(op i64)] (-> bool)
  (or (= op OP-BOX) (= op OP-UNBOX) (= op OP-TYPETEST) (= op OP-CAST)))

(defn web-property-op? [(op i64)] (-> bool)
  (or (= op OP-PROPLOAD)
      (= op OP-PROPSTORE)
      (= op OP-ARRAYLOAD)
      (= op OP-ARRAYSTORE)
      (= op OP-ARRAYLEN)))

(defn web-node-kind [(n (dyn NodeOps))] (-> (slice u8))
  (let [op (web-op n)]
    (if (dot-control-op? op)
        "control"
        (if (web-memory-op? op)
            "memory"
            (if (web-call-op? op)
                "call"
                (if (or (= op OP-SAFEPOINT) (= op OP-BARRIER))
                    "gc"
                    (if (web-dynamic-op? op)
                        "dynamic"
                        (if (web-property-op? op) "property" "value"))))))))

(defn web-projection-op? [(op i64)] (-> bool)
  (or (= op OP-PROJ) (= op OP-CPROJ)))

(defn web-node-shape [(n (dyn NodeOps))] (-> (slice u8))
  (let [op (web-op n)]
    (if (= op OP-FUN)
        "function"
        (if (web-projection-op? (n-op n))
            "projection"
            (if (or (= op OP-PHI) (= op OP-PARM))
                "phi"
                (if (dot-control-op? op) "control" "value"))))))

(defn web-type-color [(n (dyn NodeOps))] (-> (slice u8))
  (if (dot-control-op? (web-op n))
      "control"
      (if (= (web-op n) OP-NEW)
          "new"
          (if (= (n-ty n) TY-INVALID)
              "unknown"
              (match (ty-kind (n-ty n))
                (TInt [_ _ _] "integer")
                (TFlt [_ _] "float")
                (TMem [_ _] "memory")
                (TPtr [_ _] "pointer")
                (TMemPtr [_ _] "pointer")
                (TFunPtr [_ _ _] "function")
                (TRpc [_ _] "rpc")
                (TNil [] "nil")
                (TXNil [] "nil")
                (TCtrl [] "control")
                (TXCtrl [] "control")
                (TDyn [_ _] "dynamic")
                (TShape [_] "shape")
                (TStr [_ _] "string")
                (_ "unknown"))))))

(defn web-edge-kind [(use (dyn NodeOps)) (def (dyn NodeOps))] (-> (slice u8))
  (let [op (web-op def)]
    (if (dot-control-op? op)
        "control"
        (if (web-memory-op? op)
            "memory"
            (if (or (= (web-op use) OP-SAFEPOINT)
                    (= (web-op use) OP-BARRIER)
                    (= op OP-SAFEPOINT)
                    (= op OP-BARRIER))
                "gc"
                (if (or (= op OP-PROJ) (= op OP-CPROJ)) "projection" "value"))))))

(defn web-anchor-nid [(n (dyn NodeOps))] (-> i64)
  ;; Before GCM, control ownership is an explicit CFG input. After GCM, block-nid is the compiler's
  ;; authoritative placement. Publishing that ownership lets the layout build data islands without
  ;; reverse-engineering opcodes or scheduling semantics in JavaScript.
  (if (!= (n-block-nid n) 0)
      (n-block-nid n)
      (let [(mut i) 0 (mut anchor) -1]
        (loop (if (or (>= (load i) (n-nins n)) (>= (load anchor) 0))
                  (break 0)
                  (do
                    (match (n-in n (load i))
                      (Some [input] (if (cfg? input) (set! (mut anchor) (n-nid input)) 0))
                      (None [] 0))
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (load anchor))))

(defn web-emit-node! [(b (mut StrBuf)) (n (dyn NodeOps)) (first? bool)] (-> i64)
  (do
    (if first? 0 (sb-push-byte! (mut b) (cast u8 44)))
    (sb-push-str! (mut b) "{\"id\":")
    (sb-push-i64! (mut b) (n-nid n))
    (sb-push-str! (mut b) ",\"op\":")
    (sb-push-i64! (mut b) (n-op n))
    (sb-push-str! (mut b) ",\"idealOp\":")
    (sb-push-i64! (mut b) (web-op n))
    (sb-push-str! (mut b) ",\"anchor\":")
    (sb-push-i64! (mut b) (web-anchor-nid n))
    (sb-push-str! (mut b) ",\"sourceLo\":")
    (sb-push-i64! (mut b) (n-source-lo n))
    (sb-push-str! (mut b) ",\"sourceHi\":")
    (sb-push-i64! (mut b) (n-source-hi n))
    (sb-push-str! (mut b) ",\"label\":")
    (web-json-string! (mut b) (label n))
    (sb-push-str! (mut b) ",\"kind\":")
    (web-json-string! (mut b) (web-node-kind n))
    (sb-push-str! (mut b) ",\"shape\":")
    (web-json-string! (mut b) (web-node-shape n))
    (sb-push-str! (mut b) ",\"color\":")
    (web-json-string! (mut b) (web-type-color n))
    (if (web-projection-op? (n-op n))
        (do
          (sb-push-str! (mut b) ",\"projectionIndex\":")
          (sb-push-i64! (mut b)
                        (if (= (n-op n) OP-PROJ) (proj-idx n) (cproj-idx n))))
        0)
    (sb-push-str! (mut b) "}")
    0))

(defn web-emit-edge! [(b (mut StrBuf))
                      (use (dyn NodeOps))
                      (def (dyn NodeOps))
                      (index i64)
                      (first? bool)] (-> i64)
  (do
    (if first? 0 (sb-push-byte! (mut b) (cast u8 44)))
    (sb-push-str! (mut b) "{\"use\":")
    (sb-push-i64! (mut b) (n-nid use))
    (sb-push-str! (mut b) ",\"def\":")
    (sb-push-i64! (mut b) (n-nid def))
    (sb-push-str! (mut b) ",\"index\":")
    (sb-push-i64! (mut b) index)
    (sb-push-str! (mut b) ",\"kind\":")
    (web-json-string! (mut b) (web-edge-kind use def))
    (sb-push-str! (mut b) ",\"rank\":")
    (if (or (and (= index 2) (or (= (web-op use) OP-PHI) (= (web-op use) OP-LOOP)))
            (and (or (= (web-op use) OP-PHI) (= (web-op use) OP-PARM))
                 (or (= (web-op def) OP-REGION) (= (web-op def) OP-FUN))))
        (sb-push-str! (mut b) "false")
        (sb-push-str! (mut b) "true"))
    (sb-push-str! (mut b) ",\"style\":")
    (web-json-string!
      (mut b)
      (if (and (or (= (web-op use) OP-PHI) (= (web-op use) OP-PARM))
               (or (= (web-op def) OP-REGION) (= (web-op def) OP-FUN)))
          "dotted"
          (if (= (web-edge-kind use def) "memory") "dashed" "solid")))
    (sb-push-str! (mut b) "}")
    0))

(defn web-emit-machine! [(b (mut StrBuf)) (n (dyn NodeOps)) (first? bool)] (-> i64)
  (match (mach-of n)
    (Some [mach]
          (let [start (enc-op-start n)
                length (enc-op-length n)
                (mut i) 0]
            (if first? 0 (sb-push-byte! (mut b) (cast u8 44)))
            (sb-push-str! (mut b) "{\"node\":")
            (sb-push-i64! (mut b) (n-nid n))
            (sb-push-str! (mut b) ",\"address\":")
            (sb-push-i64! (mut b) start)
            (sb-push-str! (mut b) ",\"length\":")
            (sb-push-i64! (mut b) length)
            (sb-push-str! (mut b) ",\"bytes\":\"")
            (loop (if (>= (load i) length)
                      (break 0)
                      (do
                        (web-hex! (mut b) (cast u8 (/ (cast i64 (enc-byte-at (+ start (load i)))) 16)))
                        (web-hex! (mut b) (cast u8 (% (cast i64 (enc-byte-at (+ start (load i)))) 16)))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))
            (sb-push-str! (mut b) "\",\"mnemonic\":")
            (web-json-string! (mut b) (m-asm mach))
            (sb-push-str! (mut b) "}")
            0))
    (None [] (panic "web-emit-machine!: scheduled instruction is not a machine node"))))

(defn web-emit-machine-array! [(b (mut StrBuf))] (-> i64)
  (let [(mut block-index) 0 (mut first?) true]
    (loop (if (>= (load block-index) (enc-layout-block-count))
              (break 0)
              (let [block (enc-layout-block-at (load block-index)) (mut i) 0]
                (loop (if (>= (load i) (code-schedule-count block))
                          (break 0)
                          (let [n (code-schedule-at block (load i))]
                            (if (> (enc-op-length n) 0)
                                (do
                                  (web-emit-machine! (mut b) n (load first?))
                                  (set! (mut first?) false)
                                  0)
                                0)
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (match (enc-layout-jump-at (load block-index))
                  (Some [jump]
                        (if (> (enc-op-length jump) 0)
                            (do
                              (web-emit-machine! (mut b) jump (load first?))
                              (set! (mut first?) false)
                              0)
                            0))
                  (None [] 0))
                (set! (mut block-index) (+ (load block-index) 1))
                (continue))))
    0))

(defn web-graph-json-status [(root (dyn NodeOps))
                            (phase (slice u8))
                            (status (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        (mut b) (sb-new a)
        (mut all) (dot-find-all root)
        (mut i) 0]
    (sb-push-str! (mut b) "{\"phase\":")
    (web-json-string! (mut b) phase)
    (sb-push-str! (mut b) ",\"status\":")
    (web-json-string! (mut b) status)
    (sb-push-str! (mut b) ",\"root\":")
    (sb-push-i64! (mut b) (n-nid root))
    (sb-push-str! (mut b) ",\"nodes\":[")
    (loop (if (>= (load i) (len (load all)))
              (break 0)
              (do
                (web-emit-node! (mut b) (get (load all) (load i)) (= (load i) 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (sb-push-str! (mut b) "],\"edges\":[")
    (set! (mut i) 0)
    (let [(mut first?) true]
      (loop (if (>= (load i) (len (load all)))
                (break 0)
                (let [n (get (load all) (load i)) (mut j) 0]
                  (loop (if (>= (load j) (n-nins n))
                            (break 0)
                            (do
                              (match (n-in n (load j))
                                (Some [def]
                                  (do
                                    (web-emit-edge! (mut b) n def (load j) (load first?))
                                    (set! (mut first?) false)))
                                (None [] 0))
                              (set! (mut j) (+ (load j) 1))
                              (continue))))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (sb-push-str! (mut b) "],\"machine\":[")
    (if (>= (code-phase) PHASE-ENCODING) (web-emit-machine-array! (mut b)) 0)
    (sb-push-str! (mut b) "]}")
    (al-free! [(dyn NodeOps)] (mut all))
    (sb-finish! (mut b))))

(defn web-graph-json [(root (dyn NodeOps)) (phase (slice u8))] (-> (slice u8))
  (web-graph-json-status root phase "complete"))
