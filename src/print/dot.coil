;; Graphviz output — a port of Simple's final `print/GraphVisualizer.java`.

;;
;; Simple walks both inputs and outputs because the ideal graph is cyclic, emits every node, then
;; emits use-to-def edges. Control nodes are yellow boxes, Phis are pale-yellow ellipses, control
;; edges are red, and a Phi's edge to its Region is dotted. Input indices remain visible as tail
;; labels, which is essential when inspecting Region/Phi lockstep. Simple folds projections into
;; HTML-table ports on Multi nodes; this port keeps projections explicit, preserving the complete
;; graph without requiring node-family-specific output enumeration.
;;
;; `dot-graph` returns an owning byte slice allocated by the malloc allocator. The caller owns it.
(module aot.print.dot)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-push-byte! sb-push-i64! sb-finish!])
(import "aot.node.node" :use *)

(defn dot-control-op? [(op i64)] (-> bool)
  (or (= op OP-START)
      (= op OP-STOP)
      (= op OP-RETURN)
      (= op OP-REGION)
      (= op OP-LOOP)
      (= op OP-IF)
      (= op OP-CPROJ)
      (= op OP-NEVER)
      (= op OP-XCTRL)
      (= op OP-FUN)))

(defn dot-append-node-id! [(b (mut StrBuf)) (n (dyn NodeOps))] (-> i64)
  (do (sb-push-byte! (mut b) (cast u8 110)) (sb-push-i64! (mut b) (n-nid n))))

(defn dot-append-escaped! [(b (mut StrBuf)) (s (slice u8))] (-> i64)
  (let [cnt (len s)
        (mut i) 0]
    (loop (if (>= (load i) cnt)
              (break 0)
              (let [c (get s (load i))]
                (if (= c (cast u8 34))
                    (sb-push-str! (mut b) "\\\"")
                    (if (= c (cast u8 92))
                        (sb-push-str! (mut b) "\\\\")
                        (if (= c (cast u8 10))
                            (sb-push-str! (mut b) "\\n")
                            (sb-push-byte! (mut b) c))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

(defn dot-push-if-new! [(all (mut (ArrayList (dyn NodeOps))))
                        (seen (mut (ArrayList i64)))
                        (n (dyn NodeOps))] (-> i64)
  (let [id (n-nid n)]
    (if (= (get (load seen) id) 0)
        (do (set! (mut seen) id 1) (push! (mut all) n) 0)
        0)))

(defn dot-find-all [(root (dyn NodeOps))] (-> (ArrayList (dyn NodeOps)))
  (let [a (alloc/malloc-allocator)
        (mut all) (al-new [(dyn NodeOps)] a)
        (mut seen) (al-new [i64] a)
        limit (arena-node-count)
        (mut id) 0
        (mut at) 0]
    (loop (if (> (load id) limit)
              (break 0)
              (do (push! [i64] (mut seen) 0) (set! (mut id) (+ (load id) 1)) (continue))))
    (dot-push-if-new! (mut all) (mut seen) root)
    (loop (if (>= (load at) (len (load all)))
              (break 0)
              (let [n (get (load all) (load at))
                    (mut i) 0]
                (loop (if (>= (load i) (n-nins n))
                          (break 0)
                          (do
                            (match (n-in n (load i))
                              (Some [v] (dot-push-if-new! (mut all) (mut seen) v))
                              (None [] 0))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (set! (mut i) 0)
                (loop (if (>= (load i) (n-nouts n))
                          (break 0)
                          (do
                            (match (n-out n (load i))
                              (Some [v] (dot-push-if-new! (mut all) (mut seen) v))
                              (None [] 0))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (set! (mut at) (+ (load at) 1))
                (continue))))
    (al-free! [i64] (mut seen))
    (load all)))

(defn dot-emit-node! [(b (mut StrBuf)) (n (dyn NodeOps)) (root (dyn NodeOps))] (-> i64)
  (do
    (sb-push-str! (mut b) "    ")
    (dot-append-node-id! (mut b) n)
    (sb-push-str! (mut b) " [label=\"")
    (dot-append-escaped! (mut b) (label n))
    (sb-push-str! (mut b) " #")
    (sb-push-i64! (mut b) (n-nid n))
    (sb-push-str! (mut b) "\"")
    (if (dot-control-op? (n-op n))
        (sb-push-str! (mut b) " shape=box style=filled fillcolor=gold")
        (if (or (= (n-op n) OP-PHI) (= (n-op n) OP-PARM))
            (sb-push-str! (mut b) " style=filled fillcolor=lightyellow")
            0))
    (if (n-same? n root) (sb-push-str! (mut b) " penwidth=3 color=darkgreen") 0)
    (sb-push-str! (mut b) "];\n")
    0))

(defn dot-emit-edge! [(b (mut StrBuf)) (use (dyn NodeOps)) (def (dyn NodeOps)) (idx i64)] (-> i64)
  (do
    (sb-push-str! (mut b) "    ")
    (dot-append-node-id! (mut b) use)
    (sb-push-str! (mut b) " -> ")
    (dot-append-node-id! (mut b) def)
    (sb-push-str! (mut b) " [taillabel=\"")
    (sb-push-i64! (mut b) idx)
    (sb-push-str! (mut b) "\"")
    (if (and (or (= (n-op use) OP-PHI) (= (n-op use) OP-PARM))
             (or (= (n-op def) OP-REGION) (= (n-op def) OP-FUN)))
        (sb-push-str! (mut b) " style=dotted")
        (if (dot-control-op? (n-op def)) (sb-push-str! (mut b) " color=red") 0))
    (if (and (= idx 2) (or (= (n-op use) OP-PHI) (= (n-op use) OP-LOOP)))
        (sb-push-str! (mut b) " constraint=false")
        0)
    (sb-push-str! (mut b) "];\n")
    0))

(defn dot-graph [(root (dyn NodeOps))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        (mut b) (sb-new a)
        (mut all) (dot-find-all root)
        cnt (len (load all))
        (mut i) 0]
    (sb-push-str! (mut b) "digraph ideal_graph {\n")
    (sb-push-str! (mut b) "    rankdir=BT;\n")
    (sb-push-str! (mut b) "    concentrate=true;\n")
    (sb-push-str! (mut b) "    node [fontname=Helvetica];\n")
    (sb-push-str! (mut b) "    edge [fontname=Helvetica fontsize=8];\n")
    (loop (if (>= (load i) cnt)
              (break 0)
              (do
                (dot-emit-node! (mut b) (get (load all) (load i)) root)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 0)
    (loop (if (>= (load i) cnt)
              (break 0)
              (let [n (get (load all) (load i))
                    (mut j) 0]
                (loop (if (>= (load j) (n-nins n))
                          (break 0)
                          (do
                            (match (n-in n (load j))
                              (Some [def] (dot-emit-edge! (mut b) n def (load j)))
                              (None [] 0))
                            (set! (mut j) (+ (load j) 1))
                            (continue))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (sb-push-str! (mut b) "}\n")
    (al-free! [(dyn NodeOps)] (mut all))
    (sb-finish! (mut b))))
