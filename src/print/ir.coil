;; The IR pretty printer: what you read in a debugger and in a failing test.

;;
;; It must be ROBUST ON A BROKEN GRAPH. The graphs most worth printing are the corrupt ones, so
;; every walk is depth-bounded, every visit is id-tracked, and a dead node prints as `DEAD` rather
;; than following its cleared inputs into a crash.
;;
;; It must also PRINT DEAD NODES. A printer that omits them makes a graph with a deleted arm merely
;; look smaller, which is exactly how a whole deleted program reads as a clean short graph.
(module aot.print.ir)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-str])
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(defn print-node [(n (dyn NodeOps))] (-> (slice u8))
  (n-text n))

(defn print--walk! [(b (mut StrBuf)) (n (dyn NodeOps)) (depth i64) (seen (mut (ArrayList bool)))] (-> i64)
  (let [id (n-nid n)]
    (if (or (< depth 0) (>= id (len (load seen))) (get (load seen) id))
        0
        (do
          (set! (mut seen) id true)
          (n-text-into! (mut b) n)
          (sb-push-str! (mut b) "\n")
          (if (n-dead? n)
              0
              (let [(mut i) 0]
                (loop (if (>= (load i) (n-nins n))
                          (break 0)
                          (do
                            (match (n-in n (load i))
                              (Some [v] (print--walk! (mut b) v (- depth 1) (mut seen)))
                              (None [] 0))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))))
          0))))

;; The root and its input cone to `depth` levels, each node once, dead nodes included.
(defn print-graph [(root (dyn NodeOps)) (depth i64)] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        (mut b) (sb-new a)
        (mut seen) (al-new [bool] a)
        (mut i) 0]
    (loop (if (> (load i) (arena-node-count))
              (break 0)
              (do (push! [bool] (mut seen) false) (set! (mut i) (+ (load i) 1)) (continue))))
    (print--walk! (mut b) root depth (mut seen))
    (al-free! [bool] (mut seen))
    (sb-str (mut b))))
