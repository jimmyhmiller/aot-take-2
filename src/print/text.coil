;; The round-trippable textual form of a graph and of a type.

;;
;; `print` then `parse` is the identity, and that is a TESTED claim with a COUNTED FLOOR under it:
;; the test records how many node lines and how many characters it compared. Without the floor, a
;; printer that emitted only opcode names would pass "round-trips cleanly" perfectly.
;;
;; What this buys, and why it is infrastructure rather than a convenience:
;;
;;   - a graph can be written by hand, so IR work does not wait on the frontend
;;   - a golden test is a readable diff instead of an opaque blob
;;   - every phase gets `--dump-after` for free
;;   - a reduced reproduction of an optimiser bug can be FILED, which is otherwise impractical
;;
;; The type notation has exactly one definition, here, and JSL's annotations parse with it — so the
;; two cannot drift.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S1.
(module aot.print.text)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(defn ty-print [(t i64)] (-> (slice u8))
  (do (unimplemented "ty-print" "S1 — src/print/text.coil") ""))

(defn ty-parse [(s (slice u8))] (-> i64)
  (do (unimplemented "ty-parse" "S1 — src/print/text.coil") 0))

(defn graph-print [(root (dyn NodeOps))] (-> (slice u8))
  (do (unimplemented "graph-print" "S1 — src/print/text.coil") ""))

(defn graph-parse [(s (slice u8))] (-> (dyn NodeOps))
  (do (unimplemented "graph-parse" "S1 — src/print/text.coil") (unreachable-node)))
