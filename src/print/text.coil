;; The textual form of a graph and of a type.

;;
;; `graph-print` writes one line per node reachable from the root, in node-id order, using
;; `n-text`: `#nid Label :type <- inputs @block`. `ty-print` is the one type notation (see
;; `ty-text` in `aot.type.type`). The parsers that make this round-trippable remain unimplemented
;; and say so; until they exist a golden test compares printed text, not reconstructed graphs.
;;
;; What the printer buys: a readable diff in a failing test, a `dump` after any phase, and a
;; reduced reproduction of an optimizer bug that can be filed as text.
(module aot.print.text)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-str])
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.type.type" :use *)
(import "aot.print.dot" :use *)

(defn ty-print [(t i64)] (-> (slice u8))
  (ty-text t))

(defn ty-parse [(s (slice u8))] (-> i64)
  (do (unimplemented "ty-parse" "S1 — src/print/text.coil") 0))

;; Every node reachable from `root` through inputs and outputs, one per line, by node id.
(defn graph-print [(root (dyn NodeOps))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        (mut b) (sb-new a)
        (mut all) (dot-find-all root)
        (mut ids) (al-new [i64] a)
        (mut i) 0]
    (al-for [n (load all)] (push! [i64] (mut ids) (n-nid n)))
    ;; Insertion sort by id: dumps are small and stable ordering matters more than speed.
    (loop (if (>= (load i) (len (load ids)))
              (break 0)
              (let [(mut j) (load i)]
                (loop (if (or (= (load j) 0) (<= (get (load ids) (- (load j) 1)) (get (load ids) (load j))))
                          (break 0)
                          (let [tmp (get (load ids) (load j))]
                            (set! (mut ids) (load j) (get (load ids) (- (load j) 1)))
                            (set! (mut ids) (- (load j) 1) tmp)
                            (set! (mut j) (- (load j) 1))
                            (continue))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (al-for [id (load ids)]
            (match (arena-node id)
              (Some [n] (do (n-text-into! (mut b) n) (sb-push-str! (mut b) "\n") 0))
              (None [] 0)))
    (al-free! [i64] (mut ids))
    (al-free! [(dyn NodeOps)] (mut all))
    (sb-str (mut b))))

(defn graph-parse [(s (slice u8))] (-> (dyn NodeOps))
  (do (unimplemented "graph-parse" "S1 — src/print/text.coil") (unreachable-node)))
