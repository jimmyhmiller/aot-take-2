;; The .jsl reader.

;;
;; JSL is s-expressions, read with Coil's bundled `coil.reader`: `[...]` for parameter lists and
;; `let` bindings, `:keyword` for options, `"..."` for strings, `;` for comments. Choosing
;; s-expressions costs approximately zero parser work, which is the point — effort belongs in the
;; IR, not in a second grammar.
;;
;; Two properties shape everything downstream:
;;
;;   A TYPE ANNOTATION IS A SYMBOL OR A STRING. `dyn` and `int=0` are legal bare; anything
;;   containing a bracket or a space is written `"int=[0..9]"`. Both go to the same type parser, so
;;   the type notation has exactly ONE definition and JSL cannot drift from the printed form.
;;
;;   A QUOTED TOKEN IS A TYPE in `:params`/`:ret` and A STRING LITERAL everywhere else. The two
;;   positions never overlap, so nothing is ambiguous.
;;
;; Index loading is deliberately line-oriented: ordering is semantic, comments are trivia, and a
;; missing entry is fatal. The reader retains every file buffer because Sexp symbols slice it.
(module aot.jsl.reader)
(import "aot.util.arena"
        :use
        [compiler-allocator
         compiler-state
         CompilerStateSlot
         CompilerRegion
         compiler-region-clear!])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.reader" :as rd)
(import "coil.fs" :as fs)
(import "coil.mem" :as mem)
(import "coil.slice" :use *)
(import "aot.util.panic" :use *)

(const JSL-COMPILER-INDEX "jsl/compiler/index")

(defstruct JslUnit
  [(forms (ptr (ArrayList rd/Sexp)))
   (source (slice u8))
   (path (slice u8))])

(defstruct JslStore [(units (ArrayList JslUnit)) (booted bool)])

;; One immutable library snapshot, owned independently of compilation scratch. No graph nodes,
;; interned type/shape IDs, or whole-program assumptions cross this boundary. The exact index
;; bytes and every indexed source are compared on reuse; paths and order are part of the key.
;; Only the production library loader uses this cache; ad-hoc reader/checker clients stay local.
(defstruct JslLibrary
  [(units (ArrayList JslUnit))
   (index (slice u8))
   (path (slice u8))
   (loaded bool)
   (checked bool)
   (building bool)
   (hits i64)
   (misses i64)])

(defn jsl-library [] (-> (ptr JslLibrary))
  (primitive/alloc-static JslLibrary))

(defn jsl-library-region [] (-> (ptr CompilerRegion))
  (primitive/alloc-static CompilerRegion))

(defn jsl-reader-allocator [] (-> (dyn alloc/Allocator))
  (if (.building (jsl-library))
      (primitive/make-dyn alloc/Allocator (jsl-library-region))
      (compiler-allocator)))

(defn jsl-store [] (-> (ptr JslStore))
  (compiler-state [JslStore] (primitive/alloc-static CompilerStateSlot)))

(defn jsl-store-boot! [] (-> i64)
  (let [s (jsl-store)]
    (if (.booted s)
        0
        (do
          (set! (.units s) (al-new [JslUnit] (compiler-allocator)))
          (set! (.booted s) true)
          0))))

(defn jsl-reset! [] (-> i64)
  (do
    (jsl-store-boot!)
    (al-clear! [JslUnit] (mut (.units (jsl-store))))
    0))

(defn jsl-unit-new [(forms (ptr (ArrayList rd/Sexp)))
                    (source (slice u8))
                    (path (slice u8))] (-> JslUnit)
  (JslUnit
    :forms forms
    :source source
    :path path))

;; Read one already-owned source buffer. The store retains the buffer because Sexp symbol slices
;; point into it. Unit ids are one-based so zero remains an invalid/missing handle.
(defn jsl-read-source! [(source (slice u8)) (path (slice u8))] (-> i64)
  (do
    (jsl-store-boot!)
    (match (rd/read-all (jsl-reader-allocator) source 0)
      (Err [d]
           (let [diag d]
             (do
               (panic-i "jsl-read-source!: reader error at byte" (.lo diag))
               0)))
      (Ok [forms]
          (do
            (push! [JslUnit]
                   (mut (.units (jsl-store)))
                   (jsl-unit-new forms source path))
            (len (.units (jsl-store))))))))

(defn jsl-read-file [(path (slice u8))] (-> i64)
  (try (let [source
               (try-or! (fs/read-file (jsl-reader-allocator) path)
                        (do (panic "jsl-read-file: cannot read file") 0))]
         (jsl-read-source! source path))))

(defn jsl-unit [(unit i64)] (-> (ptr JslUnit))
  (do
    (jsl-store-boot!)
    (if (or (<= unit 0) (> unit (len (.units (jsl-store)))))
        (do
          (panic-i "jsl-unit: invalid unit id" unit)
          (al-elem [JslUnit] (mut (.units (jsl-store))) 0))
        (al-elem [JslUnit] (mut (.units (jsl-store))) (- unit 1)))))

(defn jsl-form-count [(unit i64)] (-> i64)
  (len (load (.forms (jsl-unit unit)))))

(defn jsl-unit-count [] (-> i64)
  (len (.units (jsl-store))))

(defn jsl-form [(unit i64) (i i64)] (-> (ptr rd/Sexp))
  (al-elem [rd/Sexp] (.forms (jsl-unit unit)) i))

(defn jsl-form-option [(form (ptr rd/Sexp)) (key (slice u8))] (-> i64)
  (let [(mut i) 2]
    (loop (if (>= (+ (load i) 1) (rd/sexp-count form))
              (break -1)
              (let [candidate (rd/sexp-nth form (load i))]
                (if (and (rd/sexp-kw? candidate) (= (rd/sexp-kw candidate) key))
                    (break (+ (load i) 1))
                    (do (set! (mut i) (+ (load i) 2)) (continue))))))))

(defn jsl-form-required-option [(form (ptr rd/Sexp)) (key (slice u8))] (-> (ptr rd/Sexp))
  (let [index (jsl-form-option form key)]
    (if (< index 0)
        (do (panic "jsl-form-required-option: missing declaration option") form)
        (rd/sexp-nth form index))))

(defn jsl-form-params [(form (ptr rd/Sexp))] (-> (ptr rd/Sexp))
  (jsl-form-required-option form "params"))

(defn jsl-form-ret [(form (ptr rd/Sexp))] (-> (ptr rd/Sexp))
  (jsl-form-required-option form "ret"))

(defn jsl-form-body [(form (ptr rd/Sexp))] (-> (ptr rd/Sexp))
  (rd/sexp-nth form (- (rd/sexp-count form) 1)))

(defn jsl-form-transitioning? [(form (ptr rd/Sexp))] (-> bool)
  (let [index (jsl-form-option form "transitioning")]
    (and (>= index 0) (rd/sexp-sym-is (rd/sexp-nth form index) "true"))))

;; `:throws true`: the definition may complete abruptly. Its result is then a completion — a
;; JavaScript value or the exception sentinel — and every caller must test it before using it
;; (`%IsException`); the checker infers the property from the body and refuses a body that throws
;; without declaring it, exactly as it does for `:transitioning`.
(defn jsl-form-throws? [(form (ptr rd/Sexp))] (-> bool)
  (let [index (jsl-form-option form "throws")]
    (and (>= index 0) (rd/sexp-sym-is (rd/sexp-nth form index) "true"))))

(defn jsl-throws? [(name (slice u8))] (-> bool)
  (match (jsl-definition-form name)
    (Some [form] (jsl-form-throws? form))
    (None [] false)))

;; `:noinline true`: a cold builtin (a throw path) that every call site shares out of line.
(defn jsl-form-noinline? [(form (ptr rd/Sexp))] (-> bool)
  (let [index (jsl-form-option form "noinline")]
    (and (>= index 0) (rd/sexp-sym-is (rd/sexp-nth form index) "true"))))

(defn jsl-noinline? [(name (slice u8))] (-> bool)
  (match (jsl-definition-form name)
    (Some [form] (jsl-form-noinline? form))
    (None [] false)))

(defn jsl-form-macro? [(form (ptr rd/Sexp))] (-> bool)
  (and (rd/sexp-list? form)
       (> (rd/sexp-count form) 0)
       (rd/sexp-sym-is (rd/sexp-nth form 0) "macro")))

(defn jsl-form-builtin? [(form (ptr rd/Sexp))] (-> bool)
  (and (rd/sexp-list? form)
       (> (rd/sexp-count form) 0)
       (rd/sexp-sym-is (rd/sexp-nth form 0) "builtin")))

;; A named definition (`builtin` or `macro`), as opposed to a declaration form (`intrinsic`).
(defn jsl-form-definition? [(form (ptr rd/Sexp))] (-> bool)
  (or (jsl-form-builtin? form) (jsl-form-macro? form)))

;; Resolve declaration names across every unit already read from the index. JSL permits forward
;; references, so checking and lowering consult the whole loaded table rather than file order.
(defn jsl-definition-form [(name (slice u8))] (-> (Option (ptr rd/Sexp)))
  (let [(mut unit) 1]
    (loop (if (> (load unit) (jsl-unit-count))
              (break (None [(ptr rd/Sexp)]))
              (let [(mut i) 0
                    found
                      (loop (if (>= (load i) (jsl-form-count (load unit)))
                                (break -1)
                                (let [form (jsl-form (load unit) (load i))]
                                  (if (and (> (rd/sexp-count form) 3)
                                           (rd/sexp-sym? (rd/sexp-nth form 1))
                                           (= (rd/sexp-sym (rd/sexp-nth form 1))
                                              name)
                                           (jsl-form-definition? form))
                                      (break (load i))
                                      (do
                                        (set! (mut i) (+ (load i) 1))
                                        (continue))))))]
                (if (>= found 0)
                    (break (Some (jsl-form (load unit) found)))
                    (do (set! (mut unit) (+ (load unit) 1)) (continue))))))))

;; Count every loaded declaration spelling `name`. Resolution deliberately returns one declaration
;; for forward references, but the checker requires this count to be exactly one before lowering:
;; otherwise signature lookup can observe the first form while graph lookup observes a later form.
(defn jsl-definition-count [(name (slice u8))] (-> i64)
  (let [(mut unit) 1
        (mut count) 0]
    (loop (if (> (load unit) (jsl-unit-count))
              (break (load count))
              (let [(mut i) 0]
                (loop (if (>= (load i) (jsl-form-count (load unit)))
                          (break 0)
                          (let [form (jsl-form (load unit) (load i))]
                            (if (and (> (rd/sexp-count form) 1)
                                     (rd/sexp-sym? (rd/sexp-nth form 1))
                                     (= (rd/sexp-sym (rd/sexp-nth form 1)) name)
                                     ;; Compared last: the name almost never matches, and the kind is two symbol compares.
                                     (jsl-form-definition? form))
                                (set! (mut count) (+ (load count) 1))
                                0)
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (set! (mut unit) (+ (load unit) 1))
                (continue))))))

(defn jsl-definition-arity [(name (slice u8))] (-> i64)
  (match (jsl-definition-form name)
    (Some [form] (rd/sexp-count (jsl-form-params form)))
    (None [] -1)))

;; Does builtin `name` take the whole callable ABI (aot.codegen.callabi) as its parameters —
;; (callee this new.target count vector a0 a1 a2), the count and vector by their ABI kinds? Such a
;; builtin is a function object's code directly, through an adapter that forwards every operand.
(defn jsl-definition-abi? [(name (slice u8))] (-> bool)
  (match (jsl-definition-form name)
    (Some [form]
          (let [params (jsl-form-params form)]
            (and (not (jsl-form-macro? form))
                 (= (rd/sexp-count params) 8)
                 (rd/sexp-sym-is (rd/sexp-nth (rd/sexp-nth params 3) 1)
                                 "argument-count")
                 (rd/sexp-sym-is (rd/sexp-nth (rd/sexp-nth params 4) 1)
                                 "argument-vector"))))
    (None [] false)))

;; Load every unit named by `jsl/index`, IN ORDER.
;;
;; The order is part of the format: a declaration's position in the index becomes its closed-world
;; function index, which appears in every printed graph and every golden hash. A missing or
;; misordered entry is a hard error, never a skip — skipping would silently renumber everything
;; below it.
(defn jsl-load-index! [(path (slice u8))] (-> i64)
  (try (let [source
               (try-or! (fs/read-file (jsl-reader-allocator) path)
                        (do (panic "jsl-load-index!: cannot read index") 0))]
         (jsl-load-index-source! source))))

(defn jsl-load-index-source! [(source (slice u8))] (-> i64)
  (let [n (len source)
        (mut lo) 0
        (mut loaded) 0]
    (loop (if (> (load lo) n)
              (break 0)
              (let [(mut hi) (load lo)]
                (loop (if (or (>= (load hi) n)
                              (= (get source (load hi)) (cast u8 10)))
                          (break 0)
                          (do (set! (mut hi) (+ (load hi) 1)) (continue))))
                (let [(mut first) (load lo)
                      (mut last) (load hi)]
                  (loop (if (and (< (load first) (load last))
                                 (let [c (get source (load first))]
                                   (or (= c (cast u8 32))
                                       (= c (cast u8 9))
                                       (= c (cast u8 13)))))
                            (do
                              (set! (mut first) (+ (load first) 1))
                              (continue))
                            (break 0)))
                  (loop (if (and (> (load last) (load first))
                                 (let [c (get source (- (load last) 1))]
                                   (or (= c (cast u8 32))
                                       (= c (cast u8 9))
                                       (= c (cast u8 13)))))
                            (do (set! (mut last) (- (load last) 1)) (continue))
                            (break 0)))
                  (if (and (< (load first) (load last))
                           (!= (get source (load first)) (cast u8 35)))
                      (do
                        (jsl-read-file (subslice [u8]
                                                 source
                                                 (load first)
                                                 (load last)))
                        (set! (mut loaded) (+ (load loaded) 1)))
                      0))
                (if (>= (load hi) n)
                    (break 0)
                    (do (set! (mut lo) (+ (load hi) 1)) (continue))))))
    (load loaded)))

;; The checker has no side effects on the forms: its result depends only on this entire table and
;; this compiler's primitive/type-family rules. Its successful result is cached only for an exact
;; table match. The executable itself fixes the checker version; this is not a disk cache.
(defn jsl-load-library! [(path (slice u8))] (-> i64)
  (let [cache (jsl-library)
        a (compiler-allocator)
        index
          (try (try-or! (fs/read-file a path)
                        (do (panic "jsl-load-library!: cannot read index") "")))
        (mut same)
          (and (.loaded cache) (= (.path cache) path) (= (.index cache) index))]
    (if (load same)
        (al-for [item (.units cache)]
                (let [unit item
                      source
                        (try (try-or! (fs/read-file a (.path unit))
                                      (do
                                        (panic "jsl-load-library!: cannot read unit")
                                        "")))]
                  (if (!= source (.source unit)) (set! (mut same) false) 0)
                  (alloc/free [u8] a source)))
        0)
    (jsl-reset!)
    (if (load same)
        (do
          (al-for [unit (.units cache)]
                  (push! [JslUnit] (mut (.units (jsl-store))) unit))
          (set! (.hits cache) (+ (.hits cache) 1)))
        (do
          (compiler-region-clear! (jsl-library-region))
          (set! (.loaded cache) false)
          (set! (.checked cache) false)
          (set! (.building cache) true)
          (let [owned (jsl-reader-allocator)]
            (set! (.index cache) (jsl-library-copy index))
            (set! (.path cache) (jsl-library-copy path))
            (jsl-load-index-source! (.index cache))
            (set! (.units cache) (al-new [JslUnit] owned))
            (al-for [unit (.units (jsl-store))]
                    (push! [JslUnit] (mut (.units cache)) unit)))
          (set! (.building cache) false)
          (set! (.loaded cache) true)
          (set! (.misses cache) (+ (.misses cache) 1))))
    (alloc/free [u8] a index)
    (jsl-unit-count)))

(defn jsl-library-clear! [] (-> i64)
  (jsl-reset!)
  (compiler-region-clear! (jsl-library-region))
  (set! (jsl-library) (primitive/zeroed JslLibrary))
  0)

(defn jsl-library-copy [(bytes (slice u8))] (-> (slice u8))
  (let [copy
          (match (alloc/alloc [u8] (jsl-reader-allocator) (len bytes))
            (Some [s] s)
            (None [] (do (panic "jsl-library: allocation failed") "")))]
    (mem/mem-copy [u8] (slice-data copy) (slice-data bytes) (len bytes))
    copy))
