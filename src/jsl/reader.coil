;; The .jsl reader.

;;
;; JSL is s-expressions, read with Coil's bundled `coil.reader`: `[...]` for parameter lists and
;; `let` bindings, `:keyword` for options, `"..."` for strings, `;` for comments. Choosing
;; s-expressions costs approximately zero parser work, which is the point — effort belongs in the
;; IR, not in a second grammar.
;;
;; Two properties shape everything downstream:
;;
;;   A TYPE ANNOTATION IS A SYMBOL OR A STRING. `dyn` and `int=0` are legal bare; anything
;;   containing a bracket or a space is written `"int=[0..9]"`. Both go to the same type parser, so
;;   the type notation has exactly ONE definition and JSL cannot drift from the printed form.
;;
;;   A QUOTED TOKEN IS A TYPE in `:params`/`:ret` and A STRING LITERAL everywhere else. The two
;;   positions never overlap, so nothing is ambiguous.
;;
;; Index loading is deliberately line-oriented: ordering is semantic, comments are trivia, and a
;; missing entry is fatal. The reader retains every file buffer because Sexp symbols slice it.
(module aot.jsl.reader)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.reader" :as rd)
(import "coil.fs" :as fs)
(import "coil.slice" :use *)
(import "aot.util.panic" :use *)

(defstruct JslUnit
  [(forms (ptr (ArrayList rd/Sexp)))
   (source (slice u8))
   (path (slice u8))])

(defstruct JslStore [(units (ArrayList JslUnit)) (booted bool)])

(defn jsl-store [] (-> (ptr JslStore))
  (primitive/alloc-static JslStore))

(defn jsl-store-boot! [] (-> i64)
  (let [s (jsl-store)]
    (if (.booted s)
        0
        (do
          (set! (.units s) (al-new [JslUnit] (alloc/malloc-allocator)))
          (set! (.booted s) true)
          0))))

(defn jsl-reset! [] (-> i64)
  (do
    (jsl-store-boot!)
    (al-clear! [JslUnit] (mut (.units (jsl-store))))
    0))

(defn jsl-unit-new [(forms (ptr (ArrayList rd/Sexp)))
                    (source (slice u8))
                    (path (slice u8))] (-> JslUnit)
  (let [(mut u) (primitive/zeroed JslUnit)]
    (set! (.forms (mut u)) forms)
    (set! (.source (mut u)) source)
    (set! (.path (mut u)) path)
    (load u)))

;; Read one already-owned source buffer. The store retains the buffer because Sexp symbol slices
;; point into it. Unit ids are one-based so zero remains an invalid/missing handle.
(defn jsl-read-source! [(source (slice u8)) (path (slice u8))] (-> i64)
  (do
    (jsl-store-boot!)
    (match (rd/read-all (alloc/malloc-allocator) source 0)
      (Err [d]
           (let [diag d]
             (do (panic-i "jsl-read-source!: reader error at byte" (.lo diag)) 0)))
      (Ok [forms]
          (do
            (push! [JslUnit]
                   (mut (.units (jsl-store)))
                   (jsl-unit-new forms source path))
            (len (.units (jsl-store))))))))

(defn jsl-read-file [(path (slice u8))] (-> i64)
  (try (let [source
               (try-or! (fs/read-file (alloc/malloc-allocator) path)
                        (do (panic "jsl-read-file: cannot read file") 0))]
         (jsl-read-source! source path))))

(defn jsl-unit [(unit i64)] (-> (ptr JslUnit))
  (do
    (jsl-store-boot!)
    (if (or (<= unit 0) (> unit (len (.units (jsl-store)))))
        (do
          (panic-i "jsl-unit: invalid unit id" unit)
          (al-elem [JslUnit] (mut (.units (jsl-store))) 0))
        (al-elem [JslUnit] (mut (.units (jsl-store))) (- unit 1)))))

(defn jsl-form-count [(unit i64)] (-> i64)
  (len (load (.forms (jsl-unit unit)))))

(defn jsl-form [(unit i64) (i i64)] (-> (ptr rd/Sexp))
  (al-elem [rd/Sexp] (.forms (jsl-unit unit)) i))

;; Load every unit named by `jsl/index`, IN ORDER.
;;
;; The order is part of the format: a declaration's position in the index becomes its closed-world
;; function index, which appears in every printed graph and every golden hash. A missing or
;; misordered entry is a hard error, never a skip — skipping would silently renumber everything
;; below it.
(defn jsl-load-index! [(path (slice u8))] (-> i64)
  (try (let [source
               (try-or! (fs/read-file (alloc/malloc-allocator) path)
                        (do (panic "jsl-load-index!: cannot read index") 0))
             n (len source)
             (mut lo) 0
             (mut loaded) 0]
         (loop (if (> (load lo) n)
                   (break 0)
                   (let [(mut hi) (load lo)]
                     (loop (if (or (>= (load hi) n) (= (get source (load hi)) (cast u8 10)))
                               (break 0)
                               (do (set! (mut hi) (+ (load hi) 1)) (continue))))
                     (let [(mut first) (load lo)
                           (mut last) (load hi)]
                       (loop (if (and (< (load first) (load last))
                                      (let [c (get source (load first))]
                                        (or (= c (cast u8 32)) (= c (cast u8 9)) (= c (cast u8 13)))))
                                 (do (set! (mut first) (+ (load first) 1)) (continue))
                                 (break 0)))
                       (loop (if (and (> (load last) (load first))
                                      (let [c (get source (- (load last) 1))]
                                        (or (= c (cast u8 32)) (= c (cast u8 9)) (= c (cast u8 13)))))
                                 (do (set! (mut last) (- (load last) 1)) (continue))
                                 (break 0)))
                       (if (and (< (load first) (load last))
                                (!= (get source (load first)) (cast u8 35)))
                           (do
                             (jsl-read-file (subslice [u8] source (load first) (load last)))
                             (set! (mut loaded) (+ (load loaded) 1)))
                           0))
                     (if (>= (load hi) n)
                         (break 0)
                         (do (set! (mut lo) (+ (load hi) 1)) (continue))))))
         (load loaded))))
