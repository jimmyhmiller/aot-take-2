;; The JSL declaration forms that are not plain definitions.

;;
;; `(intrinsic %Name% ...)` declares one published global-object root and expands into one
;; demand-loadable builtin per property, so a program that never mentions `DataView` never
;; initialises it. This is a DECLARATION-LEVEL MACRO, and it exists to replace what would otherwise
;; be a JSON manifest plus a generator — which CLAUDE.md's second rule forbids and which
;; `jsl/intrinsics.jsl` says in its own header it replaced.
;;
;; `(internal-slot ...)` and `(slot-list ...)` pin the specification's internal-slot lists to
;; concrete object layouts. A layout must name its creation operation and match the exact
;; ECMA-262 shape, so adding support for a new exotic object extends the provenance check rather
;; than weakening it.
;;
;; `(internal-method ...)` and `(internal-method-family ...)` name the essential internal methods,
;; which is what lets a JSL definition ask "does this object use the ordinary [[Get]]" — the
;; question every fast path in the object model turns on.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S5.
(module aot.jsl.decls)
(import "aot.util.panic" :use *)

(defn jsl-read-intrinsic! [(form i64)] (-> i64)
  (do (unimplemented "jsl-read-intrinsic!" "S5 — src/jsl/decls.coil") 0))

(defn jsl-read-slot-list! [(form i64)] (-> i64)
  (do (unimplemented "jsl-read-slot-list!" "S5 — src/jsl/decls.coil") 0))

(defn jsl-read-internal-method! [(form i64)] (-> i64)
  (do (unimplemented "jsl-read-internal-method!" "S5 — src/jsl/decls.coil") 0))
