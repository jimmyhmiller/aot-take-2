;; Checking JSL expressions: admitted forms, then the type each one yields.

(module aot.jsl.check.expr)
(import "aot.util.arena" :use [compiler-allocator])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.reader" :as rd)
(import "coil.os" :as os)
(import "aot.jsl.reader" :use *)
(import "aot.jsl.prims" :use *)
(import "aot.type.type" :use *)
(import "aot.jsl.check" :use [jsl-refuse])
(import "aot.jsl.check.types" :use *)
(import "aot.jsl.check.primitive" :use *)

(defn jsl-check-expr-in [(x (ptr rd/Sexp))
                         (params (ptr rd/Sexp))
                         (locals (mut (ArrayList (slice u8))))] (-> i64)
  (if (or (rd/sexp-int? x) (rd/sexp-str? x))
      0
      (if (rd/sexp-sym? x)
          (if (or (jsl-symbol-in-params? params (rd/sexp-sym x))
                  (jsl-symbol-in-locals? (load locals) (rd/sexp-sym x)))
              0
              (jsl-refuse (rd/sexp-sym x) (.lo x) (.hi x)))
          (if (not (rd/sexp-list? x))
              (jsl-refuse "non-list expression" (.lo x) (.hi x))
              (if (= (rd/sexp-count x) 0)
                  (jsl-refuse "empty expression" (.lo x) (.hi x))
                  (let [head (rd/sexp-nth x 0)]
                    (if (not (rd/sexp-sym? head))
                        (jsl-refuse "non-symbol callee" (.lo head) (.hi head))
                        (let [name (rd/sexp-sym head)]
                          ;; (%CallFunction callee this arg...): a call into JavaScript from a
                          ;; body; up to four arguments, the ABI's slot ceiling for intrinsics.
                          (if (or (= name "%CallFunction")
                                  (= name "%CallFunctionPacked"))
                              (if (if (= name "%CallFunctionPacked")
                                      (!= (rd/sexp-count x) 9)
                                      (or (< (rd/sexp-count x) 3)
                                          (> (rd/sexp-count x) 7)))
                                  (jsl-refuse "%CallFunction arity"
                                              (.lo x)
                                              (.hi x))
                                  (let [(mut i) 1]
                                    (loop (if (>= (load i) (rd/sexp-count x))
                                              (break 0)
                                              (do
                                                (jsl-check-expr-in (rd/sexp-nth x
                                                                                (load i))
                                                                   params
                                                                   (mut locals))
                                                (set! (mut i) (+ (load i) 1))
                                                (continue))))))
                              (if (= name "if")
                                  (if (!= (rd/sexp-count x) 4)
                                      (jsl-refuse "if arity" (.lo x) (.hi x))
                                      (do
                                        (jsl-check-expr-in (rd/sexp-nth x 1)
                                                           params
                                                           (mut locals))
                                        (jsl-check-expr-in (rd/sexp-nth x 2)
                                                           params
                                                           (mut locals))
                                        (jsl-check-expr-in (rd/sexp-nth x 3)
                                                           params
                                                           (mut locals))))
                                  (if (= name "let")
                                      (if (!= (rd/sexp-count x) 3)
                                          (jsl-refuse "let arity"
                                                      (.lo x)
                                                      (.hi x))
                                          (let [bindings (rd/sexp-nth x 1)
                                                base (len (load locals))]
                                            (if (not (rd/sexp-vec? bindings))
                                                (jsl-refuse "let bindings"
                                                            (.lo bindings)
                                                            (.hi bindings))
                                                0)
                                            (let [(mut i) 0]
                                              (loop (if (>= (load i)
                                                            (rd/sexp-count bindings))
                                                        (break 0)
                                                        (let [binding
                                                                (rd/sexp-nth bindings
                                                                             (load i))]
                                                          (if (not (and (rd/sexp-list? binding)
                                                                        (= (rd/sexp-count binding)
                                                                           2)))
                                                              (jsl-refuse "let binding"
                                                                          (.lo binding)
                                                                          (.hi binding))
                                                              0)
                                                          (let [local
                                                                  (rd/sexp-nth binding
                                                                               0)]
                                                            (if (not (rd/sexp-sym? local))
                                                                (jsl-refuse "let name"
                                                                            (.lo local)
                                                                            (.hi local))
                                                                0)
                                                            (jsl-check-expr-in (rd/sexp-nth binding
                                                                                            1)
                                                                               params
                                                                               (mut locals))
                                                            (push! [(slice u8)]
                                                                   (mut locals)
                                                                   (rd/sexp-sym local)))
                                                          (set! (mut i)
                                                                (+ (load i) 1))
                                                          (continue))))
                                              (jsl-check-expr-in (rd/sexp-nth x
                                                                              2)
                                                                 params
                                                                 (mut locals))
                                              (loop (if (<= (len (load locals))
                                                            base)
                                                        (break 0)
                                                        (do
                                                          (pop! (mut locals))
                                                          (continue))))
                                              0)))
                                      (let [expected
                                              (if (or (= name "%NewObject")
                                                      (= name "%Undefined")
                                                      (= name "%Null")
                                                      (= name "%GlobalObject"))
                                                  1
                                                  (if (or (= name "%Sub")
                                                          (= name "%Add")
                                                          (= name "%Mul")
                                                          (= name "%Div")
                                                          (= name "%Eq")
                                                          (= name "%SameBits")
                                                          (= name "%Ne")
                                                          (= name "%Lt")
                                                          (= name "%Le")
                                                          (= name "%And"))
                                                      3
                                                      (if (or (= name
                                                                 "%NewObjectWithShape")
                                                              (= name "%Box")
                                                              (= name "%BoxInt")
                                                              (= name
                                                                 "%BoxBool")
                                                              (= name "%Not")
                                                              (= name "%Neg")
                                                              (= name
                                                                 "%UnboxInt")
                                                              (= name
                                                                 "%UnboxBool")
                                                              (= name
                                                                 "%UnboxFlt")
                                                              (= name
                                                                 "%UnboxNumber")
                                                              (= name
                                                                 "%UnboxString")
                                                              (= name
                                                                 "%UnboxObject")
                                                              (= name
                                                                 "%UnboxObjectLike")
                                                              (= name
                                                                 "%SetPendingException")
                                                              (= name
                                                                 "%PropertyKey")
                                                              (= name
                                                                 "%WellKnownKey")
                                                              (= name
                                                                 "%InternalKey")
                                                              (= name
                                                                 "%IntrinsicPrototype")
                                                              (= name
                                                                 "%StringLength")
                                                              (= name
                                                                 "%GetObjectPrototype")
                                                              (= name
                                                                 "%ToFloat")
                                                              (= name
                                                                 "%ToInteger")
                                                              (= name "%IsInt")
                                                              (= name
                                                                 "%IsNumber")
                                                              (= name "%IsFlt")
                                                              (= name
                                                                 "%IsString")
                                                              (= name "%IsBool")
                                                              (= name "%IsNull")
                                                              (= name
                                                                 "%IsUndefined")
                                                              (= name
                                                                 "%IsSymbol")
                                                              (= name
                                                                 "%IsObject")
                                                              (= name
                                                                 "%IsObjectLike")
                                                              (= name
                                                                 "%IsFunction")
                                                              (= name
                                                                 "%IsException")
                                                              (= name
                                                                 "%IsArray")
                                                              (= name
                                                                 "%UnboxArray")
                                                              (= name
                                                                 "%UnboxSymbol")
                                                              (= name
                                                                 "%FunctionFlags")
                                                              (= name
                                                                 "%ClosureEnv")
                                                              (= name
                                                                 "%ArgumentCountInt")
                                                              (= name
                                                                 "%ArrayArgumentCount")
                                                              (= name
                                                                 "%ArrayLen"))
                                                          2
                                                          (if (or (= name
                                                                     "%PropLoadOwnNamed")
                                                                  (= name
                                                                     "%PropHasOwnNamed")
                                                                  (= name
                                                                     "%PropAttrsOwn")
                                                                  (= name
                                                                     "%PropChainHolder")
                                                                  (= name
                                                                     "%PropGetNamed")
                                                                  (= name
                                                                     "%ArgumentAt")
                                                                  (= name
                                                                     "%SetObjectPrototype"))
                                                              3
                                                              (if (or (= name
                                                                         "%PropStoreOwnNamed")
                                                                      (= name
                                                                         "%PropSetNamed"))
                                                                  4
                                                                  (if (or (= name
                                                                             "%PropStoreOwnNamedAttrs")
                                                                          (= name
                                                                             "%MakeClosure"))
                                                                      5
                                                                      (let [prim
                                                                              (prim-lookup name)]
                                                                        (if (!= prim
                                                                                0)
                                                                            (+ (prim-arity prim)
                                                                               1)
                                                                            (let [arity
                                                                                    (jsl-definition-arity name)]
                                                                              (if (< arity
                                                                                     0)
                                                                                  0
                                                                                  (+ arity
                                                                                     1)))))))))))]
                                        (if (= expected 0)
                                            (jsl-refuse name
                                                        (.lo head)
                                                        (.hi head))
                                            (if (!= (rd/sexp-count x) expected)
                                                (jsl-refuse "wrong primitive arity"
                                                            (.lo x)
                                                            (.hi x))
                                                (let [(mut i) 1]
                                                  (loop (if (>= (load i)
                                                                expected)
                                                            (break 0)
                                                            (do
                                                              (jsl-check-expr-in (rd/sexp-nth x
                                                                                              (load i))
                                                                                 params
                                                                                 (mut locals))
                                                              (set! (mut i)
                                                                    (+ (load i)
                                                                       1))
                                                              (continue)))))))))))))))))))

(defn jsl-check-expr [(x (ptr rd/Sexp)) (params (ptr rd/Sexp))] (-> i64)
  (let [(mut locals) (al-new [(slice u8)] (compiler-allocator))]
    (jsl-check-expr-in x params (mut locals))))

(defn jsl-check-param-type [(params (ptr rd/Sexp)) (name (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (rd/sexp-count params))
              (break JSL-CHECK-TY-INVALID)
              (let [decl (rd/sexp-nth params (load i))]
                (if (= (rd/sexp-sym (rd/sexp-nth decl 0)) name)
                    (break (jsl-check-type-name (rd/sexp-nth decl 1)))
                    (do (set! (mut i) (+ (load i) 1)) (continue))))))))

(defn jsl-check-local-type [(names (ArrayList (slice u8)))
                            (types (ArrayList i64))
                            (name (slice u8))] (-> i64)
  (let [(mut i) (- (len names) 1)]
    (loop (if (< (load i) 0)
              (break JSL-CHECK-TY-INVALID)
              (if (= (get names (load i)) name)
                  (break (get types (load i)))
                  (do (set! (mut i) (- (load i) 1)) (continue)))))))

(defn jsl-check-env-type [(params (ptr rd/Sexp))
                          (names (ArrayList (slice u8)))
                          (types (ArrayList i64))
                          (name (slice u8))] (-> i64)
  (let [local (jsl-check-local-type names types name)]
    (if (!= local JSL-CHECK-TY-INVALID)
        local
        (jsl-check-param-type params name))))

;; One predicate of a `:specialize` / `:inline-when` rule: a tag predicate over a declared `dyn`
;; parameter, or one of the property proofs over an object parameter and an interned key parameter.
;;
;; A tag predicate must name a parameter the BODY tag-tests. A proof of something the body never asks
;; about cannot fold anything, so the declaration would buy a re-lowering and nothing else — the static
;; half of "a proof must resolve a dispatch" (docs/SPECIALIZE.md §4.2, §5).
(defn jsl-check-specialization-predicate! [(rule (ptr rd/Sexp))
                                           (params (ptr rd/Sexp))
                                           (body (ptr rd/Sexp))] (-> i64)
  (let [shaped
          (and (rd/sexp-list? rule)
               (and (or (= (rd/sexp-count rule) 2) (= (rd/sexp-count rule) 3))
                    (and (rd/sexp-sym? (rd/sexp-nth rule 0))
                         (rd/sexp-sym? (rd/sexp-nth rule 1)))))
        tag-rule (and shaped (= (rd/sexp-count rule) 2))]
    (if (not (and shaped
                  (and (if tag-rule
                           (!= (jsl-tag-predicate (rd/sexp-sym (rd/sexp-nth rule
                                                                            0)))
                               0)
                           (and (jsl-property-specialization-predicate? (rd/sexp-sym (rd/sexp-nth rule
                                                                                                  0)))
                                (and (rd/sexp-sym? (rd/sexp-nth rule 2))
                                     (= (jsl-check-param-type params
                                                              (rd/sexp-sym (rd/sexp-nth rule
                                                                                        2)))
                                        JSL-CHECK-TY-INT))))
                       (= (jsl-check-param-type params
                                                (rd/sexp-sym (rd/sexp-nth rule
                                                                          1)))
                          (jsl-check-dyn-type TAG-ANY)))))
        (jsl-refuse "specialization tag or property predicate over declared parameters"
                    (.lo rule)
                    (.hi rule))
        0)
    (if (and tag-rule
             (not (jsl-body-tag-tests? body (rd/sexp-sym (rd/sexp-nth rule 1)))))
        (jsl-refuse "specialization predicate over a parameter the body tag-tests"
                    (.lo rule)
                    (.hi rule))
        0)
    0))

;; Does `body` apply some tag predicate to the parameter `name`?
(defn jsl-body-tag-tests? [(body (ptr rd/Sexp)) (name (slice u8))] (-> bool)
  (if (not (rd/sexp-list? body))
      false
      (let [n (rd/sexp-count body)
            direct
              (and (>= n 2)
                   (and (rd/sexp-sym? (rd/sexp-nth body 0))
                        (and (!= (jsl-tag-predicate (rd/sexp-sym (rd/sexp-nth body
                                                                              0)))
                                 0)
                             (and (rd/sexp-sym? (rd/sexp-nth body 1))
                                  (= (rd/sexp-sym (rd/sexp-nth body 1)) name)))))
            (mut found) direct
            (mut i) 0]
        (loop (if (or (>= (load i) n) (load found))
                  (break 0)
                  (do
                    (if (jsl-body-tag-tests? (rd/sexp-nth body (load i)) name)
                        (set! (mut found) true)
                        0)
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (load found))))

(defn jsl-check-call-type [(x (ptr rd/Sexp))
                           (name (slice u8))
                           (params (ptr rd/Sexp))
                           (local-names (mut (ArrayList (slice u8))))
                           (local-types (mut (ArrayList i64)))] (-> i64)
  (match (jsl-definition-form name)
    (None [] JSL-CHECK-TY-INVALID)
    (Some [target]
          (if (not (rd/sexp-vec? (jsl-form-params target)))
              JSL-CHECK-TY-INVALID
              (let [target-params (jsl-form-params target)
                    (mut i) 0
                    (mut valid) true]
                (loop (if (or (not (load valid))
                              (>= (load i) (rd/sexp-count target-params)))
                          (break 0)
                          (let [actual
                                  (jsl-check-expr-type-in (rd/sexp-nth x
                                                                       (+ (load i)
                                                                          1))
                                                          params
                                                          (mut local-names)
                                                          (mut local-types))
                                expected
                                  (jsl-check-type-name (rd/sexp-nth (rd/sexp-nth target-params
                                                                                 (load i))
                                                                    1))]
                            (if (not (jsl-check-type-assignable? actual
                                                                 expected))
                                (set! (mut valid) false)
                                0)
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (if (load valid)
                    (jsl-check-ret-type target)
                    JSL-CHECK-TY-INVALID))))))

;; A definition's result type: its declared return, widened by the exception tag when it throws.
(defn jsl-check-ret-type [(form (ptr rd/Sexp))] (-> i64)
  (let [declared (jsl-check-type-name (jsl-form-ret form))]
    (if (and (jsl-form-throws? form) (jsl-check-dyn-type? declared))
        (jsl-check-dyn-type (primitive/ior (jsl-check-dyn-tags declared)
                                           TAG-EXCEPTION))
        declared)))

;; A dynamic type that may carry the exception sentinel is a completion, not a value: only
;; `%IsException` may look at it, and only a `:throws` definition may return it.
(defn jsl-check-may-throw? [(t i64)] (-> bool)
  (and (jsl-check-dyn-type? t)
       (!= (primitive/iand (jsl-check-dyn-tags t) TAG-EXCEPTION) 0)))

(defn jsl-check-completion-free? [(t i64)] (-> bool)
  (and (!= t JSL-CHECK-TY-INVALID) (not (jsl-check-may-throw? t))))

;; Every argument of a call form is a value, never an unchecked completion. `let` binds
;; completions so a body can test them; `if` on `%IsException` narrows them away.
(defn jsl-check-args-values? [(x (ptr rd/Sexp))
                              (params (ptr rd/Sexp))
                              (local-names (mut (ArrayList (slice u8))))
                              (local-types (mut (ArrayList i64)))] (-> bool)
  (let [(mut i) 1
        (mut ok) true]
    (loop (if (or (not (load ok)) (>= (load i) (rd/sexp-count x)))
              (break 0)
              (do
                (if (jsl-check-may-throw? (jsl-check-expr-type-in (rd/sexp-nth x
                                                                               (load i))
                                                                  params
                                                                  (mut local-names)
                                                                  (mut local-types)))
                    (set! (mut ok) false)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load ok)))

(defn jsl-check-expr-type-in [(x (ptr rd/Sexp))
                              (params (ptr rd/Sexp))
                              (local-names (mut (ArrayList (slice u8))))
                              (local-types (mut (ArrayList i64)))] (-> i64)
  (if (rd/sexp-int? x)
      JSL-CHECK-TY-INT
      (if (rd/sexp-str? x)
          JSL-CHECK-TY-RAW-STRING
          (if (rd/sexp-sym? x)
              (jsl-check-env-type params
                                  (load local-names)
                                  (load local-types)
                                  (rd/sexp-sym x))
              (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
                (if (and (not (or (= name "let")
                                  (= name "if")
                                  (= name "%IsException")))
                         (not (jsl-check-args-values? x
                                                      params
                                                      (mut local-names)
                                                      (mut local-types))))
                    JSL-CHECK-TY-INVALID
                    (if (or (= name "%CallFunction")
                            (= name "%CallFunctionPacked"))
                        (jsl-check-call-function-type x
                                                      params
                                                      (mut local-names)
                                                      (mut local-types))
                        (if (= name "let")
                            (let [bindings (rd/sexp-nth x 1)
                                  base (len (load local-names))
                                  (mut i) 0]
                              (loop (if (>= (load i) (rd/sexp-count bindings))
                                        (break 0)
                                        (let [binding
                                                (rd/sexp-nth bindings (load i))
                                              init-type
                                                (jsl-check-expr-type-in (rd/sexp-nth binding
                                                                                     1)
                                                                        params
                                                                        (mut local-names)
                                                                        (mut local-types))]
                                          (push! [(slice u8)]
                                                 (mut local-names)
                                                 (rd/sexp-sym (rd/sexp-nth binding
                                                                           0)))
                                          (push! [i64]
                                                 (mut local-types)
                                                 init-type)
                                          (set! (mut i) (+ (load i) 1))
                                          (continue))))
                              (let [answer
                                      (jsl-check-expr-type-in (rd/sexp-nth x 2)
                                                              params
                                                              (mut local-names)
                                                              (mut local-types))]
                                (loop (if (<= (len (load local-names)) base)
                                          (break 0)
                                          (do
                                            (pop! (mut local-names))
                                            (pop! (mut local-types))
                                            (continue))))
                                answer))
                            (if (= name "if")
                                (let [pred
                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                             1)
                                                                params
                                                                (mut local-names)
                                                                (mut local-types))
                                      pred-ok
                                        (or (jsl-check-intlike? pred)
                                            (jsl-check-dyn-type? pred))
                                      pred-form (rd/sexp-nth x 1)
                                      guarded-tag
                                        (if (and (rd/sexp-list? pred-form)
                                                 (and (= (rd/sexp-count pred-form)
                                                         2)
                                                      (rd/sexp-sym? (rd/sexp-nth pred-form
                                                                                 0))))
                                            (jsl-tag-predicate (rd/sexp-sym (rd/sexp-nth pred-form
                                                                                         0)))
                                            0)
                                      guarded-name
                                        (if (and (!= guarded-tag 0)
                                                 (rd/sexp-sym? (rd/sexp-nth pred-form
                                                                            1)))
                                            (rd/sexp-sym (rd/sexp-nth pred-form
                                                                      1))
                                            "")
                                      original
                                        (if (= guarded-name "")
                                            JSL-CHECK-TY-INVALID
                                            (jsl-check-env-type params
                                                                (load local-names)
                                                                (load local-types)
                                                                guarded-name))
                                      narrow
                                        (and (!= guarded-name "")
                                             (jsl-check-dyn-type? original))]
                                  (if narrow
                                      (do
                                        (push! [(slice u8)]
                                               (mut local-names)
                                               guarded-name)
                                        (push! [i64]
                                               (mut local-types)
                                               (jsl-check-dyn-type (primitive/iand (jsl-check-dyn-tags original)
                                                                                   guarded-tag))))
                                      0)
                                  (let [yes
                                          (jsl-check-expr-type-in (rd/sexp-nth x
                                                                               2)
                                                                  params
                                                                  (mut local-names)
                                                                  (mut local-types))]
                                    (if narrow
                                        (do
                                          (pop! (mut local-names))
                                          (pop! (mut local-types))
                                          0)
                                        0)
                                    (if narrow
                                        (do
                                          (push! [(slice u8)]
                                                 (mut local-names)
                                                 guarded-name)
                                          (push! [i64]
                                                 (mut local-types)
                                                 (jsl-check-dyn-type (primitive/iand (jsl-check-dyn-tags original)
                                                                                     (primitive/ixor TAG-COMPLETION
                                                                                                     guarded-tag)))))
                                        0)
                                    (let [no
                                            (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                 3)
                                                                    params
                                                                    (mut local-names)
                                                                    (mut local-types))]
                                      (if narrow
                                          (do
                                            (pop! (mut local-names))
                                            (pop! (mut local-types))
                                            0)
                                          0)
                                      (if pred-ok
                                          (jsl-check-join yes no)
                                          JSL-CHECK-TY-INVALID))))
                                (if (or (= name "%NewObject")
                                        (= name "%Undefined")
                                        (= name "%Null")
                                        (= name "%GlobalObject"))
                                    (if (= name "%NewObject")
                                        JSL-CHECK-TY-RAW-OBJECT
                                        (jsl-check-dyn-type (if (= name "%Null")
                                                                TAG-NULL
                                                                (if (= name
                                                                       "%GlobalObject")
                                                                    TAG-OBJECT
                                                                    TAG-UNDEFINED))))
                                    ;; (%IntrinsicPrototype "Name.prototype"): the well-known image object, or null
                                    ;; when the realm did not materialize it.
                                    (if (= name "%IntrinsicPrototype")
                                        (if (rd/sexp-str? (rd/sexp-nth x 1))
                                            (jsl-check-dyn-type (+ TAG-NULL
                                                                   TAG-OBJECT))
                                            JSL-CHECK-TY-INVALID)
                                        ;; (%MakeClosure "%Entry%" prototype env flags): a fresh function object on `prototype`
                                        ;; (an object or null) whose code is the declared entry and whose environment word
                                        ;; is `env` (docs/DECISIONS.md, built-in closures).
                                        (if (or (= name "%PropertyKey")
                                                (= name "%WellKnownKey")
                                                (= name "%InternalKey")
                                                (= name "%MakeClosure"))
                                            (if (or (= name "%PropertyKey")
                                                    (= name "%WellKnownKey")
                                                    (= name "%InternalKey"))
                                                (if (rd/sexp-str? (rd/sexp-nth x
                                                                               1))
                                                    JSL-CHECK-TY-INT
                                                    JSL-CHECK-TY-INVALID)
                                                (let [proto-ty
                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                             2)
                                                                                params
                                                                                (mut local-names)
                                                                                (mut local-types))
                                                      env-ty
                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                             3)
                                                                                params
                                                                                (mut local-names)
                                                                                (mut local-types))
                                                      flags-ty
                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                             4)
                                                                                params
                                                                                (mut local-names)
                                                                                (mut local-types))]
                                                  (if (and (rd/sexp-str? (rd/sexp-nth x
                                                                                      1))
                                                           (jsl-check-dyn-type? proto-ty)
                                                           (= (primitive/iand (jsl-check-dyn-tags proto-ty)
                                                                              (primitive/ixor TAG-ANY
                                                                                              (+ TAG-NULL
                                                                                                 (+ TAG-OBJECT
                                                                                                    (+ TAG-FUNCTION
                                                                                                       TAG-ARRAY)))))
                                                              0)
                                                           (jsl-check-dyn-type? env-ty)
                                                           (jsl-check-completion-free? env-ty)
                                                           (= flags-ty
                                                              JSL-CHECK-TY-INT))
                                                      (jsl-check-dyn-type TAG-FUNCTION)
                                                      JSL-CHECK-TY-INVALID)))
                                            ;; (%ArrayStore array index value): the value, a JavaScript value.
                                            ;; (%Substring string start end): a fresh string over [start, end).
                                            ;; (%PropDefine object key value attrs mask): ValidateAndApplyPropertyDescriptor;
                                            ;; the answer is a status code.
                                            (if (= name "%PropDefine")
                                                (let [object-ty
                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                             1)
                                                                                params
                                                                                (mut local-names)
                                                                                (mut local-types))
                                                      key-ty
                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                             2)
                                                                                params
                                                                                (mut local-names)
                                                                                (mut local-types))
                                                      value-ty
                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                             3)
                                                                                params
                                                                                (mut local-names)
                                                                                (mut local-types))
                                                      attrs-ty
                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                             4)
                                                                                params
                                                                                (mut local-names)
                                                                                (mut local-types))
                                                      mask-ty
                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                             5)
                                                                                params
                                                                                (mut local-names)
                                                                                (mut local-types))]
                                                  (if (and (= object-ty
                                                              JSL-CHECK-TY-RAW-OBJECT)
                                                           (and (= key-ty
                                                                   JSL-CHECK-TY-INT)
                                                                (and (jsl-check-dyn-type? value-ty)
                                                                     (and (jsl-check-completion-free? value-ty)
                                                                          (and (= attrs-ty
                                                                                  JSL-CHECK-TY-INT)
                                                                               (= mask-ty
                                                                                  JSL-CHECK-TY-INT))))))
                                                      JSL-CHECK-TY-INT
                                                      JSL-CHECK-TY-INVALID))
                                                ;; (%MathBinary op x y): the operation code and two Number words.
                                                (if (= name "%MathBinary")
                                                    (let [op-ty
                                                            (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                 1)
                                                                                    params
                                                                                    (mut local-names)
                                                                                    (mut local-types))
                                                          x-ty
                                                            (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                 2)
                                                                                    params
                                                                                    (mut local-names)
                                                                                    (mut local-types))
                                                          y-ty
                                                            (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                 3)
                                                                                    params
                                                                                    (mut local-names)
                                                                                    (mut local-types))
                                                          number-ty
                                                            (jsl-check-dyn-type (+ TAG-INT
                                                                                   TAG-DOUBLE))]
                                                      (if (and (= op-ty
                                                                  JSL-CHECK-TY-INT)
                                                               (and (jsl-check-number-word? x-ty)
                                                                    (jsl-check-number-word? y-ty)))
                                                          number-ty
                                                          JSL-CHECK-TY-INVALID))
                                                    (if (= name "%Substring")
                                                        (let [string-ty
                                                                (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                     1)
                                                                                        params
                                                                                        (mut local-names)
                                                                                        (mut local-types))
                                                              start-ty
                                                                (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                     2)
                                                                                        params
                                                                                        (mut local-names)
                                                                                        (mut local-types))
                                                              end-ty
                                                                (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                     3)
                                                                                        params
                                                                                        (mut local-names)
                                                                                        (mut local-types))]
                                                          (if (and (= string-ty
                                                                      JSL-CHECK-TY-RAW-STRING)
                                                                   (and (= start-ty
                                                                           JSL-CHECK-TY-INT)
                                                                        (= end-ty
                                                                           JSL-CHECK-TY-INT)))
                                                              JSL-CHECK-TY-RAW-STRING
                                                              JSL-CHECK-TY-INVALID))
                                                        (if (= name
                                                               "%ArrayStore")
                                                            (let [array-ty
                                                                    (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                         1)
                                                                                            params
                                                                                            (mut local-names)
                                                                                            (mut local-types))
                                                                  index-ty
                                                                    (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                         2)
                                                                                            params
                                                                                            (mut local-names)
                                                                                            (mut local-types))
                                                                  value-ty
                                                                    (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                         3)
                                                                                            params
                                                                                            (mut local-names)
                                                                                            (mut local-types))]
                                                              (if (and (= array-ty
                                                                          JSL-CHECK-TY-RAW-ARRAY)
                                                                       (and (= index-ty
                                                                               JSL-CHECK-TY-INT)
                                                                            (and (jsl-check-dyn-type? value-ty)
                                                                                 (jsl-check-completion-free? value-ty))))
                                                                  value-ty
                                                                  JSL-CHECK-TY-INVALID))
                                                            ;; (%PropStoreOwnNamedAttrs object key value attrs): a definition with
                                                            ;; literal attributes; the value is the value.
                                                            (if (= name
                                                                   "%PropStoreOwnNamedAttrs")
                                                                (let [object-ty
                                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                             1)
                                                                                                params
                                                                                                (mut local-names)
                                                                                                (mut local-types))
                                                                      key-ty
                                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                             2)
                                                                                                params
                                                                                                (mut local-names)
                                                                                                (mut local-types))
                                                                      value-ty
                                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                             3)
                                                                                                params
                                                                                                (mut local-names)
                                                                                                (mut local-types))]
                                                                  (if (and (= object-ty
                                                                              JSL-CHECK-TY-RAW-OBJECT)
                                                                           (and (= key-ty
                                                                                   JSL-CHECK-TY-INT)
                                                                                (and (jsl-check-dyn-type? value-ty)
                                                                                     (= (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                             4)
                                                                                                                params
                                                                                                                (mut local-names)
                                                                                                                (mut local-types))
                                                                                        JSL-CHECK-TY-INT))))
                                                                      value-ty
                                                                      JSL-CHECK-TY-INVALID))
                                                                (if (= name
                                                                       "%PropStoreOwnNamed")
                                                                    (let [object-ty
                                                                            (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                 1)
                                                                                                    params
                                                                                                    (mut local-names)
                                                                                                    (mut local-types))
                                                                          key-ty
                                                                            (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                 2)
                                                                                                    params
                                                                                                    (mut local-names)
                                                                                                    (mut local-types))
                                                                          value-ty
                                                                            (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                 3)
                                                                                                    params
                                                                                                    (mut local-names)
                                                                                                    (mut local-types))]
                                                                      (if (and (= object-ty
                                                                                  JSL-CHECK-TY-RAW-OBJECT)
                                                                               (and (= key-ty
                                                                                       JSL-CHECK-TY-INT)
                                                                                    (jsl-check-dyn-type? value-ty)))
                                                                          value-ty
                                                                          JSL-CHECK-TY-INVALID))
                                                                    ;; (%PropSetNamed object key value): OrdinarySet's fast cases; the value,
                                                                    ;; or the exception sentinel when the slow path must decide.
                                                                    (if (= name
                                                                           "%PropSetNamed")
                                                                        (let [object-ty
                                                                                (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                     1)
                                                                                                        params
                                                                                                        (mut local-names)
                                                                                                        (mut local-types))
                                                                              key-ty
                                                                                (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                     2)
                                                                                                        params
                                                                                                        (mut local-names)
                                                                                                        (mut local-types))
                                                                              value-ty
                                                                                (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                     3)
                                                                                                        params
                                                                                                        (mut local-names)
                                                                                                        (mut local-types))]
                                                                          (if (and (= object-ty
                                                                                      JSL-CHECK-TY-RAW-OBJECT)
                                                                                   (and (= key-ty
                                                                                           JSL-CHECK-TY-INT)
                                                                                        (jsl-check-dyn-type? value-ty)))
                                                                              (jsl-check-dyn-type TAG-COMPLETION)
                                                                              JSL-CHECK-TY-INVALID))
                                                                        (if (!= (prim-lookup name)
                                                                                0)
                                                                            (let [prim
                                                                                    (prim-lookup name)
                                                                                  lhs
                                                                                    (if (>= (prim-arity prim)
                                                                                            1)
                                                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                             1)
                                                                                                                params
                                                                                                                (mut local-names)
                                                                                                                (mut local-types))
                                                                                        JSL-CHECK-TY-INVALID)
                                                                                  rhs
                                                                                    (if (= (prim-arity prim)
                                                                                           2)
                                                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                             2)
                                                                                                                params
                                                                                                                (mut local-names)
                                                                                                                (mut local-types))
                                                                                        JSL-CHECK-TY-INVALID)]
                                                                              (jsl-check-runtime-primitive-type prim
                                                                                                                lhs
                                                                                                                rhs))
                                                                            (if (>= (jsl-definition-arity name)
                                                                                    0)
                                                                                (jsl-check-call-type x
                                                                                                     name
                                                                                                     params
                                                                                                     (mut local-names)
                                                                                                     (mut local-types))
                                                                                (let [lhs
                                                                                        (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                             1)
                                                                                                                params
                                                                                                                (mut local-names)
                                                                                                                (mut local-types))]
                                                                                  (if (= (rd/sexp-count x)
                                                                                         2)
                                                                                      (jsl-check-unary-type name
                                                                                                            lhs)
                                                                                      (let [rhs
                                                                                              (jsl-check-expr-type-in (rd/sexp-nth x
                                                                                                                                   2)
                                                                                                                      params
                                                                                                                      (mut local-names)
                                                                                                                      (mut local-types))]
                                                                                        (if (= name
                                                                                               "%PropLoadOwnNamed")
                                                                                            (if (and (= lhs
                                                                                                        JSL-CHECK-TY-RAW-OBJECT)
                                                                                                     (= rhs
                                                                                                        JSL-CHECK-TY-INT))
                                                                                                (jsl-check-dyn-type TAG-ANY)
                                                                                                JSL-CHECK-TY-INVALID)
                                                                                            (if (= name
                                                                                                   "%PropHasOwnNamed")
                                                                                                (if (and (= lhs
                                                                                                            JSL-CHECK-TY-RAW-OBJECT)
                                                                                                         (= rhs
                                                                                                            JSL-CHECK-TY-INT))
                                                                                                    JSL-CHECK-TY-BOOL
                                                                                                    JSL-CHECK-TY-INVALID)
                                                                                                ;; (%PropAttrsOwn object key): the own property's attribute bits, or
                                                                                                ;; -1/-2 when absent (extensible / not).
                                                                                                (if (= name
                                                                                                       "%PropAttrsOwn")
                                                                                                    (if (and (= lhs
                                                                                                                JSL-CHECK-TY-RAW-OBJECT)
                                                                                                             (= rhs
                                                                                                                JSL-CHECK-TY-INT))
                                                                                                        JSL-CHECK-TY-INT
                                                                                                        JSL-CHECK-TY-INVALID)
                                                                                                    ;; (%PropChainHolder object key): the first prototype with an own key, or null.
                                                                                                    (if (= name
                                                                                                           "%PropChainHolder")
                                                                                                        (if (and (= lhs
                                                                                                                    JSL-CHECK-TY-RAW-OBJECT)
                                                                                                                 (= rhs
                                                                                                                    JSL-CHECK-TY-INT))
                                                                                                            (jsl-check-dyn-type (+ TAG-NULL
                                                                                                                                   (+ TAG-OBJECT
                                                                                                                                      (+ TAG-FUNCTION
                                                                                                                                         TAG-ARRAY))))
                                                                                                            JSL-CHECK-TY-INVALID)
                                                                                                        ;; (%PropGetNamed object key): ordinary [[Get]] of a data property, own or
                                                                                                        ;; inherited; the exception sentinel signals an accessor found.
                                                                                                        (if (= name
                                                                                                               "%PropGetNamed")
                                                                                                            (if (and (= lhs
                                                                                                                        JSL-CHECK-TY-RAW-OBJECT)
                                                                                                                     (= rhs
                                                                                                                        JSL-CHECK-TY-INT))
                                                                                                                (jsl-check-dyn-type TAG-COMPLETION)
                                                                                                                JSL-CHECK-TY-INVALID)
                                                                                                            (if (= name
                                                                                                                   "%SetObjectPrototype")
                                                                                                                (if (and (= lhs
                                                                                                                            JSL-CHECK-TY-RAW-OBJECT)
                                                                                                                         (and (jsl-check-dyn-type? rhs)
                                                                                                                              (= (primitive/iand (jsl-check-dyn-tags rhs)
                                                                                                                                                 (primitive/ixor TAG-ANY
                                                                                                                                                                 (+ TAG-NULL
                                                                                                                                                                    (+ TAG-OBJECT
                                                                                                                                                                       (+ TAG-FUNCTION
                                                                                                                                                                          TAG-ARRAY)))))
                                                                                                                                 0)))
                                                                                                                    JSL-CHECK-TY-RAW-OBJECT
                                                                                                                    JSL-CHECK-TY-INVALID)
                                                                                                                ;; (%ArgumentAt vector index): an overflow actual of the callable ABI, index 3 or
                                                                                                                ;; more and below the count, which the body proved.
                                                                                                                (if (= name
                                                                                                                       "%ArgumentAt")
                                                                                                                    (if (and (= lhs
                                                                                                                                JSL-CHECK-TY-ARGUMENT-VECTOR)
                                                                                                                             (= rhs
                                                                                                                                JSL-CHECK-TY-INT))
                                                                                                                        (jsl-check-dyn-type TAG-ANY)
                                                                                                                        JSL-CHECK-TY-INVALID)
                                                                                                                    (jsl-check-binary-type name
                                                                                                                                           lhs
                                                                                                                                           rhs))))))))))))))))))))))))))))))))

;; (%CallFunction callee this arg...) calls a JavaScript function value from a body: the callee
;; must already be proven a function (a `%IsFunction` test narrows it), `this` and the arguments
;; are values, and the result is the callee's completion — a value or the exception sentinel — so
;; the body is `:throws` and must test it with `%IsException` before using it.
(defn jsl-check-call-function-type [(x (ptr rd/Sexp))
                                    (params (ptr rd/Sexp))
                                    (local-names (mut (ArrayList (slice u8))))
                                    (local-types (mut (ArrayList i64)))] (-> i64)
  (let [callee
          (jsl-check-expr-type-in (rd/sexp-nth x 1)
                                  params
                                  (mut local-names)
                                  (mut local-types))
        packed (rd/sexp-sym-is (rd/sexp-nth x 0) "%CallFunctionPacked")
        (mut i) 2
        (mut ok) (= callee (jsl-check-dyn-type TAG-FUNCTION))]
    (loop (if (or (not (load ok)) (>= (load i) (rd/sexp-count x)))
              (break 0)
              (let [t
                      (jsl-check-expr-type-in (rd/sexp-nth x (load i))
                                              params
                                              (mut local-names)
                                              (mut local-types))]
                (if (not (if (and packed (= (load i) 4))
                             (= t JSL-CHECK-TY-ARGUMENT-COUNT)
                             (if (and packed (= (load i) 5))
                                 (= t JSL-CHECK-TY-ARGUMENT-VECTOR)
                                 (and (jsl-check-dyn-type? t)
                                      (jsl-check-completion-free? t)))))
                    (set! (mut ok) false)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (load ok) (jsl-check-dyn-type TAG-COMPLETION) JSL-CHECK-TY-INVALID)))

(defn jsl-check-expr-type [(x (ptr rd/Sexp)) (params (ptr rd/Sexp))] (-> i64)
  (let [(mut local-names) (al-new [(slice u8)] (compiler-allocator))
        (mut local-types) (al-new [i64] (compiler-allocator))]
    (jsl-check-expr-type-in x params (mut local-names) (mut local-types))))

(defn jsl-expr-transitioning? [(x (ptr rd/Sexp))] (-> bool)
  ;; A string literal is static data (StrConst; docs/DECISIONS.md, string literals are static
  ;; data): it allocates nothing and does not make its form transitioning.
  (if (rd/sexp-str? x)
      false
      (if (not (rd/sexp-list? x))
          false
          (let [count (rd/sexp-count x)]
            (if (= count 0)
                false
                (let [head (rd/sexp-nth x 0)
                      name (if (rd/sexp-sym? head) (rd/sexp-sym head) "")
                      direct
                        (or (= name "%NewObject")
                            (= name "%NewObjectWithShape")
                            (= name "%PropStoreOwnNamed")
                            (= name "%PropStoreOwnNamedAttrs")
                            (= name "%PropSetNamed")
                            (= name "%CallFunction")
                            (= name "%CallFunctionPacked")
                            (= name "%MakeClosure")
                            (let [prim (prim-lookup name)]
                              (and (!= prim 0) (prim-transitioning? prim)))
                            (match (jsl-definition-form name)
                              (Some [target] (jsl-form-transitioning? target))
                              (None [] false)))
                      (mut i) 1
                      (mut transitioning) direct]
                  (loop (if (or (load transitioning) (>= (load i) count))
                            (break 0)
                            (do
                              (if (jsl-expr-transitioning? (rd/sexp-nth x
                                                                        (load i)))
                                  (set! (mut transitioning) true)
                                  0)
                              (set! (mut i) (+ (load i) 1))
                              (continue))))
                  (if (or (= name "%PropertyKey")
                          (= name "%WellKnownKey")
                          (= name "%InternalKey")
                          (= name "%IntrinsicPrototype"))
                      false
                      (load transitioning))))))))
