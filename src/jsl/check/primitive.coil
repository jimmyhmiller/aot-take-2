;; Result types of JSL primitives: binary, unary and runtime.

(module aot.jsl.check.primitive)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.reader" :as rd)
(import "coil.os" :as os)
(import "aot.node.jsops" :use *)
(import "aot.type.type" :use *)
(import "aot.jsl.check.types" :use *)
(import "aot.jsl.check.expr" :use *)

(defn jsl-check-binary-type [(name (slice u8)) (lhs i64) (rhs i64)] (-> i64)
  (cond (or (= lhs JSL-CHECK-TY-INVALID) (= rhs JSL-CHECK-TY-INVALID))
          JSL-CHECK-TY-INVALID
        (or (= name "%Add") (= name "%Sub") (= name "%Mul") (= name "%Div"))
          (if (and (jsl-check-numeric? lhs) (jsl-check-numeric? rhs))
              (if (or (= lhs JSL-CHECK-TY-FLT) (= rhs JSL-CHECK-TY-FLT))
                  JSL-CHECK-TY-FLT
                  JSL-CHECK-TY-INT)
              JSL-CHECK-TY-INVALID)
        (or (= name "%Lt") (= name "%Le"))
          (if (and (jsl-check-numeric? lhs) (jsl-check-numeric? rhs))
              JSL-CHECK-TY-BOOL
              JSL-CHECK-TY-INVALID)
        (or (= name "%Eq") (= name "%Ne") (= name "%SameBits"))
          (if (if (= name "%SameBits")
                  (and (jsl-check-dyn-type? lhs)
                       (jsl-check-dyn-type? rhs))
                  (and (jsl-check-numeric? lhs)
                       (jsl-check-numeric? rhs)))
              JSL-CHECK-TY-BOOL
              JSL-CHECK-TY-INVALID)
        (= name "%And")
          (if (and (jsl-check-intlike? lhs)
                   (jsl-check-intlike? rhs))
              (if (and (= lhs JSL-CHECK-TY-BOOL)
                       (= rhs JSL-CHECK-TY-BOOL))
                  JSL-CHECK-TY-BOOL
                  JSL-CHECK-TY-INT)
              JSL-CHECK-TY-INVALID)
        :else JSL-CHECK-TY-INVALID))

(defn jsl-check-runtime-primitive-type [(prim i64) (lhs i64) (rhs i64)] (-> i64)
  (case prim JS-GLOBAL-LEXICAL-FIND
        (if (= lhs JSL-CHECK-TY-INT) JSL-CHECK-TY-INT JSL-CHECK-TY-INVALID)
          JS-GLOBAL-LEXICAL-CREATE
        (if (and (= lhs JSL-CHECK-TY-INT) (= rhs JSL-CHECK-TY-INT))
            JSL-CHECK-TY-INT
            JSL-CHECK-TY-INVALID)
          JS-GLOBAL-LEXICAL-STATE
        (if (= lhs JSL-CHECK-TY-INT) JSL-CHECK-TY-INT JSL-CHECK-TY-INVALID)
          JS-GLOBAL-LEXICAL-VALUE
        (if (= lhs JSL-CHECK-TY-INT)
            (jsl-check-dyn-type TAG-ANY)
            JSL-CHECK-TY-INVALID)
          JS-GLOBAL-LEXICAL-INITIALIZE
        (if (and (= lhs JSL-CHECK-TY-INT)
                 (jsl-check-dyn-type? rhs)
                 (jsl-check-completion-free? rhs))
            (jsl-check-dyn-type TAG-ANY)
            JSL-CHECK-TY-INVALID)
          JS-GLOBAL-LEXICAL-STORE
        (if (and (= lhs JSL-CHECK-TY-INT)
                 (jsl-check-dyn-type? rhs)
                 (jsl-check-completion-free? rhs))
            (jsl-check-dyn-type TAG-ANY)
            JSL-CHECK-TY-INVALID)
          JS-STRING-LEN
        (if (= lhs JSL-CHECK-TY-RAW-STRING)
            JSL-CHECK-TY-INT
            JSL-CHECK-TY-INVALID)
          JS-STRING-CONCAT
        (if (and (= lhs JSL-CHECK-TY-RAW-STRING)
                 (= rhs JSL-CHECK-TY-RAW-STRING))
            JSL-CHECK-TY-RAW-STRING
            JSL-CHECK-TY-INVALID)
          JS-STRING-CHARCODE
        (if (and (= lhs JSL-CHECK-TY-RAW-STRING) (= rhs JSL-CHECK-TY-INT))
            JSL-CHECK-TY-INT
            JSL-CHECK-TY-INVALID)
          JS-STRING-EQ
        (if (and (= lhs JSL-CHECK-TY-RAW-STRING)
                 (= rhs JSL-CHECK-TY-RAW-STRING))
            JSL-CHECK-TY-BOOL
            JSL-CHECK-TY-INVALID)
          JS-STRING-COMPARE
        (if (and (= lhs JSL-CHECK-TY-RAW-STRING)
                 (= rhs JSL-CHECK-TY-RAW-STRING))
            JSL-CHECK-TY-INT
            JSL-CHECK-TY-INVALID)
        ;; The traps never return; their nominal result is the full dynamic type so a following
        ;; expression can stand in for the value that would have been produced.
        JS-THROW-TYPE-ERROR (jsl-check-dyn-type TAG-ANY)
        JS-TRAP-TO-PRIMITIVE (jsl-check-dyn-type TAG-ANY)
        JS-TRAP-TO-STRING (jsl-check-dyn-type TAG-ANY)
        JS-STRING-FROMCODE
          (if (= lhs JSL-CHECK-TY-INT)
              JSL-CHECK-TY-RAW-STRING
              JSL-CHECK-TY-INVALID)
        JS-STRING-TO-NUMBER
          (if (= lhs JSL-CHECK-TY-RAW-STRING)
              (jsl-check-dyn-type (+ TAG-INT TAG-DOUBLE))
              JSL-CHECK-TY-INVALID)
        ;; (%MathUnary op x): the operation code and a Number word; (%ParseInt string radix).
        JS-MATH-UNARY
          (if (and (= lhs JSL-CHECK-TY-INT) (jsl-check-number-word? rhs))
              (jsl-check-dyn-type (+ TAG-INT TAG-DOUBLE))
              JSL-CHECK-TY-INVALID)
        JS-MATH-RANDOM (jsl-check-dyn-type (+ TAG-INT TAG-DOUBLE))
        JS-PARSE-INT
          (if (and (= lhs JSL-CHECK-TY-RAW-STRING) (= rhs JSL-CHECK-TY-INT))
              (jsl-check-dyn-type (+ TAG-INT TAG-DOUBLE))
              JSL-CHECK-TY-INVALID)
        JS-PARSE-FLOAT
          (if (= lhs JSL-CHECK-TY-RAW-STRING)
              (jsl-check-dyn-type (+ TAG-INT TAG-DOUBLE))
              JSL-CHECK-TY-INVALID)
        ;; (%PropAttributes object key): the own property's attribute bits, -1 absent and extensible,
        ;; -2 absent and not extensible.
        JS-PROP-ATTRIBUTES
          (if (and (= lhs JSL-CHECK-TY-RAW-OBJECT) (= rhs JSL-CHECK-TY-INT))
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        ;; (%ObjectIntegrity object level), (%TestIntegrity object level): SetIntegrityLevel and
        ;; TestIntegrityLevel; (%PreventExtensions object), (%IsExtensible object).
        JS-OBJECT-INTEGRITY
          (if (and (= lhs JSL-CHECK-TY-RAW-OBJECT) (= rhs JSL-CHECK-TY-INT))
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        JS-TEST-INTEGRITY
          (if (and (= lhs JSL-CHECK-TY-RAW-OBJECT) (= rhs JSL-CHECK-TY-INT))
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        JS-PREVENT-EXTENSIONS
          (if (= lhs JSL-CHECK-TY-RAW-OBJECT)
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        JS-IS-EXTENSIBLE
          (if (= lhs JSL-CHECK-TY-RAW-OBJECT)
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        JS-TRAP-NO-REALM (jsl-check-dyn-type TAG-ANY)
        JS-TRAP-INVARIANT (jsl-check-dyn-type TAG-ANY)
        JS-TRAP-DYNAMIC-CODE (jsl-check-dyn-type TAG-ANY)
        JS-KEY-ARRAY-INDEX
          (if (= lhs JSL-CHECK-TY-INT) JSL-CHECK-TY-INT JSL-CHECK-TY-INVALID)
        ;; (%ArgumentTail array): the callable ABI's overflow vector over the array's elements from 3.
        JS-ARGUMENT-TAIL
          (if (= lhs JSL-CHECK-TY-RAW-ARRAY)
              JSL-CHECK-TY-ARGUMENT-VECTOR
              JSL-CHECK-TY-INVALID)
        ;; (%PropDelete object key): OrdinaryDelete's status, 0 gone and 1 refused.
        JS-PROP-DELETE
          (if (and (= lhs JSL-CHECK-TY-RAW-OBJECT) (= rhs JSL-CHECK-TY-INT))
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        ;; (%ArrayDeleteIndex array index): the element becomes a hole.
        JS-ARRAY-DELETE
          (if (and (= lhs JSL-CHECK-TY-RAW-ARRAY) (= rhs JSL-CHECK-TY-INT))
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        JS-OBJECT-KEYS
          (if (and (= lhs JSL-CHECK-TY-RAW-OBJECT)
                   (and (jsl-check-dyn-type? rhs)
                        (jsl-check-completion-free? rhs)))
              JSL-CHECK-TY-RAW-ARRAY
              JSL-CHECK-TY-INVALID)
        JS-OBJECT-OWN-NAMES
          (if (and (= lhs JSL-CHECK-TY-RAW-OBJECT)
                   (and (jsl-check-dyn-type? rhs)
                        (jsl-check-completion-free? rhs)))
              JSL-CHECK-TY-RAW-ARRAY
              JSL-CHECK-TY-INVALID)
        JS-TRAP-KEYED-ACCESS (jsl-check-dyn-type TAG-ANY)
        JS-TRAP-UNRESOLVED-GLOBAL
          (if (= lhs JSL-CHECK-TY-INT)
              (jsl-check-dyn-type TAG-ANY)
              JSL-CHECK-TY-INVALID)
        JS-NUMBER-TO-STRING
          (if (jsl-check-dyn-type? lhs)
              JSL-CHECK-TY-RAW-STRING
              JSL-CHECK-TY-INVALID)
        JS-TRAP-TO-OBJECT (jsl-check-dyn-type TAG-ANY)
        ;; (%NewSymbol description): the description is any completion-free value; the result is the
        ;; fresh allocation, which `%Box` tags as a Symbol.
        JS-SYMBOL-NEW
          (if (and (jsl-check-dyn-type? lhs) (jsl-check-completion-free? lhs))
              JSL-CHECK-TY-RAW-SYMBOL
              JSL-CHECK-TY-INVALID)
        JS-SYMBOL-DESCRIPTION
          (if (= lhs JSL-CHECK-TY-RAW-SYMBOL)
              (jsl-check-dyn-type TAG-ANY)
              JSL-CHECK-TY-INVALID)
        ;; (%SymbolKey symbol): the property key a Symbol is, an ordinary key id.
        JS-SYMBOL-KEY
          (if (= lhs JSL-CHECK-TY-RAW-SYMBOL)
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        ;; (%DateNow): milliseconds since the epoch, an ordinary integer.
        JS-DATE-NOW JSL-CHECK-TY-INT
        ;; (%LocalTimeZoneOffset ms): the local offset at that instant, in milliseconds.
        JS-LOCAL-TZ-OFFSET
          (if (= lhs JSL-CHECK-TY-INT) JSL-CHECK-TY-INT JSL-CHECK-TY-INVALID)
        JS-ARRAY-NEW
          (if (and (= lhs JSL-CHECK-TY-INT)
                   (and (jsl-check-dyn-type? rhs)
                        (jsl-check-completion-free? rhs)))
              JSL-CHECK-TY-RAW-ARRAY
              JSL-CHECK-TY-INVALID)
        JS-ARRAY-LOAD
          (if (and (= lhs JSL-CHECK-TY-RAW-ARRAY) (= rhs JSL-CHECK-TY-INT))
              (jsl-check-dyn-type TAG-ANY)
              JSL-CHECK-TY-INVALID)
        JS-ARRAY-HAS
          (if (and (= lhs JSL-CHECK-TY-RAW-ARRAY) (= rhs JSL-CHECK-TY-INT))
              JSL-CHECK-TY-BOOL
              JSL-CHECK-TY-INVALID)
        JS-ARRAY-SET-LENGTH
          (if (and (= lhs JSL-CHECK-TY-RAW-ARRAY) (= rhs JSL-CHECK-TY-INT))
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        JS-ARRAY-INDEX-OF-STRING
          (if (= lhs JSL-CHECK-TY-RAW-STRING)
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        JS-INTERN-KEY
          (if (= lhs JSL-CHECK-TY-RAW-STRING)
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        JS-GET-PROTOTYPE
          (if (= lhs JSL-CHECK-TY-RAW-OBJECT)
              (jsl-check-dyn-type (+ TAG-NULL
                                     (+ TAG-OBJECT (+ TAG-FUNCTION TAG-ARRAY))))
              JSL-CHECK-TY-INVALID)
        JS-SET-PROTOTYPE
          (if (and (= lhs JSL-CHECK-TY-RAW-OBJECT)
                   (and (jsl-check-dyn-type? rhs)
                        (= (primitive/iand (jsl-check-dyn-tags rhs)
                                           (primitive/ixor TAG-COMPLETION
                                                           (+ TAG-NULL
                                                              (+ TAG-OBJECT
                                                                 (+ TAG-FUNCTION
                                                                    TAG-ARRAY)))))
                           0)))
              JSL-CHECK-TY-BOOL
              JSL-CHECK-TY-INVALID)
        JSL-CHECK-TY-INVALID))

(defn jsl-check-unary-type [(name (slice u8)) (arg i64)] (-> i64)
  (if (= name "%NewObjectWithShape")
      (if (= arg JSL-CHECK-TY-INT) JSL-CHECK-TY-RAW-OBJECT JSL-CHECK-TY-INVALID)
      (jsl-check-unary-type-inner name arg)))

(defn jsl-check-unary-type-inner [(name (slice u8)) (arg i64)] (-> i64)
  (cond (= arg JSL-CHECK-TY-INVALID) JSL-CHECK-TY-INVALID
        (= name "%BoxBool")
          (if (= arg JSL-CHECK-TY-BOOL)
              (jsl-check-dyn-type TAG-BOOL)
              JSL-CHECK-TY-INVALID)
        (= name "%BoxInt")
          (if (= arg JSL-CHECK-TY-INT)
              (jsl-check-dyn-type TAG-INT)
              JSL-CHECK-TY-INVALID)
        (= name "%Box")  ;; Bool shares an integer machine representation today, but boxing it as TAG-INT would
        ;; make `%IsBool` false. Admit only representations with implemented tag-preserving Box.
        (cond (= arg JSL-CHECK-TY-INT) (jsl-check-dyn-type TAG-INT)
              (= arg JSL-CHECK-TY-FLT) (jsl-check-dyn-type TAG-DOUBLE)
              (= arg JSL-CHECK-TY-RAW-OBJECT) (jsl-check-dyn-type TAG-OBJECT)
              (= arg JSL-CHECK-TY-RAW-STRING) (jsl-check-dyn-type TAG-STRING)
              (= arg JSL-CHECK-TY-RAW-ARRAY) (jsl-check-dyn-type TAG-ARRAY)
              (= arg JSL-CHECK-TY-RAW-SYMBOL) (jsl-check-dyn-type TAG-SYMBOL)
              :else JSL-CHECK-TY-INVALID)
          (or (= name "%Not") (= name "%Neg"))
        (if (= name "%Neg")
            (if (jsl-check-numeric? arg) arg JSL-CHECK-TY-INVALID)
            (if (jsl-check-intlike? arg)
                JSL-CHECK-TY-BOOL
                JSL-CHECK-TY-INVALID))
          (= name "%ToFloat")
        (if (jsl-check-intlike? arg)
            JSL-CHECK-TY-FLT
            JSL-CHECK-TY-INVALID)
        ;; Truncation toward zero of a float, saturating (`fcvtzs`).
        (= name "%ToInteger")
          (if (= arg JSL-CHECK-TY-FLT)
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        (= name "%UnboxInt")
          (if (jsl-check-dyn-type? arg)
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        (= name "%UnboxBool")
          (if (and (jsl-check-dyn-type? arg)
                   (!= (& (jsl-check-dyn-tags arg)
                          TAG-BOOL)
                       0))
              JSL-CHECK-TY-BOOL
              JSL-CHECK-TY-INVALID)
        (= name "%UnboxString")
          (if (and (jsl-check-dyn-type? arg)
                   (!= (& (jsl-check-dyn-tags arg)
                          TAG-STRING)
                       0))
              JSL-CHECK-TY-RAW-STRING
              JSL-CHECK-TY-INVALID)
        (= name "%UnboxObject")
          (if (and (jsl-check-dyn-type? arg)
                   (!= (& (jsl-check-dyn-tags arg)
                          TAG-OBJECT)
                       0))
              JSL-CHECK-TY-RAW-OBJECT
              JSL-CHECK-TY-INVALID)
        (= name "%UnboxObjectLike")
          (if (and (jsl-check-dyn-type? arg)
                   (!= (& (jsl-check-dyn-tags arg)
                          (primitive/ior TAG-OBJECT
                                         (primitive/ior TAG-FUNCTION
                                                        TAG-ARRAY)))
                       0))
              JSL-CHECK-TY-RAW-OBJECT
              JSL-CHECK-TY-INVALID)
        (= name "%UnboxArray")
          (if (and (jsl-check-dyn-type? arg)
                   (!= (& (jsl-check-dyn-tags arg)
                          TAG-ARRAY)
                       0))
              JSL-CHECK-TY-RAW-ARRAY
              JSL-CHECK-TY-INVALID)
        (= name
           "%UnboxSymbol")
          (if (and (jsl-check-dyn-type? arg)
                   (!= (& (jsl-check-dyn-tags arg)
                          TAG-SYMBOL)
                       0))
              JSL-CHECK-TY-RAW-SYMBOL
              JSL-CHECK-TY-INVALID)
        (= name
           "%ArrayLen")
          (if (= arg
                 JSL-CHECK-TY-RAW-ARRAY)
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        (= name
           "%StringLength")
          (if (= arg
                 JSL-CHECK-TY-RAW-STRING)
              JSL-CHECK-TY-INT
              JSL-CHECK-TY-INVALID)
        ;; The throw half of an abrupt completion: the value goes to the pending
        ;; word and the result is the exception sentinel.
        (= name
           "%SetPendingException")
          (if (jsl-check-completion-free? arg)
              (jsl-check-dyn-type TAG-EXCEPTION)
              JSL-CHECK-TY-INVALID)
        ;; A function object's FUNCTION-FLAG-* word (aot.shape): the callee must be
        ;; proven a function, as for %CallFunction.
        ;; `%ClosureEnv`: a proven function object's environment word, what
        ;; `%MakeClosure` stored.
        ;; `%ArgumentCountInt`: the callable ABI's count as an int; `%ArrayArgumentCount`:
        ;; an array's length as that count.
        (or (= name
               "%FunctionFlags")
            (= name
               "%ClosureEnv")
            (= name
               "%ArgumentCountInt")
            (= name
               "%ArrayArgumentCount"))
          (cond (= name
                   "%ArgumentCountInt")
                  (if (= arg
                         JSL-CHECK-TY-ARGUMENT-COUNT)
                      JSL-CHECK-TY-INT
                      JSL-CHECK-TY-INVALID)
                (= name
                   "%ArrayArgumentCount")
                  (if (= arg
                         JSL-CHECK-TY-RAW-ARRAY)
                      JSL-CHECK-TY-ARGUMENT-COUNT
                      JSL-CHECK-TY-INVALID)
                (= arg
                   (jsl-check-dyn-type TAG-FUNCTION))
                  (if (= name
                         "%FunctionFlags")
                      JSL-CHECK-TY-INT
                      (jsl-check-dyn-type TAG-ANY))
                :else JSL-CHECK-TY-INVALID)
        (= name
           "%GetObjectPrototype")
          (if (= arg
                 JSL-CHECK-TY-RAW-OBJECT)
              (jsl-check-dyn-type (+ TAG-NULL
                                     (+ TAG-OBJECT
                                        (+ TAG-FUNCTION
                                           TAG-ARRAY))))
              JSL-CHECK-TY-INVALID)
        (or (= name
               "%UnboxFlt")
            (= name
               "%UnboxNumber"))
          (if (jsl-check-dyn-type? arg)
              JSL-CHECK-TY-FLT
              JSL-CHECK-TY-INVALID)
        (!= (jsl-tag-predicate name)
            0)
          (if (jsl-check-dyn-type? arg)
              JSL-CHECK-TY-BOOL
              JSL-CHECK-TY-INVALID)
        :else JSL-CHECK-TY-INVALID))
