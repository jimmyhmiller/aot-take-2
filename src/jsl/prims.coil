;; The JSL primitive table: the `%Name` forms and what each lowers to.

;;
;; A primitive is admitted ONLY if it is a machine or runtime capability — something the graph
;; cannot express in terms of other nodes. `%StringConcat` qualifies. `Array.prototype.map` does
;; not, and is a JSL definition built out of primitives.
;;
;; This is the boundary that keeps the opcode count tied to the MACHINE surface (about sixty
;; operations) instead of the ECMAScript surface (about a thousand builtins). Every primitive added
;; here is a permanent cost in `aot.node.jsops`; every definition added to `jsl/` is free.
;;
;; The checker REFUSES BY NAME anything it cannot lower, rather than accepting it and producing a
;; graph that is wrong in a way nothing checks.
;;
;; The table is intentionally admission-based: a name appears only when its node, target lowering,
;; runtime ABI, and tests all exist. The broader JSL corpus may mention future capabilities, but the
;; production checker receives zero here and refuses them instead of manufacturing a partial graph.
(module aot.jsl.prims)
(import "aot.node.jsops" :use *)

;; Look up `%Name`. Returns the `aot.node.jsops` primitive index, or 0 for "not a primitive".
(defn prim-lookup [(name (slice u8))] (-> i64)
  (if (= name "%StringLen")
      JS-STRING-LEN
      (if (= name "%StringConcat")
      JS-STRING-CONCAT
      (if (= name "%StringCharCode")
      JS-STRING-CHARCODE
      (if (= name "%StringEq")
      JS-STRING-EQ
      (if (= name "%StringCompare")
      JS-STRING-COMPARE
      (if (= name "%GetPrototype")
      JS-GET-PROTOTYPE
      (if (= name "%SetPrototype")
      JS-SET-PROTOTYPE
      (if (= name "%ThrowTypeError")
      JS-THROW-TYPE-ERROR
      (if (= name "%TrapToPrimitive")
      JS-TRAP-TO-PRIMITIVE
      (if (= name "%TrapToString")
      JS-TRAP-TO-STRING
      (if (= name "%TrapStringToNumber")
      JS-TRAP-STRING-TO-NUMBER
      (if (= name "%TrapNoRealm")
      JS-TRAP-NO-REALM
      (if (= name "%TrapKeyedAccess")
      JS-TRAP-KEYED-ACCESS
      (if (= name "%TrapUnresolvedGlobal")
      JS-TRAP-UNRESOLVED-GLOBAL
      0)))))))))))))))

(defn prim-arity [(prim i64)] (-> i64)
  (case prim
        JS-STRING-LEN 1
        JS-STRING-CONCAT 2
        JS-STRING-CHARCODE 2
        JS-STRING-EQ 2
        JS-STRING-COMPARE 2
        JS-GET-PROTOTYPE 1
        JS-SET-PROTOTYPE 2
        JS-THROW-TYPE-ERROR 0
        JS-TRAP-TO-PRIMITIVE 0
        JS-TRAP-TO-STRING 0
        JS-TRAP-STRING-TO-NUMBER 0
        JS-TRAP-NO-REALM 0
        JS-TRAP-KEYED-ACCESS 0
        JS-TRAP-UNRESOLVED-GLOBAL 0
        0))

;; Does this primitive transition — may it call back into JavaScript or move the heap? Torque's
;; `transitioning`, and here it is exactly the question of where a Safepoint goes and which
;; references it relocates.
(defn prim-transitioning? [(prim i64)] (-> bool)
  (jsop-transitioning? prim))
