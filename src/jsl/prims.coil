;; The JSL primitive table: the `%Name` forms and what each lowers to.

;;
;; A primitive is admitted ONLY if it is a machine or runtime capability — something the graph
;; cannot express in terms of other nodes. `%StringConcat` qualifies. `Array.prototype.map` does
;; not, and is a JSL definition built out of primitives.
;;
;; This is the boundary that keeps the opcode count tied to the MACHINE surface (about sixty
;; operations) instead of the ECMAScript surface (about a thousand builtins). Every primitive added
;; here is a permanent cost in `aot.node.jsops`; every definition added to `jsl/` is free.
;;
;; The checker REFUSES BY NAME anything it cannot lower, rather than accepting it and producing a
;; graph that is wrong in a way nothing checks.
;;
;; The table is intentionally admission-based: a name appears only when its node, target lowering,
;; runtime ABI, and tests all exist. The broader JSL corpus may mention future capabilities, but the
;; production checker receives zero here and refuses them instead of manufacturing a partial graph.
(module aot.jsl.prims)
(import "aot.node.jsops" :use *)

(defn prim-global-lexical-lookup [(name (slice u8))] (-> i64)
  (cond (= name "%GlobalLexicalFind") JS-GLOBAL-LEXICAL-FIND
        (= name "%GlobalLexicalCreate") JS-GLOBAL-LEXICAL-CREATE
        (= name "%GlobalLexicalState") JS-GLOBAL-LEXICAL-STATE
        (= name "%GlobalLexicalValue") JS-GLOBAL-LEXICAL-VALUE
        (= name "%GlobalLexicalInitialize") JS-GLOBAL-LEXICAL-INITIALIZE
        (= name "%GlobalLexicalStore") JS-GLOBAL-LEXICAL-STORE
        :else 0))

;; Look up `%Name`. Returns the `aot.node.jsops` primitive index, or 0 for "not a primitive".
(defn prim-lookup [(name (slice u8))] (-> i64)
  (cond (= name "%StringLen") JS-STRING-LEN
        (= name "%StringConcat") JS-STRING-CONCAT
        (= name "%StringCharCode") JS-STRING-CHARCODE
        (= name "%StringEq") JS-STRING-EQ
        (= name "%StringCompare") JS-STRING-COMPARE
        (= name "%GetPrototype") JS-GET-PROTOTYPE
        (= name "%SetPrototype") JS-SET-PROTOTYPE
        (= name "%ThrowTypeError") JS-THROW-TYPE-ERROR
        (= name "%TrapToPrimitive") JS-TRAP-TO-PRIMITIVE
        (= name "%TrapToString") JS-TRAP-TO-STRING
        (= name "%StringToNumber") JS-STRING-TO-NUMBER
        (= name "%TrapNoRealm") JS-TRAP-NO-REALM
        (= name "%TrapInvariant") JS-TRAP-INVARIANT
        (= name
           "%KeyArrayIndex")
          JS-KEY-ARRAY-INDEX
        (= name
           "%PropDelete")
          JS-PROP-DELETE
        (= name
           "%ArrayDeleteIndex")
          JS-ARRAY-DELETE
        (= name
           "%ObjectOwnNames")
          JS-OBJECT-OWN-NAMES
        (= name
           "%ArgumentTail")
          JS-ARGUMENT-TAIL
        (= name
           "%TrapDynamicCode")
          JS-TRAP-DYNAMIC-CODE
        (= name
           "%ObjectKeys")
          JS-OBJECT-KEYS
        (= name
           "%TrapKeyedAccess")
          JS-TRAP-KEYED-ACCESS
        (= name
           "%TrapUnresolvedGlobal")
          JS-TRAP-UNRESOLVED-GLOBAL
        (= name
           "%NumberToString")
          JS-NUMBER-TO-STRING
        (= name
           "%TrapToObject")
          JS-TRAP-TO-OBJECT
        (= name
           "%InternKey")
          JS-INTERN-KEY
        (= name
           "%Substring")
          JS-SUBSTRING
        (= name
           "%StringFromCharCode")
          JS-STRING-FROMCODE
        (= name
           "%NewSymbol")
          JS-SYMBOL-NEW
        (= name
           "%SymbolDescription")
          JS-SYMBOL-DESCRIPTION
        (= name
           "%SymbolKey")
          JS-SYMBOL-KEY
        (= name
           "%DateNow")
          JS-DATE-NOW
        (= name
           "%LocalTimeZoneOffset")
          JS-LOCAL-TZ-OFFSET
        (= name
           "%HostWrite")
          JS-HOST-WRITE
        (= name
           "%NewArray")
          JS-ARRAY-NEW
        (= name
           "%ArrayLoad")
          JS-ARRAY-LOAD
        (= name
           "%ArrayHasIndex")
          JS-ARRAY-HAS
        (= name
           "%ArrayStore")
          JS-ARRAY-STORE
        (= name
           "%ArraySetLength")
          JS-ARRAY-SET-LENGTH
        (= name
           "%ArrayIndexOfString")
          JS-ARRAY-INDEX-OF-STRING
        (= name
           "%MathUnary")
          JS-MATH-UNARY
        (= name
           "%MathBinary")
          JS-MATH-BINARY
        (= name
           "%MathRandom")
          JS-MATH-RANDOM
        (= name
           "%ParseInt")
          JS-PARSE-INT
        (= name
           "%ParseFloat")
          JS-PARSE-FLOAT
        (= name
           "%PropAttributes")
          JS-PROP-ATTRIBUTES
        (= name
           "%PropDefine")
          JS-PROP-DEFINE
        (= name
           "%ObjectIntegrity")
          JS-OBJECT-INTEGRITY
        (= name
           "%PreventExtensions")
          JS-PREVENT-EXTENSIONS
        (= name
           "%IsExtensible")
          JS-IS-EXTENSIBLE
        (= name
           "%TestIntegrity")
          JS-TEST-INTEGRITY
        :else (prim-global-lexical-lookup name)))

(defn prim-arity [(prim i64)] (-> i64)
  (case prim JS-GLOBAL-LEXICAL-FIND
        1 JS-GLOBAL-LEXICAL-CREATE
        2 JS-GLOBAL-LEXICAL-STATE
        1 JS-GLOBAL-LEXICAL-VALUE
        1 JS-GLOBAL-LEXICAL-INITIALIZE
        2 JS-GLOBAL-LEXICAL-STORE
        2 JS-STRING-LEN
        1 JS-STRING-CONCAT
        2 JS-STRING-CHARCODE
        2 JS-STRING-EQ
        2 JS-STRING-COMPARE
        2 JS-GET-PROTOTYPE
        1 JS-SET-PROTOTYPE
        2 JS-THROW-TYPE-ERROR
        0 JS-TRAP-TO-PRIMITIVE
        0 JS-TRAP-TO-STRING
        0 JS-STRING-TO-NUMBER
        1 JS-TRAP-NO-REALM
        0 JS-TRAP-INVARIANT
        0 JS-TRAP-DYNAMIC-CODE
        0 JS-KEY-ARRAY-INDEX
        1 JS-PROP-DELETE
        2 JS-ARRAY-DELETE
        2 JS-OBJECT-KEYS
        2 JS-OBJECT-OWN-NAMES
        2 JS-ARGUMENT-TAIL
        1 JS-TRAP-KEYED-ACCESS
        0 JS-TRAP-UNRESOLVED-GLOBAL
        1 JS-NUMBER-TO-STRING
        1 JS-TRAP-TO-OBJECT
        0 JS-INTERN-KEY
        1 JS-SUBSTRING
        3 JS-STRING-FROMCODE
        1 JS-SYMBOL-NEW
        1 JS-SYMBOL-DESCRIPTION
        1 JS-SYMBOL-KEY
        1 JS-DATE-NOW
        0 JS-LOCAL-TZ-OFFSET
        1 JS-HOST-WRITE
        2 JS-ARRAY-NEW
        2 JS-ARRAY-LOAD
        2 JS-ARRAY-HAS
        2 JS-ARRAY-STORE
        3 JS-ARRAY-SET-LENGTH
        2 JS-ARRAY-INDEX-OF-STRING
        1 JS-MATH-UNARY
        2 JS-MATH-BINARY
        3 JS-MATH-RANDOM
        0 JS-PARSE-INT
        2 JS-PARSE-FLOAT
        1 JS-PROP-ATTRIBUTES
        2 JS-PROP-DEFINE
        5 JS-OBJECT-INTEGRITY
        2 JS-PREVENT-EXTENSIONS
        1 JS-IS-EXTENSIBLE
        1 JS-TEST-INTEGRITY
        2 0))

;; Does this primitive transition — may it call back into JavaScript or move the heap? Torque's
;; `transitioning`, and here it is exactly the question of where a Safepoint goes and which
;; references it relocates.
(defn prim-transitioning? [(prim i64)] (-> bool)
  (jsop-transitioning? prim))
