;; The JSL checker.

;;
;; Its most important behaviour is REFUSING BY NAME. A construct the lowering cannot handle is
;; reported with its own name and location, and the build fails. It is never accepted and lowered
;; to something approximate: an approximate lowering of an ECMA-262 abstract operation is a
;; specification violation that nothing downstream can detect, because the graph it produces is a
;; perfectly valid graph computing the wrong thing.
;;
;; Diagnostics are RANGED — they carry the source span — because a JSL unit is a specification
;; transcription and "somewhere in this 200-line builtin" is not an actionable report.
;;
;; STATUS: the currently lowerable JSL core is checked here. A form must have the exact `builtin`
;; declaration shape; parameters and returns must use the admitted dyn/int/bool/float families;
;; parameter and lexical-let references must resolve; `if`, `let`, primitives, and indexed calls
;; must have exact arity; and every expression is checked against the real raw/dynamic operand and
;; result families consumed by lowering. Tag-test branches refine the named dynamic value on both
;; arms before checking guarded expressions. Everything else exits through the ranged `jsl-refuse`
;; diagnostic. This is intentionally an admission boundary for the implemented JSL vocabulary,
;; not a claim that the complete runtime-library language is already accepted.
(module aot.jsl.check)
(import "aot.util.arena" :use [compiler-allocator])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.reader" :as rd)
(import "coil.os" :as os)
(import "aot.util.panic" :use *)
(import "aot.jsl.reader" :use *)
(import "aot.jsl.decls" :use *)
(import "coil.slice" :use [subslice])
(import "aot.type.type" :use *)
(import "aot.jsl.check.types" :use * :reexport)
(import "aot.jsl.check.primitive" :use * :reexport)
(import "aot.jsl.check.expr" :use * :reexport)

;; A builtin an intrinsic names as a function body: a `builtin` (a macro has no function object to
;; be), over the boxed slot ABI (every parameter `dyn`), taking at least the fixed receiver prefix.
(defn jsl-check-intrinsic-body [(name (slice u8))
                                (prefix i64)
                                (lo i64)
                                (hi i64)] (-> i64)
  (match (jsl-definition-form name)
    (None [] (jsl-refuse-in "intrinsic names an undefined builtin" name lo hi))
    (Some [form]
          (if (jsl-form-macro? form)
              (jsl-refuse-in "intrinsic body must be a builtin, not a macro"
                             name
                             lo
                             hi)
              (let [params (jsl-form-params form)
                    abi (jsl-definition-abi? name)
                    (mut i) 0]
                (if (< (rd/sexp-count params) prefix)
                    (jsl-refuse-in "intrinsic body lacks its receiver parameters"
                                   name
                                   lo
                                   hi)
                    0)
                (loop (if (>= (load i) (rd/sexp-count params))
                          (break 0)
                          (let [p (rd/sexp-nth params (load i))]
                            ;; An ABI body's count and vector have their ABI kinds; every other parameter is dyn.
                            (if (and (not (and abi
                                               (or (= (load i) 3)
                                                   (= (load i) 4))))
                                     (!= (jsl-check-type-name (rd/sexp-nth p 1))
                                         (jsl-check-dyn-type TAG-ANY)))
                                (jsl-refuse-in "intrinsic body parameters are all dyn"
                                               name
                                               lo
                                               hi)
                                0)
                            (set! (mut i) (+ (load i) 1))
                            (continue)))))))))

;; `(intrinsic ...)` (src/jsl/decls.coil): the reader proves the shape; this proves every name it
;; mentions. Its root and each (target, key) are unique, its parent is declared before it, and
;; each builtin exists with the body shape its position calls it with.
;; Does the root symbol `%Name%` spell `name`?
(defn jsl-check-intrinsic-root-is? [(sym (ptr rd/Sexp)) (name (slice u8))] (-> bool)
  (let [s (rd/sexp-sym sym)]
    (and (= (len s) (+ (len name) 2))
         (= (subslice [u8] s 1 (- (len s) 1)) name))))

(defn jsl-check-intrinsic-form [(form (ptr rd/Sexp))] (-> i64)
  (let [decl (jsl-read-intrinsic (compiler-allocator) form)
        (mut seen-self) false
        (mut parent-found) false
        (mut unit) 1
        (mut i) 0]
    ;; One pass over the loaded forms, comparing root symbols without decoding other declarations:
    ;; a root named twice is a duplicate, and the parent must be a constructor seen before `form`.
    (loop (if (> (load unit) (jsl-unit-count))
              (break 0)
              (do
                (set! (mut i) 0)
                (loop (if (>= (load i) (jsl-form-count (load unit)))
                          (break 0)
                          (let [other (jsl-form (load unit) (load i))]
                            (if (jsl-form-intrinsic? other)
                                (let [same (= other form)
                                      name (rd/sexp-nth other 1)]
                                  (if (and (rd/sexp-sym? name)
                                           (= (rd/sexp-sym (rd/sexp-nth form 1))
                                              (rd/sexp-sym name)))
                                      (if (and same (not (load seen-self)))
                                          (set! (mut seen-self) true)
                                          (jsl-refuse-in "duplicate intrinsic declaration"
                                                         (.name decl)
                                                         (.lo form)
                                                         (.hi form)))
                                      0)
                                  (if (and (!= (.parent decl) "")
                                           (not (load seen-self))
                                           (rd/sexp-sym? name)
                                           (jsl-check-intrinsic-root-is? name
                                                                         (.parent decl))
                                           (>= (jsl-form-option other
                                                                "constructor")
                                               0))
                                      (set! (mut parent-found) true)
                                      0))
                                0)
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (set! (mut unit) (+ (load unit) 1))
                (continue))))
    (if (and (!= (.parent decl) "") (not (load parent-found)))
        (jsl-refuse-in "intrinsic parent is not a constructor declared before it"
                       (.name decl)
                       (.lo form)
                       (.hi form))
        0)
    (if (!= (.kind decl) JSL-INTRINSIC-NAMESPACE)
        (jsl-check-intrinsic-body (.builtin decl) 3 (.lo form) (.hi form))
        0)
    (if (and (= (.kind decl) JSL-INTRINSIC-ENTRY)
             (not (jsl-definition-abi? (.builtin decl))))
        (jsl-refuse-in "an intrinsic entry's builtin takes the whole callable ABI"
                       (.name decl)
                       (.lo form)
                       (.hi form))
        0)
    (set! (mut i) 0)
    (loop (if (>= (load i) (len (.props decl)))
              (break 0)
              (let [prop (get (.props decl) (load i))
                    (mut j) 0]
                (loop (if (>= (load j) (load i))
                          (break 0)
                          (let [prior (get (.props decl) (load j))]
                            (if (and (= (.target prior) (.target prop))
                                     (= (.key prior) (.key prop)))
                                (jsl-refuse-in "duplicate intrinsic property"
                                               (.key prop)
                                               (.lo prop)
                                               (.hi prop))
                                0)
                            (set! (mut j) (+ (load j) 1))
                            (continue))))
                ;; A getter is called with only its receiver, which is the same one-value prefix a
                ;; method's builtin takes.
                (if (or (= (.kind prop) JSL-INTRINSIC-METHOD)
                        (= (.kind prop) JSL-INTRINSIC-ACCESSOR))
                    (jsl-check-intrinsic-body (.closure prop)
                                              1
                                              (.lo prop)
                                              (.hi prop))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    0))

(defn jsl-check-form [(form (ptr rd/Sexp))] (-> i64)
  (if (jsl-form-intrinsic? form)
      (jsl-check-intrinsic-form form)
      (jsl-check-definition-form form)))

(defn jsl-check-definition-form [(form (ptr rd/Sexp))] (-> i64)
  (do
    ;; Boolean flags and an optional specialization/inline guard vector precede :params/:ret/body.
    (if (or (not (rd/sexp-list? form))
            (not (or (= (rd/sexp-count form) 7)
                     (= (rd/sexp-count form) 9)
                     (= (rd/sexp-count form) 11)
                     (= (rd/sexp-count form) 13)
                     (= (rd/sexp-count form) 15))))
        (jsl-refuse "definition declaration shape" (.lo form) (.hi form))
        0)
    (let [kind (rd/sexp-nth form 0)
          name (rd/sexp-nth form 1)
          transitioning (jsl-form-option form "transitioning")
          noinline (jsl-form-option form "noinline")
          throws (jsl-form-option form "throws")
          source-specialize (jsl-form-option form "specialize")
          inline-when (jsl-form-option form "inline-when")
          specialize (if (>= source-specialize 0) source-specialize inline-when)
          options
            (+ (if (>= transitioning 0) 1 0)
               (+ (if (>= noinline 0) 1 0)
                  (+ (if (>= throws 0) 1 0)
                     (+ (if (>= source-specialize 0) 1 0)
                        (if (>= inline-when 0) 1 0)))))
          params (jsl-form-params form)
          ret (jsl-form-ret form)
          body (jsl-form-body form)]
      (if (not (or (rd/sexp-sym-is kind "builtin")
                   (rd/sexp-sym-is kind "macro")))
          (jsl-refuse "top-level form" (.lo kind) (.hi kind))
          0)
      (if (not (rd/sexp-sym? name))
          (jsl-refuse "definition name" (.lo name) (.hi name))
          0)
      (if (and (rd/sexp-sym? name)
               (!= (jsl-definition-count (rd/sexp-sym name)) 1))
          (jsl-refuse "duplicate JSL definition" (.lo name) (.hi name))
          0)
      ;; Every option present is one key/value pair before `:params`, and nothing else is.
      (if (!= (rd/sexp-count form) (+ 7 (* 2 options)))
          (jsl-refuse "definition option shape" (.lo form) (.hi form))
          0)
      (if (and (>= transitioning 0)
               (or (>= transitioning (+ 2 (* 2 options)))
                   (not (rd/sexp-sym-is (rd/sexp-nth form transitioning) "true"))))
          (jsl-refuse ":transitioning true" (.lo form) (.hi form))
          0)
      (if (and (>= noinline 0)
               (or (>= noinline (+ 2 (* 2 options)))
                   (not (rd/sexp-sym-is (rd/sexp-nth form noinline) "true"))))
          (jsl-refuse ":noinline true" (.lo form) (.hi form))
          0)
      (if (and (>= throws 0)
               (or (>= throws (+ 2 (* 2 options)))
                   (not (rd/sexp-sym-is (rd/sexp-nth form throws) "true"))))
          (jsl-refuse ":throws true" (.lo form) (.hi form))
          0)
      (if (not (rd/sexp-vec? params))
          (jsl-refuse "parameter vector" (.lo params) (.hi params))
          0)
      (if (and (rd/sexp-vec? params) (not (jsl-check-params-unique? params)))
          (jsl-refuse "duplicate parameter name" (.lo params) (.hi params))
          0)
      (if (not (jsl-admitted-type? ret))
          (jsl-refuse "return type" (.lo ret) (.hi ret))
          0)
      (let [(mut i) 0]
        (loop (if (>= (load i) (rd/sexp-count params))
                  (break 0)
                  (let [p (rd/sexp-nth params (load i))]
                    (if (not (and (rd/sexp-list? p) (= (rd/sexp-count p) 2)))
                        (jsl-refuse "parameter declaration" (.lo p) (.hi p))
                        0)
                    (if (not (and (rd/sexp-sym? (rd/sexp-nth p 0))
                                  (jsl-admitted-type? (rd/sexp-nth p 1))))
                        (jsl-refuse "parameter type" (.lo p) (.hi p))
                        0)
                    (set! (mut i) (+ (load i) 1))
                    (continue)))))
      (if (>= specialize 0)
          (do
            (if (and (>= source-specialize 0) (>= inline-when 0))
                (jsl-refuse "choose source specialization or guarded graph inlining, not both"
                            (.lo form)
                            (.hi form))
                0)
            (if (or (jsl-form-macro? form)
                    (>= noinline 0)
                    (>= specialize (+ 2 (* 2 options))))
                (jsl-refuse "specialization or guarded inlining requires a builtin without noinline"
                            (.lo form)
                            (.hi form))
                0)
            (let [rules (rd/sexp-nth form specialize)
                  (mut i) 0]
              (if (or (not (rd/sexp-vec? rules)) (= (rd/sexp-count rules) 0))
                  (jsl-refuse "nonempty specialization predicate vector"
                              (.lo rules)
                              (.hi rules))
                  0)
              (loop (if (>= (load i) (rd/sexp-count rules))
                        (break 0)
                        (let [rule (rd/sexp-nth rules (load i))]
                          (if (rd/sexp-vec? rule)
                              (let [n (rd/sexp-count rule)
                                    (mut k) 0]
                                (if (= n 0)
                                    (jsl-refuse "nonempty all-of specialization rule"
                                                (.lo rule)
                                                (.hi rule))
                                    0)
                                (loop (if (>= (load k) n)
                                          (break 0)
                                          (do
                                            (jsl-check-specialization-predicate! (rd/sexp-nth rule
                                                                                              (load k))
                                                                                 params
                                                                                 body)
                                            (set! (mut k) (+ (load k) 1))
                                            (continue)))))
                              (jsl-check-specialization-predicate! rule
                                                                   params
                                                                   body))
                          (set! (mut i) (+ (load i) 1))
                          (continue))))))
          0)
      (jsl-check-expr body params)
      (if (and (jsl-expr-transitioning? body)
               (not (jsl-form-transitioning? form)))
          (jsl-refuse "transitioning body requires :transitioning true"
                      (.lo body)
                      (.hi body))
          0)
      (let [actual (jsl-check-expr-type body params)
            expected (jsl-check-ret-type form)]
        (cond (= actual JSL-CHECK-TY-INVALID)
                (jsl-refuse-in "expression operand type"
                               (rd/sexp-sym name)
                               (.lo body)
                               (.hi body))
              (and (jsl-check-may-throw? actual)
                   (not (jsl-form-throws? form)))
                (jsl-refuse-in "throwing body requires :throws true"
                               (rd/sexp-sym name)
                               (.lo body)
                               (.hi body))
              (not (jsl-check-type-assignable? actual expected))
                (jsl-refuse-in "body/return type"
                               (rd/sexp-sym name)
                               (.lo body)
                               (.hi body))
              :else 0)))))

(defn jsl-check-unit [(unit i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (jsl-form-count unit))
              (break 0)
              (do
                (jsl-check-form (jsl-form unit (load i)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load i)))

;; Report a refusal inside a named definition.
(defn jsl-refuse-in [(what (slice u8))
                     (definition (slice u8))
                     (start i64)
                     (end i64)] (-> i64)
  (do
    (p--str "\naot: JSL REFUSED: ")
    (p--str what)
    (p--str " in ")
    (p--str definition)
    (p--str " [")
    (p--int start)
    (p--str "..")
    (p--int end)
    (p--str "]\n")
    (os/_exit (primitive/cast i32 EXIT-PANIC))
    0))

;; Report a refusal, naming the construct and its span.
(defn jsl-refuse [(what (slice u8)) (start i64) (end i64)] (-> i64)
  (do
    (p--str "\naot: JSL REFUSED: ")
    (p--str what)
    (p--str " [")
    (p--int start)
    (p--str "..")
    (p--int end)
    (p--str "]\n")
    (os/_exit (primitive/cast i32 EXIT-PANIC))
    0))
