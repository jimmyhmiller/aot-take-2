;; The JSL checker.

;;
;; Its most important behaviour is REFUSING BY NAME. A construct the lowering cannot handle is
;; reported with its own name and location, and the build fails. It is never accepted and lowered
;; to something approximate: an approximate lowering of an ECMA-262 abstract operation is a
;; specification violation that nothing downstream can detect, because the graph it produces is a
;; perfectly valid graph computing the wrong thing.
;;
;; Diagnostics are RANGED — they carry the source span — because a JSL unit is a specification
;; transcription and "somewhere in this 200-line builtin" is not an actionable report.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S5.
(module aot.jsl.check)
(import "aot.util.panic" :use *)

(defn jsl-check-unit [(unit i64)] (-> i64)
  (do (unimplemented "jsl-check-unit" "S5 — src/jsl/check.coil") 0))

;; Report a refusal, naming the construct and its span.
(defn jsl-refuse [(what (slice u8)) (start i64) (end i64)] (-> i64)
  (do (unimplemented "jsl-refuse" "S5 — src/jsl/check.coil") 0))
