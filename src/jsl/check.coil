;; The JSL checker.

;;
;; Its most important behaviour is REFUSING BY NAME. A construct the lowering cannot handle is
;; reported with its own name and location, and the build fails. It is never accepted and lowered
;; to something approximate: an approximate lowering of an ECMA-262 abstract operation is a
;; specification violation that nothing downstream can detect, because the graph it produces is a
;; perfectly valid graph computing the wrong thing.
;;
;; Diagnostics are RANGED — they carry the source span — because a JSL unit is a specification
;; transcription and "somewhere in this 200-line builtin" is not an actionable report.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S5.
(module aot.jsl.check)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.reader" :as rd)
(import "coil.os" :as os)
(import "aot.util.panic" :use *)
(import "aot.jsl.reader" :use *)

(defn jsl-symbol-in-params? [(params (ptr rd/Sexp)) (name (slice u8))] (-> bool)
  (let [(mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) (rd/sexp-count params)))
              (break 0)
              (let [p (rd/sexp-nth params (load i))]
                (if (and (rd/sexp-list? p)
                         (and (= (rd/sexp-count p) 2)
                              (and (rd/sexp-sym? (rd/sexp-nth p 0))
                                   (= (rd/sexp-sym (rd/sexp-nth p 0)) name))))
                    (set! (mut found) true)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

(defn jsl-symbol-in-locals? [(locals (ArrayList (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut i) (- (len locals) 1)]
    (loop (if (< (load i) 0)
              (break false)
              (if (= (get locals (load i)) name)
                  (break true)
                  (do (set! (mut i) (- (load i) 1)) (continue)))))))

(defn jsl-check-expr-in [(x (ptr rd/Sexp))
                         (params (ptr rd/Sexp))
                         (locals (mut (ArrayList (slice u8))))] (-> i64)
  (if (rd/sexp-sym? x)
      (if (or (jsl-symbol-in-params? params (rd/sexp-sym x))
              (jsl-symbol-in-locals? (load locals) (rd/sexp-sym x)))
          0
          (jsl-refuse (rd/sexp-sym x) (.lo x) (.hi x)))
      (if (not (rd/sexp-list? x))
          (jsl-refuse "non-list expression" (.lo x) (.hi x))
          (if (= (rd/sexp-count x) 0)
              (jsl-refuse "empty expression" (.lo x) (.hi x))
              (let [head (rd/sexp-nth x 0)]
                (if (not (rd/sexp-sym? head))
                    (jsl-refuse "non-symbol callee" (.lo head) (.hi head))
                    (let [name (rd/sexp-sym head)]
                      (if (= name "if")
                          (if (!= (rd/sexp-count x) 4)
                              (jsl-refuse "if arity" (.lo x) (.hi x))
                              (do
                                (jsl-check-expr-in (rd/sexp-nth x 1) params (mut locals))
                                (jsl-check-expr-in (rd/sexp-nth x 2) params (mut locals))
                                (jsl-check-expr-in (rd/sexp-nth x 3) params (mut locals))))
                          (if (= name "let")
                              (if (!= (rd/sexp-count x) 3)
                                  (jsl-refuse "let arity" (.lo x) (.hi x))
                                  (let [bindings (rd/sexp-nth x 1)
                                        base (len (load locals))]
                                    (if (not (rd/sexp-vec? bindings))
                                        (jsl-refuse "let bindings" (.lo bindings) (.hi bindings))
                                        0)
                                    (let [(mut i) 0]
                                      (loop (if (>= (load i) (rd/sexp-count bindings))
                                                (break 0)
                                                (let [binding (rd/sexp-nth bindings (load i))]
                                                  (if (not (and (rd/sexp-list? binding)
                                                                (= (rd/sexp-count binding) 2)))
                                                      (jsl-refuse "let binding" (.lo binding) (.hi binding))
                                                      0)
                                                  (let [local (rd/sexp-nth binding 0)]
                                                    (if (not (rd/sexp-sym? local))
                                                        (jsl-refuse "let name" (.lo local) (.hi local))
                                                        0)
                                                    (jsl-check-expr-in (rd/sexp-nth binding 1)
                                                                       params
                                                                       (mut locals))
                                                    (push! [(slice u8)]
                                                           (mut locals)
                                                           (rd/sexp-sym local)))
                                                  (set! (mut i) (+ (load i) 1))
                                                  (continue))))
                                      (jsl-check-expr-in (rd/sexp-nth x 2) params (mut locals))
                                      (loop (if (<= (len (load locals)) base)
                                                (break 0)
                                                (do (pop! (mut locals)) (continue))))
                                      0)))
                              (let [expected
                                      (if (or (= name "%Sub") (= name "%Add") (= name "%Mul"))
                                          3
                                          (if (or (= name "%Box") (= name "%UnboxInt"))
                                              2
                                              (let [arity (jsl-definition-arity name)]
                                                (if (< arity 0) 0 (+ arity 1)))))]
                                (if (= expected 0)
                                    (jsl-refuse name (.lo head) (.hi head))
                                    (if (!= (rd/sexp-count x) expected)
                                        (jsl-refuse "wrong primitive arity" (.lo x) (.hi x))
                                        (let [(mut i) 1]
                                          (loop (if (>= (load i) expected)
                                                    (break 0)
                                                    (do
                                                      (jsl-check-expr-in (rd/sexp-nth x (load i))
                                                                         params
                                                                         (mut locals))
                                                      (set! (mut i) (+ (load i) 1))
                                                      (continue)))))))))))))))))

(defn jsl-check-expr [(x (ptr rd/Sexp)) (params (ptr rd/Sexp))] (-> i64)
  (let [(mut locals) (al-new [(slice u8)] (alloc/malloc-allocator))]
    (jsl-check-expr-in x params (mut locals))))

(defn jsl-check-form [(form (ptr rd/Sexp))] (-> i64)
  (do
    (if (or (not (rd/sexp-list? form)) (!= (rd/sexp-count form) 7))
        (jsl-refuse "builtin declaration shape" (.lo form) (.hi form))
        0)
    (let [kind (rd/sexp-nth form 0)
          name (rd/sexp-nth form 1)
          params-key (rd/sexp-nth form 2)
          params (rd/sexp-nth form 3)
          ret-key (rd/sexp-nth form 4)
          ret (rd/sexp-nth form 5)
          body (rd/sexp-nth form 6)]
      (if (not (rd/sexp-sym-is kind "builtin"))
          (jsl-refuse "top-level form" (.lo kind) (.hi kind))
          0)
      (if (not (rd/sexp-sym? name))
          (jsl-refuse "builtin name" (.lo name) (.hi name))
          0)
      (if (not (and (rd/sexp-kw? params-key) (= (rd/sexp-kw params-key) "params")))
          (jsl-refuse ":params" (.lo params-key) (.hi params-key))
          0)
      (if (not (rd/sexp-vec? params))
          (jsl-refuse "parameter vector" (.lo params) (.hi params))
          0)
      (if (not (and (rd/sexp-kw? ret-key) (= (rd/sexp-kw ret-key) "ret")))
          (jsl-refuse ":ret" (.lo ret-key) (.hi ret-key))
          0)
      (if (not (and (rd/sexp-sym? ret) (= (rd/sexp-sym ret) "dyn")))
          (jsl-refuse "return type" (.lo ret) (.hi ret))
          0)
      (let [(mut i) 0]
        (loop (if (>= (load i) (rd/sexp-count params))
                  (break 0)
                  (let [p (rd/sexp-nth params (load i))]
                    (if (not (and (rd/sexp-list? p) (= (rd/sexp-count p) 2)))
                        (jsl-refuse "parameter declaration" (.lo p) (.hi p))
                        0)
                    (if (not (and (rd/sexp-sym? (rd/sexp-nth p 0))
                                  (and (rd/sexp-sym? (rd/sexp-nth p 1))
                                       (= (rd/sexp-sym (rd/sexp-nth p 1)) "dyn"))))
                        (jsl-refuse "parameter type" (.lo p) (.hi p))
                        0)
                    (set! (mut i) (+ (load i) 1))
                    (continue)))))
      (jsl-check-expr body params))))

(defn jsl-check-unit [(unit i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (jsl-form-count unit))
              (break 0)
              (do
                (jsl-check-form (jsl-form unit (load i)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load i)))

;; Report a refusal, naming the construct and its span.
(defn jsl-refuse [(what (slice u8)) (start i64) (end i64)] (-> i64)
  (do
    (p--str "\naot: JSL REFUSED: ")
    (p--str what)
    (p--str " [")
    (p--int start)
    (p--str "..")
    (p--int end)
    (p--str "]\n")
    (os/_exit (primitive/cast i32 EXIT-PANIC))
    0))
