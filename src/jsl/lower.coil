;; JSL into the ideal graph.

;;
;; This is the file that earns the whole JSL design. A builtin lowered here is ORDINARY GRAPH: the
;; interpreter runs it, the backend compiles it, the inliner inlines it, and the optimiser
;; specialises it into the caller — with no per-builtin arm in any of them.
;;
;; The alternative, which this exists to avoid: a builtin as an opcode costs an arm in `compute`,
;; `idealize`, the verifier, the printer, the interpreter and instruction selection. That is ten
;; dispatch sites per builtin, in a language with about a thousand builtins.
;;
;; It is also what makes `arr.map(f)` fast with no JIT. V8 inlines the Torque-generated graph for
;; `map` and specialises it against the callback; under the closed-world assumption the callback
;; here is STATICALLY KNOWN, so the same inlining needs no speculation to justify it and has no
;; deoptimisation path to maintain.
;;
;; STATUS: the checker-admitted core lowers completely to this graph vocabulary. Integer literals,
;; parameters, lexical `let`, value-producing `if`, the admitted pure primitives, calls between JSL
;; definitions, and dynamic tag predicates all have concrete lowering. `if` threads control and
;; memory through both arms and joins differing values with a Region/Phi; a recognized tag test
;; installs edge-local Cast proof before an Unbox. Index loading is two-pass, so every declaration
;; receives its stable function identity before bodies resolve forward calls. Temporary Return
;; ownership, closed-world caller removal, and final compilation-unit retention follow the same Fun
;; lifetime protocol as source declarations.
;;
;; Structured exits (`:labels`/`goto`/`:otherwise`) and transitioning primitives are not admitted
;; by `aot.jsl.check` yet. Consequently `jsl-check-transitions` is truthfully empty for today's pure
;; graph set; admitting allocation or a callback requires its safepoint/relocation walk first.
(module aot.jsl.lower)
(import "aot.util.arena" :use [compiler-allocator compiler-state CompilerStateSlot])
(import "aot.codegen.callabi" :use *)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "coil.str" :as str)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.reader" :as rd)
(import "coil.slice" :use [slice-data slice-new])
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.call" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.bits" :use *)
(import "aot.node.compare" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.property" :use *)
(import "aot.rt.abi" :use *)
(import "aot.node.gc" :use *)
(import "aot.node.jsops" :use *)
(import "aot.shape" :use *)
(import "aot.heap" :use [heap-global-reference-entry heap-intrinsic-entry])
(import "aot.facts" :use [facts-ready?])
(import "aot.type.type" :use *)
(import "aot.jsl.reader" :use *)
(import "aot.jsl.check" :use *)
(import "aot.jsl.prims" :use *)

;; One JSL definition: its stable function index, and the arena id of its Fun once a use demanded
;; it (0 until then). Every definition in the index is declared for every compile, so indices are
;; the index's order; a graph is built and its body lowered only for a definition something calls
;; (docs/DECISIONS.md, JSL definitions are built on demand).
(defstruct JslGraph [(name (slice u8)) (nid i64) (fidx i64) (form (ptr rd/Sexp))])

;; `pending` holds the table positions of built graphs whose bodies are not yet lowered;
;; `closed` is set by `jsl-close-world!`, after which a new demand is an error.
(defstruct JslGraphs
  [(items (ArrayList JslGraph))
   (pending (ArrayList i64))
   (closed bool)
   (link-mode i64)
   (specialized-sites i64)
   (specialized-nodes i64)
   (booted bool)])

;; Optional graph growth has a compilation-wide budget, independent of arena growth. A residual
;; can be smaller than its shared callee and still add code to the compilation. The counters charge
;; actual construction (including subsequently dead nodes); exhausting either leaves generic calls.
(const JSL-SPECIALIZE-SITES 4096)
(const JSL-SPECIALIZE-NODES 262144)

(const JSL-LINK-LOCAL 0)
(const JSL-LINK-IMPORT 1)
(const JSL-LINK-PROVIDER 2)

;; The shared library exports explicit semantic boundaries, not caller-specialized functions.
;; Other builtins remain available for ordinary evidence-driven graph inlining.
(defn jsl-shared-definition? [(form (ptr rd/Sexp))] (-> bool)
  (or (>= (jsl-form-option form "noinline") 0) (>= (jsl-form-option form "specialize") 0)
      (>= (jsl-form-option form "inline-when") 0)))

(defn jsl-set-link-mode! [(mode i64)] (-> i64)
  (jsl-graphs-boot!)
  (if (or (< mode JSL-LINK-LOCAL) (> mode JSL-LINK-PROVIDER))
      (panic "jsl-set-link-mode!: invalid mode") 0)
  (set! (.link-mode (jsl-graphs)) mode) 0)

(defn jsl-form-result-type [(form (ptr rd/Sexp))] (-> i64)
  (let [checked (jsl-check-ret-type form)]
    (if (jsl-check-dyn-type? checked) (ty-dyn (jsl-check-dyn-tags checked))
        (jsl-lower-type (jsl-form-ret form)))))

(defn jsl-form-signature [(form (ptr rd/Sexp))] (-> i64)
  (let [(mut types) (al-new [i64] (compiler-allocator)) params (jsl-form-params form)
        (mut i) 0]
    (push! [i64] (mut types) (jsl-form-result-type form))
    (loop (if (>= (load i) (rd/sexp-count params)) (break 0)
      (do (push! [i64] (mut types) (jsl-lower-type (rd/sexp-nth (rd/sexp-nth params (load i)) 1)))
          (set! (mut i) (+ (load i) 1)) (continue))))
    (let [signature (ty-tuple (al-slice (load types)))]
      (al-free! (mut types)) signature)))

(defn jsl-call-target [(name (slice u8))] (-> (dyn NodeOps))
  (let [index (jsl-graph-index name)]
    (if (< index 0) (panic "jsl-call-target: unknown builtin") 0)
    (let [entry (get (.items (jsl-graphs)) index)]
      (if (and (= (.link-mode (jsl-graphs)) JSL-LINK-IMPORT) (jsl-shared-definition? (.form entry)))
          (external-make (arena-declare-external! (.fidx entry) name (jsl-form-signature (.form entry))))
          (funptr-make (jsl-graph-of name) (.fidx entry))))))

(defn jsl-root-provider! [(start (dyn NodeOps))] (-> i64)
  (al-for [entry (.items (jsl-graphs))]
    (let [e entry]
      (if (jsl-shared-definition? (.form e)) (do (jsl-graph-of (.name e)) 0) 0)))
  (jsl-define-pending!)
  (al-for [entry (.items (jsl-graphs))]
    (let [e entry]
      (if (jsl-shared-definition? (.form e))
          (let [fun (jsl-node (.nid e))]
            ;; Keep the external caller hook but attach every exported function to this unit's
            ;; canonical Start. Private JSL Starts normally disappear when the world closes.
            (n-set-def! fun 1 (Some start))
            (match (fun-mem-parm fun)
              (Some [mem] (parm-set-unknown-input! mem (proj-make start 1 "provider.start.mem")))
              (None [] (panic "jsl-root-provider!: missing memory parameter")))
            0) 0)))
  0)

(defn jsl-graphs [] (-> (ptr JslGraphs))
  (compiler-state [JslGraphs] (primitive/alloc-static CompilerStateSlot)))

(defn jsl-graphs-boot! [] (-> i64)
  (let [g (jsl-graphs)]
    (if (.booted g)
        0
        (do
          (set! (.items g) (al-new [JslGraph] (compiler-allocator)))
          (set! (.pending g) (al-new [i64] (compiler-allocator)))
          (set! (.closed g) false)
          (set! (.specialized-sites g) 0)
          (set! (.specialized-nodes g) 0)
          (set! (.booted g) true)
          0))))

;; The frontend owns the realm. A `%IntrinsicPrototype` reference is a demand for that constructor
;; (docs/DECISIONS.md, the realm is materialized by demand): the hook materializes it, if the realm
;; declares it, before the name is resolved. No realm or operation names enter this module.
;; The hook receives the name's bytes as a pointer and a length.
(defstruct JslIntrinsicDemand [(f (fnptr c [(ptr u8) i64] i64)) (installed bool)])

(defn jsl-intrinsic-demand [] (-> (ptr JslIntrinsicDemand))
  (compiler-state [JslIntrinsicDemand] (primitive/alloc-static CompilerStateSlot)))

(defn jsl-set-intrinsic-demand! [(f (fnptr c [(ptr u8) i64] i64))] (-> i64)
  (do (set! (.f (jsl-intrinsic-demand)) f)
      (set! (.installed (jsl-intrinsic-demand)) true)
      0))

(defn jsl-demand-intrinsic! [(name (slice u8))] (-> i64)
  (if (.installed (jsl-intrinsic-demand))
      (primitive/call-ptr (.f (jsl-intrinsic-demand)) (slice-data [u8] name) (len name))
      0))

;; `(%MakeClosure "%Entry%" env flags)` allocates a function object whose code is a declared entry
;; (docs/DECISIONS.md, built-in closures). The frontend owns the entry's record, its function
;; identity and the value-call pointer type, so it builds the allocation: the hook receives the
;; entry's name and the control, memory, prototype, env and flags node ids, answers the function value's id and
;; leaves the memory after the allocation in `.memory`.
(defstruct JslClosureMaker
  [(f (fnptr c [(ptr u8) i64 i64 i64 i64 i64 i64] i64)) (installed bool) (memory i64)])

(defn jsl-closure-maker [] (-> (ptr JslClosureMaker))
  (compiler-state [JslClosureMaker] (primitive/alloc-static CompilerStateSlot)))

(defn jsl-set-closure-maker! [(f (fnptr c [(ptr u8) i64 i64 i64 i64 i64 i64] i64))] (-> i64)
  (do (set! (.f (jsl-closure-maker)) f)
      (set! (.installed (jsl-closure-maker)) true)
      0))

(defn jsl-closure-set-memory! [(nid i64)] (-> i64)
  (do (set! (.memory (jsl-closure-maker)) nid) 0))

(defn jsl-lower-reset! [] (-> i64)
  (do
    (jsl-graphs-boot!)
    (al-clear! [JslGraph] (mut (.items (jsl-graphs))))
    (al-clear! [i64] (mut (.pending (jsl-graphs))))
    (set! (.closed (jsl-graphs)) false)
    (set! (.specialized-sites (jsl-graphs)) 0)
    (set! (.specialized-nodes (jsl-graphs)) 0)
    (set! (.set (jsl-value-call-abi)) false)
    (set-specialize-round-ext! (primitive/fnptr-of jsl-specialize-admit-all!))
    0))

(defn jsl-graph-new [(name (slice u8)) (nid i64) (fidx i64) (form (ptr rd/Sexp))] (-> JslGraph)
  (let [(mut g) (primitive/zeroed JslGraph)]
    (set! (.name (mut g)) name)
    (set! (.nid (mut g)) nid)
    (set! (.fidx (mut g)) fidx)
    (set! (.form (mut g)) form)
    (load g)))

(defstruct JslExprResult
  [(value (dyn NodeOps)) (ctrl (dyn NodeOps)) (mem (dyn NodeOps))])

(defn jsl-expr-result [(value (dyn NodeOps))
                       (ctrl (dyn NodeOps))
                       (mem (dyn NodeOps))] (-> JslExprResult)
  (let [(mut r) (primitive/zeroed JslExprResult)]
    (set! (.value (mut r)) value)
    (set! (.ctrl (mut r)) ctrl)
    (set! (.mem (mut r)) mem)
    (load r)))

(defn jsl-env-lookup [(params (ptr rd/Sexp))
                      (values (ArrayList (dyn NodeOps)))
                      (local-names (ArrayList (slice u8)))
                      (local-values (ArrayList (dyn NodeOps)))
                      (name (slice u8))] (-> (dyn NodeOps))
  (let [(mut i) (- (len local-names) 1)
        local-idx
          (loop (if (< (load i) 0)
                    (break -1)
                    (if (= (get local-names (load i)) name)
                        (break (load i))
                        (do (set! (mut i) (- (load i) 1)) (continue)))))]
    (if (>= local-idx 0)
        (get local-values local-idx)
        (do
          (set! (mut i) 0)
          (loop (if (>= (load i) (rd/sexp-count params))
                    (break (do
                             (panic "jsl-env-lookup: checker admitted an unknown name")
                             (unreachable-node)))
                    (let [decl (rd/sexp-nth params (load i))]
                      (if (= (rd/sexp-sym (rd/sexp-nth decl 0)) name)
                          (break (get values (load i)))
                          (do (set! (mut i) (+ (load i) 1)) (continue))))))))))

(defn jsl-node [(nid i64)] (-> (dyn NodeOps))
  (match (arena-node nid) (Some [n] n) (None [] (unreachable-node))))

;; Simple's CallEnd inline worklist expands one body and then cleans up. For a JSL definition
;; with :specialize, the same worklist instead lowers the checked source with actual arguments.
;; The annotation lists alternative tag proofs sufficient to justify expansion; it grants no
;; type assumption. Unknown/TOP arguments keep an ordinary call, including its full memory and
;; exception tuple. A satisfied rule only permits lowering: ordinary JSL if/guard lowering still
;; proves which branches disappear. This avoids cloning the generic graph before discarding it.
;; The full generic body and its dependencies must exist before specialization; facts therefore
;; see its effects. Proven parse-time types may specialize in the initial pessimistic solve;
;; unknown types wait for SCCP or a caller inline. No operation-specific name dispatch is used.
(defn jsl-specialization-parameter [(params (ptr rd/Sexp)) (name (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (rd/sexp-count params))
      (break (do (panic "jsl-specialization: checked parameter missing") 0))
      (if (= name (rd/sexp-sym (rd/sexp-nth (rd/sexp-nth params (load i)) 0)))
          (break (load i)) (do (set! (mut i) (+ (load i) 1)) (continue)))))))

;; One predicate of a specialization rule, against the call's actual argument types. Registers a
;; dependency on everything it reads, so a site that declines is re-asked when SCCP sharpens it.
(defn jsl--predicate-proven? [(rule (ptr rd/Sexp)) (params (ptr rd/Sexp)) (c (dyn NodeOps))
                              (end (dyn NodeOps))] (-> bool)
  (let [predicate (rd/sexp-sym (rd/sexp-nth rule 0))
        arg (call-arg c (jsl-specialization-parameter params (rd/sexp-sym (rd/sexp-nth rule 1))))
        t (n-ty arg)]
    (n-add-dep! arg end)
    (if (or (= t TY-INVALID) (ty-high? t))
        false
        (if (= (rd/sexp-count rule) 2)
            (ty-isa? t (ty-dyn (jsl-tag-predicate predicate)))
            (let [key-node (call-arg c (jsl-specialization-parameter params (rd/sexp-sym (rd/sexp-nth rule 2))))
                  key (keyref-local key-node) mem (call-mem c)]
              (n-add-dep! key-node end) (n-add-dep! mem end)
              (if (or (= predicate "%StringLength") (= predicate "%ArrayLength"))
                  (and (>= key 0) (= (shape-key-name key) "length")
                       (ty-isa? t (ty-dyn (if (= predicate "%StringLength") TAG-STRING TAG-ARRAY))))
                  (and (ty-isa? t (ty-dyn (jsl-tag-predicate "%IsObjectLike")))
                       (if (= predicate "%OwnPropertyAbsent")
                           (property-specialization-absent? mem arg key end)
                           (property-specialization-proven? mem arg key (= predicate "%OwnWritableDataProperty") end)))))))))

;; A rule is one predicate, or a VECTOR of predicates meaning all of them — `+` needs "both operands
;; are Numbers", not "either" (docs/SPECIALIZE.md §4.2). The rule list itself stays alternatives: any
;; rule proven grants permission to re-lower, and permission is all it is — ordinary JSL lowering still
;; decides what the proof actually folds.
(defn jsl--rule-proven? [(rule (ptr rd/Sexp)) (params (ptr rd/Sexp)) (c (dyn NodeOps))
                         (end (dyn NodeOps))] (-> bool)
  (if (not (rd/sexp-vec? rule))
      (jsl--predicate-proven? rule params c end)
      (let [n (rd/sexp-count rule)
            (mut all) (> n 0)
            (mut i) 0]
        ;; Every predicate is asked, not just up to the first failure: each one's dependencies are
        ;; what bring this site back when its argument sharpens.
        (loop (if (>= (load i) n)
                  (break 0)
                  (do
                    (if (jsl--predicate-proven? (rd/sexp-nth rule (load i)) params c end)
                        0
                        (set! (mut all) false))
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (load all))))

(defn jsl-specialization-proven? [(form (ptr rd/Sexp)) (c (dyn NodeOps)) (end (dyn NodeOps))] (-> bool)
  (let [source-policy (jsl-form-option form "specialize")
        rules (rd/sexp-nth form (if (>= source-policy 0) source-policy (jsl-form-option form "inline-when")))
        params (jsl-form-params form) (mut ready) false (mut i) 0]
    (loop (if (>= (load i) (rd/sexp-count rules)) (break 0)
      (do
        (if (jsl--rule-proven? (rd/sexp-nth rules (load i)) params c end)
            (set! (mut ready) true)
            0)
        (set! (mut i) (+ (load i) 1))
        (continue))))
    (load ready)))

;; Simple IterPeeps drains reducing peepholes, admits one graph-growing inline, then drains again.
;; Source re-lowering obeys that same publication boundary. It still needs independent lifetime,
;; type and call-linking contracts: a boundary does not make a widened Parm or a stale proof sound.
;; Admit ONE replacement, then drain the ordinary worklist before asking another site. Merely
;; snapshotting the arena size does not keep proofs quiescent after the first graph mutation.
(defn jsl-specialize-admit-all! [] (-> i64)
  (let [limit (+ (arena-node-count) 1)
        (mut applied) 0
        (mut id) 1]
    (loop (if (or (> (load applied) 0) (>= (load id) limit)
                  (>= (.specialized-sites (jsl-graphs)) JSL-SPECIALIZE-SITES)
                  (>= (.specialized-nodes (jsl-graphs)) JSL-SPECIALIZE-NODES))
              (break 0)
              (do
                (match (arena-node (load id))
                  (Some [n]
                        (if (and (= (n-op n) OP-CALLEND) (not (n-dead? n)))
                            (if (= (jsl-specialize-call! n true) INLINE-TRIVIAL)
                                (set! (mut applied) (+ (load applied) 1))
                                0)
                            0))
                  (None [] 0))
                (set! (mut id) (+ (load id) 1))
                (continue))))
    (load applied)))

;; `AOT_SPECIALIZE_TRACE=1`, read once: name the condition that refused each site. A tri-state that
;; says DEFER tells you nothing about which of eight guards stopped it, and guessing costs a build
;; per guess. Answers INLINE-DEFER so it can stand in for the refusal it reports.
(defstruct SpecializeTraceFlag [(state i64)])

(defn jsl--specialize-trace? [] (-> bool)
  (let [f (compiler-state [SpecializeTraceFlag]
                          (primitive/alloc-static CompilerStateSlot))]
    (if (= (.state f) 0)
        (set! (.state f)
              (if (!= (primitive/cast i64 (os/getenv c"AOT_SPECIALIZE_TRACE")) 0) 1 2))
        0)
    (= (.state f) 1)))

(defn jsl--trace-refusal [(name (slice u8)) (why (ptr i8))] (-> i64)
  (do
    (if (jsl--specialize-trace?)
        (do (println "specialize: {s} refused: {s}" name (str/cstr->str why)) 0)
        0)
    INLINE-DEFER))

(defn jsl-specialize-call! [(end (dyn NodeOps)) (mutate bool)] (-> i64)
  (if (or (n-dead? end) (cend-folding? end)) INLINE-UNHANDLED
    (match (n-in-safe end 0)
      (None [] INLINE-UNHANDLED)
      (Some [c]
        (if (!= (n-op c) OP-CALL) INLINE-UNHANDLED
          (let [fp (call-fptr c) ft (n-ty fp)]
            (if (not (and (or (= (n-op fp) OP-FUNPTR) (= (n-op fp) OP-EXTERN)) (ty-funptr? ft)
                          (ty-funptr-single? ft))) INLINE-UNHANDLED
              (let [index (ty-funptr-target-at ft 0) g (jsl-graphs)]
                (if (or (< index 0) (>= index (len (.items g)))) INLINE-UNHANDLED
                  (let [entry (get (.items g) index) form (.form entry)]
                    (if (or (and (< (jsl-form-option form "specialize") 0)
                                 (< (jsl-form-option form "inline-when") 0))
                            (if (= (n-op fp) OP-EXTERN)
                                (!= (.link-mode g) JSL-LINK-IMPORT)
                                (!= (.nid entry) (n-nid (n-in! fp 0))))) INLINE-UNHANDLED
                      (if (or (> (len (.pending g)) 0)
                              (!= (n-nins end) (if (= (n-op fp) OP-EXTERN) 1 2))
                              (!= (call-nargs c) (rd/sexp-count (jsl-form-params form)))
                              (= (n-ty (call-ctrl c)) TY-XCTRL)
                              (ty-high? (n-ty (call-mem c))))
                          (jsl--trace-refusal (.name entry)
                                              (if (> (len (.pending g)) 0)
                                                  c"definitions still pending"
                                              (if (!= (n-nins end) (if (= (n-op fp) OP-EXTERN) 1 2))
                                                  c"not exactly one linked target"
                                              (if (!= (call-nargs c) (rd/sexp-count (jsl-form-params form)))
                                                  c"argument count disagrees with params"
                                              (if (= (n-ty (call-ctrl c)) TY-XCTRL)
                                                  c"control is dead"
                                                  c"memory still at TOP")))))
                      ;; No proof: this is not the specializer's business, so the ordinary inliner
                      ;; decides (docs/SPECIALIZE.md §7). Rules must not make a definition
                      ;; specialize-ONLY: a recursive site's operand types can be polluted by the
                      ;; shared body's other callers, so no proof exists until a clone breaks that
                      ;; cycle — `fib(n-1) + fib(n-2)` is exactly that shape, and deferring here kept
                      ;; its `+` a call (5.2 -> 6.5 ms per fib(30)).
                      (if (not (jsl-specialization-proven? form c end))
                          (do (jsl--trace-refusal (.name entry) c"no rule proven")
                              INLINE-UNHANDLED)
                        ;; A guarded graph inline retains the established Call/Return edges and
                        ;; proven types via Simple's copier. It does not manufacture fresh calls
                        ;; after SCCP. An imported provider has no local graph to copy, so its
                        ;; generic ABI stays intact. No proof means no clone, even if some other
                        ;; argument (such as an error message) happens to be constant.
                        (if (>= (jsl-form-option form "inline-when") 0)
                            (if (= (n-op fp) OP-FUNPTR) INLINE-UNHANDLED INLINE-DEFER)
                        (if (and (= (n-op fp) OP-FUNPTR) (fun-self-recursive? (n-in! fp 0)))
                            (do (n-add-dep! (n-in! fp 0) end)
                                (jsl--trace-refusal (.name entry) c"callee is self-recursive"))
                            (if (not mutate) INLINE-TRIVIAL
                              (do (jsl-specialize-body! form c end) INLINE-TRIVIAL)))))))))))))))))

(defn jsl-specialize-body! [(form (ptr rd/Sexp)) (c (dyn NodeOps)) (end (dyn NodeOps))] (-> i64)
  (let [before (arena-node-count)
        prior (n-origin-enter! (rd/sexp-sym (rd/sexp-nth form 1)) "specialize"
                               (n-source-lo c) (n-source-hi c))]
    (jsl-specialize-body-inner! form c end)
    (let [g (jsl-graphs)]
      (set! (.specialized-sites g) (+ (.specialized-sites g) 1))
      (set! (.specialized-nodes g) (+ (.specialized-nodes g) (- (arena-node-count) before))))
    (n-origin-leave! prior)))

(defn jsl-specialize-body-inner! [(form (ptr rd/Sexp)) (c (dyn NodeOps)) (end (dyn NodeOps))] (-> i64)
  (let [(mut args) (al-new [(dyn NodeOps)] (compiler-allocator))
        (mut names) (al-new [(slice u8)] (compiler-allocator))
        (mut values) (al-new [(dyn NodeOps)] (compiler-allocator))
        (mut i) 0 first (+ (arena-node-count) 1)]
    (n-keep! c) (n-keep! end)
    (loop (if (>= (load i) (call-nargs c)) (break 0)
      (do (push! [(dyn NodeOps)] (mut args) (call-arg c (load i)))
          (set! (mut i) (+ (load i) 1)) (continue))))
    (let [lowered (jsl-lower-expr (jsl-form-body form) (jsl-form-params form) (load args)
                                  (mut names) (mut values) (call-ctrl c) (call-mem c))
          ;; Peephole the residual's three edges HERE, before anything keeps them: the forwarding walk
          ;; below holds them, and a peephole there could replace a node it is still keeping, while
          ;; leaving them unpeepholed hands the loop tree an unfolded control node.
          body lowered
          local (= (n-op (call-fptr c)) OP-FUNPTR)]
      (n-keep! (.ctrl body)) (n-keep! (.mem body)) (n-keep! (.value body))
      (if local
          (match (return-fun (n-in! end 1))
            (Some [fun] (call-unlink! c fun))
            (None [] (panic "jsl-specialize: missing function owner"))) 0)
      (prop-access-forward! end (.ctrl body) (.mem body) (.value body))
      (n-unkeep! end) (if (n-unused? end) (n-kill! end) 0)
      (n-unkeep! c) (if (n-unused? c) (n-kill! c) 0)
      (n-unkeep! (.ctrl body)) (n-unkeep! (.mem body)) (n-unkeep! (.value body))
      ;; Now that nothing holds them, peephole the residual's edges. It has to happen here rather than
      ;; at construction: the folds that matter — a Region with one live input, a Phi with one distinct
      ;; value — depend on the users the forwarding walk just installed. Without this the loop tree
      ;; meets an unfolded control node ("postvisited child has no loop tree").
      ;; A residual edge can be dead by now: forwarding replaced its only user and the cascade
      ;; collected it.
      (if (n-dead? (.ctrl body)) 0 (do (n-peephole! (.ctrl body)) 0))
      (if (n-dead? (.mem body)) 0 (do (n-peephole! (.mem body)) 0))
      (if (n-dead? (.value body)) 0 (do (n-peephole! (.value body)) 0))
      0)
    ;; Only the residual body's freshly allocated nodes, not a whole-arena reseed per call.
    (set! (mut i) first)
    (loop (if (> (load i) (arena-node-count)) (break 0)
      (do (match (arena-node (load i)) (Some [n] (if (n-dead? n) 0 (do (code-add! n) 0))) (None [] 0))
          (set! (mut i) (+ (load i) 1)) (continue))))
    (al-free! (mut args)) (al-free! (mut names)) (al-free! (mut values))
    (fun-size-epoch-bump!) (invalidate-cfg!) 0))

(defn jsl-lower-macro-values [(name (slice u8))
                              (args (ArrayList (dyn NodeOps)))
                              (ctrl (dyn NodeOps))
                              (mem (dyn NodeOps))] (-> JslExprResult)
  (let [prior (n-origin-enter! name "macro" (n-source-context-lo) (n-source-context-hi))
        answer (jsl-lower-macro-values-inner name args ctrl mem)]
    (n-origin-leave! prior)
    answer))

(defn jsl-lower-macro-values-inner [(name (slice u8))
                                    (args (ArrayList (dyn NodeOps)))
                                    (ctrl (dyn NodeOps)) (mem (dyn NodeOps))] (-> JslExprResult)
  (match (jsl-definition-form name)
    (None []
          (do
            (panic "jsl-lower-macro-values: unknown macro")
            (jsl-expr-result (unreachable-node) ctrl mem)))
    (Some [form]
          (if (not (jsl-form-macro? form))
              (do
                (panic "jsl-lower-macro-values: definition is not a macro")
                (jsl-expr-result (unreachable-node) ctrl mem))
              (if (!= (len args) (rd/sexp-count (jsl-form-params form)))
                  (do
                    (panic "jsl-lower-macro-values: wrong argument count")
                    (jsl-expr-result (unreachable-node) ctrl mem))
                  (let [(mut local-names)
                          (al-new [(slice u8)] (compiler-allocator))
                        (mut local-values)
                          (al-new [(dyn NodeOps)] (compiler-allocator))]
                    ;; An argument may have no use yet other than this expansion. Peepholes inside
                    ;; the body (a tag test folding on a proven singleton, an arm dying) kill nodes
                    ;; that lose their last use, and a later reference to the same parameter would
                    ;; then read a dead node. Every argument stays alive for the whole expansion.
                    (al-for [arg args] (n-keep! arg))
                    (let [answer
                            (jsl-lower-expr (jsl-form-body form)
                                            (jsl-form-params form)
                                            args
                                            (mut local-names)
                                            (mut local-values)
                                            ctrl
                                            mem)]
                      (al-for [arg args] (n-unkeep! arg))
                      answer)))))))

(defn jsl-lower-type [(x (ptr rd/Sexp))] (-> i64)
  (if (rd/sexp-sym-is x "never") (ty-dyn 0)
      (if (rd/sexp-sym-is x "argument-vector") (callabi-vector-type)
          (if (rd/sexp-sym-is x "argument-count") (ty-int-range 0 CALL-ABI-MAX-ARGUMENTS)
              (jsl-lower-type-refined x)))))

(defn jsl-lower-type-refined [(x (ptr rd/Sexp))] (-> i64)
  (if (rd/sexp-sym-is x "dyn-object-like")
      (ty-dyn (+ TAG-OBJECT (+ TAG-FUNCTION TAG-ARRAY)))
      (jsl-lower-type-base x)))

(defn jsl-lower-type-base [(x (ptr rd/Sexp))] (-> i64)
  (let [name (rd/sexp-sym x)]
    (if (= name "dyn")
        (ty-dyn TAG-ANY)
        (if (= name "int")
            (ty-int-bot)
            (if (= name "bool")
                (ty-bool)
                (if (= name "flt")
                    (ty-flt-bot)
                    (if (= name "obj")
                        (raw-object-ty)
                        (if (= name "str")
                            (raw-string-ty)
                            (if (= name "arr")
                                (raw-array-ty)
                                (do
                                  (panic "jsl-lower-type: checker/lowerer drift")
                                  TY-INVALID))))))))))

;; JSL defines ToBoolean as `%Not(%Not(v))`. The frontend requests that semantic expansion here so
;; the definition enters the ideal graph directly, just like a JSL macro expansion, without
;; manufacturing a runtime call boundary for a pure primitive composition.
;; A lowered JSL condition that is already a constant: an integer constant, or a Box of one (the
;; JavaScript truthiness of a boxed constant is decided by its payload, as `if-compute` decides it).
(defn jsl-constant-condition? [(value (dyn NodeOps))] (-> bool)
  (let [t
          (if (and (= (n-op value) OP-BOX) (> (n-nins value) 1))
              (n-ty (n-in! value 1))
              (n-ty value))]
    (and (ty-int? t) (ty-constant? t))))

(defn jsl-constant-condition-true? [(value (dyn NodeOps))] (-> bool)
  (let [t
          (if (and (= (n-op value) OP-BOX) (> (n-nins value) 1))
              (n-ty (n-in! value 1))
              (n-ty value))]
    (!= (ty-int-lo t) 0)))

(defn jsl-lower-toboolean-value [(value (dyn NodeOps))] (-> (dyn NodeOps))
  (n-peephole! (not-make (n-peephole! (not-make value)))))

(defn jsl-unary-primitive? [(name (slice u8))] (-> bool)
  (or (= name "%Box")
      (= name "%BoxInt")
      (= name "%BoxBool")
      (= name "%Not")
      (= name "%Neg")
      (= name "%UnboxInt")
      (= name "%UnboxBool")
      (= name "%UnboxFlt")
      (= name "%UnboxNumber")
      (= name "%UnboxString")
      (= name "%UnboxObject")
      (= name "%UnboxObjectLike")
      (= name "%UnboxArray")
      (= name "%UnboxSymbol")
      (= name "%ToInteger")
      (= name "%ToFloat")))

(defn jsl-lower-unary-primitive [(name (slice u8))
                                 (value (dyn NodeOps))
                                 (ctrl (dyn NodeOps))] (-> (dyn NodeOps))
  ;; The enclosing JslExprResult still owns this control after the value folds. Box attaches
  ;; control temporarily; folding Box(TOP) can otherwise kill a fresh CallEnd CProj before the
  ;; enclosing branch wires it into its Region. Keep borrowed operands across eager peepholing.
  (n-keep! ctrl)
  (n-keep! value)
  (let [result (jsl-lower-unary-primitive-inner name value ctrl)]
    (n-unkeep! value)
    (n-unkeep! ctrl)
    result))

(defn jsl-lower-unary-primitive-inner [(name (slice u8))
                                       (value (dyn NodeOps))
                                       (ctrl (dyn NodeOps))] (-> (dyn NodeOps))
  (if (= name "%Box")
      (n-peephole! (box-make-at (Some ctrl) value))
      (if (= name "%BoxInt")
          (n-peephole! (box-make-rep-at (Some ctrl) value REP-INT))
          (if (= name "%BoxBool")
              (n-peephole! (box-make-rep-at (Some ctrl) value REP-BOOL))
              (if (or (= name "%Not") (= name "%Neg"))
                  (n-peephole! (if (= name "%Neg")
                                   (minus-make value)
                                   (not-make value)))
                  (if (= name "%UnboxInt")
                      (n-peephole! (unbox-make value REP-INT))
                      (if (= name "%UnboxBool")
                          (n-peephole! (unbox-make value REP-BOOL))
                          (if (= name "%UnboxFlt")
                              (n-peephole! (unbox-make value REP-DOUBLE))
                              (if (= name "%UnboxNumber")
                                  (n-peephole! (unbox-make value REP-NUMBER))
                                  (if (= name "%UnboxString")
                                      (n-peephole! (unbox-make value REP-STRING))
                                      (if (= name "%UnboxObject")
                                          (n-peephole! (unbox-make value
                                                                   REP-OBJECT))
                                          (if (= name "%UnboxObjectLike")
                                              (n-peephole! (unbox-make value
                                                                       REP-OBJECT-LIKE))
                                              (if (= name "%UnboxArray")
                                                  (n-peephole! (unbox-make value
                                                                           REP-ARRAY))
                                              (if (= name "%UnboxSymbol")
                                                  (n-peephole! (unbox-make value
                                                                           REP-SYMBOL))
                                                  (if (= name "%ToFloat")
                                                      (n-peephole! (to-float-make value))
                                                      (if (= name "%ToInteger")
                                                          (n-peephole! (to-int-make value))
                                                          (do
                                                            (panic "jsl-lower-unary-primitive: checker/lowerer drift")
                                                            (unreachable-node))))))))))))))))))

(defn jsl-lower-binary-primitive [(name (slice u8))
                                  (lhs (dyn NodeOps))
                                  (rhs (dyn NodeOps))] (-> (dyn NodeOps))
  (n-peephole! (if (= name "%Sub")
                   (sub-make lhs rhs)
                   (if (= name "%Add")
                       (add-make lhs rhs)
                       (if (= name "%Mul")
                           (mul-make lhs rhs)
                           (if (= name "%Div")
                               (div-make lhs rhs)
                               (if (or (= name "%Eq") (= name "%SameBits"))
                                   (if (= name "%SameBits")
                                       (eq-word-make lhs rhs)
                                       (eq-make lhs rhs))
                                   (if (= name "%Ne")
                                       (ne-make lhs rhs)
                                       (if (= name "%Lt")
                                           (lt-make lhs rhs)
                                           (if (= name "%Le")
                                               (le-make lhs rhs)
                                               (if (= name "%And")
                                                   (and-make lhs rhs)
                                                   (do
                                                     (panic "jsl-lower-binary-primitive: checker/lowerer drift")
                                                     (unreachable-node)))))))))))))

(defn jsl-lower-new-object [(ctrl (dyn NodeOps)) (mem (dyn NodeOps))] (-> JslExprResult)
  (let [fresh
          (new-make ctrl
                    (con-int OBJECT-PAYLOAD-BYTES)
                    mem
                    SHAPE-EMPTY
                    (ty-struct "JsObjectPayload"))
        ptr_ (proj-make fresh 0 "jsl.new-object.ptr")
        private-memory (proj-make fresh 1 "jsl.new-object.private-memory")
        null-value (dyn-null-make)
        prototype-state
          (store-make ctrl
                      private-memory
                      ptr_
                      (con-int OFFSET-OBJECT-PROTOTYPE)
                      null-value
                      ALIAS-OBJECT-PROTOTYPE
                      (ty-dyn TAG-ANY))
        properties-state
          (store-make ctrl
                      prototype-state
                      ptr_
                      (con-int OFFSET-OBJECT-PROPERTIES)
                      null-value
                      ALIAS-OBJECT-PROPERTIES
                      (ty-dyn TAG-ANY))
        merged (memmerge-make)]
    (memmerge-set-alias! merged ALIAS-BULK mem)
    (memmerge-set-alias! merged ALIAS-OBJECT-PROTOTYPE prototype-state)
    (memmerge-set-alias! merged ALIAS-OBJECT-PROPERTIES properties-state)
    (jsl-expr-result ptr_ ctrl merged)))

;; Final Simple Parser.makeAllocator allocates the complete TypeStruct once, obtains its private
;; memory projection, runs initialization, then publishes that memory. A JS literal likewise has
;; a known final layout when all keys are fixed. Unlike Simple, its values are arbitrary JS
;; expressions: initialize every GC-visible slot to undefined before evaluating any of them.
;; The object stays unpublished until the literal finishes; pre-created own keys are therefore
;; unobservable. Calls can lose the static backing proof, but the runtime still sees the final
;; backing and updates it in place. Never turn the compiler-local layout operand into a runtime
;; integer: New carries the layout through the existing image shape-remapping machinery.
(defn jsl-lower-new-shaped-object [(ctrl (dyn NodeOps)) (mem (dyn NodeOps))
                                  (layout (dyn NodeOps))] (-> JslExprResult)
  (let [t (n-ty layout)]
    (if (not (and (ty-int? t) (ty-constant? t)))
        (panic "%NewObjectWithShape: layout must be a compiler constant") 0)
    (let [shape (ty-int-lo t)]
      (if (or (not (shape-valid? shape)) (= shape SHAPE-STRING))
          (panic "%NewObjectWithShape: invalid object property layout") 0)
      (if (not (shape-extensible? shape))
          (panic "%NewObjectWithShape: literal layout must be extensible") 0)
      (let [(mut row) shape]
        (loop (if (= (load row) SHAPE-EMPTY) (break 0)
          (do
            (if (!= (get (.attrs (shape-table)) (load row)) SHAPE-ATTRS-DEFAULT)
                (panic "%NewObjectWithShape: literal layout requires default data attributes") 0)
            (set! (mut row) (get (.parent (shape-table)) (load row)))
            (continue)))))
      (let [raw (jsl-lower-new-object ctrl mem)]
        (if (= shape SHAPE-EMPTY) raw
            (let [(mut initial) (al-new [(dyn NodeOps)] (compiler-allocator))
                  (mut i) 0]
              (loop (if (>= (load i) (shape-field-count shape)) (break 0)
                (do (push! (mut initial) (dyn-undefined-make))
                    (set! (mut i) (+ (load i) 1)) (continue))))
              (let [storage (property-storage-new ctrl (.mem raw) shape (load initial))
                    installed (property-storage-install ctrl (.mem raw) (.value raw) shape storage)]
                (al-free! (mut initial))
                (jsl-expr-result (.value raw) ctrl installed))))))))

(defn jsl-utf8-cont [(text (slice u8)) (i i64)] (-> i64)
  (if (>= i (len text))
      (do (panic "jsl string: truncated UTF-8") 0)
      (let [b (primitive/cast i64 (get text i))]
        (if (!= (& b 0xc0) 0x80)
            (do (panic "jsl string: invalid UTF-8 continuation") 0)
            (& b 0x3f)))))

(defn jsl-string-append-utf8! [(text (slice u8)) (units (mut (ArrayList i64)))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len text))
              (break 0)
              (let [b0 (primitive/cast i64 (get text (load i)))
                    (mut cp) 0
                    (mut width) 1]
                (if (< b0 0x80)
                    (set! (mut cp) b0)
                    (if (= (& b0 0xe0) 0xc0)
                        (do
                          (set! (mut cp)
                                (| (primitive/ishl (& b0 0x1f) 6)
                                   (jsl-utf8-cont text (+ (load i) 1))))
                          (set! (mut width) 2)
                          (if (< (load cp) 0x80)
                              (panic "jsl string: overlong UTF-8")
                              0))
                        (if (= (& b0 0xf0) 0xe0)
                            (do
                              (set! (mut cp)
                                    (| (primitive/ishl (& b0 0x0f) 12)
                                       (| (primitive/ishl (jsl-utf8-cont text
                                                                         (+ (load i)
                                                                            1))
                                                          6)
                                          (jsl-utf8-cont text (+ (load i) 2)))))
                              (set! (mut width) 3)
                              (if (or (< (load cp) 0x800)
                                      (and (>= (load cp) 0xd800)
                                           (<= (load cp) 0xdfff)))
                                  (panic "jsl string: invalid UTF-8 scalar")
                                  0))
                            (if (= (& b0 0xf8) 0xf0)
                                (do
                                  (set! (mut cp)
                                        (| (primitive/ishl (& b0 0x07) 18)
                                           (| (primitive/ishl (jsl-utf8-cont text
                                                                             (+ (load i)
                                                                                1))
                                                              12)
                                              (| (primitive/ishl (jsl-utf8-cont text
                                                                                (+ (load i)
                                                                                   2))
                                                                 6)
                                                 (jsl-utf8-cont text
                                                                (+ (load i) 3))))))
                                  (set! (mut width) 4)
                                  (if (or (< (load cp) 0x10000)
                                          (> (load cp) 0x10ffff))
                                      (panic "jsl string: invalid UTF-8 scalar")
                                      0))
                                (panic "jsl string: invalid UTF-8 lead byte")))))
                (if (<= (load cp) 0xffff)
                    (push! [i64] (mut units) (load cp))
                    (let [supplement (- (load cp) 0x10000)]
                      (push! [i64]
                             (mut units)
                             (+ 0xd800 (primitive/ishr supplement 10)))
                      (push! [i64] (mut units) (+ 0xdc00 (& supplement 0x3ff)))))
                (set! (mut i) (+ (load i) (load width)))
                (continue))))
    0))

(defn jsl-string-utf16-units [(text (slice u8))] (-> (ArrayList i64))
  (let [(mut units) (al-new [i64] (compiler-allocator))]
    (jsl-string-append-utf8! text (mut units))
    (load units)))

(defn jsl-lower-string-literal [(text (slice u8))
                                (ctrl (dyn NodeOps))
                                (mem (dyn NodeOps))] (-> JslExprResult)
  (let [(mut units) (jsl-string-utf16-units text)
        result (jsl-lower-string-units (load units) ctrl mem)]
    (al-free! [i64] (mut units))
    result))

;; Both JSL text and decoded source literals enter the same allocation/memory graph. UTF-16
;; units are not re-encoded as UTF-8: JavaScript permits unpaired surrogate code units.
;; A string literal is a StrConst: data in the object file, no allocation, no stores, no memory
;; effect (docs/DECISIONS.md, string literals are data).
(defn jsl-lower-string-units [(units (ArrayList i64))
                              (ctrl (dyn NodeOps))
                              (mem (dyn NodeOps))] (-> JslExprResult)
  (jsl-expr-result (strconst-make units) ctrl mem))

(defn jsl-lower-string-units-allocated [(units (ArrayList i64))
                                        (ctrl (dyn NodeOps))
                                        (mem (dyn NodeOps))] (-> JslExprResult)
  (let [payload-bytes (+ 8 (* (len units) 2))
        fresh
          (new-make ctrl
                    (con-int payload-bytes)
                    mem
                    SHAPE-STRING
                    (ty-struct "JsStringPayload"))
        ptr_ (proj-make fresh 0 "jsl.string.ptr")
        private-memory (proj-make fresh 1 "jsl.string.private-memory")
        length-state
          (store-make ctrl
                      private-memory
                      ptr_
                      (con-int 0)
                      (con-int (len units))
                      ALIAS-STRING-LENGTH
                      (ty-int-bot))
        (mut data-state-nid) (n-nid length-state)
        (mut unit) 0
        (mut word-index) 0]
    (loop (if (>= (load unit) (len units))
              (break 0)
              (let [(mut packed) 0
                    (mut lane) 0]
                (loop (if (or (>= (load lane) 4)
                              (>= (+ (load unit) (load lane)) (len units)))
                          (break 0)
                          (do
                            (set! (mut packed)
                                  (| (load packed)
                                     (primitive/ishl (get units
                                                          (+ (load unit)
                                                             (load lane)))
                                                     (* (load lane) 16))))
                            (set! (mut lane) (+ (load lane) 1))
                            (continue))))
                (let [stored
                        (store-make ctrl
                                    (jsl-node (load data-state-nid))
                                    ptr_
                                    (con-int (+ 8 (* (load word-index) 8)))
                                    (con-int (load packed))
                                    ALIAS-STRING-DATA
                                    (ty-int-bot))]
                  (set! (mut data-state-nid) (n-nid stored)))
                (set! (mut unit) (+ (load unit) 4))
                (set! (mut word-index) (+ (load word-index) 1))
                (continue))))
    (let [merged (memmerge-make)]
      (memmerge-set-alias! merged ALIAS-BULK mem)
      (memmerge-set-alias! merged ALIAS-STRING-LENGTH length-state)
      (if (> (len units) 0)
          (memmerge-set-alias! merged
                               ALIAS-STRING-DATA
                               (jsl-node (load data-state-nid)))
          0)
      (jsl-expr-result ptr_ ctrl merged))))

(defn jsl-lower-call [(x (ptr rd/Sexp))
                      (name (slice u8))
                      (params (ptr rd/Sexp))
                      (values (ArrayList (dyn NodeOps)))
                      (local-names (mut (ArrayList (slice u8))))
                      (local-values (mut (ArrayList (dyn NodeOps))))
                      (ctrl (dyn NodeOps))
                       (mem (dyn NodeOps))] (-> JslExprResult)
  (let [(mut ctrl-nid) (n-nid ctrl)
        (mut mem-nid) (n-nid mem)
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))
        (mut i) 1]
    (loop (if (>= (load i) (rd/sexp-count x))
              (break 0)
              (let [arg
                      (jsl-lower-expr (rd/sexp-nth x (load i))
                                      params
                                      values
                                      (mut local-names)
                                      (mut local-values)
                                      (jsl-node (load ctrl-nid))
                                      (jsl-node (load mem-nid)))]
                (push! [(dyn NodeOps)] (mut args) (.value arg))
                (set! (mut ctrl-nid) (n-nid (.ctrl arg)))
                (set! (mut mem-nid) (n-nid (.mem arg)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (match (jsl-definition-form name)
      (None []
            (do
              (panic "jsl-lower-call: checker admitted an unknown definition")
              (jsl-expr-result (unreachable-node) ctrl mem)))
      (Some [form]
            (if (jsl-form-macro? form)
                (jsl-lower-macro-values name
                                        (load args)
                                        (jsl-node (load ctrl-nid))
                                        (jsl-node (load mem-nid)))
                (let [target (jsl-call-target name)
                      c
                        (call-make-with-mem (jsl-node (load ctrl-nid))
                                            (jsl-node (load mem-nid)))
                      (mut arg) 0]
                  (loop (if (>= (load arg) (len (load args)))
                            (break 0)
                            (do
                              (call-add-arg! c (get (load args) (load arg)))
                              (set! (mut arg) (+ (load arg) 1))
                              (continue))))
                  (call-set-fptr! c target)
                  (let [end (callend-make c)]
                    (if (jsl-noinline? name) (callend-set-never-inline! end) 0)
                    (jsl-expr-result (proj-make end
                                                RETURN-VALUE
                                                "jsl.call.value")
                                     (cproj-make end
                                                 RETURN-CTRL
                                                 "jsl.call.ctrl")
                                     (proj-make end RETURN-MEM "jsl.call.mem")))))))))

(defn jsl-lower-property-store-primitive [(x (ptr rd/Sexp))
                                          (params (ptr rd/Sexp))
                                          (values (ArrayList (dyn NodeOps)))
                                          (local-names (mut (ArrayList (slice u8))))
                                          (local-values (mut (ArrayList (dyn NodeOps))))
                                          (ctrl (dyn NodeOps))
                                          (mem (dyn NodeOps))
                                          (with-attrs bool)] (-> JslExprResult)
  (let [object
          (jsl-lower-expr (rd/sexp-nth x 1)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          ctrl
                          mem)
        key
          (jsl-lower-expr (rd/sexp-nth x 2)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          (.ctrl object)
                          (.mem object))
        value
          (jsl-lower-expr (rd/sexp-nth x 3)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          (.ctrl key)
                          (.mem key))
        key-id (keyref-local (.value key))
        ;; The attributes operand must be a constant: the transition it names is compile-time.
        attrs
          (if with-attrs
              (let [a
                      (jsl-lower-expr (rd/sexp-nth x 4)
                                      params
                                      values
                                      (mut local-names)
                                      (mut local-values)
                                      (.ctrl value)
                                      (.mem value))
                    at (n-ty (.value a))]
                (if (and (ty-int? at) (ty-constant? at))
                    (ty-int-lo at)
                    (do
                      (panic "%PropStoreOwnNamedAttrs: the attributes are not a constant")
                      0)))
              SHAPE-ATTRS-DEFAULT)]
    ;; A runtime key (ToPropertyKey's result) takes the runtime shape-tree store directly; with
    ;; attributes, the store whose added key takes them.
    (if (< key-id 0)
        (let [stored
                (if (= attrs SHAPE-ATTRS-DEFAULT)
                    (property-generic-access (.ctrl value)
                                             (.mem value)
                                             (.value object)
                                             (.value key)
                                             (Some (.value value))
                                             JS-PROP-SET-OWN)
                    (property-store-generic-owner-attrs (.ctrl value)
                                                        (.mem value)
                                                        (.value object)
                                                        (.value key)
                                                        (.value value)
                                                        attrs))]
          (jsl-expr-result (.value stored) (.ctrl stored) (.mem stored)))
        ;; A statically visible backing store — a literal under construction — takes the static
        ;; transition now; any other owner is a PropStore node that resolves or expands later.
        (let [stored
                (match (prop-static-storage (.mem value) (.value object))
                  (PropUnknown []
                               (prop-access-emit-attrs (.ctrl value)
                                                       (.mem value)
                                                       (.value object)
                                                       (Some (.value value))
                                                       key-id
                                                       PROP-STORE
                                                       attrs))
                  (_ (property-store-known-owner (.ctrl value)
                                                 (.mem value)
                                                 (.value object)
                                                 key-id
                                                 (.value value)
                                                 attrs)))]
          (jsl-expr-result (.value stored) (.ctrl stored) (.mem stored))))))

;; (%PropSetNamed object key value): OrdinarySet's fast cases as one PROP-SET access — it folds to
;; a store where the owner and its chain are known and expands to the runtime's `rt-prop-set`
;; otherwise; a runtime key is that call directly.
(defn jsl-lower-property-set-primitive [(x (ptr rd/Sexp))
                                        (params (ptr rd/Sexp))
                                        (values (ArrayList (dyn NodeOps)))
                                        (local-names (mut (ArrayList (slice u8))))
                                        (local-values (mut (ArrayList (dyn NodeOps))))
                                        (ctrl (dyn NodeOps))
                                        (mem (dyn NodeOps))] (-> JslExprResult)
  (let [object
          (jsl-lower-expr (rd/sexp-nth x 1)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          ctrl
                          mem)
        key
          (jsl-lower-expr (rd/sexp-nth x 2)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          (.ctrl object)
                          (.mem object))
        value
          (jsl-lower-expr (rd/sexp-nth x 3)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          (.ctrl key)
                          (.mem key))
        key-id (keyref-local (.value key))
        stored
          (if (>= key-id 0)
              (prop-access-emit (.ctrl value)
                                (.mem value)
                                (.value object)
                                (Some (.value value))
                                key-id
                                PROP-SET)
              (property-set-generic (.ctrl value)
                                    (.mem value)
                                    (.value object)
                                    (.value key)
                                    (.value value)))]
    (jsl-expr-result (.value stored) (.ctrl stored) (.mem stored))))

;; The closed-program target set for `%CallFunction`. Code words name fixed-signature callable
;; adapters, independent of the program's local formal slots. The frontend installs this set
;; before demanding JSL bodies (aot.parse.parser, parse-program-sources).
(defstruct JslValueCallAbi [(funptr-ty i64) (set bool)])

(defn jsl-value-call-abi [] (-> (ptr JslValueCallAbi))
  (compiler-state [JslValueCallAbi] (primitive/alloc-static CompilerStateSlot)))

(defn jsl-set-value-call-abi! [(funptr-ty i64)] (-> i64)
  (let [abi (jsl-value-call-abi)]
    (set! (.funptr-ty abi) funptr-ty)
    (set! (.set abi) true)
    0))

;; (%CallFunction callee this arg...): the same call the frontend builds for `f(...)` through a
;; value (aot.parse.parser, lower-value-call-with-receiver), minus the callable guard — the checker
;; required the callee narrowed to a function — and minus the completion test — the result IS the
;; completion, tested by the body. The code word is loaded from the function object and the call
;; carries callee, `this`, undefined `new.target`, actual count and a managed vector. The adapter
;; supplies undefined for missing formals; it does not change the caller's actual count.
(defn jsl-lower-call-function [(x (ptr rd/Sexp))
                               (params (ptr rd/Sexp))
                               (values (ArrayList (dyn NodeOps)))
                               (local-names (mut (ArrayList (slice u8))))
                               (local-values (mut (ArrayList (dyn NodeOps))))
                               (ctrl (dyn NodeOps))
                               (mem (dyn NodeOps))] (-> JslExprResult)
  (let [abi (jsl-value-call-abi)
        packed-call (rd/sexp-sym-is (rd/sexp-nth x 0) "%CallFunctionPacked")
        (mut ctrl-nid) (n-nid ctrl)
        (mut mem-nid) (n-nid mem)
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))
        (mut i) 1]
    (if (not (.set abi))
        (panic "jsl-lower-call-function: the value-call ABI is not settled (the frontend installs it before bodies are lowered)")
        0)
    (loop (if (>= (load i) (rd/sexp-count x))
              (break 0)
              (let [arg
                      (jsl-lower-expr (rd/sexp-nth x (load i))
                                      params
                                      values
                                      (mut local-names)
                                      (mut local-values)
                                      (jsl-node (load ctrl-nid))
                                      (jsl-node (load mem-nid)))]
                (push! [(dyn NodeOps)] (mut args) (.value arg))
                (set! (mut ctrl-nid) (n-nid (.ctrl arg)))
                (set! (mut mem-nid) (n-nid (.mem arg)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [c (jsl-node (load ctrl-nid))
          m (jsl-node (load mem-nid))
          callee (get (load args) 0)
          receiver (get (load args) 1)
          raw (unbox-make callee REP-FUNCTION)
          code
            (load-make c
                       m
                       raw
                       (con-int OFFSET-FUNCTION-CODE)
                       ALIAS-FUNCTION-CODE
                       (.funptr-ty abi))
          (mut actuals) (al-new [(dyn NodeOps)] (compiler-allocator))
          (mut k) (if packed-call 5 2)]
      (loop (if (>= (load k) (len (load args)))
                (break 0)
                (do
                  (push! [(dyn NodeOps)] (mut actuals) (get (load args) (load k)))
                  (set! (mut k) (+ (load k) 1))
                  (continue))))
      (let [packed (if packed-call
                       (load (CallArguments :vector (get (load args) 4) :count (get (load args) 3)
                                            :memory m :direct (load actuals)))
                       (callabi-pack! c m (load actuals)))
            end (callabi-invoke! c (.memory packed) code callee receiver
                                 (if packed-call (get (load args) 2) (dyn-undefined-make))
                                 packed)]
        (al-free! (mut actuals))
        (al-free! (mut args))
        (jsl-expr-result (proj-make end RETURN-VALUE "jsl.value-call.value")
                         (cproj-make end RETURN-CTRL "jsl.value-call.ctrl")
                         (proj-make end RETURN-MEM "jsl.value-call.mem"))))))

(defn jsl-lower-runtime-primitive [(x (ptr rd/Sexp))
                                   (prim i64)
                                   (params (ptr rd/Sexp))
                                   (values (ArrayList (dyn NodeOps)))
                                   (local-names (mut (ArrayList (slice u8))))
                                   (local-values (mut (ArrayList (dyn NodeOps))))
                                   (ctrl (dyn NodeOps))
                                   (mem (dyn NodeOps))] (-> JslExprResult)
  (let [(mut ctrl-nid) (n-nid ctrl)
        (mut mem-nid) (n-nid mem)
        (mut args) (al-new [(dyn NodeOps)] (compiler-allocator))
        (mut i) 1]
    (loop (if (>= (load i) (rd/sexp-count x))
              (break 0)
              (let [arg
                      (jsl-lower-expr (rd/sexp-nth x (load i))
                                      params
                                      values
                                      (mut local-names)
                                      (mut local-values)
                                      (jsl-node (load ctrl-nid))
                                      (jsl-node (load mem-nid)))]
                (push! [(dyn NodeOps)] (mut args) (.value arg))
                (set! (mut ctrl-nid) (n-nid (.ctrl arg)))
                (set! (mut mem-nid) (n-nid (.mem arg)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [op
            (jsop-make (jsl-node (load ctrl-nid))
                       (jsl-node (load mem-nid))
                       prim)
          (mut arg) 0]
      (loop (if (>= (load arg) (len (load args)))
                (break 0)
                (do
                  (jsop-add-arg! op (get (load args) (load arg)))
                  (set! (mut arg) (+ (load arg) 1))
                  (continue))))
      (jsl-expr-result (proj-make op 2 "jsl.primitive.value")
                       (jsl-node (load ctrl-nid))
                       (proj-make op 1 "jsl.primitive.mem")))))

;; `(%SetPendingException v)`: the throw half of an abrupt completion from JSL — the pending word of
;; the runtime heap record takes the value and the result is the exception sentinel
;; (docs/DECISIONS.md, exceptions are a sentinel completion), which the definition returns and its
;; caller tests.
(defn jsl-lower-pending-throw-primitive [(x (ptr rd/Sexp))
                                         (params (ptr rd/Sexp))
                                         (values (ArrayList (dyn NodeOps)))
                                         (local-names (mut (ArrayList (slice u8))))
                                         (local-values (mut (ArrayList (dyn NodeOps))))
                                         (ctrl (dyn NodeOps))
                                         (mem (dyn NodeOps))] (-> JslExprResult)
  (let [value
          (jsl-lower-expr (rd/sexp-nth x 1)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          ctrl
                          mem)
        after-value
          (jsl-pending-store (.ctrl value)
                             (.mem value)
                             RT-HEAP-OFFSET-EXCEPTION-VALUE
                             ALIAS-EXCEPTION-VALUE
                             (.value value))]
    (jsl-expr-result (dyn-exception-make) (.ctrl value) after-value)))

(defn jsl-pending-store [(ctrl (dyn NodeOps))
                         (mem (dyn NodeOps))
                         (offset i64)
                         (alias i64)
                         (value (dyn NodeOps))] (-> (dyn NodeOps))
  (let [stored
          (store-make ctrl
                      mem
                      (heapstate-make)
                      (con-int offset)
                      value
                      alias
                      (ty-dyn TAG-ANY))
        merged (memmerge-make)]
    (memmerge-set-alias! merged ALIAS-BULK (mem-effective mem ALIAS-BULK))
    (if (= (n-op mem) OP-MEMMERGE)
        (let [(mut a) 2]
          (loop (if (>= (load a) (n-nins mem))
                    (break 0)
                    (do
                      (match (n-in mem (load a))
                        (Some [slice]
                              (if (= (load a) alias)
                                  0
                                  (memmerge-set-alias! merged (load a) slice)))
                        (None [] 0))
                      (set! (mut a) (+ (load a) 1))
                      (continue)))))
        0)
    (memmerge-set-alias! merged alias stored)
    merged))

(defn jsl-lower-prototype-store-primitive [(x (ptr rd/Sexp))
                                           (params (ptr rd/Sexp))
                                           (values (ArrayList (dyn NodeOps)))
                                           (local-names (mut (ArrayList (slice u8))))
                                           (local-values (mut (ArrayList (dyn NodeOps))))
                                           (ctrl (dyn NodeOps))
                                           (mem (dyn NodeOps))] (-> JslExprResult)
  (let [object
          (jsl-lower-expr (rd/sexp-nth x 1)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          ctrl
                          mem)
        prototype
          (jsl-lower-expr (rd/sexp-nth x 2)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          (.ctrl object)
                          (.mem object))
        stored
          (store-make (.ctrl prototype)
                      (.mem prototype)
                      (.value object)
                      (con-int OFFSET-OBJECT-PROTOTYPE)
                      (.value prototype)
                      ALIAS-OBJECT-PROTOTYPE
                      (ty-dyn (+ TAG-NULL (+ TAG-OBJECT (+ TAG-FUNCTION TAG-ARRAY)))))
        merged (memmerge-make)]
    (memmerge-set-alias! merged
                         ALIAS-BULK
                         (mem-effective (.mem prototype) ALIAS-BULK))
    (memmerge-set-alias! merged ALIAS-OBJECT-PROTOTYPE stored)
    (memmerge-set-alias! merged
                         ALIAS-OBJECT-PROPERTIES
                         (mem-effective (.mem prototype)
                                        ALIAS-OBJECT-PROPERTIES))
    (jsl-expr-result (.value object) (.ctrl prototype) merged)))

(defn jsl-lower-expr [(x (ptr rd/Sexp))
                      (params (ptr rd/Sexp))
                      (values (ArrayList (dyn NodeOps)))
                      (local-names (mut (ArrayList (slice u8))))
                      (local-values (mut (ArrayList (dyn NodeOps))))
                      (ctrl (dyn NodeOps))
                      (mem (dyn NodeOps))] (-> JslExprResult)
  (if (rd/sexp-int? x)
      (jsl-expr-result (con-int (rd/sexp-int x)) ctrl mem)
      (if (rd/sexp-str? x)
          (jsl-lower-string-literal (rd/sexp-str x) ctrl mem)
          (if (rd/sexp-sym? x)
              (jsl-expr-result (jsl-env-lookup params
                                               values
                                               (load local-names)
                                               (load local-values)
                                               (rd/sexp-sym x))
                               ctrl
                               mem)
              (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
                (if (= name "let")
                    (let [bindings (rd/sexp-nth x 1)
                          names-base (len (load local-names))
                          values-base (len (load local-values))
                          (mut current-ctrl-nid) (n-nid ctrl)
                          (mut current-mem-nid) (n-nid mem)
                          (mut i) 0]
                      (loop (if (>= (load i) (rd/sexp-count bindings))
                                (break 0)
                                (let [binding (rd/sexp-nth bindings (load i))
                                      init
                                        (jsl-lower-expr (rd/sexp-nth binding 1)
                                                        params
                                                        values
                                                        (mut local-names)
                                                        (mut local-values)
                                                        (jsl-node (load current-ctrl-nid))
                                                        (jsl-node (load current-mem-nid)))]
                                  ;; A local's value must survive the peepholes of what follows: an
                                  ;; initializer on a provably dead arm folds to a constant and the
                                  ;; original is reclaimed, but the name still has to reach its uses.
                                  ;; Simple's parser keeps every value it holds; so does this one.
                                  (n-keep! (.value init))
                                  (push! [(slice u8)]
                                         (mut local-names)
                                         (rd/sexp-sym (rd/sexp-nth binding 0)))
                                  (push! [(dyn NodeOps)]
                                         (mut local-values)
                                         (.value init))
                                  (set! (mut current-ctrl-nid)
                                        (n-nid (.ctrl init)))
                                  (set! (mut current-mem-nid)
                                        (n-nid (.mem init)))
                                  (set! (mut i) (+ (load i) 1))
                                  (continue))))
                      (let [body
                              (jsl-lower-expr (rd/sexp-nth x 2)
                                              params
                                              values
                                              (mut local-names)
                                              (mut local-values)
                                              (jsl-node (load current-ctrl-nid))
                                              (jsl-node (load current-mem-nid)))]
                        (loop (if (<= (len (load local-names)) names-base)
                                  (break 0)
                                  (do (pop! (mut local-names)) (continue))))
                        (loop (if (<= (len (load local-values)) values-base)
                                  (break 0)
                                  (do
                                    (match (pop! (mut local-values))
                                      (Some [v] (n-unkeep! v))
                                      (None [] 0))
                                    (continue))))
                        body))
                    (if (= name "if")
                        (let [pred
                                (jsl-lower-expr (rd/sexp-nth x 1)
                                                params
                                                values
                                                (mut local-names)
                                                (mut local-values)
                                                ctrl
                                                mem)]
                          (if (jsl-constant-condition? (.value pred))
                              ;; A condition already folded to a constant — a key compare against a
                              ;; literal at a macro site, a tag test the argument's type decides — lowers
                              ;; only the arm it selects. The If and the dead arm would be built and then
                              ;; deleted by the first peephole pass; not building them is the macro
                              ;; expander's constant folding (docs/DECISIONS.md, JSL definitions are
                              ;; built on demand). No narrowing Cast is lost: the test folded because the
                              ;; tested value's type already implies the answer.
                              (jsl-lower-expr (rd/sexp-nth x
                                                           (if (jsl-constant-condition-true? (.value pred))
                                                               2
                                                               3))
                                              params
                                              values
                                              (mut local-names)
                                              (mut local-values)
                                              (.ctrl pred)
                                              (.mem pred))
                              (let [iff (if-make (.ctrl pred) (.value pred))
                                    arms (if-arms! iff)
                                    region (region-make)
                                    pred-form (rd/sexp-nth x 1)
                                    guarded-name
                                      (if (and (= (n-op (.value pred))
                                                  OP-TYPETEST)
                                               (and (rd/sexp-list? pred-form)
                                                    (and (= (rd/sexp-count pred-form)
                                                            2)
                                                         (rd/sexp-sym? (rd/sexp-nth pred-form
                                                                                    1)))))
                                          (rd/sexp-sym (rd/sexp-nth pred-form 1))
                                          "")]
                                ;; As in final Simple's parseTrinary, both projections and the first arm
                                ;; result must survive construction of the other arm. A JSL expression
                                ;; carries control and memory as well as its value, unlike Simple's scalar
                                ;; local: an impossible arm can return an otherwise-unused XCtrl that an
                                ;; inner diamond would reclaim before this outer Region acquires it.
                                (n-keep! (arms-true arms))
                                (n-keep! (arms-false arms))
                                (n-keep! (.value pred))
                                (n-keep! (.mem pred))
                                ;; A tag predicate narrows the exact named value on its true edge. This is the
                                ;; JSL form of ScopeNode guard substitution: checked Unbox below this edge reads
                                ;; the Cast, while the fallback arm continues to see the original dynamic value.
                                (if (= guarded-name "")
                                    0
                                    (do
                                      (let [narrowed
                                              (cast-make (arms-true arms)
                                                         (n-in! (.value pred) 1)
                                                         (ty-dyn (typetest-tags (.value pred))))]
                                        (n-keep! narrowed)
                                        (push! [(slice u8)]
                                               (mut local-names)
                                               guarded-name)
                                        (push! [(dyn NodeOps)]
                                               (mut local-values)
                                               narrowed))))
                                (let [guarded-yes
                                        (jsl-lower-expr (rd/sexp-nth x 2)
                                                        params
                                                        values
                                                        (mut local-names)
                                                        (mut local-values)
                                                        (arms-true arms)
                                                        (.mem pred))]
                                  (n-keep! (.value guarded-yes))
                                  (n-keep! (.ctrl guarded-yes))
                                  (n-keep! (.mem guarded-yes))
                                  (if (= guarded-name "")
                                      0
                                      (do
                                        (pop! (mut local-names))
                                        (match (pop! (mut local-values))
                                          (Some [v] (n-unkeep! v))
                                          (None [] 0))
                                        0))
                                  ;; The false edge carries the complementary proof. Without this Cast,
                                  ;; `if (%IsUndefined x) ... (%UnboxNumber x)` keeps the original
                                  ;; undefined|number union in the else arm and reaches the backend as an
                                  ;; unproven unbox even though control established exactly the needed fact.
                                  (if (= guarded-name "")
                                      0
                                      (do
                                        (let [narrowed
                                                (cast-make (arms-false arms)
                                                           (n-in! (.value pred)
                                                                  1)
                                                           (ty-dyn (primitive/iand TAG-COMPLETION
                                                                                   (primitive/ixor TAG-COMPLETION
                                                                                                   (typetest-tags (.value pred))))))]
                                          (n-keep! narrowed)
                                          (push! [(slice u8)]
                                                 (mut local-names)
                                                 guarded-name)
                                          (push! [(dyn NodeOps)]
                                                 (mut local-values)
                                                 narrowed))))
                                  (let [lowered-no
                                          (jsl-lower-expr (rd/sexp-nth x 3)
                                                          params
                                                          values
                                                          (mut local-names)
                                                          (mut local-values)
                                                          (arms-false arms)
                                                          (.mem pred))
                                        phi
                                          (phi-make region
                                                    (ty-meet (n-ty (.value guarded-yes))
                                                             (n-ty (.value lowered-no)))
                                                    "jsl.if")]
                                    (if (= guarded-name "")
                                        0
                                        (do
                                          (pop! (mut local-names))
                                          (match (pop! (mut local-values))
                                            (Some [v] (n-unkeep! v))
                                            (None [] 0))
                                          0))
                                    (region-add-path! region
                                                      (.ctrl guarded-yes))
                                    (region-add-path! region (.ctrl lowered-no))
                                    (phi-add-value! phi (.value guarded-yes))
                                    (phi-add-value! phi (.value lowered-no))
                                    (let [memphi
                                            (memphi-make region
                                                         1
                                                         TY-BOT
                                                         "jsl.if.mem")]
                                      (memphi-add-state! memphi
                                                         (.mem guarded-yes))
                                      (memphi-add-state! memphi
                                                         (.mem lowered-no))
                                      (n-unkeep! (.value guarded-yes))
                                      (n-unkeep! (.ctrl guarded-yes))
                                      (n-unkeep! (.mem guarded-yes))
                                      (n-unkeep! (arms-true arms))
                                      (n-unkeep! (arms-false arms))
                                      (n-unkeep! (.value pred))
                                      (n-unkeep! (.mem pred))
                                      (jsl-expr-result phi region memphi)))))))
                        (if (or (= name "%CallFunction") (= name "%CallFunctionPacked")
                                (= name "%ArgumentAt") (= name "%ArgumentCountInt") (= name "%ArrayArgumentCount"))
                            (if (or (= name "%ArgumentAt") (= name "%ArgumentCountInt") (= name "%ArrayArgumentCount"))
                                (jsl-lower-argument-primitive x params values (mut local-names) (mut local-values) ctrl mem)
                            (jsl-lower-call-function x
                                                     params
                                                     values
                                                     (mut local-names)
                                                     (mut local-values)
                                                     ctrl
                                                     mem))
                            (if (= name "%PropStoreOwnNamed")
                                (jsl-lower-property-store-primitive x
                                                                    params
                                                                    values
                                                                    (mut local-names)
                                                                    (mut local-values)
                                                                    ctrl
                                                                    mem
                                                                    false)
                                (if (= name "%PropSetNamed")
                                    (jsl-lower-property-set-primitive x
                                                                      params
                                                                      values
                                                                      (mut local-names)
                                                                      (mut local-values)
                                                                      ctrl
                                                                      mem)
                                    (if (= name "%PropStoreOwnNamedAttrs")
                                        ;; (%PropStoreOwnNamedAttrs object key value attrs): the attributes are a
                                        ;; constant of the definition site.
                                        (jsl-lower-property-store-primitive x
                                                                            params
                                                                            values
                                                                            (mut local-names)
                                                                            (mut local-values)
                                                                            ctrl
                                                                            mem
                                                                            true)
                                        (if (= name "%SetPendingException")
                                            (jsl-lower-pending-throw-primitive x
                                                                               params
                                                                               values
                                                                               (mut local-names)
                                                                               (mut local-values)
                                                                               ctrl
                                                                               mem)
                                            (if (= name "%SetObjectPrototype")
                                                (jsl-lower-prototype-store-primitive x
                                                                                     params
                                                                                     values
                                                                                     (mut local-names)
                                                                                     (mut local-values)
                                                                                     ctrl
                                                                                     mem)
                                                (if (or (= name "%MakeClosure") (= name "%IntrinsicPrototype"))
                                                    (if (= name "%MakeClosure")
                                                    (jsl-lower-make-closure x params values (mut local-names) (mut local-values) ctrl mem)
                                                    ;; A well-known intrinsic object (`Array.prototype`, …): an image constant in
                                                    ;; a realm that materialized it; null otherwise (docs/DECISIONS.md, strings).
                                                    (jsl-expr-result (if (>= (do (jsl-demand-intrinsic! (rd/sexp-str (rd/sexp-nth x 1)))
                                                                                 (heap-intrinsic-entry (rd/sexp-str (rd/sexp-nth x
                                                                                                                             1))))
                                                                             0)
                                                                         (box-make (staticref-make (heap-intrinsic-entry (rd/sexp-str (rd/sexp-nth x
                                                                                                                                                   1)))
                                                                                                   REP-OBJECT))
                                                                         (dyn-null-make))
                                                                     ctrl
                                                                     mem))
                                                    (if (or (= name "%WellKnownKey") (= name "%InternalKey"))
                                                        ;; The property key of a well-known Symbol,
                                                        ;; named by its description: one id for the
                                                        ;; image and the program alike.
                                                        (jsl-expr-result (keyref-make (shape-key-intern-symbol! (rd/sexp-str (rd/sexp-nth x
                                                                                                                              1))))
                                                                         ctrl
                                                                         mem)
                                                    (if (= name "%PropertyKey")
                                                        (jsl-expr-result (keyref-make (shape-key-intern (rd/sexp-str (rd/sexp-nth x
                                                                                                                              1))))
                                                                         ctrl
                                                                         mem)
                                                        (if (!= (prim-lookup name)
                                                                0)
                                                            (jsl-lower-runtime-primitive x
                                                                                         (prim-lookup name)
                                                                                         params
                                                                                         values
                                                                                         (mut local-names)
                                                                                         (mut local-values)
                                                                                         ctrl
                                                                                         mem)
                                                            (if (or (= name "%NewObjectWithShape")
                                                                    (= name
                                                                       "%NewObject")
                                                                    (= name
                                                                       "%Undefined")
                                                                    (= name
                                                                       "%Null")
                                                                    (= name
                                                                       "%GlobalObject"))
                                                                (if (or (= name "%NewObject") (= name "%NewObjectWithShape"))
                                                                    (if (= name "%NewObject")
                                                                        (jsl-lower-new-object ctrl mem)
                                                                        (let [layout (jsl-lower-expr (rd/sexp-nth x 1)
                                                                                      params values (mut local-names)
                                                                                      (mut local-values) ctrl mem)]
                                                                          (jsl-lower-new-shaped-object (.ctrl layout) (.mem layout) (.value layout))))
                                                                    (jsl-expr-result (if (= name
                                                                                            "%Null")
                                                                                         (box-make-rep-at (Some ctrl)
                                                                                                          (con-int 0)
                                                                                                          REP-NULL)
                                                                                         (if (= name
                                                                                                "%GlobalObject")
                                                                                             ;; Share the frontend's binding decision: reusable
                                                                                             ;; units read the executing realm's root.
                                                                                             (if (>= (heap-global-reference-entry)
                                                                                                     0)
                                                                                                 (box-make (staticref-make (heap-global-reference-entry)
                                                                                                                           REP-OBJECT))
                                                                                                 (realm-global-object-load ctrl
                                                                                                                           mem))
                                                                                             (dyn-undefined-make)))
                                                                                     ctrl
                                                                                     mem))
                                                                (if (>= (jsl-definition-arity name)
                                                                        0)
                                                                    (jsl-lower-call x
                                                                                    name
                                                                                    params
                                                                                    values
                                                                                    (mut local-names)
                                                                                    (mut local-values)
                                                                                    ctrl
                                                                                    mem)
                                                                    (let [lhs
                                                                            (jsl-lower-expr (rd/sexp-nth x
                                                                                                         1)
                                                                                            params
                                                                                            values
                                                                                            (mut local-names)
                                                                                            (mut local-values)
                                                                                            ctrl
                                                                                            mem)]
                                                                      (if (jsl-unary-primitive? name)
                                                                          (jsl-expr-result (jsl-lower-unary-primitive name
                                                                                                                      (.value lhs)
                                                                                                                      (.ctrl lhs))
                                                                                           (.ctrl lhs)
                                                                                           (.mem lhs))
                                                                          (if (= name
                                                                                 "%StringLength")
                                                                              (jsl-expr-result (load-make (.ctrl lhs)
                                                                                                          (.mem lhs)
                                                                                                          (.value lhs)
                                                                                                          (con-int 0)
                                                                                                          ALIAS-STRING-LENGTH
                                                                                                          (ty-int-bot))
                                                                                               (.ctrl lhs)
                                                                                               (.mem lhs))
                                                                              ;; An array's length word, read as memory: every element store and
                                                                              ;; length change is a runtime operation whose memory result is BOT.
                                                                              (if (= name
                                                                                     "%ArrayLen")
                                                                                  (jsl-expr-result (load-make (.ctrl lhs)
                                                                                                              (.mem lhs)
                                                                                                              (.value lhs)
                                                                                                              (con-int OFFSET-ARRAY-LENGTH)
                                                                                                              ALIAS-ARRAY-LENGTH
                                                                                                              (ty-int-bot))
                                                                                                   (.ctrl lhs)
                                                                                                   (.mem lhs))
                                                                                  ;; A proven function object's raw FUNCTION-FLAG-* word.
                                                                                  ;; `%ClosureEnv`: the environment word, a JavaScript value.
                                                                                  (if (or (= name "%FunctionFlags") (= name "%ClosureEnv"))
                                                                                      (jsl-expr-result (if (= name "%FunctionFlags")
                                                                                                           (load-make (.ctrl lhs)
                                                                                                                  (.mem lhs)
                                                                                                                  (n-peephole! (unbox-make (.value lhs) REP-FUNCTION))
                                                                                                                  (con-int OFFSET-FUNCTION-FLAGS)
                                                                                                                  ALIAS-FUNCTION-FLAGS
                                                                                                                  (ty-int-bot))
                                                                                                           (load-make (.ctrl lhs)
                                                                                                                  (.mem lhs)
                                                                                                                  (n-peephole! (unbox-make (.value lhs) REP-FUNCTION))
                                                                                                                  (con-int OFFSET-FUNCTION-ENV)
                                                                                                                  ALIAS-FUNCTION-ENV
                                                                                                                  (ty-dyn TAG-ANY)))
                                                                                                       (.ctrl lhs)
                                                                                                       (.mem lhs))
                                                                                  (if (= name
                                                                                         "%GetObjectPrototype")
                                                                                      (jsl-expr-result (load-make (.ctrl lhs)
                                                                                                                  (.mem lhs)
                                                                                                                  (.value lhs)
                                                                                                                  (con-int OFFSET-OBJECT-PROTOTYPE)
                                                                                                                  ALIAS-OBJECT-PROTOTYPE
                                                                                                                  (ty-dyn (+ TAG-NULL (+ TAG-OBJECT (+ TAG-FUNCTION TAG-ARRAY)))))
                                                                                                       (.ctrl lhs)
                                                                                                       (.mem lhs))
                                                                                      (if (!= (jsl-tag-predicate name)
                                                                                              0)
                                                                                          (jsl-expr-result (n-peephole! (typetest-make (.value lhs)
                                                                                                                                       (jsl-tag-predicate name)))
                                                                                                           (.ctrl lhs)
                                                                                                           (.mem lhs))
                                                                                          (let [rhs
                                                                                                  (jsl-lower-expr (rd/sexp-nth x
                                                                                                                               2)
                                                                                                                  params
                                                                                                                  values
                                                                                                                  (mut local-names)
                                                                                                                  (mut local-values)
                                                                                                                  (.ctrl lhs)
                                                                                                                  (.mem lhs))]
                                                                                            (if (or (= name
                                                                                                       "%PropLoadOwnNamed")
                                                                                                    (= name
                                                                                                       "%PropHasOwnNamed")
                                                                                                    (= name
                                                                                                       "%PropAttrsOwn")
                                                                                                    (= name
                                                                                                       "%PropChainHolder")
                                                                                                    (= name
                                                                                                       "%PropGetNamed"))
                                                                                                (let [key-id
                                                                                                        (keyref-local (.value rhs))]
                                                                                                  (let [constant-key
                                                                                                          (>= key-id 0)
                                                                                                        ;; A constant key is a PropAccess node: it folds
                                                                                                        ;; to a Load or a constant when the owner's backing
                                                                                                        ;; store is visible, now or after inlining, and
                                                                                                        ;; expands to the dispatch only if it never is. A
                                                                                                        ;; runtime key keeps the keyed dispatch.
                                                                                                        access
                                                                                                          (if (= name
                                                                                                                 "%PropLoadOwnNamed")
                                                                                                              (if constant-key
                                                                                                                  (prop-access-emit (.ctrl rhs)
                                                                                                                                    (.mem rhs)
                                                                                                                                    (.value lhs)
                                                                                                                                    (None [(dyn NodeOps)])
                                                                                                                                    key-id
                                                                                                                                    PROP-LOAD)
                                                                                                                  (property-load-own-keyed (.ctrl rhs)
                                                                                                                                           (.mem rhs)
                                                                                                                                           (.value lhs)
                                                                                                                                           (.value rhs)))
                                                                                                              (if (= name
                                                                                                                     "%PropGetNamed")
                                                                                                                  (if constant-key
                                                                                                                      (prop-access-emit (.ctrl rhs)
                                                                                                                                        (.mem rhs)
                                                                                                                                        (.value lhs)
                                                                                                                                        (None [(dyn NodeOps)])
                                                                                                                                        key-id
                                                                                                                                        PROP-GET)
                                                                                                                      (property-generic-access (.ctrl rhs)
                                                                                                                                               (.mem rhs)
                                                                                                                                               (.value lhs)
                                                                                                                                               (.value rhs)
                                                                                                                                               (None [(dyn NodeOps)])
                                                                                                                                               JS-PROP-GET))
                                                                                                                  (if (= name
                                                                                                                         "%PropChainHolder")
                                                                                                                      (if constant-key
                                                                                                                          (prop-access-emit (.ctrl rhs)
                                                                                                                                            (.mem rhs)
                                                                                                                                            (.value lhs)
                                                                                                                                            (None [(dyn NodeOps)])
                                                                                                                                            key-id
                                                                                                                                            PROP-HOLDER)
                                                                                                                          (property-holder-keyed (.ctrl rhs)
                                                                                                                                                 (.mem rhs)
                                                                                                                                                 (.value lhs)
                                                                                                                                                 (.value rhs)))
                                                                                                                      (if (= name
                                                                                                                             "%PropAttrsOwn")
                                                                                                                          (if constant-key
                                                                                                                              (prop-access-emit (.ctrl rhs)
                                                                                                                                                (.mem rhs)
                                                                                                                                                (.value lhs)
                                                                                                                                                (None [(dyn NodeOps)])
                                                                                                                                                key-id
                                                                                                                                                PROP-ATTRS)
                                                                                                                              (property-attrs-own-keyed (.ctrl rhs)
                                                                                                                                                        (.mem rhs)
                                                                                                                                                        (.value lhs)
                                                                                                                                                        (.value rhs)))
                                                                                                                          (if constant-key
                                                                                                                              (prop-access-emit (.ctrl rhs)
                                                                                                                                                (.mem rhs)
                                                                                                                                                (.value lhs)
                                                                                                                                                (None [(dyn NodeOps)])
                                                                                                                                                key-id
                                                                                                                                                PROP-HAS)
                                                                                                                              (property-has-own-keyed (.ctrl rhs)
                                                                                                                                                      (.mem rhs)
                                                                                                                                                      (.value lhs)
                                                                                                                                                      (.value rhs)))))))]
                                                                                                    (jsl-expr-result (.value access)
                                                                                                                     (.ctrl access)
                                                                                                                     (.mem access))))
                                                                                                (jsl-expr-result (jsl-lower-binary-primitive name
                                                                                                                                             (.value lhs)
                                                                                                                                             (.value rhs))
                                                                                                                 (.ctrl rhs)
                                                                                                                 (.mem rhs))))))))))))))))))))))))))))))

(defn jsl-declare-form! [(form (ptr rd/Sexp))] (-> i64)
  (let [name (rd/sexp-sym (rd/sexp-nth form 1))]
    (jsl-graphs-boot!)
    (let [fidx (len (.items (jsl-graphs)))]
      ;; Reserve the complete JSL namespace at declaration time. A definition need not happen to
      ;; have a FunPtr use, so relying on `funptr-make` to advance the allocator lets the source
      ;; frontend reuse a runtime-library identity and relocations can bind to the wrong symbol.
      (reserve-fidx! fidx)
      (push! [JslGraph] (mut (.items (jsl-graphs))) (jsl-graph-new name 0 fidx form))
      fidx)))

;; The position of a declared definition in the table, or -1.
(defn jsl-graph-index [(name (slice u8))] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break -1)
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (if (= (.name g) name)
                      (break (load i))
                      (do (set! (mut i) (+ (load i) 1)) (continue)))))))))

;; Build the Fun, its Parms and its signature for a declared definition, and queue its body. The
;; body is lowered by `jsl-define-pending!`, never here: a body's own calls demand further
;; definitions, and a nested lowering would fold their nodes into this definition's size.
(defn jsl-build-graph! [(index i64)] (-> (dyn NodeOps))
  (do
    ;; The closed-world image facts (aot.node.imagefacts) were computed over every graph that
    ;; existed; a graph built afterwards would hold stores the facts never saw.
    (if (facts-ready?)
        (panic "jsl-build-graph!: a JSL definition was demanded after the closed-world image facts were computed")
        0)
    (jsl-build-graph-now! index)))

(defn jsl-build-graph-now! [(index i64)] (-> (dyn NodeOps))
  (let [a (compiler-allocator)
        entry (get (.items (jsl-graphs)) index)
        name (.name entry)
        form
          (match (jsl-definition-form name)
            (Some [f] f)
            (None []
                  (do
                    (panic "jsl-build-graph!: declared definition has no form")
                    (primitive/cast (ptr rd/Sexp) 0))))
        params (jsl-form-params form)
        ;; A `:throws` definition returns a completion: its value or the exception sentinel.
        ret-ty (jsl-form-result-type form)
        (mut sig-members) (al-new [i64] a)]
    ;; Signature layout is `(return, arg0, arg1, ...)`, exactly the layout Fun/Parm consume.
    (push! [i64] (mut sig-members) ret-ty)
    (let [(mut i) 0]
      (loop (if (>= (load i) (rd/sexp-count params))
                (break 0)
                (do
                  (push! [i64]
                         (mut sig-members)
                         (jsl-lower-type (rd/sexp-nth (rd/sexp-nth params
                                                                   (load i))
                                                      1)))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (let [start (start-make ret-ty)
          fun (fun-make start (ty-tuple (al-slice (load sig-members))) name)]
      ;; Exported definitions need their declared identity even when no local FunPtr refers to
      ;; them. Registration must not depend on whether this unit happens to call its own export.
      (arena-register-function! (.fidx entry) fun)
      ;; A JSL definition inlines only on evidence (aot.node.call, callend--inline-evidence?).
      (fun-set-jsl! fun)
      (let [mem-parm (parm-make-slot fun CALL-MEM (ty-mem 1 TY-BOT) "$mem")]
        (parm-set-unknown-input! mem-parm (proj-make start 1 "jsl.start.mem"))
        (n-keep! mem-parm))
      (let [(mut i) 0]
        (loop (if (>= (load i) (rd/sexp-count params))
                  (break 0)
                  (let [decl (rd/sexp-nth params (load i))
                        p
                          (parm-make fun
                                     (load i)
                                     (jsl-lower-type (rd/sexp-nth decl 1))
                                     (rd/sexp-sym (rd/sexp-nth decl 0)))]
                    (n-keep! p)
                    (set! (mut i) (+ (load i) 1))
                    (continue)))))
      (set! (mut (.items (jsl-graphs)))
            index
            (jsl-graph-new name (n-nid fun) (.fidx entry) form))
      (push! [i64] (mut (.pending (jsl-graphs))) index)
      fun)))

(defn jsl-define-form! [(form (ptr rd/Sexp))] (-> (dyn NodeOps))
  (let [prior (n-origin-enter! (rd/sexp-sym (rd/sexp-nth form 1)) "generic" -1 -1)
        answer (jsl-define-form-inner! form)]
    (n-origin-leave! prior)
    answer))

(defn jsl-define-form-inner! [(form (ptr rd/Sexp))] (-> (dyn NodeOps))
  (let [a (compiler-allocator)
        name (rd/sexp-sym (rd/sexp-nth form 1))
        params (jsl-form-params form)
        fun (jsl-graph-of name)
        body-start (arena-node-count)
        (mut values) (al-new [(dyn NodeOps)] a)
        (mut local-names) (al-new [(slice u8)] a)
        (mut local-values) (al-new [(dyn NodeOps)] a)]
    (let [(mut i) 0]
      (loop (if (>= (load i) (rd/sexp-count params))
                (break 0)
                (do
                  (match (fun-parm fun (load i))
                    (Some [p]
                          (do
                            (push! [(dyn NodeOps)] (mut values) p)
                            (n-unkeep! p)))
                    (None []
                          (panic "jsl-define-form!: declared parameter is missing")))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (let [mem
            (match (fun-mem-parm fun)
              (Some [m] (do (n-unkeep! m) m))
              (None []
                    (do
                      (panic "jsl-define-form!: memory Parm is missing")
                      (unreachable-node))))
          body
            (jsl-lower-expr (jsl-form-body form)
                            params
                            (load values)
                            (mut local-names)
                            (mut local-values)
                            fun
                            mem)
          ret
            (return-make (.ctrl body)
                         (Some (.mem body))
                         (.value body)
                         (None [(dyn NodeOps)])
                         (Some fun))]
      (fun-set-ret! fun ret)
      ;; All JSL declarations are hoisted before any definition. Measure only nodes allocated by
      ;; this definition so unrelated later headers cannot push a small builtin over Simple's
      ;; inlining cap.
      (fun-set-approx-size! fun (- (arena-node-count) body-start))
      fun)))

;; Lower the bodies of every built graph that has none, including those the bodies themselves
;; demand, until nothing is pending. Returns how many bodies were lowered.
(defn jsl-define-pending! [] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut next) 0]
      (loop (if (>= (load next) (len (.pending (jsl-graphs))))
                (break 0)
                (let [entry
                        (get (.items (jsl-graphs))
                             (get (.pending (jsl-graphs)) (load next)))]
                  (match (jsl-definition-form (.name entry))
                    (Some [form] (jsl-define-form! form))
                    (None []
                          (do
                            (panic "jsl-define-pending!: built definition has no form")
                            (unreachable-node))))
                  (set! (mut next) (+ (load next) 1))
                  (continue))))
      (al-clear! [i64] (mut (.pending (jsl-graphs))))
      (load next))))

(defn jsl-lower-form! [(form (ptr rd/Sexp))] (-> (dyn NodeOps))
  (if (jsl-form-macro? form)
      (do
        (panic "jsl-lower-form!: a macro has no standalone graph")
        (unreachable-node))
      (do
        (jsl-declare-form! form)
        (jsl-graph-defined (rd/sexp-sym (rd/sexp-nth form 1))))))

;; A unit on its own, every definition built and lowered: the tests' entry point. Production goes
;; through `jsl-lower-index!`, which declares and lets the program demand.
(defn jsl-lower-unit! [(unit i64)] (-> i64)
  (do
    (jsl-check-unit unit)
    (let [(mut i) 0]
      (loop (if (>= (load i) (jsl-form-count unit))
                (break 0)
                (do
                  (if (not (jsl-form-builtin? (jsl-form unit (load i))))
                      0
                      (do (jsl-declare-form! (jsl-form unit (load i))) 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) (jsl-form-count unit))
                (break 0)
                (do
                  (if (not (jsl-form-builtin? (jsl-form unit (load i))))
                      0
                      (do
                        (jsl-graph-of (rd/sexp-sym (rd/sexp-nth (jsl-form unit
                                                                          (load i))
                                                                1)))
                        0))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (jsl-define-pending!)
      (load i))))

;; The Fun for a named JSL definition: the demand point. The first demand builds the Fun and its
;; Parms and queues the body (docs/DECISIONS.md, JSL definitions are built on demand); a call
;; site needs only the Fun. Demanding a definition after `jsl-close-world!` is an error: the
;; frontend installs every semantic call before the world closes.
(defn jsl-graph-of [(name (slice u8))] (-> (dyn NodeOps))
  (let [index (jsl-graph-index name)]
    (if (< index 0)
        (do (panic "jsl-graph-of: unknown JSL definition") (unreachable-node))
        (let [g (get (.items (jsl-graphs)) index)]
          (if (= (.nid g) 0)
              (if (.closed (jsl-graphs))
                  (do
                    (panic "jsl-graph-of: a JSL definition was demanded after the world closed")
                    (unreachable-node))
                  (jsl-build-graph! index))
              (match (arena-node (.nid g))
                (Some [n] n)
                (None []
                      (do
                        (panic "jsl-graph-of: stale graph id")
                        (unreachable-node)))))))))

;; The Fun with its body lowered: for tests and tools that inspect a definition's graph.
(defn jsl-graph-defined [(name (slice u8))] (-> (dyn NodeOps))
  (do
    (jsl-graph-of name)
    (jsl-define-pending!)
    (jsl-graph-of name)))

;; Whether a definition's graph was demanded by this compile.
(defn jsl-graph-built? [(name (slice u8))] (-> bool)
  (let [index (jsl-graph-index name)]
    (if (< index 0)
        false
        (let [g (get (.items (jsl-graphs)) index)] (!= (.nid g) 0)))))

;; Whether a named builtin definition is in the loaded production index. The frontend admits
;; operator syntax ahead of its semantics and must refuse an absent definition by name.
(defn jsl-defined? [(name (slice u8))] (-> bool)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break false)
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (if (= (.name g) name)
                      (break true)
                      (do (set! (mut i) (+ (load i) 1)) (continue)))))))))

(defn jsl-fidx-of [(name (slice u8))] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break (do (panic "jsl-fidx-of: unknown JSL definition") 0))
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (if (= (.name g) name)
                      (break (.fidx g))
                      (do (set! (mut i) (+ (load i) 1)) (continue)))))))))

;; One production entry point for a compilation. Units and function indices are exactly index
;; ordered; resetting both stores prevents stale arena IDs from crossing compilation boundaries.
(defn jsl-lower-index! [(path (slice u8))] (-> i64)
  (do
    (jsl-reset!)
    (jsl-lower-reset!)
    (jsl-lower-loaded-library! (jsl-load-library! path))))

;; `jsl-lower-index!` over a library this compilation already loaded with `jsl-load-library!`
;; (syntax collection reads the intrinsic declarations before any graph exists).
(defn jsl-lower-loaded-index! [] (-> i64)
  (do
    (jsl-lower-reset!)
    (jsl-lower-loaded-library! (jsl-unit-count))))

(defn jsl-lower-loaded-library! [(units i64)] (-> i64)
  (do
    (let [(mut unit) 1]
      ;; Check the complete table first, then declare every function. Declaring is the JSL
      ;; equivalent of JavaScript function hoisting: forward references are independent of file
      ;; order and function indices follow index order. No body is lowered here — a definition's
      ;; graph is built when the program (or another body) first calls it, and the bodies are
      ;; lowered by `jsl-close-world!` before the hooks come off.
      (loop (if (or (.checked (jsl-library)) (> (load unit) units))
                (break 0)
                (do
                  (jsl-check-unit (load unit))
                  (set! (mut unit) (+ (load unit) 1))
                  (continue))))
      (set! (.checked (jsl-library)) true)
      (set! (mut unit) 1)
      (loop (if (> (load unit) units)
                (break 0)
                (let [(mut i) 0]
                  (loop (if (>= (load i) (jsl-form-count (load unit)))
                            (break 0)
                            (do
                              (if (not (jsl-form-builtin? (jsl-form (load unit)
                                                             (load i))))
                                  0
                                  (do
                                    (jsl-declare-form! (jsl-form (load unit)
                                                                 (load i)))
                                    0))
                              (set! (mut i) (+ (load i) 1))
                              (continue))))
                  (set! (mut unit) (+ (load unit) 1))
                  (continue))))
      units)))

;; Close the loaded JSL call graph only after the frontend has installed every semantic call:
;; lower every demanded body (whose calls demand more, to a fixpoint), then drop the unknown-caller
;; hooks. A definition nothing demanded has no graph at all.
(defn jsl-close-world! [] (-> i64)
  (do
    (jsl-graphs-boot!)
    (jsl-define-pending!)
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break 0)
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (if (= (.nid g) 0)
                      0
                      (match (arena-node (.nid g))
                        (Some [fun]
                              (if (and (fun-unknown-callers? fun)
                                       (not (and (= (.link-mode (jsl-graphs)) JSL-LINK-PROVIDER)
                                                 (jsl-shared-definition? (.form g)))))
                                  (fun-drop-unknown-callers! fun)
                                  0))
                        (None [] (panic "jsl-close-world!: stale graph id"))))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (set! (.closed (jsl-graphs)) true)
    0))

;; JSL Returns are not parser roots: until closed-world call discovery decides which bodies survive,
;; each one needs the same temporary ownership that `parser-prepare-opto!` gives source functions.
;; Final Simple obtains this lifetime structurally because a FunPtr points at the callee Return;
;; our FunPtr points at the Fun so forward JSL declarations can be lowered before their bodies.
;; Keeping the Return here preserves the whole definition across optimistic SCCP and the final
;; all-arena sweep without prematurely making every runtime-library body a compilation-unit root.
(defn jsl-prepare-opto! [] (-> i64)
  (do
    (jsl-graphs-boot!)
    (if (> (len (.pending (jsl-graphs))) 0)
        (panic "jsl-prepare-opto!: demanded JSL definitions have no bodies yet (jsl-define-pending! runs after lowering)")
        0)
    (let [(mut i) 0
          (mut kept) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break (load kept))
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (if (= (.nid g) 0)
                      0
                      (match (arena-node (.nid g))
                        (Some [fun]
                              (match (fun-ret fun)
                                (Some [ret]
                                      (do
                                        (n-keep! ret)
                                        (set! (mut kept) (+ (load kept) 1))
                                        0))
                                (None []
                                      (panic "jsl-prepare-opto!: JSL Fun has no Return"))))
                        (None [] (panic "jsl-prepare-opto!: stale graph id"))))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))))

;; Final Simple's compilation-unit rooting applies to runtime-library functions as well as source
;; declarations. A JSL body that survives inlining must remain an emitted definition; its linked
;; Call edges are optimisation metadata and will be removed before selection. Release every
;; temporary keep installed by `jsl-prepare-opto!`; a surviving definition first gains the Stop
;; edge that owns it for code generation, while an inlined/dead body is allowed to disappear.
(defn jsl-finish-opto! [(stop (dyn NodeOps))] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0
          (mut retained) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break (load retained))
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (if (= (.nid g) 0)
                      0
                      (match (arena-node (.nid g))
                        (Some [fun]
                              (match (fun-ret fun)
                                (Some [ret]
                                      ;; A definition specialized at every one of its sites loses its
                                      ;; last caller and is collected during Opto, taking its Return
                                      ;; with it (docs/SPECIALIZE.md). The hold `jsl-prepare-opto!`
                                      ;; installed went with it; releasing it again is an unkeep of a
                                      ;; node that is no longer kept.
                                      (if (n-dead? ret)
                                          0
                                      (if (and (and (not (n-dead? fun))
                                                    (not (fun-folding? fun)))
                                               (not (ty-high? (n-ty fun))))
                                          (do
                                            (stop-add-return! stop ret)
                                            (set! (mut retained)
                                                  (+ (load retained) 1))
                                            (n-unkill! ret))
                                          ;; Releasing the temporary hold must also collect an inlined
                                          ;; Return that has no CallEnd or Stop owner. A bare unkeep
                                          ;; leaves that unused CFG sink attached to caller control,
                                          ;; where it can corrupt later loop-tree nesting.
                                          (n-unkill! ret))))
                                (None []
                                      (panic "jsl-finish-opto!: JSL Fun lost its Return"))))
                        (None [] 0)))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))))

(defn jsl-prepare-codegen! [(start (dyn NodeOps))] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0
          (mut prepared) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break (load prepared))
                (do
                  (let [g (get (.items (jsl-graphs)) (load i))]
                    (if (= (.nid g) 0)
                        0
                        (match (arena-node (.nid g))
                          (Some [fun]
                                (set! (mut prepared)
                                      (+ (load prepared)
                                         (fun-prepare-codegen! fun start))))
                          (None [] 0))))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))))

;; The transition check over what was lowered: every path that may call JavaScript or move the heap
;; carries a Safepoint, and every live reference across it is relocated.
(defn jsl-check-transitions [(root (dyn NodeOps))] (-> i64)
  ;; The admitted fixture subset contains only pure Box/Unbox/arithmetic operations. As the
  ;; checker admits transitioning primitives, this becomes the graph walk that proves Safepoints.
  (do root 0))

(defn jsl-lower-make-closure [(x (ptr rd/Sexp))
                              (params (ptr rd/Sexp))
                              (values (ArrayList (dyn NodeOps)))
                              (local-names (mut (ArrayList (slice u8))))
                              (local-values (mut (ArrayList (dyn NodeOps))))
                              (ctrl (dyn NodeOps))
                              (mem (dyn NodeOps))] (-> JslExprResult)
  (let [maker (jsl-closure-maker)]
    (if (not (.installed maker))
        (panic "jsl-lower-make-closure: no frontend installed the closure maker (%MakeClosure needs a realm)")
        0)
    (let [proto (jsl-lower-expr (rd/sexp-nth x 2) params values (mut local-names) (mut local-values) ctrl mem)]
      (n-keep! (.value proto))
      (let [env (jsl-lower-expr (rd/sexp-nth x 3) params values (mut local-names) (mut local-values) (.ctrl proto) (.mem proto))]
        (n-keep! (.value env))
        (let [flags (jsl-lower-expr (rd/sexp-nth x 4) params values (mut local-names) (mut local-values) (.ctrl env) (.mem env))
              name (rd/sexp-str (rd/sexp-nth x 1))]
          (n-unkeep! (.value env))
          (n-unkeep! (.value proto))
          (let [made (primitive/call-ptr (.f maker) (slice-data [u8] name) (len name)
                                         (n-nid (.ctrl flags)) (n-nid (.mem flags))
                                         (n-nid (.value proto)) (n-nid (.value env)) (n-nid (.value flags)))]
            (jsl-expr-result (jsl-node made) (.ctrl flags) (jsl-node (.memory maker)))))))))

;; The callable ABI's arguments as values a body can compute with (aot.codegen.callabi):
;; `(%ArgumentCountInt count)` is the count itself; `(%ArrayArgumentCount raw)` an array's length as a
;; count; `(%ArgumentAt vector index)` the overflow actual at `index` (3 or more, below the count the
;; body tested), one word of the managed vector.
(defn jsl-lower-argument-primitive [(x (ptr rd/Sexp))
                                    (params (ptr rd/Sexp))
                                    (values (ArrayList (dyn NodeOps)))
                                    (local-names (mut (ArrayList (slice u8))))
                                    (local-values (mut (ArrayList (dyn NodeOps))))
                                    (ctrl (dyn NodeOps))
                                    (mem (dyn NodeOps))] (-> JslExprResult)
  (let [name (rd/sexp-sym (rd/sexp-nth x 0))
        first (jsl-lower-expr (rd/sexp-nth x 1) params values (mut local-names) (mut local-values) ctrl mem)]
    (if (= name "%ArgumentCountInt")
        first
        (if (= name "%ArrayArgumentCount")
            (jsl-expr-result (load-make (.ctrl first) (.mem first) (.value first)
                                        (con-int OFFSET-ARRAY-LENGTH) ALIAS-ARRAY-LENGTH
                                        (ty-int-range 0 CALL-ABI-MAX-ARGUMENTS))
                             (.ctrl first) (.mem first))
            (do
              (n-keep! (.value first))
              (let [index (jsl-lower-expr (rd/sexp-nth x 2) params values (mut local-names) (mut local-values)
                                          (.ctrl first) (.mem first))
                    offset (n-peephole! (mul-make (n-peephole! (sub-make (.value index) (con-int CALL-ABI-DIRECT-COUNT)))
                                                  (con-int 8)))]
                (n-unkeep! (.value first))
                (jsl-expr-result (load-make-mode (.ctrl index) (.mem index) (.value first) offset
                                                 ALIAS-CALL-ARGUMENTS (ty-dyn TAG-ANY) true)
                                 (.ctrl index) (.mem index))))))))
