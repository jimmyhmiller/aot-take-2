;; JSL into the ideal graph.

;;
;; This is the file that earns the whole JSL design. A builtin lowered here is ORDINARY GRAPH: the
;; interpreter runs it, the backend compiles it, the inliner inlines it, and the optimiser
;; specialises it into the caller — with no per-builtin arm in any of them.
;;
;; The alternative, which this exists to avoid: a builtin as an opcode costs an arm in `compute`,
;; `idealize`, the verifier, the printer, the interpreter and instruction selection. That is ten
;; dispatch sites per builtin, in a language with about a thousand builtins.
;;
;; It is also what makes `arr.map(f)` fast with no JIT. V8 inlines the Torque-generated graph for
;; `map` and specialises it against the callback; under the closed-world assumption the callback
;; here is STATICALLY KNOWN, so the same inlining needs no speculation to justify it and has no
;; deoptimisation path to maintain.
;;
;; STATUS: the checker-admitted core lowers completely to this graph vocabulary. Integer literals,
;; parameters, lexical `let`, value-producing `if`, the admitted pure primitives, calls between JSL
;; definitions, and dynamic tag predicates all have concrete lowering. `if` threads control and
;; memory through both arms and joins differing values with a Region/Phi; a recognized tag test
;; installs edge-local Cast proof before an Unbox. Index loading is two-pass, so every declaration
;; receives its stable function identity before bodies resolve forward calls. Temporary Return
;; ownership, closed-world caller removal, and final compilation-unit retention follow the same Fun
;; lifetime protocol as source declarations.
;;
;; Structured exits (`:labels`/`goto`/`:otherwise`) and transitioning primitives are not admitted
;; by `aot.jsl.check` yet. Consequently `jsl-check-transitions` is truthfully empty for today's pure
;; graph set; admitting allocation or a callback requires its safepoint/relocation walk first.
(module aot.jsl.lower)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.reader" :as rd)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.call" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.bits" :use *)
(import "aot.node.compare" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.property" :use *)
(import "aot.node.jsops" :use *)
(import "aot.shape" :use *)
(import "aot.type.type" :use *)
(import "aot.jsl.reader" :use *)
(import "aot.jsl.check" :use *)
(import "aot.jsl.prims" :use *)

(defstruct JslGraph [(name (slice u8)) (nid i64) (fidx i64)])

(defstruct JslGraphs [(items (ArrayList JslGraph)) (booted bool)])

(defn jsl-graphs [] (-> (ptr JslGraphs))
  (primitive/alloc-static JslGraphs))

(defn jsl-graphs-boot! [] (-> i64)
  (let [g (jsl-graphs)]
    (if (.booted g)
        0
        (do
          (set! (.items g) (al-new [JslGraph] (alloc/malloc-allocator)))
          (set! (.booted g) true)
          0))))

(defn jsl-lower-reset! [] (-> i64)
  (do
    (jsl-graphs-boot!)
    (al-clear! [JslGraph] (mut (.items (jsl-graphs))))
    0))

(defn jsl-graph-new [(name (slice u8)) (nid i64) (fidx i64)] (-> JslGraph)
  (let [(mut g) (primitive/zeroed JslGraph)]
    (set! (.name (mut g)) name)
    (set! (.nid (mut g)) nid)
    (set! (.fidx (mut g)) fidx)
    (load g)))

(defstruct JslExprResult [(value (dyn NodeOps)) (ctrl (dyn NodeOps)) (mem (dyn NodeOps))])

(defn jsl-expr-result [(value (dyn NodeOps)) (ctrl (dyn NodeOps)) (mem (dyn NodeOps))] (-> JslExprResult)
  (let [(mut r) (primitive/zeroed JslExprResult)]
    (set! (.value (mut r)) value)
    (set! (.ctrl (mut r)) ctrl)
    (set! (.mem (mut r)) mem)
    (load r)))

(defn jsl-env-lookup [(params (ptr rd/Sexp))
                      (values (ArrayList (dyn NodeOps)))
                      (local-names (ArrayList (slice u8)))
                      (local-values (ArrayList (dyn NodeOps)))
                      (name (slice u8))] (-> (dyn NodeOps))
  (let [(mut i) (- (len local-names) 1)
        local-idx
          (loop (if (< (load i) 0)
                    (break -1)
                    (if (= (get local-names (load i)) name)
                        (break (load i))
                        (do (set! (mut i) (- (load i) 1)) (continue)))))]
    (if (>= local-idx 0)
        (get local-values local-idx)
        (do
          (set! (mut i) 0)
          (loop (if (>= (load i) (rd/sexp-count params))
                    (break (do
                             (panic "jsl-env-lookup: checker admitted an unknown name")
                             (unreachable-node)))
                    (let [decl (rd/sexp-nth params (load i))]
                      (if (= (rd/sexp-sym (rd/sexp-nth decl 0)) name)
                          (break (get values (load i)))
                          (do (set! (mut i) (+ (load i) 1)) (continue))))))))))

(defn jsl-node [(nid i64)] (-> (dyn NodeOps))
  (match (arena-node nid) (Some [n] n) (None [] (unreachable-node))))

(defn jsl-lower-macro-values [(name (slice u8))
                              (args (ArrayList (dyn NodeOps)))
                              (ctrl (dyn NodeOps))
                              (mem (dyn NodeOps))] (-> JslExprResult)
  (match (jsl-definition-form name)
    (None [] (do (panic "jsl-lower-macro-values: unknown macro")
                 (jsl-expr-result (unreachable-node) ctrl mem)))
    (Some [form]
          (if (not (jsl-form-macro? form))
              (do (panic "jsl-lower-macro-values: definition is not a macro")
                  (jsl-expr-result (unreachable-node) ctrl mem))
              (if (!= (len args) (rd/sexp-count (jsl-form-params form)))
                  (do (panic "jsl-lower-macro-values: wrong argument count")
                      (jsl-expr-result (unreachable-node) ctrl mem))
                  (let [(mut local-names) (al-new [(slice u8)] (alloc/malloc-allocator))
                        (mut local-values) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))]
                    (jsl-lower-expr (jsl-form-body form)
                                    (jsl-form-params form)
                                    args
                                    (mut local-names)
                                    (mut local-values)
                                    ctrl
                                    mem)))))))

(defn jsl-lower-type [(x (ptr rd/Sexp))] (-> i64)
  (let [name (rd/sexp-sym x)]
    (if (= name "dyn")
        (ty-dyn TAG-ANY)
        (if (= name "int")
            (ty-int-bot)
            (if (= name "bool")
                (ty-bool)
                (if (= name "flt")
                    (ty-flt-bot)
                    (if (= name "obj")
                        (raw-object-ty)
                        (if (= name "str")
                            (raw-string-ty)
                            (do (panic "jsl-lower-type: checker/lowerer drift") TY-INVALID)))))))))

;; JSL defines ToBoolean as `%Not(%Not(v))`. The frontend requests that semantic expansion here so
;; the definition enters the ideal graph directly, just like a JSL macro expansion, without
;; manufacturing a runtime call boundary for a pure primitive composition.
(defn jsl-lower-toboolean-value [(value (dyn NodeOps))] (-> (dyn NodeOps))
  (n-peephole! (not-make (n-peephole! (not-make value)))))

(defn jsl-unary-primitive? [(name (slice u8))] (-> bool)
  (or (= name "%Box")
      (= name "%BoxInt")
      (= name "%BoxBool")
      (= name "%Not")
      (= name "%Neg")
      (= name "%UnboxInt")
      (= name "%UnboxBool")
      (= name "%UnboxFlt")
      (= name "%UnboxNumber")
      (= name "%UnboxString")
      (= name "%UnboxObject")
      (= name "%ToFloat")))

(defn jsl-lower-unary-primitive [(name (slice u8))
                                 (value (dyn NodeOps))
                                 (ctrl (dyn NodeOps))] (-> (dyn NodeOps))
  ;; The enclosing JslExprResult still owns this control after the value folds. Box attaches
  ;; control temporarily; folding Box(TOP) can otherwise kill a fresh CallEnd CProj before the
  ;; enclosing branch wires it into its Region. Keep borrowed operands across eager peepholing.
  (n-keep! ctrl)
  (n-keep! value)
  (let [result (jsl-lower-unary-primitive-inner name value ctrl)]
    (n-unkeep! value)
    (n-unkeep! ctrl)
    result))

(defn jsl-lower-unary-primitive-inner [(name (slice u8))
                                       (value (dyn NodeOps))
                                       (ctrl (dyn NodeOps))] (-> (dyn NodeOps))
  (if (= name "%Box")
      (n-peephole! (box-make-at (Some ctrl) value))
      (if (= name "%BoxInt")
          (n-peephole! (box-make-rep-at (Some ctrl) value REP-INT))
          (if (= name "%BoxBool")
              (n-peephole! (box-make-rep-at (Some ctrl) value REP-BOOL))
              (if (or (= name "%Not") (= name "%Neg"))
                  (n-peephole! (if (= name "%Neg") (minus-make value) (not-make value)))
                  (if (= name "%UnboxInt")
                      (n-peephole! (unbox-make value REP-INT))
                      (if (= name "%UnboxBool")
                          (n-peephole! (unbox-make value REP-BOOL))
                          (if (= name "%UnboxFlt")
                              (n-peephole! (unbox-make value REP-DOUBLE))
                              (if (= name "%UnboxNumber")
                                  (n-peephole! (unbox-make value REP-NUMBER))
                                  (if (= name "%UnboxString")
                                      (n-peephole! (unbox-make value REP-STRING))
                                      (if (= name "%UnboxObject")
                                          (n-peephole! (unbox-make value REP-OBJECT))
                                          (if (= name "%ToFloat")
                                              (n-peephole! (to-float-make value))
                                              (do
                                                (panic "jsl-lower-unary-primitive: checker/lowerer drift")
                                                (unreachable-node))))))))))))))

(defn jsl-lower-binary-primitive [(name (slice u8))
                                  (lhs (dyn NodeOps))
                                  (rhs (dyn NodeOps))] (-> (dyn NodeOps))
  (n-peephole! (if (= name "%Sub")
                   (sub-make lhs rhs)
                   (if (= name "%Add")
                       (add-make lhs rhs)
                       (if (= name "%Mul")
                           (mul-make lhs rhs)
                           (if (= name "%Div")
                               (div-make lhs rhs)
                               (if (or (= name "%Eq") (= name "%SameBits"))
                                   (if (= name "%SameBits") (eq-word-make lhs rhs) (eq-make lhs rhs))
                                   (if (= name "%Ne")
                                       (ne-make lhs rhs)
                                       (if (= name "%Lt")
                                           (lt-make lhs rhs)
                                           (if (= name "%Le")
                                               (le-make lhs rhs)
                                               (if (= name "%And")
                                                   (and-make lhs rhs)
                                                   (do
                                                     (panic "jsl-lower-binary-primitive: checker/lowerer drift")
                                                     (unreachable-node)))))))))))))

(defn jsl-lower-new-object [(ctrl (dyn NodeOps)) (mem (dyn NodeOps))] (-> JslExprResult)
  (let [fresh
          (new-make ctrl
                    (con-int OBJECT-PAYLOAD-BYTES)
                    mem
                    SHAPE-EMPTY
                    (ty-struct "JsObjectPayload"))
        ptr_ (proj-make fresh 0 "jsl.new-object.ptr")
        private-memory (proj-make fresh 1 "jsl.new-object.private-memory")
        null-value (box-make-rep-at (None [(dyn NodeOps)]) (con-int 0) REP-NULL)
        prototype-state
          (store-make ctrl
                      private-memory
                      ptr_
                      (con-int OFFSET-OBJECT-PROTOTYPE)
                      null-value
                      ALIAS-OBJECT-PROTOTYPE
                      (ty-dyn TAG-ANY))
        properties-state
          (store-make ctrl
                      prototype-state
                      ptr_
                      (con-int OFFSET-OBJECT-PROPERTIES)
                      null-value
                      ALIAS-OBJECT-PROPERTIES
                      (ty-dyn TAG-ANY))
        merged (memmerge-make)]
    (memmerge-set-alias! merged ALIAS-BULK mem)
    (memmerge-set-alias! merged ALIAS-OBJECT-PROTOTYPE prototype-state)
    (memmerge-set-alias! merged ALIAS-OBJECT-PROPERTIES properties-state)
    (jsl-expr-result ptr_ ctrl merged)))

(defn jsl-utf8-cont [(text (slice u8)) (i i64)] (-> i64)
  (if (>= i (len text))
      (do (panic "jsl string: truncated UTF-8") 0)
      (let [b (primitive/cast i64 (get text i))]
        (if (!= (& b 0xc0) 0x80) (do (panic "jsl string: invalid UTF-8 continuation") 0) (& b 0x3f)))))

(defn jsl-string-append-utf8! [(text (slice u8)) (units (mut (ArrayList i64)))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (len text))
              (break 0)
              (let [b0 (primitive/cast i64 (get text (load i))) (mut cp) 0 (mut width) 1]
                (if (< b0 0x80)
                    (set! (mut cp) b0)
                    (if (= (& b0 0xe0) 0xc0)
                        (do
                          (set! (mut cp) (| (primitive/ishl (& b0 0x1f) 6)
                                             (jsl-utf8-cont text (+ (load i) 1))))
                          (set! (mut width) 2)
                          (if (< (load cp) 0x80) (panic "jsl string: overlong UTF-8") 0))
                        (if (= (& b0 0xf0) 0xe0)
                            (do
                              (set! (mut cp)
                                    (| (primitive/ishl (& b0 0x0f) 12)
                                       (| (primitive/ishl (jsl-utf8-cont text (+ (load i) 1)) 6)
                                          (jsl-utf8-cont text (+ (load i) 2)))))
                              (set! (mut width) 3)
                              (if (or (< (load cp) 0x800)
                                      (and (>= (load cp) 0xd800) (<= (load cp) 0xdfff)))
                                  (panic "jsl string: invalid UTF-8 scalar")
                                  0))
                            (if (= (& b0 0xf8) 0xf0)
                                (do
                                  (set! (mut cp)
                                        (| (primitive/ishl (& b0 0x07) 18)
                                           (| (primitive/ishl
                                                (jsl-utf8-cont text (+ (load i) 1))
                                                12)
                                              (| (primitive/ishl
                                                   (jsl-utf8-cont text (+ (load i) 2))
                                                   6)
                                                 (jsl-utf8-cont text (+ (load i) 3))))))
                                  (set! (mut width) 4)
                                  (if (or (< (load cp) 0x10000) (> (load cp) 0x10ffff))
                                      (panic "jsl string: invalid UTF-8 scalar")
                                      0))
                                (panic "jsl string: invalid UTF-8 lead byte")))))
                (if (<= (load cp) 0xffff)
                    (push! [i64] (mut units) (load cp))
                    (let [supplement (- (load cp) 0x10000)]
                      (push! [i64] (mut units) (+ 0xd800 (primitive/ishr supplement 10)))
                      (push! [i64] (mut units) (+ 0xdc00 (& supplement 0x3ff)))))
                (set! (mut i) (+ (load i) (load width)))
                (continue))))
    0))

(defn jsl-string-utf16-units [(text (slice u8))] (-> (ArrayList i64))
  (let [(mut units) (al-new [i64] (alloc/malloc-allocator))]
    (jsl-string-append-utf8! text (mut units))
    (load units)))

(defn jsl-lower-string-literal [(text (slice u8))
                                (ctrl (dyn NodeOps))
                                (mem (dyn NodeOps))] (-> JslExprResult)
  (let [(mut units) (jsl-string-utf16-units text)
        result (jsl-lower-string-units (load units) ctrl mem)]
    (al-free! [i64] (mut units))
    result))

;; Both JSL text and decoded source literals enter the same allocation/memory graph. UTF-16
;; units are not re-encoded as UTF-8: JavaScript permits unpaired surrogate code units.
(defn jsl-lower-string-units [(units (ArrayList i64))
                             (ctrl (dyn NodeOps))
                             (mem (dyn NodeOps))] (-> JslExprResult)
  (let [payload-bytes (+ 8 (* (len units) 2))
        fresh
          (new-make ctrl
                    (con-int payload-bytes)
                    mem
                    SHAPE-STRING
                    (ty-struct "JsStringPayload"))
        ptr_ (proj-make fresh 0 "jsl.string.ptr")
        private-memory (proj-make fresh 1 "jsl.string.private-memory")
        length-state
          (store-make ctrl
                      private-memory
                      ptr_
                      (con-int 0)
                      (con-int (len units))
                      ALIAS-STRING-LENGTH
                      (ty-int-bot))
        (mut data-state-nid) (n-nid length-state)
        (mut unit) 0
        (mut word-index) 0]
    (loop (if (>= (load unit) (len units))
              (break 0)
              (let [(mut packed) 0 (mut lane) 0]
                (loop (if (or (>= (load lane) 4) (>= (+ (load unit) (load lane)) (len units)))
                          (break 0)
                          (do
                            (set! (mut packed)
                                  (| (load packed)
                                     (primitive/ishl
                                       (get units (+ (load unit) (load lane)))
                                       (* (load lane) 16))))
                            (set! (mut lane) (+ (load lane) 1))
                            (continue))))
                (let [stored
                        (store-make ctrl
                                    (jsl-node (load data-state-nid))
                                    ptr_
                                    (con-int (+ 8 (* (load word-index) 8)))
                                    (con-int (load packed))
                                    ALIAS-STRING-DATA
                                    (ty-int-bot))]
                  (set! (mut data-state-nid) (n-nid stored)))
                (set! (mut unit) (+ (load unit) 4))
                (set! (mut word-index) (+ (load word-index) 1))
                (continue))))
    (let [merged (memmerge-make)]
      (memmerge-set-alias! merged ALIAS-BULK mem)
      (memmerge-set-alias! merged ALIAS-STRING-LENGTH length-state)
      (if (> (len units) 0)
          (memmerge-set-alias! merged ALIAS-STRING-DATA (jsl-node (load data-state-nid)))
          0)
      (jsl-expr-result ptr_ ctrl merged))))

(defn jsl-lower-call [(x (ptr rd/Sexp))
                      (name (slice u8))
                      (params (ptr rd/Sexp))
                      (values (ArrayList (dyn NodeOps)))
                      (local-names (mut (ArrayList (slice u8))))
                      (local-values (mut (ArrayList (dyn NodeOps))))
                      (ctrl (dyn NodeOps))
                      (mem (dyn NodeOps))] (-> JslExprResult)
  (let [(mut ctrl-nid) (n-nid ctrl)
        (mut mem-nid) (n-nid mem)
        (mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
        (mut i) 1]
    (loop (if (>= (load i) (rd/sexp-count x))
              (break 0)
              (let [arg
                      (jsl-lower-expr (rd/sexp-nth x (load i))
                                      params
                                      values
                                      (mut local-names)
                                      (mut local-values)
                                      (jsl-node (load ctrl-nid))
                                      (jsl-node (load mem-nid)))]
                (push! [(dyn NodeOps)] (mut args) (.value arg))
                (set! (mut ctrl-nid) (n-nid (.ctrl arg)))
                (set! (mut mem-nid) (n-nid (.mem arg)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (match (jsl-definition-form name)
      (None [] (do (panic "jsl-lower-call: checker admitted an unknown definition")
                   (jsl-expr-result (unreachable-node) ctrl mem)))
      (Some [form]
            (if (jsl-form-macro? form)
                (jsl-lower-macro-values name
                                        (load args)
                                        (jsl-node (load ctrl-nid))
                                        (jsl-node (load mem-nid)))
                (let [target (jsl-graph-of name)
                      c (call-make-with-mem (jsl-node (load ctrl-nid))
                                            (jsl-node (load mem-nid)))
                      (mut arg) 0]
                  (loop (if (>= (load arg) (len (load args)))
                            (break 0)
                            (do
                              (call-add-arg! c (get (load args) (load arg)))
                              (set! (mut arg) (+ (load arg) 1))
                              (continue))))
                  (call-set-fptr! c (funptr-make target (jsl-fidx-of name)))
                  (let [end (callend-make c)]
                    (jsl-expr-result (proj-make end RETURN-VALUE "jsl.call.value")
                                     (cproj-make end RETURN-CTRL "jsl.call.ctrl")
                                     (proj-make end RETURN-MEM "jsl.call.mem")))))))))

(defn jsl-lower-property-store-primitive [(x (ptr rd/Sexp))
                                          (params (ptr rd/Sexp))
                                          (values (ArrayList (dyn NodeOps)))
                                          (local-names (mut (ArrayList (slice u8))))
                                          (local-values (mut (ArrayList (dyn NodeOps))))
                                          (ctrl (dyn NodeOps))
                                          (mem (dyn NodeOps))] (-> JslExprResult)
  (let [object
          (jsl-lower-expr (rd/sexp-nth x 1)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          ctrl
                          mem)
        key
          (jsl-lower-expr (rd/sexp-nth x 2)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          (.ctrl object)
                          (.mem object))
        value
          (jsl-lower-expr (rd/sexp-nth x 3)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          (.ctrl key)
                          (.mem key))
        key-ty (n-ty (.value key))]
    (if (not (and (ty-int? key-ty) (ty-constant? key-ty)))
        (do
          (panic "JSL named-property store key did not specialize to a constant")
          (jsl-expr-result (unreachable-node) (.ctrl value) (.mem value)))
        (let [stored
                (property-store-known-owner (.ctrl value)
                                            (.mem value)
                                            (.value object)
                                            (ty-int-lo key-ty)
                                            (.value value))]
          (jsl-expr-result (.value stored) (.ctrl stored) (.mem stored))))))

(defn jsl-lower-runtime-primitive [(x (ptr rd/Sexp))
                                   (prim i64)
                                   (params (ptr rd/Sexp))
                                   (values (ArrayList (dyn NodeOps)))
                                   (local-names (mut (ArrayList (slice u8))))
                                   (local-values (mut (ArrayList (dyn NodeOps))))
                                   (ctrl (dyn NodeOps))
                                   (mem (dyn NodeOps))] (-> JslExprResult)
  (let [(mut ctrl-nid) (n-nid ctrl)
        (mut mem-nid) (n-nid mem)
        (mut args) (al-new [(dyn NodeOps)] (alloc/malloc-allocator))
        (mut i) 1]
    (loop (if (>= (load i) (rd/sexp-count x))
              (break 0)
              (let [arg
                      (jsl-lower-expr (rd/sexp-nth x (load i))
                                      params
                                      values
                                      (mut local-names)
                                      (mut local-values)
                                      (jsl-node (load ctrl-nid))
                                      (jsl-node (load mem-nid)))]
                (push! [(dyn NodeOps)] (mut args) (.value arg))
                (set! (mut ctrl-nid) (n-nid (.ctrl arg)))
                (set! (mut mem-nid) (n-nid (.mem arg)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [op (jsop-make (jsl-node (load ctrl-nid)) (jsl-node (load mem-nid)) prim)
          (mut arg) 0]
      (loop (if (>= (load arg) (len (load args)))
                (break 0)
                (do
                  (jsop-add-arg! op (get (load args) (load arg)))
                  (set! (mut arg) (+ (load arg) 1))
                  (continue))))
      (jsl-expr-result (proj-make op 2 "jsl.primitive.value")
                       (jsl-node (load ctrl-nid))
                       (proj-make op 1 "jsl.primitive.mem")))))

(defn jsl-lower-prototype-store-primitive [(x (ptr rd/Sexp))
                                            (params (ptr rd/Sexp))
                                            (values (ArrayList (dyn NodeOps)))
                                            (local-names (mut (ArrayList (slice u8))))
                                            (local-values (mut (ArrayList (dyn NodeOps))))
                                            (ctrl (dyn NodeOps))
                                            (mem (dyn NodeOps))] (-> JslExprResult)
  (let [object
          (jsl-lower-expr (rd/sexp-nth x 1)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          ctrl
                          mem)
        prototype
          (jsl-lower-expr (rd/sexp-nth x 2)
                          params
                          values
                          (mut local-names)
                          (mut local-values)
                          (.ctrl object)
                          (.mem object))
        stored
          (store-make (.ctrl prototype)
                      (.mem prototype)
                      (.value object)
                      (con-int OFFSET-OBJECT-PROTOTYPE)
                      (.value prototype)
                      ALIAS-OBJECT-PROTOTYPE
                      (ty-dyn (+ TAG-NULL TAG-OBJECT)))
        merged (memmerge-make)]
    (memmerge-set-alias! merged ALIAS-BULK
                         (mem-effective (.mem prototype) ALIAS-BULK))
    (memmerge-set-alias! merged ALIAS-OBJECT-PROTOTYPE stored)
    (memmerge-set-alias! merged ALIAS-OBJECT-PROPERTIES
                         (mem-effective (.mem prototype) ALIAS-OBJECT-PROPERTIES))
    (jsl-expr-result (.value object) (.ctrl prototype) merged)))

(defn jsl-lower-expr [(x (ptr rd/Sexp))
                      (params (ptr rd/Sexp))
                      (values (ArrayList (dyn NodeOps)))
                      (local-names (mut (ArrayList (slice u8))))
                      (local-values (mut (ArrayList (dyn NodeOps))))
                      (ctrl (dyn NodeOps))
                      (mem (dyn NodeOps))] (-> JslExprResult)
  (if (rd/sexp-int? x)
      (jsl-expr-result (con-int (rd/sexp-int x)) ctrl mem)
      (if (rd/sexp-str? x)
          (jsl-lower-string-literal (rd/sexp-str x) ctrl mem)
          (if (rd/sexp-sym? x)
          (jsl-expr-result (jsl-env-lookup params values (load local-names) (load local-values) (rd/sexp-sym x))
                           ctrl
                           mem)
          (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
            (if (= name "let")
                (let [bindings (rd/sexp-nth x 1)
                      names-base (len (load local-names))
                      values-base (len (load local-values))
                      (mut current-ctrl-nid) (n-nid ctrl)
                      (mut current-mem-nid) (n-nid mem)
                      (mut i) 0]
                  (loop (if (>= (load i) (rd/sexp-count bindings))
                            (break 0)
                            (let [binding (rd/sexp-nth bindings (load i))
                                  init
                                    (jsl-lower-expr (rd/sexp-nth binding 1)
                                                    params
                                                    values
                                                    (mut local-names)
                                                    (mut local-values)
                                                    (jsl-node (load current-ctrl-nid))
                                                    (jsl-node (load current-mem-nid)))]
                              (push! [(slice u8)] (mut local-names) (rd/sexp-sym (rd/sexp-nth binding 0)))
                              (push! [(dyn NodeOps)] (mut local-values) (.value init))
                              (set! (mut current-ctrl-nid) (n-nid (.ctrl init)))
                              (set! (mut current-mem-nid) (n-nid (.mem init)))
                              (set! (mut i) (+ (load i) 1))
                              (continue))))
                  (let [body
                          (jsl-lower-expr (rd/sexp-nth x 2)
                                          params
                                          values
                                          (mut local-names)
                                          (mut local-values)
                                          (jsl-node (load current-ctrl-nid))
                                          (jsl-node (load current-mem-nid)))]
                    (loop (if (<= (len (load local-names)) names-base)
                              (break 0)
                              (do (pop! (mut local-names)) (continue))))
                    (loop (if (<= (len (load local-values)) values-base)
                              (break 0)
                              (do (pop! (mut local-values)) (continue))))
                    body))
                (if (= name "if")
                    (let [pred
                            (jsl-lower-expr (rd/sexp-nth x 1)
                                            params
                                            values
                                            (mut local-names)
                                            (mut local-values)
                                            ctrl
                                            mem)
                          iff (if-make (.ctrl pred) (.value pred))
                          arms (if-arms! iff)
                          region (region-make)
                          pred-form (rd/sexp-nth x 1)
                          guarded-name
                            (if (and (= (n-op (.value pred)) OP-TYPETEST)
                                     (and (rd/sexp-list? pred-form)
                                          (and (= (rd/sexp-count pred-form) 2)
                                               (rd/sexp-sym? (rd/sexp-nth pred-form 1)))))
                                (rd/sexp-sym (rd/sexp-nth pred-form 1))
                                "")]
                      ;; As in final Simple's parseTrinary, both projections and the first arm
                      ;; result must survive construction of the other arm. A JSL expression
                      ;; carries control and memory as well as its value, unlike Simple's scalar
                      ;; local: an impossible arm can return an otherwise-unused XCtrl that an
                      ;; inner diamond would reclaim before this outer Region acquires it.
                      (n-keep! (arms-true arms))
                      (n-keep! (arms-false arms))
                      (n-keep! (.value pred))
                      (n-keep! (.mem pred))
                      ;; A tag predicate narrows the exact named value on its true edge. This is the
                      ;; JSL form of ScopeNode guard substitution: checked Unbox below this edge reads
                      ;; the Cast, while the fallback arm continues to see the original dynamic value.
                      (if (= guarded-name "")
                          0
                          (do
                            (push! [(slice u8)] (mut local-names) guarded-name)
                            (push! [(dyn NodeOps)]
                                   (mut local-values)
                                   (cast-make (arms-true arms)
                                              (n-in! (.value pred) 1)
                                              (ty-dyn (typetest-tags (.value pred)))))))
                      (let [guarded-yes
                              (jsl-lower-expr (rd/sexp-nth x 2)
                                              params
                                              values
                                              (mut local-names)
                                              (mut local-values)
                                              (arms-true arms)
                                              (.mem pred))]
                        (n-keep! (.value guarded-yes))
                        (n-keep! (.ctrl guarded-yes))
                        (n-keep! (.mem guarded-yes))
                        (if (= guarded-name "")
                            0
                            (do (pop! (mut local-names)) (pop! (mut local-values)) 0))
                        ;; The false edge carries the complementary proof. Without this Cast,
                        ;; `if (%IsUndefined x) ... (%UnboxNumber x)` keeps the original
                        ;; undefined|number union in the else arm and reaches the backend as an
                        ;; unproven unbox even though control established exactly the needed fact.
                        (if (= guarded-name "")
                            0
                            (do
                              (push! [(slice u8)] (mut local-names) guarded-name)
                              (push! [(dyn NodeOps)]
                                     (mut local-values)
                                     (cast-make (arms-false arms)
                                                (n-in! (.value pred) 1)
                                                (ty-dyn (primitive/iand TAG-ANY
                                                                        (primitive/ixor TAG-ANY
                                                                                        (typetest-tags (.value pred)))))))))
                        (let [lowered-no
                                (jsl-lower-expr (rd/sexp-nth x 3)
                                                params
                                                values
                                                (mut local-names)
                                                (mut local-values)
                                                (arms-false arms)
                                                (.mem pred))
                              phi
                                (phi-make region
                                          (ty-meet (n-ty (.value guarded-yes))
                                                   (n-ty (.value lowered-no)))
                                          "jsl.if")]
                          (if (= guarded-name "")
                              0
                              (do (pop! (mut local-names)) (pop! (mut local-values)) 0))
                          (region-add-path! region (.ctrl guarded-yes))
                          (region-add-path! region (.ctrl lowered-no))
                          (phi-add-value! phi (.value guarded-yes))
                          (phi-add-value! phi (.value lowered-no))
                          (let [memphi (memphi-make region 1 TY-BOT "jsl.if.mem")]
                            (memphi-add-state! memphi (.mem guarded-yes))
                            (memphi-add-state! memphi (.mem lowered-no))
                            (n-unkeep! (.value guarded-yes))
                            (n-unkeep! (.ctrl guarded-yes))
                            (n-unkeep! (.mem guarded-yes))
                            (n-unkeep! (arms-true arms))
                            (n-unkeep! (arms-false arms))
                            (n-unkeep! (.value pred))
                            (n-unkeep! (.mem pred))
                            (jsl-expr-result phi region memphi)))))
                    (if (= name "%PropStoreOwnNamed")
                        (jsl-lower-property-store-primitive x
                                                            params
                                                            values
                                                            (mut local-names)
                                                            (mut local-values)
                                                            ctrl
                                                            mem)
                        (if (= name "%SetObjectPrototype")
                            (jsl-lower-prototype-store-primitive x
                                                                 params
                                                                 values
                                                                 (mut local-names)
                                                                 (mut local-values)
                                                                 ctrl
                                                                 mem)
                        (if (= name "%PropertyKey")
                            (jsl-expr-result
                              (con-int (shape-key-intern (rd/sexp-str (rd/sexp-nth x 1))))
                              ctrl
                              mem)
                        (if (!= (prim-lookup name) 0)
                            (jsl-lower-runtime-primitive x
                                                         (prim-lookup name)
                                                         params
                                                         values
                                                         (mut local-names)
                                                         (mut local-values)
                                                         ctrl
                                                         mem)
                        (if (or (= name "%NewObject") (= name "%Undefined") (= name "%Null"))
                            (if (= name "%NewObject")
                                (jsl-lower-new-object ctrl mem)
                                (jsl-expr-result
                                  (if (= name "%Null")
                                      (box-make-rep-at (Some ctrl) (con-int 0) REP-NULL)
                                      (dyn-undefined-make)) ctrl mem))
                            (if (>= (jsl-definition-arity name) 0)
                                (jsl-lower-call x
                                                name
                                                params
                                                values
                                                (mut local-names)
                                                (mut local-values)
                                                ctrl
                                                mem)
                                (let [lhs
                                        (jsl-lower-expr (rd/sexp-nth x 1)
                                                        params
                                                        values
                                                        (mut local-names)
                                                        (mut local-values)
                                                        ctrl
                                                        mem)]
                          (if (jsl-unary-primitive? name)
                              (jsl-expr-result (jsl-lower-unary-primitive name (.value lhs) (.ctrl lhs))
                                               (.ctrl lhs)
                                               (.mem lhs))
                              (if (= name "%StringLength")
                                  (jsl-expr-result
                                    (load-make (.ctrl lhs)
                                               (.mem lhs)
                                               (.value lhs)
                                               (con-int 0)
                                               ALIAS-STRING-LENGTH
                                               (ty-int-bot))
                                    (.ctrl lhs)
                                    (.mem lhs))
                              (if (= name "%GetObjectPrototype")
                                  (jsl-expr-result
                                    (load-make (.ctrl lhs)
                                               (.mem lhs)
                                               (.value lhs)
                                               (con-int OFFSET-OBJECT-PROTOTYPE)
                                               ALIAS-OBJECT-PROTOTYPE
                                               (ty-dyn (+ TAG-NULL TAG-OBJECT)))
                                    (.ctrl lhs)
                                    (.mem lhs))
                              (if (!= (jsl-tag-predicate name) 0)
                                  (jsl-expr-result (n-peephole! (typetest-make (.value lhs) (jsl-tag-predicate name)))
                                                   (.ctrl lhs)
                                                   (.mem lhs))
                                  (let [rhs
                                          (jsl-lower-expr (rd/sexp-nth x 2)
                                                          params
                                                          values
                                                          (mut local-names)
                                                          (mut local-values)
                                                          (.ctrl lhs)
                                                          (.mem lhs))]
                                    (if (or (= name "%PropLoadOwnNamed")
                                            (= name "%PropHasOwnNamed"))
                                        (let [key-ty (n-ty (.value rhs))]
                                          (let [constant-key
                                                  (and (ty-int? key-ty)
                                                       (ty-constant? key-ty))
                                                access
                                                  (if (= name "%PropLoadOwnNamed")
                                                      (if constant-key
                                                          (property-load-own-named
                                                            (.ctrl rhs)
                                                            (.mem rhs)
                                                            (.value lhs)
                                                            (ty-int-lo key-ty))
                                                          (property-load-own-keyed
                                                            (.ctrl rhs)
                                                            (.mem rhs)
                                                            (.value lhs)
                                                            (.value rhs)))
                                                      (if constant-key
                                                          (property-has-own-named
                                                            (.ctrl rhs)
                                                            (.mem rhs)
                                                            (.value lhs)
                                                            (ty-int-lo key-ty))
                                                          (property-has-own-keyed
                                                            (.ctrl rhs)
                                                            (.mem rhs)
                                                            (.value lhs)
                                                            (.value rhs))))]
                                                (jsl-expr-result (.value access)
                                                                 (.ctrl access)
                                                                 (.mem access))))
                                        (jsl-expr-result
                                          (jsl-lower-binary-primitive name (.value lhs) (.value rhs))
                                          (.ctrl rhs)
                                          (.mem rhs))))))))))))))))))))))

(defn jsl-declare-form! [(form (ptr rd/Sexp))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        name (rd/sexp-sym (rd/sexp-nth form 1))
        params (jsl-form-params form)
        ret-ty (jsl-lower-type (jsl-form-ret form))
        (mut sig-members) (al-new [i64] a)]
    ;; Signature layout is `(return, arg0, arg1, ...)`, exactly the layout Fun/Parm consume.
    (push! [i64] (mut sig-members) ret-ty)
    (let [(mut i) 0]
      (loop (if (>= (load i) (rd/sexp-count params))
                (break 0)
                (do
                  (push! [i64]
                         (mut sig-members)
                         (jsl-lower-type (rd/sexp-nth (rd/sexp-nth params (load i)) 1)))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (let [start (start-make ret-ty)
          fun (fun-make start (ty-tuple (al-slice (load sig-members))) name)]
      (let [mem-parm (parm-make-slot fun CALL-MEM (ty-mem 1 TY-BOT) "$mem")]
        (parm-set-unknown-input! mem-parm (proj-make start 1 "jsl.start.mem"))
        (n-keep! mem-parm))
      (let [(mut i) 0]
        (loop (if (>= (load i) (rd/sexp-count params))
                  (break 0)
                  (let [decl (rd/sexp-nth params (load i))
                        p
                          (parm-make fun
                                     (load i)
                                     (jsl-lower-type (rd/sexp-nth decl 1))
                                     (rd/sexp-sym (rd/sexp-nth decl 0)))]
                    (n-keep! p)
                    (set! (mut i) (+ (load i) 1))
                    (continue)))))
      (jsl-graphs-boot!)
      (let [fidx (len (.items (jsl-graphs)))]
        ;; Reserve the complete JSL namespace at declaration time. A definition need not happen to
        ;; have a FunPtr use, so relying on `funptr-make` to advance the allocator lets the source
        ;; frontend reuse a runtime-library identity and relocations can bind to the wrong symbol.
        (reserve-fidx! fidx)
        (push! [JslGraph] (mut (.items (jsl-graphs))) (jsl-graph-new name (n-nid fun) fidx)))
      fun)))

(defn jsl-define-form! [(form (ptr rd/Sexp))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        name (rd/sexp-sym (rd/sexp-nth form 1))
        params (jsl-form-params form)
        fun (jsl-graph-of name)
        body-start (arena-node-count)
        (mut values) (al-new [(dyn NodeOps)] a)
        (mut local-names) (al-new [(slice u8)] a)
        (mut local-values) (al-new [(dyn NodeOps)] a)]
    (let [(mut i) 0]
      (loop (if (>= (load i) (rd/sexp-count params))
                (break 0)
                (do
                  (match (fun-parm fun (load i))
                    (Some [p] (do (push! [(dyn NodeOps)] (mut values) p) (n-unkeep! p)))
                    (None [] (panic "jsl-define-form!: declared parameter is missing")))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (let [mem
            (match (fun-mem-parm fun)
              (Some [m] (do (n-unkeep! m) m))
              (None [] (do (panic "jsl-define-form!: memory Parm is missing") (unreachable-node))))
          body
            (jsl-lower-expr (jsl-form-body form)
                            params
                            (load values)
                            (mut local-names)
                            (mut local-values)
                            fun
                            mem)
          ret
            (return-make (.ctrl body)
                         (Some (.mem body))
                         (.value body)
                         (None [(dyn NodeOps)])
                         (Some fun))]
      (fun-set-ret! fun ret)
      ;; All JSL declarations are hoisted before any definition. Measure only nodes allocated by
      ;; this definition so unrelated later headers cannot push a small builtin over Simple's
      ;; inlining cap.
      (fun-set-approx-size! fun (- (arena-node-count) body-start))
      fun)))

(defn jsl-lower-form! [(form (ptr rd/Sexp))] (-> (dyn NodeOps))
  (if (jsl-form-macro? form)
      (do (panic "jsl-lower-form!: a macro has no standalone graph") (unreachable-node))
      (do (jsl-declare-form! form) (jsl-define-form! form))))

(defn jsl-lower-unit! [(unit i64)] (-> i64)
  (do
    (jsl-check-unit unit)
    (let [(mut i) 0]
      (loop (if (>= (load i) (jsl-form-count unit))
                (break 0)
                (do
                  (if (jsl-form-macro? (jsl-form unit (load i)))
                      0
                      (do (jsl-declare-form! (jsl-form unit (load i))) 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (set! (mut i) 0)
      (loop (if (>= (load i) (jsl-form-count unit))
                (break 0)
                (do
                  (if (jsl-form-macro? (jsl-form unit (load i)))
                      0
                      (do (jsl-define-form! (jsl-form unit (load i))) 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (load i))))

;; The graph for a named JSL definition, built on demand and memoised.
(defn jsl-graph-of [(name (slice u8))] (-> (dyn NodeOps))
  (do
    (jsl-graphs-boot!)
    (let [(mut i) (- (len (.items (jsl-graphs))) 1)]
      (loop (if (< (load i) 0)
                (break (do
                         (panic "jsl-graph-of: unknown JSL definition")
                         (unreachable-node)))
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (if (= (.name g) name)
                      (match (arena-node (.nid g))
                        (Some [n] (break n))
                        (None [] (do (set! (mut i) (- (load i) 1)) (continue))))
                      (do (set! (mut i) (- (load i) 1)) (continue)))))))))

;; Whether a named builtin definition is in the loaded production index. The frontend admits
;; operator syntax ahead of its semantics and must refuse an absent definition by name.
(defn jsl-defined? [(name (slice u8))] (-> bool)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break false)
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (if (= (.name g) name)
                    (break true)
                    (do (set! (mut i) (+ (load i) 1)) (continue)))))))))

(defn jsl-fidx-of [(name (slice u8))] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break (do (panic "jsl-fidx-of: unknown JSL definition") 0))
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (if (= (.name g) name)
                      (break (.fidx g))
                      (do (set! (mut i) (+ (load i) 1)) (continue)))))))))

;; One production entry point for a compilation. Units and function indices are exactly index
;; ordered; resetting both stores prevents stale arena IDs from crossing compilation boundaries.
(defn jsl-lower-index! [(path (slice u8))] (-> i64)
  (do
    (jsl-reset!)
    (jsl-lower-reset!)
    (let [units (jsl-load-index! path)
          (mut unit) 1]
      ;; Check the complete table first, then declare every function before lowering any body.
      ;; This is the JSL equivalent of JavaScript function hoisting and makes forward references
      ;; independent of file order while preserving index order for stable fidx assignment.
      (loop (if (> (load unit) units)
                (break 0)
                (do
                  (jsl-check-unit (load unit))
                  (set! (mut unit) (+ (load unit) 1))
                  (continue))))
      (set! (mut unit) 1)
      (loop (if (> (load unit) units)
                (break 0)
                (let [(mut i) 0]
                  (loop (if (>= (load i) (jsl-form-count (load unit)))
                            (break 0)
                            (do
                              (if (jsl-form-macro? (jsl-form (load unit) (load i)))
                                  0
                                  (do (jsl-declare-form! (jsl-form (load unit) (load i))) 0))
                              (set! (mut i) (+ (load i) 1))
                              (continue))))
                  (set! (mut unit) (+ (load unit) 1))
                  (continue))))
      (set! (mut unit) 1)
      (loop (if (> (load unit) units)
                (break 0)
                (let [(mut i) 0]
                  (loop (if (>= (load i) (jsl-form-count (load unit)))
                            (break 0)
                            (do
                              (if (jsl-form-macro? (jsl-form (load unit) (load i)))
                                  0
                                  (do (jsl-define-form! (jsl-form (load unit) (load i))) 0))
                              (set! (mut i) (+ (load i) 1))
                              (continue))))
                  (set! (mut unit) (+ (load unit) 1))
                  (continue))))
      units)))

;; Close the loaded JSL call graph only after the frontend has installed every semantic call.
(defn jsl-close-world! [] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break 0)
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (match (arena-node (.nid g))
                    (Some [fun]
                          (if (fun-unknown-callers? fun) (fun-drop-unknown-callers! fun) 0))
                    (None [] (panic "jsl-close-world!: stale graph id")))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    0))

;; JSL Returns are not parser roots: until closed-world call discovery decides which bodies survive,
;; each one needs the same temporary ownership that `parser-prepare-opto!` gives source functions.
;; Final Simple obtains this lifetime structurally because a FunPtr points at the callee Return;
;; our FunPtr points at the Fun so forward JSL declarations can be lowered before their bodies.
;; Keeping the Return here preserves the whole definition across optimistic SCCP and the final
;; all-arena sweep without prematurely making every runtime-library body a compilation-unit root.
(defn jsl-prepare-opto! [] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0
          (mut kept) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break (load kept))
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (match (arena-node (.nid g))
                    (Some [fun]
                          (match (fun-ret fun)
                            (Some [ret]
                                  (do
                                    (n-keep! ret)
                                    (set! (mut kept) (+ (load kept) 1))
                                    0))
                            (None [] (panic "jsl-prepare-opto!: JSL Fun has no Return"))))
                    (None [] (panic "jsl-prepare-opto!: stale graph id")))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))))

;; Final Simple's compilation-unit rooting applies to runtime-library functions as well as source
;; declarations. A JSL body that survives inlining must remain an emitted definition; its linked
;; Call edges are optimisation metadata and will be removed before selection. Release every
;; temporary keep installed by `jsl-prepare-opto!`; a surviving definition first gains the Stop
;; edge that owns it for code generation, while an inlined/dead body is allowed to disappear.
(defn jsl-finish-opto! [(stop (dyn NodeOps))] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0
          (mut retained) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break (load retained))
                (let [g (get (.items (jsl-graphs)) (load i))]
                  (match (arena-node (.nid g))
                    (Some [fun]
                          (match (fun-ret fun)
                            (Some [ret]
                                  (if (and (and (not (n-dead? fun)) (not (fun-folding? fun)))
                                           (not (ty-high? (n-ty fun))))
                                      (do
                                        (stop-add-return! stop ret)
                                        (set! (mut retained) (+ (load retained) 1))
                                        (n-unkill! ret))
                                      ;; Releasing the temporary hold must also collect an inlined
                                      ;; Return that has no CallEnd or Stop owner. A bare unkeep
                                      ;; leaves that unused CFG sink attached to caller control,
                                      ;; where it can corrupt later loop-tree nesting.
                                      (n-unkill! ret)))
                            (None [] (panic "jsl-finish-opto!: JSL Fun lost its Return"))))
                    (None [] 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))))

(defn jsl-prepare-codegen! [(start (dyn NodeOps))] (-> i64)
  (do
    (jsl-graphs-boot!)
    (let [(mut i) 0
          (mut prepared) 0]
      (loop (if (>= (load i) (len (.items (jsl-graphs))))
                (break (load prepared))
                (do
                  (let [g (get (.items (jsl-graphs)) (load i))]
                    (match (arena-node (.nid g))
                      (Some [fun]
                            (set! (mut prepared)
                                  (+ (load prepared) (fun-prepare-codegen! fun start))))
                      (None [] 0)))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))))

;; The transition check over what was lowered: every path that may call JavaScript or move the heap
;; carries a Safepoint, and every live reference across it is relocated.
(defn jsl-check-transitions [(root (dyn NodeOps))] (-> i64)
  ;; The admitted fixture subset contains only pure Box/Unbox/arithmetic operations. As the
  ;; checker admits transitioning primitives, this becomes the graph walk that proves Safepoints.
  (do root 0))
