;; Closed-world facts about the image objects: what the program can do to each of them.

;;
;; The realm's initial objects are data in the static heap image (`aot.heap`). Their properties are
;; therefore constants of the compilation — until the program stores into them. A read of an image
;; object's property folds when the compiler knows that no store in the whole program can have
;; written that key of that object (docs/COMPILE-TIME.md §8 row 10, docs/DECISIONS.md, image
;; object property reads fold under closed-world facts). This module holds those facts; the pass
;; that establishes them is `aot.node.imagefacts`, which walks every graph once the world is closed.
;;
;; The facts, per image entry X and property key K:
;;
;;   escaped(X)      a reference to X reached a position the analysis does not follow — a call
;;                   argument, a return value, a stored value, a thrown value. From there X can be
;;                   the owner of any store whose owner the analysis could not name.
;;   written(X, K)   some store whose owner the analysis named as X writes K; or X escaped and some
;;                   store of K has an owner the analysis could not name; or X was the named target
;;                   of a store whose key is a runtime value.
;;   prototypes-written   some store writes an object's [[Prototype]] word after allocation.
;;   descriptors     some operation defines property attributes (define, freeze, seal, preventExtensions).
;;   deletes         some operation deletes a property; a delete is also a write of its key.
;;   code-targets(L) for a Load L of a function object's code word, the functions that word can be:
;;                   the function entries its pointer names, and, when the pointer is a value the
;;                   analysis could not name, every ESCAPED function entry and every function the
;;                   program allocates at run time. Absent, the Load keeps its declared type.
;;
;; A key interned after the facts were computed cannot have been stored by the analysed program —
;; every store in the program named an already-interned key — so it reads as unwritten. An image
;; entry added after the facts were computed is a wiring error: the image is complete when the
;; world closes, and a query about such an entry panics rather than guessing.
;;
;; Simple has no analogue: its heap begins empty and every object is a `new` the graph can see.
;; JavaScript starts with a populated realm, and this is the closed-world answer to "may that
;; populated object have changed?" — the same question Simple's Load-after-Store idealization
;; answers for a fresh allocation, asked of an allocation that predates the program.
(module aot.facts)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "aot.util.panic" :use *)

;; Named writes occupy only observed object/key pairs; unrelated keys do not widen
;; object rows. The cached pair count preserves the existing convergence signature.
(defstruct ImageFacts
  [(ready bool)
   (heap-count i64)  ; image entries the analysis saw
   (key-count i64)  ; property keys interned when the analysis ran
   (escaped (ArrayList bool))  ; per entry
   (any-key (ArrayList bool))  ; per entry: the named target of a store whose key is a runtime value
   (written (ArrayList (HashMap i64 bool)))  ; sparse named keys per entry
   (written-count i64)
   (unknown-owner-key (ArrayList bool))  ; per key: stored to an owner the analysis could not name
   (unknown-owner-any bool)  ; a store of a runtime key to an owner the analysis could not name
   (prototypes-written bool)
   (descriptors bool)  ; the program defines property attributes somewhere (define, freeze, seal, preventExtensions)
   (deletes bool)  ; the program deletes a property somewhere
   (code-targets (HashMap i64 i64))  ; per code-word Load nid: the interned fidx set it can name
   (code-target-members i64)  ; their total size, for the convergence signature
   (booted bool)])

(defn facts-table [] (-> (ptr ImageFacts))
  (compiler-state [ImageFacts] (primitive/alloc-static CompilerStateSlot)))

(defn facts-release! [] (-> i64)
  (facts-release-table! (facts-table)))

(defn facts-release-table! [(t (ptr ImageFacts))] (-> i64)
  (let [(mut i) 0]
    (if (.booted t)
        (do
          (loop (if (>= (load i) (len (.written t)))
                    (break 0)
                    (do
                      (hm-free! (al-elem [(HashMap i64 bool)]
                                         (mut (.written t))
                                         (load i)))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (al-free! (mut (.written t)))
          (al-free! (mut (.escaped t)))
          (al-free! (mut (.any-key t)))
          (al-free! (mut (.unknown-owner-key t)))
          (hm-free! (mut (.code-targets t)))
          (set! (.booted t) false))
        0)
    0))

;; Facts are compilation-local: a new realm starts with none.
(defn facts-reset! [] (-> i64)
  (let [t (facts-table)]
    (facts-release!)
    (set! (.ready t) false)
    (set! (.booted t) false)
    (set! (.heap-count t) 0)
    (set! (.key-count t) 0)
    (set! (.unknown-owner-any t) false)
    (set! (.prototypes-written t) false)
    (set! (.descriptors t) false)
    (set! (.deletes t) false)
    0))

(defn facts--fill! [(l (mut (ArrayList bool))) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break 0)
              (do
                (push! [bool] (mut l) false)
                (set! (mut i) (+ (load i) 1))
                (continue))))))

;; Begin recording over `heap-count` image entries and `key-count` property keys.
(defn facts-begin! [(heap-count i64) (key-count i64)] (-> i64)
  (let [t (facts-table)
        a (compiler-allocator)]
    (if (.ready t)
        (panic "facts-begin!: the image facts were already computed for this realm")
        0)
    (facts-release!)
    (set! (.heap-count t) heap-count)
    (set! (.key-count t) key-count)
    (set! (.escaped t) (al-new [bool] a))
    (set! (.any-key t) (al-new [bool] a))
    (set! (.written t) (al-new [(HashMap i64 bool)] a))
    (set! (.written-count t) 0)
    (set! (.unknown-owner-key t) (al-new [bool] a))
    (facts--fill! (mut (.escaped t)) heap-count)
    (facts--fill! (mut (.any-key t)) heap-count)
    (let [(mut entry) 0]
      (loop (if (>= (load entry) heap-count)
                (break 0)
                (do
                  (push! [(HashMap i64 bool)]
                         (mut (.written t))
                         (hm-new [i64 bool] a (i64-keyops)))
                  (set! (mut entry) (+ (load entry) 1))
                  (continue)))))
    (facts--fill! (mut (.unknown-owner-key t)) (+ key-count 1))
    (set! (.code-targets t) (hm-new [i64 i64] a (i64-keyops)))
    (set! (.code-target-members t) 0)
    (set! (.unknown-owner-any t) false)
    (set! (.prototypes-written t) false)
    (set! (.descriptors t) false)
    (set! (.deletes t) false)
    (set! (.booted t) true)
    0))

;; Reopen finished facts for another round: the optimizer has folded under them, so the graph it
;; leaves has fewer stores and escapes, and a rescan may find fewer marks (aot.codegen.pipeline).
(defn facts-reopen! [] (-> i64)
  (let [t (facts-table)]
    (if (not (.ready t)) (panic "facts-reopen!: no finished facts to reopen") 0)
    (facts-release!)
    (set! (.ready t) false)
    (set! (.booted t) false)
    0))

;; Move the finished snapshot out of the singleton. The caller owns its arrays until release;
;; the next scan allocates a new table. Comparing counts cannot distinguish a changed owner/key
;; or a changed call-target set of the same cardinality, so convergence compares the actual maps.
(defn facts-detach! [] (-> ImageFacts)
  (let [t (facts-table) old (load t)]
    (if (not (.ready t)) (panic "facts-detach!: facts are not finished") 0)
    (set! (.ready t) false) (set! (.booted t) false)
    old))

(defn facts-bools-equal? [(a (ArrayList bool)) (b (ArrayList bool))] (-> bool)
  (let [(mut equal) (= (len a) (len b)) (mut i) 0]
    (loop (if (or (not (load equal)) (>= (load i) (len a))) (break 0)
      (do (if (!= (get a (load i)) (get b (load i))) (set! (mut equal) false) 0)
          (set! (mut i) (+ (load i) 1)) (continue))))
    (load equal)))

(defn facts-current-equal? [(old (ptr ImageFacts))] (-> bool)
  (let [now (facts-table)
        (mut equal) (and (.ready old) (.ready now)
                          (= (.heap-count old) (.heap-count now))
                          (= (.key-count old) (.key-count now))
                          (= (.unknown-owner-any old) (.unknown-owner-any now))
                          (= (.prototypes-written old) (.prototypes-written now))
                          (= (.descriptors old) (.descriptors now))
                          (= (.deletes old) (.deletes now))
                          (facts-bools-equal? (.escaped old) (.escaped now))
                          (facts-bools-equal? (.any-key old) (.any-key now))
                          (facts-bools-equal? (.unknown-owner-key old) (.unknown-owner-key now))
                          (= (len (.written old)) (len (.written now)))
                          (= (len (.code-targets old)) (len (.code-targets now))))
        (mut i) 0]
    (loop (if (or (not (load equal)) (>= (load i) (len (.written old)))) (break 0)
      (let [row (al-elem [(HashMap i64 bool)] (mut (.written old)) (load i)) current (get (.written now) (load i))]
        (if (!= (len (load row)) (len current)) (set! (mut equal) false) 0)
        (hm-for [key value row]
          (match (get current key)
            (Some [other] (if (!= value other) (set! (mut equal) false) 0))
            (None [] (set! (mut equal) false))))
        (set! (mut i) (+ (load i) 1)) (continue))))
    (hm-for [nid targets (mut (.code-targets old))]
      (match (get (.code-targets now) nid)
        (Some [other] (if (!= targets other) (set! (mut equal) false) 0))
        (None [] (set! (mut equal) false))))
    (load equal)))

;; Discard the tables an unfinished scan built (the surface demand scan runs the transfer before the
;; world closes and never publishes facts): the next `facts-begin!` starts clean.
(defn facts-abandon! [] (-> i64)
  (let [t (facts-table)]
    (if (.ready t) (panic "facts-abandon!: the facts were finished; reopen them instead") 0)
    (facts-release!)
    (set! (.booted t) false)
    0))

;; Diagnostic count only. Equal counts do not prove equal facts; use facts-current-equal?.
(defn facts-signature [] (-> i64)
  (let [t (facts-table)
        (mut n) 0]
    (if (not (.ready t))
        (panic "facts-signature: the facts are not finished")
        0)
    (let [(mut i) 0
          e (len (.escaped t))]
      (loop (if (>= (load i) e)
                (break 0)
                (do
                  (if (get (.escaped t) (load i))
                      (set! (mut n) (+ (load n) 1))
                      0)
                  (if (get (.any-key t) (load i))
                      (set! (mut n) (+ (load n) 1))
                      0)
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (set! (mut n) (+ (load n) (.written-count t)))
    (let [(mut i) 0
          u (len (.unknown-owner-key t))]
      (loop (if (>= (load i) u)
                (break 0)
                (do
                  (if (get (.unknown-owner-key t) (load i))
                      (set! (mut n) (+ (load n) 1))
                      0)
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (if (.unknown-owner-any t) (set! (mut n) (+ (load n) 1)) 0)
    (if (.prototypes-written t) (set! (mut n) (+ (load n) 1)) 0)
    (if (.descriptors t) (set! (mut n) (+ (load n) 1)) 0)
    (if (.deletes t) (set! (mut n) (+ (load n) 1)) 0)
    ;; A narrower call-target set is a change the optimizer must see: count every published target.
    ;; Inherited entries (facts-inherit-code-targets!) are copies of counted ones and add nothing.
    (set! (mut n) (+ (load n) (.code-target-members t)))
    (load n)))

;; Publish the functions the code-word Load `nid` can name: `fidxs` is an interned fidx set
;; (aot.type.type) of `members` functions.
(defn facts-set-code-targets! [(nid i64) (fidxs i64) (members i64)] (-> i64)
  (let [t (facts-table)]
    (if (not (.booted t)) (panic "facts-set-code-targets!: no facts are being recorded") 0)
    (if (.ready t) (panic "facts-set-code-targets!: the facts are already finished") 0)
    (if (hm-contains? (.code-targets t) nid) (panic-i "facts-set-code-targets!: Load published twice" nid) 0)
    (set! (.code-target-members t) (+ (.code-target-members t) members))
    (set! (mut (.code-targets t)) nid fidxs)
    0))

;; A clone of a code-word Load — an inlined copy of a body — is the same load in one of the contexts
;; the analysis already joined, so what was published for the original holds for the copy. The copy
;; keeps the original's narrowed type; without the entry its next compute would widen it back.
(defn facts-inherit-code-targets! [(fresh i64) (old i64)] (-> i64)
  (let [t (facts-table)]
    (if (.ready t)
        (match (get (.code-targets t) old)
          (Some [fidxs] (do (set! (mut (.code-targets t)) fresh fidxs) 0))
          (None [] 0))
        0)))

;; The functions the code-word Load `nid` can name, when the analysis published them.
(defn facts-code-targets [(nid i64)] (-> (Option i64))
  (let [t (facts-table)]
    (if (.ready t)
        (get (.code-targets t) nid)
        (None [i64]))))

(defn facts-finish! [] (-> i64)
  (let [t (facts-table)]
    (if (not (.booted t))
        (panic "facts-finish!: facts-begin! was never called")
        0)
    (set! (.ready t) true)
    0))

(defn facts-ready? [] (-> bool)
  (.ready (facts-table)))

(defn facts--require-entry [(entry i64)] (-> i64)
  (let [t (facts-table)]
    (if (not (.booted t)) (panic "aot.facts: no facts are being recorded") 0)
    (if (or (< entry 0) (>= entry (.heap-count t)))
        (panic-i "aot.facts: an image entry the closed-world analysis never saw"
                 entry)
        0)))

(defn facts--require-key [(key i64)] (-> i64)
  (if (<= key 0) (panic-i "aot.facts: invalid property key" key) 0))

;; Each marker answers whether it changed anything, so the analysis can run to a fixpoint.
(defn facts-mark-escaped! [(entry i64)] (-> bool)
  (let [t (facts-table)]
    (facts--require-entry entry)
    (if (get (.escaped t) entry)
        false
        (do (set! (mut (.escaped t)) entry true) true))))

(defn facts-mark-written! [(entry i64) (key i64)] (-> bool)
  (let [t (facts-table)]
    (facts--require-entry entry)
    (facts--require-key key)
    (if (> key (.key-count t))
        (panic-i "facts-mark-written!: a key interned after the analysis began"
                 key)
        0)
    (let [keys (al-elem [(HashMap i64 bool)] (mut (.written t)) entry)]
      (if (hm-contains? (load keys) key)
          false
          (do
            (set! keys key true)
            (set! (.written-count t) (+ (.written-count t) 1))
            true)))))

(defn facts-mark-any-key! [(entry i64)] (-> bool)
  (let [t (facts-table)]
    (facts--require-entry entry)
    (if (get (.any-key t) entry)
        false
        (do (set! (mut (.any-key t)) entry true) true))))

(defn facts-mark-unknown-owner-key! [(key i64)] (-> bool)
  (let [t (facts-table)]
    (facts--require-key key)
    (if (> key (.key-count t))
        (panic-i "facts-mark-unknown-owner-key!: a key interned after the analysis began"
                 key)
        0)
    (if (get (.unknown-owner-key t) key)
        false
        (do (set! (mut (.unknown-owner-key t)) key true) true))))

(defn facts-mark-unknown-owner-any! [] (-> bool)
  (let [t (facts-table)]
    (if (.unknown-owner-any t)
        false
        (do (set! (.unknown-owner-any t) true) true))))

(defn facts-mark-prototypes-written! [] (-> bool)
  (let [t (facts-table)]
    (if (.prototypes-written t)
        false
        (do (set! (.prototypes-written t) true) true))))

(defn facts-escaped? [(entry i64)] (-> bool)
  (do
    (facts--require-entry entry)
    (get (.escaped (facts-table)) entry)))

(defn facts-escaped-count [] (-> i64)
  (let [t (facts-table)
        (mut i) 0
        (mut n) 0]
    (loop (if (>= (load i) (.heap-count t))
              (break (load n))
              (do
                (if (get (.escaped t) (load i)) (set! (mut n) (+ (load n) 1)) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))))

;; May the program have stored `key` on image entry `entry`?
;; Was image entry `entry` the named target of a store whose key is a runtime value?
(defn facts-any-key? [(entry i64)] (-> bool)
  (do
    (facts--require-entry entry)
    (get (.any-key (facts-table)) entry)))

;; A key interned after the analysis was never named by a store, but a store of a runtime key
;; covers it like every other key.
(defn facts-written? [(entry i64) (key i64)] (-> bool)
  (let [t (facts-table)]
    (facts--require-entry entry)
    (facts--require-key key)
    (or (get (.any-key t) entry)
        (and (get (.escaped t) entry) (.unknown-owner-any t))
        (if (> key (.key-count t))
            false
            (or (hm-contains? (get (.written t) entry) key)
                (and (get (.escaped t) entry) (get (.unknown-owner-key t) key)))))))

(defn facts-prototypes-written? [] (-> bool)
  (.prototypes-written (facts-table)))

(defn facts-mark-descriptors! [] (-> bool)
  (let [t (facts-table)]
    (if (.descriptors t)
        false
        (do (set! (.descriptors t) true) true))))

;; Does the program define property attributes anywhere? While it does not, a stored key of an
;; image object is still a writable data property and its fixed-offset access holds.
(defn facts-descriptors? [] (-> bool)
  (.descriptors (facts-table)))

(defn facts-mark-deletes! [] (-> bool)
  (let [t (facts-table)]
    (if (.deletes t)
        false
        (do (set! (.deletes t) true) true))))

;; Does the program delete a property anywhere? While it does not, a key present in an image
;; object's shape is present at run time, at the offset the shape fixes. Once it does, a possibly
;; written key may be gone — a delete is a write of its key — so only never-written keys fold.
(defn facts-deletes? [] (-> bool)
  (.deletes (facts-table)))

;; May the program have changed what an image entry's `key` is — its attributes (a define) or its
;; presence (a delete)? A never-written key is as the image fixed it.
(defn facts-layout-unknown? [(entry i64) (key i64)] (-> bool)
  (and (or (facts-descriptors?) (facts-deletes?)) (facts-written? entry key)))
