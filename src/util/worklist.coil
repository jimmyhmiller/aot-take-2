;; ============================================================================

;; THE SEEDED WORKLIST  —  port of Simple's `IterPeeps.WorkList`
;; ============================================================================
;;
;; A set with a RANDOMISED pop. Holds dense integer ids (node nids), so it has no dependency on the
;; graph and can be tested on its own.
;;
;; ## Why the pop order is random, deliberately
;;
;; A rewrite that is only correct under one traversal order is a broken rewrite. A deterministic
;; worklist hides that class of bug behind a green gate — order-dependent failures in a
;; sea-of-nodes optimiser show up on a MINORITY of orders, so a single fixed order proves nothing.
;;
;; The seed is explicit and recorded, so a red run reproduces exactly. Tests sweep many seeds and
;; assert the final graph is identical across all of them.
;;
;; ## Set semantics
;;
;; Pushing an id already on the list is a no-op — the worklist is a SET, not a queue. Without that,
;; a node peepholed repeatedly re-queues itself and the fixpoint never closes. Membership is an
;; O(1) bitmap keyed by id, alongside the dense array the random pop indexes into.
;;
;; Popping swaps the chosen element with the last and pops the tail, which is O(1) and does not
;; preserve order — order is exactly what we do not want here.
(module aot.util.worklist)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)

(defstruct WorkList
  [(items (ArrayList i64))  ; dense array of ids, for the random index
   (onlist (ArrayList bool))  ; membership by id, so push is idempotent in O(1)
   (seed i64)  ; the LCG state; the run is reproducible from its initial value
   (seed0 i64)  ; the initial seed, kept for reporting
   (pushes i64)  ; counters, so a test can state a floor on what it exercised
   (pops i64)])

(defn wl-new [(seed i64)] (-> WorkList)
  (let [a (alloc/malloc-allocator)
        (mut w) (primitive/zeroed WorkList)]
    (set! (.items (mut w)) (al-new [i64] a))
    (set! (.onlist (mut w)) (al-new [bool] a))
    ;; A zero seed would make the LCG constant, so map it to a fixed non-zero value rather than
    ;; silently degenerating into a deterministic order.
    (set! (.seed (mut w)) (if (= seed 0) 0x2545F4914F6CDD1D seed))
    (set! (.seed0 (mut w)) seed)
    (load w)))

;; Grow the membership bitmap so `id` is addressable.
(defn wl--ensure! [(w (mut WorkList)) (id i64)] (-> i64)
  (let [(mut i) (len (.onlist w))]
    (loop (if (> (load i) id)
              (break 0)
              (do
                (push! [bool] (mut (.onlist w)) false)
                (set! (mut i) (+ (load i) 1))
                (continue))))))

(defn wl-on? [(w WorkList) (id i64)] (-> bool)
  (if (>= id (len (.onlist w)))
      false
      (get (.onlist w) id)))

;; Push, idempotently. Returns 1 if it was actually added.
(defn wl-push! [(w (mut WorkList)) (id i64)] (-> i64)
  (do
    (wl--ensure! (mut w) id)
    (if (get (.onlist w) id)
        0
        (do
          (set! (mut (.onlist w)) id true)
          (push! [i64] (mut (.items w)) id)
          (set! (.pushes w) (+ (.pushes w) 1))
          1))))

;; xorshift64*. Small, fast, and reproducible across platforms — which matters, because a seed in a
;; failure report is worthless if it means something different on another machine.
(defn wl--next-rand! [(w (mut WorkList))] (-> i64)
  (let [(mut x) (.seed w)]
    (set! (mut x) (^ (load x) (primitive/ishr (load x) 12)))
    (set! (mut x) (^ (load x) (primitive/ishl (load x) 25)))
    (set! (mut x) (^ (load x) (primitive/ishr (load x) 27)))
    (set! (.seed w) (load x))
    ;; Mask to non-negative so the caller can take a remainder without a sign surprise.
    (primitive/iand (load x) 0x7FFFFFFFFFFFFFFF)))

;; Pop a RANDOM member. `None` when empty.
;;
;; Swap-with-last then drop the tail: O(1), and order is not preserved.
(defn wl-pop! [(w (mut WorkList))] (-> (Option i64))
  (let [n (len (.items w))]
    (if (= n 0)
        (None)
        (let [i (primitive/irem (wl--next-rand! (mut w)) n)
              id (get (.items w) i)]
          (if (!= i (- n 1))
              (set! (mut (.items w)) i (get (.items w) (- n 1)))
              0)
          (match (pop! (mut (.items w))) (Some [_] 0) (None [] 0))
          (set! (mut (.onlist w)) id false)
          (set! (.pops w) (+ (.pops w) 1))
          (Some id)))))

(defn wl-len [(w WorkList)] (-> i64)
  (len (.items w)))

(defn wl-empty? [(w WorkList)] (-> bool)
  (= (len (.items w)) 0))

(defn wl-seed0 [(w WorkList)] (-> i64)
  (.seed0 w))

(defn wl-pushes [(w WorkList)] (-> i64)
  (.pushes w))

(defn wl-pops [(w WorkList)] (-> i64)
  (.pops w))

(defn wl-clear! [(w (mut WorkList))] (-> i64)
  (do
    (loop (match (wl-pop! (mut w))
            (Some [_] (continue))
            (None [] (break 0))))
    (set! (.pushes w) 0)
    (set! (.pops w) 0)
    0))
