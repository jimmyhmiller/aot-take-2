;; Compilation-region ownership. Individual frees are region operations; ending the compilation

;; frees every backing chunk, including temporary allocations an early exit never explicitly freed.
;; Immutable cached artifacts must copy into their own allocator before this boundary.
(module aot.util.arena)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.primitive" :as primitive)
(import "coil.mem" :as mem)
(import "coil.slice" :use [slice-new])
(import "aot.util.panic" :use *)

(const COMPILER-CHUNK-BYTES 1048576)

(defstruct CompilerChunk [(next (ptr CompilerChunk)) (capacity i64) (used i64)])

(defstruct CompilerRegion
  [(head (ptr CompilerChunk)) (epoch i64) (reserved i64) (active bool)])

(defstruct CompilerStateSlot [(epoch i64) (address (ptr i8))])

(defn compiler-region [] (-> (ptr CompilerRegion))
  (primitive/alloc-static CompilerRegion))

(defn compiler-region-allocate [(r (ptr CompilerRegion))
                                (request (ref alloc/AllocRequest))] (-> (Option (ptr i8)))
  (let [bytes (.bytes request)
        alignment (.align request)
        (mut chunk) (.head r)]
    (if (not (alloc/valid-request? request))
        (panic "compiler-region: invalid allocation")
        0)
    (let [fits
            (if (= (primitive/cast i64 (load chunk)) 0)
                false
                (let [c (load chunk)
                      start
                        (alloc/align-up (+ (primitive/cast i64 c) (.used c))
                                        alignment)]
                  (<= (+ (- start (primitive/cast i64 c)) bytes) (.capacity c))))]
      (if (not fits)
          (let [need (+ (+ (primitive/sizeof CompilerChunk) alignment) bytes)
                capacity
                  (if (> need COMPILER-CHUNK-BYTES) need COMPILER-CHUNK-BYTES)
                memory (alloc/malloc (primitive/cast isize capacity))]
            (if (= (primitive/cast i64 memory) 0)
                (alloc/oom-at c"compiler-region" capacity)
                0)
            (set! (mut chunk) (primitive/cast (ptr CompilerChunk) memory))
            (let [c (load chunk)]
              (set! c
                    (CompilerChunk
                      :next (.head r)
                      :capacity capacity
                      :used (primitive/sizeof CompilerChunk)))
              (set! (.head r) c)
              (set! (.reserved r) (+ (.reserved r) capacity))))
          0))
    (let [c (load chunk)
          base (primitive/cast i64 c)
          start (alloc/align-up (+ base (.used c)) alignment)]
      (set! (.used c) (+ (- start base) bytes))
      (Some (primitive/cast (ptr i8) start)))))

(impl alloc/Allocator CompilerRegion
  (allocate [(self (ptr CompilerRegion)) (request (ref alloc/AllocRequest))]
            (-> (Option (ptr i8)))
            (compiler-region-allocate self request))
  ;; Collection growth takes a new slice and copies. No existing address ever moves or becomes
  ;; invalid before region teardown, including allocations referenced by graph edges.
  (resize [(self (ptr CompilerRegion))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))]
          (-> bool)
          false)
  (remap [(self (ptr CompilerRegion))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))]
         (-> (Option (ptr i8)))
         (None [(ptr i8)]))
  (deallocate [(self (ptr CompilerRegion))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))]
              (-> i64)
              0))

(defn compiler-allocator [] (-> (dyn alloc/Allocator))
  (if (.active (compiler-region))
      (primitive/make-dyn alloc/Allocator (compiler-region))
      (alloc/malloc-allocator)))

;; The slot itself is static at the accessor's call site; the state it names belongs to exactly
;; one generation. An epoch change invalidates ALL compiler singleton payloads, including parser,
;; types, machine-mask caches and sparse-worklist memos, without dereferencing freed storage.
(defn compiler-state [T] [(slot (ptr CompilerStateSlot))] (-> (ptr T))
  (let [r (compiler-region)]
    (if (or (= (primitive/cast i64 (.address slot)) 0)
            (!= (.epoch slot) (.epoch r)))
        (let [p (alloc/unwrap-ptr [T] (alloc/create [T] (compiler-allocator)))]
          (set! p (primitive/zeroed T))
          (set! (.address slot) (primitive/cast (ptr i8) p))
          (set! (.epoch slot) (.epoch r)))
        0)
    (primitive/cast (ptr T) (.address slot))))

(defn compiler-region-clear! [(r (ptr CompilerRegion))] (-> i64)
  (let [(mut chunk) (.head r)]
    (loop (if (= (primitive/cast i64 (load chunk)) 0)
              (break 0)
              (let [c (load chunk)
                    next (.next c)
                    capacity (.capacity c)]
                (alloc/free [u8]
                            (alloc/malloc-allocator)
                            (slice-new [u8]
                                       (primitive/cast (ptr u8) c)
                                       capacity))
                (set! (mut chunk) next)
                (continue))))
    (set! (.head r) (primitive/cast (ptr CompilerChunk) 0))
    (set! (.reserved r) 0)
    (set! (.epoch r) (+ (.epoch r) 1))
    (set! (.active r) true)
    0))

(defn compiler-session-reset! [] (-> i64)
  (compiler-region-clear! (compiler-region)))
