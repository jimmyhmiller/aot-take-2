;; Array operations the stdlib `ArrayList` does not provide.

;;
;; Two removal disciplines, and which one a caller wants is a semantic question:
;;
;;   `al-del-at!`    swap-with-last. O(1), DOES NOT preserve order. Correct for a def-use output
;;                   list, where order carries no meaning.
;;   `al-remove-at!` shift-down. O(n), preserves order. Required for a use-def input list, where
;;                   position IS the operand ("a/b" is not "b/a").
;;
;; Using the fast one on inputs is a miscompile that typechecks, so they are named apart.
(module aot.util.ary)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)

;; Remove element `i` by moving the last element into its place. Order is NOT preserved.
(defn al-del-at! [T] [(l (mut (ArrayList T))) (i i64)] (-> i64)
  (let [n (len l)]
    (if (or (< i 0) (>= i n))
        (panic-i "al-del-at!: index out of range" i)
        (do
          (if (!= i (- n 1))
              (set! (mut l) i (get l (- n 1)))
              0)
          (match (pop! (mut l)) (Some [_] 0) (None [] 0))))))

;; Remove element `i`, shifting every later element down one. Order IS preserved.
(defn al-remove-at! [T] [(l (mut (ArrayList T))) (i i64)] (-> i64)
  (let [n (len l)]
    (if (or (< i 0) (>= i n))
        (panic-i "al-remove-at!: index out of range" i)
        (let [(mut j) i]
          (loop (if (>= (load j) (- n 1))
                    (break 0)
                    (do
                      (set! (mut l) (load j) (get l (+ (load j) 1)))
                      (set! (mut j) (+ (load j) 1))
                      (continue))))
          (match (pop! (mut l)) (Some [_] 0) (None [] 0))))))

;; Insert `v` at `i`, shifting every element from `i` up one. Order IS preserved.
(defn al-insert-at! [T] [(l (mut (ArrayList T))) (i i64) (v T)] (-> i64)
  (let [n (len l)]
    (if (or (< i 0) (> i n))
        (panic-i "al-insert-at!: index out of range" i)
        (do
          (push! (mut l) v)
          (let [(mut j) n]
            (loop (if (<= (load j) i)
                      (break 0)
                      (do
                        (set! (mut l) (load j) (get l (- (load j) 1)))
                        (set! (mut j) (- (load j) 1))
                        (continue))))
            (set! (mut l) i v))))))
