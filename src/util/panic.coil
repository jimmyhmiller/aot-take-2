;; Hard failure. There is no soft failure in this compiler.

;;
;; A stub that returns -1, 0, null or an empty collection makes the failure surface somewhere
;; else, hours later, in a form that looks like a miscompile. Every unimplemented path in this
;; project calls `unimplemented` and dies naming itself.
(module aot.util.panic)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.os" :as os)

;; Exit codes. A distinct code per failure class so a harness can tell a deliberate refusal from
;; a crash without parsing text.
(const EXIT-PANIC 70)

(const EXIT-UNIMPLEMENTED 71)

(const EXIT-VERIFY 72)

;; Versioned syntax-validation protocol. Only the syntax-only driver emits these records;
;; diagnostics, unsupported capabilities and compiler panics are separate channels.
(const EXIT-SYNTAX 73)
(const PARSE-NORMAL-RECORD "AOT-PARSE/1 normal\n")
(const PARSE-SYNTAX-RECORD "AOT-PARSE/1 SyntaxError\n")

(defn parse-syntax-diagnostic! [(message (slice u8))] (-> i64)
  (try (try-or! (io/print-str (io/stdout) PARSE-SYNTAX-RECORD)
                (do (os/_exit (primitive/cast i32 EXIT-PANIC)) 0)))
  (p--str message)
  (p--str "\n")
  (os/_exit (primitive/cast i32 EXIT-SYNTAX))
  0)

(defn p--str [(s (slice u8))] (-> i64)
  (try (let [v (try-or! (io/print-str (io/stderr) s) 0)] v)))

(defn p--int [(n i64)] (-> i64)
  (try (let [v (try-or! (io/print-int (io/stderr) n) 0)] v)))

;; Abort with `msg`. Never returns; the `i64` result is so a panic can sit in an expression
;; position where a value is required.
(defn panic [(msg (slice u8))] (-> i64)
  (p--str "\naot: PANIC: ")
  (p--str msg)
  (p--str "\n")
  (os/_exit (primitive/cast i32 EXIT-PANIC))
  0)

;; Abort with `msg` and one integer datum.
(defn panic-i [(msg (slice u8)) (n i64)] (-> i64)
  (p--str "\naot: PANIC: ")
  (p--str msg)
  (p--str " [")
  (p--int n)
  (p--str "]\n")
  (os/_exit (primitive/cast i32 EXIT-PANIC))
  0)

;; Abort with `msg` and two integer data.
(defn panic-i2 [(msg (slice u8)) (a i64) (b i64)] (-> i64)
  (p--str "\naot: PANIC: ")
  (p--str msg)
  (p--str " [")
  (p--int a)
  (p--str ", ")
  (p--int b)
  (p--str "]\n")
  (os/_exit (primitive/cast i32 EXIT-PANIC))
  0)

;; The stub marker. `what` names the function and `where` names the plan section that owns it,
;; so the message says what to go implement rather than merely that something is missing.
(defn unimplemented [(what (slice u8)) (where (slice u8))] (-> i64)
  (p--str "\naot: UNIMPLEMENTED: ")
  (p--str what)
  (p--str "\n  owner: ")
  (p--str where)
  (p--str "\n  This is a scaffold stub. See docs/LAYOUT.md.\n")
  (os/_exit (primitive/cast i32 EXIT-UNIMPLEMENTED))
  0)

;; An invariant the compiler believed and the graph contradicted. Distinct from `unimplemented`:
;; this one means a bug here, not absent work.
(defn broken [(what (slice u8))] (-> i64)
  (p--str "\naot: BROKEN INVARIANT: ")
  (p--str what)
  (p--str "\n")
  (os/_exit (primitive/cast i32 EXIT-PANIC))
  0)
