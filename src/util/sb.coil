;; A string builder and a byte sink.

;;
;; Every printer in this compiler appends into one of these rather than concatenating, because a
;; graph printer that concatenates is quadratic in the graph and the graphs worth printing are the
;; big ones.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S1.
(module aot.util.sb)
(import "aot.util.panic" :use *)

(defn sb-new [] (-> i64)
  (do (unimplemented "sb-new" "S1 — src/util/sb.coil") 0))

(defn sb-str! [(b i64) (s (slice u8))] (-> i64)
  (do (unimplemented "sb-str!" "S1 — src/util/sb.coil") 0))

(defn sb-int! [(b i64) (n i64)] (-> i64)
  (do (unimplemented "sb-int!" "S1 — src/util/sb.coil") 0))

(defn sb-take [(b i64)] (-> (slice u8))
  (do (unimplemented "sb-take" "S1 — src/util/sb.coil") ""))
