;; ============================================================================

;; PHI  —  port of Simple's `node/PhiNode.java`
;; ============================================================================
;;
;; Input 0 is the Region or Loop. Inputs 1..n are the values, ONE PER PATH, positionally matched to
;; the Region's inputs 1..n. A Phi is PINNED: it executes in its Region and code motion may not
;; move it.
;;
;; ## compute — three cases, and the middle one is load-bearing
;;
;;     region is dead (XCTRL/TOP)  -> TOP
;;     region IN PROGRESS          -> the DECLARED type, not the meet
;;     otherwise                   -> TOP meet over inputs on LIVE paths only
;;
;; Two details of the third case matter:
;;
;; - It SKIPS paths whose control is XCONTROL or TOP. A Phi does not merge a value that cannot
;;   arrive. This is what lets a loop Phi have a sensible type before the back edge is analysed —
;;   and it is also why provisionality hides below any local check, which is why `ty-proven?` has
;;   to be transitive over the whole input cone rather than a one-level test.
;;
;; - It calls `addDep` on each Region input it consults. If a control path later dies, this Phi is
;;   re-queued. Without that dependency the Phi keeps a stale meet forever.
;;
;; ## Loop widening — the termination argument
;;
;; On a LOOP Phi whose type is an integer and is FALLING, Simple does not let it fall one value at
;; a time. `same_but_slightly_wider_than` jumps it toward the declared bound. Consider
;; `for (i = 0; ...; i++)`: the Phi is 0, then meets 1 to give [0..1], then [0..2] — a fixpoint
;; that takes as many iterations as the loop has values. Widening jumps to the declared range in a
;; bounded number of steps. Without it, the optimiser terminates only in the sense that the
;; universe is finite.
;;
;; ## idealize — Simple's rules in order
;;
;; 0. If the Region collapsed to something that is not a Region, become `in(1)`.
;;    If the Region is in progress, or has no inputs, or this Phi is unused — do nothing.
;;
;; 1. SINGLE UNIQUE INPUT -> become it. This is the rule that makes inlining work: when a Fun
;;    collapses to one path its Parms are Phis with one distinct value, and that value is the
;;    caller's actual argument. Argument substitution is this rule, not a substitution pass.
;;
;;    "Unique" ignores self-references, so a loop Phi whose only other input is itself collapses.
;;
;; 2. Bail if the Region still has a dead path — it is about to fold, so do not race it.
;;
;; 3. PULL THE OP DOWN THROUGH THE PHI ("same_op"). If every input is the same operation with the
;;    same shape, rewrite `Phi(op(a1,b1), op(a2,b2))` into `op(Phi(a1,a2), Phi(b1,b2))`, creating a
;;    Phi only for the argument positions that actually differ.
;;
;;    The guards are the whole content of the rule, and each one is a bug someone had:
;;      - same class, same input count, and NO control input (a pinned op cannot be moved);
;;      - for memory ops, the same alias — merging two different alias classes is a miscompile;
;;      - a Load whose memory is clobbered by a Store among its users cannot be pulled forward;
;;      - an Escape or a MemMerge is refused outright (aliases must stay straight);
;;      - at most ONE input may have other users; two and the rewrite duplicates work rather than
;;        removing it. `addDep` is registered on the extra users so it retries if they go away;
;;      - a ScopeNode input means a LAZY PHI that has not been realised yet — not a real value.
;;
;; 4. NULL-CHECK MERGES. Two forms, both about not losing the narrowing a guard established:
;;      - `Phi(zero, Guard_nonzero(N))` -> `N`. The Cast's join effect is being lost anyway.
;;      - `if (val) ...; Phi(region, false=null, true=val)` -> `val`, when the Region's idom is the
;;        If that tested `val`. Simple walks up the idom chain from the NULL side to confirm it
;;        really arrives through the FALSE projection before firing — the pattern is not enough,
;;        the dominance has to hold.
;;
;; ## MemPhi
;;
;; A Phi over a memory edge rather than a value edge, carrying an alias class. Same node, same
;; rules; `PhiNode.make` picks the subclass from the type (alias 1 = the bulk "all memory" phi).
;; It matters that this is the SAME node kind: every rule above then applies to memory merges with
;; no second implementation to keep in agreement.
;;
;; ## Lazy phis are NOT here
;;
;; Simple creates a Phi only when a variable is actually assigned on more than one path; until then
;; the scope slot points at the enclosing scope. That machinery lives in `aot.node.scope`, because
;; ============================================================================
;; STATUS: implemented for every live scalar node: rules 0-3 and the structural
;; zero/truthy-Cast form of rule 4 are tested. Memory alias/clobber guards and the alternate
;; dominance-walk null merge land with MemOp and full scope SSA respectively.
;; ============================================================================
(module aot.node.phi)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.type.type" :use *)

;; Input 0 is the Region or Loop. Inputs 1..n are the values, ONE PER PATH, positionally matched to
;; the Region's inputs 1..n.
(defstruct PhiNode [(hdr NodeHdr) (declared i64) (name (slice u8))])

(defn phi-region [(p (dyn NodeOps))] (-> (dyn NodeOps))
  (n-in! p 0))

(defn phi-declared-ty [(p (dyn NodeOps))] (-> i64)
  (if (and (!= (n-op p) OP-PHI) (!= (n-op p) OP-MEMPHI))
      (do (panic "phi-declared-ty: not a Phi") TY-BOT)
      (.declared (primitive/cast (ptr PhiNode) (hdr p)))))

;; A Phi's construction window is independent of its Region's. The parser normally fills the
;; final Simple closes the Loop control edge before immediately filling Phi backedges. Treating only
;; Region openness as construction state would expose that interval, so Simple also treats a null
;; final Phi input as in progress.
(defn phi-in-progress? [(p (dyn NodeOps))] (-> bool)
  (let [r (phi-region p)]
    (or (and (or (= (n-op r) OP-REGION) (= (n-op r) OP-LOOP)) (region-in-progress? r))
        (match (n-in p (- (n-nins p) 1)) (Some [_] false) (None [] true)))))

;; Simple's loop-Phi termination rule. A falling nonconstant integer range gets three progressively
;; wider identities; on the fourth fall it jumps to the parser-declared bound. Arithmetic carries
;; the widen stage, so a backedge cannot accidentally reset the countdown.
;;
;; `phi-widen-falling-int` is the rule itself, over the old and new types and the declared bound;
;; a loop Phi applies it here, and a Parm applies it too (aot.node.call): a recursive call is a
;; back edge in the call graph, and `f(i + 1)` seeded with a constant is the same ascending chain
;; `i = i + 1` is in a loop. Simple widens only on LoopNode Phis, and its recursive tests happen to
;; be seeded with an unbounded argument; a constant seed would not converge there either.
(defn phi-widen-falling-int [(old i64) (newt i64) (declared i64)] (-> i64)
  (if (and (ty-int? newt)
           (and (not (ty-high? newt))
           (and (!= newt old)
                (and (not (ty-constant? newt))
                     (or (= old TY-INVALID) (not (ty-int? old)) (<= (ty-int-widen newt) (ty-int-widen old)))))))
      (ty-int-slightly-wider-than newt declared)
      newt))

(defn phi--maybe-widen [(p (dyn NodeOps)) (r (dyn NodeOps)) (newt i64)] (-> i64)
  (if (= (n-op r) OP-LOOP)
      (phi-widen-falling-int (n-ty p) newt (phi-declared-ty p))
      newt))

;; Simple's three cases:
;;
;;   region dead (XCTRL/TOP)  -> TOP
;;   region IN PROGRESS       -> the DECLARED type, not the meet
;;   otherwise                -> TOP meet over inputs on LIVE paths ONLY
;;
;; Two details of the third case are load-bearing:
;;
;;   It SKIPS paths whose control is XCONTROL or TOP. A Phi does not merge a value that cannot
;;   arrive. That is what lets a loop Phi have a sensible type before the back edge is analysed —
;;   and it is also why provisionality hides below any local check, which is why `ty-proven?` must
;;   be transitive over the whole input cone rather than a one-level test.
;;
;;   It calls `n-add-dep!` on each Region input consulted. If a control path later dies, this Phi is
;;   re-queued. Without that dependency the Phi keeps a stale meet forever.
(defn phi-compute [(p (dyn NodeOps))] (-> i64)
  (match (n-in p 0)
    (None [] TY-TOP)
    (Some [r]
          (if (or (= (n-ty r) TY-XCTRL) (= (n-ty r) TY-TOP))
              TY-TOP
              (if (or (not (or (= (n-op r) OP-REGION) (= (n-op r) OP-LOOP)))
                      (phi-in-progress? p))
                  ;; In progress: report the DECLARED type. Reporting the meet here lets `i+1` fold
                  ;; to a literal and deletes the loop.
                  (phi-declared-ty p)
                  (let [cnt (n-nins p)
                        (mut i) 1
                        (mut t) TY-TOP]
                    (loop (if (>= (load i) cnt)
                              (break 0)
                              (do
                                (match (n-in r (load i))
                                  (Some [rc]
                                        (do
                                          (n-add-dep! rc p)
                                          (if (or (= (n-ty rc) TY-XCTRL) (= (n-ty rc) TY-TOP))
                                              0
                                              (match (n-in p (load i))
                                                (Some [v] (set! (mut t) (ty-meet (load t) (n-ty v))))
                                                (None [] 0)))))
                                  (None [] 0))
                                (set! (mut i) (+ (load i) 1))
                                (continue))))
                    (phi--maybe-widen p r (load t))))))))

;; The single DISTINCT input, ignoring self-references, or None if the inputs differ.
;;
;; >>> THIS IS THE RULE THAT MAKES INLINING WORK. When a Fun collapses to one path its Parms are
;; >>> Phis with one distinct value, and that value is the caller's actual argument. Argument
;; >>> substitution IS this rule, not a substitution pass.
;;
;; Ignoring self-references is what lets a loop Phi whose only other input is itself collapse.
(defn phi-single-unique-input [(p (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (match (n-in p 0)
    (None [] (None [(dyn NodeOps)]))
    (Some [r]
          ;; A Loop whose entry is dead must collapse as control first. Looking only at its backedge
          ;; value can otherwise replace the Phi with a value from an unreachable iteration.
          (if (and (= (n-op r) OP-LOOP)
                   (match (n-in r 1) (Some [entry] (= (n-ty entry) TY-XCTRL)) (None [] false)))
              (None [(dyn NodeOps)])
              (let [cnt (n-nins p)
                    (mut i) 1
                    (mut found) (None [(dyn NodeOps)])
                    (mut differs) false]
                (loop (if (or (>= (load i) cnt) (load differs))
                          (break 0)
                          (do
                            ;; A value on dead control does not participate. Register the dependency
                            ;; so this Phi is retried if a currently-live path dies later.
                            (match (n-in r (load i))
                              (Some [ctrl]
                                    (do
                                      (n-add-dep! ctrl p)
                                      (if (= (n-ty ctrl) TY-XCTRL)
                                          0
                                          (match (n-in p (load i))
                                            (Some [v]
                                                  (if (n-same? v p)
                                                      0
                                                      (match (load found)
                                                        (None [] (set! (mut found) (Some v)))
                                                        (Some [f]
                                                              (if (n-same? f v)
                                                                  0
                                                                  (set! (mut differs) true))))))
                                            (None [] 0)))))
                              (None [] 0))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (if (load differs) (None [(dyn NodeOps)]) (load found)))))))

;; Does any of the Region's paths carry XCONTROL? If so the Region is about to fold, and this Phi
;; must not race it.
(defn phi--region-has-dead-path? [(r (dyn NodeOps))] (-> bool)
  (let [cnt (n-nins r)
        (mut i) 1
        (mut yes) false]
    (loop (if (or (>= (load i) cnt) (load yes))
              (break 0)
              (do
                (match (n-in r (load i))
                  (Some [v] (if (= (n-ty v) TY-XCTRL) (set! (mut yes) true) 0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load yes)))

(defn phi-idealize [(p (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (match (n-in p 0)
    ;; 0. The Region collapsed to something that is not a Region: become input 1.
    (None [] (n-in p 1))
    (Some [r]
          (if (not (or (= (n-op r) OP-REGION) (= (n-op r) OP-LOOP)))
              (n-in p 1)
              (if (or (phi-in-progress? p) (<= (n-nins r) 1) (= (n-nouts p) 0))
                  (None [(dyn NodeOps)])
                  ;; 1. SINGLE UNIQUE INPUT -> become it.
                  (match (phi-single-unique-input p)
                    (Some [live] (Some live))
                    (None []
                          ;; 2. Bail if the Region still has a dead path — it is about to fold, so
                          ;; do not race it.
                          (if (phi--region-has-dead-path? r)
                              (None [(dyn NodeOps)])
                              ;; 3. Pull a matching unpinned scalar operation below the merge.
                              (match (phi--drop-same-op p r)
                                (Some [progress] (Some progress))
                                ;; 4. Recover the value split by a truthiness guard.
                                (None [] (phi--merge-zero-truthy p)))))))))))

(defn phi--merge-zero-truthy [(p (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (if (!= (n-nins p) 3)
      (None [(dyn NodeOps)])
      (let [a (n-in! p 1)
            b (n-in! p 2)]
        (if (phi--zero-value? (n-ty a))
            (match (truthiness-cast-source b)
              (Some [source] (if (n-same? source p) (None [(dyn NodeOps)]) (Some source)))
              (None [] (None [(dyn NodeOps)])))
            (if (phi--zero-value? (n-ty b))
                (match (truthiness-cast-source a)
                  (Some [source] (if (n-same? source p) (None [(dyn NodeOps)]) (Some source)))
                  (None [] (None [(dyn NodeOps)])))
                (None [(dyn NodeOps)]))))))

(defn phi--zero-value? [(t i64)] (-> bool)
  (or (= t TY-NIL) (and (ty-int? t) (and (= (ty-int-lo t) 0) (= (ty-int-hi t) 0)))))

;; Simple's `same_op` and `drop_same_op`, for the scalar operations present today. Memory-specific
;; alias/clobber guards join this same routine when MemOp exists; no weaker memory rewrite is
;; attempted in the meantime.
(defn phi--same-op-copy-supported? [(n (dyn NodeOps))] (-> bool)
  (let [op (n-op n)]
    (or (= op OP-MINUS)
        (= op OP-TOFLOAT)
        (= op OP-TOINT)
        (= op OP-ROUNDF32)
        (= op OP-NOT)
        (= op OP-ADD)
        (= op OP-SUB)
        (= op OP-MUL)
        (= op OP-DIV)
        (= op OP-SHL)
        (= op OP-AND)
        (= op OP-OR)
        (= op OP-XOR)
        (= op OP-SHR)
        (= op OP-SAR)
        (= op OP-EQ)
        (= op OP-NE)
        (= op OP-LT)
        (= op OP-LE)
        (= op OP-ULT))))

(defn phi--drop-same-op [(p (dyn NodeOps)) (r (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (match (n-in p 1)
    (None [] (None [(dyn NodeOps)]))
    (Some [sample]
          (if (or (and (!= (n-nins sample) 2) (!= (n-nins sample) 3))
                  (match (n-in sample 0) (Some [_] true) (None [] false))
                  (not (phi--same-op-copy-supported? sample)))
              (None [(dyn NodeOps)])
              (if (not (phi--same-op-inputs? p sample))
                  (None [(dyn NodeOps)])
                  (let [lhs (phi--merged-op-input p r 1)]
                    (match (if (= (n-nins sample) 2)
                               ;; The reconstruction hook's RHS is ignored by unary nodes.
                               (n-binop-copy sample lhs lhs)
                               (n-binop-copy sample lhs (phi--merged-op-input p r 2)))
                      (None [] (None [(dyn NodeOps)]))
                      (Some [copy]
                            ;; Do not run the rule backwards. This matters for bitwise operators
                            ;; whose computed range may be less precise after pulling down.
                            (if (ty-isa? (compute copy) (phi-compute p))
                                (Some copy)
                                (do
                                  (if (n-unused? copy) (n-kill! copy) 0)
                                  (None [(dyn NodeOps)])))))))))))

(defn phi--same-op-inputs? [(p (dyn NodeOps)) (sample (dyn NodeOps))] (-> bool)
  (let [cnt (n-nins p)
        (mut i) 1
        (mut busy) 0
        (mut ok) true]
    (loop (if (or (>= (load i) cnt) (not (load ok)))
              (break 0)
              (do
                (match (n-in p (load i))
                  (None [] (set! (mut ok) false))
                  (Some [op]
                        (if (or (!= (n-op op) (n-op sample))
                                (!= (n-nins op) (n-nins sample))
                                (not (eq-extra sample op))
                                (match (n-in op 0) (Some [_] true) (None [] false)))
                            (set! (mut ok) false)
                            (do
                              (if (> (n-nouts op) 1)
                                  (set! (mut busy) (+ (load busy) 1))
                                  0)
                              (if (> (load busy) 1)
                                  (do
                                    (phi--depend-on-other-users! p op)
                                    (set! (mut ok) false))
                                  0)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load ok)))

(defn phi--depend-on-other-users! [(p (dyn NodeOps)) (op (dyn NodeOps))] (-> i64)
  (let [cnt (n-nouts op)
        (mut i) 0]
    (loop (if (>= (load i) cnt)
              (break 0)
              (do
                (match (n-out op (load i))
                  (Some [use] (if (n-same? use p) 0 (n-add-dep! use p)))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))))

(defn phi--merged-op-input [(p (dyn NodeOps)) (r (dyn NodeOps)) (idx i64)] (-> (dyn NodeOps))
  (let [first-op (n-in! p 1)
        first (n-in! first-op idx)
        cnt (n-nins p)
        (mut i) 2
        (mut differs) false]
    (loop (if (or (>= (load i) cnt) (load differs))
              (break 0)
              (do
                (let [op (n-in! p (load i))]
                  (if (n-same? (n-in! op idx) first) (set! (mut i) (+ (load i) 1)) (set! (mut differs) true)))
                (continue))))
    (if (not (load differs))
        first
        ;; Simple drop_same_op builds the new Phi from an operand's type, not the result type.
        ;; Comparisons return BOOL while their operands may be floating. Our Phi constructor
        ;; installs its declared bound immediately, so meet ALL operand types before construction
        ;; rather than inheriting the result bound or assuming the first operand bounds the rest.
        (let [(mut bound) TY-TOP
              (mut k) 1]
          (loop (if (>= (load k) cnt)
                    (break 0)
                    (do
                      (set! (mut bound) (ty-meet (load bound) (n-ty (n-in! (n-in! p (load k)) idx))))
                      (set! (mut k) (+ (load k) 1))
                      (continue))))
        (let [merged (phi-make r (load bound) "phi-op")
              (mut j) 1]
          (loop (if (>= (load j) cnt)
                    (break 0)
                    (do
                      (phi-add-value! merged (n-in! (n-in! p (load j)) idx))
                      (set! (mut j) (+ (load j) 1))
                      (continue))))
          (n-set-ty! merged (compute merged))
          merged)))))

(impl NodeOps PhiNode
  (hdr [(self (ptr PhiNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr PhiNode))] (-> (slice u8)) (.name self))
  (is-const? [(self (ptr PhiNode))] (-> bool) false)
  ;; A Phi on an IN-PROGRESS Region reports its DECLARED type, which may well be constant. Folding
  ;; it then would replace a loop-carried variable with its initial value — this is exactly the hook
  ;; the engine reserved for half-built nodes.
  (no-const-fold? [(self (ptr PhiNode))]
                  (-> bool)
                  (phi-in-progress? (primitive/make-dyn NodeOps self)))
  ;; PINNED: a Phi executes in its Region and code motion may not move it.
  (is-pinned? [(self (ptr PhiNode))] (-> bool) true)
  (binop-copy [(self (ptr PhiNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)]))
  (compute [(self (ptr PhiNode))] (-> i64) (phi-compute (primitive/make-dyn NodeOps self)))
  (idealize [(self (ptr PhiNode))]
            (-> (Option (dyn NodeOps)))
            (phi-idealize (primitive/make-dyn NodeOps self)))
  (eq-extra [(self (ptr PhiNode)) (other (dyn NodeOps))]
            (-> bool)
            ;; Open loop Phis may have identical partial inputs and different future backedges.
            (and (not (phi-in-progress? (primitive/make-dyn NodeOps self)))
                 (and (or (= (n-op other) OP-PHI) (= (n-op other) OP-MEMPHI))
                      (not (phi-in-progress? other)))))
  (hash-extra [(self (ptr PhiNode))] (-> i64) 151))

;; Build a Phi on `region` with a declared type.
;;
;; While the region is in progress the Phi reports `declared`, NOT the meet of its inputs — the
;; back-edge value has no type yet.
(defn phi-make-op [(region (dyn NodeOps)) (declared i64) (name (slice u8)) (op i64)] (-> (dyn NodeOps))
  (if (and (!= op OP-PHI) (!= op OP-MEMPHI))
      (do (panic-i "phi-make-op: expected OP-PHI or OP-MEMPHI" op) (unreachable-node))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [PhiNode] (alloc/create [PhiNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.declared p) declared)
    (set! (.name p) name)
    (n-init! d op)
    (n-add-def! d (Some region))
    (n-set-ty! d declared)
    d)))

(defn phi-make [(region (dyn NodeOps)) (declared i64) (name (slice u8))] (-> (dyn NodeOps))
  (phi-make-op region declared name OP-PHI))

(defn phi-add-value! [(p (dyn NodeOps)) (v (dyn NodeOps))] (-> i64)
  (n-add-def! p (Some v)))

;; Append a null placeholder, matching an in-progress Region's open final path.
(defn phi-open! [(p (dyn NodeOps))] (-> i64)
  (n-add-def! p (None [(dyn NodeOps)])))

;; Close the Phi by filling that placeholder. Final Simple calls this immediately AFTER wiring the
;; Loop control backedge, inside one `endLoop` operation that exposes no intervening peephole. The
;; Phi's own null-final-input state keeps compute, folding, idealization and GVN blocked meanwhile.
(defn phi-close! [(p (dyn NodeOps)) (v (dyn NodeOps))] (-> i64)
  (let [last (- (n-nins p) 1)]
    (match (n-in p last)
      (Some [_] (broken "phi-close!: the phi is not open"))
      (None [] (n-set-def! p last (Some v))))))

;; --- owed to units that do not exist yet, and NOT stubs ---
;;
;; Memory same-op needs matching aliases, Load-vs-Store clobber checks, and explicit Escape and
;; MemMerge refusal. None of those node kinds exists yet; scalar same-op is implemented above.
;;
;; The alternate NULL-CHECK form `if (val) …; Phi(region, false=null, true=val)` -> `val` fires when
;; the Region's idom is the If that
;;    tested `val` — confirmed by walking the idom chain from the NULL side to check it really
;;    arrives through the FALSE projection. The pattern alone is not enough; the dominance has to
;;    hold. The structural `Phi(zero, truthy-Cast(val))` form is implemented above.
