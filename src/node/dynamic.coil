;; The dynamic value: Box, Unbox, TypeTest, Cast.

;;
;; This is the file that makes the compiler a JavaScript compiler rather than a Simple compiler.
;;
;; REPRESENTATION. A dynamic value is one 64-bit word, NaN-boxed: doubles are stored directly and
;; everything else lives in the NaN payload space. JavaScript numbers ARE doubles, so any
;; representation that heap-boxes a non-small double loses numeric code outright. All floating NaNs
;; canonicalise to the positive quiet NaN when boxed; the adjacent quiet-NaN prefixes carry the
;; non-double tags. That payload loss is forced — the full set of double bit patterns already uses
;; every 64-bit word, so preserving NaN payloads while adding other values to the same word is
;; impossible.
;;
;; Box and Unbox are ORDINARY NODES and the optimiser cancels them in pairs. Unbox(Box(x)) is x,
;; and that peephole is where an unboxed loop body comes from.
;;
;; GUARDS ARE CONTROL FLOW. A type guard is `If(TypeTest(v,T))` and then `Cast(T)` on the taken
;; edge. There is deliberately no Guard opcode: every CFG peephole, dominator computation, code
;; motion pass and dataflow solver already understands If/Region/Phi/Cast, and a distinct opcode
;; would need bespoke handling in each. `cast-idealize` folds when the input already `isa` the cast
;; type — which is exactly how a discharged TypeScript annotation disappears.
;;
;; Slow paths are ordinary CFG paths carrying a cold hint. Nothing downstream needs to know they
;; are slow beyond block layout and spill costs.
;;
;; ============================================================================
;; STATUS: implemented. Box · Unbox · TypeTest · Cast, the pair-cancelling peephole, and the guard
;; construction that ties them together. `Cast` is the port of Simple's `GuardNode`, generalised
;; from zero/non-zero to any lattice point — which is what a TypeScript annotation needs. Raw
;; object/string/symbol representations wait on their corresponding lattice and runtime families.
;; ============================================================================
(module aot.node.dynamic)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.control" :use *)
(import "aot.type.type" :use *)

;; The representation an Unbox produces, and the tag a Box consumes.
(const REP-INT TAG-INT)

(const REP-DOUBLE TAG-DOUBLE)

;; A JavaScript Number consumer accepts either compact signed-48 immediates or raw IEEE doubles and
;; always produces f64. It is a conversion representation, not a third runtime tag.
(const REP-NUMBER TAG-NUMBER)

(const REP-BOOL TAG-BOOL)

;; Null and undefined have no source-language payload, but representing their canonical zero
;; payload explicitly as Box nodes gives them the same materialization and scheduling contract as
;; every other NaN-boxed value.
(const REP-NULL TAG-NULL)

(const REP-UNDEFINED TAG-UNDEFINED)

(const REP-OBJECT TAG-OBJECT)

(const REP-STRING TAG-STRING)

(const REP-FUNCTION TAG-FUNCTION)

(defn raw-object-ty [] (-> i64)
  (ty-memptr false (ty-struct "JsObjectPayload")))

(defn raw-function-ty [] (-> i64)
  (ty-memptr false (ty-struct "JsFunctionPayload")))

(defn raw-string-ty [] (-> i64)
  (ty-memptr false (ty-struct "JsStringPayload")))

;; Runtime high-prefix assignment. Positive quiet-NaN space holds canonical NaN plus the first
;; seven non-double families. Function needs a distinct identity from Object for `%IsFunction`, so
;; it uses the corresponding negative quiet-NaN space; BoxDouble canonicalizes every NaN before it
;; crosses this boundary, leaving that prefix unambiguous. Object-layout runtime kinds refine the
;; payload behind TAG-OBJECT and do not replace these top-level JavaScript value families.
(const DYNAMIC-PREFIX-DOUBLE-NAN 0x7ff8)

(const DYNAMIC-PREFIX-INT 0x7ff9)

(const DYNAMIC-PREFIX-UNDEFINED 0x7ffa)

(const DYNAMIC-PREFIX-NULL 0x7ffb)

(const DYNAMIC-PREFIX-BOOL 0x7ffc)

(const DYNAMIC-PREFIX-STRING 0x7ffd)

(const DYNAMIC-PREFIX-SYMBOL 0x7ffe)

(const DYNAMIC-PREFIX-OBJECT 0x7fff)

(const DYNAMIC-PREFIX-FUNCTION 0xfff9)

;; Exact runtime word for JavaScript `undefined`. The zero payload makes every omitted argument
;; canonical and gives object files one exact value.
(const DYNAMIC-UNDEFINED-WORD 0x7ffa000000000000)

(defn dynamic-prefix-for-tag [(tag i64)] (-> i64)
  (case tag TAG-UNDEFINED
        DYNAMIC-PREFIX-UNDEFINED TAG-NULL
        DYNAMIC-PREFIX-NULL TAG-BOOL
        DYNAMIC-PREFIX-BOOL TAG-INT
        DYNAMIC-PREFIX-INT TAG-STRING
        DYNAMIC-PREFIX-STRING TAG-SYMBOL
        DYNAMIC-PREFIX-SYMBOL TAG-OBJECT
        DYNAMIC-PREFIX-OBJECT TAG-FUNCTION
        DYNAMIC-PREFIX-FUNCTION 0))

(defn dyn-undefined-make [] (-> (dyn NodeOps))
  (con-make (ty-dyn TAG-UNDEFINED)))

;; Exact runtime word for JavaScript `null`, as a constant rather than a Box of zero: a constant is
;; clone-cheap, so GCM can give every function its own copy after inlining shares it.
(defn dyn-null-make [] (-> (dyn NodeOps))
  (con-make (ty-dyn TAG-NULL)))

;; ---------------------------------------------------------------------------
;; BOX — a raw value of known representation becomes one NaN-boxed word
;;
;; The type is the SINGLETON tag set for whatever the input's representation is. That singleton is
;; what makes `Unbox(Box(x))` provable: the tag set is not merely known, it has exactly one member.
(defstruct BoxNode [(hdr NodeHdr) (rep i64)])

(defn box-rep [(n (dyn NodeOps))] (-> i64)
  (if (!= (n-op n) OP-BOX)
      (do (panic-i "box-rep: not a Box" (n-op n)) 0)
      (.rep (primitive/cast (ptr BoxNode) (hdr n)))))

;; Which tag does this raw type box to?
(defn box-tag-of [(t i64)] (-> i64)
  (if (ty-int? t)
      TAG-INT
      (if (ty-flt? t)
          TAG-DOUBLE
          (if (ty-memptr? t)
              (if (= (ty-memptr-struct t) (ty-struct "JsStringPayload"))
                  TAG-STRING
                  (if (= (ty-memptr-struct t) (ty-struct "JsFunctionPayload"))
                      TAG-FUNCTION
                      TAG-OBJECT))
              ;; Anything else is not a raw representation we can box. Refuse rather than guess a
              ;; tag: a wrong tag is a value that reads back as the wrong type, which nothing
              ;; downstream would catch.
              0))))

(defn box-compute-ty [(t i64)] (-> i64)
  (if (ty-high? t)
      TY-TOP
      (let [tag (box-tag-of t)]
        (if (= tag 0) TY-BOT (ty-dyn tag)))))

(impl NodeOps BoxNode
  (hdr [(self (ptr BoxNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr BoxNode))] (-> (slice u8)) "Box")
  (is-const? [(self (ptr BoxNode))] (-> bool) false)
  (no-const-fold? [(self (ptr BoxNode))] (-> bool) false)
  (is-pinned? [(self (ptr BoxNode))] (-> bool) false)
  (binop-copy [(self (ptr BoxNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)]))
  (compute [(self (ptr BoxNode))]
           (-> i64)
           (let [d (primitive/make-dyn NodeOps self)]
             (if (or (= (.rep self) REP-BOOL) (= (.rep self) REP-NULL) (= (.rep self) REP-UNDEFINED))
                 (ty-dyn (.rep self))
                 (box-compute-ty (n-ty (n-in! d 1))))))
  ;; Simple has no Box. Follow its one-shot mode discipline here: raw producers can be untyped
  ;; during construction (notably Minus before mode settlement). Resolve the representation from
  ;; the input's lattice type once known, unlocking before changing this GVN identity field.
  ;; Explicit representations never change; cancellation remains solely Unbox's rule.
  (idealize [(self (ptr BoxNode))] (-> (Option (dyn NodeOps)))
            (let [d (primitive/make-dyn NodeOps self)
                  tag (box-tag-of (n-ty (n-in! d 1)))]
              (if (and (= (.rep self) 0) (!= tag 0))
                  (do (n-unlock! d) (set! (.rep self) tag) (Some d))
                  (None [(dyn NodeOps)]))))
  (eq-extra [(self (ptr BoxNode)) (other (dyn NodeOps))]
            (-> bool)
            (and (= (n-op other) OP-BOX)
                 (= (.rep self) (box-rep other))))
  (hash-extra [(self (ptr BoxNode))] (-> i64) (+ 197 (.rep self))))

(defn box-make-rep-at [(ctrl (Option (dyn NodeOps)))
                       (v (dyn NodeOps))
                       (rep i64)] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [BoxNode] (alloc/create [BoxNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.rep p) rep)
    (n-init! d OP-BOX)
    (n-add-def! d ctrl)
    (n-add-def! d (Some v))
    (n-set-ty! d (compute p))
    d))

(defn box-make-at [(ctrl (Option (dyn NodeOps))) (v (dyn NodeOps))] (-> (dyn NodeOps))
  (box-make-rep-at ctrl v (box-tag-of (n-ty v))))

(defn box-make [(v (dyn NodeOps))] (-> (dyn NodeOps))
  (box-make-at (None [(dyn NodeOps)]) v))

;; ---------------------------------------------------------------------------
;; UNBOX — a boxed word becomes a raw value of the representation `rep` names
;;
;; UNDEFINED unless the tag is PROVEN. That is what the guard exists to establish, and it is why
;; `unbox-compute-ty` refuses to answer for a polymorphic input rather than assuming.
(defstruct UnboxNode [(hdr NodeHdr) (rep i64)])

(defn unbox-rep [(n (dyn NodeOps))] (-> i64)
  (.rep (primitive/cast (ptr UnboxNode) (hdr n))))

;; An Unbox is semantically justified only by a singleton dynamic tag. Its computed raw type is not
;; proof: a polymorphic dynamic input also computes the representation bottom so analysis can
;; continue until the guard or closed-world call graph sharpens it. Type checking must ask this
;; predicate before admitting the graph to the backend.
(defn unbox-proven? [(n (dyn NodeOps))] (-> bool)
  (if (!= (n-op n) OP-UNBOX)
      false
      (let [t (n-ty (n-in! n 1))
            rep (unbox-rep n)]
        (and (ty-dyn? t)
             (and (not (ty-dyn-high? t))
                  (and (!= (primitive/iand (ty-dyn-tags t) rep) 0)
                       (= (primitive/iand (ty-dyn-tags t) (primitive/ixor TAG-ANY rep)) 0)))))))

;; Typecheck handoff for the currently admitted closed-world subset. Generic JavaScript fallback
;; control has not landed yet, so every live Unbox must have become representation-proven before
;; backend entry. Dead unused JSL bodies do not constrain the compiled program.
(defn live-unboxes-proven? [] (-> bool)
  (let [cnt (arena-node-count)
        (mut i) 1
        (mut proven) true]
    (loop (if (or (> (load i) cnt) (not (load proven)))
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (and (not (n-dead? n))
                                 (and (= (n-op n) OP-UNBOX) (not (unbox-proven? n))))
                            (set! (mut proven) false)
                            0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load proven)))

;; The raw type this unbox produces, given what is known about the boxed word.
(defn unbox-compute-ty [(t i64) (rep i64)] (-> i64)
  (if (ty-high? t)
      TY-TOP
      (if (not (ty-dyn? t))
          ;; Not a dynamic value at all. Nothing to unbox, and inventing a raw type here would let
          ;; an unproven value flow into arithmetic as if it were a number.
          TY-BOT
          (if (= (primitive/iand (ty-dyn-tags t) rep) 0)
              ;; The proven tag set does not even CONTAIN this representation, so this unbox is on a
              ;; path that cannot be taken. TOP says "unreachable", which lets the dead branch fold.
              TY-TOP
              (if (ty-monomorphic? t)
                  ;; Proven: exactly this representation.
                  (if (= rep TAG-BOOL)
                      (ty-bool)
                      (if (= rep TAG-INT)
                          (ty-int-bot)
                          (if (or (= rep TAG-DOUBLE) (= rep REP-NUMBER))
                              (ty-flt-bot)
                              (if (= rep REP-OBJECT)
                                  (raw-object-ty)
                                  (if (= rep REP-FUNCTION)
                                      (raw-function-ty)
                                      (if (= rep REP-STRING) (raw-string-ty) TY-BOT))))))
                  ;; Possible but not proven. The raw bottom of that representation is the honest
                  ;; answer: the unbox is legal on the guarded path, and the guard is what narrows
                  ;; the input so that the branch above fires instead.
                  (if (= rep TAG-BOOL)
                      (ty-bool)
                      (if (= rep TAG-INT)
                          (ty-int-bot)
                          (if (or (= rep TAG-DOUBLE) (= rep REP-NUMBER))
                              (ty-flt-bot)
                              (if (= rep REP-OBJECT)
                                  (raw-object-ty)
                                  (if (= rep REP-FUNCTION)
                                      (raw-function-ty)
                                      (if (= rep REP-STRING) (raw-string-ty) TY-BOT)))))))))))

(impl NodeOps UnboxNode
  (hdr [(self (ptr UnboxNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr UnboxNode))] (-> (slice u8)) "Unbox")
  (is-const? [(self (ptr UnboxNode))] (-> bool) false)
  (no-const-fold? [(self (ptr UnboxNode))] (-> bool) false)
  (is-pinned? [(self (ptr UnboxNode))] (-> bool) false)
  (binop-copy [(self (ptr UnboxNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)]))
  (compute [(self (ptr UnboxNode))]
           (-> i64)
           (unbox-compute-ty (n-ty (n-in! (primitive/make-dyn NodeOps self) 1)) (.rep self)))
  (idealize [(self (ptr UnboxNode))]
            (-> (Option (dyn NodeOps)))
            (unbox-idealize (primitive/make-dyn NodeOps self)))
  (eq-extra [(self (ptr UnboxNode)) (other (dyn NodeOps))]
            (-> bool)
            (if (!= (n-op other) OP-UNBOX)
                false
                (= (.rep self) (.rep (primitive/cast (ptr UnboxNode) (hdr other))))))
  (hash-extra [(self (ptr UnboxNode))] (-> i64) (+ 199 (.rep self))))

;; >>> THE PAIR THAT CANCELS <<<
;;
;; `Unbox(Box(x))` is `x`, when the representations agree. This one peephole is where an unboxed loop
;; body comes from: JSL wraps every result in `%Box` and every operand in `%UnboxInt`, and once
;; inlining has put a Box next to an Unbox they annihilate, leaving raw arithmetic.
;;
;; The representation check is not optional. `Unbox_double(Box_int(x))` is NOT `x` — it is a
;; reinterpretation, and folding it would read an integer's bits as a double.
(defn unbox-idealize [(d (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [v (n-in! d 1)]
    (if (!= (n-op v) OP-BOX)
        (None [(dyn NodeOps)])
        (let [inner (n-in! v 1)
              inner-tag (box-rep v)]
          (if (and (!= inner-tag 0)
                   (or (= inner-tag (unbox-rep d))
                       (and (= (unbox-rep d) REP-NUMBER)
                            (or (= inner-tag TAG-INT) (= inner-tag TAG-DOUBLE)))))
              (if (and (= (unbox-rep d) REP-NUMBER) (= inner-tag TAG-INT))
                  (Some (n-peephole! (to-float-make inner)))
                  (Some inner))
              ;; A Box of one representation unboxed as another. Not a fold — leave it alone and let
              ;; the type system report it.
              (None [(dyn NodeOps)]))))))

(defn unbox-make [(v (dyn NodeOps)) (rep i64)] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [UnboxNode] (alloc/create [UnboxNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.rep p) rep)
    (n-init! d OP-UNBOX)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some v))
    (n-set-ty! d (compute p))
    d))

;; ---------------------------------------------------------------------------
;; TYPETEST — the PREDICATE half of a guard
;;
;; "Does `v` currently carry one of `tags`?" Its answer is a boolean, so it feeds an `If` like any
;; comparison — which is the whole point of D4: a guard is ordinary control flow.
(defstruct TypeTestNode [(hdr NodeHdr) (tags i64)])

(defn typetest-tags [(n (dyn NodeOps))] (-> i64)
  (.tags (primitive/cast (ptr TypeTestNode) (hdr n))))

;; The same shape as a range comparison, on the tag axis instead:
;;
;;   the value's tags are a SUBSET of the test  -> TRUE   (it must pass)
;;   the two sets are DISJOINT                  -> FALSE  (it cannot pass)
;;   otherwise                                  -> BOOL   (genuinely unknown; the branch stays)
;;
;; The first line is where a discharged TypeScript annotation cashes out: once the interprocedural
;; fixpoint has proven a parameter is int-only, `TypeTest(x, INT)` folds TRUE, the `If` folds to one
;; arm, and the check costs nothing.
(defn typetest-compute-ty [(t i64) (tags i64)] (-> i64)
  (if (ty-high? t)
      (ty-bool-high)
      (if (not (ty-dyn? t))
          (ty-bool)
          (let [vt (ty-dyn-tags t)]
            (if (= (primitive/iand vt tags) vt)
                (ty-true)  ; subset: must pass
                (if (= (primitive/iand vt tags) 0)
                    (ty-false)  ; disjoint: cannot pass
                    (ty-bool)))))))

(impl NodeOps TypeTestNode
  (hdr [(self (ptr TypeTestNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr TypeTestNode))] (-> (slice u8)) "TypeTest")
  (is-const? [(self (ptr TypeTestNode))] (-> bool) false)
  (no-const-fold? [(self (ptr TypeTestNode))] (-> bool) false)
  (is-pinned? [(self (ptr TypeTestNode))] (-> bool) false)
  (binop-copy [(self (ptr TypeTestNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)]))
  (compute [(self (ptr TypeTestNode))]
           (-> i64)
           (typetest-compute-ty (n-ty (n-in! (primitive/make-dyn NodeOps self) 1)) (.tags self)))
  (idealize [(self (ptr TypeTestNode))] (-> (Option (dyn NodeOps))) (None [(dyn NodeOps)]))
  (eq-extra [(self (ptr TypeTestNode)) (other (dyn NodeOps))]
            (-> bool)
            (if (!= (n-op other) OP-TYPETEST)
                false
                (= (.tags self) (.tags (primitive/cast (ptr TypeTestNode) (hdr other))))))
  (hash-extra [(self (ptr TypeTestNode))] (-> i64) (+ 211 (.tags self))))

(defn typetest-make [(v (dyn NodeOps)) (tags i64)] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [TypeTestNode] (alloc/create [TypeTestNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.tags p) tags)
    (n-init! d OP-TYPETEST)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some v))
    (n-set-ty! d (compute p))
    d))

;; ---------------------------------------------------------------------------
;; CAST — the VALUE half of a guard  —  port of Simple's `GuardNode`
;;
;; Simple's Guard is the zero/non-zero special case; this is the same node generalised to any
;; lattice point, which is what a TypeScript annotation needs.
;;
;; Inputs: 0 = the control edge on which the assertion holds, 1 = the value.
;;
;; PINNED, exactly as Simple's is: a Cast asserts something true only ON ITS EDGE, so code motion
;; must not float it out of the guarded region. Unpin it and the narrowed value escapes to a path
;; where the narrowing was never established.
(defstruct CastNode [(hdr NodeHdr) (cast-ty i64)])

(defn cast-ty-of [(n (dyn NodeOps))] (-> i64)
  (.cast-ty (primitive/cast (ptr CastNode) (hdr n))))

;; The JOIN of what is known and what is asserted: a Cast can only NARROW.
;;
;; Joining with something incompatible gives a high answer, which says the guarded edge cannot
;; carry this value. Final Simple's GuardNode then preserves its current type when that intersection
;; has no sane answer. That fallback is essential during optimistic SCCP: a branch can become dead,
;; but its Cast must not jump to a dynamic high spelling that is incomparable with the saved
;; pessimistic low bound.
(defn cast-compute-ty [(t i64) (cast i64)] (-> i64)
  (if (ty-high? t) TY-TOP (ty-join t cast)))

(defn cast-compute-node [(d (dyn NodeOps))] (-> i64)
  (let [answer (cast-compute-ty (n-ty (n-in! d 1)) (cast-ty-of d))]
    (if (ty-high? answer)
        (let [old (n-ty d)]
          (if (= old TY-INVALID) answer old))
        answer)))

;; >>> THIS IS HOW A DISCHARGED ANNOTATION DISAPPEARS <<<
;;
;; Simple's rule: fold when the input already `isa` the cast type. The assertion adds nothing, so the
;; Cast becomes its input and the guard's value side costs zero.
;;
;; This is the single most important peephole in the TypeScript story. If it is weakened, every
;; annotation stays as a runtime narrowing forever; if it is loosened — for instance to fire on an
;; unanalysed input — then `ty-isa? ANY t` is true for every `t` and EVERY cast discharges itself,
;; which is the guard mechanism erasing itself.
(defn cast-idealize [(d (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [v (n-in! d 1)
        vt (n-ty v)]
    ;; Refuse on an unanalysed input. This guard is the whole safety of the rule.
    (if (or (ty-high? vt) (= vt TY-INVALID))
        (None [(dyn NodeOps)])
        (if (ty-isa? vt (cast-ty-of d))
            (Some v)
            (None [(dyn NodeOps)])))))

(impl NodeOps CastNode
  (hdr [(self (ptr CastNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr CastNode))] (-> (slice u8)) "Cast")
  (is-const? [(self (ptr CastNode))] (-> bool) false)
  (no-const-fold? [(self (ptr CastNode))] (-> bool) false)
  ;; PINNED: the assertion holds only on this control edge.
  (is-pinned? [(self (ptr CastNode))] (-> bool) true)
  (binop-copy [(self (ptr CastNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)]))
  (compute [(self (ptr CastNode))]
           (-> i64)
           (cast-compute-node (primitive/make-dyn NodeOps self)))
  (idealize [(self (ptr CastNode))]
            (-> (Option (dyn NodeOps)))
            (cast-idealize (primitive/make-dyn NodeOps self)))
  (eq-extra [(self (ptr CastNode)) (other (dyn NodeOps))]
            (-> bool)
            (if (!= (n-op other) OP-CAST)
                false
                (= (.cast-ty self) (.cast-ty (primitive/cast (ptr CastNode) (hdr other))))))
  (hash-extra [(self (ptr CastNode))] (-> i64) (+ 223 (.cast-ty self))))

(defn cast-make [(ctrl (dyn NodeOps)) (v (dyn NodeOps)) (t i64)] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [CastNode] (alloc/create [CastNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.cast-ty p) t)
    (n-init! d OP-CAST)
    (n-add-def! d (Some ctrl))
    (n-add-def! d (Some v))
    (n-set-ty! d (compute p))
    d))

;; ---------------------------------------------------------------------------
;; THE GUARD — one entry point, so nobody assembles half of one
;;
;; `If(TypeTest(v, tags))`, both arms built together, and a `Cast` on the TAKEN edge. There is
;; deliberately no way to build the pieces separately and peephole them one at a time: that is the
;; multi-window trap, and here it would additionally leave a Cast asserting something on an edge
;; that no longer exists.
;;
;; The result carries the narrowed value for the true path and the control for both, so the caller
;; wires the merge.
(defstruct Guard
  [(narrowed (dyn NodeOps))  ; the value, narrowed, valid on the TRUE edge
   (true-ctrl (dyn NodeOps))
   (false-ctrl (dyn NodeOps))])

(defn guard-narrowed [(g Guard)] (-> (dyn NodeOps))
  (.narrowed g))

(defn guard-true [(g Guard)] (-> (dyn NodeOps))
  (.true-ctrl g))

(defn guard-false [(g Guard)] (-> (dyn NodeOps))
  (.false-ctrl g))

(defn guard! [(ctrl (dyn NodeOps)) (v (dyn NodeOps)) (tags i64)] (-> Guard)
  (let [test (typetest-make v tags)
        iff (if-make ctrl test)
        arms (if-arms! iff)
        t (arms-true arms)
        f (arms-false arms)
        (mut g) (primitive/zeroed Guard)]
    (set! (.narrowed (mut g)) (cast-make t v (ty-dyn tags)))
    (set! (.true-ctrl (mut g)) t)
    (set! (.false-ctrl (mut g)) f)
    (load g)))

;; ---------------------------------------------------------------------------
;; BRANCH-LOCAL JAVASCRIPT TRUTHINESS
;;
;; Simple's Scope creates a pinned Guard on each CProj and updates that arm's SSA binding. The
;; frontend is not present yet, but the graph operation belongs here and is independently complete:
;; given an If projection and the value tested by that If, build the value valid on that arm.
(defn truthiness-refine-ty [(t i64) (truthy bool)] (-> i64)
  (if (or (= t TY-INVALID) (ty-high? t))
      TY-TOP
      (if (= t TY-NIL)
          (if truthy TY-TOP TY-NIL)
          (if (ty-int? t)
              (let [lo (ty-int-lo t)
                    hi (ty-int-hi t)]
                (if truthy
                    (if (or (> lo 0) (< hi 0))
                        t
                        (if (and (= lo 0) (= hi 0))
                            TY-TOP
                            (if (= lo 0)
                                (ty-int-range 1 hi)
                                (if (= hi 0) (ty-int-range lo -1) t))))
                    (if (and (<= lo 0) (>= hi 0)) (ty-int-con 0) TY-TOP)))
              (if (ty-dyn? t)
                  (let [tags (ty-dyn-tags t)
                        ;; undefined/null are always false; object/function/symbol always true.
                        keep
                          (if truthy
                              (primitive/iand tags
                                              (primitive/ixor TAG-ANY
                                                              (primitive/ior TAG-UNDEFINED TAG-NULL)))
                              (primitive/iand tags
                                              (primitive/ixor TAG-ANY
                                                              (primitive/ior TAG-OBJECT
                                                                             (primitive/ior TAG-FUNCTION
                                                                                            TAG-SYMBOL)))))]
                    (ty-dyn keep))
                  ;; The float lattice cannot represent {+0,-0,NaN} or its complement, and strings
                  ;; cannot represent empty/non-empty. Preserve those families instead of lying.
                  t)))))

(defn truthiness-refine! [(arm (dyn NodeOps)) (value (dyn NodeOps))] (-> (dyn NodeOps))
  (if (!= (n-op arm) OP-CPROJ)
      (do (panic "truthiness-refine!: control is not a CProj") (unreachable-node))
      (let [iff (n-in! arm 0)]
        (if (!= (n-op iff) OP-IF)
            (do (panic "truthiness-refine!: CProj is not from an If") (unreachable-node))
            (match (if-pred iff)
              (Some [pred]
                    (if (not (n-same? pred value))
                        (do
                          (panic "truthiness-refine!: value is not the If predicate")
                          (unreachable-node))
                        (cast-make arm
                                   value
                                   (truthiness-refine-ty (n-ty value)
                                                         (= (cproj-idx arm) IF-TRUE-IDX)))))
              (None []
                    (do
                      (panic "truthiness-refine!: If has no predicate")
                      (unreachable-node))))))))

;; Recover the original predicate only when this Cast is exactly the true-arm truthiness
;; refinement built above. Phi's zero/null merge uses this structural proof; an arbitrary Cast
;; with a coincidentally nonzero-looking type is not sufficient.
(defn truthiness-cast-source [(cast (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (if (!= (n-op cast) OP-CAST)
      (None [(dyn NodeOps)])
      (let [ctrl (n-in! cast 0)
            value (n-in! cast 1)]
        (if (or (!= (n-op ctrl) OP-CPROJ) (!= (cproj-idx ctrl) IF-TRUE-IDX))
            (None [(dyn NodeOps)])
            (let [iff (n-in! ctrl 0)]
              (if (!= (n-op iff) OP-IF)
                  (None [(dyn NodeOps)])
                  (match (if-pred iff)
                    (Some [pred]
                          (if (and (n-same? pred value)
                                   (= (cast-ty-of cast) (truthiness-refine-ty (n-ty value) true)))
                              (Some value)
                              (None [(dyn NodeOps)])))
                    (None [] (None [(dyn NodeOps)])))))))))
