;; Closures: creation, captured-environment access, and the call path through them.

;;
;; Simple has first-class FUNCTIONS but not closures; JavaScript is closures throughout, so this
;; file has no Simple counterpart to follow and its design is ours.
;;
;; A closure is an object: a function index plus a captured environment. Under the closed-world
;; assumption every closure creation site is visible, so the set of functions a given call site can
;; reach is a finite, computable set rather than "anything callable" — which is what lets
;; `arr.map(f)` inline `f` with no speculation and no deoptimisation path.
;;
;; Capture is by REFERENCE, because JavaScript says so: two closures over the same `let` see each
;; other's writes. A captured binding that is provably never written after capture is lowered to a
;; by-value copy, and that is an optimisation, not the semantics.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S4.
(module aot.node.closure)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(defn closure-make [(ctrl (dyn NodeOps)) (mem (dyn NodeOps)) (fun (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "closure-make" "S4 — src/node/closure.coil") (unreachable-node)))

(defn closure-capture! [(c (dyn NodeOps)) (cell (dyn NodeOps))] (-> i64)
  (do (unimplemented "closure-capture!" "S4 — src/node/closure.coil") 0))

(defn closure-env-load [(c (dyn NodeOps)) (idx i64)] (-> (dyn NodeOps))
  (do (unimplemented "closure-env-load" "S4 — src/node/closure.coil") (unreachable-node)))
