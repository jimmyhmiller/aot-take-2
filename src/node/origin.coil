;; Node origins: the source range a node was built for.

(module aot.node.origin)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use *)
(import "coil.os" :as os)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use [NodeOps])
(import "aot.node.arena" :use *)

;; Construction attribution is a side channel, not an optimization fact. Nested expansions own
;; disjoint node sets; their parent id permits inclusive accounting without double-counting.
;; Simple carries source locations on nodes, but has no JSL expansion provenance. Rewrites and
;; target selection inherit the originating node's context. A shared GVN survivor keeps its first
;; construction owner: these are ownership counts, not a claim of exclusive semantic dependence.
(defstruct NodeOrigin
  [(name (slice u8)) (kind (slice u8)) (parent i64) (lo i64) (hi i64)])

(defstruct NodeOrigins
  [(items (ArrayList NodeOrigin)) (current i64) (booted bool)])

(defn node-origins [] (-> (ptr NodeOrigins))
  (compiler-state [NodeOrigins] (primitive/alloc-static CompilerStateSlot)))

(defn n-origin-reset! [] (-> i64)
  (let [s (node-origins)]
    (if (.booted s)
        (al-clear! (mut (.items s)))
        (set! (.items s) (al-new [NodeOrigin] (compiler-allocator))))
    (set! (.booted s) true)
    (set! (.current s) 0)
    0))

(defn n-origin-enter! [(name (slice u8)) (kind (slice u8)) (lo i64) (hi i64)] (-> i64)
  (let [s (node-origins)
        prior (.current s)]
    (if (not (.booted s)) (n-origin-reset!) 0)
    (push! [NodeOrigin]
           (mut (.items s))
           (NodeOrigin
             :name name
             :kind kind
             :parent prior
             :lo lo
             :hi hi))
    (set! (.current s) (len (.items s)))
    prior))

(defn n-origin-leave! [(prior i64)] (-> i64)
  (do (set! (.current (node-origins)) prior) 0))

(defn n-source-lo [(n (dyn NodeOps))] (-> i64)
  (.source-lo (hdr n)))

(defn n-source-hi [(n (dyn NodeOps))] (-> i64)
  (.source-hi (hdr n)))

(defn n-source-context-lo [] (-> i64)
  (.source-lo (arena)))

(defn n-source-context-hi [] (-> i64)
  (.source-hi (arena)))

(defn n-source-context-set! [(lo i64) (hi i64)] (-> i64)
  (do
    (if (or (< lo -1) (< hi -1) (and (>= lo 0) (< hi lo)))
        (panic "n-source-context-set!: invalid half-open source range")
        0)
    (set! (.source-lo (arena)) lo)
    (set! (.source-hi (arena)) hi)
    0))

(defn n-source-merge-range! [(n (dyn NodeOps)) (lo i64) (hi i64)] (-> i64)
  (if (< lo 0)
      0
      (do
        (if (< (n-source-lo n) 0)
            (do (set! (.source-lo (hdr n)) lo) (set! (.source-hi (hdr n)) hi) 0)
            (do
              (if (< lo (n-source-lo n)) (set! (.source-lo (hdr n)) lo) 0)
              (if (> hi (n-source-hi n)) (set! (.source-hi (hdr n)) hi) 0)))
        0)))

(defn n-source-merge! [(n (dyn NodeOps)) (origin (dyn NodeOps))] (-> i64)
  (n-source-merge-range! n (n-source-lo origin) (n-source-hi origin)))

(defn n-source-copy! [(n (dyn NodeOps)) (origin (dyn NodeOps))] (-> i64)
  (do
    (set! (.origin (hdr n)) (.origin (hdr origin)))
    (set! (.source-lo (hdr n)) (n-source-lo origin))
    (set! (.source-hi (hdr n)) (n-source-hi origin))
    0))
