;; The OP-* constants: a node kind's serialization tag and its case key.

(module aot.node.op)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use *)
(import "coil.os" :as os)

;; ---------------------------------------------------------------------------
;; Opcodes
;;
;; The tag is the serialization key, the `case` dispatch key, and the coarse RTTI used to guard a
;; downcast. `case` keys are ALWAYS these names, never literal numbers: a renumbering must not
;; silently rewire a dispatch table.

;; -- control --
(const OP-START 1)

(const OP-STOP 2)

(const OP-RETURN 3)

(const OP-REGION 4)

(const OP-LOOP 5)

(const OP-IF 6)

(const OP-PROJ 7)

(const OP-CPROJ 8)

(const OP-NEVER 9)

(const OP-XCTRL 10)

(const OP-PHI 11)

;; -- values --
(const OP-CON 20)

(const OP-ADD 21)

(const OP-SUB 22)

(const OP-MUL 23)

(const OP-DIV 24)

(const OP-MINUS 25)

(const OP-AND 26)

(const OP-OR 27)

(const OP-XOR 28)

(const OP-SHL 29)

(const OP-SHR 30)

(const OP-SAR 31)

(const OP-NOT 32)

(const OP-TOFLOAT 33)

(const OP-ROUNDF32 34)

(const OP-EQ 35)

(const OP-NE 36)

(const OP-LT 37)

(const OP-LE 38)

(const OP-ULT 39)

;; -- memory --
(const OP-LOAD 50)

(const OP-STORE 51)

(const OP-NEW 52)

(const OP-MEMMERGE 53)

(const OP-MEMPHI 54)

(const OP-READONLY 55)

;; -- calls --
(const OP-FUN 60)

(const OP-PARM 61)

(const OP-CALL 62)

(const OP-CALLEND 63)

(const OP-FUNPTR 64)

(const OP-ESCAPE 65)

(const OP-FREF 66)

(const OP-EXTERN 67)

;; -- parser helper --
(const OP-SCOPE 70)

;; -- dynamic values: the guard mechanism and the box/unbox pair --
(const OP-BOX 80)

(const OP-UNBOX 81)

(const OP-TYPETEST 82)

(const OP-CAST 83)

;; -- objects and arrays --
(const OP-PROPLOAD 90)

(const OP-PROPSTORE 91)

(const OP-ARRAYLOAD 92)

(const OP-ARRAYSTORE 93)

(const OP-ARRAYLEN 94)

;; -- JS primitives the JSL layer bottoms out on --
(const OP-JSOP 100)

;; -- closures, exceptions, GC --
(const OP-CLOSURE 110)

(const OP-THROW 111)

(const OP-SAFEPOINT 112)

(const OP-BARRIER 113)

;; The runtime heap-state record's address: a host pointer the process entry pins in a register.
(const OP-HEAPSTATE 114)

;; A string literal as immutable data in the object file (aot.node.dynamic).
(const OP-STATICREF 115)

(const OP-TOINT 116)

;; Unit-local metadata identities; their runtime words come from program assembly.
(const OP-KEYREF 117)

(const OP-SHAPEREF 118)

;; -- selected machine graph --
;; Machine families retain their ideal opcode as payload.  These coarse tags make it impossible to
;; mistake a selected node for an ideal node while walking the post-selection graph.
(const OP-MACH-SCALAR 200)

(const OP-MACH-MEM 201)

(const OP-MACH-CFG 202)

(const OP-MACH-CALL 203)

(const OP-MACH-PHI 204)

(const OP-MACH-SPLIT 205)

(const OP-MACH-CALLEE-SAVE 206)
