;; Reusable callable versions, independent of inlining.

;;
;; Final Simple FunNode.copyBody selects a body, allocates shells, remaps edges, removes external
;; callers, and repairs both halves of every call link. CallEndNode.doInline immediately folds
;; that copy into its caller. We use the same copying protocol but retain the entry and Return.
;; This version policy is an extension, not an algorithm supplied by Simple (docs/FUNCTION-VERSIONS.md).
;;
;; An optimized body can only be copied for a subset of its proven entry domain. Capture that
;; domain before surgery, including memory and arguments whose Parms have folded away. Private
;; entries hold those contracts while routing is open, then resume ordinary closed-world Parm
;; typing. Recursive calls initially name the generic function and use the same proof as any call.
(module aot.node.versions)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use *)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "coil.os" :as os)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "aot.util.panic" :use [panic])
(import "aot.type.type" :use *)
(import "aot.node.node" :use *)
(import "aot.node.call" :use *)
(import "aot.node.copy" :use *)
(import "aot.node.control" :use *)

(const VERSION-DEFAULT-LIMIT 2)

(const VERSION-NODE-BUDGET 4096)

(const VERSION-BODY-LIMIT 1024)

(defstruct FunctionVersion
  [(source i64)
   (name (slice u8))
   (entry i64)
   (fidx i64)
   (contract (ArrayList i64))
   (memory i64)
   (declared bool)
   (accepted bool)])

(defstruct VersionPolicy [(name (slice u8)) (limit i64)])

(defstruct FunctionVersions
  [(items (ArrayList FunctionVersion))
   (policies (ArrayList VersionPolicy))
   (nodes i64)
   (changes i64)
   (ready bool)
   (closed bool)
   (pending i64)
   (pending-call i64)
   (pending-size i64)
   (growth-percent i64)
   (growth-limit i64)
   (retained-nodes i64)
   (speculative-call i64)
   (speculative-entry i64)
   (rejected-calls (ArrayList i64))
   (rejected-entries (ArrayList i64))
   (budgeted bool)])

(defn function-versions [] (-> (ptr FunctionVersions))
  (let [s
          (compiler-state [FunctionVersions]
                          (primitive/alloc-static CompilerStateSlot))]
    (if (.ready s)
        0
        (do
          (set! (.items s) (al-new [FunctionVersion] (compiler-allocator)))
          (set! (.policies s) (al-new [VersionPolicy] (compiler-allocator)))
          (set! (.rejected-calls s) (al-new [i64] (compiler-allocator)))
          (set! (.rejected-entries s) (al-new [i64] (compiler-allocator)))
          (set! (.ready s) true)
          0))
    s))

(defn versions-reset! [] (-> i64)
  (let [s (function-versions)]
    (al-for [item (.items s)]
            (let [(mut v) item] (al-free! (mut (.contract (mut v))))))
    (al-clear! (mut (.items s)))
    (al-for [item (.policies s)]
            (let [policy item]
              (alloc/free [u8] (compiler-allocator) (.name policy))))
    (al-clear! (mut (.policies s)))
    (set! (.nodes s) 0)
    (set! (.changes s) 0)
    (set! (.closed s) false)
    (set! (.pending s) 0)
    (set! (.growth-percent s) 1)
    (set! (.growth-limit s) 0)
    (set! (.retained-nodes s) 0)
    (set! (.speculative-call s) 0)
    (set! (.speculative-entry s) 0)
    (al-clear! (mut (.rejected-calls s)))
    (al-clear! (mut (.rejected-entries s)))
    (set! (.budgeted s) false)
    (let [raw (os/getenv c"AOT_VERSION_GROWTH_PERCENT")]
      (if (= (primitive/cast i64 raw) 0)
          0
          (let [text (str/cstr->str raw)]
            (if (> (len text) 3)
                (panic "AOT_VERSION_GROWTH_PERCENT: expected 0..100")
                0)
            (match (str/str-parse-int text)
              (Some [percent]
                    (if (or (< percent 0) (> percent 100))
                        (panic "AOT_VERSION_GROWTH_PERCENT: expected 0..100")
                        (do (set! (.growth-percent s) percent) 0)))
              (None [] (panic "AOT_VERSION_GROWTH_PERCENT: expected 0..100"))))))
    (let [raw (os/getenv c"AOT_FUNCTION_VERSIONS")]
      (if (= (primitive/cast i64 raw) 0)
          0
          (versions-configure! (str/cstr->str raw))))))

(defn versions-configure! [(text (slice u8))] (-> i64)
  (let [(mut entries) (str/str-split (compiler-allocator) text ",")]
    (al-for [entry (load entries)]
            (let [(mut pair) (str/str-split (compiler-allocator) entry "=")]
              (if (!= (len (load pair)) 2)
                  (panic "AOT_FUNCTION_VERSIONS: expected name=count entries separated by commas")
                  0)
              (let [name (str/str-trim (get (load pair) 0))
                    number (str/str-trim (get (load pair) 1))]
                (if (or (= (len name) 0) (> (len number) 4))
                    (panic "AOT_FUNCTION_VERSIONS: empty name or count outside 0..1024")
                    0)
                (match (str/str-parse-int number)
                  (Some [limit]
                        (if (or (< limit 0) (> limit 1024))
                            (panic "AOT_FUNCTION_VERSIONS: count outside 0..1024")
                            (versions-set-limit! name limit)))
                  (None []
                        (panic "AOT_FUNCTION_VERSIONS: count is not an integer"))))
              (al-free! (mut pair))))
    (al-free! (mut entries))
    0))

;; Last matching override wins; '*' sets the default. Configure before optimization.
;; This policy is shared by JS and JSL and does not alter the inlining policy.
(defn versions-set-limit! [(name (slice u8)) (limit i64)] (-> i64)
  (if (< limit 0)
      (panic "versions-set-limit!: negative version limit")
      (let [(mut owned) (str/sb-new (compiler-allocator))]
        (str/sb-push-str! (mut owned) name)
        (let [copied (str/sb-finish! (mut owned))]
          (push! [VersionPolicy]
                 (mut (.policies (function-versions)))
                 (VersionPolicy :name copied :limit limit)))
        0)))

(defn versions-limit [(fun (dyn NodeOps))] (-> i64)
  (let [(mut limit) VERSION-DEFAULT-LIMIT]
    (al-for [item (.policies (function-versions))]
            (let [policy item]
              (if (or (= (.name policy) "*") (= (.name policy) (fun-name fun)))
                  (set! (mut limit) (.limit policy))
                  0)))
    (load limit)))

(defn versions-count [(source i64)] (-> i64)
  (let [(mut count) 0]
    (al-for [item (.items (function-versions))]
            (let [v item]
              (if (and (.accepted v) (= (.source v) source))
                  (set! (mut count) (+ (load count) 1))
                  0)))
    (load count)))

(defn versions-change-count [] (-> i64)
  (.changes (function-versions)))

;; Primary entries are created after global SCCP, so their copied Parm node types still describe
;; the merged source body until the entry's local optimistic solve runs. The admitted contract is
;; the authoritative interface during that gap. Slot zero is memory; argument slots follow.
(defn versions-entry-contract-at [(entry i64) (slot i64)] (-> (Option i64))
  (let [(mut found) (None [i64])]
    (al-for [item (.items (function-versions))]
            (let [v item]
              (if (and (.accepted v) (= (.entry v) entry))
                  (if (= slot 0)
                      (set! (mut found) (Some (.memory v)))
                      (if (and (> slot 0) (<= slot (len (.contract v))))
                          (set! (mut found)
                                (Some (get (.contract v) (- slot 1))))
                          0))
                  0)))
    (load found)))

;; Compile-time construction and retained code growth are different resources. Budget the latter
;; against the live program before the first trial, rather than granting every small program the
;; full construction allowance. A zero percentage disables admission; otherwise tiny entries have
;; one inliner's tiny-body allowance. Charging accepted bodies even if later inlined is conservative.
(defn versions-budget! [] (-> i64)
  (let [s (function-versions)]
    (if (.budgeted s)
        0
        (let [(mut i) 1
              (mut live) 0]
          (loop (if (> (load i) (arena-node-count))
                    (break 0)
                    (do
                      (match (arena-node (load i))
                        (Some [n]
                              (if (n-dead? n)
                                  0
                                  (set! (mut live) (+ (load live) 1))))
                        (None [] 0))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (let [scaled (/ (* (load live) (.growth-percent s)) 100)]
            (set! (.growth-limit s)
                  (if (= (.growth-percent s) 0)
                      0
                      (if (< scaled INLINE-TINY-SIZE) INLINE-TINY-SIZE scaled))))
          (set! (.budgeted s) true)
          0))))

(defn versions-count-named [(name (slice u8))] (-> i64)
  (let [(mut count) 0]
    (al-for [item (.items (function-versions))]
            (let [v item]
              (if (and (.accepted v) (= (.name v) name))
                  (set! (mut count) (+ (load count) 1))
                  0)))
    (load count)))

(defn versions-attempted? [(source i64) (contract (ArrayList i64)) (memory i64)] (-> bool)
  (let [(mut found) false]
    (al-for [item (.items (function-versions))]
            (let [v item
                  (mut same)
                    (and (= (.source v) source)
                         (= (.memory v) memory)
                         (= (len (.contract v)) (len contract)))
                  (mut i) 0]
              (loop (if (or (not (load same)) (>= (load i) (len contract)))
                        (break 0)
                        (do
                          (if (!= (get (.contract v) (load i))
                                  (get contract (load i)))
                              (set! (mut same) false)
                              0)
                          (set! (mut i) (+ (load i) 1))
                          (continue))))
              (if (load same) (set! (mut found) true) 0)))
    (load found)))

;; Finite runtime categories, not constants or descending recursive integer intervals. Preserve
;; the lattice's immutable image identities (especially known callable targets); erasing them
;; would turn a direct call in a private body into arbitrary JavaScript dispatch. Object contents
;; remain memory facts, never entry assumptions.
(defn versions-category [(t i64)] (-> i64)
  (cond (or (= t TY-INVALID) (ty-high? t)) TY-TOP
        (ty-dyn? t)
          (ty-with-identity (ty-dyn (ty-dyn-tags t)) (ty-value-identity t))
        (ty-int? t) (ty-int-bot)
        (ty-flt? t) (ty-flt-bot)
        :else t))

;; A live Parm is the authoritative bound under which its body was optimized. If a constant Parm
;; disappeared, the current caller meet still lies within that bound: removing callers only
;; sharpens it. Unknown entries instead use the declared signature. The memory slot participates
;; in the same capture; a memory-specialized body cannot be reused for a wider memory state.
(defn versions-input-bound [(fun (dyn NodeOps)) (slot i64)] (-> i64)
  (let [parameter
          (if (= slot CALL-MEM)
              (fun-mem-parm fun)
              (fun-parm fun (- slot CALL-ARG0)))]
    (match parameter
      (Some [p] (n-ty p))
      (None []
            (if (fun-unknown-callers? fun)
                (if (= slot CALL-MEM)
                    (ty-mem 1 TY-BOT)
                    (ty-sig-arg (fun-sig fun) (- slot CALL-ARG0)))
                (let [(mut path) 1
                      (mut bound) TY-TOP]
                  (loop (if (>= (load path) (n-nins fun))
                            (break (load bound))
                            (do
                              (match (n-in fun (load path))
                                (Some [c]
                                      (if (and (= (n-op c) OP-CALL)
                                               (not (ty-high? (n-ty c))))
                                          (match (n-in c slot)
                                            (Some [v]
                                                  (if (= (n-ty v) TY-INVALID)
                                                      0
                                                      (set! (mut bound)
                                                            (ty-meet (load bound)
                                                                     (n-ty v)))))
                                            (None []
                                                  (set! (mut bound)
                                                        (ty-mem 1 TY-BOT))))
                                          0))
                                (None [] 0))
                              (set! (mut path) (+ (load path) 1))
                              (continue))))))))))

(defn versions-contract [(c (dyn NodeOps)) (fun (dyn NodeOps))] (-> (ArrayList i64))
  (let [(mut types) (al-new [i64] (compiler-allocator))
        (mut i) 0]
    (loop (if (>= (load i) (call-nargs c))
              (break 0)
              (do
                (push! [i64]
                       (mut types)
                       (ty-join (versions-category (n-ty (call-arg c (load i))))
                                (versions-input-bound fun
                                                      (+ CALL-ARG0 (load i)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load types)))

(defn versions-accepts? [(c (dyn NodeOps)) (contract (ArrayList i64))] (-> bool)
  (let [(mut i) 0
        (mut accepts) (= (call-nargs c) (len contract))]
    (loop (if (or (not (load accepts)) (>= (load i) (len contract)))
              (break 0)
              (let [actual (n-ty (call-arg c (load i)))]
                (if (or (= actual TY-INVALID)
                        (ty-high? actual)
                        (not (ty-isa? actual (get contract (load i)))))
                    (set! (mut accepts) false)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load accepts)))

(defn versions-useful? [(contract (ArrayList i64)) (fun (dyn NodeOps))] (-> bool)
  (let [(mut i) 0
        (mut useful) false]
    (loop (if (>= (load i) (len contract))
              (break 0)
              (do
                (match (fun-parm fun (load i))
                  (Some [p]
                        (let [(mut used) false
                              (mut use) 0
                              (mut path) 1
                              (mut callers) TY-TOP]
                          (loop (if (>= (load use) (n-nouts p))
                                    (break 0)
                                    (do
                                      (match (n-out p (load use))
                                        (Some [_] (set! (mut used) true))
                                        (None [] 0))
                                      (set! (mut use) (+ (load use) 1))
                                      (continue))))
                          (loop (if (>= (load path) (n-nins fun))
                                    (break 0)
                                    (do
                                      (match (n-in fun (load path))
                                        (Some [c]
                                              (if (and (= (n-op c) OP-CALL)
                                                       (not (ty-high? (n-ty c)))
                                                       (< (load i)
                                                          (call-nargs c)))
                                                  (let [t
                                                          (n-ty (call-arg c
                                                                          (load i)))]
                                                    (if (= t TY-INVALID)
                                                        0
                                                        (set! (mut callers)
                                                              (ty-meet (load callers)
                                                                       t))))
                                                  0))
                                        (None [] 0))
                                      (set! (mut path) (+ (load path) 1))
                                      (continue))))
                          ;; Do not clone for unused ABI slots or facts the one shared body will
                          ;; already learn when its caller set closes. Partition only distinct
                          ;; runtime categories reaching an actually used parameter.
                          (let [shared
                                  (versions-category (if (fun-unknown-callers? fun)
                                                         (versions-input-bound fun
                                                                               (+ CALL-ARG0
                                                                                  (load i)))
                                                         (load callers)))
                                wanted
                                  (versions-category (get contract (load i)))]
                            (if (and (load used)
                                     (not (ty-high? wanted))
                                     (!= wanted shared)
                                     (ty-isa? wanted shared))
                                (set! (mut useful) true)
                                0))))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load useful)))

(defn versions-route! [(c (dyn NodeOps))
                       (source (dyn NodeOps))
                       (entry (dyn NodeOps))
                       (fidx i64)] (-> i64)
  (let [fp (funptr-make entry fidx)]
    (if (!= (primitive/cast i64 (os/getenv c"AOT_VERSION_TRACE")) 0)
        (do
          (println "version: Call #{} {s} -> #{} ({s})"
                   (n-nid c)
                   (fun-name source)
                   (n-nid entry)
                   (fun-code-name entry))
          0)
        0)
    (call-unlink! c source)
    (n-set-def! c (- (n-nins c) 1) (Some fp))
    (call-link! c entry)
    (code-add! c)
    (code-add-outputs! c)
    (set! (.changes (function-versions)) (+ (.changes (function-versions)) 1))
    (fun-size-epoch-bump!)
    (invalidate-cfg!)
    1))

;; Reuse must preserve the caller's already-proven full continuation state, as well as the
;; entry's parameter assumptions. Independently optimized copies can have different precision.
(defn versions-result-fits? [(end (dyn NodeOps)) (entry (dyn NodeOps))] (-> bool)
  (match (fun-ret entry)
    (Some [ret]
          (let [state (n-ty ret)
                old (n-ty end)]
            (and (!= state TY-INVALID)
                 (!= old TY-INVALID)
                 (ty-isa? (cend--state-with-declared-ret state
                                                         (ty-sig-ret (fun-sig entry)))
                          old))))
    (None [] false)))

(defn versions-memory-fits? [(c (dyn NodeOps)) (bound i64)] (-> bool)
  (match (n-in c CALL-MEM)
    (Some [memory]
          (and (!= (n-ty memory) TY-INVALID)
               (not (ty-high? (n-ty memory)))
               (ty-isa? (n-ty memory) bound)))
    (None [] (= bound (ty-mem 1 TY-BOT)))))

(defn versions-reuse-count [(source (dyn NodeOps))
                            (entry (dyn NodeOps))
                            (contract (ArrayList i64))
                            (memory i64)] (-> i64)
  (let [(mut path) 1
        (mut count) 0]
    (loop (if (>= (load path) (n-nins source))
              (break (load count))
              (do
                (match (n-in source (load path))
                  (Some [c]
                        (if (and (= (n-op c) OP-CALL)
                                 (not (ty-high? (n-ty c)))
                                 (versions-accepts? c contract)
                                 (versions-memory-fits? c memory)
                                 (match (call-cend c)
                                   (Some [end]
                                         (versions-result-fits? end entry))
                                   (None [] false)))
                            (set! (mut count) (+ (load count) 1))
                            0))
                  (None [] 0))
                (set! (mut path) (+ (load path) 1))
                (continue))))))

(defn versions-create! [(pending-call i64)
                        (source (dyn NodeOps))
                        (contract (ArrayList i64))] (-> i64)
  (let [before (arena-node-count)
        fidx (next-inline-fidx!)
        memory (versions-input-bound source CALL-MEM)
        fresh (fun-copy-version-body! source fidx)
        src (primitive/cast (ptr FunNode) (hdr source))
        dst (primitive/cast (ptr FunNode) (hdr fresh))]
    (let [(mut symbol) (str/sb-new (compiler-allocator))]
      (str/sb-push-str! (mut symbol) ".aot.version.")
      (str/sb-push-i64! (mut symbol) fidx)
      (set! (.code-name dst) (str/sb-finish! (mut symbol))))
    (set! (.version-root src) (n-nid source))
    (set! (.version-root dst) (n-nid source))
    (set! (.version-entry dst) true)
    (set! (.version-open dst) true)
    ;; Use the existing unknown-caller control hook for the unpublished trial. It is removed
    ;; before publishing or discarding the entry; no new executable control-node semantics.
    (fun-add-unknown-callers! fresh (start-make TY-BOT))
    (match (fun-mem-parm fresh)
      (Some [p]
            (do
              (set! (.declared (primitive/cast (ptr ParmNode) (hdr p))) memory)
              (code-add! p)
              0))
      (None [] 0))
    (let [(mut i) 0]
      (loop (if (>= (load i) (len contract))
                (break 0)
                (do
                  (match (fun-parm fresh (load i))
                    (Some [p]
                          (do
                            (set! (.declared (primitive/cast (ptr ParmNode)
                                                             (hdr p)))
                                  (get contract (load i)))
                            (code-add! p)
                            0))
                    (None [] 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (match (fun-ret fresh)
      (Some [ret] (n-keep! ret))
      (None [] (panic "versions-create!: copied function has no Return")))
    ;; Register before any optimizer visit: recursion can now find this entry without cloning it.
    (push! [FunctionVersion]
           (mut (.items (function-versions)))
           (FunctionVersion
             :source (n-nid source)
             :name (fun-name source)
             :entry (n-nid fresh)
             :fidx fidx
             :contract contract
             :memory memory
             :declared false
             :accepted false))
    (set! (.nodes (function-versions))
          (+ (.nodes (function-versions)) (- (arena-node-count) before)))
    (set! (.pending (function-versions)) (len (.items (function-versions))))
    (set! (.pending-call (function-versions)) pending-call)
    (set! (.pending-size (function-versions)) (fun-live-body-size source))
    (code-add! fresh)
    (code-add-outputs! fresh)
    1))

;; M5 chooses entry contracts from the global analysis before local optimization. Unlike the
;; legacy late trial, a primary entry is an interface the local pipeline has committed to build,
;; not a speculative copy whose already-optimized size must justify itself. Construction and
;; per-function count limits still bound the number of bodies, and every routed site still proves
;; argument and memory containment through the ordinary version predicates above.
(defn versions-create-primary! [(c (dyn NodeOps))
                                (source (dyn NodeOps))
                                (contract (ArrayList i64))] (-> i64)
  (do
    (if (!= (primitive/cast i64 (os/getenv c"AOT_VERSION_TRACE")) 0)
        (let [(mut i) 0]
          (print "version: primary {s} contract" (fun-name source))
          (loop (if (>= (load i) (len contract))
                    (break 0)
                    (do
                      (print " {s}" (ty-text (get contract (load i))))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (println " memory {s}" (ty-text (versions-input-bound source CALL-MEM)))
          0)
        0)
    (versions-create! (n-nid c) source contract)
    (let [s (function-versions)
          index (- (len (.items s)) 1)
          v (get (.items s) index)]
      (set! (mut (.items s))
            index
            (FunctionVersion
              :source (.source v)
              :name (.name v)
              :entry (.entry v)
              :fidx (.fidx v)
              :contract (.contract v)
              :memory (.memory v)
              :declared (.declared v)
              :accepted true))
      (set! (.pending s) 0)
      (match (arena-node (.entry v))
        (Some [entry] (versions-route! c source entry (.fidx v)))
        (None [] (panic "versions-create-primary!: copied entry disappeared"))))))

;; A JSL specialization rule is a finite contract the checked source itself declares useful. M5
;; may need that interface before any one call site has converged enough to select it (a loop or
;; recursive result can depend on the interface's return). Create the ordinary copied entry without
;; routing a call. It remains subject to the same per-function and construction budgets, and later
;; routing still requires the usual containment proof. A successful creation takes ownership of
;; `contract`; the caller retains it when this returns zero.
(defn versions-create-primary-unrouted! [(source (dyn NodeOps))
                                         (contract (ArrayList i64))] (-> i64)
  (let [memory (versions-input-bound source CALL-MEM)
        reject
          (or (>= (versions-count (n-nid source)) (versions-limit source))
              (>= (fun-live-body-size source) VERSION-BODY-LIMIT)
              (> (+ (.nodes (function-versions))
                    (+ (fun-live-body-size source) 1))
                 VERSION-NODE-BUDGET)
              (versions-attempted? (n-nid source) contract memory)
              (not (versions-useful? contract source)))]
    (if reject
        0
        (do
          (if (!= (primitive/cast i64 (os/getenv c"AOT_VERSION_TRACE")) 0)
              (let [(mut i) 0]
                (print "version: declared {s} contract" (fun-name source))
                (loop (if (>= (load i) (len contract))
                          (break 0)
                          (do
                            (print " {s}"
                                   (ty-text (get contract (load i))))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (println " memory {s}" (ty-text memory))
                0)
              0)
          (versions-create! 0 source contract)
          (let [s (function-versions)
                index (- (len (.items s)) 1)
                v (get (.items s) index)]
            (set! (mut (.items s))
                  index
                  (FunctionVersion
                    :source (.source v)
                    :name (.name v)
                    :entry (.entry v)
                    :fidx (.fidx v)
                    :contract (.contract v)
                    :memory (.memory v)
                    :declared true
                    :accepted true))
            (set! (.pending s) 0)
            1)))))

(defn versions-contract-equal? [(lhs (ArrayList i64))
                                (rhs (ArrayList i64))] (-> bool)
  (let [(mut same) (= (len lhs) (len rhs))
        (mut i) 0]
    (loop (if (or (not (load same)) (>= (load i) (len lhs)))
              (break 0)
              (do
                (if (!= (get lhs (load i)) (get rhs (load i)))
                    (set! (mut same) false)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load same)))

(defn versions-route-primary-reuse! [(c (dyn NodeOps))
                                     (source (dyn NodeOps))
                                     (contract (ArrayList i64))
                                     (memory i64)] (-> i64)
  (let [(mut routed) 0]
    (al-for [item (.items (function-versions))]
            (let [v item]
              (if (and (= (load routed) 0)
                       (.accepted v)
                       (= (.source v) (n-nid source))
                       (= (.memory v) memory)
                       (versions-contract-equal? (.contract v) contract)
                       (versions-accepts? c (.contract v))
                       (versions-memory-fits? c (.memory v)))
                  (match (arena-node (.entry v))
                    (Some [entry]
                          ;; Primary entries have not run their local optimizer yet. Their result
                          ;; is therefore not an admission predicate: callers retain the frozen
                          ;; global CallEnd contract until M6 publishes the finished summary.
                          (if (n-dead? entry)
                              0
                              (set! (mut routed)
                                    (versions-route! c source entry (.fidx v)))))
                    (None [] 0))
                  0)))
    (load routed)))

(defn versions--speculation-rejected? [(call-id i64) (entry-id i64)] (-> bool)
  (let [s (function-versions)
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) (len (.rejected-calls s))))
              (break 0)
              (do
                (if (and (= (get (.rejected-calls s) (load i)) call-id)
                         (= (get (.rejected-entries s) (load i)) entry-id))
                    (set! (mut found) true)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

(defn versions--contract-compatible? [(c (dyn NodeOps))
                                       (contract (ArrayList i64))] (-> bool)
  (let [(mut i) 0
        (mut compatible) (= (call-nargs c) (len contract))]
    (loop (if (or (not (load compatible)) (>= (load i) (len contract)))
              (break 0)
              (let [actual (n-ty (call-arg c (load i)))
                    overlap
                      (if (= actual TY-INVALID)
                          TY-TOP
                          (ty-join actual (get contract (load i))))]
                (if (or (= actual TY-INVALID) (ty-high? overlap))
                    (set! (mut compatible) false)
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load compatible)))

(defn versions--entry-index [(entry-id i64)] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) (len (.items (function-versions))))
                  (>= (load found) 0))
              (break 0)
              (let [v (get (.items (function-versions)) (load i))]
                (if (= (.entry v) entry-id)
                    (set! (mut found) (load i))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load found)))

;; Settle the single hypothesis installed after the preceding complete local solve. Success merely
;; confirms ordinary containment. Failure restores the generic source edge and records this
;; (call, contract) pair so a later solve may try the next declared contract without oscillating.
(defn versions--settle-speculation! [] (-> i64)
  (let [s (function-versions)]
    (if (= (.speculative-call s) 0)
        0
        (let [call-id (.speculative-call s)
              entry-id (.speculative-entry s)
              index (versions--entry-index entry-id)]
          (if (< index 0)
              (panic "versions: speculative entry vanished")
              0)
          (let [v (get (.items s) index)
                c
                  (match (arena-node call-id)
                    (Some [node] node)
                    (None [] (unreachable-node)))
                entry
                  (match (arena-node entry-id)
                    (Some [node] node)
                    (None [] (unreachable-node)))]
            (set! (.speculative-call s) 0)
            (set! (.speculative-entry s) 0)
            (if (and (not (n-dead? c))
                     (call-linked? c entry)
                     (versions-accepts? c (.contract v)))
                (do
                  (match (call-cend c)
                    (Some [end] (callend-clear-never-inline! end))
                    (None [] 0))
                  (if (!= (primitive/cast i64 (os/getenv c"AOT_VERSION_TRACE")) 0)
                      (do
                        (println "version: confirmed Call #{} -> #{} ({s})"
                                 call-id
                                 entry-id
                                 (fun-code-name entry))
                        0)
                      0)
                  0)
                (do
                  (push! [i64] (mut (.rejected-calls s)) call-id)
                  (push! [i64] (mut (.rejected-entries s)) entry-id)
                  (if (and (not (n-dead? c)) (call-linked? c entry))
                      (match (arena-node (.source v))
                        (Some [source]
                              (let [fidx (arena-function-fidx source)]
                                (if (< fidx 0)
                                    (panic "versions: source has no function index")
                                    0)
                                (call-unlink! c entry)
                                (n-set-def! c
                                            (- (n-nins c) 1)
                                            (Some (funptr-make source fidx)))
                                (call-link! c source)
                                ;; The hold belongs to the provisional route, not to the call
                                ;; site. A rejected hypothesis restores the generic call's
                                ;; ordinary inline policy just as a confirmed one does.
                                (match (call-cend c)
                                  (Some [end] (callend-clear-never-inline! end))
                                  (None [] 0))
                                (code-add! c)
                                (code-add-outputs! c)
                                (set! (.changes s) (+ (.changes s) 1))
                                (fun-size-epoch-bump!)
                                (invalidate-cfg!)
                                (if (!= (primitive/cast i64
                                                         (os/getenv c"AOT_VERSION_TRACE"))
                                       0)
                                    (do
                                      (println "version: rejected Call #{} -> #{} ({s})"
                                               call-id
                                               entry-id
                                               (fun-code-name entry))
                                      0)
                                    0)
                                1))
                        (None [] (panic "versions: speculative source vanished")))
                      0))))))))

(defn versions--speculate-round! [] (-> i64)
  (let [s (function-versions)
        limit (arena-node-count)
        (mut nid) 1
        (mut changed) 0]
    (loop (if (or (> (load nid) limit) (> (load changed) 0))
              (break (load changed))
              (do
                (if (code-work-scope-accepts? (load nid))
                    (match (arena-node (load nid))
                      (Some [end]
                            (if (and (= (n-op end) OP-CALLEND)
                                     (not (n-dead? end))
                                     (not (cend-folding? end))
                                     (> (n-nins end) 0))
                                (let [c (cend-call end)
                                      ft (n-ty (call-fptr c))]
                                  (if (and (ty-funptr? ft)
                                           (ty-funptr-single? ft))
                                      (match (arena-function (ty-funptr-the-fidx ft))
                                        (Some [source]
                                              (if (and (not (fun-version-entry? source))
                                                       (call-linked? c source))
                                                  (let [(mut found) false]
                                                    (al-for [item (.items s)]
                                                            (let [v item]
                                                              (if (and (not (load found))
                                                                       (.accepted v)
                                                                       (.declared v)
                                                                       (= (.source v)
                                                                          (n-nid source))
                                                                       (versions-memory-fits?
                                                                         c
                                                                         (.memory v))
                                                                       (not (versions-accepts?
                                                                              c
                                                                              (.contract v)))
                                                                       (versions--contract-compatible?
                                                                         c
                                                                         (.contract v))
                                                                       (not (versions--speculation-rejected?
                                                                              (n-nid c)
                                                                              (.entry v))))
                                                                  (match (arena-node (.entry v))
                                                                    (Some [target]
                                                                          (if (n-dead? target)
                                                                              0
                                                                              (do
                                                                                (versions-route!
                                                                                  c
                                                                                  source
                                                                                  target
                                                                                  (.fidx v))
                                                                                (callend-set-never-inline!
                                                                                  end)
                                                                                (set! (.speculative-call s)
                                                                                      (n-nid c))
                                                                                (set! (.speculative-entry s)
                                                                                      (.entry v))
                                                                                (set! (mut found) true)
                                                                                (set! (mut changed) 1)
                                                                                (if (!= (primitive/cast
                                                                                          i64
                                                                                          (os/getenv
                                                                                            c"AOT_VERSION_TRACE"))
                                                                                        0)
                                                                                    (do
                                                                                      (println "version: hypothesize Call #{} {s} -> #{} ({s})"
                                                                                               (n-nid c)
                                                                                               (fun-name source)
                                                                                               (n-nid target)
                                                                                               (fun-code-name target))
                                                                                      0)
                                                                                    0))))
                                                                    (None [] 0))
                                                                  0))))
                                                  0))
                                        (None [] 0))
                                      0))
                                0))
                      (None [] 0))
                    0)
                (set! (mut nid) (+ (load nid) 1))
                (continue))))))

;; A scoped local pass can expose evidence that global SCCP could not see, especially after a JSL
;; arithmetic rule folds inside a recursive body. Admission remains closed: this operation creates
;; no body and accepts no broader contract. It only retargets a surviving direct call to the exact
;; primary entry that was already admitted from whole-program evidence.
(defn versions-reroute-closed-round! [] (-> i64)
  (if (not (and (.closed (function-versions)) (code-work-scope-active?)))
      0
      (let [settled (versions--settle-speculation!)]
        (if (> settled 0)
            settled
            (let [limit (arena-node-count)
                  (mut nid) 1
                  (mut changed) 0]
              (loop (if (or (> (load nid) limit) (> (load changed) 0))
                  (break (load changed))
                  (do
                    (if (code-work-scope-accepts? (load nid))
                        (match (arena-node (load nid))
                          (Some [end]
                                (if (and (= (n-op end) OP-CALLEND)
                                         (not (n-dead? end))
                                         (not (cend-folding? end))
                                         (> (n-nins end) 0))
                                    (let [c (cend-call end)
                                          ft (n-ty (call-fptr c))]
                                      (if (and (ty-funptr? ft)
                                               (ty-funptr-single? ft))
                                          (match (arena-function
                                                   (ty-funptr-the-fidx ft))
                                            (Some [current]
                                                  (let [root-id
                                                          (if (fun-version-entry? current)
                                                              (fun-version-root current)
                                                              (n-nid current))]
                                                    (match (arena-node root-id)
                                                      (Some [source]
                                                            (let [(mut contract)
                                                                    (versions-contract c source)
                                                                  memory
                                                                    (versions-input-bound
                                                                      source
                                                                      CALL-MEM)
                                                                  (mut found) false]
                                                              (al-for [item
                                                                       (.items
                                                                         (function-versions))]
                                                                      (let [v item]
                                                                        (if (and (not (load found))
                                                                                 (.accepted v)
                                                                                 (= (.source v)
                                                                                    root-id)
                                                                                 (= (.memory v)
                                                                                    memory)
                                                                                 (versions-contract-equal?
                                                                                   (.contract v)
                                                                                   (load contract))
                                                                                 (!= (.entry v)
                                                                                     (n-nid current)))
                                                                            (match (arena-node
                                                                                     (.entry v))
                                                                              (Some [target]
                                                                                    (if (or (n-dead?
                                                                                              target)
                                                                                            (not (call-linked?
                                                                                                   c
                                                                                                   current)))
                                                                                        0
                                                                                        (do
                                                                                          (call-unlink!
                                                                                            c
                                                                                            current)
                                                                                          (n-set-def!
                                                                                            c
                                                                                            (- (n-nins c)
                                                                                               1)
                                                                                            (Some
                                                                                              (funptr-make
                                                                                                target
                                                                                                (.fidx v))))
                                                                                          (call-link! c
                                                                                                      target)
                                                                                          (if (.declared v)
                                                                                              0
                                                                                              (callend-set-never-inline!
                                                                                                end))
                                                                                          (if (!= (primitive/cast
                                                                                                    i64
                                                                                                    (os/getenv
                                                                                                      c"AOT_VERSION_TRACE"))
                                                                                                  0)
                                                                                              (do
                                                                                                (println
                                                                                                  "version: local Call #{} {s} -> #{} ({s})"
                                                                                                  (n-nid c)
                                                                                                  (fun-name source)
                                                                                                  (n-nid target)
                                                                                                  (fun-code-name
                                                                                                    target))
                                                                                                0)
                                                                                              0)
                                                                                          (code-add! c)
                                                                                          (code-add-outputs!
                                                                                            c)
                                                                                          ;; A failed hypothesis was
                                                                                          ;; evaluated under the prior
                                                                                          ;; recursive edge set. An
                                                                                          ;; exact reroute changes that
                                                                                          ;; equation, so it may be
                                                                                          ;; sound on the next solve.
                                                                                          (al-clear!
                                                                                            (mut (.rejected-calls
                                                                                                   (function-versions))))
                                                                                          (al-clear!
                                                                                            (mut (.rejected-entries
                                                                                                   (function-versions))))
                                                                                          (set! (mut found)
                                                                                                true)
                                                                                          (set! (mut changed)
                                                                                                1)
                                                                                          (set! (.changes
                                                                                                  (function-versions))
                                                                                                (+ (.changes
                                                                                                     (function-versions))
                                                                                                   1)))))
                                                                              (None [] 0))
                                                                            0)))
                                                              (al-free! (mut contract))))
                                                      (None [] 0))))
                                            (None [] 0))
                                          0))
                                    0))
                          (None [] 0))
                        0)
                    (set! (mut nid) (+ (load nid) 1))
                    (continue))))
              (if (> (load changed) 0)
                  (load changed)
                  (versions--speculate-round!)))))))

;; Snapshot the analysed CallEnds: creating an entry appends a complete copied body to the arena,
;; and those new internal sites are handled when their own component is optimized. One pass over
;; the original sites is sufficient because a newly created contract is immediately reusable by
;; every later compatible caller in the snapshot.
(defn versions-select-primary-round! [] (-> i64)
  (let [limit (arena-node-count)
        (mut nid) 1
        (mut changed) 0]
    (versions-budget!)
    (loop (if (> (load nid) limit)
              (break 0)
              (do
                (match (arena-node (load nid))
                  (Some [end]
                        (if (and (= (n-op end) OP-CALLEND)
                                 (not (n-dead? end))
                                 (not (cend-folding? end))
                                 (= (n-nins end) 2))
                            (match (return-fun (n-in! end 1))
                              (Some [source]
                                    (let [c (cend-call end)]
                                      (if (or (fun-version-entry? source)
                                              (and (> (fun-version-root source) 0)
                                                   (!= (fun-version-root source)
                                                       (n-nid source)))
                                              (not (call-linked? c source))
                                              (ty-high? (n-ty c))
                                              (!= (call-nargs c)
                                                  (ty-sig-nargs (fun-sig source)))
                                              (not (ty-funptr-single?
                                                     (n-ty (call-fptr c)))))
                                          0
                                          (let [(mut contract) (versions-contract c source)
                                                memory
                                                  (versions-input-bound source CALL-MEM)
                                                reused
                                                  (versions-route-primary-reuse!
                                                    c
                                                    source
                                                    (load contract)
                                                    memory)]
                                            (if (> reused 0)
                                                (do
                                                  (al-free! (mut contract))
                                                  (set! (mut changed)
                                                        (+ (load changed) reused)))
                                                (if (or (>= (versions-count (n-nid source))
                                                               (versions-limit source))
                                                        (>= (fun-live-body-size source)
                                                            VERSION-BODY-LIMIT)
                                                        (> (+ (.nodes (function-versions))
                                                              (+ (fun-live-body-size source) 1))
                                                           VERSION-NODE-BUDGET)
                                                        (not (versions-accepts?
                                                               c
                                                               (load contract)))
                                                        (versions-attempted?
                                                          (n-nid source)
                                                          (load contract)
                                                          memory)
                                                        (not (versions-useful?
                                                               (load contract)
                                                               source)))
                                                    (al-free! (mut contract))
                                                    (set! (mut changed)
                                                          (+ (load changed)
                                                             (versions-create-primary!
                                                               c
                                                               source
                                                               (load contract))))))))))
                              (None [] 0))
                            0))
                  (None [] 0))
                (set! (mut nid) (+ (load nid) 1))
                (continue))))
    (load changed)))

;; Standalone entry point for graph tests and clients which need only one already-analysed layer.
;; The production pipeline calls the round form to a fixed point and closes exactly once.
(defn versions-select-primary! [] (-> i64)
  (let [changed (versions-select-primary-round!)]
    (versions-close-admission!)
    changed))

;; Clean a trial before publishing its entry. Until this point no caller can fold using its
;; result, so an unprofitable body can be discarded without undoing any caller optimization.
(defn versions-finish-trial! [] (-> i64)
  (let [s (function-versions)]
    (if (= (.pending s) 0)
        0
        (let [index (- (.pending s) 1)
              v (get (.items s) index)
              entry
                (match (arena-node (.entry v))
                  (Some [f] f)
                  (None [] (unreachable-node)))
              source
                (match (arena-node (.source v))
                  (Some [f] f)
                  (None [] (unreachable-node)))
              c
                (match (arena-node (.pending-call s))
                  (Some [n] n)
                  (None [] (unreachable-node)))
              ret
                (match (fun-ret entry)
                  (Some [r] r)
                  (None [] (unreachable-node)))
              size (fun-live-body-size entry)
              source-result (ty-sig-ret (fun-sig source))
              result (ty-sig-ret (fun-sig entry))
              reuse
                (versions-reuse-count source entry (.contract v) (.memory v))
              profitable
                (or (and (>= reuse 2) (<= (* size 2) (.pending-size s)))
                    (and (<= size INLINE-MAX-SIZE)
                         (!= source-result result)
                         (ty-isa? result source-result)))
              end (call-cend c)
              acceptable
                (and profitable
                     (<= (+ (.retained-nodes s) size) (.growth-limit s))
                     (not (n-dead? c))
                     (call-linked? c source)
                     (versions-accepts? c (.contract v))
                     (versions-memory-fits? c (.memory v))
                     (match end
                       (Some [e] (versions-result-fits? e entry))
                       (None [] false)))]
          (set! (.pending s) 0)
          (fun-drop-unknown-callers! entry)
          (if acceptable
              (do
                (if (!= (primitive/cast i64 (os/getenv c"AOT_VERSION_TRACE")) 0)
                    (do
                      (println "version: keep {s}, body {} -> {} nodes, result {s} -> {s}"
                               (fun-name source)
                               (.pending-size s)
                               size
                               (ty-text source-result)
                               (ty-text result))
                      0)
                    0)
                (set! (mut (.items s))
                      index
                      (FunctionVersion
                        :source (.source v)
                        :name (.name v)
                        :entry (.entry v)
                        :fidx (.fidx v)
                        :contract (.contract v)
                        :memory (.memory v)
                        :declared (.declared v)
                        :accepted true))
                (fun-set-approx-size! entry size)
                (set! (.retained-nodes s) (+ (.retained-nodes s) size))
                (versions-route! c source entry (.fidx v)))
              (do
                (if (!= (primitive/cast i64 (os/getenv c"AOT_VERSION_TRACE")) 0)
                    (do
                      (println "version: discard {s}, body {} -> {} nodes"
                               (fun-name source)
                               (.pending-size s)
                               size)
                      0)
                    0)
                (n-unkill! ret)
                (code-add! entry)
                (code-add-outputs! entry)
                1))))))

(defn versions-try! [(end (dyn NodeOps))] (-> i64)
  (versions-budget!)
  (if (or (.closed (function-versions))
          (> (.pending (function-versions)) 0)
          (cend-folding? end)
          (!= (n-nins end) 2))
      0
      (match (return-fun (n-in! end 1))
        (None [] 0)
        (Some [source]
              (let [c (cend-call end)]
                (if (or (fun-version-entry? source)
                        (and (> (fun-version-root source) 0)
                             (!= (fun-version-root source) (n-nid source)))
                        (not (call-linked? c source))
                        (ty-high? (n-ty c))
                        (!= (call-nargs c) (ty-sig-nargs (fun-sig source)))
                        (not (ty-funptr-single? (n-ty (call-fptr c)))))
                    0
                    (let [(mut reused) 0]
                      (al-for [item (.items (function-versions))]
                              (let [v item]
                                (if (and (.accepted v)
                                         (= (load reused) 0)
                                         (= (.source v) (n-nid source))
                                         (versions-accepts? c (.contract v))
                                         (versions-memory-fits? c (.memory v)))
                                    (match (arena-node (.entry v))
                                      (Some [entry]
                                            (if (or (n-dead? entry)
                                                    (fun-folding? entry)
                                                    (not (versions-result-fits? end
                                                                                entry)))
                                                0
                                                (set! (mut reused)
                                                      (versions-route! c
                                                                       source
                                                                       entry
                                                                       (.fidx v)))))
                                      (None [] 0))
                                    0)))
                      (if (> (load reused) 0)
                          (load reused)
                          (if (or (>= (versions-count (n-nid source))
                                      (versions-limit source))
                                  ;; The initial unknown-caller hook itself defers inlining. Do not
                                  ;; mistake that temporary barrier for an out-of-line boundary.
                                  (and (not (fun-no-inline? source))
                                       (< (fun-live-body-size source)
                                          INLINE-MAX-SIZE)
                                       (not (fun-self-recursive? source)))
                                  (> (callend-inline-candidate end) 0)
                                  (not (versions-result-fits? end source))
                                  (not (versions-memory-fits? c
                                                              (versions-input-bound source
                                                                                    CALL-MEM)))
                                  (>= (fun-live-body-size source)
                                      VERSION-BODY-LIMIT)
                                  (> (+ (.nodes (function-versions))
                                        (+ (fun-live-body-size source) 1))
                                     VERSION-NODE-BUDGET))
                              0
                              (let [(mut contract) (versions-contract c source)]
                                (if (and (versions-accepts? c (load contract))
                                         (not (versions-attempted? (n-nid source)
                                                                   (load contract)
                                                                   (versions-input-bound source
                                                                                         CALL-MEM)))
                                         (versions-useful? (load contract)
                                                           source))
                                    (versions-create! (n-nid c)
                                                      source
                                                      (load contract))
                                    (do (al-free! (mut contract)) 0))))))))))))

;; One rewrite per drained worklist. All argument proofs are re-read after ordinary cleanup.
(defn versions-admit-round! [] (-> i64)
  (if (.closed (function-versions))
      0
      (if (> (.pending (function-versions)) 0)
          (versions-finish-trial!)
          (let [limit (arena-node-count)
                (mut i) 1
                (mut changed) 0]
            (loop (if (or (> (load i) limit) (> (load changed) 0))
                      (break (load changed))
                      (do
                        (match (arena-node (load i))
                          (Some [n]
                                (if (and (not (n-dead? n))
                                         (= (n-op n) OP-CALLEND)
                                         (!= (n-pesi-ty n) TY-INVALID))
                                    (set! (mut changed) (versions-try! n))
                                    0))
                          (None [] 0))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))))))

;; Once admission finishes, private entries can sharpen below their admission contracts. Their
;; closed caller sets now use exactly the normal Fun/Parm rules, including memory propagation.
(defn versions-close-admission! [] (-> i64)
  (let [(mut count) 0]
    (if (> (.pending (function-versions)) 0)
        (panic "versions-close-admission!: specialization trial has not finished")
        0)
    (set! (.closed (function-versions)) true)
    (al-for [item (.items (function-versions))]
            (let [v item]
              (if (not (.accepted v))
                  0
                  (match (arena-node (.entry v))
                    (Some [entry]
                          (if (or (n-dead? entry) (fun-folding? entry))
                              0
                              (do
                                ;; No further routing can widen this caller set. The entry now becomes an
                                ;; ordinary Fun/Parm merge and may sharpen below its original admission key.
                                (set! (.version-open (primitive/cast (ptr FunNode)
                                                                     (hdr entry)))
                                      false)
                                (code-add! entry)
                                (code-add-outputs! entry)
                                (set! (mut count) (+ (load count) 1)))))
                    (None [] 0)))))
    (load count)))

(defn versions-finish-opto! [(stop (dyn NodeOps))] (-> i64)
  (do
    (al-for [item (.items (function-versions))]
            (let [v item]
              (if (not (.accepted v))
                  0
                  (match (arena-node (.entry v))
                    (Some [entry]
                          (match (fun-ret entry)
                            (Some [ret]
                                  (if (n-dead? ret)
                                      0
                                      (do
                                        (if (and (not (n-dead? entry))
                                                 (not (fun-folding? entry))
                                                 (not (ty-high? (n-ty entry))))
                                            (stop-add-return! stop ret)
                                            0)
                                        (n-unkill! ret))))
                            (None [] 0)))
                    (None [] 0)))))
    0))

(defn versions-prepare-codegen! [(start (dyn NodeOps))] (-> i64)
  (do
    (al-for [item (.items (function-versions))]
            (let [v item]
              (if (not (.accepted v))
                  0
                  (match (arena-node (.entry v))
                    (Some [entry] (fun-prepare-codegen! entry start))
                    (None [] 0)))))
    0))
