;; The x86-64 machine port: registers, calling convention, and instruction selection.

;;
;; SECOND target, after arm64. Two ports is the point at which the machine interface stops being a
;; description of one CPU: a single port cannot tell which of its assumptions are general and which
;; are its own. Two-address forms, a flags register and variable-length encoding are all things
;; arm64 alone would let us get wrong in the shared code.
;;
;; SCAFFOLD: the register numbering is final; bodies hard-error. Filled in at S6.
(module aot.node.cpus.x86-64)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(const X86-RAX 0)

(const X86-RCX 1)

(const X86-RDX 2)

(const X86-RBX 3)

(const X86-RSP 4)

(const X86-RBP 5)

(const X86-RSI 6)

(const X86-RDI 7)

(const X86-XMM0 16)

(const X86-FLAGS 32)

(const X86-MAX-REG 33)

(defn x86-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "x86-select" "S6 — src/node/cpus/x86_64/x86_64.coil") (unreachable-node)))

(defn x86-caller-save [] (-> i64)
  (do (unimplemented "x86-caller-save" "S6 — src/node/cpus/x86_64/x86_64.coil") 0))

(defn x86-arg-mask [(sig i64) (arg i64)] (-> i64)
  (do (unimplemented "x86-arg-mask" "S6 — src/node/cpus/x86_64/x86_64.coil") 0))

(defn x86-ret-mask [(sig i64)] (-> i64)
  (do (unimplemented "x86-ret-mask" "S6 — src/node/cpus/x86_64/x86_64.coil") 0))
