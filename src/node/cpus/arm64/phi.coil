;; ARM64 MACHINE PHIS

;;
;; Final Simple preserves Phi as a machine node instead of selecting it into an instruction. GCM
;; must still recognize that arm i is consumed in Region predecessor i, and register allocation
;; later converts those conceptual edge choices into parallel copies. Scalar Phi definitions and
;; arms share one register class; MemPhi carries no live range. Both are pinned and encode zero
;; bytes. Mapping a shell before its inputs is what makes loop-Phi backedges cycle safe.
(module aot.node.cpus.arm64.phi)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.codegen.regmask" :use *)
(import "aot.type.type" :use *)
(import "aot.node.cpus.arm64.base" :use *)

(defstruct Arm64PhiNode [(hdr NodeHdr) (ideal-op i64) (result-ty i64) (value-class i64)])

(defn arm64-phi-node [(n (dyn NodeOps))] (-> (ptr Arm64PhiNode))
  (if (!= (n-op n) OP-MACH-PHI)
      (do
        (panic-i "arm64-phi-node: not a selected Phi" (n-op n))
        (primitive/cast (ptr Arm64PhiNode) (hdr n)))
      (primitive/cast (ptr Arm64PhiNode) (hdr n))))

(defn arm64-phi-class [(t i64)] (-> i64)
  (if (or (ty-mem? t) (ty-tuple? t) (= t TY-CTRL) (= t TY-XCTRL))
      ARM64-CLASS-NONE
      (if (ty-flt? t) ARM64-CLASS-FPR ARM64-CLASS-GPR)))

(defn arm64-phi-mask [(class i64)] (-> (Option (ptr RegMask)))
  (match (arm64-class-mask class)
    (None [] (None [(ptr RegMask)]))
    (Some [registers] (Some (mask-or registers (mask-stack (arm64-stack-base)))))))

(defn arm64-phi-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [op (n-op n)]
    (if (not (or (= op OP-PHI) (= op OP-MEMPHI)))
        (do (panic-i "arm64-phi-select: unsupported ideal opcode" op) (unreachable-node))
        (let [a (alloc/malloc-allocator)
              p (alloc/unwrap-ptr [Arm64PhiNode] (alloc/create [Arm64PhiNode] a))
              d (primitive/make-dyn NodeOps p)]
          (set! (.ideal-op p) op)
          (set! (.result-ty p) (n-ty n))
          (set! (.value-class p) (arm64-phi-class (n-ty n)))
          (n-init! d OP-MACH-PHI)
          (arm64-scalar--raw-inputs! d n)
          (n-force-ty! d (.result-ty p))
          d))))

(impl NodeOps Arm64PhiNode
  (hdr [(self (ptr Arm64PhiNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (compute [(self (ptr Arm64PhiNode))] (-> i64) (.result-ty self))
  (idealize [(self (ptr Arm64PhiNode))] (-> (Option (dyn NodeOps))) (None [(dyn NodeOps)]))
  (label [(self (ptr Arm64PhiNode))]
         (-> (slice u8))
         (if (= (.ideal-op self) OP-MEMPHI) "memphi" "phi"))
  (eq-extra [(self (ptr Arm64PhiNode)) (other (dyn NodeOps))]
            (-> bool)
            (and (= (n-op other) OP-MACH-PHI)
                 (= (.ideal-op self) (.ideal-op (arm64-phi-node other)))))
  (hash-extra [(self (ptr Arm64PhiNode))] (-> i64) (* (.ideal-op self) 1063))
  (is-const? [(self (ptr Arm64PhiNode))] (-> bool) false)
  (no-const-fold? [(self (ptr Arm64PhiNode))] (-> bool) true)
  (is-pinned? [(self (ptr Arm64PhiNode))] (-> bool) true)
  (binop-copy [(self (ptr Arm64PhiNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)])))

(impl MachNode Arm64PhiNode
  (m-node [(self (ptr Arm64PhiNode))] (-> (dyn NodeOps)) (primitive/make-dyn NodeOps self))
  (m-ideal-op [(self (ptr Arm64PhiNode))] (-> i64) (.ideal-op self))
  (m-post-select! [(self (ptr Arm64PhiNode))] (-> i64) 0)
  (m-regmap [(self (ptr Arm64PhiNode)) (i i64)]
            (-> (Option (ptr RegMask)))
            (if (= i 0) (None [(ptr RegMask)]) (arm64-phi-mask (.value-class self))))
  (m-outregmap [(self (ptr Arm64PhiNode))]
               (-> (Option (ptr RegMask)))
               (arm64-phi-mask (.value-class self)))
  (m-proj-outregmap [(self (ptr Arm64PhiNode)) (idx i64)]
                    (-> (Option (ptr RegMask)))
                    (do
                      (panic-i "Arm64PhiNode has no projected result" idx)
                      (None [(ptr RegMask)])))
  (m-killmap [(self (ptr Arm64PhiNode))] (-> (Option (ptr RegMask))) (None [(ptr RegMask)]))
  (m-two-address [(self (ptr Arm64PhiNode))] (-> i64) 0)
  (m-commutes [(self (ptr Arm64PhiNode))] (-> bool) false)
  (m-clone-cheap? [(self (ptr Arm64PhiNode))] (-> bool) false)
  (m-clone [(self (ptr Arm64PhiNode))] (-> (Option (dyn NodeOps))) (None [(dyn NodeOps)]))
  (m-size [(self (ptr Arm64PhiNode))] (-> i64) 0)
  (m-encoding [(self (ptr Arm64PhiNode)) (encoder i64)] (-> i64) encoder)
  (m-asm [(self (ptr Arm64PhiNode))]
         (-> (slice u8))
         (if (= (.ideal-op self) OP-MEMPHI) "memphi" "phi"))
  (m-op [(self (ptr Arm64PhiNode))]
        (-> (slice u8))
        (if (= (.ideal-op self) OP-MEMPHI) "memphi" "phi")))
