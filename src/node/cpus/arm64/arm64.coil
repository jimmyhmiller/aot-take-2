;; The arm64 machine port: registers, calling convention, and instruction selection.

;;
;; arm64 is the FIRST target because it is the development machine, so "does the emitted code
;; actually run" is answerable on every commit rather than through an emulator.
;;
;; Machine node families are grouped exactly as ideal nodes are — arith, bits, mem, branch, call —
;; rather than one file per instruction.
;;
;; SCAFFOLD: the register numbering is final; bodies hard-error. Filled in at S6.
(module aot.node.cpus.arm64)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

;; General purpose. X30 is the link register; X31 is SP in most encodings and XZR in others, which
;; is why it is named by role at each use rather than given one name here.
(const ARM-X0 0)

(const ARM-X1 1)

(const ARM-X29 29)

(const ARM-LR 30)

(const ARM-SP 31)

;; Floating point continues the numbering: D0 is register 32.
(const ARM-D0 32)

(const ARM-FLAGS 64)

(const ARM-MAX-REG 65)  ; stack slots continue upward from here

(defn arm64-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "arm64-select" "S6 — src/node/cpus/arm64/arm64.coil") (unreachable-node)))

(defn arm64-caller-save [] (-> i64)
  (do (unimplemented "arm64-caller-save" "S6 — src/node/cpus/arm64/arm64.coil") 0))

(defn arm64-arg-mask [(sig i64) (arg i64)] (-> i64)
  (do (unimplemented "arm64-arg-mask" "S6 — src/node/cpus/arm64/arm64.coil") 0))

(defn arm64-ret-mask [(sig i64)] (-> i64)
  (do (unimplemented "arm64-ret-mask" "S6 — src/node/cpus/arm64/arm64.coil") 0))
