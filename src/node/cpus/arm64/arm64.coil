;; The arm64 machine port: registers, calling convention, and instruction selection.

;;
;; arm64 is the FIRST target because it is the development machine, so "does the emitted code
;; actually run" is answerable on every commit rather than through an emulator.
;;
;; Machine node families are grouped exactly as ideal nodes are — arith, bits, mem, branch, call —
;; rather than one file per instruction.
;;
;; Final Simple's shared frame model reserves a function's incoming argument homes at the low end
;; of allocator stack locations, biases outgoing homes past them, and rotates both ranges around the
;; local frame during encoding. Its ARM port deliberately leaves stack arguments with a nonzero
;; incoming area as TODO and retains the generic stack-RPC `+1` formula. AAPCS64 has no such stack
;; RPC: BL writes X30/LR. We therefore complete the model with location ARM-MAX-REG as stack argument
;; zero, count only preceding overflow arguments across the independent GPR/FPR banks, bias outgoing
;; arguments by the caller's incoming count, and give CallEnd the identical outgoing kill range.
;;
(module aot.node.cpus.arm64)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.type.type" :use *)
(import "aot.codegen.regmask" :use *)
(import "aot.codegen.machine" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.call" :use *)
(import "aot.node.control" :use *)
(import "aot.node.gc" :use *)
(import "aot.node.jsops" :use *)
(import "aot.codegen.codegen" :use [code-add-string-constant! code-string-symbol])
(import "aot.node.dynamic" :use *)
(import "aot.node.memory" :use *)
(import "aot.shape" :use *)
(import "aot.node.cpus.arm64.base" :use *)
(import "aot.node.cpus.arm64.arith" :use *)
(import "aot.node.cpus.arm64.bits" :use *)
(import "aot.node.cpus.arm64.dynamic" :use *)
(import "aot.node.cpus.arm64.mem" :use *)
(import "aot.node.cpus.arm64.phi" :use *)
(import "aot.node.cpus.arm64.branch" :use *)
(import "aot.node.cpus.arm64.call" :use *)
(import "aot.node.cpus.arm64.split" :use *)

;; General purpose. X30 is the link register; X31 is SP in most encodings and XZR in others, which
;; is why it is named by role at each use rather than given one name here.
(const ARM-X0 0)

(const ARM-X1 1)

(const ARM-X16 16)

(const ARM-X17 17)

(const ARM-X18 18)  ; Darwin platform register, never allocated

(const ARM-X19 19)

(const ARM-X28 28)

(const ARM-X29 29)

(const ARM-LR 30)

(const ARM-SP 31)

;; Floating point continues the numbering: D0 is register 32.
(const ARM-D0 32)

(const ARM-D8 40)

(const ARM-D15 47)

(const ARM-D31 63)

(const ARM-FLAGS 64)

(const ARM-MAX-REG 65)  ; stack slots continue upward from here

(defn arm64-mach-hook [(n (dyn NodeOps))] (-> (Option (dyn MachNode)))
  (let [op (n-op n)]
    (if (= op OP-MACH-SCALAR)
        (Some (primitive/make-dyn MachNode (arm64-scalar-node n)))
        (if (= op OP-MACH-MEM)
            (Some (primitive/make-dyn MachNode (arm64-mem-node n)))
            (if (= op OP-MACH-CFG)
                (Some (primitive/make-dyn MachNode (arm64-cfg-node n)))
                (if (= op OP-MACH-CALL)
                    (Some (primitive/make-dyn MachNode (arm64-call-node n)))
                    (if (= op OP-MACH-PHI)
                        (Some (primitive/make-dyn MachNode (arm64-phi-node n)))
                        (if (= op OP-MACH-SPLIT)
                            (Some (primitive/make-dyn MachNode (arm64-split-node n)))
                            (None [(dyn MachNode)])))))))))

(defn arm64--enclosing-fun [(n (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [(mut cur) (Some n)
        (mut steps) 0
        limit (+ (arena-node-count) 1)
        (mut answer) (None [(dyn NodeOps)])]
    (loop (if (or (>= (load steps) limit)
                  (match (load cur) (Some [_] false) (None [] true))
                  (match (load answer) (Some [_] true) (None [] false)))
              (break 0)
              (match (load cur)
                (Some [c]
                      (if (= (n-op c) OP-FUN)
                          (set! (mut answer) (Some c))
                          (do (set! (mut cur) (cfg-idom-of c))
                              (set! (mut steps) (+ (load steps) 1))
                              (continue))))
                (None [] (break 0)))))
    (load answer)))

(defn arm64--caller-max-arg-slot [(call (dyn NodeOps))] (-> i64)
  (match (arm64--enclosing-fun (call-ctrl call))
    (Some [fun] (arm64-max-arg-slot (fun-sig fun)))
    (None [] 0)))

(defn arm64--callend-kills [(sig i64) (caller-max i64)] (-> (ptr RegMask))
  (let [(mut kills) (arm64-js-kill-mask)
        outgoing (arm64-max-arg-slot sig)
        (mut i) 0]
    (loop (if (>= (load i) outgoing)
              (break 0)
              (do
                (set! (mut kills)
                      (mask-or (load kills) (mask-of (+ ARM-MAX-REG (+ caller-max (load i))))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load kills)))

(defn arm64-call-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [op (n-op n)]
    (if (= op OP-FUN)
        (let [selected (arm64-call-alloc n true false 0 0)]
          (arm64-call-set-symbol! selected (fun-name n))
          (if (and (= (fun-name n) "main") (ty-dyn? (ty-tuple-at (fun-sig n) 0)))
              (arm64-call-set-process-entry! selected)
              0)
          ;; The closed-world function identity lives on FunPtr values, not Fun itself. Preserve
          ;; the singleton identity when one exists so object symbols and call relocations agree.
          (let [(mut i) 0 (mut found) -1]
            (loop (if (>= (load i) (n-nouts n))
                      (break 0)
                      (do
                        (match (n-out n (load i))
                          (Some [use]
                                (if (and (= (n-op use) OP-FUNPTR)
                                         (ty-funptr-single? (n-ty use)))
                                    (set! (mut found) (ty-funptr-the-fidx (n-ty use)))
                                    0))
                          (None [] 0))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))
            (arm64-call-set-fidx! selected (load found)))
          (arm64-fun-set-max-arg-slot! selected (arm64-max-arg-slot (fun-sig n)))
          selected)
        (if (= op OP-PARM)
            (let [selected (arm64-call-alloc n false false 0 0)
                  sig (fun-sig (parm-fun n))
                  slot (parm-call-slot n)]
              ;; Slot one is memory SSA, not a contradictory register-constrained value.
              (if (= slot CALL-MEM)
                  0
                  (arm64-call-set-output-mask! selected (arm64-arg-mask sig slot 0)))
              selected)
            (if (= op OP-CALL)
                (let [ft (n-ty (call-fptr n))
                      sig (ty-funptr-sig ft)
                      direct (ty-funptr-single? ft)
                      fidx (if direct (ty-funptr-the-fidx ft) 0)
                      selected (arm64-call-alloc n false direct fidx 4)
                      caller-max (arm64--caller-max-arg-slot n)
                      (mut i) CALL-ARG0]
                  (loop (if (>= (load i) (- (n-nins n) 1))
                            (break 0)
                            (do (arm64-call-set-input-mask! selected
                                                           (load i)
                                                           (arm64-arg-mask sig (load i) caller-max))
                                (set! (mut i) (+ (load i) 1))
                                (continue))))
                  (if direct
                      (do
                        ;; The registry owns the index: a singleton-typed Load or Phi has no Fun
                        ;; input, only a FunPtr literal does.
                        (arm64-call-set-symbol! selected
                                                (match (arena-function fidx)
                                                  (Some [fun] (fun-name fun))
                                                  (None [] (do (panic-i "arm64-call-select: direct target has no registered owner" fidx) ""))))
                        (arm64-call-drop-target! selected))
                      (arm64-call-set-input-mask! selected (- (n-nins n) 1) (arm64-gpr-mask)))
                  selected)
                (if (= op OP-CALLEND)
                    (let [call (cend-call n)
                          sig (ty-funptr-sig (n-ty (call-fptr call)))
                          selected (arm64-call-alloc n true false 0 0)]
                      (arm64-call-set-projection-mask! selected RETURN-VALUE (arm64-ret-mask sig))
                      (arm64-call-set-kill-mask! selected
                                                 (arm64--callend-kills
                                                   sig
                                                   (arm64--caller-max-arg-slot call)))
                      selected)
                    (if (= op OP-RETURN)
                        (match (arena-node (return-fun-nid n))
                          (Some [fun]
                                (let [sig (fun-sig fun)
                                      ;; Only the compiler-owned process wrapper has the public
                                      ;; name and the boxed dynamic return ABI. Hand-built backend
                                      ;; tests and other raw entry graphs may also name their Fun
                                      ;; `main`; their integer result is already the host ABI and
                                      ;; must not be interpreted as a NaN-boxed word.
                                      entry
                                        (and (= (fun-name fun) "main")
                                             (ty-dyn? (ty-tuple-at sig 0)))
                                      selected (arm64-call-alloc n false false 0 (if entry 36 4))]
                                  (arm64-call-set-input-mask! selected RETURN-VALUE (arm64-ret-mask sig))
                                  (arm64-call-set-input-mask! selected RETURN-RPC (mask-of ARM-LR))
                                  (if entry
                                      (do
                                        (arm64-call-set-entry-return! selected)
                                        (arm64-call-set-kill-mask!
                                          selected
                                          (mask-or (mask-of ARM-X16) (mask-of ARM-X17))))
                                      0)
                                  selected))
                          (None [] (do (panic "arm64-call-select: Return has no owning Fun")
                                      (unreachable-node))))
                        (if (= op OP-PROJ)
                            (let [selected (arm64-call-alloc n false false 0 0)]
                              (match (n-in n 0)
                                (Some [multi]
                                      (if (and (= (n-op multi) OP-CALLEND)
                                               (= (proj-idx n) RETURN-VALUE))
                                          (let [call (cend-call multi)
                                                sig (ty-funptr-sig (n-ty (call-fptr call)))]
                                            (arm64-call-set-output-mask! selected (arm64-ret-mask sig)))
                                          (if (and (= (n-op multi) OP-NEW) (= (proj-idx n) 0))
                                              (arm64-call-set-output-mask! selected (mask-of ARM-X0))
                                              (if (and (= (n-op multi) OP-JSOP)
                                                       (= (proj-idx n) 2))
                                                  (arm64-call-set-output-mask! selected
                                                                               (mask-of ARM-X0))
                                                  (if (and (= (n-op multi) OP-SAFEPOINT)
                                                           (>= (proj-idx n) SAFEPOINT-LIVE))
                                                      (arm64-call-set-output-mask! selected
                                                                                   (mask-stack ARM-MAX-REG))
                                                      0)))))
                                (None [] 0))
                              selected)
                            (do (panic-i "arm64-call-select: unsupported ideal opcode" op)
                                (unreachable-node))))))))))

(defn arm64-new-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [shape (new-shape n)
        bytes-ty (n-ty (new-size n))
        selected (arm64-call-alloc n false true -1 0)]
    ;; aot_rt_alloc(bytes,shape,map-id,caller-sp): the graph supplies bytes in X0; selection
    ;; materializes immutable shape and safepoint identity in X1/X2 and snapshots SP into X3.
    ;; The runtime returns the first payload byte in X0.
    (arm64-call-set-input-mask! selected 1 (mask-of ARM-X0))
    (arm64-call-set-projection-mask! selected 0 (mask-of ARM-X0))
    (arm64-call-set-kill-mask! selected (arm64-js-kill-mask))
    (arm64-call-set-alloc-shape! selected shape)
    (if (and (ty-int? bytes-ty) (ty-constant? bytes-ty))
        (arm64-call-set-alloc-bytes! selected (ty-int-lo bytes-ty))
        (panic "arm64-new-select: allocation size is not a compile-time constant"))
    (arm64-call-set-alloc-map-id! selected (n-nid selected))
    (arm64-call-set-symbol! selected "aot_rt_alloc")
    selected))

(defn arm64-safepoint-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [selected (arm64-call-alloc n false false 0 0) (mut i) SAFEPOINT-LIVE]
    ;; A safepoint emits no instruction by itself. Live inputs and relocation projections occupy
    ;; writable stack homes, which is the exact addressable state consumed by runtime stack maps.
    (loop (if (>= (load i) (n-nins n))
              (break 0)
              (do
                (arm64-call-set-input-mask! selected (load i) (mask-stack ARM-MAX-REG))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (arm64-call-set-kill-mask! selected (arm64-js-kill-mask))
    selected))

(defn arm64-barrier-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [selected (arm64-call-alloc n false true -1 4)
        value-type (n-ty (n-in! n BARRIER-VAL))
        inputs (mask-or (mask-range ARM-X0 14) (mask-range ARM-X19 27))]
    (arm64-call-set-input-mask! selected BARRIER-OBJ inputs)
    (arm64-call-set-input-mask! selected BARRIER-VAL inputs)
    (arm64-call-set-kill-mask!
      selected
      (mask-or (mask-of 15) (mask-or (mask-of ARM-X16) (mask-of ARM-X17))))
    (arm64-call-set-barrier-kind! selected
                                  (if (ty-memptr? value-type)
                                      BARRIER-KIND-RAW
                                      BARRIER-KIND-BOXED))
    selected))

(defn arm64-jsop-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [prim (jsop-prim n)
        transitioning (jsop-transitioning? prim)
        selected (arm64-call-alloc n false true -1 4)
        (mut i) JSOP-ARG0]
    (loop (if (>= (load i) (n-nins n))
              (break 0)
              (do
                (arm64-call-set-input-mask! selected
                                             (load i)
                                             (mask-of (- (load i) JSOP-ARG0)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (arm64-call-set-projection-mask! selected 2 (mask-of ARM-X0))
    (arm64-call-set-kill-mask! selected (arm64-js-kill-mask))
    ;; String capabilities allocate strings and take the string shape; a property store allocates
    ;; a backing store whose shape the runtime's transition tree decides.
    (arm64-call-set-jsop! selected
                          prim
                          (- (n-nins n) JSOP-ARG0)
                          (if (and transitioning (not (jsop-touches-properties? prim))) SHAPE-STRING 0)
                          (if transitioning (n-nid selected) 0)
                          transitioning)
    (arm64-call-set-symbol!
      selected
      (case prim
            JS-STRING-LEN "aot_rt_string_length"
            JS-STRING-CONCAT "aot_rt_string_concat"
            JS-STRING-CHARCODE "aot_rt_string_code_unit"
            JS-STRING-EQ "aot_rt_string_eq"
            JS-STRING-COMPARE "aot_rt_string_compare"
            JS-THROW "aot_rt_throw"
            JS-THROW-TYPE-ERROR "aot_rt_throw_type_error"
            JS-TRAP-INVARIANT "aot_rt_trap_invariant"
            JS-TRAP-TO-PRIMITIVE "aot_rt_unimplemented_to_primitive"
            JS-TRAP-TO-STRING "aot_rt_unimplemented_to_string"
            JS-TRAP-STRING-TO-NUMBER "aot_rt_unimplemented_string_to_number"
            JS-TRAP-NO-REALM "aot_rt_unimplemented_no_realm"
            JS-UNCAUGHT "aot_rt_uncaught"
            JS-TRAP-KEYED-ACCESS "aot_rt_unimplemented_keyed_access"
            JS-TRAP-UNRESOLVED-GLOBAL "aot_rt_unimplemented_unresolved_global"
            JS-NUMBER-TO-STRING "aot_rt_number_to_string"
            JS-TRAP-TO-OBJECT "aot_rt_unimplemented_to_object"
            JS-INTERN-KEY "aot_rt_intern_key"
            JS-PROP-GET-OWN "aot_rt_prop_get_own"
            JS-PROP-HAS-OWN "aot_rt_prop_has_own"
            JS-PROP-SET-OWN "aot_rt_prop_set_own"
            (do (panic-i "arm64-jsop-select: primitive has no runtime ABI" prim) "")))
    selected))

;; A string literal is the address of its table entry: ADRP/ADD against the entry's local symbol,
;; exactly a FunPtr's form with no Fun.
(defn arm64-strconst-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [index (code-add-string-constant! (strconst-units n))
        selected (arm64-scalar-make n OP-STRCONST ARM64-FORM-FUNPTR -1
                                    ARM64-CLASS-NONE ARM64-CLASS-GPR 0 false true)]
    (loop (if (= (n-nins selected) 0)
              (break 0)
              (do (arm64-scalar-drop-last-input! selected) (continue))))
    (arm64-scalar-set-symbol! selected (code-string-symbol index))
    (arm64-scalar-set-size! selected 8)
    selected))

(defn arm64-install-hooks! [] (-> i64)
  (do
    ;; One target-wide CFG dispatcher owns both machine control families. Constructors must not
    ;; replace this hook: selection order is unrelated to whether a Call/Return or branch is later
    ;; queried by dominance, scheduling, allocation, or encoding.
    (set-selected-cfg-ext! (primitive/fnptr-of arm64-call-cfg-hook))
    (set-selected-machine-hook! (primitive/fnptr-of arm64-mach-hook))
    (set-selected-gc-root-mask! (mask-stack ARM-MAX-REG))
    (set-selected-split-hook! (primitive/fnptr-of arm64-split-factory))
    (set-selected-layout-hook! (primitive/fnptr-of arm64-layout-jump)
                               (primitive/fnptr-of arm64-layout-set-inverted!)
                               (primitive/fnptr-of arm64-layout-branch-target)
                               (primitive/fnptr-of arm64-layout-relax-branch!)
                               (primitive/fnptr-of arm64-layout-jump?)
                               (primitive/fnptr-of arm64-layout-literal-bits)
                               (primitive/fnptr-of arm64-layout-long-target)
                               (primitive/fnptr-of arm64-layout-definition-fidx)
                               (primitive/fnptr-of arm64-layout-call-fidx))
    (set-selected-abi-hook! (primitive/fnptr-of arm64-caller-save)
                            (primitive/fnptr-of arm64-never-save)
                            (primitive/fnptr-of arm64-active-max-reg)
                            (primitive/fnptr-of arm64-callee-save-make)
                            (primitive/fnptr-of arm64-fun-process-entry-node?)
                            (primitive/fnptr-of arm64-fun-finalize-frame!)
                            (primitive/fnptr-of arm64-fun-stack-offset)
                            (primitive/fnptr-of arm64-fun-frame-adjust)
                            (primitive/fnptr-of arm64-fun-saved-rpc-offset))
    0))

(defn arm64-active-max-reg [] (-> i64) ARM-MAX-REG)

;; A FunPtr constant that survives to selection is used as a VALUE (a direct call drops its
;; target). Simple's arm port materializes it as ADRP/ADD relocated against the function symbol.
(defn arm64-funptr-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [t (n-ty n)]
    (if (not (and (ty-funptr? t) (ty-funptr-single? t)))
        (panic "arm64-funptr-select: function pointer value does not name a single function")
        0)
    (let [fidx (ty-funptr-the-fidx t)
          ;; A copied or GVN-shared FunPtr may have dropped its Fun input; the closed-world registry
          ;; is the authoritative owner of the index either way. A target the optimizer proved
          ;; unreachable has no code: its function object exists, but every call through it is on a
          ;; path SCCP showed dead, so the code word names the runtime's invariant trap instead.
          target (match (arena-function fidx)
                   (Some [fun] fun)
                   (None [] (do (panic-i "arm64-funptr-select: function index has no registered owner" fidx)
                                (unreachable-node))))
          dead (or (n-dead? target) (ty-high? (n-ty target)))
          selected (arm64-scalar-make n OP-FUNPTR ARM64-FORM-FUNPTR (if dead -1 fidx)
                                      ARM64-CLASS-NONE ARM64-CLASS-GPR 0 false true)]
      ;; The ideal FunPtr names its Fun as input 0 for identity; as a machine value the address is
      ;; a relocated constant with no control or operand inputs, exactly like an integer constant.
      ;; Keeping the Fun edge would pin the value into the callee's entry block.
      (loop (if (= (n-nins selected) 0)
                (break 0)
                (do (arm64-scalar-drop-last-input! selected) (continue))))
      (arm64-scalar-set-symbol! selected (if dead "aot_rt_trap_invariant" (fun-name target)))
      (arm64-scalar-set-size! selected 8)
      selected)))

(defn arm64-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [op (n-op n)]
    (arm64-install-hooks!)
    (if (or (= op OP-ADD)
            (= op OP-SUB)
            (= op OP-MUL)
            (= op OP-DIV)
            (= op OP-MINUS)
            (= op OP-TOFLOAT)
            (= op OP-ROUNDF32))
        (arm64-arith-select n)
        (if (or (= op OP-AND)
                (= op OP-OR)
                (= op OP-XOR)
                (= op OP-SHL)
                (= op OP-SHR)
                (= op OP-SAR)
                (= op OP-NOT)
                (= op OP-EQ)
                (= op OP-NE)
                (= op OP-LT)
                (= op OP-LE)
                (= op OP-ULT))
            (arm64-bits-select n)
            (if (or (= op OP-BOX)
                    (= op OP-UNBOX)
                    (= op OP-TYPETEST)
                    (= op OP-CAST))
                (arm64-dynamic-select n)
            (if (= op OP-HEAPSTATE)
                (let [selected (arm64-scalar-make n OP-HEAPSTATE ARM64-FORM-HEAPSTATE 0
                                                  ARM64-CLASS-NONE ARM64-CLASS-GPR 0 false true)]
                  (arm64-scalar-set-size! selected 4)
                  selected)
            (if (= op OP-FUNPTR)
                (arm64-funptr-select n)
            (if (= op OP-STRCONST)
                (arm64-strconst-select n)
            (if (or (= op OP-LOAD) (= op OP-STORE))
                (arm64-mem-select n)
                (if (= op OP-NEW)
                    (arm64-new-select n)
                    (if (= op OP-JSOP)
                        (arm64-jsop-select n)
                    (if (= op OP-BARRIER)
                        (arm64-barrier-select n)
                    (if (= op OP-SAFEPOINT)
                        (arm64-safepoint-select n)
                    (if (or (= op OP-PHI) (= op OP-MEMPHI))
                        (arm64-phi-select n)
                (if (or (= op OP-IF)
                        (= op OP-NEVER)
                        (= op OP-CPROJ)
                        (= op OP-START)
                        (= op OP-STOP)
                        (= op OP-REGION)
                        (= op OP-LOOP)
                        (= op OP-XCTRL))
                    (arm64-branch-select n)
                    (if (or (= op OP-FUN) (= op OP-PARM) (= op OP-CALL) (= op OP-CALLEND)
                            (= op OP-RETURN) (= op OP-PROJ))
                        (arm64-call-select n)
                        (if (= op OP-MEMMERGE)
                            (let [pseudo
                                    (arm64-scalar-make n
                                                       OP-MEMMERGE
                                                       ARM64-FORM-CONST
                                                       0
                                                       ARM64-CLASS-NONE
                                                       ARM64-CLASS-NONE
                                                       0
                                                       false
                                                       false)]
                              ;; MemMerge is a compile-time bundle of alias slices. It carries no
                              ;; register value and emits no bytes, but remains an ordinary selected
                              ;; dependency so loads/stores retain their exact memory edges.
                              (arm64-scalar-set-size! pseudo 0)
                              pseudo)
                        (if (= op OP-CON)
                        (let [t (con-ty-of n)]
                          (if (ty-constant? t)
                              (let [dynamic-immediate
                                      (and (ty-dyn? t)
                                           (and (not (ty-dyn-high? t))
                                                (or (= (ty-dyn-tags t) TAG-UNDEFINED)
                                                    (= (ty-dyn-tags t) TAG-NULL))))
                                    dynamic-word
                                      (if dynamic-immediate
                                          (primitive/ishl
                                            (dynamic-prefix-for-tag (ty-dyn-tags t))
                                            48)
                                          0)
                                    selected
                                      (arm64-scalar-make n
                                                         op
                                                         ARM64-FORM-CONST
                                                         (if (ty-int? t)
                                                             (ty-int-lo t)
                                                             (if (ty-flt? t)
                                                                 (flt--bits (ty-flt-value t))
                                                                 (if dynamic-immediate
                                                                     dynamic-word
                                                                     0)))
                                                         ARM64-CLASS-NONE
                                                         (if (ty-flt? t)
                                                             ARM64-CLASS-FPR
                                                             ARM64-CLASS-GPR)
                                                         0
                                                         false
                                                         true)]
                                (if (or (ty-int? t) dynamic-immediate)
                                    (arm64-scalar-set-size!
                                      selected
                                      (* 4
                                         (arm64-const-insns
                                           (if dynamic-immediate
                                               dynamic-word
                                               (ty-int-lo t)))))
                                    (arm64-scalar-set-size! selected 4))
                                selected)
                              ;; A Con that is not a register value — memory, control, a tuple, or
                              ;; the dead placeholders TOP and BOT — selects to a zero-size pseudo
                              ;; node with no register class. A non-constant Con of a REGISTER type
                              ;; must not: it would become a value with no register definition and
                              ;; no instruction, read from an uninitialized location by every use.
                              (if (or (= t TY-TOP) (= t TY-BOT) (= t TY-CTRL) (= t TY-XCTRL)
                                      (ty-mem? t) (ty-tuple? t))
                                  (let [pseudo
                                          (arm64-scalar-make n
                                                             op
                                                             ARM64-FORM-CONST
                                                             0
                                                             ARM64-CLASS-NONE
                                                             ARM64-CLASS-NONE
                                                             0
                                                             false
                                                             false)]
                                    (arm64-scalar-set-size! pseudo 0)
                                    pseudo)
                                  (do
                                    (n-panic! "arm64-select: Con of a non-constant type has no machine form" n)
                                    (unreachable-node)))))
                            (do (panic-i "arm64-select: unsupported ideal opcode" op)
                                (unreachable-node))))))))))))))))))))

;; Cycle-safe ideal -> machine mapping.  The selected shell enters `map` before its inputs are
;; visited, matching final Simple's `_instSelect`; loops and phis therefore terminate once their
;; concrete selected families exist.  Output edges are intentionally rebuilt in a second walk.
(defstruct Arm64SelectState
  [(map (ArrayList (Option (dyn NodeOps))))
   (seen (ArrayList bool))])

(defn arm64-select--node! [(n (dyn NodeOps)) (state (ptr Arm64SelectState))] (-> (dyn NodeOps))
  (let [id (n-nid n)]
    ;; Multi-node expansions create machine nodes with no ideal-map slot.  They are already
    ;; selected, but their inputs may still be ideal.  Walk those inputs in place, matching final
    ;; Simple's early MachNode arm.
    (if (or (= (n-op n) OP-MACH-SCALAR) (= (n-op n) OP-MACH-MEM) (= (n-op n) OP-MACH-CFG)
            (= (n-op n) OP-MACH-CALL) (= (n-op n) OP-MACH-PHI) (>= id (len (.map state))))
        (let [(mut i) 0]
          (loop (if (>= (load i) (n-nins n))
                    (break 0)
                    (do
                      (match (n-in n (load i))
                        (Some [old]
                              (set! (mut (.ins (hdr n)))
                                    (load i)
                                    (Some (arm64-select--node! old state))))
                        (None [] 0))
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          ;; Final Simple calls MachNode.postSelect only after every input has been recursively
          ;; remapped. Multi-node target expansions enter through this arm and need the same hook.
          (match (mach-of n)
            (Some [mach] (m-post-select! mach))
            (None [] (panic "arm64-select--node!: selected expansion has no MachNode view")))
          n)
        (match (get (.map state) id)
          (Some [already] already)
          (None []
                (let [selected (arm64-select n)]
                  ;; Selection changes representation, not source identity. Preserve the ideal
                  ;; node's provenance before machine inputs and later split nodes widen it.
                  (n-source-copy! selected n)
                  (set! (mut (.map state)) id (Some selected))
                  ;; Carry all loop-tree and CFG preorder facts across the destructive transition.
                  ;; These fields are meaningful only for CFG nodes but copying zeros on data nodes
                  ;; keeps the rule centralized and makes omissions impossible.
                  (n-set-ltree-head! selected (n-ltree-head n))
                  (n-set-ltree-parent! selected (n-ltree-parent n))
                  (n-set-ltree-depth! selected (n-ltree-depth n))
                  (n-set-cfg-pre! selected (n-cfg-pre n))
                  (let [(mut i) 0]
                    (loop (if (>= (load i) (n-nins selected))
                              (break 0)
                              (do
                                (match (n-in selected (load i))
                                  (Some [old]
                                        (set! (mut (.ins (hdr selected)))
                                              (load i)
                                              (Some (arm64-select--node! old state))))
                                  (None [] 0))
                                (set! (mut i) (+ (load i) 1))
                                (continue)))))
                  ;; Match final Simple's `mach.postSelect()` point: the selected shell is already
                  ;; in the cycle map and every selected input now names its machine replacement.
                  (match (mach-of selected)
                    (Some [mach] (m-post-select! mach))
                    (None [] (panic "arm64-select--node!: selector returned a non-machine node")))
                  selected))))))

(defn arm64-select--rebuild-outs! [(n (dyn NodeOps)) (state (ptr Arm64SelectState))] (-> i64)
  (let [id (n-nid n)]
    (if (get (.seen state) id)
        0
        (do
          (set! (mut (.seen state)) id true)
          (let [(mut i) 0]
            (loop (if (>= (load i) (n-nins n))
                      (break 0)
                      (do
                        (match (n-in n (load i))
                          (Some [def]
                                (do
                                  (push! [(Option (dyn NodeOps))] (mut (.outs (hdr def))) (Some n))
                                  (arm64-select--rebuild-outs! def state)))
                          (None [] 0))
                        (set! (mut i) (+ (load i) 1))
                        (continue)))))
          0))))

(defn arm64-select-graph [(root (dyn NodeOps))] (-> (dyn NodeOps))
  (let [old-limit (+ (arena-node-count) 1)
        a (alloc/malloc-allocator)
        state (alloc/unwrap-ptr [Arm64SelectState] (alloc/create [Arm64SelectState] a))
        (mut i) 0]
    (set! (.map state) (al-new [(Option (dyn NodeOps))] a))
    (set! (.seen state) (al-new [bool] a))
    (loop (if (>= (load i) old-limit)
              (break 0)
              (do
                (push! [(Option (dyn NodeOps))] (mut (.map state)) (None [(dyn NodeOps)]))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [selected (arm64-select--node! root state)
          selected-limit (+ (arena-node-count) 1)]
      (set! (mut i) 0)
      (loop (if (>= (load i) selected-limit)
                (break 0)
                (do
                  (push! [bool] (mut (.seen state)) false)
                  (set! (mut i) (+ (load i) 1))
                  (continue))))
      (arm64-select--rebuild-outs! selected state)
      selected)))

(defn arm64-gpr-mask [] (-> (ptr RegMask))
  (mask-or (mask-range ARM-X0 17) (mask-range ARM-X19 27)))

(defn arm64-fpr-mask [] (-> (ptr RegMask))
  (mask-range ARM-D0 ARM-D31))

(defn arm64-physical-mask [] (-> (ptr RegMask))
  (mask-or (arm64-gpr-mask) (arm64-fpr-mask)))

(defn arm64-callee-save [] (-> (ptr RegMask))
  (mask-or (mask-range ARM-X19 27) (mask-range ARM-D8 ARM-D15)))

;; What a JavaScript call, allocation, runtime primitive or safepoint kills: every register. JS
;; frames preserve nothing (docs/DECISIONS.md, the compile-time architecture), so a value live
;; across one reaches a stack slot through ordinary splitting and the stack map reads slots only.
;; `arm64-caller-save` keeps the AAPCS64 meaning for the one C boundary, the process-entry wrapper.
(defstruct Arm64JsKillMask [(mask (ptr RegMask)) (built bool)])

(defn arm64-js-kill-mask [] (-> (ptr RegMask))
  (let [t (primitive/alloc-static Arm64JsKillMask)]
    (if (.built t)
        (.mask t)
        (do
          (set! (.mask t) (mask-pin (mask-or (arm64-physical-mask) (mask-or (mask-of ARM-LR) (mask-of ARM-FLAGS)))))
          (set! (.built t) true)
          (.mask t)))))

;; Is this selected Fun the process-entry wrapper, the C boundary that honours AAPCS64?
(defn arm64-fun-process-entry-node? [(fun (dyn NodeOps))] (-> bool)
  (arm64-fun-process-entry? (arm64-call-node fun)))

(defn arm64-caller-save [] (-> (ptr RegMask))
  (mask-or (mask-sub (arm64-physical-mask) (arm64-callee-save))
           (mask-or (mask-of ARM-LR) (mask-of ARM-FLAGS))))

(defn arm64-never-save [] (-> (ptr RegMask))
  (mask-or (mask-of ARM-X18)
           (mask-or (mask-of ARM-X29)
                    (mask-or (mask-of ARM-LR)
                             (mask-or (mask-of ARM-SP) (mask-of ARM-FLAGS))))))

(defn arm64--prior-class-count [(sig i64) (arg-index i64) (floats bool)] (-> i64)
  (let [(mut i) 0
        (mut count) 0]
    (loop (if (>= (load i) arg-index)
              (break 0)
              (do
                (if (= (ty-flt? (ty-sig-arg sig (load i))) floats)
                    (set! (mut count) (+ (load count) 1))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load count)))

(defn arm64--prior-stack-count [(sig i64) (arg-index i64)] (-> i64)
  (let [(mut i) 0
        (mut gprs) 0
        (mut fprs) 0
        (mut stack) 0]
    (loop (if (>= (load i) arg-index)
              (break 0)
              (do
                (if (ty-flt? (ty-sig-arg sig (load i)))
                    (do
                      (if (>= (load fprs) 8) (set! (mut stack) (+ (load stack) 1)) 0)
                      (set! (mut fprs) (+ (load fprs) 1)))
                    (do
                      (if (>= (load gprs) 8) (set! (mut stack) (+ (load stack) 1)) 0)
                      (set! (mut gprs) (+ (load gprs) 1))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load stack)))

(defn arm64-arg-mask [(sig i64) (arg i64) (max-arg-slot i64)] (-> (ptr RegMask))
  (if (= arg 0)
      (mask-of ARM-LR)
      (if (= arg 1)
          (mask-empty)
          (let [idx (- arg 2)]
            (if (or (< idx 0) (>= idx (ty-sig-nargs sig)))
                (mask-empty)
                (let [float (ty-flt? (ty-sig-arg sig idx))
                      class-index (arm64--prior-class-count sig idx float)]
                  (if (< class-index 8)
                      (mask-of (+ (if float ARM-D0 ARM-X0) class-index))
                      ;; AArch64 keeps the return PC in LR, so ARM-MAX-REG is stack argument zero.
                      ;; Outgoing arguments are biased past the caller's incoming area: this gives
                      ;; each fixed ABI home a distinct allocator location while the frame-offset
                      ;; rotation below maps it back to AAPCS64's SP+0, SP+8, ... call boundary.
                      (mask-of (+ ARM-MAX-REG
                                  (+ max-arg-slot (arm64--prior-stack-count sig idx)))))))))))

(defn arm64-max-arg-slot [(sig i64)] (-> i64)
  (let [n (ty-sig-nargs sig)
        (mut gprs) 0
        (mut fprs) 0
        (mut stack) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break 0)
              (do
                (if (ty-flt? (ty-sig-arg sig (load i)))
                    (do
                      (if (>= (load fprs) 8) (set! (mut stack) (+ (load stack) 1)) 0)
                      (set! (mut fprs) (+ (load fprs) 1)))
                    (do
                      (if (>= (load gprs) 8) (set! (mut stack) (+ (load stack) 1)) 0)
                      (set! (mut gprs) (+ (load gprs) 1))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load stack)))

(defn arm64-ret-mask [(sig i64)] (-> (ptr RegMask))
  (mask-of (if (ty-flt? (ty-sig-ret sig)) ARM-D0 ARM-X0)))

;; ---------------------------------------------------------------------------
;; Complete target object

;; Final Simple passes one Machine object through selection, allocation, layout and encoding. The
;; target object is stateless; compilation-owned state remains in CodeGen and the selected graph.
(defstruct Arm64Machine [])

(defn arm64-machine [] (-> (ptr Arm64Machine))
  (primitive/alloc-static Arm64Machine))

(defn arm64-reg-name [(reg i64)] (-> (slice u8))
  (case reg 0 "x0" 1 "x1" 2 "x2" 3 "x3" 4 "x4" 5 "x5" 6 "x6" 7 "x7"
        8 "x8" 9 "x9" 10 "x10" 11 "x11" 12 "x12" 13 "x13" 14 "x14" 15 "x15"
        16 "x16" 17 "x17" 18 "x18" 19 "x19" 20 "x20" 21 "x21" 22 "x22" 23 "x23"
        24 "x24" 25 "x25" 26 "x26" 27 "x27" 28 "x28" 29 "fp" 30 "lr" 31 "sp"
        32 "d0" 33 "d1" 34 "d2" 35 "d3" 36 "d4" 37 "d5" 38 "d6" 39 "d7"
        40 "d8" 41 "d9" 42 "d10" 43 "d11" 44 "d12" 45 "d13" 46 "d14" 47 "d15"
        48 "d16" 49 "d17" 50 "d18" 51 "d19" 52 "d20" 53 "d21" 54 "d22" 55 "d23"
        56 "d24" 57 "d25" 58 "d26" 59 "d27" 60 "d28" 61 "d29" 62 "d30" 63 "d31"
        64 "flags"
        (do (panic-i "arm64-reg-name: register is a stack slot" reg) "")))

(impl Machine Arm64Machine
  (mach-name [(self (ptr Arm64Machine))] (-> (slice u8)) (do self "arm64"))
  (mach-reg-name [(self (ptr Arm64Machine)) (reg i64)] (-> (slice u8))
                 (do self (arm64-reg-name reg)))
  (mach-default-op-size [(self (ptr Arm64Machine))] (-> i64) (do self 4))
  (mach-select [(self (ptr Arm64Machine)) (n (dyn NodeOps))] (-> (dyn NodeOps))
               (do self (arm64-select n)))
  (mach-caller-save [(self (ptr Arm64Machine))] (-> (ptr RegMask))
                    (do self (arm64-caller-save)))
  (mach-never-save [(self (ptr Arm64Machine))] (-> (ptr RegMask))
                   (do self (arm64-never-save)))
  (mach-arg-mask [(self (ptr Arm64Machine)) (sig i64) (arg i64) (max-arg-slot i64)]
                 (-> (ptr RegMask))
                 (do self (arm64-arg-mask sig arg max-arg-slot)))
  (mach-ret-mask [(self (ptr Arm64Machine)) (sig i64)] (-> (ptr RegMask))
                 (do self (arm64-ret-mask sig)))
  (mach-rpc [(self (ptr Arm64Machine))] (-> i64) (do self ARM-LR))
  (mach-max-reg [(self (ptr Arm64Machine))] (-> i64) (do self ARM-MAX-REG))
  (mach-max-arg-slot [(self (ptr Arm64Machine)) (sig i64)] (-> i64)
                     (do self (arm64-max-arg-slot sig)))
  (mach-split [(self (ptr Arm64Machine)) (lrg i64) (kind (slice u8)) (round i64)]
              (-> (dyn NodeOps))
              (do self (arm64-install-hooks!) (arm64-split-make lrg kind round)))
  (mach-callee-save [(self (ptr Arm64Machine))
                     (fun (dyn NodeOps))
                     (ret (dyn NodeOps))
                     (reg i64)] (-> (dyn NodeOps))
                    (do self (arm64-install-hooks!) (arm64-callee-save-make fun ret reg)))
  (mach-finalize-frame [(self (ptr Arm64Machine))
                        (fun (dyn NodeOps))
                        (max-location i64)
                        (has-calls bool)] (-> i64)
                       (do self (arm64-fun-finalize-frame! fun max-location has-calls)))
  (mach-stack-offset [(self (ptr Arm64Machine)) (fun (dyn NodeOps)) (location i64)] (-> i64)
                     (do self (arm64-fun-stack-offset fun location)))
  (mach-jump [(self (ptr Arm64Machine))] (-> (dyn NodeOps))
             (do self (arm64-install-hooks!) (arm64-jump-make))))
