;; AArch64 selection for JavaScript's dynamic-word boundary.

;;
;; Simple has no dynamic value representation, so there is no target node to port here. The graph
;; contract still follows Simple: dynamic nodes have explicit register masks and exact sizes. Cast
;; preserves its control input because its narrowing is valid only on that edge; TypeTest is the
;; ordinary Boolean predicate feeding that control. Our JavaScript divergence is the NaN-box layout
;; recorded in docs/DECISIONS.md. Integer boxing writes prefix 0x7ff9 and a signed 48-bit payload;
;; double boxing canonicalizes NaN so every admitted singleton TypeTest has an unambiguous runtime
;; classifier. A representation not implemented here is rejected by name.
(module aot.node.cpus.arm64.dynamic)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.type.type" :use *)
(import "aot.codegen.regmask" :use *)
(import "aot.node.cpus.arm64.base" :use *)

(defn arm64-dynamic-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [op (n-op n)]
    (if (= op OP-BOX)
        (let [value (n-in! n 1)]
          (if (= (box-rep n) TAG-INT)
              (let [selected
                      (arm64-scalar-make n
                                         OP-BOX
                                         ARM64-FORM-BOX-INT
                                         0
                                         ARM64-CLASS-GPR
                                         ARM64-CLASS-GPR
                                         1
                                         false
                                         true)]
                (arm64-scalar-unary-input! selected value)
                (arm64-scalar-control-input! selected (n-in n 0))
                (arm64-scalar-set-size! selected 8)
                selected)
              (if (= (box-rep n) TAG-DOUBLE)
                  (let [selected
                          (arm64-scalar-make n
                                             OP-BOX
                                             ARM64-FORM-BOX-DOUBLE
                                             0
                                             ARM64-CLASS-FPR
                                             ARM64-CLASS-GPR
                                             1
                                             false
                                             true)]
                    (arm64-scalar-unary-input! selected value)
                    (arm64-scalar-control-input! selected (n-in n 0))
                    (arm64-scalar-set-size! selected 16)
                    (arm64-scalar-set-kill! selected ARM64-CLASS-FLAGS)
                    (arm64-scalar-set-kill-mask! selected (mask-of 16))
                    selected)
                  (if (or (= (box-rep n) TAG-OBJECT)
                          (= (box-rep n) TAG-STRING)
                          (= (box-rep n) TAG-BOOL)
                          (= (box-rep n) TAG-NULL)
                          (= (box-rep n) TAG-UNDEFINED))
                      (let [selected
                              (arm64-scalar-make n
                                                 OP-BOX
                                                 ARM64-FORM-BOX-REF
                                                 (dynamic-prefix-for-tag (box-rep n))
                                                 ARM64-CLASS-GPR
                                                 ARM64-CLASS-GPR
                                                 1
                                                 false
                                                 (not (or (= (box-rep n) TAG-NULL)
                                                          (= (box-rep n) TAG-UNDEFINED))))]
                        (arm64-scalar-unary-input! selected value)
                        (arm64-scalar-control-input! selected (n-in n 0))
                        (arm64-scalar-set-size! selected 8)
                        selected)
                      (do
                        (panic-i "arm64-dynamic-select: unsupported Box representation"
                                 (box-rep n))
                        (unreachable-node))))))
        (if (= op OP-UNBOX)
            (if (or (= (unbox-rep n) REP-INT) (= (unbox-rep n) REP-BOOL))
                (let [value (n-in! n 1)
                      selected
                        (arm64-scalar-make n
                                           OP-UNBOX
                                           ARM64-FORM-UNBOX-INT
                                           0
                                           ARM64-CLASS-GPR
                                           ARM64-CLASS-GPR
                                           1
                                           false
                                           false)]
                  (arm64-scalar-unary-input! selected value)
                  (arm64-scalar-control-input! selected (n-in n 0))
                  selected)
                (if (= (unbox-rep n) REP-DOUBLE)
                    (let [value (n-in! n 1)
                          selected
                            (arm64-scalar-make n
                                               OP-UNBOX
                                               ARM64-FORM-UNBOX-DOUBLE
                                               0
                                               ARM64-CLASS-GPR
                                               ARM64-CLASS-FPR
                                               1
                                               false
                                               false)]
                      (arm64-scalar-unary-input! selected value)
                      (arm64-scalar-control-input! selected (n-in n 0))
                      selected)
                    (if (= (unbox-rep n) REP-NUMBER)
                        (let [value (n-in! n 1)
                              selected
                                (arm64-scalar-make n
                                                   OP-UNBOX
                                                   ARM64-FORM-UNBOX-NUMBER
                                                   0
                                                   ARM64-CLASS-GPR
                                                   ARM64-CLASS-FPR
                                                   1
                                                   false
                                                   false)]
                          (arm64-scalar-unary-input! selected value)
                          (arm64-scalar-control-input! selected (n-in n 0))
                          (arm64-scalar-set-size! selected 32)
                          (arm64-scalar-set-kill-mask! selected
                                                       (mask-or (mask-of 16) (mask-of 17)))
                          (arm64-scalar-set-kill! selected ARM64-CLASS-FLAGS)
                          selected)
                        (if (or (= (unbox-rep n) REP-OBJECT) (= (unbox-rep n) REP-STRING))
                            (let [value (n-in! n 1)
                                  selected
                                    (arm64-scalar-make n
                                                       OP-UNBOX
                                                       ARM64-FORM-UNBOX-REF
                                                       0
                                                       ARM64-CLASS-GPR
                                                       ARM64-CLASS-GPR
                                                       1
                                                       false
                                                       false)]
                              (arm64-scalar-unary-input! selected value)
                              (arm64-scalar-control-input! selected (n-in n 0))
                              selected)
                            (do
                              (panic-i "arm64-dynamic-select: unsupported Unbox representation"
                                       (unbox-rep n))
                              (unreachable-node))))))
            (if (= op OP-TYPETEST)
                (let [tags (typetest-tags n)
                      is-double (= tags TAG-DOUBLE)
                      prefix (if is-double 0 (dynamic-prefix-for-tag tags))
                      selected
                        (arm64-scalar-make n
                                           OP-TYPETEST
                                           (if is-double
                                               ARM64-FORM-TYPETEST-DOUBLE
                                               ARM64-FORM-TYPETEST-PREFIX)
                                           prefix
                                           ARM64-CLASS-GPR
                                           ARM64-CLASS-GPR
                                           1
                                           false
                                           false)]
                  (if (and (not is-double) (= prefix 0))
                      (panic-i "arm64-dynamic-select: tag set has no runtime classifier" tags)
                      0)
                  (arm64-scalar-unary-input! selected (n-in! n 1))
                  (arm64-scalar-set-size! selected (if is-double 48 16))
                  (arm64-scalar-set-kill! selected ARM64-CLASS-FLAGS)
                  (arm64-scalar-set-kill-mask! selected
                                               (if is-double
                                                   (mask-or (mask-of 16) (mask-of 17))
                                                   (mask-of 16)))
                  selected)
                (if (= op OP-CAST)
                    (let [selected
                            (arm64-scalar-make n
                                               OP-CAST
                                               ARM64-FORM-CAST
                                               0
                                               ARM64-CLASS-GPR
                                               ARM64-CLASS-GPR
                                               1
                                               false
                                               false)]
                      (arm64-scalar-unary-input! selected (n-in! n 1))
                      (arm64-scalar-control-input! selected (n-in n 0))
                      selected)
                    (do
                      (panic-i "arm64-dynamic-select: unsupported ideal opcode" op)
                      (unreachable-node))))))))
