;; AArch64 selection for JavaScript's dynamic-word boundary.
;;
;; Simple has no dynamic value representation, so there is no target node to port here. The graph
;; contract still follows Simple: Box and Unbox are ordinary movable one-result nodes with explicit
;; register masks and exact sizes. Our JavaScript divergence is the NaN-box layout recorded in
;; docs/DECISIONS.md. Integer boxing writes prefix 0x7ff9 and a signed 48-bit payload; integer
;; unboxing sign-extends that payload. A representation not implemented here is rejected by name.
(module aot.node.cpus.arm64.dynamic)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.type.type" :use *)
(import "aot.node.cpus.arm64.base" :use *)

(defn arm64-dynamic-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [op (n-op n)]
    (if (= op OP-BOX)
        (let [value (n-in! n 1)]
          (if (!= (box-tag-of (n-ty value)) TAG-INT)
              (do (panic-i "arm64-dynamic-select: unsupported Box representation"
                           (box-tag-of (n-ty value)))
                  (unreachable-node))
              (let [selected
                      (arm64-scalar-make n OP-BOX ARM64-FORM-BOX-INT 0 ARM64-CLASS-GPR
                                         ARM64-CLASS-GPR 1 false true)]
                (arm64-scalar-unary-input! selected value)
                (arm64-scalar-set-size! selected 8)
                selected)))
        (if (= op OP-UNBOX)
            (if (!= (unbox-rep n) REP-INT)
                (do (panic-i "arm64-dynamic-select: unsupported Unbox representation"
                             (unbox-rep n))
                    (unreachable-node))
                (let [value (n-in! n 1)
                      selected
                        (arm64-scalar-make n OP-UNBOX ARM64-FORM-UNBOX-INT 0 ARM64-CLASS-GPR
                                           ARM64-CLASS-GPR 1 false false)]
                  (arm64-scalar-unary-input! selected value)
                  selected))
            (do (panic-i "arm64-dynamic-select: unsupported ideal opcode" op)
                (unreachable-node))))))
