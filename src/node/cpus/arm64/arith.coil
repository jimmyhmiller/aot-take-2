;; ARM64 arithmetic selection.
;;
;; Final Simple tests the arithmetic mode first, then selects the immediate form only when the RHS
;; is an integer constant encodable by the target. The immediate node drops that constant input:
;; its value lives in the instruction payload and must not acquire a live range. AArch64's field is
;; unsigned even though final Simple's matcher admits signed 12-bit values, so a negative Add/Sub
;; is canonicalized to the opposite opcode with a positive magnitude (`x + -k` -> `x - k`, and
;; `x - -k` -> `x + k`). Register forms retain both value inputs. Commutativity is exposed only for
;; Add and Mul.
(module aot.node.cpus.arm64.arith)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.arith" :use *)
(import "aot.node.constant" :use *)
(import "aot.type.type" :use *)
(import "aot.node.cpus.arm64.base" :use *)

(defn arm64-addsub-imm12? [(v i64)] (-> bool)
  ;; The selected payload is always positive; accept a negative semantic RHS only when its
  ;; magnitude fits the same unsigned field and can be represented without overflow.
  (and (>= v -4095) (<= v 4095)))

(defn arm64-arith-rhs-imm [(n (dyn NodeOps))] (-> (Option i64))
  (if (< (n-nins n) 3)
      (None [i64])
      (let [rhs (n-in! n 2)]
        (if (and (= (n-op rhs) OP-CON)
                 (and (ty-int? (con-ty-of rhs)) (ty-constant? (con-ty-of rhs))))
            (let [v (ty-int-lo (con-ty-of rhs))]
              (if (arm64-addsub-imm12? v) (Some v) (None [i64])))
            (None [i64])))))

(defn arm64-arith-selected [(n (dyn NodeOps))
                             (input-class i64)
                             (output-class i64)
                             (arity i64)
                             (commutative bool)]
                            (-> (dyn NodeOps))
  (arm64-scalar-make n (n-op n) ARM64-FORM-REG 0 input-class output-class arity commutative false))

(defn arm64-arith-select [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [op (n-op n)]
    (if (or (= op OP-ADD) (= op OP-SUB))
        (let [mode (if (= op OP-ADD) (add-mode n) (sub-mode n))]
          (if (= mode MODE-FLT)
              (arm64-arith-selected n ARM64-CLASS-FPR ARM64-CLASS-FPR 2 (= op OP-ADD))
              (match (arm64-arith-rhs-imm n)
                (Some [imm]
                      (let [selected-op
                              (if (< imm 0)
                                  (if (= op OP-ADD) OP-SUB OP-ADD)
                                  op)
                            payload (if (< imm 0) (- 0 imm) imm)
                            m (arm64-scalar-make n selected-op ARM64-FORM-IMM12 payload ARM64-CLASS-GPR
                                                 ARM64-CLASS-GPR 1 false false)]
                        (arm64-scalar-drop-last-input! m)
                        m))
                (None [] (arm64-arith-selected n ARM64-CLASS-GPR ARM64-CLASS-GPR 2 (= op OP-ADD))))))
        (if (= op OP-MUL)
            (let [float (= (mul-mode n) MODE-FLT)]
              (arm64-arith-selected n
                                    (if float ARM64-CLASS-FPR ARM64-CLASS-GPR)
                                    (if float ARM64-CLASS-FPR ARM64-CLASS-GPR)
                                    2
                                    true))
            (if (= op OP-DIV)
                (let [float (= (div-mode n) MODE-FLT)]
                  (arm64-arith-selected n
                                        (if float ARM64-CLASS-FPR ARM64-CLASS-GPR)
                                        (if float ARM64-CLASS-FPR ARM64-CLASS-GPR)
                                        2
                                        false))
                (if (= op OP-MINUS)
                    (arm64-arith-selected n
                                          (if (= (minus-mode n) MODE-FLT)
                                              ARM64-CLASS-FPR
                                              ARM64-CLASS-GPR)
                                          (if (= (minus-mode n) MODE-FLT)
                                              ARM64-CLASS-FPR
                                              ARM64-CLASS-GPR)
                                          1
                                          false)
                    (if (= op OP-TOFLOAT)
                        (arm64-scalar-make n op ARM64-FORM-CONVERT 0 ARM64-CLASS-GPR ARM64-CLASS-FPR
                                           1 false false)
                        (if (= op OP-ROUNDF32)
                            (arm64-scalar-make n op ARM64-FORM-CONVERT 0 ARM64-CLASS-FPR
                                               ARM64-CLASS-FPR 1 false false)
                            (do (panic-i "arm64-arith-select: unsupported ideal opcode" op)
                                (unreachable-node))))))))))
