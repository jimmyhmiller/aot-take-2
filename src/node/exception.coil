;; Exceptions: Throw and the exceptional control edge.

;;
;; Simple has no exceptions at all, so nothing here follows it.
;;
;; An exceptional edge is ORDINARY CONTROL, for the same reason a guard is (see
;; `aot.node.dynamic`): every CFG pass already understands control, and a parallel "exception
;; graph" would need bespoke handling in each of them. A call that may throw is a multi-node with
;; TWO control projections — normal and exceptional — and a `catch` is a Region merging the
;; exceptional projections that reach it.
;;
;; The consequence that has to be respected everywhere: a `try` body's memory state reaching the
;; `catch` is the state at the THROW point, not at the end of the body. Memory phis on the catch
;; Region merge one arm per possible throw site, which is why a try body with many calls has a
;; wide merge and why hoisting a store out of a try is only legal when nothing between can throw.
;;
;; `finally` is not a node kind. It is duplicated onto every path that leaves the block — normal,
;; exceptional, `return`, `break`, `continue` — which is what the specification says it means.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S8.
(module aot.node.exception)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

(defn throw-make [(ctrl (dyn NodeOps)) (mem (dyn NodeOps)) (val (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "throw-make" "S8 — src/node/exception.coil") (unreachable-node)))

;; The exceptional control projection of a node that may throw.
(defn exceptional-proj [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "exceptional-proj" "S8 — src/node/exception.coil") (unreachable-node)))

;; Can this node raise? Decides whether it gets an exceptional projection at all.
(defn may-throw? [(n (dyn NodeOps))] (-> bool)
  (do (unimplemented "may-throw?" "S8 — src/node/exception.coil") false))
