;; Compilation boot and reset.

;;
;; One entry point that puts the process into a known state: the type intern table, the node arena,
;; the GVN table, the worklist seed, and the Constant hook the engine folds through.
;;
;; Tests call `boot!` explicitly rather than relying on `coil test` forking each case. Cross-test
;; leakage should be a visible bug, not a mystery — and a real compiler run compiles more than one
;; thing in one process, so this path has to work anyway.
(module aot.node.boot)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.call" :use *)
(import "aot.node.control" :use [cfg-install-edit-hook!])
(import "aot.node.copy" :use *)
(import "aot.type.type" :use *)
(import "aot.shape" :use *)
(import "aot.heap" :use [heap-reset!])
(import "aot.facts" :use [facts-reset!])
(import "aot.node.dynamic" :use [DYNAMIC-PREFIX-OBJECT])

;; Reset everything and seed the worklist. `seed` drives the randomised pop order; vary it across
;; runs, because a rewrite that is only correct under one order is a broken rewrite.
(defn boot! [(seed i64)] (-> i64)
  (do
    (ty-boot!)
    (shape-reset!)
    (heap-reset! DYNAMIC-PREFIX-OBJECT)
    (facts-reset!)
    (arena-reset! seed)
    (con-install-hook!)
    ;; The control-opcode extension for Fun/Call/CallEnd. Without it, the first control question
    ;; asked of a call node is a named panic — see `cfg-of-ext` in aot.node.control.
    (ctrl-install-call-ext!)
    (copy-install-call-ext!)
    ;; Control-edge edits bump the region idom cache's version; the predicate needs the call
    ;; extension above to classify call-family opcodes.
    (cfg-install-edit-hook!)
    0))
