;; The GC contract in the IR: Safepoint and Barrier.

;;
;; A moving collector is only implementable if the IR was built for it from the start, so its two
;; rules are adopted unconditionally rather than retrofitted:
;;
;; R1. NO INTERIOR POINTER IS LIVE ACROSS A SAFEPOINT. Enforced by construction: address arithmetic
;;     on a managed reference is not a first-class IR value. Load and Store carry (base, offset)
;;     and fold offsets internally, so there is no exposed interior pointer that could leak across
;;     a safepoint. The verifier checks this as the pointer rule in `aot.node.memory`.
;;
;; R2. A SAFEPOINT REDEFINES EVERY LIVE REFERENCE IT RECEIVES. Live refs are INPUTS to the
;;     Safepoint and re-emerge as its PROJECTIONS; every use after the safepoint reads the
;;     projection, not the original. This is the relocation dance, and it cannot be retrofitted
;;     later without touching every pass — which is precisely why it is here on day one, before
;;     there is a collector to justify it.
;;
;; Both rules are machine-checked by the verifier on every phase in tests, not left to discipline.
;;
;; The cost is accepted knowingly: relocation projections make graphs larger and every pass must
;; respect R2. A non-moving collector would pay for generality it does not need.
;;
;; Because a boxed word may CONTAIN a reference (see `aot.node.dynamic`), the stack map records a
;; slot's KIND — raw reference, boxed word, or scalar — not merely whether it is live.
;;
;; SCAFFOLD: signatures are final; bodies hard-error. Filled in at S8.
(module aot.node.gc)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

;; A safepoint over the live reference set. Every live ref goes in; each comes back out as a
;; projection, and uses after this point must read the projection.
(defn safepoint-make [(ctrl (dyn NodeOps)) (mem (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "safepoint-make" "S8 — src/node/gc.coil") (unreachable-node)))

(defn safepoint-add-live! [(sp (dyn NodeOps)) (ref (dyn NodeOps))] (-> i64)
  (do (unimplemented "safepoint-add-live!" "S8 — src/node/gc.coil") 0))

;; The relocated value of the reference that entered at `idx`.
(defn safepoint-relocated [(sp (dyn NodeOps)) (idx i64)] (-> (dyn NodeOps))
  (do (unimplemented "safepoint-relocated" "S8 — src/node/gc.coil") (unreachable-node)))

;; A write barrier on a reference store. Which barrier is chosen at lowering, from the collector
;; policy; the node itself is abstract.
(defn barrier-make [(ctrl (dyn NodeOps))
                    (mem (dyn NodeOps))
                    (obj (dyn NodeOps))
                    (val (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "barrier-make" "S8 — src/node/gc.coil") (unreachable-node)))
