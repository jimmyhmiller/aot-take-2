;; The GC contract in the IR: Safepoint and Barrier.

;;
;; A moving collector is only implementable if the IR was built for it from the start, so its two
;; rules are adopted unconditionally rather than retrofitted:
;;
;; R1. NO INTERIOR POINTER IS LIVE ACROSS A SAFEPOINT. Enforced by construction: address arithmetic
;;     on a managed reference is not a first-class IR value. Load and Store carry (base, offset)
;;     and fold offsets internally, so there is no exposed interior pointer that could leak across
;;     a safepoint. The verifier checks this as the pointer rule in `aot.node.memory`.
;;
;; R2. A SAFEPOINT REDEFINES EVERY LIVE REFERENCE IT RECEIVES. Live refs are INPUTS to the
;;     Safepoint and re-emerge as its PROJECTIONS; every use after the safepoint reads the
;;     projection, not the original. This is the relocation dance, and it cannot be retrofitted
;;     later without touching every pass — which is precisely why it is here on day one, before
;;     there is a collector to justify it.
;;
;; Both rules are machine-checked by the verifier on every phase in tests, not left to discipline.
;;
;; The cost is accepted knowingly: relocation projections make graphs larger and every pass must
;; respect R2. A non-moving collector would pay for generality it does not need.
;;
;; Because a boxed word may CONTAIN a reference (see `aot.node.dynamic`), the stack map records a
;; slot's KIND — raw reference, boxed word, or scalar — not merely whether it is live.
;;
;; Final Simple does not expose these two JavaScript-runtime nodes as a directly portable pair; the
;; representation is this compiler's moving-GC divergence. STATUS: the IR boundary is implemented:
;; Safepoint builds the control/memory/live-reference tuple and stable relocation projections;
;; Barrier validates and preserves control, memory, object and possibly-reference value inputs.
;; Calls and allocations produce typed return-PC maps, explicit Safepoints force writable stack
;; homes and relocation projections, and the Coil runtime consumes those maps in its moving
;; semispace collector. General automatic insertion of explicit loop-backedge Safepoints remains
;; outside this node module.
(module aot.node.gc)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.control" :use *)
(import "aot.type.type" :use *)

(const SAFEPOINT-CTRL 0)

(const SAFEPOINT-MEM 1)

(const SAFEPOINT-LIVE 2)

(const BARRIER-CTRL 0)

(const BARRIER-MEM 1)

(const BARRIER-OBJ 2)

(const BARRIER-VAL 3)

(const BARRIER-KIND-RAW 1)

(const BARRIER-KIND-BOXED 2)

(defstruct SafepointNode [(hdr NodeHdr) (pad i64)])

(defstruct BarrierNode [(hdr NodeHdr) (pad i64)])

(defn safepoint-compute [(sp (dyn NodeOps))] (-> i64)
  (let [a (alloc/malloc-allocator) (mut members) (al-new [i64] a) (mut i) SAFEPOINT-LIVE]
    (push! [i64]
           (mut members)
           (match (n-in sp SAFEPOINT-CTRL) (Some [ctrl] (n-ty ctrl)) (None [] TY-TOP)))
    (push! [i64]
           (mut members)
           (match (n-in sp SAFEPOINT-MEM) (Some [mem] (n-ty mem)) (None [] TY-TOP)))
    (loop (if (>= (load i) (n-nins sp))
              (break 0)
              (do
                (push! [i64]
                       (mut members)
                       (match (n-in sp (load i)) (Some [ref] (n-ty ref)) (None [] TY-TOP)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (ty-tuple (al-slice (load members)))))

(impl NodeOps SafepointNode
  (hdr [(self (ptr SafepointNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr SafepointNode))] (-> (slice u8)) "Safepoint")
  (is-const? [(self (ptr SafepointNode))] (-> bool) false)
  (no-const-fold? [(self (ptr SafepointNode))] (-> bool) true)
  (is-pinned? [(self (ptr SafepointNode))] (-> bool) true)
  (binop-copy [(self (ptr SafepointNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)]))
  (compute [(self (ptr SafepointNode))]
           (-> i64)
           (safepoint-compute (primitive/make-dyn NodeOps self)))
  (idealize [(self (ptr SafepointNode))] (-> (Option (dyn NodeOps))) (None [(dyn NodeOps)]))
  (eq-extra [(self (ptr SafepointNode)) (other (dyn NodeOps))]
            (-> bool)
            (= (n-op other) OP-SAFEPOINT))
  (hash-extra [(self (ptr SafepointNode))] (-> i64) 353))

;; A safepoint over the live reference set. Every live ref goes in; each comes back out as a
;; projection, and uses after this point must read the projection.
(defn safepoint-make [(ctrl (dyn NodeOps)) (mem (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [SafepointNode] (alloc/create [SafepointNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.pad p) 0)
    (n-init! d OP-SAFEPOINT)
    (n-add-def! d (Some ctrl))
    (n-add-def! d (Some mem))
    (n-set-ty! d (compute p))
    d))

(defn safepoint-add-live! [(sp (dyn NodeOps)) (ref (dyn NodeOps))] (-> i64)
  (if (!= (n-op sp) OP-SAFEPOINT)
      (panic-i "safepoint-add-live!: not a Safepoint" (n-op sp))
      (let [idx (- (n-nins sp) SAFEPOINT-LIVE)]
        (n-add-def! sp (Some ref))
        ;; The tuple grows one member while the Safepoint is open. Tuple arities are incomparable,
        ;; exactly like an open Region/Phi changing shape during construction, so this mutation is
        ;; constructional rather than a lattice refinement.
        (n-force-ty! sp (compute sp))
        idx)))

;; The relocated value of the reference that entered at `idx`.
(defn safepoint-relocated [(sp (dyn NodeOps)) (idx i64)] (-> (dyn NodeOps))
  (if (or (!= (n-op sp) OP-SAFEPOINT)
          (< idx 0)
          (>= (+ idx SAFEPOINT-LIVE) (n-nins sp)))
      (do (panic-i "safepoint-relocated: live index out of range" idx) (unreachable-node))
      (let [slot (+ idx SAFEPOINT-LIVE) (mut i) 0 (mut answer) (None [(dyn NodeOps)])]
        (loop (if (or (>= (load i) (n-nouts sp))
                      (match (load answer) (Some [_] true) (None [] false)))
                  (break 0)
                  (do
                    (match (n-out sp (load i))
                      (Some [use]
                            (if (and (= (n-op use) OP-PROJ) (= (proj-idx use) slot))
                                (set! (mut answer) (Some use))
                                0))
                      (None [] 0))
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (match (load answer)
          (Some [relocated] relocated)
          (None [] (proj-make sp slot "relocated"))))))

(impl NodeOps BarrierNode
  (hdr [(self (ptr BarrierNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr BarrierNode))] (-> (slice u8)) "Barrier")
  (is-const? [(self (ptr BarrierNode))] (-> bool) false)
  (no-const-fold? [(self (ptr BarrierNode))] (-> bool) true)
  (is-pinned? [(self (ptr BarrierNode))] (-> bool) true)
  (binop-copy [(self (ptr BarrierNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)]))
  (compute [(self (ptr BarrierNode))]
           (-> i64)
           (match (n-in (primitive/make-dyn NodeOps self) BARRIER-MEM)
             (Some [mem] (n-ty mem))
             (None [] TY-TOP)))
  (idealize [(self (ptr BarrierNode))] (-> (Option (dyn NodeOps))) (None [(dyn NodeOps)]))
  ;; An effect boundary is never value-numbered with another boundary, even over equal operands.
  (eq-extra [(self (ptr BarrierNode)) (other (dyn NodeOps))] (-> bool) (do other false))
  (hash-extra [(self (ptr BarrierNode))] (-> i64) 359))

;; A write barrier on a reference store. Which barrier is chosen at lowering, from the collector
;; policy; the node itself is abstract.
(defn barrier-make [(ctrl (dyn NodeOps))
                    (mem (dyn NodeOps))
                    (obj (dyn NodeOps))
                    (val (dyn NodeOps))] (-> (dyn NodeOps))
  (let [mem-ty (n-ty mem) obj-ty (n-ty obj) val-ty (n-ty val)]
    (if (not (ty-mem? mem-ty))
        (do (panic "barrier-make: memory input is not memory") (unreachable-node))
        (if (not (ty-memptr? obj-ty))
            (do (panic "barrier-make: object input is not a managed reference") (unreachable-node))
            (if (not (or (ty-memptr? val-ty) (ty-dyn? val-ty)))
                (do (panic "barrier-make: value cannot contain a managed reference")
                    (unreachable-node))
                (let [a (alloc/malloc-allocator)
                      p (alloc/unwrap-ptr [BarrierNode] (alloc/create [BarrierNode] a))
                      d (primitive/make-dyn NodeOps p)]
                  (set! (.pad p) 0)
                  (n-init! d OP-BARRIER)
                  (n-add-def! d (Some ctrl))
                  (n-add-def! d (Some mem))
                  (n-add-def! d (Some obj))
                  (n-add-def! d (Some val))
                  (n-set-ty! d mem-ty)
                  d))))))
