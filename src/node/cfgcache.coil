;; CFG edit versioning and the dominator, owner and depth caches it invalidates.

(module aot.node.cfgcache)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use *)
(import "coil.os" :as os)
(import "aot.node.node" :use [NodeOps n-nid n-op n-dead? n-panic!])
(import "aot.node.op" :use *)
(import "aot.node.arena" :use *)

;; ---------------------------------------------------------------------------
;; The control-version counter, and the idepth cache it guards
;;
;; Simple's `validIDepth` / `invalidateIDepthCaches`. Depths are computed lazily on first request
;; and are valid through ordinary construction and peepholes: a new control node starts uncomputed,
;; a Region's depth is one past its deepest input, and folding control away only shortens chains,
;; which keeps every cached depth strictly decreasing along its dominator chain — all the parallel
;; LCA walk needs. Simple bumps the version in exactly one place: inlining, which "blows all cache
;; idepth fields past the inline point". We bump there (both inlining paths) and once at every phase
;; boundary, after a bulk edit such as unlinking or selection is known to have finished.
;;
;; Bumping on every control constructor or path edit is not more correct, only slower: during
;; opto it emptied the cache many times per peephole round, and every dominator query recomputed
;; whole chains (measured as most of opto's time on the test262 harness).
(defn cfg-version [] (-> i64)
  (.ctrl-version (arena)))

;; The edit version below which a cached OWNER is not believed (see the owner cache, further down).
(defstruct CfgOwnerEpoch [(edit-version i64)])

(defn cfg-owner-epoch [] (-> (ptr CfgOwnerEpoch))
  (compiler-state [CfgOwnerEpoch] (primitive/alloc-static CompilerStateSlot)))

;; Depths and dominators only: what an INLINE invalidates. It moves no node out of the Fun the
;; dominator walk finds for it, so every cached owner stays true (the owner cache explains why).
(defn invalidate-cfg-depths! [] (-> i64)
  (do
    (arena-boot!)
    (set! (.ctrl-version (arena)) (+ (.ctrl-version (arena)) 1))
    (set! (.cfg-edit-version (arena)) (+ (.cfg-edit-version (arena)) 1))
    0))

;; Everything, owners included: phase boundaries and bulk rewrites (unlinking, selection, a version
;; or specialization being installed), where no argument about what moved is attempted.
(defn invalidate-cfg! [] (-> i64)
  (do
    (invalidate-cfg-depths!)
    (set! (.edit-version (cfg-owner-epoch)) (.cfg-edit-version (arena)))
    0))

;; ## The region idom cache and its own, finer version
;;
;; Simple does not cache a Region's idom: the LCA of its inputs is recomputed on every request,
;; "linear in the size of the program". Our graphs are deeper (every JSL abstract operation is
;; inlined control), and the two hot walks that ask for it — IfNode's dominating-test hunt and the
;; enclosing-Fun search — ask for every Region on a chain, each of which re-walks the chains of its
;; inputs, so one request was quadratic in the chain depth and opto spent most of its time there.
;;
;; A cached idom is a POINTER, so unlike a depth it cannot survive a control edit anywhere above:
;; a rewired chain changes the LCA while the Region's own inputs are untouched. The cache is
;; therefore guarded by `cfg-edit-version`, bumped by every edge edit or kill of a control node
;; (`n-cfg-edited!`, asked through a hook the control module installs at boot, since node.coil
;; cannot name control opcodes). Data-node edits, the overwhelming majority, leave it alone, so the
;; cache survives across the many peepholes between two control changes.
(defstruct CfgEditHook [(f (fnptr c [(ref (dyn NodeOps))] bool)) (set bool)])

(defn cfg-edit-hook [] (-> (ptr CfgEditHook))
  (compiler-state [CfgEditHook] (primitive/alloc-static CompilerStateSlot)))

(defn set-cfg-edit-hook! [(f (fnptr c [(ref (dyn NodeOps))] bool))] (-> i64)
  (do (set! (.f (cfg-edit-hook)) f) (set! (.set (cfg-edit-hook)) true) 0))

(defn cfg-edit-version [] (-> i64)
  (do (arena-boot!) (.cfg-edit-version (arena))))

;; Selected CFG structs may represent both merges and single-predecessor instructions. The
;; target supplies the distinction; memoizing it by coarse opcode would confuse If with Region.
(defstruct MachineCfgMergeHook
  [(f (fnptr c [(ref (dyn NodeOps))] bool)) (set bool)])

(defn machine-cfg-merge-hook [] (-> (ptr MachineCfgMergeHook))
  (compiler-state [MachineCfgMergeHook]
                  (primitive/alloc-static CompilerStateSlot)))

(defn set-machine-cfg-merge-hook! [(f (fnptr c [(ref (dyn NodeOps))] bool))] (-> i64)
  (set! (.f (machine-cfg-merge-hook)) f)
  (set! (.set (machine-cfg-merge-hook)) true)
  0)

(defn machine-cfg-merge? [(n (dyn NodeOps))] (-> bool)
  (if (.set (machine-cfg-merge-hook))
      (primitive/call-ptr (.f (machine-cfg-merge-hook)) n)
      true))

;; Whether an opcode is control, memoized per opcode: the hook's answer is a function of the
;; opcode alone (a machine kind has one coarse opcode per node struct), and this is asked on every
;; edge edit.
(defstruct CfgOpMemo [(table (ArrayList i64)) (booted bool)])  ; per op: 0 unknown, 1 control, 2 not

(defn cfg-op-memo [] (-> (ptr CfgOpMemo))
  (let [t
          (compiler-state [CfgOpMemo]
                          (primitive/alloc-static CompilerStateSlot))]
    (if (.booted t)
        t
        (do
          (set! (.table t) (al-new [i64] (compiler-allocator)))
          (loop (if (>= (len (.table t)) 512)
                    (break 0)
                    (do (push! [i64] (mut (.table t)) 0) (continue))))
          (set! (.booted t) true)
          t))))

(defn n-cfg-op? [(n (dyn NodeOps))] (-> bool)
  (let [op (n-op n)
        memo (cfg-op-memo)]
    (if (or (< op 0) (>= op 512))
        (primitive/call-ptr (.f (cfg-edit-hook)) n)
        (let [known (get (.table memo) op)]
          (if (= known 0)
              (let [answer (primitive/call-ptr (.f (cfg-edit-hook)) n)]
                (set! (mut (.table memo)) op (if answer 1 2))
                answer)
              (= known 1))))))

;; Does changing input `i` of control node `n` change dominance? A merge (Region, Loop, Fun, Stop)
;; owns a control edge at every input; any other control node only at input 0 (an If's predicate,
;; a Return's value, a Call's arguments are data). A new node's construction (`n-add-def!` on a
;; non-merge) changes nobody's dominance.
(defn n-cfg-control-edge? [(n (dyn NodeOps)) (i i64)] (-> bool)
  (let [op (n-op n)]
    (or (= i 0)
        (= op OP-REGION)
        (= op OP-LOOP)
        (= op OP-FUN)
        (= op OP-STOP)
        (and (= op OP-MACH-CFG) (machine-cfg-merge? n)))))

;; Control edge `i` of `n` is about to change. Bumps the edit version that guards the idom and owner
;; caches. A dying control node does not bump: both caches check the node they name is alive and
;; recompute otherwise, and a kill happens on every folded branch.
(defn n-cfg-edited! [(n (dyn NodeOps)) (i i64)] (-> i64)
  (if (and (.set (cfg-edit-hook)) (n-cfg-control-edge? n i) (n-cfg-op? n))
      (do
        (set! (.cfg-edit-version (arena)) (+ (.cfg-edit-version (arena)) 1))
        0)
      0))

;; Valid when made under the current edit version and the node it names is still alive (a kill
;; does not bump the version).
(defn n-idom-cache-valid? [(n (dyn NodeOps))] (-> bool)
  (and (= (.idom-ver (hdr n)) (cfg-edit-version))
       (let [id (.idom-nid (hdr n))]
         (or (= id 0)
             (match (arena-node id)
               (Some [d] (not (n-dead? d)))
               (None [] false))))))

;; The cached idom; None when the cache says there is none. Ask `n-idom-cache-valid?` first.
(defn n-idom-cached [(n (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [id (.idom-nid (hdr n))]
    (if (= id 0)
        (None [(dyn NodeOps)])
        (match (arena-node id)
          (Some [d] (Some d))
          (None []
                (do
                  (n-panic! "n-idom-cached: cached dominator was collected" n)
                  (None [(dyn NodeOps)])))))))

;; The owner cache. It began under the idom cache's discipline — dead at ANY control edit — and that
;; made the self-recursion check (`fun-self-recursive?`, which asks the owner of every caller of a
;; callee, and a shared runtime function has a caller per call site) re-walk the caller's whole
;; dominator chain after every inline: 48M walk steps and 30M depth recomputations in the inline half
;; of a 500-call-site compile (docs/SCALING.md).
;;
;; An owner is not a dominator. A control edit changes WHICH node dominates; it does not change which
;; Fun a node is in. The walk answers "the first Fun up the dominator chain", and the only way that
;; answer changes for a live node is that Fun going away: an inline folds a Fun (the callee, or the
;; private copy a clone makes) by leaving it ON the chain, marked folding, until the Region rule
;; collapses it — so until it dies it is still the answer the walk would give, and when it dies the
;; liveness test below refuses the entry. Nids are never reused, so a dead owner cannot be mistaken
;; for a live one.
;;
;; So a cached OWNER is good until that Fun dies or `invalidate-cfg!` raises the owner epoch. A cached
;; "no owner" is a different thing — a node not yet wired under any Fun — and keeps the strict
;; discipline: it is believed only under the edit version it was seen in.
(defn n-owner-cache-valid? [(n (dyn NodeOps))] (-> bool)
  (let [id (.owner-nid (hdr n))]
    (if (= id 0)
        (= (.owner-ver (hdr n)) (cfg-edit-version))
        (and (>= (.owner-ver (hdr n)) (.edit-version (cfg-owner-epoch)))
             (match (arena-node id)
               (Some [d] (not (n-dead? d)))
               (None [] false))))))

(defn n-owner-cached-nid [(n (dyn NodeOps))] (-> i64)
  (.owner-nid (hdr n)))

(defn n-set-owner-cache! [(n (dyn NodeOps)) (owner-nid i64)] (-> i64)
  (do
    (set! (.owner-nid (hdr n)) owner-nid)
    (set! (.owner-ver (hdr n)) (cfg-edit-version))
    0))

(defn n-set-idom-cache! [(n (dyn NodeOps)) (idom (Option (dyn NodeOps)))] (-> i64)
  (do
    (set! (.idom-nid (hdr n)) (match idom (Some [d] (n-nid d)) (None [] 0)))
    (set! (.idom-ver (hdr n)) (cfg-edit-version))
    0))

(defn n-idepth-valid? [(n (dyn NodeOps))] (-> bool)
  (= (.idepth-ver (hdr n)) (cfg-version)))

(defn n-idepth-cached [(n (dyn NodeOps))] (-> i64)
  (.idepth (hdr n)))

(defn n-set-idepth! [(n (dyn NodeOps)) (d i64)] (-> i64)
  (do
    (set! (.idepth (hdr n)) d)
    (set! (.idepth-ver (hdr n)) (cfg-version))
    d))
