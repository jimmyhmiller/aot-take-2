;; ============================================================================

;; THE SEA-OF-NODES GRAPH AND THE PEEPHOLE ENGINE
;;   —  core port of Simple's `node/Node.java`
;; ============================================================================
;;
;; ## What a sea of nodes is
;;
;; One graph, no basic blocks, no statement order. A node is an operation; its INPUTS are the values
;; it consumes (use-def edges) and its OUTPUTS are the nodes consuming it (def-use edges). The two
;; directions mirror each other exactly, always — a def-use edge with no matching use-def edge is a
;; corrupt graph, and every later pass reads it as truth.
;;
;; A pure node has no location at all. It floats, defined by its inputs and pinned only by a
;; CONTROL SUBGRAPH threaded through the soup. Blocks do not exist until Global Code Motion invents
;; them (src/codegen/gcm.coil). That is the whole point of the IR: loop-invariant code motion, CSE
;; and partial-redundancy elimination are not passes, they are consequences of nodes having floated
;; and then been placed well.
;;
;; ## Representation
;;
;; A node kind is a struct whose FIRST field is `NodeHdr`, plus an `impl` of `NodeOps`. Header-first
;; means `(cast (ptr NodeHdr) concrete)` and `(cast (ptr Concrete) hdr)` are the same address, so
;; the header is reachable from a trait object and the concrete node from the header.
;;
;; Edges are `(Option (dyn NodeOps))`. The `Option` is deliberate: Simple allows null inputs — a
;; pure node's control slot, an in-progress Region's final path — and an edge that may be absent
;; should say so in the type rather than being a pointer someone forgets to test.
;;
;; Node IDENTITY is the address of the header. Two `(dyn NodeOps)` values denote the same node
;; exactly when `(= (hdr a) (hdr b))`; there is no other identity test.
;;
;; ## The engine, and why every piece of it is load-bearing
;;
;; `peephole` is the whole optimiser. It computes a type, replaces a constant-or-high node with a
;; Constant, probes the GVN table for an existing equal node, and asks the node to idealize itself.
;; Around that sit four mechanisms that are easy to omit and fatal to omit:
;;
;;   KEEP/UNKEEP   A bogus null output edge holds a node alive across surgery. Without it, a node
;;                 returned from a rewrite with no users yet is collected before it is wired in.
;;
;;   KILL/SUBSUME  Killing recursively kills inputs that lost their last use. That IS dead code
;;                 elimination — there is no separate DCE pass.
;;
;;   LOCK/UNLOCK   A node in the GVN table has its hash cached, and the hash depends on its edges.
;;                 Mutating an edge without leaving the table first leaves a stale entry that later
;;                 unifies two nodes that are no longer equal. Every edge mutator calls `unlock`.
;;
;;   DEPS          A peephole that fails its pattern match on something DISTANT registers itself on
;;                 that node. When the distant node changes, the peephole is retried. Without it a
;;                 rewrite that could not fire yet is simply lost — nothing would re-queue it, and
;;                 the missing optimisation is invisible.
;;
;; ## Types RISE here and FALL in Opto — and the assertion differs accordingly
;;
;; This is subtle and worth stating, because getting it backwards makes the assertion useless:
;;
;;   PESSIMISTIC (this file, iterpeeps): types start where parsing left them, LOW, and RISE as
;;   peepholes learn more. `setType` asserts the new type is at least as specific as the old.
;;
;;   OPTIMISTIC (src/codegen/opto.coil): types start at TOP and FALL as reachability is proven.
;;   That loop asserts the opposite direction, plus "never worse than the pessimistic answer".
;;
;; Both are monotone; they move in opposite directions. A single shared assertion would be wrong for
;; one of them.
(module aot.node.node)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use *)
(import "coil.os" :as os)
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-push-i64! sb-str])
(import "aot.util.panic" :use *)
(import "aot.util.ary" :use *)
(import "aot.type.type" :use *)
(import "aot.node.op" :use * :reexport)
(import "aot.node.arena" :use * :reexport)
(import "aot.node.origin" :use * :reexport)
(import "aot.node.gvn" :use * :reexport)
(import "aot.node.peephole" :use * :reexport)
(import "aot.node.cfgcache" :use * :reexport)

;; ---------------------------------------------------------------------------
;; The header
(defstruct NodeHdr
  [(nid i64)  ; dense unique id within a compilation
   (origin i64)  ; diagnostic construction origin; never a semantic/GVN key
   ;; Half-open byte range in retained user source; -1/-1 means no source attribution.
   (source-lo i64)
   (source-hi i64)
   (op i64)  ; OP-*
   (ty i64)  ; interned type id; TY-INVALID means "never computed"
   (pesi-ty i64)  ; bottom-up type saved across the optimistic SCCP pass
   (hash i64)  ; 0 = not in the GVN table, so the edges may still be hacked
   (ins (ArrayList (Option (dyn NodeOps))))  ; use-def, ordered, nulls allowed
   (outs (ArrayList (Option (dyn NodeOps))))  ; def-use; a None entry is a `keep`
   (deps (ArrayList (Option (dyn NodeOps))))  ; far-field peephole dependents
   (idepth i64)  ; cached dominator-tree depth; valid only at `idepth-ver`
   (idepth-ver i64)
   ;; A Region's cached immediate dominator (0 = none); valid only at `idom-ver`, the control
   ;; edit version. See the control-version section.
   (idom-nid i64)
   (idom-ver i64)
   ;; The Fun that owns this control node (0 = none), cached under the same version.
   (owner-nid i64)
   (owner-ver i64)
   ;; Backend CFG metadata. `ltree-head` names the innermost containing loop head; the loop head's
   ;; own header stores its enclosing loop in `ltree-parent`. Start is the root loop head.
   (ltree-head i64)
   (ltree-parent i64)
   (ltree-depth i64)  ; cached depth; 0 is both root depth and "not cached"
   (cfg-pre i64)  ; loop-tree DFS preorder
   (anti i64)  ; GCM anti-dependence walk marker
   (early-nid i64)  ; immutable earliest legal block after GCM's forward walk
   (block-nid i64)  ; GCM-assigned block head; 0 until placement
   (lrg i64)  ; register-allocation live-range id; 0 means no register value
   (reg i64)])  ; assigned physical/stack location; -1 until coloured

;; Every node kind implements this. Methods take `(self (ptr Self))` so the trait is object-safe
;; and `(dyn NodeOps)` is a legal edge.
(deftrait NodeOps [Self]
  ;; The header. Always `(cast (ptr NodeHdr) self)` — header-first is the representation contract.
  (hdr [(self (ptr Self))] (-> (ptr NodeHdr)))

  ;; The monotone type function. MUST NOT recurse into inputs' `compute`: the graph is cyclic and
  ;; that recursion does not terminate. Read inputs' CURRENT `ty` instead.
  (compute [(self (ptr Self))] (-> i64))

  ;; The rewrite. `None` = no change. Calling convention, from Simple, and it matters:
  ;;   - no change            -> None
  ;;   - any change           -> Some, possibly `self`
  ;;   - the RETURNED node does NOT call peephole on itself; `peephole` will
  ;;   - any OTHER new node it builds DOES call peephole
  ;; Every transform must be monotone — each removes some feature — or peepholes loop forever.
  (idealize [(self (ptr Self))] (-> (Option (dyn NodeOps))))

  ;; Debugger/printer label, e.g. "Add".
  (label [(self (ptr Self))] (-> (slice u8)))

  ;; GVN: same opcode and same edges are checked by the engine; this adds the kind's own payload.
  (eq-extra [(self (ptr Self)) (other (dyn NodeOps))] (-> bool))

  ;; GVN: the kind's own payload folded into the hash.
  (hash-extra [(self (ptr Self))] (-> i64))

  ;; Is this node already a constant? A Constant must not be re-replaced by a Constant.
  (is-const? [(self (ptr Self))] (-> bool))

  ;; >>> The in-progress hook. <<<
  ;;
  ;; Simple's `peepholeOpt` refuses constant-replacement for several half-built nodes: a Parm whose
  ;; Fun is still linking, a Load that owns a pending error, a Proj off a CallEnd that is still
  ;; discovering its targets. Folding one of those to a constant destroys information that has not
  ;; arrived yet.
  ;;
  ;; It lives on the trait NOW, with a `false` answer from every pure-value node, so that control
  ;; flow and calls can implement it without reopening this engine.
  (no-const-fold? [(self (ptr Self))] (-> bool))

  ;; Pinned in the schedule: input 0 may not be changed by code motion. Phis and Projs are pinned.
  (is-pinned? [(self (ptr Self))] (-> bool))

  ;; Simple's virtual `copy(lhs, rhs)`: rebuild THIS KIND of scalar operator over new operands,
  ;; preserving whatever payload it carries (an arithmetic mode, a comparison operator). Unary
  ;; nodes consume `lhs` and ignore `rhs`; `None` means this kind is not reconstructible here.
  ;;
  ;; It exists so that a rewrite can be written ONCE over "some binary operator" instead of once per
  ;; kind — `phiCon` pushes a constant up through a Phi and must rebuild the operator on every arm,
  ;; and it has no business knowing which operator it is looking at.
  (binop-copy [(self (ptr Self)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))))

;; ---------------------------------------------------------------------------
;; Header accessors
;;
;; Always go through these. A raw `(.nid (.hdr p))` chain works only on a concrete type and breaks
;; the moment the node arrives as a trait object.
(defn n-nid [(n (dyn NodeOps))] (-> i64)
  (.nid (hdr n)))

(defn n-op [(n (dyn NodeOps))] (-> i64)
  (.op (hdr n)))

(defn n-ty [(n (dyn NodeOps))] (-> i64)
  (.ty (hdr n)))

(defn n-pesi-ty [(n (dyn NodeOps))] (-> i64)
  (.pesi-ty (hdr n)))

(defn n-set-pesi-ty! [(n (dyn NodeOps)) (t i64)] (-> i64)
  (do (set! (.pesi-ty (hdr n)) t) 0))

(defn n-hash-of [(n (dyn NodeOps))] (-> i64)
  (.hash (hdr n)))

(defn n-ltree-head [(n (dyn NodeOps))] (-> i64)
  (.ltree-head (hdr n)))

(defn n-set-ltree-head! [(n (dyn NodeOps)) (head i64)] (-> i64)
  (do (set! (.ltree-head (hdr n)) head) 0))

(defn n-ltree-parent [(n (dyn NodeOps))] (-> i64)
  (.ltree-parent (hdr n)))

(defn n-set-ltree-parent! [(n (dyn NodeOps)) (parent i64)] (-> i64)
  (do (set! (.ltree-parent (hdr n)) parent) (set! (.ltree-depth (hdr n)) 0) 0))

(defn n-ltree-depth [(n (dyn NodeOps))] (-> i64)
  (.ltree-depth (hdr n)))

(defn n-set-ltree-depth! [(n (dyn NodeOps)) (depth i64)] (-> i64)
  (do (set! (.ltree-depth (hdr n)) depth) 0))

(defn n-cfg-pre [(n (dyn NodeOps))] (-> i64)
  (.cfg-pre (hdr n)))

(defn n-set-cfg-pre! [(n (dyn NodeOps)) (pre i64)] (-> i64)
  (do (set! (.cfg-pre (hdr n)) pre) 0))

(defn n-anti [(n (dyn NodeOps))] (-> i64)
  (.anti (hdr n)))

(defn n-set-anti! [(n (dyn NodeOps)) (anti i64)] (-> i64)
  (do (set! (.anti (hdr n)) anti) 0))

(defn n-early-nid [(n (dyn NodeOps))] (-> i64)
  (.early-nid (hdr n)))

(defn n-set-early-nid! [(n (dyn NodeOps)) (early-nid i64)] (-> i64)
  (do (set! (.early-nid (hdr n)) early-nid) 0))

(defn n-block-nid [(n (dyn NodeOps))] (-> i64)
  (.block-nid (hdr n)))

(defn n-set-block-nid! [(n (dyn NodeOps)) (block-nid i64)] (-> i64)
  (do (set! (.block-nid (hdr n)) block-nid) 0))

(defn n-lrg [(n (dyn NodeOps))] (-> i64)
  (.lrg (hdr n)))

(defn n-set-lrg! [(n (dyn NodeOps)) (lrg i64)] (-> i64)
  (do (set! (.lrg (hdr n)) lrg) 0))

(defn n-reg [(n (dyn NodeOps))] (-> i64)
  (.reg (hdr n)))

(defn n-set-reg! [(n (dyn NodeOps)) (reg i64)] (-> i64)
  (do (set! (.reg (hdr n)) reg) 0))

;; Node identity: the header address, and nothing else.
(defn n-same? [(a (dyn NodeOps)) (b (dyn NodeOps))] (-> bool)
  (= (hdr a) (hdr b)))

(defn n-nins [(n (dyn NodeOps))] (-> i64)
  (len (.ins (hdr n))))

(defn n-nouts [(n (dyn NodeOps))] (-> i64)
  (len (.outs (hdr n))))

;; Input `i`, which may legitimately be absent.
(defn n-in [(n (dyn NodeOps)) (i i64)] (-> (Option (dyn NodeOps)))
  (if (or (< i 0) (>= i (n-nins n)))
      (do
        (let [(mut b) (sb-new (compiler-allocator))]
          (sb-push-str! (mut b) "n-in: input index ")
          (sb-push-i64! (mut b) i)
          (sb-push-str! (mut b) " is out of range")
          ;; A dead node still used: name the users, they hold the stale reference.
          (let [(mut oi) 0]
            (loop (if (>= (load oi) (n-nouts n))
                      (break 0)
                      (do
                        (match (n-out n (load oi))
                          (Some [use_]
                                (do (println "  used by: {s}" (n-text use_)) 0))
                          (None [] 0))
                        (set! (mut oi) (+ (load oi) 1))
                        (continue)))))
          (n-panic! (sb-str (mut b)) n))
        (None))
      (get (.ins (hdr n)) i)))

;; Input `i`, which the caller asserts is present. Panics rather than inventing a node.
(defn n-in! [(n (dyn NodeOps)) (i i64)] (-> (dyn NodeOps))
  (match (n-in n i)
    (Some [v] v)
    (None []
          (do
            (let [(mut b) (sb-new (compiler-allocator))]
              (sb-push-str! (mut b) "n-in!: required input ")
              (sb-push-i64! (mut b) i)
              (sb-push-str! (mut b) " is absent")
              (n-panic! (sb-str (mut b)) n))
            (unreachable-node)))))

(defn n-out [(n (dyn NodeOps)) (i i64)] (-> (Option (dyn NodeOps)))
  (if (or (< i 0) (>= i (n-nouts n)))
      (do (panic-i "n-out: output index out of range" i) (None))
      (get (.outs (hdr n)) i)))

(defn n-unused? [(n (dyn NodeOps))] (-> bool)
  (= (n-nouts n) 0))

;; Fully unwired: no uses, no inputs, no type. `kill` establishes this.
(defn n-dead? [(n (dyn NodeOps))] (-> bool)
  (and (n-unused? n) (= (n-nins n) 0) (= (n-ty n) TY-INVALID)))

;; `n-in!` needs SOMETHING in the return position after it panics. Control never reaches here.
;; One node as a line of text: `#nid Label :type <- #a #b _` (an underscore is an absent input),
;; followed by ` @block` when the node has been placed. Robust on a broken graph: a dead node prints
;; as DEAD and inputs are never followed.
(defn n-text-into! [(b (mut StrBuf)) (n (dyn NodeOps))] (-> i64)
  (do
    (sb-push-str! (mut b) "#")
    (sb-push-i64! (mut b) (.nid (hdr n)))
    (sb-push-str! (mut b) " ")
    (sb-push-str! (mut b) (label n))
    (if (n-dead? n)
        (do (sb-push-str! (mut b) " DEAD") 0)
        (do
          (sb-push-str! (mut b) " :")
          (ty-text-into! (mut b) (n-ty n))
          (if (> (n-nins n) 0) (sb-push-str! (mut b) " <-") 0)
          (let [(mut i) 0]
            (loop (if (>= (load i) (n-nins n))
                      (break 0)
                      (do
                        (match (n-in n (load i))
                          (Some [v]
                                (do
                                  (sb-push-str! (mut b) " #")
                                  (sb-push-i64! (mut b) (.nid (hdr v)))))
                          (None [] (sb-push-str! (mut b) " _")))
                        (set! (mut i) (+ (load i) 1))
                        (continue)))))
          (if (!= (n-block-nid n) 0)
              (do
                (sb-push-str! (mut b) " @")
                (sb-push-i64! (mut b) (n-block-nid n)))
              0)
          ;; After allocation: the assigned location as a raw machine-neutral number. Numbers past
          ;; the target's register file are stack slots.
          (if (>= (n-reg n) 0)
              (do (sb-push-str! (mut b) " r") (sb-push-i64! (mut b) (n-reg n)))
              0)
          0))))

;; A node's type for a consumer that needs it computed. Reading an uncomputed type (still
;; TY-INVALID from `n-init!`) is a construction-order bug; name the node instead of failing later
;; inside a type routine with a bare id.
(defn n-ty! [(n (dyn NodeOps))] (-> i64)
  (let [t (n-ty n)]
    (if (= t TY-INVALID)
        (do (n-panic! "n-ty!: the node's type was never computed" n) t)
        t)))

(defn n-text [(n (dyn NodeOps))] (-> (slice u8))
  (let [(mut b) (sb-new (compiler-allocator))]
    (n-text-into! (mut b) n)
    (sb-str (mut b))))

;; Abort naming a node: the message, the node's own line, then one line per input. Every graph
;; invariant failure should route here rather than through an integer-encoded id.
(defn n-panic! [(msg (slice u8)) (n (dyn NodeOps))] (-> i64)
  (do
    (p--str "\naot: PANIC: ")
    (p--str msg)
    (p--str "\n  node:  ")
    (p--str (n-text n))
    (if (> (.origin (hdr n)) 0)
        (let [o (get (.items (node-origins)) (- (.origin (hdr n)) 1))]
          (p--str "\n  origin: ")
          (p--str (.kind o))
          (p--str " ")
          (p--str (.name o))
          (p--str " source ")
          (p--int (.lo o))
          (p--str ":")
          (p--int (.hi o))
          0)
        0)
    (let [(mut i) 0]
      (loop (if (>= (load i) (n-nins n))
                (break 0)
                (do
                  (match (n-in n (load i))
                    (Some [v]
                          (do
                            (p--str "\n  in")
                            (p--int (load i))
                            (p--str ": ")
                            (p--str (n-text v))
                            ;; A memory merge's slices are what a memory node really reads.
                            (if (= (n-op v) OP-MEMMERGE)
                                (let [(mut j) 1]
                                  (loop (if (>= (load j) (n-nins v))
                                            (break 0)
                                            (do
                                              (match (n-in v (load j))
                                                (Some [s]
                                                      (do
                                                        (p--str "\n      slice ")
                                                        (p--int (load j))
                                                        (p--str ": ")
                                                        (p--str (n-text s))))
                                                (None [] 0))
                                              (set! (mut j) (+ (load j) 1))
                                              (continue)))))
                                0)))
                    (None [] 0))
                  (set! (mut i) (+ (load i) 1))
                  (continue)))))
    (p--str "\n")
    (os/_exit (primitive/cast i32 EXIT-PANIC))
    0))

(defn unreachable-node [] (-> (dyn NodeOps))
  (panic "unreachable-node: control reached a post-panic return")
  (unreachable-node))

;; ---------------------------------------------------------------------------
;; Types
;;
;; PESSIMISTIC direction: a type may only RISE (become more specific). See the header.
(defn n-set-ty! [(n (dyn NodeOps)) (t i64)] (-> i64)
  (let [old (n-ty n)]
    (if (= t TY-INVALID)
        (panic-i "n-set-ty!: compute returned TY-INVALID; node op" (n-op n))
        0)
    (if (= old t)
        0
        (do
          (if (and (!= old TY-INVALID) (not (ty-isa? t old)))
              (let [(mut b) (sb-new (compiler-allocator))]
                (sb-push-str! (mut b)
                              "n-set-ty!: monotonicity violated: new type ")
                (ty-text-into! (mut b) t)
                (sb-push-str! (mut b) " is not at least as specific as old ")
                (ty-text-into! (mut b) old)
                (n-panic! (sb-str (mut b)) n))
              0)
          ;; `AOT_TRACE_TOP=1`: narrate a Store or Load whose type rises to TOP — the transient
          ;; that later monotonicity violations fall from.
          (if (and (ty-high? t)
                   (or (= (n-op n) OP-STORE) (= (n-op n) OP-LOAD))
                   (trace-top?))
              (let [(mut i) 0]
                (p--str "\ntrace-top: ")
                (p--str (n-text n))
                (loop (if (>= (load i) (n-nins n))
                          (break 0)
                          (do
                            (match (n-in n (load i))
                              (Some [v]
                                    (do
                                      (p--str "\n    in")
                                      (p--int (load i))
                                      (p--str ": ")
                                      (p--str (n-text v))))
                              (None [] 0))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (p--str "\n")
                0)
              0)
          (set! (.ty (hdr n)) t)
          (code-add-outputs! n)
          (n-move-deps-to-worklist! n)
          0))))

;; Used by Opto, which moves types the OTHER way and does its own assertion.
(defn n-force-ty! [(n (dyn NodeOps)) (t i64)] (-> i64)
  (do
    (if (and (!= t TY-INVALID)
             (ty-high? t)
             (or (= (n-op n) OP-STORE) (= (n-op n) OP-LOAD))
             (trace-top?))
        (do
          (p--str "\ntrace-top (forced): ")
          (p--str (n-text n))
          (p--str "\n")
          0)
        0)
    (set! (.ty (hdr n)) t)
    0))

;; ---------------------------------------------------------------------------
;; Far-field dependencies
;;
;; A peephole that fails its pattern match on a node some distance away registers itself there. If
;; that node ever changes, the peephole is retried.
;;
;; Only registers a dependency at least one step away: an immediate input or output is already
;; re-queued by ordinary edge bookkeeping, so recording it as well is pure overhead.
;; `AOT_TRACE_TOP=1`, read once.
(defstruct TraceTopFlag [(state i64)])

(defn trace-top? [] (-> bool)
  (let [f
          (compiler-state [TraceTopFlag]
                          (primitive/alloc-static CompilerStateSlot))]
    (if (= (.state f) 0)
        (set! (.state f)
              (if (!= (primitive/cast i64 (os/getenv c"AOT_TRACE_TOP")) 0) 1 2))
        0)
    (= (.state f) 1)))

;; The key of a (dep, watcher) pair in the arena's dependency set. The pair is packed into one word
;; and then mixed by a bijection (odd multiply, xor-shift): the set hashes integer keys by value, and
;; unmixed packed keys share their low bits whenever they share a watcher, which put every pair a
;; watcher registers into one probe chain.
(defn n-dep-key [(dep (dyn NodeOps)) (watcher (dyn NodeOps))] (-> i64)
  (let [packed (+ (primitive/ishl (n-nid dep) 32) (n-nid watcher))
        m (primitive/imul packed -7046029254386353131)]
    (primitive/ixor m (primitive/iand (primitive/ishr m 31) 0x1ffffffff))))

;; Dependency registrations ASKED, counted — most are refused as duplicates, and the asking is the
;; cost: 168M of them in a 500-call-site compile (docs/SCALING.md). Deterministic, so gateable.
(defstruct DepAskStat [(asks i64)])

(defn n-dep-ask-stat [] (-> (ptr DepAskStat))
  (compiler-state [DepAskStat] (primitive/alloc-static CompilerStateSlot)))

(defn code-stat-dep-asks [] (-> i64)
  (.asks (n-dep-ask-stat)))

(defn code-stat-dep-asks-reset! [] (-> i64)
  (do (set! (.asks (n-dep-ask-stat)) 0) 0))

(defn n-add-dep! [(dep (dyn NodeOps)) (watcher (dyn NodeOps))] (-> i64)
  (if (.mid-assert (arena))
      ;; An expensive assert re-runs peepholes and must have no side effects.
      0
      (let [key (n-dep-key dep watcher)]
        (set! (.asks (n-dep-ask-stat)) (+ (.asks (n-dep-ask-stat)) 1))
        ;; Simple skips both immediate neighbours, whose ordinary edges already requeue the
        ;; watcher: the watched node as an input of the watcher, and the watcher as an input of the
        ;; watched node. Both are input scans, bounded by arity; the pair set makes the duplicate
        ;; check constant instead of a scan of the dependency list.
        (if (or (hm-contains? (.dep-pairs (arena)) key)
                (n-has? (.ins (hdr watcher)) dep)
                (n-has? (.ins (hdr dep)) watcher))
            0
            (do
              (set! (mut (.dep-pairs (arena))) key true)
              (push! [(Option (dyn NodeOps))]
                     (mut (.deps (hdr dep)))
                     (Some watcher))
              0)))))

;; Simple's `addDepForwards`: unlike `n-add-dep!`, retain a dependency even when the watched node
;; is an immediate INPUT of the watcher. Forward dataflow rules use this when ordinary output
;; scheduling is intentionally insufficient. Existing outputs and duplicate dependencies are still
;; excluded.
(defn n-add-dep-forwards! [(dep (dyn NodeOps)) (watcher (dyn NodeOps))] (-> i64)
  (if (.mid-assert (arena))
      0
      (let [key (n-dep-key dep watcher)]
        (if (or (hm-contains? (.dep-pairs (arena)) key)
                (n-has? (.ins (hdr watcher)) dep))
            0
            (do
              (set! (mut (.dep-pairs (arena))) key true)
              (push! [(Option (dyn NodeOps))]
                     (mut (.deps (hdr dep)))
                     (Some watcher))
              0)))))

(defn n-has? [(l (ArrayList (Option (dyn NodeOps)))) (n (dyn NodeOps))] (-> bool)
  (let [cnt (len l)
        (mut i) 0
        (mut yes) false]
    (loop (if (or (>= (load i) cnt) (load yes))
              (break 0)
              (do
                (match (get l (load i))
                  (Some [v] (if (n-same? v n) (set! (mut yes) true) 0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load yes)))

;; Move the dependents onto the worklist and clear the list for future dependents.
(defn n-move-deps-to-worklist! [(n (dyn NodeOps))] (-> i64)
  (let [cnt (len (.deps (hdr n)))
        (mut i) 0]
    (loop (if (>= (load i) cnt)
              (break 0)
              (do
                (match (get (.deps (hdr n)) (load i))
                  (Some [v]
                        (do
                          (hm-remove! [i64 bool]
                                      (mut (.dep-pairs (arena)))
                                      (n-dep-key n v))
                          (code-add! v)))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (al-clear! [(Option (dyn NodeOps))] (mut (.deps (hdr n))))
    0))

;; ---------------------------------------------------------------------------
;; Edges
;;
;; Inputs and outputs are maintained together, always.
;; ---------------------------------------------------------------------------
;; Steps spent FINDING the use to remove, counted: the removal is O(1) but the find is a scan of the
;; def's outputs, and on a hub — a constant with thousands of users, a Parm with thousands of
;; callers — that scan was ~95% of lodash's compile. `docs/SCALING.md` gates on this number.
(defstruct UseScanStat [(steps i64)])

(defn n-use-scan-stat [] (-> (ptr UseScanStat))
  (compiler-state [UseScanStat] (primitive/alloc-static CompilerStateSlot)))

(defn code-stat-use-scan-steps [] (-> i64)
  (.steps (n-use-scan-stat)))

(defn code-stat-use-scan-steps-reset! [] (-> i64)
  (do (set! (.steps (n-use-scan-stat)) 0) 0))

(defn n-use-scan-count! [(steps i64)] (-> i64)
  (do (set! (.steps (n-use-scan-stat)) (+ (.steps (n-use-scan-stat)) steps)) 0))

;; Position hints for hubs
;;
;; Removing a use is a swap-with-last, O(1); FINDING it is a scan of the def's outputs. Simple scans,
;; and on Simple's programs the list is a handful long. In a closed-world JavaScript unit some defs
;; are HUBS — the `undefined` that pads every call's missing arguments has a use per call per slot
;; and one per linked Parm — and the scan was ~95% of lodash's compile (docs/SCALING.md).
;;
;; So for a def with at least N-USE-HUB outputs the arena remembers where its edges were put. A pair
;; is NOT one edge: the Parm of a function called from N sites with a missing argument uses that
;; `undefined` N times, and measured on the scaling test those duplicates were every miss of a
;; one-position-per-pair table. So each (def, use) pair keeps a STACK of positions — a depth under
;; the pair's key, and the k-th position under the key offset by k.
;;
;; All of it is a HINT and nothing depends on it being right: a position is checked against
;; `outs[p]` before it is believed, any edge of a pair is interchangeable with any other, a stale
;; entry is popped when it is met, and an empty stack falls back to the scan. That is what makes it
;; safe against the backend's direct edits of edge lists, against a hub that was small when its
;; first edges were added, and against two pairs colliding on a key.
(const N-USE-HUB 32)

;; How far down a pair's stack to look for the entry of an edge that just moved, before giving up
;; and pushing a fresh one. The edge that moves is the LAST output, which is nearly always the
;; pair's newest entry.
(const N-USE-MOVE-PROBES 4)

(const N-USE-SLOT-STRIDE 0x9E3779B97F4A7C1)

(const N-USE-KEEP-TAG 0xffffffff)

;; The pair's key. `None` is the KEEP edge — the null output that holds a node alive across surgery
;; — which needs a stack like any other pair: a keep on a hub is held while uses pile up behind it,
;; and measured on the scaling test finding it again was 80% of the remaining scan.
(defn n-use-pos-key [(def_ (dyn NodeOps)) (use_ (Option (dyn NodeOps)))] (-> i64)
  (match use_
    (Some [u] (n-dep-key def_ u))
    (None []
          (let [packed (+ (primitive/ishl (n-nid def_) 32) N-USE-KEEP-TAG)
                m (primitive/imul packed -7046029254386353131)]
            (primitive/ixor m (primitive/iand (primitive/ishr m 31) 0x1ffffffff))))))

(defn n-use-slot-key [(key i64) (k i64)] (-> i64)
  (+ key (primitive/imul (+ k 1) N-USE-SLOT-STRIDE)))

(defn n-use-depth [(key i64)] (-> i64)
  (match (get (.use-pos (arena)) key)
    (Some [c] c)
    (None [] 0)))

(defn n-use-slot [(key i64) (k i64)] (-> i64)
  (match (get (.use-pos (arena)) (n-use-slot-key key k))
    (Some [p] p)
    (None [] -1)))

(defn n-use-pos-note! [(def_ (dyn NodeOps)) (use_ (Option (dyn NodeOps))) (pos i64)] (-> i64)
  (let [key (n-use-pos-key def_ use_)
        depth (n-use-depth key)]
    (set! (mut (.use-pos (arena))) (n-use-slot-key key depth) pos)
    (set! (mut (.use-pos (arena))) key (+ depth 1))
    0))

;; A def has just become a hub: give the edges it collected while it was small their hints, or every
;; one of them is a full scan of the hub later. A pair that already has a stack is left alone, so a
;; def hovering at the threshold does not pile up entries.
(defn n-use-index-small! [(def_ (dyn NodeOps))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) N-USE-HUB)
              (break 0)
              (let [u (get (.outs (hdr def_)) (load i))]
                (if (= (n-use-depth (n-use-pos-key def_ u)) 0)
                    (n-use-pos-note! def_ u (load i))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))))

;; Every output edge is added here, the keep edge included, so every edge of a hub has a hint.
(defn n-add-out! [(def_ (dyn NodeOps)) (use_ (Option (dyn NodeOps)))] (-> i64)
  (let [pos (len (.outs (hdr def_)))]
    (if (= pos N-USE-HUB) (n-use-index-small! def_) 0)
    (push! [(Option (dyn NodeOps))] (mut (.outs (hdr def_))) use_)
    (if (>= pos N-USE-HUB) (n-use-pos-note! def_ use_ pos) 0)
    0))

(defn n-add-use! [(def_ (dyn NodeOps)) (use_ (dyn NodeOps))] (-> i64)
  (n-add-out! def_ (Some use_)))

;; Is `outs[p]` the edge `use_` — that use, or for `None` the keep?
(defn n-out-is? [(def_ (dyn NodeOps)) (p i64) (use_ (Option (dyn NodeOps)))] (-> bool)
  (if (or (< p 0) (>= p (len (.outs (hdr def_)))))
      false
      (match (get (.outs (hdr def_)) p)
        (Some [v]
              (match use_
                (Some [u] (n-same? v u))
                (None [] false)))
        (None []
              (match use_
                (Some [_] false)
                (None [] true))))))

;; Pop the pair's stack down to its newest BELIEVABLE position and return it, or -1 with the stack
;; empty. The returned entry is popped too: the caller is about to remove that edge.
(defn n-use-pos-take! [(def_ (dyn NodeOps)) (use_ (Option (dyn NodeOps)))] (-> i64)
  (let [key (n-use-pos-key def_ use_)
        (mut depth) (n-use-depth key)
        (mut found) -1]
    (if (= (load depth) 0)
        -1
        (do
          (loop (if (or (= (load depth) 0) (>= (load found) 0))
                    (break 0)
                    (let [k (- (load depth) 1)
                          p (n-use-slot key k)]
                      (hm-remove! [i64 i64] (mut (.use-pos (arena))) (n-use-slot-key key k))
                      (set! (mut depth) k)
                      (if (n-out-is? def_ p use_) (set! (mut found) p) 0)
                      (continue))))
          (if (= (load depth) 0)
              (do (hm-remove! [i64 i64] (mut (.use-pos (arena))) key) 0)
              (do (set! (mut (.use-pos (arena))) key (load depth)) 0))
          (load found)))))

;; The edge `moved` that sat at `from` now sits at `to`: repoint its entry. It is looked for near
;; the top of the pair's stack; not found, a fresh entry is pushed and the stale one is dropped when
;; it is next met.
(defn n-use-pos-moved! [(def_ (dyn NodeOps)) (moved (Option (dyn NodeOps))) (from i64) (to i64)]
  (-> i64)
  (let [key (n-use-pos-key def_ moved)
        depth (n-use-depth key)
        (mut k) (- depth 1)
        (mut done) false]
    (loop (if (or (load done) (< (load k) 0) (<= (load k) (- (- depth 1) N-USE-MOVE-PROBES)))
              (break 0)
              (do
                (if (= (n-use-slot key (load k)) from)
                    (do
                      (set! (mut (.use-pos (arena))) (n-use-slot-key key (load k)) to)
                      (set! (mut done) true)
                      0)
                    0)
                (set! (mut k) (- (load k) 1))
                (continue))))
    (if (load done) 0 (n-use-pos-note! def_ moved to))))

;; Remove the output at `p` by swap-with-last, telling the hints about the edge that moved into `p`.
(defn n-del-out-at! [(def_ (dyn NodeOps)) (p i64)] (-> i64)
  (let [outs_ (field (hdr def_) outs)
        last (- (len (load outs_)) 1)]
    (al-del-at! [(Option (dyn NodeOps))] (mut outs_) p)
    (if (and (>= last N-USE-HUB) (< p last))
        (n-use-pos-moved! def_ (get (load outs_) p) last p)
        0)))

;; Find one edge `use_` in `def_`'s outputs and remove it: by hint on a hub, else by a scan that runs
;; NEWEST FIRST — the edges that die are overwhelmingly recent (a node is built, wired, and folded
;; away) and a hub's old edges are the ones that stay. -1 if there is no such edge.
(defn n-del-out! [(def_ (dyn NodeOps)) (use_ (Option (dyn NodeOps)))] (-> i64)
  (let [cnt (len (.outs (hdr def_)))
        hinted (if (< cnt N-USE-HUB) -1 (n-use-pos-take! def_ use_))]
    (if (>= hinted 0)
        (do
          (n-use-scan-count! 1)
          (n-del-out-at! def_ hinted)
          hinted)
        (let [(mut i) (- cnt 1)
              (mut found) -1]
          (loop (if (or (< (load i) 0) (>= (load found) 0))
                    (break 0)
                    (do
                      (if (n-out-is? def_ (load i) use_) (set! (mut found) (load i)) 0)
                      (set! (mut i) (- (load i) 1))
                      (continue))))
          (n-use-scan-count! (- cnt (+ (load i) 1)))
          (if (>= (load found) 0) (n-del-out-at! def_ (load found)) 0)
          (load found)))))

;; Remove ONE occurrence of `use_` from `def_`'s outputs. Returns true if the list is now empty,
;; which is Simple's signal that the def just went dead.
;;
;; A node may legitimately use another twice (`x+x`), so this removes one edge, not all of them.
;; Output order carries no meaning, so the removal is the O(1) swap-with-last.
(defn n-del-use! [(def_ (dyn NodeOps)) (use_ (dyn NodeOps))] (-> bool)
  (do
    (if (< (n-del-out! def_ (Some use_)) 0)
        (broken "n-del-use!: def-use edge missing for a use-def edge")
        0)
    (= (len (.outs (hdr def_))) 0)))

;; Remove one bogus `keep` edge. Returns true if the outputs are now empty.
(defn n-del-keep! [(n (dyn NodeOps))] (-> bool)
  (do
    (if (< (n-del-out! n (None)) 0)
        (broken "n-del-keep!: unkeep on a node that was not kept")
        0)
    (= (len (.outs (hdr n))) 0)))

;; Append an input edge.
(defn n-add-def! [(n (dyn NodeOps)) (d (Option (dyn NodeOps)))] (-> i64)
  (do
    (n-unlock! n)
    (n-cfg-edited! n (len (.ins (hdr n))))
    (push! [(Option (dyn NodeOps))] (mut (.ins (hdr n))) d)
    (match d
      (Some [v] (do (n-add-use! v n) (n-source-merge! n v) 0))
      (None [] 0))))

;; Replace input `i`.
;;
;; ORDER MATTERS, and Simple says why: the new def->use edge is added BEFORE the old one is removed,
;; because removing the old edge may recursively kill the old def, and that cascade could otherwise
;; take the new def with it.
(defn n-set-def! [(n (dyn NodeOps)) (i i64) (d (Option (dyn NodeOps)))] (-> i64)
  (do
    (n-unlock! n)
    (let [ins_ (field (hdr n) ins)]
      (if (or (< i 0) (>= i (len (load ins_))))
          (panic-i "n-set-def!: input index out of range" i)
          (let [old (get (load ins_) i)]
            (if (edge-same? old d)
                0
                (do
                  (n-cfg-edited! n i)
                  (match d (Some [v] (n-add-use! v n)) (None [] 0))
                  (set! (mut ins_) i d)
                  (match old
                    (Some [o]
                          (if (n-del-use! o n)
                              (n-kill! o)  ; lost its last use: dead
                              (code-add! o)))  ; lost a use: revisit
                    (None [] 0))
                  (n-move-deps-to-worklist! n)
                  0)))))))

;; Grow with null inputs through `i`, then set that slot. This is Simple's `setDefX`, used by
;; deserialization and sparse indexed node shapes such as MemMerge.
(defn n-set-def-x! [(n (dyn NodeOps)) (i i64) (d (Option (dyn NodeOps)))] (-> i64)
  (do
    (if (< i 0) (panic-i "n-set-def-x!: negative input index" i) 0)
    (loop (if (> (n-nins n) i)
              (break 0)
              (do (n-add-def! n (None [(dyn NodeOps)])) (continue))))
    (n-set-def! n i d)))

;; Insert an input at `i`, preserving order and all edge multiplicities. ArrayList has no insertion
;; primitive, so reserve one tail slot and shift the values right before installing the new edge.
(defn n-insert-def! [(n (dyn NodeOps)) (i i64) (d (Option (dyn NodeOps)))] (-> i64)
  (do
    (if (or (< i 0) (> i (n-nins n)))
        (panic-i "n-insert-def!: input index out of range" i)
        0)
    (n-unlock! n)
    (let [ins_ (field (hdr n) ins)
          old-len (len (load ins_))]
      (push! [(Option (dyn NodeOps))] (mut ins_) (None [(dyn NodeOps)]))
      (let [(mut j) old-len]
        (loop (if (<= (load j) i)
                  (break 0)
                  (do
                    (set! (mut ins_) (load j) (get (load ins_) (- (load j) 1)))
                    (set! (mut j) (- (load j) 1))
                    (continue)))))
      (set! (mut ins_) i d)
      (match d (Some [v] (n-add-use! v n)) (None [] 0))
      (n-move-deps-to-worklist! n)
      0)))

;; Drop tail inputs until exactly `count` remain. Each edge is removed once; an input losing its
;; final user is recursively collected, exactly as for `setDef` and `kill`.
(defn n-pop-until! [(n (dyn NodeOps)) (count i64)] (-> i64)
  (do
    (if (or (< count 0) (> count (n-nins n)))
        (panic-i "n-pop-until!: target input count out of range" count)
        0)
    (n-unlock! n)
    (loop (if (<= (n-nins n) count)
              (break 0)
              (let [ins_ (field (hdr n) ins)
                    old (get (load ins_) (- (len (load ins_)) 1))]
                (match (pop! (mut ins_)) (Some [_] 0) (None [] 0))
                (match old
                  (Some [v]
                        (if (n-del-use! v n)
                            (n-kill! v)
                            (code-add! v)))
                  (None [] 0))
                (continue))))
    (n-move-deps-to-worklist! n)
    0))

;; Remove input `i`, compressing in place. ORDER-PRESERVING: suitable for Region and Phi, whose
;; input positions are matched to each other.
(defn n-del-def! [(n (dyn NodeOps)) (i i64)] (-> i64)
  (do
    (n-unlock! n)
    (n-cfg-edited! n i)
    (let [ins_ (field (hdr n) ins)
          old (get (load ins_) i)]
      (al-remove-at! [(Option (dyn NodeOps))] (mut ins_) i)
      (match old
        (Some [o]
              (do
                (if (n-del-use! o n) (n-kill! o) 0)
                (n-move-deps-to-worklist! o)
                0))
        (None [] 0)))))

;; ---------------------------------------------------------------------------
;; keep / unkeep — the null output edge
;;
;; A bogus null entry in the outputs holds a node alive across surgery. Mid-rewrite, a freshly built
;; node has no users yet, and anything that triggers a kill cascade would collect it.
(defn n-keep! [(n (dyn NodeOps))] (-> i64)
  (n-add-out! n (None)))

(defn n-unkeep! [(n (dyn NodeOps))] (-> i64)
  (do (n-del-keep! n) 0))

(defn n-kept? [(n (dyn NodeOps))] (-> bool)
  (let [cnt (n-nouts n)
        (mut i) 0
        (mut yes) false]
    (loop (if (or (>= (load i) cnt) (load yes))
              (break 0)
              (do
                (match (get (.outs (hdr n)) (load i))
                  (Some [_] 0)
                  (None [] (set! (mut yes) true)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load yes)))

;; Unkeep, and kill if that was the last thing holding it alive.
(defn n-unkill! [(n (dyn NodeOps))] (-> i64)
  (do (n-unkeep! n) (if (n-unused? n) (n-kill! n) 0)))

;; ---------------------------------------------------------------------------
;; kill / subsume — dead code elimination
;;
;; Killing a node sets every input to null, and any input that just lost its LAST use is killed in
;; turn. That recursion IS dead code elimination; there is no separate pass.
(defn n-kill! [(n (dyn NodeOps))] (-> i64)
  (if (not (n-unused? n))
      (broken "n-kill!: killing a node that still has uses")
      (do
        (n-unlock! n)
        (n-move-deps-to-worklist! n)
        (set! (.ty (hdr n)) TY-INVALID)  ; flag as dead
        (loop (if (= (n-nins n) 0)
                  (break 0)
                  (let [ins_ (field (hdr n) ins)
                        last (get (load ins_) (- (len (load ins_)) 1))]
                    (match (pop! (mut ins_)) (Some [_] 0) (None [] 0))
                    (match last
                      (Some [o]
                            (do
                              (code-add! o)
                              (if (n-del-use! o n) (n-kill! o) 0)))
                      (None [] 0))
                    (continue))))
        0)))

;; Kill a CFG node without swap-removing its control use. The producer's output order can encode
;; projection order, so detach input 0 explicitly and let ordinary kill process the remaining
;; inputs. Call only for an otherwise-unused node.
(defn n-kill-ordered! [(n (dyn NodeOps))] (-> i64)
  (if (not (n-unused? n))
      (broken "n-kill-ordered!: killing a node that still has uses")
      (match (n-in-safe n 0)
        (Some [ctrl]
              (do
                (n-unlock! n)
                (n-del-use-ordered! ctrl n)
                (code-add! ctrl)
                (set! (mut (.ins (hdr n))) 0 (None [(dyn NodeOps)]))
                (n-kill! n)))
        (None [] (n-kill! n)))))

(defn n-del-use-ordered! [(def_ (dyn NodeOps)) (use_ (dyn NodeOps))] (-> i64)
  (let [outs_ (field (hdr def_) outs)
        cnt (len (load outs_))
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) cnt) (load found))
              (break 0)
              (do
                (match (get (load outs_) (load i))
                  (Some [v]
                        (if (n-same? v use_)
                            (do
                              (al-remove-at! [(Option (dyn NodeOps))]
                                             (mut outs_)
                                             (load i))
                              (set! (mut found) true)
                              0)
                            0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (load found) 0 (broken "n-del-use-ordered!: missing def-use edge"))))

;; Replace `self` with `nnn` everywhere, then kill `self`.
;;
;; Walks the outputs from the END, moving each user's edge over. Each user is unlocked first — its
;; hash is about to change — and re-queued along with ITS users, because a rewrite here may unlock
;; one two steps away.
(defn n-subsume! [(n (dyn NodeOps)) (nnn (dyn NodeOps))] (-> i64)
  (if (n-same? n nnn)
      (broken "n-subsume!: node subsumed by itself")
      (do
        (n-source-merge! nnn n)
        (loop (if (= (n-nouts n) 0)
                  (break 0)
                  (let [outs_ (field (hdr n) outs)
                        last (get (load outs_) (- (len (load outs_)) 1))]
                    (match (pop! (mut outs_)) (Some [_] 0) (None [] 0))
                    (match last
                      (Some [u]
                            (do
                              (n-unlock! u)
                              (n-replace-input! u n nnn)
                              (n-add-use! nnn u)
                              (code-add! u)
                              (code-add-outputs! u)
                              0))
                      ;; A `keep` edge moves across too, or the replacement dies mid-surgery.
                      (None [] (do (n-keep! nnn) 0)))
                    (continue))))
        (n-kill! n)
        0)))

;; Point ONE input of `u` that names `old` at `new_`.  The output list has one entry per use, so
;; `n-subsume!` calls this once per popped edge; replacing every duplicate at once would make the
;; next recorded edge fail its invariant check.
(defn n-replace-input! [(u (dyn NodeOps))
                        (old (dyn NodeOps))
                        (new_ (dyn NodeOps))] (-> i64)
  (let [ins_ (field (hdr u) ins)
        cnt (len (load ins_))
        (mut i) 0
        (mut hit) false]
    (loop (if (or (>= (load i) cnt) (load hit))
              (break 0)
              (do
                (match (get (load ins_) (load i))
                  (Some [v]
                        (if (n-same? v old)
                            (do
                              (set! (mut ins_) (load i) (Some new_))
                              (set! (mut hit) true)
                              0)
                            0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (if (load hit)
        0
        (broken "n-replace-input!: user did not name the node it was an output of"))))

;; Initialise a freshly allocated node: assign a nid, set the opcode, give it empty edge lists.
;; Every constructor calls this first.
(defn n-init! [(n (dyn NodeOps)) (opcode i64)] (-> i64)
  (let [a (compiler-allocator)
        h (hdr n)]
    (set! (.origin h) (.current (node-origins)))
    (set! (.op h) opcode)
    (set! (.source-lo h) (.source-lo (arena)))
    (set! (.source-hi h) (.source-hi (arena)))
    (set! (.ty h) TY-INVALID)
    (set! (.pesi-ty h) TY-INVALID)
    (set! (.hash h) 0)
    (set! (.ins h) (al-new [(Option (dyn NodeOps))] a))
    (set! (.outs h) (al-new [(Option (dyn NodeOps))] a))
    (set! (.deps h) (al-new [(Option (dyn NodeOps))] a))
    (set! (.idepth h) 0)
    (set! (.idepth-ver h) 0)
    (set! (.idom-nid h) 0)
    (set! (.idom-ver h) 0)
    (set! (.owner-nid h) 0)
    (set! (.owner-ver h) 0)
    (set! (.ltree-head h) 0)
    (set! (.ltree-parent h) 0)
    (set! (.ltree-depth h) 0)
    (set! (.cfg-pre h) 0)
    (set! (.anti h) 0)
    (set! (.early-nid h) 0)
    (set! (.block-nid h) 0)
    (set! (.lrg h) 0)
    (set! (.reg h) -1)
    (arena-register! n)))

;; Recompute a node's type WITHOUT installing it. Tests use this to observe what `compute` says
;; independently of what the node currently holds — asserting on `n-ty` alone cannot distinguish
;; "compute is right" from "someone set the field".
(defn compute-ty-of [(n (dyn NodeOps))] (-> i64)
  (compute n))

;; Expose the in-progress hook for tests.
(defn no-const-fold-of? [(n (dyn NodeOps))] (-> bool)
  (no-const-fold? n))

;; Are inputs 1.. all constants?
;;
;; Simple's `allCons(dep)`, and the `dep` argument is the point: on the FIRST non-constant input it
;; registers a dependency, so that if that input later becomes constant the rewrite is retried.
;; Without it, a `phiCon` blocked today is never revisited.
(defn n-all-cons? [(n (dyn NodeOps)) (dep (dyn NodeOps))] (-> bool)
  (let [cnt (n-nins n)
        (mut i) 1
        (mut all) true]
    (loop (if (or (>= (load i) cnt) (not (load all)))
              (break 0)
              (do
                (match (n-in n (load i))
                  (Some [v]
                        (if (ty-constant? (n-ty v))
                            0
                            (do (n-add-dep! v dep) (set! (mut all) false) 0)))
                  ;; An open input is not a constant.  There is no producer to depend on yet; the
                  ;; in-progress Phi itself is requeued when its missing edge is installed.
                  (None [] (do (n-add-dep! n dep) (set! (mut all) false) 0)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load all)))

;; Rebuild a binary operator over new operands, or None if this node is not one.
(defn n-binop-copy [(n (dyn NodeOps)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (binop-copy n lhs rhs))

;; Walk the connected graph in Simple's order: node, inputs, outputs. Cycles and duplicate edges
;; are visited once by nid. Return the first node accepted by `pred`, or None after full traversal.
;; The visited state is per call, so nested and consecutive walks cannot leak marks into each other.
(defn n-walk-find [(root (dyn NodeOps))
                   (pred (fnptr c [(ref (dyn NodeOps))] bool))] (-> (Option (dyn NodeOps)))
  (let [a (compiler-allocator)
        cnt (arena-node-count)
        (mut seen) (al-new [bool] a)
        (mut i) 0]
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (push! [bool] (mut seen) false)
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (let [answer (n--walk-find root pred (mut seen))]
      (al-free! [bool] (mut seen))
      answer)))

(defn n--walk-find [(n (dyn NodeOps))
                    (pred (fnptr c [(ref (dyn NodeOps))] bool))
                    (seen (mut (ArrayList bool)))] (-> (Option (dyn NodeOps)))
  (if (get (load seen) (n-nid n))
      (None [(dyn NodeOps)])
      (do
        (set! (mut seen) (n-nid n) true)
        (if (primitive/call-ptr pred n)
            (Some n)
            (match (n--walk-edges n pred (mut seen) true)
              (Some [found] (Some found))
              (None [] (n--walk-edges n pred (mut seen) false)))))))

(defn n--walk-edges [(n (dyn NodeOps))
                     (pred (fnptr c [(ref (dyn NodeOps))] bool))
                     (seen (mut (ArrayList bool)))
                     (inputs bool)] (-> (Option (dyn NodeOps)))
  (let [cnt (if inputs (n-nins n) (n-nouts n))
        (mut i) 0
        (mut answer) (None [(dyn NodeOps)])]
    (loop (if (or (>= (load i) cnt)
                  (match (load answer) (Some [_] true) (None [] false)))
              (break 0)
              (do
                (let [edge (if inputs (n-in n (load i)) (n-out n (load i)))]
                  (match edge
                    (Some [next]
                          (match (n--walk-find next pred (mut seen))
                            (Some [found] (set! (mut answer) (Some found)))
                            (None [] 0)))
                    (None [] 0)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load answer)))

;; Memory-producing nodes among the final opcode set. Proj and Phi additionally become memory once
;; TypeMem exists; until then no live type can express that case.
(defn n-is-mem? [(n (dyn NodeOps))] (-> bool)
  (let [op (n-op n)]
    (or (= op OP-STORE) (= op OP-MEMMERGE) (= op OP-MEMPHI))))

;; Simple's default diagnostic hook. Live node kinds currently have no node-local errors; memory,
;; parser and type-checking nodes extend this once they exist.
(defn n-err [(n (dyn NodeOps))] (-> (Option (slice u8)))
  (None [(slice u8)]))

;; Input `i`, or None when the node simply does not have one.
;;
;; `n-in` PANICS on an out-of-range read, and should: asking for operand 2 of a two-input node is a
;; caller bug. But a node that has been KILLED has no inputs at all, and asking a killed node for its
;; dominator during a graph walk is legitimate — the graph is being rewritten underneath the walk,
;; and "it has no dominator" is the true answer rather than an error.
;;
;; So this is for CONTROL-STRUCTURE questions only. Do not reach for it to silence an out-of-range
;; read on a live node; that read is telling you something.
(defn n-in-safe [(n (dyn NodeOps)) (i i64)] (-> (Option (dyn NodeOps)))
  (if (or (< i 0) (>= i (n-nins n)))
      (None [(dyn NodeOps)])
      (get (.ins (hdr n)) i)))

;; Expose the pinned flag for tests.
(defn is-pinned-of? [(n (dyn NodeOps))] (-> bool)
  (is-pinned? n))
