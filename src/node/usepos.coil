;; Hub-aware reverse-edge indexing and removal.

(module aot.node.usepos)
(import "aot.util.arena" :use [compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use *)
(import "coil.os" :as os)
(import "aot.util.panic" :use *)
(import "aot.util.ary" :use *)
(import "aot.node.arena" :use *)
(import "aot.node.node" :use [NodeOps n-nid n-same? n-dep-key])

;; ---------------------------------------------------------------------------
;; Edges
;;
;; Inputs and outputs are maintained together, always.
;; ---------------------------------------------------------------------------
;; Steps spent FINDING the use to remove, counted: the removal is O(1) but the find is a scan of the
;; def's outputs, and on a hub — a constant with thousands of users, a Parm with thousands of
;; callers — that scan was ~95% of lodash's compile. `docs/SCALING.md` gates on this number.
(defstruct UseScanStat [(steps i64)])

(defn n-use-scan-stat [] (-> (ptr UseScanStat))
  (compiler-state [UseScanStat] (primitive/alloc-static CompilerStateSlot)))

(defn code-stat-use-scan-steps [] (-> i64)
  (.steps (n-use-scan-stat)))

(defn code-stat-use-scan-steps-reset! [] (-> i64)
  (do (set! (.steps (n-use-scan-stat)) 0) 0))

(defn n-use-scan-count! [(steps i64)] (-> i64)
  (do (set! (.steps (n-use-scan-stat)) (+ (.steps (n-use-scan-stat)) steps)) 0))

;; Position hints for hubs
;;
;; Removing a use is a swap-with-last, O(1); FINDING it is a scan of the def's outputs. Simple scans,
;; and on Simple's programs the list is a handful long. In a closed-world JavaScript unit some defs
;; are HUBS — the `undefined` that pads every call's missing arguments has a use per call per slot
;; and one per linked Parm — and the scan was ~95% of lodash's compile (docs/SCALING.md).
;;
;; So for a def with at least N-USE-HUB outputs the arena remembers where its edges were put. A pair
;; is NOT one edge: the Parm of a function called from N sites with a missing argument uses that
;; `undefined` N times, and measured on the scaling test those duplicates were every miss of a
;; one-position-per-pair table. So each (def, use) pair keeps a STACK of positions — a depth under
;; the pair's key, and the k-th position under the key offset by k.
;;
;; All of it is a HINT and nothing depends on it being right: a position is checked against
;; `outs[p]` before it is believed, any edge of a pair is interchangeable with any other, a stale
;; entry is popped when it is met, and an empty stack falls back to the scan. That is what makes it
;; safe against the backend's direct edits of edge lists, against a hub that was small when its
;; first edges were added, and against two pairs colliding on a key.
(const N-USE-HUB 32)

;; How far down a pair's stack to look for the entry of an edge that just moved, before giving up
;; and pushing a fresh one. The edge that moves is the LAST output, which is nearly always the
;; pair's newest entry.
(const N-USE-MOVE-PROBES 4)

(const N-USE-SLOT-STRIDE 0x9E3779B97F4A7C1)

(const N-USE-KEEP-TAG 0xffffffff)

;; The pair's key. `None` is the KEEP edge — the null output that holds a node alive across surgery
;; — which needs a stack like any other pair: a keep on a hub is held while uses pile up behind it,
;; and measured on the scaling test finding it again was 80% of the remaining scan.
(defn n-use-pos-key [(def_ (dyn NodeOps)) (use_ (Option (dyn NodeOps)))] (-> i64)
  (match use_
    (Some [u] (n-dep-key def_ u))
    (None []
          (let [packed (+ (primitive/ishl (n-nid def_) 32) N-USE-KEEP-TAG)
                m (primitive/imul packed -7046029254386353131)]
            (primitive/ixor m
                            (primitive/iand (primitive/ishr m 31) 0x1ffffffff))))))

(defn n-use-slot-key [(key i64) (k i64)] (-> i64)
  (+ key (primitive/imul (+ k 1) N-USE-SLOT-STRIDE)))

(defn n-use-depth [(key i64)] (-> i64)
  (match (get (.use-pos (arena)) key)
    (Some [c] c)
    (None [] 0)))

(defn n-use-slot [(key i64) (k i64)] (-> i64)
  (match (get (.use-pos (arena)) (n-use-slot-key key k))
    (Some [p] p)
    (None [] -1)))

(defn n-use-pos-note! [(def_ (dyn NodeOps))
                       (use_ (Option (dyn NodeOps)))
                       (pos i64)] (-> i64)
  (let [key (n-use-pos-key def_ use_)
        depth (n-use-depth key)]
    (set! (mut (.use-pos (arena))) (n-use-slot-key key depth) pos)
    (set! (mut (.use-pos (arena))) key (+ depth 1))
    0))

;; A def has just become a hub: give the edges it collected while it was small their hints, or every
;; one of them is a full scan of the hub later. A pair that already has a stack is left alone, so a
;; def hovering at the threshold does not pile up entries.
(defn n-use-index-small! [(def_ (dyn NodeOps))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) N-USE-HUB)
              (break 0)
              (let [u (get (.outs (hdr def_)) (load i))]
                (if (= (n-use-depth (n-use-pos-key def_ u)) 0)
                    (n-use-pos-note! def_ u (load i))
                    0)
                (set! (mut i) (+ (load i) 1))
                (continue))))))

;; Every output edge is added here, the keep edge included, so every edge of a hub has a hint.
(defn n-add-out! [(def_ (dyn NodeOps)) (use_ (Option (dyn NodeOps)))] (-> i64)
  (let [pos (len (.outs (hdr def_)))]
    (if (= pos N-USE-HUB) (n-use-index-small! def_) 0)
    (push! [(Option (dyn NodeOps))] (mut (.outs (hdr def_))) use_)
    (if (>= pos N-USE-HUB) (n-use-pos-note! def_ use_ pos) 0)
    0))

(defn n-add-use! [(def_ (dyn NodeOps)) (use_ (dyn NodeOps))] (-> i64)
  (n-add-out! def_ (Some use_)))

;; Is `outs[p]` the edge `use_` — that use, or for `None` the keep?
(defn n-out-is? [(def_ (dyn NodeOps)) (p i64) (use_ (Option (dyn NodeOps)))] (-> bool)
  (if (or (< p 0) (>= p (len (.outs (hdr def_)))))
      false
      (match (get (.outs (hdr def_)) p)
        (Some [v]
              (match use_
                (Some [u] (n-same? v u))
                (None [] false)))
        (None []
              (match use_
                (Some [_] false)
                (None [] true))))))

;; Pop the pair's stack down to its newest BELIEVABLE position and return it, or -1 with the stack
;; empty. The returned entry is popped too: the caller is about to remove that edge.
(defn n-use-pos-take! [(def_ (dyn NodeOps)) (use_ (Option (dyn NodeOps)))] (-> i64)
  (let [key (n-use-pos-key def_ use_)
        (mut depth) (n-use-depth key)
        (mut found) -1]
    (if (= (load depth) 0)
        -1
        (do
          (loop (if (or (= (load depth) 0) (>= (load found) 0))
                    (break 0)
                    (let [k (- (load depth) 1)
                          p (n-use-slot key k)]
                      (hm-remove! [i64 i64]
                                  (mut (.use-pos (arena)))
                                  (n-use-slot-key key k))
                      (set! (mut depth) k)
                      (if (n-out-is? def_ p use_) (set! (mut found) p) 0)
                      (continue))))
          (if (= (load depth) 0)
              (do (hm-remove! [i64 i64] (mut (.use-pos (arena))) key) 0)
              (do (set! (mut (.use-pos (arena))) key (load depth)) 0))
          (load found)))))

;; The edge `moved` that sat at `from` now sits at `to`: repoint its entry. It is looked for near
;; the top of the pair's stack; not found, a fresh entry is pushed and the stale one is dropped when
;; it is next met.
(defn n-use-pos-moved! [(def_ (dyn NodeOps))
                        (moved (Option (dyn NodeOps)))
                        (from i64)
                        (to i64)] (-> i64)
  (let [key (n-use-pos-key def_ moved)
        depth (n-use-depth key)
        (mut k) (- depth 1)
        (mut done) false]
    (loop (if (or (load done)
                  (< (load k) 0)
                  (<= (load k) (- (- depth 1) N-USE-MOVE-PROBES)))
              (break 0)
              (do
                (if (= (n-use-slot key (load k)) from)
                    (do
                      (set! (mut (.use-pos (arena)))
                            (n-use-slot-key key (load k))
                            to)
                      (set! (mut done) true)
                      0)
                    0)
                (set! (mut k) (- (load k) 1))
                (continue))))
    (if (load done) 0 (n-use-pos-note! def_ moved to))))

;; Remove the output at `p` by swap-with-last, telling the hints about the edge that moved into `p`.
(defn n-del-out-at! [(def_ (dyn NodeOps)) (p i64)] (-> i64)
  (let [outs_ (field (hdr def_) outs)
        last (- (len (load outs_)) 1)]
    (al-del-at! [(Option (dyn NodeOps))] (mut outs_) p)
    (if (and (>= last N-USE-HUB) (< p last))
        (n-use-pos-moved! def_ (get (load outs_) p) last p)
        0)))

;; Find one edge `use_` in `def_`'s outputs and remove it: by hint on a hub, else by a scan that runs
;; NEWEST FIRST — the edges that die are overwhelmingly recent (a node is built, wired, and folded
;; away) and a hub's old edges are the ones that stay. -1 if there is no such edge.
(defn n-del-out! [(def_ (dyn NodeOps)) (use_ (Option (dyn NodeOps)))] (-> i64)
  (let [cnt (len (.outs (hdr def_)))
        hinted (if (< cnt N-USE-HUB) -1 (n-use-pos-take! def_ use_))]
    (if (>= hinted 0)
        (do
          (n-use-scan-count! 1)
          (n-del-out-at! def_ hinted)
          hinted)
        (let [(mut i) (- cnt 1)
              (mut found) -1]
          (loop (if (or (< (load i) 0) (>= (load found) 0))
                    (break 0)
                    (do
                      (if (n-out-is? def_ (load i) use_)
                          (set! (mut found) (load i))
                          0)
                      (set! (mut i) (- (load i) 1))
                      (continue))))
          (n-use-scan-count! (- cnt (+ (load i) 1)))
          (if (>= (load found) 0) (n-del-out-at! def_ (load found)) 0)
          (load found)))))

;; Remove ONE occurrence of `use_` from `def_`'s outputs. Returns true if the list is now empty,
;; which is Simple's signal that the def just went dead.
;;
;; A node may legitimately use another twice (`x+x`), so this removes one edge, not all of them.
;; Output order carries no meaning, so the removal is the O(1) swap-with-last.
(defn n-del-use! [(def_ (dyn NodeOps)) (use_ (dyn NodeOps))] (-> bool)
  (do
    (if (< (n-del-out! def_ (Some use_)) 0)
        (broken "n-del-use!: def-use edge missing for a use-def edge")
        0)
    (= (len (.outs (hdr def_))) 0)))

;; Remove one bogus `keep` edge. Returns true if the outputs are now empty.
(defn n-del-keep! [(n (dyn NodeOps))] (-> bool)
  (do
    (if (< (n-del-out! n (None)) 0)
        (broken "n-del-keep!: unkeep on a node that was not kept")
        0)
    (= (len (.outs (hdr n))) 0)))
