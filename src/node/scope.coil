;; ============================================================================

;; THE SCOPE NODE  —  port of Simple's `node/ScopeNode.java` and `Var.java`
;;
;; SSA construction, done DURING parsing. There is no separate SSA pass.
;; ============================================================================
;;
;; ## Why a scope is a NODE
;;
;; It is not part of the final graph — the parser discards it. It is a node so that a variable
;; binding is an ORDINARY USE-DEF EDGE, which makes "read the current value of x" a single array
;; index instead of a symbol-table walk, and makes the scope a real user of every value it holds so
;; nothing it binds can be collected out from under it.
;;
;; Slot 0 is control. Slot 1 is memory. Slots 2.. are the variables, and `_vars` maps 1-to-1 onto
;; the inputs array. Memory is deliberately just another parser-state value in a slot: at a loop
;; head it gets the SAME lazy-Phi treatment as any variable, with no special case.
;;
;; ## LAZY PHIS — the trick that makes this affordable
;;
;; `dup` does NOT create a Phi per variable. It copies the bindings, and for a loop it stores a
;; SENTINEL — the scope itself — in each non-final slot. Reading through a sentinel triggers Phi
;; creation ON DEMAND, so a Phi appears only for a variable actually assigned on more than one path.
;;
;; Without this, a loop over a scope with fifty live variables creates fifty Phis on entry and the
;; peepholes spend their time deleting forty-nine of them. Final variables skip the sentinel
;; entirely — they cannot be reassigned, so they can never need a Phi.
;;
;; `dup` also `keep()`s every non-CFG guard, so that the accounting still balances when the guards
;; are later removed together.
;;
;; ## THE LOOP PROTOCOL — get this wrong and the loop vanishes silently
;;
;;     1. `scope-dup` the entry scope for the body, with the loop sentinel
;;     2. build the body, INSIDE the Loop's in-progress window
;;     3. peephole the body — still inside the window
;;     4. `scope-end-loop!` — fill in every Phi's back edge
;;     5. only THEN wire the Loop's control back edge
;;
;; Simple's `endLoop` asserts `loop.inProgress()` on entry, sets the control back edge, fills the
;; Phi back edges, kills the back-edge scope, and then does a one-time useless-Phi removal.
;;
;; `_endLoop` has one subtlety worth copying exactly: if a variable's DECLARED type is
;; high-or-constant and its current binding is not an in-progress Phi, no Phi is made at all —
;; the value is subsumed by the constant, because nothing can lift higher than a constant.
;;
;; Close control before the Phis and the loop is DELETED WITH NO ERROR REPORTED: the Phi momentarily
;; reads its declared zero because the back-edge value has no type yet, `i+1` folds to the literal
;; 1, the Phi loses its only other user, and the whole loop goes. Every step locally justified.
;;
;; ## MERGING AT A JOIN
;;
;; `mergeScopes` builds a Region over the two control edges, then `_merge` walks the slots and
;; creates a Phi ONLY where the two scopes disagree. A name can only differ at the innermost level
;; where it is bound, which is what makes the walk linear rather than a per-level search.
;;
;; ## GUARDS — where a TypeScript annotation and a runtime `typeof` become the same mechanism
;;
;; `addGuards` refines the bindings on the edge where a predicate is known true. After
;; `if (typeof x === "number")`, the slot for `x` ON THAT EDGE holds a Cast, so every later read
;; gets the narrowed value with no further analysis. Simple's example is `if (ptr) ptr.field;` being
;; legal because `ptr` is known non-null there.
;;
;; Simple is candid about the limits, and we inherit them rather than pretending otherwise:
;;
;; > "This operation is LEXICAL, not semantic, and thus its behavior changes the language spec.
;; > Optimizations that hide the lexical structure (e.g. constant folding control flow) can hide
;; > what is guarded or how the guard is applied, making it somewhat fragile."
;;
;; Its known gap: `if (!ary || !ary#) exit();` guards the whole expression but loses that `ary`
;; alone is non-null. Simple suggests a dedicated logical-expression node or a gather-of-checked-
;; values. For TypeScript this matters more than it does for Simple, because narrowing is a language
;; feature users rely on — so this is a place we will likely need to go beyond Simple, and that
;; will be a decision to record rather than a drift.
;;
;; ## Var
;;
;; Simple's comment: "The tracked fields are now complex enough to deserve a array-of-structs
;; layout." Declared name and type, slot index, final, forward-reference, and a parser-only
;; definite-initialisation marker. The `uninit` flag is parser-only because the binding's NULLABLE
;; TYPE carries the path-sensitive state through SSA merges — the type system does the work, and
;; the flag only catches the syntactic case.
;;
;; SCAFFOLD: signatures and the protocol above are final; bodies hard-error. Filled in at S2.
(module aot.node.scope)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

;; Fixed slots. Everything from SCOPE-VAR0 up is a variable.
(const SCOPE-CTRL 0)

(const SCOPE-MEM 1)

(const SCOPE-VAR0 2)

;; A tracked binding. Array-of-structs because the parser touches all of these together.
(defstruct Var
  [(name (slice u8))
   (idx i64)  ; slot in the containing scope; matches the inputs array 1-to-1
   (declared i64)  ; declared type
   (final bool)  ; cannot be reassigned, so can never need a Phi
   (fref bool)  ; a forward reference, not yet resolved
   (uninit bool)])  ; parser-only definite-assignment marker; the type carries the real state

(defn scope-make [] (-> (dyn NodeOps))
  (do (unimplemented "scope-make" "S2 — src/node/scope.coil") (unreachable-node)))

;; ---------------------------------------------------------------------------
;; Lexical nesting
(defn scope-push! [(s (dyn NodeOps))] (-> i64)
  (do (unimplemented "scope-push!" "S2 — src/node/scope.coil") 0))

(defn scope-pop! [(s (dyn NodeOps))] (-> i64)
  (do (unimplemented "scope-pop!" "S2 — src/node/scope.coil") 0))

;; ---------------------------------------------------------------------------
;; Bindings
(defn scope-define! [(s (dyn NodeOps))
                     (name (slice u8))
                     (declared i64)
                     (final bool)
                     (init (dyn NodeOps))] (-> i64)
  (do (unimplemented "scope-define!" "S2 — src/node/scope.coil") 0))

;; Read a binding. Reading through a loop SENTINEL is what creates the lazy Phi.
(defn scope-lookup [(s (dyn NodeOps)) (name (slice u8))] (-> (Option (dyn NodeOps)))
  (do (unimplemented "scope-lookup" "S2 — src/node/scope.coil") (None)))

(defn scope-update! [(s (dyn NodeOps)) (name (slice u8)) (v (dyn NodeOps))] (-> i64)
  (do (unimplemented "scope-update!" "S2 — src/node/scope.coil") 0))

(defn scope-ctrl [(s (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "scope-ctrl" "S2 — src/node/scope.coil") (unreachable-node)))

(defn scope-set-ctrl! [(s (dyn NodeOps)) (c (dyn NodeOps))] (-> i64)
  (do (unimplemented "scope-set-ctrl!" "S2 — src/node/scope.coil") 0))

;; Memory is an ordinary slot, so it gets the lazy-Phi machinery for free.
(defn scope-mem [(s (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "scope-mem" "S2 — src/node/scope.coil") (unreachable-node)))

;; ---------------------------------------------------------------------------
;; Duplication and merging

;; Duplicate for a branch or a loop body. When `for-loop`, non-final slots get the SENTINEL that
;; triggers lazy Phi creation on first read.
(defn scope-dup [(s (dyn NodeOps)) (for-loop bool)] (-> (dyn NodeOps))
  (do (unimplemented "scope-dup" "S2 — src/node/scope.coil") (unreachable-node)))

;; Build the Region and create a Phi only where the two scopes disagree.
(defn scope-merge! [(a (dyn NodeOps)) (b (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "scope-merge!" "S2 — src/node/scope.coil") (unreachable-node)))

;; Fill in every Phi's back edge, kill the back-edge scope, remove useless Phis.
;; MUST run before the Loop's control back edge is wired.
(defn scope-end-loop! [(entry (dyn NodeOps)) (back (dyn NodeOps)) (exit (dyn NodeOps))] (-> i64)
  (do (unimplemented "scope-end-loop!" "S2 — src/node/scope.coil") 0))

;; ---------------------------------------------------------------------------
;; Guards — lexical narrowing on a tested edge
(defn scope-add-guards! [(s (dyn NodeOps))
                         (ctrl (dyn NodeOps))
                         (pred (dyn NodeOps))
                         (invert bool)] (-> i64)
  (do (unimplemented "scope-add-guards!" "S2 — src/node/scope.coil") 0))

(defn scope-remove-guards! [(s (dyn NodeOps)) (ctrl (dyn NodeOps))] (-> i64)
  (do (unimplemented "scope-remove-guards!" "S2 — src/node/scope.coil") 0))
