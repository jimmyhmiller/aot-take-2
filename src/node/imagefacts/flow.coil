;; How image objects flow through the graph: projections, call targets and results, paired writes, loads, and per-op effects.

(module aot.node.imagefacts.flow)
(import "aot.util.arena" :use [compiler-allocator])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.os" :as os)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use [keyref-local])
(import "aot.node.control" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.property" :use *)
(import "aot.node.call" :use *)
(import "aot.node.jsops" :use *)
(import "aot.heap" :use *)
(import "aot.shape" :use *)
(import "aot.facts" :use *)
(import "aot.type.type" :use *)
(import "aot.node.imagefacts.scan" :use *)

;; Only a symbolic key supplies identity evidence. A runtime integer (including a constant with
;; the same numeric value as a local ID) cannot establish which name program assembly will bind.
(defn scan--key-operand [(k (dyn NodeOps))] (-> i64)
  (keyref-local k))

(defn scan--value-proj! [(nid i64) (multi (dyn NodeOps)) (idx i64)] (-> i64)
  (let [op (n-op multi)]
    (if (or (= op OP-PROPLOAD) (= op OP-PROPSTORE))
        (if (!= idx PROP-RESULT-VALUE)
            0
            (if (= (prop-access-kind multi) PROP-LOAD)
                (scan--read-into! nid
                                  (n-nid (n-in! multi PROP-OBJECT))
                                  (prop-access-key multi))
                (if (= (prop-access-kind multi) PROP-STORE)
                    (scan--copy-into! nid (n-nid (n-in! multi PROP-VALUE)))
                    ;; The holder of a key is some prototype along the chain, or null.
                    (if (= (prop-access-kind multi) PROP-HOLDER)
                        (scan--add-all-prototypes-into! nid)
                        ;; [[Get]] reads the key on the owner or on some prototype; the fast Set
                        ;; answers the value it stored.
                        (if (= (prop-access-kind multi) PROP-GET)
                            (scan--read-chain-into! nid
                                                    (n-nid (n-in! multi
                                                                  PROP-OBJECT))
                                                    (prop-access-key multi))
                            (if (= (prop-access-kind multi) PROP-SET)
                                (scan--copy-into! nid
                                                  (n-nid (n-in! multi
                                                                PROP-VALUE)))
                                0))))))
        (if (= op OP-JSOP)
            (let [prim (jsop-prim multi)]
              (if (!= idx 2)
                  0
                  (if (= prim JS-PROP-GET-OWN)
                      (scan--read-into! nid
                                        (n-nid (n-in! multi JSOP-ARG0))
                                        (scan--key-operand (n-in! multi
                                                                  (+ JSOP-ARG0
                                                                     1))))
                      (if (= prim JS-PROP-GET)
                          (scan--read-chain-into! nid
                                                  (n-nid (n-in! multi JSOP-ARG0))
                                                  (scan--key-operand (n-in! multi
                                                                            (+ JSOP-ARG0
                                                                               1))))
                          (if (= prim JS-PROP-SET)
                              (scan--copy-into! nid
                                                (n-nid (n-in! multi
                                                              (+ JSOP-ARG0 2))))
                              (if (= prim JS-PROP-CHAIN-HOLDER)
                                  (scan--add-all-prototypes-into! nid)
                                  (if (= prim JS-GET-PROTOTYPE)
                                      (let [owner
                                              (n-nid (n-in! multi JSOP-ARG0))
                                            n (scan--count owner)
                                            (mut i) 0]
                                        (if (scan--top? owner)
                                            (scan--add-all-prototypes-into! nid)
                                            0)
                                        (loop (if (>= (load i) n)
                                                  (break 0)
                                                  (do
                                                    (scan--add-prototype-into! nid
                                                                               (scan--entry-at owner
                                                                                               (load i)))
                                                    (set! (mut i)
                                                          (+ (load i) 1))
                                                    (continue)))))
                                      ;; A primitive whose result is not a dyn or object word — a fresh array or
                                      ;; string, a number, a boolean — denotes no image object.
                                      (if (scan--jsop-object-result? prim)
                                          (scan--set-top! nid)
                                          0))))))))
            (if (= op OP-NEW)
                0
                (if (= op OP-CALLEND)
                    (if (= idx RETURN-VALUE)
                        (scan--call-result-into! nid (cend-call multi))
                        0)
                    (scan--set-top! nid)))))))

;; ---------------------------------------------------------------------------
;; Calls

;; The Funs a Call may reach: the linked Returns' owners, else the finite set its pointer's type
;; names. Empty means unknown.
(defn scan--call-targets [(c (dyn NodeOps))] (-> (ArrayList i64))
  (let [(mut funs) (al-new [i64] (compiler-allocator))]
    (match (call-cend c)
      (Some [e]
            (let [(mut i) 1]
              (loop (if (>= (load i) (n-nins e))
                        (break 0)
                        (do
                          (match (n-in e (load i))
                            (Some [ret]
                                  (match (return-fun ret)
                                    (Some [fun]
                                          (do
                                            (push! [i64] (mut funs) (n-nid fun))
                                            0))
                                    (None [] 0)))
                            (None [] 0))
                          (set! (mut i) (+ (load i) 1))
                          (continue))))))
      (None [] 0))
    (if (> (len (load funs)) 0)
        0
        (let [ft (n-ty (call-fptr c))]
          (if (and (ty-funptr? ft) (not (ty-funptr-high? ft)))
              (let [count (ty-funptr-target-count ft)
                    (mut i) 0]
                (loop (if (>= (load i) count)
                          (break 0)
                          (do
                            (match (arena-function (ty-funptr-target-at ft
                                                                        (load i)))
                              (Some [fun]
                                    (if (= (n-op fun) OP-FUN)
                                        (do
                                          (push! [i64] (mut funs) (n-nid fun))
                                          0)
                                        0))
                              (None [] 0))
                            (set! (mut i) (+ (load i) 1))
                            (continue)))))
              0)))
    (load funs)))

;; A generic writer must not form the Cartesian product of its receiver and key parameters:
;; calls write(f, a) and write(g, c) do not write f.c. Preserve the pair through direct formal
;; forwarding, substituting both operands at the SAME call. Other dataflow and external callers
;; retain the conservative transfer. This is an image-facts divergence, not JSL-name knowledge.
;; Index linked AND finite unlinked callers once; cache terminal operands while the immutable
;; graph's points-to sets reach their fixpoint. Seen pairs terminate recursive forwarding.
(defn scan--index-callers! [] (-> i64)
  (let [s (imagescan)
        (mut i) 1]
    (loop (if (> (load i) (arena-node-count))
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [c]
                        (if (and (not (n-dead? c)) (= (n-op c) OP-CALL))
                            (al-for [fnid (scan--call-targets c)]
                                    (let [(mut callers)
                                            (match (get (.callers s) fnid)
                                              (Some [xs] xs)
                                              (None []
                                                    (al-new [(dyn NodeOps)]
                                                            (compiler-allocator))))]
                                      (push! [(dyn NodeOps)] (mut callers) c)
                                      (set! (mut (.callers s))
                                            fnid
                                            (load callers))))
                            0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))))

(defn scan--write-owner [(n (dyn NodeOps))] (-> (dyn NodeOps))
  (let [(mut v) (load n)]
    (loop (let [op (n-op (load v))]
            (if (or (= op OP-BOX) (= op OP-UNBOX) (= op OP-CAST))
                (do (set! (mut v) (n-in! (load v) 1)) (continue))
                (break (load v)))))))

(defn scan--write-pairs [(n (dyn NodeOps))] (-> (ArrayList ImageWritePair))
  (let [s (imagescan)
        a (compiler-allocator)
        (mut work) (al-new [ImageWritePair] a)
        (mut result) (al-new [ImageWritePair] a)
        (mut seen) (hm-new [i64 (HashMap i64 bool)] a (i64-keyops))
        (mut i) 0]
    (push! [ImageWritePair]
           (mut work)
           (ImageWritePair :owner (n-in! n JSOP-ARG0)
             :key (n-in! n (+ JSOP-ARG0 1))))
    (loop (if (>= (load i) (len (load work)))
              (break 0)
              (let [pair (get (load work) (load i))
                    owner (scan--write-owner (.owner pair))
                    key (.key pair)
                    onid (n-nid owner)
                    knid (n-nid key)
                    (mut keys)
                      (match (get (load seen) onid)
                        (Some [ks] ks)
                        (None [] (hm-new [i64 bool] a (i64-keyops))))]
                (if (hm-contains? (load keys) knid)
                    0
                    (do
                      (set! (mut keys) knid true)
                      (set! (mut seen) onid (load keys))
                      (let [(mut expanded) false]
                        (if (and (= (n-op key) OP-PARM)
                                 (= (n-op owner) OP-PARM)
                                 (= (n-nid (parm-fun key))
                                    (n-nid (parm-fun owner))))
                            (let [fun (parm-fun key)
                                  os (parm-call-slot owner)
                                  ks (parm-call-slot key)]
                              (if (and (= (n-op fun) OP-FUN)
                                       (not (scan--fun-open? fun))
                                       (>= os CALL-ARG0)
                                       (>= ks CALL-ARG0))
                                  (match (get (.callers s) (n-nid fun))
                                    (Some [cs]
                                          (do
                                            (set! (mut expanded) true)
                                            (al-for [c cs]
                                                    (if (and (< os
                                                                (- (n-nins c) 1))
                                                             (< ks
                                                                (- (n-nins c) 1)))
                                                        (do
                                                          (push! [ImageWritePair]
                                                                 (mut work)
                                                                 (ImageWritePair :owner
                                                                                   (n-in! c
                                                                                          os)
                                                                   :key
                                                                     (n-in! c
                                                                            ks)))
                                                          0)
                                                        (set! (mut expanded)
                                                              false)))))
                                    (None [] 0))
                                  0))
                            0)
                        (if (load expanded)
                            0
                            (do
                              (push! [ImageWritePair]
                                     (mut result)
                                     (ImageWritePair :owner owner :key key))
                              0)))))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut (.writes s)) (n-nid n) (load result))
    (load result)))

(defn scan--paired-write! [(n (dyn NodeOps))] (-> i64)
  (let [pairs
          (match (get (.writes (imagescan)) (n-nid n))
            (Some [xs] xs)
            (None [] (scan--write-pairs n)))]
    (al-for [item pairs]
            (let [pair item]
              (scan--write! (n-nid (.owner pair))
                            (scan--key-operand (.key pair))))))
  0)

;; The value a call yields: the union of its targets' Return values.
(defn scan--call-result-into! [(nid i64) (c (dyn NodeOps))] (-> i64)
  (let [funs (scan--call-targets c)]
    (if (or (= (len funs) 0) (call-has-external-target? c))
        (scan--set-top! nid)
        (al-for [fnid funs]
                (match (arena-node fnid)
                  (Some [fun]
                        (match (fun-ret fun)
                          (Some [ret]
                                (match (n-in ret RETURN-VALUE)
                                  (Some [v] (scan--copy-into! nid (n-nid v)))
                                  (None [] 0)))
                          (None [] 0)))
                  (None [] 0))))))

;; Without a unit-private visibility contract, outside code can reach the image through globals
;; and retained values. Seed the same mutation boundary for incoming callers and outgoing imports.
;; This includes descriptors/prototypes: marking just data writes would still license stale
;; fixed-layout and inherited-property proofs. Repeat the seed on every facts recomputation.
(defn scan--external-mutation! [] (-> i64)
  (scan--note! (facts-mark-unknown-owner-any!))
  (scan--note! (facts-mark-prototypes-written!))
  (scan--note! (facts-mark-descriptors!))
  (scan--note! (facts-mark-deletes!))
  (let [(mut entry) 0]
    (loop (if (>= (load entry) (heap-count))
              (break 0)
              (do
                (scan--note! (facts-mark-escaped! (load entry)))
                (scan--note! (facts-mark-any-key! (load entry)))
                (set! (mut entry) (+ (load entry) 1))
                (continue)))))
  0)

;; Each argument flows into the matching Parm of every target; with no known target, it escapes.
(defn scan--call-flow! [(c (dyn NodeOps))] (-> i64)
  (let [funs (scan--call-targets c)]
    ;; A mixed local/imported target set can still pass these arguments outside this graph.
    ;; Propagate to local parameters as well; the external branch must not hide that flow.
    (if (call-has-external-target? c)
        (do
          (scan--escape-inputs-from! c CALL-ARG0)
          ;; The unsummarized import can reach realm globals without receiving an argument.
          ;; Image templates have no unit-private visibility contract yet: none may supply a
          ;; closed-program property/prototype/descriptor proof across this boundary.
          (scan--external-mutation!))
        0)
    (if (= (len funs) 0)
        (scan--escape-inputs-from! c CALL-ARG0)
        (al-for [fnid funs]
                (match (arena-node fnid)
                  (Some [fun]
                        (let [(mut o) 0]
                          (loop (if (>= (load o) (n-nouts fun))
                                    (break 0)
                                    (do
                                      (match (n-out fun (load o))
                                        (Some [p]
                                              (if (= (n-op p) OP-PARM)
                                                  (let [slot (parm-call-slot p)]
                                                    (if (and (>= slot CALL-ARG0)
                                                             (< slot
                                                                (- (n-nins c) 1)))
                                                        (scan--copy-into! (n-nid p)
                                                                          (n-nid (n-in! c
                                                                                        slot)))
                                                        0))
                                                  0))
                                        (None [] 0))
                                      (set! (mut o) (+ (load o) 1))
                                      (continue))))))
                  (None [] 0))))))

(defn scan--load! [(nid i64) (n (dyn NodeOps))] (-> i64)
  (let [alias (load-alias n)
        ptr_ (n-nid (n-in! n MEM-PTR))
        count (scan--count ptr_)]
    (if (= alias ALIAS-OBJECT-PROTOTYPE)
        (let [(mut i) 0]
          (if (scan--top? ptr_) (scan--add-all-prototypes-into! nid) 0)
          (loop (if (>= (load i) count)
                    (break 0)
                    (do
                      (scan--add-prototype-into! nid
                                                 (scan--entry-at ptr_ (load i)))
                      (set! (mut i) (+ (load i) 1))
                      (continue)))))
        (if (= alias ALIAS-OBJECT-PROPERTIES)
            (do (scan--copy-into! nid ptr_) (scan--set-storage! nid))
            (if (or (= alias ALIAS-OBJECT-SHAPE)
                    (= alias ALIAS-STRING-LENGTH)
                    (= alias ALIAS-STRING-DATA)
                    (= alias ALIAS-FUNCTION-CODE)
                    (= alias ALIAS-FUNCTION-FLAGS)
                    (= alias ALIAS-ARRAY-LENGTH))
                0
                (if (>= alias ALIAS-FIRST-PROPERTY)
                    (if (scan--storage? ptr_)
                        (scan--read-into! nid ptr_ (shape-alias-key-id alias))
                        (scan--set-top! nid))
                    (if (and (= alias ALIAS-BULK) (scan--storage? ptr_))
                        (scan--read-into! nid ptr_ -1)
                        (scan--set-top! nid))))))))

(defn scan--visit! [(n (dyn NodeOps))] (-> i64)
  (let [nid (n-nid n)
        op (n-op n)]
    (if (= op OP-STATICREF)
        (if (= (staticref-rep n) REP-STRING)
            0
            (scan--add! nid (staticref-entry n)))
        (if (or (= op OP-BOX) (= op OP-UNBOX) (= op OP-CAST))
            (scan--copy-into! nid (n-nid (n-in! n 1)))
            (if (or (= op OP-PHI) (= op OP-PARM))
                (let [(mut i) 1
                      ;; A Parm's input 1 is the unknown-caller seed while its Fun keeps the hook;
                      ;; a Fun the closed world will close contributes only its real callers.
                      skip-hook
                        (and (= op OP-PARM)
                             (fun-unknown-callers? (parm-fun n))
                             (not (scan--fun-open? (parm-fun n))))]
                  (loop (if (>= (load i) (n-nins n))
                            (break 0)
                            (do
                              (match (n-in n (load i))
                                (Some [v]
                                      (if (and skip-hook (= (load i) 1))
                                          0
                                          (scan--copy-into! nid (n-nid v))))
                                (None [] 0))
                              (set! (mut i) (+ (load i) 1))
                              (continue)))))
                (if (= op OP-PROJ)
                    (scan--value-proj! nid (n-in! n 0) (proj-idx n))
                    (if (= op OP-LOAD)
                        (scan--load! nid n)
                        (if (or (= op OP-TYPETEST)
                                (= op OP-CON)
                                (= op OP-KEYREF)
                                (= op OP-SHAPEREF)
                                (= op OP-FUNPTR)
                                (= op OP-EQ)
                                (= op OP-NE)
                                (= op OP-LT)
                                (= op OP-LE)
                                (= op OP-ULT))
                            0
                            (scan--set-top! nid)))))))))

;; May this primitive's value result be an object the program already holds? Its declared result
;; type says: a dyn word may; a raw string or array pointer is a fresh allocation; anything else
;; is a number or a boolean.
(defn scan--jsop-object-result? [(prim i64)] (-> bool)
  (let [t (jsop-result-ty prim)]
    (or (ty-dyn? t) (= t (raw-object-ty)) (= t (raw-function-ty)))))

;; A jsop whose operands the analysis follows: reads of the object model, and pure predicates.
(defn scan--jsop-read? [(prim i64)] (-> bool)
  (or (= prim JS-PROP-GET-OWN)
      (= prim JS-PROP-HAS-OWN)
      (= prim JS-OBJECT-KEYS)
      (= prim JS-OBJECT-OWN-NAMES)
      ;; The copied elements already escaped into the array.
      (= prim JS-ARGUMENT-TAIL)
      (= prim JS-GET-PROTOTYPE)
      (= prim JS-PROP-ATTRIBUTES)
      (= prim JS-IS-EXTENSIBLE)
      (= prim JS-TEST-INTEGRITY)
      (= prim JS-PROP-CHAIN-HOLDER)
      (= prim JS-PROP-GET)
      ;; An array is never an image object; an element read yields TOP through the result rule.
      (= prim JS-ARRAY-LOAD)
      (= prim JS-ARRAY-HAS)
      (= prim JS-ARRAY-SET-LENGTH)
      (= prim JS-ARRAY-INDEX-OF-STRING)
      (= prim JS-KEY-ARRAY-INDEX)
      ;; An array is never an image object; a hole leaves no escape.
      (= prim JS-ARRAY-DELETE)
      (= prim JS-IS-UNDEFINED)
      (= prim JS-IS-NULL)
      (= prim JS-IS-BOOL)
      (= prim JS-IS-INT)
      (= prim JS-IS-FLT)
      (= prim JS-IS-STRING)
      (= prim JS-IS-SYMBOL)
      (= prim JS-IS-OBJECT)
      (= prim JS-IS-ARRAY)
      (= prim JS-IS-FUNCTION)))

(defn scan--store-effects! [(n (dyn NodeOps))] (-> i64)
  (let [alias (mem-alias-of-node n)
        ptr_ (n-nid (n-in! n MEM-PTR))
        count (scan--count ptr_)]
    (scan--escape-node! (n-in! n STORE-VAL))
    (if (= alias ALIAS-OBJECT-PROTOTYPE)
        (if (or (scan--top? ptr_) (> count 0))
            (scan--note! (facts-mark-prototypes-written!))
            0)
        (if (>= alias ALIAS-FIRST-PROPERTY)
            (if (scan--storage? ptr_)
                (scan--write! ptr_ (shape-alias-key-id alias))
                (scan--write! ptr_ -1))
            (if (or (= alias ALIAS-OBJECT-PROPERTIES) (= alias ALIAS-BULK))
                (scan--write! ptr_ -1)
                0)))))

(defn scan--op-in? [(op i64) (ops (ArrayList i64))] (-> bool)
  (let [(mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) (len ops)))
              (break (load found))
              (do
                (if (= (get ops (load i)) op) (set! (mut found) true) 0)
                (set! (mut i) (+ (load i) 1))
                (continue))))))

;; Nodes whose operands the transfer follows or that carry no object operand at all: nothing they
;; do lets a value reach code the analysis does not see.
(defn scan--inert-ops [] (-> (ArrayList i64))
  (let [(mut ops) (al-new [i64] (compiler-allocator))]
    (push! [i64] (mut ops) OP-BOX)
    (push! [i64] (mut ops) OP-UNBOX)
    (push! [i64] (mut ops) OP-CAST)
    (push! [i64] (mut ops) OP-TYPETEST)
    (push! [i64] (mut ops) OP-PHI)
    (push! [i64] (mut ops) OP-PROJ)
    (push! [i64] (mut ops) OP-CPROJ)
    (push! [i64] (mut ops) OP-LOAD)
    (push! [i64] (mut ops) OP-CON)
    (push! [i64] (mut ops) OP-PARM)
    (push! [i64] (mut ops) OP-FUNPTR)
    (push! [i64] (mut ops) OP-IF)
    (push! [i64] (mut ops) OP-REGION)
    (push! [i64] (mut ops) OP-LOOP)
    (push! [i64] (mut ops) OP-START)
    (push! [i64] (mut ops) OP-STOP)
    (push! [i64] (mut ops) OP-FUN)
    (push! [i64] (mut ops) OP-MEMMERGE)
    (push! [i64] (mut ops) OP-MEMPHI)
    (push! [i64] (mut ops) OP-READONLY)
    (push! [i64] (mut ops) OP-NEW)
    (push! [i64] (mut ops) OP-EQ)
    (push! [i64] (mut ops) OP-NE)
    (push! [i64] (mut ops) OP-LT)
    (push! [i64] (mut ops) OP-LE)
    (push! [i64] (mut ops) OP-ULT)
    (push! [i64] (mut ops) OP-NOT)
    (push! [i64] (mut ops) OP-CALLEND)
    (push! [i64] (mut ops) OP-NEVER)
    (push! [i64] (mut ops) OP-XCTRL)
    (load ops)))

(defn scan--effects! [(n (dyn NodeOps)) (inert (ArrayList i64))] (-> i64)
  (let [op (n-op n)]
    (if (or (= op OP-PROPLOAD) (= op OP-PROPSTORE))
        (if (or (= (prop-access-kind n) PROP-STORE)
                (= (prop-access-kind n) PROP-SET))
            (do
              (scan--write! (n-nid (n-in! n PROP-OBJECT)) (prop-access-key n))
              (scan--escape-node! (n-in! n PROP-VALUE)))
            0)
        (if (= op OP-STORE)
            (scan--store-effects! n)
            (if (= op OP-CALL)
                (scan--call-flow! n)
                (if (= op OP-RETURN)
                    ;; The value reaches the callers' result projections; it leaves the analysed
                    ;; program only through the external caller hook.
                    (match (return-fun n)
                      (Some [fun]
                            (if (scan--fun-open? fun)
                                (scan--escape-inputs-from! n RETURN-VALUE)
                                0))
                      (None [] (scan--escape-inputs-from! n RETURN-VALUE)))
                    (if (= op OP-JSOP)
                        (let [prim (jsop-prim n)]
                          (if (or (= prim JS-PROP-SET-OWN)
                                  (= prim JS-PROP-SET-OWN-ATTRS)
                                  (= prim JS-PROP-SET)
                                  (= prim JS-PROP-DEFINE))
                              (do
                                (if (= prim JS-PROP-DEFINE)
                                    (scan--note! (facts-mark-descriptors!))
                                    0)
                                (scan--paired-write! n)
                                (scan--escape-node! (n-in! n (+ JSOP-ARG0 2))))
                              ;; A delete is a write of its key that may leave the key absent: the
                              ;; shape-presence folds of every written key stop holding.
                              (if (= prim JS-PROP-DELETE)
                                  (do
                                    (scan--note! (facts-mark-deletes!))
                                    (scan--paired-write! n))
                                  ;; Freezing, sealing or closing an object changes every key's attributes: a write
                                  ;; of every key, and descriptors exist.
                                  (if (or (= prim JS-OBJECT-INTEGRITY)
                                          (= prim JS-PREVENT-EXTENSIONS))
                                      (do
                                        (scan--note! (facts-mark-descriptors!))
                                        (scan--write! (n-nid (n-in! n JSOP-ARG0))
                                                      -1))
                                      (if (= prim JS-ARRAY-STORE)
                                          ;; The element value escapes into the array; the array itself is read.
                                          (scan--escape-at! n
                                                            (+ JSOP-ARG0 2)
                                                            (n-in! n
                                                                   (+ JSOP-ARG0
                                                                      2)))
                                          (if (scan--jsop-read? prim)
                                              0
                                              (do
                                                (if (= prim JS-SET-PROTOTYPE)
                                                    (scan--note! (facts-mark-prototypes-written!))
                                                    0)
                                                (scan--escape-inputs-from! n
                                                                           JSOP-ARG0))))))))
                        (if (scan--op-in? op inert)
                            0
                            ;; Everything else hands its operands to code the analysis does not follow.
                            (scan--escape-inputs-from! n 0)))))))))
