;; The primitive layer JSL bottoms out on.

;;
;; JSL definitions are written against ECMA-262 and call primitives spelled `%Name`. Those
;; primitives are NOT one node kind each — that is exactly the design this project rejects, because
;; a builtin costing an opcode plus an arm in compute, idealize, verify, print, eval and select is
;; ten dispatch sites per builtin across a thousand-builtin language.
;;
;; Instead there is ONE node kind here, `JsOp`, carrying a primitive index. The op count grows with
;; the MACHINE surface (about sixty operations, all of them below), and the ECMAScript surface
;; grows in `jsl/*.jsl` at zero dispatch arms per entry.
;;
;; A primitive earns its place here only if it is a machine or runtime capability: something the
;; graph cannot express in terms of other nodes. `%StringConcat` qualifies. `Array.prototype.map`
;; does not, and is a JSL definition built out of these.
;;
;; SCAFFOLD: the primitive table and signatures are final; bodies hard-error. Filled in at S5.
(module aot.node.jsops)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)

;; --- tag inspection: the questions a guard asks ---
(const JS-IS-UNDEFINED 1)

(const JS-IS-NULL 2)

(const JS-IS-BOOL 3)

(const JS-IS-INT 4)

(const JS-IS-FLT 5)

(const JS-IS-STRING 6)

(const JS-IS-SYMBOL 7)

(const JS-IS-OBJECT 8)

(const JS-IS-ARRAY 9)

(const JS-IS-FUNCTION 10)

;; --- strings: the runtime capability, not the ECMA-262 algorithms ---
(const JS-STRING-LEN 20)

(const JS-STRING-CONCAT 21)

(const JS-STRING-CHARCODE 22)

(const JS-STRING-FROMCODE 23)

(const JS-STRING-EQ 24)

(const JS-STRING-COMPARE 25)

(const JS-STRING-INDEXOF 26)

(const JS-SUBSTRING 27)

(const JS-STRING-NEW 28)

(const JS-STRING-NORMALIZE 29)

;; --- number formatting and parsing: correctly-rounded conversion is a capability ---
(const JS-NUMBER-TO-STRING 40)

(const JS-PARSE-INT 41)

(const JS-PARSE-FLOAT 42)

(const JS-TO-FIXED 43)

;; --- math the machine provides ---
(const JS-SQRT 50)

(const JS-SIN 51)

(const JS-COS 52)

(const JS-TAN 53)

(const JS-ASIN 54)

(const JS-ACOS 55)

(const JS-ATAN 56)

(const JS-EXP 57)

(const JS-LOG 58)

(const JS-POW 59)

(const JS-FLOOR 60)

(const JS-CEIL 61)

(const JS-ROUND 62)

(const JS-RANDOM 63)

;; --- the object model's irreducible operations ---
(const JS-GET-PROTOTYPE 70)

(const JS-SET-PROTOTYPE 71)

(const JS-OWN-KEY-COUNT 72)

(const JS-OWN-KEY-AT 73)

(const JS-PROP-ATTRIBUTES 74)

(const JS-SET-PROP-ATTRIBUTES 75)

(const JS-FREEZE 76)

(const JS-PREVENT-EXTENSIONS 77)

(const JS-IS-EXTENSIBLE 78)

;; Build a JsOp. `prim` is one of the constants above; arity is fixed per primitive and checked.
(defn jsop-make [(ctrl (dyn NodeOps)) (mem (dyn NodeOps)) (prim i64)] (-> (dyn NodeOps))
  (do (unimplemented "jsop-make" "S5 — src/node/jsops.coil") (unreachable-node)))

(defn jsop-add-arg! [(n (dyn NodeOps)) (arg (dyn NodeOps))] (-> i64)
  (do (unimplemented "jsop-add-arg!" "S5 — src/node/jsops.coil") 0))

;; The primitive index a JsOp carries. Panics on any other node kind.
(defn jsop-prim [(n (dyn NodeOps))] (-> i64)
  (do (unimplemented "jsop-prim" "S5 — src/node/jsops.coil") 0))

;; Does this primitive transition — may it call back into JavaScript or move the heap? This is
;; what decides where a Safepoint goes and which references it relocates.
(defn jsop-transitioning? [(prim i64)] (-> bool)
  (do (unimplemented "jsop-transitioning?" "S5 — src/node/jsops.coil") false))
