;; The primitive layer JSL bottoms out on.

;;
;; JSL definitions are written against ECMA-262 and call primitives spelled `%Name`. Those
;; primitives are NOT one node kind each — that is exactly the design this project rejects, because
;; a builtin costing an opcode plus an arm in compute, idealize, verify, print, eval and select is
;; ten dispatch sites per builtin across a thousand-builtin language.
;;
;; Instead there is ONE node kind here, `JsOp`, carrying a primitive index. The op count grows with
;; the MACHINE surface (about sixty operations, all of them below), and the ECMAScript surface
;; grows in `jsl/*.jsl` at zero dispatch arms per entry.
;;
;; A primitive earns its place here only if it is a machine or runtime capability: something the
;; graph cannot express in terms of other nodes. `%StringConcat` qualifies. `Array.prototype.map`
;; does not, and is a JSL definition built out of these.
;;
;; Unlike Simple's scalar machine operations, JavaScript runtime capabilities need a closed family
;; whose member identity survives until target selection. This is the documented JavaScript
;; divergence: one pinned `(control,memory,value)` multi carries the capability index, while the algorithms
;; choosing and composing those capabilities remain ordinary JSL graphs.
(module aot.node.jsops)
(import "coil.str" :use [sb-new sb-push-str! sb-push-i64! sb-str])
(import "aot.util.panic" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "aot.node.node" :use *)
(import "aot.type.type" :use *)
(import "aot.node.dynamic" :use *)

;; --- tag inspection: the questions a guard asks ---
(const JS-IS-UNDEFINED 1)

(const JS-IS-NULL 2)

(const JS-IS-BOOL 3)

(const JS-IS-INT 4)

(const JS-IS-FLT 5)

(const JS-IS-STRING 6)

(const JS-IS-SYMBOL 7)

(const JS-IS-OBJECT 8)

(const JS-IS-ARRAY 9)

(const JS-IS-FUNCTION 10)

;; --- strings: the runtime capability, not the ECMA-262 algorithms ---
(const JS-STRING-LEN 20)

(const JS-STRING-CONCAT 21)

(const JS-STRING-CHARCODE 22)

(const JS-STRING-FROMCODE 23)

(const JS-STRING-EQ 24)

(const JS-STRING-COMPARE 25)

(const JS-STRING-INDEXOF 26)

(const JS-SUBSTRING 27)

(const JS-STRING-NEW 28)

(const JS-STRING-NORMALIZE 29)

;; --- number formatting and parsing: correctly-rounded conversion is a capability ---
;; One operand, a boxed number word (compact integer or double); Number::toString(x, 10) as a fresh
;; string. Transitioning: it allocates.
(const JS-NUMBER-TO-STRING 40)

(const JS-PARSE-INT 41)

(const JS-PARSE-FLOAT 42)

(const JS-TO-FIXED 43)

;; --- math the runtime provides (aot.rt.number, MATH-OP-*) ---
;; (op int, x number word) -> number word: one of the unary Math functions, chosen by `op`.
(const JS-MATH-UNARY 50)

;; (op int, x number word, y number word) -> number word: pow, atan2, hypot.
(const JS-MATH-BINARY 51)

;; () -> number word in [0, 1).
(const JS-MATH-RANDOM 63)

;; --- the object model's irreducible operations ---
(const JS-GET-PROTOTYPE 70)

(const JS-SET-PROTOTYPE 71)

(const JS-OWN-KEY-COUNT 72)

(const JS-OWN-KEY-AT 73)

(const JS-PROP-ATTRIBUTES 74)

(const JS-SET-PROP-ATTRIBUTES 75)

(const JS-FREEZE 76)

(const JS-PREVENT-EXTENSIONS 77)

(const JS-IS-EXTENSIBLE 78)

;; --- abrupt completion: the runtime's throw entries; neither returns normally ---
(const JS-THROW 80)

;; A TypeError raised by the compiler-recognized guards (calling a non-callable value). It carries
;; no operand: the message is the runtime's, and the guard's own value is not observable.
(const JS-THROW-TYPE-ERROR 81)

;; No operand. The runtime half of a compiler invariant: control reached an arm the compiler proved
;; impossible (docs/DECISIONS.md, realm). Aborts; never a JavaScript completion.
(const JS-TRAP-INVARIANT 84)

;; No operand. A JavaScript semantic this compiler does not implement yet was reached at run time
;; (ToPrimitive on an object in arithmetic). Hard error naming the semantic, so every arithmetic
;; guard chain is total and provable while the missing piece stays a runtime refusal.
(const JS-TRAP-TO-PRIMITIVE 85)

;; No operand. ToString of a non-string operand (string concatenation) is unimplemented.
(const JS-TRAP-TO-STRING 86)

;; One operand, a raw string. StringToNumber (ECMA-262 §7.1.4.1.1): the trimmed spelling's Number
;; as a boxed number word (compact integer or double), NaN for anything outside the grammar.
;; Correctly rounded decimal conversion is a capability (aot.rt.number). Not transitioning: it
;; allocates nothing.
(const JS-STRING-TO-NUMBER 44)

;; No operand. A non-strict function reached `this` with an undefined receiver in a function-entry
;; program, which has no global object to bind.
(const JS-TRAP-NO-REALM 88)

;; No operand. The `Function` constructor compiles source text at run time; this compiler is
;; ahead-of-time and has no evaluator (docs/DESIGN.md, strictly AOT). A hard refusal.
(const JS-TRAP-DYNAMIC-CODE 90)

;; (object raw, prototype): the object's own property keys as a fresh array of strings, in shape
;; order (insertion order), on the given prototype. Transitioning: it allocates; it reads the
;; properties word.
(const JS-OBJECT-KEYS 106)

;; One operand, the thrown value the program left uncaught after its last Script. Fatal.
(const JS-UNCAUGHT 89)

;; No operand. A computed property access (`o[k]`) with a runtime key: runtime key interning and
;; arrays are unimplemented.
(const JS-TRAP-KEYED-ACCESS 90)

;; One operand, the property-key id of the name. A reference to a name nothing in the realm
;; declares: a global object property lookup or a ReferenceError, neither implemented yet.
(const JS-TRAP-UNRESOLVED-GLOBAL 91)

;; --- generic own-property access over the runtime shape tree (aot.rt.shapes) ---
;; (object raw, key int) -> the own data property's value, or undefined when absent.
(const JS-PROP-GET-OWN 92)

;; (object raw, key int) -> bool: whether the object has that own property.
(const JS-PROP-HAS-OWN 93)

;; (object raw, key int, value dyn) -> value. Transitioning: a new key allocates a backing store.
(const JS-PROP-SET-OWN 94)

;; No operand. ToObject on a primitive — a wrapper object (`new String("x")`, `Object(1)`) — is
;; unimplemented.
(const JS-TRAP-TO-OBJECT 95)

;; One operand, a raw string; its property-key id in the runtime key table (`aot.rt.shapes`),
;; minted on first sight. Not transitioning: the table is host memory.
(const JS-INTERN-KEY 96)

;; --- Array exotic objects: the elements store is the runtime's (docs/DECISIONS.md, arrays) ---
;; (length int, prototype dyn) -> raw array: ArrayCreate. Transitioning.
(const JS-ARRAY-NEW 100)

;; (array raw, index int) -> the element, or undefined for a hole or an index past the length.
(const JS-ARRAY-LOAD 101)

;; (array raw, index int) -> bool: inside the length and not a hole.
(const JS-ARRAY-HAS 102)

;; (array raw, index int, value dyn) -> value. Transitioning: may grow the store; the length grows
;; to cover the index.
(const JS-ARRAY-STORE 103)

;; (array raw, length int) -> length: ArraySetLength over a valid array length. Transitioning.
(const JS-ARRAY-SET-LENGTH 104)

;; (string raw) -> the array index the canonical numeric string denotes, or -1.
(const JS-ARRAY-INDEX-OF-STRING 105)

(const JSOP-CTRL 0)

(const JSOP-MEM 1)

(const JSOP-ARG0 2)

(defstruct JsOpNode [(hdr NodeHdr) (prim i64)])

(defn jsop-result-ty [(prim i64)] (-> i64)
  (case prim JS-IS-UNDEFINED
        (ty-bool) JS-IS-NULL
        (ty-bool) JS-IS-BOOL
        (ty-bool) JS-IS-INT
        (ty-bool) JS-IS-FLT
        (ty-bool) JS-IS-STRING
        (ty-bool) JS-IS-SYMBOL
        (ty-bool) JS-IS-OBJECT
        (ty-bool) JS-IS-ARRAY
        (ty-bool) JS-IS-FUNCTION
        (ty-bool) JS-STRING-LEN
        (ty-int-bot) JS-STRING-CONCAT
        (raw-string-ty) JS-STRING-CHARCODE
        (ty-int-bot) JS-STRING-FROMCODE
        (raw-string-ty) JS-STRING-EQ
        (ty-bool) JS-STRING-COMPARE
        (ty-int-bot) JS-STRING-INDEXOF
        (ty-int-bot) JS-SUBSTRING
        (raw-string-ty) JS-STRING-NEW
        (raw-string-ty) JS-STRING-NORMALIZE
        (raw-string-ty) JS-NUMBER-TO-STRING
        (raw-string-ty) JS-PARSE-INT
        (ty-dyn (+ TAG-INT TAG-DOUBLE)) JS-PARSE-FLOAT
        (ty-dyn (+ TAG-INT TAG-DOUBLE)) JS-TO-FIXED
        (raw-string-ty) JS-STRING-TO-NUMBER
        (ty-dyn (+ TAG-INT TAG-DOUBLE)) JS-MATH-UNARY
        (ty-dyn (+ TAG-INT TAG-DOUBLE)) JS-MATH-BINARY
        (ty-dyn (+ TAG-INT TAG-DOUBLE)) JS-MATH-RANDOM
        (ty-dyn (+ TAG-INT TAG-DOUBLE)) JS-GET-PROTOTYPE
        (ty-dyn (+ TAG-NULL TAG-OBJECT)) JS-SET-PROTOTYPE
        (ty-bool) JS-OWN-KEY-COUNT
        (ty-int-bot) JS-OWN-KEY-AT
        (ty-dyn TAG-ANY) JS-PROP-ATTRIBUTES
        (ty-int-bot) JS-SET-PROP-ATTRIBUTES
        (ty-bool) JS-FREEZE
        (ty-bool) JS-PREVENT-EXTENSIONS
        (ty-bool) JS-IS-EXTENSIBLE
        (ty-bool) JS-THROW
        (ty-dyn TAG-ANY) JS-THROW-TYPE-ERROR
        (ty-dyn TAG-ANY) JS-TRAP-INVARIANT
        (ty-dyn TAG-ANY) JS-TRAP-TO-PRIMITIVE
        (ty-dyn TAG-ANY) JS-TRAP-TO-STRING
        (ty-dyn TAG-ANY) JS-TRAP-NO-REALM
        (ty-dyn TAG-ANY) JS-TRAP-DYNAMIC-CODE
        (ty-dyn TAG-ANY) JS-UNCAUGHT
        (ty-dyn TAG-ANY) JS-TRAP-KEYED-ACCESS
        (ty-dyn TAG-ANY) JS-TRAP-UNRESOLVED-GLOBAL
        (ty-dyn TAG-ANY) JS-PROP-GET-OWN
        (ty-dyn TAG-ANY) JS-PROP-HAS-OWN
        (ty-bool) JS-PROP-SET-OWN
        (ty-dyn TAG-ANY) JS-TRAP-TO-OBJECT
        (ty-dyn TAG-ANY) JS-INTERN-KEY
        (ty-int-bot) JS-ARRAY-NEW
        (raw-array-ty) JS-ARRAY-LOAD
        (ty-dyn TAG-ANY) JS-ARRAY-HAS
        (ty-bool) JS-ARRAY-STORE
        (ty-dyn TAG-ANY) JS-ARRAY-SET-LENGTH
        (ty-int-bot) JS-ARRAY-INDEX-OF-STRING
        (ty-int-bot) JS-OBJECT-KEYS
        (raw-array-ty)
          (do (panic-i "jsop-result-ty: unknown primitive" prim) TY-INVALID)))

;; Does this primitive read or write object memory the graph cannot name? Its memory result is
;; then public BOT: every slice may have changed, and the object it received has escaped.
(defn jsop-touches-properties? [(prim i64)] (-> bool)
  (or (= prim JS-PROP-GET-OWN)
      (= prim JS-PROP-HAS-OWN)
      (= prim JS-PROP-SET-OWN)
      (= prim JS-ARRAY-NEW)
      (= prim JS-ARRAY-LOAD)
      (= prim JS-ARRAY-HAS)
      (= prim JS-ARRAY-STORE)
      (= prim JS-ARRAY-SET-LENGTH)
      (= prim JS-OBJECT-KEYS)))

(defn jsop-compute [(n (dyn NodeOps))] (-> i64)
  (ty-tuple-of3 (match (n-in n JSOP-CTRL)
                  (Some [ctrl] (n-ty ctrl))
                  (None [] TY-TOP))
                (if (jsop-touches-properties? (jsop-prim n))
                    (ty-mem 1 TY-BOT)
                    (match (n-in n JSOP-MEM)
                      (Some [mem] (n-ty mem))
                      (None [] (ty-mem-top 1))))
                (jsop-result-ty (jsop-prim n))))

(impl NodeOps JsOpNode
  (hdr [(self (ptr JsOpNode))]
       (-> (ptr NodeHdr))
       (primitive/cast (ptr NodeHdr) self))
  ;; The primitive's index in the label: `JsOp[92]` is JS-PROP-GET-OWN.
  (label [(self (ptr JsOpNode))] (-> (slice u8))
         (let [(mut b) (sb-new (alloc/malloc-allocator))]
           (sb-push-str! (mut b) "JsOp[")
           (sb-push-i64! (mut b) (.prim self))
           (sb-push-str! (mut b) "]")
           (sb-str (mut b))))
  (is-const? [(self (ptr JsOpNode))] (-> bool) false)
  (no-const-fold? [(self (ptr JsOpNode))] (-> bool) true)
  (is-pinned? [(self (ptr JsOpNode))] (-> bool) true)
  (binop-copy [(self (ptr JsOpNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)]))
  (compute [(self (ptr JsOpNode))]
           (-> i64)
           (jsop-compute (primitive/make-dyn NodeOps self)))
  (idealize [(self (ptr JsOpNode))]
            (-> (Option (dyn NodeOps)))
            (None [(dyn NodeOps)]))
  (eq-extra [(self (ptr JsOpNode)) (other (dyn NodeOps))]
            (-> bool)
            (and (= (n-op other) OP-JSOP)
                 (= (.nid (hdr (primitive/make-dyn NodeOps self)))
                    (n-nid other))))
  (hash-extra [(self (ptr JsOpNode))]
              (-> i64)
              (+ 367 (.nid (hdr (primitive/make-dyn NodeOps self))))))

;; Build a JsOp. `prim` is one of the constants above; arity is fixed by JSL's primitive table and
;; checked as arguments are appended and again before backend handoff.
(defn jsop-make [(ctrl (dyn NodeOps)) (mem (dyn NodeOps)) (prim i64)] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [JsOpNode] (alloc/create [JsOpNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.prim p) prim)
    (jsop-result-ty prim)
    (n-init! d OP-JSOP)
    (n-add-def! d (Some ctrl))
    (n-add-def! d (Some mem))
    (n-set-ty! d (jsop-compute d))
    d))

(defn jsop-add-arg! [(n (dyn NodeOps)) (arg (dyn NodeOps))] (-> i64)
  (do
    (if (!= (n-op n) OP-JSOP)
        (panic-i "jsop-add-arg!: not a JsOp" (n-op n))
        0)
    (n-add-def! n (Some arg))
    (n-force-ty! n (jsop-compute n))
    (- (n-nins n) JSOP-ARG0)))

;; The primitive index a JsOp carries. Panics on any other node kind.
(defn jsop-prim [(n (dyn NodeOps))] (-> i64)
  (if (!= (n-op n) OP-JSOP)
      (do (panic-i "jsop-prim: not a JsOp" (n-op n)) 0)
      (.prim (primitive/cast (ptr JsOpNode) (hdr n)))))

;; Does this primitive transition — may it call back into JavaScript or move the heap? This is
;; what decides where a Safepoint goes and which references it relocates.
(defn jsop-transitioning? [(prim i64)] (-> bool)
  (or (= prim JS-PROP-SET-OWN)
      (= prim JS-ARRAY-NEW)
      (= prim JS-ARRAY-STORE)
      (= prim JS-ARRAY-SET-LENGTH)
      (= prim JS-OBJECT-KEYS)
      (= prim JS-STRING-CONCAT)
      (= prim JS-STRING-FROMCODE)
      (= prim JS-SUBSTRING)
      (= prim JS-STRING-NEW)
      (= prim JS-STRING-NORMALIZE)
      (= prim JS-NUMBER-TO-STRING)
      (= prim JS-TO-FIXED)))
