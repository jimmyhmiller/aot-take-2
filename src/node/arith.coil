;; ============================================================================

;; ARITHMETIC  —  port of Simple's ArithNode, AddNode, SubNode, MulNode, DivNode,
;; ToFloatNode, RoundF32Node and MinusNode
;; ============================================================================
;;
;; One file, because the peepholes are one system. Add's "sink constants right, then fold
;; `(x+c1)+c2` into `x+(c1+c2)`" and Mul's are the same rewrite; on separate screens they drift.
;;
;; ## MODE — the one-shot arithmetic selection
;;
;; Simple's `ArithNode` carries `_mode`: 0 unknown, 1 integer, 2 float. It is set ONCE and never
;; unset (`setMode` asserts `_mode==0`), and `setMode` calls `unlock` first because the mode
;; participates in the GVN hash and equality — two Adds are the same node only if they are the same
;; ARITHMETIC.
;;
;; While the mode is 0 the node is generic and NO algebraic identity may fire. Simple's Add opens
;; with exactly that:  `if( _mode==0 ) return super.idealize();`
;;
;; Mode selection from the operand types (Simple's `ArithNode.mode`):
;;     either side float                  -> 2
;;     both sides int / memptr / funptr   -> 1
;;     otherwise                          -> 0, still unknown
;;
;; For JavaScript this is where the language shows through. `a + b` in source is NOT this node — it
;; is a call to `JsAdd` (docs/FRONTEND.md), which does ToPrimitive, checks for strings, and only
;; then reaches `%Add` on raw numbers. THIS node is that `%Add`: its operands are already raw. The
;; mode settles once the optimiser has proven which representation flows in.
;;
;; ## Add's rules, in Simple's order
;;
;;   0. mode still 0            -> generic, nothing may fire
;;   1. x + 0                   -> x         (0 + x already canonicalised to x + 0)
;;   2. x + x, integer mode     -> x << 1
;;   3. non-add + add           -> swap      (goal: a LEFT SPINE of adds, constants on the right)
;;   4. x + (-y)                -> x - y
;;   5. x + (y + z)             -> (x + y) + z    (rotate; kills the add on the RHS)
;;   6. (x + c1) + c2           -> x + (c1 + c2)  (the inner pair then folds)
;;   7. spine ordering          -> rotate to gather similar terms
;;
;; Rule 6 is where `addDep` earns its place, and Simple says so: "If lhs.in(2) is not a constant, we
;; add ourselves as a dependency because if it later became a constant then we could make this
;; transformation." Without it, an Add that could not fold today is never revisited.
;;
;; Rule 5's shape comment is worth keeping: after the swaps we may see (add add non), (add non non)
;; or (add add add), but NEVER (add non add). The canonical form is what makes the later rules a
;; finite set of cases instead of a search.
;;
;; `phiCon` and `spine_cmp` are both live. The former pushes constants through Phis and the latter
;; gives every Add spine a deterministic order: constants, Phis of constants, ordinary Phis, then
;; other nodes by nid. The ordering is not cosmetic; it exposes adjacent constants to rule 6.
;;
;; ## Overflow never wraps
;;
;; A wrapped constant is a lie about the program, and in JavaScript doubly so — numbers are doubles
;; and the int representation is an optimisation we chose. On overflow the range widens to the
;; integer bottom instead. The check comes BEFORE the constant fold: `MAX+1` is a two-constant case,
;; so a fold-first ordering claims it before any check runs.
(module aot.node.arith)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.phicon" :use *)
(import "aot.type.type" :use *)

(const MODE-UNKNOWN 0)

(const MODE-INT 1)

(const MODE-FLT 2)

;; Inputs: 0 = control (absent for a pure node), 1 = lhs, 2 = rhs.
(const ARITH-LHS 1)

(const ARITH-RHS 2)

(const INT-MAX 9223372036854775807)

(const INT-MIN -9223372036854775808)

;; ---------------------------------------------------------------------------
;; Shared helpers

;; Simple's `ArithNode.mode`. An int and a float do NOT combine: they are two raw machine
;; representations, and picking one would silently reinterpret the other.
(defn arith-mode-of [(lt i64) (rt i64)] (-> i64)
  (if (or (ty-flt? lt) (ty-flt? rt))
      MODE-FLT
      (if (and (ty-int? lt) (ty-int? rt))
          MODE-INT
          MODE-UNKNOWN)))

;; Overflow detection.
;;
;; These were hand-rolled bounds comparisons, and `mul-overflows?` was a DIVISION ROUND-TRIP — a
;; divide per multiply, purely to detect overflow, on the constant-folding path of every `Mul`. The
;; primitives are the hardware flag, and their signedness follows the operand type.
;;
;; NOTE the bound: overflow is against the TRUE 64-bit limits, matching Simple, whose
;; `TypeInteger.BOT` is `[Long.MIN_VALUE .. Long.MAX_VALUE]`. An earlier version here used a
;; SYMMETRIC `-(2^63-1)` low bound so that negation never overflowed. That was an unnoticed
;; deviation, and it only surfaced when the overflow primitives — which use the real limits —
;; disagreed with it. `minus-compute-ty` guards the true min explicitly, exactly as Simple does.
(defn add-overflows? [(a i64) (b i64)] (-> bool)
  (primitive/iadd-overflow? a b))

(defn sub-overflows? [(a i64) (b i64)] (-> bool)
  (primitive/isub-overflow? a b))

(defn mul-overflows? [(a i64) (b i64)] (-> bool)
  (primitive/imul-overflow? a b))

;; Is `t` the integer constant `v`?
(defn int-con-is? [(t i64) (v i64)] (-> bool)
  (and (ty-int? t) (and (ty-constant? t) (= (ty-int-lo t) v))))

;; ---------------------------------------------------------------------------
;; Add
(defstruct AddNode [(hdr NodeHdr) (mode i64)])

(defn add-mode [(n (dyn NodeOps))] (-> i64)
  (.mode (primitive/cast (ptr AddNode) (hdr n))))

;; Set the one-shot mode. Unlocks first: the mode participates in the GVN hash and equality.
(defn add-set-mode! [(n (dyn NodeOps)) (m i64)] (-> i64)
  (if (!= (add-mode n) MODE-UNKNOWN)
      (broken "add-set-mode!: mode is one-shot and was already settled")
      (do
        (n-unlock! n)
        (set! (.mode (primitive/cast (ptr AddNode) (hdr n))) m)
        0)))

(defn add-compute-mode [(lt i64) (rt i64) (mode i64)] (-> i64)
  (if (or (ty-high? lt) (ty-high? rt))
      (if (= mode MODE-INT)
          (ty-dual (ty-int-bot))
          (if (= mode MODE-FLT) (ty-dual (ty-flt-bot)) TY-TOP))
      (let [m (if (= mode MODE-UNKNOWN) (arith-mode-of lt rt) mode)]
        (if (= m MODE-INT)
            (if (and (ty-int? lt) (ty-int? rt))
                (let [alo (ty-int-lo lt)
                      ahi (ty-int-hi lt)
                      blo (ty-int-lo rt)
                      bhi (ty-int-hi rt)]
                  (if (or (add-overflows? alo blo) (add-overflows? ahi bhi))
                      (ty-int-bot)
                      (ty-int-range-wide (+ alo blo)
                                         (+ ahi bhi)
                                         (if (> (ty-int-widen lt) (ty-int-widen rt))
                                             (ty-int-widen lt)
                                             (ty-int-widen rt)))))
                (ty-int-bot))
            (if (= m MODE-FLT)
                (if (and (ty-flt? lt) (ty-flt? rt))
                    (if (and (ty-constant? lt) (ty-constant? rt))
                        (ty-flt-con (primitive/fadd (ty-flt-value lt) (ty-flt-value rt)))
                        (ty-meet lt rt))
                    (ty-flt-bot))
                TY-BOT)))))

(defn add-compute-ty [(lt i64) (rt i64)] (-> i64)
  (add-compute-mode lt rt MODE-UNKNOWN))

;; Simple's `spine_cmp`: constants sort furthest right, then Phis of constants, then ordinary
;; Phis, then all other nodes by nid. Returning true means `hi` and `lo` are out of order.
(defn add-spine-swap? [(hi (dyn NodeOps)) (lo (dyn NodeOps)) (dep (dyn NodeOps))] (-> bool)
  (if (ty-constant? (n-ty lo))
      false
      (if (ty-constant? (n-ty hi))
          true
          (if (and (= (n-op lo) OP-PHI) (ty-high? (n-ty (n-in! lo 0))))
              false
              (if (and (= (n-op hi) OP-PHI) (ty-high? (n-ty (n-in! hi 0))))
                  false
                  (match (pcon lo dep)
                    (Some [_] false)
                    (None []
                          (match (pcon hi dep)
                            (Some [_] true)
                            (None []
                                  (if (and (= (n-op lo) OP-PHI) (!= (n-op hi) OP-PHI))
                                      true
                                      (if (and (= (n-op hi) OP-PHI) (!= (n-op lo) OP-PHI))
                                          false
                                          (> (n-nid lo) (n-nid hi)))))))))))))

(defn add-idealize [(d (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [lhs (n-in! d ARITH-LHS)
        rhs (n-in! d ARITH-RHS)]
    (if (= (add-mode d) MODE-UNKNOWN)
        ;; 0. Settle the mode before any algebraic identity fires.
        (let [m (arith-mode-of (n-ty lhs) (n-ty rhs))]
          (if (= m MODE-UNKNOWN)
              (None [(dyn NodeOps)])
              (do (add-set-mode! d m) (Some d))))
        (if (and (= (add-mode d) MODE-FLT) (ty-int? (n-ty lhs)))
            (Some (add-make-mode (to-float-make lhs) rhs MODE-FLT))
            (if (and (= (add-mode d) MODE-FLT) (ty-int? (n-ty rhs)))
                (Some (add-make-mode lhs (to-float-make rhs) MODE-FLT))
                ;; IEEE addition is not associative. Direct Phi-arm distribution is safe because
                ;; each execution still performs exactly one Add, but every spine rotation,
                ;; reassociation, and constant regrouping below is integer-only.
                (if (= (add-mode d) MODE-FLT)
                    (phi-con d false)
                    (if (int-con-is? (n-ty rhs) 0)
                        ;; 1. x + 0 -> x
                        (Some lhs)
                        (if (and (n-same? lhs rhs) (= (add-mode d) MODE-INT))
                            ;; 2. x + x -> x << 1, integer mode only
                            (Some (shl-make lhs (con-int 1)))
                            (if (and (!= (n-op lhs) OP-ADD) (= (n-op rhs) OP-ADD))
                                ;; 3. non-add + add -> swap, building a left spine
                                (Some (n-swap12! d))
                                (if (= (n-op rhs) OP-MINUS)
                                    ;; 4. x + (-y) -> x - y
                                    (Some (sub-make-mode lhs (n-in! rhs ARITH-LHS) (add-mode d)))
                                    (if (= (n-op rhs) OP-ADD)
                                        ;; 5. x + (y + z) -> (x + y) + z
                                        (Some (add-make-mode (n-peephole! (add-make-mode lhs
                                                                                         (n-in! rhs ARITH-LHS)
                                                                                         (add-mode d)))
                                                             (n-in! rhs ARITH-RHS)
                                                             (add-mode d)))
                                        (if (!= (n-op lhs) OP-ADD)
                                            (if (add-spine-swap? lhs rhs d)
                                                (Some (n-swap12! d))
                                                (phi-con d true))
                                            ;; Now only (add add non) remains.
                                            (if (and (>= (n-nins lhs) 2)
                                                     (n-same? (n-in! lhs ARITH-LHS) lhs))
                                                (None [(dyn NodeOps)])
                                                (let [c1 (n-in! lhs ARITH-RHS)]
                                                  ;; 6. (x + c1) + c2 -> x + (c1 + c2). The dependency is
                                                  ;; load-bearing: c1 may become constant later.
                                                  (n-add-dep! c1 d)
                                                  (if (and (ty-constant? (n-ty c1))
                                                           (ty-constant? (n-ty rhs)))
                                                      (Some (add-make-mode (n-in! lhs ARITH-LHS)
                                                                           (n-peephole! (add-make-mode c1
                                                                                                       rhs
                                                                                                       (add-mode d)))
                                                                           (add-mode d)))
                                                      (match (phi-con d true)
                                                        (Some [x] (Some x))
                                                        (None []
                                                              ;; 7. ((x + hi) + lo) -> ((x + lo) + hi)
                                                              (if (add-spine-swap? c1 rhs d)
                                                                  (Some (add-make-mode (n-peephole! (add-make-mode (n-in! lhs
                                                                                                                          ARITH-LHS)
                                                                                                                   rhs
                                                                                                                   (add-mode d)))
                                                                                       c1
                                                                                       (add-mode d)))
                                                                  (None [(dyn NodeOps)])))))))))))))))))))

(impl NodeOps AddNode
  (hdr [(self (ptr AddNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr AddNode))] (-> (slice u8)) "Add")
  (is-const? [(self (ptr AddNode))] (-> bool) false)
  (no-const-fold? [(self (ptr AddNode))] (-> bool) false)
  (is-pinned? [(self (ptr AddNode))] (-> bool) false)
  ;; Preserve the settled arithmetic mode: a copy that reverts to UNKNOWN would have to re-derive it,
  ;; and on operands that are not yet typed it would derive the WRONG one.
  (binop-copy [(self (ptr AddNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (Some (add-make-mode lhs rhs (.mode self))))
  (compute [(self (ptr AddNode))]
           (-> i64)
           (let [d (primitive/make-dyn NodeOps self)]
             (add-compute-mode (n-ty (n-in! d ARITH-LHS))
                               (n-ty (n-in! d ARITH-RHS))
                               (.mode self))))
  (idealize [(self (ptr AddNode))]
            (-> (Option (dyn NodeOps)))
            (add-idealize (primitive/make-dyn NodeOps self)))
  (eq-extra [(self (ptr AddNode)) (other (dyn NodeOps))]
            (-> bool)
            (if (!= (n-op other) OP-ADD)
                false
                (= (.mode self) (.mode (primitive/cast (ptr AddNode) (hdr other))))))
  (hash-extra [(self (ptr AddNode))] (-> i64) (+ 7 (* (.mode self) 31))))

(defn add-make [(lhs (dyn NodeOps)) (rhs (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [AddNode] (alloc/create [AddNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.mode p) MODE-UNKNOWN)
    (n-init! d OP-ADD)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some lhs))
    (n-add-def! d (Some rhs))
    (n-set-ty! d (compute d))
    d))

;; ---------------------------------------------------------------------------
;; Sub
(defstruct SubNode [(hdr NodeHdr) (mode i64)])

(defn sub-mode [(n (dyn NodeOps))] (-> i64)
  (.mode (primitive/cast (ptr SubNode) (hdr n))))

(defn sub-set-mode! [(n (dyn NodeOps)) (m i64)] (-> i64)
  (if (!= (sub-mode n) MODE-UNKNOWN)
      (broken "sub-set-mode!: mode is one-shot and was already settled")
      (do
        (n-unlock! n)
        (set! (.mode (primitive/cast (ptr SubNode) (hdr n))) m)
        0)))

;; The range of a difference is [alo-bhi .. ahi-blo] — the LOW bound uses the other side's HIGH.
;; Getting that backwards produces a range that excludes reachable values, which is unsound in the
;; direction that matters: the optimiser would believe something false.
(defn sub-compute-mode [(lt i64) (rt i64) (mode i64)] (-> i64)
  (if (or (ty-high? lt) (ty-high? rt))
      (if (= mode MODE-INT)
          (ty-dual (ty-int-bot))
          (if (= mode MODE-FLT) (ty-dual (ty-flt-bot)) TY-TOP))
      (let [m (if (= mode MODE-UNKNOWN) (arith-mode-of lt rt) mode)]
        (if (= m MODE-INT)
            (if (and (ty-int? lt) (ty-int? rt))
                (let [alo (ty-int-lo lt)
                      ahi (ty-int-hi lt)
                      blo (ty-int-lo rt)
                      bhi (ty-int-hi rt)]
                  (if (or (sub-overflows? alo bhi) (sub-overflows? ahi blo))
                      (ty-int-bot)
                      (ty-int-range-wide (- alo bhi)
                                         (- ahi blo)
                                         (if (> (ty-int-widen lt) (ty-int-widen rt))
                                             (ty-int-widen lt)
                                             (ty-int-widen rt)))))
                (ty-int-bot))
            (if (= m MODE-FLT)
                (if (and (ty-flt? lt) (ty-flt? rt))
                    (if (and (ty-constant? lt) (ty-constant? rt))
                        (ty-flt-con (primitive/fsub (ty-flt-value lt) (ty-flt-value rt)))
                        (ty-meet lt rt))
                    (ty-flt-bot))
                TY-BOT)))))

(defn sub-compute-ty [(lt i64) (rt i64)] (-> i64)
  (sub-compute-mode lt rt MODE-UNKNOWN))

(defn sub-idealize [(d (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [lhs (n-in! d ARITH-LHS)
        rhs (n-in! d ARITH-RHS)]
    (if (= (sub-mode d) MODE-UNKNOWN)
        (let [m (arith-mode-of (n-ty lhs) (n-ty rhs))]
          (if (= m MODE-UNKNOWN)
              (None [(dyn NodeOps)])
              (do (sub-set-mode! d m) (Some d))))
        (if (and (= (sub-mode d) MODE-FLT) (ty-int? (n-ty lhs)))
            (Some (sub-make-mode (to-float-make lhs) rhs MODE-FLT))
            (if (and (= (sub-mode d) MODE-FLT) (ty-int? (n-ty rhs)))
                (Some (sub-make-mode lhs (to-float-make rhs) MODE-FLT))
                (if (int-con-is? (n-ty rhs) 0)
                    ;; x - 0 -> x
                    (Some lhs)
                    ;; x - x -> 0. Integer mode ONLY: for floats this is false when x is NaN.
                    (if (and (n-same? lhs rhs) (= (sub-mode d) MODE-INT))
                        (Some (con-int 0))
                        ;; Simple applies these after the arithmetic mode is settled.  They are valid
                        ;; for both integer and IEEE arithmetic: neither rewrite changes evaluation
                        ;; order, and negation preserves NaN and signed-zero behavior.
                        (if (= (n-op rhs) OP-MINUS)
                            ;; x - (-y) -> x + y
                            (Some (add-make-mode lhs (n-in! rhs 1) (sub-mode d)))
                            (if (and (= (sub-mode d) MODE-INT) (= (n-op lhs) OP-MINUS))
                                ;; (-x) - y -> -(x + y)
                                (Some (minus-make (n-peephole! (add-make-mode (n-in! lhs 1) rhs (sub-mode d)))))
                                (None [(dyn NodeOps)]))))))))))

(impl NodeOps SubNode
  (hdr [(self (ptr SubNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr SubNode))] (-> (slice u8)) "Sub")
  (is-const? [(self (ptr SubNode))] (-> bool) false)
  (no-const-fold? [(self (ptr SubNode))] (-> bool) false)
  (is-pinned? [(self (ptr SubNode))] (-> bool) false)
  (binop-copy [(self (ptr SubNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (Some (sub-make-mode lhs rhs (.mode self))))
  (compute [(self (ptr SubNode))]
           (-> i64)
           (let [d (primitive/make-dyn NodeOps self)]
             (sub-compute-mode (n-ty (n-in! d ARITH-LHS))
                               (n-ty (n-in! d ARITH-RHS))
                               (.mode self))))
  (idealize [(self (ptr SubNode))]
            (-> (Option (dyn NodeOps)))
            (sub-idealize (primitive/make-dyn NodeOps self)))
  (eq-extra [(self (ptr SubNode)) (other (dyn NodeOps))]
            (-> bool)
            (if (!= (n-op other) OP-SUB)
                false
                (= (.mode self) (.mode (primitive/cast (ptr SubNode) (hdr other))))))
  (hash-extra [(self (ptr SubNode))] (-> i64) (+ 11 (* (.mode self) 31))))

(defn sub-make [(lhs (dyn NodeOps)) (rhs (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [SubNode] (alloc/create [SubNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.mode p) MODE-UNKNOWN)
    (n-init! d OP-SUB)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some lhs))
    (n-add-def! d (Some rhs))
    (n-set-ty! d (compute d))
    d))

;; ---------------------------------------------------------------------------
;; Mul
(defstruct MulNode [(hdr NodeHdr) (mode i64)])

(defn mul-mode [(n (dyn NodeOps))] (-> i64)
  (.mode (primitive/cast (ptr MulNode) (hdr n))))

(defn mul-set-mode! [(n (dyn NodeOps)) (m i64)] (-> i64)
  (if (!= (mul-mode n) MODE-UNKNOWN)
      (broken "mul-set-mode!: mode is one-shot and was already settled")
      (do
        (n-unlock! n)
        (set! (.mode (primitive/cast (ptr MulNode) (hdr n))) m)
        0)))

;; Only the two-constant case folds. A general range product is the min and max over all four corner
;; products, and the sign cases are exactly where an off-by-one becomes an UNSOUND range — so the
;; honest answer for a non-constant pair is the integer bottom until that is written and tested
;; properly. Widening is always safe; narrowing wrongly is not.
(defn mul-compute-mode [(lt i64) (rt i64) (mode i64)] (-> i64)
  (if (or (ty-high? lt) (ty-high? rt))
      (if (= mode MODE-INT)
          (ty-dual (ty-int-bot))
          (if (= mode MODE-FLT) (ty-dual (ty-flt-bot)) TY-TOP))
      (let [m (if (= mode MODE-UNKNOWN) (arith-mode-of lt rt) mode)]
        (if (= m MODE-INT)
            (if (and (ty-int? lt) (ty-int? rt))
                (if (and (ty-constant? lt) (ty-constant? rt))
                    (let [a (ty-int-lo lt)
                          b (ty-int-lo rt)]
                      (if (mul-overflows? a b) (ty-int-bot) (ty-int-con (* a b))))
                    (ty-int-bot))
                (ty-int-bot))
            (if (= m MODE-FLT)
                (if (and (ty-flt? lt) (ty-flt? rt))
                    (if (and (ty-constant? lt) (ty-constant? rt))
                        (ty-flt-con (primitive/fmul (ty-flt-value lt) (ty-flt-value rt)))
                        (ty-meet lt rt))
                    (ty-flt-bot))
                TY-BOT)))))

(defn mul-compute-ty [(lt i64) (rt i64)] (-> i64)
  (mul-compute-mode lt rt MODE-UNKNOWN))

(defn mul--constant-int-idealize [(d (dyn NodeOps)) (lhs (dyn NodeOps)) (c i64)] (-> (Option (dyn NodeOps)))
  (if (= c 1)
      (Some lhs)
      (if (= c 0)
          (Some (con-int 0))
          ;; Simple lowers the three profitable constant shapes before instruction selection:
          ;; 2^n, 2^n+1 and 2^n-1.  Require a positive power candidate; in particular, zero is not
          ;; a power of two and must never reach `ctz`.
          (if (and (> c 0) (= (primitive/iand c (- c 1)) 0))
              (Some (shl-make lhs (con-int (primitive/ctz c))))
              (let [below (- c 1)
                    above (+ c 1)]
                (if (and (> below 0) (= (primitive/iand below (- below 1)) 0))
                    (Some (add-make (n-peephole! (shl-make lhs (con-int (primitive/ctz below))))
                                    lhs))
                    (if (and (> above 0) (= (primitive/iand above (- above 1)) 0))
                        (Some (sub-make (n-peephole! (shl-make lhs (con-int (primitive/ctz above))))
                                        lhs))
                        (phi-con d true))))))))

(defn mul-idealize [(d (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [lhs (n-in! d ARITH-LHS)
        rhs (n-in! d ARITH-RHS)]
    (if (= (mul-mode d) MODE-UNKNOWN)
        (let [m (arith-mode-of (n-ty lhs) (n-ty rhs))]
          (if (= m MODE-UNKNOWN)
              (None [(dyn NodeOps)])
              (do (mul-set-mode! d m) (Some d))))
        (if (and (= (mul-mode d) MODE-FLT) (ty-int? (n-ty lhs)))
            (Some (mul-make-mode (to-float-make lhs) rhs MODE-FLT))
            (if (and (= (mul-mode d) MODE-FLT) (ty-int? (n-ty rhs)))
                (Some (mul-make-mode lhs (to-float-make rhs) MODE-FLT))
                ;; Sink the constant to the RHS so every constant rule below sees one canonical form.
                (if (and (ty-constant? (n-ty lhs)) (not (ty-constant? (n-ty rhs))))
                    (Some (n-swap12! d))
                    (if (and (= (mul-mode d) MODE-INT)
                             (and (ty-int? (n-ty rhs)) (ty-constant? (n-ty rhs))))
                        (mul--constant-int-idealize d lhs (ty-int-lo (n-ty rhs)))
                        (if (and (= (mul-mode d) MODE-FLT) (ty-flt? (n-ty rhs)))
                            (if (and (ty-constant? (n-ty rhs))
                                     (primitive/fcmp-eq (ty-flt-value (n-ty rhs)) 1.0))
                                (Some lhs)
                                (phi-con d false))
                            (phi-con d true)))))))))

(impl NodeOps MulNode
  (hdr [(self (ptr MulNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr MulNode))] (-> (slice u8)) "Mul")
  (is-const? [(self (ptr MulNode))] (-> bool) false)
  (no-const-fold? [(self (ptr MulNode))] (-> bool) false)
  (is-pinned? [(self (ptr MulNode))] (-> bool) false)
  (binop-copy [(self (ptr MulNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (Some (mul-make-mode lhs rhs (.mode self))))
  (compute [(self (ptr MulNode))]
           (-> i64)
           (let [d (primitive/make-dyn NodeOps self)]
             (mul-compute-mode (n-ty (n-in! d ARITH-LHS))
                               (n-ty (n-in! d ARITH-RHS))
                               (.mode self))))
  (idealize [(self (ptr MulNode))]
            (-> (Option (dyn NodeOps)))
            (mul-idealize (primitive/make-dyn NodeOps self)))
  (eq-extra [(self (ptr MulNode)) (other (dyn NodeOps))]
            (-> bool)
            (if (!= (n-op other) OP-MUL)
                false
                (= (.mode self) (.mode (primitive/cast (ptr MulNode) (hdr other))))))
  (hash-extra [(self (ptr MulNode))] (-> i64) (+ 13 (* (.mode self) 31))))

(defn mul-make [(lhs (dyn NodeOps)) (rhs (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [MulNode] (alloc/create [MulNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.mode p) MODE-UNKNOWN)
    (n-init! d OP-MUL)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some lhs))
    (n-add-def! d (Some rhs))
    (n-set-ty! d (compute d))
    d))

;; ---------------------------------------------------------------------------
;; Div
;;
;; Simple's DivNode applies its own rules before the shared ArithNode rules, in this order:
;; integer division by one returns the dividend; float division by one does the same; division by
;; any other float constant becomes multiplication by its reciprocal; only then does shared
;; arithmetic settle the mode or convert a mixed integer operand with ToFloat. Integer constant
;; division by zero is defined as zero by Simple's ideal graph evaluator. Float division keeps IEEE
;; semantics, including infinities and NaN.
(defstruct DivNode [(hdr NodeHdr) (mode i64)])

(defn div-mode [(n (dyn NodeOps))] (-> i64)
  (.mode (primitive/cast (ptr DivNode) (hdr n))))

(defn div-set-mode! [(n (dyn NodeOps)) (m i64)] (-> i64)
  (if (!= (div-mode n) MODE-UNKNOWN)
      (broken "div-set-mode!: mode is one-shot and was already settled")
      (do
        (n-unlock! n)
        (set! (.mode (primitive/cast (ptr DivNode) (hdr n))) m)
        0)))

(defn div-compute-ty [(lt i64) (rt i64) (mode i64)] (-> i64)
  (if (or (ty-high? lt) (ty-high? rt))
      (if (= mode MODE-INT)
          (ty-dual (ty-int-bot))
          (if (= mode MODE-FLT) (ty-dual (ty-flt-bot)) TY-TOP))
      (let [m (if (= mode MODE-UNKNOWN) (arith-mode-of lt rt) mode)]
        (if (= m MODE-INT)
            (if (and (ty-int? lt) (ty-int? rt))
                (if (and (ty-constant? lt) (ty-constant? rt))
                    (let [x (ty-int-lo lt)
                          y (ty-int-lo rt)]
                      (if (= y 0)
                          (ty-int-con 0)
                          ;; Coil and Java both define this two's-complement quotient as INT-MIN;
                          ;; spell it out so no host division trap can leak into constant folding.
                          (if (and (= x INT-MIN) (= y -1))
                              (ty-int-con INT-MIN)
                              (ty-int-con (/ x y)))))
                    (ty-int-bot))
                (ty-int-bot))
            (if (= m MODE-FLT)
                (if (and (ty-flt? lt) (ty-flt? rt))
                    (if (and (ty-constant? lt) (ty-constant? rt))
                        (ty-flt-con (primitive/fdiv (ty-flt-value lt) (ty-flt-value rt)))
                        (ty-meet lt rt))
                    (ty-flt-bot))
                TY-BOT)))))

(defn div-idealize [(d (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [lhs (n-in! d ARITH-LHS)
        rhs (n-in! d ARITH-RHS)
        lt (n-ty lhs)
        rt (n-ty rhs)
        mode (div-mode d)]
    (if (and (= mode MODE-INT) (int-con-is? rt 1))
        (Some lhs)
        (if (and (= mode MODE-FLT)
                 (and (ty-flt? rt)
                      (and (ty-constant? rt)
                           (primitive/fcmp-eq (ty-flt-value rt) 1.0))))
            (Some lhs)
            ;; Do not replace IEEE division by multiplication with a pre-rounded reciprocal. For
            ;; example, 3/10 differs from 3*(1/10). Simple may make this optimization for its source
            ;; language; JavaScript requires the independently rounded division result.
            (if (= mode MODE-UNKNOWN)
                (let [m (arith-mode-of lt rt)]
                  (if (= m MODE-UNKNOWN)
                      (None [(dyn NodeOps)])
                      (do (div-set-mode! d m) (Some d))))
                (if (= mode MODE-FLT)
                    (if (ty-int? lt)
                        (Some (div-make-mode (to-float-make lhs) rhs MODE-FLT))
                        (if (ty-int? rt)
                            (Some (div-make-mode lhs (to-float-make rhs) MODE-FLT))
                            (None [(dyn NodeOps)])))
                    (None [(dyn NodeOps)])))))))

(impl NodeOps DivNode
  (hdr [(self (ptr DivNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr DivNode))] (-> (slice u8)) "Div")
  (is-const? [(self (ptr DivNode))] (-> bool) false)
  (no-const-fold? [(self (ptr DivNode))] (-> bool) false)
  (is-pinned? [(self (ptr DivNode))] (-> bool) false)
  (binop-copy [(self (ptr DivNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (Some (div-make-mode lhs rhs (.mode self))))
  (compute [(self (ptr DivNode))]
           (-> i64)
           (let [d (primitive/make-dyn NodeOps self)]
             (div-compute-ty (n-ty (n-in! d ARITH-LHS))
                             (n-ty (n-in! d ARITH-RHS))
                             (.mode self))))
  (idealize [(self (ptr DivNode))]
            (-> (Option (dyn NodeOps)))
            (div-idealize (primitive/make-dyn NodeOps self)))
  (eq-extra [(self (ptr DivNode)) (other (dyn NodeOps))]
            (-> bool)
            (if (!= (n-op other) OP-DIV)
                false
                (= (.mode self) (.mode (primitive/cast (ptr DivNode) (hdr other))))))
  (hash-extra [(self (ptr DivNode))] (-> i64) (+ 23 (* (.mode self) 31))))

(defn div-make [(lhs (dyn NodeOps)) (rhs (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [DivNode] (alloc/create [DivNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.mode p) MODE-UNKNOWN)
    (n-init! d OP-DIV)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some lhs))
    (n-add-def! d (Some rhs))
    (n-set-ty! d (compute d))
    d))

;; ---------------------------------------------------------------------------
;; Shl — needed by Add's `x + x -> x << 1`
(defstruct ShlNode [(hdr NodeHdr) (pad i64)])

(defn shl-compute-ty [(lt i64) (rt i64)] (-> i64)
  (if (or (ty-high? lt) (ty-high? rt))
      TY-TOP
      (if (and (ty-int? lt) (ty-int? rt))
          (if (and (ty-constant? rt) (not (ty-high? lt)))
              (let [s (primitive/iand (ty-int-lo rt) 63)
                    lo (ty-int-lo lt)
                    hi (ty-int-hi lt)
                    slo (primitive/ishl lo s)
                    shi (primitive/ishl hi s)]
                ;; Simple sharpens a whole range when shifting both endpoints back recovers them
                ;; exactly. Machine i64 shift counts are modulo 64.
                (if (and (= (primitive/ishr slo s) lo) (= (primitive/ishr shi s) hi))
                    (ty-int-range-wide slo shi (ty-int-widen lt))
                    (ty-int-bot)))
              (if (int-con-is? lt 0) (ty-int-con 0) (ty-int-bot)))
          TY-BOT)))

(defn shl-idealize [(d (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [lhs (n-in! d ARITH-LHS)
        rhs (n-in! d ARITH-RHS)
        rt (n-ty rhs)]
    (if (not (and (ty-int? rt) (ty-constant? rt)))
        (None [(dyn NodeOps)])
        (let [s (primitive/iand (ty-int-lo rt) 63)]
          (if (= s 0)
              (Some lhs)
              ;; (x + c) << s -> (x << s) + (c << s), when the displaced constant remains a
              ;; compact signed 32-bit immediate. Register a dependency because Add may only
              ;; acquire its canonical RHS constant after another peephole fires.
              (if (= (n-op lhs) OP-ADD)
                  (do
                    (n-add-dep! lhs d)
                    (let [c (n-ty (n-in! lhs ARITH-RHS))]
                      (if (and (ty-int? c) (ty-constant? c))
                          (let [shifted (primitive/ishl (ty-int-lo c) s)]
                            (if (and (>= shifted -2147483648) (<= shifted 2147483647))
                                (Some (add-make (n-peephole! (shl-make (n-in! lhs ARITH-LHS) rhs))
                                                (con-int shifted)))
                                (None [(dyn NodeOps)])))
                          (None [(dyn NodeOps)]))))
                  (None [(dyn NodeOps)])))))))

(impl NodeOps ShlNode
  (hdr [(self (ptr ShlNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr ShlNode))] (-> (slice u8)) "Shl")
  (is-const? [(self (ptr ShlNode))] (-> bool) false)
  (no-const-fold? [(self (ptr ShlNode))] (-> bool) false)
  (is-pinned? [(self (ptr ShlNode))] (-> bool) false)
  (binop-copy [(self (ptr ShlNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (Some (shl-make lhs rhs)))
  (compute [(self (ptr ShlNode))]
           (-> i64)
           (let [d (primitive/make-dyn NodeOps self)]
             (shl-compute-ty (n-ty (n-in! d ARITH-LHS)) (n-ty (n-in! d ARITH-RHS)))))
  (idealize [(self (ptr ShlNode))]
            (-> (Option (dyn NodeOps)))
            (shl-idealize (primitive/make-dyn NodeOps self)))
  (eq-extra [(self (ptr ShlNode)) (other (dyn NodeOps))] (-> bool) (= (n-op other) OP-SHL))
  (hash-extra [(self (ptr ShlNode))] (-> i64) 17))

(defn shl-make [(lhs (dyn NodeOps)) (rhs (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [ShlNode] (alloc/create [ShlNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.pad p) 0)
    (n-init! d OP-SHL)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some lhs))
    (n-add-def! d (Some rhs))
    (n-set-ty! d (compute d))
    d))

;; ---------------------------------------------------------------------------
;; Minus — unary negation
(defstruct MinusNode [(hdr NodeHdr) (mode i64)])

(defn minus-mode [(n (dyn NodeOps))] (-> i64)
  (.mode (primitive/cast (ptr MinusNode) (hdr n))))

(defn minus-set-mode! [(n (dyn NodeOps)) (m i64)] (-> i64)
  (if (!= (minus-mode n) MODE-UNKNOWN)
      (broken "minus-set-mode!: mode is one-shot and was already settled")
      (do
        (n-unlock! n)
        (set! (.mode (primitive/cast (ptr MinusNode) (hdr n))) m)
        0)))

(defn minus-compute-mode [(t i64) (mode i64)] (-> i64)
  (if (ty-high? t)
      (if (= mode MODE-INT)
          (ty-dual (ty-int-bot))
          (if (= mode MODE-FLT) (ty-dual (ty-flt-bot)) TY-TOP))
      (if (= mode MODE-INT)
          (if (ty-int? t)
              (let [lo (ty-int-lo t)
                    hi (ty-int-hi t)]
                ;; Negating the minimum overflows, so the range widens rather than wrapping.
                (if (or (= lo INT-MIN) (= hi INT-MIN))
                    (ty-int-bot)
                    (ty-int-range-wide (- 0 hi) (- 0 lo) (ty-int-widen t))))
              (ty-int-bot))
          (if (= mode MODE-FLT)
              (if (ty-flt? t)
                  (if (ty-constant? t)
                      ;; Unary negation flips the IEEE sign bit. `0.0 - x` is not equivalent for
                      ;; signed zero: it produces +0 for x=+0 instead of -0.
                      (ty-flt-con (flt--from-bits (primitive/ixor (flt--bits (ty-flt-value t)) -9223372036854775808)))
                      t)
                  (ty-flt-bot))
              TY-BOT))))

(defn minus-compute-ty [(t i64)] (-> i64)
  (minus-compute-mode t (if (ty-flt? t) MODE-FLT (if (ty-int? t) MODE-INT MODE-UNKNOWN))))

(impl NodeOps MinusNode
  (hdr [(self (ptr MinusNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr MinusNode))] (-> (slice u8)) "Minus")
  (is-const? [(self (ptr MinusNode))] (-> bool) false)
  (no-const-fold? [(self (ptr MinusNode))] (-> bool) false)
  (is-pinned? [(self (ptr MinusNode))] (-> bool) false)
  (binop-copy [(self (ptr MinusNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (Some (minus-make-mode lhs (.mode self))))
  (compute [(self (ptr MinusNode))]
           (-> i64)
           (minus-compute-mode (n-ty (n-in! (primitive/make-dyn NodeOps self) ARITH-LHS))
                               (.mode self)))
  (idealize [(self (ptr MinusNode))]
            (-> (Option (dyn NodeOps)))
            (let [d (primitive/make-dyn NodeOps self)
                  v (n-in! d ARITH-LHS)]
              (if (= (minus-mode d) MODE-UNKNOWN)
                  (let [m
                          (if (ty-flt? (n-ty v))
                              MODE-FLT
                              (if (ty-int? (n-ty v)) MODE-INT MODE-UNKNOWN))]
                    (if (= m MODE-UNKNOWN)
                        (None [(dyn NodeOps)])
                        (do (minus-set-mode! d m) (Some d))))
                  ;; -(-x) -> x
                  (if (= (n-op v) OP-MINUS)
                      (Some (n-in! v ARITH-LHS))
                      (None [(dyn NodeOps)])))))
  (eq-extra [(self (ptr MinusNode)) (other (dyn NodeOps))]
            (-> bool)
            (if (!= (n-op other) OP-MINUS)
                false
                (= (.mode self) (.mode (primitive/cast (ptr MinusNode) (hdr other))))))
  (hash-extra [(self (ptr MinusNode))] (-> i64) (+ 19 (* (.mode self) 31))))

(defn minus-make [(v (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [MinusNode] (alloc/create [MinusNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.mode p) MODE-UNKNOWN)
    (n-init! d OP-MINUS)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some v))
    (n-set-ty! d (compute d))
    d))

(defn minus-make-mode [(v (dyn NodeOps)) (m i64)] (-> (dyn NodeOps))
  (let [d (minus-make v)]
    (if (= m MODE-UNKNOWN) 0 (minus-set-mode! d m))
    d))

;; ---------------------------------------------------------------------------
;; ToFloat
;;
;; Simple's ToFloatNode has no idealization rules. Its compute order is: high input becomes high
;; F64; NIL becomes +0.0; an integer constant becomes the corresponding float constant; every
;; other analysed input becomes F64. It is a representation conversion, not JavaScript ToNumber.
(defstruct ToFloatNode [(hdr NodeHdr) (pad i64)])

(defn to-float-compute-ty [(t i64)] (-> i64)
  (if (ty-high? t)
      (ty-dual (ty-flt-bot))
      (if (= t TY-NIL)
          (ty-flt-con 0.0)
          (if (and (ty-int? t) (ty-constant? t))
              (ty-flt-con (primitive/cast f64 (ty-int-lo t)))
              (ty-flt-bot)))))

(impl NodeOps ToFloatNode
  (hdr [(self (ptr ToFloatNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr ToFloatNode))] (-> (slice u8)) "ToFloat")
  (is-const? [(self (ptr ToFloatNode))] (-> bool) false)
  (no-const-fold? [(self (ptr ToFloatNode))] (-> bool) false)
  (is-pinned? [(self (ptr ToFloatNode))] (-> bool) false)
  (binop-copy [(self (ptr ToFloatNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (Some (to-float-make lhs)))
  (compute [(self (ptr ToFloatNode))]
           (-> i64)
           (to-float-compute-ty (n-ty (n-in! (primitive/make-dyn NodeOps self) ARITH-LHS))))
  (idealize [(self (ptr ToFloatNode))] (-> (Option (dyn NodeOps))) (None [(dyn NodeOps)]))
  (eq-extra [(self (ptr ToFloatNode)) (other (dyn NodeOps))]
            (-> bool)
            (= (n-op other) OP-TOFLOAT))
  (hash-extra [(self (ptr ToFloatNode))] (-> i64) 29))

(defn to-float-make [(v (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [ToFloatNode] (alloc/create [ToFloatNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.pad p) 0)
    (n-init! d OP-TOFLOAT)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some v))
    (n-set-ty! d (compute d))
    d))

;; ---------------------------------------------------------------------------
;; ToInt — a float truncated toward zero to an integer (`fcvtzs`), the machine capability behind
;; JSL's `%ToInteger`. Simple has no float-to-int conversion because its language has no implicit
;; numeric conversion; JavaScript's ToIntegerOrInfinity, ToUint32 and array-index tests need one.
;; Saturating like the instruction: NaN is 0, out-of-range values pin to the i64 extremes. A
;; constant folds to its truncation.
(defstruct ToIntNode [(hdr NodeHdr) (pad i64)])

(defn to-int-compute-ty [(t i64)] (-> i64)
  (if (ty-high? t)
      (ty-dual (ty-int-bot))
      (if (and (ty-flt? t) (ty-constant? t))
          (ty-int-con (primitive/cast i64 (ty-flt-value t)))
          (ty-int-bot))))

(impl NodeOps ToIntNode
  (hdr [(self (ptr ToIntNode))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr ToIntNode))] (-> (slice u8)) "ToInt")
  (is-const? [(self (ptr ToIntNode))] (-> bool) false)
  (no-const-fold? [(self (ptr ToIntNode))] (-> bool) false)
  (is-pinned? [(self (ptr ToIntNode))] (-> bool) false)
  (binop-copy [(self (ptr ToIntNode)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (Some (to-int-make lhs)))
  (compute [(self (ptr ToIntNode))]
           (-> i64)
           (to-int-compute-ty (n-ty (n-in! (primitive/make-dyn NodeOps self) ARITH-LHS))))
  (idealize [(self (ptr ToIntNode))] (-> (Option (dyn NodeOps))) (None [(dyn NodeOps)]))
  (eq-extra [(self (ptr ToIntNode)) (other (dyn NodeOps))]
            (-> bool)
            (= (n-op other) OP-TOINT))
  (hash-extra [(self (ptr ToIntNode))] (-> i64) 31))

(defn to-int-make [(v (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [ToIntNode] (alloc/create [ToIntNode] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.pad p) 0)
    (n-init! d OP-TOINT)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some v))
    (n-set-ty! d (compute d))
    d))

;; ---------------------------------------------------------------------------
;; RoundF32
;;
;; Simple first rounds a constant through the host f32 representation and returns that exact f64
;; value as a float constant. Otherwise it preserves the input type. Its sole idealization removes
;; the node when the input is already a nonconstant F32 value (`_sz == 32`).
(defstruct RoundF32Node [(hdr NodeHdr) (pad i64)])

(defn round-f32-compute-ty [(t i64)] (-> i64)
  (if (and (ty-flt? t) (ty-constant? t))
      (ty-flt-con (primitive/cast f64 (primitive/cast f32 (ty-flt-value t))))
      t))

(impl NodeOps RoundF32Node
  (hdr [(self (ptr RoundF32Node))] (-> (ptr NodeHdr)) (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr RoundF32Node))] (-> (slice u8)) "RoundF32")
  (is-const? [(self (ptr RoundF32Node))] (-> bool) false)
  (no-const-fold? [(self (ptr RoundF32Node))] (-> bool) false)
  (is-pinned? [(self (ptr RoundF32Node))] (-> bool) false)
  (binop-copy [(self (ptr RoundF32Node)) (lhs (dyn NodeOps)) (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (Some (round-f32-make lhs)))
  (compute [(self (ptr RoundF32Node))]
           (-> i64)
           (round-f32-compute-ty (n-ty (n-in! (primitive/make-dyn NodeOps self) ARITH-LHS))))
  (idealize [(self (ptr RoundF32Node))]
            (-> (Option (dyn NodeOps)))
            (let [d (primitive/make-dyn NodeOps self)
                  lhs (n-in! d ARITH-LHS)
                  t (n-ty lhs)]
              (if (and (ty-flt? t) (= (ty-flt-size t) 32))
                  (Some lhs)
                  (None [(dyn NodeOps)]))))
  (eq-extra [(self (ptr RoundF32Node)) (other (dyn NodeOps))]
            (-> bool)
            (= (n-op other) OP-ROUNDF32))
  (hash-extra [(self (ptr RoundF32Node))] (-> i64) 31))

(defn round-f32-make [(v (dyn NodeOps))] (-> (dyn NodeOps))
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [RoundF32Node] (alloc/create [RoundF32Node] a))
        d (primitive/make-dyn NodeOps p)]
    (set! (.pad p) 0)
    (n-init! d OP-ROUNDF32)
    (n-add-def! d (None [(dyn NodeOps)]))
    (n-add-def! d (Some v))
    (n-set-ty! d (compute d))
    d))

;; `phiCon` and Phi-aware spine ordering are implemented above and have named regression tests.

;; Constructors that preserve an already-settled mode. `binop-copy` needs these: a copy that reverted
;; to UNKNOWN would have to re-derive the mode, and on operands that are not yet typed it would
;; derive the wrong one.
(defn add-make-mode [(lhs (dyn NodeOps)) (rhs (dyn NodeOps)) (m i64)] (-> (dyn NodeOps))
  (let [d (add-make lhs rhs)]
    (if (= m MODE-UNKNOWN) 0 (add-set-mode! d m))
    d))

(defn sub-make-mode [(lhs (dyn NodeOps)) (rhs (dyn NodeOps)) (m i64)] (-> (dyn NodeOps))
  (let [d (sub-make lhs rhs)]
    (if (= m MODE-UNKNOWN) 0 (sub-set-mode! d m))
    d))

(defn mul-make-mode [(lhs (dyn NodeOps)) (rhs (dyn NodeOps)) (m i64)] (-> (dyn NodeOps))
  (let [d (mul-make lhs rhs)]
    (if (= m MODE-UNKNOWN) 0 (mul-set-mode! d m))
    d))

(defn div-make-mode [(lhs (dyn NodeOps)) (rhs (dyn NodeOps)) (m i64)] (-> (dyn NodeOps))
  (let [d (div-make lhs rhs)]
    (if (= m MODE-UNKNOWN) 0 (div-set-mode! d m))
    d))
