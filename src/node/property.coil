                           (key (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "propload-keyed-make" "S3 — src/node/property.coil") (unreachable-node)))

(defn propstore-keyed-make [(ctrl (dyn NodeOps))
                            (mem (dyn NodeOps))
                            (obj (dyn NodeOps))
                            (key (dyn NodeOps))
                            (val (dyn NodeOps))] (-> (dyn NodeOps))
