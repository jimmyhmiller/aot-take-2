;; Property and element access: PropLoad, PropStore, ArrayLoad, ArrayStore, ArrayLen.

;;
;; These are the JavaScript object model as IR nodes. Each has a FAST path and a GENERIC path, and
;; which one a site gets is decided by what the shape analysis proved:
;;
;;   proven single shape  -> the fast path: a Load at a known alias class and byte offset, with no
;;                           check at all, because the shape was established by a guard upstream.
;;   proven small set     -> a guarded chain of fast paths, generic as the final fallback.
;;   nothing proven       -> the generic path: [[Get]] stays the JSL definition (own step, then
;;                           the prototype chain), and its own-property step is one runtime
;;                           operation over the shape tree (`property-generic-access`).
;;
;; The complete named-read operation stays a call to the JSL JsGetNamed definition. Its
;; :specialize policy lowers that same checked source at sites with proven receiver tags; unknown
;; sites share the generic helper. The PropAccess nodes below are the representation-level
;; operations exposed inside that helper or a specialized caller, not the frontend's full Get.
;;
;; Keyed access (`o[k]`) with a non-constant key stays generic unless the key is proven to be an
;; array index, which is the one case worth its own node.
;;
;; The node: `PropAccess` is a call-like multi — (control, memory, value) — carrying a constant key
;; and a kind (load, has, store). It is what the frontend and JSL emit for an own-property access
;; whose owner's backing store is not statically visible at that moment. Its idealize is the fast
;; path: when the memory SSA shows the owner's properties word to be a Store of a known allocation
;; (the same pattern a literal's definitions leave behind), the access becomes one Load, one
;; constant, or the static store transition, and the projections forward to those. Inlining exposes
;; exactly this pattern at call sites that were opaque at parse time, which is why the access has
;; to be a node and not an expansion. Whatever is still unresolved when optimization ends is
;; expanded once, before type checking, into the runtime shape-tree operation below.
;;
;; Simple has no such node because a field access in Simple is a Load: the struct type IS the
;; layout. The dispatch here is the JavaScript divergence; the folding rule is Simple's
;; Load-after-Store idealization reached through the owner's properties word.
;;
;; Simple LoadNode.compute joins the declared pointer field with the effective memory slice.
;; Its idealize first sharpens aliases, forwards an equal-address Store, exposes effective
;; memory, and tries a dominating equivalent Load. Its backward walk skips only proven
;; non-aliasing Stores, registers dependencies on unresolved pointers/offsets/Phis/calls, and
;; stops when aliasing is unknown. Pushing a Load through a Phi must collapse an arm (the
;; backedge for loops), preventing endless loop expansion. Start is not a constant-memory proof.
;; Here layouts are mutable JavaScript shapes, so the common property query proves the shape
;; at the incoming memory position. It joins equal shapes across all Phi arms without moving
;; loads, stops at cycles/effects, and seeds image state only at the explicit fresh-realm boundary.
(module aot.node.property)
(import "aot.util.arena"
        :use
        [compiler-allocator compiler-state CompilerStateSlot])
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.arraylist" :use *)
(import "coil.str" :use [sb-new sb-push-str! sb-push-i64! sb-str cstr->str])
(import "coil.os" :as os)
(import "aot.util.panic" :use *)
(import "aot.node.node" :use *)
(import "aot.node.constant" :use *)
(import "aot.node.control" :use *)
(import "aot.node.cfg" :use *)
(import "aot.node.compare" :use *)
(import "aot.node.phi" :use *)
(import "aot.node.dynamic" :use *)
(import "aot.node.memory" :use *)
(import "aot.node.jsops" :use *)
(import "aot.type.type" :use *)
(import "aot.shape" :use *)
(import "aot.heap" :use *)
(import "aot.facts" :use *)

(const PROP-LOAD 0)

(const PROP-HAS 1)

(const PROP-STORE 2)

;; The own property's attributes (SHAPE-ATTR-* bits), -1 absent on an extensible object, -2 absent
;; on a non-extensible one: the one question JSL's [[Get]] and [[Set]] ask before a load or store,
;; folding to a constant wherever the shape is known (aot.node.property, docs/DECISIONS.md, property
;; attributes live in the shape tree).
(const PROP-ATTRS 3)

;; The first prototype (the receiver excluded) with an own `key`, or null: the one question the
;; chain walk of [[Get]] and [[Set]] asks. It folds when the receiver's prototype chain is image
;; data — a literal's %Object.prototype%, an image object's chain — under the closed-world facts.
(const PROP-HOLDER 4)

;; Ordinary [[Get]] of a data property, own or inherited: the value, undefined past the chain's end,
;; or the exception sentinel for an accessor found (whose pair the JSL slow path then reads). One
;; access, so a site whose owner and chain are known folds to a load or a constant, and one whose
;; owner is unknown is one runtime call (JS-PROP-GET), never a chain of runtime questions.
(const PROP-GET 5)

;; The fast cases of OrdinarySet with the object as receiver: an own writable data property takes
;; the value, an absent key is added when the object is extensible and no prototype holds the key
;; as an accessor or read-only property. The value, or the exception sentinel when the slow path
;; must decide (JS-PROP-SET when nothing is known).
(const PROP-SET 6)

(const PROP-CTRL 0)

(const PROP-MEM 1)

(const PROP-OBJECT 2)

(const PROP-VALUE 3)

;; Projection indices of the tuple `(control, memory, value)`.
(const PROP-RESULT-CTRL 0)

(const PROP-RESULT-MEM 1)

(const PROP-RESULT-VALUE 2)

(defstruct PropAccessNode
  [(hdr NodeHdr)
   (key i64)
   (kind i64)
   (attrs i64)  ; a store: the attributes a new key takes (SHAPE-ATTRS-DEFAULT for an assignment)
   (res-mem i64)  ; once resolved: the memory the mem projection forwards to
   (res-value i64)])  ; once resolved: the value the value projection forwards to

;; What the memory SSA says about an owner's backing store at a program point.
(defsum PropStatic
  (PropUnknown)
  (PropNoStorage)
  ;; storage zero means the exact shape is known across memory paths but no single SSA pointer
  ;; names its backing store. Consumers load the properties word at their own memory position.
  (PropStorage [(storage i64) (shape i64)]))

;; Simple LoadNode follows memory definitions, bypasses only proven unrelated stores, and records
;; dependencies on every inspected blocker. Its Phi rule requires a profitable arm and protects
;; loop termination. Our extra query asks for a complete property shape at the same memory point.
;; A join retains a shape only when every reachable arm proves that exact shape; cycles and open
;; merges conservatively return unknown. No provisional dead arm is used as a proof here.
;; Calls are barriers. Initial-image facts enter only through START-INITIAL-MEM, never arbitrary
;; Start memory or an unknown caller. This query does not change the heap image or create nodes.
(defn prop-state-shape [(state PropStatic)] (-> i64)
  (match state
    (PropUnknown [] -1)
    (PropNoStorage [] SHAPE-EMPTY)
    (PropStorage [_ shape] shape)))

;; A per-key proof. Absence is distinct from a present property containing undefined. `exact`
;; says the entire backing shape is known, as required to allocate a transition; a whole-program
;; invariant can prove this key absent without knowing which other keys have been added.
;; A present property's image value is reusable only when image-value-entry is nonnegative.
(defsum PropOwn
  (OwnUnknown)
  (OwnAbsent [(shape i64) (exact bool)])
  (OwnPresent [(shape i64) (storage i64) (image-value-entry i64)]))

(defn prop-own-in-shape [(shape i64) (storage i64) (key i64)] (-> PropOwn)
  (if (shape-has-key? shape key)
      (OwnPresent
        :shape shape
        :storage storage
        :image-value-entry -1)
      (OwnAbsent shape true)))

;; The sole authority for an own-property proof. Local memory evidence is strongest. When that
;; is unknown, a conservative closed-world invariant may still hold across every memory state.
;; Consumers never infer current presence directly from the image, or inspect receiver opcodes.
(defn prop-own-state [(mem (dyn NodeOps))
                      (object (dyn NodeOps))
                      (key i64)
                      (dep (dyn NodeOps))] (-> PropOwn)
  (match (prop-memory-state mem object dep)
    (PropNoStorage [] (OwnAbsent SHAPE-EMPTY true))
    (PropStorage [storage shape] (prop-own-in-shape shape storage key))
    (PropUnknown []
                 (let [entry (ty-image-entry (n-ty object))]
                   (if (and (mem-identity-reference? (n-ty object))
                            (facts-ready?)
                            (>= entry 0)
                            (not (heap-entry-string? entry)))
                       (let [shape (heap-storage-shape entry)
                             written (facts-written? entry key)]
                         (if (facts-layout-unknown? entry key)
                             (OwnUnknown)
                             (if (shape-has-key? shape key)
                                 (OwnPresent
                                   :shape shape
                                   :storage 0
                                   :image-value-entry (if written -1 entry))
                                 (if written
                                     (OwnUnknown)
                                     (OwnAbsent shape false)))))
                       (OwnUnknown))))))

(defn prop-own-read [(ctrl (dyn NodeOps))
                     (mem (dyn NodeOps))
                     (object (dyn NodeOps))
                     (key i64)
                     (state PropOwn)
                     (get? bool)] (-> (Option (dyn NodeOps)))
  (match state
    (OwnUnknown [] (None [(dyn NodeOps)]))
    (OwnAbsent [_ _] (Some (dyn-undefined-make)))
    (OwnPresent [shape storage image-entry]
                (if (and get?
                         (!= (& (shape-key-attrs shape key) SHAPE-ATTR-ACCESSOR)
                             0))
                    (Some (dyn-exception-make))
                    (if (>= image-entry 0)
                        (let [backing (heap-entry-storage image-entry)
                              slot
                                (/ (shape-offset-key shape key) HEAP-WORD-BYTES)]
                          (image-word-node (heap-entry-word backing slot)
                                           (heap-entry-word-kind backing slot)))
                        (Some (load-make ctrl
                                         mem
                                         (prop-storage-pointer ctrl
                                                               mem
                                                               object
                                                               storage)
                                         (con-int (shape-offset-key shape key))
                                         (shape-alias-key shape key)
                                         (ty-dyn TAG-ANY))))))))

(defn prop-memory-state [(mem (dyn NodeOps))
                         (object (dyn NodeOps))
                         (dep (dyn NodeOps))] (-> PropStatic)
  (let [(mut path) (al-new [i64] (compiler-allocator))
        (mut fuel) 1024
        answer (prop-memory-state-walk mem object dep (mut path) (mut fuel))]
    (al-free! (mut path))
    answer))

(defn prop-memory-state-walk [(mem (dyn NodeOps))
                              (object (dyn NodeOps))
                              (dep (dyn NodeOps))
                              (path (mut (ArrayList i64)))
                              (fuel (mut i64))] (-> PropStatic)
  (let [(mut seen) false]
    (n-add-dep! mem dep)
    (n-add-dep! object dep)
    (al-for [id (load path)] (if (= id (n-nid mem)) (set! (mut seen) true) 0))
    (if (or (load seen) (<= (load fuel) 0) (>= (len (load path)) 256))
        (PropUnknown)
        (do
          (set! (mut fuel) (- (load fuel) 1))
          (push! (mut path) (n-nid mem))
          (let [answer
                  (prop-memory-state-step mem object dep (mut path) (mut fuel))]
            (pop! (mut path))
            answer)))))

(defn prop-memory-state-step [(mem (dyn NodeOps))
                              (object (dyn NodeOps))
                              (dep (dyn NodeOps))
                              (path (mut (ArrayList i64)))
                              (fuel (mut i64))] (-> PropStatic)
  (let [op (n-op mem)]
    (if (= op OP-MEMMERGE)
        (prop-memory-state-walk (memmerge-alias mem ALIAS-OBJECT-PROPERTIES)
                                object
                                dep
                                (mut path)
                                (mut fuel))
        (if (= op OP-STORE)
            (let [ptr_ (n-in! mem MEM-PTR)]
              (n-add-dep! ptr_ dep)
              (if (or (!= (mem-alias-of-node mem) ALIAS-OBJECT-PROPERTIES)
                      (mem-provably-distinct? ptr_ object))
                  (prop-memory-state-walk (n-in! mem MEM-STATE)
                                          object
                                          dep
                                          (mut path)
                                          (mut fuel))
                  (if (mem-same-object? ptr_ object)
                      (prop-storage-word-state (n-in! mem STORE-VAL) dep)
                      (PropUnknown))))
            (if (or (= op OP-PHI) (= op OP-MEMPHI) (= op OP-PARM))
                (let [region (n-in! mem 0)
                      (mut shape) -1
                      (mut first) true
                      (mut valid) true
                      (mut i) 1]
                  (n-add-dep! region dep)
                  (if (phi-in-progress? mem)
                      (PropUnknown)
                      (do
                        (loop (if (>= (load i) (n-nins mem))
                                  (break 0)
                                  (let [ctrl (n-in! region (load i))]
                                    (n-add-dep! ctrl dep)
                                    ;; Include even currently dead arms: no dependence on provisional reachability.
                                    (let [state
                                            (match (n-in mem (load i))
                                              (Some [input]
                                                    (prop-memory-state-walk input
                                                                            object
                                                                            dep
                                                                            (mut path)
                                                                            (mut fuel)))
                                              (None [] (PropUnknown)))
                                          next (prop-state-shape state)]
                                      (if (or (< next 0)
                                              (and (not (load first))
                                                   (!= next (load shape))))
                                          (set! (mut valid) false)
                                          0)
                                      (set! (mut first) false)
                                      (set! (mut shape) next))
                                    (set! (mut i) (+ (load i) 1))
                                    (continue))))
                        (if (and (load valid) (not (load first)))
                            (PropStorage 0 (load shape))
                            (PropUnknown)))))
                (if (= op OP-PROJ)
                    (let [source (n-in! mem 0)]
                      (n-add-dep! source dep)
                      (if (and (= (n-op source) OP-START)
                               (= (proj-idx mem) START-INITIAL-MEM))
                          (let [entry (ty-image-entry (n-ty object))]
                            (if (and (mem-identity-reference? (n-ty object))
                                     (>= entry 0)
                                     (not (heap-entry-string? entry)))
                                (if (< (heap-entry-storage entry) 0)
                                    (PropNoStorage)
                                    (PropStorage 0 (heap-storage-shape entry)))
                                (PropUnknown)))
                          (if (and (= (n-op source) OP-NEW)
                                   (= (proj-idx mem) 1))
                              (prop-memory-state-walk (new-memory source)
                                                      object
                                                      dep
                                                      (mut path)
                                                      (mut fuel))
                              (if (and (or (= (n-op source) OP-PROPLOAD)
                                           (= (n-op source) OP-PROPSTORE))
                                       (= (proj-idx mem) PROP-RESULT-MEM)
                                       (not (or (= (prop-access-kind source)
                                                   PROP-STORE)
                                                (= (prop-access-kind source)
                                                   PROP-SET))))
                                  (prop-memory-state-walk (n-in! source
                                                                 PROP-MEM)
                                                          object
                                                          dep
                                                          (mut path)
                                                          (mut fuel))
                                  (PropUnknown)))))
                    (PropUnknown)))))))

(defn prop-storage-word-state [(word (dyn NodeOps)) (dep (dyn NodeOps))] (-> PropStatic)
  (do
    (n-add-dep! word dep)
    (if (= (n-ty word) (ty-dyn TAG-NULL))
        (PropNoStorage)
        (if (= (n-op word) OP-BOX)
            (let [storage (n-in! word 1)]
              (n-add-dep! storage dep)
              (if (and (= (n-op storage) OP-PROJ)
                       (= (n-op (n-in! storage 0)) OP-NEW))
                  (PropStorage (n-nid storage) (new-shape (n-in! storage 0)))
                  (PropUnknown)))
            (PropUnknown)))))

(defn prop-access-node [(n (dyn NodeOps))] (-> (ptr PropAccessNode))
  (if (not (or (= (n-op n) OP-PROPLOAD) (= (n-op n) OP-PROPSTORE)))
      (do
        (panic-i "prop-access-node: not a property access" (n-op n))
        (primitive/cast (ptr PropAccessNode) (hdr n)))
      (primitive/cast (ptr PropAccessNode) (hdr n))))

(defn prop-access-key [(n (dyn NodeOps))] (-> i64)
  (.key (prop-access-node n)))

(defn prop-access-kind [(n (dyn NodeOps))] (-> i64)
  (.kind (prop-access-node n)))

(defn prop-access-attrs [(n (dyn NodeOps))] (-> i64)
  (.attrs (prop-access-node n)))

;; Find the [[Prototype]] word by walking its memory alias to the owning Store.
;; None when the memory state does not show it; traversed nodes record dependencies.
(defn prop-owner-prototype [(mem (dyn NodeOps))
                            (object (dyn NodeOps))
                            (dep (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [(mut state) (mem-effective mem ALIAS-OBJECT-PROTOTYPE)
        (mut found) (None [(dyn NodeOps)])
        (mut walking) true]
    (loop (if (not (load walking))
              (break 0)
              (let [cur (load state)]
                (n-add-dep! cur dep)
                (if (= (n-op cur) OP-STORE)
                    (do
                      (n-add-dep! (n-in! cur MEM-PTR) dep)
                      (if (!= (mem-alias-of-node cur) ALIAS-OBJECT-PROTOTYPE)
                          (do
                            (set! (mut state) (n-in! cur MEM-STATE))
                            (continue))
                          (if (mem-same-object? (n-in! cur MEM-PTR) object)
                              (do
                                (set! (mut found) (Some (n-in! cur STORE-VAL)))
                                (set! (mut walking) false)
                                (continue))
                              (if (mem-provably-distinct? (n-in! cur MEM-PTR)
                                                          object)
                                  (do
                                    (set! (mut state) (n-in! cur MEM-STATE))
                                    (continue))
                                  (do (set! (mut walking) false) (continue))))))
                    (if (= (n-op cur) OP-MEMMERGE)
                        (do
                          (set! (mut state)
                                (memmerge-alias cur ALIAS-OBJECT-PROTOTYPE))
                          (continue))
                        (if (and (= (n-op cur) OP-PROJ)
                                 (and (= (proj-idx cur) 1)
                                      (= (n-op (n-in! cur 0)) OP-NEW)))
                            (do
                              (set! (mut state) (new-memory (n-in! cur 0)))
                              (continue))
                            (do (set! (mut walking) false) (continue))))))))
    (load found)))

;; The holder of `key` for a fresh object whose prototype word the memory state shows: null when the
;; word is null, the image chain from a boxed StaticRef, unknown otherwise.
(defn prop-fresh-holder [(mem (dyn NodeOps))
                         (object (dyn NodeOps))
                         (key i64)
                         (dep (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [entry (ty-image-entry (n-ty object))
        prototype
          (match (prop-owner-prototype mem object dep)
            (Some [value] (Some value))
            (None []
                  (if (and (mem-identity-reference? (n-ty object))
                           (facts-ready?)
                           (>= entry 0)
                           (not (heap-entry-string? entry))
                           (not (facts-prototypes-written?)))
                      (image-word-node (heap-entry-word entry
                                                        HEAP-OFFSET-PROTOTYPE-WORD)
                                       (heap-entry-word-kind entry
                                                             HEAP-OFFSET-PROTOTYPE-WORD))
                      (None [(dyn NodeOps)]))))]
    (match prototype
      (None [] (None [(dyn NodeOps)]))
      (Some [value]
            (if (= (n-ty value) (ty-dyn TAG-NULL))
                (Some (dyn-null-make))
                (let [parent (ty-image-entry (n-ty value))]
                  (n-add-dep! value dep)
                  (if (and (>= parent 0)
                           (not (heap-entry-string? parent))
                           (ty-monomorphic? (n-ty value)))
                      (prop-image-holder mem
                                         (heap-ref-word (staticref-rep-prefix (ty-dyn-tags (n-ty value)))
                                                        parent)
                                         key
                                         dep)
                      (None [(dyn NodeOps)]))))))))

;; The owner's properties word must be a Store to this very object of either the null word (no
;; backing store yet) or a boxed fresh allocation whose hidden class New declares.
(defn prop-static-storage [(mem (dyn NodeOps)) (object (dyn NodeOps))] (-> PropStatic)
  (prop-memory-state mem object object))

(defn prop-storage-pointer [(ctrl (dyn NodeOps))
                            (mem (dyn NodeOps))
                            (object (dyn NodeOps))
                            (storage i64)] (-> (dyn NodeOps))
  (if (> storage 0)
      (match (arena-node storage)
        (Some [ptr_] ptr_)
        (None []
              (do
                (panic "prop-storage-pointer: proof names a missing node")
                (unreachable-node))))
      (unbox-make (load-make ctrl
                             mem
                             object
                             (con-int OFFSET-OBJECT-PROPERTIES)
                             ALIAS-OBJECT-PROPERTIES
                             (ty-dyn TAG-OBJECT))
                  REP-OBJECT)))

(defn prop-access-result-ty [(kind i64) (value-ty i64)] (-> i64)
  (if (= kind PROP-HAS)
      (ty-bool)
      (if (= kind PROP-ATTRS)
          (prop-attrs-ty)
          (if (= kind PROP-HOLDER)
              (ty-dyn (+ TAG-NULL (+ TAG-OBJECT (+ TAG-FUNCTION TAG-ARRAY))))
              (if (= kind PROP-GET)
                  (prop-get-ty)
                  (if (= kind PROP-SET)
                      ;; The value on success, the sentinel when the slow path decides.
                      (if (and (ty-dyn? value-ty) (not (ty-dyn-high? value-ty)))
                          (ty-dyn (| (ty-dyn-tags value-ty) TAG-EXCEPTION))
                          value-ty)
                      (if (= kind PROP-STORE) value-ty (ty-dyn TAG-ANY))))))))

;; Holder reads and writes consume the same memory-position proof as direct accesses.
(defn prop-holder-read [(ctrl (dyn NodeOps))
                        (mem (dyn NodeOps))
                        (holder (dyn NodeOps))
                        (key i64)
                        (dep (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (if (= (n-ty holder) (ty-dyn TAG-NULL))
      (Some (dyn-undefined-make))
      (let [object (unbox-make holder REP-OBJECT-LIKE)]
        (n-keep! object)
        (let [answer
                (prop-own-read ctrl
                               mem
                               object
                               key
                               (prop-own-state mem object key dep)
                               true)]
          (n-unkeep! object)
          (if (n-unused? object) (n-kill! object) 0)
          answer))))

(defn prop-holder-set-ok [(mem (dyn NodeOps))
                          (holder (dyn NodeOps))
                          (key i64)
                          (dep (dyn NodeOps))] (-> (Option bool))
  (if (= (n-ty holder) (ty-dyn TAG-NULL))
      (Some true)
      (match (prop-own-state mem holder key dep)
        (OwnPresent [shape _ _] (Some (prop-shape-data-proof? shape key true)))
        (_ (None [bool])))))

;; A folded holder that decided nothing is a node nothing uses.
(defn prop-holder-drop! [(holder (dyn NodeOps))] (-> i64)
  (if (n-unused? holder) (n-kill! holder) 0))

;; Walk an invariant image prototype chain, asking the same per-key memory proof at each holder.
;; Calls can invalidate property state without changing the identity or prototype of the holder.
(defn prop-image-holder [(mem (dyn NodeOps))
                         (word i64)
                         (key i64)
                         (dep (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (if (or (not (facts-ready?)) (facts-prototypes-written?))
      (None [(dyn NodeOps)])
      (let [(mut current) word
            (mut steps) 0
            (mut answer) (None [(dyn NodeOps)])]
        (loop (if (>= (load steps) (heap-count))
                  (break 0)
                  (let [entry (heap-ref-entry (load current))
                        holder
                          (match (image-word-node (load current) HEAP-WORD-REF)
                            (Some [value] value)
                            (None []
                                  (do
                                    (panic "prop-image-holder: invalid prototype word")
                                    (unreachable-node))))
                        object (n-in! holder 1)]
                    (n-keep! holder)
                    (let [state (prop-own-state mem object key dep)]
                      (n-unkeep! holder)
                      (match state
                        (OwnUnknown []
                                    (do (prop-holder-drop! holder) (break 0)))
                        (OwnPresent [_ _ _]
                                    (do
                                      (set! (mut answer) (Some holder))
                                      (break 0)))
                        (OwnAbsent [_ _]
                                   (let [next-word
                                           (heap-entry-word entry
                                                            HEAP-OFFSET-PROTOTYPE-WORD)
                                         next
                                           (image-word-object-entry next-word
                                                                    (heap-entry-word-kind entry
                                                                                          HEAP-OFFSET-PROTOTYPE-WORD))]
                                     (prop-holder-drop! holder)
                                     (if (< next 0)
                                         (do
                                           (set! (mut answer)
                                                 (Some (dyn-null-make)))
                                           (break 0))
                                         (do
                                           (set! (mut current) next-word)
                                           (set! (mut steps) (+ (load steps) 1))
                                           (continue))))))))))
        (load answer))))

;; The attributes a fresh-object shape answers for `key`: the field's bits, or -1/-2 by extensibility.
;; Eligibility only: reuse the same owner/storage and image facts as PropAccess. This function
;; creates no graph and grants no assumption. The actual access still proves/folds itself when
;; JSL is lowered. Simple's typed field access already knows its offset; JavaScript must establish
;; an own data descriptor first. A broad object tag does not establish that descriptor.
;; `AOT_SPECIALIZE_TRACE=1`, read once. The property proof has seven ways to fail and answers one
;; bool, so without this the only way to learn which one fired is a build per guess. Reads the same
;; variable as the JSL-side refusal trace; the two flags are independent and that is harmless.
(defstruct PropProofTraceFlag [(state i64)])

(defn prop--proof-trace? [] (-> bool)
  (let [f
          (compiler-state [PropProofTraceFlag]
                          (primitive/alloc-static CompilerStateSlot))]
    (if (= (.state f) 0)
        (set! (.state f)
              (if (!= (primitive/cast i64 (os/getenv c"AOT_SPECIALIZE_TRACE"))
                      0)
                  1
                  2))
        0)
    (= (.state f) 1)))

(defn prop--proof-no [(why (ptr i8))] (-> bool)
  (do
    (if (prop--proof-trace?)
        (do (println "prop-proof: no: {s}" (cstr->str why)) 0)
        0)
    false))

(defn property-specialization-proven? [(mem (dyn NodeOps))
                                       (boxed (dyn NodeOps))
                                       (key i64)
                                       (write? bool)
                                       (dep (dyn NodeOps))] (-> bool)
  (if (< key 0)
      (prop--proof-no c"key is not a constant")
      (let [object (if (= (n-op boxed) OP-BOX) (n-in! boxed 1) (load boxed))]
        (match (prop-own-state mem object key dep)
          (OwnPresent [shape _ _] (prop-shape-data-proof? shape key write?))
          (OwnAbsent [_ _]
                     (prop--proof-no c"property absent at this memory position"))
          (OwnUnknown []
                      (prop--proof-no c"receiver state unknown to memory SSA"))))))

;; Absence is useful evidence for lowering OrdinarySet, but grants no right to create a property:
;; the residual PropSet must still prove extensibility and the inherited descriptor. Requiring
;; the exact shape here limits admission to sites where that residual can make a direct transition.
(defn property-specialization-absent? [(mem (dyn NodeOps))
                                      (boxed (dyn NodeOps))
                                      (key i64)
                                      (dep (dyn NodeOps))] (-> bool)
  (if (< key 0) false
      (let [object (if (= (n-op boxed) OP-BOX) (n-in! boxed 1) (load boxed))]
        (match (prop-own-state mem object key dep)
          (OwnAbsent [_ exact] exact)
          (_ false)))))

(defn prop-shape-data-proof? [(shape i64) (key i64) (write? bool)] (-> bool)
  (and (shape-has-key? shape key)
       (= (& (shape-key-attrs shape key) SHAPE-ATTR-ACCESSOR) 0)
       (or (not write?)
           (!= (& (shape-key-attrs shape key) SHAPE-ATTR-WRITABLE) 0))))

(defn prop-shape-attrs [(shape i64) (key i64)] (-> i64)
  (if (shape-has-key? shape key)
      (shape-key-attrs shape key)
      (if (shape-extensible? shape) -1 -2)))

(defn prop-access-compute [(d (dyn NodeOps))] (-> i64)
  (let [p (prop-access-node d)]
    (ty-tuple-of3 (match (n-in d PROP-CTRL)
                    (Some [c] (n-ty c))
                    (None [] TY-TOP))
                  (match (n-in d PROP-MEM)
                    (Some [m] (n-ty m))
                    (None [] (ty-mem-top 1)))
                  (prop-access-result-ty (.kind p)
                                         (if (> (n-nins d) PROP-VALUE)
                                             (match (n-in d PROP-VALUE)
                                               (Some [v] (n-ty v))
                                               (None [] (ty-dyn TAG-ANY)))
                                             (ty-dyn TAG-ANY))))))

;; Forward every projection of a resolved access and let the worklist collect the access itself.
;; A specialization must keep the proof the site already had (docs/SPECIALIZE.md §3.1). The residual
;; body's value is typed by the definition's declaration; the projection it replaces may hold something
;; narrower, because the callee's own Returns proved it — the parser's completion check then asserts the
;; result is not the exception sentinel, and that Cast would recompute WIDER than before, which the
;; monotone node types reject. A Cast to the projection's own type keeps that fact.
(defn prop--forwarded-value [(u (dyn NodeOps))
                             (replacement (dyn NodeOps))
                             (ctrl (dyn NodeOps))
                             (value-slot bool)] (-> (dyn NodeOps))
  (if (and value-slot
           (and (!= (n-ty u) TY-INVALID)
                (and (not (ty-high? (n-ty u)))
                     (not (ty-isa? (n-ty replacement) (n-ty u))))))
      (n-peephole! (cast-make ctrl replacement (n-ty u)))
      ;; `replacement` is an edge the caller holds for this walk: peepholing it here could subsume the
      ;; very node the caller still keeps. The specializer peepholes these edges once the walk has
      ;; released them (aot.jsl.lower, `jsl-specialize-body-inner!`).
      replacement))

(defn prop-access-forward! [(d (dyn NodeOps))
                            (ctrl (dyn NodeOps))
                            (mem (dyn NodeOps))
                            (value (dyn NodeOps))] (-> i64)
  (let [(mut projs) (al-new [i64] (compiler-allocator))
        (mut i) 0]
    (n-keep! ctrl)
    (n-keep! mem)
    (n-keep! value)
    (loop (if (>= (load i) (n-nouts d))
              (break 0)
              (do
                (match (n-out d (load i))
                  (Some [u]
                        (if (or (= (n-op u) OP-PROJ) (= (n-op u) OP-CPROJ))
                            (push! [i64] (mut projs) (n-nid u))
                            (n-panic! "prop-access-forward!: a property access has a non-projection user"
                                      u)))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (al-for [id (load projs)]
            (match (arena-node id)
              (Some [u]
                    (if (n-dead? u)
                        0
                        (let [idx
                                (if (= (n-op u) OP-CPROJ)
                                    (cproj-idx u)
                                    (proj-idx u))
                              replacement
                                (if (= idx PROP-RESULT-CTRL)
                                    ctrl
                                    (if (= idx PROP-RESULT-MEM) mem value))]
                          (n-subsume! u
                                      (prop--forwarded-value u
                                                             replacement
                                                             ctrl
                                                             (= idx
                                                                PROP-RESULT-VALUE))))))
              (None [] 0)))
    (al-free! [i64] (mut projs))
    (n-unkeep! ctrl)
    (n-unkeep! mem)
    (n-unkeep! value)
    0))

;; The fast path: resolve against a statically visible backing store.
(defn prop-access-idealize [(d (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [p (prop-access-node d)]
    (if (!= (.res-mem p) 0)
        (None [(dyn NodeOps)])
        (match (n-in d PROP-MEM)
          (None [] (None [(dyn NodeOps)]))
          (Some [mem]
                (let [ctrl (n-in! d PROP-CTRL)
                      object (n-in! d PROP-OBJECT)
                      key (.key p)]
                  (n-add-dep! ctrl d)
                  (n-add-dep! mem d)
                  (n-add-dep! object d)
                  (if (or (= (n-ty ctrl) TY-XCTRL) (ty-high? (n-ty mem)))
                      (None [(dyn NodeOps)])
                      (if (= (.kind p) PROP-HOLDER)
                          (match (prop-fresh-holder mem object key d)
                            (Some [holder]
                                  (prop-access-resolve! d ctrl mem holder))
                            (None [] (None [(dyn NodeOps)])))
                          (prop-access-own! d
                                            ctrl
                                            mem
                                            object
                                            key
                                            (prop-own-state mem object key d))))))))))

(defn prop-access-own! [(d (dyn NodeOps))
                        (ctrl (dyn NodeOps))
                        (mem (dyn NodeOps))
                        (object (dyn NodeOps))
                        (key i64)
                        (state PropOwn)] (-> (Option (dyn NodeOps)))
  (let [p (prop-access-node d)
        kind (.kind p)]
    (match state
      (OwnUnknown [] (None [(dyn NodeOps)]))
      (OwnAbsent [shape exact]
                 (if (= kind PROP-HAS)
                     (prop-access-resolve! d ctrl mem (con-int 0))
                     (if (= kind PROP-ATTRS)
                         (prop-access-resolve! d
                                               ctrl
                                               mem
                                               (con-int (prop-shape-attrs shape
                                                                          key)))
                         (if (= kind PROP-LOAD)
                             (prop-access-resolve! d
                                                   ctrl
                                                   mem
                                                   (dyn-undefined-make))
                             (if (= kind PROP-GET)
                                 (prop-get-chain! d ctrl mem object key)
                                 (if (= kind PROP-SET)
                                     (if (not (shape-extensible? shape))
                                         (prop-access-resolve! d
                                                               ctrl
                                                               mem
                                                               (dyn-exception-make))
                                         (if exact
                                             (prop-set-absent! d
                                                               ctrl
                                                               mem
                                                               object
                                                               key)
                                             (None [(dyn NodeOps)])))
                                     (if (and exact (shape-extensible? shape))
                                         (let [stored
                                                 (property-store-shaped ctrl
                                                                        mem
                                                                        object
                                                                        key
                                                                        (n-in! d
                                                                               PROP-VALUE)
                                                                        (.attrs p)
                                                                        shape
                                                                        0)]
                                           (prop-access-resolve! d
                                                                 ctrl
                                                                 (.mem stored)
                                                                 (.value stored)))
                                         (None [(dyn NodeOps)]))))))))
      (OwnPresent [shape storage image-entry]
                  (if (= kind PROP-HAS)
                      (prop-access-resolve! d ctrl mem (con-int 1))
                      (if (= kind PROP-ATTRS)
                          (prop-access-resolve! d
                                                ctrl
                                                mem
                                                (con-int (shape-key-attrs shape
                                                                          key)))
                          (if (or (= kind PROP-STORE) (= kind PROP-SET))
                              (if (prop-shape-data-proof? shape key true)
                                  (let [stored
                                          (property-store-in-shape ctrl
                                                                   mem
                                                                   (prop-storage-pointer ctrl
                                                                                         mem
                                                                                         object
                                                                                         storage)
                                                                   shape
                                                                   key
                                                                   (n-in! d
                                                                          PROP-VALUE))]
                                    (prop-access-resolve! d
                                                          ctrl
                                                          (.mem stored)
                                                          (.value stored)))
                                  (if (= kind PROP-SET)
                                      (prop-access-resolve! d
                                                            ctrl
                                                            mem
                                                            (dyn-exception-make))
                                      (None [(dyn NodeOps)])))
                              (match (prop-own-read ctrl
                                                    mem
                                                    object
                                                    key
                                                    state
                                                    (= kind PROP-GET))
                                (Some [value]
                                      (prop-access-resolve! d ctrl mem value))
                                (None [] (None [(dyn NodeOps)]))))))))))

;; [[Get]] of a key a fresh object lacks: its chain's holder, when the memory state shows the
;; prototype word, decides — undefined at null, the image word at an image holder.
(defn prop-get-chain! [(d (dyn NodeOps))
                       (ctrl (dyn NodeOps))
                       (mem (dyn NodeOps))
                       (object (dyn NodeOps))
                       (key i64)] (-> (Option (dyn NodeOps)))
  (match (prop-fresh-holder mem object key d)
    (None [] (None [(dyn NodeOps)]))
    (Some [holder]
          (match (prop-holder-read ctrl mem holder key d)
            (Some [value]
                  (do
                    (prop-holder-drop! holder)
                    (prop-access-resolve! d ctrl mem value)))
            (None [] (do (prop-holder-drop! holder) (None [(dyn NodeOps)])))))))

;; OrdinarySet of a key a fresh, extensible object lacks: added by the static transition when the
;; chain's holder allows it, the sentinel when the holder is an accessor or read-only property.
(defn prop-set-absent! [(d (dyn NodeOps))
                        (ctrl (dyn NodeOps))
                        (mem (dyn NodeOps))
                        (object (dyn NodeOps))
                        (key i64)] (-> (Option (dyn NodeOps)))
  (match (prop-fresh-holder mem object key d)
    (None [] (None [(dyn NodeOps)]))
    (Some [holder]
          (let [ok (prop-holder-set-ok mem holder key d)]
            (prop-holder-drop! holder)
            (match ok
              (None [] (None [(dyn NodeOps)]))
              (Some [allowed]
                    (if allowed
                        (let [stored
                                (property-store-known-owner ctrl
                                                            mem
                                                            object
                                                            key
                                                            (n-in! d PROP-VALUE)
                                                            SHAPE-ATTRS-DEFAULT)]
                          (prop-access-resolve! d
                                                ctrl
                                                (.mem stored)
                                                (.value stored)))
                        (prop-access-resolve! d ctrl mem (dyn-exception-make)))))))))

(defn prop-access-resolve! [(d (dyn NodeOps))
                            (ctrl (dyn NodeOps))
                            (mem (dyn NodeOps))
                            (value (dyn NodeOps))] (-> (Option (dyn NodeOps)))
  (let [p (prop-access-node d)]
    (set! (.res-mem p) (n-nid mem))
    (set! (.res-value p) (n-nid value))
    (prop-access-forward! d ctrl mem value)
    (Some d)))

;; Simple's MultiNode.pcopy for a resolved access: a projection created after resolution still
;; forwards. Control forwards to the incoming control; the access itself never had any.
(defn prop-access-pcopy [(d (dyn NodeOps)) (idx i64)] (-> (Option (dyn NodeOps)))
  (let [p (prop-access-node d)]
    (if (= (.res-mem p) 0)
        (None [(dyn NodeOps)])
        (if (= idx PROP-RESULT-CTRL)
            (n-in d PROP-CTRL)
            (arena-node (if (= idx PROP-RESULT-MEM) (.res-mem p) (.res-value p)))))))

(impl NodeOps PropAccessNode
  (hdr [(self (ptr PropAccessNode))]
       (-> (ptr NodeHdr))
       (primitive/cast (ptr NodeHdr) self))
  (label [(self (ptr PropAccessNode))]
         (-> (slice u8))
         (let [(mut b) (sb-new (compiler-allocator))]
           (sb-push-str! (mut b)
                         (if (= (.kind self) PROP-LOAD)
                             "PropLoad"
                             (if (= (.kind self) PROP-HAS)
                                 "PropHas"
                                 (if (= (.kind self) PROP-ATTRS)
                                     "PropAttrs"
                                     (if (= (.kind self) PROP-HOLDER)
                                         "PropHolder"
                                         (if (= (.kind self) PROP-GET)
                                             "PropGet"
                                             (if (= (.kind self) PROP-SET)
                                                 "PropSet"
                                                 "PropStore")))))))
           (sb-push-str! (mut b) "[")
           (sb-push-str! (mut b) (shape-key-name (.key self)))
           (sb-push-str! (mut b) "]")
           (sb-str (mut b))))
  (is-const? [(self (ptr PropAccessNode))] (-> bool) false)
  (no-const-fold? [(self (ptr PropAccessNode))] (-> bool) true)
  (is-pinned? [(self (ptr PropAccessNode))] (-> bool) true)
  (binop-copy [(self (ptr PropAccessNode))
               (lhs (dyn NodeOps))
               (rhs (dyn NodeOps))]
              (-> (Option (dyn NodeOps)))
              (None [(dyn NodeOps)]))
  (compute [(self (ptr PropAccessNode))]
           (-> i64)
           (prop-access-compute (primitive/make-dyn NodeOps self)))
  (idealize [(self (ptr PropAccessNode))]
            (-> (Option (dyn NodeOps)))
            (prop-access-idealize (primitive/make-dyn NodeOps self)))
  ;; A control-bearing multi is a site, as a Call is: never GVN-merged.
  (eq-extra [(self (ptr PropAccessNode)) (other (dyn NodeOps))]
            (-> bool)
            (= (.nid (hdr (primitive/make-dyn NodeOps self))) (n-nid other)))
  (hash-extra [(self (ptr PropAccessNode))]
              (-> i64)
              (+ 401 (.nid (hdr (primitive/make-dyn NodeOps self))))))

;; An access is control, as a Call is: it sits in the middle of a block and its control
;; projection heads the next one. `aot.node.call` contributes this to `cfg-of`.
(impl CFGOps PropAccessNode
  (cfg-node [(self (ptr PropAccessNode))]
            (-> (dyn NodeOps))
            (primitive/make-dyn NodeOps self))
  (block-head? [(self (ptr PropAccessNode))] (-> bool) false)
  (cfg-idom [(self (ptr PropAccessNode))]
            (-> (Option (dyn NodeOps)))
            (n-in-safe (primitive/make-dyn NodeOps self) PROP-CTRL))
  (cfg-idepth [(self (ptr PropAccessNode))]
              (-> i64)
              (cfg-idepth-default (primitive/make-dyn NodeOps self))))

(defn prop-access-cfg [(n (dyn NodeOps))] (-> (Option (dyn CFGOps)))
  (if (or (= (n-op n) OP-PROPLOAD) (= (n-op n) OP-PROPSTORE))
      (Some (primitive/make-dyn CFGOps (prop-access-node n)))
      (None [(dyn CFGOps)])))

;; Build an access. `value` is Some only for a store.
(defn prop-access-make [(ctrl (dyn NodeOps))
                        (mem (dyn NodeOps))
                        (object (dyn NodeOps))
                        (value (Option (dyn NodeOps)))
                        (key i64)
                        (kind i64)] (-> (dyn NodeOps))
  (let [a (compiler-allocator)
        p (alloc/unwrap-ptr [PropAccessNode] (alloc/create [PropAccessNode] a))
        d (primitive/make-dyn NodeOps p)]
    (if (or (<= key 0) (> key (shape-key-count)))
        (panic-i "prop-access-make: invalid property key" key)
        0)
    (set! (.key p) key)
    (set! (.kind p) kind)
    (set! (.attrs p) SHAPE-ATTRS-DEFAULT)
    (set! (.res-mem p) 0)
    (set! (.res-value p) 0)
    (n-init! d
             (if (or (= kind PROP-STORE) (= kind PROP-SET))
                 OP-PROPSTORE
                 OP-PROPLOAD))
    (n-add-def! d (Some ctrl))
    (n-add-def! d (Some mem))
    (n-add-def! d (Some object))
    (match value
      (Some [v] (n-add-def! d (Some v)))
      (None []
            (if (or (= kind PROP-STORE) (= kind PROP-SET))
                (panic "prop-access-make: a store needs a value")
                0)))
    (n-set-ty! d (compute p))
    d))

;; An access as the three values the frontend threads: its control, memory and value projections.
(defn prop-access-emit [(ctrl (dyn NodeOps))
                        (mem (dyn NodeOps))
                        (object (dyn NodeOps))
                        (value (Option (dyn NodeOps)))
                        (key i64)
                        (kind i64)] (-> PropertyAccessResult)
  (prop-access-emit-attrs ctrl mem object value key kind SHAPE-ATTRS-DEFAULT))

;; A store that defines a new key with these attributes (CreateDataProperty with a descriptor, the
;; image builder's `prototype`): the same node, the transition it takes carries the attributes.
(defn prop-access-emit-attrs [(ctrl (dyn NodeOps))
                              (mem (dyn NodeOps))
                              (object (dyn NodeOps))
                              (value (Option (dyn NodeOps)))
                              (key i64)
                              (kind i64)
                              (attrs i64)] (-> PropertyAccessResult)
  (let [d (prop-access-make ctrl mem object value key kind)]
    (set! (.attrs (prop-access-node d)) attrs)
    (property-access-result (proj-make d PROP-RESULT-VALUE "prop.value")
                            (cproj-make d PROP-RESULT-CTRL "prop.ctrl")
                            (proj-make d PROP-RESULT-MEM "prop.mem"))))

;; The generic path, once per unresolved access, after optimization: the guarded closed-world
;; dispatch below. Nothing may remain afterwards; a later phase seeing an access is a wiring bug.
(defn property-expand-all! [] (-> i64)
  (let [cnt (arena-node-count)
        shapes-before (shape-count)
        (mut i) 1
        (mut expanded) 0]
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (and (not (n-dead? n))
                                 (or (= (n-op n) OP-PROPLOAD)
                                     (= (n-op n) OP-PROPSTORE)))
                            (let [p (prop-access-node n)]
                              (if (!= (.res-mem p) 0)
                                  0
                                  (let [ctrl (n-in! n PROP-CTRL)
                                        origin-prior (.current (node-origins))
                                        origin-set
                                          (do
                                            (set! (.current (node-origins))
                                                  (.origin (hdr n)))
                                            0)
                                        mem (n-in! n PROP-MEM)
                                        object (n-in! n PROP-OBJECT)
                                        access
                                          (if (= (.kind p) PROP-STORE)
                                              (if (= (.attrs p)
                                                     SHAPE-ATTRS-DEFAULT)
                                                  (property-store-generic-owner ctrl
                                                                                mem
                                                                                object
                                                                                (.key p)
                                                                                (n-in! n
                                                                                       PROP-VALUE))
                                                  (property-store-generic-owner-attrs ctrl
                                                                                      mem
                                                                                      object
                                                                                      (keyref-make (.key p))
                                                                                      (n-in! n
                                                                                             PROP-VALUE)
                                                                                      (.attrs p)))
                                              (if (= (.kind p) PROP-ATTRS)
                                                  (property-attrs-own-named ctrl
                                                                            mem
                                                                            object
                                                                            (.key p))
                                                  (if (= (.kind p) PROP-HOLDER)
                                                      (property-holder-named ctrl
                                                                             mem
                                                                             object
                                                                             (.key p))
                                                      (if (= (.kind p) PROP-GET)
                                                          (property-generic-access ctrl
                                                                                   mem
                                                                                   object
                                                                                   (keyref-make (.key p))
                                                                                   (None [(dyn NodeOps)])
                                                                                   JS-PROP-GET)
                                                          (if (= (.kind p)
                                                                 PROP-SET)
                                                              (property-set-generic ctrl
                                                                                    mem
                                                                                    object
                                                                                    (keyref-make (.key p))
                                                                                    (n-in! n
                                                                                           PROP-VALUE))
                                                              (property-own-named ctrl
                                                                                  mem
                                                                                  object
                                                                                  (.key p)
                                                                                  (= (.kind p)
                                                                                     PROP-LOAD)))))))]
                                    (set! (mut expanded) (+ (load expanded) 1))
                                    origin-set
                                    (n-origin-leave! origin-prior)
                                    (set! (.res-mem p) (n-nid (.mem access)))
                                    (set! (.res-value p)
                                          (n-nid (.value access)))
                                    (prop-access-forward! n
                                                          (.ctrl access)
                                                          (.mem access)
                                                          (.value access))
                                    (if (n-unused? n) (n-kill! n) 0)
                                    0)))
                            0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (set! (mut i) 1)
    (loop (if (> (load i) cnt)
              (break 0)
              (do
                (match (arena-node (load i))
                  (Some [n]
                        (if (and (not (n-dead? n))
                                 (or (= (n-op n) OP-PROPLOAD)
                                     (= (n-op n) OP-PROPSTORE))
                                 (> (n-nouts n) 0))
                            (n-panic! "property-expand-all!: a property access survived expansion"
                                      n)
                            0))
                  (None [] 0))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    ;; Every dispatch above enumerated the shape universe as it stood when that access expanded.
    ;; A transition created by a later store's expansion is a shape no earlier dispatch tests for:
    ;; a load would read `undefined` from an object that has the property.
    (if (!= (shape-count) shapes-before)
        (panic-i2 "property-expand-all!: the shape universe grew during expansion (before, after)"
                  shapes-before
                  (shape-count))
        0)
    (load expanded)))

(defstruct PropertyStorageResult
  [(ptr_ (dyn NodeOps)) (mem (dyn NodeOps))])

(defstruct PropertyAccessResult
  [(value (dyn NodeOps)) (ctrl (dyn NodeOps)) (mem (dyn NodeOps))])

(defn property-access-result [(value (dyn NodeOps))
                              (ctrl (dyn NodeOps))
                              (mem (dyn NodeOps))] (-> PropertyAccessResult)
  (let [(mut r) (primitive/zeroed PropertyAccessResult)]
    (set! (.value (mut r)) value)
    (set! (.ctrl (mut r)) ctrl)
    (set! (.mem (mut r)) mem)
    (load r)))

(defn property-storage-result [(ptr_ (dyn NodeOps)) (mem (dyn NodeOps))] (-> PropertyStorageResult)
  (let [(mut r) (primitive/zeroed PropertyStorageResult)]
    (set! (.ptr_ (mut r)) ptr_)
    (set! (.mem (mut r)) mem)
    (load r)))

;; Allocate and fully initialize one immutable-layout property backing store. Values are in payload
;; offset order, which is also property insertion order for the transition tree. The object that
;; owns this storage publishes the resulting pointer only after this function returns, so every
;; field store remains private until the final MemMerge is installed.
(defn property-storage-new [(ctrl (dyn NodeOps))
                            (public-mem (dyn NodeOps))
                            (shape i64)
                            (values (ArrayList (dyn NodeOps)))] (-> PropertyStorageResult)
  (do
    (if (or (= shape SHAPE-EMPTY)
            (= shape SHAPE-STRING)
            (not (shape-valid? shape)))
        (panic-i "property-storage-new: invalid property shape" shape)
        0)
    (let [fields (shape-field-count shape)]
      (if (!= fields (len values))
          (panic-i "property-storage-new: value count does not match shape"
                   (len values))
          0)
      (let [fresh
              (new-make ctrl
                        (con-int (* fields SHAPE-WORD-BYTES))
                        public-mem
                        shape
                        (ty-struct "JsPropertyStorage"))
            ptr_ (proj-make fresh 0 "property.storage.ptr")
            private-mem (proj-make fresh 1 "property.storage.private-memory")
            merged (memmerge-make)
            (mut state-nid) (n-nid private-mem)
            (mut i) 0]
        (memmerge-set-alias! merged ALIAS-BULK public-mem)
        (loop (if (>= (load i) fields)
                  (break 0)
                  (let [alias (shape-field-alias-at shape (load i))
                        stored
                          (store-make ctrl
                                      (match (arena-node (load state-nid))
                                        (Some [n] n)
                                        (None [] (unreachable-node)))
                                      ptr_
                                      (con-int (* (load i) SHAPE-WORD-BYTES))
                                      (get values (load i))
                                      alias
                                      (ty-dyn TAG-ANY))]
                    (memmerge-set-alias! merged alias stored)
                    (set! (mut state-nid) (n-nid stored))
                    (set! (mut i) (+ (load i) 1))
                    (continue))))
        (property-storage-result ptr_ merged)))))

;; Publish a fully initialized backing store into an ordinary object's stable storage slot. The
;; owner store reads the pre-publication object slice, while the returned bundle independently
;; carries every backing-field slice. Feeding the bundle into its own Store would create a memory
;; cycle, so this separation is part of the representation contract rather than an optimization.
(defn property-storage-install [(ctrl (dyn NodeOps))
                                (object-mem (dyn NodeOps))
                                (object (dyn NodeOps))
                                (shape i64)
                                (storage PropertyStorageResult)] (-> (dyn NodeOps))
  (let [boxed-storage (box-make-at (Some ctrl) (.ptr_ storage))
        installed
          (store-make ctrl
                      object-mem
                      object
                      (con-int OFFSET-OBJECT-PROPERTIES)
                      boxed-storage
                      ALIAS-OBJECT-PROPERTIES
                      (ty-dyn TAG-ANY))
        merged (memmerge-make)
        fields (shape-field-count shape)
        (mut i) 0]
    (memmerge-set-alias! merged
                         ALIAS-BULK
                         (mem-effective object-mem ALIAS-BULK))
    (memmerge-set-alias! merged
                         ALIAS-OBJECT-PROTOTYPE
                         (mem-effective object-mem ALIAS-OBJECT-PROTOTYPE))
    (memmerge-set-alias! merged ALIAS-OBJECT-PROPERTIES installed)
    (loop (if (>= (load i) fields)
              (break 0)
              (let [alias (shape-field-alias-at shape (load i))]
                (memmerge-set-alias! merged
                                     alias
                                     (mem-effective (.mem storage) alias))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    merged))

;; The generic path: one runtime operation over the shape tree (`aot.rt.shapes`). The owner is a
;; proven raw ordinary object; the runtime reads its properties word, finds the key in the backing
;; store's shape, and loads, tests, or stores (transitioning to a child shape for a new key). Its
;; memory result is public BOT: the object escaped to the runtime and any slice may have changed.
;;
;; This replaced a closed-world dispatch that enumerated every compile-time shape holding the key.
;; That dispatch was unsound — a store expanded later creates a shape no earlier arm tests for —
;; and unbounded, k runtime keys over n shapes reaching n·k! layouts; docs/DECISIONS.md, property
;; access. Prototype traversal is deliberately the JSL caller's job: this is the representation
;; [[GetOwnProperty]]/[[DefineOwnProperty]] capability, not JavaScript [[Get]]/[[Set]].
(defn property-generic-access [(ctrl (dyn NodeOps))
                               (mem (dyn NodeOps))
                               (object (dyn NodeOps))
                               (key (dyn NodeOps))
                               (value (Option (dyn NodeOps)))
                               (prim i64)] (-> PropertyAccessResult)
  (let [op (jsop-make ctrl mem prim)]
    (jsop-add-arg! op object)
    (jsop-add-arg! op key)
    (match value (Some [v] (jsop-add-arg! op v)) (None [] 0))
    ;; A store's value is the value stored; the graph keeps using that node, not the call's copy.
    (property-access-result (match value
                              (Some [v] v)
                              (None []
                                    (proj-make op 2 "property.generic.value")))
                            ctrl
                            (proj-make op 1 "property.generic.mem"))))

;; The runtime's OrdinarySet fast path (`rt-prop-set`): its answer is the value or the sentinel, so
;; unlike a store the graph uses the call's result.
(defn property-set-generic [(ctrl (dyn NodeOps))
                            (mem (dyn NodeOps))
                            (object (dyn NodeOps))
                            (key (dyn NodeOps))
                            (value (dyn NodeOps))] (-> PropertyAccessResult)
  (let [op (jsop-make ctrl mem JS-PROP-SET)]
    (jsop-add-arg! op object)
    (jsop-add-arg! op key)
    (jsop-add-arg! op value)
    (property-access-result (proj-make op 2 "property.generic.value")
                            ctrl
                            (proj-make op 1 "property.generic.mem"))))

;; The runtime's attribute question (`rt-prop-attributes`) over a constant or a runtime key.
(defn property-attrs-own-named [(ctrl (dyn NodeOps))
                                (mem (dyn NodeOps))
                                (object (dyn NodeOps))
                                (key i64)] (-> PropertyAccessResult)
  (do
    (if (or (<= key 0) (> key (shape-key-count)))
        (panic-i "property-attrs-own-named: invalid property key" key)
        0)
    (property-generic-access ctrl
                             mem
                             object
                             (keyref-make key)
                             (None [(dyn NodeOps)])
                             JS-PROP-ATTRIBUTES)))

;; The runtime's chain walk (`rt-prop-chain-holder`) over a constant or a runtime key.
(defn property-holder-named [(ctrl (dyn NodeOps))
                             (mem (dyn NodeOps))
                             (object (dyn NodeOps))
                             (key i64)] (-> PropertyAccessResult)
  (do
    (if (or (<= key 0) (> key (shape-key-count)))
        (panic-i "property-holder-named: invalid property key" key)
        0)
    (property-generic-access ctrl
                             mem
                             object
                             (keyref-make key)
                             (None [(dyn NodeOps)])
                             JS-PROP-CHAIN-HOLDER)))

(defn property-holder-keyed [(ctrl (dyn NodeOps))
                             (mem (dyn NodeOps))
                             (object (dyn NodeOps))
                             (key (dyn NodeOps))] (-> PropertyAccessResult)
  (property-generic-access ctrl
                           mem
                           object
                           key
                           (None [(dyn NodeOps)])
                           JS-PROP-CHAIN-HOLDER))

(defn property-attrs-own-keyed [(ctrl (dyn NodeOps))
                                (mem (dyn NodeOps))
                                (object (dyn NodeOps))
                                (key (dyn NodeOps))] (-> PropertyAccessResult)
  (property-generic-access ctrl
                           mem
                           object
                           key
                           (None [(dyn NodeOps)])
                           JS-PROP-ATTRIBUTES))

;; A definition with attributes that no static shape absorbed: the runtime's ValidateAndApply
;; (`rt-prop-define`) with every descriptor field named. The value is the value stored.
;; The runtime's store whose added key takes `attrs` (`rt-prop-set-own-attrs`): the same contract
;; as the default store — a present writable data property takes the value and keeps its attributes.
(defn property-store-generic-owner-attrs [(ctrl (dyn NodeOps))
                                          (mem (dyn NodeOps))
                                          (object (dyn NodeOps))
                                          (key (dyn NodeOps))
                                          (value (dyn NodeOps))
                                          (attrs i64)] (-> PropertyAccessResult)
  (let [op (jsop-make ctrl mem JS-PROP-SET-OWN-ATTRS)]
    (jsop-add-arg! op object)
    (jsop-add-arg! op key)
    (jsop-add-arg! op value)
    (jsop-add-arg! op (con-int attrs))
    (property-access-result value ctrl (proj-make op 1 "property.generic.mem"))))

(defn property-own-named [(ctrl (dyn NodeOps))
                          (mem (dyn NodeOps))
                          (object (dyn NodeOps))
                          (key i64)
                          (load-value? bool)] (-> PropertyAccessResult)
  (do
    (if (or (<= key 0) (> key (shape-key-count)))
        (panic-i "property-own-named: invalid property key" key)
        0)
    (property-generic-access ctrl
                             mem
                             object
                             (keyref-make key)
                             (None [(dyn NodeOps)])
                             (if load-value? JS-PROP-GET-OWN JS-PROP-HAS-OWN))))

;; A store to a key the backing store's shape already carries: the field's word changes, the
;; layout does not. Only that field's slice moves; every other slice continues unchanged.
(defn property-store-in-shape [(ctrl (dyn NodeOps))
                               (mem (dyn NodeOps))
                               (storage (dyn NodeOps))
                               (shape i64)
                               (key i64)
                               (value (dyn NodeOps))] (-> PropertyAccessResult)
  (let [alias (shape-alias-key shape key)
        stored
          (store-make ctrl
                      mem
                      storage
                      (con-int (shape-offset-key shape key))
                      value
                      alias
                      (ty-dyn TAG-ANY))
        merged (memmerge-make)]
    ;; Final Simple Parser.mergeAlias: preserve ALL prior memory, overriding just this field.
    ;; MemMerge idealization collapses stacked defaults without losing unrelated aliases.
    (memmerge-set-alias! merged ALIAS-BULK mem)
    (memmerge-set-alias! merged alias stored)
    (property-access-result value ctrl merged)))

(defn property-load-own-named [(ctrl (dyn NodeOps))
                               (mem (dyn NodeOps))
                               (object (dyn NodeOps))
                               (key i64)] (-> PropertyAccessResult)
  (property-own-named ctrl mem object key true))

(defn property-has-own-named [(ctrl (dyn NodeOps))
                              (mem (dyn NodeOps))
                              (object (dyn NodeOps))
                              (key i64)] (-> PropertyAccessResult)
  (property-own-named ctrl mem object key false))

;; A runtime key id takes the same runtime operation; the key is simply not a constant.
(defn property-own-keyed [(ctrl (dyn NodeOps))
                          (mem (dyn NodeOps))
                          (object (dyn NodeOps))
                          (key (dyn NodeOps))
                          (load-value? bool)] (-> PropertyAccessResult)
  (property-generic-access ctrl
                           mem
                           object
                           key
                           (None [(dyn NodeOps)])
                           (if load-value? JS-PROP-GET-OWN JS-PROP-HAS-OWN)))

(defn property-load-own-keyed [(ctrl (dyn NodeOps))
                               (mem (dyn NodeOps))
                               (object (dyn NodeOps))
                               (key (dyn NodeOps))] (-> PropertyAccessResult)
  (property-own-keyed ctrl mem object key true))

(defn property-has-own-keyed [(ctrl (dyn NodeOps))
                              (mem (dyn NodeOps))
                              (object (dyn NodeOps))
                              (key (dyn NodeOps))] (-> PropertyAccessResult)
  (property-own-keyed ctrl mem object key false))

(defn property-store-generic-owner [(ctrl (dyn NodeOps))
                                    (mem (dyn NodeOps))
                                    (object (dyn NodeOps))
                                    (key i64)
                                    (value (dyn NodeOps))] (-> PropertyAccessResult)
  (do
    (if (or (<= key 0) (> key (shape-key-count)))
        (panic-i "property-store-generic-owner: invalid property key" key)
        0)
    (property-generic-access ctrl
                             mem
                             object
                             (keyref-make key)
                             (Some value)
                             JS-PROP-SET-OWN)))

;; A store whose owner's backing store is statically visible, with the attributes a new key takes.
;; A present key is written in place when it is a writable data property with the same attributes
;; (JSL asks the attributes before storing, so this is the case an assignment reaches); a new key
;; transitions the shape with the attributes when the shape is extensible. Anything else — a
;; non-extensible shape, an attribute change — is the runtime's define.
(defn property-store-known-owner [(ctrl (dyn NodeOps))
                                  (mem (dyn NodeOps))
                                  (object (dyn NodeOps))
                                  (key i64)
                                  (value (dyn NodeOps))
                                  (attrs i64)] (-> PropertyAccessResult)
  (match (prop-memory-state mem object object)
    (PropUnknown []
                 (if (= attrs SHAPE-ATTRS-DEFAULT)
                     (property-store-generic-owner ctrl mem object key value)
                     (property-store-generic-owner-attrs ctrl
                                                         mem
                                                         object
                                                         (keyref-make key)
                                                         value
                                                         attrs)))
    (PropNoStorage []
                   (property-store-shaped ctrl
                                          mem
                                          object
                                          key
                                          value
                                          attrs
                                          SHAPE-EMPTY
                                          0))
    (PropStorage [storage shape]
                 (property-store-shaped ctrl
                                        mem
                                        object
                                        key
                                        value
                                        attrs
                                        shape
                                        storage))))

(defn property-store-shaped [(ctrl (dyn NodeOps))
                             (mem (dyn NodeOps))
                             (object (dyn NodeOps))
                             (key i64)
                             (value (dyn NodeOps))
                             (attrs i64)
                             (shape i64)
                             (storage-id i64)] (-> PropertyAccessResult)
  (let [present (shape-has-key? shape key)
        writable
          (and present
               (= (& (shape-key-attrs shape key)
                     (| SHAPE-ATTR-ACCESSOR SHAPE-ATTR-WRITABLE))
                  SHAPE-ATTR-WRITABLE))]
    (if (or (and present (not writable))
            (and (not present) (not (shape-extensible? shape))))
        (if (= attrs SHAPE-ATTRS-DEFAULT)
            (property-store-generic-owner ctrl mem object key value)
            (property-store-generic-owner-attrs ctrl
                                                mem
                                                object
                                                (keyref-make key)
                                                value
                                                attrs))
        (if present
            (property-store-in-shape ctrl
                                     mem
                                     (prop-storage-pointer ctrl
                                                           mem
                                                           object
                                                           storage-id)
                                     shape
                                     key
                                     value)
            (let [next (shape-transition-key-attrs shape key attrs)
                  fields (shape-field-count shape)
                  (mut values) (al-new [(dyn NodeOps)] (compiler-allocator))
                  (mut i) 0]
              (if (> fields 0)
                  (let [storage
                          (prop-storage-pointer ctrl mem object storage-id)]
                    (n-keep! storage)
                    (loop (if (>= (load i) fields)
                              (break 0)
                              (do
                                (push! (mut values)
                                       (load-make ctrl
                                                  mem
                                                  storage
                                                  (con-int (* (load i)
                                                              SHAPE-WORD-BYTES))
                                                  (shape-field-alias-at shape
                                                                        (load i))
                                                  (ty-dyn TAG-ANY)))
                                (set! (mut i) (+ (load i) 1))
                                (continue))))
                    (n-unkeep! storage))
                  0)
              (push! (mut values) value)
              (let [storage (property-storage-new ctrl mem next (load values))
                    installed
                      (property-storage-install ctrl mem object next storage)]
                (al-free! (mut values))
                (property-access-result value ctrl installed)))))))

(defn propload-named-make [(ctrl (dyn NodeOps))
                           (mem (dyn NodeOps))
                           (obj (dyn NodeOps))
                           (name (slice u8))] (-> (dyn NodeOps))
  (do
    (unimplemented "propload-named-make" "S3 — src/node/property.coil")
    (unreachable-node)))

