                      (mem (dyn NodeOps))
                      (arr (dyn NodeOps))
                      (idx (dyn NodeOps))] (-> (dyn NodeOps))
  (do (unimplemented "arrayload-make" "S3 — src/node/property.coil") (unreachable-node)))

(defn arraystore-make [(ctrl (dyn NodeOps))
                       (mem (dyn NodeOps))
                       (arr (dyn NodeOps))
                       (idx (dyn NodeOps))
                       (val (dyn NodeOps))] (-> (dyn NodeOps))
