;; Shapes — hidden classes — as a transition tree, and the alias classes memory SSA is built on.

;;
;; Shapes form a tree rooted at the empty shape. Adding a field to a shape follows an edge, and the
;; edge is MEMOISED on (shape, name): the tree a whole-program build produces is a function of the
;; program and not of visit order, which is what makes a golden graph reproducible.
;;
;; THE ONE SENTENCE THAT MAKES MEMORY SSA WORK:
;;
;;   A field's alias class and byte offset are allocated at the transition edge that INTRODUCES the
;;   field, and inherited unchanged by every descendant.
;;
;; A store through `{x}` and a load through `{x,y}` must name the same word, because `{x,y}` was
;; reached FROM `{x}` and a transition never moves an existing field. Allocate per-shape-per-field
;; instead and those two touch different words, so load-after-store forwarding silently stops
;; firing: no error, no crash, just worse code — the hardest kind of bug to notice.
;;
;; The consequence is the point rather than a wart: `{x,y}` and `{y,x}` are genuinely DIFFERENT
;; layouts, because the edge that introduced `x` differs. That is the entire content of "hidden
;; class", and it is what a shape test is a witness for.
;;
;; Simple records stable aliases on declared Fields inside TypeStruct rather than implementing a
;; JavaScript hidden-class transition table, so this module is a documented language divergence,
;; not a direct port. STATUS: the transition tree is implemented. `(parent,name)` lookup is
;; canonical, an existing name preserves layout, a new edge allocates exactly one alias and payload
;; offset, and ancestor lookup preserves both in descendants. Prototype mutation, deletion and
;; dictionary-mode shapes are outside this table and are not claimed here.
(module aot.shape)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use [subslice])
(import "aot.util.panic" :use *)

;; The field-less root. Every object starts here.
(const SHAPE-EMPTY 1)

;; Runtime-reserved immutable layout. The high descriptor bit says the payload contains no boxed
;; reference slots; its low identity remains distinct from every compiler-created transition.
(const SHAPE-STRING 0x4000000000000001)

(const ALIAS-STRING-LENGTH 2)
(const ALIAS-STRING-DATA 3)

;; Every ordinary object payload begins with two boxed references. Keeping property storage behind
;; an independently movable backing object preserves JavaScript identity when a shape transition
;; grows the property set; the collector traces both slots like any other boxed object edge.
(const ALIAS-OBJECT-PROTOTYPE 4)
(const ALIAS-OBJECT-PROPERTIES 5)
(const ALIAS-OBJECT-SHAPE 6)
(const OFFSET-OBJECT-PROTOTYPE 0)
(const OFFSET-OBJECT-PROPERTIES 8)
(const OBJECT-PAYLOAD-BYTES 16)

;; A function object's payload begins like an ordinary object's, then carries the raw code word
;; (a text address, never a reference prefix, so tracing leaves it alone) and the boxed captured
;; environment (null until closures exist). See docs/DECISIONS.md, function values.
(const ALIAS-FUNCTION-CODE 7)
(const ALIAS-FUNCTION-ENV 8)
(const OFFSET-FUNCTION-CODE 16)
(const OFFSET-FUNCTION-ENV 24)
(const FUNCTION-PAYLOAD-BYTES 32)

;; An Array exotic object's payload begins like an ordinary object's, then carries the boxed
;; elements store (a heap object of shape SHAPE-ELEMENTS whose payload is one boxed word per
;; element slot, holes included) and the raw length word (docs/DECISIONS.md, arrays).
(const ALIAS-ARRAY-ELEMENTS 11)
(const ALIAS-ARRAY-LENGTH 12)
(const OFFSET-ARRAY-ELEMENTS 16)
(const OFFSET-ARRAY-LENGTH 24)
(const ARRAY-PAYLOAD-BYTES 32)

;; The elements store's layout: runtime-reserved, scanned (every word is a boxed value or the
;; hole), never a property shape. Its high descriptor bit keeps it distinct from every transition.
(const SHAPE-ELEMENTS 0x2000000000000001)

;; The realm's global object root inside the runtime heap record, addressed through the heap-state
;; pointer: host memory with its own alias class, never a heap field.
(const ALIAS-REALM-ROOT 9)

;; The pending exception's value in the runtime heap record (docs/DECISIONS.md, exceptions are a
;; sentinel completion): the thrown value while a throw unwinds, zero otherwise.
(const ALIAS-EXCEPTION-VALUE 10)

;; The first alias class the shape tree hands to a named property.
(const ALIAS-FIRST-PROPERTY 13)

(const SHAPE-WORD-BYTES 8)

(defstruct ShapeTable
  [(parent (ArrayList i64))
   (nameoff (ArrayList i64))
   (namelen (ArrayList i64))
   (keyid (ArrayList i64))
   (alias (ArrayList i64))
   (offset (ArrayList i64))
   (field-count (ArrayList i64))
   (bytes (ArrayList u8))
   (key-nameoff (ArrayList i64))
   (key-namelen (ArrayList i64))
   (next-alias i64)
   (booted bool)])

(defn shape-table [] (-> (ptr ShapeTable))
  (primitive/alloc-static ShapeTable))

;; Shape and property-key identities are compilation-local metadata. Reusing their numeric IDs
;; across `boot!` would let a JSL representation dispatch compiled for one source unit observe
;; transition rows left by another unit in the same compiler process.
(defn shape-reset! [] (-> i64)
  (let [t (shape-table)]
    (set! (.booted t) false)
    (shape-boot!)))

(defn shape-boot! [] (-> i64)
  (let [t (shape-table)]
    (if (.booted t)
        0
        (let [a (alloc/malloc-allocator)]
          (set! (.parent t) (al-new [i64] a))
          (set! (.nameoff t) (al-new [i64] a))
          (set! (.namelen t) (al-new [i64] a))
          (set! (.keyid t) (al-new [i64] a))
          (set! (.alias t) (al-new [i64] a))
          (set! (.offset t) (al-new [i64] a))
          (set! (.field-count t) (al-new [i64] a))
          (set! (.bytes t) (al-new [u8] a))
          (set! (.key-nameoff t) (al-new [i64] a))
          (set! (.key-namelen t) (al-new [i64] a))
          ;; Slot zero is invalid; slot one is the field-less root.
          (push! [i64] (mut (.parent t)) 0)
          (push! [i64] (mut (.nameoff t)) 0)
          (push! [i64] (mut (.namelen t)) 0)
          (push! [i64] (mut (.keyid t)) 0)
          (push! [i64] (mut (.alias t)) 0)
          (push! [i64] (mut (.offset t)) 0)
          (push! [i64] (mut (.field-count t)) 0)
          (push! [i64] (mut (.parent t)) 0)
          (push! [i64] (mut (.nameoff t)) 0)
          (push! [i64] (mut (.namelen t)) 0)
          (push! [i64] (mut (.keyid t)) 0)
          (push! [i64] (mut (.alias t)) 0)
          (push! [i64] (mut (.offset t)) 0)
          (push! [i64] (mut (.field-count t)) 0)
          ;; Property-key ID zero is invalid. IDs are canonical on exact UTF-8 bytes.
          (push! [i64] (mut (.key-nameoff t)) 0)
          (push! [i64] (mut (.key-namelen t)) 0)
          ;; Alias 1 is bulk; 2/3 strings; 4/5 object slots; 6 is the runtime shape header; 7/8
          ;; are the function object's code and environment words; 9 is the realm root and 10 the
          ;; pending exception value in the runtime heap record; 11/12 the array's elements and
          ;; length words. Properties follow.
          (set! (.next-alias t) ALIAS-FIRST-PROPERTY)
          (set! (.booted t) true)
          0))))

(defn shape-key-name-eq? [(key i64) (name (slice u8))] (-> bool)
  (let [t (shape-table)
        off (get (.key-nameoff t) key)
        ln (get (.key-namelen t) key)]
    (if (!= ln (len name))
        false
        (let [(mut i) 0 (mut same) true]
          (loop (if (or (>= (load i) ln) (not (load same)))
                    (break 0)
                    (do
                      (if (!= (get (.bytes t) (+ off (load i))) (get name (load i)))
                          (set! (mut same) false)
                          0)
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (load same)))))

(defn shape-key-intern [(name (slice u8))] (-> i64)
  (do
    (shape-boot!)
    (if (= (len name) 0) (panic "shape-key-intern: empty property key") 0)
    (let [t (shape-table) (mut key) 1 (mut found) 0]
      (loop (if (>= (load key) (len (.key-nameoff t)))
                (break 0)
                (if (shape-key-name-eq? (load key) name)
                    (do (set! (mut found) (load key)) (break 0))
                    (do (set! (mut key) (+ (load key) 1)) (continue)))))
      (if (!= (load found) 0)
          (load found)
          (let [id (len (.key-nameoff t)) off (len (.bytes t)) (mut i) 0]
            (loop (if (>= (load i) (len name))
                      (break 0)
                      (do
                        (push! [u8] (mut (.bytes t)) (get name (load i)))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))
            (push! [i64] (mut (.key-nameoff t)) off)
            (push! [i64] (mut (.key-namelen t)) (len name))
            id)))))

(defn shape-key-count [] (-> i64)
  (do (shape-boot!) (- (len (.key-nameoff (shape-table))) 1)))

(defn shape-key-name [(key i64)] (-> (slice u8))
  (do
    (shape-boot!)
    (if (or (<= key 0) (> key (shape-key-count)))
        (do (panic-i "shape-key-name: invalid property key" key) "")
        (let [t (shape-table) off (get (.key-nameoff t) key) ln (get (.key-namelen t) key)]
          (subslice [u8] (al-slice (.bytes t)) off (+ off ln))))))

(defn shape-field-key [(shape i64)] (-> i64)
  (do
    (if (or (<= shape SHAPE-EMPTY) (not (shape-valid? shape)))
        (panic-i "shape-field-key: shape introduces no field" shape)
        0)
    (get (.keyid (shape-table)) shape)))

(defn shape-count [] (-> i64)
  (do (shape-boot!) (len (.parent (shape-table)))))

(defn shape-valid? [(shape i64)] (-> bool)
  (do
    (shape-boot!)
    (or (= shape SHAPE-STRING)
        (and (>= shape SHAPE-EMPTY) (< shape (len (.parent (shape-table))))))))

(defn shape-name-eq? [(shape i64) (name (slice u8))] (-> bool)
  (let [t (shape-table)
        off (get (.nameoff t) shape)
        ln (get (.namelen t) shape)]
    (if (!= ln (len name))
        false
        (let [(mut i) 0
              (mut same) true]
          (loop (if (or (>= (load i) ln) (not (load same)))
                    (break 0)
                    (do
                      (if (!= (get (.bytes t) (+ off (load i))) (get name (load i)))
                          (set! (mut same) false)
                          0)
                      (set! (mut i) (+ (load i) 1))
                      (continue))))
          (load same)))))

(defn shape-find-field [(shape0 i64) (name (slice u8))] (-> i64)
  (let [(mut shape) shape0
        (mut found) 0]
    (loop (if (= (load shape) SHAPE-EMPTY)
              (break 0)
              (if (shape-name-eq? (load shape) name)
                  (do (set! (mut found) (load shape)) (break 0))
                  (do (set! (mut shape) (get (.parent (shape-table)) (load shape))) (continue)))))
    (load found)))

(defn shape-find-field-key [(shape0 i64) (key i64)] (-> i64)
  (let [(mut shape) shape0 (mut found) 0]
    (if (or (<= key 0) (> key (shape-key-count)))
        (panic-i "shape-find-field-key: invalid property key" key)
        0)
    (loop (if (= (load shape) SHAPE-EMPTY)
              (break 0)
              (if (= (get (.keyid (shape-table)) (load shape)) key)
                  (do (set! (mut found) (load shape)) (break 0))
                  (do (set! (mut shape) (get (.parent (shape-table)) (load shape))) (continue)))))
    (load found)))

(defn shape-has-key? [(shape i64) (key i64)] (-> bool)
  (do
    (if (not (shape-valid? shape)) (panic-i "shape-has-key?: invalid shape" shape) 0)
    (!= (shape-find-field-key shape key) 0)))

(defn shape-alias-key [(shape i64) (key i64)] (-> i64)
  (let [field (shape-find-field-key shape key)]
    (if (= field 0)
        (do (panic "shape-alias-key: key is not in shape") 0)
        (get (.alias (shape-table)) field))))

(defn shape-offset-key [(shape i64) (key i64)] (-> i64)
  (let [field (shape-find-field-key shape key)]
    (if (= field 0)
        (do (panic "shape-offset-key: key is not in shape") 0)
        (get (.offset (shape-table)) field))))

(defn shape-field-alias-at [(shape0 i64) (index i64)] (-> i64)
  (do
    (if (or (< index 0) (>= index (shape-field-count shape0)))
        (panic-i "shape-field-alias-at: invalid field index" index)
        0)
    (let [(mut shape) shape0]
      (loop (if (= (get (.offset (shape-table)) (load shape)) (* index SHAPE-WORD-BYTES))
                (break (get (.alias (shape-table)) (load shape)))
                (do
                  (set! (mut shape) (get (.parent (shape-table)) (load shape)))
                  (continue)))))))

;; Follow (or create) the transition that adds `name` to `from`. Memoised.
(defn shape-transition [(from i64) (name (slice u8))] (-> i64)
  (do
    (shape-boot!)
    (if (not (shape-valid? from)) (panic-i "shape-transition: invalid parent shape" from) 0)
    (if (= (len name) 0) (panic "shape-transition: empty field name") 0)
    ;; Adding an already-present property changes its value, not its layout.
    (if (!= (shape-find-field from name) 0)
        from
        (let [t (shape-table)
              (mut child) 2
              (mut found) 0]
          ;; The transition map is canonical on `(parent,name)`. A linear table is deliberate at
          ;; this stage: shape creation is cold and deterministic; lookup can move to a hash table
          ;; without changing identities or the representation contract.
          (loop (if (>= (load child) (len (.parent t)))
                    (break 0)
                    (if (and (= (get (.parent t) (load child)) from)
                             (shape-name-eq? (load child) name))
                        (do (set! (mut found) (load child)) (break 0))
                        (do (set! (mut child) (+ (load child) 1)) (continue)))))
          (if (!= (load found) 0)
              (load found)
              (let [id (len (.parent t))
                    key (shape-key-intern name)
                    keyoff (get (.key-nameoff t) key)
                    keylen (get (.key-namelen t) key)
                    nameoff (len (.bytes t))
                    count (get (.field-count t) from)
                    alias (.next-alias t)
                    (mut i) 0]
                ;; `name` is commonly the slice returned by shape-key-name and can therefore
                ;; alias this ArrayList's backing allocation. Appending may reallocate it. Copy
                ;; through the canonical key offset and re-read the current ArrayList each
                ;; iteration instead of retaining that potentially stale slice.
                (loop (if (>= (load i) keylen)
                          (break 0)
                          (do
                            (push! [u8]
                                   (mut (.bytes t))
                                   (get (.bytes t) (+ keyoff (load i))))
                            (set! (mut i) (+ (load i) 1))
                            (continue))))
                (push! [i64] (mut (.parent t)) from)
                (push! [i64] (mut (.nameoff t)) nameoff)
                (push! [i64] (mut (.namelen t)) keylen)
                (push! [i64] (mut (.keyid t)) key)
                (push! [i64] (mut (.alias t)) alias)
                ;; Offsets are relative to the first object payload word. Runtime object headers
                ;; are not shape fields and the allocator adds its header size exactly once.
                (push! [i64] (mut (.offset t)) (* count SHAPE-WORD-BYTES))
                (push! [i64] (mut (.field-count t)) (+ count 1))
                (set! (.next-alias t) (+ alias 1))
                id))))))

;; The static shape table as the `__aot_shapes` blob the runtime boots its transition tree from
;; (`aot.rt.shapes` documents the layout and the reason). Emitted once per object file, after
;; every compile-time transition has been made.
(defn shape-put4! [(out (mut (ArrayList u8))) (v i64)] (-> i64)
  (do
    (push! [u8] (mut out) (primitive/cast u8 (& v 0xff)))
    (push! [u8] (mut out) (primitive/cast u8 (& (primitive/ishr v 8) 0xff)))
    (push! [u8] (mut out) (primitive/cast u8 (& (primitive/ishr v 16) 0xff)))
    (push! [u8] (mut out) (primitive/cast u8 (& (primitive/ishr v 24) 0xff)))
    0))

(const SHAPE-BLOB-VERSION 1)

(defn shape-table-bytes [] (-> (slice u8))
  (do
    (shape-boot!)
    (let [t (shape-table)
          (mut out) (al-new [u8] (alloc/malloc-allocator))
          shapes (len (.parent t))
          keys (len (.key-nameoff t))
          (mut i) 0]
      ;; A program that made no shape and no key has nothing to say: the object carries no
      ;; section and the runtime's tree starts at the root (`shapes-boot!` with a null blob).
      (if (and (<= shapes (+ SHAPE-EMPTY 1)) (<= keys 1))
          0
          (do
            (push! [u8] (mut out) 0x41)
            (push! [u8] (mut out) 0x4f)
            (push! [u8] (mut out) 0x54)
            (push! [u8] (mut out) 0x53)
            (push! [u8] (mut out) 0x48)
            (push! [u8] (mut out) 0x41)
            (push! [u8] (mut out) 0x50)
            (push! [u8] (mut out) 0x45)
            (shape-put4! (mut out) SHAPE-BLOB-VERSION)
            (shape-put4! (mut out) shapes)
            (shape-put4! (mut out) keys)
            (shape-put4! (mut out) (len (.bytes t)))
            (loop (if (>= (load i) shapes)
                      (break 0)
                      (do
                        (shape-put4! (mut out) (get (.parent t) (load i)))
                        (shape-put4! (mut out) (get (.keyid t) (load i)))
                        (shape-put4! (mut out) (get (.offset t) (load i)))
                        (shape-put4! (mut out) (get (.field-count t) (load i)))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))
            (set! (mut i) 0)
            (loop (if (>= (load i) keys)
                      (break 0)
                      (do
                        (shape-put4! (mut out) (get (.key-nameoff t) (load i)))
                        (shape-put4! (mut out) (get (.key-namelen t) (load i)))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))
            (set! (mut i) 0)
            (loop (if (>= (load i) (len (.bytes t)))
                      (break 0)
                      (do
                        (push! [u8] (mut out) (get (.bytes t) (load i)))
                        (set! (mut i) (+ (load i) 1))
                        (continue))))
            0))
      (al-slice (load out)))))

;; The alias class of `name` in `shape`, allocated at the introducing edge.
(defn shape-alias [(shape i64) (name (slice u8))] (-> i64)
  (do
    (if (not (shape-valid? shape)) (panic-i "shape-alias: invalid shape" shape) 0)
    (let [field (shape-find-field shape name)]
      (if (= field 0)
          (do (panic "shape-alias: field is not in shape") 0)
          (get (.alias (shape-table)) field)))))

;; The byte offset of `name` in `shape`, likewise inherited from the introducing edge.
(defn shape-offset [(shape i64) (name (slice u8))] (-> i64)
  (do
    (if (not (shape-valid? shape)) (panic-i "shape-offset: invalid shape" shape) 0)
    (let [field (shape-find-field shape name)]
      (if (= field 0)
          (do (panic "shape-offset: field is not in shape") 0)
          (get (.offset (shape-table)) field)))))

(defn shape-has? [(shape i64) (name (slice u8))] (-> bool)
  (do
    (if (not (shape-valid? shape)) (panic-i "shape-has?: invalid shape" shape) 0)
    (!= (shape-find-field shape name) 0)))

(defn shape-field-count [(shape i64)] (-> i64)
  (do
    (if (not (shape-valid? shape)) (panic-i "shape-field-count: invalid shape" shape) 0)
    (get (.field-count (shape-table)) shape)))

;; The property key an alias class names: the introducing edge's key. Every field row carries its
;; own alias, so an alias identifies one (parent shape, key) edge; the reverse map is a scan of the
;; rows, which the closed-world image analysis (`aot.node.imagefacts`) asks once per Store.
(defn shape-alias-key-id [(alias i64)] (-> i64)
  (do
    (shape-boot!)
    (if (< alias ALIAS-FIRST-PROPERTY) (panic-i "shape-alias-key-id: not a property alias" alias) 0)
    (let [t (shape-table)
          (mut shape) 2
          (mut found) 0]
      (loop (if (or (!= (load found) 0) (>= (load shape) (len (.parent t))))
                (break 0)
                (do
                  (if (= (get (.alias t) (load shape)) alias) (set! (mut found) (load shape)) 0)
                  (set! (mut shape) (+ (load shape) 1))
                  (continue))))
      (if (= (load found) 0)
          (do (panic-i "shape-alias-key-id: no field row carries the alias" alias) 0)
          (get (.keyid t) (load found))))))
