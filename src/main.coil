;; The compiler driver.

;;
;;   aot compile FILE.ts        compile one file to an object
;;   aot run FILE.ts            compile, link and run
;;   aot dump FILE.ts PHASE     print the graph after PHASE
;;
;; SCAFFOLD: argument handling is real; the pipeline behind it is stubbed at S1.
(module aot.main)
(import "coil.print" :use *)
(import "aot.util.panic" :use *)
(import "aot.codegen.codegen" :use *)

(defn usage [] (-> i64)
  (do
    (println "aot — an AOT TypeScript/JavaScript compiler on a sea-of-nodes IR")
    (println "")
    (println "  aot compile FILE.ts       compile to an object file")
    (println "  aot run     FILE.ts       compile, link and run")
    (println "  aot dump    FILE.ts PHASE print the graph after PHASE")
    (println "")
    (println "See docs/LAYOUT.md for the architecture and the build order.")
    0))

(defn main [] (-> i64)
  (do
    (usage)
    ;; The pipeline is not wired yet; say so and exit non-zero rather than exiting 0 on a
    ;; compiler that cannot compile.
    (unimplemented "main: the compile pipeline is not wired"
                   "S1 — src/codegen/codegen.coil code-drive!")
    1))
