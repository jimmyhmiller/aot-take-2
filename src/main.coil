;; The compiler driver.

;;
;;   aot compile FILE.ts FILE.o
;;   aot run FILE.ts FILE.o EXECUTABLE
(module aot.main)
(import "coil.alloc" :as alloc)
(import "coil.args" :as args)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.print" :use *)
(import "aot.codegen.pipeline" :use *)
(import "aot.node.boot" :use *)
(import "aot.parse.parser" :use *)
(import "coil.os" :as os)
(import "aot.util.panic" :use *)

;; Source files named by argv positions `[first, last)`, read in order. A realm's Scripts are
;; evaluated in this order. Returns nonzero after reporting an unreadable file.
;; One source file, or None after reporting that it could not be read.
(defn read-source [(path (slice u8))] (-> (Option (slice u8)))
  (try (let [source (try-or! (fs/read-file (alloc/malloc-allocator) path)
                             (do (println "aot: could not read source file {s}" path)
                                 (None [(slice u8)])))]
         (Some source))))

(defn read-sources! [(sources (mut (ArrayList (slice u8)))) (first i64) (last i64)] (-> i64)
  (let [(mut i) first
        (mut failed) 0]
    (loop (if (or (>= (load i) last) (!= (load failed) 0))
              (break 0)
              (do
                (match (read-source (args/args-nth (load i)))
                  (Some [source] (push! [(slice u8)] (mut sources) source))
                  (None [] (set! (mut failed) 1)))
                (set! (mut i) (+ (load i) 1))
                (continue))))
    (load failed)))

(defn free-sources! [(sources (mut (ArrayList (slice u8))))] (-> i64)
  (do
    (al-for [source (load sources)] (alloc/free [u8] (alloc/malloc-allocator) source))
    (al-free! [(slice u8)] (mut sources))
    0))

(defn usage [] (-> i64)
  (do
    (println "aot — an AOT TypeScript/JavaScript compiler on a sea-of-nodes IR")
    (println "")
    (println "  aot compile FILE.ts FILE.o             compile to a Mach-O object")
    (println "  aot run FILE.ts FILE.o EXECUTABLE      compile, link and run")
    (println "  aot compile-script FILE.js... FILE.o  compile a realm: Scripts in evaluation order")
    (println "  aot parse-script FILE.js              validate syntax without evaluation")
    (println "  aot run-script FILE.js... FILE.o EXECUTABLE  execute a realm; do not call source main")
    (println "  aot dump FILE... PHASE [--dot] [--script]  print the graph after a phase:")
    (println "      parse | iter | opto | typecheck | select | gcm | sched | regalloc")
    (println "")
    (println "See docs/LAYOUT.md for the architecture and the build order.")
    0))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (do
    (args/args-set! argc argv)
    (if (< (args/args-count) 2)
        (do (usage) 64)
        (let [command (args/args-nth 1)]
          (if (= command "dump")
              (if (< (args/args-count) 4)
                  (do (usage) 64)
                  ;; `dump FILE... PHASE [--dot] [--script]`: the phase is the last positional
                  ;; argument; every earlier positional argument is a Script of the realm.
                  (let [(mut dot) false
                        (mut script) false
                        (mut positional) 0
                        (mut i) 2]
                    (loop (if (>= (load i) (args/args-count))
                              (break 0)
                              (do
                                (if (= (args/args-nth (load i)) "--dot")
                                    (set! (mut dot) true)
                                    (if (= (args/args-nth (load i)) "--script")
                                        (set! (mut script) true)
                                        (set! (mut positional) (+ (load positional) 1))))
                                (set! (mut i) (+ (load i) 1))
                                (continue))))
                    (if (< (load positional) 2)
                        (do (usage) 64)
                        (let [(mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
                              (mut phase) ""
                              (mut seen) 0]
                          (set! (mut i) 2)
                          (loop (if (>= (load i) (args/args-count))
                                    (break 0)
                                    (do
                                      (if (or (= (args/args-nth (load i)) "--dot") (= (args/args-nth (load i)) "--script"))
                                          0
                                          (do
                                            (set! (mut seen) (+ (load seen) 1))
                                            (if (= (load seen) (load positional))
                                                (set! (mut phase) (args/args-nth (load i)))
                                                (match (read-source (args/args-nth (load i)))
                                                  (Some [source] (push! [(slice u8)] (mut sources) source))
                                                  (None [] (do (os/_exit 66) 0))))))
                                      (set! (mut i) (+ (load i) 1))
                                      (continue))))
                          (print "{s}" (pipeline-dump-sources! (load sources) (load phase) 1 (load script) (load dot)))
                          (free-sources! (mut sources))
                          0))))
          (if (= command "parse-script")
              (if (!= (args/args-count) 3)
                  (do (usage) 64)
                  (try (let [source (try-or! (fs/read-file (alloc/malloc-allocator) (args/args-nth 2)) 66)]
                         (boot! 1)
                         (parse-syntax-program-mode! source true true)
                         (print "{}" PARSE-NORMAL-RECORD)
                         (alloc/free [u8] (alloc/malloc-allocator) source)
                         0)))
          (if (or (= command "compile") (= command "compile-script"))
              (if (< (args/args-count) 4)
                  (do (usage) 64)
                  (let [(mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
                        script (= command "compile-script")
                        last (- (args/args-count) 1)]
                    (if (and (not script) (!= (args/args-count) 4))
                        (do (usage) 64)
                        (if (!= (read-sources! (mut sources) 2 last) 0)
                            66
                            (do
                              (pipeline-compile-macho-sources! (load sources) (args/args-nth last) 1 script)
                              (free-sources! (mut sources))
                              0)))))
              (if (or (= command "run") (= command "run-script"))
                  (if (< (args/args-count) 5)
                      (do (usage) 64)
                      (let [(mut sources) (al-new [(slice u8)] (alloc/malloc-allocator))
                            script (= command "run-script")
                            last (- (args/args-count) 2)]
                        (if (and (not script) (!= (args/args-count) 5))
                            (do (usage) 64)
                            (if (!= (read-sources! (mut sources) 2 last) 0)
                                66
                                (let [answer (pipeline-compile-link-run-sources! (load sources)
                                                                                 (args/args-nth last)
                                                                                 (args/args-nth (+ last 1))
                                                                                 1 script)]
                                  (free-sources! (mut sources))
                                  answer)))))
                  (do (usage) 64)))))))))