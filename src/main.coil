;; The compiler driver.

;;
;;   aot compile FILE.ts FILE.o
;;   aot run FILE.ts FILE.o EXECUTABLE
(module aot.main)
(import "coil.alloc" :as alloc)
(import "coil.args" :as args)
(import "coil.fs" :as fs)
(import "coil.print" :use *)
(import "aot.codegen.pipeline" :use *)
(import "aot.node.boot" :use *)
(import "aot.parse.parser" :use *)
(import "coil.os" :as os)
(import "aot.util.panic" :use *)

(defn usage [] (-> i64)
  (do
    (println "aot — an AOT TypeScript/JavaScript compiler on a sea-of-nodes IR")
    (println "")
    (println "  aot compile FILE.ts FILE.o             compile to a Mach-O object")
    (println "  aot run FILE.ts FILE.o EXECUTABLE      compile, link and run")
    (println "  aot compile-script FILE.js FILE.o     compile top-level Script code")
    (println "  aot parse-script FILE.js              validate syntax without evaluation")
    (println "  aot run-script FILE.js FILE.o EXECUTABLE  execute Script; do not call source main")
    (println "  aot dump FILE PHASE [--dot] [--script]  print the graph after a phase:")
    (println "      parse | iter | opto | typecheck | select | gcm | sched | regalloc")
    (println "")
    (println "See docs/LAYOUT.md for the architecture and the build order.")
    0))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (do
    (args/args-set! argc argv)
    (if (< (args/args-count) 2)
        (do (usage) 64)
        (let [command (args/args-nth 1)]
          (if (= command "dump")
              (if (or (< (args/args-count) 4) (> (args/args-count) 6))
                  (do (usage) 64)
                  (try (let [source (try-or! (fs/read-file (alloc/malloc-allocator) (args/args-nth 2)) 66)
                             (mut dot) false
                             (mut script) false
                             (mut i) 4]
                         (loop (if (>= (load i) (args/args-count))
                                   (break 0)
                                   (do
                                     (if (= (args/args-nth (load i)) "--dot") (set! (mut dot) true) 0)
                                     (if (= (args/args-nth (load i)) "--script") (set! (mut script) true) 0)
                                     (if (and (!= (args/args-nth (load i)) "--dot") (!= (args/args-nth (load i)) "--script"))
                                         (do (usage) (os/_exit 64) 0)
                                         0)
                                     (set! (mut i) (+ (load i) 1))
                                     (continue))))
                         (print "{s}" (pipeline-dump-mode! source (args/args-nth 3) 1 (load script) (load dot)))
                         (alloc/free [u8] (alloc/malloc-allocator) source)
                         0)))
          (if (= command "parse-script")
              (if (!= (args/args-count) 3)
                  (do (usage) 64)
                  (try (let [source (try-or! (fs/read-file (alloc/malloc-allocator) (args/args-nth 2)) 66)]
                         (boot! 1)
                         (parse-syntax-program-mode! source true true)
                         (print "{}" PARSE-NORMAL-RECORD)
                         (alloc/free [u8] (alloc/malloc-allocator) source)
                         0)))
          (if (or (= command "compile") (= command "compile-script"))
              (if (!= (args/args-count) 4)
                  (do (usage) 64)
                  (try (let [source
                               (try-or! (fs/read-file (alloc/malloc-allocator) (args/args-nth 2))
                                        (do (println "aot: could not read source file") 66))]
                         (do
                           (pipeline-compile-macho-mode! source (args/args-nth 3) 1 (= command "compile-script"))
                           (alloc/free [u8] (alloc/malloc-allocator) source)
                           0))))
              (if (or (= command "run") (= command "run-script"))
                  (if (!= (args/args-count) 5)
                      (do (usage) 64)
                      (try (let [source
                                   (try-or! (fs/read-file (alloc/malloc-allocator) (args/args-nth 2))
                                            (do (println "aot: could not read source file") 66))]
                             (let [answer
                                     (pipeline-compile-link-run-mode! source
                                                                 (args/args-nth 3)
                                                                 (args/args-nth 4)
                                                                 1 (= command "run-script"))]
                               (do
                                 (alloc/free [u8] (alloc/malloc-allocator) source)
                                 answer)))))
                  (do (usage) 64)))))))))